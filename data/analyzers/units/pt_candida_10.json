{"scene_id": "pt_candida_10", "source": "/home/user/screenwrite-analyzers/data/analyzers/pdtrain/scenes/pt_candida_10.fountain", "heading": "INT. CANDIDA - CONTINUOUS", "cast": [{"id": 0, "name": "BURGESS", "names": ["BURGESS"], "gender": "?", "first": 1, "spoke": 2}, {"id": 1, "name": "LEXY", "names": ["LEXY"], "gender": "?", "first": 4, "spoke": 4}, {"id": 2, "name": "CANDIDA", "names": ["CANDIDA"], "gender": "?", "first": 5, "spoke": 6}, {"id": 3, "name": "MARCHBANKS", "names": ["MARCHBANKS"], "gender": "?", "first": 9, "spoke": 1}, {"id": 4, "name": "MORELL", "names": ["MORELL"], "gender": "m", "first": 6, "spoke": 4}, {"id": 5, "name": "EUGENE", "names": ["EUGENE"], "gender": "?", "first": 8, "spoke": 0}, {"id": 6, "name": "PROSERPINE", "names": ["PROSERPINE"], "gender": "f", "first": 70, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. CANDIDA - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "BURGESS (strongly remonstrating).", "para": 0, "sent": 0, "present": [0]}, {"u": 2, "kind": "action", "text": "Aw, no, Candy.", "para": 0, "sent": 1, "present": [0]}, {"u": 3, "kind": "action", "text": "'Ang it all!", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "(Lexy Mill comes in, looking anxious and important.)", "para": 0, "sent": 3, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "LEXY (hastening to shake hands with Candida).", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "How do you do, Mrs. Morell?", "para": 1, "sent": 1, "present": [0, 1, 2, 4]}, {"u": 7, "kind": "action", "text": "So glad to see you back again.", "para": 1, "sent": 2, "present": [0, 1, 2, 4]}, {"u": 8, "kind": "dialogue", "text": "Thank you, Lexy. You know Eugene, don't you?", "name": "CANDIDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "Oh, yes. How do you do, Marchbanks?", "name": "LEXY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Quite well, thanks.", "name": "MARCHBANKS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "LEXY (to Morell).", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "I've just come from the Guild of St. Matthew.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "They are in the greatest consternation about your telegram.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "There's nothing wrong, is there?", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "What did you telegraph about, James?", "name": "CANDIDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "LEXY (to Candida).", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "He was to have spoken for them tonight.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "They've taken the large hall in Mare Street and spent a lot of money on posters.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Morell's telegram was to say he couldn't come.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "It came on them like a thunderbolt.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "CANDIDA (surprized, and beginning to suspect something wrong).", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Given up an engagement to speak!", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "First time in his life, I'll bet. Ain' it, Candy?", "name": "BURGESS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "LEXY (to Morell).", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "They decided to send an urgent telegram to you asking whether you could not change your mind.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Have you received it?", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "MORELL (with restrained impatience).", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Yes, yes: I got it.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "It was reply paid.", "name": "LEXY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Yes, I know. I answered it. I can't go.", "name": "MORELL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "But why, James?", "name": "CANDIDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "MORELL (almost fiercely).", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Because I don't choose.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "These people forget that I am a man: they think I am a talking machine to be turned on for their pleasure every evening of my life.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "May I not have ONE night at home, with my wife, and my friends?", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "(They are all amazed at this outburst, except Eugene.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "His expression remains unchanged.)", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Oh, James, you know you'll have an attack of bad conscience to-morrow; and I shall have to suffer for that.", "name": "CANDIDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "LEXY (intimidated, but urgent).", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "I know, of course, that they make the most unreasonable demands on you.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "But they have been telegraphing all over the place for another speaker: and they can get nobody but the President of the Agnostic League.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "MORELL (promptly).", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Well, an excellent man.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "What better do they want?", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "But he always insists so powerfully on the divorce of Socialism from Christianity. He will undo all the good we have been doing. Of course you know best; but--(He hesitates.)", "name": "LEXY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "CANDIDA (coaxingly).", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "Oh, DO go, James.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "We'll all go.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "BURGESS (grumbling).", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "Look 'ere, Candy!", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "I say!", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "Let's stay at home by the fire, comfortable.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "He won't need to be more'n a couple-o'-hour away.", "para": 12, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "You'll be just as comfortable at the meeting. We'll all sit on the platform and be great people.", "name": "CANDIDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "EUGENE (terrified).", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "Oh, please don't let us go on the platform.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "No--everyone will stare at us--I couldn't.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "I'll sit at the back of the room.", "para": 13, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "Don't be afraid. They'll be too busy looking at James to notice you.", "name": "CANDIDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "action", "text": "MORELL (turning his head and looking meaningly at her over his shoulder).", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "Prossy's complaint, Candida!", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "Eh?", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "CANDIDA (gaily).", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "Yes.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "BURGESS (mystified).", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "action", "text": "Prossy's complaint.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "action", "text": "Wot are you talking about, James?", "para": 16, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "action", "text": "MORELL (not heeding him, rises; goes to the door; and holds it open, shouting in a commanding voice).", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "action", "text": "Miss Garnett.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "action", "text": "PROSERPINE (in the distance).", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 71, "kind": "action", "text": "Yes, Mr. Morell.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 72, "kind": "action", "text": "Coming.", "para": 18, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 73, "kind": "action", "text": "(They all wait, except Burgess, who goes stealthily to Lexy and draws him aside.)", "para": 18, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 74, "kind": "dialogue", "text": "Listen here, Mr. Mill. Wot's Prossy's complaint? Wot's wrong with 'er?", "name": "BURGESS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 75, "kind": "action", "text": "LEXY (confidentially).", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 76, "kind": "action", "text": "Well, I don't exactly know; but she spoke very strangely to me this morning.", "para": 19, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 77, "kind": "action", "text": "I'm afraid she's a little out of her mind sometimes.", "para": 19, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 78, "kind": "action", "text": "BURGESS (overwhelmed).", "para": 20, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 79, "kind": "action", "text": "Why, it must be catchin'!", "para": 20, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 80, "kind": "action", "text": "Four in the same 'ouse!", "para": 20, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 81, "kind": "action", "text": "(He goes back to the hearth, quite lost before the instability of the human intellect in a clergyman's house.)", "para": 20, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 82, "kind": "action", "text": "PROSERPINE (appearing on the threshold).", "para": 21, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 83, "kind": "action", "text": "What is it, Mr. Morell?", "para": 21, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 84, "kind": "dialogue", "text": "Telegraph to the Guild of St. Matthew that I am coming.", "name": "MORELL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 85, "kind": "action", "text": "PROSERPINE (surprised).", "para": 22, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 86, "kind": "action", "text": "Don't they expect you?", "para": 22, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 87, "kind": "action", "text": "MORELL (peremptorily).", "para": 23, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 88, "kind": "action", "text": "Do as I tell you.", "para": 23, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 89, "kind": "action", "text": "(Proserpine frightened, sits down at her typewriter, and obeys.", "para": 24, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 90, "kind": "action", "text": "Morell goes across to Burgess, Candida watching his movements all the time with growing wonder and misgiving.)", "para": 24, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 91, "kind": "dialogue", "text": "Burgess: you don't want to come?", "name": "MORELL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 92, "kind": "action", "text": "BURGESS (in deprecation).", "para": 25, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 93, "kind": "action", "text": "Oh, don't put it like that, James.", "para": 25, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 94, "kind": "action", "text": "It's only that it ain't Sunday, you know.", "para": 25, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 95, "kind": "dialogue", "text": "I'm sorry. I thought you might like to be introduced to the chairman. He's on the Works Committee of the County Council and has some influence in the matter of contracts. (Burgess wakes up at once. Morell, expecting as much, waits a moment, and says) Will you come?", "name": "MORELL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 96, "kind": "action", "text": "BURGESS (with enthusiasm).", "para": 26, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 97, "kind": "action", "text": "Course I'll come, James.", "para": 26, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 98, "kind": "action", "text": "Ain' it always a pleasure to 'ear you.", "para": 26, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 99, "kind": "action", "text": "MORELL (turning from him).", "para": 27, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 100, "kind": "action", "text": "I shall want you to take some notes at the meeting, Miss Garnett, if you have no other engagement.", "para": 27, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 101, "kind": "action", "text": "(She nods, afraid to speak.)", "para": 27, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 102, "kind": "action", "text": "You are coming, Lexy, I suppose.", "para": 27, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 103, "kind": "dialogue", "text": "Certainly.", "name": "LEXY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}