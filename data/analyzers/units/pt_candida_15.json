{"scene_id": "pt_candida_15", "source": "/home/user/screenwrite-analyzers/data/analyzers/pdtrain/scenes/pt_candida_15.fountain", "heading": "INT. CANDIDA - CONTINUOUS", "cast": [{"id": 0, "name": "CANDIDA", "names": ["CANDIDA"], "gender": "m", "first": 1, "spoke": 4}, {"id": 1, "name": "MARCHBANKS", "names": ["MARCHBANKS"], "gender": "m", "first": 5, "spoke": 4}, {"id": 2, "name": "MORELL", "names": ["MORELL"], "gender": "m", "first": 4, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. CANDIDA - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "CANDIDA (with quiet anger).", "para": 0, "sent": 0, "present": [0]}, {"u": 2, "kind": "action", "text": "Eugene is very quick-witted, James.", "para": 0, "sent": 1, "present": [0]}, {"u": 3, "kind": "action", "text": "I hope I am going to laugh; but I am not sure that I am not going to be very angry.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "(She goes to the fireplace, and stands there leaning with her arm on the mantelpiece and her foot on the fender, whilst Eugene steals to Morell and plucks him by the sleeve.)", "para": 0, "sent": 3, "present": [0, 2]}, {"u": 5, "kind": "action", "text": "MARCHBANKS (whispering).", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "Stop Morell.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Don't let us say anything.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "MORELL (pushing Eugene away without deigning to look at him).", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "I hope you don't mean that as a threat, Candida.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "CANDIDA (with emphatic warning).", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Take care, James.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Eugene: I asked you to go.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Are you going?", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "MORELL (putting his foot down).", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "He shall not go.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "I wish him to remain.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I'll go. I'll do whatever you want. (He turns to the door.)", "name": "MARCHBANKS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Stop! (He obeys.) Didn't you hear James say he wished you to stay? James is master here. Don't you know that?", "name": "CANDIDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "MARCHBANKS (flushing with a young poet's rage against tyranny).", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "By what right is he master?", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "CANDIDA (quietly).", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Tell him, James.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "MORELL (taken aback).", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "My dear: I don't know of any right that makes me master.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "I assert no such right.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "CANDIDA (with infinite reproach).", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "You don't know!", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Oh, James, James!", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "(To Eugene, musingly.)", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "I wonder do you understand, Eugene!", "para": 8, "sent": 4, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "No: you're too young.", "para": 8, "sent": 5, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Well, I give you leave to stay--to stay and learn.", "para": 8, "sent": 6, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "(She comes away from the hearth and places herself between them.)", "para": 8, "sent": 7, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Now, James: what's the matter?", "para": 8, "sent": 8, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Come: tell me.", "para": 8, "sent": 9, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "MARCHBANKS (whispering tremulously across to him).", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Don't.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Come. Out with it!", "name": "CANDIDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "MORELL (slowly).", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "I meant to prepare your mind carefully, Candida, so as to prevent misunderstanding.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Yes, dear: I am sure you did. But never mind: I shan't misunderstand.", "name": "CANDIDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Well--er--(He hesitates, unable to find the long explanation which he supposed to be available.)", "name": "MORELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Well?", "name": "CANDIDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "MORELL (baldly).", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Eugene declares that you are in love with him.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "MARCHBANKS (frantically).", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "No, no, no, no, never.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "I did not, Mrs. Morell: it's not true.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "I said I loved you, and that he didn't.", "para": 12, "sent": 3, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "I said that I understood you, and that he couldn't.", "para": 12, "sent": 4, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "And it was not after what passed there before the fire that I spoke: it was not, on my word.", "para": 12, "sent": 5, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "It was this morning.", "para": 12, "sent": 6, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "CANDIDA (enlightened).", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "This morning!", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "Yes. (He looks at her, pleading for credence, and then adds, simply) That was what was the matter with my collar.", "name": "MARCHBANKS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "CANDIDA (after a pause; for she does not take in his meaning at once).", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "His collar!", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "(She turns to Morell, shocked.)", "para": 14, "sent": 2, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Oh, James: did you--(she stops)?", "para": 14, "sent": 3, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "MORELL (ashamed).", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "You know, Candida, that I have a temper to struggle with.", "para": 15, "sent": 1, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "And he said (shuddering) that you despised me in your heart.", "para": 15, "sent": 2, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "CANDIDA (turning quickly on Eugene).", "para": 16, "sent": 0, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "Did you say that?", "para": 16, "sent": 1, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "MARCHBANKS (terrified).", "para": 17, "sent": 0, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "No!", "para": 17, "sent": 1, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "CANDIDA (severely).", "para": 18, "sent": 0, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "Then James has just told me a falsehood.", "para": 18, "sent": 1, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "Is that what you mean?", "para": 18, "sent": 2, "present": [0, 1, 2]}, {"u": 70, "kind": "dialogue", "text": "No, no: I--I-- (blurting out the explanation desperately) --it was David's wife. And it wasn't at home: it was when she saw him dancing before all the people.", "name": "MARCHBANKS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 71, "kind": "action", "text": "MORELL (taking the cue with a debater's adroitness).", "para": 19, "sent": 0, "present": [0, 1, 2]}, {"u": 72, "kind": "action", "text": "Dancing before all the people, Candida; and thinking he was moving their hearts by his mission when they were only suffering from--Prossy's complaint.", "para": 19, "sent": 1, "present": [0, 1, 2]}, {"u": 73, "kind": "action", "text": "(She is about to protest: he raises his hand to silence her, exclaiming) Don't try to look indignant, Candida:--", "para": 19, "sent": 2, "present": [0, 1, 2]}, {"u": 74, "kind": "action", "text": "CANDIDA (interjecting).", "para": 20, "sent": 0, "present": [0, 1, 2]}, {"u": 75, "kind": "action", "text": "Try!", "para": 20, "sent": 1, "present": [0, 1, 2]}, {"u": 76, "kind": "action", "text": "MORELL (continuing).", "para": 21, "sent": 0, "present": [0, 1, 2]}, {"u": 77, "kind": "action", "text": "Eugene was right.", "para": 21, "sent": 1, "present": [0, 1, 2]}, {"u": 78, "kind": "action", "text": "As you told me a few hours after, he is always right.", "para": 21, "sent": 2, "present": [0, 1, 2]}, {"u": 79, "kind": "action", "text": "He said nothing that you did not say far better yourself.", "para": 21, "sent": 3, "present": [0, 1, 2]}, {"u": 80, "kind": "action", "text": "He is the poet, who sees everything; and I am the poor parson, who understands nothing.", "para": 21, "sent": 4, "present": [0, 1, 2]}, {"u": 81, "kind": "action", "text": "CANDIDA (remorsefully).", "para": 22, "sent": 0, "present": [0, 1, 2]}, {"u": 82, "kind": "action", "text": "Do you mind what is said by a foolish boy, because I said something like it again in jest?", "para": 22, "sent": 1, "present": [0, 1, 2]}, {"u": 83, "kind": "dialogue", "text": "That foolish boy can speak with the inspiration of a child and the cunning of a serpent. He has claimed that you belong to him and not to me; and, rightly or wrongly, I have come to fear that it may be true. I will not go about tortured with doubts and suspicions. I will not live with you and keep a secret from you. I will not suffer the intolerable degradation of jealousy. We have agreed--he and I--that you shall choose between us now. I await your decision.", "name": "MORELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 84, "kind": "action", "text": "CANDIDA (slowly recoiling a step, her heart hardened by his rhetoric in spite of the sincere feeling behind it).", "para": 23, "sent": 0, "present": [0, 1, 2]}, {"u": 85, "kind": "action", "text": "Oh!", "para": 23, "sent": 1, "present": [0, 1, 2]}, {"u": 86, "kind": "action", "text": "I am to choose, am I?", "para": 23, "sent": 2, "present": [0, 1, 2]}, {"u": 87, "kind": "action", "text": "I suppose it is quite settled that I must belong to one or the other.", "para": 23, "sent": 3, "present": [0, 1, 2]}, {"u": 88, "kind": "action", "text": "MORELL (firmly).", "para": 24, "sent": 0, "present": [0, 1, 2]}, {"u": 89, "kind": "action", "text": "Quite.", "para": 24, "sent": 1, "present": [0, 1, 2]}, {"u": 90, "kind": "action", "text": "You must choose definitely.", "para": 24, "sent": 2, "present": [0, 1, 2]}, {"u": 91, "kind": "action", "text": "MARCHBANKS (anxiously).", "para": 25, "sent": 0, "present": [0, 1, 2]}, {"u": 92, "kind": "action", "text": "Morell: you don't understand.", "para": 25, "sent": 1, "present": [0, 1, 2]}, {"u": 93, "kind": "action", "text": "She means that she belongs to herself.", "para": 25, "sent": 2, "present": [0, 1, 2]}, {"u": 94, "kind": "action", "text": "CANDIDA (turning on him).", "para": 26, "sent": 0, "present": [0, 1, 2]}, {"u": 95, "kind": "action", "text": "I mean that and a good deal more, Master Eugene, as you will both find out presently.", "para": 26, "sent": 1, "present": [0, 1, 2]}, {"u": 96, "kind": "action", "text": "And pray, my lords and masters, what have you to offer for my choice?", "para": 26, "sent": 2, "present": [0, 1, 2]}, {"u": 97, "kind": "action", "text": "I am up for auction, it seems.", "para": 26, "sent": 3, "present": [0, 1, 2]}, {"u": 98, "kind": "action", "text": "What do you bid, James?", "para": 26, "sent": 4, "present": [0, 1, 2]}, {"u": 99, "kind": "action", "text": "MORELL (reproachfully).", "para": 27, "sent": 0, "present": [0, 1, 2]}, {"u": 100, "kind": "action", "text": "Cand-- (He breaks down: his eyes and throat fill with tears: the orator becomes the wounded animal.)", "para": 27, "sent": 1, "present": [0, 1, 2]}, {"u": 101, "kind": "action", "text": "I can't speak--", "para": 27, "sent": 2, "present": [0, 1, 2]}, {"u": 102, "kind": "action", "text": "CANDIDA (impulsively going to him).", "para": 28, "sent": 0, "present": [0, 1, 2]}, {"u": 103, "kind": "action", "text": "Ah, dearest--", "para": 28, "sent": 1, "present": [0, 1, 2]}, {"u": 104, "kind": "action", "text": "MARCHBANKS (in wild alarm).", "para": 29, "sent": 0, "present": [0, 1, 2]}, {"u": 105, "kind": "action", "text": "Stop: it's not fair.", "para": 29, "sent": 1, "present": [0, 1, 2]}, {"u": 106, "kind": "action", "text": "You mustn't show her that you suffer, Morell.", "para": 29, "sent": 2, "present": [0, 1, 2]}, {"u": 107, "kind": "action", "text": "I am on the rack, too; but I am not crying.", "para": 29, "sent": 3, "present": [0, 1, 2]}, {"u": 108, "kind": "action", "text": "MORELL (rallying all his forces).", "para": 30, "sent": 0, "present": [0, 1, 2]}, {"u": 109, "kind": "action", "text": "Yes: you are right.", "para": 30, "sent": 1, "present": [0, 1, 2]}, {"u": 110, "kind": "action", "text": "It is not for pity that I am bidding.", "para": 30, "sent": 2, "present": [0, 1, 2]}, {"u": 111, "kind": "action", "text": "(He disengages himself from Candida.)", "para": 30, "sent": 3, "present": [0, 1, 2]}, {"u": 112, "kind": "action", "text": "CANDIDA (retreating, chilled).", "para": 31, "sent": 0, "present": [0, 1, 2]}, {"u": 113, "kind": "action", "text": "I beg your pardon, James; I did not mean to touch you.", "para": 31, "sent": 1, "present": [0, 1, 2]}, {"u": 114, "kind": "action", "text": "I am waiting to hear your bid.", "para": 31, "sent": 2, "present": [0, 1, 2]}, {"u": 115, "kind": "action", "text": "MORELL (with proud humility).", "para": 32, "sent": 0, "present": [0, 1, 2]}, {"u": 116, "kind": "action", "text": "I have nothing to offer you but my strength for your defence, my honesty of purpose for your surety, my ability and industry for your livelihood, and my authority and position for your dignity.", "para": 32, "sent": 1, "present": [0, 1, 2]}, {"u": 117, "kind": "action", "text": "That is all it becomes a man to offer to a woman.", "para": 32, "sent": 2, "present": [0, 1, 2]}, {"u": 118, "kind": "action", "text": "CANDIDA (quite quietly).", "para": 33, "sent": 0, "present": [0, 1, 2]}, {"u": 119, "kind": "action", "text": "And you, Eugene?", "para": 33, "sent": 1, "present": [0, 1, 2]}, {"u": 120, "kind": "action", "text": "What do you offer?", "para": 33, "sent": 2, "present": [0, 1, 2]}, {"u": 121, "kind": "dialogue", "text": "My weakness! my desolation! my heart's need!", "name": "MARCHBANKS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 122, "kind": "action", "text": "CANDIDA (impressed).", "para": 34, "sent": 0, "present": [0, 1, 2]}, {"u": 123, "kind": "action", "text": "That's a good bid, Eugene.", "para": 34, "sent": 1, "present": [0, 1, 2]}, {"u": 124, "kind": "action", "text": "Now I know how to make my choice.", "para": 34, "sent": 2, "present": [0, 1, 2]}]}