{"scene_id": "pt_fan_20", "source": "/home/user/screenwrite-analyzers/data/analyzers/pdtrain/scenes/pt_fan_20.fountain", "heading": "INT. FAN - CONTINUOUS", "cast": [{"id": 0, "name": "LORD WINDERMERE", "names": ["LORD WINDERMERE", "LADY WINDERMERE"], "gender": "f", "first": 2, "spoke": 13}, {"id": 1, "name": "LORD DARLINGTON", "names": ["LORD DARLINGTON"], "gender": "?", "first": 2, "spoke": 6}, {"id": 2, "name": "CECIL GRAHAM", "names": ["CECIL GRAHAM"], "gender": "?", "first": 5, "spoke": 6}, {"id": 3, "name": "LORD AUGUSTUS", "names": ["LORD AUGUSTUS"], "gender": "?", "first": 15, "spoke": 1}, {"id": 4, "name": "MRS. ERLYNNE", "names": ["MRS. ERLYNNE"], "gender": "?", "first": 41, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. FAN - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Up by door .", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "dialogue", "text": "I am really off now, Lord Darlington. I am sorry you are leaving England so soon. Pray call on us when you come back! My wife and I will be charmed to see you!", "name": "LORD WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 3, "kind": "action", "text": "Upstage with LORD WINDERMERE.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 4, "kind": "dialogue", "text": "I am afraid I shall be away for many years. Good-night!", "name": "LORD DARLINGTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "Arthur!", "name": "CECIL GRAHAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "What?", "name": "LORD WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "I want to speak to you for a moment. No, do come!", "name": "CECIL GRAHAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Putting on his coat .", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "I can\u2019t\u2014I\u2019m off!", "name": "LORD WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "It is something very particular. It will interest you enormously.", "name": "CECIL GRAHAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Smiling .", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "It is some of your nonsense, Cecil.", "name": "LORD WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "It isn\u2019t! It isn\u2019t really.", "name": "CECIL GRAHAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Going to him .", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "My dear fellow, you mustn\u2019t go yet. I have a lot to talk to you about. And Cecil has something to show you.", "name": "LORD AUGUSTUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Walking over .", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Well, what is it?", "name": "LORD WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Darlington has got a woman here in his rooms. Here is her fan. Amusing, isn\u2019t it?", "name": "CECIL GRAHAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "A pause .", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Good God!", "name": "LORD WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Seizes the fan \u2014DUMBY rises .", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "What is the matter?", "name": "CECIL GRAHAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Lord Darlington!", "name": "LORD WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Turning round .", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Yes!", "name": "LORD DARLINGTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "What is my wife\u2019s fan doing here in your rooms? Hands off, Cecil. Don\u2019t touch me.", "name": "LORD WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Your wife\u2019s fan?", "name": "LORD DARLINGTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Yes, here it is!", "name": "LORD WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Walking towards him .", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "I don\u2019t know!", "name": "LORD DARLINGTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "You must know. I demand an explanation. Don\u2019t hold me, you fool.", "name": "LORD WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "To CECIL GRAHAM.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Aside .", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "She is here after all!", "name": "LORD DARLINGTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Speak, sir! Why is my wife\u2019s fan here? Answer me! By God! I\u2019ll search your rooms, and if my wife\u2019s here, I\u2019ll\u2014", "name": "LORD WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Moves .", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "You shall not search my rooms. You have no right to do so. I forbid you!", "name": "LORD DARLINGTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "You scoundrel! I\u2019ll not leave your room till I have searched every corner of it! What moves behind that curtain?", "name": "LORD WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Rushes towards the curtain C.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Enters behind R.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Lord Windermere!", "name": "MRS. ERLYNNE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Mrs. Erlynne!", "name": "LORD WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Every one starts and turns round .", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "LADY WINDERMERE slips out from behind the curtain and glides from the room L.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "I am afraid I took your wife\u2019s fan in mistake for my own, when I was leaving your house to-night. I am so sorry.", "name": "MRS. ERLYNNE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Takes fan from him .", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "LORD WINDERMERE looks at her in contempt .", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "LORD DARLINGTON in mingled astonishment and anger .", "para": 16, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "LORD AUGUSTUS turns away .", "para": 16, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "The other men smile at each other .", "para": 16, "sent": 4, "present": [0, 1, 2, 3, 4]}]}