{"scene_id": "pt_fan_7", "source": "/home/user/screenwrite-analyzers/data/analyzers/pdtrain/scenes/pt_fan_7.fountain", "heading": "INT. FAN - CONTINUOUS", "cast": [{"id": 0, "name": "LADY WINDERMERE", "names": ["LADY WINDERMERE", "LORD WINDERMERE"], "gender": "?", "first": 1, "spoke": 17}, {"id": 1, "name": "PARKER", "names": ["PARKER"], "gender": "?", "first": 11, "spoke": 3}, {"id": 2, "name": "DUCHESS OF BERWICK", "names": ["DUCHESS OF BERWICK"], "gender": "?", "first": 40, "spoke": 4}, {"id": 3, "name": "LADY AGATHA", "names": ["LADY AGATHA"], "gender": "?", "first": 40, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. FAN - CONTINUOUS", "present": []}, {"u": 1, "kind": "dialogue", "text": "Arthur, if that woman comes here, I shall insult her.", "name": "LADY WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 2, "kind": "dialogue", "text": "Margaret, don\u2019t say that.", "name": "LORD WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 3, "kind": "dialogue", "text": "I mean it.", "name": "LADY WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 4, "kind": "dialogue", "text": "Child, if you did such a thing, there\u2019s not a woman in London who wouldn\u2019t pity you.", "name": "LORD WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 5, "kind": "dialogue", "text": "There is not a good woman in London who would not applaud me. We have been too lax. We must make an example. I propose to begin to-night.", "name": "LADY WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 6, "kind": "action", "text": "Picking up fan .", "para": 0, "sent": 0, "present": [0]}, {"u": 7, "kind": "dialogue", "text": "Yes, you gave me this fan to-day; it was your birthday present. If that woman crosses my threshold, I shall strike her across the face with it.", "name": "LADY WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 8, "kind": "dialogue", "text": "Margaret, you couldn\u2019t do such a thing.", "name": "LORD WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 9, "kind": "dialogue", "text": "You don\u2019t know me!", "name": "LADY WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 10, "kind": "action", "text": "Moves R.", "para": 1, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "Enter PARKER.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Parker!", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Yes, my lady.", "name": "PARKER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "I shall dine in my own room. I don\u2019t want dinner, in fact. See that everything is ready by half-past ten. And, Parker, be sure you pronounce the names of the guests very distinctly to-night. Sometimes you speak so fast that I miss them. I am particularly anxious to hear the names quite clearly, so as to make no mistake. You understand, Parker?", "name": "LADY WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Yes, my lady.", "name": "PARKER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "That will do!", "name": "LADY WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Exit PARKER C.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "[ Speaking to LORD WINDERMERE.] Arthur, if that woman comes here\u2014I warn you\u2014", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Margaret, you\u2019ll ruin us!", "name": "LORD WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Us! From this moment my life is separate from yours. But if you wish to avoid a public scandal, write at once to this woman, and tell her that I forbid her to come here!", "name": "LADY WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "I will not\u2014I cannot\u2014she must come!", "name": "LORD WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Then I shall do exactly as I have said.", "name": "LADY WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Goes R.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "You leave me no choice.", "name": "LADY WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Exit R.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Calling after her .", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Margaret! Margaret!", "name": "LORD WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "A pause .", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "My God! What shall I do? I dare not tell her who this woman really is. The shame would kill her.", "name": "LORD WINDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Sinks down into a chair and buries his face in his hands .", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "* * * * *", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Drawing-room in Lord Windermere\u2019s house .", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Door R.U. opening into ball-room , where band is playing .", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Door L. through which guests are entering .", "para": 12, "sent": 2, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Door L.U. opens on to illuminated terrace .", "para": 12, "sent": 3, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Palms , flowers , and brilliant lights .", "para": 12, "sent": 4, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Room crowded with guests .", "para": 12, "sent": 5, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Lady Windermere is receiving them .", "para": 12, "sent": 6, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Up C.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "So strange Lord Windermere isn\u2019t here. Mr. Hopper is very late, too. You have kept those five dances for him, Agatha?", "name": "DUCHESS OF BERWICK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Comes down .", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Yes, mamma.", "name": "LADY AGATHA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Sitting on sofa .", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Just let me see your card. I\u2019m so glad Lady Windermere has revived cards.\u2014They\u2019re a mother\u2019s only safeguard. You dear simple little thing!", "name": "DUCHESS OF BERWICK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Scratches out two names .", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "No nice girl should ever waltz with such particularly younger sons! It looks so fast! The last two dances you might pass on the terrace with Mr. Hopper.", "name": "DUCHESS OF BERWICK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Enter MR. DUMBY and LADY PLYMDALE from the ball-room .", "para": 17, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Yes, mamma.", "name": "LADY AGATHA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Fanning herself .", "para": 18, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "The air is so pleasant there.", "name": "DUCHESS OF BERWICK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Mrs. Cowper-Cowper. Lady Stutfield. Sir James Royston. Mr. Guy Berkeley.", "name": "PARKER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}