{"scene_id": "pt_ghosts_22", "source": "/home/user/screenwrite-analyzers/data/analyzers/pdtrain/scenes/pt_ghosts_22.fountain", "heading": "INT. GHOSTS - CONTINUOUS", "cast": [{"id": 0, "name": "OSWALD", "names": ["OSWALD"], "gender": "?", "first": 1, "spoke": 16}, {"id": 1, "name": "MRS. ALVING", "names": ["MRS. ALVING"], "gender": "?", "first": 2, "spoke": 14}, {"id": 2, "name": "REGINA", "names": ["REGINA"], "gender": "?", "first": 7, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. GHOSTS - CONTINUOUS", "present": []}, {"u": 1, "kind": "dialogue", "text": "Is that true, mother? Do you mean it?", "name": "OSWALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 2, "kind": "dialogue", "text": "How? What?", "name": "MRS. ALVING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 3, "kind": "dialogue", "text": "That you couldn't deny me anything.", "name": "OSWALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 4, "kind": "dialogue", "text": "My dear Oswald--", "name": "MRS. ALVING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "Hush!", "name": "OSWALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Brings a tray with a half-bottle of champagne and two glasses, which she sets on the table.", "para": 0, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Shall I open it?", "name": "REGINA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "No, thanks. I will do it myself.", "name": "OSWALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "REGINA goes out again.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Sits down by the table.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "What was it you meant--that I mustn't deny you?", "name": "MRS. ALVING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Busy opening the bottle.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "First let us have a glass--or two.", "name": "OSWALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "The cork pops; he pours wine into one glass, and is about to pour it into the other.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Holding her hand over it.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Thanks; not for me.", "name": "MRS. ALVING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Oh! won't you? Then I will!", "name": "OSWALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "He empties the glass, fills, and empties it again; then he sits down by the table.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "In expectancy.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Well?", "name": "MRS. ALVING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Without looking at her.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Tell me--I thought you and Pastor Manders seemed so odd--so quiet--at dinner to-day.", "name": "OSWALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Did you notice it?", "name": "MRS. ALVING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Yes. H'm--", "name": "OSWALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "After a short silence.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Tell me: what do you think of Regina?", "name": "OSWALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "What do I think?", "name": "MRS. ALVING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Yes; isn't she splendid?", "name": "OSWALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "My dear Oswald, you don't know her as I do--", "name": "MRS. ALVING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Well?", "name": "OSWALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Regina, unfortunately, was allowed to stay at home too long. I ought to have taken her earlier into my house.", "name": "MRS. ALVING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Yes, but isn't she splendid to look at, mother?", "name": "OSWALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "He fills his glass.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Regina has many serious faults--", "name": "MRS. ALVING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Oh, what does that matter?", "name": "OSWALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "He drinks again.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "But I am fond of her, nevertheless, and I am responsible for her. I wouldn't for all the world have any harm happen to her.", "name": "MRS. ALVING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Springs up.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Mother, Regina is my only salvation!", "name": "OSWALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Rising.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "What do you mean by that?", "name": "MRS. ALVING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "I cannot go on bearing all this anguish of soul alone.", "name": "OSWALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Have you not your mother to share it with you?", "name": "MRS. ALVING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Yes; that's what I thought; and so I came home to you. But that will not do. I see it won't do. I cannot endure my life here.", "name": "OSWALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Oswald!", "name": "MRS. ALVING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}