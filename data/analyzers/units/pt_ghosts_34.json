{"scene_id": "pt_ghosts_34", "source": "/home/user/screenwrite-analyzers/data/analyzers/pdtrain/scenes/pt_ghosts_34.fountain", "heading": "INT. GHOSTS - CONTINUOUS", "cast": [{"id": 0, "name": "OSWALD", "names": ["OSWALD"], "gender": "?", "first": 1, "spoke": 9}, {"id": 1, "name": "MRS. ALVING", "names": ["MRS. ALVING", "ALVING"], "gender": "?", "first": 3, "spoke": 14}], "units": [{"u": 0, "kind": "heading", "text": "INT. GHOSTS - CONTINUOUS", "present": []}, {"u": 1, "kind": "dialogue", "text": "Do not leave me! Where are you going?", "name": "OSWALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 2, "kind": "action", "text": "In the hall.", "para": 0, "sent": 0, "present": [0]}, {"u": 3, "kind": "dialogue", "text": "To fetch the doctor, Oswald! Let me pass!", "name": "MRS. ALVING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "Also outside.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "You shall not go out. And no one shall come in.", "name": "OSWALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "The locking of a door is heard.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Comes in again.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Oswald! Oswald--my child!", "name": "MRS. ALVING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Follows her.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Have you a mother's heart for me--and yet can see me suffer from this unutterable dread?", "name": "OSWALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "After a moment's silence, commands herself, and says:.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Here is my hand upon it.", "name": "MRS. ALVING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Will you--?", "name": "OSWALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "If it should ever be necessary. But it will never be necessary. No, no; it is impossible.", "name": "MRS. ALVING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Well, let us hope so. And let us live together as long as we can. Thank you, mother.", "name": "OSWALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He seats himself in the arm-chair which MRS. ALVING has moved to the sofa.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Day is breaking.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "The lamp is still burning on the table.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Drawing near cautiously.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Do you feel calm now?", "name": "MRS. ALVING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Yes.", "name": "OSWALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Bending over him.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "It has been a dreadful fancy of yours, Oswald--nothing but a fancy. All this excitement has been too much for you. But now you shall have a long rest; at home with your mother, my own bless\u00ebd boy. Everything you point to you shall have, just as when you were a little child.--There now. The crisis is over. You see how easily it passed! Oh, I was sure it would.--And do you see, Oswald, what a lovely day we are going to have? Brilliant sunshine! Now you can really see your home.", "name": "MRS. ALVING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She goes to the table and puts out the lamp.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Sunrise.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "The glacier and the snow-peaks in the background glow in the morning light.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Sits in the arm-chair with his back towards the landscape, without moving.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Suddenly he says:.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Mother, give me the sun.", "name": "OSWALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "By the table, starts and looks at him.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "What do you say?", "name": "MRS. ALVING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Repeats, in a dull, toneless voice.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "The sun. The sun.", "name": "OSWALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Goes to him.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Oswald, what is the matter with you?", "name": "MRS. ALVING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Seems to shrink together to the chair; all his muscles relax; his face is expressionless, his eyes have a glassy stare.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Quivering with terror.", "para": 15, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "What is this?", "name": "MRS. ALVING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Shrieks.", "para": 16, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Oswald! what is the matter with you?", "name": "MRS. ALVING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Falls on her knees beside him and shakes him.", "para": 17, "sent": 0, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Oswald! Oswald! look at me! Don't you know me?", "name": "MRS. ALVING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Tonelessly as before.", "para": 18, "sent": 0, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "The sun.--The sun.", "name": "OSWALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "Springs up in despair, entwines her hands in her hair and shrieks.", "para": 19, "sent": 0, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "I cannot bear it!", "name": "MRS. ALVING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Whispers, as though petrified.", "para": 20, "sent": 0, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "; I cannot bear it! Never!", "name": "MRS. ALVING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "Suddenly.", "para": 21, "sent": 0, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Where has he got them?", "name": "MRS. ALVING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}