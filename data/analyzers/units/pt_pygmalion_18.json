{"scene_id": "pt_pygmalion_18", "source": "/home/user/screenwrite-analyzers/data/analyzers/pdtrain/scenes/pt_pygmalion_18.fountain", "heading": "INT. PYGMALION - CONTINUOUS", "cast": [{"id": 0, "name": "LIZA", "names": ["LIZA"], "gender": "m", "first": 1, "spoke": 9}, {"id": 1, "name": "FREDDY", "names": ["FREDDY"], "gender": "f", "first": 2, "spoke": 1}, {"id": 2, "name": "MRS", "names": ["MRS"], "gender": "?", "first": 8, "spoke": 8}, {"id": 3, "name": "HIGGINS", "names": ["HIGGINS", "MRS. HIGGINS"], "gender": "f", "first": 6, "spoke": 1}, {"id": 4, "name": "PICKERING", "names": ["PICKERING"], "gender": "?", "first": 20, "spoke": 2}, {"id": 5, "name": "CLARA", "names": ["CLARA"], "gender": "f", "first": 35, "spoke": 2}, {"id": 6, "name": "MRS. EYNSFORD HILL", "names": ["MRS. EYNSFORD HILL"], "gender": "?", "first": 32, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. PYGMALION - CONTINUOUS", "present": []}, {"u": 1, "kind": "dialogue", "text": "You see, it\u2019s like this. If a man has a bit of a conscience, it always takes him when he\u2019s sober; and then it makes him low-spirited. A drop of booze just takes that off and makes him happy.", "name": "LIZA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 2, "kind": "action", "text": "To Freddy, who is in convulsions of suppressed laughter.", "para": 0, "sent": 0, "present": [0, 1]}, {"u": 3, "kind": "dialogue", "text": "Here! what are you sniggering at?", "name": "LIZA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 4, "kind": "dialogue", "text": "The new small talk. You do it so awfully well.", "name": "FREDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "If I was doing it proper, what was you laughing at?", "name": "LIZA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "To Higgins.", "para": 1, "sent": 0, "present": [0, 1, 3]}, {"u": 7, "kind": "dialogue", "text": "Have I said anything I oughtn\u2019t?", "name": "LIZA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 8, "kind": "dialogue", "text": "HIGGINS", "name": "MRS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "interposing.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Not at all, Miss Doolittle.", "name": "MRS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Well, that\u2019s a mercy, anyhow.", "name": "LIZA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Expansively.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "What I always say is\u2014", "name": "LIZA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "HIGGINS [rising and looking at his watch] Ahem!", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "LIZA [looking round at him; taking the hint; and rising] Well: I must go. [They all rise.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Freddy goes to the door].", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "So pleased to have met you.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Good-bye. [She shakes hands with Mrs. Higgins].", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Good-bye.", "name": "MRS. HIGGINS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Good-bye, Colonel Pickering.", "name": "LIZA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Good-bye, Miss Doolittle.", "name": "PICKERING", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "They shake hands.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "LIZA [nodding to the others] Good-bye, all.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "FREDDY [opening the door for her] Are you walking across the Park, Miss Doolittle?", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "If so\u2014", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Walk! Not bloody likely.", "name": "LIZA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Sensation.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "I am going in a taxi.", "name": "LIZA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "She goes out.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Pickering gasps and sits down.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Freddy goes out on the balcony to catch another glimpse of Eliza.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "EYNSFORD HILL", "name": "MRS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 6]}, {"u": 33, "kind": "action", "text": "suffering from shock.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 6]}, {"u": 34, "kind": "dialogue", "text": "Well, I really can\u2019t get used to the new ways.", "name": "MRS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 6]}, {"u": 35, "kind": "action", "text": "CLARA [throwing herself discontentedly into the Elizabethan chair].", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "Oh, it\u2019s all right, mamma, quite right.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "People will think we never go anywhere or see anybody if you are so old-fashioned.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "dialogue", "text": "I daresay I am very old-fashioned; but I do hope you won\u2019t begin using that expression, Clara. I have got accustomed to hear you talking about men as rotters, and calling everything filthy and beastly; though I do think it horrible and unladylike. But this last is really too much. Don\u2019t you think so, Colonel Pickering?", "name": "MRS. EYNSFORD HILL", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "Don\u2019t ask me. I\u2019ve been away in India for several years; and manners have changed so much that I sometimes don\u2019t know whether I\u2019m at a respectable dinner-table or in a ship\u2019s forecastle.", "name": "PICKERING", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "It\u2019s all a matter of habit. There\u2019s no right or wrong in it. Nobody means anything by it. And it\u2019s so quaint, and gives such a smart emphasis to things that are not in themselves very witty. I find the new small talk delightful and quite innocent.", "name": "CLARA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "dialogue", "text": "EYNSFORD HILL", "name": "MRS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "rising.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "dialogue", "text": "Well, after that, I think it\u2019s time for us to go.", "name": "MRS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "Pickering and Higgins rise.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "action", "text": "CLARA [rising] Oh yes: we have three at homes to go to still.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "action", "text": "Good-bye, Mrs. Higgins.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "Good-bye, Colonel Pickering.", "para": 16, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "Good-bye, Professor Higgins.", "para": 16, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "action", "text": "HIGGINS [coming grimly at her from the divan, and accompanying her to the door] Good-bye.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "action", "text": "Be sure you try on that small talk at the three at-homes.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "action", "text": "Don\u2019t be nervous about it.", "para": 17, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "action", "text": "Pitch it in strong.", "para": 17, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "action", "text": "CLARA [all smiles] I will.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "action", "text": "Good-bye.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "action", "text": "Such nonsense, all this early Victorian prudery!", "para": 18, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "action", "text": "HIGGINS [tempting her] Such damned nonsense!", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "dialogue", "text": "Such bloody nonsense!", "name": "CLARA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "dialogue", "text": "EYNSFORD HILL", "name": "MRS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 59, "kind": "action", "text": "convulsively.", "para": 20, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 60, "kind": "dialogue", "text": "Clara!", "name": "MRS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}