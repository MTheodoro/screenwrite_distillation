{"scene_id": "pt_seagull_13", "source": "/home/user/screenwrite-analyzers/data/analyzers/pdtrain/scenes/pt_seagull_13.fountain", "heading": "INT. SEAGULL - CONTINUOUS", "cast": [{"id": 0, "name": "TRIGORIN", "names": ["TRIGORIN"], "gender": "?", "first": 1, "spoke": 11}, {"id": 1, "name": "NINA", "names": ["NINA"], "gender": "?", "first": 2, "spoke": 6}, {"id": 2, "name": "ARKADINA", "names": ["ARKADINA"], "gender": "?", "first": 19, "spoke": 7}, {"id": 3, "name": "SORIN", "names": ["SORIN"], "gender": "?", "first": 19, "spoke": 3}, {"id": 4, "name": "JACOB", "names": ["JACOB"], "gender": "?", "first": 19, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. SEAGULL - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Holding out her closed hand to TRIGORIN.", "para": 0, "sent": 0, "present": [0]}, {"u": 2, "kind": "dialogue", "text": "Is it odd or even?", "name": "NINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 3, "kind": "dialogue", "text": "Even.", "name": "TRIGORIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "With a sigh.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "No, it is odd. I had only one pea in my hand. I wanted to see whether I was to become an actress or not. If only some one would advise me what to do!", "name": "NINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "One cannot give advice in a case like this.", "name": "TRIGORIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "A pause.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "We shall soon part, perhaps never to meet again. I should like you to accept this little medallion as a remembrance of me. I have had your initials engraved on it, and on this side is the name of one of your books: \u201cDays and Nights.\u201d", "name": "NINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "How sweet of you!", "name": "TRIGORIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He kisses the medallion.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "It is a lovely present.", "name": "TRIGORIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Think of me sometimes.", "name": "NINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "I shall never forget you. I shall always remember you as I saw you that bright day--do you recall it?--a week ago, when you wore your light dress, and we talked together, and the white seagull lay on the bench beside us.", "name": "TRIGORIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Lost in thought.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Yes, the sea-gull.", "name": "NINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "A pause.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "I beg you to let me see you alone for two minutes before you go.", "name": "NINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She goes out to the left.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "At the same moment ARKADINA comes in from the right, followed by SORIN in a long coat, with his orders on his breast, and by JACOB, who is busy packing.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Stay here at home, you poor old man. How could you pay visits with that rheumatism of yours?", "name": "ARKADINA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "To TRIGORIN.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Who left the room just now, was it Nina?", "name": "ARKADINA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Yes.", "name": "TRIGORIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "I beg your pardon; I am afraid we interrupted you.", "name": "ARKADINA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "She sits down.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "I think everything is packed. I am absolutely exhausted.", "name": "ARKADINA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Reading the inscription on the medallion.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "\u201cDays and Nights, page 121, lines 11 and 12.\u201d", "name": "TRIGORIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Clearing the table.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Shall I pack your fishing-rods, too, sir?", "name": "JACOB", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Yes, I shall need them, but you can give my books away.", "name": "TRIGORIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Very well, sir.", "name": "JACOB", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "To himself.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Page 121, lines 11 and 12.", "name": "TRIGORIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "To ARKADINA.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Have we my books here in the house?", "name": "TRIGORIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Yes, they are in my brother\u2019s library, in the corner cupboard.", "name": "ARKADINA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Page 121--", "name": "TRIGORIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "He goes out.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "You are going away, and I shall be lonely without you.", "name": "SORIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "What would you do in town?", "name": "ARKADINA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Oh, nothing in particular, but somehow--", "name": "SORIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "He laughs.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "They are soon to lay the corner-stone of the new court-house here. How I should like to leap out of this minnow-pond, if but for an hour or two! I am tired of lying here like an old cigarette stump. I have ordered the carriage for one o\u2019clock. We can go away together.", "name": "SORIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "After a pause.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "No, you must stay here. Don\u2019t be lonely, and don\u2019t catch cold. Keep an eye on my boy. Take good care of him; guide him along the proper paths.", "name": "ARKADINA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}