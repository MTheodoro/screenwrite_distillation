{"scene_id": "pt_seagull_19", "source": "/home/user/screenwrite-analyzers/data/analyzers/pdtrain/scenes/pt_seagull_19.fountain", "heading": "INT. SEAGULL - CONTINUOUS", "cast": [{"id": 0, "name": "MASHA", "names": ["MASHA"], "gender": "?", "first": 1, "spoke": 12}, {"id": 1, "name": "MEDVIEDENKO", "names": ["MEDVIEDENKO"], "gender": "?", "first": 2, "spoke": 11}, {"id": 2, "name": "PAULINA", "names": ["PAULINA"], "gender": "?", "first": 26, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. SEAGULL - CONTINUOUS", "present": []}, {"u": 1, "kind": "dialogue", "text": "There is no one here. His old uncle is forever asking for Constantine, and can\u2019t live without him for an instant.", "name": "MASHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 2, "kind": "dialogue", "text": "He dreads being left alone.", "name": "MEDVIEDENKO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 3, "kind": "action", "text": "Listening to the wind.", "para": 0, "sent": 0, "present": [0, 1]}, {"u": 4, "kind": "dialogue", "text": "This is a wild night. We have had this storm for two days.", "name": "MEDVIEDENKO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Turning up the lamp.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "The waves on the lake are enormous.", "name": "MASHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "It is very dark in the garden. Do you know, I think that old theatre ought to be knocked down. It is still standing there, naked and hideous as a skeleton, with the curtain flapping in the wind. I thought I heard a voice weeping in it as I passed there last night.", "name": "MEDVIEDENKO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "What an idea!", "name": "MASHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "A pause.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Come home with me, Masha.", "name": "MEDVIEDENKO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Shaking her head.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I shall spend the night here.", "name": "MASHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Imploringly.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Do come, Masha. The baby must be hungry.", "name": "MEDVIEDENKO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Nonsense, Matriona will feed it.", "name": "MASHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "A pause.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "It is a pity to leave him three nights without his mother.", "name": "MEDVIEDENKO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "You are getting too tiresome. You used sometimes to talk of other things besides home and the baby, home and the baby. That is all I ever hear from you now.", "name": "MASHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Come home, Masha.", "name": "MEDVIEDENKO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "You can go home if you want to.", "name": "MASHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Your father won\u2019t give me a horse.", "name": "MEDVIEDENKO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Yes, he will; ask him.", "name": "MASHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "I think I shall. Are you coming home to-morrow?", "name": "MEDVIEDENKO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Yes, yes, to-morrow.", "name": "MASHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "She takes snuff.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "TREPLIEFF and PAULINA come in.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "TREPLIEFF is carrying some pillows and a blanket, and PAULINA is carrying sheets and pillow cases.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "They lay them on the divan, and TREPLIEFF goes and sits down at his desk.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Who is that for, mother?", "name": "MASHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Mr. Sorin asked to sleep in Constantine\u2019s room to-night.", "name": "PAULINA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Let me make the bed.", "name": "MASHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "She makes the bed.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "PAULINA goes up to the desk and looks at the manuscripts lying on it. [A pause.]", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Well, I am going. Good-bye, Masha.", "name": "MEDVIEDENKO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "He kisses his wife\u2019s hand.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Good-bye, mother.", "name": "MEDVIEDENKO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "He tries to kiss his mother-in-law\u2019s hand.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Crossly.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Be off, in God\u2019s name!", "name": "PAULINA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "TREPLIEFF shakes hands with him in silence, and MEDVIEDENKO goes out.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Looking at the manuscripts.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "No one ever dreamed, Constantine, that you would one day turn into a real author. The magazines pay you well for your stories.", "name": "PAULINA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "She strokes his hair.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "You have grown handsome, too. Dear, kind Constantine, be a little nicer to my Masha.", "name": "PAULINA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Still making the bed.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Leave him alone, mother.", "name": "MASHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "She is a sweet child.", "name": "PAULINA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "A pause.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "A woman, Constantine, asks only for kind looks. I know that from experience.", "name": "PAULINA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}