{"scene_id": "pt_seagull_24", "source": "/home/user/screenwrite-analyzers/data/analyzers/pdtrain/scenes/pt_seagull_24.fountain", "heading": "INT. SEAGULL - CONTINUOUS", "cast": [{"id": 0, "name": "SHAMRAEFF", "names": ["SHAMRAEFF"], "gender": "?", "first": 1, "spoke": 3}, {"id": 1, "name": "TRIGORIN", "names": ["TRIGORIN"], "gender": "?", "first": 2, "spoke": 4}, {"id": 2, "name": "MASHA", "names": ["MASHA"], "gender": "?", "first": 7, "spoke": 2}, {"id": 3, "name": "TREPLIEFF", "names": ["TREPLIEFF"], "gender": "?", "first": 8, "spoke": 11}, {"id": 4, "name": "ARKADINA", "names": ["ARKADINA"], "gender": "?", "first": 10, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. SEAGULL - CONTINUOUS", "present": []}, {"u": 1, "kind": "dialogue", "text": "We have something here that belongs to you, sir.", "name": "SHAMRAEFF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 2, "kind": "dialogue", "text": "What is it?", "name": "TRIGORIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 3, "kind": "dialogue", "text": "You told me to have the sea-gull stuffed that Mr. Constantine killed some time ago.", "name": "SHAMRAEFF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 4, "kind": "dialogue", "text": "Did I?", "name": "TRIGORIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Thoughtfully.", "para": 0, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "I don\u2019t remember.", "name": "TRIGORIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Sixty-one. One.", "name": "MASHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "TREPLIEFF throws open the window and stands listening.", "para": 1, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "How dark the night is! I wonder what makes me so restless.", "name": "TREPLIEFF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Shut the window, Constantine, there is a draught here.", "name": "ARKADINA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "TREPLIEFF shuts the window.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Ninety-eight.", "name": "MASHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "See, my card is full.", "name": "TRIGORIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Gaily.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Bravo! Bravo!", "name": "ARKADINA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Bravo!", "name": "SHAMRAEFF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Wherever he goes and whatever he does, that man always has good luck.", "name": "ARKADINA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "She gets up.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "And now, come to supper. Our renowned guest did not have any dinner to-day. We can continue our game later.", "name": "ARKADINA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "To her son.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Come, Constantine, leave your writing and come to supper.", "name": "ARKADINA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "I don\u2019t want anything to eat, mother; I am not hungry.", "name": "TREPLIEFF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "As you please.", "name": "ARKADINA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "She wakes SORIN.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Come to supper, Peter.", "name": "ARKADINA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "She takes SHAMRAEFF\u2019S arm.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Let me tell you about my reception in Kharkoff.", "name": "ARKADINA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "PAULINA blows out the candles on the table, then she and DORN roll SORIN\u2019S chair out of the room, and all go out through the door on the left, except TREPLIEFF, who is left alone.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "TREPLIEFF prepares to write.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "He runs his eye over what he has already written.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "I have talked a great deal about new forms of art, but I feel myself gradually slipping into the beaten track.", "name": "TREPLIEFF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "He reads.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "\u201cThe placard cried it from the wall--a pale face in a frame of dusky hair\u201d--cried--frame--that is stupid.", "name": "TREPLIEFF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "He scratches out what he has written.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "I shall begin again from the place where my hero is wakened by the noise of the rain, but what follows must go. This description of a moonlight night is long and stilted. Trigorin has worked out a process of his own, and descriptions are easy for him. He writes that the neck of a broken bottle lying on the bank glittered in the moonlight, and that the shadows lay black under the mill-wheel. There you have a moonlight night before your eyes, but I speak of the shimmering light, the twinkling stars, the distant sounds of a piano melting into the still and scented air, and the result is abominable.", "name": "TREPLIEFF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "A pause.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "The conviction is gradually forcing itself upon me that good literature is not a question of forms new or old, but of ideas that must pour freely from the author\u2019s heart, without his bothering his head about any forms whatsoever.", "name": "TREPLIEFF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "A knock is heard at the window nearest the table.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "What was that?", "name": "TREPLIEFF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "He looks out of the window.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "I can\u2019t see anything.", "name": "TREPLIEFF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "He opens the glass door and looks out into the garden.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "I heard some one run down the steps.", "name": "TREPLIEFF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "He calls.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Who is there?", "name": "TREPLIEFF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "He goes out, and is heard walking quickly along the terrace.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "In a few minutes he comes back with NINA ZARIETCHNAYA.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Oh, Nina, Nina!", "name": "TREPLIEFF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}