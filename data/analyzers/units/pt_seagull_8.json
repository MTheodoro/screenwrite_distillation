{"scene_id": "pt_seagull_8", "source": "/home/user/screenwrite-analyzers/data/analyzers/pdtrain/scenes/pt_seagull_8.fountain", "heading": "INT. SEAGULL - CONTINUOUS", "cast": [{"id": 0, "name": "ARKADINA", "names": ["ARKADINA"], "gender": "?", "first": 1, "spoke": 11}, {"id": 1, "name": "NINA", "names": ["NINA"], "gender": "?", "first": 2, "spoke": 4}, {"id": 2, "name": "SORIN", "names": ["SORIN"], "gender": "?", "first": 4, "spoke": 6}, {"id": 3, "name": "MASHA", "names": ["MASHA"], "gender": "?", "first": 17, "spoke": 3}, {"id": 4, "name": "DORN", "names": ["DORN"], "gender": "?", "first": 25, "spoke": 7}, {"id": 5, "name": "MEDVIEDENKO", "names": ["MEDVIEDENKO"], "gender": "?", "first": 40, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. SEAGULL - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Sits down beside ARKADINA, and embraces her.", "para": 0, "sent": 0, "present": [0]}, {"u": 2, "kind": "dialogue", "text": "I am so happy. I belong to you now.", "name": "NINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 3, "kind": "action", "text": "Sits down in his arm-chair.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 4, "kind": "dialogue", "text": "She looks lovely to-day.", "name": "SORIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "Yes, she has put on her prettiest dress, and looks sweet. That was nice of you.", "name": "ARKADINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "She kisses NINA.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "But we mustn\u2019t praise her too much; we shall spoil her. Where is Trigorin?", "name": "ARKADINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "He is fishing off the wharf.", "name": "NINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "I wonder he isn\u2019t bored.", "name": "ARKADINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "She begins to read again.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "What are you reading?", "name": "NINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "\u201cOn the Water,\u201d by Maupassant.", "name": "ARKADINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She reads a few lines to herself.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "But the rest is neither true nor interesting.", "name": "ARKADINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "She lays down the book.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "I am uneasy about my son. Tell me, what is the matter with him? Why is he so dull and depressed lately? He spends all his days on the lake, and I scarcely ever see him any more.", "name": "ARKADINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "His heart is heavy.", "name": "MASHA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Timidly, to NINA.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Please recite something from his play.", "name": "MASHA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Shrugging her shoulders.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Shall I? Is it so interesting?", "name": "NINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "With suppressed rapture.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "When he recites, his eyes shine and his face grows pale. His voice is beautiful and sad, and he has the ways of a poet.", "name": "MASHA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "SORIN begins to snore.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Pleasant dreams!", "name": "DORN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Peter!", "name": "ARKADINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Eh?", "name": "SORIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Are you asleep?", "name": "ARKADINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Not a bit of it.", "name": "SORIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "A pause.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "You don\u2019t do a thing for your health, brother, but you really ought to.", "name": "ARKADINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "The idea of doing anything for one\u2019s health at sixty-five!", "name": "DORN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "One still wants to live at sixty-five.", "name": "SORIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Crossly.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Ho! Take some camomile tea.", "name": "DORN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "I think a journey to some watering-place would be good for him.", "name": "ARKADINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Why, yes; he might go as well as not.", "name": "DORN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "You don\u2019t understand.", "name": "ARKADINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "There is nothing to understand in this case; it is quite clear.", "name": "DORN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "He ought to give up smoking.", "name": "MEDVIEDENKO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "What nonsense!", "name": "SORIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "A pause.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "No, that is not nonsense. Wine and tobacco destroy the individuality. After a cigar or a glass of vodka you are no longer Peter Sorin, but Peter Sorin plus somebody else. Your ego breaks in two: you begin to think of yourself in the third person.", "name": "DORN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "It is easy for you to condemn smoking and drinking; you have known what life is, but what about me? I have served in the Department of Justice for twenty-eight years, but I have never lived, I have never had any experiences. You are satiated with life, and that is why you have an inclination for philosophy, but I want to live, and that is why I drink my wine for dinner and smoke cigars, and all.", "name": "SORIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "One must take life seriously, and to take a cure at sixty-five and regret that one did not have more pleasure in youth is, forgive my saying so, trifling.", "name": "DORN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}