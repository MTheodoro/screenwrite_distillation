{"scene_id": "pt_superman_18", "source": "/home/user/screenwrite-analyzers/data/analyzers/pdtrain/scenes/pt_superman_18.fountain", "heading": "INT. SUPERMAN - CONTINUOUS", "cast": [{"id": 0, "name": "THE ROWDY SOCIAL-DEMOCRAT", "names": ["THE ROWDY SOCIAL-DEMOCRAT"], "gender": "?", "first": 2, "spoke": 3}, {"id": 1, "name": "THE GOATHERD", "names": ["THE GOATHERD"], "gender": "?", "first": 5, "spoke": 1}, {"id": 2, "name": "MENDOZA", "names": ["MENDOZA"], "gender": "?", "first": 8, "spoke": 10}, {"id": 3, "name": "THE SULKY SOCIAL-DEMOCRAT", "names": ["THE SULKY SOCIAL-DEMOCRAT"], "gender": "?", "first": 10, "spoke": 2}, {"id": 4, "name": "DUVAL", "names": ["DUVAL"], "gender": "?", "first": 15, "spoke": 3}, {"id": 5, "name": "TANNER", "names": ["TANNER"], "gender": "?", "first": 29, "spoke": 3}, {"id": 6, "name": "THE ENGLISH SOCIAL-DEMOCRATS", "names": ["THE ENGLISH SOCIAL-DEMOCRATS"], "gender": "?", "first": 18, "spoke": 1}, {"id": 7, "name": "STRAKER", "names": ["STRAKER"], "gender": "?", "first": 29, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. SUPERMAN - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "derisively.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "dialogue", "text": "Shikespear.", "name": "THE ROWDY SOCIAL-DEMOCRAT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 3, "kind": "action", "text": "A whistle comes from the goatherd on the hill.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "He springs up and points excitedly forward along the road to the north.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "dialogue", "text": "Automobile! Automobile!", "name": "THE GOATHERD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "He rushes down the hill and joins the rest, who all scramble to their feet.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "in ringing tones.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "To arms! Who has the gun?", "name": "MENDOZA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "handing a rifle to Mendoza.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Here.", "name": "THE SULKY SOCIAL-DEMOCRAT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Have the nails been strewn in the road?", "name": "MENDOZA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Two ahnces of em.", "name": "THE ROWDY SOCIAL-DEMOCRAT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Good!", "name": "MENDOZA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "To the Frenchman.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "With me, Duval. If the nails fail, puncture their tires with a bullet.", "name": "MENDOZA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "He gives the rifle to Duval, who follows him up the hill.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Mendoza produces an opera glass.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "The others hurry across to the road and disappear to the north.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 6]}, {"u": 19, "kind": "action", "text": "on the hill, using his glass.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 6]}, {"u": 20, "kind": "dialogue", "text": "Two only, a capitalist and his chauffeur. They look English.", "name": "MENDOZA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 6]}, {"u": 21, "kind": "dialogue", "text": "Angliche! Aoh yess. Cochons!", "name": "DUVAL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 6]}, {"u": 22, "kind": "action", "text": "Handling the rifle.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 6]}, {"u": 23, "kind": "dialogue", "text": "Faut tire, n'est-ce-pas?", "name": "DUVAL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 6]}, {"u": 24, "kind": "dialogue", "text": "No: the nails have gone home. Their tire is down: they stop.", "name": "MENDOZA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 6]}, {"u": 25, "kind": "action", "text": "shouting to the others.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 6]}, {"u": 26, "kind": "dialogue", "text": "Fondez sur eux, nom de Dieu!", "name": "DUVAL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 6]}, {"u": 27, "kind": "action", "text": "rebuking his excitement.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 6]}, {"u": 28, "kind": "dialogue", "text": "Du calme, Duval: keep your hair on. They take it quietly. Let us descend and receive them.", "name": "MENDOZA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 6]}, {"u": 29, "kind": "action", "text": "Mendoza descends, passing behind the fire and coming forward, whilst Tanner and Straker, in their motoring goggles, leather coats, and caps, are led in from the road by brigands.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "dialogue", "text": "Is this the gentleman you describe as your boss? Does he speak English?", "name": "TANNER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "dialogue", "text": "Course he does. Y'don't suppowz we Hinglishmen lets ahrselves be bossed by a bloomin Spenniard, do you?", "name": "THE ROWDY SOCIAL-DEMOCRAT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "action", "text": "with dignity.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "dialogue", "text": "Allow me to introduce myself: Mendoza, President of the League of the Sierra!", "name": "MENDOZA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "action", "text": "Posing loftily.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "dialogue", "text": "I am a brigand: I live by robbing the rich.", "name": "MENDOZA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "action", "text": "promptly.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "dialogue", "text": "I am a gentleman: I live by robbing the poor. Shake hands.", "name": "TANNER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "dialogue", "text": "Hear, hear!", "name": "THE ENGLISH SOCIAL-DEMOCRATS", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "action", "text": "General laughter and good humor.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "action", "text": "Tanner and Mendoza shake hands.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 41, "kind": "action", "text": "The Brigands drop into their former places.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 42, "kind": "dialogue", "text": "Ere! where do I come in?", "name": "STRAKER", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 43, "kind": "action", "text": "introducing.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 44, "kind": "dialogue", "text": "My friend and chauffeur.", "name": "TANNER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 45, "kind": "action", "text": "suspiciously.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 46, "kind": "dialogue", "text": "Well, which is he? friend or show-foor? It makes all the difference you know.", "name": "THE SULKY SOCIAL-DEMOCRAT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 47, "kind": "action", "text": "explaining.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 48, "kind": "dialogue", "text": "We should expect ransom for a friend. A professional chauffeur is free of the mountains. He even takes a trifling percentage of his princpal's ransom if he will honor us by accepting it.", "name": "MENDOZA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 49, "kind": "dialogue", "text": "I see. Just to encourage me to come this way again. Well, I'll think about it.", "name": "STRAKER", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 50, "kind": "action", "text": "impulsively rushing across to Straker.", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}