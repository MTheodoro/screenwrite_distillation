{"scene_id": "s00000", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00000.fountain", "heading": "INT. DRAINED ROLLER RINK - TEMPORARY COUNTY COURTROOM - DAY", "cast": [{"id": 0, "name": "ADAEZE OKAFOR", "names": ["ADAEZE OKAFOR", "ADAEZE"], "gender": "?", "first": 9, "spoke": 25}, {"id": 1, "name": "LEV BRANDT", "names": ["LEV BRANDT", "LEV"], "gender": "m", "first": 12, "spoke": 22}, {"id": 2, "name": "JUDGE HOLLIS TRAN", "names": ["JUDGE HOLLIS TRAN", "JUDGE TRAN"], "gender": "?", "first": 15, "spoke": 17}, {"id": 3, "name": "CLERK", "names": ["CLERK"], "gender": "?", "first": 115, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRAINED ROLLER RINK - TEMPORARY COUNTY COURTROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A roller rink.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Maple floor, warped by flood.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Disco ball still hangs over the bench, wrapped in bubble wrap.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Folding tables.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "Folding chairs.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "A flag on a mic stand.", "para": 1, "sent": 2, "present": []}, {"u": 7, "kind": "action", "text": "Courthouse is under repair.", "para": 2, "sent": 0, "present": []}, {"u": 8, "kind": "action", "text": "Justice is here instead.", "para": 2, "sent": 1, "present": []}, {"u": 9, "kind": "action", "text": "ADAEZE OKAFOR (40s, sharp navy suit, sneakers under the table, reading glasses pushed into cropped grey hair) stands at the defense table.", "para": 3, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "Alone.", "para": 3, "sent": 1, "present": [0]}, {"u": 11, "kind": "action", "text": "Her client's chair is empty.", "para": 3, "sent": 2, "present": [0]}, {"u": 12, "kind": "action", "text": "Across the aisle: LEV BRANDT (50s, heavy, rumpled, a pastry crumb on his tie) shuffles exhibits.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Calm.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Too calm.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "On a raised DJ booth, now a bench: JUDGE HOLLIS TRAN (60s, silver braid over one shoulder, half-moon spectacles, a thermos of tea).", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "She taps a gavel made from a skate wheel and a dowel.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Rink speakers hiss.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Back on the record.", "name": "JUDGE TRAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Your Honor, the People are ready.", "name": "LEV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "The defense is not.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Counsel, your client is late.", "name": "JUDGE TRAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "My client is in a hospital.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Convenient.", "name": "LEV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Say that again.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "I said, convenient.", "name": "LEV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Mr. Brandt.", "name": "JUDGE TRAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "It is, Judge. Day three of trial. Day three of a medical emergency.", "name": "LEV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "He had a seizure on the stairs.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Which stairs?", "name": "LEV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "The stairs of this building. The one with the leak.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "A drip.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Somewhere.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Plink.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Plink.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Everyone listens.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "I have a doctor's note?", "name": "JUDGE TRAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "I filed it at seven.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "I never received it.", "name": "LEV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "I emailed you.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "My inbox says otherwise.", "name": "LEV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Your inbox says a lot of things.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Enough.", "name": "JUDGE TRAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Silence.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "The disco ball turns a quarter inch in a draft.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Lev smiles.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Opens a folder.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Slides one page onto the table.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Then the People move to proceed in absentia.", "name": "LEV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Objection.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Basis?", "name": "JUDGE TRAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Every basis.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "She can't list one.", "name": "LEV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Sixth Amendment. Confrontation. Presence. Counsel of choice.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "He waived presence on Monday.", "name": "LEV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "He did not.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "Page four of the waiver.", "name": "LEV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Adaeze freezes.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Hands go to her own stack.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Flips.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "Flips.", "para": 11, "sent": 3, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Ms. Okafor?", "name": "JUDGE TRAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "Page four.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "She finds it.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "Reads.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "Her jaw sets.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "A signature.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "Her client's.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "Dated Monday.", "para": 13, "sent": 2, "present": [0, 1, 2]}, {"u": 69, "kind": "dialogue", "text": "That is not his hand.", "name": "ADAEZE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 70, "kind": "dialogue", "text": "It is his hand.", "name": "LEV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 71, "kind": "dialogue", "text": "He signs with a loop. This has no loop.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 72, "kind": "dialogue", "text": "People change.", "name": "LEV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 73, "kind": "dialogue", "text": "Not in a week.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 74, "kind": "dialogue", "text": "Counsel, approach.", "name": "JUDGE TRAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 75, "kind": "action", "text": "They do.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 76, "kind": "action", "text": "Skates of silence.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 77, "kind": "action", "text": "Their shoes squeak on the maple.", "para": 14, "sent": 2, "present": [0, 1, 2]}, {"u": 78, "kind": "dialogue", "text": "Mr. Brandt. Where did you get this?", "name": "JUDGE TRAN", "speaker": 2, "ext": ["CONT'D"], "paren": ["low"], "dual": false, "present": [0, 1, 2]}, {"u": 79, "kind": "dialogue", "text": "From the clerk.", "name": "LEV", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2]}, {"u": 80, "kind": "dialogue", "text": "Which clerk?", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2]}, {"u": 81, "kind": "dialogue", "text": "The one who works here.", "name": "LEV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 82, "kind": "dialogue", "text": "There are four.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 83, "kind": "dialogue", "text": "The one with the lanyard.", "name": "LEV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 84, "kind": "dialogue", "text": "They all have lanyards!", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 85, "kind": "dialogue", "text": "Lower your voice.", "name": "JUDGE TRAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 86, "kind": "dialogue", "text": "You forged it.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": ["hissing"], "dual": false, "present": [0, 1, 2]}, {"u": 87, "kind": "dialogue", "text": "Careful.", "name": "LEV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 88, "kind": "dialogue", "text": "Or you let someone forge it. Same thing.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 89, "kind": "dialogue", "text": "That is slander, counselor.", "name": "LEV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 90, "kind": "dialogue", "text": "Stop. Both of you.", "name": "JUDGE TRAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 91, "kind": "action", "text": "Beat.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 92, "kind": "action", "text": "The drip: plink.", "para": 15, "sent": 1, "present": [0, 1, 2]}, {"u": 93, "kind": "action", "text": "Judge Tran lifts the page toward the light.", "para": 16, "sent": 0, "present": [0, 1, 2]}, {"u": 94, "kind": "action", "text": "Tilts it.", "para": 16, "sent": 1, "present": [0, 1, 2]}, {"u": 95, "kind": "action", "text": "Squints.", "para": 16, "sent": 2, "present": [0, 1, 2]}, {"u": 96, "kind": "action", "text": "Her thumb rubs the signature.", "para": 17, "sent": 0, "present": [0, 1, 2]}, {"u": 97, "kind": "action", "text": "Black comes away.", "para": 17, "sent": 1, "present": [0, 1, 2]}, {"u": 98, "kind": "action", "text": "Wet.", "para": 17, "sent": 2, "present": [0, 1, 2]}, {"u": 99, "kind": "action", "text": "She holds the thumb up for them to see.", "para": 18, "sent": 0, "present": [0, 1, 2]}, {"u": 100, "kind": "dialogue", "text": "Ink's still wet.", "name": "JUDGE TRAN", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 101, "kind": "action", "text": "Lev's smile dies.", "para": 19, "sent": 0, "present": [0, 1, 2]}, {"u": 102, "kind": "dialogue", "text": "Your Honor, that's - that can't -", "name": "LEV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 103, "kind": "dialogue", "text": "Monday, you said.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 104, "kind": "dialogue", "text": "The photocopier smears.", "name": "LEV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 105, "kind": "dialogue", "text": "It is a pen, Mr. Brandt. A felt-tip. Not a copier.", "name": "JUDGE TRAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 106, "kind": "dialogue", "text": "I can explain.", "name": "LEV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 107, "kind": "dialogue", "text": "Please. Do.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 108, "kind": "dialogue", "text": "It was a... a re-signing. For the file.", "name": "LEV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 109, "kind": "dialogue", "text": "By whom?", "name": "JUDGE TRAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 110, "kind": "action", "text": "Lev opens his mouth.", "para": 20, "sent": 0, "present": [0, 1, 2]}, {"u": 111, "kind": "action", "text": "Closes it.", "para": 20, "sent": 1, "present": [0, 1, 2]}, {"u": 112, "kind": "action", "text": "Behind him, the rink doors swing open.", "para": 21, "sent": 0, "present": [0, 1, 2]}, {"u": 113, "kind": "action", "text": "Wind.", "para": 21, "sent": 1, "present": [0, 1, 2]}, {"u": 114, "kind": "action", "text": "A clerk in a lanyard stands there, small, pale, holding a felt-tip pen like a dropped weapon.", "para": 21, "sent": 2, "present": [0, 1, 2]}, {"u": 115, "kind": "dialogue", "text": "I'm sorry. He said it was routine.", "name": "CLERK", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 116, "kind": "action", "text": "Nobody moves.", "para": 22, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 117, "kind": "dialogue", "text": "Mr. Brandt. Sit down.", "name": "JUDGE TRAN", "speaker": 2, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 118, "kind": "action", "text": "Lev sits.", "para": 23, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 119, "kind": "action", "text": "Slowly.", "para": 23, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 120, "kind": "action", "text": "His chair squeaks on the maple.", "para": 23, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 121, "kind": "dialogue", "text": "Your Honor, the defense moves for dismissal with prejudice.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 122, "kind": "dialogue", "text": "Granted.", "name": "JUDGE TRAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 123, "kind": "action", "text": "The skate-wheel gavel.", "para": 24, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 124, "kind": "action", "text": "One tap.", "para": 24, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 125, "kind": "action", "text": "Echo, bright against the rafters.", "para": 24, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 126, "kind": "action", "text": "Adaeze exhales.", "para": 25, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 127, "kind": "action", "text": "Takes off her glasses.", "para": 25, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 128, "kind": "action", "text": "Rubs her eyes.", "para": 25, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 129, "kind": "dialogue", "text": "Sneakers. Best decision I made all week.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 130, "kind": "action", "text": "Judge Tran pours tea.", "para": 26, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 131, "kind": "action", "text": "Steam curls in the cold.", "para": 26, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 132, "kind": "dialogue", "text": "Court is adjourned. Somebody turn that ball off.", "name": "JUDGE TRAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 133, "kind": "action", "text": "The disco ball stops turning.", "para": 27, "sent": 0, "present": [0, 1, 2, 3]}]}