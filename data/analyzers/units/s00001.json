{"scene_id": "s00001", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00001.fountain", "heading": "INT. TAXIDERMY WORKSHOP - NIGHT", "cast": [{"id": 0, "name": "ODALYS VEGA", "names": ["ODALYS VEGA", "ODALYS"], "gender": "f", "first": 4, "spoke": 5}, {"id": 1, "name": "WOMAN", "names": ["WOMAN"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 8, "spoke": 4}, {"id": 3, "name": "INGRID", "names": ["INGRID"], "gender": "?", "first": 20, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. TAXIDERMY WORKSHOP - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Glass eyes in jars.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A fox half-stuffed on the bench.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain on a skylight.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ODALYS VEGA (30s, rain-soaked trench coat, badge on her belt) stands in the doorway.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "At the bench, a WOMAN in a leather apron sews a pheasant's wing.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Her back is turned.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Evening. Sorry about the hour.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Kettle's on. Sit.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Odalys sits on a stool.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Looks at the fox.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "The fox looks back.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "I'm looking into a break-in at the museum. Friday night.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Terrible. They never lock the back.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "That's what the guard said. Funny, because he said she never left the bench that night either.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Who?", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Nobody. Your name?", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "The woman turns.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Warm face.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Needle in her teeth.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Ingrid.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "She sets down the wing.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "On the shelf behind her: a small brass key tag.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "MUSEUM - REAR.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Does she take sugar, your guard?", "name": "INGRID", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Odalys stands.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Her hand drifts to her belt.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Ingrid smiles.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Ingrid. Put the needle down.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}