{"scene_id": "s00002", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00002.fountain", "heading": "INT. DROWNED CATHEDRAL - BEEKEEPERS' LIBRARY - DUSK", "cast": [{"id": 0, "name": "TAMSIN HALE", "names": ["TAMSIN HALE", "TAMSIN"], "gender": "?", "first": 3, "spoke": 1}, {"id": 1, "name": "BRAM", "names": ["BRAM"], "gender": "?", "first": 4, "spoke": 2}, {"id": 2, "name": "PIP", "names": ["PIP"], "gender": "?", "first": 5, "spoke": 1}, {"id": 3, "name": "POLLY", "names": ["POLLY"], "gender": "?", "first": 5, "spoke": 1}, {"id": 4, "name": "SERAPH VANE", "names": ["SERAPH VANE", "SERAPH"], "gender": "?", "first": 12, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. DROWNED CATHEDRAL - BEEKEEPERS' LIBRARY - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "Knee-deep green water fills the nave.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Shelves of wax-sealed books rise like reefs from it, and bees drift between the pillars in slow gold ribbons.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "TAMSIN HALE (20s, barefoot, hair tied with twine) wades along a shelf, tracing spines with two fingers.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "Behind her, old BRAM (70s, white beard stained with honey) skims comb into a bucket.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Beside the font, twin girls PIP and POLLY (10, identical, freckled) float paper boats made of recipe pages.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "dialogue", "text": "This one hums.", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "They all hum. Leave it be.", "name": "BRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Pip says the roof is thinking again.", "name": "POLLY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "I said it was dreaming.", "name": "PIP", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "High above, a pane of old glass lets in the last amber light.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "The bees rise toward it, then settle.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "A figure pushes through the west door, shaking water from a long coat of feathers: SERAPH VANE (40s, tall, ink on her lips, a lantern with no flame).", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "She stops, hearing the hum.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Smiles faintly.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Is the keeper in?", "name": "SERAPH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "The keeper is always in. He's just slow.", "name": "BRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Tamsin slides the humming book back into its place.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "The bees go quiet.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}]}