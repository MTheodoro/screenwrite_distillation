{"scene_id": "s00004", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00004.fountain", "heading": "INT. RIVERBOAT CASINO - PRIVATE DINING SALON - NIGHT", "cast": [{"id": 0, "name": "HORACE VANDERMEER", "names": ["HORACE VANDERMEER", "HORACE"], "gender": "m", "first": 5, "spoke": 22}, {"id": 1, "name": "NEELY", "names": ["NEELY"], "gender": "m", "first": 7, "spoke": 21}, {"id": 2, "name": "ABBOTT", "names": ["ABBOTT"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "MILES KOWALCZYK", "names": ["MILES KOWALCZYK", "MILES"], "gender": "?", "first": 11, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. RIVERBOAT CASINO - PRIVATE DINING SALON - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Red velvet.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Brass lamps.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A paddle wheel churns beyond the portholes, and the whole room sways with the current.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A long table set for three, with a court reporter's absence conspicuous.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "At its head sits HORACE VANDERMEER (50s, silver temples, a gray double-breasted suit, a fountain pen he never uncaps).", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "He is the attorney for the plaintiff.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "Across from him, CORNELIUS \"NEELY\" ABBOTT (60s, ruddy, a carnation in his lapel, a glass of bourbon sweating at his elbow).", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "The witness.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Genial.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Rich.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "At the foot of the table, MILES KOWALCZYK (30s, lean, perfect posture, a fresh haircut) arranges his notes.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "He represents Abbott.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "A deposition, held on a boat so no one can serve a subpoena in the wrong county.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "We'll keep this informal, Mr. Abbott.", "name": "HORACE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Neely. Everyone calls me Neely.", "name": "NEELY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Mr. Abbott will answer to his name.", "name": "MILES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Miles, relax. We're among friends.", "name": "NEELY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Are we?", "name": "HORACE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "I hope so.", "name": "NEELY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Horace smiles.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Uncaps nothing.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Turns a page.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "You've owned the Gilded Heron for how long?", "name": "HORACE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Eleven years. Since my father passed.", "name": "NEELY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Objection. Relevance.", "name": "MILES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "It's a deposition, Mr. Kowalczyk. Objections are noted, not ruled upon.", "name": "HORACE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Noted, then.", "name": "MILES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Let him ask. I've nothing to hide.", "name": "NEELY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "A waiter pours coffee, withdraws.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "The paddle wheel thuds.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Glasses shiver.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "And the vessel carries how many guests on a Friday?", "name": "HORACE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Three hundred, maybe three-fifty.", "name": "NEELY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Sprinklers?", "name": "HORACE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Of course.", "name": "NEELY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Inspected?", "name": "HORACE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Every year.", "name": "NEELY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Mr. Abbott, you needn't elaborate.", "name": "MILES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "He's only asking about the boat.", "name": "NEELY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Only about the boat.", "name": "HORACE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "He turns another page.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Pleasant.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Unhurried.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "He might be reading a menu.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Wonderful. Then let's talk about the fire.", "name": "HORACE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Neely's glass stops halfway to his lips.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Which fire?", "name": "NEELY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "The one in the engine room, August third.", "name": "HORACE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "That was minor.", "name": "NEELY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Mr. Abbott -", "name": "MILES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "- a small electrical matter. The crew handled it.", "name": "NEELY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "The crew locked it.", "name": "HORACE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "I don't follow.", "name": "NEELY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "The engine room door. Locked from the outside. Eleven men inside.", "name": "HORACE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Objection! He's testifying.", "name": "MILES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "He is, in fact, answering. Mr. Abbott?", "name": "HORACE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "That door sticks. It's old.", "name": "NEELY", "speaker": 1, "ext": [], "paren": ["too fast"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "It sticks from the outside only?", "name": "HORACE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "It - I wouldn't know.", "name": "NEELY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "You signed the work order.", "name": "HORACE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "My signature is on a great many things.", "name": "NEELY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "This one is dated July thirtieth. Replace latch with exterior bolt. Reason given: theft prevention.", "name": "HORACE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "Silence.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "Miles stops writing.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "The boat creaks.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "Where did you get that?", "name": "MILES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "From the contractor's invoice file. Delivered this morning, with a very nervous apology.", "name": "HORACE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "He's lying.", "name": "NEELY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "dialogue", "text": "He's dead, Mr. Abbott. Since Tuesday. His widow brought the file.", "name": "HORACE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "Neely sets down the glass.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "It trembles against the saucer.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "Miles. Say something.", "name": "NEELY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "I'd like a recess.", "name": "MILES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "dialogue", "text": "We are on a river, Mr. Kowalczyk. Where would you recess to?", "name": "HORACE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "dialogue", "text": "The deck.", "name": "MILES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "dialogue", "text": "Of course.", "name": "HORACE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "Miles stands, then sits again.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "action", "text": "He looks at Neely.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "action", "text": "Neely won't look at anyone.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "dialogue", "text": "It was supposed to be empty.", "name": "NEELY", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "dialogue", "text": "Neely, don't -", "name": "MILES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "dialogue", "text": "The insurance man said the engine room would be empty at night.", "name": "NEELY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "dialogue", "text": "And the eleven?", "name": "HORACE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 84, "kind": "dialogue", "text": "They weren't on the schedule.", "name": "NEELY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 85, "kind": "action", "text": "Horace finally uncaps the fountain pen.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 86, "kind": "action", "text": "Writes one line.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 87, "kind": "action", "text": "The nib scratches.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 88, "kind": "action", "text": "Loud.", "para": 12, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 89, "kind": "dialogue", "text": "That will do for today.", "name": "HORACE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 90, "kind": "action", "text": "He caps the pen.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 91, "kind": "action", "text": "The paddle wheel thuds.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 92, "kind": "action", "text": "The lamps sway.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}]}