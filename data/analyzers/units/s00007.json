{"scene_id": "s00007", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00007.fountain", "heading": "INT. BOWLING ALLEY - AFTER HOURS - NIGHT", "cast": [{"id": 0, "name": "LUCKY STRIKE LANES", "names": ["LUCKY STRIKE LANES"], "gender": "?", "first": 4, "spoke": 0}, {"id": 1, "name": "ROSALIND OKONKWO-HART", "names": ["ROSALIND OKONKWO-HART", "ROSALIND"], "gender": "f", "first": 8, "spoke": 17}, {"id": 2, "name": "DEVANTE", "names": ["DEVANTE"], "gender": "?", "first": 12, "spoke": 13}, {"id": 3, "name": "PEARL ADEYEMI", "names": ["PEARL ADEYEMI", "PEARL"], "gender": "f", "first": 16, "spoke": 15}], "units": [{"u": 0, "kind": "heading", "text": "INT. BOWLING ALLEY - AFTER HOURS - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dead neon.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sixteen lanes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The smell of old shoe spray and fryer oil.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A banner over the counter, curling at one corner: LUCKY STRIKE LANES - SINCE 1974.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beneath it, a handwritten sign: CLOSED FOR GOOD.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Cardboard boxes line the shoe counter.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "A radio plays low, a ballgame, nobody listening.", "para": 2, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "ROSALIND OKONKWO-HART (40s, tired eyes, her late father's cardigan two sizes too big) wraps trophies in newspaper.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Methodical.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Careful.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Every one gets its own page.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Her brother DEVANTE (30s, leather jacket, restless hands) slouches against lane nine, flicking the lever on the ball return.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Click.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Click.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Click.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Between them, on a stool: MRS. PEARL ADEYEMI (70s, church hat, a purse held like a shield).", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Their father's oldest friend.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "She hasn't taken her coat off.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Click.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Click.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Stop that.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "It's a lever.", "name": "DEVANTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "It's loud.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "He stops.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Picks at a splinter on the rail.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Rosalind turns a trophy over in her hands.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "A bowler, gold paint chipped off one knee.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "He bowled a 290 once.", "name": "PEARL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "I know.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Nineteen eighty-eight.", "name": "PEARL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "It was a 289.", "name": "DEVANTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "He told me 290.", "name": "PEARL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "He rounded up.", "name": "DEVANTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "He did not round.", "name": "PEARL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Rosalind sets the trophy in a box.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Takes another.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Wraps.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "The paper crackles.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "You're keeping those?", "name": "DEVANTE", "speaker": 2, "ext": [], "paren": ["to Rosalind"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "They're his.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "They're junk.", "name": "DEVANTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Then leave them.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "I'm not leaving anything. I'm just asking.", "name": "DEVANTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "He kicks a bowling ball.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "It rolls an inch, rocks back.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "He stares at it.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "The buyer's coming at nine?", "name": "PEARL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Eight.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "He's turning it into a gym.", "name": "PEARL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "I know.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "A gym.", "name": "PEARL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Pearl.", "name": "DEVANTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "I'm only saying.", "name": "PEARL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Devante crosses to the pin deck.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Climbs over the gutter rail, and walks down lane nine toward the pins.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Rosalind looks up.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Pearl looks up.", "para": 10, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "He walks the entire length, boots loud on the wood, and stops at the foul line, back to them.", "para": 10, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "Don't scuff the boards.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "They're getting torn out.", "name": "DEVANTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "Still.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "He steps off the lane.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "Picks up a ball.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "Weighs it.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "Sets it down.", "para": 11, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "Rosalind tapes a box shut.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "The tape shrieks.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "Pearl flinches.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "dialogue", "text": "He always said you'd be the one to close up.", "name": "PEARL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "Rosalind's hands stop.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "Then keep going.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "I'm not closing anything. The bank is.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "You know what I mean.", "name": "PEARL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "dialogue", "text": "I don't.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "Devante turns.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "Pearl turns.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "Rosalind lifts the box, struggling with its weight.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "action", "text": "Devante and Pearl both step forward, then both freeze.", "para": 14, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "action", "text": "Rosalind sets the box down herself.", "para": 14, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "dialogue", "text": "Let me.", "name": "DEVANTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "dialogue", "text": "I've got it.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "dialogue", "text": "You'll hurt your back.", "name": "DEVANTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "dialogue", "text": "I've hurt it before.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 84, "kind": "action", "text": "She lifts.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 85, "kind": "action", "text": "Carries it to the door.", "para": 15, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 86, "kind": "action", "text": "Sets it on the step.", "para": 15, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 87, "kind": "action", "text": "Cold air floods the lanes.", "para": 15, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 88, "kind": "dialogue", "text": "Rosalind, honey, your coat.", "name": "PEARL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 89, "kind": "dialogue", "text": "I'm fine.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 90, "kind": "dialogue", "text": "You're shaking.", "name": "PEARL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 91, "kind": "dialogue", "text": "It's cold.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 92, "kind": "action", "text": "Pearl reaches into her purse.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 93, "kind": "action", "text": "Pulls out a folded bowling shirt, faded green, a name embroidered on the pocket: CHUKS.", "para": 16, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 94, "kind": "action", "text": "She holds it out.", "para": 17, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 95, "kind": "action", "text": "Rosalind doesn't take it.", "para": 17, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 96, "kind": "dialogue", "text": "Where'd you get that?", "name": "DEVANTE", "speaker": 2, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 97, "kind": "dialogue", "text": "He left it in my car. Years ago.", "name": "PEARL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 98, "kind": "action", "text": "Silence.", "para": 18, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 99, "kind": "action", "text": "The radio crackles: a crowd roars somewhere far away.", "para": 18, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 100, "kind": "action", "text": "Devante takes the shirt.", "para": 19, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 101, "kind": "action", "text": "Looks at it.", "para": 19, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 102, "kind": "action", "text": "Folds it once more, carefully, along the same creases.", "para": 19, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 103, "kind": "action", "text": "Walks to the box by the door.", "para": 19, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 104, "kind": "action", "text": "Lays it on top.", "para": 19, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 105, "kind": "action", "text": "He doesn't say anything.", "para": 20, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 106, "kind": "action", "text": "Neither does Rosalind.", "para": 20, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 107, "kind": "action", "text": "She tapes the flaps shut.", "para": 20, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 108, "kind": "action", "text": "Pearl finally stands.", "para": 21, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 109, "kind": "action", "text": "Buttons her coat.", "para": 21, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 110, "kind": "dialogue", "text": "Eight o'clock, you said.", "name": "PEARL", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 111, "kind": "dialogue", "text": "Eight.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 112, "kind": "dialogue", "text": "I'll bring coffee.", "name": "PEARL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 113, "kind": "action", "text": "She goes.", "para": 22, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 114, "kind": "action", "text": "The door sighs closed behind her.", "para": 22, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 115, "kind": "action", "text": "Devante and Rosalind alone.", "para": 23, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 116, "kind": "action", "text": "The radio talks to nobody.", "para": 23, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 117, "kind": "action", "text": "He crosses to the counter.", "para": 24, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 118, "kind": "action", "text": "Picks up the last trophy.", "para": 24, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 119, "kind": "action", "text": "Offers it to her, base first.", "para": 24, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 120, "kind": "action", "text": "She takes it.", "para": 25, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 121, "kind": "action", "text": "Wraps it.", "para": 25, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 122, "kind": "action", "text": "Her page is today's sports section.", "para": 25, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 123, "kind": "dialogue", "text": "Which one's this?", "name": "DEVANTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 124, "kind": "dialogue", "text": "Doubles. Nineteen ninety-one. With Mom.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 125, "kind": "dialogue", "text": "Huh.", "name": "DEVANTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 126, "kind": "action", "text": "He sets his hand on the box lid.", "para": 26, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 127, "kind": "action", "text": "Leaves it there a moment.", "para": 26, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 128, "kind": "action", "text": "Then he reaches up and kills the radio.", "para": 27, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 129, "kind": "action", "text": "The alley goes quiet.", "para": 28, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 130, "kind": "action", "text": "Only the hum of the cooler.", "para": 28, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 131, "kind": "action", "text": "Only the paper.", "para": 28, "sent": 2, "present": [0, 1, 2, 3]}]}