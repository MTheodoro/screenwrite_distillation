{"scene_id": "s00008", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00008.fountain", "heading": "INT. MUNICIPAL PLANETARIUM - CONTROL ROOM - NIGHT", "cast": [{"id": 0, "name": "JUNE", "names": ["JUNE"], "gender": "m", "first": 3, "spoke": 12}, {"id": 1, "name": "ASANTE", "names": ["ASANTE"], "gender": "?", "first": 3, "spoke": 0}, {"id": 2, "name": "WALLACE PYO", "names": ["WALLACE PYO", "WALLACE"], "gender": "?", "first": 4, "spoke": 14}], "units": [{"u": 0, "kind": "heading", "text": "INT. MUNICIPAL PLANETARIUM - CONTROL ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped booth above the dome.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dials, a projector the size of an oven, a dead cup of coffee on every flat surface.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "JUNIPER \"JUNE\" ASANTE (30s, hoodie, headset, a laptop plastered with stickers) sits at a console, bored.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "Beside her, WALLACE PYO (60s, security guard uniform one size small, a thermos) pretends to read a paperback.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 5, "kind": "action", "text": "Through the glass, the empty dome is lit with a slow field of artificial stars.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "You're not supposed to be up here.", "name": "WALLACE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Maintenance.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "At two a.m.?", "name": "WALLACE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Stars don't recalibrate themselves.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "He sips from the thermos.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Turns a page without reading it.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Ceiling's clear. Roof hatch in four.", "name": "JUNE", "speaker": 0, "ext": ["CONT'D"], "paren": ["into headset, flat"], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Who're you talking to?", "name": "WALLACE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Myself. Old habit.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "You said \"roof hatch.\"", "name": "WALLACE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "I said \"roof catch.\" As in, catch up on emails.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Mm.", "name": "WALLACE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "He doesn't believe her.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "He doesn't move, either.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "June taps a key.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "The stars shift.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "The constellation of Orion slides west.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "My wife loved Orion.", "name": "WALLACE", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Everyone does.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "She said it looked like a man waiting for a bus.", "name": "WALLACE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "June laughs.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Real.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Surprised.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "That's good.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "She was good.", "name": "WALLACE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Quiet.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The projector whirs.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Hold. Hold. He's talking.", "name": "JUNE", "speaker": 0, "ext": [], "paren": ["under her breath, to the headset"], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "There it is again.", "name": "WALLACE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Hold on, I'm - (beat) - praying. Quietly. For my laptop. It crashes.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Sure it does.", "name": "WALLACE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "He sets down the paperback, stands, and stretches until his back cracks.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Everyone out of the vault when you're done, please. I lock at six.", "name": "WALLACE", "speaker": 2, "ext": ["CONT'D"], "paren": ["to the empty booth"], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Beat.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "June looks at him.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "You knew.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "I'm sixty-one. I know what a van looks like parked behind a dome at midnight.", "name": "WALLACE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "And you sat here.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "I'm on break.", "name": "WALLACE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "He pours coffee.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Offers her the cup.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "She takes it.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Don't take the telescope. It's on loan from the university.", "name": "WALLACE", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Hear that, everybody? Leave the telescope.", "name": "JUNE", "speaker": 0, "ext": [], "paren": ["into headset"], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Overhead, the stars drift on, indifferent.", "para": 12, "sent": 0, "present": [0, 1, 2]}]}