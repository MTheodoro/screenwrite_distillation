{"scene_id": "s00009", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00009.fountain", "heading": "INT. GRAIN ELEVATOR - ROLLER DERBY TRACK - NIGHT", "cast": [{"id": 0, "name": "BRUISE", "names": ["BRUISE"], "gender": "f", "first": 5, "spoke": 11}, {"id": 1, "name": "CASTILLO", "names": ["CASTILLO"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "TAMARA GRAY-OYELARAN", "names": ["TAMARA GRAY-OYELARAN", "TAMARA"], "gender": "?", "first": 6, "spoke": 7}, {"id": 3, "name": "DOT KWIATKOWSKI", "names": ["DOT KWIATKOWSKI", "DOT"], "gender": "f", "first": 7, "spoke": 6}, {"id": 4, "name": "JONAS FELD", "names": ["JONAS FELD", "JONAS"], "gender": "m", "first": 8, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRAIN ELEVATOR - ROLLER DERBY TRACK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A concrete silo floor, converted.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Oval track taped on the slab, plywood bleachers, one hanging bulb per corner.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dust floats in the beams.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The Harvest Hellcats are down nine in the final jam.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "Their jammer, MARISOL \"BRUISE\" CASTILLO (20s, shaved sides, mouthguard dangling), sits on the infield bench lacing her skates tight enough to hurt.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Beside her, team captain TAMARA GRAY-OYELARAN (30s, tall, eye-black, taped wrist) watches the clock.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Across the track, rival jammer DOT KWIATKOWSKI (40s, braids, quiet) stretches her calf, never looking over.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Referee JONAS FELD (50s, striped shirt, whistle in his teeth) walks the track, checking the lines.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "Tamara watches Bruise.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Bruise watches the floor.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "The clock reads 1:14.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Left side. Don't force it.", "name": "TAMARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "I wasn't going to.", "name": "BRUISE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "You were.", "name": "TAMARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "I'm fine.", "name": "BRUISE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Tamara slaps the bench between them.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Once.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Bruise nods without lifting her head.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Jonas blows a short whistle.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Skaters line up.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Bruise stands.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Dot stands.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Neither looks at the other.", "para": 7, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Jammers to the line.", "name": "JONAS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Four points a lap. That's all.", "name": "TAMARA", "speaker": 2, "ext": [], "paren": ["to Bruise"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "I know.", "name": "BRUISE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Then go.", "name": "TAMARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Bruise rolls to the starting line.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "You're limping.", "name": "DOT", "speaker": 3, "ext": [], "paren": ["to Bruise"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "You're old.", "name": "BRUISE", "speaker": 0, "ext": [], "paren": ["to Dot"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "I'm patient.", "name": "DOT", "speaker": 3, "ext": [], "paren": ["to Bruise"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "You're slow.", "name": "BRUISE", "speaker": 0, "ext": [], "paren": ["to Dot"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Jonas raises his whistle.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Do not watch her feet.", "name": "TAMARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Whose feet?", "name": "BRUISE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Mine.", "name": "DOT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Beat.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "The grain-elevator echo carries it.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Quiet on the line.", "name": "JONAS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "It's a three-lap jam, Bruise.", "name": "TAMARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "I said I know.", "name": "BRUISE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Give her a minute. She's praying.", "name": "DOT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "I'm not praying.", "name": "BRUISE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "You're moving your lips.", "name": "DOT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "I'm counting.", "name": "BRUISE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "She counts like her mother.", "name": "TAMARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "Leave my mother out of it.", "name": "BRUISE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Just blow it already.", "name": "BRUISE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Just blow it already.", "name": "DOT", "speaker": 3, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Last warning. Hush.", "name": "JONAS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Bruise rolls her shoulders.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Dot rolls hers.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Their eyes finally meet.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "Two seconds.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Three.", "para": 11, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Jonas lifts the whistle.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "A cold quiet drops over the whole silo.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "The whistle shrieks.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}]}