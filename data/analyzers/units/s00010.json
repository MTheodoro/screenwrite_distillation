{"scene_id": "s00010", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00010.fountain", "heading": "INT. FUNICULAR CONTROL HUT - NIGHT", "cast": [{"id": 0, "name": "OKSANA VOLKOV", "names": ["OKSANA VOLKOV", "OKSANA"], "gender": "f", "first": 4, "spoke": 14}, {"id": 1, "name": "DEZ", "names": ["DEZ"], "gender": "m", "first": 7, "spoke": 20}, {"id": 2, "name": "ACHEBE", "names": ["ACHEBE"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "MARGUERITE", "names": ["MARGUERITE"], "gender": "?", "first": 20, "spoke": 7}, {"id": 4, "name": "BOOT", "names": ["BOOT"], "gender": "?", "first": 57, "spoke": 0}, {"id": 5, "name": "TARIQ BEN-HAIM", "names": ["TARIQ BEN-HAIM", "TARIQ"], "gender": "m", "first": 60, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. FUNICULAR CONTROL HUT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A concrete box bolted to a mountainside.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "One window.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Below it, the cable runs down into fog.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "OKSANA VOLKOV (40s, lean, grease on her cuffs) stands at a bank of dials.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "A wrench in her fist.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "She hasn't blinked in a while.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "DESMOND \"DEZ\" ACHEBE (30s, soaked parka, bad limp) sits on an overturned crate.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "A pistol rests on his knee.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Not pointed.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Not far from pointed.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Between them on the floor: a canvas duffel, zipped.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Stop looking at the brake.", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "I'm looking at the gauge.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "You're looking at the brake.", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "She lets the wrench drop to her side.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Slowly.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Car Two is stopped at the midpoint. Eleven people inside. Two of them are kids.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Then you better start it again when I say.", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "The radio on the desk CRACKLES.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Hut, this is Base. Oksana, come in.", "name": "MARGUERITE", "speaker": 3, "ext": ["V.O."], "paren": ["radio, tinny"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Dez raises the pistol an inch.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Oksana looks at it.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Looks at the radio.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Say everything's fine.", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "She lifts the handset.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Thumbs the key.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Base, Hut. Everything's fine.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Your readout says Car Two is holding. Why is Car Two holding?", "name": "MARGUERITE", "speaker": 3, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Wind shear. Routine.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "There's no wind at the summit station. I'm looking at the flag.", "name": "MARGUERITE", "speaker": 3, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Dez stands.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Limps one step closer.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "The pistol is level now.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Tell her to go home.", "name": "DEZ", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Marguerite, finish your shift. I've got it.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": ["into handset"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Silence on the line.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Fog presses at the window.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Okay.", "name": "MARGUERITE", "speaker": 3, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Click.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Dead air.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Dez exhales through his nose.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Not relief.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Arithmetic.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "She's calling someone.", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "She's calling the sheriff. Twenty minutes up the grade.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Then we have fifteen.", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "He nudges the duffel with his boot.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Open it.", "name": "DEZ", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "I don't want to see what's in it.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Open it.", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "She kneels.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Pulls the zipper.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Inside: a hard-shell case, steel, handcuffed to a leather strap.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "She looks up.", "para": 13, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "This is somebody's wrist strap.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "It's somebody's problem.", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "A BOOT scrapes outside.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Both freeze.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "The door swings in.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "TARIQ BEN-HAIM (20s, uniform of the ski patrol, red jacket, wet to the skin) stands in the frame with his hands half raised.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "Snow in his eyebrows.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "dialogue", "text": "Nobody told me the lift was down. I walked up the service road --", "name": "TARIQ", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "He sees the pistol.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "Stops.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "dialogue", "text": "Close the door.", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "dialogue", "text": "Okay. Okay.", "name": "TARIQ", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "action", "text": "He closes it.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "action", "text": "Stays against it.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "dialogue", "text": "Sit on the floor. Hands on your knees.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": ["to Tariq, flat"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "action", "text": "Tariq sits.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "action", "text": "Careful, slow.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "dialogue", "text": "Who knows you're here?", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "dialogue", "text": "My radio's on channel six. It's always on.", "name": "TARIQ", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "action", "text": "Dez looks at the red radio clipped to Tariq's vest.", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 75, "kind": "action", "text": "Crosses to him.", "para": 19, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 76, "kind": "action", "text": "Rips it free.", "para": 19, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 77, "kind": "action", "text": "Thumbs it off.", "para": 19, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 78, "kind": "dialogue", "text": "Now nobody does.", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 79, "kind": "action", "text": "From the desk, the base radio hisses again.", "para": 20, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 80, "kind": "dialogue", "text": "Oksana. I can see the headlights on the service road. Two sets. Don't tell me everything's fine.", "name": "MARGUERITE", "speaker": 3, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 81, "kind": "action", "text": "Dez turns.", "para": 21, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 82, "kind": "action", "text": "Slowly.", "para": 21, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 83, "kind": "action", "text": "Aims at the handset.", "para": 21, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 84, "kind": "dialogue", "text": "Dez. If I don't answer, she calls it in as a hostage.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 85, "kind": "dialogue", "text": "Then answer.", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 86, "kind": "action", "text": "She picks up the handset.", "para": 22, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 87, "kind": "action", "text": "Her thumb rests on the key but doesn't press it.", "para": 22, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 88, "kind": "dialogue", "text": "What do I tell her?", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 89, "kind": "action", "text": "Dez's jaw works.", "para": 23, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 90, "kind": "action", "text": "Outside, far down the slope, an engine growls.", "para": 23, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 91, "kind": "action", "text": "Closer.", "para": 23, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 92, "kind": "action", "text": "Tires on gravel.", "para": 23, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 93, "kind": "dialogue", "text": "Tell her the truth. Tell her I want the car moving.", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 94, "kind": "dialogue", "text": "Marguerite. There's a man in the hut with a gun. He wants Car Two moving.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": ["keying"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 95, "kind": "dialogue", "text": "Copy. Then move it.", "name": "MARGUERITE", "speaker": 3, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 96, "kind": "action", "text": "Oksana stares at the handset.", "para": 24, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 97, "kind": "action", "text": "Tariq stares at Oksana.", "para": 24, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 98, "kind": "dialogue", "text": "Ma'am, don't. The kids --", "name": "TARIQ", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 99, "kind": "dialogue", "text": "Shut up.", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 100, "kind": "dialogue", "text": "Marguerite, say that again.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 101, "kind": "dialogue", "text": "Move it. Slow. Sheriff's at the bottom station. Moving the car puts it in his hands.", "name": "MARGUERITE", "speaker": 3, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 102, "kind": "action", "text": "Dez's eyes go to the window.", "para": 25, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 103, "kind": "action", "text": "Headlights sweep across the fog.", "para": 25, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 104, "kind": "action", "text": "Then the glass goes white.", "para": 25, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 105, "kind": "dialogue", "text": "Don't.", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 106, "kind": "action", "text": "Oksana puts her palm on the lever.", "para": 26, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 107, "kind": "dialogue", "text": "You can still walk out.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 108, "kind": "dialogue", "text": "With what?", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 109, "kind": "action", "text": "He kicks the duffel toward her.", "para": 27, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 110, "kind": "action", "text": "Hard.", "para": 27, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 111, "kind": "action", "text": "It slides to her knees.", "para": 27, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 112, "kind": "dialogue", "text": "Take it. Take the damn case.", "name": "DEZ", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 113, "kind": "action", "text": "She doesn't move.", "para": 28, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 114, "kind": "action", "text": "Tariq doesn't move.", "para": 28, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 115, "kind": "action", "text": "The cable HUMS under load, waiting.", "para": 28, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 116, "kind": "action", "text": "Dez cocks the pistol.", "para": 29, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 117, "kind": "dialogue", "text": "Pull it.", "name": "DEZ", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 118, "kind": "action", "text": "She pulls.", "para": 30, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 119, "kind": "action", "text": "The whole hut SHUDDERS.", "para": 31, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 120, "kind": "action", "text": "Down in the fog, the cable begins to run.", "para": 31, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}