{"scene_id": "s00012", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00012.fountain", "heading": "INT. LAUNDROMAT - NIGHT", "cast": [{"id": 0, "name": "BIRGITTA LUNDQVIST", "names": ["BIRGITTA LUNDQVIST", "BIRGITTA"], "gender": "f", "first": 4, "spoke": 9}, {"id": 1, "name": "TOBIAS", "names": ["TOBIAS"], "gender": "m", "first": 5, "spoke": 7}, {"id": 2, "name": "GIRL", "names": ["GIRL"], "gender": "f", "first": 6, "spoke": 5}, {"id": 3, "name": "NOOR", "names": ["NOOR"], "gender": "f", "first": 38, "spoke": 3}, {"id": 4, "name": "MAN", "names": ["MAN"], "gender": "?", "first": 47, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAUNDROMAT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent tubes buzz over a row of dryers, half of them spinning.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rain streaks the front glass.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A vending machine hums in the corner.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "BIRGITTA LUNDQVIST (30s, scrubs under a raincoat, tired eyes) feeds quarters into a dryer.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her son TOBIAS (8, pajamas, rain boots on the wrong feet) sits on a folding table swinging his legs and holding a plastic dinosaur.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Against the wall, a GIRL (10, school uniform, backpack on both shoulders) sits alone with a library book and does not look up.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Mom, why is it taking so long?", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Because it's wet, bud.", "name": "BIRGITTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Everything's wet. It's raining.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Birgitta laughs, a short breath of a laugh.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "She shuts the dryer door and presses the button.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "The drum begins to turn.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Tobias hops down, wanders to the vending machine, and presses his nose to the glass while Birgitta checks her phone, frowns at it, and turns the screen face-down on the table, and the Girl, without lifting her eyes from the page, turns one page over.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Can I get the gummy ones?", "name": "TOBIAS", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "It's ten at night.", "name": "BIRGITTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "It's eleven. The clock says.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Birgitta looks at the clock.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "He's right.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "She sighs and digs in her pocket for coins.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Tobias carries his dinosaur over to the Girl and holds it out, nose-first, a ceremonial offering.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "This is Gary. He's a stegosaurus.", "name": "TOBIAS", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "The Girl looks up.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "A long, measuring look.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Then she takes Gary and studies his plates.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Stegosaurs had tiny brains.", "name": "GIRL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Gary's smart.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Then he's not a stegosaurus.", "name": "GIRL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Tobias considers this, deeply wounded, and turns to his mother for ruling.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Birgitta crosses over, dropping her coins into the machine on the way, the machine clunking out a bag of gummies, and kneels between the two children.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Hey. Where are your parents?", "name": "BIRGITTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The Girl closes her book on her finger.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "My dad's coming. He's parking.", "name": "GIRL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "It's been an hour.", "name": "BIRGITTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "It's a hard lot to park in.", "name": "GIRL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Birgitta looks toward the glass.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "The lot outside is empty except for her own car, rain bouncing off the hood.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "What's your name, sweetheart?", "name": "BIRGITTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Noor.", "name": "GIRL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Noor, I'm going to call someone to help us find your dad. Okay?", "name": "BIRGITTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Noor's face changes.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Her shoulders come up.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "She grabs her backpack straps in both fists.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Don't. He'll be mad. I'm not supposed to tell people where we live.", "name": "NOOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "I don't need to know where you live.", "name": "BIRGITTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Then who are you calling?", "name": "NOOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "The front door BANGS open.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "A MAN (40s, wet work jacket, breathing hard) stands in the doorway scanning the room.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "He sees Noor.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Everything in his posture collapses at once.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Tobias, startled, drops the gummies.", "para": 10, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Birgitta rises in front of both children.", "para": 10, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "Noor.", "name": "MAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "Dad.", "name": "NOOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "She runs to him.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "He drops to his knees and wraps both arms around her.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Birgitta watches the two of them, her hand on Tobias's head.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "She's been here an hour.", "name": "BIRGITTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "The truck wouldn't start. I ran all the way from the bridge. Thank you. Thank you for --", "name": "MAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "Her name is Noor?", "name": "BIRGITTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "Noor. Yes.", "name": "MAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "He kisses the top of her head.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "Lifts her.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "She buries her face in his collar.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "Tobias picks up his gummies and Gary and trots back to his mother.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "Mom? Gary says goodbye.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "Noor lifts her head from her father's shoulder and, very seriously, waves.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}]}