{"scene_id": "s00013", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00013.fountain", "heading": "EXT. SALT FLATS - ABANDONED EVAPORATION WORKS - DAY", "cast": [{"id": 0, "name": "SILAS WHITTAKER", "names": ["SILAS WHITTAKER", "SILAS"], "gender": "?", "first": 4, "spoke": 18}, {"id": 1, "name": "CONNIE", "names": ["CONNIE"], "gender": "?", "first": 8, "spoke": 17}, {"id": 2, "name": "REYES", "names": ["REYES"], "gender": "?", "first": 8, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SALT FLATS - ABANDONED EVAPORATION WORKS - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A white plain stretches to a white sky.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rotting wooden vats lie in rows like open coffins.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Heat shimmers off the crust.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SILAS WHITTAKER (50s, gray beard, duster bleached by sun) kneels beside a dead horse.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He runs one hand along its neck and says nothing.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Behind him, a shadow lengthens.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "He doesn't turn.", "para": 2, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "CONSTANCE \"CONNIE\" REYES (30s, wide-brimmed hat, rifle across her back) stands twenty feet away on the crust.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "She holds a canteen by its strap.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "That your horse?", "name": "CONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Was.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Looks like the salt got her.", "name": "CONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Looks like a bullet got her.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "She walks closer.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Stops short of arm's reach.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "He rises, brushing his knees, and finally turns.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "His eyes go to the canteen.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Hers go to his holster.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I'll trade you water for a name.", "name": "CONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I'd trade you a name for a mule.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "I don't have a mule.", "name": "CONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Then you don't have a name worth the water.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "She almost smiles.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "He almost doesn't.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "The wind pulls at her hat brim.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "She tilts the canteen.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Water slaps against the metal, loud in the silence.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Don't wave that around.", "name": "SILAS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "It's mine to wave.", "name": "CONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "He takes a step.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "She does not move.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "He takes another.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Her hand drifts back to the rifle sling.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Easy.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "You first.", "name": "CONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "They stand with the dead horse between them and the white sky above.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Neither one blinks.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "You work for Dutch Halloran?", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Never heard of him.", "name": "CONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "That's a lie, and you tell it badly.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Then I'm in good company.", "name": "CONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "He nods slowly.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Looks off toward a ridge on the horizon, a thin dark line.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "He's coming, you know. He's got six men and a Gatling gun on a wagon.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "I know.", "name": "CONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Then why are you standing here?", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "She uncaps the canteen.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Drinks.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Wipes her mouth with the back of her wrist.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Holds it out to him at arm's length, the way one offers food to a dog.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Same reason as you.", "name": "CONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "He takes it.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Drinks long.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "The water runs down his beard.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "He hands it back.", "para": 10, "sent": 3, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "He killed my brother.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "He killed my husband.", "name": "CONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "He burned my ranch.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "He took my land.", "name": "CONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "They speak at once, the words overlapping, neither stopping for the other.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "I came out here to die. ^ CONNIE I came out here to finish it.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "A beat.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "They look at each other, really look, for the first time.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "Can you shoot that thing?", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "Better than you can shoot that.", "name": "CONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "He glances at his holster.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "Almost laughs.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 68, "kind": "dialogue", "text": "What's your plan?", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "She points past him at the nearest vat, a long wooden trough sunk in the crust.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 70, "kind": "dialogue", "text": "Wagon comes down the old cart road. Wheels sink in the brine. Horses panic.", "name": "CONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 71, "kind": "dialogue", "text": "And the Gatling?", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 72, "kind": "dialogue", "text": "Pointed at the sky, if the wagon tips.", "name": "CONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 73, "kind": "action", "text": "He studies the vats.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 74, "kind": "action", "text": "The road.", "para": 15, "sent": 1, "present": [0, 1, 2]}, {"u": 75, "kind": "action", "text": "The ridge.", "para": 15, "sent": 2, "present": [0, 1, 2]}, {"u": 76, "kind": "action", "text": "The long, long distance.", "para": 15, "sent": 3, "present": [0, 1, 2]}, {"u": 77, "kind": "dialogue", "text": "That's a lot of ifs.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 78, "kind": "dialogue", "text": "You got a better one?", "name": "CONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 79, "kind": "action", "text": "He doesn't.", "para": 16, "sent": 0, "present": [0, 1, 2]}, {"u": 80, "kind": "action", "text": "He pulls the revolver from his holster and checks the cylinder.", "para": 16, "sent": 1, "present": [0, 1, 2]}, {"u": 81, "kind": "action", "text": "Three rounds.", "para": 16, "sent": 2, "present": [0, 1, 2]}, {"u": 82, "kind": "action", "text": "He sighs.", "para": 16, "sent": 3, "present": [0, 1, 2]}, {"u": 83, "kind": "dialogue", "text": "Hand me a few.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 84, "kind": "action", "text": "She digs in her coat.", "para": 17, "sent": 0, "present": [0, 1, 2]}, {"u": 85, "kind": "action", "text": "Pours a small handful of cartridges into his palm.", "para": 17, "sent": 1, "present": [0, 1, 2]}, {"u": 86, "kind": "action", "text": "He loads them one by one.", "para": 17, "sent": 2, "present": [0, 1, 2]}, {"u": 87, "kind": "action", "text": "On the ridge, a plume of dust rises.", "para": 18, "sent": 0, "present": [0, 1, 2]}, {"u": 88, "kind": "action", "text": "A glint of brass.", "para": 18, "sent": 1, "present": [0, 1, 2]}, {"u": 89, "kind": "action", "text": "The faint creak of wheels.", "para": 18, "sent": 2, "present": [0, 1, 2]}, {"u": 90, "kind": "dialogue", "text": "Time to pick a vat.", "name": "CONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 91, "kind": "action", "text": "She walks away toward the trough.", "para": 19, "sent": 0, "present": [0, 1, 2]}, {"u": 92, "kind": "action", "text": "He lingers over the dead horse for one last moment, touches its mane, and follows.", "para": 19, "sent": 1, "present": [0, 1, 2]}]}