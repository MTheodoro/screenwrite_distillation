{"scene_id": "s00017", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00017.fountain", "heading": "EXT. HOT-AIR BALLOON BASKET - 400 FEET UP - DAY", "cast": [{"id": 0, "name": "GLORIA PENDERGAST", "names": ["GLORIA PENDERGAST", "GLORIA"], "gender": "f", "first": 4, "spoke": 5}, {"id": 1, "name": "WINNIE OKONKWO-HART", "names": ["WINNIE OKONKWO-HART", "WINNIE"], "gender": "f", "first": 5, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. HOT-AIR BALLOON BASKET - 400 FEET UP - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A wicker box.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A burner.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A county fair shrunk to a quilt far below.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "GLORIA PENDERGAST (60s, sun visor, clipboard) stands at one wall.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside her, WINNIE OKONKWO-HART (20s, borrowed sweater, white knuckles on the rope).", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Gloria cups her hands and bellows over the side.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Welcome, everyone! Enjoy the view!", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Nobody below hears.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "A cow looks up.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Why are we shouting?", "name": "WINNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Tradition.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Winnie closes her eyes.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "The basket tilts.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She opens them.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Don't look down. Don't look down.", "name": "WINNIE", "speaker": 1, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Gloria taps her clipboard, squints at a dial, and mutters.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Pilot never said it'd do that.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Do what?", "name": "WINNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Nothing. Everybody smile for the camera!", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "There is no camera.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Winnie slowly forces a smile anyway.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Gloria hands her the clipboard.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Hold this. And whatever you do, don't let go of her.", "name": "GLORIA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Of who?", "name": "WINNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Gloria points at the burner.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "It hisses.", "para": 7, "sent": 1, "present": [0, 1]}]}