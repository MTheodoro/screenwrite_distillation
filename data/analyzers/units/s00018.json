{"scene_id": "s00018", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00018.fountain", "heading": "INT. FERRYBOAT SNACK BAR - AFTERNOON", "cast": [{"id": 0, "name": "GRANDPA EZEKIEL", "names": ["GRANDPA EZEKIEL", "EZEKIEL"], "gender": "?", "first": 3, "spoke": 6}, {"id": 1, "name": "PIPPA", "names": ["PIPPA"], "gender": "?", "first": 3, "spoke": 4}, {"id": 2, "name": "JUNIOR", "names": ["JUNIOR"], "gender": "?", "first": 3, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. FERRYBOAT SNACK BAR - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Plastic chairs bolted down.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Gulls wheel past the window.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "GRANDPA EZEKIEL (70s, cardigan, newspaper folded in quarters) stirs his coffee while his granddaughter PIPPA (9, bandaged knee, sticker book) turns pages beside him and her older brother JUNIOR (14, hood up, one earbud in) slouches opposite, ignoring both and sliding his sandwich crust from one side of the plate to the other.", "para": 0, "sent": 2, "present": [0, 1, 2]}, {"u": 4, "kind": "dialogue", "text": "Grandpa, did you ever fall off a boat?", "name": "PIPPA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "Twice.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Did it hurt?", "name": "PIPPA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "The second time, no. By then I knew how.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "That's not how that works.", "name": "JUNIOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "It is if you do it right.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Show me.", "name": "PIPPA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Not on this boat.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Can we get off at the next stop?", "name": "JUNIOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "There's no next stop. It's a ferry.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Then we're stuck.", "name": "PIPPA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Stuck is a strong word. We're simply committed.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}