{"scene_id": "s00019", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00019.fountain", "heading": "INT. MUSHROOM FARM - GROWING TUNNEL - NIGHT", "cast": [{"id": 0, "name": "MAGNUS LINDGREN", "names": ["MAGNUS LINDGREN", "MAGNUS"], "gender": "m", "first": 6, "spoke": 12}, {"id": 1, "name": "ZUZU", "names": ["ZUZU"], "gender": "?", "first": 7, "spoke": 7}, {"id": 2, "name": "KOWALCZYK", "names": ["KOWALCZYK"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "ABIOLA ADEBAYO-CLARK", "names": ["ABIOLA ADEBAYO-CLARK", "ABIOLA"], "gender": "f", "first": 8, "spoke": 8}, {"id": 4, "name": "STRANGER", "names": ["STRANGER"], "gender": "m", "first": 9, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. MUSHROOM FARM - GROWING TUNNEL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A mile of dark.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wet concrete.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Shelves of pale caps stacked to the ceiling, glowing faintly under purple grow-lights.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The air is thick with spores and damp rot.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Four flashlight beams cut the gloom.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "MAGNUS LINDGREN (50s, farm foreman, a ring of keys, a limp) walks point.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Behind him, ZUZANNA \"ZUZU\" KOWALCZYK (20s, seasonal picker, hairnet, boots too big) clutches a bucket.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Then ABIOLA ADEBAYO-CLARK (30s, state inspector, clipboard, mask pulled under her chin).", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Last of all, a STRANGER (30s, soaked jacket, no ID, a duffel strapped across his back) who joined them at the gate.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Something drips.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Something shifts.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Stay close. Don't touch the shelves.", "name": "MAGNUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Why not?", "name": "ABIOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Contamination.", "name": "MAGNUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "She scribbles on her clipboard.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "He doesn't watch her do it.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Zuzu stops.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Her light has found a shelf where the caps are wrong.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Taller.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Gray-veined.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Their gills pulse, slow, like breathing.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Mr. Lindgren.", "name": "ZUZU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Keep walking.", "name": "MAGNUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "They're moving.", "name": "ZUZU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "They're not.", "name": "MAGNUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "He walks on.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "She doesn't.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "The Stranger steps up beside her and lowers his light until it falls on the cap nearest them.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "It leans toward the beam.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Just slightly.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Then away.", "para": 6, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "They don't like the light.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Who are you?", "name": "ZUZU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "He doesn't answer.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Behind them, Abiola's pen scratches, stops, scratches again.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Foreman. Your water logs don't match the humidity readings.", "name": "ABIOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "I'll fix it.", "name": "MAGNUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Not a fix. A discrepancy.", "name": "ABIOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "I said I'll fix it.", "name": "MAGNUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "He is walking faster.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Keys jangling.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "The tunnel bends.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "The grow-lights dim in the curve and the shelves close in on both sides.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Zuzu hurries to catch up, nearly stumbling.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Her flashlight beam wobbles over a patch of floor.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Something lies there, wrapped in a hairnet.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "A boot.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Half a boot.", "para": 9, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "She stops.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Her mouth opens, closes.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "Abiola.", "name": "ZUZU", "speaker": 1, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "Hm?", "name": "ABIOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "Look at the floor.", "name": "ZUZU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "Abiola looks.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Her pen stops mid-word.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Mr. Lindgren. What is that.", "name": "ABIOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "Magnus has turned.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "He holds his light on the boot, then on Zuzu, and for a moment nobody says anything at all.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "Previous picker. Quit last week.", "name": "MAGNUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "Quit without his boot?", "name": "ABIOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "People are strange.", "name": "MAGNUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "The Stranger takes one slow step backward.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "His duffel scrapes a shelf.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "A cap bends toward him.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "Don't move.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "Everyone freezes.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "action", "text": "The dripping stops.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "action", "text": "The glow from the shelves swells, then settles, like a held breath released.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "Then: a rustle, far down the tunnel.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "action", "text": "Many small sounds.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "action", "text": "Soft as a hand on silk.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "dialogue", "text": "What is that?", "name": "ZUZU", "speaker": 1, "ext": [], "paren": ["barely audible"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "action", "text": "The Stranger looks at Magnus.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "action", "text": "Magnus looks at his keys.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "dialogue", "text": "He knows.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 76, "kind": "dialogue", "text": "I don't.", "name": "MAGNUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 77, "kind": "dialogue", "text": "Then why did you lock the gate behind us?", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 78, "kind": "action", "text": "Abiola turns to Magnus slowly.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 79, "kind": "action", "text": "Her clipboard lowers.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 80, "kind": "dialogue", "text": "Mr. Lindgren.", "name": "ABIOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 81, "kind": "dialogue", "text": "It's protocol.", "name": "MAGNUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 82, "kind": "dialogue", "text": "It's a lie.", "name": "ABIOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 83, "kind": "action", "text": "The rustling is closer.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 84, "kind": "action", "text": "Zuzu's bucket tips and spills a hundred pale caps onto the concrete.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 85, "kind": "action", "text": "They quiver.", "para": 18, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 86, "kind": "dialogue", "text": "Please. Please just open the gate.", "name": "ZUZU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 87, "kind": "action", "text": "Magnus pulls the ring of keys from his belt, holds them out in his shaking hand.", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 88, "kind": "dialogue", "text": "I can't. They're not for the gate. They're for the door at the other end.", "name": "MAGNUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 89, "kind": "dialogue", "text": "What's at the other end?", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 90, "kind": "action", "text": "Magnus finally lifts his eyes.", "para": 20, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 91, "kind": "dialogue", "text": "The reason it's quiet now.", "name": "MAGNUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 92, "kind": "action", "text": "The rustling stops.", "para": 21, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 93, "kind": "action", "text": "The grow-lights flicker.", "para": 21, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 94, "kind": "action", "text": "A single cap, dead center on the floor, begins to rise.", "para": 21, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 95, "kind": "action", "text": "Zuzu exhales.", "para": 22, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 96, "kind": "action", "text": "And the Stranger, slowly, unslings the duffel, unzips it, and takes out a small steel canister with a red valve.", "para": 22, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 97, "kind": "dialogue", "text": "Then we go the other way.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}