{"scene_id": "s00023", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00023.fountain", "heading": "INT. FREIGHT ELEVATOR, CANNERY - NIGHT", "cast": [{"id": 0, "name": "SAUL VERHOEVEN", "names": ["SAUL VERHOEVEN", "SAUL"], "gender": "?", "first": 4, "spoke": 2}, {"id": 1, "name": "NADIA PRUITT", "names": ["NADIA PRUITT", "NADIA"], "gender": "?", "first": 5, "spoke": 3}, {"id": 2, "name": "EMEKA OSEI", "names": ["EMEKA OSEI", "EMEKA"], "gender": "m", "first": 6, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. FREIGHT ELEVATOR, CANNERY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Steel cage.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Flickering bulb.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Stuck between floors.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SAUL VERHOEVEN (50s, grey suit, bleeding sleeve) leans on the wall.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "NADIA PRUITT (30s, tactical vest, gun lowered) watches the hatch.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Beside her, a young courier, EMEKA OSEI (20s, backpack hugged tight).", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Nobody touches the panel.", "name": "NADIA", "speaker": 1, "ext": [], "paren": ["to everyone"], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Is it bad? Your arm?", "name": "EMEKA", "speaker": 2, "ext": [], "paren": ["quiet, to Saul"], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "It's fine, kid.", "name": "SAUL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Nadia cranes toward the ceiling.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Dust drifts down.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Come on, come on. Not now.", "name": "NADIA", "speaker": 1, "ext": [], "paren": ["under her breath"], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Boots thump overhead.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Then stop.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Then nothing.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "They're gone?", "name": "EMEKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Be still.", "name": "NADIA", "speaker": 1, "ext": [], "paren": ["to Emeka"], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Saul slides the backpack from Emeka's arms.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Emeka lets him.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Should've taken the stairs.", "name": "SAUL", "speaker": 0, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "The cage lurches.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Slowly, it starts to rise.", "para": 5, "sent": 1, "present": [0, 1, 2]}]}