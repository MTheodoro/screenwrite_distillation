{"scene_id": "s00025", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00025.fountain", "heading": "INT. MOBILE SURGICAL TRUCK, FAIRGROUND - NIGHT", "cast": [{"id": 0, "name": "IMELDA CASTELLANOS-BRIGHT", "names": ["IMELDA CASTELLANOS-BRIGHT", "IMELDA"], "gender": "f", "first": 4, "spoke": 16}, {"id": 1, "name": "TOOTS", "names": ["TOOTS"], "gender": "?", "first": 5, "spoke": 14}, {"id": 2, "name": "VASSILIEV", "names": ["VASSILIEV"], "gender": "?", "first": 5, "spoke": 0}, {"id": 3, "name": "WENDELL", "names": ["WENDELL"], "gender": "m", "first": 14, "spoke": 6}, {"id": 4, "name": "DISPATCH", "names": ["DISPATCH"], "gender": "?", "first": 44, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. MOBILE SURGICAL TRUCK, FAIRGROUND - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Steel walls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fluorescent hum.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Outside, a carousel plays a warped waltz.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. IMELDA CASTELLANOS-BRIGHT (50s, silver braid, precise) scrubs at a stainless sink.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across the narrow room, ANTON \"TOOTS\" VASSILIEV (30s, medic, tattooed forearms) wheels in a gurney.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "A sheet covers the shape on it.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Toots. Slower.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Sorry, Doc. Floor's uneven.", "name": "TOOTS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "It's a truck in a field. Everything's uneven.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Toots locks the gurney.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "The carousel music thins, then swells.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Vitals are stable. Pressure's low, but he's talking.", "name": "TOOTS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Who is he?", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Calls himself Wendell. Fell off the Ferris wheel.", "name": "TOOTS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Fell.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "That's his word.", "name": "TOOTS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Imelda dries her hands.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "She folds the sheet back.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "WENDELL (60s, pale, cheerful, fairground jacket) squints up at the lights.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Hello, hello. Don't go to any trouble.", "name": "WENDELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Mr. Wendell, I'm Dr. Castellanos-Bright. Where does it hurt?", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Nowhere, really. Funny that.", "name": "WENDELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Pain meds?", "name": "IMELDA", "speaker": 0, "ext": [], "paren": ["to Toots"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "None. He refused.", "name": "TOOTS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Refused?", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "I like to feel where I am.", "name": "WENDELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "She checks his pupils.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "He follows her light with unnerving ease.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Toots shifts on his feet.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Doc, a word?", "name": "TOOTS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Say it here.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "It's not a thing for here.", "name": "TOOTS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "She holds his gaze.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Then she walks him to the corner, out of Wendell's earshot.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "What.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Fall was sixty feet. He landed on concrete.", "name": "TOOTS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "And?", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Nothing's broken. Not a rib. Not a bruise.", "name": "TOOTS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Imelda looks back at Wendell.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "He waves.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Then he's lucky.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Doc, I felt for a pulse four times. I couldn't find one.", "name": "TOOTS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "The radio on the wall CRACKLES.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Mobile Two, dispatch. Ambulance en route, ETA fifteen. Say your patient's condition.", "name": "DISPATCH", "speaker": 4, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Imelda keys the radio, eyes on Wendell.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Dispatch, patient is stable. Repeat, stable.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": ["into radio"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "Copy. Be advised, caller says the Ferris wheel victim was pronounced at the scene. Please confirm identity.", "name": "DISPATCH", "speaker": 4, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Silence.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "The carousel waltz winds down to a single note.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Doc.", "name": "TOOTS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "I heard.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "She turns.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Wendell is sitting up, the sheet pooled at his waist.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "He's still smiling.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "His chest does not rise or fall.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Dr. Castellanos-Bright. I think I'd like some of that pain medicine after all.", "name": "WENDELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "Why's that, Mr. Wendell?", "name": "IMELDA", "speaker": 0, "ext": [], "paren": ["slowly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "Because it's starting.", "name": "WENDELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "He looks down at his hands.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "They are going translucent, like wax over a flame.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "Doc, back away.", "name": "TOOTS", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "Imelda doesn't.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "She reaches out and takes Wendell's hand, which is already cooling.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "dialogue", "text": "Toots, tell dispatch to cancel the ambulance.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "Doc--", "name": "TOOTS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "dialogue", "text": "Tell them he's been pronounced.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": ["not looking away"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "action", "text": "Toots stares at her.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "action", "text": "Then he lifts the radio, and his voice breaks.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "dialogue", "text": "Dispatch, Mobile Two. Cancel the ambulance.", "name": "TOOTS", "speaker": 1, "ext": [], "paren": ["into radio"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "dialogue", "text": "Thank you for staying.", "name": "WENDELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "action", "text": "The sheet settles over an empty gurney.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "action", "text": "Outside, the carousel starts again from the beginning.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}]}