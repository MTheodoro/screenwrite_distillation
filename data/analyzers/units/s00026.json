{"scene_id": "s00026", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00026.fountain", "heading": "INT. PIGEON LOFT, ROOFTOP - DAWN", "cast": [{"id": 0, "name": "STASYS BIRKAVS", "names": ["STASYS BIRKAVS", "STASYS"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "DONNIE FUSCO", "names": ["DONNIE FUSCO", "DONNIE"], "gender": "m", "first": 5, "spoke": 2}, {"id": 2, "name": "FAT LEO ARMBRUSTER", "names": ["FAT LEO ARMBRUSTER", "LEO"], "gender": "m", "first": 5, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. PIGEON LOFT, ROOFTOP - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Cooing.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Feathers.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Three men in a cage of chicken wire.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "STASYS BIRKAVS (50s, flat cap, careful) feeds grain from a tin.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "DONNIE FUSCO (30s, tracksuit) and FAT LEO ARMBRUSTER (40s, enormous, quiet) sit on upturned buckets.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Nobody here is angry. Understand?", "name": "STASYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Nobody's angry.", "name": "DONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "The money is a number on paper. I like birds more than numbers.", "name": "STASYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Birds don't lend.", "name": "LEO", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "No. They return. That is the difference.", "name": "STASYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "So we're square? Everyone square?", "name": "DONNIE", "speaker": 1, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Of course. Leo, the bucket.", "name": "STASYS", "speaker": 0, "ext": [], "paren": ["smiling"], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Leo lifts his bucket.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Underneath, a revolver, and beneath that, an envelope fat with cash.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Donnie's smile slides off his face.", "para": 2, "sent": 2, "present": [0, 1, 2]}]}