{"scene_id": "s00028", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00028.fountain", "heading": "INT. BACKSTAGE, SUBMARINE-THEMED MUSEUM GIFT SHOP - NIGHT", "cast": [{"id": 0, "name": "ELOISE VANTERPOOL", "names": ["ELOISE VANTERPOOL", "ELOISE"], "gender": "?", "first": 3, "spoke": 13}, {"id": 1, "name": "ROMAN ASTOR-LIN", "names": ["ROMAN ASTOR-LIN", "ROMAN"], "gender": "?", "first": 4, "spoke": 14}, {"id": 2, "name": "HESTER PENHALLOW", "names": ["HESTER PENHALLOW", "PENHALLOW"], "gender": "?", "first": 13, "spoke": 3}, {"id": 3, "name": "COLM BRADSHAW", "names": ["COLM BRADSHAW", "COLM"], "gender": "?", "first": 38, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. BACKSTAGE, SUBMARINE-THEMED MUSEUM GIFT SHOP - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped storeroom of plush squid, periscope keychains, and cardboard boxes marked FRAGILE.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A string of party lights hangs over a folding table of wilting cupcakes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "ELOISE VANTERPOOL (30s, rolled-up sleeves, name tag reading \"Ask Me About Barnacles\") counts stock with a clicker.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "At the doorway, ROMAN ASTOR-LIN (30s, rumpled blazer, wet from the rain) lingers with a bouquet of grocery-store carnations.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "Hi.", "name": "ROMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "You're late.", "name": "ELOISE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "I know.", "name": "ROMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "By three years, in fact.", "name": "ELOISE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I know.", "name": "ROMAN", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She keeps clicking.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He sets the carnations on the table, beside a cupcake that has \"CONGRATS\" piped across it in blue.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Whose party?", "name": "ROMAN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Retirement. Dr. Penhallow. Thirty-one years of squid.", "name": "ELOISE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I came to see you.", "name": "ROMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Ro, don't.", "name": "ELOISE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Eloise, listen. I didn't leave because I wanted to. My mother got sick, I flew to Singapore, and every time I tried to write the letter it came out like a lie. So I stopped trying. And then it was a year. And then it was too long.", "name": "ROMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "You could have called.", "name": "ELOISE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "I could have done a lot of things. I'm not asking you to forgive me. I'm only asking you to let me stand here for a minute.", "name": "ROMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "She stops clicking.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "She sets the clicker down and finally turns.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Your mother?", "name": "ELOISE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "She passed in March.", "name": "ROMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "I'm sorry.", "name": "ELOISE", "speaker": 0, "ext": [], "paren": ["softer"], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Thank you.", "name": "ROMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Ro...", "name": "ELOISE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Yeah?", "name": "ROMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "You still have that stupid scarf?", "name": "ELOISE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "It's in the car.", "name": "ROMAN", "speaker": 1, "ext": [], "paren": ["laughing, relieved"], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Laughter from the corridor.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "A door bangs open and a crowd of coworkers fills the storeroom with noise.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "At the front, a new arrival: DR. HESTER PENHALLOW (60s, tweed, bow tie shaped like a seahorse), glowing with champagne.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Eloise! There you are! Is this the famous Roman?", "name": "PENHALLOW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Dr. Penhallow, he's not--", "name": "ELOISE", "speaker": 0, "ext": [], "paren": ["blushing"], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "You've been talking about him for three years. Have a cupcake, dear boy.", "name": "PENHALLOW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Roman looks at Eloise.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "She does not meet his eyes, but she does not deny it.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Thank you. I will.", "name": "ROMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Behind them, a grinning intern, COLM BRADSHAW (20s, lanyard, hopeful), holds up a phone.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Group photo! Everyone squeeze in!", "name": "COLM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Eloise steps beside Roman.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Their shoulders touch.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Neither moves away.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "You're buying dinner.", "name": "ELOISE", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Anything.", "name": "ROMAN", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Anywhere?", "name": "ELOISE", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Anywhere.", "name": "ROMAN", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Colm's flash goes off.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "For one frame, they are both laughing.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Lovely. Now, who wants to hear about the giant squid?", "name": "PENHALLOW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Groans from everyone.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Eloise leans against Roman and whispers.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Run.", "name": "ELOISE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "They slip out through the storeroom's back door.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "The party lights keep swaying behind them.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}]}