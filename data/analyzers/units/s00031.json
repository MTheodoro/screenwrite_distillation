{"scene_id": "s00031", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00031.fountain", "heading": "INT. CLOCKMAKER'S GUILD VAULT ANTECHAMBER - NIGHT", "cast": [{"id": 0, "name": "SECOND MAN", "names": ["MAN", "SECOND MAN"], "gender": "?", "first": 4, "spoke": 0}, {"id": 1, "name": "JANITOR", "names": ["JANITOR"], "gender": "?", "first": 9, "spoke": 5}, {"id": 2, "name": "GUARD", "names": ["GUARD"], "gender": "?", "first": 10, "spoke": 5}, {"id": 3, "name": "DWYER", "names": ["DWYER"], "gender": "m", "first": 25, "spoke": 3}, {"id": 4, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 33, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. CLOCKMAKER'S GUILD VAULT ANTECHAMBER - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Marble floor.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Brass pendulums under glass domes, swinging out of sync.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A time lock gleams on a steel door.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A MAN in a janitor's coverall mops, eyes down.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He is tall, mid-40s, with a limp.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Behind him, a second MAN in a security blazer, younger, wide-shouldered, scrolls a tablet.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "The janitor stops mopping and glances at the guard.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "The guard doesn't look up.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "dialogue", "text": "Quiet shift.", "name": "JANITOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Don't talk to me while I'm working.", "name": "GUARD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Right.", "name": "JANITOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "He mops closer to the door.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "His mop handle taps the lock panel, twice, a soft tick.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Hey. What was that?", "name": "GUARD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Nothing. Sorry.", "name": "JANITOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "The guard approaches, tablet lowered.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "The janitor straightens.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Their eyes meet.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I don't think I know you.", "name": "GUARD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Third week. Night crew.", "name": "JANITOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Name?", "name": "GUARD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "A beat.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Somewhere, a pendulum clicks.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The janitor's hand slips into his bucket.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Cormac Dwyer.", "name": "JANITOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "There's no Dwyer on the roster.", "name": "GUARD", "speaker": 2, "ext": [], "paren": ["reading from tablet"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "No. There isn't.", "name": "DWYER", "speaker": 3, "ext": [], "paren": ["calmly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "He pulls a taser from the bucket and fires.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "The guard drops.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Dwyer kneels, takes his keycard, and turns to the pendulums.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "At the far end of the room, a SECOND MAN has stood watching from the shadows the entire time: a thin figure in a clockmaker's apron, silver hair, spectacles.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "He steps forward.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "You're early.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "You said midnight.", "name": "DWYER", "speaker": 3, "ext": [], "paren": ["not surprised"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "I said twelve-oh-three. He walks the floor at twelve-oh-two.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Then he's dead on schedule.", "name": "DWYER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "The stranger smiles, tucks a loupe into his pocket, and removes a key from around his neck.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Call me Aurelio.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "AURELIO inserts the key.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "The vault door sighs open on a room of ticking gold.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}]}