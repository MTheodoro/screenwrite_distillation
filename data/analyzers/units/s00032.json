{"scene_id": "s00032", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00032.fountain", "heading": "EXT. SALT FLATS WAGON STOP - NOON", "cast": [{"id": 0, "name": "HANNAH DELACROIX", "names": ["HANNAH DELACROIX", "DELACROIX", "HANNAH"], "gender": "f", "first": 6, "spoke": 5}, {"id": 1, "name": "ZEKE", "names": ["ZEKE"], "gender": "?", "first": 7, "spoke": 5}, {"id": 2, "name": "MARSHAL TOBIAS GRAINGER", "names": ["MARSHAL TOBIAS GRAINGER", "GRAINGER"], "gender": "m", "first": 8, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SALT FLATS WAGON STOP - NOON", "present": []}, {"u": 1, "kind": "action", "text": "White ground.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "White sky.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single wagon with a cracked wheel.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A water barrel under a tarp.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The heat shimmers like paper held over a flame.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "HANNAH DELACROIX (30s, dust-caked bonnet, rifle across her knees) sits on the wagon tongue.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Her husband EZEKIEL \"ZEKE\" DELACROIX (30s, bandaged hand) paces the barrel.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Across the flats, a lone rider approaches slowly, leading a second horse: MARSHAL TOBIAS GRAINGER (50s, gray duster, tin star scratched with age).", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Grainger reins up, tips his hat.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Afternoon.", "name": "GRAINGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Marshal.", "name": "HANNAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Afternoon.", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Looks like a wheel gave out.", "name": "GRAINGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "It did.", "name": "HANNAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "I could help.", "name": "GRAINGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "We're fine.", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Grainger swings down.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "He pats his horse.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "He looks at the barrel, the rifle, Zeke's bandaged hand.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Cut yourself?", "name": "GRAINGER", "speaker": 2, "ext": [], "paren": ["to Zeke"], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Rope.", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Funny. Rope burns look different from teeth.", "name": "GRAINGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Hannah's finger moves toward the trigger.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Zeke's jaw works.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Marshal, you're welcome to water.", "name": "HANNAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "That's kind. I'm not thirsty.", "name": "GRAINGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "He walks to the back of the wagon and lifts the tarp.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Underneath: a canvas sack, dark with dried stains.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Well, now.", "name": "GRAINGER", "speaker": 2, "ext": ["CONT'D"], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Let it be, Marshal.", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Let it be.", "name": "HANNAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "They say it together, flat and fast.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "^We didn't kill him for the money.", "name": "ZEKE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "^He came for the children.", "name": "HANNAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Grainger lets the tarp fall.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "The wind lifts a thin curtain of salt.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Hell of a place to find out you were right.", "name": "GRAINGER", "speaker": 2, "ext": [], "paren": ["to the flats"], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "He unbuckles his gun belt and drops it in the dust.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Put that rifle down, ma'am. I'm only going to sit.", "name": "GRAINGER", "speaker": 2, "ext": ["CONT'D"], "paren": ["to Hannah"], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "She doesn't.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "He sits anyway.", "para": 9, "sent": 1, "present": [0, 1, 2]}]}