{"scene_id": "s00037", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00037.fountain", "heading": "INT. NATURAL HISTORY MUSEUM, DINOSAUR HALL - NIGHT", "cast": [{"id": 0, "name": "CASSIUS OBAYOMI", "names": ["CASSIUS OBAYOMI", "CASSIUS"], "gender": "?", "first": 6, "spoke": 4}, {"id": 1, "name": "RENATA VOSKUIJLEN", "names": ["RENATA VOSKUIJLEN"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "FONZ", "names": ["FONZ"], "gender": "m", "first": 6, "spoke": 1}, {"id": 3, "name": "MARBURY", "names": ["MARBURY"], "gender": "?", "first": 6, "spoke": 0}, {"id": 4, "name": "PALOMA TREVINO-HALE", "names": ["PALOMA TREVINO-HALE", "PALOMA"], "gender": "f", "first": 6, "spoke": 1}, {"id": 5, "name": "GUSTAV LINDQVIST", "names": ["GUSTAV LINDQVIST"], "gender": "m", "first": 6, "spoke": 0}, {"id": 6, "name": "QUINCY ABERNATHY", "names": ["QUINCY ABERNATHY", "QUINCY"], "gender": "?", "first": 6, "spoke": 1}, {"id": 7, "name": "GUARD", "names": ["GUARD"], "gender": "?", "first": 18, "spoke": 0}, {"id": 8, "name": "ROLAND PIKE", "names": ["ROLAND PIKE", "ROLAND"], "gender": "?", "first": 23, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. NATURAL HISTORY MUSEUM, DINOSAUR HALL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cathedral of bones.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A Diplodocus skeleton arches over the central floor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Moonlight pours through high windows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Somewhere a pipe drips.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A service door clicks open.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "Six figures in black filter in, silent as cats: CASSIUS OBAYOMI (40s, crew boss, headset), RENATA VOSKUIJLEN (30s, safecracker, tool roll), ILDEFONSO \"FONZ\" MARBURY (20s, climber, harness), PALOMA TREVINO-HALE (30s, hacker, laptop bag), GUSTAV LINDQVIST (60s, forger, silk gloves), and QUINCY ABERNATHY (20s, driver, nervy).", "para": 1, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 7, "kind": "dialogue", "text": "Clock's running. Eleven minutes.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 8, "kind": "action", "text": "Renata crosses to a glass case under the skeleton's ribs, where a fossilized egg sits on velvet.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 9, "kind": "action", "text": "Fonz clips a line to the beam above and begins to ascend.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "action", "text": "Paloma kneels beside a wall panel, jacks in, and her screen scrolls green code.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "action", "text": "Gustav circles the display, comparing the egg to a photograph in his palm, while Quincy hovers at the doorway, watching the corridor with his heart in his throat.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "Cameras are looped.", "name": "PALOMA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "Fonz?", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "Almost. Bone's slick.", "name": "FONZ", "speaker": 2, "ext": [], "paren": ["from above"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "action", "text": "Renata pries the lock.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "action", "text": "It pops.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "action", "text": "She lifts the lid and Gustav, with trembling gloved hands, swaps the real egg for a copy, but a sharp CLICK echoes from the corridor and Quincy swallows, Fonz freezes in mid-swing, Paloma shuts her laptop, and Renata drops flat behind the case.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "Guard. Coming this way.", "name": "QUINCY", "speaker": 6, "ext": [], "paren": ["hissing"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 19, "kind": "dialogue", "text": "Positions.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 20, "kind": "action", "text": "Fonz hauls himself up onto the Diplodocus ribs.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 21, "kind": "action", "text": "Gustav tucks the real egg inside his coat and melts behind a pillar.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 22, "kind": "action", "text": "Paloma and Renata slide under a bench, and Cassius presses against the wall beside the door as a flashlight beam swings across the floor.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 23, "kind": "action", "text": "A GUARD, a heavyset man in his fifties named ROLAND PIKE, strolls in humming.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 24, "kind": "action", "text": "He pauses at the case.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 25, "kind": "action", "text": "He sweeps his light along the glass.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 26, "kind": "action", "text": "A beat.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 27, "kind": "action", "text": "Another.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 28, "kind": "action", "text": "Cassius raises a fist, ready.", "para": 5, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 29, "kind": "dialogue", "text": "Dang pigeons.", "name": "ROLAND", "speaker": 8, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 30, "kind": "action", "text": "He wanders off.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 31, "kind": "action", "text": "His footsteps fade.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 32, "kind": "action", "text": "The crew exhales as one.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 33, "kind": "action", "text": "Fonz drops silently to the floor and the six of them regroup near the door.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 34, "kind": "action", "text": "Cassius counts heads with a finger.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 35, "kind": "dialogue", "text": "Out. Now.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 36, "kind": "action", "text": "They file through the service door, one by one, Gustav last, cradling the egg like a newborn.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 37, "kind": "action", "text": "The Diplodocus watches them go.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}]}