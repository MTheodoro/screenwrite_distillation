{"scene_id": "s00039", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00039.fountain", "heading": "INT. PRIVATE LIBRARY OF A VICTORIAN MANOR - NIGHT", "cast": [{"id": 0, "name": "INSPECTOR PHILOMENA CRABTREE", "names": ["INSPECTOR PHILOMENA CRABTREE", "CRABTREE"], "gender": "?", "first": 4, "spoke": 9}, {"id": 1, "name": "CONSTABLE REGINALD OKAFOR-WELLS", "names": ["CONSTABLE REGINALD OKAFOR-WELLS", "OKAFOR-WELLS"], "gender": "?", "first": 4, "spoke": 4}, {"id": 2, "name": "GWENDOLEN SLOANE", "names": ["GWENDOLEN SLOANE", "SLOANE"], "gender": "f", "first": 5, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. PRIVATE LIBRARY OF A VICTORIAN MANOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Candles gutter.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A thunderclap rattles the leaded glass.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "In the center of the room, a body lies under a red velvet curtain, only a pair of polished shoes showing.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "INSPECTOR PHILOMENA CRABTREE (50s, damp mackintosh, sharp eyes) enters, followed by CONSTABLE REGINALD OKAFOR-WELLS (20s, helmet under his arm).", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "A third figure waits by the fireplace: the manor's housekeeper, MRS. GWENDOLEN SLOANE (60s, black dress, key ring at her waist).", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Who found him?", "name": "CRABTREE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "I did, Inspector. At half past nine.", "name": "SLOANE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "And the door?", "name": "CRABTREE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Locked from within.", "name": "SLOANE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Then how did you get in?", "name": "OKAFOR-WELLS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I have a key.", "name": "SLOANE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Constable, the windows.", "name": "CRABTREE", "speaker": 0, "ext": [], "paren": ["to Okafor-Wells"], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "He checks each in turn.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Every latch is down.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Sealed, ma'am.", "name": "OKAFOR-WELLS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Crabtree kneels, lifts the curtain, and studies the dead man's face.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "A tiny smile crosses hers.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Mrs. Sloane. Did Lord Ashworth take his evening port?", "name": "CRABTREE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "He did.", "name": "SLOANE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "From this decanter?", "name": "CRABTREE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "She taps a crystal vessel on the mantel.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "It is empty.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "It was full when I left him.", "name": "SLOANE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Constable, the glass.", "name": "CRABTREE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Okafor-Wells lifts it with a handkerchief and sniffs.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "He recoils.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Almonds.", "name": "OKAFOR-WELLS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Mrs. Sloane's hand tightens on her keys.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Crabtree rises slowly.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Mrs. Sloane, I don't believe this man was alone when he died.", "name": "CRABTREE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Inspector, I assure you--", "name": "SLOANE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "A thump from the bookcase.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "All three freeze.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "The shelf swings inward on a hidden hinge and a gust of cold air blows out every candle but one.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Crabtree and Okafor-Wells spin toward the opening.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Mrs. Sloane bolts for the door, but Okafor-Wells catches her sleeve and the two of them struggle, keys clattering across the floor.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Constable, hold her.", "name": "CRABTREE", "speaker": 0, "ext": [], "paren": ["calmly"], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "I've got her, ma'am.", "name": "OKAFOR-WELLS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Crabtree raises the last candle toward the dark passage.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "You may come out now.", "name": "CRABTREE", "speaker": 0, "ext": [], "paren": ["to the dark"], "dual": false, "present": [0, 1, 2]}]}