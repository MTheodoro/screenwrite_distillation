{"scene_id": "s00041", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00041.fountain", "heading": "INT. COMPETITIVE PIE-BAKING TENT, COUNTY FAIR - DAY", "cast": [{"id": 0, "name": "AGGIE", "names": ["AGGIE"], "gender": "f", "first": 6, "spoke": 1}, {"id": 1, "name": "LINDQUIST-REYES", "names": ["LINDQUIST-REYES"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "LONNIE BIGGS", "names": ["LONNIE BIGGS", "LONNIE"], "gender": "m", "first": 7, "spoke": 1}, {"id": 3, "name": "MEI-LING ARROYO", "names": ["MEI-LING ARROYO"], "gender": "?", "first": 8, "spoke": 0}, {"id": 4, "name": "SIGMUND PRATT", "names": ["SIGMUND PRATT"], "gender": "?", "first": 9, "spoke": 0}, {"id": 5, "name": "DOROTHEA", "names": ["DOROTHEA"], "gender": "?", "first": 10, "spoke": 1}, {"id": 6, "name": "DELPHINE VASQUEZ-MOORE", "names": ["DELPHINE VASQUEZ-MOORE", "DELPHINE"], "gender": "?", "first": 10, "spoke": 1}, {"id": 7, "name": "JUDGE", "names": ["JUDGE"], "gender": "?", "first": 11, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. COMPETITIVE PIE-BAKING TENT, COUNTY FAIR - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Rows of folding tables.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Flour hangs in sunbeams like pollen.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A banner reads: 87TH ANNUAL PIE CHAMPIONSHIP.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A judge's gavel sits next to a bell.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Six contestants stand behind their pies in tight, silent ranks.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "AGATHA \"AGGIE\" LINDQUIST-REYES (60s, blue ribbon pinned to apron, jaw set) polishes a lattice crust with a pastry brush.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Beside her, LONNIE BIGGS (40s, sweating through a chef's coat, flour on his eyebrows) arranges cherries with tweezers.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "At the next station, the young prodigy MEI-LING ARROYO (16, braids, calm as a monk) lets her pie rest.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Behind them, SIGMUND PRATT (70s, bolo tie, hands tremble) hums a hymn.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "At the end of the row, twin sisters DOROTHEA and DELPHINE VASQUEZ-MOORE (50s, identical aprons, identical glares) tap the same rhythm on their tables.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "action", "text": "A JUDGE in a straw boater strolls the line, clipboard in hand.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "action", "text": "He stops at Aggie.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "Mrs. Lindquist-Reyes. Third time in the final. Nervous?", "name": "JUDGE", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 14, "kind": "dialogue", "text": "Never.", "name": "AGGIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 15, "kind": "action", "text": "Her brush twitches.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 16, "kind": "action", "text": "Lonnie watches it twitch.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 17, "kind": "dialogue", "text": "And you, young man?", "name": "JUDGE", "speaker": 7, "ext": [], "paren": ["to Lonnie"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 18, "kind": "dialogue", "text": "Oh, I'm great. Great! Totally relaxed!", "name": "LONNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 19, "kind": "action", "text": "A cherry rolls off his tweezers and across the table.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 20, "kind": "action", "text": "He does not move.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 21, "kind": "action", "text": "Everyone watches it roll.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 22, "kind": "action", "text": "It stops against Mei-Ling's pie.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 23, "kind": "action", "text": "She regards it, then flicks it back to him with one finger.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 24, "kind": "action", "text": "The judge raises his bell.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 25, "kind": "dialogue", "text": "^Don't you dare.", "name": "DOROTHEA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 26, "kind": "dialogue", "text": "^Don't you dare.", "name": "DELPHINE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 27, "kind": "action", "text": "The twins speak as one, to each other.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 28, "kind": "action", "text": "Neither blinks.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 29, "kind": "action", "text": "The judge rings the bell.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "action", "text": "All six lift their forks like swords.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "action", "text": "The tent goes still.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "action", "text": "Sigmund's hymn gets louder, then stops mid-note.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "action", "text": "The judge cuts into Aggie's pie.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "action", "text": "Steam rises.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "action", "text": "He takes a bite.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "action", "text": "Chews.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "action", "text": "His face reveals nothing.", "para": 9, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "dialogue", "text": "Hm.", "name": "JUDGE", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "action", "text": "Aggie's brush finally falls from her hand.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}