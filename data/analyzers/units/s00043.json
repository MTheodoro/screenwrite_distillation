{"scene_id": "s00043", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00043.fountain", "heading": "INT. CURLING CLUB LOUNGE, SECOND-FLOOR VIEWING GLASS - EVENING", "cast": [{"id": 0, "name": "HADLEY BRANTFORD", "names": ["HADLEY BRANTFORD", "HADLEY"], "gender": "f", "first": 5, "spoke": 10}, {"id": 1, "name": "ABDULLAH FARRUKH", "names": ["ABDULLAH FARRUKH", "ABDULLAH"], "gender": "?", "first": 6, "spoke": 3}, {"id": 2, "name": "WINNIE", "names": ["WINNIE"], "gender": "?", "first": 6, "spoke": 6}, {"id": 3, "name": "SOLBERG", "names": ["SOLBERG"], "gender": "?", "first": 6, "spoke": 0}, {"id": 4, "name": "ARCHIE", "names": ["ARCHIE"], "gender": "?", "first": 7, "spoke": 5}, {"id": 5, "name": "TWOMBLY", "names": ["TWOMBLY"], "gender": "?", "first": 7, "spoke": 0}, {"id": 6, "name": "DISPATCH", "names": ["DISPATCH"], "gender": "?", "first": 32, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. CURLING CLUB LOUNGE, SECOND-FLOOR VIEWING GLASS - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "The rink below glows blue-white.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Granite stones glide silently across ice.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A scoreboard reads END 9 / TIED 4-4.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The lounge is a warm cave of wood paneling, trophies, and a single fan whirring pointlessly.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "HADLEY BRANTFORD (40s, team skip, wool sweater, thermos of something stronger than tea) leans on the railing.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Behind her, on a leather couch, her teammates ABDULLAH FARRUKH (30s, sweeper, ice-burned cheeks) and WINIFRED \"WINNIE\" SOLBERG (20s, rookie, ponytail, quivering) sit with their brooms across their laps.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "At the bar, a retired champion, ARCHIBALD \"ARCHIE\" TWOMBLY (70s, cardigan, commentator headset around his neck), polishes a glass.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "dialogue", "text": "Winnie, your delivery.", "name": "HADLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "I know.", "name": "WINNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "You pulled it left in the eighth.", "name": "HADLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "I know.", "name": "WINNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "It's all right to know. I'd just like you to fix it.", "name": "HADLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "She's got it, Hadley.", "name": "ABDULLAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Does she?", "name": "HADLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "I've got it.", "name": "WINNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Then say it with your whole face.", "name": "HADLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "I have got it.", "name": "WINNIE", "speaker": 2, "ext": [], "paren": ["breathing in"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Better.", "name": "HADLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Back in '71, I threw the last stone with a broken wrist.", "name": "ARCHIE", "speaker": 4, "ext": [], "paren": ["from the bar"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "We know, Archie.", "name": "ABDULLAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Won, too.", "name": "ARCHIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Everyone's very proud of Archie.", "name": "HADLEY", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "A bell rings below.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "The teams are called to the ice.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Winnie rises first.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Abdullah follows, and Hadley screws the cap onto her thermos.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "This is Archie Twombly, live from the Glenmore Club. The last end is about to begin.", "name": "ARCHIE", "speaker": 4, "ext": [], "paren": ["into his headset"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Hadley, muttering to herself, does not turn around.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Don't blow it, Brantford.", "name": "HADLEY", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "A phone buzzes on the bar.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Archie answers.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Archie? It's the broadcast truck. We've lost your feed. Is the skip ready?", "name": "DISPATCH", "speaker": 6, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "She's ready. They're all ready.", "name": "ARCHIE", "speaker": 4, "ext": [], "paren": ["into phone"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "Hadley stops at the stairs.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "She looks down at the ice, pale and shining.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "Winnie. Whatever happens, you throw the last one.", "name": "HADLEY", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "Me? Hadley, no.", "name": "WINNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "dialogue", "text": "You. It's what you were born for.", "name": "HADLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "She's right.", "name": "ABDULLAH", "speaker": 1, "ext": [], "paren": ["low, to Winnie"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "Okay. Okay.", "name": "WINNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "They file down the stairs.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "Archie watches through the glass as three small figures step onto the ice.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "dialogue", "text": "Archie, we're back. Go ahead.", "name": "DISPATCH", "speaker": 6, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "dialogue", "text": "And here they come.", "name": "ARCHIE", "speaker": 4, "ext": [], "paren": ["into headset"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "action", "text": "He lifts a glass to the window and sets it down untouched.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}]}