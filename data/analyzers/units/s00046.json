{"scene_id": "s00046", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00046.fountain", "heading": "EXT. SHELLED FARMHOUSE ROOF, ARDENNES - DAWN", "cast": [{"id": 0, "name": "GENE", "names": ["GENE"], "gender": "?", "first": 3, "spoke": 3}, {"id": 1, "name": "BRODSKY", "names": ["BRODSKY"], "gender": "?", "first": 3, "spoke": 0}, {"id": 2, "name": "PRIVATE LOUIS TRUDEAU-PARK", "names": ["PRIVATE LOUIS TRUDEAU-PARK", "TRUDEAU-PARK"], "gender": "?", "first": 4, "spoke": 2}, {"id": 3, "name": "SERGEANT MARGUERITE OYELOWO", "names": ["SERGEANT MARGUERITE OYELOWO", "OYELOWO"], "gender": "?", "first": 5, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SHELLED FARMHOUSE ROOF, ARDENNES - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Snow dusts the broken tiles.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Beyond the ridge, the thud of far guns.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "CORPORAL EUGENE \"GENE\" BRODSKY (20s, frozen mustache) crouches behind a chimney with binoculars.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "Beside him, PRIVATE LOUIS TRUDEAU-PARK (19, baby-faced, rifle hugged) shivers.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 5, "kind": "action", "text": "A few yards away, SERGEANT MARGUERITE OYELOWO (30s, tough, her helmet dented) sits against a beam, tying a rag around her wrist.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "action", "text": "She tightens it with her teeth.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "He lowers the binoculars.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Sarge, I count six.", "name": "GENE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Count again.", "name": "OYELOWO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Eight.", "name": "GENE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Better.", "name": "OYELOWO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Is it true what they say? About the Tigers?", "name": "TRUDEAU-PARK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Louis, eat your biscuit.", "name": "OYELOWO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "I'm not hungry.", "name": "TRUDEAU-PARK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "I didn't ask.", "name": "OYELOWO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "He opens the biscuit tin.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "His fingers are blue.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "She reaches over and, without a word, tucks his scarf tighter.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "They're moving.", "name": "GENE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "She rises on one knee and takes the binoculars.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Her jaw hardens.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Gene, wire the others. Louis, with me.", "name": "OYELOWO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "They slide down the roof toward the ladder.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}]}