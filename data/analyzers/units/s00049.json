{"scene_id": "s00049", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00049.fountain", "heading": "EXT. CLIFFSIDE STAIRCASE OF THE WIND TEMPLE - DAWN", "cast": [{"id": 0, "name": "ALDRIC VANTERPOOL", "names": ["ALDRIC VANTERPOOL", "ALDRIC"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "THESSALY", "names": ["THESSALY"], "gender": "?", "first": 5, "spoke": 5}, {"id": 2, "name": "SORREL IRONBARK", "names": ["SORREL IRONBARK", "SORREL"], "gender": "?", "first": 6, "spoke": 4}, {"id": 3, "name": "BARNABUS GLIMMERWICK", "names": ["BARNABUS GLIMMERWICK", "BARNABUS"], "gender": "?", "first": 7, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. CLIFFSIDE STAIRCASE OF THE WIND TEMPLE - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Ten thousand steps, hewn into rock.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Prayer flags snap.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Clouds boil below.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ALDRIC VANTERPOOL (30s, battered armor, scabbard empty) climbs, panting.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Behind him, a hooded girl, THESSALY (teen, silver eyes, bare feet) hops step to step like a goat.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Further down, burly SORREL IRONBARK (40s, axe on back, braided beard) hauls himself up, wheezing.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Last comes the old wizard BARNABUS GLIMMERWICK (80s, crooked staff, patched robes), who rests on every third step.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Barnabus, hurry!", "name": "ALDRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "I am a wizard, not a mountain goat!", "name": "BARNABUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "I'm a mountain goat.", "name": "THESSALY", "speaker": 1, "ext": [], "paren": ["skipping"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Gods, the stairs.", "name": "SORREL", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Thessaly stops at a landing.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Above, a stone gate, and between its pillars, a shimmering curtain of wind.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "She puts out her hand.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "It ripples.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "It's open.", "name": "THESSALY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Is it safe?", "name": "ALDRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "No.", "name": "THESSALY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Good. I dislike safe.", "name": "SORREL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Barnabus catches up, bent double.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Aldric, listen. When we cross, the Wind Warden will ask each of us one question.", "name": "BARNABUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "What question?", "name": "ALDRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "What we fear most.", "name": "BARNABUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "^That's easy.", "name": "SORREL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "^That's easy.", "name": "THESSALY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "They answer together, then glare at each other.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Sorrel?", "name": "ALDRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Being forgotten.", "name": "SORREL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Thessaly?", "name": "ALDRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Being found.", "name": "THESSALY", "speaker": 1, "ext": [], "paren": ["small"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Aldric draws a breath.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Wind howls through the gate.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "He steps toward it, hand on the empty scabbard.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Then we go together.", "name": "ALDRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}