{"scene_id": "s00050", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00050.fountain", "heading": "INT. NIGHT BUS, MIDWEST HIGHWAY - NIGHT", "cast": [{"id": 0, "name": "CELESTE ARMITAGE-NOLAN", "names": ["CELESTE ARMITAGE-NOLAN", "CELESTE"], "gender": "f", "first": 5, "spoke": 7}, {"id": 1, "name": "DOM", "names": ["DOM"], "gender": "?", "first": 6, "spoke": 8}, {"id": 2, "name": "ACHEBE", "names": ["ACHEBE"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "DRIVER", "names": ["DRIVER"], "gender": "?", "first": 18, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT BUS, MIDWEST HIGHWAY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Half-lit aisle.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of sleeping strangers.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The engine drones like a long exhale.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain streaks the windows.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CELESTE ARMITAGE-NOLAN (30s, red scarf, paperback open on her knee) sits halfway back.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across the aisle, DOMINIC \"DOM\" ACHEBE (30s, rumpled suit, cold coffee) has been staring at her book for twenty minutes.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "He finally leans over.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Is it any good?", "name": "DOM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "It's a murder mystery.", "name": "CELESTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Does everyone die?", "name": "DOM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Mostly.", "name": "CELESTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Sounds restful.", "name": "DOM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She laughs, quietly, despite herself.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "The bus hits a pothole and the whole cabin lurches.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Her book slides to the floor.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Dom retrieves it and hands it back.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Their fingers touch.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Folks, we're pulling into Dubuque for a ten-minute break. Stretch your legs. Don't wander.", "name": "DRIVER", "speaker": 3, "ext": ["V.O."], "paren": ["over intercom, crackling"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Don't wander, he says.", "name": "CELESTE", "speaker": 0, "ext": [], "paren": ["to the cabin, dry"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Where would I go?", "name": "DOM", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "He stands.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "The bus brakes hiss.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Celeste rises too, and they collide in the narrow aisle.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Sorry.", "name": "CELESTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "No, I'm sorry.", "name": "DOM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "I'm Celeste.", "name": "CELESTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Dom.", "name": "DOM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "They shake hands, lingering.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Anybody traveling to Chicago, I'll be holding the bus for exactly ten minutes. Not eleven.", "name": "DRIVER", "speaker": 3, "ext": ["V.O."], "paren": ["over intercom"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Chicago.", "name": "DOM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Me too.", "name": "CELESTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "He looks at her, hope in his face.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Then I guess we have eleven hours.", "name": "DOM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "She picks up her book.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Then you'd better tell me who did it.", "name": "CELESTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}