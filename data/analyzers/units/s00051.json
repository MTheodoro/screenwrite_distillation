{"scene_id": "s00051", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00051.fountain", "heading": "INT. AMATEUR THEATER GREEN ROOM - NIGHT", "cast": [{"id": 0, "name": "THEODORA", "names": ["THEODORA"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "ALCOTT-WELLS", "names": ["ALCOTT-WELLS"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "BILLIE", "names": ["BILLIE"], "gender": "?", "first": 5, "spoke": 3}, {"id": 3, "name": "FAIRCHILD", "names": ["FAIRCHILD"], "gender": "?", "first": 5, "spoke": 0}, {"id": 4, "name": "ALOYSIUS PENDERGAST-MWANGI", "names": ["ALOYSIUS PENDERGAST-MWANGI", "ALOYSIUS"], "gender": "?", "first": 6, "spoke": 5}, {"id": 5, "name": "GWENDOLINE POPE", "names": ["GWENDOLINE POPE", "GWENDOLINE"], "gender": "?", "first": 7, "spoke": 3}, {"id": 6, "name": "ARCHIE", "names": ["ARCHIE"], "gender": "?", "first": 8, "spoke": 4}, {"id": 7, "name": "TREMAINE", "names": ["TREMAINE"], "gender": "?", "first": 8, "spoke": 0}, {"id": 8, "name": "RODERICK SPARROW-LUND", "names": ["RODERICK SPARROW-LUND", "RODERICK"], "gender": "?", "first": 8, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. AMATEUR THEATER GREEN ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Costumes hang in clouds.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Powder, hairspray, a half-eaten sandwich.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A speaker on the wall hisses with the thin sound of an audience settling.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "THEODORA \"TEDDY\" ALCOTT-WELLS (50s, tragedy mask on her forehead) stands at the mirror adjusting a Roman toga.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Behind her, her understudy WILHELMINA \"BILLIE\" FAIRCHILD (20s, script clutched like a rosary) mouths lines to herself.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "action", "text": "Across the room, the director ALOYSIUS PENDERGAST-MWANGI (60s, cravat, velvet jacket) wrings his hands.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "action", "text": "At the costume rack, wardrobe mistress GWENDOLINE POPE (40s, pins in her mouth) hems a cape.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "action", "text": "Beside her sit the leading men: ARCHIBALD \"ARCHIE\" TREMAINE (30s, a laurel wreath), and RODERICK SPARROW-LUND (40s, a plastic sword).", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 9, "kind": "dialogue", "text": "She's late. Where is she?", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 10, "kind": "dialogue", "text": "Who?", "name": "ALOYSIUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 11, "kind": "dialogue", "text": "Calpurnia. The lead.", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 12, "kind": "dialogue", "text": "She's in the lavatory.", "name": "ALOYSIUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 13, "kind": "dialogue", "text": "She's been in the lavatory for forty minutes.", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 14, "kind": "dialogue", "text": "Maybe she fell in.", "name": "ARCHIE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 15, "kind": "dialogue", "text": "That's not funny, Archie.", "name": "RODERICK", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 16, "kind": "dialogue", "text": "It's a little funny.", "name": "ARCHIE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 17, "kind": "dialogue", "text": "Hold still, Teddy.", "name": "GWENDOLINE", "speaker": 5, "ext": [], "paren": ["through pins"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 18, "kind": "dialogue", "text": "I am still.", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 19, "kind": "dialogue", "text": "Mr. Pendergast-Mwangi, I know her lines.", "name": "BILLIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 20, "kind": "dialogue", "text": "Darling, you are an understudy.", "name": "ALOYSIUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 21, "kind": "dialogue", "text": "I'm a good understudy.", "name": "BILLIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 22, "kind": "dialogue", "text": "She really is, Aloysius.", "name": "RODERICK", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 23, "kind": "dialogue", "text": "She did the balcony scene in her sleep last week.", "name": "ARCHIE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 24, "kind": "dialogue", "text": "Because that is an excellent use of sleep.", "name": "ALOYSIUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 25, "kind": "action", "text": "The speaker hisses louder: the house lights dim, applause rises.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 26, "kind": "dialogue", "text": "Aloysius, she's not coming.", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 27, "kind": "dialogue", "text": "She will.", "name": "ALOYSIUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 28, "kind": "dialogue", "text": "She will not.", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 29, "kind": "dialogue", "text": "She will if I go and get her.", "name": "GWENDOLINE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 30, "kind": "action", "text": "She spits the pins into her palm and marches out.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 31, "kind": "dialogue", "text": "Billie, you're up.", "name": "ARCHIE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 32, "kind": "dialogue", "text": "Me?", "name": "BILLIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 33, "kind": "dialogue", "text": "Take the wreath.", "name": "RODERICK", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 34, "kind": "action", "text": "Archie lifts the wreath off his own head and lowers it onto hers.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 35, "kind": "action", "text": "She stares into the mirror.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 36, "kind": "action", "text": "Her hands stop shaking.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 37, "kind": "action", "text": "Gwendoline sails back in, towing a tearful woman in a bathrobe.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 38, "kind": "dialogue", "text": "Here she is.", "name": "GWENDOLINE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 39, "kind": "action", "text": "Billie and the woman in the bathrobe look at each other, and Billie hands back the wreath without a word.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}]}