{"scene_id": "s00053", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00053.fountain", "heading": "INT. OPEN-PLAN OFFICE, SYNERGY HOLDINGS - DAY", "cast": [{"id": 0, "name": "RAY", "names": ["RAY"], "gender": "?", "first": 5, "spoke": 8}, {"id": 1, "name": "FENNIMORE-SALAZAR", "names": ["FENNIMORE-SALAZAR"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "DELPHINE OKAFOR-LUND", "names": ["DELPHINE OKAFOR-LUND", "DELPHINE"], "gender": "f", "first": 6, "spoke": 6}, {"id": 3, "name": "INTERN QUENTIN BOSCH", "names": ["INTERN QUENTIN BOSCH", "QUENTIN"], "gender": "?", "first": 7, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. OPEN-PLAN OFFICE, SYNERGY HOLDINGS - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Cubicles.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Motivational posters.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A broken ficus.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A whiteboard reads: PIVOT TO JOY.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "RAYMOND \"RAY\" FENNIMORE-SALAZAR (40s, vice president of Vibes, a lanyard of lanyards) claps his hands.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "DELPHINE OKAFOR-LUND (30s, tired, double-fisted coffee) watches from her desk.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Next to her sits INTERN QUENTIN BOSCH (20s, tie from a high school dance).", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Team! Quick sync.", "name": "RAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "It's four-fifty-nine.", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Perfect time for a sync!", "name": "RAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "He means a meeting.", "name": "QUENTIN", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "A circle-back! A deep dive! A moment of alignment!", "name": "RAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "It's a Friday.", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Friday is the new Monday.", "name": "RAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "He draws a giant circle on the whiteboard, then another, then a third.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Delphine and Quentin stare, appalled.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Who can tell me what this means?", "name": "RAY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "^Three circles.", "name": "QUENTIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "^Three circles.", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "They say it together.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Ray points at them both, delighted.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Exactly! The Triple Loop!", "name": "RAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Ray.", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Yes?", "name": "RAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "I'm going home.", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Is that a no on the loop?", "name": "RAY", "speaker": 0, "ext": [], "paren": ["crestfallen"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "She gathers her bag.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Quentin, loyal, stays seated.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "I like the loop, Ray.", "name": "QUENTIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Ray beams.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Delphine pauses in the doorway.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Quentin. Run.", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}