{"scene_id": "s00054", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00054.fountain", "heading": "EXT. DUST-CHOKED TRADING POST, HIGH PLAINS - AFTERNOON", "cast": [{"id": 0, "name": "SALT", "names": ["SALT"], "gender": "?", "first": 4, "spoke": 0}, {"id": 1, "name": "NAILS", "names": ["NAILS"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "SPARROW", "names": ["SPARROW"], "gender": "?", "first": 5, "spoke": 4}, {"id": 3, "name": "CROWFOOT", "names": ["CROWFOOT"], "gender": "?", "first": 5, "spoke": 0}, {"id": 4, "name": "POSTMISTRESS CLEMENTINE VANDERMEER", "names": ["POSTMISTRESS CLEMENTINE VANDERMEER", "CLEMENTINE"], "gender": "?", "first": 6, "spoke": 4}, {"id": 5, "name": "SHERIFF AUGUSTINE BELL", "names": ["SHERIFF AUGUSTINE BELL", "BELL"], "gender": "?", "first": 7, "spoke": 7}, {"id": 6, "name": "WILLET FAIRBANKS", "names": ["WILLET FAIRBANKS", "WILLET"], "gender": "m", "first": 7, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DUST-CHOKED TRADING POST, HIGH PLAINS - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "A sagging porch.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A horse trough green with scum.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wind pushes tumbleweeds past hitching posts that have not held a horse in weeks.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A hand-painted sign reads: SALT - NAILS - SOULS.", "para": 0, "sent": 3, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "ELIJAH \"SPARROW\" CROWFOOT (30s, braided hair, buckskin vest) leans on a porch rail, whittling.", "para": 1, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "action", "text": "Inside the doorway sits POSTMISTRESS CLEMENTINE VANDERMEER (60s, gingham, shotgun across her lap) with a ledger.", "para": 1, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "action", "text": "A rider approaches: SHERIFF AUGUSTINE BELL (40s, moustache, sweat-stained hat), trailed by a young deputy, WILLET FAIRBANKS (18, gun belt too big for his hips).", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 8, "kind": "action", "text": "Bell dismounts and strides to the porch.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 9, "kind": "action", "text": "Willet slides off his horse, trips over a stirrup, rights himself, and follows, one hand on his holster.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "dialogue", "text": "Sparrow.", "name": "BELL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "Sheriff.", "name": "SPARROW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "You were seen near the Henderson place.", "name": "BELL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "Lot of people were near the Henderson place.", "name": "SPARROW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "Gus, that boy was at my counter all morning.", "name": "CLEMENTINE", "speaker": 4, "ext": [], "paren": ["from the doorway"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "Was he?", "name": "BELL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "Bought nails.", "name": "CLEMENTINE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "How many?", "name": "BELL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "Enough for a coffin.", "name": "CLEMENTINE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "action", "text": "A cold quiet.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "action", "text": "Sparrow continues to whittle.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "action", "text": "Willet licks his lips.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Sheriff, should I--", "name": "WILLET", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "No.", "name": "BELL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "Sparrow finishes the carving and holds it up: a tiny wooden bird.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "action", "text": "He sets it on the rail between them.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "I didn't kill him.", "name": "SPARROW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "No one said you did.", "name": "BELL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "Then why's the boy sweating?", "name": "SPARROW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "Everyone looks at Willet.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "He blanches.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "It's hot.", "name": "WILLET", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "^It's ninety degrees.", "name": "CLEMENTINE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "^It's ninety degrees.", "name": "BELL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "They speak together, and Bell shoots her a look.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "She shrugs, rocks the shotgun on her lap, and says nothing more.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "Sparrow slides the bird toward Willet.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "The boy stares at it, shaking, and as Bell turns to him, the wind drops.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "Even the tumbleweeds stop rolling.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}]}