{"scene_id": "s00055", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00055.fountain", "heading": "INT. UNDERGROUND PARKING STRUCTURE, LEVEL P4 - NIGHT", "cast": [{"id": 0, "name": "DETECTIVE IGNACIO PALAZZO-MENSAH", "names": ["DETECTIVE IGNACIO PALAZZO-MENSAH", "IGNACIO"], "gender": "?", "first": 6, "spoke": 5}, {"id": 1, "name": "COLLETTE ARMSTRONG-DUBOIS", "names": ["COLLETTE ARMSTRONG-DUBOIS", "COLLETTE"], "gender": "?", "first": 7, "spoke": 2}, {"id": 2, "name": "INFORMANT", "names": ["INFORMANT"], "gender": "?", "first": 8, "spoke": 0}, {"id": 3, "name": "BRIDGET QUILLFEATHER", "names": ["BRIDGET QUILLFEATHER", "BRIDGET"], "gender": "f", "first": 8, "spoke": 4}, {"id": 4, "name": "DETECTIVE MARCUS OYELARAN-STROUD", "names": ["DETECTIVE MARCUS OYELARAN-STROUD", "MARCUS"], "gender": "?", "first": 9, "spoke": 3}, {"id": 5, "name": "SOPHRONIA HALLIWELL", "names": ["SOPHRONIA HALLIWELL", "SOPHRONIA"], "gender": "?", "first": 9, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. UNDERGROUND PARKING STRUCTURE, LEVEL P4 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Concrete columns.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dripping pipes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Fluorescent tubes that buzz and flicker.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Oil stains like ink blots.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "At the far end, a stairwell door hangs ajar.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "DETECTIVE IGNACIO PALAZZO-MENSAH (40s, trench coat, a limp, a gun held low) slips between two parked sedans.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Behind him, FBI analyst COLLETTE ARMSTRONG-DUBOIS (30s, ballistic vest over a cardigan) clutches a laptop.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "In the shadows, a figure in a gray hoodie crouches: the INFORMANT, BRIDGET QUILLFEATHER (20s, nervous eyes, pale as paper).", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "A ways off, DETECTIVE MARCUS OYELARAN-STROUD (50s, radio at his collar) circles the perimeter, and in a car at the exit ramp, driver SOPHRONIA HALLIWELL (30s, headset, steady) watches the mirror.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Bridget, where's the package?", "name": "IGNACIO", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Level three. In the van.", "name": "BRIDGET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Level three isn't on the schematic.", "name": "COLLETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "It's not on anything.", "name": "BRIDGET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "All units, hold positions.", "name": "MARCUS", "speaker": 4, "ext": [], "paren": ["into radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "A steel door clangs somewhere.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Everyone freezes.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "A distant engine idles.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Headlights sweep across the pillars and swing away.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Easy.", "name": "IGNACIO", "speaker": 0, "ext": [], "paren": ["quietly, to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Collette types something silent.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Bridget wipes her sweaty palms on her knees.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Exit ramp clear. For now.", "name": "SOPHRONIA", "speaker": 5, "ext": [], "paren": ["into headset"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "They'll see the lights.", "name": "BRIDGET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "They already know we're here.", "name": "IGNACIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Then why--", "name": "BRIDGET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "A gunshot cracks across the garage.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "A windshield bursts.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Ignacio shoves Bridget flat.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Collette dives behind a column, laptop sliding across the concrete.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Marcus sprints toward the sound.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Sophronia guns the engine and the car leaps forward.", "para": 4, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Another shot.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Another.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "The echoes pile on each other until the whole structure rings like a struck bell.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Contact! North ramp!", "name": "MARCUS", "speaker": 4, "ext": [], "paren": ["shouting"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Get her out!", "name": "IGNACIO", "speaker": 0, "ext": [], "paren": ["to Collette"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "What about you?", "name": "COLLETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Go!", "name": "IGNACIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Collette grabs Bridget's hand and they run for the stairwell, ducking low between sedans.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Ignacio rises, fires twice, and ducks.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Marcus, Ignacio, I'm coming around.", "name": "SOPHRONIA", "speaker": 5, "ext": [], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Her car shrieks around a column and slams to a stop in front of Collette and Bridget.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "The back door flies open.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Get in!", "name": "SOPHRONIA", "speaker": 5, "ext": ["CONT'D"], "paren": ["through the window"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "They pile into the back seat.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Ignacio sprints, vaults the hood, and drops into the front.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "Marcus dives in last.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "The car lurches forward as bullets rake the trunk.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "Drive!", "name": "MARCUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "I am driving!", "name": "SOPHRONIA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "The car roars up the ramp and out into the rain.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}