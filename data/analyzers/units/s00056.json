{"scene_id": "s00056", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00056.fountain", "heading": "INT. FUNERAL PARLOR BACK OFFICE - NIGHT", "cast": [{"id": 0, "name": "LARRY", "names": ["LARRY"], "gender": "?", "first": 5, "spoke": 2}, {"id": 1, "name": "PIETRZAK", "names": ["PIETRZAK"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "VERONICA CHEN-ADEYEMI", "names": ["VERONICA CHEN-ADEYEMI", "VERONICA"], "gender": "f", "first": 6, "spoke": 1}, {"id": 3, "name": "MILO", "names": ["MILO"], "gender": "?", "first": 7, "spoke": 1}, {"id": 4, "name": "TOBIAS WREN", "names": ["TOBIAS WREN", "WREN"], "gender": "?", "first": 8, "spoke": 1}, {"id": 5, "name": "CALLER", "names": ["CALLER"], "gender": "?", "first": 24, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. FUNERAL PARLOR BACK OFFICE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Wood paneling.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Lilies in a vase.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A desk lamp turned low.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A phone sits on the blotter like a sleeping animal.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LAWRENCE \"LARRY\" PIETRZAK (50s, undertaker's black suit, tie loosened) counts bills at the desk.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "In the armchair sits his partner, VERONICA CHEN-ADEYEMI (40s, perfect posture, gloves on).", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "On the sofa, a boy, MILO (teen, school blazer), turns an unlit candle over in his hands.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "At the window stands a figure, silent, looking out at the parking lot: TOBIAS WREN (30s, long coat).", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "The phone rings.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Veronica lifts her eyes.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Larry stops counting.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Leave it.", "name": "LARRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "It's the fourth time.", "name": "VERONICA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Larry's thumb works the edge of the bills.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Milo sets the candle down.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Should I--", "name": "MILO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "No.", "name": "LARRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "The phone rings.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Rings.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Rings.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Wren turns from the window, watches the receiver, and picks it up without speaking.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "He listens.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "A thin voice crackles through.", "para": 4, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Is the arrangement still on for tomorrow?", "name": "CALLER", "speaker": 5, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Wren looks at Larry.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Larry nods once.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "It is.", "name": "WREN", "speaker": 4, "ext": [], "paren": ["into phone"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "He hangs up.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Veronica unfolds her gloved hands, and, for the first time, Larry meets Milo's eyes.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}