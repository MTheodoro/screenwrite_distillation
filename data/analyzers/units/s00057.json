{"scene_id": "s00057", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00057.fountain", "heading": "EXT. ICE-LOCKED RIVER BARGE, ARCTIC - DAWN", "cast": [{"id": 0, "name": "ASTRID BJORNSDOTTIR-NKEMELU", "names": ["ASTRID BJORNSDOTTIR-NKEMELU", "ASTRID"], "gender": "?", "first": 6, "spoke": 4}, {"id": 1, "name": "DMITRI KOWALCZYK-ROSS", "names": ["DMITRI KOWALCZYK-ROSS", "DMITRI"], "gender": "?", "first": 7, "spoke": 5}, {"id": 2, "name": "TOMAS", "names": ["TOMAS"], "gender": "?", "first": 8, "spoke": 3}, {"id": 3, "name": "ISABELLA VERRIDGE-LIM", "names": ["ISABELLA VERRIDGE-LIM", "ISABELLA"], "gender": "?", "first": 8, "spoke": 3}, {"id": 4, "name": "OKSANA PETRENKO-ABARA", "names": ["OKSANA PETRENKO-ABARA", "OKSANA"], "gender": "?", "first": 9, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ICE-LOCKED RIVER BARGE, ARCTIC - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A flat iron barge, locked in white.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Its hull creaks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wind blows ice-dust sideways.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A tarp stretched between two crates makes a miserable shelter.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Five figures huddle inside it.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "ASTRID BJORNSDOTTIR-NKEMELU (40s, fur hood, frost-rimmed eyebrows) pours the last of the tea into a tin cup.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Next to her, her brother-in-law DMITRI KOWALCZYK-ROSS (50s, giant gloves) feeds a dying camp stove.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "On the far side, a young couple, TOMAS and ISABELLA VERRIDGE-LIM (20s each, tangled together under one blanket), whisper.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "At the tarp's mouth, their guide, OKSANA PETRENKO-ABARA (30s, rifle slung, compass in hand), squints at the horizon.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "How long?", "name": "ASTRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "The ice should break by noon.", "name": "OKSANA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "It's been noon for three days.", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "You okay?", "name": "TOMAS", "speaker": 2, "ext": [], "paren": ["to Isabella"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "I'm fine.", "name": "ISABELLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "You're shivering.", "name": "TOMAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "So are you.", "name": "ISABELLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Dmitri, give her your gloves.", "name": "ASTRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "She has gloves.", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Not good ones.", "name": "ASTRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Dmitri strips off the enormous gloves and tosses them to Isabella, who catches them against her chest.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Thank you.", "name": "ISABELLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Don't mention it.", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Quiet. All of you.", "name": "OKSANA", "speaker": 4, "ext": [], "paren": ["from the tarp mouth"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "A deep crack booms from under the barge.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "The whole deck shudders.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Dmitri curses.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Astrid grabs the tin cup before it spills, but Tomas and Isabella, tangled in the blanket, roll toward the gap and Oksana lunges to haul them back from the edge.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Back! Away from the rail!", "name": "OKSANA", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "What is it?", "name": "TOMAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "The river's moving.", "name": "OKSANA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Moving? The river's frozen.", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Not anymore.", "name": "OKSANA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "The barge tilts, a slow, enormous lean.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "They scramble over crates.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Ice groans like a living thing.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Water, black and glassy, opens in a long line beside the hull.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Everyone to the stern!", "name": "ASTRID", "speaker": 0, "ext": [], "paren": ["shouting"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "They stumble across the tilting deck, Dmitri carrying the stove, Tomas pulling Isabella, Oksana covering the rear.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Astrid reaches the stern first and throws a rope to the ice beyond.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Then the barge rights itself with a thunderous slap, and the lean is gone.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Ice-dust swirls.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "The river, free now, carries them forward.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Noon.", "name": "DMITRI", "speaker": 1, "ext": [], "paren": ["laughing, breathless"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Told you.", "name": "OKSANA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}