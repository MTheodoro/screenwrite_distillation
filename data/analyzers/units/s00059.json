{"scene_id": "s00059", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00059.fountain", "heading": "INT. PET STORE, REPTILE SECTION - DAY", "cast": [{"id": 0, "name": "BARN", "names": ["BARN"], "gender": "?", "first": 5, "spoke": 4}, {"id": 1, "name": "OKAFOR-LINDGREN", "names": ["OKAFOR-LINDGREN"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "JUNIPER VASQUEZ-ABARA", "names": ["JUNIPER VASQUEZ-ABARA", "JUNIPER"], "gender": "?", "first": 6, "spoke": 4}, {"id": 3, "name": "EZEKIEL PRUITT-HALE", "names": ["EZEKIEL PRUITT-HALE", "EZEKIEL"], "gender": "?", "first": 7, "spoke": 3}, {"id": 4, "name": "DESDEMONA KILLINGSWORTH", "names": ["DESDEMONA KILLINGSWORTH", "DESDEMONA"], "gender": "?", "first": 8, "spoke": 1}, {"id": 5, "name": "TIBBY", "names": ["TIBBY"], "gender": "?", "first": 9, "spoke": 2}, {"id": 6, "name": "MOREAU-WELLS", "names": ["MOREAU-WELLS"], "gender": "?", "first": 9, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. PET STORE, REPTILE SECTION - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Heat lamps.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Terrariums.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A sign: PLEASE DO NOT KNOCK ON GLASS.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The air smells of mealworms.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "BARNABY \"BARN\" OKAFOR-LINDGREN (30s, apron, name tag crooked) restocks crickets.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "His coworker JUNIPER VASQUEZ-ABARA (20s, pink hair, bandaged thumb) leans on the counter.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "A customer, MR. EZEKIEL PRUITT-HALE (70s, tweed cap, binocular case), peers into a tank.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "At the back door, the manager, DESDEMONA KILLINGSWORTH (40s, clipboard, cheerful menace), rattles keys.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "And behind the register, a nervous newcomer, TIBERIUS \"TIBBY\" MOREAU-WELLS (teen, first shift, sweating through his shirt), tries to look busy.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "dialogue", "text": "Juniper, where's the iguana?", "name": "BARN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "In his tank.", "name": "JUNIPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "Which tank?", "name": "BARN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "The big one.", "name": "JUNIPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "That one's empty.", "name": "BARN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "Oh.", "name": "JUNIPER", "speaker": 2, "ext": [], "paren": ["slowly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "action", "text": "They look at each other.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "action", "text": "Both turn toward Mr. Pruitt-Hale, who is still peering into the empty tank.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "Fascinating. Where's the lizard?", "name": "EZEKIEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "He's resting!", "name": "TIBBY", "speaker": 5, "ext": [], "paren": ["very high"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "Tibby, don't lie to the customer.", "name": "DESDEMONA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "I'm not lying! I'm hopeful!", "name": "TIBBY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Young man, I've bought four geckos from this store. I know when a tank is vacant.", "name": "EZEKIEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "Sir, it's a rare species.", "name": "BARN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "Camouflaged?", "name": "EZEKIEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "Extremely.", "name": "JUNIPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "action", "text": "A thump from the ceiling.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "All five look up.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "A long green tail hangs from a ceiling tile, swaying gently.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "Tibby faints into the cricket display.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "Desdemona sighs and heads for a ladder.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}]}