{"scene_id": "s00061", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00061.fountain", "heading": "EXT. TRENCH LINE, RAIN-SOAKED FIELD - NIGHT", "cast": [{"id": 0, "name": "PENROSE", "names": ["PENROSE"], "gender": "?", "first": 4, "spoke": 3}, {"id": 1, "name": "SERGEANT BAPTISTE ONWUACHI", "names": ["SERGEANT BAPTISTE ONWUACHI", "ONWUACHI"], "gender": "m", "first": 5, "spoke": 4}, {"id": 2, "name": "PRIVATE ELIAS FJELDSTAD-MORENO", "names": ["PRIVATE ELIAS FJELDSTAD-MORENO", "FJELDSTAD-MORENO"], "gender": "m", "first": 6, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. TRENCH LINE, RAIN-SOAKED FIELD - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A sheet of rain.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Barbed wire sags in the flare light.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Mud sucks at every boot.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LIEUTENANT ARCHIBALD \"ARCHIE\" PENROSE (30s, helmet strap loose, flashlight taped) crouches with a map.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "SERGEANT BAPTISTE ONWUACHI (40s, thick forearms, helmet dented) checks his rifle.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "PRIVATE ELIAS FJELDSTAD-MORENO (19, trembling, bayonet fixed) hugs the trench wall.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Sergeant, status?", "name": "PENROSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Half the men are asleep.", "name": "ONWUACHI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "I'm not asleep.", "name": "FJELDSTAD-MORENO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Nobody said you were.", "name": "ONWUACHI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Elias, keep your head down.", "name": "PENROSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Yes sir.", "name": "FJELDSTAD-MORENO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Fix bayonets! On my word!", "name": "ONWUACHI", "speaker": 1, "ext": [], "paren": ["to the trench"], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "A whistle shrieks.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Penrose and Onwuachi look up as one.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Elias presses his forehead to the mud.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Dear God.", "name": "PENROSE", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Now!", "name": "ONWUACHI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "The whole trench erupts.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Men climb out of the earth.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Elias stays frozen until Onwuachi hauls him up by the collar and drags him into the dark.", "para": 3, "sent": 2, "present": [0, 1, 2]}]}