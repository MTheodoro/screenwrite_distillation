{"scene_id": "s00064", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00064.fountain", "heading": "INT. SAFE-DEPOSIT VAULT, PRIVATE BANK - NIGHT", "cast": [{"id": 0, "name": "GIDEON ASHWORTH-DEMBELE", "names": ["GIDEON ASHWORTH-DEMBELE", "GIDEON"], "gender": "?", "first": 4, "spoke": 3}, {"id": 1, "name": "LUCRETIA FONTAINE-OKAFOR", "names": ["LUCRETIA FONTAINE-OKAFOR", "LUCRETIA"], "gender": "?", "first": 5, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. SAFE-DEPOSIT VAULT, PRIVATE BANK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Rows of brass boxes under a vaulted ceiling.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single green banker's lamp.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The air is cold and smells of old metal.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "GIDEON ASHWORTH-DEMBELE (50s, impeccable suit, silver cufflinks) stands before an open drawer, fingers curled around a velvet pouch.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Facing him, in the narrow aisle, LUCRETIA FONTAINE-OKAFOR (40s, black gloves, revolver steady) blocks his exit.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Gideon turns.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Lucretia does not lower the gun.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You're early.", "name": "GIDEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "You're late.", "name": "LUCRETIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Gideon smiles and lifts the pouch.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Lucretia's eyes drop to it.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "^It's not what you think.", "name": "GIDEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "^It's exactly what I think.", "name": "LUCRETIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "They speak together, flat, certain.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "A drip falls somewhere in the dark.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Lucretia. Put it down.", "name": "GIDEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "You first.", "name": "LUCRETIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He opens his fingers.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "The pouch lands on the marble with a soft chink.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Lucretia exhales, almost relieved, and kicks it toward the wall.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "The gun doesn't waver.", "para": 6, "sent": 0, "present": [0, 1]}]}