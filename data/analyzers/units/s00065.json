{"scene_id": "s00065", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00065.fountain", "heading": "INT. GRAND HOTEL LOBBY - DAY", "cast": [{"id": 0, "name": "CORNY", "names": ["CORNY"], "gender": "?", "first": 5, "spoke": 7}, {"id": 1, "name": "BELLWEATHER", "names": ["BELLWEATHER"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "PRUDENCE", "names": ["PRUDENCE"], "gender": "m", "first": 6, "spoke": 6}, {"id": 3, "name": "LEOPOLDINA ARCHAMBAULT-DIOP", "names": ["LEOPOLDINA ARCHAMBAULT-DIOP", "LEOPOLDINA"], "gender": "?", "first": 7, "spoke": 3}, {"id": 4, "name": "CALLER", "names": ["CALLER"], "gender": "?", "first": 24, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRAND HOTEL LOBBY - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Marble pillars.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A revolving door that sighs with each turn.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A brass bell on the concierge desk.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A poodle in a rhinestone collar naps under a velvet bench.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CORNELIUS \"CORNY\" BELLWEATHER (50s, three-piece suit, monocle) sits in a chair and pretends to read a newspaper.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Across from him on a sofa, his wife PRUDENCE (40s, enormous hat, fan) watches him with mounting suspicion.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "At the desk, the concierge LEOPOLDINA ARCHAMBAULT-DIOP (30s, immaculate, bored) files her nails.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "She shifts.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "He shifts.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "The poodle yawns.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Corny, you're holding the paper upside down.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Am I?", "name": "CORNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "The pictures are standing on their heads.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Modern art.", "name": "CORNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "She snaps her fan.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "A telephone on the desk rings, and Leopoldina answers in a voice like warm butter.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Front desk. Yes, Mr. Bellweather is in the lobby. No, he is not expecting a call.", "name": "LEOPOLDINA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Corny rises so quickly the newspaper flies.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "He crosses the lobby in three long strides and tries to take the phone from her hand.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Sir, it's for the hotel.", "name": "LEOPOLDINA", "speaker": 3, "ext": ["CONT'D"], "paren": ["covering the receiver"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "It's for me.", "name": "CORNY", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Corny, who is it?", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": ["from the sofa"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Nobody! Wrong number!", "name": "CORNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Corny? It's Fifi. Are you coming up?", "name": "CALLER", "speaker": 4, "ext": ["V.O."], "paren": ["over phone, faint"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Leopoldina's eyebrow rises half an inch.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Prudence stands.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "The poodle wakes.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Corny.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "She's the dog groomer.", "name": "CORNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "At the Grand Hotel.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "They have a salon.", "name": "CORNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "They do not.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "We do not.", "name": "LEOPOLDINA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Corny, defeated, takes the receiver.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "He puts it to his ear and listens a long moment, then speaks.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "I'll be right up. Tell her to bring the poodle.", "name": "CORNY", "speaker": 0, "ext": [], "paren": ["into phone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Prudence follows his gaze to the dog under the bench.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "It wags its tail.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Leopoldina hangs up and, with perfect composure, lifts the brass bell and rings it once.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}]}