{"scene_id": "s00066", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00066.fountain", "heading": "INT. HOSPITAL ROOFTOP HELIPAD - DAWN", "cast": [{"id": 0, "name": "NATHANIEL OYELOWO-STRAND", "names": ["NATHANIEL OYELOWO-STRAND", "NATHANIEL"], "gender": "?", "first": 4, "spoke": 3}, {"id": 1, "name": "NURSE PHILOMENA BRANDT-ADEYEMI", "names": ["NURSE PHILOMENA BRANDT-ADEYEMI", "PHILOMENA"], "gender": "?", "first": 5, "spoke": 3}, {"id": 2, "name": "GASPAR LINDQVIST-MBEKI", "names": ["GASPAR LINDQVIST-MBEKI", "GASPAR"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "DISPATCH", "names": ["DISPATCH"], "gender": "?", "first": 13, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOSPITAL ROOFTOP HELIPAD - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Concrete, windsock, a single orange cone.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The city spreads below in blue haze.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A rusted door clatters open.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. NATHANIEL OYELOWO-STRAND (40s, scrubs, blood on one cuff) steps out, breathing.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Behind him comes NURSE PHILOMENA BRANDT-ADEYEMI (30s, braids, hospital badge swinging).", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Nearby, an orderly, GASPAR LINDQVIST-MBEKI (20s, lanky, mop bucket), smokes against the rail.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Third night in a row.", "name": "NATHANIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "You keep coming up here.", "name": "PHILOMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Nobody follows me.", "name": "NATHANIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I followed you.", "name": "PHILOMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "So did I. I was here first.", "name": "GASPAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "The radio on Philomena's belt crackles.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Trauma Two, inbound helicopter, ETA four minutes. Pediatric, severe burns.", "name": "DISPATCH", "speaker": 3, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Nathaniel straightens.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Philomena grabs the radio.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Copy. Pad is clear.", "name": "PHILOMENA", "speaker": 1, "ext": [], "paren": ["into radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "She and Nathaniel look at Gaspar, who drops his cigarette and stamps it out.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "The windsock snaps taut.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Gaspar, the cone.", "name": "NATHANIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "On it.", "name": "GASPAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "He drags the orange cone aside.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "In the distance, a speck grows into the rising hammer of rotors.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}]}