{"scene_id": "s00067", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00067.fountain", "heading": "INT. REVOLVING RESTAURANT ATOP A SKYSCRAPER - NIGHT", "cast": [{"id": 0, "name": "AUGUSTINE KORMANN-DELACROIX", "names": ["AUGUSTINE KORMANN-DELACROIX", "AUGUSTINE"], "gender": "?", "first": 5, "spoke": 7}, {"id": 1, "name": "SALOME BRANDT-OYELARAN", "names": ["SALOME BRANDT-OYELARAN", "SALOME"], "gender": "f", "first": 5, "spoke": 9}, {"id": 2, "name": "WENDELIN ASHFORD-PETROV", "names": ["WENDELIN ASHFORD-PETROV", "WENDELIN"], "gender": "?", "first": 5, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. REVOLVING RESTAURANT ATOP A SKYSCRAPER - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "The city turns slowly beyond a wall of glass.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "White tablecloths, low candles.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A string quartet plays something sorrowful.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Every table is full, except one.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "At that table, three people sit in a tight triangle: AUGUSTINE KORMANN-DELACROIX (50s, charcoal suit, hands always moving), SALOME BRANDT-OYELARAN (40s, emerald dress, cool eyes), and WENDELIN ASHFORD-PETROV (30s, black turtleneck, a briefcase handcuffed to his wrist).", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Salome, you look radiant.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "I look hungry.", "name": "SALOME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "The soup is good.", "name": "WENDELIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Wendelin, it's soup.", "name": "SALOME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "It's very good soup.", "name": "WENDELIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Shall we order?", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": ["with a laugh"], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "We shall not.", "name": "SALOME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She sets down her fork.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "He lays his napkin across his knee.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "The restaurant turns.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "A new skyline slides into view.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "You know why I asked you here.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "I have a theory.", "name": "SALOME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "She has several.", "name": "WENDELIN", "speaker": 2, "ext": [], "paren": ["clearing his throat"], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I have one.", "name": "SALOME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Then say it.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "You want what's in the case.", "name": "SALOME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Wendelin's hand tightens on the handle.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Augustine lets the quartet play four more bars.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "I want you to open it.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "I don't have the key.", "name": "SALOME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "You do.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "I don't.", "name": "SALOME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "She doesn't.", "name": "WENDELIN", "speaker": 2, "ext": [], "paren": ["quietly, to Augustine"], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Then who does?", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "A beat.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The restaurant turns again, and the three of them watch the city pass beneath them, glittering and indifferent.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Salome lifts her water glass.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Order the soup, Augustine.", "name": "SALOME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}