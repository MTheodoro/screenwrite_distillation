{"scene_id": "s00072_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00072.fountain", "heading": "INT. CABLE GONDOLA - CONTINUOUS", "cast": [{"id": 0, "name": "RAMONA QUISPE", "names": ["RAMONA QUISPE", "RAMONA"], "gender": "f", "first": 3, "spoke": 15}, {"id": 1, "name": "ED", "names": ["ED"], "gender": "m", "first": 4, "spoke": 12}, {"id": 2, "name": "BAYLISS", "names": ["BAYLISS"], "gender": "?", "first": 4, "spoke": 0}, {"id": 3, "name": "RESCUE COORDINATOR", "names": ["RESCUE COORDINATOR"], "gender": "?", "first": 10, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. CABLE GONDOLA - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Cramped.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fogged glass.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "RAMONA QUISPE (40s, mountain guide, cracked lip, orange windbreaker) wedges herself in a corner with a radio.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "EDMUND \"ED\" BAYLISS (60s, retired surveyor, tweed jacket, knee brace) grips the seat with both hands.", "para": 0, "sent": 3, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "Base, Base, this is Quispe in cabin six. Over.", "name": "RAMONA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "Static.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Ed stares at the floor.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Do not tell me we've lost the line.", "name": "ED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Quiet, please.", "name": "RAMONA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Cabin six, we read you. Say your count.", "name": "RESCUE COORDINATOR", "speaker": 3, "ext": ["V.O."], "paren": ["radio, crackling"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Two. One guide, one passenger. No injuries.", "name": "RAMONA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Copy. Cable crew is ninety minutes out. Snow on the access road.", "name": "RESCUE COORDINATOR", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Ed exhales, long and shaky.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Ninety minutes.", "name": "ED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "It's good news, Ed. It means they're coming.", "name": "RAMONA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "I know what it means. I've been wrong about distances my whole life.", "name": "ED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "The gondola lurches.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Both of them stiffen.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "It settles.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Ed pries open a thermos with trembling fingers.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Quispe, confirm you have warm layers.", "name": "RESCUE COORDINATOR", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Confirm. Emergency blanket, two.", "name": "RAMONA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "She tears open a foil packet and drapes one over Ed's shoulders.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "He tries to refuse.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "She tucks it tight.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "You'd make a decent nurse.", "name": "ED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "I'd make a terrible nurse. I make a good guide.", "name": "RAMONA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Wind.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "The glass rattles faintly.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Do you ever get used to it? The height?", "name": "ED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "No. You learn which fear is worth listening to.", "name": "RAMONA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "And this one?", "name": "ED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "This one is just cold.", "name": "RAMONA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Ed laughs, surprised.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Ramona half smiles.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "The radio crackles again.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Cabin six, new estimate, seventy-five minutes. Road crew cleared the slide.", "name": "RESCUE COORDINATOR", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Copy, seventy-five.", "name": "RAMONA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "That's a fifteen-minute improvement.", "name": "ED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "It's a fifteen-minute improvement.", "name": "RAMONA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "She lowers the radio.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "The dark outside deepens.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Ed pulls the blanket around himself, and Ramona settles her back against the cold glass.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Tell me about the mountain.", "name": "ED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Which one?", "name": "RAMONA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Any of them.", "name": "ED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "My grandfather said they listen. If you say their name wrong, they send weather.", "name": "RAMONA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "What did you call this one?", "name": "ED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Apu Kuntur.", "name": "RAMONA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Apu Kuntur.", "name": "ED", "speaker": 1, "ext": [], "paren": ["trying it"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "A gust shakes the cabin.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Then the wind drops, and the whole gondola goes still.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Well. Perhaps I said it right.", "name": "ED", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Perhaps.", "name": "RAMONA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Cabin six, I'm hearing you laughing. That's what I like to hear.", "name": "RESCUE COORDINATOR", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "Just keep coming.", "name": "RAMONA", "speaker": 0, "ext": [], "paren": ["to the radio"], "dual": false, "present": [0, 1, 2, 3]}]}