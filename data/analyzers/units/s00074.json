{"scene_id": "s00074", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00074.fountain", "heading": "INT. CONVERTED BOWLING ALLEY - OPEN OFFICE - DAY", "cast": [{"id": 0, "name": "GRETCHEN VOSS", "names": ["GRETCHEN VOSS", "GRETCHEN"], "gender": "?", "first": 4, "spoke": 7}, {"id": 1, "name": "BIG DAVE MUNOZ", "names": ["BIG DAVE MUNOZ", "DAVE"], "gender": "m", "first": 5, "spoke": 1}, {"id": 2, "name": "PRIYA NAIR", "names": ["PRIYA NAIR", "PRIYA"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "LEOPOLD ASHFORD", "names": ["LEOPOLD ASHFORD", "LEOPOLD"], "gender": "?", "first": 7, "spoke": 1}, {"id": 4, "name": "HANNELORE BRANDT", "names": ["HANNELORE BRANDT", "HANNELORE"], "gender": "f", "first": 8, "spoke": 2}, {"id": 5, "name": "TOBY OYELARAN", "names": ["TOBY OYELARAN", "TOBY"], "gender": "?", "first": 9, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. CONVERTED BOWLING ALLEY - OPEN OFFICE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Lanes carpeted over.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Desks sit where pins used to stand.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The ball return hums.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "GRETCHEN VOSS (50s, headset, power blazer) paces the gutter.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "BIG DAVE MUNOZ (40s, linebacker build, lanyard) hunches over a keyboard.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "PRIYA NAIR (late 20s, three monitors) types without blinking.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "LEOPOLD ASHFORD (60s, bowtie) polishes a trophy no one has won.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "HANNELORE BRANDT (30s, cardigan, furious calm) stares at a spreadsheet.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "TOBY OYELARAN (20s, intern, backward cap) holds a clipboard like a shield.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "She stops.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "Nobody looks up.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Quarterly synergy.", "name": "GRETCHEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "Dave stands.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "Sits.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Priya's typing slows, then quickens.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Leopold sets down the trophy.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "We are on track.", "name": "LEOPOLD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Are we.", "name": "GRETCHEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Hannelore turns her monitor ninety degrees.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "A red cell glows.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Toby takes a half step toward the exit.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Gretchen catches it.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Toby.", "name": "GRETCHEN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Yes, Ms. Voss.", "name": "TOBY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Coffee.", "name": "GRETCHEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "He bolts.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Dave watches him go, envious.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "I could use one too.", "name": "DAVE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "You could use a lot of things.", "name": "GRETCHEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Priya's keyboard stops.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Silence.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "The ball return clunks.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "The numbers are final.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "They are not final.", "name": "HANNELORE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "They are final.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Leopold lifts the trophy again and begins to polish with great concentration.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Gretchen crosses to Hannelore, leans over, and reads the red cell.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "She exhales through her nose.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Fix it.", "name": "GRETCHEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "It's not broken.", "name": "HANNELORE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Then make it less true.", "name": "GRETCHEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Hannelore picks up a pen.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Clicks it.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Clicks it again.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Dave rolls his chair six inches away from her.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Toby returns with six coffees balanced in a cardboard tray, and nobody takes one.", "para": 8, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}]}