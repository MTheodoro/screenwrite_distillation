{"scene_id": "s00075", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00075.fountain", "heading": "INT. CHEESE-AGING CAVE - NIGHT", "cast": [{"id": 0, "name": "MARISOL FUENTES", "names": ["MARISOL FUENTES", "MARISOL"], "gender": "?", "first": 3, "spoke": 3}, {"id": 1, "name": "CASPIAN DUBOIS", "names": ["CASPIAN DUBOIS", "CASPIAN"], "gender": "?", "first": 3, "spoke": 3}, {"id": 2, "name": "IGGY BRANNIGAN", "names": ["IGGY BRANNIGAN", "IGGY"], "gender": "?", "first": 3, "spoke": 3}, {"id": 3, "name": "SUNITA RAO", "names": ["SUNITA RAO", "SUNITA"], "gender": "f", "first": 4, "spoke": 4}, {"id": 4, "name": "MADAME ELOISE THIBAULT", "names": ["MADAME ELOISE THIBAULT", "MADAME THIBAULT"], "gender": "?", "first": 22, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. CHEESE-AGING CAVE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Limestone walls, wooden racks of wheels, a fog of ammonia and mold.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single bulb swings on a cord.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "MARISOL FUENTES (30s, climbing harness, headlamp) lowers herself off a ladder while CASPIAN DUBOIS (40s, careful hands, white coat stolen from a cheesemonger) checks a humidity gauge and IGGY BRANNIGAN (20s, nervous, duffel bag) props open the freight door with a wheel of Gruyere.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 4, "kind": "action", "text": "SUNITA RAO (50s, retired locksmith, reading glasses on a chain) kneels at a steel cabinet at the back, picks in hand.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 5, "kind": "dialogue", "text": "Eleven minutes. That's the guard's loop.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "dialogue", "text": "Nine. I counted.", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "It smells like feet in here.", "name": "IGGY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "It smells like money. Hush.", "name": "SUNITA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "The cabinet clicks.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Sunita pulls the door.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Inside, velvet-lined shelves cradle a row of small glass jars.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Marisol reaches in.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Starter cultures.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Four hundred years old. Worth more than gold.", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "It's cheese mold.", "name": "IGGY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "It's the cheese mold.", "name": "SUNITA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Iggy lifts a jar.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Caspian takes the next one.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Marisol begins loading the duffel.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Everything is calm, almost gentle, like four people in a pantry.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "A flashlight beam sweeps across the entrance.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "MADAME ELOISE THIBAULT (70s, nightgown, wellington boots, a shotgun held like an umbrella) steps through the freight door.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "She does not look surprised.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Put them back.", "name": "MADAME THIBAULT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "We were just--", "name": "IGGY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Madame, we can explain.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Don't explain.", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "She's holding a shotgun, Caspian, explain something.", "name": "SUNITA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Put them back. Every one. Then you may leave.", "name": "MADAME THIBAULT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "The four of them glance at each other.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Marisol sets the duffel down.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Caspian nudges a jar back with one finger.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Iggy sobs quietly.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Sunita sighs and replaces the cabinet door.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "The key is in the left pocket of my robe. It always was.", "name": "MADAME THIBAULT", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Sunita peers at her.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "You left it unlocked.", "name": "SUNITA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "I left it for the mice. You, I did not expect.", "name": "MADAME THIBAULT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}