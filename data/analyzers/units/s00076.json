{"scene_id": "s00076", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00076.fountain", "heading": "INT. CONVERTED LIGHTHOUSE - COWORKING SPACE - DAY", "cast": [{"id": 0, "name": "BARNABY STOKES", "names": ["BARNABY STOKES", "BARNABY"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "ORLA FITZGIBBON", "names": ["ORLA FITZGIBBON", "ORLA"], "gender": "?", "first": 5, "spoke": 3}, {"id": 2, "name": "JUNG-HO PARK", "names": ["JUNG-HO PARK", "JUNG-HO"], "gender": "?", "first": 6, "spoke": 4}, {"id": 3, "name": "ADAEZE NWOSU", "names": ["ADAEZE NWOSU", "ADAEZE"], "gender": "?", "first": 7, "spoke": 3}, {"id": 4, "name": "CEDRIC LAMONT", "names": ["CEDRIC LAMONT", "CEDRIC"], "gender": "?", "first": 8, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. CONVERTED LIGHTHOUSE - COWORKING SPACE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A spiral staircase of standing desks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fresnel lens turned into a conference light.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Everyone wears matching grey fleece.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "BARNABY STOKES (40s, community manager, smiling too hard) claps once at the top of the stairs.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "ORLA FITZGIBBON (30s, product lead, cold brew) leans on the rail.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "JUNG-HO PARK (20s, engineer, noise-cancelling headphones) types.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "ADAEZE NWOSU (30s, designer, sketchbook) draws the lens.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "CEDRIC LAMONT (50s, investor, borrowed lanyard) examines the view like a purchase.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Hi, team! Quick announcement: we are pivoting.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": ["to everyone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Nobody moves.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Jung-Ho slides one headphone off an ear.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "To what?", "name": "JUNG-HO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "To the next thing.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "We pivoted Tuesday.", "name": "ORLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "We pivoted into a wall.", "name": "ADAEZE", "speaker": 3, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Walk me through the vision.", "name": "CEDRIC", "speaker": 4, "ext": [], "paren": ["to Barnaby"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "It's a platform for platforms.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Orla and Jung-Ho speak at the same moment.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "That's not a product.", "name": "ORLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "That's a typo.", "name": "JUNG-HO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "I need you aligned.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": ["to Orla"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "I'm aligned. I'm so aligned I'm sideways.", "name": "ORLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Cedric descends two steps and peers at Adaeze's sketchbook.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Is that the logo?", "name": "CEDRIC", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "It's a lighthouse.", "name": "ADAEZE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "We should keep that.", "name": "CEDRIC", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "She closes the book very slowly.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "It was always the lighthouse.", "name": "ADAEZE", "speaker": 3, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "So! Who's excited?", "name": "BARNABY", "speaker": 0, "ext": [], "paren": ["to everyone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "A long pause.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "The lens rotates.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "A single pigeon lands on the rail.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Jung-Ho raises one hand.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Can I be excused?", "name": "JUNG-HO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "It's a flat org.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Then I flatly would like to leave.", "name": "JUNG-HO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}