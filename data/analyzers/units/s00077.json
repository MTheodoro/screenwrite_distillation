{"scene_id": "s00077", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00077.fountain", "heading": "INT. SILVER STAR ROLLER RINK - AFTER CLOSING", "cast": [{"id": 0, "name": "NELL ABERNATHY", "names": ["NELL ABERNATHY", "NELL"], "gender": "f", "first": 5, "spoke": 5}, {"id": 1, "name": "SOLEDAD IBARRA", "names": ["SOLEDAD IBARRA", "SOLEDAD"], "gender": "?", "first": 6, "spoke": 5}, {"id": 2, "name": "HASHIMOTO", "names": ["HASHIMOTO", "MR. HASHIMOTO"], "gender": "?", "first": 7, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. SILVER STAR ROLLER RINK - AFTER CLOSING", "present": []}, {"u": 1, "kind": "action", "text": "The rink is a long amber oval of varnished maple, scuffed grey where a thousand wheels have turned.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Disco light dribbles over the empty benches.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The carpeted walls smell of popcorn and old rubber.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single overhead fan ticks.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "NELL ABERNATHY (16, long-limbed, a cast on one wrist) sits on the bench lacing a skate with her good hand.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "SOLEDAD IBARRA (16, braids tied up, a jersey two sizes big) circles the floor in slow, practiced loops, trailing one hand along the rail.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "At the snack counter, MR. HASHIMOTO (70s, cardigan, reading glasses on his forehead) counts the till, never looking up.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "She crosses the rink and stops in front of the bench.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "She looks down at her.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "She doesn't smile.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "You said you'd tell me.", "name": "SOLEDAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "I know.", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "That was Tuesday.", "name": "SOLEDAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "It's complicated.", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "She pushes off again, harder this time, a loop, then another.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Nell watches her go.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "The fan ticks.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "At the counter, Mr. Hashimoto slides a stack of bills into a bag and does not look up.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Eleven dollars short.", "name": "MR. HASHIMOTO", "speaker": 2, "ext": [], "paren": ["to the till"], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "It's Nell's thing, it's always Nell's thing.", "name": "SOLEDAD", "speaker": 1, "ext": [], "paren": ["skating, not stopping"], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "My thing?", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "You and your cast and your secret.", "name": "SOLEDAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "She skates past the bench, close enough that the wind of it lifts the hair on Nell's neck.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Nell stands.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Her laces hang loose.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "You don't know what happened.", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Then tell me.", "name": "SOLEDAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "I'm leaving.", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "The word hangs in the air.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Soledad stops.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The skates scrape, and the sound seems very loud.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Across the rink, the till slams shut.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Girls. Lights in five.", "name": "MR. HASHIMOTO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Soledad pulls off a skate and throws it.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "It skids across the maple and clatters against the wall.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Nell flinches, then crosses the floor in her socks, stoops, and picks the skate up.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "She holds it out.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Soledad does not take it.", "para": 6, "sent": 4, "present": [0, 1, 2]}]}