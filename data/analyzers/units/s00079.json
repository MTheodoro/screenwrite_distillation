{"scene_id": "s00079", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00079.fountain", "heading": "INT. DIALYSIS UNIT - NIGHT", "cast": [{"id": 0, "name": "HELENE MARCHETTI", "names": ["HELENE MARCHETTI", "HELENE"], "gender": "f", "first": 5, "spoke": 6}, {"id": 1, "name": "ROSALIND AKINS", "names": ["ROSALIND AKINS", "ROSALIND"], "gender": "f", "first": 6, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. DIALYSIS UNIT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A long, low room of reclining chairs and blinking machines.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Most of the beds are empty.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A rain-streaked window frames the parking lot.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The machines hum a single note, patient as insects.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. HELENE MARCHETTI (50s, grey at the temples, scrubs worn soft with washing) pulls a stool beside the last occupied chair.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "ROSALIND AKINS (70s, shawl, a library paperback open on her lap) does not look up from her page.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Blood moves slow and dark through the tubing between her arm and the machine.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She turns a page.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "She is not reading it.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "How's the pressure?", "name": "HELENE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "You tell me.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Helene checks the monitor.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Taps the screen.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Writes nothing.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Good enough.", "name": "HELENE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Mm.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "The machine ticks.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Helene folds her hands in her lap, unfolds them.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She looks at the paperback.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Is it any good?", "name": "HELENE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Third time through.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "That's a yes, then.", "name": "HELENE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Rosalind closes the book on her finger.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She looks, at last, at the doctor.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "You've got your father's habit.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Which one?", "name": "HELENE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Asking the thing next to the thing.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Helene does not answer.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "A nurse's cart rattles somewhere beyond the glass.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "In the pause, both of them reach for the call button at the same moment, hands touching on the plastic.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "They pull back.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "I'll get it. ROSALIND ^I'll get it.", "name": "HELENE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Neither moves.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "The machine counts down another minute.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Rosalind opens the book again, and Helene, after a moment, takes it gently from her hands, finds the place, and begins to read aloud, badly, in a low voice, to no one in particular.", "para": 7, "sent": 2, "present": [0, 1]}]}