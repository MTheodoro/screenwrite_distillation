{"scene_id": "s00080_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00080.fountain", "heading": "INT. TELEGRAPH OFFICE - CONTINUOUS", "cast": [{"id": 0, "name": "MAUDE PELLETIER", "names": ["MAUDE PELLETIER", "MAUDE"], "gender": "f", "first": 3, "spoke": 9}, {"id": 1, "name": "ISAIAH", "names": ["ISAIAH"], "gender": "f", "first": 6, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. TELEGRAPH OFFICE - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Dim.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A key chattering on a desk.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "MAUDE PELLETIER (50s, sleeves rolled, ink on her fingers) taps without looking up.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "The door opens.", "para": 2, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Light cuts across the floor.", "para": 2, "sent": 1, "present": [0]}, {"u": 6, "kind": "dialogue", "text": "Afternoon.", "name": "ISAIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Afternoon.", "name": "MAUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She keeps tapping.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Got a wire to send.", "name": "ISAIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Paper's on the left.", "name": "MAUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He takes a sheet.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Writes.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Folds it.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Sets it down.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She reads without picking it up.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Two words.", "name": "MAUDE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "It's all I need.", "name": "ISAIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Ninety cents.", "name": "MAUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He counts coins onto the desk.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She doesn't count them.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Coffee?", "name": "MAUDE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "If it's made.", "name": "ISAIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She pours from a pot on a cold stove.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Sets a tin cup near his hand.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Her other hand stays under the desk.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Your husband about?", "name": "ISAIAH", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Out at the well.", "name": "MAUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Long walk.", "name": "ISAIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "He likes it.", "name": "MAUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "He lifts the cup.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Doesn't drink.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Sets it down.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Funny. Well's dry since August.", "name": "ISAIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "The key stops chattering.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Maude's shoulders drop an inch.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Then I suppose he won't be back.", "name": "MAUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "A pause.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "The wire hums.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Isaiah turns the paper toward her.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Two words in pencil: SHE KNOWS.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "I'd say that's still true.", "name": "ISAIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Maude draws a revolver from beneath the desk.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Lays it flat on the coins.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Ninety cents. Sheriff.", "name": "MAUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}