{"scene_id": "s00081_0", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00081.fountain", "heading": "INT. PIEROGI FACTORY - NIGHT SHIFT", "cast": [{"id": 0, "name": "RAFAL KOWALCZYK", "names": ["RAFAL KOWALCZYK", "RAFAL"], "gender": "?", "first": 4, "spoke": 7}, {"id": 1, "name": "TAMSIN OKORO", "names": ["TAMSIN OKORO", "TAMSIN"], "gender": "m", "first": 5, "spoke": 7}, {"id": 2, "name": "LINDGREN", "names": ["LINDGREN"], "gender": "?", "first": 29, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. PIEROGI FACTORY - NIGHT SHIFT", "present": []}, {"u": 1, "kind": "action", "text": "Steam.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Conveyor belts of dough.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Hairnets and hum.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "RAFAL KOWALCZYK (40s, detective, rumpled suit under a hairnet) squints at a freezer door.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "TAMSIN OKORO (30s, factory floor manager, clipboard, no patience) walks beside him.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Four minutes.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "You said that at the gate.", "name": "RAFAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Four minutes at the gate. Four minutes now.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "They pass a bin of spinach filling.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Rafal sniffs it.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Winces.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Who found the body?", "name": "RAFAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Night packer. Quit on the spot.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Name?", "name": "RAFAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Gus. Everybody calls him the Ferret.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Rafal nods.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Writes.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "A belt jams.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Alarm bleats.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Tamsin pivots and kills it with one slap.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Back to your stations. Nothing to see.", "name": "TAMSIN", "speaker": 1, "ext": ["CONT'D"], "paren": ["to the floor"], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Workers drift.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Rafal watches them go.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Nothing.", "name": "RAFAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I run a clean line.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Somebody stuffed a man into your freezer.", "name": "RAFAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Not on my line.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "At the end of the corridor, a hairnet bobs.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "GUS \"THE FERRET\" LINDGREN (50s, wiry, sleeves pulled over fists) hurries toward the exit.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Hey.", "name": "RAFAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Gus quickens.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Mr. Lindgren.", "name": "RAFAL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Gus sprints.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Rafal vaults a bin of dough.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Tamsin swears and follows.", "para": 8, "sent": 2, "present": [0, 1, 2]}]}