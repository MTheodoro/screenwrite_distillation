{"scene_id": "s00081_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00081.fountain", "heading": "INT. LOADING DOCK - CONTINUOUS", "cast": [{"id": 0, "name": "BIANCA DELACROIX-OYELARAN", "names": ["BIANCA DELACROIX-OYELARAN", "BIANCA"], "gender": "f", "first": 1, "spoke": 4}, {"id": 1, "name": "GUS", "names": ["GUS"], "gender": "m", "first": 1, "spoke": 4}, {"id": 2, "name": "RAFAL", "names": ["RAFAL"], "gender": "f", "first": 5, "spoke": 7}, {"id": 3, "name": "TAMSIN", "names": ["TAMSIN"], "gender": "f", "first": 6, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. LOADING DOCK - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Gus slams through the door and runs headlong into BIANCA DELACROIX-OYELARAN (30s, health inspector, white coat, clipboard of her own).", "para": 0, "sent": 0, "present": [0, 1]}, {"u": 2, "kind": "action", "text": "Both go down.", "para": 0, "sent": 1, "present": [0, 1]}, {"u": 3, "kind": "dialogue", "text": "Watch it!", "name": "BIANCA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 4, "kind": "dialogue", "text": "Sorry, sorry, sorry.", "name": "GUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Rafal arrives, breathing hard.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "Tamsin right behind.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Stay on the floor, both of you.", "name": "RAFAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "You are early.", "name": "TAMSIN", "speaker": 3, "ext": [], "paren": ["to Bianca"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "You are in violation.", "name": "BIANCA", "speaker": 0, "ext": [], "paren": ["to Tamsin"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Where were you going?", "name": "RAFAL", "speaker": 2, "ext": [], "paren": ["to Gus"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Home. I didn't see nothing.", "name": "GUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "You saw the body.", "name": "RAFAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "I saw a coat.", "name": "GUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "What body?", "name": "BIANCA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "There is no body.", "name": "TAMSIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "There is a body.", "name": "RAFAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "^There is no body, and you have no warrant.", "name": "TAMSIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "They talk over each other.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Gus scrambles up.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Bianca writes.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Rafal grabs Gus by the sleeve.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Whose coat?", "name": "RAFAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Hers.", "name": "GUS", "speaker": 1, "ext": [], "paren": ["wet-eyed"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "He points.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "At Tamsin.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "The loading dock goes quiet.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "A forklift beeps somewhere.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Tamsin looks at her own coat.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Zipped to the chin.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Dry-cleaned.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Perfect.", "para": 4, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "That is a lie.", "name": "TAMSIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Is it?", "name": "BIANCA", "speaker": 0, "ext": [], "paren": ["pen hovering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Tamsin steps backward.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Rafal steps with her.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Open the coat.", "name": "RAFAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "I will not.", "name": "TAMSIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Open it.", "name": "RAFAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "She doesn't.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Gus whimpers.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Bianca flips a page.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Rafal reaches for the zipper.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Tamsin's hand snaps out and clamps his wrist.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Her knuckles whiten.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "For a heartbeat they stand locked like dancers.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Then she lets go.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Slides the zipper down.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Underneath, the lining is torn, dark, and wet.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "He wasn't supposed to be on shift.", "name": "TAMSIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}