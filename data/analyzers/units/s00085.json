{"scene_id": "s00085", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00085.fountain", "heading": "INT. CAROUSEL WORKSHOP - NIGHT", "cast": [{"id": 0, "name": "KALINDA RUSSO", "names": ["KALINDA RUSSO", "KALINDA"], "gender": "?", "first": 5, "spoke": 5}, {"id": 1, "name": "OSCAR TREMBLAY", "names": ["OSCAR TREMBLAY", "OSCAR"], "gender": "f", "first": 6, "spoke": 5}, {"id": 2, "name": "MOSES BELLAMY", "names": ["MOSES BELLAMY", "MOSES"], "gender": "?", "first": 7, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. CAROUSEL WORKSHOP - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Painted horses hang from chains.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Gilded poles.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A calliope under a tarp.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Dust in lamplight.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "KALINDA RUSSO (30s, black jumpsuit, tool roll) crouches at a floor panel.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "OSCAR TREMBLAY (50s, ex-clockmaker, magnifier on one eye) holds a flashlight steady.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "MOSES BELLAMY (20s, lookout, earbud) hovers by the door.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Pry bar.", "name": "KALINDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Oscar hands it over.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "She slides the bar under the panel.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Wood groans.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "A compartment opens.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Inside, a velvet satchel.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "There she is.", "name": "OSCAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Guys. Headlights.", "name": "MOSES", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Both freeze.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "A white beam sweeps the window, slides across the horses, and passes on.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Keep breathing.", "name": "KALINDA", "speaker": 0, "ext": [], "paren": ["exhaling"], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I am breathing!", "name": "MOSES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Quietly.", "name": "OSCAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Kalinda lifts the satchel.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Weighs it in her palm.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Frowns.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Light.", "name": "KALINDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "What?", "name": "OSCAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "It's too light.", "name": "KALINDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "She opens it.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Inside lies a single brass key and a note.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Oscar reads over her shoulder.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "\"Try the horse.\"", "name": "OSCAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "^\"Try the third horse.\"", "name": "KALINDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "They speak the same line at the same instant.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Moses stares from one to the other.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "What third horse?", "name": "MOSES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "All three turn.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Above them, a carousel horse with a chipped blue mane.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Kalinda climbs onto the platform.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Oscar follows.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Moses bolts after.", "para": 7, "sent": 4, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "They gather around the animal, and she turns the key in a hidden lock at the saddle.", "para": 7, "sent": 5, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "The belly pops open.", "para": 7, "sent": 6, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Gold coins pour into her arms.", "para": 7, "sent": 7, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "A siren starts up outside.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Oh no.", "name": "MOSES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Oh yes.", "name": "OSCAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "They scatter.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Moses dives under the calliope tarp.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Oscar slides behind a stack of poles.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Kalinda leaps from the platform, hugging the coins, and vanishes between two rows of horses as the doors burst open.", "para": 9, "sent": 3, "present": [0, 1, 2]}]}