{"scene_id": "s00086", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00086.fountain", "heading": "INT. FERRY GALLEY - NIGHT", "cast": [{"id": 0, "name": "ESTELLE MARCHAND", "names": ["ESTELLE MARCHAND", "ESTELLE"], "gender": "f", "first": 4, "spoke": 9}, {"id": 1, "name": "ARTHUR PENHALLOW", "names": ["ARTHUR PENHALLOW", "ARTHUR"], "gender": "?", "first": 5, "spoke": 9}, {"id": 2, "name": "TILDA VANCE", "names": ["TILDA VANCE", "TILDA"], "gender": "?", "first": 18, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. FERRY GALLEY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped galley below decks, steel counters and swinging pots.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The boat creaks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single porthole shows black water.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ESTELLE MARCHAND (50s, elegant, wearing her good coat in a kitchen) sits at the narrow table, stirring a cup of cold tea.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "ARTHUR PENHALLOW (60s, ship's cook, apron, forearms like rope) stands at the stove with his back to her, ladling soup.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "You might have told me.", "name": "ESTELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "I would have.", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "When?", "name": "ESTELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "When it was true.", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She sets the spoon down.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He stirs the pot.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "The ferry rocks.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "It has been true for a year.", "name": "ESTELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "It has been possible for a year.", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Arthur.", "name": "ESTELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Estelle.", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "The galley door swings open.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "TILDA VANCE (20s, deckhand, oilskin, red hands) comes in with a bucket and stops short.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Sorry. I can come back.", "name": "TILDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Stay. You'll want soup.", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Do stay, dear. We were only discussing the weather.", "name": "ESTELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "It's bad out.", "name": "TILDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "It is.", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "It's worse in here.", "name": "ESTELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Tilda looks from one to the other.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "She sets down the bucket.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Should I--", "name": "TILDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Take a bowl.", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Take two.", "name": "ESTELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Okay.", "name": "TILDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "You could have written.", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": ["to Estelle"], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "You could have answered.", "name": "ESTELLE", "speaker": 0, "ext": [], "paren": ["to Arthur"], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "This is really good soup.", "name": "TILDA", "speaker": 2, "ext": [], "paren": ["halfway through a mouthful"], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Arthur and Estelle turn together and look at her.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Tilda sets down the spoon.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "I'll just--", "name": "TILDA", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Eat.", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Eat, child.", "name": "ESTELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "She does.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "The ferry groans in the swell, and somewhere above them a horn sounds, long and low, for a harbor they cannot see.", "para": 6, "sent": 1, "present": [0, 1, 2]}]}