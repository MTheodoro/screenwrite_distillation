{"scene_id": "s00087", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00087.fountain", "heading": "INT. HYPERBARIC CHAMBER - NIGHT", "cast": [{"id": 0, "name": "NAOMI ESCOBEDO", "names": ["NAOMI ESCOBEDO", "NAOMI"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "PAUL ZIELINSKI", "names": ["PAUL ZIELINSKI", "PAUL"], "gender": "?", "first": 4, "spoke": 4}, {"id": 2, "name": "TECH ARDEN FLETCHER", "names": ["TECH ARDEN FLETCHER"], "gender": "?", "first": 4, "spoke": 0}, {"id": 3, "name": "CHARGE NURSE BIRGITTA", "names": ["CHARGE NURSE BIRGITTA", "BIRGITTA"], "gender": "?", "first": 5, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. HYPERBARIC CHAMBER - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Steel hull.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Porthole glass.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Pipes that shudder as pressure climbs.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. NAOMI ESCOBEDO (40s, scrubs, calm eyes) adjusts a valve while PAUL ZIELINSKI (60s, diver, wrapped in a thin blanket) stares at the gauge and TECH ARDEN FLETCHER (20s, headset, ponytail) logs numbers on a clipboard beyond the porthole, tapping the glass whenever the needle moves.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "Chamber, status?", "name": "CHARGE NURSE BIRGITTA", "speaker": 3, "ext": ["V.O."], "paren": ["intercom"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "dialogue", "text": "Two atmospheres. Holding.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Twice the weight on my chest. Same as the day I surfaced too fast.", "name": "PAUL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "You came up in eleven minutes. Nobody does that and walks.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "I walked.", "name": "PAUL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "You crawled. I read the report.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I don't remember crawling.", "name": "PAUL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "You will tomorrow.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Will I.", "name": "PAUL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "That's what we do here.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Doctor, ten minutes remaining.", "name": "BIRGITTA", "speaker": 3, "ext": ["V.O."], "paren": ["intercom"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Copy.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}