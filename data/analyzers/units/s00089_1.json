{"scene_id": "s00089_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00089.fountain", "heading": "INT. CAR WASH OFFICE - CONTINUOUS", "cast": [{"id": 0, "name": "DESHAWN MCALLISTER", "names": ["DESHAWN MCALLISTER", "DESHAWN"], "gender": "m", "first": 2, "spoke": 13}, {"id": 1, "name": "LUCIA FERREIRA-KANG", "names": ["LUCIA FERREIRA-KANG", "LUCIA"], "gender": "f", "first": 3, "spoke": 13}, {"id": 2, "name": "OBUYA", "names": ["OBUYA", "MR. OBUYA"], "gender": "m", "first": 32, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. CAR WASH OFFICE - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "A closet with a space heater, a cracked radio, a wall of keys.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "DESHAWN MCALLISTER (18, graduation gown unzipped over a polo, name tag reading \"DESHAWN\") counts out a till.", "para": 0, "sent": 1, "present": [0]}, {"u": 3, "kind": "action", "text": "LUCIA FERREIRA-KANG (18, same gown, mascara smudged) perches on a stool, shoes in her lap.", "para": 0, "sent": 2, "present": [0, 1]}, {"u": 4, "kind": "dialogue", "text": "You work here every Friday?", "name": "LUCIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "Every night.", "name": "DESHAWN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Even tonight?", "name": "LUCIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Especially.", "name": "DESHAWN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Lucia turns the radio dial.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Static, then a slow song.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She leaves it.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "They called your name.", "name": "LUCIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I know. I was there.", "name": "DESHAWN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "I mean it was loud. Your section.", "name": "LUCIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "My mom brought the airhorn.", "name": "DESHAWN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Of course she did.", "name": "LUCIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He nearly smiles.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Folds the till into a canvas bag.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "My dad didn't come.", "name": "LUCIA", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "I'm sorry.", "name": "DESHAWN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "It's fine.", "name": "LUCIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "It's not.", "name": "DESHAWN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "No. It's not.", "name": "LUCIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She looks at the shoes in her lap.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "He busies himself with the keys.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "You hungry?", "name": "DESHAWN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "I could eat.", "name": "LUCIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "There's a place by the freeway. Pancakes.", "name": "DESHAWN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "It's eleven p.m.", "name": "LUCIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "That's when they're best.", "name": "DESHAWN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "A knock.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "They both turn.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "MR. OBUYA (60s, owner, windbreaker, flashlight) leans in the doorway.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Deshawn. Why is the tunnel still running?", "name": "MR. OBUYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "I thought you wanted it warm.", "name": "DESHAWN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "I wanted it empty. Shut it down.", "name": "MR. OBUYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Yes, sir.", "name": "DESHAWN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Mr. Obuya looks at Lucia.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "At the gown.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "At the shoes.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Congratulations.", "name": "MR. OBUYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Thank you.", "name": "LUCIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Both of you.", "name": "MR. OBUYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "He goes.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Deshawn exhales.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Lucia unfolds from the stool.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Would you get fired?", "name": "LUCIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Probably not.", "name": "DESHAWN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "But you'd tell me if you would.", "name": "LUCIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "No.", "name": "DESHAWN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "She laughs, shaky.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "He holds the door.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "They step into the neon and the tunnel hums, spinning for nobody.", "para": 8, "sent": 2, "present": [0, 1, 2]}]}