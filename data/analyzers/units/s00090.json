{"scene_id": "s00090", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00090.fountain", "heading": "INT. COUNTY HOSPITAL - POLIO WARD - NIGHT", "cast": [{"id": 0, "name": "ALISTAIR VANCE-HOLLOWAY", "names": ["ALISTAIR VANCE-HOLLOWAY", "DR. VANCE-HOLLOWAY"], "gender": "?", "first": 5, "spoke": 8}, {"id": 1, "name": "NURSE BERNADETTE OKONJO", "names": ["NURSE BERNADETTE OKONJO", "NURSE OKONJO"], "gender": "?", "first": 6, "spoke": 4}, {"id": 2, "name": "THEODORA LINDQUIST", "names": ["THEODORA LINDQUIST", "MRS. LINDQUIST"], "gender": "m", "first": 7, "spoke": 5}, {"id": 3, "name": "CASPER WU", "names": ["CASPER WU", "CASPER"], "gender": "?", "first": 8, "spoke": 4}, {"id": 4, "name": "CHAPLAIN AUGUSTUS DELACROIX-BENNETT", "names": ["CHAPLAIN AUGUSTUS DELACROIX-BENNETT", "CHAPLAIN DELACROIX-BENNETT"], "gender": "m", "first": 9, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. COUNTY HOSPITAL - POLIO WARD - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Iron lungs line the room like a row of steel whales.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Green light.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A ceiling fan turns slowly.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A radio murmurs a dance tune from a distant city.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. ALISTAIR VANCE-HOLLOWAY (50s, tall, courteous, bow tie loosened) pauses at the foot of a bed with a chart.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "NURSE BERNADETTE OKONJO (40s, starched cap, quick hands) adjusts a dial on the nearest machine.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "MRS. THEODORA LINDQUIST (60s, wool coat, handbag in both hands) sits very straight on a visitor's chair.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "CASPER WU (20s, medical student, borrowed white coat) stands by the door, taking notes.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "CHAPLAIN AUGUSTUS DELACROIX-BENNETT (70s, soft voice, stole around his neck) kneels in prayer at a bedside.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "He reads the chart a long time.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Mrs. Lindquist watches him.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Nurse Okonjo does not.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "He seems comfortable.", "name": "MRS. LINDQUIST", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "He is resting.", "name": "DR. VANCE-HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "That is not the same thing.", "name": "MRS. LINDQUIST", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "No. It is not.", "name": "DR. VANCE-HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "She nods, grateful for the honesty.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "He closes the chart.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Doctor, the pressure reading on bed six--", "name": "CASPER", "speaker": 3, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Later, Mr. Wu.", "name": "DR. VANCE-HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Yes, sir.", "name": "CASPER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Okonjo crosses to the window.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "The blinds are drawn.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "She tugs a cord and the slats rise.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Moonlight spills onto the machine, silvering the boy inside, who sleeps with his mouth a little open.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "His color is better.", "name": "NURSE OKONJO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Is it?", "name": "MRS. LINDQUIST", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Pink in the cheeks.", "name": "NURSE OKONJO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Dr. Vance-Holloway steps closer.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "He lifts the boy's wrist.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "A long moment.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Nurse. The oxygen.", "name": "DR. VANCE-HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Already, Doctor.", "name": "NURSE OKONJO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "She is turning a valve.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "He does not say what she did, and she does not say what she saw.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Casper looks from one to the other, understanding nothing, then too much.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Doctor?", "name": "CASPER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Fetch the Chaplain.", "name": "DR. VANCE-HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "He's here.", "name": "CASPER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Then bring him.", "name": "DR. VANCE-HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Casper crosses the room.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "The Chaplain looks up from his prayer before he arrives.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "I know.", "name": "CHAPLAIN DELACROIX-BENNETT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "He rises, creaking, and takes Mrs. Lindquist's hand.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "She stares at it without understanding.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Then the radio gives a bright trumpet note, and Mrs. Lindquist rises, breath catching, and lets the handbag fall.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "No.", "name": "MRS. LINDQUIST", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Mrs. Lindquist.", "name": "DR. VANCE-HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "He was pink. She said he was pink.", "name": "MRS. LINDQUIST", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "He was, ma'am.", "name": "NURSE OKONJO", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Mrs. Lindquist crosses to the bed.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Puts a hand on the cold steel.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "The machine wheezes its steady wheeze, pushing air into a chest that no longer asks.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "I am so sorry.", "name": "DR. VANCE-HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "She does not turn.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Nobody speaks.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "In the corner, the radio plays on, a waltz, cheerful and absurd.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Nurse Okonjo crosses and switches it off, and the silence that follows is the loudest thing in the ward.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4]}]}