{"scene_id": "s00091", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00091.fountain", "heading": "INT. PARKED VAN OUTSIDE BELL FOUNDRY - NIGHT", "cast": [{"id": 0, "name": "ZELDA", "names": ["ZELDA"], "gender": "?", "first": 1, "spoke": 12}, {"id": 1, "name": "MURALI", "names": ["MURALI"], "gender": "?", "first": 2, "spoke": 11}], "units": [{"u": 0, "kind": "heading", "text": "INT. PARKED VAN OUTSIDE BELL FOUNDRY - NIGHT", "present": []}, {"u": 1, "kind": "dialogue", "text": "You're humming.", "name": "ZELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 2, "kind": "dialogue", "text": "I'm not.", "name": "MURALI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 3, "kind": "dialogue", "text": "You are. It's the thing from the radio.", "name": "ZELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 4, "kind": "dialogue", "text": "It's a lullaby.", "name": "MURALI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "Whose?", "name": "ZELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Mine. My mother's. Don't.", "name": "MURALI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "I didn't say anything.", "name": "ZELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You were about to.", "name": "MURALI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I was about to say it's nice.", "name": "ZELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "It isn't nice. It's a song about a goat.", "name": "MURALI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Is it a good goat?", "name": "ZELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "He dies.", "name": "MURALI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Ah.", "name": "ZELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Everybody dies in the second verse.", "name": "MURALI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "That's a heavy lullaby.", "name": "ZELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "We were a heavy family.", "name": "MURALI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "And you cope by humming in a van outside a bell foundry.", "name": "ZELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Four more minutes.", "name": "MURALI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Four more minutes.", "name": "ZELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Then we go in.", "name": "MURALI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Then we go in.", "name": "ZELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "And you stop asking questions.", "name": "MURALI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Never.", "name": "ZELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}