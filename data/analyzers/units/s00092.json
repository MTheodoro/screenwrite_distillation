{"scene_id": "s00092", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00092.fountain", "heading": "INT. LUNAR GREENHOUSE - ARTIFICIAL NIGHT", "cast": [{"id": 0, "name": "IMOGEN VASQUEZ-LEE", "names": ["IMOGEN VASQUEZ-LEE", "IMOGEN"], "gender": "f", "first": 4, "spoke": 12}, {"id": 1, "name": "ANTON BERGSTROM", "names": ["ANTON BERGSTROM", "ANTON"], "gender": "m", "first": 6, "spoke": 12}], "units": [{"u": 0, "kind": "heading", "text": "INT. LUNAR GREENHOUSE - ARTIFICIAL NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A vast pressurized dome of hydroponic trays under violet grow-lamps.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of tomato vines climb strings toward the glass.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Beyond the dome, the grey regolith and a hard, bright Earth.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "IMOGEN VASQUEZ-LEE (40s, station botanist, rolled sleeves, soil under her nails) kneels between two trays with a pair of pruning shears.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She is slight and quick, her hair held by a pencil.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "ANTON BERGSTROM (50s, systems engineer, thick glasses, a tablet always in hand) stands at the far end checking the irrigation readouts, wearing a sweater with a hole in one elbow.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Both are very tired.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Neither says so.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Pump three is running hot.", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Tell it to calm down.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "It doesn't take advice.", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Neither do the tomatoes.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She snips a withered leaf.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Drops it in a bucket.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Anton taps the tablet.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "The lamps pulse a half-second slower.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "That's the fourth flicker today.", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "I counted six.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "You counted the ones I didn't.", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She stands, stretches her back, and wanders down the row toward him, trailing a hand through the leaves.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Do you ever hear them?", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "The plants?", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "The stems. When the lamps come on. A kind of ticking.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "That's the heat.", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I know it's the heat.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "They stand a moment in the violet light.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Imogen.", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Yes.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "You've been in here eighteen hours.", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "They don't water themselves.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Actually, they do. That's my entire job.", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "She laughs, a short cough of a sound.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "He nearly smiles.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "The lights shudder.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Both look up.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "A distant thud rolls through the dome, a bolt shaken loose in the airlock.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "The vines sway, then settle.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "The tablet in Anton's hand goes dark, and so does the row of lamps.", "para": 7, "sent": 4, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "For three heartbeats there is only the white wash of Earthlight on the leaves.", "para": 7, "sent": 5, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Don't move.", "name": "IMOGEN", "speaker": 0, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "I wasn't going to.", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "The lamps flare back to life one by one.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Imogen exhales.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "Anton wipes his glasses on the hole in his sweater.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "They look at each other, then at the trays, and then both go back to work without another word, side by side, snipping and tapping in the purple dark.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Pump three.", "name": "ANTON", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "Go.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "He crosses to a panel and thumps it with the heel of his hand.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "A pump coughs.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "Water begins to run.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "Imogen reaches out and touches a ripening tomato.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "It is perfectly, impossibly red.", "para": 9, "sent": 4, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "Anton.", "name": "IMOGEN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "Mm.", "name": "ANTON", "speaker": 1, "ext": [], "paren": ["from the panel"], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "Come and see.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "He walks over.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "She plucks the fruit, wipes it on her sleeve, and hands it to him.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "He looks at it for a long time.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "Then he takes a bite, and the juice runs down his chin, and neither of them says a word.", "para": 10, "sent": 3, "present": [0, 1]}]}