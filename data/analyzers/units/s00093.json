{"scene_id": "s00093", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00093.fountain", "heading": "INT. BIRTHDAY PARTY BACKYARD - DAY", "cast": [{"id": 0, "name": "WALDO PIMM", "names": ["WALDO PIMM", "WALDO"], "gender": "m", "first": 5, "spoke": 4}, {"id": 1, "name": "BERNICE PLUMMER-ASANTE", "names": ["BERNICE PLUMMER-ASANTE", "BERNICE"], "gender": "?", "first": 21, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. BIRTHDAY PARTY BACKYARD - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Balloons.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Folding tables.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A bouncy castle deflating in the corner.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Forty children, screaming.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "WALDO PIMM (40s, sequined vest, top hat, rabbit in a cage) stands on a milk crate, juggling three oranges.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "One slips.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "He catches it with his chin.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "dialogue", "text": "Ladies and gentlemen! The Great Waldo!", "name": "WALDO", "speaker": 0, "ext": [], "paren": ["to the kids"], "dual": false, "present": [0]}, {"u": 9, "kind": "action", "text": "A child screams.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "Another cries.", "para": 2, "sent": 1, "present": [0]}, {"u": 11, "kind": "action", "text": "A third throws cake.", "para": 2, "sent": 2, "present": [0]}, {"u": 12, "kind": "dialogue", "text": "Sixty dollars. Sixty dollars. Sixty dollars.", "name": "WALDO", "speaker": 0, "ext": ["CONT'D"], "paren": ["muttering"], "dual": false, "present": [0]}, {"u": 13, "kind": "action", "text": "He pulls a scarf from his sleeve.", "para": 3, "sent": 0, "present": [0]}, {"u": 14, "kind": "action", "text": "It keeps coming.", "para": 3, "sent": 1, "present": [0]}, {"u": 15, "kind": "action", "text": "Yards of it.", "para": 3, "sent": 2, "present": [0]}, {"u": 16, "kind": "action", "text": "He tugs.", "para": 3, "sent": 3, "present": [0]}, {"u": 17, "kind": "action", "text": "Tugs.", "para": 3, "sent": 4, "present": [0]}, {"u": 18, "kind": "action", "text": "Out comes a second scarf, then a third, tied together, and finally a live parakeet that flies straight over the fence.", "para": 3, "sent": 5, "present": [0]}, {"u": 19, "kind": "dialogue", "text": "That was Gerald.", "name": "WALDO", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the sky"], "dual": false, "present": [0]}, {"u": 20, "kind": "action", "text": "A woman's voice calls from the gate.", "para": 4, "sent": 0, "present": [0]}, {"u": 21, "kind": "action", "text": "BERNICE PLUMMER-ASANTE (70s, sunhat, enormous handbag) pushes through, waving a rolled newspaper at Waldo, who ducks.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "The rabbit escapes its cage, hops across the lawn, and disappears under the cake table.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Bernice swings and misses.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Waldo vaults the crate, a child grabs his cape, and the three of them end up in a heap beside the bouncy castle, the castle sighing down on top of them.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "You owe me for the parakeet!", "name": "BERNICE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "He's a free spirit!", "name": "WALDO", "speaker": 0, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1]}]}