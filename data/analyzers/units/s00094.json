{"scene_id": "s00094", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00094.fountain", "heading": "EXT. ROOFTOP APIARY - GOLDEN HOUR", "cast": [{"id": 0, "name": "AMARA OKEKE", "names": ["AMARA OKEKE", "AMARA"], "gender": "f", "first": 4, "spoke": 6}, {"id": 1, "name": "THEO BALASUBRAMANIAN", "names": ["THEO BALASUBRAMANIAN", "THEO"], "gender": "m", "first": 5, "spoke": 6}, {"id": 2, "name": "GRANDMOTHER NNEKA", "names": ["GRANDMOTHER NNEKA", "NNEKA"], "gender": "?", "first": 16, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ROOFTOP APIARY - GOLDEN HOUR", "present": []}, {"u": 1, "kind": "action", "text": "Hives like pastel filing cabinets.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Bees drift over the city skyline.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A string of bulbs sways overhead.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "AMARA OKEKE (30s, veil pushed back, honey on her wrist) lifts a frame heavy with comb.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "THEO BALASUBRAMANIAN (30s, borrowed veil, delighted) stands too close, holding a smoker he has not lit.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Step back.", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "I'm fine.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You're stepping on the queen's door.", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I'm sorry, Your Majesty.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She laughs.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He lights the smoker.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "A white plume.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Gently.", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Always.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "The stairwell door bangs.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "GRANDMOTHER NNEKA (80s, floral housecoat, cane, a shopping bag) hobbles onto the roof.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Amara!", "name": "NNEKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Mama?", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Hello, ma'am.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Who is the boy?", "name": "NNEKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "It's Theo, Mama. I told you.", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "You told me Thursday.", "name": "NNEKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Today is Thursday.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Then I am on time.", "name": "NNEKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "She sets the bag on a hive.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Amara lunges to catch it.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Mama! Not there.", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "It's only plantains.", "name": "NNEKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "They'll love the plantains.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "They better. Come, boy. Eat.", "name": "NNEKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}