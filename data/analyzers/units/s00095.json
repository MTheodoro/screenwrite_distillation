{"scene_id": "s00095", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00095.fountain", "heading": "INT. DEAD MAN'S TACKLE SHOP - BACK ROOM - DAY", "cast": [{"id": 0, "name": "GLORIA ESPINOSA-WRAY", "names": ["GLORIA ESPINOSA-WRAY", "GLORIA"], "gender": "f", "first": 5, "spoke": 24}, {"id": 1, "name": "RAUL", "names": ["RAUL"], "gender": "?", "first": 6, "spoke": 23}], "units": [{"u": 0, "kind": "heading", "text": "INT. DEAD MAN'S TACKLE SHOP - BACK ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Rods in racks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Tins of lures.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A calendar from 2009.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Dust motes in a shaft of window light.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "GLORIA ESPINOSA-WRAY (60s, widow's black, silver bun) sits on an upturned bucket, a shoebox in her lap.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her son RAUL (30s, work shirt, wedding ring turned the wrong way) stands at the workbench, sorting reels into a crate.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Neither speaks.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He lifts a reel.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Examines it.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Sets it down.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "This one's good.", "name": "RAUL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Your father cursed that one.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "He cursed all of them.", "name": "RAUL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "He cursed them gently.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Raul almost laughs.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He doesn't.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "I can have the shop listed by Friday.", "name": "RAUL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Do what you want.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "It's your shop.", "name": "RAUL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "It was his shop.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Ma.", "name": "RAUL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "You didn't come.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": ["opening the shoebox"], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "I came to the funeral.", "name": "RAUL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "You didn't come in March.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I was working.", "name": "RAUL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "He asked.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "I know he asked.", "name": "RAUL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "He asked every day.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "And I said I'd come.", "name": "RAUL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "And you said you'd come.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "A drip from the ceiling.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "A bucket catches it.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Gloria lifts a photograph from the box.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "A boy on a pier, grinning with a fish too big for him.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Look.", "name": "GLORIA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "He doesn't.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "I don't want to.", "name": "RAUL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "You were eight.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "I remember.", "name": "RAUL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "He kept it in the register. Under the tray.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "That's stupid.", "name": "RAUL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "It's what he did.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "He'd have let me know. If it mattered.", "name": "RAUL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "He did let you know. Every day. By asking.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "Raul grips the bench.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "The knuckles go white.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "A reel falls from the crate and rolls across the floor.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "You think I don't know that? GLORIA ^You think I don't know what you think?", "name": "RAUL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "Their voices overlap and collide.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "They stop.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "Gloria sets down the photograph.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Sit.", "name": "GLORIA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "I'm fine.", "name": "RAUL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "Sit.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "He sits on a crate.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "Hands between his knees.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "I was scared.", "name": "RAUL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "Of what?", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "Of seeing him small.", "name": "RAUL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "He wasn't small.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "He was. Ma. In the photos you sent, he was.", "name": "RAUL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "He was still your father.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "That's the thing.", "name": "RAUL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "What?", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "I wanted him to stay the one with the fish.", "name": "RAUL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "Oh, Raul.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": ["very quietly"], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "action", "text": "He bends forward, forehead on his fists.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "Gloria sets the box aside, crosses the room in her slow black shoes, and rests a hand on the back of his neck, the way you steady a young horse.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "The drip falls into the bucket, steady as a clock.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "I should've come.", "name": "RAUL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "dialogue", "text": "Yes.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 72, "kind": "dialogue", "text": "That's it? Yes?", "name": "RAUL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 73, "kind": "dialogue", "text": "You want me to say it was fine?", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 74, "kind": "dialogue", "text": "I want you to say something.", "name": "RAUL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 75, "kind": "dialogue", "text": "Help me pack the rods.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 76, "kind": "action", "text": "He wipes his face on his sleeve.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 77, "kind": "action", "text": "Stands.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 78, "kind": "action", "text": "Takes one end of the long rod rack.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 79, "kind": "action", "text": "She takes the other.", "para": 11, "sent": 3, "present": [0, 1]}, {"u": 80, "kind": "action", "text": "They carry it out into the light, not looking at each other, the way people do who have finally said enough.", "para": 11, "sent": 4, "present": [0, 1]}]}