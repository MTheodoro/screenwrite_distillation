{"scene_id": "s00096", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00096.fountain", "heading": "INT. DEEP-SEA HABITAT \"THRESHOLD\" - MAIN CABIN - NIGHT CYCLE", "cast": [{"id": 0, "name": "NADIRA SHARIFOVA", "names": ["NADIRA SHARIFOVA", "NADIRA"], "gender": "?", "first": 4, "spoke": 8}, {"id": 1, "name": "PETRUS VAN DER LINDE", "names": ["PETRUS VAN DER LINDE", "PETRUS"], "gender": "?", "first": 5, "spoke": 5}, {"id": 2, "name": "QUILL", "names": ["QUILL"], "gender": "m", "first": 6, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. DEEP-SEA HABITAT \"THRESHOLD\" - MAIN CABIN - NIGHT CYCLE", "present": []}, {"u": 1, "kind": "action", "text": "A curved steel cylinder lined with cables, plastic crates, and pipe.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Portholes the size of dinner plates show nothing but black water.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single red emergency lamp pulses at the far bulkhead.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "NADIRA SHARIFOVA (40s, habitat commander, close-cropped hair, a mug that reads WORLD'S OKAYEST BOSS) stands at the central console.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "PETRUS VAN DER LINDE (50s, pressure technician, ginger beard gone grey at the chin) kneels beside an open floor panel, a wrench in each hand.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "QUILL (20s, oceanographer, real name Quillon Adeyemi, dreadlocks tied up in a net) bends over a bank of sonar monitors, headphones around his neck.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Eyes up, everyone. Status report.", "name": "NADIRA", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Seal four is weeping.", "name": "PETRUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Sonar's reading something big.", "name": "QUILL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "How big?", "name": "NADIRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Bigger than us.", "name": "QUILL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Nadira sets down her mug.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Define \"something.\"", "name": "NADIRA", "speaker": 0, "ext": [], "paren": ["to Quill"], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "It's moving. Slowly. Circling.", "name": "QUILL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Not today. Not today. Not today.", "name": "PETRUS", "speaker": 1, "ext": [], "paren": ["muttering, to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "He tightens a bolt.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "A thin jet of water hisses at his wrist, and he curses and clamps a hand over it.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Nadira drops beside him and slaps a patch over the leak.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Hold it.", "name": "NADIRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I am holding it.", "name": "PETRUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Hold it harder.", "name": "NADIRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "The emergency lamp pulses faster.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Quill removes his headphones, puts them back on, and removes them again.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "It's gone.", "name": "QUILL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Gone where?", "name": "NADIRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Just gone. Vanished off the screen.", "name": "QUILL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "The hull shudders.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "A deep, resonant note rolls through the walls, like a cello string the size of a whale.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Everyone freezes.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Dust drifts from the ceiling.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Petrus lets go of the patch, and it holds.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "That was no engine.", "name": "PETRUS", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "That was a song.", "name": "QUILL", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Nobody panic.", "name": "NADIRA", "speaker": 0, "ext": [], "paren": ["to everyone, quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "She looks at the nearest porthole.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "A vast, pale eye slides past the glass, unblinking, then drifts into the dark.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "That's a sperm whale.", "name": "QUILL", "speaker": 2, "ext": [], "paren": ["grinning, helpless"], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "It's enormous.", "name": "PETRUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Of course it is.", "name": "NADIRA", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "She retrieves her mug and takes a long, slow sip.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Her hand shakes only a little.", "para": 7, "sent": 1, "present": [0, 1, 2]}]}