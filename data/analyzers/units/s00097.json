{"scene_id": "s00097", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00097.fountain", "heading": "INT. RETROFITTED SCHOOL BUS BRIDAL SHOP - DAY", "cast": [{"id": 0, "name": "PHILOMENA TRASK", "names": ["PHILOMENA TRASK", "PHILOMENA"], "gender": "f", "first": 3, "spoke": 5}, {"id": 1, "name": "GWENDOLYN OSEI-MARTINSEN", "names": ["GWENDOLYN OSEI-MARTINSEN", "GWENDOLYN"], "gender": "f", "first": 4, "spoke": 4}, {"id": 2, "name": "LUCIEN FAURE", "names": ["LUCIEN FAURE", "LUCIEN"], "gender": "m", "first": 5, "spoke": 3}, {"id": 3, "name": "IMANI REYNOLDS", "names": ["IMANI REYNOLDS", "IMANI"], "gender": "?", "first": 6, "spoke": 3}, {"id": 4, "name": "BARTHOLOMEW FINCH", "names": ["BARTHOLOMEW FINCH", "BARTHOLOMEW"], "gender": "?", "first": 7, "spoke": 3}, {"id": 5, "name": "AUNT CORDELIA", "names": ["AUNT CORDELIA"], "gender": "?", "first": 23, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. RETROFITTED SCHOOL BUS BRIDAL SHOP - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A yellow school bus gutted and rebuilt as a boutique: tulle hung from the luggage racks, chandeliers swaying from the ceiling, a three-way mirror bolted where the driver's seat used to be.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sunlight falls through the stop-sign window in a red octagon on the floor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "PHILOMENA TRASK (30s, bride, hair half-pinned, bare feet) stands on a milk crate in a billowing gown.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "GWENDOLYN OSEI-MARTINSEN (60s, shop owner, pins in her mouth, measuring tape like a stole) kneels at the hem.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "LUCIEN FAURE (30s, best man, tuxedo jacket over jeans) lounges on a bench seat eating a muffin.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "IMANI REYNOLDS (20s, maid of honor, phone in hand) paces the aisle.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "BARTHOLOMEW FINCH (70s, bus driver, still in uniform, newspaper) sits at the wheel, pretending to read.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "Arms up.", "name": "GWENDOLYN", "speaker": 1, "ext": [], "paren": ["around the pins"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "They are up.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Up like you mean it.", "name": "GWENDOLYN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Philomena raises her arms.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "The dress gapes.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Imani gasps.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "It's too big!", "name": "IMANI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "It's perfect.", "name": "LUCIEN", "speaker": 2, "ext": [], "paren": ["mouth full"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Imani and Philomena speak together.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "It's not perfect!", "name": "IMANI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "^I love it!", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "They stop.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Look at each other.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Imani's phone rings.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "She answers, thumb flying.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Is she in the dress? I want a photo. Don't let her cry. She'll cry.", "name": "AUNT CORDELIA", "speaker": 5, "ext": ["V.O."], "paren": ["over speaker, crackling"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "I'm not crying.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Is she crying?", "name": "AUNT CORDELIA", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "A little.", "name": "IMANI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "I'm not!", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "She is.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Gwendolyn stands, spits the pins into her palm, and wipes the bride's cheek with the measuring tape.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Hush, child.", "name": "GWENDOLYN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Bartholomew lowers the newspaper.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Are we leaving, or what?", "name": "BARTHOLOMEW", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "We are fitting a bride!", "name": "GWENDOLYN", "speaker": 1, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Fitting a bride in a bus. My mother would never.", "name": "BARTHOLOMEW", "speaker": 4, "ext": [], "paren": ["to his paper"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Lucien licks muffin from his thumb.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Phil, honestly. You look like a lighthouse.", "name": "LUCIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "That's not a compliment.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "It is where I'm from.", "name": "LUCIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Everything seems fine.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "The chandeliers tinkle.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "The sun burns the floor.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Philomena steps off the crate and walks the aisle, the gown dragging behind her like a wake.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Then the bus lurches.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "The engine coughs and catches.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Bartholomew is leaning on the wheel, and one foot is flat on the accelerator.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Hold on.", "name": "BARTHOLOMEW", "speaker": 4, "ext": [], "paren": ["with great calm"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "Everyone stumbles.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "The bus rolls forward.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "Gwendolyn grabs a rack.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "Imani drops the phone.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Lucien's muffin lands in Philomena's veil.", "para": 10, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "The bus rolls through the garage doors and into the street, a wedding on wheels, tulle streaming out the windows like a flag.", "para": 10, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "Hello? Is the bus moving?", "name": "AUNT CORDELIA", "speaker": 5, "ext": ["V.O."], "paren": ["from the phone, on the floor"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}