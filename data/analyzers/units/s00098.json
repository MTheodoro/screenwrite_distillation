{"scene_id": "s00098", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00098.fountain", "heading": "INT. MATTRESS WAREHOUSE - MAILROOM - DAY", "cast": [{"id": 0, "name": "THE INTERN", "names": ["INTERN", "THE INTERN"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "PRUDENCE KALLIS", "names": ["PRUDENCE KALLIS", "PRUDENCE"], "gender": "?", "first": 5, "spoke": 8}, {"id": 2, "name": "ANDRZEJ NOWICKI-FAYE", "names": ["ANDRZEJ NOWICKI-FAYE", "ANDRZEJ"], "gender": "m", "first": 6, "spoke": 3}, {"id": 3, "name": "ROSCOE", "names": ["ROSCOE"], "gender": "m", "first": 20, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. MATTRESS WAREHOUSE - MAILROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Stacks of boxed queens and kings reach the rafters.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A conveyor rattles.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Fluorescent light buzzes over steel shelving.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "THE INTERN (19, stiff new polo, name tag blank) stands in the doorway holding a manila envelope like a live fish.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "MS. PRUDENCE KALLIS (50s, cardigan, reading glasses on a beaded chain) sorts parcels at the counter.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "ANDRZEJ NOWICKI-FAYE (40s, forklift gloves tucked in his belt) sits on a pallet, eating a sandwich in precise bites.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Nobody speaks.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "The conveyor rattles.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Um. Hi. I was told to report here.", "name": "THE INTERN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "By whom?", "name": "PRUDENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "A man in a tie.", "name": "THE INTERN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "They all wear ties.", "name": "PRUDENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She does not look up.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Andrzej chews.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "The Intern steps into the room and sets the envelope on the counter.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "It says to give you this.", "name": "THE INTERN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Prudence slits it open with a letter opener.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Reads.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Her mouth thins.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Roscoe.", "name": "PRUDENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Sorry?", "name": "THE INTERN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "It says here your name is Roscoe.", "name": "PRUDENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Oh. Yes. Roscoe. Hi.", "name": "ROSCOE", "speaker": 3, "ext": [], "paren": ["startled"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Roscoe.", "name": "ANDRZEJ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Roscoe, welcome to the mailroom.", "name": "PRUDENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Thanks. What do I do?", "name": "ROSCOE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "You stand.", "name": "PRUDENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Stand?", "name": "ROSCOE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "You stand. You wait. You deliver nothing.", "name": "ANDRZEJ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "That's it?", "name": "ROSCOE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Seventeen years, and that is the entire job.", "name": "PRUDENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Andrzej folds his sandwich paper into a perfect square.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Prudence slides the envelope into a drawer already full of identical ones.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Roscoe adjusts his name tag, which still says nothing.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "The conveyor rattles on.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Is there a handbook?", "name": "ROSCOE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "There's a mattress.", "name": "ANDRZEJ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "He points.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "In the corner, between two stacks of boxes, a single twin bed made up with a grey blanket.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "A small nest of mail beside it.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Does someone sleep here?", "name": "ROSCOE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Not tonight.", "name": "PRUDENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}