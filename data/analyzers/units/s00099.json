{"scene_id": "s00099", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00099.fountain", "heading": "INT. NIGHT TRAIN - SLEEPER COMPARTMENT - NIGHT", "cast": [{"id": 0, "name": "CLEMENCE ARDOIN", "names": ["CLEMENCE ARDOIN", "CLEMENCE"], "gender": "f", "first": 5, "spoke": 17}, {"id": 1, "name": "SULEIMAN HADDAD", "names": ["SULEIMAN HADDAD", "SULEIMAN"], "gender": "?", "first": 6, "spoke": 16}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT TRAIN - SLEEPER COMPARTMENT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A narrow cabin of dark wood and brass.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Two bunks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A lamp swings with the rails.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain slides sideways down the window.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CLEMENCE ARDOIN (30s, wool coat, hair undone) sits on the lower bunk with her shoes still on.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "SULEIMAN HADDAD (30s, travel-worn suit, a single suitcase) stands at the window with his back to her.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He does not turn.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She watches the back of his neck.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He watches the dark.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "You could have taken another car.", "name": "CLEMENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "There was no other car.", "name": "SULEIMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "There's always another car.", "name": "CLEMENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Not at two in the morning.", "name": "SULEIMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "You didn't ask.", "name": "CLEMENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Neither did you.", "name": "SULEIMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "The rails clack.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She smooths her skirt.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He loosens his tie, pulls it off, folds it once, twice, and tucks it in his pocket.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Tell me why you came.", "name": "CLEMENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "I told you.", "name": "SULEIMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "You told me a story about a conference.", "name": "CLEMENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "It was a good conference.", "name": "SULEIMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "In Lyon. Where I live.", "name": "CLEMENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "It's a big city.", "name": "SULEIMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Suleiman.", "name": "CLEMENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Clemence.", "name": "SULEIMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Say it.", "name": "CLEMENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "I got on the wrong train.", "name": "SULEIMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "You got on the right one.", "name": "CLEMENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "That's worse.", "name": "SULEIMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Yes.", "name": "CLEMENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "He finally turns.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "The lamp lights half his face.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "She is already standing.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "They are closer than either planned.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Six years.", "name": "SULEIMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Seven in March.", "name": "CLEMENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "You counted.", "name": "SULEIMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "You didn't?", "name": "CLEMENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Every day.", "name": "SULEIMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Then why is this the first time?", "name": "CLEMENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Because you would have said no.", "name": "SULEIMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "I might have said yes.", "name": "CLEMENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Might.", "name": "SULEIMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Might.", "name": "CLEMENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "The train screams around a curve and throws her against his chest.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "He catches her.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Neither lets go.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "That was an accident.", "name": "CLEMENCE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "I know.", "name": "SULEIMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "I'm not sorry.", "name": "CLEMENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Neither am I.", "name": "SULEIMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "She slaps him, hard, across the cheek.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "He doesn't flinch.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "She slaps him again, and then she is crying, and then she is holding onto his lapels, and he says her name into her hair, again and again, as the rain beats on the glass and the train carries them toward a station neither of them knows.", "para": 6, "sent": 2, "present": [0, 1]}]}