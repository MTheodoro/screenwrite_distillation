{"scene_id": "s00100", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00100.fountain", "heading": "INT. FARMHOUSE KITCHEN - AUCTION DAY", "cast": [{"id": 0, "name": "IVO LANDRY", "names": ["IVO LANDRY", "IVO"], "gender": "m", "first": 6, "spoke": 5}, {"id": 1, "name": "PETRA SZABO", "names": ["PETRA SZABO", "PETRA"], "gender": "f", "first": 7, "spoke": 5}, {"id": 2, "name": "DOLORES NKRUMAH", "names": ["DOLORES NKRUMAH", "DOLORES"], "gender": "f", "first": 8, "spoke": 5}, {"id": 3, "name": "ANSELM WHITFIELD", "names": ["ANSELM WHITFIELD", "ANSELM"], "gender": "m", "first": 9, "spoke": 4}, {"id": 4, "name": "KIRSTEN BJORNSEN", "names": ["KIRSTEN BJORNSEN", "KIRSTEN"], "gender": "f", "first": 10, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. FARMHOUSE KITCHEN - AUCTION DAY", "present": []}, {"u": 1, "kind": "action", "text": "Oilcloth on the table.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Ladder-back chairs.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A wall clock that ran slow for fifty years.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Outside, through the screen door, trucks and auctioneer chatter in the yard.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Five siblings crowd the room.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "IVO LANDRY (50s, eldest, Sunday jacket, no tie) stands at the counter packing a box of cutlery.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "PETRA SZABO (40s, nurse's clogs, keys in a fist) leans on the sink, arms crossed.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "DOLORES NKRUMAH (late 30s, silk blouse, phone face-down on the table) sits in their mother's chair.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "ANSELM WHITFIELD (30s, work boots, farm cap) rolls a pencil between his fingers by the stove.", "para": 1, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "KIRSTEN BJORNSEN (20s, youngest, bare feet, a cardboard box in her arms) hovers in the doorway to the hall.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "The clock goes to me.", "name": "IVO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "It goes to whoever's here.", "name": "PETRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "I'm here.", "name": "ANSELM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "I'm here too.", "name": "DOLORES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "You're on your phone.", "name": "IVO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "I'm on my phone in the chair.", "name": "DOLORES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Anselm sets the pencil on the table.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Dolores picks it up and sets it back where it was.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Petra jingles her keys.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Ivo wraps a fork in newspaper, then another, working quickly, like a man counting something.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "I took the quilt.", "name": "KIRSTEN", "speaker": 4, "ext": [], "paren": ["from the doorway"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Which quilt?", "name": "PETRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "The blue one.", "name": "KIRSTEN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "That's Ma's quilt.", "name": "IVO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "She told me.", "name": "KIRSTEN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "When?", "name": "ANSELM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "In March.", "name": "KIRSTEN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Of course she told you.", "name": "DOLORES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "That's not fair.", "name": "PETRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "I didn't say it was fair.", "name": "DOLORES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Kirsten shifts the box.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Under the lid, a corner of blue appears.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Ivo sees it.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Looks away.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "A truck engine roars past the screen door and fades.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Ivo puts down the fork and lowers himself, slowly, onto the last free chair.", "para": 3, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "The clock goes to whoever winds it.", "name": "IVO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Nobody winds it.", "name": "PETRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "I wind it.", "name": "ANSELM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Dolores lifts her head, surprised.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Anselm picks the pencil up again, rolls it between finger and thumb.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Petra's hand loosens on the keys, and Kirsten sets the box on the table and, with the care of someone handling an egg, unfolds the quilt.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "She lays it over the oilcloth.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "The five of them look at it, a field of faded blue squares.", "para": 4, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "That's the barn.", "name": "DOLORES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "That's the pump house.", "name": "ANSELM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "That's the pump house, Ivo.", "name": "PETRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "That's the barn.", "name": "IVO", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Nobody argues.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Outside the auctioneer cries a number, and another, and the clock on the wall, for no reason, ticks once and falls silent.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}]}