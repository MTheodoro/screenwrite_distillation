{"scene_id": "s00101", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00101.fountain", "heading": "INT. RADIO STATION BROADCAST BOOTH - NIGHT", "cast": [{"id": 0, "name": "OSWALD FERRIS-MBEKI", "names": ["OSWALD FERRIS-MBEKI", "OSWALD"], "gender": "m", "first": 7, "spoke": 2}, {"id": 1, "name": "LAVINIA CRUZ-HOLLANDER", "names": ["LAVINIA CRUZ-HOLLANDER", "LAVINIA"], "gender": "f", "first": 8, "spoke": 4}, {"id": 2, "name": "DEREK PUTNAM-ADEBAYO", "names": ["DEREK PUTNAM-ADEBAYO", "DEREK"], "gender": "m", "first": 9, "spoke": 2}, {"id": 3, "name": "MARGUERITE LACROIX", "names": ["MARGUERITE LACROIX", "MARGUERITE"], "gender": "f", "first": 10, "spoke": 5}, {"id": 4, "name": "HAZEL OKONKWO-DREW", "names": ["HAZEL OKONKWO-DREW", "HAZEL"], "gender": "?", "first": 11, "spoke": 1}, {"id": 5, "name": "NIGEL STRAND", "names": ["NIGEL STRAND", "NIGEL"], "gender": "m", "first": 12, "spoke": 5}, {"id": 6, "name": "VOICE", "names": ["VOICE"], "gender": "?", "first": 24, "spoke": 4}, {"id": 7, "name": "AIR", "names": ["AIR"], "gender": "?", "first": 4, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. RADIO STATION BROADCAST BOOTH - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A glass-walled booth lined with egg-crate foam.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dials, faders, a microphone on a swan neck.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Beyond the glass, a dim studio and a bank of dead windows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A red ON AIR sign glows above the door.", "para": 0, "sent": 3, "present": [7]}, {"u": 5, "kind": "action", "text": "Six people sit around a small round table in the booth, hands flat on the wood.", "para": 1, "sent": 0, "present": [7]}, {"u": 6, "kind": "action", "text": "A single candle burns in the center.", "para": 1, "sent": 1, "present": [7]}, {"u": 7, "kind": "action", "text": "OSWALD FERRIS-MBEKI (60s, station manager, cardigan, pipe unlit) presides.", "para": 2, "sent": 0, "present": [0, 7]}, {"u": 8, "kind": "action", "text": "LAVINIA CRUZ-HOLLANDER (40s, medium, shawl, silver rings on every finger) closes her eyes.", "para": 2, "sent": 1, "present": [0, 1, 7]}, {"u": 9, "kind": "action", "text": "DEREK PUTNAM-ADEBAYO (30s, sound engineer, headphones round his neck) rests a hand on the mixing board.", "para": 2, "sent": 2, "present": [0, 1, 2, 7]}, {"u": 10, "kind": "action", "text": "MARGUERITE LACROIX (70s, retired host, silk scarf, oxygen tank) watches the flame.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 7]}, {"u": 11, "kind": "action", "text": "HAZEL OKONKWO-DREW (20s, intern, notebook) writes furiously.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 7]}, {"u": 12, "kind": "action", "text": "NIGEL STRAND (50s, owner's lawyer, damp raincoat) stares at the exit.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 7]}, {"u": 13, "kind": "dialogue", "text": "We are here to hear what was never aired.", "name": "LAVINIA", "speaker": 1, "ext": [], "paren": ["eyes closed"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 7]}, {"u": 14, "kind": "dialogue", "text": "Hush, everyone.", "name": "OSWALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 7]}, {"u": 15, "kind": "dialogue", "text": "This is absurd.", "name": "NIGEL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 7]}, {"u": 16, "kind": "dialogue", "text": "Let her work, dear.", "name": "MARGUERITE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 7]}, {"u": 17, "kind": "action", "text": "The candle flame bows.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 7]}, {"u": 18, "kind": "action", "text": "Derek glances at the board.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 7]}, {"u": 19, "kind": "action", "text": "Every needle is dead.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 7]}, {"u": 20, "kind": "dialogue", "text": "Nothing's powered.", "name": "DEREK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 7]}, {"u": 21, "kind": "dialogue", "text": "That's what I wrote.", "name": "HAZEL", "speaker": 4, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 7]}, {"u": 22, "kind": "dialogue", "text": "He is close. A man with a heavy voice. He says...", "name": "LAVINIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 7]}, {"u": 23, "kind": "action", "text": "A crackle on the monitor speaker.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 7]}, {"u": 24, "kind": "dialogue", "text": "...ten minutes to air.", "name": "VOICE", "speaker": 6, "ext": ["V.O."], "paren": ["distorted, from the speaker"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 25, "kind": "action", "text": "Oswald drops his pipe.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 26, "kind": "action", "text": "Marguerite covers her mouth.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 27, "kind": "action", "text": "Derek leans toward the board.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 28, "kind": "action", "text": "Nigel pushes his chair back.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 29, "kind": "dialogue", "text": "That's a recording. Someone's playing a tape.", "name": "NIGEL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "dialogue", "text": "There's no tape. Nothing's plugged in.", "name": "DEREK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "dialogue", "text": "...cut the lights, Marguerite.", "name": "VOICE", "speaker": 6, "ext": ["V.O."], "paren": ["from the speaker"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "action", "text": "Marguerite is staring at the speaker.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "action", "text": "Her hand shakes.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "action", "text": "The oxygen tank hisses.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "dialogue", "text": "That is Vincent.", "name": "MARGUERITE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "dialogue", "text": "Vincent is dead, Marguerite.", "name": "OSWALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "dialogue", "text": "Thirty years.", "name": "MARGUERITE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "dialogue", "text": "...tell them what you did.", "name": "VOICE", "speaker": 6, "ext": ["V.O."], "paren": ["from the speaker"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "action", "text": "Lavinia's eyes fly open.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "action", "text": "She is not looking at the speaker.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 41, "kind": "action", "text": "She is looking at Nigel.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 42, "kind": "dialogue", "text": "It's you.", "name": "LAVINIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 43, "kind": "dialogue", "text": "I beg your pardon?", "name": "NIGEL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 44, "kind": "dialogue", "text": "He is saying your name.", "name": "LAVINIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 45, "kind": "dialogue", "text": "He is not.", "name": "NIGEL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 46, "kind": "dialogue", "text": "...Nigel.", "name": "VOICE", "speaker": 6, "ext": ["V.O."], "paren": ["from the speaker"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 47, "kind": "action", "text": "Nigel slams a palm onto the table.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 48, "kind": "action", "text": "The candle gutters.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 49, "kind": "action", "text": "The ON AIR sign flashes.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 50, "kind": "action", "text": "Hazel scribbles.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 51, "kind": "action", "text": "Derek lunges for the board.", "para": 8, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 52, "kind": "action", "text": "Oswald stands, knocking over his chair.", "para": 8, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 53, "kind": "action", "text": "The whole booth goes black.", "para": 8, "sent": 6, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 54, "kind": "action", "text": "In the dark, a single click.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 55, "kind": "action", "text": "A match is lit.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 56, "kind": "action", "text": "Marguerite's face floats above the flame, calm, steady, ancient.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 57, "kind": "dialogue", "text": "Sit down, Mr. Strand.", "name": "MARGUERITE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 58, "kind": "dialogue", "text": "Please.", "name": "NIGEL", "speaker": 5, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 59, "kind": "dialogue", "text": "Vincent kept very good notes.", "name": "MARGUERITE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 60, "kind": "action", "text": "She holds up a small cassette.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 61, "kind": "action", "text": "The match burns her finger.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 62, "kind": "action", "text": "She doesn't flinch.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 63, "kind": "action", "text": "In the glow, five faces stare at the sixth, who is no longer looking at the exit at all.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}