{"scene_id": "s00102", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00102.fountain", "heading": "INT. FLOODED LIMESTONE CAVE - DAY", "cast": [{"id": 0, "name": "JOSEFINA LARRAZABAL", "names": ["JOSEFINA LARRAZABAL", "JOSEFINA"], "gender": "?", "first": 6, "spoke": 5}, {"id": 1, "name": "TOMASZ EKWUEME", "names": ["TOMASZ EKWUEME", "TOMASZ"], "gender": "m", "first": 7, "spoke": 2}, {"id": 2, "name": "MADELEINE PRICE-ODUYA", "names": ["MADELEINE PRICE-ODUYA", "MADELEINE"], "gender": "f", "first": 8, "spoke": 3}, {"id": 3, "name": "RUBEN HAKIMI", "names": ["RUBEN HAKIMI", "RUBEN"], "gender": "m", "first": 9, "spoke": 2}, {"id": 4, "name": "GUNNAR SIGURDSSON", "names": ["GUNNAR SIGURDSSON", "GUNNAR"], "gender": "m", "first": 10, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. FLOODED LIMESTONE CAVE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A low chamber, water to the waist.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Headlamps stab the dark.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Stalactites drip.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Somewhere ahead, a pulse of water echoes.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Five climbers wade in a line.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "JOSEFINA LARRAZABAL (30s, expedition lead, braid) pushes ahead, rope coiled over one shoulder.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "TOMASZ EKWUEME (40s, doctor, glasses fogged) follows with a medical bag held above his head.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "MADELEINE PRICE-ODUYA (20s, geologist, hardhat) tests the wall with a hammer.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "RUBEN HAKIMI (30s, photographer, camera in a dry bag) stumbles.", "para": 1, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "GUNNAR SIGURDSSON (50s, veteran caver, quiet, grey beard) brings up the rear, a hand on the rope, counting steps.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Water's rising.", "name": "JOSEFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Not rising. Rain upstairs.", "name": "GUNNAR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Is that better?", "name": "RUBEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "It's the same.", "name": "GUNNAR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Madeleine taps the wall.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "A hollow note answers.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "She tilts her head and taps again.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "It's thin here.", "name": "MADELEINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "How thin?", "name": "TOMASZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Thin enough that he should not lean on it.", "name": "MADELEINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Ruben, who has been leaning, pulls back.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "The wall gives a long groan.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Josefina swings around, grabs Ruben's collar, and drags him forward as a slab of limestone sheers off and drops into the water behind them.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "A wave slaps all five.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Gunnar yanks Tomasz upright, Tomasz clutches his bag, Madeleine drops her hammer, and Josefina shoves Ruben against the far wall and shouts for them all to move.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Go! Go! Go!", "name": "JOSEFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "They surge down the passage.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "The rope jerks tight.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Gunnar, last in line, counts steps, and when he reaches thirty, he stops.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "The water behind them has gone still.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "That's the worst of it.", "name": "GUNNAR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "You're sure?", "name": "JOSEFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "No. But it sounds like it.", "name": "GUNNAR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Tomasz lets out a laugh that is half a sob.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Ruben clutches his camera.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Madeleine fishes her hammer from the water and wipes it on her sleeve.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Everyone count off.", "name": "JOSEFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "One.", "name": "TOMASZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Two.", "name": "MADELEINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Three.", "name": "RUBEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Four.", "name": "GUNNAR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Five. Good. We keep moving.", "name": "JOSEFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}