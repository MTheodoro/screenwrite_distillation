{"scene_id": "s00103", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00103.fountain", "heading": "INT. CATHEDRAL BELL TOWER OBSERVATION POST - DAY", "cast": [{"id": 0, "name": "CAPTAIN HENRY ABERNETHY-LOWE", "names": ["CAPTAIN HENRY ABERNETHY-LOWE", "ABERNETHY-LOWE"], "gender": "m", "first": 5, "spoke": 8}, {"id": 1, "name": "CORPORAL TOMMASO RICCI", "names": ["CORPORAL TOMMASO RICCI", "RICCI"], "gender": "m", "first": 7, "spoke": 2}, {"id": 2, "name": "PRIVATE ELIJAH STONE-BARNES", "names": ["PRIVATE ELIJAH STONE-BARNES", "ELIJAH"], "gender": "m", "first": 8, "spoke": 4}, {"id": 3, "name": "RADIO OPERATOR", "names": ["RADIO OPERATOR"], "gender": "?", "first": 17, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. CATHEDRAL BELL TOWER OBSERVATION POST - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A cramped stone chamber beneath the bells.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Narrow arrow-slit windows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Sandbags stacked against the wall.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A field telephone on a plank, a pair of binoculars on a nail.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CAPTAIN HENRY ABERNETHY-LOWE stands at the east slit, field glasses at his eyes.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "He is tall, spare, and impeccable, his uniform pressed even in the dust.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "CORPORAL TOMMASO RICCI sits on an ammunition crate, a rifle across his knees, cleaning it with a rag.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "PRIVATE ELIJAH STONE-BARNES, barely nineteen, huddles by the stairwell door, a mug of tea cold in his hands.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "The captain lowers the glasses.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "He does not turn.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Anything?", "name": "ABERNETHY-LOWE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Nothing, sir.", "name": "RICCI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Then keep looking.", "name": "ABERNETHY-LOWE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Ricci nods, not looking up.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "The private watches the captain, who watches the horizon.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "A great quiet fills the tower.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Eagle's Nest, this is Baker Two. Report.", "name": "RADIO OPERATOR", "speaker": 3, "ext": ["V.O."], "paren": ["field phone, crackling"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Abernethy-Lowe crosses the floor, lifts the receiver, and holds it with two fingers.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Baker Two, Eagle's Nest. Position quiet. No movement.", "name": "ABERNETHY-LOWE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Understood. Command wants a sweep of the north road at sixteen hundred.", "name": "RADIO OPERATOR", "speaker": 3, "ext": ["V.O."], "paren": ["field phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Acknowledged.", "name": "ABERNETHY-LOWE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "He hangs up.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Stands very still, his hand lingering on the receiver.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Elijah sets down the mug.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Sir?", "name": "ELIJAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Private.", "name": "ABERNETHY-LOWE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Is it true what they say about the bells?", "name": "ELIJAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "What do they say?", "name": "ABERNETHY-LOWE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "That they ring on their own before an attack.", "name": "ELIJAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Ricci snorts, rubbing the rifle.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "The captain turns, finally, and studies the boy.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "They ring when the wind is wrong. That's all.", "name": "ABERNETHY-LOWE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Then why do you keep checking?", "name": "ELIJAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "The captain does not answer.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "A long pause.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "High above, in the dark of the belfry, a single bell hums, a faint, shivering note, not a ring, not yet.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Ricci puts down the rifle.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Abernethy-Lowe lifts his glasses.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Elijah stands.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "They all look at the arrow-slit, where the afternoon light has gone a strange, pale gold.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Wind.", "name": "RICCI", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Wind.", "name": "ABERNETHY-LOWE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "The bell hums again.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "This time, it rings.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}]}