{"scene_id": "s00104", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00104.fountain", "heading": "INT. POTTERY KILN SHED - DUSK", "cast": [{"id": 0, "name": "LEILANI KAHALE", "names": ["LEILANI KAHALE", "LEILANI"], "gender": "?", "first": 5, "spoke": 11}, {"id": 1, "name": "DARIUS PELLEGRINO-OKAFOR", "names": ["DARIUS PELLEGRINO-OKAFOR", "DARIUS"], "gender": "m", "first": 6, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. POTTERY KILN SHED - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "Brick walls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A squat kiln glowing orange at its seams.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Shelves of unglazed bowls.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Clay dust in the air like flour.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LEILANI KAHALE (30s, apron, forearms grey with slip) crouches at the kiln, peering through a peephole.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "DARIUS PELLEGRINO-OKAFOR (30s, jacket, an umbrella he does not need) stands in the doorway holding a paper bag.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "You're letting the heat out.", "name": "LEILANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Sorry.", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He steps in.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Closes the door.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I brought dumplings.", "name": "DARIUS", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I'm firing.", "name": "LEILANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "I can wait.", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "It's six hours.", "name": "LEILANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Then I brought a lot of dumplings.", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She almost smiles.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Turns back to the peephole.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Cone eight is down. Cone nine soon.", "name": "LEILANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Is that good?", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "It's necessary.", "name": "LEILANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "He sets the bag on a shelf.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Wanders along the bowls, touching the rims with one finger.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She watches him, in profile, across the glow of the kiln.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "These are beautiful.", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "They're unfinished.", "name": "LEILANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "So am I.", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "That's a terrible line.", "name": "LEILANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "I know. I rehearsed it.", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "She laughs.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "He turns.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Their eyes meet.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "I missed you. DARIUS ^I missed you.", "name": "LEILANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Both stop.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "The kiln ticks.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Neither moves.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Stay.", "name": "LEILANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "For the firing?", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "For the firing.", "name": "LEILANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "He crosses the shed, sits on an upturned bucket by the kiln, and opens the bag.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Steam rises, ginger and sesame.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "She sits beside him on the floor.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "He passes her a dumpling.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "She holds it up to the orange light.", "para": 7, "sent": 4, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Six hours.", "name": "LEILANI", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "We have time.", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}