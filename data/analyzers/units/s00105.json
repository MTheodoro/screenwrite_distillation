{"scene_id": "s00105", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00105.fountain", "heading": "INT. PICKLE FACTORY - HUMAN RESOURCES OFFICE - DAY", "cast": [{"id": 0, "name": "MAGDALENA OKOYE-FINNEGAN", "names": ["MAGDALENA OKOYE-FINNEGAN", "MAGDALENA"], "gender": "?", "first": 4, "spoke": 11}, {"id": 1, "name": "BARRY KOWALSKI-ADEYEMI", "names": ["BARRY KOWALSKI-ADEYEMI", "BARRY"], "gender": "m", "first": 5, "spoke": 11}, {"id": 2, "name": "PETRONELLA GRUBER", "names": ["PETRONELLA GRUBER", "PETRONELLA"], "gender": "?", "first": 6, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. PICKLE FACTORY - HUMAN RESOURCES OFFICE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A glass cubicle overlooking the brine vats.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The air is vinegar.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A motivational poster reads: \"BE THE DILL.\"", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MAGDALENA OKOYE-FINNEGAN (50s, HR director, cardigan, sensible shoes) sits behind a desk stacked with folders.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across from her, BARRY KOWALSKI-ADEYEMI (40s, line supervisor, apron, spotless) folds his hands in his lap.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "In the corner, a chair holds PETRONELLA GRUBER (60s, union rep, thermos, knitting).", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "She smiles.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "He smiles back.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Thank you for coming in, Barry.", "name": "MAGDALENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Of course.", "name": "BARRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "This is informal.", "name": "MAGDALENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Great.", "name": "BARRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She slides a folder across the desk.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "He does not touch it.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Petronella knits.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Anything you'd like to share?", "name": "MAGDALENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "About what?", "name": "BARRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Anything.", "name": "MAGDALENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "He glances at the folder.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "At Petronella.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "At the poster.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Business is good.", "name": "BARRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Is it?", "name": "MAGDALENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Yes.", "name": "BARRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "She nods.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Opens the folder.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Takes out a single photograph and sets it between them.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "He leans forward, then back, swallowing.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "That's a gherkin.", "name": "BARRY", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "It is.", "name": "MAGDALENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "It's a small gherkin.", "name": "BARRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "It is a small gherkin that was found in the Reuben line of Plant Three.", "name": "MAGDALENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Knit one, purl two.", "name": "PETRONELLA", "speaker": 2, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "That's hardly my fault.", "name": "BARRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Whose fault is it?", "name": "MAGDALENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Systemic.", "name": "BARRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "She closes the folder gently.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Folds her hands.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Barry, we ran the camera footage.", "name": "MAGDALENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "His smile stays.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Everything else drains.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Petronella sets down her needles.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "He did it for the cat.", "name": "PETRONELLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Not now.", "name": "MAGDALENA", "speaker": 0, "ext": [], "paren": ["to Petronella"], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "It was a stray.", "name": "BARRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "It ate forty pounds of relish.", "name": "MAGDALENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "It was hungry.", "name": "BARRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Petronella pours tea into the thermos cap and offers it to him.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "He takes it.", "para": 8, "sent": 1, "present": [0, 1, 2]}]}