{"scene_id": "s00106", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00106.fountain", "heading": "EXT. DRIVE-IN MOVIE SCREEN - ROOFTOP SCAFFOLD - NIGHT", "cast": [{"id": 0, "name": "LEANDER PRZYBYLSKI", "names": ["LEANDER PRZYBYLSKI", "LEANDER"], "gender": "m", "first": 4, "spoke": 19}, {"id": 1, "name": "WINIFRED", "names": ["WINIFRED"], "gender": "f", "first": 5, "spoke": 22}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DRIVE-IN MOVIE SCREEN - ROOFTOP SCAFFOLD - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A vast white screen stands over a lot of weeds and abandoned speaker posts.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "At the top, a narrow catwalk of weathered planks runs behind the canvas.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A few stars show through the clouds.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LEANDER PRZYBYLSKI (15, thin, hands in the pockets of a too-big hoodie) climbs over the last rung and sits at the edge with his legs hanging over nothing.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Behind him, his sister WINIFRED (17, denim jacket, keys on a lanyard, jaw clenched) hauls herself up the ladder, breathing hard, and stands on the catwalk.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "She finds him.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "She does not hurry.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You scared me.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "You came up anyway.", "name": "LEANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Mom's looking everywhere.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Not here.", "name": "LEANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "She will be.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He doesn't turn.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She walks along the planks, one hand trailing the canvas, which breathes like a sail.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "The wind carries her voice into the dark lot.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Dad's car is still in the driveway.", "name": "WINIFRED", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "I know.", "name": "LEANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "He's not going to leave tonight.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "He always says that.", "name": "LEANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "He does.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Then he does.", "name": "LEANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "She sits beside him, close but not touching.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Below, a cat crosses the lot and vanishes.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Remember when we used to come here?", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I remember the fries.", "name": "LEANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Dad used to put his arm over the seat.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "He used to put his arm over Mom.", "name": "LEANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "I was five.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "I was three. I remember.", "name": "LEANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "You do not.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "I remember everything.", "name": "LEANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "That's true, and she knows it.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "She lowers her eyes.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Come home.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Why?", "name": "LEANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Because it's cold.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "That's not a reason.", "name": "LEANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Because I'm cold.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "That's closer.", "name": "LEANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Because I need you.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "He turns at last.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Looks at her.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "In the dark, the white screen glows faintly behind his head like a halo.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "You never say that.", "name": "LEANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "I'm saying it.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Why now?", "name": "LEANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "Because he's going to leave tomorrow.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "The words fall into the silence.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "Leander flinches, hard, like she struck him.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "He stands abruptly.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "The planks creak.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "She grabs his sleeve and he rips free.", "para": 7, "sent": 4, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "You knew.", "name": "LEANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "Since Tuesday.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "You knew since Tuesday and you didn't say.", "name": "LEANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "I was protecting you.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "From what?", "name": "LEANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "From this.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "This is worse!", "name": "LEANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "His voice cracks and breaks over the empty lot.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "He kicks a loose plank.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "It tumbles off the edge and bounces down the scaffold with a long, cheap clatter.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "They both listen until it stops.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "Leander.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "Don't.", "name": "LEANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "Look at me.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "action", "text": "He doesn't.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "She steps in front of him, forcing it.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "I'm sorry. I should have told you.", "name": "WINIFRED", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "action", "text": "He crumples.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "She catches him before he reaches the planks.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "His shoulders shake.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "She holds him, her chin on his head, and over her shoulder the huge dark screen waits for a picture that will never come.", "para": 10, "sent": 3, "present": [0, 1]}]}