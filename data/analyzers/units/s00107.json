{"scene_id": "s00107", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00107.fountain", "heading": "INT. PAWN SHOP - AFTER HOURS", "cast": [{"id": 0, "name": "IRENE KOSTOPOULOS", "names": ["IRENE KOSTOPOULOS", "KOSTOPOULOS"], "gender": "?", "first": 5, "spoke": 13}, {"id": 1, "name": "OFFICER DAMIAN FOLASADE-REYES", "names": ["OFFICER DAMIAN FOLASADE-REYES", "DAMIAN"], "gender": "?", "first": 6, "spoke": 1}, {"id": 2, "name": "SOL WEINBERG-ACHEBE", "names": ["SOL WEINBERG-ACHEBE", "SOL"], "gender": "m", "first": 7, "spoke": 6}, {"id": 3, "name": "JAMAL TEAGUE", "names": ["JAMAL TEAGUE", "JAMAL"], "gender": "?", "first": 8, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. PAWN SHOP - AFTER HOURS", "present": []}, {"u": 1, "kind": "action", "text": "Glass cases.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Guitars on the wall.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A wall of wristwatches ticking out of sync.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "One shattered window patched with cardboard.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DET. IRENE KOSTOPOULOS (50s, trench coat, tired eyes) crouches beside a broken display case, photographing the glass.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "OFFICER DAMIAN FOLASADE-REYES (20s, rookie, uniform too crisp) stands at the door writing in a notebook.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "SOL WEINBERG-ACHEBE (60s, shop owner, cardigan, hands behind his back) watches from behind the register.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "At the end of the counter, a teenager, JAMAL TEAGUE (17, hoodie, no shoes), sits cross-legged on the floor with a blanket around his shoulders.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Kostopoulos stands.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Her knees crack.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "She nods at the broken case.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "What was in there?", "name": "KOSTOPOULOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Rings.", "name": "SOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "How many?", "name": "KOSTOPOULOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Eleven.", "name": "SOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "She lifts one eyebrow.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Sol studies the floor.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Twelve.", "name": "SOL", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Mm.", "name": "KOSTOPOULOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Damian flips a page.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Jamal pulls the blanket tighter.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Kostopoulos crosses to him and lowers herself, stiffly, into a squat.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "You got a name?", "name": "KOSTOPOULOS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Jamal.", "name": "JAMAL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Jamal. You hurt?", "name": "KOSTOPOULOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "No.", "name": "JAMAL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "You hungry?", "name": "KOSTOPOULOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "He shrugs.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "She looks up at Damian.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Officer. Find him something.", "name": "KOSTOPOULOS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Like what?", "name": "DAMIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Anything.", "name": "KOSTOPOULOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Damian leaves.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Sol follows him with his eyes.", "para": 6, "sent": 1, "present": [0, 2, 3]}, {"u": 35, "kind": "action", "text": "The watches tick.", "para": 6, "sent": 2, "present": [0, 2, 3]}, {"u": 36, "kind": "action", "text": "Kostopoulos sits on the floor beside Jamal, her coat spreading around her.", "para": 6, "sent": 3, "present": [0, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Did you break the window?", "name": "KOSTOPOULOS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "It was already broken.", "name": "JAMAL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Did you go in?", "name": "KOSTOPOULOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "I was cold.", "name": "JAMAL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "That's not what I asked.", "name": "KOSTOPOULOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3]}, {"u": 42, "kind": "action", "text": "He shrugs again.", "para": 7, "sent": 0, "present": [0, 2, 3]}, {"u": 43, "kind": "action", "text": "Sol clears his throat.", "para": 7, "sent": 1, "present": [0, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "He's been sleeping behind the dumpster for a week.", "name": "SOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "You knew?", "name": "KOSTOPOULOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "I leave the heater on in the back.", "name": "SOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3]}, {"u": 47, "kind": "action", "text": "Kostopoulos looks at Sol, then at the boy.", "para": 8, "sent": 0, "present": [0, 2, 3]}, {"u": 48, "kind": "action", "text": "She exhales.", "para": 8, "sent": 1, "present": [0, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "So nobody broke in.", "name": "KOSTOPOULOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Somebody did. I just forgot to say hello.", "name": "SOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3]}, {"u": 51, "kind": "action", "text": "Damian returns with a bag of crackers from the vending machine.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Jamal takes it with both hands.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Nobody mentions the twelve rings, and eventually Kostopoulos folds her notebook shut.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}]}