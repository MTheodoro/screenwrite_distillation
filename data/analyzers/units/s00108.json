{"scene_id": "s00108", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00108.fountain", "heading": "INT. GENERATION SHIP \"ANAMNESIS\" - COUNCIL CHAMBER - SHIP DAY", "cast": [{"id": 0, "name": "ELDER TOMOKO VASQUEZ-ADEBAYO", "names": ["ELDER TOMOKO VASQUEZ-ADEBAYO", "TOMOKO"], "gender": "f", "first": 4, "spoke": 7}, {"id": 1, "name": "NAVIGATOR PRIYADARSHINI OKEKE", "names": ["NAVIGATOR PRIYADARSHINI OKEKE", "PRIYADARSHINI"], "gender": "f", "first": 5, "spoke": 4}, {"id": 2, "name": "MEDIC CORVIN HALLORAN-NWOSU", "names": ["MEDIC CORVIN HALLORAN-NWOSU", "CORVIN"], "gender": "m", "first": 6, "spoke": 6}, {"id": 3, "name": "ENGINEER BEATRIX SOLBERG-MWANGI", "names": ["ENGINEER BEATRIX SOLBERG-MWANGI", "BEATRIX"], "gender": "f", "first": 7, "spoke": 6}, {"id": 4, "name": "ARCHIVIST DESMOND OYELARAN-PIKE", "names": ["ARCHIVIST DESMOND OYELARAN-PIKE", "DESMOND"], "gender": "m", "first": 8, "spoke": 8}, {"id": 5, "name": "ZANELE KOROMA-LINDEN", "names": ["ZANELE KOROMA-LINDEN", "ZANELE"], "gender": "f", "first": 9, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. GENERATION SHIP \"ANAMNESIS\" - COUNCIL CHAMBER - SHIP DAY", "present": []}, {"u": 1, "kind": "action", "text": "A circular hall with a ceiling like the inside of a seed.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Six seats are arranged around a table of pale resin.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The viewport behind them shows stars drifting in a very slow river.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ELDER TOMOKO VASQUEZ-ADEBAYO (70s, high collar, white hair braided to her waist) sits at the head.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "NAVIGATOR PRIYADARSHINI OKEKE (40s, ink-stained fingers, silent) sits beside her.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "MEDIC CORVIN HALLORAN-NWOSU (50s, round glasses, a satchel of vials) leans forward.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "ENGINEER BEATRIX SOLBERG-MWANGI (30s, rolled sleeves, calloused hands) sits scowling with her arms crossed.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "ARCHIVIST DESMOND OYELARAN-PIKE (60s, tweed, a book on his knee) sits very upright.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "And at the foot, the youngest, ZANELE KOROMA-LINDEN (20s, council apprentice, uniform too stiff) holds a stylus above a slate.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "We begin.", "name": "TOMOKO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Fuel reserves?", "name": "PRIYADARSHINI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Eleven percent.", "name": "BEATRIX", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Eleven.", "name": "PRIYADARSHINI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Eleven and falling.", "name": "BEATRIX", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "The farm decks are failing too.", "name": "CORVIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "That is in the records.", "name": "DESMOND", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "The records do not feed anyone.", "name": "CORVIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "They tell us why.", "name": "DESMOND", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Why does not matter. When does.", "name": "CORVIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Please.", "name": "TOMOKO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "They quiet.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Zanele writes.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "We will decide today whether the ship turns.", "name": "TOMOKO", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Turning costs four percent.", "name": "BEATRIX", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Not turning costs everything.", "name": "PRIYADARSHINI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "There is a system two light-years aft.", "name": "DESMOND", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Two years of burn.", "name": "BEATRIX", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Two years of burn, and a green world.", "name": "DESMOND", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "How green?", "name": "CORVIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Not as green as the book.", "name": "DESMOND", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Then how green?", "name": "CORVIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Enough.", "name": "DESMOND", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Zanele raises her stylus.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "May I speak?", "name": "ZANELE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "The apprentice speaks last.", "name": "TOMOKO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Yes, Elder.", "name": "ZANELE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "But speak.", "name": "TOMOKO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "If we turn, my children will be born in the turn.", "name": "ZANELE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "So?", "name": "BEATRIX", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "So they will never see where we were going.", "name": "ZANELE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "They will see where we got.", "name": "DESMOND", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Is that enough?", "name": "ZANELE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Nobody answers.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Tomoko rests her palms on the resin and closes her eyes.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Priyadarshini studies her own inked fingers.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Corvin pulls a vial from his satchel, then puts it back.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "Beatrix uncrosses her arms.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "I would turn.", "name": "BEATRIX", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "I would turn.", "name": "CORVIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "Archives will log it.", "name": "DESMOND", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "Turn.", "name": "PRIYADARSHINI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "Then it is decided.", "name": "TOMOKO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "Thank you.", "name": "ZANELE", "speaker": 5, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "Do not thank us. Remember us.", "name": "TOMOKO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "She taps the table.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "The stars in the viewport shift.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "A deep note vibrates through the floor, and the entire ship begins to bank, so slowly that only the stars know.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}