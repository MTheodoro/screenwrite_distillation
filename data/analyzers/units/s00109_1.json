{"scene_id": "s00109_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00109.fountain", "heading": "INT. ICE-FISHING HUT - CONTINUOUS", "cast": [{"id": 0, "name": "WILHELMINA BRODERICK-ADEYEMI", "names": ["WILHELMINA BRODERICK-ADEYEMI", "WILHELMINA"], "gender": "f", "first": 5, "spoke": 10}, {"id": 1, "name": "FELIX", "names": ["FELIX"], "gender": "f", "first": 6, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. ICE-FISHING HUT - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Cramped.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A propane heater.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Two folding stools.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A round hole in the floor shows black water under a skin of ice.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "WILHELMINA BRODERICK-ADEYEMI (60s, wool cap, flask) sits on one stool, holding a rod.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her grandson FELIX (12, puffy coat, wide eyes) sits on the other, watching the hole.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "She tugs the line.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Nothing.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Grandma.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Patience.", "name": "WILHELMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "It's been an hour.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "The fish don't know that.", "name": "WILHELMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He sighs.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Rubs his hands over the heater.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Can I tell you something?", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Always.", "name": "WILHELMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "I like it here.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Good boy.", "name": "WILHELMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She smiles.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Sips from the flask.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Then frowns.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "The line twitches.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She reels slowly.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "A tug, hard.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "She leans back, braces.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Get the net.", "name": "WILHELMINA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "He grabs it.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Kneels by the hole.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "The line goes slack.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Wilhelmina pulls it up.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "The hook is bare, clean, polished.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Huh.", "name": "WILHELMINA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Did we lose it?", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "We did.", "name": "WILHELMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "She re-baits.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Drops the line.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "They wait.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "The heater ticks.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Wind presses the shack.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Through the hole, the black water seems to ripple, but there is no wind below the ice.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Grandma.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Shh.", "name": "WILHELMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Something's under us.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "She lifts her head.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "Sees it too.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "A paleness rises in the water.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "A shape.", "para": 10, "sent": 3, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Round.", "para": 10, "sent": 4, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "Broad.", "para": 10, "sent": 5, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "Slowly turning.", "para": 10, "sent": 6, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Felix. Back up.", "name": "WILHELMINA", "speaker": 0, "ext": [], "paren": ["very softly"], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "He doesn't move.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "He's staring.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "It has a face.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "She drops the rod, seizes him by the coat, and drags him away from the hole.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "The pale thing breaks the surface.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "It is not a fish.", "para": 12, "sent": 2, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "It is not anything.", "para": 12, "sent": 3, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "Two white hands grip the edge of the ice and pull, and the water around them runs black and silent.", "para": 12, "sent": 4, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "Out! The door!", "name": "WILHELMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "She pushes him.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "He fumbles with the latch.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "The thing hauls itself into the hut, dripping, long-limbed, tilting its head to one side, looking at them both with an expression of mild and infinite hunger.", "para": 13, "sent": 2, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "The heater gutters and goes out.", "para": 13, "sent": 3, "present": [0, 1]}]}