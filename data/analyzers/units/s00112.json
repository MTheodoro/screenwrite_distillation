{"scene_id": "s00112", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00112.fountain", "heading": "EXT. LIFEBOAT - OPEN SEA - DAWN", "cast": [{"id": 0, "name": "CAPTAIN MAGNUS EKSTROM-ADEBAYO", "names": ["CAPTAIN MAGNUS EKSTROM-ADEBAYO", "MAGNUS"], "gender": "?", "first": 3, "spoke": 5}, {"id": 1, "name": "PIA RAMIREZ-OKONKWO", "names": ["PIA RAMIREZ-OKONKWO", "PIA"], "gender": "?", "first": 5, "spoke": 3}, {"id": 2, "name": "DELPHINE", "names": ["DELPHINE"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "BAZ", "names": ["BAZ"], "gender": "m", "first": 7, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. LIFEBOAT - OPEN SEA - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A cramped orange boat rocks on a grey swell.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Four figures huddle under a torn canopy.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "CAPTAIN MAGNUS EKSTROM-ADEBAYO (60s, grizzled, hand clamped on the tiller) squints at the horizon.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "He is silent.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside him, DR. PIA RAMIREZ-OKONKWO (40s, soaked blazer) wrings out her scarf.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "At the bow, young DELPHINE (16, wide-eyed, life jacket too big) clutches a flare gun.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "In the middle, BAZ (30s, steward, torn jacket) lies on his back, one arm over his eyes.", "para": 1, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "He shifts.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "She looks at him.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Baz. Are you awake?", "name": "PIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "No.", "name": "BAZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Good. Stay that way.", "name": "PIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Magnus lifts one finger.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Everyone goes still.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "He points.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "A smudge on the horizon.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "A smoke trail.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Captain! Is that a ship?", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "It is.", "name": "MAGNUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Should I fire it?", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Not yet.", "name": "MAGNUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "She lowers the gun.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Baz sits up, clutching the gunwale.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Fire it now, Delphine!", "name": "BAZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Wait.", "name": "MAGNUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Magnus, if she doesn't--", "name": "PIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "It's too far. They'd never see it.", "name": "MAGNUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "He steadies the tiller.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "They wait.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "The smoke thickens.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "A hull appears.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Grey.", "para": 6, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Steel.", "para": 6, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Moving toward them.", "para": 6, "sent": 6, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Now.", "name": "MAGNUS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Delphine fires.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "A red star climbs into the sky.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "They scream, all four of them, together.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}]}