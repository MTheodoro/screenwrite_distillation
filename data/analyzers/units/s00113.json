{"scene_id": "s00113", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00113.fountain", "heading": "INT. TERRAFORMING STATION DOME - CONTROL DECK - DAY", "cast": [{"id": 0, "name": "ADMIRAL SELENE VOSKUIJLEN-ADEYEMI", "names": ["ADMIRAL SELENE VOSKUIJLEN-ADEYEMI", "SELENE"], "gender": "?", "first": 5, "spoke": 8}, {"id": 1, "name": "COMMANDER RAMIRO OKONJO-TALLIS", "names": ["COMMANDER RAMIRO OKONJO-TALLIS", "RAMIRO"], "gender": "?", "first": 6, "spoke": 1}, {"id": 2, "name": "DOCTOR YUKI HARTMANN-NWAFOR", "names": ["DOCTOR YUKI HARTMANN-NWAFOR", "YUKI"], "gender": "f", "first": 7, "spoke": 1}, {"id": 3, "name": "ENGINEER BODHI LARSSON-EZE", "names": ["ENGINEER BODHI LARSSON-EZE", "BODHI"], "gender": "m", "first": 8, "spoke": 3}, {"id": 4, "name": "LIEUTENANT CASSANDRA MBEKI-FROST", "names": ["LIEUTENANT CASSANDRA MBEKI-FROST", "CASSANDRA"], "gender": "?", "first": 9, "spoke": 1}, {"id": 5, "name": "THE OBSERVER", "names": ["OBSERVER", "THE OBSERVER"], "gender": "?", "first": 10, "spoke": 3}, {"id": 6, "name": "CONTROL", "names": ["CONTROL"], "gender": "?", "first": 20, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. TERRAFORMING STATION DOME - CONTROL DECK - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A broad glass cupola overlooks a rust-red landscape speckled with the first green.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Atmospheric processors the size of cathedrals churn on the horizon.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Inside, a ring of consoles, each glowing in a different color.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Six people work the ring.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "ADMIRAL SELENE VOSKUIJLEN-ADEYEMI (60s, silver crop, high collar) paces the center.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "COMMANDER RAMIRO OKONJO-TALLIS (40s, shaved head, burn scar on one cheek) taps at a console.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "DOCTOR YUKI HARTMANN-NWAFOR (30s, braids, lab coat) studies a spectrograph.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "ENGINEER BODHI LARSSON-EZE (20s, sleeveless jacket, goggles on his forehead) crouches under a panel.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "LIEUTENANT CASSANDRA MBEKI-FROST (30s, tight bun) monitors a bank of weather maps.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "And last, at a small console apart from the others, THE OBSERVER, an elderly man known only by his badge, watches without touching anything.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Report.", "name": "SELENE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Oxygen at eleven percent.", "name": "RAMIRO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Methane trace is falling.", "name": "YUKI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Pump six is slow.", "name": "BODHI", "speaker": 3, "ext": [], "paren": ["from under the panel"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Storm cell northeast. Forty minutes out.", "name": "CASSANDRA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Can the dome hold?", "name": "SELENE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "It's held worse.", "name": "BODHI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "That is not an answer.", "name": "SELENE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Yes, Admiral.", "name": "BODHI", "speaker": 3, "ext": [], "paren": ["emerging"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Station, this is Earth Control. Please confirm your count.", "name": "CONTROL", "speaker": 6, "ext": ["V.O."], "paren": ["over the speaker, filtered"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "Control, we confirm six souls.", "name": "SELENE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Six. Understood. Be advised, the board has questions about the Observer.", "name": "CONTROL", "speaker": 6, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "The Observer's head turns.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "Nobody else moves.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "Control, he has all clearances.", "name": "SELENE", "speaker": 0, "ext": [], "paren": ["to the speaker"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "It's not about clearances.", "name": "CONTROL", "speaker": 6, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "Then what is it about?", "name": "SELENE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "A long silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "Static.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "He was registered dead in 2091.", "name": "CONTROL", "speaker": 6, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "Every head turns toward the Observer.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "action", "text": "He smiles, an old, courteous smile, and stands, smoothing his badge.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "It was a clerical error.", "name": "THE OBSERVER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "Of course it was.", "name": "SELENE", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "Ramiro rises.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "Cassandra rises.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "Yuki drops her pen.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "Bodhi steps out from the panel and wipes his hands, slowly, on his trousers.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "I am sorry to have worried you. I am here only to watch.", "name": "THE OBSERVER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "Watch what?", "name": "SELENE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "dialogue", "text": "The part that comes after you.", "name": "THE OBSERVER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "Outside, the first thin line of storm cloud crosses the red horizon.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}]}