{"scene_id": "s00114", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00114.fountain", "heading": "INT. LAKESIDE BOATHOUSE BALLROOM - NIGHT", "cast": [{"id": 0, "name": "ELOWEN TREGARTHEN-ADEYEMI", "names": ["ELOWEN TREGARTHEN-ADEYEMI", "ELOWEN"], "gender": "f", "first": 7, "spoke": 13}, {"id": 1, "name": "ARTEMIS KOWALCZYK-MWANGI", "names": ["ARTEMIS KOWALCZYK-MWANGI", "ARTEMIS"], "gender": "?", "first": 8, "spoke": 10}, {"id": 2, "name": "LEONID BRAUNSTEIN-OKAFOR", "names": ["LEONID BRAUNSTEIN-OKAFOR", "LEONID"], "gender": "?", "first": 9, "spoke": 3}, {"id": 3, "name": "MIRABEL", "names": ["MIRABEL"], "gender": "?", "first": 10, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAKESIDE BOATHOUSE BALLROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A long timber hall on stilts above black water.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Faded bunting.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A chandelier with half its bulbs out.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Through tall windows, the lake lies glassy and still under a quarter moon.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A gramophone in the corner plays a thin, crackling waltz.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "Four people occupy the room, and only one of them is dancing.", "para": 1, "sent": 0, "present": []}, {"u": 7, "kind": "action", "text": "ELOWEN TREGARTHEN-ADEYEMI (30s, sea-green dress, bare shoulders) turns slowly in the center of the floor, alone, her eyes half closed.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "At the bar, ARTEMIS KOWALCZYK-MWANGI (30s, rolled-up shirt sleeves, a bottle in one hand) pours two glasses and pours a third.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "LEONID BRAUNSTEIN-OKAFOR (50s, dinner jacket, white gloves) stands near the gramophone with a hand on the horn, as if holding the music in place.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "And on the window seat, curled like a cat, sits a girl of eight, MIRABEL (small, in a nightgown, hair loose), who is not supposed to be awake.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "She spins.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "The hem of her dress sweeps the boards.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "She stops, breathless, and looks directly at him.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "You never asked me to dance.", "name": "ELOWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "He lowers the bottle.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "He does not answer.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "She walks toward him, slowly, leaving a track in the dust.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "I don't dance.", "name": "ARTEMIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "You did once.", "name": "ELOWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "That was a different year.", "name": "ARTEMIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "It was this year.", "name": "ELOWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Leonid clears his throat.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Both glance at him.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Perhaps I should adjust the record.", "name": "LEONID", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Leave it.", "name": "ELOWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "He lifts his hand from the horn, relieved.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Artemis puts down the bottle.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "He steps out from behind the bar.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "For a moment they stand a yard apart.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "The lake is still.", "name": "ARTEMIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "It always is, here.", "name": "ELOWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "That frightens me.", "name": "ARTEMIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Does it?", "name": "ELOWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "You don't know what's under it.", "name": "ARTEMIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "She smiles at that, the first smile of the night, and takes his hand.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "He lets her.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "She pulls him gently onto the floor, one arm round his shoulder, the other in his palm, and they sway to the gramophone's crooked waltz.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "At the window, Mirabel hugs her knees.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Lovely.", "name": "LEONID", "speaker": 2, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "He's going to cry.", "name": "MIRABEL", "speaker": 3, "ext": [], "paren": ["also softly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Who?", "name": "LEONID", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Him.", "name": "MIRABEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Leonid peers.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Artemis's face is turned to the dark window, jaw set, eyes bright.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "He does not cry.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Not yet.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "He holds her closer.", "para": 8, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "I couldn't stay.", "name": "ARTEMIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "I know.", "name": "ELOWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "I couldn't tell you why.", "name": "ARTEMIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "I know that too.", "name": "ELOWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "The record stutters.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Leonid lunges for the needle.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "The room goes still and quiet, and Elowen stops, her hand still in Artemis's, her eyes on his face.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Say it, then.", "name": "ELOWEN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Say what?", "name": "ARTEMIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "Whatever it is you came all this way to say.", "name": "ELOWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "He opens his mouth.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "Closes it.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "From the window seat comes the dry rustle of Mirabel unfolding, and then her small, bare feet on the boards, crossing the room, stopping beside them.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "He wants you to come back.", "name": "MIRABEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "Silence.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "Then the lake, at last, ripples, once, and a single bulb of the chandelier pops.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "Does he?", "name": "ELOWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "Yes.", "name": "ARTEMIS", "speaker": 1, "ext": [], "paren": ["barely"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "Elowen releases his hand.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "Steps back.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "She looks at the child, at Leonid, at the bottle on the bar, and then at Artemis again, and for a long moment says nothing at all.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "Then she slaps him.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "The crack rings through the hall.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "The gramophone, which Leonid has been holding down with both hands, begins, absurdly, to play again.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "Eleven years.", "name": "ELOWEN", "speaker": 0, "ext": [], "paren": ["trembling"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "I know.", "name": "ARTEMIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "dialogue", "text": "Eleven years, and you send a child.", "name": "ELOWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "dialogue", "text": "I wasn't sent. I came.", "name": "MIRABEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "Artemis laughs, a wet, helpless sound.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "Elowen turns away toward the dark windows, her back straight.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "action", "text": "Leonid, with great delicacy, picks up the third glass and offers it to her.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "action", "text": "She takes it.", "para": 14, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "action", "text": "She drinks it in one swallow.", "para": 14, "sent": 4, "present": [0, 1, 2, 3]}]}