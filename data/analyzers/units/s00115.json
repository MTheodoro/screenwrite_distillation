{"scene_id": "s00115", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00115.fountain", "heading": "INT. MOUNTAIN SKI-LIFT CHALET - NIGHT", "cast": [{"id": 0, "name": "ADELINA RUSSO-OKAFOR", "names": ["ADELINA RUSSO-OKAFOR", "ADELINA"], "gender": "f", "first": 6, "spoke": 8}, {"id": 1, "name": "HOLDEN MBEKI-FALK", "names": ["HOLDEN MBEKI-FALK", "HOLDEN"], "gender": "m", "first": 7, "spoke": 3}, {"id": 2, "name": "ROSEMARY PLUMMER-ASANTE", "names": ["ROSEMARY PLUMMER-ASANTE", "ROSEMARY"], "gender": "f", "first": 8, "spoke": 2}, {"id": 3, "name": "TEODORO BRANDT-NWOSU", "names": ["TEODORO BRANDT-NWOSU"], "gender": "?", "first": 9, "spoke": 0}, {"id": 4, "name": "MAN IN A GREY COAT", "names": ["MAN", "MAN IN A GREY COAT"], "gender": "?", "first": 10, "spoke": 11}, {"id": 5, "name": "GREY COAT", "names": ["GREY COAT"], "gender": "?", "first": 10, "spoke": 0}, {"id": 6, "name": "CALLUM", "names": ["CALLUM"], "gender": "?", "first": 49, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. MOUNTAIN SKI-LIFT CHALET - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A pine-paneled lodge, snow banked against the windows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fire in a stone hearth.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cracked leather sofa, a bar of antlers, a pot of mulled wine on the stove.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Five people.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "One is a stranger.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "ADELINA RUSSO-OKAFOR (30s, red scarf, cheeks wind-burned) kneels at the hearth, feeding the fire.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "HOLDEN MBEKI-FALK (30s, ski patrol jacket, radio at his shoulder) paces by the window.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "ROSEMARY PLUMMER-ASANTE (60s, lodge owner, tartan apron) ladles wine into mugs.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "TEODORO BRANDT-NWOSU (20s, snowboarder, one arm in a sling) sprawls on the sofa.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "And near the door, dripping, stands a MAN IN A GREY COAT (40s, no hat, snow in his eyebrows) who arrived ten minutes ago and has not given a name.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Wine, love?", "name": "ROSEMARY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Thank you.", "name": "MAN IN A GREY COAT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "He takes it.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "Does not drink.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Adelina watches him over her shoulder.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Where did you come from?", "name": "ADELINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Down the mountain.", "name": "MAN IN A GREY COAT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "The lift's been closed for hours.", "name": "ADELINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "I walked.", "name": "MAN IN A GREY COAT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "In this?", "name": "HOLDEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "It wasn't so bad.", "name": "MAN IN A GREY COAT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Teodoro whistles.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Rosemary exchanges a look with Holden.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "You'll be wanting a room.", "name": "ROSEMARY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "No. I'm only waiting.", "name": "MAN IN A GREY COAT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "For what?", "name": "HOLDEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "For her.", "name": "MAN IN A GREY COAT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "He nods at Adelina.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "She goes very still.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "The fire pops.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "I don't know you.", "name": "ADELINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "No.", "name": "MAN IN A GREY COAT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Then why--", "name": "ADELINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "I knew your sister.", "name": "MAN IN A GREY COAT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Rosemary lowers the ladle.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Teodoro sits up.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Holden's hand finds his radio.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "My sister died in the spring.", "name": "ADELINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "I know. I was there.", "name": "MAN IN A GREY COAT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Adelina stands, slowly.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Her scarf slides from her shoulders.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Holden steps between them, not hostile, but ready.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Sir, maybe you should sit down.", "name": "HOLDEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Of course.", "name": "MAN IN A GREY COAT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "He sits on the arm of the sofa.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "Teodoro shifts to make room, then thinks better of it and shifts back.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "Say your name.", "name": "ADELINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "Callum.", "name": "MAN IN A GREY COAT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "dialogue", "text": "Callum.", "name": "ADELINA", "speaker": 0, "ext": [], "paren": ["testing it"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "dialogue", "text": "She talked about you. Every day.", "name": "CALLUM", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "dialogue", "text": "That's not possible.", "name": "ADELINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "dialogue", "text": "She called you her lighthouse.", "name": "CALLUM", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "action", "text": "Adelina closes her eyes.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "action", "text": "The room holds its breath.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "action", "text": "Rosemary crosses herself.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "action", "text": "Holden's hand drops from the radio.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "dialogue", "text": "She wanted you to have this.", "name": "CALLUM", "speaker": 6, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 59, "kind": "action", "text": "He reaches into his coat and takes out a small, flat parcel wrapped in brown paper, tied with string.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 60, "kind": "action", "text": "He holds it out.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 61, "kind": "action", "text": "For a long moment, she doesn't take it.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 62, "kind": "action", "text": "Then she does.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}]}