{"scene_id": "s00116", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00116.fountain", "heading": "EXT. FIELD KITCHEN - FORWARD CAMP - DAWN", "cast": [{"id": 0, "name": "SERGEANT WILHELMINA OKORO-BRANDT", "names": ["SERGEANT WILHELMINA OKORO-BRANDT", "OKORO-BRANDT"], "gender": "f", "first": 4, "spoke": 9}, {"id": 1, "name": "PRIVATE LEOPOLDO ESCOBAR-TANAKA", "names": ["PRIVATE LEOPOLDO ESCOBAR-TANAKA", "ESCOBAR-TANAKA"], "gender": "?", "first": 5, "spoke": 6}, {"id": 2, "name": "CORPORAL ABEBE TEKLE-NORDSTROM", "names": ["CORPORAL ABEBE TEKLE-NORDSTROM", "TEKLE-NORDSTROM"], "gender": "m", "first": 6, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FIELD KITCHEN - FORWARD CAMP - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A canvas lean-to against a ruined stone wall.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A cauldron simmers over a fire.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Mud, mist, and the distant percussion of artillery that has gone on so long it has become weather.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SERGEANT WILHELMINA OKORO-BRANDT (40s, flour on her sleeves) stirs a pot with a wooden paddle.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "PRIVATE LEOPOLDO ESCOBAR-TANAKA (19, helmet pushed back, mud to the knee) sits on an upturned bucket peeling potatoes.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "CORPORAL ABEBE TEKLE-NORDSTROM (30s, bandaged hand, cigarette behind one ear) leans on the wall with a tin cup.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Nobody speaks.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "A shell lands, far off.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "The pot shivers.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "More salt.", "name": "OKORO-BRANDT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "We're out.", "name": "ESCOBAR-TANAKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Then less water.", "name": "OKORO-BRANDT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "We're out of that too.", "name": "ESCOBAR-TANAKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "She keeps stirring.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Tekle-Nordstrom takes the cigarette from behind his ear, looks at it, puts it back.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Rumor says the line moves tomorrow.", "name": "TEKLE-NORDSTROM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Rumor says.", "name": "OKORO-BRANDT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "You don't believe it?", "name": "TEKLE-NORDSTROM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I believe the potatoes.", "name": "OKORO-BRANDT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Escobar-Tanaka drops a peel into a bucket.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Picks up another potato.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Does not peel it.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Sergeant.", "name": "ESCOBAR-TANAKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Private.", "name": "OKORO-BRANDT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Is it all right if I write home?", "name": "ESCOBAR-TANAKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "You may.", "name": "OKORO-BRANDT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "What do I say?", "name": "ESCOBAR-TANAKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "That the soup's good.", "name": "OKORO-BRANDT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Is it?", "name": "ESCOBAR-TANAKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "She tastes from the paddle.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Chews.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Considers.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "No.", "name": "OKORO-BRANDT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Tekle-Nordstrom laughs once, quietly, into his cup.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Escobar-Tanaka looks from one to the other and smiles for the first time in days.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "She hands him a bowl.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Eat.", "name": "OKORO-BRANDT", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "He eats.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "A shell lands, closer.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "The pot rattles.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Nobody looks up.", "para": 7, "sent": 3, "present": [0, 1, 2]}]}