{"scene_id": "s00117", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00117.fountain", "heading": "INT. GRAND HOTEL ICE-SCULPTURE WORKSHOP - NIGHT", "cast": [{"id": 0, "name": "FELICITY AMADI-STR", "names": ["FELICITY AMADI-STR", "FELICITY"], "gender": "f", "first": 4, "spoke": 13}, {"id": 1, "name": "BARNABAS OKONKWO-REYES", "names": ["BARNABAS OKONKWO-REYES", "BARNABAS"], "gender": "?", "first": 5, "spoke": 10}, {"id": 2, "name": "DESMOND ACHEBE-LINDGREN", "names": ["DESMOND ACHEBE-LINDGREN", "DESMOND"], "gender": "?", "first": 32, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRAND HOTEL ICE-SCULPTURE WORKSHOP - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A walk-in freezer converted to a studio.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Frost on every surface.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A half-carved swan stands on a plinth, a chainsaw hangs from a hook, and a work lamp throws a cold blue circle on the floor.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "FELICITY AMADI-STR\u00d6M (30s, parka, ski goggles) crouches at the base of the swan, a chisel in her glove.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "BARNABAS OKONKWO-REYES (40s, wool hat, breath fogging) holds the lamp steady.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "They work in silence, whispering only when necessary.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Left a bit.", "name": "FELICITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "This is left.", "name": "BARNABAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Your left.", "name": "FELICITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "It's my left.", "name": "BARNABAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Mine, then.", "name": "FELICITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He sighs.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Shifts the lamp.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "The beam slides across the ice, and inside the swan's translucent belly, a dark shape appears.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "There.", "name": "FELICITY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "You're sure?", "name": "BARNABAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Fifteen pounds of platinum. Frozen in solid.", "name": "FELICITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Why would anyone put it in a swan?", "name": "BARNABAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Because no one chisels a swan.", "name": "FELICITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "We're chiseling a swan.", "name": "BARNABAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "We're not anyone.", "name": "FELICITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "She taps the ice with the chisel.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "A crack travels along the neck.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Barnabas winces.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Careful.", "name": "BARNABAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "It's only a swan.", "name": "FELICITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "It's a swan worth four thousand dollars, and the gala is tomorrow.", "name": "BARNABAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Then we'll leave them a duck.", "name": "FELICITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "The freezer door clanks.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "They freeze.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "A figure enters.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "DESMOND ACHEBE-LINDGREN (50s, executive chef, whites under a long coat) stops just inside, studying the swan, then them.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Evening.", "name": "DESMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Evening, Chef.", "name": "FELICITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "We were just finishing.", "name": "BARNABAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "At two a.m.?", "name": "DESMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Inspiration.", "name": "FELICITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "It is a very good swan.", "name": "DESMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Thank you.", "name": "BARNABAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "It would be a better swan with its belly intact.", "name": "DESMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "A pause.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Desmond crosses to the chainsaw and lifts it off the hook, casually, like a man picking up a ladle.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Chef, we can explain.", "name": "FELICITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "I would hope so.", "name": "DESMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "It was Felicity's idea.", "name": "BARNABAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "It was not!", "name": "FELICITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "It was mine, actually.", "name": "DESMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "They stare at him.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "I froze the platinum in. Sixteen years ago. You are both very late.", "name": "DESMOND", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "He smiles, a long, slow, wolfish smile, and pulls the cord.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "The chainsaw roars.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Felicity and Barnabas leap backward, and the swan, quivering, begins to crack from the neck down.", "para": 8, "sent": 2, "present": [0, 1, 2]}]}