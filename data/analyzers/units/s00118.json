{"scene_id": "s00118", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00118.fountain", "heading": "INT. APOTHECARY SHOP - EVENING - 1794", "cast": [{"id": 0, "name": "MASTER EZEKIEL ARTHURSEN-OKAFOR", "names": ["MASTER EZEKIEL ARTHURSEN-OKAFOR", "EZEKIEL"], "gender": "m", "first": 5, "spoke": 8}, {"id": 1, "name": "YOUNG PHILIPPA BRANDT-NWOSU", "names": ["YOUNG PHILIPPA BRANDT-NWOSU"], "gender": "m", "first": 7, "spoke": 0}, {"id": 2, "name": "MADAME ODETTE LACROIX-ADEYEMI", "names": ["MADAME ODETTE LACROIX-ADEYEMI"], "gender": "?", "first": 8, "spoke": 0}, {"id": 3, "name": "CONSTABLE HENDRICK VAN DER MEER-OLUWA", "names": ["CONSTABLE HENDRICK VAN DER MEER-OLUWA", "HENDRICK"], "gender": "?", "first": 9, "spoke": 12}, {"id": 4, "name": "MADAME LACROIX", "names": ["MADAME LACROIX"], "gender": "?", "first": 8, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. APOTHECARY SHOP - EVENING - 1794", "present": []}, {"u": 1, "kind": "action", "text": "Shelves of blue glass bottles.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dried herbs hang from the rafters.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A brass scale.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Low light from a single oil lamp, and a wet street beyond the bowed windows.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MASTER EZEKIEL ARTHURSEN-OKAFOR, the apothecary, grinds powder in a mortar behind the counter.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "He is stout and gentle, with spectacles pushed up on his forehead.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "His apprentice, YOUNG PHILIPPA BRANDT-NWOSU, no more than sixteen, sweeps the floor.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "At a small table by the window, MADAME ODETTE LACROIX-ADEYEMI, a widow in black silk, sits with a cup of tea she has not touched.", "para": 1, "sent": 3, "present": [0, 1, 2, 4]}, {"u": 9, "kind": "action", "text": "And by the door, snow on his hat, stands CONSTABLE HENDRICK VAN DER MEER-OLUWA, huge and slow, a lantern at his belt.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "He nods to the apothecary.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "The apothecary nods back.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Constable.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Master Arthursen.", "name": "HENDRICK", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Tea?", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Thank you, no.", "name": "HENDRICK", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "He remains by the door.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Philippa sweeps around his boots.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Madame Lacroix stirs her cup, the spoon clinking against the china.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "You are out late.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "It's a cold night.", "name": "HENDRICK", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "It is.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "There was a death on Pearl Street.", "name": "HENDRICK", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Ezekiel does not stop grinding.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Philippa's broom pauses a fraction of a second, then continues.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Terrible.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "A gentleman. Sixty years. Found in his chair.", "name": "HENDRICK", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Terrible.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "His wife says he took a draught for the cough.", "name": "HENDRICK", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Ezekiel sets the pestle down.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Many do.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "From this shop.", "name": "HENDRICK", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Madame Lacroix lifts her gaze from the cup.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Her eyes find the constable, then the apothecary, then the floor.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Ezekiel wipes his hands on his apron.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "I make no poisons, Constable.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "I did not say poison.", "name": "HENDRICK", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "A pause.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "The lamp flickers.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Philippa stands completely still.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Madame Lacroix sets the cup on its saucer, with extraordinary gentleness.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "I believe I can help.", "name": "MADAME LACROIX", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Madame?", "name": "HENDRICK", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "It was my husband.", "name": "MADAME LACROIX", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Hendrick turns, slowly.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Ezekiel stops breathing.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Philippa lets the broom fall.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "The draught was mine. I mixed it. I brought him the cup.", "name": "MADAME LACROIX", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Madame, you cannot--", "name": "HENDRICK", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "I can. I did.", "name": "MADAME LACROIX", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "She rises, smooths her black silk, and crosses to the constable.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "She offers him her wrists.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "He looks at them.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "He does not take them.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "I should like to hear why.", "name": "HENDRICK", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "You would not.", "name": "MADAME LACROIX", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Try me.", "name": "HENDRICK", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "She considers.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Then she sits again.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "The constable removes his hat.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "Ezekiel pours two cups of tea.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "In the corner, Philippa picks up the broom, and under the old oil lamp, with the snow falling in the street outside, the widow begins to speak.", "para": 10, "sent": 4, "present": [0, 1, 2, 3, 4]}]}