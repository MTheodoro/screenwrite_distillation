{"scene_id": "s00119", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00119.fountain", "heading": "INT. BAKERY DELIVERY TRUCK - CARGO AREA - PRE-DAWN", "cast": [{"id": 0, "name": "MARI", "names": ["MARI"], "gender": "?", "first": 6, "spoke": 10}, {"id": 1, "name": "BENNETT-OKORO", "names": ["BENNETT-OKORO"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "HECTOR DELACROIX-ASANTE", "names": ["HECTOR DELACROIX-ASANTE", "HECTOR"], "gender": "?", "first": 7, "spoke": 7}, {"id": 3, "name": "PRIYA RAMASWAMY-LINDQVIST", "names": ["PRIYA RAMASWAMY-LINDQVIST", "PRIYA"], "gender": "f", "first": 8, "spoke": 5}, {"id": 4, "name": "THE STRANGER", "names": ["STRANGER", "THE STRANGER"], "gender": "m", "first": 4, "spoke": 5}, {"id": 5, "name": "JULIAN", "names": ["JULIAN"], "gender": "?", "first": 43, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. BAKERY DELIVERY TRUCK - CARGO AREA - PRE-DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Steel racks of bread trays.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Flour hangs in the air.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single dome light.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The truck rocks gently over a country road.", "para": 0, "sent": 3, "present": [4]}, {"u": 5, "kind": "action", "text": "Three crew members and a stranger sit among the loaves.", "para": 1, "sent": 0, "present": [4]}, {"u": 6, "kind": "action", "text": "MARISOL \"MARI\" BENNETT-OKORO (30s, flour-dusted overalls, driver's cap) kneels in the aisle with a wrench.", "para": 2, "sent": 0, "present": [0, 1, 4]}, {"u": 7, "kind": "action", "text": "HECTOR DELACROIX-ASANTE (40s, forearms like hams, a neat moustache) sorts baguettes into bags.", "para": 2, "sent": 1, "present": [0, 1, 2, 4]}, {"u": 8, "kind": "action", "text": "PRIYA RAMASWAMY-LINDQVIST (20s, hairnet, earbuds) counts a stack of invoices.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "And in the corner, wedged between two racks with a bakery apron over his suit, sits THE STRANGER (50s, polished shoes, a briefcase handcuffed to his wrist).", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Radio check.", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "One.", "name": "PRIYA", "speaker": 3, "ext": [], "paren": ["into collar"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Two.", "name": "HECTOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Three. Stranger?", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "I'm not on the radio.", "name": "THE STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "You're on now.", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "I'm a delivery.", "name": "THE STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Pastry delivery.", "name": "HECTOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Very funny.", "name": "THE STRANGER", "speaker": 4, "ext": [], "paren": ["wearily"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "He tugs at the handcuff.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "It doesn't give.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Priya pulls out an earbud.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "How long do we hold him?", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Until the bank opens.", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "That's four hours.", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "So we'll have fresh bread.", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Hector chuckles.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "The truck turns onto gravel.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Loaves shift.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "The stranger lowers his head.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "You know I can pay.", "name": "THE STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Everybody can pay.", "name": "HECTOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Double what they're giving you.", "name": "THE STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "That's what they all say.", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Is it a lot?", "name": "PRIYA", "speaker": 3, "ext": [], "paren": ["low, to Mari"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Not enough.", "name": "MARI", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Hector pushes aside a tray to reach the stranger's briefcase.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "The man jerks it away.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Hector slaps the man's wrist, once, and the case springs open.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Inside, a silver dossier.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Hector flips it open.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Mari.", "name": "HECTOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "What.", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "His name is Julian Ashworth-Mbeki.", "name": "HECTOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Marisol freezes.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Priya drops her invoices.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "The stranger lifts his chin.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "His face, in the dome light, is perfectly composed.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "That is my name.", "name": "JULIAN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "You're the auditor.", "name": "MARI", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "I am.", "name": "JULIAN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "Hector, we grabbed the wrong man.", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "We grabbed the right man.", "name": "HECTOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "He's the auditor!", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "The auditor with the files.", "name": "HECTOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "They look at each other.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "Julian smiles.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "The truck bounces over a pothole and a tray of croissants slides off its rack and scatters across the floor.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "dialogue", "text": "Well. Shall we eat?", "name": "JULIAN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}