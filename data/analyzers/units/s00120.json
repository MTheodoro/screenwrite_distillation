{"scene_id": "s00120", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00120.fountain", "heading": "INT. FUNICULAR STATION - OPERATOR'S BOOTH - NIGHT", "cast": [{"id": 0, "name": "ODALYS VANTERPOOL", "names": ["ODALYS VANTERPOOL", "ODALYS"], "gender": "?", "first": 4, "spoke": 20}], "units": [{"u": 0, "kind": "heading", "text": "INT. FUNICULAR STATION - OPERATOR'S BOOTH - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Sodium light.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rain on tin.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A brass lever the size of a forearm.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ODALYS VANTERPOOL, 40s, wet wool coat, hair pinned too tight.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She has a cassette recorder.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "She sets it on the control desk.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "Presses PLAY.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "dialogue", "text": "If you're hearing this, I'm already on the car.", "name": "ODALYS", "speaker": 0, "ext": ["V.O."], "paren": ["tape, hiss"], "dual": false, "present": [0]}, {"u": 9, "kind": "dialogue", "text": "I know.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 10, "kind": "dialogue", "text": "Don't talk to the tape, Odalys. You hate it when people talk to the tape.", "name": "ODALYS", "speaker": 0, "ext": ["V.O."], "paren": ["tape"], "dual": false, "present": [0]}, {"u": 11, "kind": "dialogue", "text": "Then stop being so sure of me.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 12, "kind": "dialogue", "text": "Three days. That's how long I watched the ledger. Three days of numbers that didn't breathe right.", "name": "ODALYS", "speaker": 0, "ext": ["V.O."], "paren": ["tape"], "dual": false, "present": [0]}, {"u": 13, "kind": "dialogue", "text": "You said nobody would check the cable inspections.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 14, "kind": "dialogue", "text": "Nobody did. That was the point. Brakes on the upper car were signed off in March. By a man who died in January.", "name": "ODALYS", "speaker": 0, "ext": ["V.O."], "paren": ["tape"], "dual": false, "present": [0]}, {"u": 15, "kind": "dialogue", "text": "Say it plainer.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 16, "kind": "dialogue", "text": "The upper car won't hold on the grade. Not with a full load. Not tonight.", "name": "ODALYS", "speaker": 0, "ext": ["V.O."], "paren": ["tape"], "dual": false, "present": [0]}, {"u": 17, "kind": "dialogue", "text": "There's no load. It's midnight.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 18, "kind": "dialogue", "text": "There's a load. Look at the window.", "name": "ODALYS", "speaker": 0, "ext": ["V.O."], "paren": ["tape"], "dual": false, "present": [0]}, {"u": 19, "kind": "action", "text": "She doesn't look.", "para": 3, "sent": 0, "present": [0]}, {"u": 20, "kind": "dialogue", "text": "I'm not looking.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 21, "kind": "dialogue", "text": "Look.", "name": "ODALYS", "speaker": 0, "ext": ["V.O."], "paren": ["tape"], "dual": false, "present": [0]}, {"u": 22, "kind": "action", "text": "Lights.", "para": 4, "sent": 0, "present": [0]}, {"u": 23, "kind": "action", "text": "Halfway up the mountain.", "para": 4, "sent": 1, "present": [0]}, {"u": 24, "kind": "action", "text": "A car, lit yellow, climbing.", "para": 4, "sent": 2, "present": [0]}, {"u": 25, "kind": "dialogue", "text": "Who's on it?", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 26, "kind": "dialogue", "text": "The board. All nine. The anniversary ride. You booked it.", "name": "ODALYS", "speaker": 0, "ext": ["V.O."], "paren": ["tape"], "dual": false, "present": [0]}, {"u": 27, "kind": "dialogue", "text": "I booked it.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 28, "kind": "dialogue", "text": "You booked it so I couldn't stop it.", "name": "ODALYS", "speaker": 0, "ext": ["V.O."], "paren": ["tape"], "dual": false, "present": [0]}, {"u": 29, "kind": "action", "text": "Her hand finds the lever.", "para": 5, "sent": 0, "present": [0]}, {"u": 30, "kind": "action", "text": "Cold brass.", "para": 5, "sent": 1, "present": [0]}, {"u": 31, "kind": "dialogue", "text": "Then why leave a tape?", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 32, "kind": "dialogue", "text": "Because you'll want to pull it. And you'll want to know why you didn't.", "name": "ODALYS", "speaker": 0, "ext": ["V.O."], "paren": ["tape, softer"], "dual": false, "present": [0]}, {"u": 33, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0]}, {"u": 34, "kind": "action", "text": "The tape hisses.", "para": 6, "sent": 1, "present": [0]}, {"u": 35, "kind": "action", "text": "Rain.", "para": 6, "sent": 2, "present": [0]}, {"u": 36, "kind": "action", "text": "The car crests the grade.", "para": 7, "sent": 0, "present": [0]}, {"u": 37, "kind": "dialogue", "text": "Forgive me.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 38, "kind": "action", "text": "She pulls the lever.", "para": 8, "sent": 0, "present": [0]}, {"u": 39, "kind": "action", "text": "A shriek of steel from the dark.", "para": 9, "sent": 0, "present": [0]}, {"u": 40, "kind": "action", "text": "Then a flash, white, enormous, the whole mountain jumping.", "para": 9, "sent": 1, "present": [0]}, {"u": 41, "kind": "action", "text": "The window blows in.", "para": 10, "sent": 0, "present": [0]}]}