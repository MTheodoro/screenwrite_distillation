{"scene_id": "s00121", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00121.fountain", "heading": "INT. DRIVE-IN PROJECTION BOOTH - NIGHT", "cast": [{"id": 0, "name": "PIA CALLOWAY", "names": ["PIA CALLOWAY", "PIA"], "gender": "f", "first": 3, "spoke": 7}, {"id": 1, "name": "WENDELL OYELARAN", "names": ["WENDELL OYELARAN", "WENDELL"], "gender": "m", "first": 4, "spoke": 8}, {"id": 2, "name": "INTERCOM", "names": ["INTERCOM"], "gender": "?", "first": 13, "spoke": 0}, {"id": 3, "name": "MRS. DUBOIS", "names": ["MRS. DUBOIS"], "gender": "?", "first": 14, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRIVE-IN PROJECTION BOOTH - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped room of hot metal and film smell.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Two projectors rattle in unison, throwing twin beams through small square windows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "PIA CALLOWAY, 16, in her father's oversized work shirt, threads a reel with quick, careful hands.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "Beside her, WENDELL OYELARAN, 17, holds a flashlight and a paper sack of popcorn he has no intention of sharing.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "He peers over her shoulder.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "She swats him away without looking.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "You're holding it wrong.", "name": "WENDELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "I've held it a hundred times.", "name": "PIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Holding it wrong a hundred times.", "name": "WENDELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She grins in spite of herself, then locks the gate.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "The projector sings.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "A faint cheer drifts up from the cars below.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "An INTERCOM crackles on the wall.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Pia, honey, reel two's late. Cars are honking.", "name": "MRS. DUBOIS", "speaker": 3, "ext": ["O.S."], "paren": ["intercom"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Coming up, Mrs. Dubois. Ninety seconds.", "name": "PIA", "speaker": 0, "ext": [], "paren": ["to the intercom"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Ninety seconds is how long the Hendersons will wait before they ask for their dollar back.", "name": "MRS. DUBOIS", "speaker": 3, "ext": ["O.S."], "paren": ["intercom"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "She lets go of the button and turns, flustered.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "He is already holding out the second reel like a dinner plate.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Ninety seconds. I'll count.", "name": "WENDELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "You'll count wrong.", "name": "PIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Then count with me.", "name": "WENDELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "She takes the reel.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "He leans in, shoulder to shoulder, so close their flashlights tangle.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "She does not move away.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Wend. If this goes wrong, my dad will fire me.", "name": "PIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "It's your dad's booth.", "name": "WENDELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "That's why.", "name": "PIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Together they thread.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "The leader slips through the rollers, sprockets bite, and she tightens her jaw and he quiets his breathing, both of them staring at the same sliver of film.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Sixty seconds.", "name": "MRS. DUBOIS", "speaker": 3, "ext": ["O.S."], "paren": ["intercom"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "We know!", "name": "PIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "We know!", "name": "WENDELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "The changeover cue flashes in the corner of the screen.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "She thumbs the switch.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "The first projector dies.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "The second blazes.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Below, the cars cheer.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "She exhales.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "He laughs.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "They stand there, shaking, two kids on top of the world.", "para": 9, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Best job in the county.", "name": "WENDELL", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Worst pay.", "name": "PIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Best view.", "name": "WENDELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "She looks at him.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "He is looking at the screen.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "On the glass, the light of the film flickers across both faces.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}]}