{"scene_id": "s00124", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00124.fountain", "heading": "INT. LAMPLIGHTERS' DEPOT - DAWN - 1887", "cast": [{"id": 0, "name": "HOBART PRYCE", "names": ["HOBART PRYCE", "PRYCE"], "gender": "m", "first": 5, "spoke": 9}, {"id": 1, "name": "TESS MALLORY", "names": ["TESS MALLORY", "TESS"], "gender": "f", "first": 6, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAMPLIGHTERS' DEPOT - DAWN - 1887", "present": []}, {"u": 1, "kind": "action", "text": "Brass poles hang from iron hooks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Ladders.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Oil cans.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A coke stove ticking.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "HOBART PRYCE, 50s, ash-grey beard, sits on an overturned crate mending a wick-trimmer.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across from him, young TESS MALLORY, 19, boots too large, sorts spent matches into a tin.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Neither speaks.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "A church bell somewhere.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Six strokes.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Poles.", "name": "PRYCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Tess lifts two from the rack.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Hands one over.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He tests the weight.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Nods.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Gaslight's out on Fenwick Row.", "name": "PRYCE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Again?", "name": "TESS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Again.", "name": "PRYCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "They pull on coats.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Tess drops the tin.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Matches scatter across the boards.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "They both kneel and snatch at them, knocking heads.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Sorry.", "name": "TESS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Mind the sulphur.", "name": "PRYCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "The door bangs open.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Wind.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Running feet outside.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Both freeze, poles half raised.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Dogs?", "name": "TESS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Constables.", "name": "PRYCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "They glance at the window.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Blue coats pass.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "The street goes quiet.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Both exhale.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "They're after the Quigley lot.", "name": "PRYCE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Not us.", "name": "TESS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Never us. We carry fire. Nobody arrests the man with fire.", "name": "PRYCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "He grins.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "She almost does.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "They step into the street.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "The sky is the color of dishwater.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Tess lifts her pole to the first lamp.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Pryce lifts his to the second.", "para": 10, "sent": 3, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "Two small flames bloom in the grey.", "para": 10, "sent": 4, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Mr. Pryce?", "name": "TESS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Aye.", "name": "PRYCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "What happens when they light themselves?", "name": "TESS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Then we find something else to carry.", "name": "PRYCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "They move on up the row, side by side, one lamp, then the next.", "para": 11, "sent": 0, "present": [0, 1]}]}