{"scene_id": "s00128", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00128.fountain", "heading": "INT. CURLING CLUB - DAWN", "cast": [{"id": 0, "name": "COACH GREER WALLENBERG", "names": ["COACH GREER WALLENBERG", "GREER"], "gender": "?", "first": 3, "spoke": 5}, {"id": 1, "name": "STRANGER", "names": ["STRANGER"], "gender": "f", "first": 4, "spoke": 4}, {"id": 2, "name": "MARGIT", "names": ["MARGIT"], "gender": "?", "first": 21, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. CURLING CLUB - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Empty ice, grey-blue under the rafters.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A frost-fogged scoreboard.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "COACH GREER WALLENBERG, 50s, thermos in hand, walks the sheet checking pebble, shoulders tight, a man with a final tomorrow.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "A STRANGER stands at the rail, an elderly woman in a green scarf, hands tucked in her sleeves.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "She has slipped in out of the cold.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "He sees her.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He stops.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Rink's closed, ma'am.", "name": "GREER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "So is the door you came through.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He glances back.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "It is.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He turns again, wary, and she steps onto the ice in soft shoes, steady as if she has done it all her life.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Who let you in?", "name": "GREER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Nobody. I'm just early.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She stops beside a stone and nudges it with her toe.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He bristles.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "That's the championship stone.", "name": "GREER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "It pulls left. You know it does.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He says nothing.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She smiles.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Margit Lindqvist. I won this club's first trophy in 1961.", "name": "STRANGER", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Greer. I coach the rink that wants the next one.", "name": "GREER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Then listen, Greer. You grind that stone on the left side, and your girls will thank you tomorrow.", "name": "MARGIT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "He stares at her, then at the stone.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "He crouches, runs a thumb along the running band.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "A burr.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Small.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Real.", "para": 6, "sent": 4, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "How did you know?", "name": "GREER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "It pulled left in 1961, too.", "name": "MARGIT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "He looks up.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "She has already turned for the door, scarf trailing, leaving a line of small wet prints on the ice.", "para": 7, "sent": 1, "present": [0, 1, 2]}]}