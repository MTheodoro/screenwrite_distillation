{"scene_id": "s00129", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00129.fountain", "heading": "INT. ST. CASIMIR LANES - CONVERTED CHURCH - NIGHT", "cast": [{"id": 0, "name": "ROSALIND PARKHURST", "names": ["ROSALIND PARKHURST", "ROSALIND"], "gender": "m", "first": 7, "spoke": 8}, {"id": 1, "name": "DEACON PARKHURST", "names": ["DEACON PARKHURST", "DEACON"], "gender": "m", "first": 7, "spoke": 9}, {"id": 2, "name": "NADINE FOLASADE", "names": ["NADINE FOLASADE", "NADINE"], "gender": "f", "first": 10, "spoke": 7}, {"id": 3, "name": "GUS TREVELYAN", "names": ["GUS TREVELYAN", "GUS"], "gender": "?", "first": 11, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. ST. CASIMIR LANES - CONVERTED CHURCH - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A nave of oiled maple lanes where the pews once stood.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Stained glass glows behind the pin decks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The league scoreboard hangs where the crucifix used to be.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Four men and women sit at the last lane in the last frame of the season.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "No one is cheering.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "The place is nearly empty.", "para": 1, "sent": 2, "present": []}, {"u": 7, "kind": "action", "text": "ROSALIND PARKHURST, 60s, cardigan, bowling shoes polished like church shoes, wipes her ball with a towel.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Beside her, her son DEACON PARKHURST, 30s, sits with his elbows on his knees, staring at his phone without reading it.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Across the lane sit their opponents.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "NADINE FOLASADE, 40s, braids tied back, rolls her shoulders.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Next to her, an old man in a bowling shirt, GUS TREVELYAN, 70s, tape on two fingers, a cigarette unlit between them.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "The pin deck resets with a long mechanical groan.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Your father used to say the pins knew.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Knew what?", "name": "DEACON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Whether you wanted it.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Deacon puts the phone away.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Mom, it's a Tuesday.", "name": "DEACON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "It's the Tuesday.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Nadine gets up.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Walks to the ball return.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Picks up a green ball.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Weighs it.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Puts it back.", "para": 6, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Picks up a blue one.", "para": 6, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "You boys have been on our lane too long.", "name": "NADINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Twelve years.", "name": "GUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Twelve years, and nobody has said a word.", "name": "NADINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Because there was nothing to say.", "name": "GUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "There was plenty.", "name": "NADINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Deacon looks at his mother.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Rosalind does not look at him.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Is there something I should know?", "name": "DEACON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Take your turn.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "I'm asking.", "name": "DEACON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Take your turn, Deacon.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "He stands.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Picks his ball.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Steps to the line.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Pauses.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Dad used to bring us here Sundays.", "name": "DEACON", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Your dad used to bring a lot of people here Sundays.", "name": "GUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Deacon turns.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Nadine has gone very still.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Rosalind has put the towel down.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Gus.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Might as well. Twelve years is long enough.", "name": "GUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Don't.", "name": "NADINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Your father had two families, son. This lane was where they met without knowing.", "name": "GUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Say that again.", "name": "DEACON", "speaker": 1, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "I've been polite twelve years.", "name": "GUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Gus, shut your mouth.", "name": "NADINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "He's not lying.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Deacon looks at the ball in his hands.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "His grip tightens.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "The leather creaks.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Nadine?", "name": "DEACON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "Your father was my father too.", "name": "NADINE", "speaker": 2, "ext": [], "paren": ["evenly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "A long silence.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "Somewhere in the rafters a pigeon shifts.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "Deacon sets the ball down.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "It rolls, slow, down the lane, crosses the arrows, kisses the head pin, and drops all ten.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "Nobody looks at the scoreboard.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "Strike.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "Your game.", "name": "NADINE", "speaker": 2, "ext": [], "paren": ["not smiling"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "Why tonight?", "name": "DEACON", "speaker": 1, "ext": [], "paren": ["turning to Gus"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "Because it's the last frame, son. After tonight there's no lane to share.", "name": "GUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "Deacon walks away from the line.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "He passes his mother.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "He passes Nadine.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "He stops at the end of the lane, where the stained glass throws red light across his hands.", "para": 14, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "He picks up the blue ball.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "action", "text": "Holds it out to Nadine.", "para": 15, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "Roll one.", "name": "DEACON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "She hesitates.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "Then she takes it.", "para": 16, "sent": 1, "present": [0, 1, 2, 3]}]}