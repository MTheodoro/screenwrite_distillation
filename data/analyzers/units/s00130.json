{"scene_id": "s00130", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00130.fountain", "heading": "INT. MONASTERY BELL TOWER - DAWN", "cast": [{"id": 0, "name": "SERGEANT IGNATIUS OBUYA", "names": ["SERGEANT IGNATIUS OBUYA", "OBUYA"], "gender": "m", "first": 5, "spoke": 9}, {"id": 1, "name": "PRIVATE TOBIAS WREN", "names": ["PRIVATE TOBIAS WREN", "WREN"], "gender": "m", "first": 6, "spoke": 6}, {"id": 2, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 7, "spoke": 1}, {"id": 3, "name": "ANSELM", "names": ["ANSELM"], "gender": "?", "first": 15, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. MONASTERY BELL TOWER - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Narrow stone stair, spiraling up into dark.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "At the top: a square chamber, open arches on four sides, a great bronze bell hanging dead still.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Fog beyond the arches.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Below, somewhere, artillery coughs.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SERGEANT IGNATIUS OBUYA, 30s, mud to the knees, rifle slung, wedges himself behind a pillar.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Behind him, PRIVATE TOBIAS WREN, 19, shaking hands, a field radio strapped to his back.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "A STRANGER crouches in the corner.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Gaunt.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Brown habit, rope belt, bare feet.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "He has been there all night.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Who's that?", "name": "OBUYA", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Monk, I think.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "You speak English?", "name": "OBUYA", "speaker": 0, "ext": [], "paren": ["to the Stranger"], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "The Stranger nods, once.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Some. Brother Anselm.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Brother, you can't be up here.", "name": "OBUYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "I have rung this bell every dawn for thirty years.", "name": "ANSELM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Another shell.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "The tower shudders.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Dust falls.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Sarge, the ridge is full of them.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Count.", "name": "OBUYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Forty. Fifty.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Radio. Tell battalion we're in position.", "name": "OBUYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Wren fumbles with the handset.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Static.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Nothing.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Dead.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Then we hold.", "name": "OBUYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Anselm stands.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "He looks at Obuya.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Points to the bell, then to himself.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "They will hear it. They always stop.", "name": "ANSELM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Brother, if you ring that, they'll know exactly where we are.", "name": "OBUYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "They know already.", "name": "ANSELM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "He lifts the rope and tugs once.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "A single, enormous BONG.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "No!", "name": "OBUYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Anselm rings it again.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "And again.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "The tower hums with it.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Below, in the fog, the guns fall silent.", "para": 10, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Wren stares through the arch.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "They're stopping.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "What?", "name": "OBUYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "They're taking their hats off.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Obuya lowers his rifle.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Anselm keeps ringing.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Behind him, the sun breaks through the fog like a struck match.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}]}