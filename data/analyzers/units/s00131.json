{"scene_id": "s00131", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00131.fountain", "heading": "INT. HOTEL SERVICE ELEVATOR - DAY", "cast": [{"id": 0, "name": "CHEF BASILE ORTEGA", "names": ["CHEF BASILE ORTEGA", "BASILE"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "SHANICE DORSEY", "names": ["SHANICE DORSEY", "SHANICE"], "gender": "?", "first": 5, "spoke": 5}, {"id": 2, "name": "UNCLE VITO PALAZZO", "names": ["UNCLE VITO PALAZZO", "VITO"], "gender": "?", "first": 6, "spoke": 4}, {"id": 3, "name": "DEV RAMASWAMY", "names": ["DEV RAMASWAMY", "DEV"], "gender": "?", "first": 7, "spoke": 3}, {"id": 4, "name": "TILDA BJORKLUND", "names": ["TILDA BJORKLUND", "TILDA"], "gender": "?", "first": 8, "spoke": 5}, {"id": 5, "name": "BRIDE", "names": ["BRIDE"], "gender": "?", "first": 9, "spoke": 0}, {"id": 6, "name": "MOIRA KENNEDY", "names": ["MOIRA KENNEDY", "MOIRA"], "gender": "?", "first": 9, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOTEL SERVICE ELEVATOR - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A stainless box, too small.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A three-tier wedding cake on a rolling cart takes up most of it.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Six people squeeze around it.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CHEF BASILE ORTEGA, 50s, apron, sweat.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "SHANICE DORSEY, 20s, bridal planner, clipboard.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "UNCLE VITO PALAZZO, 60s, tuxedo, too tight.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "DEV RAMASWAMY, 20s, the photographer, camera bag.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "TILDA BJORKLUND, 30s, bridesmaid in a puffy teal gown.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "And the BRIDE herself, MOIRA KENNEDY, 28, in a veil, eyes closed, breathing slow.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "action", "text": "The elevator jolts.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "action", "text": "Stops.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "action", "text": "The lights flicker.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "Oh no.", "name": "TILDA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "It's fine. It's a service elevator. They stall.", "name": "SHANICE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "Stall! Cake, madame, is made of stall!", "name": "BASILE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "Somebody push the button.", "name": "VITO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "I'm pushing it.", "name": "DEV", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "Don't push it, it's the alarm.", "name": "SHANICE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "Everything is the alarm!", "name": "TILDA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "Everybody stop.", "name": "MOIRA", "speaker": 6, "ext": [], "paren": ["eyes closed"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "action", "text": "Nobody stops.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Fondant! The humidity!", "name": "BASILE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "Is it hot in here?", "name": "VITO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "It's very hot in here.", "name": "DEV", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "Please. Everyone please.", "name": "SHANICE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "My dress is sticking to my...", "name": "TILDA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "Everybody.", "name": "MOIRA", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "Dev leans on the wall.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "The cart rolls an inch.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "The cake sways.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "Everyone lunges at once.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "action", "text": "Basile catches the top tier.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "Vito catches Basile.", "para": 4, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "Shanice catches Vito.", "para": 4, "sent": 6, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "Tilda catches Shanice's clipboard.", "para": 4, "sent": 7, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "The cake settles.", "para": 4, "sent": 8, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "Do not breathe!", "name": "BASILE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "dialogue", "text": "I'm not breathing.", "name": "VITO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "Can we call someone?", "name": "SHANICE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "I have no signal!", "name": "TILDA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "dialogue", "text": "I have one bar.", "name": "DEV", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "dialogue", "text": "Zero bars on the cake!", "name": "BASILE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "dialogue", "text": "I'm leaving him.", "name": "MOIRA", "speaker": 6, "ext": [], "paren": ["opening her eyes"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "action", "text": "The cake swings.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "dialogue", "text": "What?", "name": "TILDA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "dialogue", "text": "I'm leaving him. I've been thinking about it for three weeks, and I'm leaving him, and I'm doing it in the elevator.", "name": "MOIRA", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "dialogue", "text": "Moira, honey.", "name": "SHANICE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "dialogue", "text": "Not on the cake.", "name": "VITO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "action", "text": "The elevator lurches back to life.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "action", "text": "It rises.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "action", "text": "It dings.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "action", "text": "The doors open on a ballroom of two hundred guests, all of them turned to look.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}]}