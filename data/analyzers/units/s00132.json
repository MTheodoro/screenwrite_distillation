{"scene_id": "s00132", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00132.fountain", "heading": "INT. PLANETARIUM - CENTRAL DOME - NIGHT", "cast": [{"id": 0, "name": "PIP", "names": ["PIP"], "gender": "?", "first": 6, "spoke": 12}, {"id": 1, "name": "ADEYEMI-LARKIN", "names": ["ADEYEMI-LARKIN"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "SOUND", "names": ["SOUND"], "gender": "?", "first": 31, "spoke": 0}, {"id": 3, "name": "VOICE", "names": ["VOICE"], "gender": "?", "first": 36, "spoke": 1}, {"id": 4, "name": "MORDECAI ASHFORD-LUND", "names": ["MORDECAI ASHFORD-LUND", "MORDECAI"], "gender": "?", "first": 43, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. PLANETARIUM - CENTRAL DOME - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A great hemisphere of dark.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "In its middle, a squat projector shaped like a spiked beetle, squatting on a platform ringed with reclining seats.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The cupola above glows faintly with the residue of the day's last show.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Soft footfalls.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "Someone is breathing carefully, the way people do when they have broken into a place and wish to be forgiven for it.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "PERSEPHONE \"PIP\" ADEYEMI-LARKIN, 30s, small, black thermal jacket, a miner's headlamp turned to red.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "She kneels at the base of the projector with a canvas tool roll, unwrapping picks the way a surgeon lays out scalpels.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Her face is composed.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Her eyes are not.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She whispers into her sleeve.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I'm at the base. Panel is off. I see the vault door.", "name": "PIP", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She waits.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Nothing.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Anyone?", "name": "PIP", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She sighs.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Presses her palm to the dome's cold metal.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Tilts her head to look up through the beetle's legs into the dark of a ceiling she cannot see.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "The planetarium, empty, is still a place that holds its breath.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She slides a pick into the lock.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Turns it a quarter.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Listens.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Turns it back.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Wipes sweat from her upper lip with the heel of her glove.", "para": 7, "sent": 4, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Come on, old girl.", "name": "PIP", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Click.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "A heavy tumbler falls somewhere inside.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "She holds her breath.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Another.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Another.", "para": 8, "sent": 4, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "The door drifts open an inch.", "para": 8, "sent": 5, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Behind her, a SOUND.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Soft.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "The slide of a shoe.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "She does not turn.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Her hand drops to the tool roll, closes on a flat steel bar.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "A VOICE from the dark.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "That lock was installed in 1958. It sticks on the third tumbler.", "name": "VOICE", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Pip pivots, bar raised.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "A tall figure steps from between two seats.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Silver hair.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Cardigan.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Pocket flashlight in one hand, thermos in the other.", "para": 13, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "DR. MORDECAI ASHFORD-LUND, 70s, lowers the flashlight so the beam falls on the floor between them.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "He is calm.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Infinitely tired.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Now she knows him.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "She lowers the bar one inch.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Doctor.", "name": "PIP", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Miss Adeyemi-Larkin. You came earlier than I thought.", "name": "MORDECAI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "You knew.", "name": "PIP", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "I wrote the alarm schedule. I turned it off at nine.", "name": "MORDECAI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "Why?", "name": "PIP", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "He sets the thermos on a seat.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "Sits beside it.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Sighs.", "para": 16, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Because forty years of children have lain under that sky, and not one of them has ever asked me what's inside the projector.", "name": "MORDECAI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "What's inside the projector?", "name": "PIP", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "The Hope Diamond, as it happens.", "name": "MORDECAI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "That's a joke.", "name": "PIP", "speaker": 0, "ext": [], "paren": ["a beat"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "It is not a joke. It is a stone the museum board acquired in 1982 and kept off the books. I have guarded it for forty years in the one place no thief would ever think to look.", "name": "MORDECAI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "Except me.", "name": "PIP", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "dialogue", "text": "Except you.", "name": "MORDECAI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "She looks at the open vault.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "At the old man.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "At the bar in her hand.", "para": 17, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "dialogue", "text": "Why would you turn off the alarm, then?", "name": "PIP", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "dialogue", "text": "Because I'd like somebody to see it before I die.", "name": "MORDECAI", "speaker": 4, "ext": [], "paren": ["simply"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "action", "text": "He rises.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "Takes the flashlight in two fingers and clicks it off.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "dialogue", "text": "Open it, Pip. I will turn on the stars.", "name": "MORDECAI", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "action", "text": "He crosses to the control panel.", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "action", "text": "Presses a button.", "para": 19, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "action", "text": "The dome erupts into a billion pinpoints of light.", "para": 20, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "action", "text": "Pip stands in the center, bar forgotten, the vault door swinging wide.", "para": 21, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "action", "text": "In the dark inside the beetle, something catches the starlight and throws it back, a single cold blue fire.", "para": 21, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 76, "kind": "dialogue", "text": "Mordecai.", "name": "PIP", "speaker": 0, "ext": [], "paren": ["breathing"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 77, "kind": "dialogue", "text": "Yes?", "name": "MORDECAI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 78, "kind": "dialogue", "text": "You should have asked sooner.", "name": "PIP", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 79, "kind": "action", "text": "He smiles, and for a moment the whole dome is theirs.", "para": 22, "sent": 0, "present": [0, 1, 2, 3, 4]}]}