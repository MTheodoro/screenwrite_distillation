{"scene_id": "s00133", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00133.fountain", "heading": "INT. HOSPITAL BASEMENT LAUNDRY - NIGHT", "cast": [{"id": 0, "name": "EUGENIA HARTSHORN", "names": ["EUGENIA HARTSHORN", "EUGENIA"], "gender": "f", "first": 4, "spoke": 8}, {"id": 1, "name": "CALLIE HARTSHORN", "names": ["CALLIE HARTSHORN", "CALLIE"], "gender": "f", "first": 4, "spoke": 7}, {"id": 2, "name": "OSWIN BRADDOCK", "names": ["OSWIN BRADDOCK", "OSWIN"], "gender": "?", "first": 9, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOSPITAL BASEMENT LAUNDRY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Industrial washers thump.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Steam beads on pipes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A row of orange plastic chairs, bolted down.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "EUGENIA HARTSHORN, 60s, in a good coat, folds a single hospital gown over and over, smaller each time.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Across from her, her daughter CALLIE HARTSHORN, 30s, scrubs, badge flipped backward, watches a dryer turn.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Between them, on the third chair, a paper bag from the cafeteria.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Untouched.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Heavy boots.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "OSWIN BRADDOCK, 60s, maintenance, enters pushing a cart of towels.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "He nods to both, parks it, starts feeding sheets into a mangle.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "You haven't eaten.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Neither have you.", "name": "CALLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "I'm not on shift.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "You're here, Mom.", "name": "CALLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Eugenia smooths the gown flat on her knee.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Folds it again.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Evening, ladies.", "name": "OSWIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Evening.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Hey, Oswin.", "name": "CALLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "He glances at the bag.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Then at the two of them.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Says nothing.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Feeds another sheet.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "They moved him to the sixth floor.", "name": "CALLIE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "I know.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "I told them to wait.", "name": "CALLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "I know.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Dr. Rahimi said Thursday. Maybe Friday.", "name": "CALLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Eugenia sets the gown down.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Stands.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Walks to the washer.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Opens the door.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Looks inside.", "para": 6, "sent": 4, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Closes it.", "para": 6, "sent": 5, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "This one's done.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Mom, it's empty.", "name": "CALLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Is it?", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Oswin stops the mangle.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Eugenia opens the washer again.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "She reaches in, pulls out a single wool sock, grey, wet.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "She holds it up.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "His.", "name": "EUGENIA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "She sits.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Holds the sock in both hands, as if it were a bird.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Callie moves to the chair beside her.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Does not touch her.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Slides the paper bag across.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Eugenia takes the sandwich.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Unwraps it.", "para": 9, "sent": 4, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Bites.", "para": 9, "sent": 5, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Chews.", "para": 9, "sent": 6, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Her jaw works hard.", "para": 9, "sent": 7, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Oswin turns off the mangle.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Quietly, he fetches a clean towel, folds it, and lays it across the sock in her lap.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "Dryer's free.", "name": "OSWIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Eugenia nods.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Does not stand.", "para": 11, "sent": 1, "present": [0, 1, 2]}]}