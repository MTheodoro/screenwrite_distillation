{"scene_id": "s00134", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00134.fountain", "heading": "INT. HARBOR FISH AUCTION HALL - 4 A.M.", "cast": [{"id": 0, "name": "CHAR", "names": ["CHAR"], "gender": "m", "first": 5, "spoke": 8}, {"id": 1, "name": "IGLESIAS", "names": ["IGLESIAS"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "DOM VASQUEZ", "names": ["DOM VASQUEZ", "DOM"], "gender": "m", "first": 8, "spoke": 7}, {"id": 3, "name": "TWITCH", "names": ["TWITCH"], "gender": "?", "first": 9, "spoke": 5}, {"id": 4, "name": "SHADOW", "names": ["SHADOW"], "gender": "?", "first": 28, "spoke": 0}, {"id": 5, "name": "DETECTIVE MARGUERITE LAWSON", "names": ["DETECTIVE MARGUERITE LAWSON", "LAWSON"], "gender": "f", "first": 35, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. HARBOR FISH AUCTION HALL - 4 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "Concrete.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wet.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Gulls screaming under the rafters.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rows of tuna on ice, long as men.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CARMELO \"CHAR\" IGLESIAS, 40s, rubber boots, gutting knife, sweeps the floor like a man hiding something.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "A bell clangs.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Crowd noise.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "At the end of the aisle, DOM VASQUEZ, 50s, tailored raincoat, stands over a crate with a briefcase at his feet.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Beside him, a skinny kid, TWITCH, 19, in a hoodie, hand twitching in his pocket.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Dom.", "name": "CHAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Char. Product?", "name": "DOM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Under the bluefin.", "name": "CHAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Under the what?", "name": "TWITCH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Fish, kid.", "name": "CHAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Char tips a tuna on its side.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Underneath: a taped brick.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Count it.", "name": "DOM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "I'll count it.", "name": "TWITCH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Let him.", "name": "CHAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "All here.", "name": "TWITCH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Good. Case.", "name": "DOM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Dom nudges the briefcase forward with his toe.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Char kneels.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Lifts it.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Opens.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Dollars, banded.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "He snaps it shut.", "para": 5, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Behind them a SHADOW moves.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Char sees it first.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Don't turn around.", "name": "CHAR", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Who?", "name": "DOM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Just don't.", "name": "CHAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Footsteps on wet concrete.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Slow.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Then DETECTIVE MARGUERITE LAWSON, 40s, windbreaker, badge on a lanyard, a gun in her right hand, steps out between two ice tubs.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Her eyes flick across the three of them: Char, the brick, the briefcase, the kid.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Police. Hands.", "name": "LAWSON", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Oh, God.", "name": "TWITCH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Detective.", "name": "DOM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Marguerite.", "name": "CHAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Char, you son of a bitch.", "name": "LAWSON", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "I didn't do anything.", "name": "TWITCH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "Kid, shut up.", "name": "DOM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Twitch bolts.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Slips on fish scales.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Falls.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "The brick skids across the floor and splits, white powder bursting like flour in the lamp light.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "Dom lunges for the briefcase.", "para": 8, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "Char drops it.", "para": 8, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "Lawson fires once into the rafters.", "para": 8, "sent": 6, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "BANG.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "Gulls explode upward.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "Everyone freezes.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "Nobody moves.", "name": "LAWSON", "speaker": 5, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "A long beat.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "Dom raises his hands.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "Twitch lies still.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "Char folds his arms.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "You're early, Marguerite.", "name": "CHAR", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "You're late, Carmelo.", "name": "LAWSON", "speaker": 5, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "She holsters her weapon.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "Takes the briefcase.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "Walks to the edge of the dock, tosses it into the black harbor.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "It sinks without a ripple.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "dialogue", "text": "What the hell?", "name": "DOM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "dialogue", "text": "Go home, Dom. Take the kid.", "name": "LAWSON", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "action", "text": "She turns her back on them.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}