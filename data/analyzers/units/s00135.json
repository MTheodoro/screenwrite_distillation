{"scene_id": "s00135", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00135.fountain", "heading": "INT. FIELD HOSPITAL - REQUISITIONED BALLROOM - NIGHT", "cast": [{"id": 0, "name": "SERGEANT NIKODEM ZAWADZKI", "names": ["SERGEANT NIKODEM ZAWADZKI", "NIKODEM"], "gender": "m", "first": 5, "spoke": 5}, {"id": 1, "name": "NURSE PHILOMENA OKONKWO", "names": ["NURSE PHILOMENA OKONKWO", "PHILOMENA"], "gender": "?", "first": 6, "spoke": 4}, {"id": 2, "name": "PRIVATE ELIAS BRODEUR", "names": ["PRIVATE ELIAS BRODEUR", "ELIAS"], "gender": "?", "first": 7, "spoke": 3}, {"id": 3, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 8, "spoke": 3}, {"id": 4, "name": "MARCHETTI", "names": ["MARCHETTI"], "gender": "m", "first": 17, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. FIELD HOSPITAL - REQUISITIONED BALLROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A grand hall of cracked chandeliers and bloodied parquet.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cots in rows where the dance floor used to be.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Lanterns hang from candelabras.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Somewhere, a gramophone with no needle collects dust.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SERGEANT NIKODEM ZAWADZKI, 30s, left arm in a sling, sits on a cot.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Beside him, NURSE PHILOMENA OKONKWO, 30s, rolls bandages with grim efficiency.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Across the aisle, a young soldier lies still, face to the wall: PRIVATE ELIAS BRODEUR, 18.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "A figure in the doorway, silhouetted by the dying fire outside: a STRANGER, in a civilian overcoat, rifle slung.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Is this the hospital?", "name": "STRANGER", "speaker": 3, "ext": [], "paren": ["from the door"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "It's a ballroom. Come in.", "name": "PHILOMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "The Stranger crosses the hall.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "His boots echo on the parquet.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "He pauses by Elias's cot.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "This one's alive?", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "He breathes. That's all we know.", "name": "NIKODEM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Who are you?", "name": "PHILOMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Captain Lucien Marchetti. 4th Brigade. Our line broke at midnight.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Broke?", "name": "NIKODEM", "speaker": 0, "ext": [], "paren": ["sitting up"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "They'll be here by dawn.", "name": "MARCHETTI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Philomena rises.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Nikodem swings his legs to the floor.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Elias stirs, a small groan.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "We have forty wounded.", "name": "PHILOMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Then you have a decision.", "name": "MARCHETTI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "We have no decision. We don't move them.", "name": "NIKODEM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "He will. And she will. And you will.", "name": "MARCHETTI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "He points to Philomena.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Then to Nikodem.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Then to the wall.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Sergeant, you speak for the men?", "name": "MARCHETTI", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "I speak for no one.", "name": "NIKODEM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Then I'll speak.", "name": "MARCHETTI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Elias wakes.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Looks at Marchetti.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Looks at the rifle.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Captain?", "name": "ELIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Private.", "name": "MARCHETTI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "I can walk.", "name": "ELIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "No, you can't.", "name": "PHILOMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "I can crawl.", "name": "ELIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Then crawl first. We follow.", "name": "MARCHETTI", "speaker": 4, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "He turns to the others.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Nikodem nods once.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Philomena grabs a blanket.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "They begin moving cots toward the door, one by one, the way mourners carry a coffin.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "At the far end of the hall, the gramophone, caught in a draft, begins to turn on its own.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "A thin old waltz crackles out, ghostly, ridiculous, and every head lifts.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Then the first shell lands.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "The chandelier swings.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Plaster rains.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "The cots stagger.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Philomena throws herself over Elias.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Nikodem hauls Marchetti down.", "para": 11, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "The waltz continues, warped by the blast, slowing to a drone.", "para": 11, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Dust.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Smoke.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "A long, long silence.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Marchetti coughs.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "Rises.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "Lifts his rifle.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "They're early.", "name": "MARCHETTI", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "dialogue", "text": "Of course they are.", "name": "NIKODEM", "speaker": 0, "ext": [], "paren": ["wiping his face"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "Marchetti smiles grimly and puts his rifle to his shoulder.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "The ballroom, for the last time, becomes a ballroom of living men.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}]}