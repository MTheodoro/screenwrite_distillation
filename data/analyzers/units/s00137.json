{"scene_id": "s00137", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00137.fountain", "heading": "INT. FERRY - CALL CENTER DECK - DAY", "cast": [{"id": 0, "name": "PRUDENCE KWAN", "names": ["PRUDENCE KWAN", "PRUDENCE"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "GARRETT LINDQVIST", "names": ["GARRETT LINDQVIST", "GARRETT"], "gender": "?", "first": 5, "spoke": 7}, {"id": 2, "name": "DAPHNE ROUMELIOTIS", "names": ["DAPHNE ROUMELIOTIS", "DAPHNE"], "gender": "?", "first": 6, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. FERRY - CALL CENTER DECK - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A converted car deck: forty cubicles under fluorescent tubes, water slapping the hull.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A fire drill siren WAILS.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Nobody has stood up.", "para": 1, "sent": 0, "present": []}, {"u": 4, "kind": "action", "text": "At the central desk, PRUDENCE KWAN, 40s, floor manager, headset around her neck, scrolls on her laptop.", "para": 2, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "In the next cubicle, GARRETT LINDQVIST, 30s, a lanyard of seventeen badges, types with one finger.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Behind them, DAPHNE ROUMELIOTIS, 50s, QA lead, eats a banana.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "It's a drill. They said it's a drill.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Who said?", "name": "GARRETT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Facilities.", "name": "DAPHNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "We don't have Facilities. We're on a boat.", "name": "GARRETT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "She means the Captain's office.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "I mean Facilities.", "name": "DAPHNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "The siren wails on.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "We should evacuate.", "name": "GARRETT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "To where? We're in the middle of the Sound.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "The muster point is the lifeboat.", "name": "DAPHNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Which one is the lifeboat?", "name": "GARRETT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "The one with the sign.", "name": "DAPHNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "The sign fell off in March.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I filed a ticket.", "name": "GARRETT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Garrett, you don't have a ticket system.", "name": "DAPHNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "That's why it's still open.", "name": "GARRETT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "The siren stops.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "In the silence, the three of them look at each other.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Nobody has moved.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Okay, back to work.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Agreed.", "name": "DAPHNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Agreed.", "name": "GARRETT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "They sit.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Headsets on.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "A phone rings.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Thank you for calling, how can I help?", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": ["into headset"], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Behind them, the ferry's horn sounds, long and low.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "They don't look up.", "para": 6, "sent": 1, "present": [0, 1, 2]}]}