"dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "It flows west.", "name": "AMARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "East.", "name": "SILAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "West, Your Honor.", "name": "AMARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Amara, I walked the creek.", "name": "SILAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Silas, I walked it twice.", "name": "AMARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Counsel, address the bench, not each other.", "name": "WILHELMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Apologies, Your Honor.", "name": "SILAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Apologies.", "name": "AMARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Both speak at the same moment, voices stacking.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "We would move to submit the survey.", "name": "SILAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "We would move to submit the survey.", "name": "AMARA", "speaker": 2, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "A long silence.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "A cow lows, somewhere outside.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", 