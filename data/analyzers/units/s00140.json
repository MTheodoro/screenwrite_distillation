{"scene_id": "s00140", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00140.fountain", "heading": "EXT. TUG-OF-WAR PIT - COUNTY FAIR - DUSK", "cast": [{"id": 0, "name": "HOLLIS BRANDT", "names": ["HOLLIS BRANDT", "HOLLIS"], "gender": "m", "first": 5, "spoke": 3}, {"id": 1, "name": "NEELA CHOWDHURY", "names": ["NEELA CHOWDHURY", "NEELA"], "gender": "f", "first": 6, "spoke": 3}, {"id": 2, "name": "TOBY MARCINKIEWICZ", "names": ["TOBY MARCINKIEWICZ", "TOBY"], "gender": "?", "first": 7, "spoke": 3}, {"id": 3, "name": "WENDOLYN ACHTERBERG", "names": ["WENDOLYN ACHTERBERG", "WENDOLYN"], "gender": "f", "first": 8, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. TUG-OF-WAR PIT - COUNTY FAIR - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "Mud.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Two ropes of frayed hemp.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A line of chalk.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Four people in team shirts stand knee-deep in the slop.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "HOLLIS BRANDT hauls the knot.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "NEELA CHOWDHURY braces her heels.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "TOBY MARCINKIEWICZ squints at the opposing team across the pit.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "WENDOLYN ACHTERBERG spits and tightens her grip.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "On three.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "On two.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "On three!", "name": "NEELA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Whatever, just pull!", "name": "WENDOLYN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "The horn sounds.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "The rope snaps taut.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "They lean back as one.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Heave!", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Heave!", "name": "NEELA", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Don't let go!", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Don't you dare!", "name": "WENDOLYN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Hollis's boot slides.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Neela grabs his belt.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Toby's grip slips.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Wendolyn screams.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Left!", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Right!", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Down!", "name": "NEELA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Up!", "name": "WENDOLYN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "The rope goes slack.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "All four fall backward into the mud with a splat.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "They lie there, eyes toward the sky.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Hollis wipes his face.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Neela stares at her hands.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Toby laughs once, short.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Wendolyn closes her eyes.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Nobody says who won.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}]}