{"scene_id": "s00141", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00141.fountain", "heading": "INT. GOBLIN CUSTOMS OFFICE - UNDER THE HILL - DAY", "cast": [{"id": 0, "name": "KRIX BONEWHISTLE", "names": ["KRIX BONEWHISTLE", "KRIX"], "gender": "?", "first": 5, "spoke": 7}, {"id": 1, "name": "GRUMBELINE SOOT", "names": ["GRUMBELINE SOOT", "GRUMBELINE"], "gender": "?", "first": 6, "spoke": 5}, {"id": 2, "name": "SIR ALDERIC THORNE", "names": ["SIR ALDERIC THORNE", "ALDERIC"], "gender": "?", "first": 7, "spoke": 3}, {"id": 3, "name": "MAGDA VESPERS", "names": ["MAGDA VESPERS", "MAGDA"], "gender": "f", "first": 7, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. GOBLIN CUSTOMS OFFICE - UNDER THE HILL - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A stone vault with a crooked desk.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Lanterns of green fire.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A sign in nine languages: \"DECLARE EVERYTHING.\"", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Dust drifts from the ceiling.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "KRIX BONEWHISTLE, a goblin, three feet tall, in a tiny waistcoat, stamps papers with a thick fist.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Next to him, GRUMBELINE SOOT, a goblin woman with a monocle, sorts coins by weight.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Before the desk stand two travelers: SIR ALDERIC THORNE, 40s, a knight in dented armor, and a hooded witch, MAGDA VESPERS, who carries a covered basket.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Name, species, purpose.", "name": "KRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Alderic Thorne. Human. Passing through.", "name": "ALDERIC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Anything to declare?", "name": "KRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "My sword.", "name": "ALDERIC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "We saw the sword.", "name": "GRUMBELINE", "speaker": 1, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Madam?", "name": "KRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Magda Vespers. Witch. Visiting a cousin.", "name": "MAGDA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Anything to declare?", "name": "KRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Nothing.", "name": "MAGDA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "The basket twitches.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Grumbeline looks up.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "What's in the basket?", "name": "GRUMBELINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Bread.", "name": "MAGDA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Bread does not purr.", "name": "GRUMBELINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Magda sighs.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Lifts the cloth.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Inside: a small, indignant dragon, no larger than a kitten, blinking.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "That's a declarable.", "name": "KRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "That's a declarable!", "name": "GRUMBELINE", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Told you.", "name": "ALDERIC", "speaker": 2, "ext": [], "paren": ["under his breath"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "He's a rescue.", "name": "MAGDA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Fee is three silvers and a favor.", "name": "KRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Magda counts three coins from her sleeve.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "She sets them on the desk.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Grumbeline weighs each one, squints through the monocle, then nods.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "The favor?", "name": "GRUMBELINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Name it.", "name": "MAGDA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Teach us to make bread that purrs.", "name": "KRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Magda smiles for the first time.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "The dragon yawns, and a small flame lights the office.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}]}