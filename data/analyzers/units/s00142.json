{"scene_id": "s00142", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00142.fountain", "heading": "EXT. ROOFTOP PIGEON COOP - SUNSET", "cast": [{"id": 0, "name": "TAMSIN OKONKWO-REYES", "names": ["TAMSIN OKONKWO-REYES", "TAMSIN"], "gender": "f", "first": 4, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ROOFTOP PIGEON COOP - SUNSET", "present": []}, {"u": 1, "kind": "action", "text": "A tar roof six stories up, patched with plywood.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A wire-and-board coop sits against the stairwell.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "City below, orange and gold.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "TAMSIN OKONKWO-REYES, 15, backpack, headphones around her neck, climbs through the roof hatch.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She carries a thermos and a phone.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "She kneels beside the coop.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "She opens the little door.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "A pigeon, grey and ruffled, hops onto her wrist.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "She strokes it with one finger.", "para": 3, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "She sets the phone on the ledge.", "para": 4, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "Taps the screen.", "para": 4, "sent": 1, "present": [0]}, {"u": 12, "kind": "action", "text": "A red dot blinks.", "para": 4, "sent": 2, "present": [0]}, {"u": 13, "kind": "dialogue", "text": "Okay. Voice memo. Day twelve of the Great Return.", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 14, "kind": "action", "text": "She pulls the pigeon close.", "para": 5, "sent": 0, "present": [0]}, {"u": 15, "kind": "dialogue", "text": "Kevin hasn't flown home in six days. I don't think it's a navigation problem.", "name": "TAMSIN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 16, "kind": "action", "text": "She hesitates.", "para": 6, "sent": 0, "present": [0]}, {"u": 17, "kind": "action", "text": "Then continues, quieter.", "para": 6, "sent": 1, "present": [0]}, {"u": 18, "kind": "dialogue", "text": "I think he likes it wherever he's going.", "name": "TAMSIN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 19, "kind": "action", "text": "She stops the recording.", "para": 7, "sent": 0, "present": [0]}, {"u": 20, "kind": "action", "text": "Plays it back.", "para": 7, "sent": 1, "present": [0]}, {"u": 21, "kind": "dialogue", "text": "I think he likes it wherever he's going.", "name": "TAMSIN", "speaker": 0, "ext": ["V.O."], "paren": ["phone"], "dual": false, "present": [0]}, {"u": 22, "kind": "action", "text": "She frowns.", "para": 8, "sent": 0, "present": [0]}, {"u": 23, "kind": "action", "text": "Taps again.", "para": 8, "sent": 1, "present": [0]}, {"u": 24, "kind": "action", "text": "Plays the previous bit.", "para": 8, "sent": 2, "present": [0]}, {"u": 25, "kind": "dialogue", "text": "Kevin hasn't flown home in six days.", "name": "TAMSIN", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": ["phone"], "dual": false, "present": [0]}, {"u": 26, "kind": "action", "text": "She sets down the phone.", "para": 9, "sent": 0, "present": [0]}, {"u": 27, "kind": "action", "text": "She watches the sun slide behind the water towers.", "para": 9, "sent": 1, "present": [0]}, {"u": 28, "kind": "action", "text": "She lifts her wrist.", "para": 9, "sent": 2, "present": [0]}, {"u": 29, "kind": "action", "text": "The pigeon hops off, fluttering up onto the lip of the coop.", "para": 9, "sent": 3, "present": [0]}, {"u": 30, "kind": "dialogue", "text": "Go, then.", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 31, "kind": "action", "text": "He doesn't.", "para": 10, "sent": 0, "present": [0]}, {"u": 32, "kind": "action", "text": "He tucks his beak under his wing.", "para": 10, "sent": 1, "present": [0]}, {"u": 33, "kind": "action", "text": "She laughs, wipes her eyes with her sleeve, and sits on the warm tar with her back against the coop.", "para": 11, "sent": 0, "present": [0]}, {"u": 34, "kind": "action", "text": "She presses record again.", "para": 12, "sent": 0, "present": [0]}, {"u": 35, "kind": "dialogue", "text": "Day thirteen. He stayed.", "name": "TAMSIN", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the phone"], "dual": false, "present": [0]}]}