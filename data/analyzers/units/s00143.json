{"scene_id": "s00143", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00143.fountain", "heading": "INT. TOWN HALL - EVENING", "cast": [{"id": 0, "name": "MAYOR GWENDOLYN ARDITO", "names": ["MAYOR GWENDOLYN ARDITO", "GWENDOLYN"], "gender": "f", "first": 5, "spoke": 3}, {"id": 1, "name": "BARNABAS KOWALCZYK", "names": ["BARNABAS KOWALCZYK", "BARNABAS"], "gender": "m", "first": 6, "spoke": 5}, {"id": 2, "name": "TILLIE OSEI", "names": ["TILLIE OSEI", "TILLIE"], "gender": "?", "first": 6, "spoke": 5}, {"id": 3, "name": "DOT PELLEGRINI", "names": ["DOT PELLEGRINI", "DOT"], "gender": "f", "first": 6, "spoke": 3}, {"id": 4, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 6, "spoke": 2}, {"id": 5, "name": "IRVING", "names": ["IRVING"], "gender": "?", "first": 20, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. TOWN HALL - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Folding chairs.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A banner reads \"SAVE THE HARBOR FERRY.\"", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A coffee urn leaks in the corner.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain on the windows.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MAYOR GWENDOLYN ARDITO, 50s, stands at a podium.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Three citizens remain: BARNABAS KOWALCZYK, 60s, in a fisherman's sweater; TILLIE OSEI, 20s, with a clipboard; DOT PELLEGRINI, 70s, in a raincoat, knitting; and, in the back, a STRANGER in a damp suit, notebook closed on his knee.", "para": 1, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "dialogue", "text": "The council voted six to one. The ferry stops running on the first.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "Six to one.", "name": "BARNABAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "We can still petition.", "name": "TILLIE", "speaker": 2, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "We petitioned in 1998.", "name": "DOT", "speaker": 3, "ext": [], "paren": ["without looking up"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "We could pray.", "name": "TILLIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Pray on your own time.", "name": "BARNABAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "I fought for this ferry, Barnabas.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": ["wearily"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Then fight harder.", "name": "BARNABAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "She says nothing.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Dot's needles click.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "The Stranger raises a hand.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "If I might.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "And you are?", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Irving Tse. Regional transit.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "A murmur.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Tillie sits up.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Barnabas folds his arms.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "I'm not here to close it.", "name": "IRVING", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Then why?", "name": "TILLIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Because somebody has to say the numbers out loud.", "name": "IRVING", "speaker": 5, "ext": [], "paren": ["mutters, to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Say them.", "name": "TILLIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "It costs four hundred thousand a year. It carries eleven people a day.", "name": "IRVING", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Twelve, when I'm visiting my sister.", "name": "DOT", "speaker": 3, "ext": [], "paren": ["still knitting"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Laughter, thin and tired.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Gwendolyn rubs her eyes.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "I can keep it running one more year, if the town raises forty thousand.", "name": "IRVING", "speaker": 5, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "We don't have forty thousand.", "name": "BARNABAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "We can have it.", "name": "TILLIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Amen.", "name": "BARNABAS", "speaker": 1, "ext": [], "paren": ["grudging"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Dot ties off her stitch, rises, and drops a knitted scarf in the middle of the table.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Starting bid. Sell it.", "name": "DOT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "One by one, they reach for their wallets.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}