{"scene_id": "s00144_0", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00144.fountain", "heading": "INT. AGING CAVE - ALPINE CHEESE DAIRY - NIGHT", "cast": [{"id": 0, "name": "ANGELIKA STROBL", "names": ["ANGELIKA STROBL", "ANGELIKA"], "gender": "f", "first": 6, "spoke": 5}, {"id": 1, "name": "DIDI", "names": ["DIDI"], "gender": "m", "first": 7, "spoke": 3}, {"id": 2, "name": "HOFER", "names": ["HOFER"], "gender": "m", "first": 7, "spoke": 0}, {"id": 3, "name": "PETRA LUNDQVIST-AGYEMAN", "names": ["PETRA LUNDQVIST-AGYEMAN", "PETRA"], "gender": "m", "first": 8, "spoke": 3}, {"id": 4, "name": "FRAU BERGMANN", "names": ["FRAU BERGMANN", "BERGMANN"], "gender": "f", "first": 9, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. AGING CAVE - ALPINE CHEESE DAIRY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A hand-hewn tunnel, damp and cold.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Shelves of wheels stacked to the ceiling, each the size of a tire, smelling of mold and old milk.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Strings of bare bulbs.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Water drips in a slow metronome.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Three figures in white coats and hairnets creep between the racks.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "ANGELIKA STROBL, 40s, lean, planner, carries a thermal scanner.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "DIETMAR \"DIDI\" HOFER, 50s, safecracker, wears a headlamp and a toolbelt.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "PETRA LUNDQVIST-AGYEMAN, 30s, driver, clutches a walkie.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "And the night watchman, FRAU BERGMANN, 60s, somewhere above them, a flashlight in her fist and a radio on her hip, who has not yet noticed anything.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "A bulb flickers.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Aisle nine. Wheel forty.", "name": "ANGELIKA", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Which wheel?", "name": "DIDI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "The one with the red seal.", "name": "ANGELIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "They fan out.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Didi knocks a wheel.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "It rocks.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Petra lunges.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Catches it.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Her biceps shake.", "para": 4, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Careful.", "name": "PETRA", "speaker": 3, "ext": [], "paren": ["through teeth"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Sorry.", "name": "DIDI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Angelika finds it.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "A wheel the size of a wagon, wax-sealed.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "She taps.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "It rings hollow.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Didi.", "name": "ANGELIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "He kneels.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Cracks the seal with a pick.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Wax flakes.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Inside: a steel box.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Hello, beautiful.", "name": "DIDI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "It's in the cheese?", "name": "PETRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Forty years. Nobody looks in a wheel.", "name": "ANGELIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Didi lifts the box.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "A click.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "A light.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "A flashlight beam sweeps the aisle above.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Wer ist da?", "name": "BERGMANN", "speaker": 4, "ext": ["O.S."], "paren": ["sharp"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Everyone freezes.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Petra mouths a curse.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Night watch.", "name": "ANGELIKA", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "The beam comes closer.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Footsteps on the gantry.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "A shadow spills between the racks.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Didi bolts.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Slams into a shelf.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Wheels tumble.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "A cascade of cheese thunders down the aisle.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "He drops the box.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Petra yanks him back.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Angelika snatches it mid-air, ducks, rolls through the wreckage.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "Halt!", "name": "BERGMANN", "speaker": 4, "ext": ["O.S.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "They scramble.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "Cheese everywhere.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "The beam sweeps wildly.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Go go go!", "name": "PETRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "All three bolt for the tunnel mouth, slipping on rinds.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Behind them, a landslide of Gruyere pours into the aisle and buries the guard to her ankles.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}]}