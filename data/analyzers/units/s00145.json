{"scene_id": "s00145", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00145.fountain", "heading": "INT. REGATTA BOATHOUSE - MORNING", "cast": [{"id": 0, "name": "COACH ELEANOR PRZYBYLSKI", "names": ["COACH ELEANOR PRZYBYLSKI", "ELEANOR"], "gender": "?", "first": 4, "spoke": 8}, {"id": 1, "name": "ZEB", "names": ["ZEB"], "gender": "?", "first": 5, "spoke": 2}, {"id": 2, "name": "HOLLINGSWORTH", "names": ["HOLLINGSWORTH"], "gender": "?", "first": 5, "spoke": 0}, {"id": 3, "name": "MARISELA QUIROGA", "names": ["MARISELA QUIROGA", "MARISELA"], "gender": "?", "first": 5, "spoke": 1}, {"id": 4, "name": "CASPIAN ADEBAYO", "names": ["CASPIAN ADEBAYO", "CASPIAN"], "gender": "m", "first": 5, "spoke": 1}, {"id": 5, "name": "TOVE NIELSEN", "names": ["TOVE NIELSEN"], "gender": "?", "first": 5, "spoke": 0}, {"id": 6, "name": "BASHIR KARIMI", "names": ["BASHIR KARIMI", "BASHIR"], "gender": "?", "first": 5, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. REGATTA BOATHOUSE - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "A long timber shed that smells of varnish and river.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Eight-oared shells hang from racks like sleeping fish.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Pale light slants through the slats.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "COACH ELEANOR PRZYBYLSKI, 60s, windbreaker, whistle, sits on an overturned oar-box.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Before her stand five rowers in damp unisuits: ZEBEDIAH \"ZEB\" HOLLINGSWORTH, 20s, stroke; MARISELA QUIROGA, 20s, bow; CASPIAN ADEBAYO, 19, coxswain, small and quiet; TOVE NIELSEN, 21, seat five; and BASHIR KARIMI, 23, who has not yet looked up.", "para": 1, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 6, "kind": "action", "text": "She says nothing.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 7, "kind": "action", "text": "The oars drip.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 8, "kind": "dialogue", "text": "You're late.", "name": "ELEANOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 9, "kind": "dialogue", "text": "Two minutes.", "name": "ZEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "dialogue", "text": "Two minutes is a boat length.", "name": "ELEANOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "Coach, it was fog.", "name": "MARISELA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "The fog was there when I got here.", "name": "ELEANOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "action", "text": "Caspian shifts a megaphone in his hands.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "action", "text": "Marisela tightens a shoelace that does not need tightening.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "action", "text": "Tove studies a knot in the floorboards.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "action", "text": "Bashir finally lifts his eyes and meets hers.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "action", "text": "She holds the look.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "action", "text": "Then she rises, crosses to the shell Number Four, runs her palm along its hull, kneels to check a rigger bolt, and then, without turning, tosses a wrench over her shoulder, which Zeb catches and Marisela passes to Caspian, who hands it to Tove, who hands it to Bashir, who looks at it as though it were a snake.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "Seat seven's rigger is loose.", "name": "ELEANOR", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "It was tight yesterday.", "name": "BASHIR", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "Yesterday you were a different rower.", "name": "ELEANOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "action", "text": "Bashir doesn't answer.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "He kneels, takes the wrench, and tightens the bolt with six slow turns.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "Coach, the forecast says headwind.", "name": "CASPIAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "Then we row into it.", "name": "ELEANOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "It's a hundred meters.", "name": "ZEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "It's two thousand, Zebediah.", "name": "ELEANOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "The river laps outside.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "Boat on shoulders.", "name": "ELEANOR", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "They lift the shell as one.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "action", "text": "Eight hands, no words.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "They carry it out into the pale light, and Eleanor stays behind a moment, listening to their feet recede.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}]}