{"scene_id": "s00146", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00146.fountain", "heading": "INT. MOBILE HOME - KITCHEN TABLE - DAY", "cast": [{"id": 0, "name": "BEATRIX LOMAX-DIALLO", "names": ["BEATRIX LOMAX-DIALLO", "BEATRIX"], "gender": "f", "first": 5, "spoke": 6}, {"id": 1, "name": "HENRY TAKAHASHI", "names": ["HENRY TAKAHASHI", "HENRY"], "gender": "?", "first": 6, "spoke": 7}, {"id": 2, "name": "DANTE VELARDE", "names": ["DANTE VELARDE", "DANTE"], "gender": "?", "first": 7, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. MOBILE HOME - KITCHEN TABLE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A narrow kitchen.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wood paneling.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A window unit rattles.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "On the table: a stack of papers, a stamp pad, and a coffee mug that says WORLD'S OKAYEST NOTARY.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "BEATRIX LOMAX-DIALLO, 60s, notary, reading glasses on her forehead, sits at the head.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "To her left, HENRY TAKAHASHI, 70s, widower, rests both hands flat.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "To her right, his son-in-law, DANTE VELARDE, 40s, in a pressed shirt, fidgets with a pen.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "She stamps a page.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "He watches the stamp.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "He reaches for another page.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "She slides it toward him.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "This one transfers the deed.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "I know what it does.", "name": "HENRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Henry, take your time.", "name": "DANTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "I've taken my time. I'm seventy-three.", "name": "HENRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Dante nods.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "He lowers his eyes.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Beatrix clears her throat.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Mr. Velarde, you'll sign as witness.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Of course.", "name": "DANTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "She slides the pen to him.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "He takes it.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "His hand shakes slightly.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "He signs.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "She notarizes.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Mr. Takahashi, you are conveying the property to your daughter Keiko's estate, correct?", "name": "BEATRIX", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Keiko's gone.", "name": "HENRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "I'm sorry.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "To her children, then.", "name": "HENRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "They're minors.", "name": "DANTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "A trustee, then.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "You.", "name": "HENRY", "speaker": 1, "ext": [], "paren": ["looking at Dante"], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Dante pauses.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "He sets down the pen.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Henry, I don't need to be trustee.", "name": "DANTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "You'll do it right.", "name": "HENRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Beatrix looks from one to the other.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "She taps the stamp.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "She lifts the final page.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "He holds out his hand.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "She places the page in it.", "para": 7, "sent": 4, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "He reads.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Slow.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Every line.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Then he signs, large and square, and slides it back.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "She stamps.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "The sound is small, dry, final.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Congratulations.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Is that what it is?", "name": "HENRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "She smiles, gently, and pours him more coffee.", "para": 10, "sent": 0, "present": [0, 1, 2]}]}