{"scene_id": "s00147", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00147.fountain", "heading": "INT. RADIO TELESCOPE CONTROL ROOM - NIGHT", "cast": [{"id": 0, "name": "SOLVEIG ABERNATHY-OKAFOR", "names": ["SOLVEIG ABERNATHY-OKAFOR", "SOLVEIG"], "gender": "?", "first": 4, "spoke": 16}], "units": [{"u": 0, "kind": "heading", "text": "INT. RADIO TELESCOPE CONTROL ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A concrete room at the end of a dirt road, humming with machines.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Banks of dials.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A wall of monitors showing a single flat grey line.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. SOLVEIG ABERNATHY-OKAFOR, 40s, in a sweater and fingerless gloves, sits at the main console with a voice recorder and a cold cup of tea.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She hasn't slept.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "She presses RECORD.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "dialogue", "text": "Log entry, hour sixty. Signal is still there.", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 8, "kind": "action", "text": "She plays back the clip.", "para": 3, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "A pulse, faint, like a heartbeat, from a speaker.", "para": 3, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "She rewinds.", "para": 4, "sent": 0, "present": [0]}, {"u": 11, "kind": "dialogue", "text": "Log entry, hour fifty-two. It repeats every eleven minutes.", "name": "SOLVEIG", "speaker": 0, "ext": ["V.O."], "paren": ["recording"], "dual": false, "present": [0]}, {"u": 12, "kind": "dialogue", "text": "Eleven minutes.", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 13, "kind": "action", "text": "She leans closer, listening, and her hand slips to the console edge.", "para": 5, "sent": 0, "present": [0]}, {"u": 14, "kind": "action", "text": "The pulse thumps.", "para": 5, "sent": 1, "present": [0]}, {"u": 15, "kind": "action", "text": "The monitors flicker.", "para": 5, "sent": 2, "present": [0]}, {"u": 16, "kind": "action", "text": "The lights dim for a heartbeat, then recover.", "para": 5, "sent": 3, "present": [0]}, {"u": 17, "kind": "action", "text": "She exhales and lifts the recorder again.", "para": 6, "sent": 0, "present": [0]}, {"u": 18, "kind": "dialogue", "text": "Hour sixty-one. The pulse has changed. It now repeats every ten.", "name": "SOLVEIG", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 19, "kind": "action", "text": "She pauses.", "para": 7, "sent": 0, "present": [0]}, {"u": 20, "kind": "action", "text": "Her voice drops.", "para": 7, "sent": 1, "present": [0]}, {"u": 21, "kind": "dialogue", "text": "Ten minutes.", "name": "SOLVEIG", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 22, "kind": "action", "text": "She plays it back.", "para": 8, "sent": 0, "present": [0]}, {"u": 23, "kind": "dialogue", "text": "Hour sixty-one. The pulse has changed.", "name": "SOLVEIG", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": ["recording"], "dual": false, "present": [0]}, {"u": 24, "kind": "dialogue", "text": "Stop.", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 25, "kind": "action", "text": "She stops it.", "para": 9, "sent": 0, "present": [0]}, {"u": 26, "kind": "action", "text": "Silence.", "para": 9, "sent": 1, "present": [0]}, {"u": 27, "kind": "action", "text": "Then, faintly, from the speaker, the pulse resumes.", "para": 9, "sent": 2, "present": [0]}, {"u": 28, "kind": "action", "text": "A beat.", "para": 9, "sent": 3, "present": [0]}, {"u": 29, "kind": "action", "text": "Another.", "para": 9, "sent": 4, "present": [0]}, {"u": 30, "kind": "dialogue", "text": "That's not mine.", "name": "SOLVEIG", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 31, "kind": "action", "text": "She turns slowly.", "para": 10, "sent": 0, "present": [0]}, {"u": 32, "kind": "action", "text": "The speaker is off.", "para": 10, "sent": 1, "present": [0]}, {"u": 33, "kind": "action", "text": "The monitors show the grey line.", "para": 10, "sent": 2, "present": [0]}, {"u": 34, "kind": "action", "text": "The pulse continues.", "para": 10, "sent": 3, "present": [0]}, {"u": 35, "kind": "action", "text": "It's coming from the recorder.", "para": 11, "sent": 0, "present": [0]}, {"u": 36, "kind": "dialogue", "text": "Hello?", "name": "SOLVEIG", "speaker": 0, "ext": ["CONT'D"], "paren": ["a whisper"], "dual": false, "present": [0]}, {"u": 37, "kind": "action", "text": "She holds the recorder up.", "para": 12, "sent": 0, "present": [0]}, {"u": 38, "kind": "action", "text": "The pulse quickens.", "para": 12, "sent": 1, "present": [0]}, {"u": 39, "kind": "dialogue", "text": "Hello.", "name": "SOLVEIG", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": ["recording, but wrong, slow, deeper"], "dual": false, "present": [0]}, {"u": 40, "kind": "action", "text": "She drops the recorder.", "para": 13, "sent": 0, "present": [0]}, {"u": 41, "kind": "action", "text": "It clatters.", "para": 13, "sent": 1, "present": [0]}, {"u": 42, "kind": "action", "text": "She stands, backs away.", "para": 13, "sent": 2, "present": [0]}, {"u": 43, "kind": "action", "text": "The lights flicker.", "para": 13, "sent": 3, "present": [0]}, {"u": 44, "kind": "action", "text": "The console hums.", "para": 13, "sent": 4, "present": [0]}, {"u": 45, "kind": "action", "text": "The recorder lies on its side, spinning its reels.", "para": 13, "sent": 5, "present": [0]}, {"u": 46, "kind": "dialogue", "text": "Solveig. Come here.", "name": "SOLVEIG", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": ["recording, patient"], "dual": false, "present": [0]}, {"u": 47, "kind": "action", "text": "She does not move.", "para": 14, "sent": 0, "present": [0]}, {"u": 48, "kind": "action", "text": "Tears gather at her eyes.", "para": 14, "sent": 1, "present": [0]}, {"u": 49, "kind": "dialogue", "text": "No.", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 50, "kind": "dialogue", "text": "Come here. I have been waiting eleven minutes.", "name": "SOLVEIG", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": ["recording"], "dual": false, "present": [0]}, {"u": 51, "kind": "dialogue", "text": "Ten.", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 52, "kind": "dialogue", "text": "Ten.", "name": "SOLVEIG", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": ["recording"], "dual": false, "present": [0]}, {"u": 53, "kind": "action", "text": "A long silence.", "para": 15, "sent": 0, "present": [0]}, {"u": 54, "kind": "action", "text": "The pulse slows.", "para": 15, "sent": 1, "present": [0]}, {"u": 55, "kind": "action", "text": "The lights steady.", "para": 15, "sent": 2, "present": [0]}, {"u": 56, "kind": "action", "text": "The grey line on the monitors becomes a single, perfect, ordinary wave.", "para": 15, "sent": 3, "present": [0]}, {"u": 57, "kind": "action", "text": "She picks up the recorder.", "para": 16, "sent": 0, "present": [0]}, {"u": 58, "kind": "action", "text": "Her hand is still.", "para": 16, "sent": 1, "present": [0]}, {"u": 59, "kind": "action", "text": "She looks at it.", "para": 16, "sent": 2, "present": [0]}, {"u": 60, "kind": "dialogue", "text": "It's gone.", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 61, "kind": "action", "text": "She stops the machine.", "para": 17, "sent": 0, "present": [0]}, {"u": 62, "kind": "action", "text": "The room is silent.", "para": 17, "sent": 1, "present": [0]}, {"u": 63, "kind": "action", "text": "She sets the recorder down on the console, very gently, like a bird she has learned to trust.", "para": 17, "sent": 2, "present": [0]}, {"u": 64, "kind": "action", "text": "She picks up her tea.", "para": 18, "sent": 0, "present": [0]}, {"u": 65, "kind": "action", "text": "It's warm.", "para": 18, "sent": 1, "present": [0]}]}