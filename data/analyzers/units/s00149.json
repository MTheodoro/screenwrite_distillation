{"scene_id": "s00149", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00149.fountain", "heading": "INT. FENCING SALLE - EVENING", "cast": [{"id": 0, "name": "ENZO", "names": ["ENZO"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "BIANCHI", "names": ["BIANCHI"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "PRIYANKA SHARMA-ODUYA", "names": ["PRIYANKA SHARMA-ODUYA"], "gender": "f", "first": 5, "spoke": 0}, {"id": 3, "name": "PRIYA", "names": ["PRIYA"], "gender": "?", "first": 6, "spoke": 5}, {"id": 4, "name": "MASTER ALBERIC DUVAL", "names": ["MASTER ALBERIC DUVAL", "ALBERIC"], "gender": "?", "first": 26, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. FENCING SALLE - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Wooden floor, mirrored wall.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Masks hang on pegs.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Two figures in white square off under a single hanging lamp.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LORENZO \"ENZO\" BIANCHI, 20s, wiry, tightens his glove.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Opposite, PRIYANKA SHARMA-ODUYA, 20s, calm, flexes her blade.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Priya, you're stalling.", "name": "ENZO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "I'm warming up.", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "It's your finals bout.", "name": "ENZO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "It's practice.", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "They salute.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "En garde.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Silence.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "The lamp hums.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Lunge.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Parry.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "The blades sing.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "They circle, step, retreat, advance, a quiet dance.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Bit slow tonight.", "name": "ENZO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Bit loud tonight.", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Click.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Point to Priya.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "She grins.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "He grins back.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "The door opens.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "A tall, silver-haired man in a long coat steps in.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "MASTER ALBERIC DUVAL, 70s, leans on a cane and watches.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Don't stop on my account.", "name": "ALBERIC", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Maestro.", "name": "ENZO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Master Duval.", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Again.", "name": "ALBERIC", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "They resume.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Faster now.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Blades blur.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "A final parry.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "A riposte.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Priya stops, blade at Enzo's chest.", "para": 6, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Touch.", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Alberic nods, slowly, and turns to go.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "At the door, he pauses.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Priyanka. Pack your bag. Nationals are Thursday.", "name": "ALBERIC", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}