{"scene_id": "s00150", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00150.fountain", "heading": "INT. FUNERAL PARLOR - BACK ROOM SPEAKEASY - NIGHT - 1926", "cast": [{"id": 0, "name": "SABINE ARCHAMBAULT", "names": ["SABINE ARCHAMBAULT", "SABINE"], "gender": "?", "first": 5, "spoke": 7}, {"id": 1, "name": "HORACE PELLETIER", "names": ["HORACE PELLETIER", "HORACE"], "gender": "m", "first": 6, "spoke": 8}, {"id": 2, "name": "TOBY", "names": ["TOBY"], "gender": "?", "first": 7, "spoke": 4}, {"id": 3, "name": "FINNEGAN", "names": ["FINNEGAN"], "gender": "?", "first": 7, "spoke": 0}, {"id": 4, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 8, "spoke": 3}, {"id": 5, "name": "CALLUM", "names": ["CALLUM"], "gender": "?", "first": 26, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. FUNERAL PARLOR - BACK ROOM SPEAKEASY - NIGHT - 1926", "present": []}, {"u": 1, "kind": "action", "text": "Behind a velvet curtain: a card table set atop a coffin lid, a bar of embalming-fluid bottles filled with gin, a gramophone low and hissing.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Gaslight.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Four people.", "para": 1, "sent": 0, "present": []}, {"u": 4, "kind": "action", "text": "One empty chair.", "para": 1, "sent": 1, "present": []}, {"u": 5, "kind": "action", "text": "SABINE ARCHAMBAULT, 30s, in beads and a cloche, shuffles.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "HORACE PELLETIER, 50s, mortician, apron over a vest.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "TOBIAS \"TOBY\" FINNEGAN, 20s, a cop's son in a borrowed suit.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "And a STRANGER, in a grey coat, who sits at the table's far edge and has said nothing.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Deal's mine.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Deal's the house's.", "name": "HORACE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "The house is dead, Horace.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Not tonight.", "name": "HORACE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Can we play?", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Sit, Toby.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "He sits.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "The Stranger doesn't move.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "You in?", "name": "HORACE", "speaker": 1, "ext": [], "paren": ["to the Stranger"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "I'm watching.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "We don't have spectators.", "name": "HORACE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "You do now.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "A beat.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Sabine deals.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "He studies his cards.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "She studies him.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "You have a name, friend?", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Callum Redfern.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Redfern. Like the Redfern Brewery?", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Like the Redfern Brewery's heir.", "name": "CALLUM", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Heir to what? They shut down in '19.", "name": "HORACE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "To the cellar.", "name": "CALLUM", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Horace sets down his cards.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Sabine's eyebrows lift.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Callum. Is there beer in the cellar?", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Four hundred barrels.", "name": "CALLUM", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Mr. Redfern, can I buy some?", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Mr. Finnegan, I can't sell to a policeman's son.", "name": "CALLUM", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Toby colors.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Horace laughs.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "He knows you.", "name": "HORACE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "I know everybody. It's my cellar.", "name": "CALLUM", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "What do you want, Callum?", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Partners.", "name": "CALLUM", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "In what?", "name": "HORACE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "In the thing after this.", "name": "CALLUM", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "He lays down his cards.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "A straight flush.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "Nobody says a word.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "The gramophone skips.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "He wins.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "He always did.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Horace pours four glasses from the embalming bottle.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "Slides one to each.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "Lifts his.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "To the cellar.", "name": "HORACE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}