{"scene_id": "s00151", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00151.fountain", "heading": "INT. CAR WASH - TUNNEL - NIGHT", "cast": [{"id": 0, "name": "RAY", "names": ["RAY"], "gender": "?", "first": 5, "spoke": 3}, {"id": 1, "name": "OYELOWO", "names": ["OYELOWO"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "TANISHA BEAUMONT", "names": ["TANISHA BEAUMONT", "TANISHA"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "MARCUS DELACROIX-WU", "names": ["MARCUS DELACROIX-WU", "MARCUS"], "gender": "m", "first": 7, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. CAR WASH - TUNNEL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Blue foam.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Spinning brushes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A conveyor drags a black sedan through the dark.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The attendant booth glows at the end.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "RAYMUNDO \"RAY\" OYELOWO, 40s, uniform, towel on shoulder, waits at the exit.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "At his side, TANISHA BEAUMONT, 20s, trainee, holds a squeegee like a baton.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "A second man leans on the booth wall: MARCUS DELACROIX-WU, 50s, leather jacket, thumb in his belt.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "The sedan emerges, dripping.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Marcus.", "name": "RAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Ray.", "name": "MARCUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Car's clean.", "name": "RAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Is it?", "name": "MARCUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Tanisha wipes the windshield, too fast.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Spotless, sir.", "name": "TANISHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Easy, kid. You'll rub off the paint.", "name": "MARCUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "She stops.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "He opens the trunk.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Looks inside.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Closes it.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Ray. Come here.", "name": "MARCUS", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Ray steps close.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Marcus puts a hand on his shoulder.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Squeezes.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Smiles.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Good work.", "name": "MARCUS", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "He pulls three twenties from his jacket.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Tucks them into Ray's breast pocket.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Pats it.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "What was in the trunk?", "name": "TANISHA", "speaker": 2, "ext": [], "paren": ["whispering to Ray"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Nothing.", "name": "RAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Exactly.", "name": "MARCUS", "speaker": 3, "ext": [], "paren": ["already in the car"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "The sedan rolls out into the rain.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Tanisha looks at the three twenties poking from Ray's pocket.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Ray's hand trembles once.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Then he folds the bills away and turns on the hose.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}]}