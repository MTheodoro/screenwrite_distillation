{"scene_id": "s00152", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00152.fountain", "heading": "INT. FARMHOUSE KITCHEN - PRE-DAWN", "cast": [{"id": 0, "name": "EDMUND ABERNETHY-SOTO", "names": ["EDMUND ABERNETHY-SOTO", "EDMUND"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "LIORA ABERNETHY-SOTO", "names": ["LIORA ABERNETHY-SOTO", "LIORA"], "gender": "?", "first": 4, "spoke": 4}, {"id": 2, "name": "QUENTIN DUPREE", "names": ["QUENTIN DUPREE", "QUENTIN"], "gender": "m", "first": 6, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. FARMHOUSE KITCHEN - PRE-DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A bare bulb.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A pot of coffee going cold.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A calendar with a date circled in red.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "EDMUND ABERNETHY-SOTO, 60s, sits at the table with a stack of unopened envelopes.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "His daughter, LIORA ABERNETHY-SOTO, 30s, stands at the sink with her back to him.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "A hired hand, QUENTIN DUPREE, 40s, hovers by the door, cap in his hands.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "He lifts one envelope.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Sets it down.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Lifts another.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "She runs the tap.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Turns it off.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Runs it again.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Mr. Abernethy, the auctioneer's truck is at the gate.", "name": "QUENTIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Already?", "name": "EDMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Six a.m., he said.", "name": "QUENTIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "It's four-thirty.", "name": "LIORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "They like to get a good spot.", "name": "QUENTIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "He opens an envelope.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Reads.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Closes it.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "She turns, wipes her hands on her apron, sits across from him.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Neither speaks.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Your mother loved this kitchen.", "name": "EDMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "She hated the stove.", "name": "LIORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "She hated the stove, yes.", "name": "EDMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "I'll start with the tractor.", "name": "QUENTIN", "speaker": 2, "ext": [], "paren": ["awkward"], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Quentin, wait.", "name": "LIORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Ma'am?", "name": "QUENTIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Let him go, Liora.", "name": "EDMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "He doesn't have to.", "name": "LIORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "It's his job.", "name": "EDMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "It's all right.", "name": "QUENTIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Sit down, son.", "name": "EDMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "I'd rather stand.", "name": "QUENTIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "He stands.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "They sit.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "The kitchen clock ticks.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Outside, an engine idles.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "A truck door slams.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "He pushes the stack of envelopes to the middle of the table.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "She takes one.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Opens it.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Reads.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Her mouth tightens.", "para": 6, "sent": 4, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "She folds it small.", "para": 6, "sent": 5, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "She stands and fills the kettle.", "para": 7, "sent": 0, "present": [0, 1, 2]}]}