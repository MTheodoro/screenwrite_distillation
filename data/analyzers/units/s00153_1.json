{"scene_id": "s00153_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00153.fountain", "heading": "INT. GONDOLA CABIN - CONTINUOUS", "cast": [{"id": 0, "name": "AUGUSTIN LEFEBVRE-MBAYE", "names": ["AUGUSTIN LEFEBVRE-MBAYE", "AUGUSTIN"], "gender": "m", "first": 3, "spoke": 6}, {"id": 1, "name": "ROSALIE TANNENBAUM", "names": ["ROSALIE TANNENBAUM", "ROSALIE"], "gender": "f", "first": 4, "spoke": 4}, {"id": 2, "name": "KIERAN SZYMANSKI", "names": ["KIERAN SZYMANSKI", "KIERAN"], "gender": "m", "first": 5, "spoke": 4}, {"id": 3, "name": "JASMINE BEAUCHAMP-IYER", "names": ["JASMINE BEAUCHAMP-IYER", "JASMINE"], "gender": "f", "first": 6, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. GONDOLA CABIN - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Four people in a space built for ten.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "They have been here five hours.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "AUGUSTIN LEFEBVRE-MBAYE, 60s, retired cartographer, wool coat buttoned to the neck, sits in the corner with a thermos, perfectly still.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "Opposite him, ROSALIE TANNENBAUM, 30s, a nurse in a puffy yellow jacket, rubs her hands together and breathes into her cupped palms.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "On the floor: KIERAN SZYMANSKI, 20s, backpacker, his leg splinted with a ski pole and a scarf, jaw clenched.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "At the window, JASMINE BEAUCHAMP-IYER, 40s, in a business suit and sneakers, pounds on the glass with her fist, then stops, then pounds again.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "The cabin sways.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Ice cracks.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "A slow groan runs down the cable.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Anyone else hear that?", "name": "JASMINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "It is the cable.", "name": "AUGUSTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "The cable is groaning.", "name": "JASMINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "It has been groaning for five hours.", "name": "AUGUSTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Does it hurt?", "name": "ROSALIE", "speaker": 1, "ext": [], "paren": ["to Kieran"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Only when I breathe.", "name": "KIERAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Then breathe shallow.", "name": "ROSALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Thanks, doc.", "name": "KIERAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Nurse.", "name": "ROSALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Thanks, nurse.", "name": "KIERAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Jasmine slumps against the window.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Her breath fogs the glass.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "She traces a line with her finger, then wipes it away.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "The signal's dead. The radio's dead. The cable is the only thing alive.", "name": "JASMINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "There is the thermos.", "name": "AUGUSTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "He unscrews it.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Pours a capful of steaming tea.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Holds it out to Kieran.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Kieran takes it.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Sips.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Passes it to Rosalie.", "para": 5, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "She sips.", "para": 5, "sent": 6, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Passes it to Jasmine.", "para": 5, "sent": 7, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "She hesitates.", "para": 5, "sent": 8, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Then drinks.", "para": 5, "sent": 9, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "The cabin lurches.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "A long metallic shriek.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Everyone grabs a rail.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Oh, God.", "name": "ROSALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Be calm.", "name": "AUGUSTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Is it dropping?", "name": "KIERAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "It's swinging.", "name": "JASMINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "The cabin sways wider, wider, a pendulum in the dark.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Then slowly, painfully, it steadies.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Far below, a river laughs.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "The map of this gorge was my last. I measured it in 1974. I always wondered what it looked like from here.", "name": "AUGUSTIN", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "He pours another capful.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Raises it.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "To the view.", "name": "AUGUSTIN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Nobody answers.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Then Rosalie lifts her hand.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Then Kieran.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Then Jasmine.", "para": 9, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "They drink.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}]}