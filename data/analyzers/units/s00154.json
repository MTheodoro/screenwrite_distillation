{"scene_id": "s00154", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00154.fountain", "heading": "INT. BONDED TEA WAREHOUSE - AFTER CLOSING", "cast": [{"id": 0, "name": "LEO", "names": ["LEO"], "gender": "f", "first": 5, "spoke": 18}, {"id": 1, "name": "MARCHAND-ADEBISI", "names": ["MARCHAND-ADEBISI"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "ANTON KARPINSKI-OLUWALE", "names": ["ANTON KARPINSKI-OLUWALE", "ANTON"], "gender": "?", "first": 11, "spoke": 18}, {"id": 3, "name": "INES KARPINSKI-OLUWALE", "names": ["INES KARPINSKI-OLUWALE", "INES"], "gender": "f", "first": 12, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. BONDED TEA WAREHOUSE - AFTER CLOSING", "present": []}, {"u": 1, "kind": "action", "text": "A cathedral of tea chests, stacked in towers to the rafters.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Shafts of lamplight.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The smell of bergamot and dust.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A catwalk runs across the beams.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LEOPOLDINE \"LEO\" MARCHAND-ADEBISI, 40s, customs inspector, long coat, lanyard, walks the floor slowly, a clipboard against her hip.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "She stops at a chest labelled DARJEELING FIRST FLUSH.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "She taps it.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Hollow.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "A footstep behind her.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She does not turn.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "You're late, Anton.", "name": "LEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "ANTON KARPINSKI-OLUWALE, 50s, in a dark overcoat, emerges from between two towers of chests.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "He carries a small leather case.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Traffic.", "name": "ANTON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "There was no traffic.", "name": "LEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Then I walked slowly.", "name": "ANTON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "She finally turns.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "He smiles, a thin, kind smile.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "She doesn't return it.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Open it.", "name": "LEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "You said no names.", "name": "ANTON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "I said no names on the phone.", "name": "LEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "He sets the case on a chest.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Unlatches it.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Inside: tea.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Real tea, loose, pale green.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "He takes a pinch and holds it out.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Taste.", "name": "ANTON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "She takes it, rolls it between finger and thumb, sniffs.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Her expression changes.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "It's the Himalayan Silver Tip.", "name": "LEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "It is.", "name": "ANTON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "That doesn't exist anymore.", "name": "LEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "It exists in eleven chests.", "name": "ANTON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "In this warehouse?", "name": "LEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "In this warehouse.", "name": "ANTON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "She puts the leaf in her mouth.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Chews.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Swallows.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Closes her eyes.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "It's extraordinary.", "name": "LEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "It's illegal.", "name": "ANTON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "It's both.", "name": "LEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "A sound from the catwalk overhead.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Both look up.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "A silhouette moves between the beams.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Leo draws a pistol from under her coat.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Anton raises both hands.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Don't.", "name": "ANTON", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Who is that?", "name": "LEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "My daughter.", "name": "ANTON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "You brought your daughter?", "name": "LEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "She insisted.", "name": "ANTON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "The silhouette leans over the rail.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "A young woman, perhaps twenty, with Anton's eyes.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Come down.", "name": "LEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "She does, down a rope ladder, one slow rung at a time.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "At the bottom she lowers her hood.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "The lamplight catches her face.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "Ines.", "name": "ANTON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "INES KARPINSKI-OLUWALE, 20s, stands between her father and the inspector.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "Hands open.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "Dad, it's fine.", "name": "INES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "Both of you, step back.", "name": "LEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "They speak at once.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "Leo, put it down.", "name": "ANTON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "Please, please, please.", "name": "INES", "speaker": 3, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "Leo holds the gun steady for three long seconds.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "Then, slowly, she lowers it.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "dialogue", "text": "Eleven chests.", "name": "LEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "dialogue", "text": "Eleven.", "name": "ANTON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "I get five.", "name": "LEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "Four.", "name": "ANTON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "dialogue", "text": "Five, Anton. Or the daughter sings.", "name": "LEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "Ines glances at her father.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "He sighs.", "para": 15, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "dialogue", "text": "Five.", "name": "ANTON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "action", "text": "Leo holsters the gun.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "action", "text": "She lifts the clipboard.", "para": 16, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "action", "text": "Writes something, tears off the page, hands it to him.", "para": 16, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "dialogue", "text": "That's a receipt for the tea. As seized.", "name": "LEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "dialogue", "text": "It says \"destroyed.\"", "name": "ANTON", "speaker": 2, "ext": [], "paren": ["reading"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "dialogue", "text": "It will be, by the end of the week.", "name": "LEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 84, "kind": "action", "text": "She walks back into the stacks.", "para": 17, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 85, "kind": "action", "text": "Her footsteps fade.", "para": 17, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 86, "kind": "action", "text": "The lamp hums.", "para": 17, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 87, "kind": "action", "text": "Ines exhales for the first time in a minute.", "para": 17, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 88, "kind": "dialogue", "text": "Dad.", "name": "INES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 89, "kind": "dialogue", "text": "Yes?", "name": "ANTON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 90, "kind": "dialogue", "text": "Next time I'll stay in the car.", "name": "INES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}