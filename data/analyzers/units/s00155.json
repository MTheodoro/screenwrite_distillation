2, 3, 4, 5]}, {"u": 9, "kind": "action", "text": "She clicks it.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Start.", "name": "FRIDA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "Theo mounts.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "Billie pushes off.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "The tandem wobbles.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "He steers right.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "She leans left.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "They crash into the rack.", "para": 3, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "He laughs.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "She stares daggers.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "He helps her up.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "She brushes off his hands.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Corazon watches.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Nods approval.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Juan-Pablo looks up from his phone, shrugs, and pockets it.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Abuela, don't.", "name": "JUAN-PABLO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Watch me.", "name": "CORAZON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "She climbs on.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Pats the seat behind her.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "He sighs, climbs on.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "They pedal off, smooth as silk, past the kiosk, past the pier, into the sun.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Frida clicks the stopwatch.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Billie and Theo watch them go.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Their hands find each other.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}