{"scene_id": "s00156", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00156.fountain", "heading": "INT. TRAMPOLINE PARK - PRIVATE PARTY ROOM - DAY", "cast": [{"id": 0, "name": "HARRY", "names": ["HARRY"], "gender": "m", "first": 8, "spoke": 7}, {"id": 1, "name": "EZEKWESILI", "names": ["EZEKWESILI"], "gender": "?", "first": 8, "spoke": 0}, {"id": 2, "name": "DOROTHEA PRZYWARA", "names": ["DOROTHEA PRZYWARA", "DOROTHEA"], "gender": "m", "first": 9, "spoke": 7}, {"id": 3, "name": "HR", "names": ["HR"], "gender": "?", "first": 9, "spoke": 0}, {"id": 4, "name": "TREVOR OKONJO-LANE", "names": ["TREVOR OKONJO-LANE", "TREVOR"], "gender": "?", "first": 10, "spoke": 4}, {"id": 5, "name": "MARGUERITE VOLKOV", "names": ["MARGUERITE VOLKOV", "MARGUERITE"], "gender": "m", "first": 11, "spoke": 5}, {"id": 6, "name": "PAXTON HALE", "names": ["PAXTON HALE", "PAXTON"], "gender": "m", "first": 12, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. TRAMPOLINE PARK - PRIVATE PARTY ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A wall of padded foam.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Neon signs: JUMP!", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "SOAR!", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SURVIVE!", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A banner reads \"SYNERGY OFFSITE 2026.\"", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "A long table of untouched pizza.", "para": 0, "sent": 5, "present": []}, {"u": 7, "kind": "action", "text": "Five employees in matching grippy socks sit in a circle on the floor, cross-legged, as a laminated agenda card makes its way from hand to hand.", "para": 1, "sent": 0, "present": []}, {"u": 8, "kind": "action", "text": "HARRISON \"HARRY\" EZEKWESILI, 40s, VP of Operations, tie still knotted.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "DOROTHEA PRZYWARA, 30s, the HR manager, clipboard.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "TREVOR OKONJO-LANE, 20s, an intern with his sock half off.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "MARGUERITE VOLKOV, 50s, in a cardigan, the longest-tenured.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "And PAXTON HALE, 30s, from Sales, who has not stopped smiling since he arrived.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "Okay, everybody, let's share one fear and one trampoline goal.", "name": "DOROTHEA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "I'll start. My fear is irrelevance.", "name": "HARRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "My fear is liability.", "name": "DOROTHEA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "My fear is... all of this.", "name": "TREVOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "My fear is that I'll outlive the company.", "name": "MARGUERITE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "I don't have fears. I have opportunities.", "name": "PAXTON", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "action", "text": "A beat.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "action", "text": "Everyone looks at Paxton.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "Paxton, that's a fear in disguise.", "name": "HARRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Is it?", "name": "PAXTON", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "It is.", "name": "DOROTHEA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "Definitely.", "name": "TREVOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "I'll allow it.", "name": "MARGUERITE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "Trampoline goals?", "name": "DOROTHEA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "Backflip.", "name": "HARRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "No injuries.", "name": "DOROTHEA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "Escape.", "name": "TREVOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "A nap.", "name": "MARGUERITE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "A synergistic pyramid.", "name": "PAXTON", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "Let's jump.", "name": "HARRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "They rise.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "The trampolines are a field of black.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "Harry steps on.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "Bounces once.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "Bounces twice.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "His tie flaps over his shoulder.", "para": 4, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "This isn't so bad.", "name": "HARRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "He bounces higher.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "Dorothea joins.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "Then Trevor.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "Then Marguerite, solemn as a monk.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "Paxton cannonballs onto the biggest trampoline, shouting.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "Pyramid!", "name": "PAXTON", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "action", "text": "They stack awkwardly.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "Harry on the bottom.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "Dorothea on his shoulders.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "action", "text": "Trevor on hers.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "action", "text": "Marguerite on his.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "action", "text": "Paxton climbs to the top, hands overhead.", "para": 6, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "dialogue", "text": "Synergy!", "name": "PAXTON", "speaker": 6, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "action", "text": "The pyramid sways.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "action", "text": "Gasps.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "action", "text": "Dorothea's clipboard slips.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "action", "text": "Trevor loses a sock.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "action", "text": "The whole pile topples sideways into the foam pit with a majestic thump.", "para": 7, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "action", "text": "Silence.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 59, "kind": "action", "text": "A hand emerges, then a head.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 60, "kind": "action", "text": "It is Marguerite.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 61, "kind": "action", "text": "She spits out foam.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 62, "kind": "dialogue", "text": "That was the best meeting we have ever had.", "name": "MARGUERITE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 63, "kind": "action", "text": "One by one, the others surface, laughing.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 64, "kind": "action", "text": "Harry pulls off his tie and flings it into the air.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 65, "kind": "dialogue", "text": "Let's do it again.", "name": "HARRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 66, "kind": "action", "text": "They scramble.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 67, "kind": "action", "text": "A whistle shrills from the wall speaker.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 68, "kind": "dialogue", "text": "Time!", "name": "DOROTHEA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 69, "kind": "action", "text": "They sag.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 70, "kind": "action", "text": "Harry sighs.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 71, "kind": "dialogue", "text": "Put that in the minutes.", "name": "HARRY", "speaker": 0, "ext": [], "paren": ["to Dorothea"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 72, "kind": "dialogue", "text": "\"Synergy achieved.\"", "name": "DOROTHEA", "speaker": 2, "ext": [], "paren": ["writing"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 73, "kind": "dialogue", "text": "Can I go home now?", "name": "TREVOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 74, "kind": "dialogue", "text": "Not before the pizza.", "name": "MARGUERITE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 75, "kind": "action", "text": "They move toward the table.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 76, "kind": "action", "text": "Paxton lingers.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 77, "kind": "action", "text": "He looks back at the foam pit, grinning at the wreckage.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 78, "kind": "dialogue", "text": "Opportunities.", "name": "PAXTON", "speaker": 6, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}