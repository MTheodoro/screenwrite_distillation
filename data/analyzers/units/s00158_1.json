{"scene_id": "s00158_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00158.fountain", "heading": "INT. DENTIST TENT - CONTINUOUS", "cast": [{"id": 0, "name": "ZEKE", "names": ["ZEKE"], "gender": "m", "first": 4, "spoke": 12}, {"id": 1, "name": "MONTAGUE", "names": ["MONTAGUE"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "ABNER TWOBEARS", "names": ["ABNER TWOBEARS", "ABNER"], "gender": "m", "first": 5, "spoke": 11}], "units": [{"u": 0, "kind": "heading", "text": "INT. DENTIST TENT - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "A barber's chair nailed to a plank floor.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A tray of forceps.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A bottle of whiskey and a bucket.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. EZEKIEL \"ZEKE\" MONTAGUE, 50s, in a stained vest, leans over the chair.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "In the chair, a miner, ABNER TWOBEARS, 40s, white-knuckled, mouth wide.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Hold still.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "I'm holding.", "name": "ABNER", "speaker": 2, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "You're trembling.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "I'm holding while trembling.", "name": "ABNER", "speaker": 2, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Zeke lifts the forceps.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Peers into the mouth.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Sniffs.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "This one's rotten.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Pull it.", "name": "ABNER", "speaker": 2, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "You sure?", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "He's been pulling at me for three weeks. Pull it.", "name": "ABNER", "speaker": 2, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Zeke grips.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Twists.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Pulls.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "The tooth pops.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Abner howls.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Zeke holds it up to the lantern.", "para": 3, "sent": 5, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Eighteen karat.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "What?", "name": "ABNER", "speaker": 2, "ext": [], "paren": ["spitting"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "It's gold. Your tooth is gold.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Abner reaches up and feels his jaw.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Then looks at Zeke.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Give it back.", "name": "ABNER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "It's my fee.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "It's my tooth.", "name": "ABNER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "It was your tooth. Now it's a fee.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Abner rises.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Fists clench.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Zeke steps back, tooth in hand.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Hand it over, Doc.", "name": "ABNER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Two dollars, Abner.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "I'll give you the two dollars.", "name": "ABNER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "And the tooth.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "And the tooth stays mine.", "name": "ABNER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "A long silence.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Then Zeke tosses the tooth.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Abner catches it.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Pays two coins.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "They both exhale.", "para": 6, "sent": 4, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Next time, I'll price by the karat.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Next time, I'll pull my own.", "name": "ABNER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "He pockets the tooth, tips his hat, and leaves.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Zeke watches him go.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "The lantern hisses.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Outside, a mule brays.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "He pours himself a drink.", "para": 7, "sent": 4, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Next.", "name": "ZEKE", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the empty chair"], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "The tent flap opens on wind and dark.", "para": 8, "sent": 0, "present": [0, 1, 2]}]}