{"scene_id": "s00159", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00159.fountain", "heading": "EXT. SNOWFIELD - BELOW A CRASHED BUSH PLANE - DAY", "cast": [{"id": 0, "name": "ASTRID VESTERGAARD-NNAMDI", "names": ["ASTRID VESTERGAARD-NNAMDI", "ASTRID"], "gender": "?", "first": 5, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SNOWFIELD - BELOW A CRASHED BUSH PLANE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "White.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Everything white.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A twisted aluminum wing juts from a drift like a broken bone.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Wind scours the ridge.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ASTRID VESTERGAARD-NNAMDI, 30s, in a torn orange parka, kneels beside a battered satchel.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her face is cracked with cold.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "A tiny emergency radio sits in her lap, its antenna taped to a ski pole.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "She lifts it.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Presses the key.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "Releases.", "para": 2, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "Static.", "para": 3, "sent": 0, "present": [0]}, {"u": 12, "kind": "action", "text": "She tries again.", "para": 4, "sent": 0, "present": [0]}, {"u": 13, "kind": "action", "text": "Static.", "para": 4, "sent": 1, "present": [0]}, {"u": 14, "kind": "action", "text": "She sets it down.", "para": 5, "sent": 0, "present": [0]}, {"u": 15, "kind": "action", "text": "Breathes.", "para": 5, "sent": 1, "present": [0]}, {"u": 16, "kind": "action", "text": "Fumbles in the satchel, withdraws a small digital recorder, and presses PLAY.", "para": 5, "sent": 2, "present": [0]}, {"u": 17, "kind": "dialogue", "text": "Day two. I'm okay. Cold, but okay. I keep calling. Nobody answers.", "name": "ASTRID", "speaker": 0, "ext": ["V.O."], "paren": ["recording, scratchy"], "dual": false, "present": [0]}, {"u": 18, "kind": "action", "text": "She listens, eyes shut.", "para": 6, "sent": 0, "present": [0]}, {"u": 19, "kind": "dialogue", "text": "If you find this, tell Mom I wasn't scared.", "name": "ASTRID", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": ["recording"], "dual": false, "present": [0]}, {"u": 20, "kind": "action", "text": "Her mouth twists.", "para": 7, "sent": 0, "present": [0]}, {"u": 21, "kind": "action", "text": "She turns the recorder off.", "para": 7, "sent": 1, "present": [0]}, {"u": 22, "kind": "action", "text": "She looks at the wing.", "para": 8, "sent": 0, "present": [0]}, {"u": 23, "kind": "action", "text": "At the sky.", "para": 8, "sent": 1, "present": [0]}, {"u": 24, "kind": "action", "text": "At the ridge, where a shape, grey, hunched, sways.", "para": 8, "sent": 2, "present": [0]}, {"u": 25, "kind": "action", "text": "She stills.", "para": 9, "sent": 0, "present": [0]}, {"u": 26, "kind": "action", "text": "Her hand finds the pistol flare in her pocket.", "para": 9, "sent": 1, "present": [0]}, {"u": 27, "kind": "action", "text": "The shape resolves.", "para": 10, "sent": 0, "present": [0]}, {"u": 28, "kind": "action", "text": "A caribou.", "para": 10, "sent": 1, "present": [0]}, {"u": 29, "kind": "action", "text": "It stares.", "para": 10, "sent": 2, "present": [0]}, {"u": 30, "kind": "action", "text": "She stares.", "para": 10, "sent": 3, "present": [0]}, {"u": 31, "kind": "action", "text": "A moment of animal truce.", "para": 10, "sent": 4, "present": [0]}, {"u": 32, "kind": "action", "text": "It turns and ambles over the ridge.", "para": 11, "sent": 0, "present": [0]}, {"u": 33, "kind": "action", "text": "She lets out a shuddering breath, laughs once, short, ragged.", "para": 12, "sent": 0, "present": [0]}, {"u": 34, "kind": "action", "text": "The radio crackles.", "para": 13, "sent": 0, "present": [0]}, {"u": 35, "kind": "action", "text": "Three clicks.", "para": 14, "sent": 0, "present": [0]}, {"u": 36, "kind": "action", "text": "A pause.", "para": 14, "sent": 1, "present": [0]}, {"u": 37, "kind": "action", "text": "Three clicks again, from far away.", "para": 14, "sent": 2, "present": [0]}, {"u": 38, "kind": "action", "text": "She grabs it.", "para": 15, "sent": 0, "present": [0]}, {"u": 39, "kind": "action", "text": "Fumbles.", "para": 15, "sent": 1, "present": [0]}, {"u": 40, "kind": "action", "text": "Presses the key.", "para": 15, "sent": 2, "present": [0]}, {"u": 41, "kind": "dialogue", "text": "This is Astrid. This is Astrid Vestergaard. I'm alive.", "name": "ASTRID", "speaker": 0, "ext": [], "paren": ["hoarse"], "dual": false, "present": [0]}, {"u": 42, "kind": "action", "text": "She drops her head.", "para": 16, "sent": 0, "present": [0]}, {"u": 43, "kind": "action", "text": "Snow stings her cheek.", "para": 16, "sent": 1, "present": [0]}, {"u": 44, "kind": "action", "text": "She closes her eyes and listens to the radio.", "para": 17, "sent": 0, "present": [0]}]}