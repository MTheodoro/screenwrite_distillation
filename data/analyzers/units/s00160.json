{"scene_id": "s00160", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00160.fountain", "heading": "INT. DRIVE-THROUGH WEDDING CHAPEL - NIGHT", "cast": [{"id": 0, "name": "LENNY", "names": ["LENNY"], "gender": "m", "first": 5, "spoke": 12}, {"id": 1, "name": "ABIODUN", "names": ["ABIODUN"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "BIANCA STROZZI-OKORO", "names": ["BIANCA STROZZI-OKORO", "BIANCA"], "gender": "?", "first": 8, "spoke": 9}, {"id": 3, "name": "ELIAS NAKAMURA-FLORES", "names": ["ELIAS NAKAMURA-FLORES", "ELIAS"], "gender": "?", "first": 9, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRIVE-THROUGH WEDDING CHAPEL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Pink neon.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A window hatch cut into a stucco wall.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "An organ plays on a loop from a speaker on a post.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A plastic arch of roses.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Inside the booth: REVEREND-ISH LEONARD \"LENNY\" ABIODUN, 50s, in a rented robe, drinks from a paper cup.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "A car pulls up.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Headlights wash the arch.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Out of the driver's window leans BIANCA STROZZI-OKORO, 30s, in a white dress and a leather jacket.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "In the passenger seat sits ELIAS NAKAMURA-FLORES, 30s, bow tie crooked.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Welcome to the Chapel of Quick Vows. What's your order?", "name": "LENNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Two vows, no fries.", "name": "BIANCA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "We'd like the premium.", "name": "ELIAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "The premium has a rose.", "name": "LENNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Then give us the rose.", "name": "ELIAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Elias, we don't have time.", "name": "BIANCA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Bianca, the rose is five dollars.", "name": "ELIAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "It's a real rose.", "name": "LENNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "It's plastic.", "name": "BIANCA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "It's a real plastic rose.", "name": "LENNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "We'll take the rose.", "name": "ELIAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Bianca sighs.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Hands cash.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Lenny passes a rose through the window.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Elias holds it.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "She snatches it.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "They both laugh.", "para": 3, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Names?", "name": "LENNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Bianca Strozzi-Okoro.", "name": "BIANCA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Elias Nakamura-Flores.", "name": "ELIAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Do you, Elias, take this woman...", "name": "LENNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "I do.", "name": "ELIAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "I haven't finished.", "name": "LENNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "He knows the rest.", "name": "BIANCA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Do you, Bianca...", "name": "LENNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Absolutely.", "name": "BIANCA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "By the power vested in me by the state of Nevada and a two-day online course...", "name": "LENNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Lenny.", "name": "ELIAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "...I pronounce you...", "name": "LENNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Lenny!", "name": "BIANCA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "...married.", "name": "LENNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "The organ stutters.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Elias leans out and kisses Bianca.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "She grabs his lapel.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "The horn honks, long and joyful.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "That's twelve dollars, plus tip.", "name": "LENNY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "We have to talk about my mother.", "name": "BIANCA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "What about your mother?", "name": "ELIAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "She's in the back seat.", "name": "BIANCA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "A hand rises over the headrest.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "A tiny wave.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Lenny drops his cup.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}]}