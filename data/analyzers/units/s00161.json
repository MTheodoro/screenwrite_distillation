{"scene_id": "s00161", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00161.fountain", "heading": "INT. GENERATION SHIP \"MERIDIAN\" - SEED VAULT - SHIP'S NIGHT", "cast": [{"id": 0, "name": "CAPTAIN IFEOMA ROTHSCHILD-ADAMU", "names": ["CAPTAIN IFEOMA ROTHSCHILD-ADAMU", "IFEOMA"], "gender": "?", "first": 5, "spoke": 9}, {"id": 1, "name": "CHIEF BOTANIST HAKON LEIVESTAD", "names": ["CHIEF BOTANIST HAKON LEIVESTAD", "HAKON"], "gender": "?", "first": 6, "spoke": 4}, {"id": 2, "name": "ENGINEER PRAVEEN MBANDAKA-DOYLE", "names": ["ENGINEER PRAVEEN MBANDAKA-DOYLE", "PRAVEEN"], "gender": "?", "first": 7, "spoke": 2}, {"id": 3, "name": "TECHNICIAN SOLENNE ACHTERBERG-NGO", "names": ["TECHNICIAN SOLENNE ACHTERBERG-NGO", "SOLENNE"], "gender": "?", "first": 8, "spoke": 3}, {"id": 4, "name": "YUSUF KAZEMI-BROOKS", "names": ["YUSUF KAZEMI-BROOKS", "YUSUF"], "gender": "?", "first": 9, "spoke": 1}, {"id": 5, "name": "BRIDGE", "names": ["BRIDGE"], "gender": "?", "first": 31, "spoke": 1}, {"id": 6, "name": "COMMANDER DEWITT LARKSPUR-OSEI", "names": ["COMMANDER DEWITT LARKSPUR-OSEI"], "gender": "?", "first": 36, "spoke": 0}, {"id": 7, "name": "LARKSPUR", "names": ["LARKSPUR"], "gender": "m", "first": 36, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. GENERATION SHIP \"MERIDIAN\" - SEED VAULT - SHIP'S NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A frozen cavern of steel drawers, floor to ceiling.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Blue frost on the rails.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Breath fogs in the air.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Five crew in thermal suits, headlamps swinging, work a cart down the center aisle.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "CAPTAIN IFEOMA ROTHSCHILD-ADAMU, 50s, leads.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "CHIEF BOTANIST HAKON LEIVESTAD, 40s, carries a scanner.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "ENGINEER PRAVEEN MBANDAKA-DOYLE, 30s, hauls a toolbox.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "TECHNICIAN SOLENNE ACHTERBERG-NGO, 20s, monitors a wrist display.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "And YUSUF KAZEMI-BROOKS, 30s, medic, trails with a field kit.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Vault Four. Be quick. The air scrubbers fail in nine minutes.", "name": "IFEOMA", "speaker": 0, "ext": [], "paren": ["to all"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Drawer four-twelve.", "name": "HAKON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Four-twelve, four-twelve.", "name": "PRAVEEN", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Temperature's rising.", "name": "SOLENNE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "How much?", "name": "YUSUF", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Two degrees. In a minute.", "name": "SOLENNE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Move.", "name": "IFEOMA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "They reach the drawer.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Hakon scans.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Green light.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "He pulls.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Inside: row upon row of tiny vials, frosted white.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "The wheat.", "name": "HAKON", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Take it.", "name": "PRAVEEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "All of it.", "name": "HAKON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "He lifts a rack.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Hands it to Solenne.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "She slides it into a cooler.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Yusuf hovers, anxious.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "The ship shudders.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "A klaxon begins, low and pulsing.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Bridge, status.", "name": "IFEOMA", "speaker": 0, "ext": [], "paren": ["into her collar"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Captain, we've lost cooling on Deck Nine. You have six minutes.", "name": "BRIDGE", "speaker": 5, "ext": ["V.O."], "paren": ["radio, tinny"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Understood.", "name": "IFEOMA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "At the far end of the aisle, a hatch slides open.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "A figure steps through, silhouetted by red emergency light.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "COMMANDER DEWITT LARKSPUR-OSEI, 60s, black uniform, a sidearm drawn, stands in the doorway.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "dialogue", "text": "Nobody touches the seed.", "name": "LARKSPUR", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "action", "text": "The five crew freeze.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "action", "text": "Hakon, mid-lift, half-turns.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "action", "text": "Praveen's toolbox hits the floor.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 41, "kind": "action", "text": "Solenne steps back.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 42, "kind": "action", "text": "Yusuf raises both hands.", "para": 8, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 43, "kind": "action", "text": "Ifeoma does not move.", "para": 8, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 44, "kind": "dialogue", "text": "Commander. The vault is failing.", "name": "IFEOMA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 45, "kind": "dialogue", "text": "The vault is mine.", "name": "LARKSPUR", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 46, "kind": "dialogue", "text": "The ship will starve.", "name": "IFEOMA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 47, "kind": "dialogue", "text": "The ship will obey.", "name": "LARKSPUR", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 48, "kind": "action", "text": "A tense silence.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 49, "kind": "action", "text": "The klaxon pulses.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 50, "kind": "dialogue", "text": "Captain...", "name": "SOLENNE", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 51, "kind": "dialogue", "text": "Easy.", "name": "IFEOMA", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 52, "kind": "dialogue", "text": "The wheat is warming.", "name": "HAKON", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 53, "kind": "action", "text": "Ifeoma takes one slow step forward, palms open.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 54, "kind": "dialogue", "text": "Dewitt. We both took the oath.", "name": "IFEOMA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 55, "kind": "dialogue", "text": "I took it first.", "name": "LARKSPUR", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 56, "kind": "action", "text": "He steps closer.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 57, "kind": "action", "text": "The gun trembles.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 58, "kind": "dialogue", "text": "Then keep it. Open the lock. Let us take the seed.", "name": "IFEOMA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 59, "kind": "action", "text": "A beat.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 60, "kind": "action", "text": "Then Larkspur lowers his weapon.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 61, "kind": "action", "text": "Hand shaking, he pulls a keycard from his jacket and sweeps it over the panel.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 62, "kind": "action", "text": "A deep thunk.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 63, "kind": "action", "text": "The vault door opens wider.", "para": 12, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 64, "kind": "dialogue", "text": "Go.", "name": "LARKSPUR", "speaker": 7, "ext": [], "paren": ["hoarse"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 65, "kind": "action", "text": "They run.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 66, "kind": "action", "text": "The cart rattles.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 67, "kind": "action", "text": "Frost sprays from the wheels.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 68, "kind": "action", "text": "Behind them, the Commander stays by the hatch, watching them vanish into the dark with the ship's future in a cooler.", "para": 13, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}