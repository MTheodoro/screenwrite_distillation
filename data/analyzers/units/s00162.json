{"scene_id": "s00162", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00162.fountain", "heading": "EXT. SCHOOL BUS - RAILROAD CROSSING - DUSK", "cast": [{"id": 0, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "LOTTE FAIRBANKS-OJO", "names": ["LOTTE FAIRBANKS-OJO", "LOTTE"], "gender": "f", "first": 5, "spoke": 7}, {"id": 2, "name": "WENDELL", "names": ["WENDELL"], "gender": "f", "first": 23, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SCHOOL BUS - RAILROAD CROSSING - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "An old yellow bus sits dead on the tracks, hazards blinking.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The engine ticks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A signal bell dings in the distance.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A STRANGER, 17, in a letterman jacket, leans out of the open door.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside him, on the steps, sits LOTTE FAIRBANKS-OJO, 17, holding a trumpet case.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "It won't start.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "I noticed.", "name": "LOTTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Do you know cars?", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I know trumpets.", "name": "LOTTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He laughs.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She doesn't.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "The bell dings faster.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Far away, a train horn.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Okay. We should get off.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I'm not leaving my trumpet.", "name": "LOTTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "It's a trumpet.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "It was my grandfather's.", "name": "LOTTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He looks down the track.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "The light grows.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "He looks at her.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "What's your name?", "name": "STRANGER", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Lotte.", "name": "LOTTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Wendell. I mean, Wendell is my name. Wendell Dube.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Hi, Wendell.", "name": "LOTTE", "speaker": 1, "ext": [], "paren": ["deadpan"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Hi.", "name": "WENDELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The horn blares.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Closer.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "He grabs her arm.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "She grabs the trumpet.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Together they leap from the bus and roll down the gravel embankment.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Behind them, the train hits.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "A burst of yellow.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "A shower of steel.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Silence.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Lotte sits up, trumpet case clutched to her chest.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Wendell sits beside her, breathing hard.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Thanks.", "name": "LOTTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Sure.", "name": "WENDELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "She opens the case.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "The trumpet gleams, unscratched.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "She lifts it, blows a single, clean, brassy note.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "They stare at each other.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "And laugh.", "para": 9, "sent": 1, "present": [0, 1, 2]}]}