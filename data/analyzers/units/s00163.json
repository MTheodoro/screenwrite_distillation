{"scene_id": "s00163", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00163.fountain", "heading": "INT. PUDDING LANE BAKERY - NIGHT - 1666", "cast": [{"id": 0, "name": "MASTER THOMAS FARRIER-WELLS", "names": ["MASTER THOMAS FARRIER-WELLS", "THOMAS"], "gender": "m", "first": 6, "spoke": 5}, {"id": 1, "name": "MISTRESS GWENLLIAN FARRIER-WELLS", "names": ["MISTRESS GWENLLIAN FARRIER-WELLS", "GWENLLIAN"], "gender": "?", "first": 6, "spoke": 2}, {"id": 2, "name": "HOBB PETTIGREW", "names": ["HOBB PETTIGREW", "HOBB"], "gender": "?", "first": 8, "spoke": 2}, {"id": 3, "name": "JOAN MACKENZIE-AJAYI", "names": ["JOAN MACKENZIE-AJAYI", "JOAN"], "gender": "f", "first": 9, "spoke": 1}, {"id": 4, "name": "ABRAHAM BENVENISTE", "names": ["ABRAHAM BENVENISTE", "ABRAHAM"], "gender": "?", "first": 10, "spoke": 2}, {"id": 5, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 11, "spoke": 3}, {"id": 6, "name": "SILVANUS", "names": ["SILVANUS"], "gender": "m", "first": 25, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. PUDDING LANE BAKERY - NIGHT - 1666", "present": []}, {"u": 1, "kind": "action", "text": "A low-beamed oven room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Flour in the air.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Trays of unbaked loaves.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A hearth glowing orange.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Six people sit around a long table, sharing a late supper of bread and cheese by one candle.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "MASTER THOMAS FARRIER-WELLS, 50s, baker, at the head.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "His wife, MISTRESS GWENLLIAN FARRIER-WELLS, 40s.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Their journeyman, HOBB PETTIGREW, 20s.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "The maid, JOAN MACKENZIE-AJAYI, teens.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "A traveling cloth merchant, ABRAHAM BENVENISTE, 60s.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "And a young STRANGER in a green cloak, hood up.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Eat. There's more in the oven.", "name": "THOMAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "There is always more in the oven.", "name": "GWENLLIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Not if the master keeps counting.", "name": "HOBB", "speaker": 2, "ext": [], "paren": ["whispering to Joan"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "He counts crumbs.", "name": "JOAN", "speaker": 3, "ext": [], "paren": ["whispering back"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Abraham chuckles.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "The Stranger says nothing, breaking bread slowly.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Friend, you've eaten little.", "name": "ABRAHAM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "I'm saving room.", "name": "STRANGER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "For what?", "name": "ABRAHAM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "For the fire.", "name": "STRANGER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "A silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Thomas sets down his knife.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Sir?", "name": "THOMAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Forgive me. My name is Silvanus Carew. I serve the Lord Mayor. I came to warn you.", "name": "STRANGER", "speaker": 5, "ext": [], "paren": ["throwing back the hood"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "Of what?", "name": "GWENLLIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "Of this oven.", "name": "SILVANUS", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "My oven has stood thirty years.", "name": "THOMAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "My lord says the wind is wrong tonight.", "name": "SILVANUS", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "Thomas stares at him.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "Joan reaches for the poker, smothers the fire.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "Hobb, damp the hearth!", "name": "THOMAS", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "Master baker, damp the hearth!", "name": "SILVANUS", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "They speak at once, loud, and the silence afterward is a cliff.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "Master?", "name": "HOBB", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "Do it.", "name": "THOMAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "Hobb leaps to the hearth, dumps a bucket.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "Steam billows.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "The room goes grey.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "Everyone coughs.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "When it clears, Gwenllian is clutching Thomas's sleeve.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "Joan has her hand over her mouth.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "Abraham has risen.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "Silvanus is smiling, sadly, as he lowers his hood.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "Too late, I fear. The wind has already come.", "name": "SILVANUS", "speaker": 6, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "action", "text": "From beyond the shutters, faint, a bell begins to ring.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}]}