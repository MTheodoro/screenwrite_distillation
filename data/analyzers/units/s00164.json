{"scene_id": "s00164", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00164.fountain", "heading": "INT. MATTRESS SHOWROOM - DAY", "cast": [{"id": 0, "name": "CASSIUS BLACKWOOD-ADEYEMI", "names": ["CASSIUS BLACKWOOD-ADEYEMI", "CASSIUS"], "gender": "f", "first": 5, "spoke": 17}, {"id": 1, "name": "MARIGOLD DUPONT-ASANTE", "names": ["MARIGOLD DUPONT-ASANTE", "MARIGOLD"], "gender": "f", "first": 6, "spoke": 17}], "units": [{"u": 0, "kind": "heading", "text": "INT. MATTRESS SHOWROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A cavernous retail floor of identical beds under bright lights.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Price tags like confetti.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A banner: \"NOTHING DOWN!", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "EVERYTHING SOFT!\"", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CASSIUS BLACKWOOD-ADEYEMI, 40s, a sales manager in an ill-fitting suit, stands at a display bed holding a clipboard.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Opposite him, MARIGOLD DUPONT-ASANTE, 30s, a regional auditor with a briefcase, stands with her arms folded.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Welcome to Bedrock Mattress Gallery. May I interest you in a night of salvation?", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "I'm from corporate.", "name": "MARIGOLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Ah.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": ["sagging"], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I'm here to audit your sales.", "name": "MARIGOLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Of course.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "You're down sixty percent.", "name": "MARIGOLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "It's a down market.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Mattresses are never down.", "name": "MARIGOLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "They're flat, Marigold.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "That is not funny.", "name": "MARIGOLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "It's a little funny.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She walks the floor, scribbling.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He trails her, wringing his hands.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Where is everyone?", "name": "MARIGOLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Lunch.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "It's two p.m.", "name": "MARIGOLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Long lunch.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Cassius.", "name": "MARIGOLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Union.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "You don't have a union.", "name": "MARIGOLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "We have a book club.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "That's not the same.", "name": "MARIGOLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "They read a lot.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "She stops at a display bed.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Presses a hand to the mattress.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "It sighs.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "She pokes it.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Pokes again.", "para": 3, "sent": 4, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "This model is called the \"Cloud Nine\"?", "name": "MARIGOLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Yes.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "It's lumpy.", "name": "MARIGOLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "It's organic.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "She sits on the edge.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Tests it.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Lies back.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Her eyes drift shut.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Oh.", "name": "MARIGOLD", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Yes.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Oh, no.", "name": "MARIGOLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Corporate always says that.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "This is the best mattress I've ever laid on.", "name": "MARIGOLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Why do you think nobody's at lunch?", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "She sits up slowly.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "Cassius gestures behind her.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "Along the back wall, twelve employees lie on twelve mattresses, hands folded on their chests, eyes closed, perfectly still.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "A soft, collective snore rises.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "Marigold looks at them.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "Looks at her clipboard.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "Looks at Cassius.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "Slowly, she lowers the clipboard, takes off her shoes, and sets them neatly on the floor.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "Then she lies back down.", "para": 6, "sent": 4, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "How much?", "name": "MARIGOLD", "speaker": 1, "ext": ["CONT'D"], "paren": ["eyes closed"], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "Nothing down.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "Of course.", "name": "MARIGOLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "Cassius pulls a blanket from a rack and lays it over her.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "He tiptoes away, switching off the lights one by one.", "para": 7, "sent": 1, "present": [0, 1]}]}