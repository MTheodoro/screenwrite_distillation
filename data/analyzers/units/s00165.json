{"scene_id": "s00165", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00165.fountain", "heading": "INT. TAXIDERMY SHOP - BACK ROOM - NIGHT", "cast": [{"id": 0, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 5, "spoke": 2}, {"id": 1, "name": "PRIYA", "names": ["PRIYA"], "gender": "?", "first": 6, "spoke": 2}, {"id": 2, "name": "NAKASHIMA", "names": ["NAKASHIMA"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "BRONWYN OKORO-LINDHOLM", "names": ["BRONWYN OKORO-LINDHOLM", "BRONWYN"], "gender": "f", "first": 7, "spoke": 4}, {"id": 4, "name": "SOFIA CALDERON-BEAUMONT", "names": ["SOFIA CALDERON-BEAUMONT", "SOFIA"], "gender": "f", "first": 8, "spoke": 3}, {"id": 5, "name": "IMANI THOMPSON-REYES", "names": ["IMANI THOMPSON-REYES", "IMANI"], "gender": "?", "first": 9, "spoke": 2}, {"id": 6, "name": "WILLA ACHTERBERG", "names": ["WILLA ACHTERBERG", "WILLA"], "gender": "?", "first": 10, "spoke": 2}, {"id": 7, "name": "MARGUERITE", "names": ["MARGUERITE"], "gender": "?", "first": 30, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. TAXIDERMY SHOP - BACK ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped room hung with glass-eyed stags and mounted pheasants.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A sleepover in sleeping bags on a threadbare rug.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single lantern.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Six girls, thirteen and fourteen, cross-legged in a ring.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "A STRANGER among them, a girl none of the others quite remembers inviting, sits at the edge of the lantern's reach, face half in shadow.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "PRIYAMVADA \"PRIYA\" NAKASHIMA, 13, hugs a pillow.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "BRONWYN OKORO-LINDHOLM, 14, tells a story with a flashlight under her chin.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "SOFIA CALDERON-BEAUMONT, 13, braids her hair.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "IMANI THOMPSON-REYES, 14, flips through a magazine.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "And WILLA ACHTERBERG, 13, looks at the ceiling.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "...and the taxidermist never came home.", "name": "BRONWYN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "Stop.", "name": "SOFIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "They found him in his own shop, stuffed.", "name": "BRONWYN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "That's gross.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "That's the plot of a movie.", "name": "IMANI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "It's the plot of this shop.", "name": "BRONWYN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "Someone is standing behind the deer.", "name": "WILLA", "speaker": 6, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "action", "text": "Everyone looks.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "action", "text": "A stag's head hangs on the wall, its antlers throwing shadow.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "action", "text": "Nothing.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "There's no one.", "name": "SOFIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "I saw an eye.", "name": "WILLA", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "It's glass.", "name": "IMANI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "The lantern gutters.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "action", "text": "The Stranger leans forward.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "action", "text": "Her face enters the light: pale, calm, smiling.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "Do you want to know my name?", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "We thought you came with Sofia.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "I thought she came with you.", "name": "SOFIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "My name is Marguerite.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "dialogue", "text": "Marguerite is the name on the shop door.", "name": "BRONWYN", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "dialogue", "text": "Yes.", "name": "MARGUERITE", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "action", "text": "She rises.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "action", "text": "The ring of girls draws back.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "action", "text": "The lantern flickers out.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "action", "text": "In the dark, six pairs of eyes catch the last glint of the stag's glass stare.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "action", "text": "Then, one by one, they stop blinking.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}