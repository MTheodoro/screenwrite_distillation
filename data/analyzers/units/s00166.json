{"scene_id": "s00166", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00166.fountain", "heading": "INT. SALT MINE - CORPORATE RETREAT HALL - DAY", "cast": [{"id": 0, "name": "FELICITY ARMSTRONG-NWOSU", "names": ["FELICITY ARMSTRONG-NWOSU", "FELICITY"], "gender": "?", "first": 5, "spoke": 10}, {"id": 1, "name": "GIDEON PALAMARCHUK-DIOP", "names": ["GIDEON PALAMARCHUK-DIOP", "GIDEON"], "gender": "f", "first": 6, "spoke": 6}, {"id": 2, "name": "ANNELIESE VON TRAPP-OKAFOR", "names": ["ANNELIESE VON TRAPP-OKAFOR", "ANNELIESE"], "gender": "?", "first": 24, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. SALT MINE - CORPORATE RETREAT HALL - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A vaulted chamber a thousand feet underground, carved from white crystal.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "String lights.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Folding tables.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A flip chart reads \"OUR CULTURE: DEPTH.\"", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "FELICITY ARMSTRONG-NWOSU, 40s, a regional director in a hard hat and blazer, stands in front of the flip chart with a marker.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "At the table sits GIDEON PALAMARCHUK-DIOP, 30s, an analyst, glaring at the screen of a phone that has no signal.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "She taps the chart.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Depth. Roots. Foundation. Let's build this from the ground down.", "name": "FELICITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "We are literally underground.", "name": "GIDEON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Exactly.", "name": "FELICITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He sighs.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She writes \"TRUST\" in the margin and underlines it twice.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Trust.", "name": "FELICITY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He looks at the phone.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Looks at her.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Puts the phone away.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Okay. I trust you.", "name": "GIDEON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Do you?", "name": "FELICITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "No.", "name": "GIDEON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Good. That's honest.", "name": "FELICITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She sets down the marker.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "The mine hums with ventilation.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "The elevator door dings.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "A third person steps off, brisk and bright-eyed: ANNELIESE VON TRAPP-OKAFOR, 50s, a consultant in a white lab coat, carrying a wooden box.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "I'm sorry I'm late. The cage was slow.", "name": "ANNELIESE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Anneliese! We were just on trust.", "name": "FELICITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Wonderful. I brought the exercise.", "name": "ANNELIESE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "She sets the box on the table.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Opens it.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Inside, eight small salt crystals, glittering.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Each of you will pick one. Hold it. Tell me what it means.", "name": "ANNELIESE", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Gideon holds one up.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Peers at it.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Felicity takes another, hesitates, turns it over.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "It means my hands are cold.", "name": "GIDEON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Gideon.", "name": "ANNELIESE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "It means I miss the sun.", "name": "GIDEON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "That's a start.", "name": "ANNELIESE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "It means I have not seen my kids in a week.", "name": "FELICITY", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Silence.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Gideon looks at her.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "She stares at the crystal, not at him.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "That's the exercise.", "name": "ANNELIESE", "speaker": 2, "ext": [], "paren": ["gently"], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Is it?", "name": "FELICITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Yes.", "name": "ANNELIESE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Felicity blinks hard.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Gideon pulls a chair beside her.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "He doesn't say anything.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "After a moment, she sets the crystal down.", "para": 10, "sent": 3, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Let's go up.", "name": "FELICITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "The elevator doesn't run until four.", "name": "GIDEON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Then we'll wait.", "name": "FELICITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "They sit.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Anneliese packs the box.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "The lights hum.", "para": 11, "sent": 2, "present": [0, 1, 2]}]}