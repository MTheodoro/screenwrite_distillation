{"scene_id": "s00167", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00167.fountain", "heading": "INT. HOTEL BALLROOM - EMPTY - NIGHT", "cast": [{"id": 0, "name": "CONGRATULATIONS", "names": ["CONGRATULATIONS"], "gender": "?", "first": 3, "spoke": 0}, {"id": 1, "name": "BAZ", "names": ["BAZ"], "gender": "?", "first": 5, "spoke": 13}, {"id": 2, "name": "WOJCIECHOWSKI-OKAFOR", "names": ["WOJCIECHOWSKI-OKAFOR"], "gender": "?", "first": 5, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOTEL BALLROOM - EMPTY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Round tables, white cloths.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A raised dais.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A banner: \"CONGRATULATIONS, BARRY & PETRA.\"", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "Empty champagne flutes.", "para": 0, "sent": 3, "present": [0]}, {"u": 5, "kind": "action", "text": "BARRY \"BAZ\" WOJCIECHOWSKI-OKAFOR, 40s, in a rumpled tux, stands behind the microphone.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "A tape recorder sits on the podium beside him.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "He taps the mic.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Feedback.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Good evening, everyone. I'm Barry, the best man.", "name": "BAZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "He pauses.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Nobody is there.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Okay. Rehearsal.", "name": "BAZ", "speaker": 1, "ext": ["CONT'D"], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "He presses RECORD on the tape.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Clears his throat.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Petra and I go way back. To fourth grade, when she punched me in the face.", "name": "BAZ", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "He stops.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Presses STOP.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "REWIND.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "PLAY.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "...when she punched me in the face.", "name": "BAZ", "speaker": 1, "ext": ["V.O."], "paren": ["tape"], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "He winces.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Too violent.", "name": "BAZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "He presses RECORD again.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Petra and I go way back. To fourth grade, when she gave me a high-five.", "name": "BAZ", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "PLAY.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "...gave me a high-five.", "name": "BAZ", "speaker": 1, "ext": ["V.O."], "paren": ["tape"], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Too nice. She hit me.", "name": "BAZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "He sighs.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "RECORD.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "To the happy couple. May your marriage be like a good wine. Aged, complex, and occasionally bitter.", "name": "BAZ", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "PLAY.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "...occasionally bitter.", "name": "BAZ", "speaker": 1, "ext": ["V.O."], "paren": ["tape"], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Horrible. Terrible. Delete.", "name": "BAZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "He slumps over the podium.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Stares at the empty room.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Slowly, he straightens.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Petra. Barry. I'm so happy for you both. I mean it.", "name": "BAZ", "speaker": 1, "ext": ["CONT'D"], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "PLAY.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "I'm so happy for you both. I mean it.", "name": "BAZ", "speaker": 1, "ext": ["V.O."], "paren": ["tape, quiet"], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "He listens.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Nods once.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "He tucks the tape recorder into his pocket, adjusts his tie, and walks off the dais, whistling.", "para": 13, "sent": 2, "present": [0, 1, 2]}]}