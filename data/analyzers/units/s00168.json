{"scene_id": "s00168", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00168.fountain", "heading": "INT. MOUNTAIN VILLAGE DENTAL CLINIC - DAY", "cast": [{"id": 0, "name": "AMADEUS BRZEZINSKI-OYELARAN", "names": ["AMADEUS BRZEZINSKI-OYELARAN", "AMADEUS"], "gender": "?", "first": 5, "spoke": 6}, {"id": 1, "name": "ASSISTANT KALINDA ROSSITER-MWANGI", "names": ["ASSISTANT KALINDA ROSSITER-MWANGI", "KALINDA"], "gender": "?", "first": 6, "spoke": 1}, {"id": 2, "name": "ELDER ODYSSEUS PAPADAKIS-NGUYEN", "names": ["ELDER ODYSSEUS PAPADAKIS-NGUYEN", "ODYSSEUS"], "gender": "?", "first": 7, "spoke": 5}, {"id": 3, "name": "TEODORA", "names": ["TEODORA"], "gender": "?", "first": 8, "spoke": 0}, {"id": 4, "name": "JACOB", "names": ["JACOB"], "gender": "?", "first": 8, "spoke": 0}, {"id": 5, "name": "MIRIAM", "names": ["MIRIAM"], "gender": "f", "first": 8, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. MOUNTAIN VILLAGE DENTAL CLINIC - DAY", "present": []}, {"u": 1, "kind": "action", "text": "One chair.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "One lamp.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A window onto a goat pasture.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A bell tinkles.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. AMADEUS BRZEZINSKI-OYELARAN, 50s, white coat, mask, pulls on gloves.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Beside him, ASSISTANT KALINDA ROSSITER-MWANGI, 30s, lays out instruments.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "In the chair: the village headman, ELDER ODYSSEUS PAPADAKIS-NGUYEN, 70s, jaw clenched.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "At the door, three villagers wait: TEODORA, 30s; JACOB, 20s; and a child, MIRIAM, 8, clutching a goat-shaped toy.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "Open, please.", "name": "AMADEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "No.", "name": "ODYSSEUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Elder, I need to look.", "name": "AMADEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Look from there.", "name": "ODYSSEUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Sir. Just a peek.", "name": "KALINDA", "speaker": 1, "ext": [], "paren": ["gently"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "He opens.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Amadeus peers.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Tuts.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "That is the worst molar I have seen in thirty years.", "name": "AMADEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Thank you.", "name": "ODYSSEUS", "speaker": 2, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "It's not a compliment.", "name": "AMADEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "It is to me.", "name": "ODYSSEUS", "speaker": 2, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Calm.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "The clinic is bright and still.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "A goat bleats outside.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Teodora and Jacob exchange glances.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Miriam hugs her toy tighter.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Kalinda. Local.", "name": "AMADEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "She hands him the syringe.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "He lifts it.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "The elder's eyes widen.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "The villagers lean forward.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Suddenly, a roar from the pasture.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "The door slams open and a goat charges in, horns down, bell clanging, scattering Teodora and Jacob and Miriam, who scream and leap onto the waiting chairs.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "The goat skids on the tile, slams into the instrument tray.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Steel clatters.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "The elder bolts upright.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Amadeus drops the syringe.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Kalinda lunges for the goat.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "It dodges.", "para": 6, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Everyone shouts at once.", "para": 6, "sent": 6, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "That's my goat!", "name": "ODYSSEUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Your goat!", "name": "AMADEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "The goat, panting, plants itself in the dental chair, chewing a paper bib.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}