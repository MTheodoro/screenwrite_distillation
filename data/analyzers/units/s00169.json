{"scene_id": "s00169", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00169.fountain", "heading": "INT. CAR FERRY - UPPER DECK DINING ROOM - NIGHT", "cast": [{"id": 0, "name": "MATRIARCH ZAINAB ABDULLAHI-PREWITT", "names": ["MATRIARCH ZAINAB ABDULLAHI-PREWITT", "ZAINAB"], "gender": "f", "first": 5, "spoke": 6}, {"id": 1, "name": "CYRIL", "names": ["CYRIL"], "gender": "?", "first": 8, "spoke": 5}, {"id": 2, "name": "AUGUSTINE", "names": ["AUGUSTINE"], "gender": "?", "first": 8, "spoke": 4}, {"id": 3, "name": "PERPETUA", "names": ["PERPETUA"], "gender": "?", "first": 9, "spoke": 3}, {"id": 4, "name": "ROSAMUND", "names": ["ROSAMUND"], "gender": "?", "first": 10, "spoke": 2}, {"id": 5, "name": "THADDEUS", "names": ["THADDEUS"], "gender": "?", "first": 11, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. CAR FERRY - UPPER DECK DINING ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A long cafeteria table bolted to the floor.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fluorescent lights.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A view of black water.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The ferry throbs beneath them.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Six members of the Abdullahi-Prewitt family sit with trays of congealed shepherd's pie.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A funeral reception, after the funeral.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "MATRIARCH ZAINAB ABDULLAHI-PREWITT, 70s, at the head.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Her sons, CYRIL, 50s, and AUGUSTINE, 40s, glare across the table.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Cyril's wife, PERPETUA, 50s, grips her napkin.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Their daughter ROSAMUND, 20s, scrolls on her phone.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "And the youngest, THADDEUS, 16, keeps his eyes on the water.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Eat. He would have wanted us to eat.", "name": "ZAINAB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "He wanted the boat.", "name": "CYRIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "He wanted the boat sold.", "name": "AUGUSTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "He wanted it kept.", "name": "CYRIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Cyril, please.", "name": "PERPETUA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "You never listened to him.", "name": "AUGUSTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "I listened. I just disagreed.", "name": "CYRIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Can we not do this on a ferry?", "name": "ROSAMUND", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "We're not leaving a ferry.", "name": "THADDEUS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Quiet, all of you.", "name": "ZAINAB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "They are not quiet.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Dad's will says I sell it.", "name": "AUGUSTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Dad's will says I decide.", "name": "CYRIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Both of you, stop.", "name": "PERPETUA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "You always take his side.", "name": "AUGUSTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "I take no side. I take the family's.", "name": "PERPETUA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "There is no family.", "name": "ROSAMUND", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "I'm still here.", "name": "THADDEUS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "The ferry lurches over a wave.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Trays slide.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Zainab rises, steadies herself on the table.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Your father's will is in my purse. He wrote it on a napkin.", "name": "ZAINAB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "A napkin?", "name": "CYRIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "A napkin.", "name": "ZAINAB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "She opens her purse.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Withdraws a folded, grease-spotted paper napkin.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "She sets it down.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Flattens it.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Everyone leans in.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "\"Give the boat to whoever sails it.\"", "name": "ZAINAB", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "That's all.", "name": "ZAINAB", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Thaddeus rises, slowly.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "He crosses to the window.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "He looks out into the dark at the glow of the wheelhouse.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "I know how.", "name": "THADDEUS", "speaker": 5, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "The others look at him.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "For the first time all evening, nobody speaks.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}