{"scene_id": "s00171", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00171.fountain", "heading": "INT. LAUNDROMAT - NIGHT", "cast": [{"id": 0, "name": "BERNADETTE COLE", "names": ["BERNADETTE COLE", "BERNADETTE"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "NACHO", "names": ["NACHO"], "gender": "?", "first": 7, "spoke": 6}, {"id": 2, "name": "REYES", "names": ["REYES"], "gender": "?", "first": 7, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAUNDROMAT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dryers tumble.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "One flickering tube.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain on the glass.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "BERNADETTE COLE, 50s, folds a man's shirts.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Precise.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Too precise.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "IGNACIO \"NACHO\" REYES, 20s, enters, soaked, a duffel on his shoulder.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "He drops it.", "para": 1, "sent": 4, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Takes the seat across from her.", "para": 1, "sent": 5, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "She does not look up.", "para": 1, "sent": 6, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He sets a ring on the folding table.", "para": 1, "sent": 7, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "She folds a sleeve.", "para": 1, "sent": 8, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "He taps the ring.", "para": 1, "sent": 9, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "She smooths a collar.", "para": 1, "sent": 10, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "You're late.", "name": "BERNADETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Bus was slow.", "name": "NACHO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Eleven years, Ignacio. The bus was slow.", "name": "BERNADETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "I wrote you.", "name": "NACHO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "You wrote Dad. Dad's dead.", "name": "BERNADETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I know he's dead. I was in the room.", "name": "NACHO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "You were in the hallway.", "name": "BERNADETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Okay. The hallway. I was in the hallway, Bernie, because you told me not to come in. You said, quote, he doesn't want you here.", "name": "NACHO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "He didn't.", "name": "BERNADETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "He asked for me. The nurse told me.", "name": "NACHO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "The nurse didn't know him.", "name": "BERNADETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Neither did you.", "name": "NACHO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "She stops folding.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "A dryer buzzes.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Neither moves.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Then she sweeps the shirts off the table with one arm.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "They scatter across the floor.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Nacho stands, kicks the duffel, and the ring spins off the table and rolls under a machine.", "para": 2, "sent": 5, "present": [0, 1, 2]}]}