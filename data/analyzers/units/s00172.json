{"scene_id": "s00172", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00172.fountain", "heading": "INT. HOLLOW GIANT OAK - TWILIGHT", "cast": [{"id": 0, "name": "QUEEN ELSPETH", "names": ["QUEEN ELSPETH"], "gender": "f", "first": 4, "spoke": 4}, {"id": 1, "name": "SIR BRAM THORNWICK", "names": ["SIR BRAM THORNWICK", "SIR BRAM"], "gender": "?", "first": 7, "spoke": 3}, {"id": 2, "name": "PAGES", "names": ["PAGES"], "gender": "?", "first": 8, "spoke": 0}, {"id": 3, "name": "TWIG", "names": ["TWIG"], "gender": "?", "first": 8, "spoke": 1}, {"id": 4, "name": "NETTLE", "names": ["NETTLE"], "gender": "f", "first": 8, "spoke": 1}, {"id": 5, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 9, "spoke": 3}, {"id": 6, "name": "WRENNA", "names": ["WRENNA"], "gender": "?", "first": 20, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOLLOW GIANT OAK - TWILIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A throne room carved inside a dead tree.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Roots for pillars.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Fireflies in jars.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "QUEEN ELSPETH, 70s, sits wrapped in moss-green wool.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her crown is a ring of antlers.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "A cloaked FIGURE stands in the doorway, dripping.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "Beside the throne, SIR BRAM THORNWICK, 50s, one-armed knight, rests a hand on his hilt.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Two PAGES, TWIG and NETTLE, twins, 10, hide behind a root.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "I came about the debt.", "name": "STRANGER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Debts are paid at dawn. This is dusk.", "name": "QUEEN ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Then I'm early.", "name": "STRANGER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "Bram steps forward.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "Sword half drawn.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Name yourself.", "name": "SIR BRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "The Stranger lowers the hood.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "A woman, 30s, bark-pale skin, eyes like polished amber.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "You know it. Say it, Brammy.", "name": "STRANGER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Bram releases the sword.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Stares.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Wrenna.", "name": "SIR BRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "Wrenna Ashgrove. The tree-keeper's daughter. The one you left under the roots.", "name": "WRENNA", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "You were dead.", "name": "QUEEN ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "So were the roots, once.", "name": "WRENNA", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "Twig whispers to Nettle.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "action", "text": "Nettle shushes her.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "Is she a ghost?", "name": "TWIG", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "Ghosts don't drip.", "name": "NETTLE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "Wrenna sets a small acorn on the floor.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "It cracks.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "A green shoot unfurls, and stops.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "Wilts.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "action", "text": "She sighs.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "I thought I'd have more left.", "name": "WRENNA", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "Sit, child.", "name": "QUEEN ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "Wrenna sits on a root.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "Elspeth sets her crown aside.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "The debt is forgiven.", "name": "QUEEN ELSPETH", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "dialogue", "text": "I didn't come to be forgiven.", "name": "WRENNA", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "Then what?", "name": "SIR BRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "To see it. Once. Before it falls.", "name": "WRENNA", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "The fireflies dim, one jar at a time.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}]}