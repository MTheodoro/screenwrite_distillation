{"scene_id": "s00174", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00174.fountain", "heading": "INT. STALLED FERRIS WHEEL GONDOLA - NIGHT", "cast": [{"id": 0, "name": "GUS", "names": ["GUS"], "gender": "m", "first": 4, "spoke": 3}, {"id": 1, "name": "FELLOWES", "names": ["FELLOWES"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "TAMSIN OYELARAN", "names": ["TAMSIN OYELARAN", "TAMSIN"], "gender": "f", "first": 5, "spoke": 3}, {"id": 3, "name": "MAN IN YELLOW RAINCOAT", "names": ["MAN", "MAN IN YELLOW RAINCOAT"], "gender": "?", "first": 6, "spoke": 2}, {"id": 4, "name": "YELLOW RAINCOAT", "names": ["YELLOW RAINCOAT"], "gender": "?", "first": 6, "spoke": 0}, {"id": 5, "name": "PIKE", "names": ["PIKE"], "gender": "?", "first": 24, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. STALLED FERRIS WHEEL GONDOLA - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dead carnival below.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fog.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The gondola sways.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "AUGUSTA \"GUS\" FELLOWES, 60s, retired carny, grips the rail.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Across from him, TAMSIN OYELARAN, 20s, scrolls a dead phone.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "Beside her, a MAN IN A YELLOW RAINCOAT, face hidden under a hood, sits perfectly still.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "dialogue", "text": "Operator'll be back. They always come back.", "name": "GUS", "speaker": 0, "ext": [], "paren": ["to both"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "Who's they?", "name": "TAMSIN", "speaker": 2, "ext": [], "paren": ["to Gus"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Nobody. Nobody's there.", "name": "GUS", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Something below laughs.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Tinny.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Calliope music starts, off-key.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Do you hear that?", "name": "TAMSIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "The Man in the Yellow Raincoat lifts his head.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Ticket, please.", "name": "MAN IN YELLOW RAINCOAT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Gus pats his pockets.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Tamsin shakes her head.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "We didn't buy tickets.", "name": "TAMSIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Everyone buys one.", "name": "MAN IN YELLOW RAINCOAT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "The hood falls back.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Painted grin.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "No eyes.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Gus grabs Tamsin's wrist.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Pike. It's Pike. Not again.", "name": "GUS", "speaker": 0, "ext": [], "paren": ["low, to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "You remember me, Gus.", "name": "PIKE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "The gondola drops a foot.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Stops.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "The grin widens.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}