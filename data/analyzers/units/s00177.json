{"scene_id": "s00177", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00177.fountain", "heading": "INT. DRIED-OUT PLANETARIUM - NIGHT", "cast": [{"id": 0, "name": "DETECTIVE IMOGEN SALAZAR", "names": ["DETECTIVE IMOGEN SALAZAR", "IMOGEN"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "REYNALD KOWALSKI", "names": ["REYNALD KOWALSKI", "REYNALD"], "gender": "m", "first": 5, "spoke": 4}, {"id": 2, "name": "CURATOR ASTRID LUNDGREN", "names": ["CURATOR ASTRID LUNDGREN", "ASTRID"], "gender": "?", "first": 6, "spoke": 6}, {"id": 3, "name": "SECURITY GUARD BASHIR HALLOWAY", "names": ["SECURITY GUARD BASHIR HALLOWAY", "BASHIR"], "gender": "?", "first": 7, "spoke": 3}, {"id": 4, "name": "CORONER", "names": ["CORONER"], "gender": "?", "first": 19, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRIED-OUT PLANETARIUM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dome overhead.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cracked seats.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Projector dust under a single work light.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DETECTIVE IMOGEN SALAZAR, 40s, crouches by a chalk outline.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her partner, DET. REYNALD KOWALSKI, 50s, eats sunflower seeds.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "CURATOR ASTRID LUNDGREN, 60s, stands arms folded.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "SECURITY GUARD BASHIR HALLOWAY, 30s, lingers by the door.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "A voice crackles on Imogen's radio.", "para": 1, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Nobody touched the projector?", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Nobody has touched it in years.", "name": "ASTRID", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Then who turned it on?", "name": "REYNALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Wasn't me. I was at the front desk.", "name": "BASHIR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "He was at the desk. I saw him.", "name": "ASTRID", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "You saw him at the desk at ten. Victim died at ten-thirty.", "name": "REYNALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "I was at the desk until eleven.", "name": "BASHIR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Quiet, all of you.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "The room goes still.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Imogen presses the radio.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Imogen, the stars on his jacket. They're real stars. Pins. Constellation of Orion.", "name": "CORONER", "speaker": 4, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Orion?", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Orion is the show we never finished.", "name": "ASTRID", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "The projector hums to life.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Above them, the dome blooms with stars.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Orion rises.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Bashir takes a step back.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Who's in the booth?", "name": "REYNALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "No one. It's automatic.", "name": "ASTRID", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "It's not automatic. Not anymore.", "name": "BASHIR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Bashir. How would you know that?", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Bashir does not answer.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "The stars drift.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Reynald draws his weapon.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Astrid draws a breath.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "It was supposed to be a tribute.", "name": "ASTRID", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "To who?", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "To the man in the outline. Yours truly built that show. I built it for him.", "name": "ASTRID", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Reynald lowers the gun a few inches, then raises it again, pointing at Astrid.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Ma'am, step away from the console.", "name": "REYNALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}