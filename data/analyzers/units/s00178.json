 11, "kind": "dialogue", "text": "He can't stay.", "name": "LARS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Soup. Only soup left. Sure.", "name": "DEEPAK", "speaker": 2, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Finn slowly turns from the horizon.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Dad, the ice is cracking.", "name": "FINN", "speaker": 3, "ext": [], "paren": ["to Lars"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "It's always cracking.", "name": "LARS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Louder, this time.", "name": "FINN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Lars glances down at the wrapped shape, then at Eleni.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "She holds his gaze and gently pulls the blanket over the face.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Lars takes off his gloves.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Puts them on Finn.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Hold these for me.", "name": "LARS", "speaker": 0, "ext": [], "paren": ["quiet, to Finn"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "He walks to the sled and begins loading it.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}]}