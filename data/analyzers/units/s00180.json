{"scene_id": "s00180", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00180.fountain", "heading": "INT. ABANDONED LIGHTHOUSE - LENS ROOM - NIGHT", "cast": [{"id": 0, "name": "DETECTIVE NADIA KOROMA", "names": ["DETECTIVE NADIA KOROMA", "NADIA"], "gender": "?", "first": 3, "spoke": 5}, {"id": 1, "name": "UNIFORM OFFICER TREVOR LANE", "names": ["UNIFORM OFFICER TREVOR LANE", "TREVOR"], "gender": "?", "first": 4, "spoke": 2}, {"id": 2, "name": "HARBORMASTER OSWALD PRIEST", "names": ["HARBORMASTER OSWALD PRIEST", "OSWALD"], "gender": "?", "first": 5, "spoke": 3}, {"id": 3, "name": "PHILIPPA ACHTERBERG", "names": ["PHILIPPA ACHTERBERG", "DR. ACHTERBERG"], "gender": "?", "first": 14, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED LIGHTHOUSE - LENS ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Wind howls through broken glass.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A crushed lantern lies on its side.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "DETECTIVE NADIA KOROMA, 40s, kneels by a body-shaped tarp.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "UNIFORM OFFICER TREVOR LANE, 20s, holds a flashlight.", "para": 0, "sent": 3, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "HARBORMASTER OSWALD PRIEST, 60s, stands dripping in the doorway.", "para": 0, "sent": 4, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Time of death?", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Coroner says midnight.", "name": "TREVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Midnight? I was here at midnight.", "name": "OSWALD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "You were here?", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Checking the light. It was out.", "name": "OSWALD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "It's always out.", "name": "TREVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Mr. Priest, did you see anyone?", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Footsteps on the spiral stair.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "DR. PHILIPPA ACHTERBERG, 50s, in a rain slicker, climbs into the room, medical bag in hand.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Don't touch the tarp.", "name": "DR. ACHTERBERG", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Doctor.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "That's not the coroner.", "name": "OSWALD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "I'm his sister. I came for the body.", "name": "DR. ACHTERBERG", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Your brother's dead?", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Achterberg lowers the bag.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Oswald looks at the floor.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Trevor looks at Nadia.", "para": 2, "sent": 