{"scene_id": "s00182", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00182.fountain", "heading": "INT. OBSERVATORY BALLROOM - NIGHT", "cast": [{"id": 0, "name": "CELESTE MARCHETTI", "names": ["CELESTE MARCHETTI", "CELESTE"], "gender": "?", "first": 5, "spoke": 5}, {"id": 1, "name": "JULIAN VOSS", "names": ["JULIAN VOSS", "JULIAN"], "gender": "f", "first": 6, "spoke": 5}, {"id": 2, "name": "WAITER", "names": ["WAITER"], "gender": "?", "first": 7, "spoke": 2}, {"id": 3, "name": "ISOLDE FAIRWEATHER", "names": ["ISOLDE FAIRWEATHER", "ISOLDE"], "gender": "?", "first": 8, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. OBSERVATORY BALLROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A gala under a brass telescope.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Strings tune.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Champagne flutes glint.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Couples drift to the dance floor.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CELESTE MARCHETTI, 30s, stands alone by the window in a green gown.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her ex, JULIAN VOSS, 30s, enters in a tuxedo, hesitates, then crosses to her.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "A WAITER, 20s, passes with a tray.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Behind them, ISOLDE FAIRWEATHER, 60s, Celeste's aunt, watches over her fan.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "You came.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "You invited me.", "name": "CELESTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I didn't think you'd say yes.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Celeste, darling, the cake!", "name": "ISOLDE", "speaker": 3, "ext": [], "paren": ["calling over"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "In a minute, Auntie.", "name": "CELESTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "The waiter offers a flute.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Julian takes two.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Hands one to her.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Compliments of the house.", "name": "WAITER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "To old times.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "To new ones.", "name": "CELESTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Julian, you've gotten thin.", "name": "ISOLDE", "speaker": 3, "ext": [], "paren": ["approaching"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Hello, Isolde.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Are you eating?", "name": "ISOLDE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Auntie.", "name": "CELESTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "The music swells.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Julian offers a hand.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "She looks at it.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Behind her, Isolde fans faster.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "The waiter retreats.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "One dance.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "One.", "name": "CELESTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "She takes it.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "They step into the crowd, stiff at first, then not.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Isolde lowers the fan and sighs.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "The waiter sets down his tray and leaves it.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Fetch the cake knife, would you? She'll want it later.", "name": "ISOLDE", "speaker": 3, "ext": [], "paren": ["to the waiter"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Ma'am?", "name": "WAITER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "I said she'd want it. Go.", "name": "ISOLDE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}