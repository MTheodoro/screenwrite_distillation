{"scene_id": "s00185", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00185.fountain", "heading": "EXT. SINKING FISHING TRAWLER - DECK - DAWN", "cast": [{"id": 0, "name": "CAPTAIN IMELDA DRAGOMIR", "names": ["CAPTAIN IMELDA DRAGOMIR", "IMELDA"], "gender": "f", "first": 4, "spoke": 2}, {"id": 1, "name": "DEACON PRICE", "names": ["DEACON PRICE", "DEACON"], "gender": "?", "first": 5, "spoke": 1}, {"id": 2, "name": "OLU ABIODUN", "names": ["OLU ABIODUN", "OLU"], "gender": "?", "first": 6, "spoke": 1}, {"id": 3, "name": "SANTI", "names": ["SANTI"], "gender": "?", "first": 7, "spoke": 1}, {"id": 4, "name": "VEGA", "names": ["VEGA"], "gender": "?", "first": 7, "spoke": 0}, {"id": 5, "name": "LIN HUANG", "names": ["LIN HUANG"], "gender": "?", "first": 8, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SINKING FISHING TRAWLER - DECK - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "The boat tilts at ten degrees.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Gray water sloshes at the rails.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A radio mast leans.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CAPTAIN IMELDA DRAGOMIR, 50s, leathery, in yellow oilskins, stands at the wheelhouse door, counting heads with her finger.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "DEACON PRICE, 20s, deckhand, drags a blue cooler across the planks.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "OLU ABIODUN, 40s, engineer, slumps against a winch, hands black with oil.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "SANTIAGO \"SANTI\" VEGA, 30s, cook, bails with a saucepan.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "A girl, LIN HUANG, 12, the captain's niece, sits cross-legged on a coil of rope with a life vest two sizes too big.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "Raft's inflated. Ten minutes.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "We said that twenty minutes ago.", "name": "DEACON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Pump's dead.", "name": "OLU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Saucepan's not.", "name": "SANTI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "Lin tightens a strap.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "Nobody hurries.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Imelda hands Lin a granola bar.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Eat. It's a long wait.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}