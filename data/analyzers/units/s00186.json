{"scene_id": "s00186", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00186.fountain", "heading": "INT. PAPER LANTERN FACTORY - EVENING", "cast": [{"id": 0, "name": "MEI-LING TSAI", "names": ["MEI-LING TSAI", "MEI-LING"], "gender": "f", "first": 4, "spoke": 3}, {"id": 1, "name": "DANIEL OKORO", "names": ["DANIEL OKORO", "DANIEL"], "gender": "?", "first": 5, "spoke": 2}, {"id": 2, "name": "AUNTIE FEN", "names": ["AUNTIE FEN"], "gender": "f", "first": 6, "spoke": 0}, {"id": 3, "name": "JASPER TSAI", "names": ["JASPER TSAI"], "gender": "m", "first": 4, "spoke": 0}, {"id": 4, "name": "GRACE OKORO", "names": ["GRACE OKORO", "GRACE"], "gender": "f", "first": 5, "spoke": 1}, {"id": 5, "name": "FOREMAN", "names": ["FOREMAN"], "gender": "?", "first": 9, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. PAPER LANTERN FACTORY - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Hundreds of unlit lanterns hang from the rafters like pale moons.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Long tables, glue pots, bamboo ribs.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "One window glows orange.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MEI-LING TSAI, 30s, in a paint-spattered smock, glues a seam.", "para": 1, "sent": 0, "present": [0, 3]}, {"u": 5, "kind": "action", "text": "Her fiance, DANIEL OKORO, 30s, in a suit, stands at the door with a small box.", "para": 1, "sent": 1, "present": [0, 1, 3, 4]}, {"u": 6, "kind": "action", "text": "MEI-LING's mother, AUNTIE FEN, 60s, folds paper at the next table.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "action", "text": "Her brother, JASPER TSAI, 20s, hauls a crate.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "Daniel's mother, GRACE OKORO, 60s, sits near the stove with tea.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "A FOREMAN, 50s, watches from the loft.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "You said seven.", "name": "DANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Lanterns don't glue themselves.", "name": "MEI-LING", "speaker": 0, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "Daniel sets the box on the table.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "It sits there.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "Fen pretends not to look.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Jasper drops the crate.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Everyone freezes.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Grace sets down her tea.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Daniel. The box.", "name": "GRACE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "He's just stopping by.", "name": "MEI-LING", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "I'm not.", "name": "DANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "He opens the box.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "A ring.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Mei-Ling presses the seam flat with her thumb.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Holds it.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Holds it longer.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Do we light them or not?", "name": "FOREMAN", "speaker": 5, "ext": [], "paren": ["from the loft"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Not yet.", "name": "MEI-LING", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "She sets the lantern on the table, turns, and takes the ring from the box.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Then she walks to the window, holds it up to the orange light, and the room waits.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Fen drops her paper.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Jasper stares at his shoes.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Grace smiles into her tea.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "The Foreman strikes a match.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}