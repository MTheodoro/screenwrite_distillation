{"scene_id": "s00188", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00188.fountain", "heading": "INT. ROLLER RINK - SNACK BAR - NIGHT", "cast": [{"id": 0, "name": "PAZ ORTEGA-WILLIAMS", "names": ["PAZ ORTEGA-WILLIAMS", "PAZ"], "gender": "?", "first": 4, "spoke": 9}, {"id": 1, "name": "KIRA SINGH", "names": ["KIRA SINGH", "KIRA"], "gender": "f", "first": 5, "spoke": 6}, {"id": 2, "name": "DEWEY LAMBERT", "names": ["DEWEY LAMBERT", "DEWEY"], "gender": "m", "first": 6, "spoke": 5}, {"id": 3, "name": "ARLO HOLLOWAY", "names": ["HOLLOWAY", "ARLO HOLLOWAY"], "gender": "f", "first": 7, "spoke": 0}, {"id": 4, "name": "TALL STRANGER", "names": ["TALL STRANGER"], "gender": "?", "first": 24, "spoke": 0}, {"id": 5, "name": "MAX", "names": ["MAX"], "gender": "?", "first": 25, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROLLER RINK - SNACK BAR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Disco ball scatters light.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Neon trim.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Under the music, wheels rumble on wood.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "PAZ ORTEGA-WILLIAMS, 17, in rental skates, leans on the counter.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her best friend, KIRA SINGH, 17, steals fries from her basket.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "DEWEY LAMBERT, 18, behind the counter in a paper hat, wipes it down.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "At a nearby table, BEATRICE \"BEE\" HOLLOWAY, 16, sketches in a notebook, and her brother, ARLO HOLLOWAY, 14, sips a slushie.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Okay, but if I ask him and he says no, I have to move to another state.", "name": "PAZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "You are not moving to another state.", "name": "KIRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Then I'm dying. Those are the options.", "name": "PAZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "He's right there. Dewey. Dewey!", "name": "KIRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Hey. Sorry. I was in the fryer zone.", "name": "DEWEY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Kill me.", "name": "PAZ", "speaker": 0, "ext": [], "paren": ["low, to Kira"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "She wants to know if you're going to the thing on Saturday.", "name": "KIRA", "speaker": 1, "ext": [], "paren": ["to Dewey"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "The thing?", "name": "DEWEY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "The thing. At the quarry.", "name": "PAZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Oh. The quarry. Yeah, probably. Maybe. Why?", "name": "DEWEY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "No reason. Just curious.", "name": "PAZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "She has a reason.", "name": "KIRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "I do not.", "name": "PAZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Dewey leans his elbows on the counter.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Kira bounces on her skates.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Bee tears a page from her notebook and slides it across the table to Arlo, who pockets it.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "A TALL STRANGER, 20s, in a leather jacket and black skates, glides up behind Paz and taps her shoulder.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "This is MAXIMILIAN \"MAX\" DUBOIS.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Paz turns.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Her face does something complicated.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Paz. You never called.", "name": "MAX", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Max. I was going to.", "name": "PAZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Oh no.", "name": "KIRA", "speaker": 1, "ext": [], "paren": ["under her breath"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Who's this?", "name": "DEWEY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Her ex.", "name": "MAX", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Oh.", "name": "DEWEY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "He's not my ex. We went out twice. Once. Once and a half.", "name": "PAZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "You left in the middle of the second one.", "name": "MAX", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "I was sick.", "name": "PAZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "You were laughing.", "name": "MAX", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Bee smiles into her slushie.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Arlo whispers to her.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Dewey slowly picks up a rag and starts wiping the counter again, harder.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Kira looks from one face to another, delighted and horrified.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Anyone want fries?", "name": "KIRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}