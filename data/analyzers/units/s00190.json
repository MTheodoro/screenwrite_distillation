{"scene_id": "s00190", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00190.fountain", "heading": "INT. CABLE CAR CABIN - ALPINE GORGE - NIGHT", "cast": [{"id": 0, "name": "SOLVEIG RASMUSSEN", "names": ["SOLVEIG RASMUSSEN", "SOLVEIG"], "gender": "f", "first": 4, "spoke": 7}, {"id": 1, "name": "AGENT KAZIMIR DOBRYNIN", "names": ["AGENT KAZIMIR DOBRYNIN", "KAZIMIR"], "gender": "m", "first": 5, "spoke": 11}, {"id": 2, "name": "LUCIEN FAUREAU", "names": ["LUCIEN FAUREAU", "LUCIEN"], "gender": "?", "first": 6, "spoke": 5}, {"id": 3, "name": "TAMARA QUINN", "names": ["TAMARA QUINN", "TAMARA"], "gender": "m", "first": 7, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. CABLE CAR CABIN - ALPINE GORGE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A glass box suspended over blackness.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wind buffets it.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Lights of a village glimmer far below.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. SOLVEIG RASMUSSEN, 40s, grips a metal briefcase.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Opposite her, AGENT KAZIMIR DOBRYNIN, 50s, sits calm, a pistol in his lap.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "LUCIEN FAUREAU, 30s, the operator, huddles near the control panel.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "TAMARA QUINN, 20s, a journalist with a camera, crouches by the door.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Static from the radio.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "The cabin lurches and stops.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Why did we stop?", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Wind. It trips the brake.", "name": "LUCIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "The wind did not trip it.", "name": "KAZIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Lucien checks the panel.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Tamara lifts the camera and starts filming.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Kazimir slides a hand over the lens.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "No.", "name": "KAZIMIR", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Public interest.", "name": "TAMARA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Private interest. Mine.", "name": "KAZIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Solveig edges the briefcase behind her knees.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Kazimir notices.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "He raises the pistol, not at her, but at the ceiling.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "A single shot cracks the roof light.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Wind shrieks in.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Lucien dives for the floor.", "para": 4, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Tamara drops the camera.", "para": 4, "sent": 6, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "It skids to the door and tumbles out of a gap.", "para": 4, "sent": 7, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Solveig lunges for the pistol, and Kazimir catches her wrist.", "para": 4, "sent": 8, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "They struggle.", "para": 4, "sent": 9, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "The cabin swings.", "para": 4, "sent": 10, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Let go.", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "The case, Doctor.", "name": "KAZIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "It's not yours.", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "It was never yours.", "name": "KAZIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Lucien crawls toward the panel.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Tamara grabs his ankle.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "What are you doing?", "name": "TAMARA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Restarting the brake.", "name": "LUCIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Don't. He'll kill us.", "name": "TAMARA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "He'll kill us anyway.", "name": "LUCIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "He hits a lever.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "The cabin lurches forward.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Kazimir loses his balance.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Solveig wrenches the pistol free, and it clatters across the floor.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Tamara scoops it up and aims at Kazimir with both hands.", "para": 6, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Sit down.", "name": "TAMARA", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "You will not shoot.", "name": "KAZIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Try me.", "name": "TAMARA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Kazimir sits.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Solveig flips the case open: nothing inside but a photograph.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Lucien stares at it.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Kazimir smiles.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "You wanted a photograph?", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "I wanted the man in it.", "name": "KAZIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Solveig turns it over.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "A name.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Her own.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "The cabin glides on into the dark.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "We're ten minutes from the station.", "name": "LUCIEN", "speaker": 2, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "Then we have ten minutes.", "name": "TAMARA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "For what?", "name": "KAZIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "For you to talk.", "name": "TAMARA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "Kazimir says nothing.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "The wind drops.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "Solveig steadies herself on the rail and holds the photograph up to the light.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "The faces blur.", "para": 9, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "The village grows closer below.", "para": 9, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "Who sent you?", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "The man who took your picture.", "name": "KAZIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "dialogue", "text": "My father took that picture.", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "dialogue", "text": "Yes.", "name": "KAZIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "Tamara's grip on the pistol tightens.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "action", "text": "Lucien checks the panel.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "action", "text": "The cabin hums.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "A light on the dock ahead flashes red.", "para": 10, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "dialogue", "text": "Station's alerted.", "name": "LUCIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "dialogue", "text": "They'll be waiting.", "name": "TAMARA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "Kazimir shrugs.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "action", "text": "Solveig folds the photograph into her coat.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "action", "text": "The cabin glides into the dock.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "action", "text": "The door slides open.", "para": 11, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "action", "text": "Armed uniformed men fill the platform.", "para": 11, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "dialogue", "text": "Doctor. Ask them whose uniforms those are.", "name": "KAZIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "action", "text": "Solveig looks.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 84, "kind": "action", "text": "Her face falls.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 85, "kind": "action", "text": "She takes a step back.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 86, "kind": "dialogue", "text": "Those are my father's.", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}