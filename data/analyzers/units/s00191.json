{"scene_id": "s00191", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00191.fountain", "heading": "INT. DERELICT SPACE ELEVATOR CAR - ORBITAL TETHER - CONTINUOUS", "cast": [{"id": 0, "name": "SPARROW", "names": ["SPARROW"], "gender": "f", "first": 4, "spoke": 7}, {"id": 1, "name": "ADEBAYO", "names": ["ADEBAYO"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "TOBY", "names": ["TOBY"], "gender": "?", "first": 5, "spoke": 4}, {"id": 3, "name": "ZHANG", "names": ["ZHANG"], "gender": "?", "first": 5, "spoke": 0}, {"id": 4, "name": "MAJOR DELPHINE VOSKUIJLEN", "names": ["MAJOR DELPHINE VOSKUIJLEN", "DELPHINE"], "gender": "?", "first": 6, "spoke": 3}, {"id": 5, "name": "GIDEON FAIRCHILD", "names": ["GIDEON FAIRCHILD", "GIDEON"], "gender": "?", "first": 7, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. DERELICT SPACE ELEVATOR CAR - ORBITAL TETHER - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Cramped.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Frost on the windows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Earth hangs below like a blue coin.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CAPTAIN IRIS \"SPARROW\" ADEBAYO, 40s, floats at the console.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Her engineer, TOBIAS \"TOBY\" ZHANG, 30s, clings to a ladder.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "action", "text": "MAJOR DELPHINE VOSKUIJLEN, 50s, a medic, holds a sedated passenger's wrist.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "action", "text": "The passenger, GIDEON FAIRCHILD, 70s, drifts asleep, tethered to a seat.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "dialogue", "text": "Toby, how's the cable?", "name": "SPARROW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "Thinner than I'd like, Sparrow.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "His pulse is slowing.", "name": "DELPHINE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "Sparrow does not look up.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "She taps a screen.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "It blinks red.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Delphine, can you wake him?", "name": "SPARROW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "I can. I shouldn't.", "name": "DELPHINE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Do it anyway.", "name": "SPARROW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Delphine unclips a syringe.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Toby watches her hand, then looks away.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "The car shudders.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "We're losing altitude.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "We were never gaining.", "name": "SPARROW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Delphine injects Gideon.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "He stirs.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "His eyes open slowly.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Iris? Is that you?", "name": "GIDEON", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "It's me, Dad.", "name": "SPARROW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Gideon smiles faintly and drifts back to sleep.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Sparrow sets her jaw and turns to the console.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Toby. Cut the cable.", "name": "SPARROW", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Sparrow.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Cut it.", "name": "SPARROW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Toby draws a cutter from his belt.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "He floats to the hatch and stops there, hand on the latch, looking back at Delphine.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "It's the right call.", "name": "DELPHINE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "That's what I'm afraid of.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "He opens the hatch.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}