{"scene_id": "s00192", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00192.fountain", "heading": "EXT. DUST-BOWL GHOST TOWN - MAIN STREET - HIGH NOON", "cast": [{"id": 0, "name": "MARSHAL JEBEDIAH CROW", "names": ["MARSHAL JEBEDIAH CROW", "JEBEDIAH"], "gender": "m", "first": 4, "spoke": 5}, {"id": 1, "name": "OLETA BAINBRIDGE", "names": ["OLETA BAINBRIDGE", "OLETA"], "gender": "f", "first": 5, "spoke": 5}, {"id": 2, "name": "SISTER MARGUERITE", "names": ["SISTER MARGUERITE"], "gender": "?", "first": 6, "spoke": 4}, {"id": 3, "name": "PETEY NAKAMURA", "names": ["PETEY NAKAMURA", "PETEY"], "gender": "m", "first": 7, "spoke": 1}, {"id": 4, "name": "DEPUTY HOLLIS WAKEFIELD", "names": ["DEPUTY HOLLIS WAKEFIELD"], "gender": "m", "first": 8, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DUST-BOWL GHOST TOWN - MAIN STREET - HIGH NOON", "present": []}, {"u": 1, "kind": "action", "text": "Wind scours the street.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A tumbleweed rolls past a sagging saloon.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A crooked sign reads \"TIN CUP.\"", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MARSHAL JEBEDIAH CROW, 50s, stands at one end of the street, a battered Colt on his hip.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Opposite him, OLETA BAINBRIDGE, 40s, in a black duster, rests a hand on her holster.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "In the saloon doorway, SISTER MARGUERITE, 30s, a nun, clutches a lantern.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "On the roof of the livery, a boy, PETEY NAKAMURA, 14, lies hidden with a rifle.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Behind a rain barrel crouches DEPUTY HOLLIS WAKEFIELD, 20s, sweating.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "You look older, Jeb.", "name": "OLETA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "You look the same.", "name": "JEBEDIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "That's the problem.", "name": "OLETA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Marguerite steps down from the saloon porch, lantern swinging.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Petey adjusts his aim.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Hollis stands, then ducks.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Both of you, this is a house of God.", "name": "SISTER MARGUERITE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "It's a saloon, Sister.", "name": "JEBEDIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "It was a church first.", "name": "SISTER MARGUERITE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Move aside, Sister.", "name": "OLETA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "I will not.", "name": "SISTER MARGUERITE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Oleta draws and fires.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "The lantern shatters.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Marguerite screams.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Jebediah draws.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Petey's rifle cracks from the roof.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Oleta's hat flies off.", "para": 3, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Hollis shouts and flings himself prone.", "para": 3, "sent": 6, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "A second shot echoes.", "para": 3, "sent": 7, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Jebediah falls to one knee, hand to his shoulder.", "para": 3, "sent": 8, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Who's up there?", "name": "JEBEDIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "I thought he was yours.", "name": "OLETA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "He's not mine.", "name": "JEBEDIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "I'm nobody's!", "name": "PETEY", "speaker": 3, "ext": [], "paren": ["from roof"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Oleta looks at Jebediah.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Jebediah looks at Oleta.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "She holsters her gun.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "He does not.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Seems we've both been ambushed.", "name": "OLETA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Seems so.", "name": "JEBEDIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Then come inside, the lot of you. And bring the boy.", "name": "SISTER MARGUERITE", "speaker": 2, "ext": [], "paren": ["rising, grim"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Hollis crawls out from behind the barrel.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Petey climbs down the ladder.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Jebediah, bleeding, offers Oleta his arm.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "She takes it.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "They walk to the saloon together as the wind picks up.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4]}]}