{"scene_id": "s00193", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00193.fountain", "heading": "INT. ABANDONED SUBWAY PLATFORM - NIGHT", "cast": [{"id": 0, "name": "INSPECTOR LUCIEN MARCH", "names": ["INSPECTOR LUCIEN MARCH", "LUCIEN"], "gender": "m", "first": 4, "spoke": 5}, {"id": 1, "name": "VESPER DUNNE", "names": ["VESPER DUNNE", "VESPER"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "HOODED MAN", "names": ["HOODED MAN"], "gender": "f", "first": 6, "spoke": 1}, {"id": 3, "name": "BOY", "names": ["BOY"], "gender": "?", "first": 6, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED SUBWAY PLATFORM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Tiled walls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dripping pipes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A flickering clock reads 3:07.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "INSPECTOR LUCIEN MARCH, 50s, in a trench coat, waits with his hands in his pockets.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across the tracks, VESPER DUNNE, 30s, in red heels, holds a small case.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Between them stands a HOODED MAN, 40s, and a BOY, 12, who sells newspapers at the exit.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Miss Dunne. Punctual.", "name": "LUCIEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Inspector March. You came alone.", "name": "VESPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "I always do.", "name": "LUCIEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "The Boy waves a paper.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "The Hooded Man steps behind a pillar.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Lucien sees it.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Who's your friend?", "name": "LUCIEN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Nobody. Just the usual.", "name": "VESPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "The usual doesn't wear a gun.", "name": "LUCIEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Vesper smiles.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Tosses the case across the tracks.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Lucien catches it.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "The Hooded Man draws.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Lucien drops the case and ducks.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "The Boy shrieks and bolts.", "para": 3, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Vesper kicks the Hooded Man's knee.", "para": 3, "sent": 6, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "He cries out.", "para": 3, "sent": 7, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "They struggle and tumble.", "para": 3, "sent": 8, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Lucien tackles them both.", "para": 3, "sent": 9, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Vesper!", "name": "LUCIEN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Stop calling me that!", "name": "VESPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "The gun skitters along the tile.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "A train horn blares in the tunnel.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Everyone freezes.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Light blooms from the dark.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Vesper snatches the case.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "The Hooded Man grabs her ankle.", "para": 4, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Where's the money, Vesper?", "name": "HOODED MAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Wouldn't you like to know.", "name": "VESPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "The train roars in.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Lucien shoves them both flat as the cars thunder past.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Wind whips coats.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "When the last car clears, the platform is empty.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "The case lies open, filled with newspaper clippings.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}]}