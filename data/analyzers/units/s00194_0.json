{"scene_id": "s00194_0", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00194.fountain", "heading": "EXT. MAIL-ORDER WINDMILL RANCH - DAY", "cast": [{"id": 0, "name": "MAGGIE", "names": ["MAGGIE"], "gender": "f", "first": 4, "spoke": 8}, {"id": 1, "name": "ROSALIND SOTO", "names": ["SOTO", "ROSALIND SOTO", "ROSALIND"], "gender": "f", "first": 4, "spoke": 3}, {"id": 2, "name": "COLTON PIKE", "names": ["COLTON PIKE", "COLTON"], "gender": "m", "first": 6, "spoke": 6}, {"id": 3, "name": "BEAU TILLMAN", "names": ["BEAU TILLMAN", "BEAU"], "gender": "m", "first": 8, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. MAIL-ORDER WINDMILL RANCH - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Wind pumps clank.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cattle low.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A porch looks out on a dry creek.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MAGDALENA \"MAGGIE\" SOTO, 40s, sits on the porch rail rolling a cigarette.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Her daughter, ROSALIND SOTO, 20s, mends a bridle.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "A drifter, COLTON PIKE, 30s, stands at the gate with his hat in his hands.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "His horse, a sorry mare, waits behind him.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "A young ranch hand, BEAU TILLMAN, 18, stacks hay bales nearby.", "para": 1, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Ma'am, I heard you're hiring.", "name": "COLTON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Heard from who?", "name": "MAGGIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Gas station.", "name": "COLTON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "We don't have a gas station.", "name": "MAGGIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "I made a wrong turn, then.", "name": "COLTON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Rosalind snorts.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Beau drops a bale on his toe.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Ow!", "name": "BEAU", "speaker": 3, "ext": [], "paren": ["hopping"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Beau.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "I'm fine.", "name": "BEAU", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Can you ride, Mr. ...?", "name": "MAGGIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Pike. Colton Pike. I can ride, rope, shoe, fix a windmill.", "name": "COLTON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Can you cook?", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Badly.", "name": "COLTON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "We've got a cook.", "name": "MAGGIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "We've got a Rosalind.", "name": "BEAU", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "He means me.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Rosalind, show him the bunkhouse.", "name": "MAGGIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Thank you, ma'am.", "name": "COLTON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Rosalind sets the bridle down and heads off.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Colton follows.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Maggie lights her cigarette.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Beau?", "name": "MAGGIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Yes, ma'am?", "name": "BEAU", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Wires on the south fence were cut last night. Watch him.", "name": "MAGGIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "The drifter?", "name": "BEAU", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "The drifter.", "name": "MAGGIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Beau nods, swallows, and picks up another bale.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Maggie exhales smoke and watches Colton cross the yard, the mare nosing at his shoulder.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}]}