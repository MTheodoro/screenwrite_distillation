{"scene_id": "s00195", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00195.fountain", "heading": "INT. CORPORATE MAILROOM - DAY", "cast": [{"id": 0, "name": "GERALD PFEFFERKORN", "names": ["GERALD PFEFFERKORN", "GERALD"], "gender": "m", "first": 4, "spoke": 7}, {"id": 1, "name": "NEHA BHATTACHARYA-WELLS", "names": ["NEHA BHATTACHARYA-WELLS", "NEHA"], "gender": "f", "first": 6, "spoke": 6}, {"id": 2, "name": "DON", "names": ["DON"], "gender": "f", "first": 7, "spoke": 9}, {"id": 3, "name": "KRUMBLE", "names": ["KRUMBLE"], "gender": "?", "first": 7, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. CORPORATE MAILROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A basement windowless room lined with pigeonholes, a jammed copier, and a framed poster: \"TEAMWORK: BECAUSE NOBODY CAN DO IT ALONE.\"", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A fluorescent tube buzzes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Cardboard boxes are stacked to the ceiling in the corner like a failing skyline.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "GERALD PFEFFERKORN, 50s, mailroom supervisor, wears a lanyard with three laminated cards and a worn gray cardigan.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He sorts envelopes at triple speed.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "NEHA BHATTACHARYA-WELLS, 20s, the new hire, in a crisp blazer, stands in the doorway, holding a binder.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "DONOVAN \"DON\" KRUMBLE, 40s, a regional manager, arrives behind her, wearing a tie with tiny cartoon calculators.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Name?", "name": "GERALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Neha. First day.", "name": "NEHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Sit. Don't touch the copier.", "name": "GERALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Is it broken?", "name": "NEHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "It's alive. There's a difference.", "name": "GERALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Gerald! Great news. Efficiency review.", "name": "DON", "speaker": 2, "ext": [], "paren": ["entering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "We've been efficient since 1994.", "name": "GERALD", "speaker": 0, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Which is why we're moving to quarterly.", "name": "DON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Quarterly what?", "name": "NEHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Everything.", "name": "DON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Gerald drops a stack of letters.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "The copier lets out a long, plaintive beep.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Don, the mail comes daily.", "name": "GERALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "And we'll bill it quarterly.", "name": "DON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Bill who?", "name": "NEHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Ourselves. It's called internal chargeback.", "name": "DON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Gerald removes his glasses and rubs the bridge of his nose.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "He gestures at the stack of undelivered boxes.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Those are your Q3 bonus checks.", "name": "GERALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Then they're early!", "name": "DON", "speaker": 2, "ext": [], "paren": ["brightly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "They're three weeks late. Because of you.", "name": "GERALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Let's not assign blame. Let's assign tasks.", "name": "DON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Neha raises her hand.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Don points at her like she's won a prize.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Can I ask a question?", "name": "NEHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Please.", "name": "DON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Why are we pretending this makes sense?", "name": "NEHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "The copier beeps again.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Don's smile holds a moment too long.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Gerald puts his glasses back on.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Welcome aboard, Neha.", "name": "DON", "speaker": 2, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3]}]}