{"scene_id": "s00198", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00198.fountain", "heading": "INT. LAUNDROMAT-CAFE \"SUDS & BEANS\" - MORNING", "cast": [{"id": 0, "name": "SOFIA ABERNATHY-KHOURY", "names": ["SOFIA ABERNATHY-KHOURY", "SOFIA"], "gender": "f", "first": 5, "spoke": 14}, {"id": 1, "name": "TEDDY", "names": ["TEDDY"], "gender": "?", "first": 6, "spoke": 15}, {"id": 2, "name": "LINDGREN-ASANTE", "names": ["LINDGREN-ASANTE"], "gender": "?", "first": 6, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAUNDROMAT-CAFE \"SUDS & BEANS\" - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Machines hum.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A chalkboard menu.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Mismatched armchairs.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain taps the windows.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SOFIA ABERNATHY-KHOURY, 30s, sits cross-legged in an armchair with a paperback and a latte.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across from her, in the next chair, THEODORE \"TEDDY\" LINDGREN-ASANTE, 30s, folds a stack of towels with great ceremony.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "He glances at her book.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "She glances at his towels.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "A dryer buzzes.", "para": 1, "sent": 4, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Neither moves.", "para": 1, "sent": 5, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "That's a good one.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "You've read it?", "name": "SOFIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Twice.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Everyone says the ending is a letdown.", "name": "SOFIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Everyone's wrong.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Sofia closes the book on her finger.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "What's your favorite part?", "name": "SOFIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "The part where nothing happens.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "That's most of it.", "name": "SOFIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Exactly.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "She laughs.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "He looks pleased, then busies himself with a towel.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "The dryer buzzes again.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "This time he gets up, opens the door, and starts pulling out warm clothes.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Sofia watches.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "He holds up a pair of socks, one blue and one yellow.", "para": 3, "sent": 5, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "How does this keep happening?", "name": "TEDDY", "speaker": 1, "ext": ["CONT'D"], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "It's a conspiracy.", "name": "SOFIA", "speaker": 0, "ext": [], "paren": ["overhearing"], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "It's entropy.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Same thing.", "name": "SOFIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "He sits back down with the clothes in his lap.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "She sips her latte.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Rain keeps tapping.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Anybody else feel like the whole city is just waiting?", "name": "SOFIA", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the room, lightly"], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "A barista at the counter, unseen, clatters a cup.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Teddy and Sofia look at the sound, then back at each other.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "For what?", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "For someone to say something.", "name": "SOFIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Maybe someone just did.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Sofia tilts her head.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "A dryer thumps.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Teddy holds up the mismatched socks.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Want one?", "name": "TEDDY", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Which?", "name": "SOFIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "You pick.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "She considers, then takes the yellow.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "She tucks it into her book as a bookmark.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "He tucks the blue into his pocket.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "They sit quietly.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "What's your name?", "name": "SOFIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Teddy.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Sofia.", "name": "SOFIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "They do not shake hands.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "They both look at the rain.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "It's supposed to stop at noon.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "I hope it doesn't.", "name": "SOFIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "He looks at her.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "She looks at her book.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "A dryer shuts off, and the room is quiet enough to hear the tick of the clock above the counter.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "Stay.", "name": "SOFIA", "speaker": 0, "ext": ["CONT'D"], "paren": ["softly, to herself"], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Hm?", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "The weather. I meant the weather.", "name": "SOFIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "Oh. Right.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "He smiles at his knees.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "She turns a page she isn't reading.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "Outside, the rain thickens.", "para": 10, "sent": 2, "present": [0, 1, 2]}]}