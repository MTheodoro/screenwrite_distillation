{"scene_id": "s00199", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00199.fountain", "heading": "INT. REGENCY LIBRARY - EVENING", "cast": [{"id": 0, "name": "LADY CORDELIA ASHWORTH-PEMBERTON", "names": ["LADY CORDELIA ASHWORTH-PEMBERTON", "CORDELIA"], "gender": "?", "first": 4, "spoke": 12}, {"id": 1, "name": "LADY HENRIETTA VANE", "names": ["LADY HENRIETTA VANE", "HENRIETTA"], "gender": "f", "first": 5, "spoke": 16}, {"id": 2, "name": "LORD EDMUND FITZWILLIAM-OKAFOR", "names": ["LORD EDMUND FITZWILLIAM-OKAFOR", "EDMUND"], "gender": "m", "first": 6, "spoke": 8}, {"id": 3, "name": "HOBSON", "names": ["HOBSON"], "gender": "?", "first": 7, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. REGENCY LIBRARY - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Tall shelves, a crackling fire, a globe on a stand.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Candles in sconces.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain streaks the windowpanes.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LADY CORDELIA ASHWORTH-PEMBERTON, 30s, in an emerald gown, pours sherry.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her cousin, LADY HENRIETTA VANE, 30s, in a lilac dress, stands at the fireplace, fanning herself.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "LORD EDMUND FITZWILLIAM-OKAFOR, 40s, in a black coat, leafs through a book.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Their butler, HOBSON, 60s, stands by the door with a salver.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Henrietta, you are quiet tonight.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "I am always quiet.", "name": "HENRIETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "You are never quiet.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Then I am tonight.", "name": "HENRIETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "She has a secret.", "name": "EDMUND", "speaker": 2, "ext": [], "paren": ["without looking up"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "I do not.", "name": "HENRIETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Her fan has stopped. She only stops fanning when she is lying.", "name": "EDMUND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Cordelia, tell him he is insufferable.", "name": "HENRIETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "He is insufferable.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Thank you.", "name": "EDMUND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "It was not a compliment.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "It was from you.", "name": "EDMUND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Enough. I will tell you.", "name": "HENRIETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Do.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Father has accepted an offer for my hand.", "name": "HENRIETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "From whom?", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "From Lord Ravenscroft.", "name": "HENRIETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Ravenscroft is sixty.", "name": "EDMUND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Sixty-two.", "name": "HENRIETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Henrietta.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "He has a fine estate.", "name": "HENRIETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "He has a fine gout.", "name": "EDMUND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Do you wish to marry him?", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "I do not wish to do anything.", "name": "HENRIETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Then do not.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "It is not so simple.", "name": "HENRIETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "It is exactly so simple. Tell your father no.", "name": "EDMUND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "You do not know my father.", "name": "HENRIETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "I do. He is a dreadful man.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Cordelia!", "name": "HENRIETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Well, he is.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Hobson steps forward and presents the salver.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "A single letter, sealed in red.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "For Lady Henrietta, my lady.", "name": "HOBSON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Henrietta takes it with careful fingers.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "She opens it.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Reads.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Her fan drops.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Cordelia and Edmund exchange a look.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "He is dead.", "name": "HENRIETTA", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Who?", "name": "EDMUND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Ravenscroft. This morning.", "name": "HENRIETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "The fire pops.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Cordelia sets down the sherry.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "She takes Henrietta's hand.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Then you are free.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Yes. I am.", "name": "HENRIETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "She laughs, a short, shocked sound.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Then she cries.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "Edmund closes his book.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "Hobson quietly withdraws.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}]}