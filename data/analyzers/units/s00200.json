{"scene_id": "s00200", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00200.fountain", "heading": "INT. APARTMENT - KITCHEN - EVENING", "cast": [{"id": 0, "name": "CLEMENTINE BRAITHWAITE", "names": ["CLEMENTINE BRAITHWAITE", "CLEMENTINE"], "gender": "?", "first": 5, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. APARTMENT - KITCHEN - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "A small kitchen.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A table set for two.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "One candle burning.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A phone leans against the salt shaker.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CLEMENTINE BRAITHWAITE, 30s, in an apron, stirs a pot.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She tastes.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Adds salt.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "Checks the clock.", "para": 1, "sent": 3, "present": [0]}, {"u": 9, "kind": "action", "text": "She wipes her hands, straightens a fork, moves it a quarter inch, moves it back.", "para": 1, "sent": 4, "present": [0]}, {"u": 10, "kind": "action", "text": "The phone buzzes.", "para": 2, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "She answers on speaker.", "para": 2, "sent": 1, "present": [0]}, {"u": 12, "kind": "action", "text": "Only a long silence and a car horn on the other end.", "para": 2, "sent": 2, "present": [0]}, {"u": 13, "kind": "dialogue", "text": "It's fine.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 14, "kind": "action", "text": "She waits.", "para": 3, "sent": 0, "present": [0]}, {"u": 15, "kind": "dialogue", "text": "No, I'm stirring. Twenty is fine.", "name": "CLEMENTINE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 16, "kind": "action", "text": "The line clicks dead.", "para": 4, "sent": 0, "present": [0]}, {"u": 17, "kind": "action", "text": "She does not look at the phone.", "para": 4, "sent": 1, "present": [0]}, {"u": 18, "kind": "action", "text": "A moment later it rings again: her own voicemail greeting, played back by mistake.", "para": 4, "sent": 2, "present": [0]}, {"u": 19, "kind": "dialogue", "text": "Hi, you've reached Clementine. Leave a message and I'll call you right back.", "name": "CLEMENTINE", "speaker": 0, "ext": ["V.O."], "paren": ["recorded, cheerful"], "dual": false, "present": [0]}, {"u": 20, "kind": "action", "text": "She presses the screen.", "para": 5, "sent": 0, "present": [0]}, {"u": 21, "kind": "action", "text": "The voice stops.", "para": 5, "sent": 1, "present": [0]}, {"u": 22, "kind": "action", "text": "She takes the second plate from the table and slides it back into the cupboard.", "para": 5, "sent": 2, "present": [0]}, {"u": 23, "kind": "action", "text": "She blows out the candle.", "para": 5, "sent": 3, "present": [0]}, {"u": 24, "kind": "action", "text": "Sits.", "para": 5, "sent": 4, "present": [0]}, {"u": 25, "kind": "action", "text": "Eats alone, slowly, while the pot goes on simmering.", "para": 5, "sent": 5, "present": [0]}]}