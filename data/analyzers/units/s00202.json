{"scene_id": "s00202", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00202.fountain", "heading": "EXT. FROZEN WATERFALL CLIFF - DAWN", "cast": [{"id": 0, "name": "FIGURE", "names": ["FIGURE"], "gender": "?", "first": 3, "spoke": 3}, {"id": 1, "name": "ANSELM", "names": ["ANSELM"], "gender": "m", "first": 4, "spoke": 8}, {"id": 2, "name": "THE WARDEN", "names": ["THE WARDEN"], "gender": "m", "first": 5, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FROZEN WATERFALL CLIFF - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A wall of blue ice, a hundred feet high, hung with icicles.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Mist rises from the pool below.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cloaked FIGURE, face hidden, climbs the ice with two picks.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "Below, on a ledge, a boy sits tying a boot: ANSELM, 12, thin, in a patched coat.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "The Figure reaches the ledge, hauls up, and stops, breathing hard.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "You're a long way from home.", "name": "FIGURE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "So are you.", "name": "ANSELM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "I'm not from anywhere.", "name": "FIGURE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Anselm looks away.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "He pulls the laces tight.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "The Figure sits beside him without being asked.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "A long pause.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Wind drops.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "You followed me.", "name": "ANSELM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Since the village.", "name": "FIGURE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Anselm picks at a thread on his sleeve.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "The Figure pulls back its hood: a woman, 50s, with a weathered face and a scar down one cheek.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "They said you were dead.", "name": "ANSELM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Who is they?", "name": "THE WARDEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "The elders.", "name": "ANSELM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "The elders say many things.", "name": "THE WARDEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "She takes a flask from her coat, drinks, offers it.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "He shakes his head.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "She puts it away.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Silence settles.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Down in the pool, ice cracks like a gunshot.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Are you going to take me back?", "name": "ANSELM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Do you want to go back?", "name": "THE WARDEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Anselm does not answer.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "He stares at the ice.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "A bird screams overhead.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "He tightens his fists.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "The Warden watches the cliff, not him.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "They'll be here by noon.", "name": "THE WARDEN", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Who?", "name": "ANSELM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "The ones who'd rather you didn't live.", "name": "THE WARDEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Anselm stands abruptly.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "He grabs one of her picks off the ledge.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Then I'm not going back.", "name": "ANSELM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "I know.", "name": "THE WARDEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "You're not going to stop me?", "name": "ANSELM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "I'm going to teach you how to climb.", "name": "THE WARDEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "He looks at the pick.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "At her.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "She rises, takes his hand, and sets his grip.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Then she turns to the ice.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Left foot first. Always.", "name": "THE WARDEN", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "She starts up.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Anselm hesitates, then plants the pick and follows.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "The first light of the sun strikes the falls.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "The ice blazes.", "para": 8, "sent": 3, "present": [0, 1, 2]}]}