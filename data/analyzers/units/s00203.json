{"scene_id": "s00203", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00203.fountain", "heading": "INT. ROOFTOP GREENHOUSE - AFTERNOON", "cast": [{"id": 0, "name": "CASPIAN ODUYA", "names": ["CASPIAN ODUYA", "CASPIAN"], "gender": "?", "first": 4, "spoke": 12}, {"id": 1, "name": "VERONIKA STANISLAWSKI", "names": ["VERONIKA STANISLAWSKI", "VERONIKA"], "gender": "f", "first": 5, "spoke": 8}, {"id": 2, "name": "JUNE PAPADOPOULOS", "names": ["JUNE PAPADOPOULOS", "JUNE"], "gender": "f", "first": 6, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROOFTOP GREENHOUSE - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Glass panes fogged with humidity.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of orchids.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A watering can.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CASPIAN ODUYA, 40s, sorts seed packets at a potting bench.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "VERONIKA STANISLAWSKI, 50s, sits on an upturned crate, sipping tea.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "JUNE PAPADOPOULOS, 20s, leans on a shelf, headphones around her neck.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "The vault is on the third floor. The elevator needs a keycard. The stairwell has a camera.", "name": "CASPIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "And the roof?", "name": "VERONIKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Roof door is alarmed. But the greenhouse vent connects to the same shaft.", "name": "CASPIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "How wide is the vent?", "name": "JUNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Twenty inches.", "name": "CASPIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "That's tight.", "name": "JUNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "You're small.", "name": "CASPIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I'm average.", "name": "JUNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "You're small, June. Be proud.", "name": "VERONIKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "I'm proud. I'm also claustrophobic.", "name": "JUNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Veronika can talk you through.", "name": "CASPIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "I'll hum.", "name": "VERONIKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "You'll hum?", "name": "JUNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Whale songs. They help.", "name": "VERONIKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "We go Thursday. The night guard changes at ten.", "name": "CASPIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "What about the dog?", "name": "VERONIKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "There's no dog.", "name": "CASPIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "There was a dog last month.", "name": "VERONIKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "That was a different building.", "name": "CASPIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Can we confirm the dog?", "name": "JUNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "I'll confirm the dog.", "name": "CASPIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Good.", "name": "VERONIKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Good.", "name": "JUNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "They sit.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "A drip falls from a leaf.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Veronika stirs her tea.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "June drums on her knee.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Caspian sets down the seed packet.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Anyone want a tomato?", "name": "CASPIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Is it a good one?", "name": "VERONIKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Best on the roof.", "name": "CASPIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Obviously. It's the only one.", "name": "JUNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Eat.", "name": "CASPIAN", "speaker": 0, "ext": [], "paren": ["handing her one"], "dual": false, "present": [0, 1, 2]}]}