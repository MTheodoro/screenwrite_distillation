{"scene_id": "s00205", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00205.fountain", "heading": "INT. ABANDONED SKATING RINK - DAWN", "cast": [{"id": 0, "name": "COACH IGNATIUS PRZYBYLSKI", "names": ["COACH IGNATIUS PRZYBYLSKI", "COACH IGNATIUS"], "gender": "?", "first": 5, "spoke": 9}, {"id": 1, "name": "DARIUS", "names": ["DARIUS"], "gender": "m", "first": 7, "spoke": 5}, {"id": 2, "name": "FONTENOT", "names": ["FONTENOT"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "RADIO ANNOUNCER", "names": ["RADIO ANNOUNCER"], "gender": "?", "first": 9, "spoke": 2}, {"id": 4, "name": "LEN", "names": ["LEN"], "gender": "?", "first": 17, "spoke": 5}, {"id": 5, "name": "AKINTOLA-BRADY", "names": ["AKINTOLA-BRADY"], "gender": "?", "first": 17, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED SKATING RINK - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A vast hall with a cracked ice surface, half-melted and gray.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Bleachers stripped bare.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A scoreboard dangles by one chain.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Pale light pours through a hole in the roof, striking the center of the rink like a spotlight.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "COACH IGNATIUS PRZYBYLSKI, 60s, bundled in a parka, sits on a bucket at the boards, holding a stopwatch in mittened hands.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "His breath rises in plumes.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "On the ice, DARIUS \"THE WALL\" FONTENOT, 30s, a goalie with a dented mask, stands in a crouch at the net, a puck at his feet.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "A radio on the boards crackles.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "And that's the final from Calgary, folks. Eagles take it six to two.", "name": "RADIO ANNOUNCER", "speaker": 3, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Six to two. Hear that, Darius?", "name": "COACH IGNATIUS", "speaker": 0, "ext": [], "paren": ["turning it down"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I heard it.", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "That's us, in three weeks, if you do not fix your glove side.", "name": "COACH IGNATIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "My glove side is fine.", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Your glove side is a screen door.", "name": "COACH IGNATIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Darius takes the puck and flicks it into the net.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Coach shakes his head.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "A figure enters from the locker-room tunnel: LENNOX \"LEN\" AKINTOLA-BRADY, 20s, a rookie in a too-big jersey, skates tied around his neck.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "He stops at the boards, intimidated.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Coach? Am I late?", "name": "LEN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "You are early, which is worse. It means you didn't sleep.", "name": "COACH IGNATIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "I slept.", "name": "LEN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "You slept badly.", "name": "COACH IGNATIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Len sits, ties a skate.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Darius watches from the net.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Coach clicks the stopwatch.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Len, shoot on Darius.", "name": "COACH IGNATIUS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Me? On him?", "name": "LEN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "You see anyone else?", "name": "COACH IGNATIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Len steps on the ice.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Skates a slow circle.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Darius lowers his mask.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Len winds up, shoots.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Darius flicks the glove.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "The puck hits it and drops.", "para": 5, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Len stares.", "para": 5, "sent": 6, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Screen door.", "name": "DARIUS", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Sorry?", "name": "LEN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Nothing.", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Len shoots again.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Darius makes the save with his pad.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Coach scribbles.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Len shoots again.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "This time the puck sails over the glove.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Again.", "name": "COACH IGNATIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Again?", "name": "LEN", "speaker": 4, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Again.", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "They say it at once, a little too loudly.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "Coach covers a smile.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "Len shoots.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "Darius lunges.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "The puck clangs off the post.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "The radio crackles.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "We now return to our regular programming.", "name": "RADIO ANNOUNCER", "speaker": 3, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "Coach clicks the radio off.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "Quiet.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "Len and Darius stand facing each other.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "Good. Again.", "name": "COACH IGNATIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}