{"scene_id": "s00206", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00206.fountain", "heading": "INT. ABANDONED OPERA HOUSE - STAGE - NIGHT", "cast": [{"id": 0, "name": "ELIAS VANTERPOOL", "names": ["ELIAS VANTERPOOL", "ELIAS"], "gender": "?", "first": 4, "spoke": 9}, {"id": 1, "name": "ODETTE MARCHAND-OYELARAN", "names": ["ODETTE MARCHAND-OYELARAN", "ODETTE"], "gender": "?", "first": 15, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED OPERA HOUSE - STAGE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Torn velvet curtains.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A dusty chandelier.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Moonlight through a hole in the dome.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ELIAS VANTERPOOL, 50s, in a rumpled suit, stands center stage with a flashlight, scanning the empty rows.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He is breathing hard, bleeding from a cut above his eye.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "dialogue", "text": "I know you're out there.", "name": "ELIAS", "speaker": 0, "ext": [], "paren": ["to the dark"], "dual": false, "present": [0]}, {"u": 7, "kind": "action", "text": "No answer.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "The chandelier creaks.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "He turns the beam on the box seats.", "para": 2, "sent": 2, "present": [0]}, {"u": 10, "kind": "dialogue", "text": "Steady. Steady.", "name": "ELIAS", "speaker": 0, "ext": ["CONT'D"], "paren": ["to himself"], "dual": false, "present": [0]}, {"u": 11, "kind": "action", "text": "A seat folds down with a clack.", "para": 3, "sent": 0, "present": [0]}, {"u": 12, "kind": "action", "text": "Elias spins.", "para": 3, "sent": 1, "present": [0]}, {"u": 13, "kind": "action", "text": "Nothing.", "para": 3, "sent": 2, "present": [0]}, {"u": 14, "kind": "action", "text": "A whisper drifts through the hall, impossible to place.", "para": 3, "sent": 3, "present": [0]}, {"u": 15, "kind": "action", "text": "A woman steps from the wings, slowly, hands visible: ODETTE MARCHAND-OYELARAN, 40s, in a long gray coat, a small revolver in her gloved hand.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She does not raise it.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Hello, Elias.", "name": "ODETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Odette. How did you find me?", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "You always loved this place.", "name": "ODETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "All of you, stay back!", "name": "ELIAS", "speaker": 0, "ext": [], "paren": ["to the empty house"], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "There's no one here but us.", "name": "ODETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Then why did you bring the gun?", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Habit.", "name": "ODETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She holds it up and then tosses it.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "It clatters center stage between them.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Elias looks at it.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "He does not move.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "What do you want?", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "The ledger.", "name": "ODETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "I burned it.", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "You didn't.", "name": "ODETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "I should have.", "name": "ELIAS", "speaker": 0, "ext": [], "paren": ["quietly, to himself"], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "He pulls a thick notebook from inside his coat and holds it out.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "She doesn't take it.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "The chandelier shivers.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Keep it. I only needed to know you still had it.", "name": "ODETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Why?", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Because they're coming for it. And now they know too.", "name": "ODETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "A door slams somewhere in the dark.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Elias's face drains.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Odette steps back into the wings.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Run, Elias.", "name": "ODETTE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "He drops the flashlight.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "It rolls into the orchestra pit.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "Footsteps pound from every direction.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Elias bolts upstage.", "para": 8, "sent": 3, "present": [0, 1]}]}