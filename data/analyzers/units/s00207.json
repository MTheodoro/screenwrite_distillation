{"scene_id": "s00207", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00207.fountain", "heading": "INT. PARKING GARAGE - LEVEL 3 - NIGHT", "cast": [{"id": 0, "name": "BRENDAN MWANGI", "names": ["BRENDAN MWANGI", "BRENDAN"], "gender": "?", "first": 4, "spoke": 3}, {"id": 1, "name": "SOLEDAD ARRIAGA", "names": ["SOLEDAD ARRIAGA", "SOLEDAD"], "gender": "f", "first": 6, "spoke": 4}, {"id": 2, "name": "TOBIAS KESSLER-ADEYEMI", "names": ["TOBIAS KESSLER-ADEYEMI", "TOBIAS"], "gender": "?", "first": 17, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. PARKING GARAGE - LEVEL 3 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Concrete columns.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Flickering fluorescents.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single sedan idles.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "BRENDAN MWANGI, 40s, sits in the sedan, engine running.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He checks his watch.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "His partner, SOLEDAD ARRIAGA, 30s, leans on a column nearby, smoking.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "She flicks ash and watches the ramp.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "He's late.", "name": "BRENDAN", "speaker": 0, "ext": [], "paren": ["through the window"], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "He'll come.", "name": "SOLEDAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "You said that an hour ago.", "name": "BRENDAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She shrugs and drops the cigarette.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "A set of headlights sweeps the ramp.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She straightens.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He kills the engine.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "A black van rolls in and stops.", "para": 2, "sent": 4, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "The side door slides open.", "para": 2, "sent": 5, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "TOBIAS KESSLER-ADEYEMI, 50s, steps out in a long coat, flanked by a stocky man in sunglasses.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "He walks over slowly.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Brendan climbs out of the sedan.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Gentlemen. Lady.", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "You're an hour late.", "name": "SOLEDAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Traffic.", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Do you have it?", "name": "BRENDAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Tobias smiles.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "He reaches into his coat.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Brendan tenses.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Soledad's hand moves to her hip.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Relax.", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "He pulls out an envelope.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Holds it up.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "She takes a step.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The stocky man steps with her.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Tobias lowers the envelope.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "First, the money.", "name": "TOBIAS", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Brendan opens the trunk.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "A duffel.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "He unzips it, shows the bundles.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Tobias nods.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Now the envelope.", "name": "SOLEDAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Tobias hands it over.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "She tears it open.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Photographs.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Her face goes cold.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "These are of my daughter.", "name": "SOLEDAD", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Yes.", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "She draws her gun.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "The stocky man draws his.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Brendan freezes.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Tobias raises both hands, still smiling.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Now we all understand each other.", "name": "TOBIAS", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}]}