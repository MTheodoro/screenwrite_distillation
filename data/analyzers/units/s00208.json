{"scene_id": "s00208", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00208.fountain", "heading": "EXT. BAMBOO FOREST - RAINY AFTERNOON", "cast": [{"id": 0, "name": "HANNELORE BECK", "names": ["HANNELORE BECK", "HANNELORE"], "gender": "?", "first": 4, "spoke": 9}, {"id": 1, "name": "MARISOL AGUILAR", "names": ["MARISOL AGUILAR", "MARISOL"], "gender": "?", "first": 5, "spoke": 8}, {"id": 2, "name": "THABO NKOSI-WILLIAMS", "names": ["THABO NKOSI-WILLIAMS", "THABO"], "gender": "f", "first": 6, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "EXT. BAMBOO FOREST - RAINY AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Tall green stalks creak in the wind.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Mud everywhere.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A trail disappears into fog.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "HANNELORE BECK, 50s, a botanist, leads, machete in hand.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Behind her trudges MARISOL AGUILAR, 20s, a student with a heavy pack.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Last comes THABO NKOSI-WILLIAMS, 30s, their guide, who limps and carries a radio.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "We stop at the next clearing.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": ["to all"], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "How far is that?", "name": "MARISOL", "speaker": 1, "ext": [], "paren": ["to Hannelore"], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Not far.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "It is far.", "name": "THABO", "speaker": 2, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Rain thickens.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Marisol slips and grabs a stalk.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "It cracks.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Sorry!", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Careful, it carries sound.", "name": "THABO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Sound is fine. It's silence that worries me.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Why?", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Because it means something is listening.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "They stop.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "All three listen.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "The rain pauses.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "A distant rustle.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Is that the wind?", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "No.", "name": "THABO", "speaker": 2, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Keep walking.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "But which way?", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Forward.", "name": "THABO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Not forward. Left. Left!", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Which left?", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Mine.", "name": "THABO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Marisol veers right by mistake.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Thabo yanks her back.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "She bumps into Hannelore.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "The three tangle for a second, then break apart.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Sorry, sorry.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Stay together.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": ["to all"], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "This is Thabo. We are lost.", "name": "THABO", "speaker": 2, "ext": [], "paren": ["into radio, muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Static answers.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "He shakes the radio.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "It stays dead.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "He tucks it away.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "We keep moving.", "name": "THABO", "speaker": 2, "ext": ["CONT'D"], "paren": ["to the group"], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "She knows.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "She does?", "name": "THABO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "I do?", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "We keep moving.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "They push on.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "The rustle follows.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "It never gets closer.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "It never gets farther.", "para": 6, "sent": 3, "present": [0, 1, 2]}]}