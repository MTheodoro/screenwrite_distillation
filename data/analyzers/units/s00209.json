{"scene_id": "s00209", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00209.fountain", "heading": "INT. DEFUNCT TAXIDERMY MUSEUM - NIGHT", "cast": [{"id": 0, "name": "DETECTIVE LOUISA FAIRWEATHER-KNOX", "names": ["DETECTIVE LOUISA FAIRWEATHER-KNOX", "LOUISA"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "SANJAY PILLAI", "names": ["SANJAY PILLAI", "SANJAY"], "gender": "?", "first": 5, "spoke": 2}, {"id": 2, "name": "PROFESSOR ISADORE WREN", "names": ["PROFESSOR ISADORE WREN", "ISADORE"], "gender": "?", "first": 6, "spoke": 7}, {"id": 3, "name": "PRISCILLA OYEDEJI", "names": ["PRISCILLA OYEDEJI", "PRISCILLA"], "gender": "?", "first": 7, "spoke": 4}, {"id": 4, "name": "ELLIOTT CRUZ", "names": ["ELLIOTT CRUZ", "ELLIOTT"], "gender": "?", "first": 8, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. DEFUNCT TAXIDERMY MUSEUM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Glass eyes glint.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A stuffed bear looms.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Moonlight cuts through blinds.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DETECTIVE LOUISA FAIRWEATHER-KNOX, 40s, stands beside a toppled display case.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "DET. SANJAY PILLAI, 30s, photographs the glass.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "PROFESSOR ISADORE WREN, 70s, wrings his hands.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "MS. PRISCILLA OYEDEJI, 50s, the curator, leans on a pedestal.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "A night watchman, ELLIOTT CRUZ, 20s, stands guard by the door.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Who last saw the owl?", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "I did. Six o'clock.", "name": "PRISCILLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Seven.", "name": "ISADORE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Six, Isadore.", "name": "PRISCILLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "You left at six. I was still here at seven.", "name": "ISADORE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "So you saw it at seven.", "name": "SANJAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "I saw something at seven.", "name": "ISADORE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Something?", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "A shape. In the dark.", "name": "ISADORE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "There's always a shape, Professor.", "name": "ELLIOTT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "This one moved.", "name": "ISADORE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Everything moves if you stare long enough.", "name": "PRISCILLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Quiet.", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "She points her flashlight at the empty display case.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "The glass is broken outward, not in.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "She crouches and picks up a single gray feather.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "It wasn't stolen. It left.", "name": "LOUISA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Owls don't leave. They're stuffed.", "name": "SANJAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "That one wasn't.", "name": "ISADORE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Elliott's radio crackles.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Static.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Then a soft, rhythmic hooting.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Everyone turns toward the dark rafters.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Oh no.", "name": "PRISCILLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Oh yes.", "name": "ISADORE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Louisa shines the light upward.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Two enormous yellow eyes gleam.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "A shadow unfolds.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}]}