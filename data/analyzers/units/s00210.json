{"scene_id": "s00210", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00210.fountain", "heading": "INT. OPEN-PLAN OFFICE - \"SYNERGY HUB\" - MORNING", "cast": [{"id": 0, "name": "TARK", "names": ["TARK"], "gender": "?", "first": 5, "spoke": 15}, {"id": 1, "name": "BOLLINGER", "names": ["BOLLINGER"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "CORDY", "names": ["CORDY"], "gender": "f", "first": 6, "spoke": 8}, {"id": 3, "name": "ADESANYA", "names": ["ADESANYA"], "gender": "?", "first": 6, "spoke": 0}, {"id": 4, "name": "MARGUERITE LESAGE-OKORO", "names": ["MARGUERITE LESAGE-OKORO", "MARGUERITE"], "gender": "?", "first": 7, "spoke": 8}, {"id": 5, "name": "THAD", "names": ["THAD"], "gender": "?", "first": 8, "spoke": 5}, {"id": 6, "name": "QUILLFEATHER", "names": ["QUILLFEATHER"], "gender": "?", "first": 8, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. OPEN-PLAN OFFICE - \"SYNERGY HUB\" - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Standing desks, bean bags, a kombucha tap, motivational posters.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A banner: \"WE ARE FAMILY.\"", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A beanbag chair shaped like a unicorn.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Fluorescent morning light.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "TARQUIN \"TARK\" BOLLINGER, 30s, in a vest and sneakers, balances on a wobble board.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Beside him, CORDELIA \"CORDY\" ADESANYA, 40s, hair in a tight bun, taps at a laptop.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "MARGUERITE LESAGE-OKORO, 50s, the office manager, hoses a droopy fern.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "THADDEUS \"THAD\" QUILLFEATHER, 60s, a quiet man in a gray suit, sits at the corner desk, unmoving.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 9, "kind": "dialogue", "text": "Team! Quick sync!", "name": "TARK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "dialogue", "text": "We just did a sync.", "name": "CORDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "This is a meta-sync.", "name": "TARK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "Tark, the fern is dying.", "name": "MARGUERITE", "speaker": 4, "ext": [], "paren": ["over the hose"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "Everything is dying. That's the culture of change.", "name": "TARK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "action", "text": "Cordy rolls her eyes.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "action", "text": "Thad stays still.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "action", "text": "He has not moved in some time.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "Thad. Buddy. Thoughts?", "name": "TARK", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "action", "text": "No answer.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "Thad?", "name": "CORDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "Thad doesn't talk before ten.", "name": "MARGUERITE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "It's ten-fifteen.", "name": "TARK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Is he, uh...", "name": "CORDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "He's fine.", "name": "MARGUERITE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "He's on mute.", "name": "TARK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "We're in person.", "name": "CORDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "Mute is a state of mind.", "name": "TARK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "They approach the desk.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "Marguerite prods Thad's shoulder with the hose.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "He topples out of the chair.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "Cordy shrieks.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "Tark falls off the wobble board.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "action", "text": "Marguerite drops the hose, which sprays everyone.", "para": 4, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "They scramble backward.", "para": 4, "sent": 6, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "Thad lies on the floor, eyes closed, and snores.", "para": 4, "sent": 7, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "He's asleep!", "name": "CORDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "He's been asleep since Tuesday.", "name": "MARGUERITE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "Since Tuesday?", "name": "TARK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "dialogue", "text": "That's when he stopped answering emails.", "name": "MARGUERITE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "We thought that was mindfulness.", "name": "TARK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "Thad opens one eye.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "Sits up, slowly, dripping.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "dialogue", "text": "Is it Friday?", "name": "THAD", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "dialogue", "text": "It's Thursday.", "name": "CORDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "dialogue", "text": "Damn.", "name": "THAD", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "action", "text": "He lies back down.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "action", "text": "Tark stares at the others.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "Cordy stares at Marguerite.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "Marguerite shuts off the water.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "dialogue", "text": "Okay. New initiative. Naps.", "name": "TARK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "dialogue", "text": "We already have naps.", "name": "CORDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "dialogue", "text": "Mandatory naps.", "name": "TARK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "dialogue", "text": "I'd back that.", "name": "THAD", "speaker": 5, "ext": [], "paren": ["from the floor, dreamy"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "dialogue", "text": "Tark, who signed off on the quarterly?", "name": "MARGUERITE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "dialogue", "text": "Which quarterly?", "name": "TARK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "dialogue", "text": "The one that says we're out of money.", "name": "MARGUERITE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "dialogue", "text": "We're out of money?", "name": "TARK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "dialogue", "text": "We've been out of money since March.", "name": "CORDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "dialogue", "text": "But the kombucha tap works.", "name": "TARK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 59, "kind": "dialogue", "text": "That's a donation.", "name": "MARGUERITE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 60, "kind": "action", "text": "Tark takes a long, wobbly step.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 61, "kind": "action", "text": "He looks at the banner.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 62, "kind": "action", "text": "At the unicorn beanbag.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 63, "kind": "action", "text": "At the dying fern.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 64, "kind": "action", "text": "Behind him, the overhead lights flicker out one by one.", "para": 7, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 65, "kind": "dialogue", "text": "Told you.", "name": "THAD", "speaker": 5, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 66, "kind": "dialogue", "text": "Told me what?", "name": "TARK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 67, "kind": "dialogue", "text": "That it was Friday.", "name": "THAD", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}