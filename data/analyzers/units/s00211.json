{"scene_id": "s00211", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00211.fountain", "heading": "INT. FUNERAL PARLOR - VIEWING ROOM - NIGHT", "cast": [{"id": 0, "name": "DETECTIVE MARISOL OKAFOR-DUMAS", "names": ["DETECTIVE MARISOL OKAFOR-DUMAS", "MARISOL"], "gender": "f", "first": 5, "spoke": 13}, {"id": 1, "name": "LEOPOLD GRIMSBY", "names": ["LEOPOLD GRIMSBY", "LEOPOLD"], "gender": "m", "first": 7, "spoke": 2}, {"id": 2, "name": "PHILOMENA TEAGUE-ABARA", "names": ["PHILOMENA TEAGUE-ABARA", "PHILOMENA"], "gender": "f", "first": 8, "spoke": 8}, {"id": 3, "name": "CALEB NASH", "names": ["CALEB NASH", "CALEB"], "gender": "?", "first": 9, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. FUNERAL PARLOR - VIEWING ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Carpet muffles footfalls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Lilies in tall vases.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A closed casket on a draped stand.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single lamp.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DETECTIVE MARISOL OKAFOR-DUMAS, 40s, in a black blazer, stands near the casket, hands behind her back.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She watches the door.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "MR. LEOPOLD GRIMSBY, 60s, the funeral director, stands rigid in a dark suit.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "A mourner, PHILOMENA TEAGUE-ABARA, 50s, sits in the front row, handkerchief twisted in her fist.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "In the back, a young usher named CALEB NASH, 20s, fidgets with his cufflinks.", "para": 1, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "The family asked for privacy, Detective.", "name": "LEOPOLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I won't be long.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "She was my sister.", "name": "PHILOMENA", "speaker": 2, "ext": [], "paren": ["without turning"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "I know.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Then you know she wasn't well.", "name": "PHILOMENA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "I know she was poisoned.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Caleb drops a cufflink.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "It rolls under a pew.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "He doesn't pick it up.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "That is a serious accusation.", "name": "LEOPOLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "It's a finding.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "By whom?", "name": "PHILOMENA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "The lab. It came back this afternoon.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Philomena finally turns.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Her eyes are dry.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Her mouth is steady.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "And who do you think did it?", "name": "PHILOMENA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Someone who had access to her tea.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Leopold shifts his weight.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Caleb takes a step toward the exit.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Marisol raises one hand.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Mr. Nash. Stay.", "name": "MARISOL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "I was just getting air.", "name": "CALEB", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "The air is fine here.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "The lamp flickers.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Marisol steps to the casket and lays a hand on the lid.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Mrs. Teague-Abara. Tell me about the tea.", "name": "MARISOL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "It was chamomile.", "name": "PHILOMENA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Who bought it?", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "I did.", "name": "PHILOMENA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Who poured it?", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "I did.", "name": "PHILOMENA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "A pause.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "The lilies sway.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Caleb breathes out.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Thank you.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Is that all?", "name": "PHILOMENA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "For tonight.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "She nods to Leopold, then to Caleb.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Philomena rises, smooths her skirt, and walks out.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "The door sighs shut behind her.", "para": 7, "sent": 2, "present": [0, 1, 3]}, {"u": 51, "kind": "action", "text": "Marisol lifts the lid of the casket just a crack and looks at something inside.", "para": 7, "sent": 3, "present": [0, 1, 3]}]}