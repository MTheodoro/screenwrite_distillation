{"scene_id": "s00212", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00212.fountain", "heading": "EXT. FLOATING MARKET ON A CLOUD - DAY", "cast": [{"id": 0, "name": "SABLE", "names": ["SABLE"], "gender": "?", "first": 5, "spoke": 10}, {"id": 1, "name": "BRINDLE OKAFOR-LYNN", "names": ["BRINDLE OKAFOR-LYNN", "BRINDLE"], "gender": "?", "first": 6, "spoke": 6}, {"id": 2, "name": "MADAME ZEPHYRINE", "names": ["MADAME ZEPHYRINE"], "gender": "?", "first": 7, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FLOATING MARKET ON A CLOUD - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Stalls drift on white vapor.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Bridges of braided mist.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Lanterns shaped like fish.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Far below, a patchwork of farmland.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SABLE, 20s, a thief in a patched coat, crouches behind a stall of enchanted fruit.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her partner, BRINDLE OKAFOR-LYNN, 30s, hairy-eared and cheerful, juggles three glowing apples.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "A merchant, MADAME ZEPHYRINE, 60s, sells wind in jars.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Brindle, stop juggling the evidence.", "name": "SABLE", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "It's not evidence. It's snacks.", "name": "BRINDLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Customers! Two coins for a breeze!", "name": "MADAME ZEPHYRINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "We do not have two coins.", "name": "SABLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "We have one and a half.", "name": "BRINDLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "We have none. I told you not to spend on the pie.", "name": "SABLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "It was a good pie.", "name": "BRINDLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "It was a pigeon with crust.", "name": "SABLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Last chance, my darlings!", "name": "MADAME ZEPHYRINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Sable pops up.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Smiles at the merchant.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Slides a hand toward a jar.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Madame, we heard you sell the finest sirocco on the cloud.", "name": "SABLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Only the finest.", "name": "MADAME ZEPHYRINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "How fine?", "name": "BRINDLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Fine enough to carry you to the moon.", "name": "MADAME ZEPHYRINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "We'll take two.", "name": "SABLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "At two coins each?", "name": "MADAME ZEPHYRINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "At half a coin each, since you're our favorite.", "name": "SABLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Child, don't flatter me.", "name": "MADAME ZEPHYRINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Flattery's all I've got.", "name": "SABLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Brindle drops an apple.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "It bounces across the stall, rolls off the edge, and falls through the cloud.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "All three watch it go.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "That was an apple of wisdom.", "name": "MADAME ZEPHYRINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "We'll find another.", "name": "BRINDLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "We won't.", "name": "SABLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Madame Zephyrine sighs.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "She uncorks a jar.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "A soft wind swirls out, lifts Sable's hair, and tugs at Brindle's coat.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Free sample.", "name": "MADAME ZEPHYRINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "She likes us.", "name": "BRINDLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "She pities us.", "name": "SABLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Both.", "name": "MADAME ZEPHYRINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "The wind rises.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Sable and Brindle grab each other's arms.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "They lift an inch off the cloud.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "They rise slowly, laughing, up toward the lanterns.", "para": 5, "sent": 3, "present": [0, 1, 2]}]}