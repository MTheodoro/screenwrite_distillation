{"scene_id": "s00213", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00213.fountain", "heading": "INT. LIGHTHOUSE KEEPER'S COTTAGE - SITTING ROOM - NIGHT", "cast": [{"id": 0, "name": "INSPECTOR GWENDOLYN TREVELYAN-OKOYE", "names": ["INSPECTOR GWENDOLYN TREVELYAN-OKOYE", "GWENDOLYN"], "gender": "?", "first": 6, "spoke": 6}, {"id": 1, "name": "SERGEANT ABEL MWAMBA", "names": ["SERGEANT ABEL MWAMBA", "ABEL"], "gender": "?", "first": 7, "spoke": 2}, {"id": 2, "name": "HEPZIBAH DRUMMOND", "names": ["HEPZIBAH DRUMMOND", "HEPZIBAH"], "gender": "?", "first": 8, "spoke": 8}, {"id": 3, "name": "WILFRED DRUMMOND", "names": ["WILFRED DRUMMOND", "WILFRED"], "gender": "m", "first": 8, "spoke": 7}, {"id": 4, "name": "MISS ODALYS PRENTISS", "names": ["MISS ODALYS PRENTISS", "ODALYS"], "gender": "f", "first": 10, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. LIGHTHOUSE KEEPER'S COTTAGE - SITTING ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Low beams.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A woodstove ticks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Salt-bleached curtains.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Shelves of shells, charts, and mismatched teacups.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Storm pushes at the windows.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "INSPECTOR GWENDOLYN TREVELYAN-OKOYE, 50s, in a damp raincoat, stands by the stove.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "A younger officer, SERGEANT ABEL MWAMBA, 30s, takes notes in a corner.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "The keeper's widow, MRS. HEPZIBAH DRUMMOND, 70s, sits in a rocking chair with a shawl.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Her son, WILFRED DRUMMOND, 40s, hovers by the doorway.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "A neighbor, MISS ODALYS PRENTISS, 60s, stirs tea at a side table.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Mrs. Drummond, when did you last see your husband?", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Yesterday. At supper.", "name": "HEPZIBAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "She means Tuesday.", "name": "WILFRED", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "I mean yesterday.", "name": "HEPZIBAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "It was Tuesday, Mother.", "name": "WILFRED", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Then it was Tuesday.", "name": "HEPZIBAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Tuesday supper.", "name": "ABEL", "speaker": 1, "ext": [], "paren": ["writing"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "I brought the pie.", "name": "ODALYS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Which pie?", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Gooseberry.", "name": "ODALYS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "It's always gooseberry.", "name": "WILFRED", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "It's his favorite.", "name": "ODALYS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "It was his favorite.", "name": "HEPZIBAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "A beat.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "The storm slaps the glass.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Odalys sets down the spoon.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Was there anything unusual about the evening?", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "He was quiet.", "name": "HEPZIBAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "He was always quiet.", "name": "WILFRED", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Not like that.", "name": "HEPZIBAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "He mentioned the lamp.", "name": "ODALYS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "The lamp?", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "He said it would go out. Soon.", "name": "ODALYS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "It did go out.", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "It didn't go out. It was put out.", "name": "WILFRED", "speaker": 3, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Wilfred.", "name": "HEPZIBAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "I'm only saying.", "name": "WILFRED", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Mr. Drummond, do you have something to tell me?", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Wilfred looks at his mother.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "At Odalys.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "At the floor.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "The woodstove ticks.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Hepzibah rocks slowly.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "No.", "name": "WILFRED", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Mrs. Drummond?", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "I think he does.", "name": "HEPZIBAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Wilfred swallows.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Odalys looks at her hands.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Abel's pen hovers above the page.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Gwendolyn waits, patient as the sea.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}]}