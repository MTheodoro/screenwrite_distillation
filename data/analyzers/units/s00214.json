status?", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Nothing on the east road.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Still no word from Command.", "name": "TEODORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "They'll come.", "name": "RAFFERTY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "When?", "name": "TEODORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Soon.", "name": "RAFFERTY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Static.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Then a faint voice.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Bell Tower, this is Command. Abort. Repeat, abort. Fall back to the bridge.", "name": "COMMAND", "speaker": 5, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Teodora stares at the handset.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "She passes it to Rafferty.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Command, say again.", "name": "RAFFERTY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "The bridge. Now.", "name": "COMMAND", "speaker": 5, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Rafferty crushes the map.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Anneliese tightens her scarf.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Desmond stows the binoculars.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Matteo looks at all of them.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Are we leaving?", "name": "MATTEO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "We're leaving.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Can I bring the bell?", "name": "MATTEO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "It's too heavy, Matteo.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": ["gently"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "I know. I just wanted to ask.", "name": "MATTEO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}