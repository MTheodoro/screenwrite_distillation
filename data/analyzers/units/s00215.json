{"scene_id": "s00215", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00215.fountain", "heading": "INT. COUNTY MORGUE - NIGHT", "cast": [{"id": 0, "name": "HILDEGARD OYELOWO-STRAND", "names": ["HILDEGARD OYELOWO-STRAND", "HILDEGARD"], "gender": "?", "first": 5, "spoke": 14}, {"id": 1, "name": "MARCUS PELL", "names": ["MARCUS PELL", "MARCUS"], "gender": "?", "first": 6, "spoke": 7}, {"id": 2, "name": "EUGENE FAIRBANKS", "names": ["EUGENE FAIRBANKS", "EUGENE"], "gender": "?", "first": 7, "spoke": 9}, {"id": 3, "name": "BODY", "names": ["BODY"], "gender": "?", "first": 71, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. COUNTY MORGUE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Steel drawers.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cold fluorescent light.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A radiator knocks.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A gurney in the center.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. HILDEGARD OYELOWO-STRAND, 50s, in scrubs, writes a label.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her assistant, MARCUS PELL, 20s, wheels in a covered body.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "The night guard, EUGENE FAIRBANKS, 60s, sips coffee near the door.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Last one tonight.", "name": "HILDEGARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Where do I put him?", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Drawer fourteen.", "name": "HILDEGARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Marcus wheels the gurney to the wall.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "He opens the drawer.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "It's already occupied.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Dr. Strand?", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "What?", "name": "HILDEGARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Fourteen's full.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "It can't be.", "name": "HILDEGARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "She crosses.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "They both look in.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "A sheet.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "A shape.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Hildegard flips back a corner.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "A pale face.", "para": 3, "sent": 5, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Marcus gasps.", "para": 3, "sent": 6, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "That's the same guy.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "That's impossible.", "name": "HILDEGARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "She looks at the gurney.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Lifts the sheet there.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "The same face.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Eugene. Eugene, come look.", "name": "HILDEGARD", "speaker": 0, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "I don't want to.", "name": "EUGENE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Come look.", "name": "HILDEGARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "I'm on break.", "name": "EUGENE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Eugene.", "name": "HILDEGARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "He sets down the coffee.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Comes over, reluctant.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Looks at the two faces.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Pales.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Oh, hell.", "name": "EUGENE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Maybe it's twins.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Twins don't die the same day.", "name": "EUGENE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "They do sometimes.", "name": "HILDEGARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Do they?", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "It happens.", "name": "HILDEGARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Lights flicker.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "A drawer slides open on its own.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Another.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Then another.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Down the long row, one by one, the drawers roll out.", "para": 6, "sent": 4, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Cold fog spills across the floor.", "para": 6, "sent": 5, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Not again.", "name": "EUGENE", "speaker": 2, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Not again?", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Last time was '98.", "name": "EUGENE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "What happened in '98?", "name": "HILDEGARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "They all sat up.", "name": "EUGENE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "The radiator stops knocking.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Sheets rustle.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Marcus slowly retreats against the wall.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "Hildegard grabs a scalpel and holds it like a talisman.", "para": 7, "sent": 4, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Everyone stay calm.", "name": "HILDEGARD", "speaker": 0, "ext": [], "paren": ["trembling"], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "A hand lifts from drawer fourteen and grips the edge.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "Eugene. Lock the door.", "name": "HILDEGARD", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "It's already locked.", "name": "EUGENE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "From the outside?", "name": "HILDEGARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "From the outside.", "name": "EUGENE", "speaker": 2, "ext": [], "paren": ["realizing"], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "The lights go out.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "Somewhere, a gurney wheel squeaks.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "Hildegard's breath catches.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "Then a voice, small and cheerful, from the dark.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 71, "kind": "dialogue", "text": "Evening, doctor.", "name": "BODY", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "action", "text": "The lights flick on.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "action", "text": "Every drawer is open.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "Every sheet is empty.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}]}