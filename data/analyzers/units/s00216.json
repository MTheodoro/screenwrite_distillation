{"scene_id": "s00216", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00216.fountain", "heading": "INT. FAMILY MINIVAN - PARKED AT A DRIVE-IN - NIGHT", "cast": [{"id": 0, "name": "NADINE OKORO-LANCASTER", "names": ["NADINE OKORO-LANCASTER", "NADINE"], "gender": "f", "first": 4, "spoke": 5}, {"id": 1, "name": "RUFUS", "names": ["RUFUS"], "gender": "?", "first": 4, "spoke": 4}, {"id": 2, "name": "GRETCHEN LANCASTER-PRICE", "names": ["GRETCHEN LANCASTER-PRICE", "GRETCHEN"], "gender": "?", "first": 5, "spoke": 5}, {"id": 3, "name": "COACH TANAKA", "names": ["COACH TANAKA"], "gender": "?", "first": 16, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. FAMILY MINIVAN - PARKED AT A DRIVE-IN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Back seat.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The movie flickers through the windshield.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Popcorn spills.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "NADINE OKORO-LANCASTER, 16, sits in the back with her little brother, RUFUS, 9, who holds a box of candy.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "In the front, their mother, GRETCHEN LANCASTER-PRICE, 40s, glances at the rear-view mirror.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "A phone buzzes in the cupholder.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Rufus, quit kicking the seat.", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "I'm not.", "name": "RUFUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "You are, honey.", "name": "GRETCHEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "It's the movie.", "name": "RUFUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "The movie doesn't kick.", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Gretchen picks up the phone.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Reads the screen.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Her face stiffens.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "She answers on speaker.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Mrs. Lancaster-Price? It's about Nadine. She missed practice again.", "name": "COACH TANAKA", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Nadine freezes.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Rufus stops chewing.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Thank you, Coach. We'll talk.", "name": "GRETCHEN", "speaker": 2, "ext": [], "paren": ["evenly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "I just want her to know there's a spot.", "name": "COACH TANAKA", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Thank you.", "name": "GRETCHEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "She hangs up.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "A long silence.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "On the screen, an actress screams.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Nadine stares at her knees.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Nadine.", "name": "GRETCHEN", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "I can explain.", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Please do.", "name": "GRETCHEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "I don't want to play.", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "She's been going to the library instead.", "name": "RUFUS", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Rufus!", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Sorry!", "name": "RUFUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Gretchen watches them in the mirror.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Then she reaches back and puts a hand on Nadine's knee.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "It stays there.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "On screen, the credits roll.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}]}