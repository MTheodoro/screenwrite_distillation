{"scene_id": "s00217", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00217.fountain", "heading": "INT. DEPARTMENT OF PAPERWORK - FILE ROOM - DAY", "cast": [{"id": 0, "name": "NUMBER", "names": ["NUMBER"], "gender": "?", "first": 3, "spoke": 0}, {"id": 1, "name": "BARNABY OKAFOR-STILLWELL", "names": ["BARNABY OKAFOR-STILLWELL", "BARNABY"], "gender": "?", "first": 5, "spoke": 12}, {"id": 2, "name": "ODALYS PEREIRA-HOLM", "names": ["ODALYS PEREIRA-HOLM", "ODALYS"], "gender": "?", "first": 6, "spoke": 9}, {"id": 3, "name": "DIRECTOR PRUDENCE KWAKU-LINDHOLM", "names": ["DIRECTOR PRUDENCE KWAKU-LINDHOLM"], "gender": "?", "first": 27, "spoke": 0}, {"id": 4, "name": "DIRECTOR KWAKU", "names": ["DIRECTOR KWAKU"], "gender": "?", "first": 27, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. DEPARTMENT OF PAPERWORK - FILE ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Towering stacks of manila folders.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A hum of fluorescents.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A sign: \"PLEASE TAKE A NUMBER.\"", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "No one has ever taken a number.", "para": 0, "sent": 3, "present": [0]}, {"u": 5, "kind": "action", "text": "BARNABY OKAFOR-STILLWELL, 40s, junior filing clerk, sits behind a desk stamping forms.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "His coworker, ODALYS PEREIRA-HOLM, 30s, shuffles a stack.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Their cart squeaks.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Form 27B.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Stamped?", "name": "ODALYS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Stamped.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Triplicate?", "name": "ODALYS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Quadruplicate.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Since when?", "name": "ODALYS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Since the memo.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "What memo?", "name": "ODALYS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "The memo that supersedes the memo.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Odalys sighs.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "The cart rolls away on its own and bumps a shelf.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "A folder falls.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Both stare at it.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "That one's supposed to stay up.", "name": "BARNABY", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Why?", "name": "ODALYS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "It's the only copy.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Of what?", "name": "ODALYS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Of us.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The door at the end of the aisle swings open.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "A figure strides in with a clipboard: DIRECTOR PRUDENCE KWAKU-LINDHOLM, 50s, stern, wearing a gray suit and a visitor badge.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Which of you is Barnaby?", "name": "DIRECTOR KWAKU", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "That's me.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "You've been stamping form 27B in triplicate.", "name": "DIRECTOR KWAKU", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Quadruplicate, ma'am.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "It's supposed to be quintuplicate.", "name": "DIRECTOR KWAKU", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Since when?", "name": "ODALYS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Since yesterday.", "name": "DIRECTOR KWAKU", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "But the memo said...", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "The memo was superseded.", "name": "DIRECTOR KWAKU", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "By what?", "name": "ODALYS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "By me.", "name": "DIRECTOR KWAKU", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Barnaby looks at Odalys.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Odalys looks at the stamp.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Director Kwaku makes a small note.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Rectify by Friday.", "name": "DIRECTOR KWAKU", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "All of them?", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "All of them.", "name": "DIRECTOR KWAKU", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "That's forty thousand.", "name": "ODALYS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Then you had better start.", "name": "DIRECTOR KWAKU", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "She leaves.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "The door sighs shut.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Barnaby slowly lowers the stamp.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "It makes a small, lonely thud.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}]}