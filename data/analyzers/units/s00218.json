{"scene_id": "s00218", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00218.fountain", "heading": "INT. SAFEHOUSE - BASEMENT - NIGHT", "cast": [{"id": 0, "name": "AGENT RENATA OYEKAN-VOSS", "names": ["AGENT RENATA OYEKAN-VOSS", "RENATA"], "gender": "f", "first": 4, "spoke": 7}, {"id": 1, "name": "AGENT BASTIAN HALVORSEN", "names": ["AGENT BASTIAN HALVORSEN", "BASTIAN"], "gender": "?", "first": 5, "spoke": 7}, {"id": 2, "name": "TEDDIE", "names": ["TEDDIE"], "gender": "?", "first": 6, "spoke": 10}, {"id": 3, "name": "KAPLAN", "names": ["KAPLAN"], "gender": "?", "first": 6, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. SAFEHOUSE - BASEMENT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Concrete walls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Bare bulb.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A card table with a laptop and a stack of cash.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "AGENT RENATA OYEKAN-VOSS, 40s, slumps in a chair.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "AGENT BASTIAN HALVORSEN, 30s, paces.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "The informant, THEODORA \"TEDDIE\" KAPLAN, 50s, rocks nervously on a stool.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "You said they'd be here by midnight.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "They will be.", "name": "BASTIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "They won't. They're never late, and they're never early. They're just there.", "name": "TEDDIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Teddie.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "It's a fact.", "name": "TEDDIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "You've been saying that for two hours.", "name": "BASTIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "It's been true for two hours.", "name": "TEDDIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Renata rubs her eyes.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Bastian stops pacing, then resumes.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Teddie hums something tuneless.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Stop humming.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "I'm not humming.", "name": "TEDDIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "You are.", "name": "BASTIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "It's the pipes.", "name": "TEDDIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "The pipes knock.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "All three look up.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "The knocking repeats, in a pattern.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "That's not pipes.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "That's Morse.", "name": "BASTIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "It's the wind.", "name": "TEDDIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "In a basement?", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "It's a drafty basement.", "name": "TEDDIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Bastian crosses to the wall.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Presses an ear against it.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Renata draws her weapon.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "The knocking stops.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Someone's behind this wall.", "name": "BASTIAN", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "That's the neighbor's.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "We don't have a neighbor.", "name": "BASTIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Teddie stands.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Her stool tips over.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "She backs toward the stairs.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "I told you. I told both of you.", "name": "TEDDIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Teddie, sit down.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "I'm leaving.", "name": "TEDDIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "You're not.", "name": "BASTIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Watch me.", "name": "TEDDIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "The wall cracks.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Plaster dust sprinkles the table.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "A fist punches through.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Renata fires.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Bastian ducks.", "para": 6, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Teddie screams and bolts up the stairs, and the bulb swings wildly, throwing shadows across the concrete.", "para": 6, "sent": 5, "present": [0, 1, 2, 3]}]}