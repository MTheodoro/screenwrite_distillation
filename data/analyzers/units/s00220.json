{"scene_id": "s00220", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00220.fountain", "heading": "INT. DRYDOCK CANTEEN - NIGHT", "cast": [{"id": 0, "name": "ODALYS VANTERPOOL", "names": ["ODALYS VANTERPOOL", "ODALYS"], "gender": "?", "first": 4, "spoke": 17}, {"id": 1, "name": "BRANIMIR KOSTA", "names": ["BRANIMIR KOSTA", "BRANIMIR"], "gender": "m", "first": 6, "spoke": 9}, {"id": 2, "name": "KIRIN ASHWORTH", "names": ["KIRIN ASHWORTH", "KIRIN"], "gender": "?", "first": 7, "spoke": 5}, {"id": 3, "name": "BIG HOLLIS", "names": ["BIG HOLLIS", "HOLLIS"], "gender": "?", "first": 8, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRYDOCK CANTEEN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Steel table.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cold tea.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A hull looms through the window, half-painted.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ODALYS VANTERPOOL (50s, foreman, grease-stained clipboard) stands.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Doesn't sit.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "BRANIMIR KOSTA (60s, welder, one good eye) stares at his hands.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "KIRIN ASHWORTH (19, apprentice, new boots) hovers by the door.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "BIG HOLLIS (40s, union steward, arms folded) leans on the vending machine.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Listen up. Inspection failed. Weld seam forty-two.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Forty-two. Forty-two.", "name": "BRANIMIR", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Branimir.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "I heard.", "name": "BRANIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Who signed off on it?", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Does it matter?", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "It matters.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "It was me.", "name": "KIRIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Everyone turns.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Branimir was on break. I did the pass. I thought it was good.", "name": "KIRIN", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "It wasn't him.", "name": "BRANIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "It was.", "name": "KIRIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Boy, sit down.", "name": "BRANIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Kirin, did you X-ray the seam?", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "No ma'am. There was no film left.", "name": "KIRIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "No film. On a Tuesday.", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Who's in charge of ordering film?", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "You are.", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Right. Right.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": ["beat"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "So it's your film. Your seam. Your hull.", "name": "BRANIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Don't.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Forty years I never missed a seam.", "name": "BRANIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "I know.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Forty years.", "name": "BRANIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "I know, Branimir.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Nobody gets fired tonight.", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Not your call.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "It's the contract.", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "The contract says a lot of things.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "The ship sails Friday.", "name": "BRANIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "The ship does not sail Friday.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Is it really that bad?", "name": "KIRIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "It's a hairline crack, Kirin. At sea it opens like a zipper.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Her hand slams the table.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Tea jumps.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Kirin flinches.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Branimir laughs.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Short.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Dry.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Then we cut it out. Tonight. Four of us.", "name": "BRANIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Four of us.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Overtime's on the union.", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Film. I forgot the film.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "She picks up the clipboard.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Puts it down.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Picks up four mugs instead.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Tea's cold. I'll make fresh.", "name": "ODALYS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}