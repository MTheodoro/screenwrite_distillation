{"scene_id": "s00221", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00221.fountain", "heading": "INT. CLOSED PLANETARIUM - NIGHT", "cast": [{"id": 0, "name": "WOMAN", "names": ["WOMAN"], "gender": "f", "first": 6, "spoke": 14}, {"id": 1, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 9, "spoke": 11}, {"id": 2, "name": "DESMOND", "names": ["DESMOND"], "gender": "?", "first": 52, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. CLOSED PLANETARIUM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A domed room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of empty reclining seats.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A projector hums in the center, casting a slow field of stars across the ceiling.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A man in a damp raincoat stands at the control console.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "He wipes his hands on a handkerchief, one finger at a time.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "A WOMAN enters from the lobby door, keys in her hand.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "She stops.", "para": 2, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "She does not turn on the lights.", "para": 2, "sent": 2, "present": [0]}, {"u": 9, "kind": "dialogue", "text": "Evening.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She sets her keys on the nearest seat, carefully, so they make no sound.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "We're closed.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "So I see.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He nudges a dial.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "The stars drift.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "A comet crosses the dome.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Door was locked.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "It was.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He smiles at the ceiling.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She watches his hands.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "You want something to drink? There's a kettle in the office.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Kind of you.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "She does not move toward the office.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Neither does he.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Your coat's wet.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "It's been a long walk.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "From where?", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "He lets the question hang.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "The comet fades.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "You kept the Orion show. They told me you'd cut it.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Who told you?", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Man at the ticket window. Years ago.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "She takes one step down the aisle.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "He takes one up.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "They stop level with the fourth row.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "I don't think I know you.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "No. But your husband did.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Her jaw sets.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "She glances at the exit sign, then back.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "My husband's dead.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "That's what I said. Did.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "She reaches slowly into her coat pocket.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "He watches it.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "She pulls out a small brass key and holds it up between two fingers.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Basement. Where he kept the film reels.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "I thought so.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "He wrote a name on every can. Yours is on the third shelf.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "He doesn't answer.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "The stars wheel overhead.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Tell me your name and I'll hand you the key.", "name": "WOMAN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "A long beat.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "He folds the handkerchief into a square.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Desmond Pryce.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Thank you, Mr. Pryce.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "She places the key on the armrest between them.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "He doesn't reach for it.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "Aren't you going to ask what's on the reel?", "name": "DESMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "No.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "She picks up her own keys again.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Turns toward the lobby.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "Stops with her back to him.", "para": 14, "sent": 2, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "The lights come on at eleven. You have twenty minutes.", "name": "WOMAN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "She leaves.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "The door sighs shut.", "para": 15, "sent": 1, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "He stands alone beneath Orion.", "para": 16, "sent": 0, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "Then he takes the key.", "para": 16, "sent": 1, "present": [0, 1, 2]}]}