{"scene_id": "s00222", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00222.fountain", "heading": "INT. SALT WAREHOUSE, CANAL DISTRICT - DAWN", "cast": [{"id": 0, "name": "INSPECTOR NNAMDI OKONKWO-REYES", "names": ["INSPECTOR NNAMDI OKONKWO-REYES", "INSPECTOR", "OKONKWO-REYES"], "gender": "m", "first": 6, "spoke": 18}, {"id": 1, "name": "SERGEANT IMOGEN BRAITHWAITE", "names": ["SERGEANT IMOGEN BRAITHWAITE", "IMOGEN"], "gender": "?", "first": 7, "spoke": 14}, {"id": 2, "name": "PETRU LAZAR", "names": ["PETRU LAZAR", "PETRU"], "gender": "?", "first": 7, "spoke": 15}, {"id": 3, "name": "DOLORES HALLORAN", "names": ["DOLORES HALLORAN", "DOLORES"], "gender": "?", "first": 40, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. SALT WAREHOUSE, CANAL DISTRICT - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Mountains of grey salt.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rafters.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single skylight.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Footsteps.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "Crunch.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "INSPECTOR NNAMDI OKONKWO-REYES (40s, rumpled suit, tired eyes) walks the center aisle with a flashlight he doesn't need.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Behind him: SERGEANT IMOGEN BRAITHWAITE (30s, crisp, notebook) and old watchman PETRU LAZAR (70s, cap, cough).", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Quiet.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Almost peaceful.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Pretty, isn't it.", "name": "INSPECTOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "It's a crime scene, sir.", "name": "IMOGEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Can't it be both?", "name": "OKONKWO-REYES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Nobody touched nothing. I swear on my mother.", "name": "PETRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Mr. Lazar, relax. Nobody's accusing.", "name": "OKONKWO-REYES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Petru coughs.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Wipes his mouth.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Body's in the east bay. Under three feet of salt. Found by the forklift driver.", "name": "IMOGEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Where's the driver?", "name": "OKONKWO-REYES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Home. Sick.", "name": "PETRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Sick how?", "name": "IMOGEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Sick sick. He threw up.", "name": "PETRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Reasonable.", "name": "OKONKWO-REYES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "They reach the east bay.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "A yellow tape.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "A shallow trench.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The trench is empty.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "That's not right.", "name": "IMOGEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "No.", "name": "OKONKWO-REYES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Forensics bagged her at four a.m. I signed the form.", "name": "IMOGEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "I seen them take her. Two men. White van.", "name": "PETRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "What men?", "name": "OKONKWO-REYES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Men in coats.", "name": "PETRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Our men?", "name": "IMOGEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "How would I know your men?", "name": "PETRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Mr. Lazar. Tonight. Did anyone come in after the van?", "name": "OKONKWO-REYES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Nobody.", "name": "PETRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Nobody?", "name": "IMOGEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "The lady from the office. She forgot her umbrella.", "name": "PETRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "What lady?", "name": "OKONKWO-REYES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Miss Halloran. Dolores.", "name": "PETRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Dolores Halloran? She's been on leave a month.", "name": "IMOGEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Then I seen a ghost.", "name": "PETRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Silence.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Salt trickles from a heap.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Somewhere a pigeon.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Sergeant. Phone the office.", "name": "OKONKWO-REYES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "It's six a.m.", "name": "IMOGEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Phone.", "name": "OKONKWO-REYES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "She does.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Holds it to her ear.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Her face changes.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Straight to voicemail. Her own voice.", "name": "IMOGEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Whose voice?", "name": "OKONKWO-REYES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Halloran's. She says: \"Leave a message after the salt.\"", "name": "IMOGEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "What does that mean?", "name": "PETRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "It means someone's been here longer than we have.", "name": "OKONKWO-REYES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "He turns.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "Beams the flashlight into the rafters.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "A shape up there.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "A woman crouched on a beam.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "Umbrella in hand.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "DOLORES HALLORAN (50s, grey coat, composed) peers down.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "Inspector. I wondered when you'd look up.", "name": "DOLORES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "Ma'am, come down. Slowly.", "name": "IMOGEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "I'd rather you came up.", "name": "DOLORES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "Holy mother.", "name": "PETRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "Miss Halloran. Where's the body?", "name": "OKONKWO-REYES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "Under you.", "name": "DOLORES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "Everyone looks down.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "The salt floor shifts.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "dialogue", "text": "Sir.", "name": "IMOGEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "I see it.", "name": "OKONKWO-REYES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "I told you nothing was touched!", "name": "PETRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "dialogue", "text": "You told them nothing. That's different.", "name": "DOLORES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "She raises the umbrella.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "Opens it.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "Salt rains from the folds.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "dialogue", "text": "Sergeant. Cuff Mr. Lazar.", "name": "OKONKWO-REYES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "dialogue", "text": "Me?", "name": "PETRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "dialogue", "text": "Mr. Lazar, you have the right to--", "name": "IMOGEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "dialogue", "text": "I was told to say nothing! They said the lady would pay!", "name": "PETRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "dialogue", "text": "And I did.", "name": "DOLORES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "action", "text": "She drops.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 84, "kind": "action", "text": "The umbrella floats her down like a slow bell.", "para": 15, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 85, "kind": "action", "text": "She lands in the salt without a sound.", "para": 15, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 86, "kind": "dialogue", "text": "Dolores Halloran, you are under arrest.", "name": "OKONKWO-REYES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 87, "kind": "dialogue", "text": "For which one?", "name": "DOLORES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 88, "kind": "action", "text": "Okonkwo-Reyes smiles, tired.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 89, "kind": "dialogue", "text": "Start with the umbrella.", "name": "OKONKWO-REYES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}