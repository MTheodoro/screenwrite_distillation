{"scene_id": "s00223", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00223.fountain", "heading": "INT. DAIRY-CASE AISLE, 24-HOUR GROCERY - 3 A.M.", "cast": [{"id": 0, "name": "TOBIAS WREN-ALDRIDGE", "names": ["TOBIAS WREN-ALDRIDGE", "TOBIAS"], "gender": "?", "first": 3, "spoke": 5}, {"id": 1, "name": "PRISCILLA OYELARAN", "names": ["PRISCILLA OYELARAN", "PRISCILLA"], "gender": "?", "first": 6, "spoke": 2}, {"id": 2, "name": "DIMA", "names": ["DIMA"], "gender": "m", "first": 7, "spoke": 2}, {"id": 3, "name": "ROSENFELD", "names": ["ROSENFELD"], "gender": "?", "first": 7, "spoke": 0}, {"id": 4, "name": "HYACINTH PELL", "names": ["HYACINTH PELL", "HYACINTH"], "gender": "f", "first": 8, "spoke": 1}, {"id": 5, "name": "MARGUERITE", "names": ["MARGUERITE"], "gender": "?", "first": 9, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. DAIRY-CASE AISLE, 24-HOUR GROCERY - 3 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent hum.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Forty brands of yogurt, all the same.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "TOBIAS WREN-ALDRIDGE (30s, Regional Synergy Lead, lanyard, no pulse) holds a laser pointer at a shelf.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "dialogue", "text": "Team. Our learning: yogurt is a journey.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 5, "kind": "action", "text": "Four night-shift stockers stare back.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "PRISCILLA OYELARAN (40s, forklift certified, unimpressed) holds a pallet jack like a shield.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "DMITRI \"DIMA\" ROSENFELD (20s, hoodie, headphones around his neck) eats a yogurt, deliberately.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "HYACINTH PELL (50s, reading glasses on a chain, ex-accountant) checks her watch.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "MARGUERITE (60s, no last name anyone remembers) is asleep standing up.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Going forward, we are removing the word \"expired.\"", "name": "TOBIAS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "We're what?", "name": "PRISCILLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "We're reframing it as \"mature.\"", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "Dima's spoon stops.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "He puts it down.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "That's illegal.", "name": "DIMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "That's agile.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "I left a pension for this.", "name": "HYACINTH", "speaker": 4, "ext": [], "paren": ["to no one"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Tobias fires the laser pointer at Marguerite's forehead.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Is it the fire?", "name": "MARGUERITE", "speaker": 5, "ext": [], "paren": ["eyes closed"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "No, Marguerite. It's the Synergy Lead.", "name": "PRISCILLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Marguerite nods, drifts off again.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Tobias lowers the pointer.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Okay. Okay. Is there anything anyone wants to say before we align?", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Silence.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Dima raises his yogurt like a toast.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Mature.", "name": "DIMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}