{"scene_id": "s00224", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00224.fountain", "heading": "INT. ROLLER RINK, AFTER CLOSING - NIGHT", "cast": [{"id": 0, "name": "TEDDY", "names": ["TEDDY"], "gender": "f", "first": 5, "spoke": 6}, {"id": 1, "name": "AUGUSTIN MWANGI", "names": ["MWANGI", "AUGUSTIN MWANGI", "AUGUSTIN"], "gender": "?", "first": 5, "spoke": 6}, {"id": 2, "name": "FAYE SOLOMON-DRAKE", "names": ["FAYE SOLOMON-DRAKE", "FAYE"], "gender": "f", "first": 8, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROLLER RINK, AFTER CLOSING - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Mirror ball stopped.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "House lights half up.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rental skates in cubbies.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A snack bar with its grill off.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "THEODORA \"TEDDY\" MWANGI (11) sits on the rail, one skate on, one off.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Rink floor gleams.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Her father, AUGUSTIN MWANGI (40s, rink manager, keys on a belt loop), mops the far lane.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Her aunt FAYE SOLOMON-DRAKE (30s, coat still on, car keys in fist) walks in from the lobby.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Door was open.", "name": "FAYE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I'm still here.", "name": "AUGUSTIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He keeps mopping.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Faye watches the bucket.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Teddy. Shoes.", "name": "FAYE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Teddy doesn't move.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Your dad and I need a minute.", "name": "FAYE", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "You can say it in front of me.", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Teddy.", "name": "AUGUSTIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "I'm eleven, not stupid.", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Faye crosses to the rail.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Sits one spot down.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Close, not close enough.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "The offer's still open. The spare room. The school's good.", "name": "FAYE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Her school's good here.", "name": "AUGUSTIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "It's two hours away.", "name": "FAYE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "It's my kid.", "name": "AUGUSTIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "He stops mopping.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Leans the handle on the wall.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Teddy pulls her second skate off.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Sets it beside the first.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Lines them up, toes touching.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Do I get a vote?", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Of course you do.", "name": "FAYE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Of course.", "name": "AUGUSTIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Neither of them looks at her.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Mom's skates are still in the office.", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Augustin and Faye both freeze.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Faye stares at the floor.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Augustin studies the ceiling.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "They don't fit anyone.", "name": "AUGUSTIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "They fit me.", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Faye lets out a breath.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Almost a laugh.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Size five. She had tiny feet.", "name": "FAYE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Augustin walks to the snack bar.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Pours three cups of water from the tap.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Brings them over.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Hands one to each.", "para": 12, "sent": 3, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "They drink.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "The ice machine clunks.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Can I skate once? Alone? Then we decide.", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Augustin looks at Faye.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Faye looks at Augustin.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Slowly, both nod.", "para": 14, "sent": 2, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Teddy slides off the rail in her socks.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Walks to the center of the empty rink.", "para": 15, "sent": 1, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "She doesn't skate.", "para": 16, "sent": 0, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "She just stands there.", "para": 16, "sent": 1, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Arms out.", "para": 16, "sent": 2, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Eyes closed.", "para": 16, "sent": 3, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "Faye puts her cup down.", "para": 17, "sent": 0, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "Augustin sits.", "para": 17, "sent": 1, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "They wait.", "para": 18, "sent": 0, "present": [0, 1, 2]}]}