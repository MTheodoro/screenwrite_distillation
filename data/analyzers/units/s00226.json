{"scene_id": "s00226", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00226.fountain", "heading": "INT. GRAIN ELEVATOR CONTROL ROOM - NIGHT", "cast": [{"id": 0, "name": "LEONIDAS PAPADAKIS", "names": ["LEONIDAS PAPADAKIS", "LEONIDAS"], "gender": "?", "first": 4, "spoke": 13}, {"id": 1, "name": "CORA BEAUMONT-TEAGUE", "names": ["CORA BEAUMONT-TEAGUE", "CORA"], "gender": "?", "first": 9, "spoke": 12}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRAIN ELEVATOR CONTROL ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped booth above a concrete silo.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dials, a swivel chair, a space heater.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Through the window, conveyor belts hang motionless in the dark.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LEONIDAS PAPADAKIS (50s, county auditor, windbreaker) sits at the desk with a ledger open.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He checks numbers with a pencil.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "He is calm.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "Boots on the iron stairs.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "The door opens.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "CORA BEAUMONT-TEAGUE (40s, elevator manager, rolled sleeves) enters with two chipped mugs of coffee.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Cream?", "name": "CORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Black's fine.", "name": "LEONIDAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She hands him a mug.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He sips.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She doesn't.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Long drive from the county seat.", "name": "CORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Two hours. I like the quiet.", "name": "LEONIDAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Nothing quieter than a silo at midnight.", "name": "CORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He nods and turns a page.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She studies the back of his head.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "The weigh tickets for September match the bank deposits.", "name": "LEONIDAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Good.", "name": "CORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "October's a little thin.", "name": "LEONIDAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Rain. Hauling slowed.", "name": "CORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Mm.", "name": "LEONIDAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "He turns another page.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Behind him, a shadow crosses the window.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Cora sees it.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "She doesn't blink.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "It's the volume I can't square. Four thousand bushels, gone on paper.", "name": "LEONIDAS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Spillage.", "name": "CORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "That's a lot of spillage.", "name": "LEONIDAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "It's a big elevator.", "name": "CORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "He closes the ledger.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Looks at her for the first time.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "I'd like to use your phone.", "name": "LEONIDAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Line's down.", "name": "CORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "It was working an hour ago.", "name": "LEONIDAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Storms.", "name": "CORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "There are no storms.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Both of them know it.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "He reaches for the receiver on the wall.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "She reaches for it too.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Their hands land on it together.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "They freeze, her fingers over his, the heater ticking.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Don't.", "name": "CORA", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Let go.", "name": "LEONIDAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "She grips harder.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "He twists.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "The mugs rattle off the desk and shatter, coffee across the ledger.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "They stumble apart, both breathing hard.", "para": 10, "sent": 3, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "I've already sent copies to the state office.", "name": "LEONIDAS", "speaker": 0, "ext": ["CONT'D"], "paren": ["softly"], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "Cora lets go of the phone.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "She sinks into the swivel chair.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "When?", "name": "CORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "Tuesday.", "name": "LEONIDAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "She begins, quietly, to laugh.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "Then why did you drive out?", "name": "CORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "To give you a chance to explain.", "name": "LEONIDAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "Outside, the conveyor belts begin to turn on their own.", "para": 13, "sent": 0, "present": [0, 1]}]}