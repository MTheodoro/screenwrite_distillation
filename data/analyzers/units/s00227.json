{"scene_id": "s00227", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00227.fountain", "heading": "EXT. SALT FLAT, ABANDONED STAGE STOP - NOON", "cast": [{"id": 0, "name": "JED", "names": ["JED"], "gender": "?", "first": 5, "spoke": 7}, {"id": 1, "name": "ARROWOOD", "names": ["ARROWOOD"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "MARISOL QUINTANILLA", "names": ["MARISOL QUINTANILLA", "MARISOL"], "gender": "?", "first": 10, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SALT FLAT, ABANDONED STAGE STOP - NOON", "present": []}, {"u": 1, "kind": "action", "text": "White ground.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "White sky.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A dead well.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Two hitching posts.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "JEDEDIAH \"JED\" ARROWOOD (50s, long duster, one glove) sits on a crate.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Whittles.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Doesn't look up.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Hooves.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Slow.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "MARISOL QUINTANILLA (30s, black hat, rifle across the saddle) rides in.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Stops thirty feet off.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "He keeps whittling.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She keeps still.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Water's bad.", "name": "JED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "I brought my own.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Figured.", "name": "JED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "She swings down.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Boots crunch.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "She leaves the rifle on the horse.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "He folds his knife.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Slides it into his boot.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "You're a long way from Dodge.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "So are you.", "name": "JED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "A hawk.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "A wind.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Nothing else.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "She walks toward him.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Ten feet.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Five.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Eleven years.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Twelve.", "name": "JED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "She stops.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Her hand drifts to the holster.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "He raises his glove hand.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Slow.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Palm out.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "I don't have a gun.", "name": "JED", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Liar.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Left it in the well.", "name": "JED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "She stares.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Then at the well.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Back at him.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Why?", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "So you'd have to ask.", "name": "JED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "She draws.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "He doesn't move.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "The barrel shakes.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "The hawk screams.", "para": 13, "sent": 2, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Then she holsters it, and slaps him once across the face with the flat of her hand.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "He takes it.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Now we're even.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "She turns for her horse.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "He lets out a breath that's been twelve years in the making.", "para": 15, "sent": 1, "present": [0, 1, 2]}]}