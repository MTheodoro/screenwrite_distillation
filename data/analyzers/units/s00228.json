{"scene_id": "s00228", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00228.fountain", "heading": "INT. TREEHOLLOW ARCHIVE OF THE MOSS-KEEPERS - TWILIGHT", "cast": [{"id": 0, "name": "HESPERIA THORNQUILL", "names": ["HESPERIA THORNQUILL", "HESPERIA"], "gender": "f", "first": 5, "spoke": 13}, {"id": 1, "name": "OSWIN FERNLEIGH", "names": ["OSWIN FERNLEIGH", "OSWIN"], "gender": "?", "first": 7, "spoke": 7}, {"id": 2, "name": "BRAMBLE-JACK", "names": ["BRAMBLE-JACK"], "gender": "?", "first": 8, "spoke": 6}, {"id": 3, "name": "ILUNA WAVEREAD", "names": ["ILUNA WAVEREAD", "ILUNA"], "gender": "?", "first": 9, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. TREEHOLLOW ARCHIVE OF THE MOSS-KEEPERS - TWILIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Inside the trunk of a tree so old its heartwood has hollowed into a cathedral.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Shelves of bark scrolls spiral up the walls.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Fireflies drift among them like patient candles.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "At a root-table in the center sit four figures, each with a small lamp.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "HESPERIA THORNQUILL (60s, keeper-in-chief, silver braid to her knees) turns the pages of a mossbound book.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She is calm in the way of those who have never been hurried.", "para": 2, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Beside her, the young scribe OSWIN FERNLEIGH (17, ink to the elbows) copies a line, tongue between his teeth.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Across from them a travelling tinker, BRAMBLE-JACK (40s, patched coat, pockets that clink), polishes a brass key with his sleeve.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "At the end of the table, a stranger from the river-folk, ILUNA WAVEREAD (30s, damp hair, a shell necklace), sits with her chin in her palm.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "We begin the evening readings.", "name": "HESPERIA", "speaker": 0, "ext": [], "paren": ["to the table"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Nobody moves.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "The fireflies drift.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Keeper Thornquill, should I record the weather?", "name": "OSWIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Yes, child. Rain in the east, none in the west.", "name": "HESPERIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Rain in the east.", "name": "OSWIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "He writes.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "She smiles at the book.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Same rain as yesterday. Same rain as a hundred years.", "name": "BRAMBLE-JACK", "speaker": 2, "ext": [], "paren": ["low, to himself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Bramble-Jack, if you have a thought, share it with us all.", "name": "HESPERIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Nothing, Keeper. Just brass.", "name": "BRAMBLE-JACK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "He holds the key up.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "It catches a firefly's light.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "It's a lovely key.", "name": "ILUNA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Isn't it? Found it in a trout.", "name": "BRAMBLE-JACK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "In a trout?", "name": "ILUNA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Don't ask.", "name": "BRAMBLE-JACK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "She laughs, soft, and he looks pleased.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Hesperia closes the book.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Opens another.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Iluna Wavereads. You came with a question.", "name": "HESPERIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "I did. Though it's been so peaceful, I almost forgot.", "name": "ILUNA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Ask it anyway.", "name": "HESPERIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "The river-folk say a door lies under this tree. They say it opens once a generation.", "name": "ILUNA", "speaker": 3, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "The cellar door.", "name": "OSWIN", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Oswin.", "name": "HESPERIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Sorry, Keeper.", "name": "OSWIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Hesperia turns a page.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "The parchment rustles.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "There is a door. It does not open for questions.", "name": "HESPERIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "What does it open for?", "name": "ILUNA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Patience.", "name": "HESPERIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "She's been waiting six years, Keeper. I counted.", "name": "BRAMBLE-JACK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Then six years is not yet enough.", "name": "HESPERIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Iluna sighs, amused rather than defeated.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Oswin, would you like to hear what the river says about the archive?", "name": "ILUNA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Please.", "name": "OSWIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "It says you keep the quietest place in the whole forest.", "name": "ILUNA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "It does?", "name": "OSWIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "It does. And it says the quiet is the door.", "name": "ILUNA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Hesperia looks up from the book for the first time.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Studies the river-woman a long moment.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Who taught you that?", "name": "HESPERIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Nobody. I listened.", "name": "ILUNA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Well. Well, well.", "name": "HESPERIA", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "She closes the book on her finger.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Bramble-Jack, bring the key.", "name": "HESPERIA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "He rises, key in his palm, and crosses the root floor.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "At the base of the spiral stair, he kneels.", "para": 15, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "The key fits nothing visible.", "para": 15, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "Where do I--", "name": "BRAMBLE-JACK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "Wherever it is quietest.", "name": "HESPERIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "He closes his eyes.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "Listens.", "para": 16, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "Then touches the key to the grain of the wood, and the grain opens, gently, like an eyelid.", "para": 16, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "Warm gold light spills across the floor.", "para": 17, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "You did that.", "name": "OSWIN", "speaker": 1, "ext": [], "paren": ["to Iluna"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "We all did.", "name": "ILUNA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "The fireflies drift toward the light, in no hurry at all.", "para": 18, "sent": 0, "present": [0, 1, 2, 3]}]}