{"scene_id": "s00229", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00229.fountain", "heading": "INT. LAUNDROMAT, LATE NIGHT", "cast": [{"id": 0, "name": "NADIRA FAROUK", "names": ["NADIRA FAROUK", "NADIRA"], "gender": "f", "first": 3, "spoke": 5}, {"id": 1, "name": "CASIMIR ODUYA", "names": ["CASIMIR ODUYA", "CASIMIR"], "gender": "m", "first": 4, "spoke": 6}, {"id": 2, "name": "LINNEA HARTWELL-SATO", "names": ["LINNEA HARTWELL-SATO", "LINNEA"], "gender": "f", "first": 5, "spoke": 4}, {"id": 3, "name": "INTERCOM", "names": ["INTERCOM"], "gender": "?", "first": 7, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAUNDROMAT, LATE NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Twelve dryers, three working.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A TV on the wall plays a muted weather channel.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "NADIRA FAROUK (30s, scrubs, hair in a clip) folds towels at a long table, sorts socks into pairs, pulls a stray sock from her pocket and drops it into a lost-and-found bucket, all without looking up.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "Across the room, her brother-in-law CASIMIR ODUYA (40s, security jacket) feeds quarters into a dryer, kicks the door shut, and slumps onto a plastic chair.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "In the corner, a young woman, LINNEA HARTWELL-SATO (20s, headphones, textbook), highlights a page and glances at the clock every half minute.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "An intercom crackles on the wall.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Attention customers. The attendant is on break. Please do not feed the machines your feelings.", "name": "INTERCOM", "speaker": 3, "ext": ["V.O."], "paren": ["tinny, bored"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "That's new.", "name": "CASIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "It's the owner. He thinks he's funny.", "name": "NADIRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "He is not.", "name": "CASIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "A small pause.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "A dryer thumps.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Excuse me. Do you know what time the last bus is?", "name": "LINNEA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "One-ten.", "name": "NADIRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Thanks.", "name": "LINNEA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Ninety-nine percent of the time it's late.", "name": "CASIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Great.", "name": "LINNEA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Nadira pairs two socks, tucks them, sets them on the pile.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Casimir rubs his eyes.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Linnea turns a page of her textbook.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "The weather channel shows a swirl of green over the coast.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "A phone buzzes on the table.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Nadira checks it.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Reads.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Sets it face down.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Hospital?", "name": "CASIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "My shift's covered. They just wanted to tell me.", "name": "NADIRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "That's nice of them.", "name": "CASIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "It's the first time.", "name": "NADIRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "The intercom crackles again.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Dryer six is finished. Dryer six has been finished for forty minutes. Dryer six would like you to take your clothes.", "name": "INTERCOM", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Linnea looks up, guilty.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Hurries to dryer six.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Pulls out a hot tangle of jeans.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Sorry.", "name": "LINNEA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "He's watching us.", "name": "CASIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "He's always watching us.", "name": "NADIRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "She laughs, quiet.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Casimir smiles at his shoes.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Linnea folds her jeans into a small, neat square.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Outside, a bus idles at the curb.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Nobody gets up.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}]}