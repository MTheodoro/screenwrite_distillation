{"scene_id": "s00230", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00230.fountain", "heading": "INT. BACK ROOM, FISH MARKET - PRE-DAWN", "cast": [{"id": 0, "name": "SAL KNIFE", "names": ["SAL KNIFE", "SAL"], "gender": "?", "first": 4, "spoke": 7}, {"id": 1, "name": "BIANCHINI", "names": ["BIANCHINI"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "RENZO", "names": ["RENZO"], "gender": "?", "first": 5, "spoke": 3}, {"id": 3, "name": "DETECTIVE MARISELA OYELOWO-KANE", "names": ["DETECTIVE MARISELA OYELOWO-KANE", "MARISELA"], "gender": "?", "first": 6, "spoke": 2}, {"id": 4, "name": "GRETCHEN VOLKOV", "names": ["GRETCHEN VOLKOV", "GRETCHEN"], "gender": "?", "first": 7, "spoke": 3}, {"id": 5, "name": "DOMINGO", "names": ["DOMINGO"], "gender": "m", "first": 8, "spoke": 2}, {"id": 6, "name": "TAVARES", "names": ["TAVARES"], "gender": "?", "first": 8, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. BACK ROOM, FISH MARKET - PRE-DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Crushed ice.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Crates of mackerel.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A bare bulb swings overhead.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SALVATORE \"SAL THE KNIFE\" BIANCHINI (50s, rubber apron, scarred knuckles) counts cash into a fish crate.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "His nephew, LORENZO \"RENZO\" BIANCHINI (20s, nervous, wet cuffs), holds the lid.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "At a steel table, DETECTIVE MARISELA OYELOWO-KANE (40s, trench coat, notebook) sits perfectly still.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "Across from her, the bookkeeper, GRETCHEN VOLKOV (50s, cardigan, reading glasses on a cord), sorts receipts.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "By the freezer door, a hulking enforcer called DOMINGO \"THE HAMMER\" TAVARES (30s, tailored suit under a slicker) watches the others.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 9, "kind": "dialogue", "text": "Renzo, keep your hands where I see them.", "name": "SAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "dialogue", "text": "They're on the lid, Uncle Sal.", "name": "RENZO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "Then keep them there.", "name": "SAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "Your numbers don't add, Salvatore.", "name": "GRETCHEN", "speaker": 4, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "Gretchen, my numbers always add.", "name": "SAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "Not this month.", "name": "GRETCHEN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "action", "text": "She holds up a receipt.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "action", "text": "Sal squints at it.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "action", "text": "The bulb swings.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "action", "text": "Shadows slide across everyone.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "Mr. Bianchini, I'd like to know where your nephew was Tuesday night.", "name": "MARISELA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "Detective, he was here. Gutting cod. Ask the cod.", "name": "SAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "I'm asking you.", "name": "MARISELA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Boss, she's wearing a wire.", "name": "DOMINGO", "speaker": 5, "ext": [], "paren": ["from the freezer"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "Marisela and Sal both look at Gretchen.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "Gretchen blinks, then at Marisela.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "action", "text": "Domingo reaches for his pocket.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "action", "text": "Renzo lets go of the lid and it slams.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "She goes for the door.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "He goes for her.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "Gretchen throws the receipts, a blizzard of paper.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "Marisela dives behind the crates.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "Sal pulls a gutting knife and Domingo draws a pistol.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "Nobody shoot! Nobody shoot!", "name": "RENZO", "speaker": 2, "ext": [], "paren": ["shouting"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "A long frozen beat.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "Paper settles like snow.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "She's not wired. It's the bookkeeper.", "name": "DOMINGO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "I don't wear wires, Mr. Tavares. I wear cardigans.", "name": "GRETCHEN", "speaker": 4, "ext": [], "paren": ["composed"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "She peels the cardigan open.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "Nothing underneath but a blouse.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "Sal lowers the knife.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "Domingo lowers the gun.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "dialogue", "text": "Then who's talking to the police?", "name": "SAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "Everyone turns slowly to Renzo.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "dialogue", "text": "Uncle Sal. I can explain.", "name": "RENZO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "dialogue", "text": "Of course you can, Renzo.", "name": "SAL", "speaker": 0, "ext": [], "paren": ["gently"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "action", "text": "He puts the knife down.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "action", "text": "Picks up a mackerel instead.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "Weighs it.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "dialogue", "text": "But first, you gut the fish.", "name": "SAL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}