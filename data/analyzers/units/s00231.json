{"scene_id": "s00231", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00231.fountain", "heading": "INT. TAXIDERMY SHOP BACK OFFICE - NIGHT", "cast": [{"id": 0, "name": "CONSTANCE BELLWETHER-OKAFOR", "names": ["CONSTANCE BELLWETHER-OKAFOR", "CONSTANCE"], "gender": "?", "first": 4, "spoke": 17}, {"id": 1, "name": "INSPECTOR ARTHUR LINDQVIST", "names": ["INSPECTOR ARTHUR LINDQVIST", "INSPECTOR LINDQVIST"], "gender": "m", "first": 5, "spoke": 18}, {"id": 2, "name": "ELLIOTT FAIRWEATHER-NGUYEN", "names": ["ELLIOTT FAIRWEATHER-NGUYEN", "ELLIOTT"], "gender": "m", "first": 38, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. TAXIDERMY SHOP BACK OFFICE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Glass eyes in drawers.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A stuffed heron on the filing cabinet.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A desk lamp.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CONSTANCE BELLWETHER-OKAFOR (50s, shop owner, tweed) sits behind the desk.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across from her, INSPECTOR ARTHUR LINDQVIST (60s, bowler hat on his knee) leans forward.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Miss Bellwether-Okafor, the dead man was your partner.", "name": "INSPECTOR LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "He was, Inspector.", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "And you were the last to see him.", "name": "INSPECTOR LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I locked up at six. He was alive then.", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Alive and in a temper, the clerk says.", "name": "INSPECTOR LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "He was always in a temper.", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "About what?", "name": "INSPECTOR LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "The heron.", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "The heron.", "name": "INSPECTOR LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "He wanted to sell it. I did not.", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "To whom?", "name": "INSPECTOR LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "A collector. A man who pays in cash.", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Name?", "name": "INSPECTOR LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "He never gave one.", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Convenient.", "name": "INSPECTOR LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "For him, perhaps. Not for me.", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Do you own a revolver, madam?", "name": "INSPECTOR LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "I own a skinning knife and a very good sense of humor.", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "The first I've seen. The second I'm waiting for.", "name": "INSPECTOR LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Then you will wait a long time.", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "He taps his hat.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "She straightens a pen.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "The heron stares at both.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Tell me about the safe.", "name": "INSPECTOR LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "There is no safe.", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "There is a safe-shaped hole in your wall.", "name": "INSPECTOR LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Is there?", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Behind the heron.", "name": "INSPECTOR LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "I never look behind the heron.", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Perhaps you should.", "name": "INSPECTOR LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "The door opens.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "A tall young man steps in, soaked, a package under his arm.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "ELLIOTT FAIRWEATHER-NGUYEN (20s, delivery boy, cap dripping) stops.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "He looks from one to the other.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Sorry. Parcel for Mr. Pennington.", "name": "ELLIOTT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Mr. Pennington is dead.", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Oh. Then who signs?", "name": "ELLIOTT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "I will. What is it?", "name": "INSPECTOR LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Don't know. It's ticking.", "name": "ELLIOTT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Inspector Lindqvist and Constance look at each other.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Then at the parcel.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Then at the heron.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Put it down gently, young man.", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Is it going to--", "name": "ELLIOTT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "It's going to be fine. Probably.", "name": "INSPECTOR LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Elliott lowers the parcel onto the desk.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "The ticking stops.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Silence.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Constance lifts the lid.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Inside, a brass pocket watch and a note.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "\"Look behind the heron. Signed, Pennington.\"", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": ["reading"], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "He's been dead since six.", "name": "INSPECTOR LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "He mailed it at five.", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Elliott takes off his dripping cap.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "Should I go?", "name": "ELLIOTT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "No. Stand by the heron. Both of you.", "name": "INSPECTOR LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "They turn toward the bird.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "It stares back, patient.", "para": 9, "sent": 1, "present": [0, 1, 2]}]}