{"scene_id": "s00233", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00233.fountain", "heading": "INT. LAUNDRY ROOM OF A GRAND HOTEL - NIGHT", "cast": [{"id": 0, "name": "EULALIE FONTENOT-RAMASWAMY", "names": ["EULALIE FONTENOT-RAMASWAMY", "EULALIE"], "gender": "?", "first": 3, "spoke": 16}, {"id": 1, "name": "JULIAN FONTENOT", "names": ["JULIAN FONTENOT", "JULIAN"], "gender": "?", "first": 3, "spoke": 14}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAUNDRY ROOM OF A GRAND HOTEL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Steam pipes and canvas carts.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A long ironing table with a single white shirt stretched over it.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "MRS. EULALIE FONTENOT-RAMASWAMY (60s, head housekeeper, starched apron, silver hair pinned flat) presses the shirt with a heavy iron.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "Her motions are slow and exact.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Her son, JULIAN FONTENOT (30s, tuxedo, bow tie undone) stands across the table.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "He holds a champagne flute like it's something he's been told to carry.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Mother.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Julian.", "name": "EULALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "The reception started an hour ago.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I know. I heard the music.", "name": "EULALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She turns the shirt.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Irons the cuff.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He watches the iron, not her.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "You promised you'd come.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I'm here. In the building.", "name": "EULALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "That's not the same.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "It's close.", "name": "EULALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "The iron hisses.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Steam rolls between them.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Mr. Whitcombe asked about you.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Did he.", "name": "EULALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "He wants to thank you.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "I've been thanked.", "name": "EULALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "By whom?", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "By the shirts.", "name": "EULALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "He sets the flute down.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Takes a cloth from the cart and begins to fold it into a square.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "It's the wrong size.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "He folds it again.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "They're announcing the engagement.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Yes.", "name": "EULALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Sophie's parents are here.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "I've seen their luggage. Very nice leather.", "name": "EULALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Mother.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Julian.", "name": "EULALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "She sets the iron upright.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Looks at the shirt.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Finally at him.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Your collar is crooked.", "name": "EULALIE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "He lifts his hands to fix it.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "They shake.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "She walks around the table, takes the two ends of the bow tie from him, and ties it without a word.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Her fingers are quick and steady.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "His are not.", "para": 7, "sent": 4, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "I thought you'd be angry.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "I am ironing, Julian. Don't mistake it.", "name": "EULALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "She tugs the knot straight.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Smooths his lapels with both palms.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Go. They'll want you for the toast.", "name": "EULALIE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Come with me.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "In this apron?", "name": "EULALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Yes.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "She looks at the apron.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "At her hands.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "At the white shirt, still warm on the board.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "Give me ten minutes.", "name": "EULALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "You'll come?", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "Ten minutes.", "name": "EULALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "He nods.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "Picks up his flute.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "Leaves it.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "Picks up the folded cloth instead and puts it in her hand.", "para": 10, "sent": 3, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "He goes.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "She stands holding the cloth.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "Then she takes off the apron, and folds it, and lays it on the board where the shirt had been.", "para": 12, "sent": 0, "present": [0, 1]}]}