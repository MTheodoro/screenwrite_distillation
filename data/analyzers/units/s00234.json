{"scene_id": "s00234", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00234.fountain", "heading": "EXT. SHELLED FARMHOUSE COURTYARD, NORMANDY - DAWN", "cast": [{"id": 0, "name": "ZEKE", "names": ["ZEKE"], "gender": "?", "first": 5, "spoke": 12}, {"id": 1, "name": "MATTHIAS-ODUYA", "names": ["MATTHIAS-ODUYA"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "PRIVATE COLM BRANNIGAN-VOSS", "names": ["PRIVATE COLM BRANNIGAN-VOSS", "COLM"], "gender": "m", "first": 6, "spoke": 9}, {"id": 3, "name": "RAFA", "names": ["RAFA"], "gender": "?", "first": 7, "spoke": 8}, {"id": 4, "name": "DELGADO-HOLM", "names": ["DELGADO-HOLM"], "gender": "?", "first": 7, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SHELLED FARMHOUSE COURTYARD, NORMANDY - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Mist.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Broken tile.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A dead cow on its side, bloated.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Three soldiers crouch behind a collapsed wall.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "SERGEANT EZEKIEL \"ZEKE\" MATTHIAS-ODUYA (30s, helmet netted, chewing nothing) peers over the stones.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Beside him, PRIVATE COLM BRANNIGAN-VOSS (19, rifle too big, freckles) breathes through his mouth.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Behind them, CORPORAL RAFAELA \"RAFA\" DELGADO-HOLM (20s, radio on her back, steady hands) checks her sidearm.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "Quiet. Too quiet.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "You say that every time, Sarge.", "name": "COLM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "It's true every time.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Barn's clear. House is clear. Nothing on the ridge.", "name": "RAFA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Then why's the cow dead?", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Shell.", "name": "RAFA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Which shell?", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Ours?", "name": "COLM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Maybe.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "A bird lands on the cow.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Pecks.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Leaves.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Corporal Delgado-Holm. Can I ask something?", "name": "COLM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Rafa. Just Rafa.", "name": "RAFA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Rafa. Why's the radio quiet?", "name": "COLM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Because nobody's talking.", "name": "RAFA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "That's what I mean.", "name": "COLM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Brannigan. Eyes front.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Yes, Sarge.", "name": "COLM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "They wait.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "A droplet of mist rolls from Zeke's helmet and hits the mud.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Sarge. Door.", "name": "RAFA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "The farmhouse door, which was shut, is now ajar.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "A hand-width.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Colm. Left. Rafa. Right. On three.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "One.", "name": "COLM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Two.", "name": "RAFA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "They rise together, rifles up.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "The door swings wide.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Out steps a goat.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Then a second goat.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "A third.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "The squad stares.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "The goats stare back.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Sarge. Was that the thing?", "name": "COLM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "That was the thing.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": ["deadpan"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "I'm going to be sick.", "name": "RAFA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "She laughs, covering her mouth.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Colm sinks down, giggling.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Zeke slumps against the wall, shoulders shaking.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "A whistle in the sky.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Rising.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "They all stop laughing at once.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "Down!", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "They scatter.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "The first shell lands in the barn.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "The wall behind them heaves.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "The goats bolt in three directions.", "para": 14, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Dust and straw rain over three helmets.", "para": 14, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "Rafa pulls Colm flat.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Zeke crawls over both of them.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "Rafa! Radio!", "name": "ZEKE", "speaker": 0, "ext": ["CONT'D"], "paren": ["shouting"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "It's dead!", "name": "RAFA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "Then pray!", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "dialogue", "text": "To who?", "name": "COLM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "dialogue", "text": "The goats!", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}