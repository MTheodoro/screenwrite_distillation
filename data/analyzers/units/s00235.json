{"scene_id": "s00235", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00235.fountain", "heading": "INT. RADIO DUGOUT, WESTERN FRONT - NIGHT", "cast": [{"id": 0, "name": "LIEUTENANT PHILIPPE ARMAND-DOGBE", "names": ["LIEUTENANT PHILIPPE ARMAND-DOGBE", "PHILIPPE"], "gender": "m", "first": 4, "spoke": 4}, {"id": 1, "name": "RADIO", "names": ["RADIO"], "gender": "?", "first": 7, "spoke": 2}, {"id": 2, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 24, "spoke": 3}, {"id": 3, "name": "ALOIS", "names": ["ALOIS"], "gender": "?", "first": 34, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. RADIO DUGOUT, WESTERN FRONT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A timber box dug into clay.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single candle.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A field set with a cracked dial.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LIEUTENANT PHILIPPE ARMAND-DOGBE (20s, mud to the eyebrows, a hole in his left sleeve) crouches over the headset, writing coordinates with a stub of pencil.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Static.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Then a faint, courteous voice.", "para": 2, "sent": 1, "present": [0]}, {"u": 7, "kind": "dialogue", "text": "Dugout Seven, this is Battalion. Report.", "name": "RADIO", "speaker": 1, "ext": ["V.O."], "paren": ["distant, crackling"], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Battalion, Dugout Seven. Quiet night. Nothing to report.", "name": "PHILIPPE", "speaker": 0, "ext": [], "paren": ["into the mic"], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Copy. Stay warm, Seven.", "name": "RADIO", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Will do.", "name": "PHILIPPE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He releases the key.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Stares at the candle.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "The flame is steady.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Too steady.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "For a long moment the whole dugout seems to hold still.", "para": 3, "sent": 4, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "A scrape at the entrance.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "The blanket curtain moves.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "A figure ducks in.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "A boy in a muddy overcoat with no insignia, holding a tin cup of tea.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "He is perhaps sixteen.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "He wears no helmet, only a thin smile.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Who are you?", "name": "PHILIPPE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "The boy sets the cup down in front of him.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Tea, sir. Compliments of the other side.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Philippe doesn't breathe.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The pencil rolls off the table.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "They've been listening since Tuesday.", "name": "STRANGER", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "And you came to tell me?", "name": "PHILIPPE", "speaker": 0, "ext": [], "paren": ["very quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "I came to say they've changed the plan.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "He crosses to the radio, turns the dial one click, and Battalion's voice fades to nothing.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Another voice takes its place, in another language, bright and brisk.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The boy meets Philippe's eyes.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Now he has a name.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "My name is Alois, sir. I'd drink the tea.", "name": "ALOIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Philippe picks up the cup.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "His hand does not shake.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "He drinks.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}]}