{"scene_id": "s00236", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00236.fountain", "heading": "INT. SMALL-TOWN PET FUNERAL PARLOR - DAY", "cast": [{"id": 0, "name": "BEA", "names": ["BEA"], "gender": "?", "first": 4, "spoke": 8}, {"id": 1, "name": "LANGSTROM-OYELEYE", "names": ["LANGSTROM-OYELEYE"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "GERRY", "names": ["GERRY"], "gender": "f", "first": 5, "spoke": 8}, {"id": 3, "name": "POTTS", "names": ["POTTS"], "gender": "?", "first": 5, "spoke": 0}, {"id": 4, "name": "HECTOR MWENDA-ABERNATHY", "names": ["HECTOR MWENDA-ABERNATHY", "HECTOR"], "gender": "?", "first": 5, "spoke": 13}, {"id": 5, "name": "DENNIS", "names": ["DENNIS"], "gender": "?", "first": 23, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. SMALL-TOWN PET FUNERAL PARLOR - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Pastel walls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Little urns on velvet shelves.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A framed poster: \"Every Goodbye Deserves Dignity.\"", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "BEATRIX \"BEA\" LANGSTROM-OYELEYE (40s, funeral director, black pencil skirt, too-bright lipstick) stands at a small oak lectern with a sleeping ferret in a tiny casket beside her.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Seated in the front row, in folding chairs: GERALDINE \"GERRY\" POTTS (60s, widowed, tissue in fist) and her brother-in-law HECTOR MWENDA-ABERNATHY (60s, loud tie, sunglasses on indoors).", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 6, "kind": "dialogue", "text": "Friends. We are gathered to honor Nibbles.", "name": "BEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "dialogue", "text": "Oh, Nibbles.", "name": "GERRY", "speaker": 2, "ext": [], "paren": ["weeping"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "He was a good ferret.", "name": "HECTOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "He was.", "name": "BEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Smelled like a gym bag.", "name": "HECTOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Hector!", "name": "GERRY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "I'm saying it with love.", "name": "HECTOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Perhaps we could hold the anecdotes until the reception.", "name": "BEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "I'm just saying he bit the mailman.", "name": "HECTOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "He bit the mailman once.", "name": "GERRY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Four times.", "name": "HECTOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Twice.", "name": "GERRY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Four. I counted.", "name": "HECTOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Let us bow our heads.", "name": "BEA", "speaker": 0, "ext": [], "paren": ["over them"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "They do.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "A pause.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "A phone rings, tinny, from Hector's pocket.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Not now, Dennis.", "name": "HECTOR", "speaker": 4, "ext": [], "paren": ["answering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Hector, did you tell her about the hamster?", "name": "DENNIS", "speaker": 5, "ext": ["O.S."], "paren": ["through the phone, blaring"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "What hamster?", "name": "GERRY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Dennis, I'm at a funeral!", "name": "HECTOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Whose?", "name": "DENNIS", "speaker": 5, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Nibbles's.", "name": "BEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Oh no. He was a good ferret!", "name": "DENNIS", "speaker": 5, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "That's what I said!", "name": "HECTOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Hector, what hamster?", "name": "GERRY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Nothing! A rumor!", "name": "HECTOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Ladies, gentlemen, caller, please--", "name": "BEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "The casket lid pops open.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Nibbles sits up, yawns, stretches.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Silence in every key.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "He's alive.", "name": "GERRY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "He was asleep.", "name": "HECTOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "It happens.", "name": "BEA", "speaker": 0, "ext": [], "paren": ["holding the lectern"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "What happens? Did he come back?", "name": "DENNIS", "speaker": 5, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Hector hangs up.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Gerry scoops the ferret into her arms and sobs with joy.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 5]}, {"u": 43, "kind": "dialogue", "text": "My boy! My Nibbles!", "name": "GERRY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5]}, {"u": 44, "kind": "dialogue", "text": "I'll prepare a refund.", "name": "BEA", "speaker": 0, "ext": [], "paren": ["recovering"], "dual": false, "present": [0, 1, 2, 3, 5]}, {"u": 45, "kind": "dialogue", "text": "Keep the flowers.", "name": "HECTOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Nibbles bites Bea.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "She yelps.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "Hector nods, satisfied.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "Four times.", "name": "HECTOR", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}