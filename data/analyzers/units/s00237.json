{"scene_id": "s00237", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00237.fountain", "heading": "INT. SINKING FISHING TRAWLER, WHEELHOUSE - NIGHT", "cast": [{"id": 0, "name": "CAPTAIN RUTH ABERNATHY-KOMA", "names": ["CAPTAIN RUTH ABERNATHY-KOMA", "RUTH"], "gender": "?", "first": 4, "spoke": 10}, {"id": 1, "name": "BASTIEN LEFEBVRE-ADEOLA", "names": ["BASTIEN LEFEBVRE-ADEOLA", "BASTIEN"], "gender": "?", "first": 6, "spoke": 7}, {"id": 2, "name": "MAEVE ONWUACHI-DRUMM", "names": ["MAEVE ONWUACHI-DRUMM", "MAEVE"], "gender": "?", "first": 7, "spoke": 8}, {"id": 3, "name": "COAST GUARD", "names": ["COAST GUARD"], "gender": "?", "first": 9, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. SINKING FISHING TRAWLER, WHEELHOUSE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Water ankle-deep and rising.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A lantern swings from the ceiling.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Waves slam the hull.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CAPTAIN RUTH ABERNATHY-KOMA (50s, oilskins, grey braid) grips the wheel.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her knuckles are white.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Beside her, deckhand BASTIEN LEFEBVRE-ADEOLA (20s, hood, cut lip) bails with a plastic bucket.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "At the radio, first mate MAEVE ONWUACHI-DRUMM (30s, hands taped, glasses fogged) clutches the handset.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Mayday, mayday, this is trawler Gallant Heron, taking water, request assistance.", "name": "MAEVE", "speaker": 2, "ext": [], "paren": ["into radio"], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Gallant Heron, say again your position.", "name": "COAST GUARD", "speaker": 3, "ext": ["V.O."], "paren": ["garbled"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Forty-one north, sixty-eight west! Forty-one north!", "name": "MAEVE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "How much time?", "name": "BASTIEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Twenty minutes.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "That's not time. That's a prayer.", "name": "BASTIEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "...ant Heron... one hour... response...", "name": "COAST GUARD", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "One hour! We don't have one hour!", "name": "MAEVE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Maeve. Give me the mic.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "They can't hear--", "name": "MAEVE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Give it to me!", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Maeve hands it over.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "A wave rocks the boat.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "The lantern swings.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Coast Guard, this is Ruth Abernathy. Last transmission. We are abandoning ship in ten minutes. Three souls. Please mark our position.", "name": "RUTH", "speaker": 0, "ext": ["CONT'D"], "paren": ["into radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Abandoning to what?", "name": "BASTIEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "The raft.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "The raft's been in the shed since March.", "name": "BASTIEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Then it's had a long rest.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Captain, the pump's dead!", "name": "MAEVE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "I'm bailing!", "name": "BASTIEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Bail faster!", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "...Heron... flare... fire flare...", "name": "COAST GUARD", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Flare! Where's the flare?", "name": "MAEVE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Port locker!", "name": "BASTIEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "It's underwater!", "name": "MAEVE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Then swim!", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Maeve dives into the dark water pooled in the corner.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Surfaces gasping.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "A bright orange flare in her fist.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Got it!", "name": "MAEVE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Up top! Go!", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "They push through the hatch.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "The sea comes at them in sheets.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Wind grabs the flare, strikes it.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Red fire stabs the sky.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Far off, a searchlight swings.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Bastien whoops.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "They see us! They see us!", "name": "BASTIEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Slow down, Ruth. Don't thank anyone yet.", "name": "RUTH", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "The hull groans.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "A wave lifts them.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "The searchlight finds their faces.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}]}