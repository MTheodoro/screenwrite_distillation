{"scene_id": "s00238", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00238.fountain", "heading": "EXT. COMMUNITY POOL, DIVING PLATFORM - LATE AFTERNOON", "cast": [{"id": 0, "name": "PETE", "names": ["PETE"], "gender": "?", "first": 4, "spoke": 3}, {"id": 1, "name": "ADEYEMI-LANDRY", "names": ["ADEYEMI-LANDRY"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "BEANPOLE", "names": ["BEANPOLE"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "OKONJO", "names": ["OKONJO"], "gender": "?", "first": 6, "spoke": 0}, {"id": 4, "name": "SUNITA MARCHETTI-DAS", "names": ["SUNITA MARCHETTI-DAS", "SUNITA"], "gender": "?", "first": 7, "spoke": 3}, {"id": 5, "name": "CASPIAN FROST-NKEMELU", "names": ["CASPIAN FROST-NKEMELU", "CASPIAN"], "gender": "f", "first": 8, "spoke": 2}, {"id": 6, "name": "ROSALIND", "names": ["ROSALIND"], "gender": "?", "first": 9, "spoke": 2}, {"id": 7, "name": "GWENDOLYN TARASOVA", "names": ["GWENDOLYN TARASOVA", "GWENDOLYN"], "gender": "?", "first": 9, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. COMMUNITY POOL, DIVING PLATFORM - LATE AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Chlorine light, gold on blue.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The ten-meter platform stands over the water like a lighthouse in swim trunks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Six teenagers cluster at the top, bare feet on warm concrete.", "para": 1, "sent": 0, "present": []}, {"u": 4, "kind": "action", "text": "PERPETUA \"PETE\" ADEYEMI-LANDRY, 16, tall and laconic, stretches her calves against the rail.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "She does not look down.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "BRIAN \"BEANPOLE\" OKONJO, 15, adjusts his goggles for the fifth time, lips moving as he rehearses a joke he will never tell.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "SUNITA MARCHETTI-DAS, 16, ponytail wet, picks at a nail.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "CASPIAN FROST-NKEMELU, 17, shirtless, tries very hard to look relaxed.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "action", "text": "The twins ROSALIND and GWENDOLYN TARASOVA, 15, share a towel and a single earbud each.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 10, "kind": "action", "text": "Wind moves the surface of the pool like a hand smoothing a bedsheet.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 11, "kind": "dialogue", "text": "Who's first?", "name": "PETE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 12, "kind": "dialogue", "text": "Not me.", "name": "BEANPOLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 13, "kind": "dialogue", "text": "Not me.", "name": "SUNITA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 14, "kind": "dialogue", "text": "I'll go.", "name": "CASPIAN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 15, "kind": "dialogue", "text": "You said that last week.", "name": "PETE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 16, "kind": "dialogue", "text": "And last week I almost did.", "name": "CASPIAN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 17, "kind": "action", "text": "The twins exchange a look.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 18, "kind": "action", "text": "Take the earbuds out in unison.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 19, "kind": "dialogue", "text": "We'll go together.", "name": "ROSALIND", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 20, "kind": "dialogue", "text": "We'll go together.", "name": "GWENDOLYN", "speaker": 7, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 21, "kind": "action", "text": "^", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 22, "kind": "action", "text": "They step to the edge, hands linked.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 23, "kind": "action", "text": "Neither speaks.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 24, "kind": "action", "text": "Below, a lifeguard whistles a lazy tune.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 25, "kind": "dialogue", "text": "Wait. Wait. Don't.", "name": "SUNITA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 26, "kind": "dialogue", "text": "Why?", "name": "ROSALIND", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 27, "kind": "dialogue", "text": "Why?", "name": "GWENDOLYN", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 28, "kind": "dialogue", "text": "Because after this, it's September.", "name": "SUNITA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 29, "kind": "action", "text": "Silence.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "action", "text": "Even the wind seems to pause.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "action", "text": "She says it quietly.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "action", "text": "They hear it anyway.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "action", "text": "Pete finally looks down.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "action", "text": "Her face softens.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "action", "text": "She sits on the edge of the platform, legs swinging into the sky.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "dialogue", "text": "Then let's make it a good one.", "name": "PETE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "action", "text": "Caspian sits beside her.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "action", "text": "Beanpole joins them, goggles fogged.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "action", "text": "Sunita comes last, close enough that their shoulders touch.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "action", "text": "The twins look at each other once more.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 41, "kind": "action", "text": "Then, together, they jump.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 42, "kind": "action", "text": "The splash is distant and silver.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 43, "kind": "action", "text": "The others lean over to watch the ripples spread outward, ring after ring, until they reach the walls.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 44, "kind": "dialogue", "text": "Okay. Now me.", "name": "BEANPOLE", "speaker": 2, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}