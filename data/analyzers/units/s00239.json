{"scene_id": "s00239", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00239.fountain", "heading": "EXT. BRIDGE OF BONES OVER THE GREY GORGE - DAWN", "cast": [{"id": 0, "name": "AELFWYN THORNBURY", "names": ["AELFWYN THORNBURY", "AELFWYN"], "gender": "f", "first": 5, "spoke": 7}, {"id": 1, "name": "GRIM", "names": ["GRIM"], "gender": "m", "first": 6, "spoke": 5}, {"id": 2, "name": "OKORO-SHALE", "names": ["OKORO-SHALE"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "THISTLE-WREN", "names": ["THISTLE-WREN"], "gender": "?", "first": 7, "spoke": 7}, {"id": 4, "name": "BROTHER CASSIAN VELLACOTT", "names": ["BROTHER CASSIAN VELLACOTT", "CASSIAN"], "gender": "m", "first": 8, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. BRIDGE OF BONES OVER THE GREY GORGE - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A bridge strung between two cliffs, built from the ribs of some long-dead leviathan.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fog fills the gorge below.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Mountain wind pulls at cloaks.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A party of four stands at the near end.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "AELFWYN THORNBURY (30s, ranger, bow across her back, scar through one eyebrow) tests the first rib with her boot.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "GRIMBALD \"GRIM\" OKORO-SHALE (50s, dwarf-born, braided beard, iron-shod staff) leans on the staff and glares at the fog.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "THISTLE-WREN (late teens, half-fey, hair like dandelion down) hops from foot to foot, humming.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "BROTHER CASSIAN VELLACOTT (40s, wandering monk, wooden prayer beads, travel-worn robe) kneels briefly, touches the stone, rises.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "We cross single file. Spacing of three paces. Anyone who stumbles, the others hold.", "name": "AELFWYN", "speaker": 0, "ext": [], "paren": ["to the group"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Three paces. As if the fog will respect it.", "name": "GRIM", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "It will! I asked it nicely!", "name": "THISTLE-WREN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Thistle, you don't ask fog.", "name": "AELFWYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "That's why it listens.", "name": "THISTLE-WREN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "The ribs are old. Older than the oldest prayer I know.", "name": "CASSIAN", "speaker": 4, "ext": [], "paren": ["quietly, to Aelfwyn"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Will they hold?", "name": "AELFWYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "They have so far.", "name": "CASSIAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Aelfwyn nods.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Steps out onto the bridge.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "The bone creaks, then settles.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "She takes three paces and stops.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Grim follows.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Thistle-Wren follows Grim, humming louder.", "para": 6, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Cassian takes the rear, counting his beads.", "para": 6, "sent": 6, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Halfway across, a gust slams the bridge sideways.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "The party freezes.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Thistle-Wren grabs Grim's belt.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Grim drops his staff to the rib to steady himself.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Aelfwyn kneels, one hand on the bone, the other signaling Cassian to hold.", "para": 7, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "The fog thickens until none of them can see more than an arm's length ahead.", "para": 7, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Idiot dwarf. Never trust a bridge made of something that died.", "name": "GRIM", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Everyone, breathe. Let the wind pass through you.", "name": "CASSIAN", "speaker": 4, "ext": [], "paren": ["calling"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "I'm trying! My lungs are very small!", "name": "THISTLE-WREN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Quiet, all of you. Listen.", "name": "AELFWYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "They listen.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Far below, in the white, something large exhales.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "It's the leviathan.", "name": "THISTLE-WREN", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "It's dead.", "name": "GRIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Its ghost isn't.", "name": "THISTLE-WREN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Then we cross as guests.", "name": "CASSIAN", "speaker": 4, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "The wind drops.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "The fog parts for a moment, revealing the far side: a cairn, a green slope, a thin road winding into pines.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Move. Now. Quick and quiet.", "name": "AELFWYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "They run, three paces apart, bone ringing under their boots like a xylophone of the dead.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Thistle-Wren giggles.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Grim wheezes.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Cassian's beads clack.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Aelfwyn counts, lips tight.", "para": 10, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "They reach the far cliff and tumble onto grass.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Grim lies flat, staring at the sky.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Never again.", "name": "GRIM", "speaker": 1, "ext": [], "paren": ["to the sky"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "We have to cross back.", "name": "THISTLE-WREN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "I'll sleep here.", "name": "GRIM", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Behind them, the bridge sighs and sways.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "The fog closes over it like a lid.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "We should keep moving. The road is long.", "name": "CASSIAN", "speaker": 4, "ext": [], "paren": ["to the group"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Up, old friend.", "name": "AELFWYN", "speaker": 0, "ext": [], "paren": ["offering her hand to Grim"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "He takes it.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "She hauls him upright.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "The four stand in a row, looking down the road.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "Where does it go?", "name": "THISTLE-WREN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "Wherever we go.", "name": "AELFWYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "They start walking.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "The wind follows at their heels, gentle now, almost apologetic.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}]}