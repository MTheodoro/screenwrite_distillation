{"scene_id": "s00241", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00241.fountain", "heading": "INT. PRIVATE LIBRARY OF A COUNTRY HOUSE - NIGHT", "cast": [{"id": 0, "name": "SIR AUGUSTUS FERRIDAY-OKONKWO", "names": ["SIR AUGUSTUS FERRIDAY-OKONKWO", "SIR AUGUSTUS"], "gender": "m", "first": 5, "spoke": 5}, {"id": 1, "name": "LADY PHILOMENA FERRIDAY", "names": ["LADY PHILOMENA FERRIDAY", "PHILOMENA"], "gender": "m", "first": 5, "spoke": 11}, {"id": 2, "name": "BARNABY CHATTERJEE-WHITLOCK", "names": ["BARNABY CHATTERJEE-WHITLOCK", "DR. CHATTERJEE-WHITLOCK"], "gender": "f", "first": 7, "spoke": 7}, {"id": 3, "name": "SAMUEL OKAFOR-LYNCH", "names": ["SAMUEL OKAFOR-LYNCH", "MR. OKAFOR-LYNCH"], "gender": "?", "first": 8, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. PRIVATE LIBRARY OF A COUNTRY HOUSE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Firelight.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Leather spines.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A storm throwing rain at the leaded windows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Four people sit in wing chairs around a low table: a decanter, a deck of cards, a bowl of walnuts.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "SIR AUGUSTUS FERRIDAY-OKONKWO (70s, silver mustache, velvet jacket) holds a glass of port and a closed fan of cards.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "His niece LADY PHILOMENA FERRIDAY (30s, emerald gown, pearl choker) taps a walnut against the table.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Their guest DR. BARNABY CHATTERJEE-WHITLOCK (50s, rumpled tweed, wire glasses) studies his hand.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "The butler, MR. SAMUEL OKAFOR-LYNCH (60s, impeccable, immaculately still), stands behind the fireplace.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Thunder rolls.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "The cards are placed one by one.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Your play, Doctor.", "name": "SIR AUGUSTUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Patience, Sir Augustus.", "name": "DR. CHATTERJEE-WHITLOCK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "He lays a card.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Smiles faintly.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "You're stalling.", "name": "PHILOMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "I'm thinking.", "name": "DR. CHATTERJEE-WHITLOCK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Same thing.", "name": "PHILOMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Samuel, more port.", "name": "SIR AUGUSTUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Of course, Sir Augustus.", "name": "MR. OKAFOR-LYNCH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "He glides forward, fills the glass, glides back.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "The fire pops.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Uncle, the will.", "name": "PHILOMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Not tonight.", "name": "SIR AUGUSTUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "You said tonight.", "name": "PHILOMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "I said some night.", "name": "SIR AUGUSTUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "It's a sensitive subject, my dear.", "name": "DR. CHATTERJEE-WHITLOCK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "It's my inheritance.", "name": "PHILOMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "It's mine until I'm dead.", "name": "SIR AUGUSTUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Another thunderclap.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "The lights flicker.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "The room dips to gold, then to near-black.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "A glass shatters.", "para": 9, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Someone gasps.", "para": 9, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "The lights return.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Sir Augustus is slumped in his chair, one hand clutching the arm, the other still gripping the port.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "His mustache is wet.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "His eyes are open.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "He does not breathe.", "para": 11, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Philomenna rises first, knocking the walnut bowl over.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Chatterjee-Whitlock is already at the old man's side with two fingers on the throat.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Okafor-Lynch has not moved from the fireplace.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Uncle?", "name": "PHILOMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "He's gone.", "name": "DR. CHATTERJEE-WHITLOCK", "speaker": 2, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "That's not possible. He was just talking.", "name": "PHILOMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "It happens quickly.", "name": "DR. CHATTERJEE-WHITLOCK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "She looks at the decanter.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "At the butler.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "At the doctor.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "She picks up the port, sniffs it.", "para": 13, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Bitter almond.", "name": "PHILOMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Philomena, don't touch--", "name": "DR. CHATTERJEE-WHITLOCK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Samuel poured it.", "name": "PHILOMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Madam, I poured what Sir Augustus requested.", "name": "MR. OKAFOR-LYNCH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "You poured it twice.", "name": "PHILOMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Once for the glass. Once for his health.", "name": "MR. OKAFOR-LYNCH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "She lunges at him.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "He doesn't flinch.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "The doctor catches her arm.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "Chatterjee-Whitlock holds her back as she strains, trembling, at the butler.", "para": 14, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "You killed him!", "name": "PHILOMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "Madam, I loved him for forty years.", "name": "MR. OKAFOR-LYNCH", "speaker": 3, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "The storm breaks.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "Rain hammers the glass.", "para": 15, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "For the first time, Okafor-Lynch's composure cracks.", "para": 15, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "He reaches into his waistcoat and withdraws a folded paper.", "para": 15, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "He wrote this himself, this afternoon. It names the poison. And the man who put it in the decanter.", "name": "MR. OKAFOR-LYNCH", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "He hands it to the doctor.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "The doctor reads.", "para": 16, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "His face drains of color.", "para": 16, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "dialogue", "text": "I didn't--", "name": "DR. CHATTERJEE-WHITLOCK", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "He steps back.", "para": 17, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "action", "text": "Philomena stares at him.", "para": 17, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "action", "text": "The fire collapses into embers.", "para": 17, "sent": 2, "present": [0, 1, 2, 3]}]}