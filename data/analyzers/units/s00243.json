{"scene_id": "s00243", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00243.fountain", "heading": "INT. FAMILY KITCHEN, SUBURBAN HOUSE - EVENING", "cast": [{"id": 0, "name": "GRANDMOTHER ODETTE ABERNATHY-KWAME", "names": ["GRANDMOTHER ODETTE ABERNATHY-KWAME", "ODETTE"], "gender": "?", "first": 4, "spoke": 10}, {"id": 1, "name": "DERRICK ABERNATHY", "names": ["DERRICK ABERNATHY", "ABERNATHY", "MILO ABERNATHY", "DERRICK", "MILO"], "gender": "m", "first": 4, "spoke": 16}, {"id": 2, "name": "PRIYA RAGHAVAN-ABERNATHY", "names": ["PRIYA RAGHAVAN-ABERNATHY", "PRIYA"], "gender": "m", "first": 6, "spoke": 7}, {"id": 3, "name": "JUNE", "names": ["JUNE"], "gender": "?", "first": 7, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. FAMILY KITCHEN, SUBURBAN HOUSE - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Steam on the windows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A turkey, half-carved.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Mismatched chairs around a table crammed with side dishes.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "GRANDMOTHER ODETTE ABERNATHY-KWAME (70s, cardigan, unshakable) sits at the head, fork poised.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Her son DERRICK ABERNATHY (40s, rolled sleeves, carving knife) stands over the bird.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "His wife PRIYA RAGHAVAN-ABERNATHY (40s, apron, flour on her cheek) refills the gravy boat.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Their teenager JUNIPER \"JUNE\" ABERNATHY (16, black nail polish, phone face down) slouches in her chair.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Their youngest, MILO ABERNATHY (7, napkin tucked in his collar), kicks the table leg.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Derrick, the breast is for guests.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Mother, we are the guests.", "name": "DERRICK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Derrick, the potatoes.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Which potatoes?", "name": "DERRICK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "The mashed ones.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "The ones I made.", "name": "JUNE", "speaker": 3, "ext": [], "paren": ["overlapping, to Priya"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "^", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "June, put your phone away.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "It's face down.", "name": "JUNE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "It's still there.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Can I have a roll?", "name": "MILO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Say please.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Please roll.", "name": "MILO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Okay, everyone, a toast.", "name": "DERRICK", "speaker": 1, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Glasses are raised.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Odette's is not.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "To family. To love. To the people at this table.", "name": "DERRICK", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "To the person who bought the wine.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "That was me.", "name": "DERRICK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "It was me.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "It was a joint purchase.", "name": "DERRICK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "It was a Costco purchase.", "name": "JUNE", "speaker": 3, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "I like Costco.", "name": "MILO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Milo, eat.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "I'm waiting for the toast to be over.", "name": "MILO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "It's over.", "name": "DERRICK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Then why is Grandma not drinking?", "name": "MILO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "All heads turn to Odette.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "She holds her glass, then sets it down carefully.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Because I have news.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Mother?", "name": "DERRICK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Odette?", "name": "PRIYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "I sold the house.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": ["to all of them"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Silence.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "A gravy boat drips.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Milo drops his roll.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Wow.", "name": "JUNE", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Mother, you can't--", "name": "DERRICK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "I already did.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Let her finish.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": ["to Derrick"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "I'm moving to Lisbon. In March.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Is that far?", "name": "MILO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Very.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Can I come?", "name": "MILO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Eat your roll first.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Derrick sits slowly.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Priya hands him the potatoes.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "He takes a spoonful, stares at it, and laughs once.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}]}