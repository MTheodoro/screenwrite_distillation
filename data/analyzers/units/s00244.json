{"scene_id": "s00244", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00244.fountain", "heading": "INT. ST. CLEMENT'S HOSPITAL, TRAUMA BAY THREE - NIGHT", "cast": [{"id": 0, "name": "ANWEN OKOYE-FITZGERALD", "names": ["ANWEN OKOYE-FITZGERALD", "ANWEN"], "gender": "?", "first": 4, "spoke": 16}, {"id": 1, "name": "NURSE TADEUSZ MBEKI-LORENZ", "names": ["NURSE TADEUSZ MBEKI-LORENZ", "TADEUSZ"], "gender": "f", "first": 5, "spoke": 8}, {"id": 2, "name": "PRIYANKA HALVORSEN-NWOSU", "names": ["PRIYANKA HALVORSEN-NWOSU", "PRIYANKA"], "gender": "?", "first": 6, "spoke": 6}, {"id": 3, "name": "DISPATCH", "names": ["DISPATCH"], "gender": "?", "first": 8, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. ST. CLEMENT'S HOSPITAL, TRAUMA BAY THREE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Overhead lights.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Monitors beep.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A body on a gurney under blue drapes.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. ANWEN OKOYE-FITZGERALD (40s, surgeon, scrubs, mask pulled down) works at the bedside.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside her, NURSE TADEUSZ MBEKI-LORENZ (30s, calm, gloved) hands her a clamp.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "At the foot of the gurney, RESIDENT DR. PRIYANKA HALVORSEN-NWOSU (20s, new, eyes huge) watches, clipboard clutched.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "On the wall, a speaker crackles.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Trauma Three, ETA on the second unit, four minutes.", "name": "DISPATCH", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Copy. We're stable.", "name": "ANWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Pressure's dropping.", "name": "TADEUSZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Fluids?", "name": "ANWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Wide open.", "name": "TADEUSZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Priyanka, what's your call?", "name": "ANWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Um. Blood?", "name": "PRIYANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Correct. Type?", "name": "ANWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "O negative. Universal.", "name": "PRIYANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Go get four units.", "name": "ANWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Right now?", "name": "PRIYANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Yesterday.", "name": "ANWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Priyanka bolts through the door.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Tadeusz watches her go.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "She'll be fine.", "name": "TADEUSZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "They all say that.", "name": "ANWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "She will be.", "name": "TADEUSZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Pressure.", "name": "ANWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Eighty over fifty.", "name": "TADEUSZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Pulse?", "name": "ANWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "One-thirty.", "name": "TADEUSZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Pack it. Pack it, pack it.", "name": "ANWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "He packs.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "She presses.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "The monitor rises, falters, steadies.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Trauma Three, update. Second unit is reporting a child on board. Pediatric trauma, eight years old.", "name": "DISPATCH", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Anwen and Tadeusz exchange a look.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Open Bay Four.", "name": "ANWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Dr. Okoye-Fitzgerald, we're short.", "name": "TADEUSZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Then call Reyes in from the cafeteria.", "name": "ANWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "She's off.", "name": "TADEUSZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Call her anyway.", "name": "ANWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "He is already dialing.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "The door bursts open.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Priyanka, breathless, carries a cooler of blood bags.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Four units, O negative.", "name": "PRIYANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Good. Hang two. Then you're with me in Four.", "name": "ANWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "The child?", "name": "PRIYANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "The child.", "name": "ANWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Priyanka stares.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Then she sets down the cooler, rolls up her sleeves, and nods once.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "You'll be fine.", "name": "ANWEN", "speaker": 0, "ext": ["CONT'D"], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "They all say that.", "name": "PRIYANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Anwen almost smiles.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Pulls up her mask.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Out the door.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}]}