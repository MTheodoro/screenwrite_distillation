{"scene_id": "s00245", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00245.fountain", "heading": "INT. GLASSBLOWER'S FURNACE ROOM, VENICE - NIGHT, 1743", "cast": [{"id": 0, "name": "MASTER ZORZI CAMPOSAMPIERO", "names": ["MASTER ZORZI CAMPOSAMPIERO", "ZORZI"], "gender": "?", "first": 4, "spoke": 15}, {"id": 1, "name": "ISABELLA MOLIN-OKAFOR", "names": ["ISABELLA MOLIN-OKAFOR", "ISABELLA"], "gender": "f", "first": 9, "spoke": 15}], "units": [{"u": 0, "kind": "heading", "text": "INT. GLASSBLOWER'S FURNACE ROOM, VENICE - NIGHT, 1743", "present": []}, {"u": 1, "kind": "action", "text": "Orange glow.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Pipes and pontils on racks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Heat that bends the air.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MASTER ZORZI CAMPOSAMPIERO (60s, leather apron, burn-scarred forearms) shapes a molten bulb at the furnace mouth.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Slow turn.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Slow breath.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "The door opens.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Rain.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "ISABELLA DA MOLIN-OKAFOR (30s, travelling cloak, a velvet bag pulled tight against her chest) stands dripping.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Closed.", "name": "ZORZI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I know.", "name": "ISABELLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Then why are you here?", "name": "ZORZI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "The Council sends their regards.", "name": "ISABELLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He stops turning.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "The glass sags.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He rights it.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Tell the Council I have nothing to say.", "name": "ZORZI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "They'd like the formula.", "name": "ISABELLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "They'd like the moon.", "name": "ZORZI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She crosses to the bench.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Sets the velvet bag down.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "It clinks.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "This is yours.", "name": "ISABELLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "What is it?", "name": "ZORZI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "A sample. Of what you made last winter.", "name": "ISABELLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "He glances at the bag.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Then at her.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "You stole it.", "name": "ZORZI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "I borrowed it.", "name": "ISABELLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "From my own workshop.", "name": "ZORZI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "From your apprentice.", "name": "ISABELLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "His jaw works.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "The furnace roars.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Her cloak steams.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Giacomo.", "name": "ZORZI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "He's very young.", "name": "ISABELLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "He's a fool.", "name": "ZORZI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "He's frightened.", "name": "ISABELLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Zorzi sets down the pipe.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Turns.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Picks up the long iron tongs.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Master Zorzi.", "name": "ISABELLA", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Open the bag.", "name": "ZORZI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "She does.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "Inside: a glass bird, translucent blue, wings spread.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "She lifts it into the glow.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "It flickers like a pulse.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "The Council thinks it's witchcraft.", "name": "ISABELLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "It's chemistry.", "name": "ZORZI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "They'll burn the shop.", "name": "ISABELLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "They'll burn me first.", "name": "ZORZI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "She sets the bird on the bench.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "I could leave it here. Tell them you destroyed it.", "name": "ISABELLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "And Giacomo?", "name": "ZORZI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "Gone to Padua.", "name": "ISABELLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "Zorzi laughs, short, ugly.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "He lifts the tongs, steps toward her.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "She doesn't move.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "He raises the iron, and the bird glitters between them.", "para": 11, "sent": 3, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "With one stroke, he smashes it.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "Blue shards fly.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "Isabella flinches.", "para": 12, "sent": 2, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "Zorzi and Isabella both stand in the sudden silence, glass sparks drifting like fireflies.", "para": 12, "sent": 3, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "Tell the Council it's ash.", "name": "ZORZI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "They'll want proof.", "name": "ISABELLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "Then bring them the furnace.", "name": "ZORZI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "action", "text": "He turns back to the fire.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "After a long moment she picks up a single shard, slips it into her cloak, and goes out into the rain.", "para": 13, "sent": 1, "present": [0, 1]}]}