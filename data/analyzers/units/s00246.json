{"scene_id": "s00246", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00246.fountain", "heading": "INT. CLOCKMAKER'S SHOP, BACK ROOM - NIGHT", "cast": [{"id": 0, "name": "MARGOT", "names": ["MARGOT"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "ILLINGWORTH-BASSEY", "names": ["ILLINGWORTH-BASSEY"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "VICTOR OKONKWO-REYES", "names": ["VICTOR OKONKWO-REYES", "VICTOR"], "gender": "?", "first": 5, "spoke": 3}, {"id": 3, "name": "DEL", "names": ["DEL"], "gender": "?", "first": 6, "spoke": 2}, {"id": 4, "name": "ARMSTRONG-KATZ", "names": ["ARMSTRONG-KATZ"], "gender": "?", "first": 6, "spoke": 0}, {"id": 5, "name": "SOL", "names": ["SOL"], "gender": "m", "first": 7, "spoke": 2}, {"id": 6, "name": "QUILLFEATHER", "names": ["QUILLFEATHER"], "gender": "?", "first": 7, "spoke": 0}, {"id": 7, "name": "ALISTAIR PEMBERTON-SHAW", "names": ["ALISTAIR PEMBERTON-SHAW", "ALISTAIR"], "gender": "?", "first": 24, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. CLOCKMAKER'S SHOP, BACK ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dozens of clocks ticking out of step.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A vault door, ajar.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Four thieves crowd the doorway in dark clothes.", "para": 1, "sent": 0, "present": []}, {"u": 4, "kind": "action", "text": "MARGOT \"THE MOUSE\" ILLINGWORTH-BASSEY (40s, crew leader) holds a stopwatch.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "VICTOR OKONKWO-REYES (30s, safecracker) presses a stethoscope to the vault.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "DELPHINE \"DEL\" ARMSTRONG-KATZ (20s, driver) shifts on her feet.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "action", "text": "SOLOMON \"SOL\" QUILLFEATHER (50s, lookout, bowler hat) peers through the shutters.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 8, "kind": "dialogue", "text": "Ninety seconds. Everyone know their job?", "name": "MARGOT", "speaker": 0, "ext": [], "paren": ["to the crew"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 9, "kind": "dialogue", "text": "I watch.", "name": "SOL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "dialogue", "text": "I drive.", "name": "DEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "I listen.", "name": "VICTOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "Good. Victor, tumblers.", "name": "MARGOT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "Come on, you old beauty.", "name": "VICTOR", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "action", "text": "A click.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "action", "text": "Another.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "action", "text": "The door swings wide.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "action", "text": "Inside: velvet cases, empty.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "Empty.", "name": "MARGOT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "Empty?", "name": "VICTOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "Margot--", "name": "DEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "Quiet.", "name": "MARGOT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "action", "text": "Every clock in the shop strikes midnight at once.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "A cacophony of chimes.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "A figure steps out from between the grandfather clocks: ALISTAIR PEMBERTON-SHAW (60s, nightshirt, shotgun, mildly annoyed).", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 25, "kind": "dialogue", "text": "Evening. I moved it Tuesday.", "name": "ALISTAIR", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 26, "kind": "action", "text": "The crew freezes.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 27, "kind": "action", "text": "Sol removes his bowler hat.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 28, "kind": "dialogue", "text": "Tuesday?", "name": "SOL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 29, "kind": "dialogue", "text": "Tuesday.", "name": "ALISTAIR", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "dialogue", "text": "Of course it was Tuesday.", "name": "MARGOT", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "action", "text": "Alistair lowers the shotgun, sighs.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "dialogue", "text": "There's tea. Stay for tea.", "name": "ALISTAIR", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}