{"scene_id": "s00247", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00247.fountain", "heading": "INT. VILLAGE SCHOOLHOUSE KITCHEN, KARAKORAM FOOTHILLS - EARLY MORNING", "cast": [{"id": 0, "name": "GRANDMOTHER ZAINAB QURESHI-ABBASOV", "names": ["GRANDMOTHER ZAINAB QURESHI-ABBASOV", "ZAINAB"], "gender": "?", "first": 6, "spoke": 6}, {"id": 1, "name": "FARIDA QURESHI", "names": ["FARIDA QURESHI", "FARIDA"], "gender": "?", "first": 6, "spoke": 2}, {"id": 2, "name": "SAMINA QURESHI", "names": ["SAMINA QURESHI", "SAMINA"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "TIMUR QURESHI", "names": ["TIMUR QURESHI", "TIMUR"], "gender": "?", "first": 6, "spoke": 1}, {"id": 4, "name": "LAILA", "names": ["LAILA"], "gender": "?", "first": 10, "spoke": 1}, {"id": 5, "name": "ELIAS HARTMANN-DOGAN", "names": ["ELIAS HARTMANN-DOGAN", "ELIAS"], "gender": "?", "first": 29, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. VILLAGE SCHOOLHOUSE KITCHEN, KARAKORAM FOOTHILLS - EARLY MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Mud-brick walls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A copper kettle.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Pale light through a slit window, catching flour in the air like small stars.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Five members of one family move around a low table.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "Bread is being made.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "GRANDMOTHER ZAINAB QURESHI-ABBASOV (80s, headscarf the color of dried apricots) kneads dough with enormous patience.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "Her daughter-in-law FARIDA QURESHI (50s, sleeves rolled) shapes loaves, one hand quick on the dough, one hand on the baby wrapped at her back.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Her granddaughter SAMINA QURESHI (17, exam papers poking from her satchel) lays out clay plates.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Her grandson TIMUR QURESHI (12, ink on his fingers) feeds the clay oven with dry twigs.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Her youngest, a girl of six called LAILA, lingers at the door, watching her feet.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Samina, the salt.", "name": "ZAINAB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Samina brings it.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Zainab pinches some, crushes it between her fingers, adds it to the dough.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "The oven's ready, Dadi.", "name": "TIMUR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Is it? Show me.", "name": "ZAINAB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "He holds out his palm to the oven mouth.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Holds it there.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Yanks it back.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Ready.", "name": "ZAINAB", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Farida slides the first loaf onto the paddle.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "The smell rises, warm and sweet.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Laila steps in.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Can I help?", "name": "LAILA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Of course.", "name": "FARIDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "She hands Laila a small ball of dough.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Laila kneads it clumsily.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "A knock at the door.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Everyone looks up.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "A stranger steps in, shaking snow from his shoulders: MR. ELIAS HARTMANN-DOGAN (40s, regional inspector, leather satchel, wet boots), blinking in the warm light.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Forgive me. I'm looking for the headmistress.", "name": "ELIAS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "That's my mother.", "name": "SAMINA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Mr. Hartmann-Dogan. We did not expect you until Thursday.", "name": "FARIDA", "speaker": 1, "ext": [], "paren": ["wiping her hands"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "The road was clear.", "name": "ELIAS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "The road is never clear.", "name": "ZAINAB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "It was today.", "name": "ELIAS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Zainab studies him a long moment.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Then cuts a heel of bread, hands it to him.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Eat first. Papers later.", "name": "ZAINAB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "He bites.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "His shoulders drop.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "This is extraordinary.", "name": "ELIAS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "It's Dadi's.", "name": "SAMINA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "It is everyone's.", "name": "ZAINAB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "The baby coos.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Laila giggles.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Timur feeds the oven another twig.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "The kettle begins, finally, to sing.", "para": 15, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}]}