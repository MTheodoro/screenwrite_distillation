{"scene_id": "s00248", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00248.fountain", "heading": "INT. ABANDONED CARNIVAL FUNHOUSE - NIGHT", "cast": [{"id": 0, "name": "MARI", "names": ["MARI"], "gender": "?", "first": 6, "spoke": 11}, {"id": 1, "name": "ENGELBRECHT-OJO", "names": ["ENGELBRECHT-OJO"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "TREVOR KAPOOR-LINDSTROM", "names": ["TREVOR KAPOOR-LINDSTROM", "TREVOR"], "gender": "m", "first": 8, "spoke": 12}, {"id": 3, "name": "WINNIE", "names": ["WINNIE"], "gender": "?", "first": 9, "spoke": 10}, {"id": 4, "name": "BAPTISTE-HOLLOWAY", "names": ["BAPTISTE-HOLLOWAY"], "gender": "?", "first": 9, "spoke": 0}, {"id": 5, "name": "CHILD", "names": ["CHILD"], "gender": "?", "first": 70, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED CARNIVAL FUNHOUSE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cracked mirrors.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Painted clown faces peeling off plywood.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A rusted carousel horse hangs from a wire.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Wind whistles through broken boards.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Three friends pick through the dark with flashlights.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "MARISOL \"MARI\" ENGELBRECHT-OJO (20s, hoodie, nervous laugh) leads.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "She points her beam down a narrow corridor lined with warped glass.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "TREVOR KAPOOR-LINDSTROM (20s, camera on a strap, bravado) follows, filming.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "WINIFRED \"WINNIE\" BAPTISTE-HOLLOWAY (20s, backpack, serious) brings up the rear, checking a paper map.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Okay, so, this is the Hall of Mirrors. Day one of the haunted-places series. Say hi, Mari.", "name": "TREVOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Hi.", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Say hi, Winnie.", "name": "TREVOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "I'm reading.", "name": "WINNIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Reading what?", "name": "TREVOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "The map. It says there's an exit through the carousel.", "name": "WINNIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Then why are we in the funhouse?", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Content.", "name": "TREVOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Idiot.", "name": "WINNIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Be nice. I'm broadcasting.", "name": "TREVOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Hold on. Trevor.", "name": "MARI", "speaker": 0, "ext": [], "paren": ["over his shoulder"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "What?", "name": "TREVOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "There's three of us.", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Yes.", "name": "TREVOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "In the mirror there's four.", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "They stop.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Mari points.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "In a cracked panel, three flashlight beams.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "And a fourth, steady, a pale light that doesn't match any of them.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "It's a reflection.", "name": "WINNIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Of what?", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Whoa, whoa. Everyone breathe.", "name": "TREVOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "They turn in a slow circle.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "The fourth light is gone.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "The mirror shows only themselves.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Cool. That was cool.", "name": "TREVOR", "speaker": 2, "ext": ["CONT'D"], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "We leave. Now.", "name": "WINNIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Yes. Yes. Let's go.", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "They back down the corridor, shoulder to shoulder.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "A laugh echoes.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Not theirs.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Light and high, a child's.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "They sprint.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Boots clatter.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "A mirror shatters, then another, one after another, as if a hand were sweeping through.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Trevor drops the camera.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "It spins on the floor, filming the ceiling.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Winnie grabs Mari's wrist.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Mari grabs Trevor's collar.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "They crash through a painted door into the carousel hall.", "para": 9, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "The carousel horses are all turned to face them.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "No.", "name": "TREVOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "Don't move.", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "Don't look.", "name": "WINNIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "The music box starts.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Slow, wheezing.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Winnie, the map. The exit.", "name": "MARI", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "Behind the red horse.", "name": "WINNIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "Which is the red horse?", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "They all look.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "Twenty horses.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "Eighteen are white.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "One is black.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "One is red.", "para": 12, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "The red horse blinks.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "They scream.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "In unison.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "action", "text": "A single voice that rattles the roof.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "action", "text": "Then the music stops, as though a hand had pressed it silent.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "A voice, close, warm, from just behind the three of them.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "dialogue", "text": "You came back.", "name": "CHILD", "speaker": 5, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "action", "text": "Mari whips around.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "action", "text": "Nobody there.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "dialogue", "text": "We've never been here.", "name": "MARI", "speaker": 0, "ext": [], "paren": ["under her breath"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "dialogue", "text": "You came back.", "name": "CHILD", "speaker": 5, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 75, "kind": "action", "text": "Trevor drops to his knees, scooping the camera.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 76, "kind": "action", "text": "Its red light blinks.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 77, "kind": "dialogue", "text": "Please. Please. We'll leave. We'll never--", "name": "TREVOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 78, "kind": "action", "text": "The voice laughs.", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 79, "kind": "dialogue", "text": "Say it again.", "name": "CHILD", "speaker": 5, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 80, "kind": "dialogue", "text": "We'll leave.", "name": "TREVOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 81, "kind": "dialogue", "text": "Say it with love.", "name": "CHILD", "speaker": 5, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 82, "kind": "dialogue", "text": "No.", "name": "WINNIE", "speaker": 3, "ext": [], "paren": ["sudden, firm"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 83, "kind": "action", "text": "She stands.", "para": 20, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 84, "kind": "action", "text": "She faces the dark where the voice is.", "para": 20, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 85, "kind": "action", "text": "Raises her flashlight, and aims it at the red horse.", "para": 20, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 86, "kind": "dialogue", "text": "We're not saying anything. We're leaving. You can have the funhouse.", "name": "WINNIE", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 87, "kind": "action", "text": "Silence.", "para": 21, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 88, "kind": "action", "text": "The wind stops.", "para": 21, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 89, "kind": "action", "text": "Then the red horse, slowly, turns its head away.", "para": 22, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 90, "kind": "dialogue", "text": "Walk. Don't run.", "name": "WINNIE", "speaker": 3, "ext": ["CONT'D"], "paren": ["to the others"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 91, "kind": "action", "text": "They walk.", "para": 23, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 92, "kind": "action", "text": "Past the horses.", "para": 23, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 93, "kind": "action", "text": "Past the dead ticket booth.", "para": 23, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 94, "kind": "action", "text": "Past the gate.", "para": 23, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 95, "kind": "action", "text": "Behind them, the music box begins again.", "para": 24, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 96, "kind": "action", "text": "Soft.", "para": 24, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 97, "kind": "action", "text": "Almost happy.", "para": 24, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}