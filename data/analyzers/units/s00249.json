{"scene_id": "s00249", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00249.fountain", "heading": "EXT. HIGH PLATEAU, BURNED FOREST - DAWN", "cast": [{"id": 0, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 7, "spoke": 7}, {"id": 1, "name": "TALL MAN", "names": ["TALL MAN"], "gender": "?", "first": 8, "spoke": 7}, {"id": 2, "name": "WOMAN", "names": ["WOMAN"], "gender": "?", "first": 11, "spoke": 7}, {"id": 3, "name": "ELIO", "names": ["ELIO"], "gender": "?", "first": 26, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. HIGH PLATEAU, BURNED FOREST - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Black trunks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Ash like grey snow.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A crippled pickup with its hood up.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A man sits on its bumper, bandaging his hand.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "Another stands at the tree line, binoculars up.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "A third crouches by the tailgate, counting cans.", "para": 1, "sent": 2, "present": []}, {"u": 7, "kind": "dialogue", "text": "We can't stay.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 8, "kind": "dialogue", "text": "We can't leave.", "name": "TALL MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "We don't have fuel.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "We have legs.", "name": "TALL MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "We have four cans of beans and no opener.", "name": "WOMAN", "speaker": 2, "ext": [], "paren": ["from the tailgate"], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Then we use the knife.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "It's your knife.", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I know whose knife it is.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "The tall man lowers the binoculars.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Smoke. East ridge.", "name": "TALL MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "How far?", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Six miles.", "name": "TALL MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "It could be anyone.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "It could be the fire again.", "name": "TALL MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "It could be help.", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "It could be them.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "A silence.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "They look at each other.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "You never told us your name.", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Elio.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Elio what?", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Just Elio.", "name": "ELIO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Okay, Just Elio. Here's what we do.", "name": "TALL MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "We split.", "name": "ELIO", "speaker": 3, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "We stay together.", "name": "WOMAN", "speaker": 2, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "^", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "We go together, east, now!", "name": "TALL MAN", "speaker": 1, "ext": [], "paren": ["overlapping both"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "A hiss in the trees.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "All three freeze.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Branches crack.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "A shape moves in the ash, low and fast.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Run!", "name": "ELIO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "The truck door slams.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "The woman dives.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "The tall man fires.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "A burst of gunshot echoes across the burned plateau, and the pale smoke rises, higher, higher.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}]}