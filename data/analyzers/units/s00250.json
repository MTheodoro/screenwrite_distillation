{"scene_id": "s00250", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00250.fountain", "heading": "INT. ORBITAL SALVAGE TUG \"LONG PATIENCE,\" CARGO BAY - SHIP NIGHT", "cast": [{"id": 0, "name": "OKSANA REYNOLDS-ADEBOYE", "names": ["OKSANA REYNOLDS-ADEBOYE", "OKSANA"], "gender": "?", "first": 5, "spoke": 9}, {"id": 1, "name": "COMMS", "names": ["COMMS"], "gender": "?", "first": 7, "spoke": 8}, {"id": 2, "name": "SIMEON AKINTOLA-VEGA", "names": ["SIMEON AKINTOLA-VEGA", "SIMEON"], "gender": "m", "first": 21, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. ORBITAL SALVAGE TUG \"LONG PATIENCE,\" CARGO BAY - SHIP NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Strip lighting.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Mag-boots clank.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Crates stacked in nets.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A viewport shows a wreck turning slowly against the stars.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "OKSANA REYNOLDS-ADEBOYE (40s, engineer, grease up to the elbows) crouches over an open hatch, a wrench in one hand.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She does not look up when the intercom hisses.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "dialogue", "text": "Engineer. Bridge. Report.", "name": "COMMS", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She keeps working.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Turns a bolt.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Another.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Still on it.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Captain wants a status on the coupling.", "name": "COMMS", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Tell the Captain it's a coupling.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Copy.", "name": "COMMS", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She sets the wrench down.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Wipes her hands on her thighs.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "From a vent behind her, a soft click.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She turns slowly.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Nothing.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "But she picks the wrench back up.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "A second figure floats in from the airlock: SIMEON AKINTOLA-VEGA (30s, flight tech, jumpsuit unzipped to the chest).", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "He anchors himself with one boot to a crate and stares at her.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "You okay?", "name": "SIMEON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Fine.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "You've been down here nine hours.", "name": "SIMEON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "It's a big coupling.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Captain says come up.", "name": "SIMEON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Captain says what?", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Engineer, Captain says come up. Immediately.", "name": "COMMS", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Why?", "name": "OKSANA", "speaker": 0, "ext": [], "paren": ["to the intercom"], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Something on the scanner. Something near the wreck.", "name": "COMMS", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Oksana and Simeon look at each other.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "She tightens her grip on the wrench.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "He zips his jumpsuit to the collar.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "What is it?", "name": "SIMEON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Unknown. Moving. Matching our heading.", "name": "COMMS", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "How close?", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Twelve kilometers. And closing.", "name": "COMMS", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "She lets the wrench drift.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "It spins slowly in front of her, catching the light.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "I'm going up.", "name": "SIMEON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Wait.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "He waits.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Her eyes go to the viewport.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "The wreck rotates; behind it, a shape too regular to be debris.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "She says nothing.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Neither does he.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "They float side by side.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Engineer? Tech? Respond.", "name": "COMMS", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Simeon opens his mouth.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Closes it.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Oksana presses the intercom.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "We're coming up.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": ["evenly"], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "She lets go.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Drifts across the bay.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "At the door she stops, lays one palm flat on a crate as if for luck.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Then she follows Simeon into the corridor.", "para": 12, "sent": 0, "present": [0, 1, 2]}]}