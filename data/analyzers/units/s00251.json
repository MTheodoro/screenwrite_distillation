{"scene_id": "s00251", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00251.fountain", "heading": "INT. PAWNSHOP BACK ROOM - NIGHT", "cast": [{"id": 0, "name": "MAN", "names": ["MAN"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "GREY HOODIE", "names": ["GREY HOODIE"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "SHOPKEEPER MARCUS OYELARAN-BRIGHT", "names": ["SHOPKEEPER MARCUS OYELARAN-BRIGHT", "MARCUS"], "gender": "m", "first": 7, "spoke": 5}, {"id": 3, "name": "DETECTIVE IRENE KOWALCZYK-DIOP", "names": ["DETECTIVE IRENE KOWALCZYK-DIOP", "DETECTIVE KOWALCZYK-DIOP", "KOWALCZYK-DIOP"], "gender": "f", "first": 23, "spoke": 4}, {"id": 4, "name": "DANNY", "names": ["DANNY"], "gender": "?", "first": 33, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. PAWNSHOP BACK ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Glass cases.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Guitars on hooks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A TV with the sound off.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A MAN IN A GREY HOODIE (30s) tears open a drawer, dumps it.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Jewelry rattles onto the floor.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Behind him, the door creaks.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "SHOPKEEPER MARCUS OYELARAN-BRIGHT (50s, cardigan, baseball bat) steps in.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "The man turns.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Whoa. Whoa.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Put it down.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "It's not what it looks like.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "It looks like robbery.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Okay, it's what it looks like.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "He bolts.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Marcus swings.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "The bat clips a guitar; strings twang.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "They crash together against the counter, hands on each other's collars.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "A glass case shatters under them.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Let go!", "name": "MAN", "speaker": 0, "ext": ["CONT'D"], "paren": ["grunting"], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "You let go!", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "They stagger, breathing hard.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "A second figure appears in the doorway.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "DETECTIVE IRENE KOWALCZYK-DIOP (40s, badge on her belt, gun drawn) stands with her feet planted.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Police. Hands.", "name": "DETECTIVE KOWALCZYK-DIOP", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Both men freeze.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Both raise their hands.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Marcus drops the bat.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "The man drops the loot.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Detective. He's the thief.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "He's the owner!", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Sir. Mr. Oyelaran-Bright. I'm familiar.", "name": "DETECTIVE KOWALCZYK-DIOP", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "She holsters, steps forward, and cuffs the man.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "You've been busy, Danny.", "name": "KOWALCZYK-DIOP", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Hi, Irene.", "name": "DANNY", "speaker": 4, "ext": [], "paren": ["sighing"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "You know him?", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "He's my brother.", "name": "KOWALCZYK-DIOP", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "A beat.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Marcus picks up the bat, sets it on the counter, and quietly pours himself a drink.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}]}