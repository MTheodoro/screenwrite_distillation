{"scene_id": "s00252", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00252.fountain", "heading": "EXT. WINDMILL RANCH, DRY PLAINS - DAY", "cast": [{"id": 0, "name": "ABEL MONTGOMERY-OSEI", "names": ["ABEL MONTGOMERY-OSEI", "ABEL"], "gender": "?", "first": 4, "spoke": 9}, {"id": 1, "name": "RADIO", "names": ["RADIO"], "gender": "?", "first": 21, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. WINDMILL RANCH, DRY PLAINS - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A tall steel windmill creaks against a bleached sky.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A sagging fence runs off into dust.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Beneath the tower, a water trough, half-empty.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ABEL MONTGOMERY-OSEI (50s, long coat, sun-cracked hat, a face like riverbed) rides in, dismounts, and loosens the cinch.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "His horse drinks.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "He doesn't.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "He walks to the windmill.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Reaches into the shadow of the tower and pulls out a tin box.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "Opens it.", "para": 2, "sent": 2, "present": [0]}, {"u": 10, "kind": "action", "text": "Inside: a folded letter, a photograph, a wedding ring.", "para": 2, "sent": 3, "present": [0]}, {"u": 11, "kind": "action", "text": "He reads the letter.", "para": 3, "sent": 0, "present": [0]}, {"u": 12, "kind": "action", "text": "Folds it.", "para": 3, "sent": 1, "present": [0]}, {"u": 13, "kind": "action", "text": "Pockets the ring.", "para": 3, "sent": 2, "present": [0]}, {"u": 14, "kind": "action", "text": "Holds the photograph a long time.", "para": 3, "sent": 3, "present": [0]}, {"u": 15, "kind": "action", "text": "Then he sits against the windmill leg and stares across the plain.", "para": 4, "sent": 0, "present": [0]}, {"u": 16, "kind": "action", "text": "A faint crackle from his saddlebag.", "para": 5, "sent": 0, "present": [0]}, {"u": 17, "kind": "action", "text": "A small battered radio, strapped there for emergencies.", "para": 5, "sent": 1, "present": [0]}, {"u": 18, "kind": "dialogue", "text": "Not now.", "name": "ABEL", "speaker": 0, "ext": [], "paren": ["to the radio"], "dual": false, "present": [0]}, {"u": 19, "kind": "action", "text": "The crackle repeats.", "para": 6, "sent": 0, "present": [0]}, {"u": 20, "kind": "action", "text": "A voice, thin and far:", "para": 6, "sent": 1, "present": [0]}, {"u": 21, "kind": "dialogue", "text": "Abel. You there?", "name": "RADIO", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "I'm here.", "name": "ABEL", "speaker": 0, "ext": [], "paren": ["sighing"], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "They found the bodies at Cutter's Rise.", "name": "RADIO", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "I know.", "name": "ABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "It was the Calloway gang.", "name": "RADIO", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "I know who it was.", "name": "ABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "What are you going to do?", "name": "RADIO", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Abel looks at the windmill blades turning.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Looks at the dust.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "I'm going to stay here a while.", "name": "ABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Abel--", "name": "RADIO", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "A while.", "name": "ABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "He clicks the radio off.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Puts it back in the bag.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "The wind picks up.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "The windmill groans.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Far on the horizon, three riders appear as dark specks.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Abel doesn't turn.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Took you long enough.", "name": "ABEL", "speaker": 0, "ext": ["CONT'D"], "paren": ["to himself"], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "He stands.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Draws his revolver.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Checks it.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Holsters it.", "para": 10, "sent": 3, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "Then, deliberately, he sits down again and takes off his hat, resting it on his knee.", "para": 10, "sent": 4, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "The riders grow.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Abel waits.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "At two hundred yards, one of them raises a rifle.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Abel doesn't flinch.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Not yet.", "name": "ABEL", "speaker": 0, "ext": ["CONT'D"], "paren": ["softly, to the photograph"], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "The shot cracks.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "The photograph leaps from his hand, a hole through the corner.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "He stares at it.", "para": 13, "sent": 2, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "Then he is on his feet, gun up, firing three times at the riders.", "para": 13, "sent": 3, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "One falls.", "para": 13, "sent": 4, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "The others scatter into the dust.", "para": 13, "sent": 5, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "Silence returns.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "The windmill creaks.", "para": 14, "sent": 1, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "Abel crosses to the photograph, bends, and picks it up with great care.", "para": 14, "sent": 2, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "A hole where a shoulder used to be.", "para": 14, "sent": 3, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "He lowers himself to the ground.", "para": 15, "sent": 0, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "Breathes.", "para": 15, "sent": 1, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "There. Now we're done.", "name": "ABEL", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the sky"], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "The wind carries the smoke away.", "para": 16, "sent": 0, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "The blades keep turning.", "para": 16, "sent": 1, "present": [0, 1]}]}