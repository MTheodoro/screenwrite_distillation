{"scene_id": "s00253", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00253.fountain", "heading": "INT. COURTHOUSE BASEMENT, EXHIBIT STORAGE - DAY", "cast": [{"id": 0, "name": "ATTORNEY SABINE OKONKWO-HARTLEY", "names": ["ATTORNEY SABINE OKONKWO-HARTLEY", "SABINE"], "gender": "f", "first": 5, "spoke": 15}, {"id": 1, "name": "OPPOSING COUNSEL DOMINIC TRAVERSO-ADEBAYO", "names": ["OPPOSING COUNSEL DOMINIC TRAVERSO-ADEBAYO", "DOMINIC"], "gender": "?", "first": 6, "spoke": 13}, {"id": 2, "name": "PRU", "names": ["PRU"], "gender": "f", "first": 7, "spoke": 6}, {"id": 3, "name": "LINDGREN-ASANTE", "names": ["LINDGREN-ASANTE"], "gender": "?", "first": 7, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. COURTHOUSE BASEMENT, EXHIBIT STORAGE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent tubes.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Metal shelving.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Cardboard boxes labeled in marker.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Three people stand at a steel table, a single evidence bag between them.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "ATTORNEY SABINE OKONKWO-HARTLEY (40s, gray suit, tired) holds a tablet.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "OPPOSING COUNSEL DOMINIC TRAVERSO-ADEBAYO (50s, expensive tie, patient smile) flips through an inventory.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "CLERK PRUDENCE \"PRU\" LINDGREN-ASANTE (20s, lanyard, headphones around her neck) logs entries on a clipboard.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "For the record, we are inspecting Exhibit Fourteen.", "name": "SABINE", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "For the record, it's a screwdriver.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "It's a Phillips-head.", "name": "PRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Thank you, Pru.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Sabine, we've been through this.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Dominic, we've been through everything.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "The chain of custody is solid.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "The chain of custody has a gap of nineteen hours.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "That was a weekend.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Murder trials don't have weekends.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "This one did.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "I'm just the clerk.", "name": "PRU", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Pru, which officer logged the tool?", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Officer Haverford. Badge four-two-one.", "name": "PRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "He's on leave.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Convenient.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Medical.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Of course.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Of course.", "name": "PRU", "speaker": 2, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Sabine leans over the bag.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Squints at a smudge on the handle.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "That's a thumbprint.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Probably the officer's.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Probably.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Is there a point?", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "There's a name in the margin of the log. Not Haverford.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Pru checks her clipboard.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Her eyes widen.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Oh.", "name": "PRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Pru?", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "It says... Traverso.", "name": "PRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Dominic's smile doesn't move.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Your father's name.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "It's a common name.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": ["evenly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "It's a very uncommon screwdriver.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Pru backs a step toward the stairs.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Sabine, calm, unfolds her tablet.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Let the record show opposing counsel declined to comment.", "name": "SABINE", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the ceiling"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Neither confirmed nor denied.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "That's the same thing.", "name": "SABINE", "speaker": 0, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "It is not.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "^", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Pru, very softly, closes the log.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}]}