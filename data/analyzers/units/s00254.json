{"scene_id": "s00254", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00254.fountain", "heading": "INT. DEEP-SEA RESEARCH HABITAT \"THALASSA-9,\" MESS HALL - SHIP NIGHT", "cast": [{"id": 0, "name": "COMMANDER ILSE VARGA-OKONJO", "names": ["COMMANDER ILSE VARGA-OKONJO", "ILSE"], "gender": "m", "first": 6, "spoke": 6}, {"id": 1, "name": "MBALI NKOSI-ARRINGTON", "names": ["MBALI NKOSI-ARRINGTON", "MBALI"], "gender": "f", "first": 7, "spoke": 8}, {"id": 2, "name": "ENGINEER DEWEY HOLLOWAY-SATO", "names": ["ENGINEER DEWEY HOLLOWAY-SATO", "DEWEY"], "gender": "m", "first": 8, "spoke": 6}, {"id": 3, "name": "PRIYA", "names": ["PRIYA"], "gender": "f", "first": 9, "spoke": 6}, {"id": 4, "name": "DESAI-BRANDT", "names": ["DESAI-BRANDT"], "gender": "?", "first": 9, "spoke": 0}, {"id": 5, "name": "NEWCOMER", "names": ["NEWCOMER"], "gender": "?", "first": 10, "spoke": 3}, {"id": 6, "name": "ARTHUR", "names": ["ARTHUR"], "gender": "?", "first": 50, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. DEEP-SEA RESEARCH HABITAT \"THALASSA-9,\" MESS HALL - SHIP NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Low ceiling.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Portholes show black water.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A table bolted to the floor.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Steam from five bowls of reconstituted soup.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Five crew eat in tired silence.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "COMMANDER ILSE VARGA-OKONJO (50s, grey crewcut, flight jacket) cuts a biscuit in half.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "DR. MBALI NKOSI-ARRINGTON (30s, marine biologist, spectacles on a string) stirs her soup without drinking.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "ENGINEER DEWEY HOLLOWAY-SATO (40s, wrench in his belt) scrapes his bowl.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "TECH PRIYANKA \"PRIYA\" DESAI-BRANDT (20s, tablet in one hand, spoon in the other) scrolls through readings.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "And a quiet man, face smudged with grease, who has not given his name: A NEWCOMER (30s, orange vest, new boots).", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Anyone want to say anything?", "name": "ILSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "A pipe knocks somewhere.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "The trench is warmer than yesterday.", "name": "MBALI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Everything's warmer than yesterday.", "name": "DEWEY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Not everything. Pressure's flat.", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Flat is good.", "name": "NEWCOMER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Flat is boring.", "name": "DEWEY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "I like boring.", "name": "ILSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "I like flat.", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "I like soup.", "name": "MBALI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "They eat.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "A porthole flickers: a pale shape drifts past and is gone.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Did anyone see that?", "name": "MBALI", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "What?", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Fish.", "name": "DEWEY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "It was larger than fish.", "name": "MBALI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Dr. Nkosi-Arrington, the instruments say nothing.", "name": "ILSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "The instruments aren't looking out the window.", "name": "MBALI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "It's the lights. They attract plankton.", "name": "NEWCOMER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Plankton doesn't look back.", "name": "DEWEY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Did it look back?", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "I don't know.", "name": "MBALI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "The table goes quiet.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Priya sets down her tablet, face up.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Everyone leans in.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Priya. Readings.", "name": "ILSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Nothing. A small thermal bloom, two hundred meters out.", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Heat means life.", "name": "DEWEY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Or a vent.", "name": "MBALI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Or us.", "name": "NEWCOMER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Ilse looks at him.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "He looks at her.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "After a moment she nods and resumes cutting her biscuit.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Eat. We have a shift in an hour.", "name": "ILSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "They eat.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "Nobody speaks.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "The pipe knocks again.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "Then the newcomer says, softly, to no one:", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "Name's Arthur.", "name": "ARTHUR", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "dialogue", "text": "Welcome, Arthur.", "name": "ILSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "dialogue", "text": "Welcome.", "name": "DEWEY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "dialogue", "text": "Welcome.", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "dialogue", "text": "Welcome. Your boots are very new.", "name": "MBALI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "dialogue", "text": "They're the only thing I own.", "name": "ARTHUR", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "action", "text": "Mbali smiles for the first time.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "action", "text": "The others do too.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "action", "text": "Outside, the porthole darkens again.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}]}