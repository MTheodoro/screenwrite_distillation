{"scene_id": "s00255", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00255.fountain", "heading": "INT. REGIONAL BAKING CHAMPIONSHIP, COMMUNITY HALL - AFTERNOON", "cast": [{"id": 0, "name": "BERNIE", "names": ["BERNIE"], "gender": "f", "first": 6, "spoke": 5}, {"id": 1, "name": "OKONKWO-PRYCE", "names": ["OKONKWO-PRYCE"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "CORKY", "names": ["CORKY"], "gender": "?", "first": 7, "spoke": 5}, {"id": 3, "name": "ABERNATHY-LIU", "names": ["ABERNATHY-LIU"], "gender": "?", "first": 7, "spoke": 0}, {"id": 4, "name": "GWENDOLYN MUKHERJEE-FALLOWS", "names": ["GWENDOLYN MUKHERJEE-FALLOWS", "GWENDOLYN"], "gender": "f", "first": 8, "spoke": 5}, {"id": 5, "name": "OLLIE", "names": ["OLLIE"], "gender": "?", "first": 9, "spoke": 5}, {"id": 6, "name": "TEMPLETON-ADAIR", "names": ["TEMPLETON-ADAIR"], "gender": "?", "first": 9, "spoke": 0}, {"id": 7, "name": "OISE OLUWASEUN-LEBLANC", "names": ["OISE OLUWASEUN-LEBLANC"], "gender": "?", "first": 10, "spoke": 0}, {"id": 8, "name": "FRAN\u00c7OISE", "names": ["FRAN\u00c7OISE"], "gender": "f", "first": 10, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. REGIONAL BAKING CHAMPIONSHIP, COMMUNITY HALL - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Bunting.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Folding tables.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A smell of sugar and mild panic.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Contestants stand at oven stations in matching aprons.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Five of them cluster near the judges' table, where a lemon tart sits under a glass dome.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "BERNADETTE \"BERNIE\" OKONKWO-PRYCE (60s, apron with a hand-stitched rolling pin) wipes flour from her glasses.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "CORNELIUS \"CORKY\" ABERNATHY-LIU (30s, hair net, drawn-on mustache) sulks beside a deflated souffl\u00e9.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "GWENDOLYN MUKHERJEE-FALLOWS (40s, crisp white chef's jacket) arranges a perfect row of macarons.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "ORVILLE \"OLLIE\" TEMPLETON-ADAIR (70s, suspenders) hums off-key over a tray of shortbread.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "action", "text": "And the judge, MADAME FRAN\u00c7OISE OLUWASEUN-LEBLANC (50s, silk scarf, expression of permanent disappointment), lowers herself into the central chair.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 11, "kind": "dialogue", "text": "Contestants. Time.", "name": "FRAN\u00c7OISE", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 12, "kind": "dialogue", "text": "Time!", "name": "BERNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 13, "kind": "dialogue", "text": "Time?", "name": "CORKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 14, "kind": "dialogue", "text": "Time.", "name": "GWENDOLYN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 15, "kind": "dialogue", "text": "Time, time, time.", "name": "OLLIE", "speaker": 5, "ext": [], "paren": ["humming"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 16, "kind": "dialogue", "text": "Mr. Abernathy-Liu, your souffl\u00e9 has fallen.", "name": "FRAN\u00c7OISE", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 17, "kind": "dialogue", "text": "It's resting.", "name": "CORKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 18, "kind": "dialogue", "text": "It is flat.", "name": "FRAN\u00c7OISE", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 19, "kind": "dialogue", "text": "It's modernist.", "name": "CORKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 20, "kind": "dialogue", "text": "It's a pancake, dear.", "name": "BERNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 21, "kind": "dialogue", "text": "It's an homage to the pancake.", "name": "CORKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 22, "kind": "dialogue", "text": "Mine rose perfectly.", "name": "GWENDOLYN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 23, "kind": "dialogue", "text": "Yours is a macaron, Gwen. It's required to.", "name": "BERNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 24, "kind": "dialogue", "text": "Don't be catty.", "name": "GWENDOLYN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 25, "kind": "dialogue", "text": "I'm not catty. I'm shortbread.", "name": "OLLIE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 26, "kind": "dialogue", "text": "Mr. Templeton-Adair, you are not allowed to hum.", "name": "FRAN\u00c7OISE", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 27, "kind": "dialogue", "text": "I'm not humming.", "name": "OLLIE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 28, "kind": "dialogue", "text": "You are.", "name": "FRAN\u00c7OISE", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 29, "kind": "dialogue", "text": "It's the oven.", "name": "OLLIE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 30, "kind": "action", "text": "The oven timer BEEPS.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 31, "kind": "action", "text": "Everyone jumps.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 32, "kind": "action", "text": "Gwendolyn's elbow knocks her tray.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 33, "kind": "action", "text": "Macarons scatter across the floor like pastel dice.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 34, "kind": "action", "text": "Corky dives, Bernie dives, Ollie dives.", "para": 7, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 35, "kind": "action", "text": "The three of them collide, flour clouds going up, a tangle of aprons.", "para": 7, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 36, "kind": "dialogue", "text": "Stop! Stop at once!", "name": "FRAN\u00c7OISE", "speaker": 8, "ext": [], "paren": ["standing"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 37, "kind": "action", "text": "Bernie surfaces with a macaron in her teeth.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 38, "kind": "action", "text": "Corky has a mouthful of shortbread.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 39, "kind": "action", "text": "Ollie is under the table.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 40, "kind": "action", "text": "Gwendolyn stands frozen, hands at her cheeks.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 41, "kind": "dialogue", "text": "Eight hours.", "name": "GWENDOLYN", "speaker": 4, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 42, "kind": "dialogue", "text": "Mrs. Mukherjee-Fallows.", "name": "FRAN\u00c7OISE", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 43, "kind": "dialogue", "text": "Eight hours I stood at that oven.", "name": "GWENDOLYN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 44, "kind": "dialogue", "text": "It's not bad, actually.", "name": "BERNIE", "speaker": 0, "ext": [], "paren": ["spitting out the macaron"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 45, "kind": "dialogue", "text": "Quite good.", "name": "CORKY", "speaker": 2, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 46, "kind": "dialogue", "text": "Can someone pass a plate?", "name": "OLLIE", "speaker": 5, "ext": [], "paren": ["from under the table"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 47, "kind": "action", "text": "Fran\u00e7oise sits slowly, looks at the wreckage, and for the first time lifts a hand to her mouth to hide a smile.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 48, "kind": "dialogue", "text": "I have never seen such a thing.", "name": "FRAN\u00c7OISE", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 49, "kind": "dialogue", "text": "Does that mean we won?", "name": "BERNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 50, "kind": "dialogue", "text": "It means I'm hungry.", "name": "FRAN\u00c7OISE", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}]}