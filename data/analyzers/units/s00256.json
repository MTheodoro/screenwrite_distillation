{"scene_id": "s00256", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00256.fountain", "heading": "INT. NIGHT BOAT, RIVER DANUBE - NIGHT", "cast": [{"id": 0, "name": "OLGA RADOMSKA-IKEJIANI", "names": ["OLGA RADOMSKA-IKEJIANI", "OLGA"], "gender": "m", "first": 5, "spoke": 9}, {"id": 1, "name": "DETECTIVE KASPAR NWANKWO-BRUUN", "names": ["DETECTIVE KASPAR NWANKWO-BRUUN", "KASPAR"], "gender": "?", "first": 7, "spoke": 10}, {"id": 2, "name": "LAURA", "names": ["LAURA"], "gender": "?", "first": 48, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT BOAT, RIVER DANUBE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A narrow cabin.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Brass lamp.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Curtains drawn.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A tray with two untouched cups of tea.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "OLGA RADOMSKA-IKEJIANI (40s, black gloves, a fur collar) sits on the bunk.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She stirs her tea slowly, never lifting it.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Across from her, DETECTIVE KASPAR NWANKWO-BRUUN (50s, trench, bruised knuckles) leans against the door.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He is calm.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "She is calm.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "The boat rocks.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "You knew him.", "name": "KASPAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Everyone knew him.", "name": "OLGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Better than most.", "name": "KASPAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Worse.", "name": "OLGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "He wrote to you every week.", "name": "KASPAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Letters are cheap.", "name": "OLGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She sips.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Sets the cup down.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He watches the cup, not her.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "He's dead, Olga.", "name": "KASPAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "So I hear.", "name": "OLGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Poisoned.", "name": "KASPAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "How careless.", "name": "OLGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "He moves.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "In a single step he is across the cabin.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "She rises just as quickly.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "They stand an inch apart.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Give me the glove.", "name": "KASPAR", "speaker": 1, "ext": ["CONT'D"], "paren": ["quietly"], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Which?", "name": "OLGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "The left.", "name": "KASPAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "She holds out her left hand.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "He takes it.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Peels the glove, finger by finger.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "On her wrist: a bruise shaped like a ring of fingertips.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "He fought.", "name": "KASPAR", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "He was stronger than he looked.", "name": "OLGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Than you looked.", "name": "KASPAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "She yanks free.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "He catches her again.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "They grapple.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "The lamp swings.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Tea spills across the floor.", "para": 8, "sent": 4, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "She wrenches a hairpin from her hair, jabs at his arm.", "para": 8, "sent": 5, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "He twists it away.", "para": 8, "sent": 6, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "Both crash onto the bunk, breathing hard.", "para": 8, "sent": 7, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Then the cabin door opens.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "A woman's voice, off-screen, calm and amused:", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Kaspar. Olga. You're both very loud.", "name": "LAURA", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "They freeze.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Kaspar, over Olga, hand at her throat.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Olga, under him, the pin at his ribs.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Who is that?", "name": "OLGA", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "My wife.", "name": "KASPAR", "speaker": 1, "ext": [], "paren": ["whispering back"], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Olga laughs, a low rich laugh.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "He lets go.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "She sits up, smoothing her fur.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "Then this is a very different kind of poisoning.", "name": "OLGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}