{"scene_id": "s00257", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00257.fountain", "heading": "INT. HOSPITAL ROOFTOP HELIPAD - NIGHT", "cast": [{"id": 0, "name": "MALACHI BOUSSARD-OJO", "names": ["MALACHI BOUSSARD-OJO", "MALACHI"], "gender": "?", "first": 4, "spoke": 17}, {"id": 1, "name": "WOMAN", "names": ["WOMAN"], "gender": "?", "first": 8, "spoke": 10}, {"id": 2, "name": "LONG GREY COAT", "names": ["LONG GREY COAT"], "gender": "?", "first": 8, "spoke": 0}, {"id": 3, "name": "DELPHINE", "names": ["DELPHINE"], "gender": "?", "first": 39, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOSPITAL ROOFTOP HELIPAD - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Wind.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Orange safety lights.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The city spreads below like a spilled circuit board.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. MALACHI BOUSSARD-OJO (40s, scrubs under a parka) leans on the railing, staring at the lights.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "A thermos steams beside him.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Boots on metal stairs.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "The door opens.", "para": 2, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "A WOMAN IN A LONG GREY COAT (30s, hospital badge flipped backwards) steps out and stops five feet away.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "You shouldn't be up here.", "name": "MALACHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Neither should you.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I'm on break.", "name": "MALACHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "So am I.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She walks to the railing.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Stands beside him.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "He pours coffee into the thermos cap, offers it.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "She takes it.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Thanks, Dr. Boussard-Ojo.", "name": "WOMAN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "You know my name.", "name": "MALACHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "It's on the schedule.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I don't know yours.", "name": "MALACHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Not yet.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "She sips.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Looks at the city.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "He watches her.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "She hands the cap back, empty.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "He fills it again.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Third floor. Bed twelve. Did you know him?", "name": "MALACHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Mr. Prokopiou?", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Yes.", "name": "MALACHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "I did.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "He died an hour ago.", "name": "MALACHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "I know. I was with him.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Not on the chart.", "name": "MALACHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "I'm not on any chart.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "A siren climbs the hill and fades.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Malachi stiffens.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "She looks at him steadily.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Who are you?", "name": "MALACHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Delphine. Delphine Ashworth.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "The inspector from the board?", "name": "MALACHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "The same.", "name": "DELPHINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "You were here the whole time.", "name": "MALACHI", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Since Tuesday.", "name": "DELPHINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "His hand shakes.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "The thermos cap spills.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "He wipes his palm on his thigh, steps back, and she steps forward.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "He grips the railing.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "She grips his sleeve.", "para": 7, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Their eyes lock for a long time, wind snapping both coats against their legs.", "para": 7, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Dr. Boussard-Ojo, the insulin dose you ordered was ten times the standard.", "name": "DELPHINE", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "It was a clerical error.", "name": "MALACHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "It was initialed in your handwriting.", "name": "DELPHINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "I was tired.", "name": "MALACHI", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Everyone is tired.", "name": "DELPHINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "He pulls free.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Paces to the helipad's yellow circle.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Stands in its center, head bowed.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "He was in pain. For eleven days.", "name": "MALACHI", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "And?", "name": "DELPHINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "I thought I was doing him a kindness.", "name": "MALACHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "You were doing yourself one.", "name": "DELPHINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "He looks up.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "The wind drops.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "Far below, a patrol car pulls into the emergency bay, its lights spinning blue and red against the glass.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "You called them.", "name": "MALACHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "At the start of break.", "name": "DELPHINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "Why wait?", "name": "MALACHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "I wanted to hear you say it.", "name": "DELPHINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "She picks up the thermos, screws the lid on, and sets it gently at his feet.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "He stares at it.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "Then slowly, he sits down in the yellow circle and lets the cold come.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}]}