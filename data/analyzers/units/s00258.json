{"scene_id": "s00258", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00258.fountain", "heading": "EXT. TRAIN WATER TOWER, RAILWAY SIDING - NIGHT", "cast": [{"id": 0, "name": "WIDOW HESTER GALLOWAY-BIRD", "names": ["WIDOW HESTER GALLOWAY-BIRD", "HESTER"], "gender": "f", "first": 5, "spoke": 19}, {"id": 1, "name": "TRAVELLING DOCTOR AMARA OKONKWO-WESTBROOK", "names": ["TRAVELLING DOCTOR AMARA OKONKWO-WESTBROOK", "AMARA"], "gender": "f", "first": 6, "spoke": 18}], "units": [{"u": 0, "kind": "heading", "text": "EXT. TRAIN WATER TOWER, RAILWAY SIDING - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A wooden tower on iron legs.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A pump house.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rails vanish into dark prairie.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Two women sit under it, a small fire between them, boots stretched toward the heat.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "WIDOW HESTER GALLOWAY-BIRD (60s, wide-brimmed hat, shotgun across her knees) pokes the embers with a stick.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "TRAVELLING DOCTOR AMARA OKONKWO-WESTBROOK (40s, black bag, dusty skirt) writes in a leather book.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "The fire cracks.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You writing about me?", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "About the weather.", "name": "AMARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "No weather in that book.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "It's a long book.", "name": "AMARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Hester snorts.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Amara closes the cover, folds her hands.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Where you headed?", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "North. There's a fever in Redwater.", "name": "AMARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Redwater's dead.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Not all of it.", "name": "AMARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Not all, I'll grant you.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "How far is it?", "name": "AMARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Two days on foot. One on a horse.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "I've no horse.", "name": "AMARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "I have.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Is she for sale?", "name": "AMARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "She's not a she. She's a gelding. And no.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Rent, then.", "name": "AMARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "I've been waiting thirty years for someone to ask me that.", "name": "HESTER", "speaker": 0, "ext": [], "paren": ["to the fire"], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Is that a yes?", "name": "AMARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "It's a story.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Tell it.", "name": "AMARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "My husband had a horse. Same gelding's mother. He rode her to Redwater the winter of the sickness. Carried medicine.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "And?", "name": "AMARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "He didn't come back.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "I'm sorry.", "name": "AMARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Don't be. He was a fool. He said she'd carry him anywhere.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Did she?", "name": "AMARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "She came back. Alone. Saddle empty.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "She did her job.", "name": "AMARA", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Everybody does, eventually.", "name": "HESTER", "speaker": 0, "ext": [], "paren": ["to the fire"], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "She stirs the embers.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Sparks swirl into the black.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Hear that? She'll ride.", "name": "HESTER", "speaker": 0, "ext": ["CONT'D"], "paren": ["louder, to the dark"], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Who are you talking to?", "name": "AMARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "The horse. And the husband.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "Amara smiles in spite of herself.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "She reaches over, takes the stick, and pokes the fire herself.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Then let's sleep. We leave at dawn.", "name": "AMARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "We?", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "You're not letting a stranger ride your husband's horse alone.", "name": "AMARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "Hester looks at her.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "For the first time, she laughs.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Doctor, you're smarter than you look.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "I've been told.", "name": "AMARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "They settle back.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "The rails hum faintly in the cold.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "Far off, a whistle.", "para": 9, "sent": 2, "present": [0, 1]}]}