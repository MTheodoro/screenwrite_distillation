{"scene_id": "s00259", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00259.fountain", "heading": "EXT. FLOATING MARKET OF THE LANTERN SEA - DUSK", "cast": [{"id": 0, "name": "QUEEN-MOTHER OSHUN ADEBAYO-LUMINARA", "names": ["QUEEN-MOTHER OSHUN ADEBAYO-LUMINARA", "OSHUN"], "gender": "?", "first": 6, "spoke": 12}, {"id": 1, "name": "PRINCE TAMSIN LUMINARA-VOSS", "names": ["PRINCE TAMSIN LUMINARA-VOSS", "TAMSIN"], "gender": "?", "first": 7, "spoke": 3}, {"id": 2, "name": "NERISSA KALOMBO-AQUILA", "names": ["NERISSA KALOMBO-AQUILA", "NERISSA"], "gender": "f", "first": 8, "spoke": 5}, {"id": 3, "name": "BARNABAS", "names": ["BARNABAS"], "gender": "m", "first": 9, "spoke": 6}, {"id": 4, "name": "OYELOWO-SMYTHE", "names": ["OYELOWO-SMYTHE"], "gender": "?", "first": 9, "spoke": 0}, {"id": 5, "name": "PIPPA TRELAWNEY-ANAYA", "names": ["PIPPA TRELAWNEY-ANAYA", "PIPPA"], "gender": "f", "first": 10, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FLOATING MARKET OF THE LANTERN SEA - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "Hundreds of boats lashed together on a windless lagoon.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Paper lanterns hang from masts.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Traders call across the water in a tangle of tongues.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Drifting steam smells of spice and rain.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "At the heart of the market, on a barge strung with silver bells, five figures stand in a ring.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "QUEEN-MOTHER OSHUN ADEBAYO-LUMINARA (70s, sea-silk robe, crown of coral) holds a trident in one hand and a small carved box in the other.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Her son, PRINCE TAMSIN LUMINARA-VOSS (30s, silver armor, bloodshot eyes), stands stiffly at her right.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "The sorceress NERISSA KALOMBO-AQUILA (40s, indigo cloak, hair braided with shells) waits on her left.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "An old pirate captain, BARNABAS \"BLACK BARNEY\" OYELOWO-SMYTHE (60s, one eye, huge laugh), leans on a cutlass.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "And the ferryman's daughter, PIPPA TRELAWNEY-ANAYA (14, barefoot, bright), clings to a mast.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Friends. Neighbors. Traders of the Lantern Sea. I have called you here to end the feud.", "name": "OSHUN", "speaker": 0, "ext": [], "paren": ["into the crowd"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "Silence ripples across the boats.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "Bells chime softly.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Mother, this is unwise.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "It is overdue.", "name": "OSHUN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "It is a trap.", "name": "NERISSA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "It is a truce.", "name": "OSHUN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Truce! I love a truce. When do we eat?", "name": "BARNABAS", "speaker": 3, "ext": [], "paren": ["booming"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Captain Barney, hush.", "name": "PIPPA", "speaker": 5, "ext": [], "paren": ["whispering from the mast"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "I can't hush. I'm a pirate.", "name": "BARNABAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Barnabas. Your fleet will withdraw from the northern channel.", "name": "OSHUN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "My fleet will think about it.", "name": "BARNABAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Your fleet will withdraw.", "name": "OSHUN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Of course, Majesty.", "name": "BARNABAS", "speaker": 3, "ext": [], "paren": ["grinning"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "And the sorcerers' guild?", "name": "NERISSA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Will return the stolen tides.", "name": "OSHUN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "They were not stolen. They were borrowed.", "name": "NERISSA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "For three centuries.", "name": "OSHUN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "It was a long loan.", "name": "NERISSA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Mother, enough.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Silence, Tamsin.", "name": "OSHUN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "She opens the carved box.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Inside rests a pearl the size of a fist, dull and grey.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "This is the Heart of the Lagoon. It has been dying for forty years. Unless all of you swear on it, it dies tonight.", "name": "OSHUN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Gasps ripple.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Tamsin steps forward and seizes the box.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Barnabas draws his cutlass.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Nerissa raises a hand and the water around the barge begins to rise.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Pippa leaps from the mast and lands between them all.", "para": 9, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Stop it! All of you!", "name": "PIPPA", "speaker": 5, "ext": [], "paren": ["shouting"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "They freeze.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Cutlass.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Hand.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Hand on the box.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "The lanterns sway.", "para": 10, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "My father says a pearl dies when it stops being held.", "name": "PIPPA", "speaker": 5, "ext": ["CONT'D"], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "Child--", "name": "OSHUN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "So hold it. Together.", "name": "PIPPA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "A long moment.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "Then Tamsin lowers his hand.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Barnabas sheathes his cutlass.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "Nerissa lets the water fall.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "Oshun, tired, extends the box.", "para": 11, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "One by one, they each place a hand on the pearl.", "para": 11, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "The grey surface warms.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "A faint pulse of silver rises, then gold, then every color the lanterns carry.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "The crowd exhales.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "The boats begin to rock gently, as if the lagoon itself had sighed.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "Well, I'll be.", "name": "BARNABAS", "speaker": 3, "ext": [], "paren": ["under his breath"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "It has been a long time since it glowed.", "name": "NERISSA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "dialogue", "text": "Forgive me, Mother.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": ["to Oshun, softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "dialogue", "text": "There is nothing to forgive. Hold the light.", "name": "OSHUN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "dialogue", "text": "Can I go home now?", "name": "PIPPA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "dialogue", "text": "She wants to go home! The savior of the sea wants to go home!", "name": "BARNABAS", "speaker": 3, "ext": [], "paren": ["roaring with laughter"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "dialogue", "text": "Pippa Trelawney-Anaya, you may go anywhere you like.", "name": "OSHUN", "speaker": 0, "ext": [], "paren": ["smiling"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "action", "text": "Pippa grins, drops from the barge into a small skiff, and begins to row, the lanterns blooming on the water around her.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}