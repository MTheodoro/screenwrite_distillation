{"scene_id": "s00260", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00260.fountain", "heading": "INT. ABANDONED LIGHTHOUSE KEEPER'S QUARTERS - NIGHT", "cast": [{"id": 0, "name": "HARPER OSEI-LINDQVIST", "names": ["HARPER OSEI-LINDQVIST", "HARPER"], "gender": "?", "first": 7, "spoke": 8}, {"id": 1, "name": "JAZ", "names": ["JAZ"], "gender": "?", "first": 8, "spoke": 3}, {"id": 2, "name": "ABERNATHY-TRAN", "names": ["ABERNATHY-TRAN"], "gender": "?", "first": 8, "spoke": 0}, {"id": 3, "name": "KEZIAH ONYANGO-FALLOWS", "names": ["KEZIAH ONYANGO-FALLOWS", "KEZIAH"], "gender": "f", "first": 9, "spoke": 5}, {"id": 4, "name": "MATT", "names": ["MATT"], "gender": "?", "first": 10, "spoke": 6}, {"id": 5, "name": "KOWALSKI-BELLO", "names": ["KOWALSKI-BELLO"], "gender": "?", "first": 10, "spoke": 0}, {"id": 6, "name": "LOTTIE SUNDARAM-REEVES", "names": ["LOTTIE SUNDARAM-REEVES", "LOTTIE"], "gender": "f", "first": 11, "spoke": 6}, {"id": 7, "name": "KEEPER", "names": ["KEEPER"], "gender": "?", "first": 58, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED LIGHTHOUSE KEEPER'S QUARTERS - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A round room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Peeling wallpaper the color of old tea.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cast-iron stove.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A spiral stair winding up into darkness.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Salt crusts the windows.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "Five friends have made camp on the floor with sleeping bags and flashlights.", "para": 1, "sent": 0, "present": []}, {"u": 7, "kind": "action", "text": "HARPER OSEI-LINDQVIST (20s, canvas jacket, mug of instant coffee) sits cross-legged near the stove.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "JASPER \"JAZ\" ABERNATHY-TRAN (20s, knit cap, deck of cards) shuffles with a nervous flick.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "KEZIAH ONYANGO-FALLOWS (20s, vintage windbreaker, hair in a bandana) reads a tattered logbook by flashlight.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "MATEUSZ \"MATT\" KOWALSKI-BELLO (30s, flannel, camera tripod) adjusts a lens.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "And LOTTIE SUNDARAM-REEVES (20s, oversized sweater, pale), who hasn't spoken since they arrived, hugs her knees by the window.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "So the logbook. Read it again.", "name": "HARPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "\"October ninth. Fog thick as wool. The light turns but no ship answers. I hear footsteps on the stair, though I am alone.\"", "name": "KEZIAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "Spooky.", "name": "JAZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "\"October tenth. The footsteps again. This time they stop at my door.\"", "name": "KEZIAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "Cut it. We can't use this on camera.", "name": "MATT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "Why not?", "name": "JAZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "It's too good. We'll need to reshoot.", "name": "MATT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "It's a log, Matt. It's not a script.", "name": "HARPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "\"October eleventh. The door is open. I did not open it.\"", "name": "KEZIAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "action", "text": "A creak from the stair above.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "action", "text": "Everyone looks.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "Nothing.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "Only the dark.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "There's something on the stairs.", "name": "LOTTIE", "speaker": 6, "ext": [], "paren": ["very quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "There's nothing.", "name": "HARPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "There's something.", "name": "LOTTIE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "Where?", "name": "MATT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "The third landing.", "name": "LOTTIE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "Keziah clicks her flashlight toward the third landing.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "The beam finds a pale shape, slim and still, standing with its head tilted.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "action", "text": "A figure in a keeper's coat, face blurred as if seen through wet glass.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "Oh no.", "name": "KEZIAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "Don't move. Nobody move.", "name": "JAZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "Matt, are you filming?", "name": "HARPER", "speaker": 0, "ext": [], "paren": ["through her teeth"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "Yes.", "name": "MATT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "Keep filming.", "name": "HARPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "The figure takes one step down.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "The boards creak.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "Another.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "Jaz drops the cards; they scatter like white birds.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "Matt swings the camera.", "para": 9, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "Lottie rises, steps toward the stair, mesmerized.", "para": 9, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "dialogue", "text": "Lottie, don't.", "name": "KEZIAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "It wants to show me something.", "name": "LOTTIE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "dialogue", "text": "Lottie!", "name": "HARPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "She grabs Lottie's arm.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "Lottie turns, eyes glassy, smiling.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "dialogue", "text": "He's lonely.", "name": "LOTTIE", "speaker": 6, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "action", "text": "The figure reaches the second landing.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "action", "text": "The temperature drops.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "action", "text": "Their breath fogs.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "action", "text": "The stove flame bends sideways, then goes out.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "action", "text": "Darkness.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "action", "text": "Five flashlights jitter.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "action", "text": "Five beams find the keeper's coat, now at the bottom of the stair, its face almost clear.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "action", "text": "Almost human.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "dialogue", "text": "Stay.", "name": "KEEPER", "speaker": 7, "ext": [], "paren": ["a whisper, a wind"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 59, "kind": "action", "text": "Jaz screams.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 60, "kind": "action", "text": "Matt backs into the stove.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 61, "kind": "action", "text": "Keziah slams the logbook shut.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 62, "kind": "action", "text": "Harper wrenches Lottie back with both hands, and the five of them stumble toward the door.", "para": 13, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 63, "kind": "action", "text": "They crash through it, tumbling onto the wet grass outside.", "para": 13, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 64, "kind": "action", "text": "The sea roars.", "para": 13, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 65, "kind": "action", "text": "The lighthouse beam sweeps over them, steady, impossible, from a lamp that has been dead for forty years.", "para": 13, "sent": 6, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 66, "kind": "action", "text": "They stare up.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 67, "kind": "action", "text": "The beam swings away.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 68, "kind": "action", "text": "Lottie, panting, laughs weakly.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 69, "kind": "dialogue", "text": "Nobody believed me.", "name": "LOTTIE", "speaker": 6, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 70, "kind": "dialogue", "text": "I got it. I got all of it.", "name": "MATT", "speaker": 4, "ext": [], "paren": ["shaking"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 71, "kind": "dialogue", "text": "Delete it.", "name": "HARPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 72, "kind": "dialogue", "text": "What?", "name": "MATT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 73, "kind": "dialogue", "text": "Delete it. Please.", "name": "HARPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 74, "kind": "action", "text": "Matt looks at the camera.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 75, "kind": "action", "text": "At Harper.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 76, "kind": "action", "text": "At the lighthouse.", "para": 16, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 77, "kind": "action", "text": "He nods.", "para": 16, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 78, "kind": "action", "text": "Presses the button, and the light on the camera goes out.", "para": 16, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}