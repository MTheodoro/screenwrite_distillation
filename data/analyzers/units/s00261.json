{"scene_id": "s00261", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00261.fountain", "heading": "EXT. CROSSROADS SHRINE IN A PINE FOREST - TWILIGHT", "cast": [{"id": 0, "name": "ARTY", "names": ["ARTY"], "gender": "f", "first": 4, "spoke": 5}, {"id": 1, "name": "OKAFOR-LINDEN", "names": ["OKAFOR-LINDEN"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "BROTHER MALACHAI TREVELYAN-BOSE", "names": ["BROTHER MALACHAI TREVELYAN-BOSE", "MALACHAI"], "gender": "m", "first": 5, "spoke": 7}, {"id": 3, "name": "KESTREL AMANI-DUNBAR", "names": ["KESTREL AMANI-DUNBAR", "KESTREL"], "gender": "?", "first": 6, "spoke": 8}, {"id": 4, "name": "SIR OSWALD PEMBERTON-ADEYEMI", "names": ["SIR OSWALD PEMBERTON-ADEYEMI", "OSWALD"], "gender": "m", "first": 7, "spoke": 8}, {"id": 5, "name": "GIRL", "names": ["GIRL"], "gender": "?", "first": 33, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "EXT. CROSSROADS SHRINE IN A PINE FOREST - TWILIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A stone cairn at the meeting of four paths, crowned with offerings: ribbons, acorns, a child's wooden horse.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Mist threads between the pines.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Four travellers arrive from four directions and stop, each at the edge of the clearing.", "para": 1, "sent": 0, "present": []}, {"u": 4, "kind": "action", "text": "ARTEMISIA \"ARTY\" OKAFOR-LINDEN (30s, scout, hooded cloak, short bow) crouches beside the cairn and touches a ribbon.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "BROTHER MALACHAI TREVELYAN-BOSE (50s, cleric, bronze bell hung at his belt) removes his hat in the shrine's presence.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "KESTREL AMANI-DUNBAR (20s, thief, patched leathers, two daggers) leans on a pine, arms crossed, looking bored.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "And SIR OSWALD PEMBERTON-ADEYEMI (40s, knight, tarnished armor, a battered shield with a painted sun) stands with his sword point-down in the loam.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "Four roads, four travellers. I take it we all received the same summons.", "name": "OSWALD", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "A black feather on the doorstep.", "name": "ARTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Same.", "name": "KESTREL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "A feather in the offering plate.", "name": "MALACHAI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Mine was nailed to my gate.", "name": "OSWALD", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Dramatic.", "name": "KESTREL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Quite.", "name": "OSWALD", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "So who sent it?", "name": "ARTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Not who. What.", "name": "MALACHAI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Here we go.", "name": "KESTREL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "The shrine. The shrine called us.", "name": "MALACHAI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Shrines don't call. They sit.", "name": "KESTREL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "This one speaks, if one listens.", "name": "MALACHAI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Brother, let us listen, then.", "name": "OSWALD", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "A wind passes, bringing cold.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "The ribbons ripple.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Arty cocks her head.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Someone's coming.", "name": "ARTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Footsteps in the pines.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "The four draw weapons and turn together.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "A small girl steps out of the mist.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Perhaps nine.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Ragged coat, bare feet, a black feather braided in her hair.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "She carries a wooden bowl.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Hello.", "name": "GIRL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Child. Where is your family?", "name": "OSWALD", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "They're gone. I live here now.", "name": "GIRL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Alone?", "name": "KESTREL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "With the roads.", "name": "GIRL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Child, did you send these feathers?", "name": "MALACHAI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Four of you. That's the right number.", "name": "GIRL", "speaker": 5, "ext": [], "paren": ["nodding"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "For what?", "name": "ARTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "The girl sets down the bowl at the foot of the cairn.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "It is filled with dark water.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "To drink.", "name": "GIRL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Pass.", "name": "KESTREL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "It's a promise.", "name": "GIRL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "What kind of promise?", "name": "OSWALD", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "That you'll come back. After.", "name": "GIRL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "After what?", "name": "MALACHAI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "The girl smiles, very faintly.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "The mist thickens.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Behind the pines, something enormous exhales, and the ground trembles.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "Oswald.", "name": "ARTY", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "I feel it.", "name": "OSWALD", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "Oh, great.", "name": "KESTREL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "Child, what is out there?", "name": "MALACHAI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "That's what you're for.", "name": "GIRL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "The ground shudders again.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "Pinecones rattle down.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "Branches break.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "action", "text": "The four glance at one another.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "Then, one by one, they step to the bowl, dip their hands, and drink.", "para": 11, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "The water is cold as iron.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "Oswald coughs.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "Kestrel swears.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "Arty gasps and clutches her chest.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "action", "text": "Malachai rings his bell once, bright and clear.", "para": 12, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "action", "text": "Light blooms from the cairn.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "action", "text": "The mist retreats, trembling.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "dialogue", "text": "Thank you.", "name": "GIRL", "speaker": 5, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "dialogue", "text": "Child, what is your name?", "name": "OSWALD", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "dialogue", "text": "I don't have one yet.", "name": "GIRL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "action", "text": "She turns and walks into the pines.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "action", "text": "The four watch her go, then raise their weapons to the dark.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "dialogue", "text": "Should have taken the money.", "name": "KESTREL", "speaker": 3, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}