{"scene_id": "s00262", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00262.fountain", "heading": "EXT. ICE CAVE UNDER A COLLAPSING GLACIER - DAY", "cast": [{"id": 0, "name": "LEOCADIA MWANGI-HALVORSEN", "names": ["LEOCADIA MWANGI-HALVORSEN", "LEOCADIA"], "gender": "f", "first": 6, "spoke": 18}, {"id": 1, "name": "TOBIAS ADEGOKE-LINDGREN", "names": ["TOBIAS ADEGOKE-LINDGREN", "TOBIAS"], "gender": "f", "first": 8, "spoke": 17}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ICE CAVE UNDER A COLLAPSING GLACIER - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Blue walls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Meltwater running in thin silver threads across the floor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Overhead, the ice groans like a living thing.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Two climbers in torn gear crouch near the cave mouth.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "Their ropes lie in a coil between them, one end frayed.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "DR. LEOCADIA MWANGI-HALVORSEN (40s, glaciologist, split lip) tapes a gash in her thigh.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "She works fast, jaw clenched.", "para": 2, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "Across from her, her expedition partner TOBIAS ADEGOKE-LINDGREN (30s, mountaineer, frostbitten ears) tests the sharpness of an ice axe with his thumb.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Our rope won't hold another fall.", "name": "LEOCADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Then we don't fall.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Tobias.", "name": "LEOCADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Leocadia.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Eight hundred meters to the glacier terminus. Without a rope.", "name": "LEOCADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Seven fifty.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Does it matter?", "name": "LEOCADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "It matters to me.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Why?", "name": "LEOCADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Because it's less.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She laughs, then winces.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "He tosses her a chocolate bar.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She catches it one-handed.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "How many left?", "name": "LEOCADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Three.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Four, if we split yours.", "name": "LEOCADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I ate mine.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "You always eat yours.", "name": "LEOCADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "I have a metabolism.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "You have a problem.", "name": "LEOCADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "The ice groans louder.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "A trickle of water becomes a stream, curling around their boots.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Leo.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "I hear it.", "name": "LEOCADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "The glacier's moving.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "It's always moving.", "name": "LEOCADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Faster.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "She stands, wincing, and puts a hand against the wall.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "It hums.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "We go. Now.", "name": "LEOCADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Without gear?", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Without everything.", "name": "LEOCADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "They shoulder packs, scramble toward the cave mouth.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "The ceiling cracks, a long hairline racing across the blue.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "Tobias grabs her arm.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "She grabs his.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "They both look up as a slab the size of a truck shears loose.", "para": 7, "sent": 4, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "They dive.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "The slab lands where they stood, spraying frozen shards.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "Leocadia tumbles through the opening, Tobias behind, both rolling into the white glare of day.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "They lie on their backs, gasping.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "Behind them, the cave collapses, groaning, with a final thunderous sigh.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "Dust settles.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "Snow glitters.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "A distant raven calls.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "Seven fifty.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": ["laughing, breathless"], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "Seven hundred. We just walked fifty.", "name": "LEOCADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "We crawled fifty.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "Counts.", "name": "LEOCADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "They sit up.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "She offers him the chocolate.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "He shakes his head.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "She breaks it in half, hands him the bigger piece.", "para": 11, "sent": 3, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "Leo.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "Eat.", "name": "LEOCADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "He eats.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "She watches the sky.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "I'm tired.", "name": "LEOCADIA", "speaker": 0, "ext": ["CONT'D"], "paren": ["quietly"], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "I know.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "Don't say anything.", "name": "LEOCADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "I won't.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "They sit in the sun a long time.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "Neither speaks.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "The glacier moves under them like a slow breath.", "para": 13, "sent": 2, "present": [0, 1]}, {"u": 74, "kind": "action", "text": "Eventually she rises, offers him her good hand.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 75, "kind": "action", "text": "He takes it.", "para": 14, "sent": 1, "present": [0, 1]}, {"u": 76, "kind": "action", "text": "They start walking.", "para": 14, "sent": 2, "present": [0, 1]}]}