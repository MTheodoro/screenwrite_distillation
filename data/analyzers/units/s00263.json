{"scene_id": "s00263", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00263.fountain", "heading": "INT. COACHING INN STABLE LOFT, ENGLAND - NIGHT, 1788", "cast": [{"id": 0, "name": "LADY GEORGIANA ASHWORTH-OLUWOLE", "names": ["LADY GEORGIANA ASHWORTH-OLUWOLE", "GEORGIANA"], "gender": "?", "first": 7, "spoke": 16}, {"id": 1, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 9, "spoke": 9}, {"id": 2, "name": "MATTHIAS", "names": ["MATTHIAS"], "gender": "?", "first": 32, "spoke": 6}, {"id": 3, "name": "A VOICE", "names": ["A VOICE"], "gender": "?", "first": 40, "spoke": 1}, {"id": 4, "name": "SOLDIER", "names": ["SOLDIER"], "gender": "?", "first": 52, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. COACHING INN STABLE LOFT, ENGLAND - NIGHT, 1788", "present": []}, {"u": 1, "kind": "action", "text": "Hay.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Lantern light.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The smell of horse and rain.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A rope ladder to the yard below.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A cloaked figure crouches in the straw, back to the wall, pistol held in both hands.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "The ladder creaks.", "para": 2, "sent": 0, "present": []}, {"u": 7, "kind": "action", "text": "LADY GEORGIANA ASHWORTH-OLUWOLE (30s, riding habit torn at the hem, hair coming loose) climbs into the loft and freezes at the sight of the pistol.", "para": 3, "sent": 0, "present": [0]}, {"u": 8, "kind": "dialogue", "text": "Put that away, please.", "name": "GEORGIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 9, "kind": "dialogue", "text": "Stay where you are.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I have been riding for nine hours. I will sit.", "name": "GEORGIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She sits on a hay bale.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "The stranger does not lower the pistol.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Who sent you?", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Nobody. I own the horse in the third stall. I came to check on her.", "name": "GEORGIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Liar.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "I assure you, I am not.", "name": "GEORGIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "The stranger leans out of shadow.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "A man, late twenties, rain-soaked, hollow-eyed, in the coat of a courier.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "The horse in the third stall is mine.", "name": "STRANGER", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "It is a grey mare with a white sock?", "name": "GEORGIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "A brown gelding.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": ["beat"], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Then we are both mistaken.", "name": "GEORGIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She smiles, tilts her head, and the tension shifts, just slightly.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "He lowers the pistol an inch.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I am a courier. I carry letters for the Crown.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "How dull.", "name": "GEORGIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "You'd be surprised.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Show me one.", "name": "GEORGIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "No.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Then tell me your name, courier.", "name": "GEORGIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "He hesitates, searching her face for a lie.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Matthias.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Matthias what?", "name": "GEORGIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Just Matthias.", "name": "MATTHIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Then call me Georgiana. Just Georgiana.", "name": "GEORGIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "The ladder creaks again.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Both turn.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Boots on the rungs.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Torchlight on the beams.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Search the loft!", "name": "A VOICE", "speaker": 3, "ext": ["O.S."], "paren": ["from below"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Matthias grabs her arm.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "She grabs his wrist.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "They freeze, nose to nose, as torchlight crawls along the straw.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "They've come for me.", "name": "MATTHIAS", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Then they shall have us both.", "name": "GEORGIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Why?", "name": "MATTHIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Because I'm tired of being polite.", "name": "GEORGIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "She yanks him down into the hay.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Pulls her cloak over them both.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Torchlight sweeps over the rafters.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "A soldier's head appears at the top of the ladder, squinting.", "para": 10, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Nothing here.", "name": "SOLDIER", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "Only straw and horse-dung!", "name": "SOLDIER", "speaker": 4, "ext": ["CONT'D"], "paren": ["calling"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "The head vanishes.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Boots descend.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Silence returns.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "Matthias and Georgiana lie breathless beneath the cloak.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "You're heavier than you look.", "name": "GEORGIANA", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "You're braver than you look.", "name": "MATTHIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "We are both liars.", "name": "GEORGIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "Obviously.", "name": "MATTHIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "They begin, helplessly, to laugh.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "Then to shake.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "Then, finally, to lie very still, listening to the rain on the slates.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "Matthias slides the pistol into his belt.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "dialogue", "text": "I owe you.", "name": "MATTHIAS", "speaker": 2, "ext": ["CONT'D"], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "dialogue", "text": "I'll collect.", "name": "GEORGIANA", "speaker": 0, "ext": [], "paren": ["to him"], "dual": false, "present": [0, 1, 2, 3, 4]}]}