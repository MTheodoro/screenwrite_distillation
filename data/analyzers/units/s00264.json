{"scene_id": "s00264", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00264.fountain", "heading": "INT. PARKED CAR, PARKING GARAGE LEVEL P3 - NIGHT", "cast": [{"id": 0, "name": "DETECTIVE CASSIUS ONWUDIWE-HARLOW", "names": ["DETECTIVE CASSIUS ONWUDIWE-HARLOW", "CASSIUS"], "gender": "?", "first": 4, "spoke": 12}, {"id": 1, "name": "DISPATCH", "names": ["DISPATCH"], "gender": "?", "first": 14, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. PARKED CAR, PARKING GARAGE LEVEL P3 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Concrete.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sodium light.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A car idling, engine just above a whisper.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DETECTIVE CASSIUS ONWUDIWE-HARLOW (50s, stained trench, thermos in the cupholder) sits behind the wheel.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Alone.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "He watches an elevator door.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "It does not open.", "para": 2, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "He turns off the engine.", "para": 3, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Silence.", "para": 3, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "A drip somewhere.", "para": 3, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "He picks up a cell phone.", "para": 4, "sent": 0, "present": [0]}, {"u": 12, "kind": "action", "text": "Dials.", "para": 4, "sent": 1, "present": [0]}, {"u": 13, "kind": "action", "text": "Puts it to his ear.", "para": 4, "sent": 2, "present": [0]}, {"u": 14, "kind": "dialogue", "text": "Dispatch.", "name": "DISPATCH", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Cassius Harlow. Badge two-one-four. I'm on P3 at the Meridian.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Copy, Detective. Status?", "name": "DISPATCH", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Stakeout. Nothing yet.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Need backup?", "name": "DISPATCH", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "No.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Detective, it's two a.m.", "name": "DISPATCH", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "I know what time it is.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "You've been there six hours.", "name": "DISPATCH", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Seven.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "He sets the phone on the dash.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Opens the thermos.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Pours coffee into the cap.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Sips.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Winces.", "para": 5, "sent": 4, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Cold.", "name": "CASSIUS", "speaker": 0, "ext": ["CONT'D"], "paren": ["to himself"], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "He watches the elevator again.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "A light above the door blinks: 3.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Then dims.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Come on. Come on, you son of a--", "name": "CASSIUS", "speaker": 0, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "The elevator dings.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "The door slides open.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Empty.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "He sits very still.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Then slowly lets out a breath.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Closes his eyes.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Not tonight.", "name": "CASSIUS", "speaker": 0, "ext": ["CONT'D"], "paren": ["to himself"], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "The phone buzzes on the dash.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "He picks it up.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Detective, the subject has been detained at the airport. You're clear to stand down.", "name": "DISPATCH", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Airport.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "He never came to the Meridian.", "name": "DISPATCH", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Of course he didn't.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "Go home, Cassius.", "name": "DISPATCH", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Copy.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "He ends the call.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "Puts the thermos back in the cupholder.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "Starts the engine.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Seven hours.", "name": "CASSIUS", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the rearview"], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "He backs out slowly.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "The elevator door slides shut behind him on its own.", "para": 11, "sent": 1, "present": [0, 1]}]}