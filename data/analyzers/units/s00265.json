{"scene_id": "s00265", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00265.fountain", "heading": "EXT. SUNKEN GARDEN BENEATH A FALLEN STARSHIP - NIGHT", "cast": [{"id": 0, "name": "IRENEUS BASKERVILLE-ADE", "names": ["IRENEUS BASKERVILLE-ADE", "IRENEUS"], "gender": "m", "first": 4, "spoke": 6}, {"id": 1, "name": "MYRT", "names": ["MYRT"], "gender": "f", "first": 5, "spoke": 5}, {"id": 2, "name": "OKONKWO-SPARROW", "names": ["OKONKWO-SPARROW"], "gender": "?", "first": 5, "spoke": 0}, {"id": 3, "name": "HOLGER STAVROS-NWACHUKWU", "names": ["HOLGER STAVROS-NWACHUKWU", "HOLGER"], "gender": "?", "first": 6, "spoke": 9}, {"id": 4, "name": "THEO", "names": ["THEO"], "gender": "f", "first": 7, "spoke": 5}, {"id": 5, "name": "LAVENDER-OSEI", "names": ["LAVENDER-OSEI"], "gender": "?", "first": 7, "spoke": 0}, {"id": 6, "name": "GRANDMAMA NKECHI WINTERBOURNE", "names": ["GRANDMAMA NKECHI WINTERBOURNE", "GRANDMAMA"], "gender": "?", "first": 8, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SUNKEN GARDEN BENEATH A FALLEN STARSHIP - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A hull the size of a cathedral lies crumpled across a valley.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Under its arch, moss and glowing mushrooms have colonized a courtyard of broken tile.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Five figures circle a fire in the courtyard center.", "para": 1, "sent": 0, "present": []}, {"u": 4, "kind": "action", "text": "IRENEUS BASKERVILLE-ADE (50s, wizard, coat of many pockets) feeds twigs to the flames.", "para": 2, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "MYRTLE \"MYRT\" OKONKWO-SPARROW (20s, bard, lute on her back) tunes a string.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "HOLGER STAVROS-NWACHUKWU (30s, mercenary, scarred jaw) sharpens a long blade on a whetstone.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "THEODORA \"THEO\" LAVENDER-OSEI (teens, apprentice, ink on her chin) copies glyphs from the hull onto a scroll.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "action", "text": "And GRANDMAMA NKECHI WINTERBOURNE (80s, wrapped in quilts, eyes sharp as tacks) sits on a stool nearest the fire.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 9, "kind": "dialogue", "text": "We rest here till dawn.", "name": "IRENEUS", "speaker": 0, "ext": [], "paren": ["to the group"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "dialogue", "text": "Rest? With that thing over us?", "name": "HOLGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "It's a ship, Holger. It's dead.", "name": "IRENEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "So were the last three things I fought.", "name": "HOLGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "Holger, relax. Listen to this.", "name": "MYRT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "action", "text": "She plucks a gentle melody.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "action", "text": "The mushrooms pulse, brightening in time.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "action", "text": "Theo looks up from her scroll, startled.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "Oh. They like it.", "name": "THEO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "Everything likes it.", "name": "MYRT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "Not me.", "name": "HOLGER", "speaker": 3, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "You like it, boy. You just won't say.", "name": "GRANDMAMA", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "Grandmama--", "name": "HOLGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Hush.", "name": "GRANDMAMA", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "The fire cracks.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "Ireneus rises, brushing his coat.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "Theo, the glyphs. What do they say?", "name": "IRENEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "Um. \"Do not wake the garden.\"", "name": "THEO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "A long silence.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "The music stops.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "Myrt's hand freezes on the strings.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "Theo.", "name": "MYRT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "Sorry. I only just read it.", "name": "THEO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "Everyone quiet.", "name": "HOLGER", "speaker": 3, "ext": [], "paren": ["rising, blade drawn"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "Holger, put that away.", "name": "IRENEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "No.", "name": "HOLGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "Beneath them, the ground trembles.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "The mushrooms flare white, then red.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "A distant hum rises through the soil like a stirring giant.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "dialogue", "text": "Ireneus.", "name": "MYRT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "I know.", "name": "IRENEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "Well. That's the trouble with gardens.", "name": "GRANDMAMA", "speaker": 6, "ext": [], "paren": ["mildly, to the fire"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "The hull groans.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "Vines uncoil from the ceiling, thick as cables, and begin to descend.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "Holger swings at one.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "It splits, spills glowing sap, and lunges for his throat.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "Theo, run!", "name": "HOLGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "dialogue", "text": "Where?", "name": "THEO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "dialogue", "text": "Anywhere!", "name": "HOLGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "Myrt strikes a chord, wild, dissonant.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "action", "text": "The vines recoil.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "action", "text": "Ireneus hurls a handful of powder; it ignites in a flash of orange.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "action", "text": "Theo hauls Grandmama up by the elbow and they stumble toward the arch.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "dialogue", "text": "Don't look back!", "name": "IRENEUS", "speaker": 0, "ext": [], "paren": ["over the roar"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "dialogue", "text": "I am looking!", "name": "MYRT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "dialogue", "text": "Then look faster!", "name": "HOLGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "action", "text": "A vine catches Holger's ankle.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "action", "text": "He topples.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "action", "text": "Myrt dives, slashes with her lute-strap.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "action", "text": "It parts.", "para": 13, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 59, "kind": "action", "text": "Together they scramble to their feet.", "para": 13, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 60, "kind": "action", "text": "The five reach the arch just as the entire garden convulses, erupting into a roar of green light.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 61, "kind": "action", "text": "They tumble onto cold grass beyond.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 62, "kind": "action", "text": "Behind them, the starship shudders, then lies still.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 63, "kind": "dialogue", "text": "Hm.", "name": "GRANDMAMA", "speaker": 6, "ext": [], "paren": ["breathing hard"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 64, "kind": "dialogue", "text": "Grandmama?", "name": "THEO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 65, "kind": "dialogue", "text": "I'd like to go home now.", "name": "GRANDMAMA", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}