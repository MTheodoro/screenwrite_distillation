{"scene_id": "s00266", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00266.fountain", "heading": "INT. DERELICT ORPHANAGE, WEST WING DORMITORY - NIGHT", "cast": [{"id": 0, "name": "EUGENIA FALLOWFIELD-ADEYEMI", "names": ["EUGENIA FALLOWFIELD-ADEYEMI", "EUGENIA"], "gender": "f", "first": 6, "spoke": 15}, {"id": 1, "name": "NOAH", "names": ["NOAH"], "gender": "?", "first": 7, "spoke": 6}, {"id": 2, "name": "OKWUOSA-BERGMAN", "names": ["OKWUOSA-BERGMAN"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "LENA TAKAHASHI-DUMONT", "names": ["LENA TAKAHASHI-DUMONT", "LENA"], "gender": "?", "first": 8, "spoke": 8}, {"id": 4, "name": "CHILD", "names": ["CHILD"], "gender": "?", "first": 19, "spoke": 4}, {"id": 5, "name": "WREN", "names": ["WREN"], "gender": "?", "first": 27, "spoke": 5}, {"id": 6, "name": "TAPE", "names": ["TAPE"], "gender": "?", "first": 88, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. DERELICT ORPHANAGE, WEST WING DORMITORY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Iron beds in rows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Mildewed mattresses.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A rocking horse with one glass eye.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Moonlight through a shattered window.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Three paranormal investigators move in a tight triangle, flashlights jittering.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "DR. EUGENIA FALLOWFIELD-ADEYEMI (50s, parapsychologist, wool coat, an old tape recorder in her hand) leads.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "NOAH \"NO\" OKWUOSA-BERGMAN (20s, camera operator, headlamp) films over her shoulder.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "LENA TAKAHASHI-DUMONT (30s, sound engineer, headphones, boom mic) sweeps the room with a long pole.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Quiet, please. I want a clean recording.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": ["to the group"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Copy.", "name": "NOAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Copy.", "name": "LENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "They freeze.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "The tape recorder whirs.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "A long beat.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "The wind moves through the dormitory like breath.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Is anyone here?", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": ["into the recorder"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Then, faintly, from the far end:", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Yes.", "name": "CHILD", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "All three jump.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Lena stumbles into the rocking horse; it sways, creaking.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Noah's camera light lurches.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Did you hear that?", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Yes.", "name": "LENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "I got it.", "name": "NOAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "What is your name?", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": ["into the recorder"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Wren.", "name": "CHILD", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Hello, Wren. How old are you?", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Nine.", "name": "CHILD", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Do you live here?", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "We all do.", "name": "CHILD", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "The temperature drops.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Their breath fogs.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Okay. Okay. This is fine.", "name": "LENA", "speaker": 3, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "It's very fine.", "name": "NOAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "It's extremely fine.", "name": "LENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Wren, can you show us where you are?", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "A pause.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Then, down the dormitory aisle, a lantern flickers into being.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Under it stands a small figure in a gray nightshirt, hands clasped, face pale and ordinary.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Oh my god.", "name": "NOAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Hello, Wren.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": ["steady"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "Hello.", "name": "WREN", "speaker": 5, "ext": [], "paren": ["smiling"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "She tilts her head.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Behind her, the iron beds begin to rattle, one by one.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Eugenia.", "name": "LENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "I see them.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "They're excited.", "name": "WREN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "Why?", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "You're the first visitors.", "name": "WREN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Eugenia opens her mouth.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "Closes it.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "Please tell me we're leaving.", "name": "NOAH", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "Not yet.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "Eugenia!", "name": "LENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "Not yet. Wren, who is the one at the back?", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "Beyond Wren, in the darkness, a tall shape unfolds from the last bed.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "A woman in a nurse's uniform, face hidden in shadow.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "That's Matron.", "name": "WREN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "Matron.", "name": "LENA", "speaker": 3, "ext": [], "paren": ["very quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "dialogue", "text": "She's not very nice.", "name": "WREN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "The nurse steps forward.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "A single stride, and the whole room tilts.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "The beds slide.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "The glass in the window sings.", "para": 13, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "action", "text": "Lena shrieks and drops the mic.", "para": 13, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "action", "text": "Noah's camera light flares and goes out.", "para": 13, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "action", "text": "Eugenia stumbles against an iron frame.", "para": 13, "sent": 6, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "dialogue", "text": "Out! Everyone, out!", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": ["shouting"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "action", "text": "They run.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "action", "text": "The dormitory stretches around them, doors multiplying, corridors lengthening.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "action", "text": "Lena sobs.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "action", "text": "Noah curses.", "para": 14, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "action", "text": "Eugenia, hand on the wall, counts doors under her breath.", "para": 14, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 75, "kind": "dialogue", "text": "Seven. Eight. Nine. Here!", "name": "EUGENIA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 76, "kind": "action", "text": "She slams through a door.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 77, "kind": "action", "text": "They tumble into the courtyard, grass and moonlight, cold clean air.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 78, "kind": "action", "text": "They lie gasping.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 79, "kind": "action", "text": "The orphanage looms behind them, windows dark.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 80, "kind": "dialogue", "text": "Never again.", "name": "LENA", "speaker": 3, "ext": [], "paren": ["weeping"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 81, "kind": "dialogue", "text": "I lost the camera.", "name": "NOAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 82, "kind": "dialogue", "text": "No. You have the tape.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 83, "kind": "action", "text": "She holds up the recorder, its light still green.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 84, "kind": "action", "text": "She presses play.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 85, "kind": "action", "text": "Her own voice: \"Is anyone here?\"", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 86, "kind": "action", "text": "A pause.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 87, "kind": "action", "text": "Then a small voice, unmistakable:", "para": 18, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 88, "kind": "dialogue", "text": "Come back.", "name": "TAPE", "speaker": 6, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 89, "kind": "action", "text": "They stare at the recorder.", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 90, "kind": "action", "text": "Slowly, without a word, Lena takes it, crouches, and buries it in the dirt.", "para": 19, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}]}