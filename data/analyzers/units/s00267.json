{"scene_id": "s00267", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00267.fountain", "heading": "INT. BAGGAGE CLAIM, MIDNIGHT TERMINAL - NIGHT", "cast": [{"id": 0, "name": "SABRINA OLUWAFEMI-STRAND", "names": ["SABRINA OLUWAFEMI-STRAND", "SABRINA"], "gender": "f", "first": 4, "spoke": 10}, {"id": 1, "name": "VIC", "names": ["VIC"], "gender": "?", "first": 5, "spoke": 9}, {"id": 2, "name": "ANANDARAJAH-KELLER", "names": ["ANANDARAJAH-KELLER"], "gender": "?", "first": 5, "spoke": 0}, {"id": 3, "name": "INSPECTOR MIRA TOLENTINO-ACHEBE", "names": ["INSPECTOR MIRA TOLENTINO-ACHEBE", "MIRA"], "gender": "?", "first": 6, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. BAGGAGE CLAIM, MIDNIGHT TERMINAL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A carousel loops empty.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Flickering departures board.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The cleaners have gone home.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SABRINA OLUWAFEMI-STRAND (30s, courier, hard-shell case handcuffed to her wrist) waits at belt six.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside her, a tall man holds a paper cup: VICTOR \"VIC\" ANANDARAJAH-KELLER (40s, airport security, lanyard, deadpan).", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "At the end of the belt, a third figure examines the departures board: INSPECTOR MIRA TOLENTINO-ACHEBE (50s, plainclothes, press badge folded in her palm).", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Ma'am, you've been here three hours.", "name": "VIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "My bag is delayed.", "name": "SABRINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Which bag?", "name": "VIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "The blue one.", "name": "SABRINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "You don't have a blue one.", "name": "VIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "I'd like to speak to your supervisor.", "name": "SABRINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "I am my supervisor.", "name": "VIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Then I'd like another one.", "name": "SABRINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Miss Oluwafemi-Strand.", "name": "MIRA", "speaker": 3, "ext": [], "paren": ["without turning"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Do I know you?", "name": "SABRINA", "speaker": 0, "ext": [], "paren": ["freezing"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Not yet. But I know the case on your wrist.", "name": "MIRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Sabrina's hand tightens on the handle.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "It's personal.", "name": "SABRINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "It's evidence.", "name": "MIRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Evidence of what?", "name": "VIC", "speaker": 1, "ext": [], "paren": ["to Mira"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Of a very bad weekend.", "name": "MIRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Sabrina whips the case up and swings it at Vic's head.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "He ducks.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "It clips Mira's shoulder.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Mira stumbles back; Sabrina bolts for the exit, dragging the case on its chain.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Stop!", "name": "VIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Let her run.", "name": "MIRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Inspector?", "name": "VIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Sabrina! The carousel's about to start!", "name": "MIRA", "speaker": 3, "ext": [], "paren": ["calling"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Sabrina stops, turns.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "The belt shudders and begins to turn, empty.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "She looks at it, then at them.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "What's that supposed to mean?", "name": "SABRINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "It means turn it over.", "name": "MIRA", "speaker": 3, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "It means she's cornered.", "name": "VIC", "speaker": 1, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "^", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Sabrina stares.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "The case drops open on its chain, spilling nothing.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "A few sheets of paper flutter to the floor.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Oh.", "name": "SABRINA", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Yes.", "name": "MIRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "It's empty.", "name": "SABRINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "It was always empty.", "name": "MIRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Sabrina laughs, short and hollow.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Slowly she sinks to the floor beside the belt.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Vic takes off his lanyard and sets it beside her.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Tea?", "name": "VIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Please.", "name": "SABRINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}