{"scene_id": "s00268", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00268.fountain", "heading": "INT. LUNAR RELAY STATION \"KESTREL-4,\" COMMAND DECK - SHIP NIGHT", "cast": [{"id": 0, "name": "STATION CHIEF AMINATA VOSKUIJLEN-OSEI", "names": ["STATION CHIEF AMINATA VOSKUIJLEN-OSEI", "AMINATA"], "gender": "?", "first": 3, "spoke": 21}, {"id": 1, "name": "DAV", "names": ["DAV"], "gender": "?", "first": 4, "spoke": 21}, {"id": 2, "name": "LINDQVIST-KAMARA", "names": ["LINDQVIST-KAMARA"], "gender": "?", "first": 4, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. LUNAR RELAY STATION \"KESTREL-4,\" COMMAND DECK - SHIP NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped dome of monitors and cables.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A slice of Earth hangs in the viewport, blue and fragile.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "STATION CHIEF AMINATA VOSKUIJLEN-OSEI (40s, grey coverall, tied-back hair) sits at the primary console, headset on one ear.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "Beside her, systems tech DAVID \"DAV\" LINDQVIST-KAMARA (30s, T-shirt, bare feet on the deck) eats a protein bar.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "Telemetry's drifting.", "name": "AMINATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "It's always drifting.", "name": "DAV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Not by this much.", "name": "AMINATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Let me see.", "name": "DAV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "He swivels to her screen, bar in his mouth.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Reads.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Swallows.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Huh.", "name": "DAV", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Huh?", "name": "AMINATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "That's not drift.", "name": "DAV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "What is it?", "name": "AMINATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Something is pinging us.", "name": "DAV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "From where?", "name": "AMINATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Everywhere.", "name": "DAV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "A soft tone sounds.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Both look at the console.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "A line of green text scrolls past.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "\"Greetings, Kestrel-Four.\"", "name": "AMINATA", "speaker": 0, "ext": [], "paren": ["reading"], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "That's--", "name": "DAV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "It's coming from our own transmitter.", "name": "AMINATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "It's a loopback!", "name": "DAV", "speaker": 1, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "It's not a loopback!", "name": "AMINATA", "speaker": 0, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "^", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "They stare at each other.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "The text continues.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "\"We have waited.\"", "name": "DAV", "speaker": 1, "ext": [], "paren": ["reading"], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Who's \"we\"?", "name": "AMINATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Aminata, I'm going to need a minute.", "name": "DAV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Take two.", "name": "AMINATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "He stands, pacing.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Then stops, hands on his hips.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Okay. Hypothesis. Either it's a prank by the Mars crew--", "name": "DAV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "They're asleep.", "name": "AMINATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "--or it's a prank by the ground crew--", "name": "DAV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "They're in a meeting.", "name": "AMINATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "--or it's us.", "name": "DAV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Us?", "name": "AMINATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "We're hallucinating. Oxygen's low.", "name": "DAV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "She taps a gauge.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "It reads perfect.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Oxygen's fine.", "name": "AMINATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Damn.", "name": "DAV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Another tone.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "The text changes.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "\"Please do not be afraid.\"", "name": "AMINATA", "speaker": 0, "ext": [], "paren": ["reading"], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "I'm afraid.", "name": "DAV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Me too.", "name": "AMINATA", "speaker": 0, "ext": [], "paren": ["dry"], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "She types: WHO ARE YOU.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "The cursor blinks.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Then the reply:", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "\"A friend.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Look up.\"", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "They look up.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Through the viewport, high above the lunar horizon, a ring of pale lights forms, silent, orderly, expanding.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "Chief.", "name": "DAV", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "I see it.", "name": "AMINATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Should we call Houston?", "name": "DAV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "We should wake the Mars crew.", "name": "AMINATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "Both.", "name": "DAV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "Both.", "name": "AMINATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "Neither moves.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "The lights grow.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "In the viewport the Earth looks smaller than before.", "para": 13, "sent": 2, "present": [0, 1, 2]}, {"u": 68, "kind": "dialogue", "text": "Aminata?", "name": "DAV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 69, "kind": "dialogue", "text": "Yes?", "name": "AMINATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 70, "kind": "dialogue", "text": "I never finished my protein bar.", "name": "DAV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 71, "kind": "action", "text": "She almost smiles.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 72, "kind": "action", "text": "Reaches over and takes it from his hand.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 73, "kind": "action", "text": "Takes a bite.", "para": 14, "sent": 2, "present": [0, 1, 2]}, {"u": 74, "kind": "dialogue", "text": "Neither did I.", "name": "AMINATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 75, "kind": "action", "text": "She chews, slowly.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 76, "kind": "action", "text": "They watch the sky.", "para": 15, "sent": 1, "present": [0, 1, 2]}]}