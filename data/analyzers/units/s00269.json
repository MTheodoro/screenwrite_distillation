{"scene_id": "s00269", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00269.fountain", "heading": "INT. FREIGHT ELEVATOR, SHUTTERED TEXTILE MILL - NIGHT", "cast": [{"id": 0, "name": "MAN", "names": ["MAN"], "gender": "?", "first": 5, "spoke": 8}, {"id": 1, "name": "LEATHER JACKET", "names": ["LEATHER JACKET"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "WOMAN", "names": ["WOMAN"], "gender": "f", "first": 9, "spoke": 10}, {"id": 3, "name": "STEFAN", "names": ["STEFAN"], "gender": "?", "first": 51, "spoke": 5}, {"id": 4, "name": "NAOMI", "names": ["NAOMI"], "gender": "?", "first": 55, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. FREIGHT ELEVATOR, SHUTTERED TEXTILE MILL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A steel cage the size of a small room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dim bulb.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A brass gate.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Dust.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A MAN IN A LEATHER JACKET (40s, scar through his lip) leans against the back wall.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "A smoking pistol hangs loose in his fist.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "The gate rattles.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "A hand grips it from outside.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "A WOMAN (30s, long coat, blood on her cuff) slides in, pulls the gate shut, and presses the lever.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "The elevator lurches down.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "They face each other.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Silence, except for the cables.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "You're late.", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "You're early.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "I was told midnight.", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Midnight was the plan.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "She looks at his pistol.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "He tucks it slowly into his waistband.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Where's the third?", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Dead.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "How?", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Quickly.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "The cable groans.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The bulb flickers.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "She steps close and he flinches, then stills.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "She reaches into his jacket, withdraws a leather folio, flips it open.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "A set of blueprints.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "A passport.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "A photograph.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Matteo Ferrante.", "name": "WOMAN", "speaker": 2, "ext": ["CONT'D"], "paren": ["reading"], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "That's me.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "It isn't.", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "It is tonight.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Tell me your real name.", "name": "WOMAN", "speaker": 2, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Why?", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "So I know whom to shoot.", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "He grins, tilts his head.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "The elevator thumps to a halt between floors.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "The lights die.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Total dark.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "In the dark, a scuffle.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "A thud.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "A gasp.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "A pistol clatters on the floor.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Someone lunges, someone slams a wall, a body falls against the gate and it rattles open.", "para": 9, "sent": 4, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "The bulb sputters back to life.", "para": 9, "sent": 5, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "The woman has the man pinned against the cage, forearm across his throat.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "His hands are on her wrists.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Both breathing hard.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "The pistol lies between their feet.", "para": 10, "sent": 3, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Stefan.", "name": "MAN", "speaker": 0, "ext": ["CONT'D"], "paren": ["strained"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Stefan what?", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Stefan Halloran.", "name": "STEFAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "My brother.", "name": "WOMAN", "speaker": 2, "ext": [], "paren": ["releasing him"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Naomi.", "name": "STEFAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "You're alive.", "name": "NAOMI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "Barely.", "name": "STEFAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "She slaps him, hard.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "Then hugs him, fiercer than a boxer.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "Twelve years.", "name": "NAOMI", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "Eleven and a half.", "name": "STEFAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "dialogue", "text": "I'm still going to kill you.", "name": "NAOMI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "dialogue", "text": "Do it after we get out.", "name": "STEFAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "The elevator groans.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "Starts to move again, down, into the dark.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}]}