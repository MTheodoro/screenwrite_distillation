{"scene_id": "s00271", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00271.fountain", "heading": "INT. SALT MINE ELEVATOR HOIST HOUSE - DAY", "cast": [{"id": 0, "name": "GUS", "names": ["GUS"], "gender": "f", "first": 5, "spoke": 14}, {"id": 1, "name": "TREVINO", "names": ["TREVINO"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "LUCKY", "names": ["LUCKY"], "gender": "?", "first": 8, "spoke": 8}, {"id": 3, "name": "MARROW", "names": ["MARROW"], "gender": "?", "first": 8, "spoke": 0}, {"id": 4, "name": "DEPUTY WENDELL OKORO", "names": ["DEPUTY WENDELL OKORO", "WENDELL"], "gender": "m", "first": 11, "spoke": 6}, {"id": 5, "name": "REVEREND ISAIAH CALLOWAY-BRANT", "names": ["REVEREND ISAIAH CALLOWAY-BRANT", "CALLOWAY-BRANT"], "gender": "?", "first": 50, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. SALT MINE ELEVATOR HOIST HOUSE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Brine-crusted timbers.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A cable drum.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "One lantern.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Wind through the slats.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SHERIFF AUGUSTINE \"GUS\" TREVINO (50s, gray mustache, bad knee) sits on an upturned crate.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Rifle across his lap.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Waiting.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Across from him, hands tied to the cable rail: LUCINDA \"LUCKY\" MARROW (30s, sun-cracked lips, torn duster).", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Smiling.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Always smiling.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Behind her, in the doorway: DEPUTY WENDELL OKORO (20s, borrowed hat, pale).", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Counting something on his fingers.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Gus checks his watch.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Puts it away.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Noon. Should be noon.", "name": "GUS", "speaker": 0, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Time moves slow in a salt mine.", "name": "LUCKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Didn't ask you.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "A drip somewhere.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "The cable drum creaks.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Sheriff. The train's late.", "name": "WENDELL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "I can hear that.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Wendell shifts his weight.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "The floorboards complain.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Your boy's nervous.", "name": "LUCKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "My boy's fine.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "I'm fine.", "name": "WENDELL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "He isn't.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "His hand rests on his holster.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Slides off.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Rests again.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Gus rises.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Knee pops.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "He walks to the slat window.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Looks out at white flats and nothing.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Nobody moves till the whistle.", "name": "GUS", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Yes sir.", "name": "WENDELL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Hear that? Nobody moves.", "name": "LUCKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "She tugs the rope.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Testing.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Gus turns.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Quit that.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Quit what?", "name": "LUCKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "You know what.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "She lets the rope go slack.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Smile widens.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "A fourth figure fills the doorway behind Wendell.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Quiet.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Boots on salt.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "REVEREND ISAIAH CALLOWAY-BRANT (60s, black frock, spectacles, a Bible under one arm).", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Dust on his shoulders.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "He tips his hat.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "Gentlemen. Lady.", "name": "CALLOWAY-BRANT", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "Wendell spins.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "Hand on the gun this time.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "Who in hell are you?", "name": "WENDELL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "A man looking for water.", "name": "CALLOWAY-BRANT", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "dialogue", "text": "No water here. Only salt.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "So I see.", "name": "CALLOWAY-BRANT", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "action", "text": "He steps in.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "Slow.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "Eyes drifting to Lucky.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "To the rope.", "para": 14, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "To the rifle.", "para": 14, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "dialogue", "text": "Morning, Reverend.", "name": "LUCKY", "speaker": 2, "ext": [], "paren": ["to Calloway-Brant"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "action", "text": "Gus looks at her.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "action", "text": "Looks at the preacher.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "dialogue", "text": "You two acquainted?", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "dialogue", "text": "No.", "name": "CALLOWAY-BRANT", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "dialogue", "text": "Never met.", "name": "LUCKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "action", "text": "Too fast.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "action", "text": "Both.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "action", "text": "Gus raises the rifle.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "action", "text": "Not at anyone.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 75, "kind": "action", "text": "Just up.", "para": 17, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 76, "kind": "dialogue", "text": "Damn.", "name": "GUS", "speaker": 0, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 77, "kind": "action", "text": "A distant whistle.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 78, "kind": "action", "text": "Long.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 79, "kind": "action", "text": "Low.", "para": 18, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 80, "kind": "dialogue", "text": "That's the train.", "name": "WENDELL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 81, "kind": "dialogue", "text": "Everybody stay put.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 82, "kind": "action", "text": "Calloway-Brant sets the Bible on the crate.", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 83, "kind": "action", "text": "Unhurried.", "para": 19, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 84, "kind": "dialogue", "text": "Sheriff, I'd sit down.", "name": "CALLOWAY-BRANT", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 85, "kind": "dialogue", "text": "I'll stand.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 86, "kind": "dialogue", "text": "Then stand well.", "name": "CALLOWAY-BRANT", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 87, "kind": "action", "text": "He opens the Bible.", "para": 20, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 88, "kind": "action", "text": "Hollowed out.", "para": 20, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 89, "kind": "action", "text": "A short-barreled pistol.", "para": 20, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 90, "kind": "action", "text": "Wendell draws.", "para": 21, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 91, "kind": "action", "text": "Late.", "para": 21, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 92, "kind": "action", "text": "The pistol barks.", "para": 22, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 93, "kind": "action", "text": "Wendell spins.", "para": 22, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 94, "kind": "action", "text": "Drops.", "para": 22, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 95, "kind": "action", "text": "Gus fires.", "para": 23, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 96, "kind": "action", "text": "Splinters from the doorframe.", "para": 23, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 97, "kind": "action", "text": "Calloway-Brant is already moving, crashing sideways into the lantern.", "para": 23, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 98, "kind": "action", "text": "Dark.", "para": 24, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 99, "kind": "action", "text": "Then fire.", "para": 24, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 100, "kind": "action", "text": "The lantern oil catches the dry timber.", "para": 24, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 101, "kind": "dialogue", "text": "Cut me loose, Gus! Cut me loose!", "name": "LUCKY", "speaker": 2, "ext": [], "paren": ["laughing"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 102, "kind": "dialogue", "text": "Not a chance.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 103, "kind": "action", "text": "Flames climb the wall.", "para": 25, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 104, "kind": "action", "text": "Smoke rolls.", "para": 25, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 105, "kind": "action", "text": "Calloway-Brant is a shadow behind the cable drum.", "para": 25, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 106, "kind": "dialogue", "text": "Last chance, Sheriff!", "name": "CALLOWAY-BRANT", "speaker": 5, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 107, "kind": "dialogue", "text": "Come take it!", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 108, "kind": "action", "text": "Gus fires at the drum.", "para": 26, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 109, "kind": "action", "text": "Sparks.", "para": 26, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 110, "kind": "action", "text": "The cable snaps free and whips across the room, slashing the rope at Lucky's wrists.", "para": 26, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 111, "kind": "action", "text": "She is loose.", "para": 27, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 112, "kind": "action", "text": "She grins.", "para": 27, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 113, "kind": "dialogue", "text": "Thank you kindly.", "name": "LUCKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 114, "kind": "action", "text": "She snatches Wendell's fallen gun.", "para": 28, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 115, "kind": "action", "text": "Gus swings the rifle on her.", "para": 28, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 116, "kind": "action", "text": "They freeze.", "para": 29, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 117, "kind": "action", "text": "Three guns.", "para": 29, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 118, "kind": "action", "text": "Three people.", "para": 29, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 119, "kind": "action", "text": "Fire roaring.", "para": 29, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 120, "kind": "dialogue", "text": "Don't.", "name": "WENDELL", "speaker": 4, "ext": [], "paren": ["weak, from the floor"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 121, "kind": "action", "text": "None of them moves.", "para": 30, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 122, "kind": "action", "text": "The roof timbers groan.", "para": 31, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 123, "kind": "action", "text": "A beam drops between them in a shower of sparks.", "para": 31, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 124, "kind": "action", "text": "They scatter.", "para": 32, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}