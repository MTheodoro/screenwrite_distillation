{"scene_id": "s00272", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00272.fountain", "heading": "INT. MUNICIPAL SWAN-BOAT BOATHOUSE - EVENING", "cast": [{"id": 0, "name": "BARNABY QUILL", "names": ["BARNABY QUILL", "BARNABY"], "gender": "?", "first": 3, "spoke": 13}, {"id": 1, "name": "ODALYS FERREIRA-NNAMDI", "names": ["ODALYS FERREIRA-NNAMDI", "ODALYS"], "gender": "?", "first": 5, "spoke": 13}, {"id": 2, "name": "PETE", "names": ["PETE"], "gender": "m", "first": 11, "spoke": 9}, {"id": 3, "name": "LAZAR", "names": ["LAZAR"], "gender": "?", "first": 11, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. MUNICIPAL SWAN-BOAT BOATHOUSE - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "A cathedral of damp wood.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Eleven fiberglass swans, enormous and faintly smug, are moored nose to tail in the dark water, each wearing the faded expression of a creature that has been pedaled by thousands of children and has forgiven none of them.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "BARNABY QUILL (50s, municipal windbreaker, a lanyard heavy with keys that open nothing important) stands on the dock with a clipboard held like a hymnal.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "He is counting swans for the third time and arriving at a different number each time.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "action", "text": "ODALYS FERREIRA-NNAMDI (40s, wet-weather poncho, hair in a hopeful bun) climbs out of a swan with the dignity of a woman leaving a courtroom.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "It's twelve.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "It's eleven.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "The inventory says twelve.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "The inventory also says the pond is a lake.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Behind them, a third voice drifts from the rafters.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "PETRU \"PETE\" LAZAR (20s, cheerful, harness, a flashlight in his teeth) dangles above the water, retrieving a pennant.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Thith ith the one.", "name": "PETE", "speaker": 2, "ext": [], "paren": ["around the flashlight"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Pete, take the flashlight out of your mouth.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Pete spits the flashlight into his palm.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "It bounces off a swan's head and sinks.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "That was a municipal flashlight.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "It was my flashlight.", "name": "PETE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "It was Barnaby's flashlight.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "It was a flashlight in the general sense.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Can I come down now?", "name": "PETE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "No.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Yes.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "No, because if he comes down we'll have to talk about the swan.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "We are talking about the swan.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Which swan?", "name": "PETE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "The twelfth.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "There's a twelfth?", "name": "PETE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "There is not a twelfth.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Barnaby, I rode it. For twenty minutes. It has a steering problem and a name.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "What name?", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Gerald.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Gerald's a good name.", "name": "PETE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Pete, you are suspended in the air by one strap and I need you to stop having opinions.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "I've had opinions the whole time, though.", "name": "PETE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "He's had opinions since March.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "In March I told you both the swans were not to be named.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "You named the swans.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "I named ONE swan. Lucille. Out of respect.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Lucille's on the left.", "name": "PETE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Lucille is the one we sank in August.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Lucille is resting.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "A long silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Water slaps the pilings.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "A swan, somewhere, knocks against the dock with a hollow note.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Barnaby, there are twelve swans.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "I know.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": ["very quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "So who's got Gerald?", "name": "PETE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Barnaby lets the clipboard drop.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "It floats.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "All three of them watch it drift away across the dark water toward the far swan, which has, impossibly, begun to turn its head.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}]}