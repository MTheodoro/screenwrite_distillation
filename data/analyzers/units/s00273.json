[], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "You didn't take it.", "name": "SOL", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Sol laughs once.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Short.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Dead.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Four years.", "name": "SOL", "speaker": 1, "ext": ["CONT'D"], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "A third silhouette steps through the exit light.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "TOBIAS WREN (60s, dry, immaculate raincoat).", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Evening, both.", "name": "TOBIAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Kaveh's gun drifts toward Tobias.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Sol's wrench stays on Kaveh.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Nobody here's leaving angry. Which is the point.", "name": "TOBIAS", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "He sets a thin black case on the wet floor and slides it forward.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Sol drops the wrench.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "It rings.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Kaveh lowers the gun.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}]}