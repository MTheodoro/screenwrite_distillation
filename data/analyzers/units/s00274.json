{"scene_id": "s00274", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00274.fountain", "heading": "INT. LIGHTHOUSE KEEPER'S QUARTERS - NIGHT", "cast": [{"id": 0, "name": "HELGA STRAND", "names": ["HELGA STRAND", "HELGA"], "gender": "?", "first": 5, "spoke": 6}, {"id": 1, "name": "ARNE STRAND", "names": ["ARNE STRAND", "ARNE"], "gender": "m", "first": 5, "spoke": 6}, {"id": 2, "name": "MAREN STRAND", "names": ["MAREN STRAND", "MAREN"], "gender": "m", "first": 5, "spoke": 3}, {"id": 3, "name": "THEO STRAND", "names": ["THEO STRAND", "THEO"], "gender": "?", "first": 5, "spoke": 2}, {"id": 4, "name": "CAPTAIN BASIL YEBOAH-KARLSSON", "names": ["CAPTAIN BASIL YEBOAH-KARLSSON", "BASIL"], "gender": "?", "first": 13, "spoke": 9}, {"id": 5, "name": "RADIO", "names": ["RADIO"], "gender": "?", "first": 17, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. LIGHTHOUSE KEEPER'S QUARTERS - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Storm outside.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sea slamming rock.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A kerosene lamp.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A shortwave radio on the table, buzzing.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "HELGA STRAND (60s, oilskin, iron-gray braid) stands at the stove.", "para": 1, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "action", "text": "Stirring.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "Not looking up.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "At the table: her son, ARNE STRAND (30s, damp wool sweater, a bandage across one hand).", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "He stares at the radio.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Their daughter-in-law, MAREN STRAND (30s, pregnant, hands wrapped around a cup) watches Arne watch the radio.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "On the stairs, listening: THEO STRAND (10, pajamas, bare feet).", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "He has been told to sleep.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "By the window: CAPTAIN BASIL YEBOAH-KARLSSON (50s, drenched, sou'wester in hand).", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "A stranger.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Dripping onto the floorboards.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "The radio hisses.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Coast Guard to lighthouse. Come in.", "name": "RADIO", "speaker": 5, "ext": ["V.O."], "paren": ["distorted"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Nobody moves.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Helga stirs.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Coast Guard to lighthouse. We have your vessel's mayday. Repeat. Come in.", "name": "RADIO", "speaker": 5, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Arne rises.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Chair scrapes.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Maren catches his wrist.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Don't.", "name": "MAREN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Maren.", "name": "ARNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "You say one word to them and it's over.", "name": "MAREN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "It's already over.", "name": "ARNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Helga sets the spoon down.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Turns.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Sit.", "name": "HELGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Arne sits.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Maren lets go.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Basil steps from the window.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Water pooling around his boots.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "They'll keep calling.", "name": "BASIL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Let them.", "name": "HELGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "My crew is in that water.", "name": "BASIL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Your crew is dead, Captain.", "name": "HELGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Silence.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "The radio crackles.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Lighthouse. Acknowledge. Over.", "name": "RADIO", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Theo sits on the bottom stair.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Pulls his knees up.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Daddy?", "name": "THEO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Go to bed.", "name": "ARNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Who's talking?", "name": "THEO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "The radio, love. Go on.", "name": "MAREN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "Theo doesn't go.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "Basil crosses the room in three strides and picks up the microphone.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "Arne is up again.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Helga steps between them.", "para": 16, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "The three of them stand locked, a breath apart, Maren half-risen behind with one hand on her belly, Theo gripping the banister.", "para": 16, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "Let me answer.", "name": "BASIL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "Put it down.", "name": "HELGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "They'll send a boat.", "name": "BASIL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "They'll send a boat for us.", "name": "ARNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "For all of us.", "name": "BASIL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "dialogue", "text": "For him.", "name": "HELGA", "speaker": 0, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "She nods at Arne.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "action", "text": "Basil looks.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "Looks at the bandage.", "para": 17, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "At the rope burn climbing the wrist.", "para": 17, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "dialogue", "text": "You cut the line.", "name": "BASIL", "speaker": 4, "ext": [], "paren": ["slowly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "Arne says nothing.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "dialogue", "text": "You cut our line.", "name": "BASIL", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "dialogue", "text": "The reef would have taken the lighthouse.", "name": "ARNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "dialogue", "text": "The reef took forty men!", "name": "BASIL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "dialogue", "text": "I was trying to save my family!", "name": "ARNE", "speaker": 1, "ext": [], "paren": ["shouting"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "action", "text": "Maren covers her mouth.", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "action", "text": "Theo starts to cry without sound.", "para": 19, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "dialogue", "text": "Lighthouse, we have a visual on your lamp. Repeat, we have a visual. Hold position.", "name": "RADIO", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "action", "text": "Basil lets the microphone drop.", "para": 20, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "action", "text": "It swings on its cord, clicking against the table leg.", "para": 20, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "action", "text": "Helga takes it.", "para": 21, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 75, "kind": "action", "text": "Presses the key.", "para": 21, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 76, "kind": "dialogue", "text": "This is Helga Strand. Lighthouse is secure.", "name": "HELGA", "speaker": 0, "ext": [], "paren": ["into the microphone"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 77, "kind": "action", "text": "A pause.", "para": 22, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 78, "kind": "action", "text": "Static.", "para": 22, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 79, "kind": "dialogue", "text": "Copy, ma'am. Any survivors?", "name": "RADIO", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 80, "kind": "action", "text": "Everyone looks at Basil.", "para": 23, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 81, "kind": "action", "text": "Basil stares at the floor.", "para": 24, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 82, "kind": "action", "text": "At the pool of seawater spreading around his boots.", "para": 24, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 83, "kind": "action", "text": "At the small bare feet on the stairs.", "para": 24, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 84, "kind": "action", "text": "He looks up.", "para": 24, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 85, "kind": "dialogue", "text": "One.", "name": "BASIL", "speaker": 4, "ext": [], "paren": ["barely"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 86, "kind": "action", "text": "Helga lowers the microphone.", "para": 25, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 87, "kind": "action", "text": "Arne puts his face in his bandaged hand.", "para": 25, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 88, "kind": "action", "text": "Maren crosses to him and doesn't touch him.", "para": 25, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 89, "kind": "action", "text": "Wind hits the tower.", "para": 26, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 90, "kind": "action", "text": "The lamp above them sweeps its beam across the window, turning, turning, turning.", "para": 26, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}