{"scene_id": "s00275", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00275.fountain", "heading": "INT. MINIATURE GOLF WINDMILL - DAY", "cast": [{"id": 0, "name": "GRETCHEN POLLARD", "names": ["GRETCHEN POLLARD", "GRETCHEN"], "gender": "?", "first": 4, "spoke": 1}, {"id": 1, "name": "WALDO POLLARD", "names": ["WALDO POLLARD", "WALDO"], "gender": "?", "first": 4, "spoke": 1}, {"id": 2, "name": "TEENAGE ATTENDANT RUSS OYELARAN", "names": ["TEENAGE ATTENDANT RUSS OYELARAN", "RUSS"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "LITTLE MIRABEL", "names": ["LITTLE MIRABEL", "MIRABEL"], "gender": "?", "first": 7, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. MINIATURE GOLF WINDMILL - DAY", "present": []}, {"u": 1, "kind": "action", "text": "The big concrete windmill at hole eighteen.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Blades turning slowly.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A tunnel through its base.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "GRETCHEN POLLARD (50s, visor, scorecard in teeth) is wedged halfway into the tunnel on her stomach.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Her husband WALDO POLLARD (50s, bucket hat) holds her ankles.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "TEENAGE ATTENDANT RUSS OYELARAN (17, name tag, vest) arrives with a rake.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "LITTLE MIRABEL (8, glitter sneakers) watches from the green, club trailing.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Ma'am, you can't go in there.", "name": "RUSS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "My ball's in there!", "name": "GRETCHEN", "speaker": 0, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "She means it.", "name": "WALDO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "The blades turn.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "A blade clips Waldo's hat.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "He ducks.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Gretchen shoots out of the tunnel, ball in hand, and the two of them tumble into Russ.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "All three go down in a heap.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "The rake clatters.", "para": 5, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Is that a hole in one?", "name": "MIRABEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "No.", "name": "RUSS", "speaker": 2, "ext": [], "paren": ["from the pile"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Gretchen holds up the ball like a trophy.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}]}