{"scene_id": "s00276", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00276.fountain", "heading": "EXT. FLOODED RICE PADDY - DAWN", "cast": [{"id": 0, "name": "LIEUTENANT NADIA VASSILIOU", "names": ["LIEUTENANT NADIA VASSILIOU", "NADIA"], "gender": "?", "first": 7, "spoke": 8}, {"id": 1, "name": "SERGEANT FIONN MCALLISTER-DUBE", "names": ["SERGEANT FIONN MCALLISTER-DUBE", "FIONN"], "gender": "?", "first": 9, "spoke": 5}, {"id": 2, "name": "CORPORAL AMARA TSEGAYE", "names": ["CORPORAL AMARA TSEGAYE", "AMARA"], "gender": "f", "first": 10, "spoke": 3}, {"id": 3, "name": "POLDO", "names": ["POLDO"], "gender": "m", "first": 11, "spoke": 3}, {"id": 4, "name": "RINCON", "names": ["RINCON"], "gender": "?", "first": 11, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FLOODED RICE PADDY - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Mist.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Brown water to the knees.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A broken dike.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Frogs.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Four soldiers in a skirmish line.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "Slogging.", "para": 1, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "LIEUTENANT NADIA VASSILIOU (30s, helmet strap loose) in the lead.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Compass in her fist.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "SERGEANT FIONN MCALLISTER-DUBE (40s, radio on his back) behind her.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "CORPORAL AMARA TSEGAYE (20s, rifle high, eyes wide) third.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "PRIVATE LEOPOLDO \"POLDO\" RINCON (19, glasses taped at the hinge) last.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Spacing. Ten feet.", "name": "NADIA", "speaker": 0, "ext": [], "paren": ["low, to the line"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "They spread.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Water sloshes.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Ten feet. Ten feet. Ten feet.", "name": "POLDO", "speaker": 3, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "A frog leaps.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Amara jerks the rifle.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Fionn grabs the barrel.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Easy.", "name": "FIONN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Sorry.", "name": "AMARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "They go on.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "The mist shifts.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Metal glints ahead.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "A crouched shape.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "A helmet.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Then another.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Nadia raises a fist.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Everyone stops.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "A crack.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Water jumps near Poldo.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Down!", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Nadia and Amara dive left.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Fionn and Poldo dive right.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "A machine gun opens up, stitching the paddy.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Stay low! Stay LOW!", "name": "FIONN", "speaker": 1, "ext": [], "paren": ["shouting at the whole squad"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Poldo lifts his head.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Gets a mouthful of mud.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Okay. Okay okay okay.", "name": "POLDO", "speaker": 3, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Where is it?", "name": "AMARA", "speaker": 2, "ext": [], "paren": ["to Nadia"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Treeline. Eleven o'clock.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "She crawls to Fionn.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "He is on the radio.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "His lips move.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Static only.", "para": 14, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Dead.", "name": "FIONN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Try again.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "He tries.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Nothing.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "The firing stops.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Hard silence.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Frogs begin again.", "para": 16, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Nadia peers over the dike.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "She stares.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "Her shoulders drop.", "para": 17, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "Hold fire.", "name": "NADIA", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the squad"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Ma'am?", "name": "AMARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "Hold. Fire.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Across the paddy, the \"helmets\" are scarecrows.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "Two straw men in rusted pots.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "A third machine gun sits on a bamboo tripod, tied to a clapper that bangs in the breeze.", "para": 18, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "Fionn lets out a breath that turns into a laugh.", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "Amara puts her forehead on her rifle.", "para": 19, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "Poldo sits straight up out of the water, soaked to the chin.", "para": 19, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "dialogue", "text": "It's a bird scarer.", "name": "POLDO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "It's a bird scarer.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "She pulls her wet hat off and wrings it.", "para": 20, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "action", "text": "Amara and Poldo stand together, shaking, and slap each other on the shoulder, hard, both laughing.", "para": 20, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "dialogue", "text": "Will you tell them she did the compass right?", "name": "FIONN", "speaker": 1, "ext": [], "paren": ["to Nadia"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "dialogue", "text": "Tell them yourself. She's your lieutenant.", "name": "NADIA", "speaker": 0, "ext": [], "paren": ["to Fionn"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "action", "text": "Fionn looks at Nadia.", "para": 21, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "action", "text": "She looks at him.", "para": 21, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "action", "text": "A beat, and neither can say which of them was the \"she\" meant.", "para": 21, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "dialogue", "text": "Aye.", "name": "FIONN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "action", "text": "They start across the paddy.", "para": 22, "sent": 0, "present": [0, 1, 2, 3, 4]}]}