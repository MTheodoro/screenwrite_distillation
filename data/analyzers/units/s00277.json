{"scene_id": "s00277", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00277.fountain", "heading": "INT. BONDED WAREHOUSE - CHEESE AGING CAVE - NIGHT", "cast": [{"id": 0, "name": "DOLLY", "names": ["DOLLY"], "gender": "f", "first": 4, "spoke": 4}, {"id": 1, "name": "PRITCHARD-ABARA", "names": ["PRITCHARD-ABARA"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "CASIMIR VOLKOV", "names": ["CASIMIR VOLKOV"], "gender": "m", "first": 6, "spoke": 0}, {"id": 3, "name": "LEFTY", "names": ["LEFTY"], "gender": "?", "first": 9, "spoke": 1}, {"id": 4, "name": "BATISTE", "names": ["BATISTE"], "gender": "?", "first": 9, "spoke": 0}, {"id": 5, "name": "INSPECTOR HOLLIS TANAKA-REED", "names": ["INSPECTOR HOLLIS TANAKA-REED", "HOLLIS"], "gender": "?", "first": 19, "spoke": 6}, {"id": 6, "name": "PEPPER NAKAMURA-OSEI", "names": ["PEPPER", "PEPPER NAKAMURA-OSEI"], "gender": "f", "first": 47, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. BONDED WAREHOUSE - CHEESE AGING CAVE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Rows of wheels stacked to the ceiling.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cold.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Ammonia and rind.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A woman in a hairnet, DOLORES \"DOLLY\" PRITCHARD-ABARA (50s), runs a finger along a shelf.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "She doesn't look at the two men by the door.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "A man in a good suit, CASIMIR VOLKOV (40s), checks his cuffs.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "He is early.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "He hates being early.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "The second man, LENNOX \"LEFTY\" BATISTE (30s, work gloves, one sleeve rolled), leans on a hand truck.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "He taps it.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "She lifts a wheel.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Turns it.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Sniffs.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "It's the right one.", "name": "LEFTY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "We'll see.", "name": "DOLLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "She sets it down.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Wipes her hands on her apron.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "He watches her hands.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "A fourth figure comes down the aisle: INSPECTOR HOLLIS TANAKA-REED (50s, county badge on a belt clip).", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Slow.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Wheezing from the cold.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "She stops three rows away.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Evening.", "name": "HOLLIS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Nobody answers.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "She nods at the shelves.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Lot of inventory.", "name": "HOLLIS", "speaker": 5, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "It's a big cave.", "name": "DOLLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Hollis smiles.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Moves closer.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Casimir shifts his weight.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "He glances at Lefty.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Lefty looks at the floor.", "para": 8, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Mind if I look at the paperwork?", "name": "HOLLIS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Back office.", "name": "DOLLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "I'd rather look here.", "name": "HOLLIS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "She waits.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Dolly hands over a clipboard.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "She flips pages.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Doesn't read them.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Funny. These numbers line up exactly.", "name": "HOLLIS", "speaker": 5, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "We keep good books.", "name": "DOLLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Nobody keeps books this good.", "name": "HOLLIS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "She sets the clipboard on a wheel.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Casimir steps forward.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Lefty's hand tightens on the truck.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "A fifth voice, from the dark behind the last row.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "Everybody just stay where you are.", "name": "PEPPER", "speaker": 6, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "Out of the dark: PEPPER NAKAMURA-OSEI (20s, the night cleaner, mop bucket, calm).", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "action", "text": "A pistol in her yellow glove.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "action", "text": "She points at no one in particular.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "action", "text": "At the room.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "dialogue", "text": "Mrs. Pritchard, you said you'd be gone by ten.", "name": "PEPPER", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "action", "text": "Dolly doesn't blink.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "action", "text": "She looks at the wheel Hollis is leaning on.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "action", "text": "Hollis sees it.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "action", "text": "Straightens.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "action", "text": "Takes her hand off the cheese.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "action", "text": "Lefty lets go of the hand truck.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 59, "kind": "action", "text": "It rolls a foot.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 60, "kind": "action", "text": "Stops.", "para": 16, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 61, "kind": "action", "text": "Casimir smooths his tie.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 62, "kind": "action", "text": "The compressor kicks on.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 63, "kind": "action", "text": "A long, low hum.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 64, "kind": "action", "text": "Pepper lowers the pistol.", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 65, "kind": "dialogue", "text": "It's cold in here.", "name": "PEPPER", "speaker": 6, "ext": ["CONT'D"], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 66, "kind": "action", "text": "Dolly takes off her apron.", "para": 20, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 67, "kind": "action", "text": "Folds it.", "para": 20, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 68, "kind": "action", "text": "Sets it on the shelf.", "para": 20, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 69, "kind": "action", "text": "She nods once to Hollis, who nods back.", "para": 20, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 70, "kind": "action", "text": "They walk out together.", "para": 21, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 71, "kind": "action", "text": "The two men follow.", "para": 21, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 72, "kind": "action", "text": "Pepper stays, looking at the wheels, the mop bucket at her feet.", "para": 21, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}]}