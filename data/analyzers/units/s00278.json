{"scene_id": "s00278", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00278.fountain", "heading": "INT. ABANDONED PLANETARIUM - NIGHT", "cast": [{"id": 0, "name": "EVELYN HARGROVE", "names": ["EVELYN HARGROVE", "EVELYN"], "gender": "f", "first": 5, "spoke": 8}, {"id": 1, "name": "THE MAN", "names": ["MAN", "THE MAN"], "gender": "f", "first": 6, "spoke": 7}, {"id": 2, "name": "AMBROSE", "names": ["AMBROSE"], "gender": "?", "first": 41, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED PLANETARIUM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A great dome of cracked plaster.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of tilting seats like rotted teeth.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "At the center, a Zeiss star projector, shrouded like a sleeping beast.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A flashlight beam wanders across the dome.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "Behind it: EVELYN HARGROVE (30s, wool coat, camera bag), picking her way down the aisle.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "dialogue", "text": "Hello? The caretaker said the doors were unlocked.", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Her voice dies in the plaster.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She reaches the projector.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Lays a hand on its cover.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "A SOUND.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Soft.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Behind her.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "A seat creaking back.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She spins the light.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "A MAN sits in the third row.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Gray suit.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Hands folded.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Smiling pleasantly.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Ten minutes early. Punctual people are rare.", "name": "THE MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "I didn't see you come in.", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "I didn't come in.", "name": "THE MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "She laughs, nervous, and glances at the exit.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Still there.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Still far.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Are you the caretaker?", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "I look after the stars. Is that the same?", "name": "THE MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "She lowers the light.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "I'm here to photograph the dome. For the historical society.", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Of course.", "name": "THE MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "He stands.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Slowly.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "His shadow does not move with him.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Oh.", "name": "EVELYN", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Don't be frightened. I only want you to look up.", "name": "THE MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "No.", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Please.", "name": "THE MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "The projector SHUDDERS under its cover.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "A hum rises from the machine.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "A thin line of light cuts from under the cloth.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Who are you?", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Ambrose Lyle. Chief astronomer. Nineteen thirty-one.", "name": "THE MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "He smiles, and the plaster above them goes black, then bursts with ten thousand stars.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Please.", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Look up, Miss Hargrove.", "name": "AMBROSE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "She doesn't want to.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "She does.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "The stars begin to move toward her.", "para": 10, "sent": 2, "present": [0, 1, 2]}]}