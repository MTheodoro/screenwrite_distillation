{"scene_id": "s00279", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00279.fountain", "heading": "INT. GREENHOUSE CONSERVATORY - NIGHT", "cast": [{"id": 0, "name": "DOCTOR PRUDENCE ACHEBE", "names": ["DOCTOR PRUDENCE ACHEBE", "ACHEBE"], "gender": "?", "first": 7, "spoke": 1}, {"id": 1, "name": "LORD ALISTAIR PENHALLOW-NG", "names": ["LORD ALISTAIR PENHALLOW-NG"], "gender": "m", "first": 9, "spoke": 0}, {"id": 2, "name": "TALLY", "names": ["TALLY"], "gender": "?", "first": 10, "spoke": 1}, {"id": 3, "name": "BRIGHTWATER", "names": ["BRIGHTWATER"], "gender": "?", "first": 10, "spoke": 0}, {"id": 4, "name": "OSWIN OKONKWO-FRY", "names": ["OSWIN OKONKWO-FRY", "OSWIN"], "gender": "m", "first": 11, "spoke": 1}, {"id": 5, "name": "GRANDE DAME ESMERALDA VANCE", "names": ["GRANDE DAME ESMERALDA VANCE", "ESMERALDA"], "gender": "m", "first": 12, "spoke": 2}, {"id": 6, "name": "DEV", "names": ["DEV"], "gender": "?", "first": 13, "spoke": 3}, {"id": 7, "name": "MARLOWE", "names": ["MARLOWE"], "gender": "?", "first": 13, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. GREENHOUSE CONSERVATORY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Glass walls beaded with condensation.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Orchids hang like trapped moths.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "At the center, a wrought-iron table, a half-eaten fig tart, and a toppled chair.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Six people stand around the table.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "In the chair's place lies the body of the host, a velvet cloak over his chest.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "Nobody has touched him.", "para": 1, "sent": 2, "present": []}, {"u": 7, "kind": "action", "text": "DOCTOR PRUDENCE ACHEBE (50s, tailored green suit) kneels.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Fingertips at his throat.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "LORD ALISTAIR PENHALLOW-NG (60s, monocle, flushed) stands rigid, a champagne flute shaking in his hand.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "MISS TALLULAH \"TALLY\" BRIGHTWATER (20s, flapper beads) grips the back of a chair.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "MR. OSWIN OKONKWO-FRY (40s, butler's tails) holds the door.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "GRANDE DAME ESMERALDA VANCE (70s, black lace, cane) watches all of them.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "Standing apart, by the orchids: INSPECTOR DEVRAJ \"DEV\" MARLOWE (40s, rumpled raincoat, soaked).", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 14, "kind": "dialogue", "text": "No one leaves.", "name": "DEV", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 15, "kind": "dialogue", "text": "Dev, darling, you can't hold us.", "name": "TALLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 16, "kind": "dialogue", "text": "Miss Brightwater, I can hold you till breakfast.", "name": "DEV", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 17, "kind": "dialogue", "text": "Oswin, lock the door.", "name": "ESMERALDA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 18, "kind": "dialogue", "text": "Already done, madam.", "name": "OSWIN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 19, "kind": "action", "text": "Everyone turns to look at Oswin.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 20, "kind": "action", "text": "Oswin looks at the key in his hand.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 21, "kind": "action", "text": "Doctor Achebe stands.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 22, "kind": "action", "text": "Lord Alistair steps back into an orchid.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 23, "kind": "action", "text": "The flute shatters.", "para": 8, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 24, "kind": "action", "text": "Tally and Dev lunge for the same loose thread of cloak.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 25, "kind": "action", "text": "Oswin bolts for the door.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 26, "kind": "action", "text": "Esmeralda's cane cracks down on his wrist.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 27, "kind": "action", "text": "Alistair collapses into a chair.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 28, "kind": "action", "text": "The doctor catches the key mid-air.", "para": 9, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 29, "kind": "dialogue", "text": "The tart.", "name": "ACHEBE", "speaker": 0, "ext": [], "paren": ["calm"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "action", "text": "Every head turns to the fig tart.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "action", "text": "One slice missing.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "action", "text": "A silver fork beside it, tines green.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "dialogue", "text": "Who cut the tart?", "name": "DEV", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "action", "text": "Silence.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "action", "text": "Condensation drips from the glass roof.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "dialogue", "text": "I did, Inspector.", "name": "ESMERALDA", "speaker": 5, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}