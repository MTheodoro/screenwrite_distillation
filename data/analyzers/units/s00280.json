{"scene_id": "s00280", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00280.fountain", "heading": "EXT. DRIFTING ICE FLOE, ARCTIC INLET - DAY", "cast": [{"id": 0, "name": "FIGURE", "names": ["FIGURE"], "gender": "?", "first": 4, "spoke": 0}, {"id": 1, "name": "HANNE", "names": ["HANNE"], "gender": "?", "first": 8, "spoke": 6}, {"id": 2, "name": "SKJOLD", "names": ["SKJOLD"], "gender": "?", "first": 8, "spoke": 1}, {"id": 3, "name": "STATION", "names": ["STATION"], "gender": "?", "first": 15, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DRIFTING ICE FLOE, ARCTIC INLET - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A white plain under a white sky.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A scatter of gear: a collapsed tent, a sled, a battered handheld radio.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wind pushes snow in thin ribbons across the surface.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A FIGURE in a red parka kneels over a camp stove, back to us.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Small.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Methodical.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "The figure turns.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "HANNELORE \"HANNE\" SKJOLD (40s, glacier goggles pushed up, frostbitten cheeks, a field biologist's patience in her face) pours melted water into a tin cup.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "She drinks.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Looks at the horizon.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Day nine.", "name": "HANNE", "speaker": 1, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "She sets down the cup.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Picks up the radio.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Thumbs it.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Station, this is Skjold. Do you copy?", "name": "HANNE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Static.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "She waits.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Counts to thirty.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Tries again.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Station, this is Skjold. Floe drift continues northeast. Rations, six days. Morale, fine.", "name": "HANNE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "She almost smiles at that last word.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Static, then a thin voice, far away.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "...Skjold, copy... say again...", "name": "STATION", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Hanne grips the radio.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Station, I read you. Position unchanged. I am not in distress.", "name": "HANNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "...hold... helicopter... three days...", "name": "STATION", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Understood. Three days.", "name": "HANNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "She lowers the radio.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Doesn't celebrate.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Doesn't sag.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Reaches for a notebook and a pencil stub.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "The camera finds the page.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "A tally of marks, nine neat strokes.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "She adds a tenth.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Under the tally, in block letters: DON'T LOSE THE PENCIL.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Don't lose the pencil.", "name": "HANNE", "speaker": 1, "ext": ["CONT'D"], "paren": ["reading it aloud"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "She tucks the pencil behind her ear.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Looks out at the ice, and the ice looks back, patient and enormous.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "A low groan rolls under the floe.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "A thin crack runs a few meters away and stops.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Not yet, thank you.", "name": "SKJOLD", "speaker": 2, "ext": [], "paren": ["mildly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "She zips the radio into her parka and starts to repack the sled.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}]}