{"scene_id": "s00281", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00281.fountain", "heading": "INT. NATURAL HISTORY MUSEUM - WHALE HALL - NIGHT", "cast": [{"id": 0, "name": "ZOFIA KRAWCZYK-ADEYEMI", "names": ["ZOFIA KRAWCZYK-ADEYEMI", "ZOFIA"], "gender": "?", "first": 5, "spoke": 2}, {"id": 1, "name": "TRIX", "names": ["TRIX"], "gender": "?", "first": 8, "spoke": 2}, {"id": 2, "name": "OKAFOR-LINDQVIST", "names": ["OKAFOR-LINDQVIST"], "gender": "?", "first": 8, "spoke": 0}, {"id": 3, "name": "MIRIAM SOLOMON-BEAUCHAMP", "names": ["MIRIAM SOLOMON-BEAUCHAMP", "MIRIAM"], "gender": "m", "first": 10, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. NATURAL HISTORY MUSEUM - WHALE HALL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A blue whale skeleton hangs from the ceiling.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Moonlight through skylights makes its ribs look like a ship's hull.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Three figures at the base of a display case.", "para": 1, "sent": 0, "present": []}, {"u": 4, "kind": "action", "text": "Black clothes, soft shoes.", "para": 1, "sent": 1, "present": []}, {"u": 5, "kind": "action", "text": "ZOFIA KRAWCZYK-ADEYEMI (40s) kneels at the lock, picks in her teeth.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Patient.", "para": 2, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Her hands barely move.", "para": 2, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "TRISTAN \"TRIX\" OKAFOR-LINDQVIST (20s) holds a flashlight with a red filter and a stopwatch.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "His knee bounces.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "MIRIAM SOLOMON-BEAUCHAMP (60s, silver bob) stands at the rail, arms folded, watching the doors.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Ninety seconds.", "name": "TRIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Zofia doesn't answer.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "The lock clicks.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "She sets down the picks.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Inside the case: a fossil egg the size of a football, on a velvet cradle.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Trix reaches.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Miriam's hand closes on his sleeve.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "He stops.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Gloves.", "name": "MIRIAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "He pulls on gloves.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "His fingers are wet.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "They slide.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Zofia takes his hands, wipes them on her shirt, helps him.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "She lifts the egg.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Weighs it.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Hands it to Miriam.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Miriam holds it a moment too long.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Her thumb strokes the shell.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Miriam.", "name": "TRIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "I know.", "name": "MIRIAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "She wraps it in a blanket and passes it to Trix.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "He cradles it against his chest like a baby.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "A SOUND.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Footsteps on the mezzanine.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "A flashlight sweeps the hall.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Three freeze.", "para": 12, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Trix stops breathing.", "para": 12, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "The light crosses the whale.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "The ribs.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "The case.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "It settles on the empty velvet.", "para": 13, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Silence.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Then the light moves on.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "The footsteps fade toward the east wing.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Zofia lets out a breath.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Trix is shaking so hard the egg rattles in its blanket.", "para": 15, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "She steadies it with both hands.", "para": 15, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Walk.", "name": "ZOFIA", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "They walk.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Under the whale.", "para": 16, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Past the stuffed elk.", "para": 16, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Toward the loading dock.", "para": 16, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "At the door, Miriam stops.", "para": 17, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Looks back at the empty case.", "para": 17, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "At the whale.", "para": 17, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Seventy years.", "name": "MIRIAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "Move.", "name": "ZOFIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "Miriam turns.", "para": 18, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "Follows.", "para": 18, "sent": 1, "present": [0, 1, 2, 3]}]}