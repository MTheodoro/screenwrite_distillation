{"scene_id": "s00283", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00283.fountain", "heading": "INT. FAMILY MINIVAN - DRIVE-THROUGH BREAKFAST LANE - MORNING", "cast": [{"id": 0, "name": "ROLAND ESPINOZA-HART", "names": ["ROLAND ESPINOZA-HART", "ROLAND"], "gender": "?", "first": 5, "spoke": 3}, {"id": 1, "name": "NEELAM ESPINOZA-HART", "names": ["NEELAM ESPINOZA-HART", "NEELAM"], "gender": "?", "first": 5, "spoke": 2}, {"id": 2, "name": "TAMSIN", "names": ["TAMSIN"], "gender": "?", "first": 8, "spoke": 1}, {"id": 3, "name": "FELIX", "names": ["FELIX"], "gender": "?", "first": 9, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. FAMILY MINIVAN - DRIVE-THROUGH BREAKFAST LANE - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Rain on the windshield.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Four people.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "One bag of hash browns that has already been opened.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "He is at the wheel, shouting into the speaker box while checking the mirror, the clock, and his phone all at once.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "His name is ROLAND ESPINOZA-HART (40s, tie half-knotted).", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "She is in the passenger seat, shouting over him to the speaker box, with a coffee in one hand and a sleeping bag stuffed under her arm.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "This is NEELAM ESPINOZA-HART (40s, hospital scrubs).", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "In the back, a girl of twelve, TAMSIN, kicks the seat.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "A boy of seven, FELIX, is standing on the seat, pressing his nose to the glass.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "A sibling war has broken out over the hash browns.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "They each have one hand in the bag and one hand on the other's face.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Roland reaches back without looking and swats at both.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Neelam reaches back, too, and her coffee spills down Roland's sleeve.", "para": 3, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "He yelps.", "para": 3, "sent": 6, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Tamsin shrieks.", "para": 3, "sent": 7, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Felix falls off the seat onto the floor, still holding the bag.", "para": 3, "sent": 8, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Two number threes!", "name": "ROLAND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Three!", "name": "NEELAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "He's eating mine!", "name": "TAMSIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "It's MY bag!", "name": "FELIX", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Everybody stop!", "name": "ROLAND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Nobody stops.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "The speaker box crackles.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "The car behind them honks.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Roland, move up.", "name": "NEELAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "I'm moving!", "name": "ROLAND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "He is not moving.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "He is reaching for a napkin.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Felix's foot is on the horn.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "The honk goes long.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Neelam lunges for the foot.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Tamsin grabs the napkin.", "para": 5, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Roland swerves a half inch and hits the speaker post.", "para": 5, "sent": 6, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "The speaker box goes silent.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "All four freeze, mid-motion, a family in tableau.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Then everyone starts again.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}]}