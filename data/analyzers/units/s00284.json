{"scene_id": "s00284", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00284.fountain", "heading": "INT. PEST-CONTROL TRAINING SEMINAR - HOTEL BALLROOM - DAY", "cast": [{"id": 0, "name": "HUMPHREY", "names": ["HUMPHREY"], "gender": "?", "first": 5, "spoke": 12}, {"id": 1, "name": "BRANDYWINE-OYELOWO", "names": ["BRANDYWINE-OYELOWO"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "PRIZZY", "names": ["PRIZZY"], "gender": "f", "first": 6, "spoke": 10}, {"id": 3, "name": "DELACROIX-NAKASHIMA", "names": ["DELACROIX-NAKASHIMA"], "gender": "?", "first": 6, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. PEST-CONTROL TRAINING SEMINAR - HOTEL BALLROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Folding chairs.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A projector screen with a photograph of a cockroach the size of a thumb.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A tray of lukewarm danishes.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Two chairs are occupied.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "AUGUSTUS \"HUMPHREY\" BRANDYWINE-OYELOWO (50s, rumpled blazer, lanyard) is trying to open a danish with the ferocity of a man defusing a bomb.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "In the next chair, PRISCILLA \"PRIZZY\" DELACROIX-NAKASHIMA (30s, crisp polo, notebook) is writing in a hand so neat it looks typeset.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "At the front, nobody.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "The presenter has not arrived.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "The cockroach on the screen stares at the room with enormous composure.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Prizzy, I think we've been had.", "name": "HUMPHREY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Humphrey, we paid for the seminar.", "name": "PRIZZY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "We paid for a seminar. We didn't pay for an absence.", "name": "HUMPHREY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "I'm sure he's coming.", "name": "PRIZZY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "It's been forty minutes. I've eaten two danishes. I have regrets.", "name": "HUMPHREY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Regrets, he says.", "name": "PRIZZY", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "A pause.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Humphrey looks at the screen.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "At the cockroach.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "That's a lot of bug.", "name": "HUMPHREY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "That's an American cockroach.", "name": "PRIZZY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Is it? It looks Greek.", "name": "HUMPHREY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Humphrey.", "name": "PRIZZY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "It's got the look. Stately. Doomed.", "name": "HUMPHREY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Prizzy puts down her pen.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Humphrey takes a bite of danish.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Anyone?", "name": "HUMPHREY", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the empty room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "The empty room does not answer.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "A fluorescent tube buzzes.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "I could present.", "name": "PRIZZY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "You could.", "name": "HUMPHREY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "I know all the slides. I've seen the deck.", "name": "PRIZZY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "You have the deck?", "name": "HUMPHREY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "It's on my laptop.", "name": "PRIZZY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Prizzy, that's the bravest thing anyone's said since the continental breakfast.", "name": "HUMPHREY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "She stands.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Smooths her polo.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Walks to the front.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Plugs in the cable.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "The projector flickers, then flares to life with a new slide: a diagram of a roach's digestive tract.", "para": 7, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Good morning, everyone.", "name": "PRIZZY", "speaker": 2, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Oh, this is going to be good.", "name": "HUMPHREY", "speaker": 0, "ext": [], "paren": ["whispering to himself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Prizzy clears her throat, takes a breath.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "The door at the back bangs in the wind, and nobody comes in.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Humphrey slumps.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Prizzy continues, regardless.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "We're in the middle of a seminar.", "name": "PRIZZY", "speaker": 2, "ext": ["CONT'D"], "paren": ["to the empty doorway, kindly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Prizzy, let the draft in. It might be the roaches.", "name": "HUMPHREY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}