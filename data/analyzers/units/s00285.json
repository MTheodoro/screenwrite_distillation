{"scene_id": "s00285", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00285.fountain", "heading": "INT. DRIVE-IN THEATER PROJECTION BOOTH - NIGHT", "cast": [{"id": 0, "name": "DOCTOR MARGUERITE OYELARAN-STACK", "names": ["DOCTOR MARGUERITE OYELARAN-STACK", "MARGUERITE"], "gender": "?", "first": 8, "spoke": 5}, {"id": 1, "name": "PADDY", "names": ["PADDY"], "gender": "?", "first": 9, "spoke": 1}, {"id": 2, "name": "GALLAGHER-NWOSU", "names": ["GALLAGHER-NWOSU"], "gender": "?", "first": 9, "spoke": 0}, {"id": 3, "name": "SHERIFF HOLCOMB JABLONSKI", "names": ["SHERIFF HOLCOMB JABLONSKI", "HOLCOMB"], "gender": "m", "first": 10, "spoke": 6}, {"id": 4, "name": "JUNIPER PARK-MBEKI", "names": ["JUNIPER PARK-MBEKI", "JUNIPER"], "gender": "?", "first": 12, "spoke": 5}, {"id": 5, "name": "SAUL", "names": ["SAUL"], "gender": "?", "first": 12, "spoke": 6}, {"id": 6, "name": "ODETTE ABERNATHY-VOSS", "names": ["ODETTE ABERNATHY-VOSS"], "gender": "?", "first": 13, "spoke": 0}, {"id": 7, "name": "MRS. ABERNATHY", "names": ["MRS. ABERNATHY"], "gender": "?", "first": 13, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRIVE-IN THEATER PROJECTION BOOTH - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped concrete box above the snack bar.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Two projectors, dusty.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A shelf of film cans.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "One small window overlooking a lot of weeds and a blank screen leaning in the dark.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Six people crowd the booth.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "Rain drums the roof.", "para": 1, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "A lantern sits on an overturned can, throwing their shadows huge.", "para": 1, "sent": 2, "present": []}, {"u": 8, "kind": "action", "text": "DOCTOR MARGUERITE OYELARAN-STACK (50s, medical bag, cardigan) kneels by a figure lying on the floor under a coat.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "The coat covers the face of PATRICK \"PADDY\" GALLAGHER-NWOSU (30s, projectionist), who is not moving.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "SHERIFF HOLCOMB JABLONSKI (60s, rain slicker, flashlight) stands at the door, back to the wall, watching the stairs.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "TWO TEENAGERS huddle by the window.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "They are JUNIPER PARK-MBEKI (16, letterman jacket) and her brother SAUL (17, headphones around his neck, shaking).", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "By the film shelf, an old woman, MRS. ODETTE ABERNATHY-VOSS (70s, shawl, a thermos clutched like a talisman).", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 14, "kind": "dialogue", "text": "He's gone.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 15, "kind": "dialogue", "text": "He can't be.", "name": "SAUL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 16, "kind": "dialogue", "text": "Saul, don't.", "name": "JUNIPER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 17, "kind": "dialogue", "text": "He was fine at the second reel.", "name": "MRS. ABERNATHY", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 18, "kind": "dialogue", "text": "Everybody quiet.", "name": "HOLCOMB", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 19, "kind": "action", "text": "They fall quiet.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 20, "kind": "action", "text": "Rain.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 21, "kind": "action", "text": "And below the rain, a slow scrape on the stairs.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 22, "kind": "action", "text": "Something dragging.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 23, "kind": "dialogue", "text": "That's him.", "name": "SAUL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 24, "kind": "dialogue", "text": "He's right there, Saul.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 25, "kind": "dialogue", "text": "Then who's on the stairs?", "name": "SAUL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 26, "kind": "dialogue", "text": "Oh God.", "name": "JUNIPER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 27, "kind": "dialogue", "text": "Don't say His name. Not in here.", "name": "MRS. ABERNATHY", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 28, "kind": "dialogue", "text": "Lock the door.", "name": "HOLCOMB", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 29, "kind": "dialogue", "text": "There's no lock!", "name": "JUNIPER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "dialogue", "text": "Use the can! Use a film can!", "name": "SAUL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "dialogue", "text": "Hold on, hold on, everyone--", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "dialogue", "text": "Get back from the door!", "name": "HOLCOMB", "speaker": 3, "ext": [], "paren": ["over her"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "dialogue", "text": "It's coming up!", "name": "SAUL", "speaker": 5, "ext": [], "paren": ["over him"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "dialogue", "text": "Saul, shut UP!", "name": "JUNIPER", "speaker": 4, "ext": [], "paren": ["over both"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "dialogue", "text": "It wants the projector!", "name": "MRS. ABERNATHY", "speaker": 7, "ext": [], "paren": ["over everyone"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "action", "text": "They all stop.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "action", "text": "Look at her.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "dialogue", "text": "It always wants the projector.", "name": "MRS. ABERNATHY", "speaker": 7, "ext": ["CONT'D"], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "action", "text": "The scrape reaches the top of the stairs.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "action", "text": "Stops.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 41, "kind": "action", "text": "The lantern flame leans toward the door, as if drawn.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 42, "kind": "dialogue", "text": "Nothing there. Nothing there.", "name": "HOLCOMB", "speaker": 3, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 43, "kind": "action", "text": "Something knocks.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 44, "kind": "action", "text": "Three times.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 45, "kind": "action", "text": "Soft.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 46, "kind": "action", "text": "Almost polite.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 47, "kind": "dialogue", "text": "Don't open it.", "name": "SAUL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 48, "kind": "dialogue", "text": "Nobody's opening it.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 49, "kind": "action", "text": "The door handle turns.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 50, "kind": "dialogue", "text": "It's locked, right? Tell me it's locked.", "name": "JUNIPER", "speaker": 4, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 51, "kind": "dialogue", "text": "There's no lock, I said!", "name": "HOLCOMB", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 52, "kind": "action", "text": "The door swings in.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 53, "kind": "action", "text": "Empty landing.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 54, "kind": "action", "text": "Wet footprints on the concrete, leading in.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 55, "kind": "action", "text": "The footprints lead to Paddy's body.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 56, "kind": "action", "text": "The coat slides slowly off his face.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 57, "kind": "dialogue", "text": "No pulse. I checked. I checked.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 58, "kind": "action", "text": "Paddy's eyes open.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 59, "kind": "action", "text": "White.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 60, "kind": "action", "text": "Wet.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 61, "kind": "action", "text": "He looks at the projectors.", "para": 15, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 62, "kind": "dialogue", "text": "Roll it.", "name": "PADDY", "speaker": 1, "ext": [], "paren": ["a rasp"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 63, "kind": "action", "text": "Every projector in the booth clatters to life by itself.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 64, "kind": "action", "text": "Light erupts against the blank screen outside, and a figure of the sheriff, thirty feet tall, begins to move across it.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 65, "kind": "action", "text": "Holcomb looks over his shoulder at the window.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 66, "kind": "action", "text": "At himself on the screen.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 67, "kind": "action", "text": "He raises his flashlight.", "para": 17, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 68, "kind": "dialogue", "text": "That's not me.", "name": "HOLCOMB", "speaker": 3, "ext": [], "paren": ["barely"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 69, "kind": "action", "text": "On the screen, the giant Holcomb turns and looks into the booth.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}