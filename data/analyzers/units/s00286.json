false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Ma'am, what's your name?", "name": "RESCUER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Beatrix. Beatrix Oyelowo-Marsh.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Beatrix, are you hurt?", "name": "RESCUER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Wrist. Maybe rib. I'm stuck, not bleeding.", "name": "BEATRIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Good. We're coming. Stay still.", "name": "RESCUER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I'm not going anywhere.", "name": "BEATRIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "She almost laughs.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Dust sifts down onto her shoulders.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "She lowers her head onto her arm and watches the beam of her headlamp tremble on the concrete.", "para": 4, "sent": 2, "present": [0, 1, 2]}]}