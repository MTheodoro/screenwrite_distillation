{"scene_id": "s00287", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00287.fountain", "heading": "EXT. RAILROAD WATER TOWER PLATFORM - DAY", "cast": [{"id": 0, "name": "WOMAN", "names": ["WOMAN"], "gender": "?", "first": 3, "spoke": 0}, {"id": 1, "name": "ROSIE", "names": ["ROSIE"], "gender": "?", "first": 4, "spoke": 6}, {"id": 2, "name": "HARTWELL-BANDA", "names": ["HARTWELL-BANDA"], "gender": "?", "first": 4, "spoke": 0}, {"id": 3, "name": "ELIJAH TOBIAS CORNWALL", "names": ["ELIJAH TOBIAS CORNWALL", "ELIJAH"], "gender": "m", "first": 8, "spoke": 2}, {"id": 4, "name": "JED", "names": ["JED"], "gender": "?", "first": 10, "spoke": 1}, {"id": 5, "name": "OKONJO", "names": ["OKONJO"], "gender": "?", "first": 10, "spoke": 0}, {"id": 6, "name": "PERALES-WINTERS", "names": ["PERALES-WINTERS"], "gender": "?", "first": 13, "spoke": 0}, {"id": 7, "name": "CORNELIUS DUNLEAVY-KEITA", "names": ["CORNELIUS DUNLEAVY-KEITA", "CORNELIUS"], "gender": "m", "first": 18, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "EXT. RAILROAD WATER TOWER PLATFORM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A prairie town reduced to a siding, a tank on stilts, and one plank platform baking in the sun.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A dog sleeps in the shade of a barrel.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A WOMAN sits on a crate, shelling peas into a pan.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "ROSALIND \"ROSIE\" HARTWELL-BANDA (40s, calico dress, wide-brimmed hat).", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 5, "kind": "action", "text": "Calm.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "Too calm.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "An old man whittles a spoon on the steps.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "ELIJAH TOBIAS CORNWALL (70s, white beard, suspenders).", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "A boy of twelve pumps the handle of the well.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "JEDEDIAH \"JED\" OKONJO (12, oversized boots).", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "A young cowhand leans against the post, hat low.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "He chews a straw.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "SANTIAGO \"SANTI\" PERALES-WINTERS (20s, spurs, easy grin).", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "action", "text": "At the far end, a rider.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "action", "text": "A stranger on a gray horse.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "action", "text": "He reins in.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "action", "text": "Climbs down slow.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "action", "text": "His name is CORNELIUS DUNLEAVY-KEITA (50s, long coat, dusty).", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 19, "kind": "action", "text": "He nods to them all.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 20, "kind": "dialogue", "text": "Afternoon.", "name": "CORNELIUS", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 21, "kind": "dialogue", "text": "Afternoon.", "name": "ROSIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 22, "kind": "action", "text": "She keeps shelling.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 23, "kind": "action", "text": "He ties the horse.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 24, "kind": "action", "text": "Walks up the steps.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 25, "kind": "action", "text": "Elijah scoots his boots out of the way.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 26, "kind": "dialogue", "text": "Train due?", "name": "CORNELIUS", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 27, "kind": "dialogue", "text": "Four o'clock.", "name": "ELIJAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 28, "kind": "dialogue", "text": "That's a ways.", "name": "CORNELIUS", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 29, "kind": "dialogue", "text": "Hot day for waiting.", "name": "ELIJAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "action", "text": "Cornelius smiles.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "action", "text": "Takes off his hat and wipes his brow.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "action", "text": "Santi drops the straw.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "action", "text": "Picks up a new one.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "dialogue", "text": "That your boy at the pump?", "name": "CORNELIUS", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "dialogue", "text": "He's everybody's boy.", "name": "ROSIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "action", "text": "Cornelius nods.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "action", "text": "Watches Jed work the handle.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "action", "text": "The water gushes into a trough.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "dialogue", "text": "Mister, you want some?", "name": "JED", "speaker": 4, "ext": [], "paren": ["to no one"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "dialogue", "text": "I'd be obliged.", "name": "CORNELIUS", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 41, "kind": "action", "text": "Jed fills a tin cup.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 42, "kind": "action", "text": "Hands it up.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 43, "kind": "action", "text": "Cornelius drinks.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 44, "kind": "action", "text": "Slowly.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 45, "kind": "action", "text": "Hands it back.", "para": 10, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 46, "kind": "dialogue", "text": "Peas.", "name": "CORNELIUS", "speaker": 7, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 47, "kind": "dialogue", "text": "Peas.", "name": "ROSIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 48, "kind": "dialogue", "text": "I always liked them.", "name": "CORNELIUS", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 49, "kind": "action", "text": "She finally looks up.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 50, "kind": "action", "text": "Meets his eye.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 51, "kind": "dialogue", "text": "Not these.", "name": "ROSIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 52, "kind": "action", "text": "Cornelius lowers his hand.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 53, "kind": "action", "text": "Santi straightens from the post.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 54, "kind": "action", "text": "Elijah sets the knife on his knee.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 55, "kind": "action", "text": "Jed backs away from the pump.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 56, "kind": "dialogue", "text": "Ah.", "name": "CORNELIUS", "speaker": 7, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 57, "kind": "action", "text": "Rosie reaches into the pan.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 58, "kind": "action", "text": "Under the peas, a revolver.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 59, "kind": "action", "text": "She lifts it, calm as a woman lifting a teacup.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 60, "kind": "dialogue", "text": "Walk back to your horse.", "name": "ROSIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 61, "kind": "action", "text": "He does not move.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 62, "kind": "dialogue", "text": "Now, Mr. Dunleavy.", "name": "ROSIE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 63, "kind": "action", "text": "He turns.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 64, "kind": "action", "text": "Takes the steps one at a time.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 65, "kind": "action", "text": "Reaches the gray.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 66, "kind": "action", "text": "Swings up.", "para": 15, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 67, "kind": "action", "text": "The dog lifts its head.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 68, "kind": "dialogue", "text": "Tell the boy to keep pumping.", "name": "CORNELIUS", "speaker": 7, "ext": [], "paren": ["to Rosie, over his shoulder"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 69, "kind": "action", "text": "He rides out.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 70, "kind": "action", "text": "Rosie sets the revolver back in the peas.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 71, "kind": "action", "text": "Jed lets out a sob and sits right down in the dust.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}