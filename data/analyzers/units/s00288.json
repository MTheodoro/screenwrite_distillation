{"scene_id": "s00288", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00288.fountain", "heading": "EXT. CHERRY ORCHARD IN BLOSSOM - DAY", "cast": [{"id": 0, "name": "LAZARUS BARNABY-OKORO", "names": ["LAZARUS BARNABY-OKORO", "LAZARUS"], "gender": "?", "first": 5, "spoke": 16}, {"id": 1, "name": "HEZ", "names": ["HEZ"], "gender": "?", "first": 7, "spoke": 13}, {"id": 2, "name": "ARRINGTON-CHEN", "names": ["ARRINGTON-CHEN"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "PRUDENCE LOWELL-ADEYEMI", "names": ["PRUDENCE LOWELL-ADEYEMI", "PRUDENCE"], "gender": "?", "first": 53, "spoke": 16}], "units": [{"u": 0, "kind": "heading", "text": "EXT. CHERRY ORCHARD IN BLOSSOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Pink petals on the wind.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A weathered fence.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A stone farmhouse with the shutters closed.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Two men sit on the porch.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "LAZARUS BARNABY-OKORO (50s, shirtsleeves, suspenders, sharp eyes) whittles.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Slow strokes.", "para": 2, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "HEZEKIAH \"HEZ\" ARRINGTON-CHEN (60s, white mustache, bad leg stretched out) fans himself with a hat.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "A mockingbird sings.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Petals fall.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Pretty.", "name": "HEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Pretty.", "name": "LAZARUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Used to hate cherries.", "name": "HEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "You never said.", "name": "LAZARUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Didn't have to.", "name": "HEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "He fans himself.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Lazarus sets down the knife.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Hez.", "name": "LAZARUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Mm.", "name": "HEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Eleven years.", "name": "LAZARUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Twelve in August.", "name": "HEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Twelve.", "name": "LAZARUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Hez nods.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "A petal lands on his boot.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "He brushes it off.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "You ever think she'd come back?", "name": "HEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "No.", "name": "LAZARUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Me neither.", "name": "HEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "A quiet.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "The mockingbird stops.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The wind drops.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The orchard holds its breath.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Funny how the birds go quiet.", "name": "HEZ", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Mm.", "name": "LAZARUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Before weather.", "name": "HEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Before something.", "name": "LAZARUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Lazarus rises.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Walks to the porch rail.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Looks down the lane.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Dust, far off.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "One rider.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Coming slow.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Company.", "name": "LAZARUS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Hez struggles up.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Takes his hat.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Stands beside him.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "They watch together.", "para": 11, "sent": 3, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "The rider reaches the gate.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Stops.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "A woman.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Black dress, black hat, a rifle across the saddle.", "para": 12, "sent": 3, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "She dismounts.", "para": 12, "sent": 4, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Her name is PRUDENCE LOWELL-ADEYEMI (40s, dust-streaked, hard-eyed).", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "She walks to the porch.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Stops at the bottom step.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Lazarus.", "name": "PRUDENCE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "Prudence.", "name": "LAZARUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "Hezekiah.", "name": "PRUDENCE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "Ma'am.", "name": "HEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "She lets the rifle hang.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "You thought I was dead.", "name": "PRUDENCE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "We hoped.", "name": "LAZARUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "That's honest.", "name": "PRUDENCE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "Pru, we can talk--", "name": "HEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "We talked. Twelve years ago. On this porch.", "name": "PRUDENCE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "She climbs one step.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "You said you'd sell the land and split it.", "name": "PRUDENCE", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "We did.", "name": "LAZARUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "dialogue", "text": "You said you'd send my share.", "name": "PRUDENCE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "dialogue", "text": "It never--", "name": "LAZARUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "dialogue", "text": "It never came.", "name": "PRUDENCE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "action", "text": "Lazarus and Hez exchange a look.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "action", "text": "Hez's hand drifts toward his hat.", "para": 16, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "dialogue", "text": "Pru, I don't know what you think--", "name": "HEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "dialogue", "text": "I think the orchard is mine.", "name": "PRUDENCE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "Petals swirl.", "para": 17, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "Lazarus's hand goes still on the rail.", "para": 17, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "dialogue", "text": "It's mine, Pru. I paid.", "name": "LAZARUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "dialogue", "text": "With what?", "name": "PRUDENCE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "action", "text": "Silence.", "para": 18, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "action", "text": "She climbs another step.", "para": 18, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "dialogue", "text": "With my share.", "name": "PRUDENCE", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "dialogue", "text": "Pru.", "name": "LAZARUS", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 84, "kind": "dialogue", "text": "I'm not here to kill you.", "name": "PRUDENCE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 85, "kind": "dialogue", "text": "Thank God.", "name": "HEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 86, "kind": "dialogue", "text": "I'm here to sit.", "name": "PRUDENCE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 87, "kind": "action", "text": "She climbs the last step.", "para": 19, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 88, "kind": "action", "text": "Looks at the empty chair.", "para": 19, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 89, "kind": "action", "text": "Sits.", "para": 19, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 90, "kind": "action", "text": "Lays the rifle across her knees.", "para": 19, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 91, "kind": "dialogue", "text": "Pour me a drink, Hez.", "name": "PRUDENCE", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 92, "kind": "action", "text": "Hez stares at her.", "para": 20, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 93, "kind": "action", "text": "Slowly reaches for the jug.", "para": 20, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 94, "kind": "action", "text": "Pours.", "para": 20, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 95, "kind": "action", "text": "His hand trembles.", "para": 20, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 96, "kind": "action", "text": "She takes the cup.", "para": 20, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 97, "kind": "action", "text": "She drinks.", "para": 21, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 98, "kind": "action", "text": "Sets it down.", "para": 21, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 99, "kind": "dialogue", "text": "Now. Tell me about the cherries.", "name": "PRUDENCE", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 100, "kind": "action", "text": "Lazarus turns from the rail.", "para": 22, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 101, "kind": "action", "text": "Sits.", "para": 22, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 102, "kind": "action", "text": "Picks up the knife.", "para": 22, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 103, "kind": "action", "text": "Doesn't whittle.", "para": 22, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 104, "kind": "action", "text": "Just holds it.", "para": 22, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 105, "kind": "dialogue", "text": "They bloom early here.", "name": "LAZARUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 106, "kind": "dialogue", "text": "I remember.", "name": "PRUDENCE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 107, "kind": "action", "text": "The mockingbird starts again, slowly.", "para": 23, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 108, "kind": "action", "text": "A petal falls on the rifle barrel.", "para": 23, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 109, "kind": "action", "text": "None of them moves to brush it off.", "para": 23, "sent": 2, "present": [0, 1, 2, 3]}]}