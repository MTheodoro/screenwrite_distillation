5]}, {"u": 10, "kind": "dialogue", "text": "The armored van arrives at six.", "name": "PHIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Six-ten.", "name": "RAFI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Six-oh-five.", "name": "DESI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Six.", "name": "PHIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "It's always late.", "name": "RAFI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Not on Thursdays.", "name": "DESI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "It's Thursday.", "name": "PHIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "It's a flower truck on Thursdays.", "name": "RAFI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "They deliver the same floor.", "name": "DESI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "They deliver at the same dock.", "name": "PHIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Different dock.", "name": "RAFI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Same dock, different door.", "name": "DESI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Children.", "name": "PHIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "They stop.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Rafi sips.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Desi shrugs.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Same dock. Same door. We hide in the roses.", "name": "PHIL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "In the roses.", "name": "RAFI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Thorns?", "name": "DESI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Dethorned.", "name": "PHIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Oh.", "name": "DESI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Desi.", "name": "RAFI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Rafi.", "name": "DESI", "speaker": 4, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "They say each other's name together.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Rafi grins.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Desi flicks the petal at him.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "It lands on the blueprint.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Five-forty. Positions.", "name": "PHIL", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "She folds the blueprint.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Slides it into her coat.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Rafi screws the lid on the thermos.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Desi pulls her headphones up.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "The compressor shudders.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "The light flickers once, then steadies.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}