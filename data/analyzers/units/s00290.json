{"scene_id": "s00290", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00290.fountain", "heading": "INT. FLOODED CHURCH CRYPT - COMMAND POST - NIGHT", "cast": [{"id": 0, "name": "MAJOR WINIFRED BAPTISTE-OKONKWO", "names": ["MAJOR WINIFRED BAPTISTE-OKONKWO", "WINIFRED"], "gender": "?", "first": 5, "spoke": 7}, {"id": 1, "name": "CAPTAIN LUCIAN HARGREAVES-DIALLO", "names": ["CAPTAIN LUCIAN HARGREAVES-DIALLO", "LUCIAN"], "gender": "?", "first": 6, "spoke": 4}, {"id": 2, "name": "STACKS", "names": ["STACKS"], "gender": "?", "first": 7, "spoke": 2}, {"id": 3, "name": "WILLOUGHBY", "names": ["WILLOUGHBY"], "gender": "?", "first": 7, "spoke": 0}, {"id": 4, "name": "LIEUTENANT SIMONE ARCHAMBAULT-TSOSIE", "names": ["LIEUTENANT SIMONE ARCHAMBAULT-TSOSIE", "SIMONE"], "gender": "?", "first": 8, "spoke": 4}, {"id": 5, "name": "CORPORAL REUBEN VASQUEZ-OLUWOLE", "names": ["CORPORAL REUBEN VASQUEZ-OLUWOLE", "REUBEN"], "gender": "m", "first": 9, "spoke": 3}, {"id": 6, "name": "COLONEL", "names": ["COLONEL"], "gender": "?", "first": 13, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. FLOODED CHURCH CRYPT - COMMAND POST - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Vaulted brick.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Knee-deep water.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A table on cinderblocks, a field telephone, three lanterns.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Mortar dust drifts down with each distant shell.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MAJOR WINIFRED BAPTISTE-OKONKWO (40s, helmet off, tired) leans over a map.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "CAPTAIN LUCIAN HARGREAVES-DIALLO (30s, bandaged forehead) sits on the table edge.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "SERGEANT EUSTACE \"STACKS\" WILLOUGHBY (50s, immense, silent) cleans a rifle.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "LIEUTENANT SIMONE ARCHAMBAULT-TSOSIE (20s, radio operator) crouches by the field telephone.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "CORPORAL REUBEN VASQUEZ-OLUWOLE (20s, sentry) watches the stairs.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "The field telephone buzzes.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "Simone grabs it.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Command post.", "name": "SIMONE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Status.", "name": "COLONEL", "speaker": 6, "ext": ["V.O."], "paren": ["over the phone, thin"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "Holding, sir. Water's rising.", "name": "SIMONE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "Hold until dawn.", "name": "COLONEL", "speaker": 6, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "Sir, they're shelling the nave.", "name": "SIMONE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "Hold until dawn, Lieutenant.", "name": "COLONEL", "speaker": 6, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "action", "text": "The line clicks.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "action", "text": "Simone lowers the receiver.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "Well?", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "Dawn.", "name": "SIMONE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "That's five hours.", "name": "LUCIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "Then we'll see five hours.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "A shell hits the church.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "action", "text": "The crypt shakes.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "action", "text": "Mortar rains.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "A lantern swings, throws shadows.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "Closer. Closer.", "name": "REUBEN", "speaker": 5, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "Let them.", "name": "STACKS", "speaker": 2, "ext": [], "paren": ["rumble"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "Winifred and Lucian step aside, water sloshing.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "They whisper over the map.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "If the north wall goes, we pull back through the ossuary.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "And if the ossuary floods?", "name": "LUCIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "Then we swim.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "A third shell, so close the lanterns gutter.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "Reuben shouts from the stairs.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "Movement! Top step!", "name": "REUBEN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "Everyone drops.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "Rifles up.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "Stacks rolls behind the table.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "Simone drags the phone under it.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "A boot appears on the stairs.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "Then a hand, empty, open.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "dialogue", "text": "Hold fire!", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "Hold fire!", "name": "LUCIAN", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "action", "text": "Nobody fires.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "A voice, thin and foreign, from the dark above.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "dialogue", "text": "Show yourself!", "name": "REUBEN", "speaker": 5, "ext": [], "paren": ["calling up"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "action", "text": "The crypt shakes one more time.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "action", "text": "Then, for the first time in hours, silence.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "dialogue", "text": "That's the barrage ending.", "name": "STACKS", "speaker": 2, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "action", "text": "Dust settles.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "action", "text": "Water stills.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "action", "text": "Reuben lowers his rifle at last.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "dialogue", "text": "Stand down. Rest in shifts.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": ["to the whole crypt"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "dialogue", "text": "Dawn?", "name": "LUCIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "dialogue", "text": "Dawn.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "action", "text": "She turns to the map and does not look back at the stairs.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}]}