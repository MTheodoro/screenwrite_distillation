{"scene_id": "s00291", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00291.fountain", "heading": "INT. SERVICE ELEVATOR - GRAND HOTEL - DAY", "cast": [{"id": 0, "name": "BERNADETTE QUARLES-IBARRA", "names": ["BERNADETTE QUARLES-IBARRA", "BERNADETTE"], "gender": "f", "first": 3, "spoke": 3}, {"id": 1, "name": "FERDIE", "names": ["FERDIE"], "gender": "?", "first": 4, "spoke": 3}, {"id": 2, "name": "ACHTERBERG-LOWE", "names": ["ACHTERBERG-LOWE"], "gender": "?", "first": 4, "spoke": 0}, {"id": 3, "name": "KWABENA OSEI-DRUMMOND", "names": ["KWABENA OSEI-DRUMMOND", "KWABENA"], "gender": "?", "first": 5, "spoke": 2}, {"id": 4, "name": "LOTTIE FAIRCHILD-NAKAMURA", "names": ["LOTTIE FAIRCHILD-NAKAMURA", "LOTTIE"], "gender": "f", "first": 6, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. SERVICE ELEVATOR - GRAND HOTEL - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A brass box, six feet square, smelling of lilies.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "In the center, a four-tier wedding cake on a rolling cart, wrapped in plastic like a fragile patient.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "BERNADETTE QUARLES-IBARRA (50s, caterer's apron, clipboard) presses herself against the left wall.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "FERDINAND \"FERDIE\" ACHTERBERG-LOWE (60s, tuxedo, bow tie slightly crooked) holds the right.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 5, "kind": "action", "text": "KWABENA OSEI-DRUMMOND (20s, bellhop pillbox hat) guards the buttons.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "action", "text": "LOTTIE FAIRCHILD-NAKAMURA (8, flower girl, wreath of daisies) sits cross-legged on the floor beside the cart, eating a rose off the top tier.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "action", "text": "The elevator lurches.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "Everyone freezes.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "The cake sways.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Bernadette's clipboard drops.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Ferdie's hand shoots out to steady the cart.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Kwabena stabs three buttons at once.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Lottie licks icing off her wrist.", "para": 2, "sent": 6, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "The lift hums, hangs, hums again.", "para": 2, "sent": 7, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Is it stuck?", "name": "FERDIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "It is not stuck.", "name": "BERNADETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "It's thinking.", "name": "KWABENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Can I have the other rose?", "name": "LOTTIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "No.", "name": "BERNADETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Yes.", "name": "FERDIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Sir, with respect, it's her cake.", "name": "KWABENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "It's my daughter's cake, and my granddaughter's rose.", "name": "FERDIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "That rose is sixty dollars.", "name": "BERNADETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "It tastes like soap.", "name": "LOTTIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "The elevator drops six inches.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "The top tier slides.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Four hands lunge.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "The cake settles.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Nobody breathes.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Ferdie wipes a smear of frosting from his lapel and holds out his hand, palm up, to Bernadette.", "para": 3, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "She looks at it.", "para": 3, "sent": 6, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Then she hands him a plastic fork.", "para": 3, "sent": 7, "present": [0, 1, 2, 3, 4]}]}