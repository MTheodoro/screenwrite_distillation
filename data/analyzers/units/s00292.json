{"scene_id": "s00292", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00292.fountain", "heading": "INT. FUNERAL PARLOR - VIEWING ROOM - NIGHT", "cast": [{"id": 0, "name": "JO", "names": ["JO"], "gender": "?", "first": 4, "spoke": 1}, {"id": 1, "name": "ADEBAYO-KRUSE", "names": ["ADEBAYO-KRUSE"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "MALACHI TREVELYAN-SHAW", "names": ["MALACHI TREVELYAN-SHAW"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "VOICE", "names": ["VOICE"], "gender": "?", "first": 19, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. FUNERAL PARLOR - VIEWING ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Folding chairs.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Carnations in a wire stand.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A closed casket, brass handles dull.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "JOSEPHINE \"JO\" ADEBAYO-KRUSE (40s, black coat, sunglasses she doesn't remove) sits in the front row.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "She does not turn when the door opens.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "MALACHI TREVELYAN-SHAW (50s, black suit, damp at the shoulders) stands in the doorway.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "He holds a small paper bag.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "He walks the aisle.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Sits two chairs from her.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Sets the bag on the empty seat between them.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "She looks at it.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Doesn't touch it.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "A phone rings in her coat.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "She lets it go three rings.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "He watches her hand.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "She takes it out.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Answers.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Holds it between them on speaker.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Is he there?", "name": "VOICE", "speaker": 3, "ext": ["V.O."], "paren": ["over the phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "He's here.", "name": "JO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Then you know.", "name": "VOICE", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "She says nothing.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Her thumb moves along the edge of the phone.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "He leans his elbows on his knees and looks at the casket.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Open the bag.", "name": "VOICE", "speaker": 3, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "She doesn't.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "He does.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Takes out a single brass key.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Holds it up to the lamp.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "The key turns slowly on its string.", "para": 8, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "That's the end of it.", "name": "VOICE", "speaker": 3, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Jo hangs up.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Slips the phone back in her coat.", "para": 9, "sent": 1, "present": [1, 2, 3]}, {"u": 34, "kind": "action", "text": "She takes the key from his fingers, and for a moment their hands stay together.", "para": 9, "sent": 2, "present": [1, 2, 3]}, {"u": 35, "kind": "action", "text": "She stands.", "para": 10, "sent": 0, "present": [1, 2, 3]}, {"u": 36, "kind": "action", "text": "Smooths her coat.", "para": 10, "sent": 1, "present": [1, 2, 3]}, {"u": 37, "kind": "action", "text": "He stays seated.", "para": 10, "sent": 2, "present": [1, 2, 3]}, {"u": 38, "kind": "action", "text": "She walks to the casket and lays the key on the lid, beside the carnations.", "para": 10, "sent": 3, "present": [1, 2, 3]}, {"u": 39, "kind": "action", "text": "At the door she stops.", "para": 11, "sent": 0, "present": [1, 2, 3]}, {"u": 40, "kind": "action", "text": "He still hasn't looked at her.", "para": 11, "sent": 1, "present": [1, 2, 3]}, {"u": 41, "kind": "action", "text": "She goes out, and he sits on, staring at the key.", "para": 11, "sent": 2, "present": [1, 2, 3]}]}