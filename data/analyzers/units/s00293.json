{"scene_id": "s00293", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00293.fountain", "heading": "INT. COMMUNITY CENTER BASEMENT - FOLDING-CHAIR CIRCLE - NIGHT", "cast": [{"id": 0, "name": "DOLLIE", "names": ["DOLLIE"], "gender": "?", "first": 4, "spoke": 9}, {"id": 1, "name": "ENGSTROM-ACHEBE", "names": ["ENGSTROM-ACHEBE"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "CORNELL BEAUMONT-ASANTE", "names": ["CORNELL BEAUMONT-ASANTE", "CORNELL"], "gender": "m", "first": 5, "spoke": 8}, {"id": 3, "name": "YASMINE KOWALSKI-HADDAD", "names": ["YASMINE KOWALSKI-HADDAD", "YASMINE"], "gender": "f", "first": 6, "spoke": 6}, {"id": 4, "name": "TIBERIUS FAIRWEATHER-MWANGI", "names": ["TIBERIUS FAIRWEATHER-MWANGI", "TIBERIUS"], "gender": "m", "first": 7, "spoke": 7}, {"id": 5, "name": "HARPER DELACROIX-YAMAMOTO", "names": ["HARPER DELACROIX-YAMAMOTO", "HARPER"], "gender": "?", "first": 8, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. COMMUNITY CENTER BASEMENT - FOLDING-CHAIR CIRCLE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A low-ceilinged room with a linoleum floor and a coffee urn that has been warm since 1994.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Posters of tide pools on cinderblock walls.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Five chairs in a circle, one empty.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "FACILITATOR DOLORES \"DOLLIE\" ENGSTROM-ACHEBE (60s, cardigan, kind eyes, a voice trained to be even) sits with a clipboard on her knee.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "CORNELL BEAUMONT-ASANTE (40s, mechanic's hands scrubbed pink, work shirt with his name stitched on) grips a paper cup.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "YASMINE KOWALSKI-HADDAD (30s, scrubs, hair coming loose, eyes bright with no sleep) sits with her feet tucked under her.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "OLD MR. TIBERIUS FAIRWEATHER-MWANGI (80s, tweed cap in his lap, hearing aid whistling softly) leans on a cane.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "HARPER DELACROIX-YAMAMOTO (17, hoodie, earbuds around neck) has chosen the chair nearest the door.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "Thank you for coming. Who would like to start?", "name": "DOLLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "I'll start.", "name": "CORNELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Thank you, Cornell.", "name": "DOLLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "My wife used to say I never talked. Said I could run a whole day on three words. Truth is I just never knew where to put the rest of them.", "name": "CORNELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "That's me with my mother. Eleven years of silence in the same kitchen.", "name": "YASMINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "And now she's gone.", "name": "CORNELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "And now the kitchen's loud.", "name": "YASMINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "What's that?", "name": "TIBERIUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "She says the kitchen's loud, Tiberius.", "name": "DOLLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Mine's the opposite. Mine hums. The refrigerator hums so much I think it's her.", "name": "TIBERIUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "That's not weird.", "name": "HARPER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "It's a bit weird, young man.", "name": "TIBERIUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "I'm not a man.", "name": "HARPER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Young person, then. Forgive me.", "name": "TIBERIUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "It's fine.", "name": "HARPER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Harper, would you like to share?", "name": "DOLLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "No.", "name": "HARPER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "That's all right.", "name": "DOLLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Okay, maybe.", "name": "HARPER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "A long pause.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "The urn gurgles.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "My dad's phone still gets texts. I read them sometimes. People tell him about their day. I don't know why I keep reading.", "name": "HARPER", "speaker": 5, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "You keep him company.", "name": "YASMINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "He's not there.", "name": "HARPER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Neither's my mother, and I still set two cups.", "name": "YASMINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Two cups.", "name": "CORNELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Every morning.", "name": "YASMINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "I do that with the truck. I leave the passenger seat clear.", "name": "CORNELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "What for?", "name": "TIBERIUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "In case.", "name": "CORNELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Ah.", "name": "TIBERIUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "It's a good thing, to leave room.", "name": "DOLLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Is it?", "name": "CORNELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "I think so. I leave a chair in this circle every week. For whoever isn't here yet.", "name": "DOLLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "That's why there's an empty one.", "name": "HARPER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "That's why.", "name": "DOLLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "It's not empty. My Winnie sits there.", "name": "TIBERIUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "Nobody laughs.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "Mine too.", "name": "CORNELL", "speaker": 2, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "Mine's in the kitchen.", "name": "YASMINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "Mine's on the phone.", "name": "HARPER", "speaker": 5, "ext": [], "paren": ["very quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "Then we're full tonight.", "name": "DOLLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}