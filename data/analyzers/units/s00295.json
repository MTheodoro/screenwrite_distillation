{"scene_id": "s00295", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00295.fountain", "heading": "INT. PARKING STRUCTURE ROOFTOP - DAWN", "cast": [{"id": 0, "name": "LEONIE ASANTEWAA-VOGEL", "names": ["LEONIE ASANTEWAA-VOGEL", "LEONIE"], "gender": "?", "first": 4, "spoke": 8}, {"id": 1, "name": "RETTA", "names": ["RETTA"], "gender": "f", "first": 6, "spoke": 8}, {"id": 2, "name": "OKOYE-BLOOM", "names": ["OKOYE-BLOOM"], "gender": "?", "first": 6, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. PARKING STRUCTURE ROOFTOP - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A rental van.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Two women lean on its bumper.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Between them, a gym bag.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LEONIE ASANTEWAA-VOGEL (40s, bomber jacket) lights a cigarette.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her hands are steady.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "MARGUERETTA \"RETTA\" OKOYE-BLOOM (30s, hoodie) watches the sun come up over a gray city.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Leonie offers the pack.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Retta shakes her head.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "You hungry?", "name": "LEONIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "No.", "name": "RETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "You should eat.", "name": "LEONIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Later.", "name": "RETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Leonie drags on the cigarette.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Looks at the bag.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "She wanted it split three ways.", "name": "LEONIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "She wanted a lot of things.", "name": "RETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "She called me last night.", "name": "LEONIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "She called me, too.", "name": "RETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "A pigeon lands on the van roof.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Walks the length of it.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "She said she was sorry.", "name": "LEONIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "She said that to me, too.", "name": "RETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Leonie flicks the ash.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Retta stares at her shoes.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Nobody's coming.", "name": "LEONIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "I know.", "name": "RETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "So we could just go.", "name": "LEONIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "We could.", "name": "RETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Neither moves.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The pigeon takes off.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Retta bends.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Unzips the bag a few inches.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Looks.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Zips it shut.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "She hands the strap to Leonie, and Leonie takes it, and for a moment neither lets go.", "para": 8, "sent": 4, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Which way?", "name": "LEONIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "You pick.", "name": "RETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Leonie opens the van door.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Retta gets in.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Leonie follows.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "They sit with the engine off and the sun on the windshield.", "para": 9, "sent": 3, "present": [0, 1, 2]}]}