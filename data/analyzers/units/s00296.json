{"scene_id": "s00296", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00296.fountain", "heading": "INT. NIGHT FERRY, LOWER CAR DECK - NIGHT", "cast": [{"id": 0, "name": "LORCAN BRENNAN-OSEI", "names": ["LORCAN BRENNAN-OSEI", "LORCAN"], "gender": "?", "first": 5, "spoke": 14}, {"id": 1, "name": "NELLWYN PRYCE-ADEYEMI", "names": ["NELLWYN PRYCE-ADEYEMI", "NELLWYN"], "gender": "?", "first": 6, "spoke": 10}, {"id": 2, "name": "TAD", "names": ["TAD"], "gender": "?", "first": 7, "spoke": 11}, {"id": 3, "name": "MBEKI-LINDEN", "names": ["MBEKI-LINDEN"], "gender": "?", "first": 7, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT FERRY, LOWER CAR DECK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Rows of parked cars.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Chains rattle.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Fog presses on the stern gate.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single fluorescent tube hums over three folding chairs where the deckhands drink coffee.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LORCAN BRENNAN-OSEI (50s, deckhand) pours from a thermos.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "NELLWYN PRYCE-ADEYEMI (20s, new hire, hi-vis vest) sits on the chair edge.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "THADDEUS \"TAD\" MBEKI-LINDEN (60s, captain's patch on his sleeve) rubs his eyes.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "You hear that?", "name": "LORCAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Hear what?", "name": "NELLWYN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Knocking.", "name": "LORCAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Engine.", "name": "TAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Not the engine. Knocking. Under us.", "name": "LORCAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Under the deck?", "name": "NELLWYN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Under the hull.", "name": "LORCAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Lorcan, it's the sea.", "name": "TAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "The sea doesn't knock three times.", "name": "LORCAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Maybe it's a buoy.", "name": "NELLWYN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Maybe it's a buoy.", "name": "TAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "It's not a buoy.", "name": "LORCAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Then what is it?", "name": "TAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Last crossing, it knocked four times. Before that, five.", "name": "LORCAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Counting down?", "name": "NELLWYN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Counting something.", "name": "LORCAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Stop frightening the girl.", "name": "TAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "I'm not frightened.", "name": "NELLWYN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Then you've not been listening.", "name": "TAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Three. That's three. Tonight it's three.", "name": "LORCAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "And after three?", "name": "NELLWYN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Two, one.", "name": "LORCAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "And after one?", "name": "NELLWYN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "That's what I'm asking him.", "name": "LORCAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "After one, we don't dock.", "name": "TAD", "speaker": 2, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Silence.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "The fluorescent tube flickers.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "The fog at the stern gate seems to lean.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "That's a joke.", "name": "NELLWYN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "It's a rule. My father taught me. When it counts down to one, you turn the ship around.", "name": "TAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Tonight is three.", "name": "NELLWYN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Tonight is three.", "name": "LORCAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Then pray for a long crossing.", "name": "TAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "A single knock, soft, from under the deck.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "That was two.", "name": "NELLWYN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "That was two.", "name": "LORCAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Turn her around.", "name": "TAD", "speaker": 2, "ext": [], "paren": ["barely"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Captain?", "name": "LORCAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Turn. Her. Around.", "name": "TAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}