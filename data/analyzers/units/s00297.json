{"scene_id": "s00297", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00297.fountain", "heading": "INT. COLD-STORAGE LOCKER, FISH MARKET - NIGHT", "cast": [{"id": 0, "name": "DEL", "names": ["DEL"], "gender": "f", "first": 6, "spoke": 8}, {"id": 1, "name": "OKONKWO-REYES", "names": ["OKONKWO-REYES"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "TOBY", "names": ["TOBY"], "gender": "f", "first": 7, "spoke": 8}, {"id": 3, "name": "HARLAN-AMADI", "names": ["HARLAN-AMADI"], "gender": "?", "first": 7, "spoke": 0}, {"id": 4, "name": "SABINE ROUSSEAU-ADEKUNLE", "names": ["SABINE", "SABINE ROUSSEAU-ADEKUNLE"], "gender": "m", "first": 37, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. COLD-STORAGE LOCKER, FISH MARKET - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Steel racks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Crates of ice.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Breath fogging.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A swinging bulb.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Two figures wedge the door shut with a pry bar.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "DELPHINE \"DEL\" OKONKWO-REYES (30s, rubber apron) shoves a crate against it.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "TOBIAS \"TOBY\" HARLAN-AMADI (50s, flannel, grizzled) leans on the bar, panting.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Something THUDS on the other side of the door.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Once.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Is it holding?", "name": "DEL", "speaker": 0, "ext": [], "paren": ["to Toby"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "It's holding.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "THUD.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "The door shivers.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Okay. Okay. Don't scream.", "name": "DEL", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Nobody make a sound.", "name": "TOBY", "speaker": 2, "ext": [], "paren": ["to the whole locker"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Who are you talking to?", "name": "DEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Habit.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Ice drips.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "The bulb sways.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "How long?", "name": "DEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Till morning crew.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "That's six hours.", "name": "DEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Then we wait six hours.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Another THUD.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Dents the steel.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Del backs away.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Her heel hits a crate.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Cold light flickers across her face.", "para": 7, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "It's only the compressor.", "name": "DEL", "speaker": 0, "ext": [], "paren": ["whispering, to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "That's not the compressor.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "The bulb goes out.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Darkness.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Breathing.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "A slow, wet scraping from the far end of the locker.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "From the dark: a voice, gentle.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Del?", "name": "SABINE", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Del freezes.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Toby grabs her sleeve.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Don't.", "name": "TOBY", "speaker": 2, "ext": [], "paren": ["mouthing"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Del, it's me. Open the door.", "name": "SABINE", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Sabine?", "name": "DEL", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "The bulb flares.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "At the end of the aisle, in the white fog, stands SABINE ROUSSEAU-ADEKUNLE (30s, same apron as Del, hair wet, lips blue).", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "She smiles.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Her feet do not touch the floor.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Del makes a small sound.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Toby heaves the pry bar up like a club.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Oh, don't be afraid. I've come to warm up.", "name": "SABINE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "She drifts forward.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "The ice on the racks cracks.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Frost races up the walls.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "Stay back!", "name": "TOBY", "speaker": 2, "ext": [], "paren": ["to Sabine"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "She's dead! She drowned in March!", "name": "DEL", "speaker": 0, "ext": [], "paren": ["to Toby"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "Del.", "name": "SABINE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "She extends a hand.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "Del's breath stops.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Toby swings the bar.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "It passes through Sabine and rings against a steel rack.", "para": 14, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "Sabine looks at him, hurt.", "para": 14, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "That wasn't kind.", "name": "SABINE", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "The THUD on the door comes a third time and the door bursts open on the rush of morning crew: sunlight, shouting.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "Sabine vanishes in the light like breath on glass.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "Toby drops the bar.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "Del falls to her knees.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "The ice on the racks begins, quietly, to melt.", "para": 16, "sent": 2, "present": [0, 1, 2, 3, 4]}]}