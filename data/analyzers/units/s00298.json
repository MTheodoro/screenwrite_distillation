{"scene_id": "s00298", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00298.fountain", "heading": "INT. CALL CENTER - COMPLAINTS DEPARTMENT - DAY", "cast": [{"id": 0, "name": "CYPRIAN OYELARAN-BLOOM", "names": ["CYPRIAN OYELARAN-BLOOM", "CYPRIAN"], "gender": "m", "first": 4, "spoke": 8}, {"id": 1, "name": "AGGIE", "names": ["AGGIE"], "gender": "?", "first": 5, "spoke": 9}, {"id": 2, "name": "VANTERPOOL-NKEMELU", "names": ["VANTERPOOL-NKEMELU"], "gender": "?", "first": 5, "spoke": 0}, {"id": 3, "name": "MOE", "names": ["MOE"], "gender": "?", "first": 6, "spoke": 3}, {"id": 4, "name": "LINDQVIST-SANTOS", "names": ["LINDQVIST-SANTOS"], "gender": "?", "first": 6, "spoke": 0}, {"id": 5, "name": "ROSAMUND FEATHERSTONE-ABIOLA", "names": ["ROSAMUND FEATHERSTONE-ABIOLA", "ROSAMUND"], "gender": "?", "first": 7, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. CALL CENTER - COMPLAINTS DEPARTMENT - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Cubicles.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Headsets.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A banner reads \"WE LISTEN!\" in sagging letters.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CYPRIAN OYELARAN-BLOOM (30s, headset askew) slams his desk.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "AGATHA \"AGGIE\" VANTERPOOL-NKEMELU (50s, supervisor, cardigan, mug that says WORLD'S OKAYEST BOSS) strides over.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "MORDECAI \"MOE\" LINDQVIST-SANTOS (20s, intern, tie too wide) trails behind her with a notepad.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "action", "text": "ROSAMUND FEATHERSTONE-ABIOLA (60s, a customer) is audible only through the headset.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "dialogue", "text": "Ma'am, I understand.", "name": "CYPRIAN", "speaker": 0, "ext": [], "paren": ["into mic"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "You do NOT understand!", "name": "ROSAMUND", "speaker": 5, "ext": ["V.O."], "paren": ["tinny, furious"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Ma'am, the toaster is under warranty.", "name": "CYPRIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "It exploded!", "name": "ROSAMUND", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Ma'am, \"exploded\" is not a covered event.", "name": "CYPRIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Cyprian. Hold.", "name": "AGGIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "She says it exploded.", "name": "CYPRIAN", "speaker": 0, "ext": [], "paren": ["muting"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Did it?", "name": "AGGIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "She sent a photo.", "name": "CYPRIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "He tilts the monitor.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "A blackened ceiling, a toast-shaped hole.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Is that a toast-shaped hole?", "name": "MOE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Moe, take a note.", "name": "AGGIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "What note?", "name": "MOE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "\"Do not tell her it is covered.\"", "name": "AGGIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Why not?", "name": "MOE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Because then we'd owe her a ceiling.", "name": "AGGIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Cyprian unmutes.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Ma'am, we are going to send you a brand-new toaster.", "name": "CYPRIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "A TOASTER?", "name": "ROSAMUND", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "A better toaster.", "name": "CYPRIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "I want a ceiling!", "name": "ROSAMUND", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Aggie snatches the headset off Cyprian.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Puts it on.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Smiles at the monitor.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Mrs. Featherstone-Abiola, it's Agatha. Have you tried the hat?", "name": "AGGIE", "speaker": 1, "ext": [], "paren": ["sweetly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "...What hat?", "name": "ROSAMUND", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "The complimentary hat.", "name": "AGGIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "A pause.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Moe and Cyprian stare at her.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Is it a nice hat?", "name": "ROSAMUND", "speaker": 5, "ext": ["V.O."], "paren": ["softening"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "It's a very nice hat.", "name": "AGGIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "She hangs up.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Takes off the headset.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Cyprian and Moe watch her like she has levitated.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "There's no hat.", "name": "CYPRIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Moe. Find a hat.", "name": "AGGIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}