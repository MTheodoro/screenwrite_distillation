{"scene_id": "s00300", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00300.fountain", "heading": "INT. OBSERVATION CAR, MOUNTAIN SCENIC RAILWAY - SUNSET", "cast": [{"id": 0, "name": "WOMAN", "names": ["WOMAN"], "gender": "f", "first": 4, "spoke": 4}, {"id": 1, "name": "THE STRANGER", "names": ["STRANGER", "THE STRANGER"], "gender": "?", "first": 7, "spoke": 5}, {"id": 2, "name": "ANSELM", "names": ["ANSELM"], "gender": "?", "first": 22, "spoke": 6}, {"id": 3, "name": "PHILIPPA", "names": ["PHILIPPA"], "gender": "?", "first": 24, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. OBSERVATION CAR, MOUNTAIN SCENIC RAILWAY - SUNSET", "present": []}, {"u": 1, "kind": "action", "text": "A glass-domed car, brass fittings polished to honey.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Plush velvet seats.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Outside, peaks go violet under a rose-colored sky.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A WOMAN sits alone by the window, a travel journal on her knee.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Mid-thirties, silk scarf, auburn hair pinned with a tortoiseshell comb.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "She writes, and stops, and watches the mountains.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "A STRANGER enters from the vestibule: a tall man, forties, tweed jacket, a camera on a strap.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He pauses at her row.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Is this seat taken?", "name": "THE STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "There are forty empty seats.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I know. I counted.", "name": "THE STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She almost smiles.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He sits across the aisle, not beside.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Lifts the camera, lowers it again.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "The light's gone before I can catch it. Always.", "name": "THE STRANGER", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Then stop catching it.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "And do what?", "name": "THE STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Look at it.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He looks.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "A long beat.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "The train curves, and the whole western sky tilts into the car.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "My name is Anselm.", "name": "THE STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Anselm Whitcombe-Diallo.", "name": "ANSELM", "speaker": 2, "ext": [], "paren": ["correcting himself"], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Philippa Okoro-Strand.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Philippa. That's a good mountain name.", "name": "ANSELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Is there such a thing?", "name": "PHILIPPA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "There is now.", "name": "ANSELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "The train rocks gently through a tunnel and out again.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Do you travel often?", "name": "PHILIPPA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Only when I've lost something.", "name": "ANSELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "What did you lose?", "name": "PHILIPPA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "I'm hoping the mountains will tell me.", "name": "ANSELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "They don't talk.", "name": "PHILIPPA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "They don't need to.", "name": "ANSELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "She closes her journal.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "The sky goes from rose to lavender.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Neither of them speaks, and neither looks away.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}]}