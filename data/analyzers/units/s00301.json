{"scene_id": "s00301", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00301.fountain", "heading": "INT. BALLROOM CLOAKROOM - ART DECO HOTEL - NIGHT", "cast": [{"id": 0, "name": "WOMAN IN SAPPHIRE", "names": ["WOMAN", "WOMAN IN SAPPHIRE", "WOMAN IN SILVER"], "gender": "?", "first": 4, "spoke": 12}, {"id": 1, "name": "OTTOLINE", "names": ["OTTOLINE"], "gender": "f", "first": 31, "spoke": 2}, {"id": 2, "name": "MARGUERITE", "names": ["MARGUERITE"], "gender": "?", "first": 33, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. BALLROOM CLOAKROOM - ART DECO HOTEL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A narrow room of brass hooks and furs.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single frosted lamp.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Muffled orchestra through the wall.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A WOMAN in a sapphire gown leans against the counter, breathing hard.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her lipstick is smeared.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Her hand grips a champagne flute so tightly it might break.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "The attendant's stool is empty.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "The door opens.", "para": 3, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Another WOMAN steps in, in a silver gown, a fur stole over one arm.", "para": 3, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "She closes the door behind her.", "para": 3, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "Locks it.", "para": 3, "sent": 3, "present": [0]}, {"u": 12, "kind": "dialogue", "text": "You followed me.", "name": "WOMAN IN SAPPHIRE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 13, "kind": "dialogue", "text": "You left your wrap.", "name": "WOMAN IN SILVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 14, "kind": "action", "text": "She holds out a stole.", "para": 4, "sent": 0, "present": [0]}, {"u": 15, "kind": "action", "text": "The woman in sapphire stares at it.", "para": 4, "sent": 1, "present": [0]}, {"u": 16, "kind": "action", "text": "Doesn't take it.", "para": 4, "sent": 2, "present": [0]}, {"u": 17, "kind": "dialogue", "text": "I said I wouldn't dance.", "name": "WOMAN IN SAPPHIRE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 18, "kind": "dialogue", "text": "You danced with him.", "name": "WOMAN IN SILVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 19, "kind": "dialogue", "text": "She asked.", "name": "WOMAN IN SAPPHIRE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 20, "kind": "dialogue", "text": "She did?", "name": "WOMAN IN SILVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 21, "kind": "action", "text": "The sapphire woman sets the flute down.", "para": 5, "sent": 0, "present": [0]}, {"u": 22, "kind": "action", "text": "It rings on the marble.", "para": 5, "sent": 1, "present": [0]}, {"u": 23, "kind": "dialogue", "text": "Constance asked me for the third waltz. In front of everyone. I couldn't say no.", "name": "WOMAN IN SAPPHIRE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 24, "kind": "dialogue", "text": "Of course you could.", "name": "WOMAN IN SILVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 25, "kind": "dialogue", "text": "She's my cousin.", "name": "WOMAN IN SAPPHIRE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 26, "kind": "dialogue", "text": "She's your cousin who looks at you like I do.", "name": "WOMAN IN SILVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 27, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0]}, {"u": 28, "kind": "action", "text": "The orchestra swells and falls.", "para": 6, "sent": 1, "present": [0]}, {"u": 29, "kind": "action", "text": "The woman in silver steps closer and drapes the stole over her companion's shoulders.", "para": 7, "sent": 0, "present": [0]}, {"u": 30, "kind": "action", "text": "For a moment they stand with their foreheads almost touching.", "para": 7, "sent": 1, "present": [0]}, {"u": 31, "kind": "dialogue", "text": "I'm Ottoline, by the way. You never asked.", "name": "WOMAN IN SAPPHIRE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Ottoline Fairbrother-Nnamdi.", "name": "OTTOLINE", "speaker": 1, "ext": [], "paren": ["softer"], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Marguerite.", "name": "WOMAN IN SILVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Marguerite, I'm terrified.", "name": "OTTOLINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Good. So am I.", "name": "MARGUERITE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "A knock at the door.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "They break apart.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Ottoline wipes her lipstick.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Marguerite unlocks the door and opens it on the roar of the band.", "para": 8, "sent": 3, "present": [0, 1, 2]}]}