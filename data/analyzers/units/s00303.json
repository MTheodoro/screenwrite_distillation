{"scene_id": "s00303", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00303.fountain", "heading": "INT. WITHERED SALON IN A CLOSED CHATEAU - 1789 - NIGHT", "cast": [{"id": 0, "name": "MADAME HORTENSE DE VALLOMBREUSE-ADEYEMI", "names": ["MADAME HORTENSE DE VALLOMBREUSE-ADEYEMI", "HORTENSE"], "gender": "?", "first": 5, "spoke": 10}, {"id": 1, "name": "LOUIS-MARIE FONTAINE-OKOYE", "names": ["LOUIS-MARIE FONTAINE-OKOYE", "LOUIS-MARIE"], "gender": "?", "first": 10, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. WITHERED SALON IN A CLOSED CHATEAU - 1789 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A great room under dust sheets.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single candle burns on a harpsichord whose lid has been propped open with a book.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Shuttered windows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Outside, far off, a crowd murmurs like the sea.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "An old woman, MADAME HORTENSE DE VALLOMBREUSE-ADEYEMI (70s, silver silk gone gray at the hem, a ring on every finger), sits at the harpsichord.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She does not play.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She presses one key, listens to its fading note, and presses another.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "The door opens.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "A young man slips in and shuts it behind him, breathing hard.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "LOUIS-MARIE FONTAINE-OKOYE (20s, servant's livery, torn collar, a candle stub in his hand) is the last of her household.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "You are late, Louis-Marie.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Madame, the gates are down. They are in the courtyard.", "name": "LOUIS-MARIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "I heard.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Then you must come. There is a cart in the stable. I have bribed the boy.", "name": "LOUIS-MARIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "With what?", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "With your emeralds.", "name": "LOUIS-MARIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Ah. Those were never mine.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Madame, please.", "name": "LOUIS-MARIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She presses a key.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "The note hangs.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Do you know, I have lived in this house for fifty-one years and never once been alone in this room. There was always someone to carry a candle. Someone to close a shutter. Someone to watch me not play.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "I am here.", "name": "LOUIS-MARIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Yes. You are the last.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Madame, they will burn it.", "name": "LOUIS-MARIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I should hope so. It is a great deal of work to maintain.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "He kneels beside the stool.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "She does not look at him.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "The crowd's murmur swells into a roar and the candle on the harpsichord gutters.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Please. For my sake.", "name": "LOUIS-MARIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Then do this for mine. Take the candle. Go through the kitchen. Do not look back, and do not tell them you served me.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "They will know.", "name": "LOUIS-MARIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "They will know that you ran. That is enough.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "She finally turns.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Touches his face with a ringed hand, once, lightly.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Go.", "name": "HORTENSE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "He rises.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Backs away.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "At the door he stops, then bows low, deeper than any servant should.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "The door closes.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "She turns back to the keys and plays, at last, one slow chord that fills the dark room.", "para": 6, "sent": 4, "present": [0, 1]}]}