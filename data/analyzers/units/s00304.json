{"scene_id": "s00304", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00304.fountain", "heading": "INT. CURLING CLUB - LOCKER ROOM - EVENING", "cast": [{"id": 0, "name": "YOUNG WOMAN", "names": ["YOUNG WOMAN"], "gender": "f", "first": 4, "spoke": 0}, {"id": 1, "name": "HJALMAR ODUYA-KRISTENSEN", "names": ["HJALMAR ODUYA-KRISTENSEN", "HJALMAR"], "gender": "?", "first": 7, "spoke": 2}, {"id": 2, "name": "MO", "names": ["MO"], "gender": "?", "first": 10, "spoke": 3}, {"id": 3, "name": "DELACROIX-ABARA", "names": ["DELACROIX-ABARA"], "gender": "?", "first": 10, "spoke": 0}, {"id": 4, "name": "BRYNJA", "names": ["BRYNJA"], "gender": "?", "first": 29, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. CURLING CLUB - LOCKER ROOM - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Wet wool.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Steam.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The thump of stones through a wall.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A YOUNG WOMAN sits on the bench in her stocking feet, broom across her knees.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Twenties, red parka, a bruise on her cheekbone from a fall.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "She stares at nothing.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "Coach HJALMAR ODUYA-KRISTENSEN (60s, club blazer, whistle) stands at the door with a clipboard.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He does not speak.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He taps the clipboard against his thigh.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "At the far end, a veteran, MAUREEN \"MO\" DELACROIX-ABARA (40s, gray-blonde braid) tightens a boot.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "She doesn't look up either.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "The young woman bends.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Unlaces one shoe.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Laces it again.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Same shoe.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Five minutes.", "name": "HJALMAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "The young woman nods.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Leave her.", "name": "MO", "speaker": 2, "ext": [], "paren": ["to Hjalmar"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "She has a stone to throw.", "name": "HJALMAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "She has a minute.", "name": "MO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Hjalmar studies the young woman.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "She picks up the broom.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Puts it down.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Picks up a towel and presses it to her cheek.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "A horn sounds in the hallway.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Mo stands.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Offers her hand.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "The young woman looks at it, then up at her face.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Brynja.", "name": "MO", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "I'm fine.", "name": "BRYNJA", "speaker": 4, "ext": [], "paren": ["rising"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "She isn't.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "She takes the hand anyway.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Hjalmar steps aside from the door.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "The three of them walk out together, Brynja in the middle, broom over her shoulder, jaw set.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}]}