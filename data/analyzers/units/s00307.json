{"scene_id": "s00307", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00307.fountain", "heading": "INT. LAUNDROMAT - BACK TABLE - NIGHT", "cast": [{"id": 0, "name": "IGGY", "names": ["IGGY"], "gender": "?", "first": 6, "spoke": 18}, {"id": 1, "name": "OYELOWO-BRANDT", "names": ["OYELOWO-BRANDT"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "CORRIE", "names": ["CORRIE"], "gender": "?", "first": 7, "spoke": 17}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAUNDROMAT - BACK TABLE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Flat fluorescent light.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of dryers tumbling.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A folding table.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A wall of coin machines.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Two siblings, a brother and a sister, fold clothes in silence.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "IGNATIUS \"IGGY\" OYELOWO-BRANDT (30s, grease-stained flannel, hands that don't stay still) folds towels with military corners.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "CORINTHIA \"CORRIE\" OYELOWO-BRANDT (30s, nurse's clogs, tired eyes) folds a child's pajamas into a square the size of her palm.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "The machines hum.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "A dryer thumps.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "You're doing it wrong.", "name": "IGGY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "It's pajamas.", "name": "CORRIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "There's a way.", "name": "IGGY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Then show me.", "name": "CORRIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "He doesn't.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "She keeps folding.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "A quarter rattles inside a dryer.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "How's Mom?", "name": "IGGY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Tuesday she asked who you were.", "name": "CORRIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Tuesday I wasn't there.", "name": "IGGY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "She asked anyway.", "name": "CORRIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "What'd you say?", "name": "IGGY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Her son.", "name": "CORRIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Good.", "name": "IGGY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Beat.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "He takes a shirt from the pile.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Corrie, I'm sorry.", "name": "IGGY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "For what?", "name": "CORRIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "I don't know. Everything.", "name": "IGGY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "That's not an apology. That's a weather report.", "name": "CORRIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "I'm trying.", "name": "IGGY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "I know you are.", "name": "CORRIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "She folds.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "He folds.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "A buzzer sounds on a distant machine.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "I could come Sunday.", "name": "IGGY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "You said that last month.", "name": "CORRIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "I came.", "name": "IGGY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "For ten minutes.", "name": "CORRIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "It was ten good minutes.", "name": "IGGY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "It was ten minutes you spent on your phone.", "name": "CORRIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "It was the shop. A guy needed a quote.", "name": "IGGY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Iggy.", "name": "CORRIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Okay.", "name": "IGGY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "She's not going to be here forever.", "name": "CORRIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "I know.", "name": "IGGY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "You don't.", "name": "CORRIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "He stops.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Sets down the shirt.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Looks at her for the first time.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Corrie, I know.", "name": "IGGY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "She meets his eyes.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "A long beat.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Then she hands him the pajamas.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "Do it the way you said.", "name": "CORRIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "He takes them.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Unfolds.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Folds again, slowly, creasing each edge with his thumbnail.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "See?", "name": "IGGY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "That's better.", "name": "CORRIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "It's the same.", "name": "IGGY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "It's better.", "name": "CORRIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "A dryer finishes and goes quiet.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "The room hums on.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "They reach for the next pile together.", "para": 11, "sent": 2, "present": [0, 1, 2]}]}