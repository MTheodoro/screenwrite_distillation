{"scene_id": "s00308", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00308.fountain", "heading": "EXT. PIER AMUSEMENT ARCADE - NIGHT", "cast": [{"id": 0, "name": "NOVA", "names": ["NOVA"], "gender": "?", "first": 3, "spoke": 5}, {"id": 1, "name": "ABIOLA-HARTLEY", "names": ["ABIOLA-HARTLEY"], "gender": "?", "first": 3, "spoke": 0}, {"id": 2, "name": "FLISS", "names": ["FLISS"], "gender": "f", "first": 4, "spoke": 1}, {"id": 3, "name": "OKONJO-VARGA", "names": ["OKONJO-VARGA"], "gender": "?", "first": 4, "spoke": 0}, {"id": 4, "name": "WYNDHAM TIERNEY-ASARE", "names": ["WYNDHAM TIERNEY-ASARE", "WYNDHAM"], "gender": "?", "first": 5, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. PIER AMUSEMENT ARCADE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Neon, salt air, the electronic bleat of a hundred machines.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A claw crane glows at the end of a row.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "NOVELLA \"NOVA\" ABIOLA-HARTLEY (20s, sequined jacket) feeds quarters into the crane.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "Her friend FELICITY \"FLISS\" OKONJO-VARGA (20s, cardigan, two ice creams) hovers behind.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 5, "kind": "action", "text": "A stranger, WYNDHAM TIERNEY-ASARE (20s, windbreaker, a tin of tokens), waits for the machine.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 6, "kind": "action", "text": "She presses the stick.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "action", "text": "The claw descends.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "It grips a plush octopus.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "It lifts.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "It drops it.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "She groans and slaps the glass.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "He stifles a laugh.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "She turns on him.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Don't.", "name": "NOVA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "I didn't.", "name": "WYNDHAM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "You were going to.", "name": "NOVA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "I was going to say nice try.", "name": "WYNDHAM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "He slides a token into the slot.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Their eyes meet.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "She steps aside.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "He takes the stick.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "The claw descends over the octopus.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Fliss licks her ice cream.", "para": 4, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Watches them both.", "para": 4, "sent": 6, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "The claw grabs.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Lifts.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Shakes.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "The octopus swings and holds, then drops into the chute.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "It tumbles out.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "He picks it up.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Hands it to Nova.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "She takes it.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Thank you.", "name": "NOVA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "You're welcome.", "name": "WYNDHAM", "speaker": 4, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "They speak at once and laugh.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Fliss clears her throat.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "We're going to miss the Ferris wheel.", "name": "FLISS", "speaker": 2, "ext": [], "paren": ["to Nova"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Go on. I'll catch up.", "name": "NOVA", "speaker": 0, "ext": [], "paren": ["to Fliss"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Fliss shrugs.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Goes.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Nova turns to Wyndham, hugging the octopus.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "So.", "name": "NOVA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "So.", "name": "WYNDHAM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "She looks at the octopus.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "He looks at his shoes.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "A siren whoops from a driving game and someone shouts jackpot.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "She starts to speak and the lights on the pier go out.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Darkness.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "A collective moan from the arcade.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "A beat.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Then the lights return, brighter than before, and he is gone.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "She is alone with the octopus.", "para": 10, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "She looks around.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "Down the row, by the Ferris wheel entrance, he is waving.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Her ticket is in his hand.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}]}