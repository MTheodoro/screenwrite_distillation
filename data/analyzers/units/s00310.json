{"scene_id": "s00310", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00310.fountain", "heading": "INT. ORBITAL STATION \"HALCYON\" - OBSERVATION RING - SHIP NIGHT", "cast": [{"id": 0, "name": "COMMANDER YUSUF ADEWUNMI-LINDGREN", "names": ["COMMANDER YUSUF ADEWUNMI-LINDGREN", "YUSUF"], "gender": "?", "first": 3, "spoke": 4}, {"id": 1, "name": "HELENA OKONKWO-BRANDT", "names": ["HELENA OKONKWO-BRANDT", "HELENA"], "gender": "?", "first": 4, "spoke": 3}, {"id": 2, "name": "ENGINEER TOMASZ NAKASHIMA-AMADI", "names": ["ENGINEER TOMASZ NAKASHIMA-AMADI", "TOMASZ"], "gender": "m", "first": 5, "spoke": 3}, {"id": 3, "name": "TECH IRIS MBEKI-HALVORSEN", "names": ["TECH IRIS MBEKI-HALVORSEN", "IRIS"], "gender": "?", "first": 6, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. ORBITAL STATION \"HALCYON\" - OBSERVATION RING - SHIP NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A curved window onto a gray world.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Four crew in thermal suits sit at a low table around a flickering screen.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "COMMANDER YUSUF ADEWUNMI-LINDGREN (50s) speaks first.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "DR. HELENA OKONKWO-BRANDT (40s) answers.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "ENGINEER TOMASZ NAKASHIMA-AMADI (30s) interrupts.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "And the youngest, TECH IRIS MBEKI-HALVORSEN (20s), says nothing.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Final report. Oxygen reserves at eleven percent.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "That's four days.", "name": "HELENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Four days if nobody breathes.", "name": "TOMASZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Nobody's counting breaths, Tomasz.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I am.", "name": "TOMASZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Commander, the relief ship?", "name": "HELENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Nine days out.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Then we're five short.", "name": "HELENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Five.", "name": "TOMASZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "We are going to be fine.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "No, we're not.", "name": "IRIS", "speaker": 3, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "They look at her.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "She looks at the window.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "But we can say it like we are.", "name": "IRIS", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Yusuf nods.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Helena reaches across the table and takes Iris's hand.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Tomasz folds his arms and stares at the gray world turning below.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}]}