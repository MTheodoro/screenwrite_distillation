{"scene_id": "s00312", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00312.fountain", "heading": "INT. BOTANICAL GARDEN ORCHID HOUSE - MORNING", "cast": [{"id": 0, "name": "DETECTIVE SOLOMON OKAFOR-LINDQVIST", "names": ["DETECTIVE SOLOMON OKAFOR-LINDQVIST", "SOLOMON"], "gender": "m", "first": 4, "spoke": 4}, {"id": 1, "name": "CURATOR AMELIA DRUMMOND-ADEBAYO", "names": ["CURATOR AMELIA DRUMMOND-ADEBAYO", "AMELIA"], "gender": "m", "first": 7, "spoke": 5}, {"id": 2, "name": "THADDEUS BROUGHAM-ASANTE", "names": ["THADDEUS BROUGHAM-ASANTE", "THADDEUS"], "gender": "?", "first": 16, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. BOTANICAL GARDEN ORCHID HOUSE - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Humid green dim.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Mist beading on glass.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A path of wet flagstones between banks of blooms.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DETECTIVE SOLOMON OKAFOR-LINDQVIST (50s, trench coat, notebook) crouches beside an empty planter.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "A tag reads PHALAENOPSIS \"GHOST\".", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Nothing grows there.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "CURATOR AMELIA DRUMMOND-ADEBAYO (40s, cardigan, trowel in her back pocket) stands over him, arms crossed.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "When did you last see it?", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Last Thursday. Or last Wednesday.", "name": "AMELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Which?", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I water them in sequence. Thursday is the third bench.", "name": "AMELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "So Thursday.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "So Thursday.", "name": "AMELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Footsteps on the gravel.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "A young man comes round the corner at a trot, apron flapping.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "A volunteer: THADDEUS BROUGHAM-ASANTE (20s, name tag on a lanyard).", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "He freezes when he sees the detective.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Sorry. I didn't know.", "name": "THADDEUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Thaddeus. Go back to the lilies.", "name": "AMELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Yes, ma'am.", "name": "THADDEUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "He does not move.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Amelia does not look at him.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Solomon, still crouched, studies Thaddeus's hands.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "They are stained with potting soil, and a single white petal is stuck to his wrist.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Thaddeus.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Sir.", "name": "THADDEUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Thaddeus.", "name": "AMELIA", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Their voices collide on the name.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Thaddeus swallows.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "He peels the petal off his wrist and holds it out on his open palm.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "It was dying.", "name": "THADDEUS", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Amelia says nothing.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Solomon straightens slowly, closing his notebook, and in the green dim the mist begins, gently, to settle.", "para": 6, "sent": 1, "present": [0, 1, 2]}]}