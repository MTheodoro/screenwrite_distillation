{"scene_id": "s00313", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00313.fountain", "heading": "INT. DEEP-SEA HABITAT \"ABYSSAL ONE\" - MESS HALL - SHIP NIGHT", "cast": [{"id": 0, "name": "CAPTAIN DOROTHEA OKORO-VALLENTINE", "names": ["CAPTAIN DOROTHEA OKORO-VALLENTINE", "DOROTHEA"], "gender": "?", "first": 4, "spoke": 8}, {"id": 1, "name": "BART", "names": ["BART"], "gender": "?", "first": 5, "spoke": 13}, {"id": 2, "name": "LINDBERG-NWOSU", "names": ["LINDBERG-NWOSU"], "gender": "?", "first": 5, "spoke": 0}, {"id": 3, "name": "MARINE BIOLOGIST SELENE ADEBAYO-KOWALSKI", "names": ["MARINE BIOLOGIST SELENE ADEBAYO-KOWALSKI", "SELENE"], "gender": "?", "first": 6, "spoke": 8}, {"id": 4, "name": "MEDIC IGNATIUS FAIRCHILD-OSEI", "names": ["MEDIC IGNATIUS FAIRCHILD-OSEI", "IGNATIUS"], "gender": "?", "first": 7, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. DEEP-SEA HABITAT \"ABYSSAL ONE\" - MESS HALL - SHIP NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped steel cylinder, portholes black with pressure.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A galley table bolted to the floor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Four crew sit with untouched trays.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CAPTAIN DOROTHEA OKORO-VALLENTINE (50s).", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "ENGINEER BARTHOLOMEW \"BART\" LINDBERG-NWOSU (40s).", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "MARINE BIOLOGIST SELENE ADEBAYO-KOWALSKI (30s).", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "MEDIC IGNATIUS FAIRCHILD-OSEI (30s).", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "Say it again.", "name": "DOROTHEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "The hull is whispering.", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "That's metal contraction.", "name": "SELENE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "It's not contraction. It's tonal. It repeats.", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Repeats what?", "name": "IGNATIUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Seven beats. Pause. Seven beats.", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Bart, we're nine hundred meters down. Everything whispers.", "name": "SELENE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Not in sevens.", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Have you logged it?", "name": "DOROTHEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Three times. Systems say nominal.", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Maybe the systems are lying.", "name": "IGNATIUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Systems don't lie.", "name": "SELENE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "They omit.", "name": "IGNATIUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Enough. Bart, if it's not a fault, what is it?", "name": "DOROTHEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "A signal.", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "From where?", "name": "SELENE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Outside.", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "There's nothing outside.", "name": "IGNATIUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "There's a trench outside, three kilometers deep.", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Whales sing in sevens sometimes.", "name": "SELENE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Not at this depth.", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Play it.", "name": "DOROTHEA", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Captain--", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Play. It.", "name": "DOROTHEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Bart reaches under the table.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "A speaker crackles.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Over the hum of the ventilators, a low hollow knock, seven times.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "A pause.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Seven times.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "That's inside the hull.", "name": "SELENE", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "That's coming from the airlock.", "name": "IGNATIUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Who's in the airlock?", "name": "DOROTHEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Nobody.", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Nobody's in there.", "name": "IGNATIUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Then who's knocking?", "name": "SELENE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "The knocking stops.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Silence, for a full, heavy breath.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Then, from the speaker, the same seven beats, slower, and a voice, far away and fragmentary, that sounds like Selene's own.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "That's me.", "name": "SELENE", "speaker": 3, "ext": ["CONT'D"], "paren": ["barely"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "Shut it off.", "name": "DOROTHEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "I can't.", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Bartholomew.", "name": "DOROTHEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "It's not coming from the system, Captain. It's coming through the glass.", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Selene stands.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Her chair clatters.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "She backs toward the bulkhead.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "The four of them stare at the black porthole.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "On its surface, in condensation, one finger-width at a time, a handprint begins to bloom.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4]}]}