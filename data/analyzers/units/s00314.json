{"scene_id": "s00314", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00314.fountain", "heading": "INT. LAKESIDE BOATHOUSE - LATE AFTERNOON", "cast": [{"id": 0, "name": "DOSIA", "names": ["DOSIA"], "gender": "?", "first": 7, "spoke": 23}, {"id": 1, "name": "ELIAS WELLINGTON-ADEBAYO", "names": ["WELLINGTON-ADEBAYO", "ELIAS WELLINGTON-ADEBAYO", "ELIAS"], "gender": "m", "first": 7, "spoke": 16}, {"id": 2, "name": "WOMAN", "names": ["WOMAN"], "gender": "?", "first": 60, "spoke": 0}, {"id": 3, "name": "RUTH MARCHETTI-OSEI", "names": ["RUTH", "RUTH MARCHETTI-OSEI"], "gender": "f", "first": 39, "spoke": 3}, {"id": 4, "name": "PERRY", "names": ["PERRY"], "gender": "?", "first": 81, "spoke": 1}, {"id": 5, "name": "ADEKUNLE-STRAND", "names": ["ADEKUNLE-STRAND"], "gender": "?", "first": 81, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAKESIDE BOATHOUSE - LATE AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "A weathered boathouse leaning toward the water.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cedar planks gone silver.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A rowing shell hangs from the rafters on rope slings, pale as a bone.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Light slants through gaps in the boards and lies across the floor in long bars.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Dust turns in the light.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "A radio, tuned between stations, hisses faintly from the workbench.", "para": 1, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "THEODOSIA \"DOSIA\" WELLINGTON-ADEBAYO (60s, a man's cardigan over a housedress, hair tied up with a bootlace) sits on an overturned bucket, sanding the oar of a long-dead husband.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She works with patient, practiced strokes.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "She has done this every autumn for thirty years.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "ELIAS WELLINGTON-ADEBAYO (30s, city coat, rental-car keys on his finger) stands at the threshold.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He has not stepped inside.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "His shoes are wrong for the planks.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Mama.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "You're late.", "name": "DOSIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Traffic.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "There's no traffic on the lake road.", "name": "DOSIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "There was a deer.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She sands.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "The oar's grain comes up gold under her thumb.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "You came to talk about the house.", "name": "DOSIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "I came to see you.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Yes. And to talk about the house.", "name": "DOSIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "He steps in at last.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "The floorboards give a long, low groan.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "He looks at the shell above him.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Reaches up.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Does not quite touch it.", "para": 5, "sent": 4, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "It's still here.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Where would it go?", "name": "DOSIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Dad would've sold it.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Your father would have rowed it into the lake and kept going.", "name": "DOSIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Mama.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "I'm only saying.", "name": "DOSIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "She finally looks up.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Studies his face.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "His coat.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "His keys.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "You look like a man who's been told to be gentle.", "name": "DOSIA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Ruth thinks--", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 40, "kind": "dialogue", "text": "Ruth thinks a great many things from three states away.", "name": "DOSIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 41, "kind": "dialogue", "text": "She thinks you should come stay with us.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 42, "kind": "dialogue", "text": "In an apartment.", "name": "DOSIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 43, "kind": "dialogue", "text": "A good apartment.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 44, "kind": "dialogue", "text": "Elias.", "name": "DOSIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 45, "kind": "dialogue", "text": "Mama, the stairs. The pipes. Winter.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 46, "kind": "action", "text": "She sets down the sandpaper.", "para": 7, "sent": 0, "present": [0, 1, 3]}, {"u": 47, "kind": "action", "text": "Brushes dust off her knee with a slow hand.", "para": 7, "sent": 1, "present": [0, 1, 3]}, {"u": 48, "kind": "dialogue", "text": "Tell me, did you ever once, as a boy, carry that oar?", "name": "DOSIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 49, "kind": "dialogue", "text": "Once.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 50, "kind": "dialogue", "text": "And?", "name": "DOSIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 51, "kind": "dialogue", "text": "I dropped it.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 52, "kind": "dialogue", "text": "Into the lake.", "name": "DOSIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 53, "kind": "dialogue", "text": "Dad had to swim for it.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 54, "kind": "dialogue", "text": "He was furious.", "name": "DOSIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 55, "kind": "dialogue", "text": "He was laughing.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 56, "kind": "dialogue", "text": "Both things can be true.", "name": "DOSIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 57, "kind": "action", "text": "The radio hisses.", "para": 8, "sent": 0, "present": [0, 1, 3]}, {"u": 58, "kind": "action", "text": "A gull cries somewhere over the water.", "para": 8, "sent": 1, "present": [0, 1, 3]}, {"u": 59, "kind": "action", "text": "Elias sinks onto a coil of rope, and the boathouse tilts a little, and holds.", "para": 8, "sent": 2, "present": [0, 1, 3]}, {"u": 60, "kind": "action", "text": "A WOMAN's voice calls from the dock outside, bright and brisk.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "Elias? Is she in there?", "name": "RUTH", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "Elias closes his eyes.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "Dosia's mouth thins.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "She picks up the sandpaper.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "You brought her.", "name": "DOSIA", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "She drove. I didn't know--", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "Of course you didn't.", "name": "DOSIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "RUTH MARCHETTI-OSEI (30s, parka, a folder under her arm) steps into the doorway, silhouetted against the lake.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "She sees the shell above them, the oar in Dosia's lap, and the quiet.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "She stops.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "dialogue", "text": "Oh. I'm interrupting.", "name": "RUTH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "Yes.", "name": "DOSIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "I'll wait outside.", "name": "RUTH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "dialogue", "text": "You'll come in. And you'll stand where I can see you.", "name": "DOSIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "Ruth does.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "The three of them make an awkward triangle on the creaking floor.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "The light bars stretch across their feet.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "dialogue", "text": "Now. Which of you is going to tell me the real reason you're here?", "name": "DOSIA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "action", "text": "Neither answers.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "action", "text": "The radio hisses between stations.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "action", "text": "A small figure appears at the water door at the back: PEREGRINE \"PERRY\" ADEKUNLE-STRAND (10, wet to the knees, a bucket of minnows).", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 82, "kind": "action", "text": "He stops, takes in the three adults, and decides to be invisible.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 83, "kind": "dialogue", "text": "Perry. Put the minnows in the trough.", "name": "DOSIA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 84, "kind": "dialogue", "text": "Yes, Miss Dosia.", "name": "PERRY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 85, "kind": "action", "text": "He tiptoes past them to the trough, pours, and tiptoes out the way he came.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 86, "kind": "dialogue", "text": "Then I'll finish the oar.", "name": "DOSIA", "speaker": 0, "ext": ["CONT'D"], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 87, "kind": "action", "text": "She resumes sanding.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 88, "kind": "action", "text": "Slow, rhythmic, patient.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 89, "kind": "action", "text": "Elias watches his mother's hands.", "para": 16, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 90, "kind": "action", "text": "Ruth watches Elias.", "para": 16, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 91, "kind": "action", "text": "And the shell hangs above them like a held breath.", "para": 16, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}]}