{"scene_id": "s00315", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00315.fountain", "heading": "INT. ARMORED PARKING GARAGE, P4 - NIGHT", "cast": [{"id": 0, "name": "VIC", "names": ["VIC"], "gender": "?", "first": 4, "spoke": 8}, {"id": 1, "name": "ODUYA-LINDGREN", "names": ["ODUYA-LINDGREN"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "ANNA", "names": ["ANNA"], "gender": "?", "first": 5, "spoke": 6}, {"id": 3, "name": "BRAITHWAITE-NKOSI", "names": ["BRAITHWAITE-NKOSI"], "gender": "?", "first": 5, "spoke": 0}, {"id": 4, "name": "REG", "names": ["REG"], "gender": "?", "first": 6, "spoke": 4}, {"id": 5, "name": "ASANTE-HOLM", "names": ["ASANTE-HOLM"], "gender": "?", "first": 6, "spoke": 0}, {"id": 6, "name": "DEACON TIMOTHY ABARA-VOSS", "names": ["DEACON TIMOTHY ABARA-VOSS", "DEACON"], "gender": "?", "first": 7, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. ARMORED PARKING GARAGE, P4 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Concrete.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sodium glare.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Four people in a ring around a black sedan with its trunk open.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "VIKTOR \"VIC\" ODUYA-LINDGREN (40s, tailored coat).", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "ANNELIESE \"ANNA\" BRAITHWAITE-NKOSI (30s, gloves).", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "action", "text": "REGINALD \"REG\" ASANTE-HOLM (50s, armed).", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 7, "kind": "action", "text": "And the fourth, tied to a chair, a gag around his neck: DEACON TIMOTHY ABARA-VOSS (60s, cufflinks).", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 8, "kind": "dialogue", "text": "Anna, take the gag off.", "name": "VIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 9, "kind": "dialogue", "text": "Vic, he'll shout.", "name": "ANNA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "dialogue", "text": "He won't.", "name": "VIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "He will.", "name": "REG", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "Deacon, will you shout?", "name": "VIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "No.", "name": "DEACON", "speaker": 6, "ext": [], "paren": ["hoarse"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "He's lying.", "name": "ANNA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "He's tired. Tired men don't shout.", "name": "VIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "Please, Victor.", "name": "DEACON", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "Don't \"please\" me. You sold the list.", "name": "VIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "I sold nothing.", "name": "DEACON", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "We've got the bank record.", "name": "REG", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "Then the bank record's wrong.", "name": "DEACON", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "Reg, check his phone.", "name": "ANNA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Already did. Nothing.", "name": "REG", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "Nothing doesn't mean innocent.", "name": "ANNA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "No. It means careful.", "name": "VIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "Victor, listen. I wasn't the one.", "name": "DEACON", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "Then who?", "name": "VIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "Ask her.", "name": "DEACON", "speaker": 6, "ext": [], "paren": ["a long beat"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "Every head turns toward Anna.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "She doesn't flinch.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "That's a nice try, Deacon.", "name": "ANNA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "Check her laptop.", "name": "DEACON", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "Anna.", "name": "REG", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "Reg, don't.", "name": "ANNA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "Anna.", "name": "VIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "The ring tightens.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "In the silence, a distant door clanks open and footsteps echo down the ramp.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}]}