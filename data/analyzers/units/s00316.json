{"scene_id": "s00316", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00316.fountain", "heading": "INT. OPERA HOUSE, FLY GALLERY - NIGHT", "cast": [{"id": 0, "name": "IMOGEN LARKSPUR-ADEWALE", "names": ["IMOGEN LARKSPUR-ADEWALE", "IMOGEN"], "gender": "?", "first": 4, "spoke": 2}, {"id": 1, "name": "HOLDEN PRYCE-NWANKWO", "names": ["HOLDEN PRYCE-NWANKWO", "HOLDEN"], "gender": "?", "first": 5, "spoke": 3}, {"id": 2, "name": "SALOME BRAITHWAITE-OKORO", "names": ["SALOME BRAITHWAITE-OKORO", "SALOME"], "gender": "?", "first": 6, "spoke": 3}, {"id": 3, "name": "ZHENYA", "names": ["ZHENYA"], "gender": "?", "first": 7, "spoke": 2}, {"id": 4, "name": "ABARA-KOZLOV", "names": ["ABARA-KOZLOV"], "gender": "?", "first": 7, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. OPERA HOUSE, FLY GALLERY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Far above the stage, a catwalk of iron grating hung with ropes and counterweights.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Below, the orchestra tunes in a distant tide.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Four figures in stagehand blacks creep along the rail.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The first is IMOGEN LARKSPUR-ADEWALE (40s), who holds a lantern shuttered to a slit.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "The second is HOLDEN PRYCE-NWANKWO (50s), who carries a coil of rope over one shoulder.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "The third is SALOME BRAITHWAITE-OKORO (30s), who moves like water.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "The fourth, last in line, is YEVGENY \"ZHENYA\" ABARA-KOZLOV (20s), who is sweating through his gloves.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "She raises two fingers.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "He freezes behind her.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "She points at a hanging chandelier of painted canvas, ten feet away.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "He nods, though he cannot see what she means.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "She takes the rope from him, loops it round the rail, and tests it with her weight.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "He swallows.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "The chandelier turns slowly in the draft.", "para": 2, "sent": 6, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Ten minutes.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Eight.", "name": "HOLDEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Seven, if he stops shaking.", "name": "SALOME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "I'm not shaking.", "name": "ZHENYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "You're humming.", "name": "SALOME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "I'm humming because he's humming.", "name": "ZHENYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Nobody's humming.", "name": "HOLDEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "They listen.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Below, the orchestra falls silent.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "A hush rolls up through the dark.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "A single violin begins, and from beneath the stage a soprano's voice rises in a glissando so pure it makes Imogen's grip tighten on the lantern.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "She turns to him, and he to her.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Her eyes glitter.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "His mouth is open.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Whoever they are to each other, in this moment they share a single trembling breath.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Now.", "name": "SALOME", "speaker": 2, "ext": [], "paren": ["pointing"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "They move.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "She drops the rope.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "He catches it.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "She slides down.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "He braces.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "The chandelier lurches, and a hundred glass beads shiver.", "para": 5, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Below, someone in the audience gasps.", "para": 5, "sent": 6, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Abort!", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": ["hissing"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Too late!", "name": "HOLDEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "The chandelier swings free and crashes silently into the curtain, a harmless explosion of painted canvas.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "The audience, delighted, applauds.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "The four of them crouch on the catwalk, frozen, as the soprano holds her note and the whole house roars.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}]}