{"scene_id": "s00317", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00317.fountain", "heading": "INT. REGIONAL SWIM CENTER - POOL DECK - EARLY MORNING", "cast": [{"id": 0, "name": "COACH MARISOL TREVELYAN-ADEWALE", "names": ["COACH MARISOL TREVELYAN-ADEWALE", "MARISOL"], "gender": "f", "first": 5, "spoke": 16}, {"id": 1, "name": "ISAURA PRZYBYLSKI-MBEKI", "names": ["ISAURA PRZYBYLSKI-MBEKI", "ISAURA"], "gender": "?", "first": 6, "spoke": 12}], "units": [{"u": 0, "kind": "heading", "text": "INT. REGIONAL SWIM CENTER - POOL DECK - EARLY MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Chlorine haze.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Lane ropes bobbing.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rows of empty bleachers.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single swimmer cuts lengths in lane four.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "COACH MARISOL TREVELYAN-ADEWALE (50s, whistle, towel round her neck) crouches at the pool edge with a stopwatch.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "On the starting block, soaked, goggles pushed up on her forehead, waits ISAURA PRZYBYLSKI-MBEKI (17, racing suit, shoulders too narrow for her ambitions).", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Again.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "I just did two hundred.", "name": "ISAURA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "And you'll do another.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Coach.", "name": "ISAURA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Isaura.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "My arms are lead.", "name": "ISAURA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Lead floats if you move fast enough.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Isaura laughs, breath ragged.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Lowers her goggles.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "On my whistle.", "name": "MARISOL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "On your whistle.", "name": "ISAURA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Marisol raises it.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Go.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Isaura launches.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "The water folds around her.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Marisol clicks the watch.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Walks the deck beside the lane, keeping pace.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "At the wall, Isaura tumbles, pushes off.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Marisol bends lower.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Long. Long.", "name": "MARISOL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "I'm trying!", "name": "ISAURA", "speaker": 1, "ext": ["O.S."], "paren": ["gasping"], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Long, Isaura!", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Isaura touches the far wall.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Surfaces.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Breathes.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Marisol stops the watch.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Looks at it.", "para": 6, "sent": 4, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Better.", "name": "MARISOL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "How much?", "name": "ISAURA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Two-tenths.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "That's all?", "name": "ISAURA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "That's everything.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Isaura grins.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Pulls herself onto the deck and sits, legs dangling.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Marisol sits beside her.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "They both stare at the water.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Can I ask something?", "name": "ISAURA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "You can ask.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Did you ever want to quit?", "name": "ISAURA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Every day.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "But you didn't.", "name": "ISAURA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "I got up. That's the whole trick.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "That's not a trick. That's just getting up.", "name": "ISAURA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Yes. Exactly.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "They say the next line together.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Again?", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "Again.", "name": "ISAURA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "They laugh.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "Isaura stands.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "Marisol rises.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "The water settles into stillness, waiting for them.", "para": 9, "sent": 3, "present": [0, 1]}]}