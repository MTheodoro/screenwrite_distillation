{"scene_id": "s00318", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00318.fountain", "heading": "INT. PRESCHOOL PLAYGROUND - NAP TIME - AFTERNOON", "cast": [{"id": 0, "name": "GRANDMA ODALIE KOWALSKI-ADEYEMI", "names": ["GRANDMA ODALIE KOWALSKI-ADEYEMI", "ODALIE"], "gender": "?", "first": 4, "spoke": 2}, {"id": 1, "name": "BERTIE", "names": ["BERTIE"], "gender": "?", "first": 5, "spoke": 1}, {"id": 2, "name": "NNAMDI-LINDGREN", "names": ["NNAMDI-LINDGREN"], "gender": "?", "first": 5, "spoke": 0}, {"id": 3, "name": "AUNT RUFINA PRYCE-OYELARAN", "names": ["AUNT RUFINA PRYCE-OYELARAN", "RUFINA"], "gender": "f", "first": 6, "spoke": 1}, {"id": 4, "name": "COUSIN TAVIAN BRAITHWAITE-OSEI", "names": ["COUSIN TAVIAN BRAITHWAITE-OSEI", "TAVIAN"], "gender": "m", "first": 7, "spoke": 1}, {"id": 5, "name": "BABY SITTER", "names": ["BABY SITTER"], "gender": "?", "first": 8, "spoke": 0}, {"id": 6, "name": "JOJO", "names": ["JOJO"], "gender": "?", "first": 8, "spoke": 1}, {"id": 7, "name": "ABARA-FENWICK", "names": ["ABARA-FENWICK"], "gender": "?", "first": 8, "spoke": 0}, {"id": 8, "name": "LITTLE ZURI ADEKUNLE-HOLM", "names": ["LITTLE ZURI ADEKUNLE-HOLM", "ZURI"], "gender": "?", "first": 9, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. PRESCHOOL PLAYGROUND - NAP TIME - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Foam mats.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Mobile of felt moons.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Six figures in miniature chairs at a very small table, holding very small teacups.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "GRANDMA ODALIE KOWALSKI-ADEYEMI (70s, church hat).", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "UNCLE BARTHOLOMEW \"BERTIE\" NNAMDI-LINDGREN (50s, delivery uniform).", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "AUNT RUFINA PRYCE-OYELARAN (40s, scrubs).", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "COUSIN TAVIAN BRAITHWAITE-OSEI (30s, suit).", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "THE BABY SITTER, MS. JOSEPHINE \"JOJO\" ABARA-FENWICK (20s, lanyard).", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 9, "kind": "action", "text": "And the child, LITTLE ZURI ADEKUNLE-HOLM (4, tutu over snow pants).", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 10, "kind": "dialogue", "text": "More tea, please.", "name": "ZURI", "speaker": 8, "ext": [], "paren": ["solemn"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 11, "kind": "dialogue", "text": "Of course, dear.", "name": "ODALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 12, "kind": "action", "text": "She pours from an empty pot.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 13, "kind": "action", "text": "Bertie sips from a cup of nothing.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 14, "kind": "action", "text": "Rufina checks her watch.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 15, "kind": "action", "text": "Tavian's phone buzzes; he silences it.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 16, "kind": "action", "text": "Jojo mouths along with every word.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 17, "kind": "dialogue", "text": "She spilled.", "name": "ZURI", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 18, "kind": "dialogue", "text": "She did?", "name": "BERTIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 19, "kind": "dialogue", "text": "She did not.", "name": "RUFINA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 20, "kind": "dialogue", "text": "She did a little.", "name": "TAVIAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 21, "kind": "dialogue", "text": "He's lying. She spilled a lot.", "name": "ODALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 22, "kind": "dialogue", "text": "He did it.", "name": "ZURI", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 23, "kind": "dialogue", "text": "Who's he?", "name": "JOJO", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 24, "kind": "dialogue", "text": "Him.", "name": "ZURI", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 25, "kind": "action", "text": "Everybody points at somebody else.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 26, "kind": "dialogue", "text": "Nap time!", "name": "ZURI", "speaker": 8, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 27, "kind": "action", "text": "They lower their heads onto the table, one by one, a perfect silent tableau.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 28, "kind": "action", "text": "Zuri peeks.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 29, "kind": "action", "text": "Smiles.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 30, "kind": "action", "text": "Lowers her head too.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}]}