{"scene_id": "s00319", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00319.fountain", "heading": "EXT. ABANDONED DRIVE-IN SNACK STAND ROOF - NIGHT", "cast": [{"id": 0, "name": "CALLUM ODUYA-LINDQVIST", "names": ["CALLUM ODUYA-LINDQVIST", "CALLUM"], "gender": "?", "first": 6, "spoke": 19}, {"id": 1, "name": "NADIA", "names": ["NADIA"], "gender": "?", "first": 7, "spoke": 19}, {"id": 2, "name": "ABARA-FENWICK", "names": ["ABARA-FENWICK"], "gender": "?", "first": 7, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ABANDONED DRIVE-IN SNACK STAND ROOF - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A flat tar roof under a smear of stars.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A cracked neon cone sign, unlit.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cooler.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Two lawn chairs.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Two teenagers sit with their backs to the sky.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "CALLUM ODUYA-LINDQVIST (16, skinny, hoodie, hands tucked in sleeves) watches the road below.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "NADEZHDA \"NADIA\" ABARA-FENWICK (16, cut-off jeans, scab on one knee) lies flat, staring up.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Somewhere far off, a freight train rolls.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Seven.", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Seven what?", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Satellites. Since you sat down.", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "That's not satellites.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "It's satellites.", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "It's planes.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Planes blink.", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "He doesn't argue.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Leans back.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "The tar creaks.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "My dad's driving back tomorrow.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "From where?", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Reno.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "What's in Reno?", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Nothing. That's the point.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "She turns her head toward him.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Is he staying?", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "He says so.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Do you believe him?", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "He bought a couch.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "That's not the same.", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "He's never bought a couch.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "She sits up.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Pulls her knees to her chest.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "He opens the cooler and offers her a soda.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "She takes it.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Mine's leaving for good, you know.", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Your mom?", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Mine's mom, yes, my mom. Moving to Tucson with a guy named Gordon.", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Gordon sounds fake.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Gordon sounds like a sofa.", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "He might be your dad's couch.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "She laughs, loud, startling a nighthawk off the sign.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Callum smiles, too, for the first time.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "The freight train's horn fades.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "You'll still be here.", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Yeah.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Promise.", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "I'm not going anywhere. There's nowhere to go.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "That's not a promise.", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "It's the only kind I have.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "She tips her soda against his.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "They drink.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "A shooting star cuts across the sky and neither of them says anything, though both see it.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Make a wish.", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "I did.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "What was it?", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "If I tell you, it won't work.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "That's superstition.", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "It's a rule.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "Same thing.", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "Not tonight.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "She lies back.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "He lies down, too, shoulder to shoulder, and the stars wheel on above them.", "para": 10, "sent": 1, "present": [0, 1, 2]}]}