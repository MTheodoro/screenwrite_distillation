{"scene_id": "s00325", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00325.fountain", "heading": "INT. HYPERBARIC CHAMBER - HOSPITAL BASEMENT - NIGHT", "cast": [{"id": 0, "name": "LENA ASHWORTH", "names": ["LENA ASHWORTH", "LENA"], "gender": "?", "first": 5, "spoke": 6}, {"id": 1, "name": "NURSE PRIYA DESAI", "names": ["NURSE PRIYA DESAI", "PRIYA"], "gender": "f", "first": 6, "spoke": 5}, {"id": 2, "name": "WALDEMAR GRUBB", "names": ["WALDEMAR GRUBB", "WALDEMAR"], "gender": "?", "first": 7, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. HYPERBARIC CHAMBER - HOSPITAL BASEMENT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A steel cylinder the size of a submarine hatch, riveted, round-windowed, humming.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dials gleam.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single bench runs along each wall.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The air smells of hot metal and antiseptic.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. LENA ASHWORTH, forties, tall, severe, with grey strands escaping from a tight bun, checks a pressure gauge with the focus of a surgeon.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "NURSE PRIYA DESAI, thirties, small, quick, her scrubs covered in a cardigan, adjusts an IV line on a gurney.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "MR. WALDEMAR GRUBB, sixties, a diver with the bends, lies on the gurney, bearded, grey-skinned, eyes bright with fear.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Pressure at two atmospheres. Priya, how is his pulse?", "name": "LENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "One-ten and climbing.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Lena crosses to Priya.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "She leans over the gurney.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "She checks Waldemar's pupils.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She frowns and looks up at Priya.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Am I dying?", "name": "WALDEMAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "You are being treated.", "name": "LENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "That is not an answer.", "name": "WALDEMAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "It's the only one she gives.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Lena shoots Priya a look.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Priya shrugs.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "She tucks the blanket tighter around Waldemar's feet.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Two and a half atmospheres. Watch the oxygen. If he seizes, we have ninety seconds.", "name": "LENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Ninety seconds in a sealed tube. Wonderful.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "I heard that.", "name": "LENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Tell me one thing. Which of you two is in charge?", "name": "WALDEMAR", "speaker": 2, "ext": [], "paren": ["wheezing"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Lena and Priya both begin to answer.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Both stop.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "The dial needle trembles.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "A rivet pings somewhere in the wall.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "She is.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "She is.", "name": "LENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "They look at each other.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Waldemar's whole body arches off the gurney and the alarm shrieks.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Lena and Priya grab him at once, one at his shoulders, one at his knees, and hold him down while the chamber hums louder around them.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Three atmospheres! Now!", "name": "LENA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Three! Going up!", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "She hammers the valve.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "The needle climbs.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Waldemar sags back, gasping, and the alarm cuts out.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "The sudden silence is enormous.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Thank you.", "name": "WALDEMAR", "speaker": 2, "ext": [], "paren": ["a whisper"], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Lena lets go first.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Priya follows.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Neither of them speaks.", "para": 9, "sent": 2, "present": [0, 1, 2]}]}