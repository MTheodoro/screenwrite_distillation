{"scene_id": "s00326", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00326.fountain", "heading": "INT. CHEESE-AGING CAVE - NIGHT", "cast": [{"id": 0, "name": "SABINE LAROCHE", "names": ["SABINE LAROCHE", "SABINE"], "gender": "f", "first": 5, "spoke": 12}, {"id": 1, "name": "MOSES TREVELYAN", "names": ["MOSES TREVELYAN", "MOSES"], "gender": "?", "first": 7, "spoke": 14}, {"id": 2, "name": "GINO BELLAMY", "names": ["GINO BELLAMY", "GINO"], "gender": "m", "first": 9, "spoke": 14}, {"id": 3, "name": "GUARD", "names": ["GUARD"], "gender": "?", "first": 69, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. CHEESE-AGING CAVE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A limestone cavern carved into a mountainside, lined with wooden racks holding ten thousand wheels of alpine cheese.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Humidity drips from the ceiling.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The air is thick as a wet wool coat.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A chain-link door stands at the far end, a keypad glowing red.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SABINE LAROCHE, forties, a former pastry chef turned safecracker, wears a hairnet and a white lab coat.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She kneels at the keypad with a screwdriver in her teeth.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "MOSES TREVELYAN, fifties, a tall, stooped man who once forged museum labels, stands lookout in rubber boots.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He holds a flashlight and a wheel of Gruyere like a baby.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "GINO BELLAMY, thirties, a nervous driver in a hooded sweatshirt, paces behind them, whispering into a walkie-talkie.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Sabine, the guard changes at three. It's two fifty.", "name": "GINO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I know what time it is.", "name": "SABINE", "speaker": 0, "ext": [], "paren": ["through the screwdriver"], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Please do not breathe on the Gruyere. It's eighteen months old and extremely sensitive.", "name": "MOSES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Moses, you are literally holding it.", "name": "GINO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "That's different. I love it.", "name": "MOSES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Sabine pulls the keypad cover off.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Wires spill out like a nest.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "She selects a pair and strips them with her teeth.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Quiet. Both of you.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "What if it trips an alarm?", "name": "GINO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "It will not trip an alarm.", "name": "MOSES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "It might trip an alarm.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "It will not, Sabine, I studied the schematic.", "name": "MOSES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "You studied the schematic of a cheese cave?", "name": "GINO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "It's a very serious cheese cave.", "name": "MOSES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "She twists the wires together.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "A green light blinks.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "The door clicks.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Oh my God.", "name": "GINO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Don't say it.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "It opened.", "name": "GINO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Do not say anything!", "name": "MOSES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The door swings wide.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Beyond it, a steel vault shaped like a giant wheel of cheese, the combination dial glittering.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "There she is.", "name": "MOSES", "speaker": 1, "ext": ["CONT'D"], "paren": ["reverent"], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Gino presses his walkie to his ear and his face drains.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Guys. Guys, guard's early. He's coming down the tunnel.", "name": "GINO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "How early?", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Now.", "name": "GINO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Footsteps echo.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "A distant voice, bored, singing a folk song.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Sabine rises, wipes her hands.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Moses sets down the Gruyere and takes up a ladle from a bucket.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Gino drops behind a rack.", "para": 8, "sent": 4, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "He'll check the door.", "name": "MOSES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Then we close the door.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "She yanks it shut.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "The latch snaps and the keypad goes dark, plunging the cavern into blackness except for Moses's flashlight beam shaking on the wall.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Is it locked?", "name": "GINO", "speaker": 2, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "From which side?", "name": "MOSES", "speaker": 1, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Sabine stares at the door, at the dead keypad.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Oh no.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "What oh no? What \"oh no?\"", "name": "GINO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "I locked us inside.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "The singing stops.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "A flashlight beam sweeps along the racks toward them.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "I'll talk to him.", "name": "GINO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "You'll do no such thing.", "name": "MOSES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "Both of you, shut up, I'm thinking.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "We're thieves in a cheese cave.", "name": "GINO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "We are gourmets in a cheese cave.", "name": "MOSES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Quiet!", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "She snatches the screwdriver, jams it in the latch, twists.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "Metal shrieks.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "The door pops open an inch, then two, then flies wide.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "The guard's beam hits the vault.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "Sabine slams the door shut again from the inside and holds it, her whole body against the steel.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "Moses and Gino pile in beside her.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "The three of them pant in the dark.", "para": 14, "sent": 2, "present": [0, 1, 2]}, {"u": 69, "kind": "dialogue", "text": "Evening, folks!", "name": "GUARD", "speaker": 3, "ext": ["O.S."], "paren": ["muffled, cheerful"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "Nobody breathes.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "dialogue", "text": "He's gone past.", "name": "MOSES", "speaker": 1, "ext": [], "paren": ["a whisper"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "How do you know?", "name": "GINO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "He's still singing.", "name": "MOSES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "Faintly, the song resumes and fades down the tunnel.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "Sabine slides to the floor.", "para": 16, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "Gino laughs, high and helpless.", "para": 16, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "Moses retrieves the Gruyere and kisses it.", "para": 16, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "dialogue", "text": "The vault. Now. Before I lose my mind.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "action", "text": "She turns the dial.", "para": 17, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "action", "text": "Click, click, click.", "para": 17, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "action", "text": "The great wheel door groans open, and inside, stacked to the ceiling, are not diamonds, not bearer bonds, but ten thousand more wheels of cheese.", "para": 17, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "dialogue", "text": "It's cheese.", "name": "GINO", "speaker": 2, "ext": [], "paren": ["flat"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "dialogue", "text": "It's the cheese.", "name": "MOSES", "speaker": 1, "ext": [], "paren": ["gently"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 84, "kind": "dialogue", "text": "We were robbing the wrong cave.", "name": "SABINE", "speaker": 0, "ext": [], "paren": ["a long beat"], "dual": false, "present": [0, 1, 2, 3]}]}