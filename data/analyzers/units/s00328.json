{"scene_id": "s00328", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00328.fountain", "heading": "INT. FERRY TERMINAL LOST PROPERTY OFFICE - NIGHT", "cast": [{"id": 0, "name": "ROSALIND IKEDA", "names": ["ROSALIND IKEDA", "IKEDA"], "gender": "?", "first": 4, "spoke": 7}, {"id": 1, "name": "AUGUSTIN BEAUMONT", "names": ["AUGUSTIN BEAUMONT", "AUGUSTIN"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "LUCINDA MORROW", "names": ["LUCINDA MORROW", "LUCINDA"], "gender": "f", "first": 6, "spoke": 5}, {"id": 3, "name": "KWAME ASANTE", "names": ["KWAME ASANTE", "KWAME"], "gender": "?", "first": 7, "spoke": 4}, {"id": 4, "name": "OFFICER PERRY", "names": ["OFFICER PERRY", "PERRY"], "gender": "?", "first": 8, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. FERRY TERMINAL LOST PROPERTY OFFICE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Shelves of umbrellas.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A cage of single gloves.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Fluorescent hum.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DET. ROSALIND IKEDA leans on the counter.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "AUGUSTIN BEAUMONT, the clerk, hides behind a ledger.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "LUCINDA MORROW sits on a bench with a violin case on her knees.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "KWAME ASANTE paces.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "OFFICER PERRY blocks the door.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Describe the case again.", "name": "IKEDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Black. Brass clasps. A sticker of a lighthouse on the lid.", "name": "LUCINDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "We have forty-one black cases. Nine with brass.", "name": "AUGUSTIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "That one's hers. That one in her lap.", "name": "KWAME", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "This one is mine. Yours is somewhere else.", "name": "LUCINDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Open it.", "name": "IKEDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "It's a violin.", "name": "LUCINDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Then it won't mind.", "name": "IKEDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Detective, there are procedures.", "name": "AUGUSTIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Mr. Beaumont, you logged this case at nine-ten. Two hours before the ferry docked.", "name": "IKEDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "I may have mistaken the time.", "name": "AUGUSTIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "He mistakes everything.", "name": "KWAME", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Kwame, sit down.", "name": "LUCINDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "I've been sitting since Tuesday.", "name": "KWAME", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Officer Perry, the door.", "name": "IKEDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Locked, ma'am.", "name": "PERRY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Miss Morrow. The clasps.", "name": "IKEDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "No.", "name": "LUCINDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Then I'll count to three.", "name": "IKEDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Please don't.", "name": "AUGUSTIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "One.", "name": "KWAME", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}