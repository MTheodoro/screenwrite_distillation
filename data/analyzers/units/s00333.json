{"scene_id": "s00333", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00333.fountain", "heading": "INT. CAROUSEL WORKSHOP - NIGHT", "cast": [{"id": 0, "name": "MINA", "names": ["MINA"], "gender": "?", "first": 3, "spoke": 3}, {"id": 1, "name": "TEDDY", "names": ["TEDDY"], "gender": "f", "first": 4, "spoke": 3}, {"id": 2, "name": "OSRIC", "names": ["OSRIC"], "gender": "?", "first": 5, "spoke": 2}, {"id": 3, "name": "LOLA", "names": ["LOLA"], "gender": "?", "first": 6, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. CAROUSEL WORKSHOP - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cavernous barn of splintered painted horses, hanging by chains from the rafters, their glass eyes catching a single lantern.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sawdust drifts like snow.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "MINA, twenties, a documentary photographer, raises a camera.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "TEDDY, thirties, her guide, grips a crowbar.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "OSRIC, sixties, the caretaker, stands rigid in the doorway with a ring of keys.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "LOLA, ten, Osric's granddaughter, clutches a plush rabbit.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Teddy, did you hear that?", "name": "MINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "It's the wind.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "No wind in here.", "name": "OSRIC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Grandpa, the horses are looking at me.", "name": "LOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Lola, honey, they're wood.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Teddy, look up.", "name": "MINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Lola, come here.", "name": "OSRIC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "A chain clinks.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "One painted horse swings, slow.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Another turns its head.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Mina, back up.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "I'm trying.", "name": "MINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Grandpa!", "name": "LOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "The lantern gutters.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "All the horses begin to descend at once on their chains, slamming into the floor, shrieking, wheels turning, the whole carousel lurching into motion in the dark.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}]}