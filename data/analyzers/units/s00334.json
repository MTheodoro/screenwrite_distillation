{"scene_id": "s00334", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00334.fountain", "heading": "INT. TAXIDERMY SHOP - BACK ROOM - DAY", "cast": [{"id": 0, "name": "CORNELIA BRIGHT", "names": ["CORNELIA BRIGHT", "CORNELIA"], "gender": "?", "first": 5, "spoke": 8}, {"id": 1, "name": "DESMOND ARCHULETA", "names": ["DESMOND ARCHULETA", "DESMOND"], "gender": "f", "first": 6, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. TAXIDERMY SHOP - BACK ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Glass eyes everywhere.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A stuffed badger on the desk.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A deposition table cleared between a moose head and a fox in mid-pounce.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ATTY.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "CORNELIA BRIGHT, forties, in a grey suit, sits with a legal pad.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "DESMOND ARCHULETA, fifties, the shop owner, sits across from her in a smock, hands folded.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "State your name for the record.", "name": "CORNELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Desmond Archuleta.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "And you have owned this shop how long?", "name": "CORNELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Twenty-two years.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "And in that time you've never kept a customer's property past the pickup date.", "name": "CORNELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Never.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Never once.", "name": "CORNELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Not once.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Mr. Archuleta, how many animals are in this room?", "name": "CORNELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "I couldn't say. Thirty. Forty.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Would it surprise you to learn that forty-one are registered, and forty-two are present?", "name": "CORNELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Counting error.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Would it surprise you that the forty-second is a recently deceased Great Dane belonging to my client?", "name": "CORNELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Desmond's hands unfold.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Cornelia's pen stops.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "They stare at each other.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Behind Desmond, the badger on the desk seems to lean forward.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "I want a lawyer.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I am the lawyer.", "name": "CORNELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "They both rise at once.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "The table scrapes.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "A glass eye rolls to the floor between them.", "para": 3, "sent": 2, "present": [0, 1]}]}