{"scene_id": "s00335", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00335.fountain", "heading": "INT. ABANDONED CANNERY - OFFICE - NIGHT", "cast": [{"id": 0, "name": "ROSALIE FENWICK", "names": ["ROSALIE FENWICK", "ROSALIE"], "gender": "?", "first": 4, "spoke": 2}, {"id": 1, "name": "MAUDE", "names": ["MAUDE"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "PERCIVAL", "names": ["PERCIVAL"], "gender": "?", "first": 6, "spoke": 3}, {"id": 3, "name": "IGNATIUS", "names": ["IGNATIUS"], "gender": "m", "first": 7, "spoke": 2}, {"id": 4, "name": "SISTER BERNADETTE", "names": ["SISTER BERNADETTE"], "gender": "?", "first": 8, "spoke": 2}, {"id": 5, "name": "LEOPOLD", "names": ["LEOPOLD"], "gender": "?", "first": 9, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED CANNERY - OFFICE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A rusted office above the cannery floor, windows black, a lone lamp burning on a steel desk.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fish labels peel off the walls.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Below, machinery drips.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ROSALIE FENWICK, thirties, a historian with a field recorder, sits on the desk.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "MAUDE, sixties, the former forewoman, perches on a stool, arms crossed.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "PERCIVAL, forties, Rosalie's research assistant, hovers by the door.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "IGNATIUS, fifties, a priest in a heavy coat, stands at the window.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "SISTER BERNADETTE, seventies, clutches a rosary.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "LEOPOLD, thirties, the surveyor, kneels by a floor hatch with a torch.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Let's start with the night shift of 1961.", "name": "ROSALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "We don't talk about it.", "name": "MAUDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Maude, please.", "name": "PERCIVAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "I said we don't.", "name": "MAUDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Maude is right. Some nights are best left in the water.", "name": "IGNATIUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Leopold lifts the hatch.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "A cold wet breath rolls up from below.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Something down here.", "name": "LEOPOLD", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Close it.", "name": "SISTER BERNADETTE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Leopold, what is it?", "name": "ROSALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "A shoe. And a hand.", "name": "LEOPOLD", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "A hand?", "name": "PERCIVAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Holding the shoe.", "name": "LEOPOLD", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Maude rises.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Ignatius crosses himself.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Rosalie turns her recorder to Leopold.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "He told them not to open the hatch.", "name": "MAUDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Who did?", "name": "SISTER BERNADETTE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "He did.", "name": "MAUDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "She means Gideon.", "name": "IGNATIUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Who is Gideon?", "name": "PERCIVAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Nobody answers.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Down the hatch, the hand twitches.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "It's moving.", "name": "LEOPOLD", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "The lamp dims.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Every door in the cannery slams at once.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}