{"scene_id": "s00336", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00336.fountain", "heading": "INT. PLANETARIUM DOME - NIGHT", "cast": [{"id": 0, "name": "ZELDA", "names": ["ZELDA"], "gender": "f", "first": 3, "spoke": 2}, {"id": 1, "name": "MOE", "names": ["MOE"], "gender": "f", "first": 4, "spoke": 0}, {"id": 2, "name": "KIRSTEN", "names": ["KIRSTEN"], "gender": "?", "first": 5, "spoke": 1}, {"id": 3, "name": "BAXTER", "names": ["BAXTER"], "gender": "?", "first": 6, "spoke": 0}, {"id": 4, "name": "YUSUF", "names": ["YUSUF"], "gender": "?", "first": 7, "spoke": 1}, {"id": 5, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 8, "spoke": 3}, {"id": 6, "name": "LUCIAN", "names": ["LUCIAN"], "gender": "?", "first": 20, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. PLANETARIUM DOME - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Stars wheel overhead on a painted ceiling.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Reclining seats ring a projector like a metal spider.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "ZELDA, thirties, in a black bodysuit, clips a wire.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "MOE, fifties, her partner, kneels at the projector.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "KIRSTEN, forties, the planetarium director, bound to a seat with tape.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "BAXTER, twenties, a guard, lies unconscious.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "YUSUF, thirties, watches the door.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "A STRANGER, forties, in a long coat, steps out of the dark aisle.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "action", "text": "Zelda turns.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "Kirsten wriggles.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "Moe freezes.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "He raises a wrench.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "She lowers her wire cutters.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Evening. I'm told the Orion diamond is on display tonight.", "name": "STRANGER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "It isn't.", "name": "ZELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "It's under the projector.", "name": "STRANGER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Yusuf slides toward the stranger.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "He grabs his collar.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "The stranger doesn't flinch.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "My name is Lucian. I'm the buyer.", "name": "STRANGER", "speaker": 5, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "The buyer isn't due until Friday.", "name": "YUSUF", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "I'm early. She knows.", "name": "LUCIAN", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "He nods at Kirsten.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "She nods back.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "action", "text": "Zelda stares at her.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "action", "text": "She stares at Zelda.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "You sold us out.", "name": "ZELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "I sold you a ceiling, dear.", "name": "KIRSTEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "Moe drops the wrench.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "The stars blink out.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}]}