{"scene_id": "s00341", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00341.fountain", "heading": "INT. BELL TOWER OBSERVATION POST - DAWN", "cast": [{"id": 0, "name": "MBEKI", "names": ["MBEKI"], "gender": "?", "first": 4, "spoke": 2}, {"id": 1, "name": "ARNAUD", "names": ["ARNAUD"], "gender": "?", "first": 6, "spoke": 1}, {"id": 2, "name": "HOSSEINI", "names": ["HOSSEINI"], "gender": "?", "first": 8, "spoke": 1}, {"id": 3, "name": "MAJOR TULLY", "names": ["MAJOR TULLY"], "gender": "?", "first": 13, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. BELL TOWER OBSERVATION POST - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A narrow stone chamber under the bells.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sandbags in the arched window.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Mist below.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SGT. MBEKI, forties, binoculars up, kneels at the window.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "PVT.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "ARNAUD, nineteen, clutches a rifle.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "CPL.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "HOSSEINI, thirties, sits against the wall working a field radio.", "para": 1, "sent": 4, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "They are silent.", "para": 1, "sent": 5, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "He adjusts the dial.", "para": 1, "sent": 6, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He lowers the binoculars.", "para": 1, "sent": 7, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Arnaud's knuckles go white.", "para": 1, "sent": 8, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Bell Tower, this is Command. Status report. Over.", "name": "MAJOR TULLY", "speaker": 3, "ext": ["O.S."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Tell him nothing moves.", "name": "MBEKI", "speaker": 0, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Command, Bell Tower. Nothing moves. Over.", "name": "HOSSEINI", "speaker": 2, "ext": [], "paren": ["into radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Keep it that way. Over.", "name": "MAJOR TULLY", "speaker": 3, "ext": ["O.S."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Hosseini sets down the handset.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Below, in the fog, something metal clinks.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Mbeki holds up a flat hand.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Arnaud's rifle trembles.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Hosseini slides the radio away from the wall.", "para": 2, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Sergeant. It's coming from the church.", "name": "ARNAUD", "speaker": 1, "ext": [], "paren": ["barely audible"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "It's the church that's ours.", "name": "MBEKI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "A single bell above them swings and sounds, once, deep and sudden.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}]}