{"scene_id": "s00342", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00342.fountain", "heading": "EXT. BOCCE COURT UNDER HIGHWAY OVERPASS - DAY", "cast": [{"id": 0, "name": "NONNA FILOMENA", "names": ["NONNA FILOMENA"], "gender": "?", "first": 5, "spoke": 4}, {"id": 1, "name": "BIG WALT", "names": ["BIG WALT"], "gender": "?", "first": 6, "spoke": 4}, {"id": 2, "name": "DARIUS", "names": ["DARIUS"], "gender": "?", "first": 7, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. BOCCE COURT UNDER HIGHWAY OVERPASS - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A strip of crushed oyster shell beneath concrete pillars.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Traffic thunders overhead.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Folding chairs line the court.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A thermos of espresso sits on an overturned crate.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "NONNA FILOMENA, eighties, in a black dress and sensible shoes, squints at the pallino.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "BIG WALT, fifties, her opponent, a trucker in a leather vest, crouches with a ball cradled in his palm.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "DARIUS, fifteen, Walt's nephew, holds the measuring string and a notebook.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "She straightens, shifts her weight, and sends her ball down the shell with a sharp flick of the wrist while he lobs his in a high arc, and the two collide mid-court in a crack that scatters dust, and the pallino rolls under a chair where Darius scrambles after it on his knees.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "That's mine.", "name": "NONNA FILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "That's a tie.", "name": "BIG WALT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "It's closer to the chair.", "name": "DARIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Darius, measure!", "name": "NONNA FILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Don't measure, Darius.", "name": "BIG WALT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I'm measuring.", "name": "DARIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Walt, you cheat.", "name": "NONNA FILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Nonna, I've never cheated in my life.", "name": "BIG WALT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "It's four inches.", "name": "DARIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Four inches for who?", "name": "NONNA FILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "For me, obviously.", "name": "BIG WALT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "For her.", "name": "DARIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Walt looks at Darius.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Darius looks at Nonna.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "She lifts the thermos, takes one sip, and offers it to Walt.", "para": 3, "sent": 2, "present": [0, 1, 2]}]}