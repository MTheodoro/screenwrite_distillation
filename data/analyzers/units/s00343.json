{"scene_id": "s00343", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00343.fountain", "heading": "INT. HALL OF MIRRORS - OFF-SEASON FAIRGROUND - NIGHT", "cast": [{"id": 0, "name": "CORINNE DUBOIS-ADEYEMI", "names": ["CORINNE DUBOIS-ADEYEMI", "CORINNE"], "gender": "f", "first": 5, "spoke": 7}, {"id": 1, "name": "ARTIE", "names": ["ARTIE"], "gender": "?", "first": 6, "spoke": 7}, {"id": 2, "name": "PLUMLEY", "names": ["PLUMLEY"], "gender": "?", "first": 6, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. HALL OF MIRRORS - OFF-SEASON FAIRGROUND - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A canvas-walled maze of warped glass.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Half the bulbs are dead.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dust coats every frame.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The mirrors turn the dark into a hundred darks.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CORINNE DUBOIS-ADEYEMI, thirties, a paranormal investigator in a leather jacket, walks slowly down a corridor with a handheld lamp, her reflection stretching tall, then squat, then tall again.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "ARTHUR \"ARTIE\" PLUMLEY, seventies, the fairground's last attendant, shuffles behind her in a patched coat, a ring of keys swinging at his hip.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Artie, you said the last visitor left in 1987.", "name": "CORINNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "So I did.", "name": "ARTIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Then who is the person in the third mirror?", "name": "CORINNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Miss Dubois-Adeyemi, I wouldn't look.", "name": "ARTIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "She looks.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Her reflection waves, but she hasn't moved.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Artie.", "name": "CORINNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Yes, miss.", "name": "ARTIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Is that me?", "name": "CORINNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "It was. For a while.", "name": "ARTIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "She steps back.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Her reflection steps forward.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "The glass ripples like water.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Artie, open the door.", "name": "CORINNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "There's no door, miss. There's only the way you came.", "name": "ARTIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Then take me back.", "name": "CORINNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "I'd love to. But I've been looking for the way out since the summer of '87.", "name": "ARTIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "She turns.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Behind her, in every mirror, Artie stands younger, smiling, and a hundred reflections of her are walking away.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Artie, what did you do?", "name": "CORINNE", "speaker": 0, "ext": [], "paren": ["a whisper"], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "I stayed too long, miss. Same as you.", "name": "ARTIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "The lamp gutters out.", "para": 6, "sent": 0, "present": [0, 1, 2]}]}