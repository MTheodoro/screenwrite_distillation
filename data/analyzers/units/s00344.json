{"scene_id": "s00344", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00344.fountain", "heading": "EXT. GLACIER CREVASSE - DAY", "cast": [{"id": 0, "name": "INGRID HALVORSEN", "names": ["INGRID HALVORSEN", "INGRID"], "gender": "f", "first": 3, "spoke": 3}, {"id": 1, "name": "SOLANGE RENARD", "names": ["SOLANGE RENARD", "SOLANGE"], "gender": "f", "first": 4, "spoke": 2}, {"id": 2, "name": "DAG", "names": ["DAG"], "gender": "?", "first": 5, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. GLACIER CREVASSE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A blue slot in the ice, forty feet deep, walls ribbed like the inside of a throat.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wind whistles across the lip.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "INGRID HALVORSEN, forties, a mountaineer in a red jacket, dangles from a rope at the crevasse edge, kicking for purchase.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "SOLANGE RENARD, thirties, her partner, lies flat on the ice above, the rope wrapped around her gloves.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "DAG, fifties, their guide, plants an ice axe a few feet back and hauls on the line.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "I've got you!", "name": "SOLANGE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "You don't!", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "She's slipping, Dag!", "name": "SOLANGE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Both of you, shut up and haul.", "name": "DAG", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Ingrid swings her boot at the wall.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "The ice bites.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "She hangs, breathing.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Tell me when she's got the axe in.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Axe is in.", "name": "DAG", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Solange pulls.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Ingrid rises one foot, then two.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "She grabs the lip with a gloved hand.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "She looks up at Solange.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "She looks at Dag.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Pull.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "They pull.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "She crawls onto the ice, gasping.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Nobody speaks.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Dag unwraps the rope from Solange's hands, finger by finger.", "para": 4, "sent": 3, "present": [0, 1, 2]}]}