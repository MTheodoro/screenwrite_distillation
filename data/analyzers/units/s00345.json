{"scene_id": "s00345", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00345.fountain", "heading": "EXT. FLOODED RICE PADDY DIKE - DAWN", "cast": [{"id": 0, "name": "HARGREAVE", "names": ["HARGREAVE"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "DOC", "names": ["DOC"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "BIANCHI", "names": ["BIANCHI"], "gender": "m", "first": 5, "spoke": 0}, {"id": 3, "name": "LIN TRAN", "names": ["LIN TRAN", "LIN"], "gender": "?", "first": 7, "spoke": 2}, {"id": 4, "name": "OKAFOR", "names": ["OKAFOR"], "gender": "m", "first": 9, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FLOODED RICE PADDY DIKE - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A narrow earthen dike cuts across a drowned paddy, mist lying on the water like a sheet.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single banyan tree stands at the far end.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Distant mortar thuds roll across the flat.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LT. HARGREAVE, thirties, a young officer with a map case, crouches at the dike's edge.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "SGT. \"DOC\" BIANCHI, forties, a medic with a red-cross satchel, crouches beside him.", "para": 1, "sent": 1, "present": [0, 2]}, {"u": 6, "kind": "action", "text": "PVT.", "para": 1, "sent": 2, "present": [0, 2]}, {"u": 7, "kind": "action", "text": "LIN TRAN, twenty, a scout, lies prone in the mud at the lead.", "para": 1, "sent": 3, "present": [0, 2, 3]}, {"u": 8, "kind": "action", "text": "CPL.", "para": 1, "sent": 4, "present": [0, 2, 3]}, {"u": 9, "kind": "action", "text": "OKAFOR, thirties, the radioman, hunkers behind them with the set on his back, the antenna bending as he twists to look behind.", "para": 1, "sent": 5, "present": [0, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Doc, keep it down.", "name": "HARGREAVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "I am down, Lieutenant. I'm lying in a rice paddy.", "name": "DOC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Contact, left.", "name": "LIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Hargreave lifts his head, Doc grabs the satchel, Okafor drops the handset, and all four of them flatten as a burst of fire stitches the water twenty feet away and sends up silver fans.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Okafor, call it in.", "name": "HARGREAVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Sir, I can't call it in. They're listening.", "name": "OKAFOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Then talk in code.", "name": "HARGREAVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "What code?", "name": "DOC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "The cornflakes code.", "name": "OKAFOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "OKAFOR, do not say cornflakes.", "name": "HARGREAVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Sir, cornflakes is the code!", "name": "OKAFOR", "speaker": 4, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Gentlemen, I would like to survive the morning.", "name": "DOC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "They're moving.", "name": "LIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Hargreave raises a hand.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Lin crawls back, drags the radio, thumbs the key twice.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Static pops.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "A voice crackles, faint.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Everyone on me. We go in three.", "name": "HARGREAVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Three what?", "name": "DOC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Three, Doc.", "name": "HARGREAVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "They rise as one, bent double, and splash down the dike toward the banyan with the fog swallowing them, all four of them running.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}]}