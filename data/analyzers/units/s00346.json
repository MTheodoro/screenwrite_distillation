{"scene_id": "s00346", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00346.fountain", "heading": "INT. NIGHT-MARKET FISH STALL WALK-IN FREEZER - NIGHT", "cast": [{"id": 0, "name": "VIVIAN CHOW", "names": ["VIVIAN CHOW", "VIVIAN"], "gender": "f", "first": 6, "spoke": 12}, {"id": 1, "name": "MARCUS DELACROIX-OYELARAN", "names": ["MARCUS DELACROIX-OYELARAN", "MARCUS"], "gender": "?", "first": 8, "spoke": 13}, {"id": 2, "name": "TWO-TONE EDDIE", "names": ["TWO-TONE EDDIE", "EDDIE"], "gender": "m", "first": 10, "spoke": 2}, {"id": 3, "name": "HANNAH PRZYBYLSKI", "names": ["HANNAH PRZYBYLSKI", "HANNAH"], "gender": "?", "first": 11, "spoke": 2}, {"id": 4, "name": "ZHAO", "names": ["ZHAO"], "gender": "m", "first": 12, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT-MARKET FISH STALL WALK-IN FREEZER - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A steel freezer behind a night-market fish stall.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Frost on every surface.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Hanging carcasses of tuna sway slightly in the cold, their eyes sealed with ice.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single light panel hums.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The air tastes of salt and metal.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "VIVIAN CHOW, fifties, the stall owner, in a white rubber apron and gloves, stands with her back to a rack of frozen squid.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Her face betrays nothing.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "MARCUS DELACROIX-OYELARAN, forties, a loan collector in a long wool coat, stands directly in front of her, hands in his pockets.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "His breath smokes.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "TWO-TONE EDDIE, thirties, his driver, a heavy man with a bleached streak in his hair, leans against the door, arms folded.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "HANNAH PRZYBYLSKI, twenties, Vivian's niece, holds a tray of ice with trembling fingers, trying to look busy.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "OLD MR. ZHAO, seventies, sits on an upturned crate in the corner with a cigarette he has not lit, watching.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Forty thousand, Mrs. Chow.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "I know the number.", "name": "VIVIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "The number has been the number for six months.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "The number is not on my table.", "name": "VIVIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Eddie shifts his weight against the door.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "The metal creaks.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Hannah's tray rattles.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Zhao rolls the cigarette between his fingers.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Then where is it?", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "In the fish.", "name": "VIVIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "In the fish.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": ["a thin smile"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Every night, a little. In the bellies. You pay a man to carry it off the pier and nobody looks inside a tuna.", "name": "VIVIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Clever.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Thirty-one years in this trade.", "name": "VIVIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "He steps closer.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Hannah backs up a pace and the tray tilts.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "A few cubes slide off and shatter on the floor.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Nobody turns.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Show me.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Vivian picks up a long steel knife from the rack.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Eddie straightens.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Zhao lights his cigarette at last, the flame small and orange in all that white.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Which one would you like?", "name": "VIVIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Surprise me.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "She walks along the line of tuna, touches one with the flat of her blade, then another.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "She stops at the last.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "She makes one long cut.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Something falls out onto the ice, wrapped in oilcloth.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Auntie.", "name": "HANNAH", "speaker": 3, "ext": [], "paren": ["a whisper"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Hold the tray steady, child.", "name": "VIVIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Marcus crouches, unwraps the oilcloth with two fingers.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Inside is a thick bundle of cash and a small black notebook.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "He flips the notebook open.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "He reads a line.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "He reads another.", "para": 10, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "His jaw tightens.", "para": 10, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "This is not my money.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "No.", "name": "VIVIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "This is a list.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "It is a list of every man your boss pays to look the other way. The names. The dates. Every Tuesday.", "name": "VIVIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Eddie takes his hand off the door.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "Marcus.", "name": "EDDIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "Not now.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Marcus, that's my cousin on page two.", "name": "EDDIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "I said not now.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "The market is closing. Everybody leave.", "name": "ZHAO", "speaker": 4, "ext": [], "paren": ["rough, quiet"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "Nobody moves.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "The tuna sway.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "The light hums.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "Vivian wipes her blade clean on her apron, once, twice, and slides it back into the rack.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "dialogue", "text": "You may keep the money. The book stays with me.", "name": "VIVIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "dialogue", "text": "And if I refuse?", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "Then you will tell your boss you walked into a freezer with a list of his friends and walked out without it.", "name": "VIVIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "Marcus closes the notebook.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "action", "text": "He holds it a long moment.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "action", "text": "He lays it back on the ice, carefully, as if it might wake.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "dialogue", "text": "Eddie, the door.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "action", "text": "Eddie opens it.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "action", "text": "Warm night air rolls in, loud with frying oil and distant music.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "action", "text": "Marcus pockets the cash and goes out without looking back.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "action", "text": "Eddie follows.", "para": 14, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "action", "text": "The door swings shut.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "action", "text": "Hannah lets the tray fall.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 76, "kind": "dialogue", "text": "Auntie, you were so calm.", "name": "HANNAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 77, "kind": "dialogue", "text": "I was so cold.", "name": "VIVIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 78, "kind": "action", "text": "Zhao exhales a long plume of smoke.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 79, "kind": "action", "text": "Vivian picks up the notebook and tucks it in her apron pocket.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4]}]}