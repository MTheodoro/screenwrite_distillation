{"scene_id": "s00347", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00347.fountain", "heading": "INT. GRAIN ELEVATOR - NIGHT", "cast": [{"id": 0, "name": "CALEB WRIGHT", "names": ["CALEB WRIGHT", "CALEB"], "gender": "m", "first": 5, "spoke": 5}, {"id": 1, "name": "AMARA OKORO", "names": ["AMARA OKORO", "AMARA"], "gender": "?", "first": 6, "spoke": 6}, {"id": 2, "name": "DEACON PRICE", "names": ["DEACON PRICE", "DEACON"], "gender": "m", "first": 7, "spoke": 6}, {"id": 3, "name": "LIV HAGEN", "names": ["LIV HAGEN", "LIV"], "gender": "f", "first": 8, "spoke": 5}, {"id": 4, "name": "PEPPER NAKAMURA", "names": ["PEPPER NAKAMURA", "PEPPER"], "gender": "f", "first": 9, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRAIN ELEVATOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A concrete tower, nine stories tall, hollow as a throat.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A rusted catwalk spirals up the inside wall.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Chutes hang like dead tongues.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Wind through broken louvres makes a sound like breathing.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CALEB WRIGHT, thirties, a tow-truck driver, leads with a flashlight.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "AMARA OKORO, thirties, his girlfriend, follows with a phone.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "DEACON PRICE, sixties, a retired farmhand, carries a lantern.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "LIV HAGEN, twenties, a student, clutches a camera.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "PEPPER NAKAMURA, forties, a county sheriff's deputy, brings up the rear with a hand on her holster.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Stay on the catwalk.", "name": "CALEB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "It's moving.", "name": "AMARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "That's just the wind, son.", "name": "DEACON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Wind doesn't whisper.", "name": "LIV", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Everybody quiet.", "name": "PEPPER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "They stop.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Something below clatters.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Grain trickles from a chute and hisses across the floor though the silo has been empty for twenty years.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Caleb.", "name": "AMARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "I see it.", "name": "CALEB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Back up, all of you.", "name": "DEACON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Did somebody say my name?", "name": "LIV", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Nobody said your name.", "name": "PEPPER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Somebody did.", "name": "LIV", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Deacon holds up the lantern.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "The flame leans toward the dark at the bottom of the tower.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Caleb sweeps his beam across the floor.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Piles of grain stir like sleepers.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "It's pulling the grain.", "name": "AMARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Pulling it where?", "name": "CALEB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Toward the hatch.", "name": "DEACON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "What hatch?", "name": "PEPPER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "The one under the scale house.", "name": "DEACON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "They all look.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "A black square gapes in the concrete, ringed with old stains.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "A cold breath rises.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Deputy, shouldn't you call somebody?", "name": "LIV", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "No signal.", "name": "PEPPER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Mine neither.", "name": "AMARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Then we leave. Now.", "name": "CALEB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "He turns and starts up the catwalk.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "The others follow.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Behind them, the grain heaves up in a wave and breaks against the wall.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Run.", "name": "DEACON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "They scramble up the spiral, boots ringing on the iron, the catwalk shaking.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Liv drops her camera.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Amara grabs her sleeve.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Pepper draws and fires once into the dark, the shot huge, and nothing answers.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Keep climbing!", "name": "CALEB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "The door at the top is chained.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "He hits it with his shoulder.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "It does not give.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Pepper puts her pistol against the lock and fires.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "The chain falls.", "para": 7, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "The door bursts open on a starry night.", "para": 7, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "They pour out onto the roof.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Deacon slams the door and braces his back against it.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "Is everyone here?", "name": "DEACON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "Five.", "name": "LIV", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "Four. Where's Pepper?", "name": "AMARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "They turn.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "The door buckles from below, once, twice.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "Something presses a hand against the inside of the steel.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "The metal bulges in the shape of fingers.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "dialogue", "text": "Don't open it.", "name": "PEPPER", "speaker": 4, "ext": ["O.S."], "paren": ["muffled, calm"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "Pepper!", "name": "AMARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "dialogue", "text": "Don't open it. I'm not the one knocking.", "name": "PEPPER", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}