{"scene_id": "s00350", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00350.fountain", "heading": "INT. COLLAPSED MINE ELEVATOR CAGE - NIGHT", "cast": [{"id": 0, "name": "DEZ", "names": ["DEZ"], "gender": "m", "first": 4, "spoke": 18}, {"id": 1, "name": "HOLLOWAY", "names": ["HOLLOWAY"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "ARCHIE PENHALIGON", "names": ["ARCHIE PENHALIGON", "ARCHIE"], "gender": "m", "first": 5, "spoke": 15}], "units": [{"u": 0, "kind": "heading", "text": "INT. COLLAPSED MINE ELEVATOR CAGE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A steel cage wedged in a vertical shaft, tilted twenty degrees, hanging by a single frayed cable.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Pebbles tick down from above.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A dim headlamp illuminates two men and a bucket of water.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DESMOND \"DEZ\" HOLLOWAY, forties, a foreman with a broken arm in a makeshift sling, sits against the bars.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "ARCHIE PENHALIGON, twenties, a fresh-faced miner with a bleeding scalp, crouches on the opposite side, rope looped round his wrist.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Archie, kid, how's your head?", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "It's fine, Dez.", "name": "ARCHIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "It's not fine. I can see it from here.", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Then don't look.", "name": "ARCHIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Dez shifts.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "The cage groans.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "The cable above pings like a plucked string.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Both men go perfectly still.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Don't breathe.", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "I'm not breathing.", "name": "ARCHIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Good man.", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "They hold.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "The cage settles.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Dez lets out a ragged breath.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Okay. Okay. We're okay.", "name": "DEZ", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Dez, how long have we been down here?", "name": "ARCHIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Nine hours.", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "They'd have come by now.", "name": "ARCHIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "They'll come.", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Dez. Nobody's coming.", "name": "ARCHIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Dez does not answer.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "He looks at his arm.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "He looks at the water bucket.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "He looks at Archie.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Archie, you're the lightest. If you climb the cable, you can reach the ladder.", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Climb it?", "name": "ARCHIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "It's twenty feet. You've done worse.", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "I've never done worse.", "name": "ARCHIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Archie.", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "He'll cut me loose, Dez. The cable. It won't take two.", "name": "ARCHIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Then it won't take one either. It'll take whatever it takes.", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Archie loops the rope around his waist.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "He tests the knot.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "His hands shake.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Hold the rope.", "name": "ARCHIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "I've got you.", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "He rises.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Dez wraps the rope around his good arm.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Archie reaches for the cable, grips it, lifts one boot.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "The cage swings.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Easy! Easy, kid!", "name": "DEZ", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "I'm easy!", "name": "ARCHIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "He climbs.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Three feet.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Five.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "The cable twangs.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "A strand parts, then another, curling like wire hair.", "para": 7, "sent": 4, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Dez cries out.", "para": 7, "sent": 5, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Archie stops.", "para": 7, "sent": 6, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "Dez, it's going!", "name": "ARCHIE", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "Keep climbing!", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "It's going, Dez!", "name": "ARCHIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "Do not stop, Archie! Do not stop!", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Archie lunges.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "His fingers catch a rung.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "The cage drops six inches with a scream of metal.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "Dez is flung against the bars.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "The rope snaps taut on his arm and he roars through his teeth.", "para": 8, "sent": 4, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "Go! Go!", "name": "DEZ", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "Archie pulls himself onto the ladder.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "He turns, hanging there, breathing like a bellows, and stares down at Dez.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 67, "kind": "dialogue", "text": "I'm on, Dez. I'm on!", "name": "ARCHIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 68, "kind": "dialogue", "text": "Of course you are.", "name": "DEZ", "speaker": 0, "ext": [], "paren": ["weak laugh"], "dual": false, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "The cable parts with a crack like a gunshot.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "The cage falls away into the dark and its crash echoes up the shaft, long after it has gone.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 71, "kind": "dialogue", "text": "Dez?", "name": "ARCHIE", "speaker": 2, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2]}, {"u": 72, "kind": "action", "text": "Nothing.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 73, "kind": "action", "text": "Then, from impossibly far below, a faint voice.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 74, "kind": "dialogue", "text": "Climb, Archie.", "name": "DEZ", "speaker": 0, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}]}