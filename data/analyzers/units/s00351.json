{"scene_id": "s00351", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00351.fountain", "heading": "EXT. SANDBAR - ESTUARY FERRY - DAY", "cast": [{"id": 0, "name": "CAPTAIN MIRIAM OKAFOR-LINDQVIST", "names": ["CAPTAIN MIRIAM OKAFOR-LINDQVIST", "MIRIAM"], "gender": "f", "first": 5, "spoke": 6}, {"id": 1, "name": "DENNIS ABERNATHY", "names": ["DENNIS ABERNATHY", "DENNIS"], "gender": "m", "first": 6, "spoke": 3}, {"id": 2, "name": "FATIMA HADDAD", "names": ["FATIMA HADDAD", "FATIMA"], "gender": "?", "first": 7, "spoke": 1}, {"id": 3, "name": "CHILD'S FATHER", "names": ["CHILD'S FATHER"], "gender": "?", "first": 8, "spoke": 0}, {"id": 4, "name": "TOMASZ NOWAK", "names": ["TOMASZ NOWAK", "TOMASZ"], "gender": "?", "first": 8, "spoke": 2}, {"id": 5, "name": "OLD PETRONELLA", "names": ["OLD PETRONELLA"], "gender": "?", "first": 9, "spoke": 0}, {"id": 6, "name": "JASPER", "names": ["JASPER"], "gender": "m", "first": 10, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SANDBAR - ESTUARY FERRY - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A small vehicle ferry grounded on a mile of shining sandbar.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The tide has gone out and left her heeled over, her ramp resting on mud.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Gulls stalk the wet.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Heat shimmers on the water's far edge.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CAPTAIN MIRIAM OKAFOR-LINDQVIST, fifties, sits on the ramp, her cap beside her.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "DENNIS ABERNATHY, forties, a salesman in a ruined suit, stands at the rail holding his shoes.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "FATIMA HADDAD, thirties, a nurse, kneels beside a child asleep on a coat.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "CHILD'S FATHER, TOMASZ NOWAK, thirties, sits by her with his hand on the child's back.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "OLD PETRONELLA, eighties, sits on a bollard knitting.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "JASPER, twenties, the engineer, stands at the engine hatch, wiping his hands on a rag.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "action", "text": "Miriam checks her watch.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "action", "text": "She checks it again.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "action", "text": "She puts it away.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "action", "text": "Dennis watches her do this and says nothing.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "How long till the tide comes back?", "name": "DENNIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "Six hours. Maybe seven.", "name": "MIRIAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "action", "text": "Dennis nods.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "action", "text": "He sets his shoes on the rail, lines them up, takes them down again.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "action", "text": "Fatima tucks the coat tighter around the child's shoulders.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "action", "text": "Tomasz watches her hands.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "action", "text": "Petronella's needles click.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "action", "text": "Jasper climbs from the hatch and stands, looking out at the sandbar, at the bright far line of the sea.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "He rolls his sleeves to the elbow.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "He rolls them down.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "Engine's fine.", "name": "JASPER", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "I know.", "name": "MIRIAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "It's the tide that's the problem.", "name": "JASPER", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "I know.", "name": "MIRIAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "Fatima rises and walks to the water jug.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "She pours a cup, brings it back to Tomasz.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "He takes it.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "action", "text": "He drinks half and gives the rest to the child, who stirs and sips without waking.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "Dennis turns his face to the sky as if looking for rain.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "We could walk.", "name": "DENNIS", "speaker": 1, "ext": [], "paren": ["to the deck"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "No.", "name": "MIRIAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "It's only a mile.", "name": "DENNIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "The channel is deeper than it looks.", "name": "MIRIAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "Dennis shrugs.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "He sits on the rail.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "Petronella's needles click twice and stop.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "She holds up her knitting to the light and examines it, turns it over, resumes.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "dialogue", "text": "Is there more water?", "name": "TOMASZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "dialogue", "text": "Two jugs.", "name": "JASPER", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "dialogue", "text": "Then there is enough.", "name": "TOMASZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "action", "text": "Nobody argues.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "action", "text": "Gulls cry overhead.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "Out on the flat, a line of ripples begins to form, very slowly, a long way off.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "Miriam sees it first.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "action", "text": "She keeps her face still.", "para": 7, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "action", "text": "She picks up her cap and puts it on.", "para": 7, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "action", "text": "She says nothing to anyone, and one by one the others notice her, and notice what she is looking at, and sit very straight and quiet to wait.", "para": 7, "sent": 6, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "dialogue", "text": "Is that the tide?", "name": "FATIMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "dialogue", "text": "That is the tide.", "name": "MIRIAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "action", "text": "Fatima touches the child's hair.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "action", "text": "Tomasz closes his eyes.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "action", "text": "Dennis sets his shoes down, side by side, with care.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "action", "text": "Jasper wipes his hands on the rag one more time, unhurried, and folds it, and puts it in his pocket.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}]}