{"scene_id": "s00352", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00352.fountain", "heading": "INT. FAMILY HARDWARE STORE - AFTER HOURS - NIGHT", "cast": [{"id": 0, "name": "ROSE LINDQVIST", "names": ["ROSE LINDQVIST", "ROSE"], "gender": "?", "first": 5, "spoke": 9}, {"id": 1, "name": "HENRY LINDQVIST", "names": ["HENRY LINDQVIST", "HENRY"], "gender": "m", "first": 5, "spoke": 13}, {"id": 2, "name": "MARGO LINDQVIST-BYRNE", "names": ["MARGO LINDQVIST-BYRNE", "MARGO"], "gender": "?", "first": 7, "spoke": 5}, {"id": 3, "name": "DANNY LINDQVIST", "names": ["DANNY LINDQVIST", "DANNY"], "gender": "?", "first": 5, "spoke": 7}, {"id": 4, "name": "UNCLE FRITZ", "names": ["UNCLE FRITZ", "FRITZ"], "gender": "?", "first": 9, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. FAMILY HARDWARE STORE - AFTER HOURS - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A narrow hardware store, aisles crowded floor to ceiling with bins of nails, rope, washers, paint cans.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single bulb hangs over the register.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cardboard sign taped to the door reads: \"CLOSED.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "FOREVER?\"", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ROSE LINDQVIST, sixties, the widow, sits on a stool at the register, a cigar box open in front of her.", "para": 1, "sent": 0, "present": [0, 1, 3]}, {"u": 6, "kind": "action", "text": "HENRY LINDQVIST, forties, her eldest, in a suit, paces the center aisle.", "para": 1, "sent": 1, "present": [0, 1, 3]}, {"u": 7, "kind": "action", "text": "MARGO LINDQVIST-BYRNE, thirties, her daughter, leans against the paint counter with her arms crossed.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "DANNY LINDQVIST, twenty-five, her youngest, sits on an upturned bucket by the door.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "UNCLE FRITZ, seventies, Rose's brother-in-law, polishes a hammer with a rag, saying nothing.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Mom, the offer expires Friday.", "name": "HENRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "I know when Friday is.", "name": "ROSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Henry, can you sit down?", "name": "MARGO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "I'm trying to help.", "name": "HENRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "You're trying to pace.", "name": "MARGO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Danny, tell her.", "name": "HENRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Tell her what?", "name": "DANNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "That fourteen hundred square feet next to a Whole Foods is worth three times what this place makes.", "name": "HENRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "I don't know, Henry.", "name": "DANNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "You don't know.", "name": "HENRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "It's Dad's store.", "name": "DANNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Dad's dead, Danny.", "name": "HENRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Silence.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Fritz stops polishing.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Margo uncrosses her arms.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Rose closes the cigar box with a small click.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Say that again.", "name": "ROSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Mom, I didn't mean...", "name": "HENRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Say it again, Henry. To my face.", "name": "ROSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Henry stops in the middle of the aisle.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "He opens his mouth.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "He closes it.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Mom.", "name": "MARGO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Quiet, Margo.", "name": "ROSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Danny stands.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "The bucket tips and clatters.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Henry spins toward the sound, his sleeve catching a display of screwdrivers, and a hundred handles hit the floor, rolling.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Great. Fantastic.", "name": "HENRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "I've got it.", "name": "DANNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Leave it, Danny!", "name": "HENRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "I said I've got it!", "name": "DANNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "He drops to his knees and gathers the screwdrivers.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Margo kneels beside him.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Henry stands with his hands open at his sides.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Fritz sets down the hammer, picks up a broom, and begins to sweep, slow and steady.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Your father kept the books in this box.", "name": "ROSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "She lifts the lid.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Inside are index cards, hundreds of them, in neat blue ink.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Every customer who ever couldn't pay. Every tab he let ride. Forty years.", "name": "ROSE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Mom, I never knew.", "name": "MARGO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Nobody did. That's the thing about your father. He never wanted to be thanked.", "name": "ROSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "How much is owed?", "name": "HENRY", "speaker": 1, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "I haven't counted. I think it's more than the Whole Foods offer.", "name": "ROSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Henry laughs once, a helpless sound.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "He sits down on the floor in the middle of the screwdrivers.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "Uncle Fritz, did you know?", "name": "HENRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "I wrote half those cards.", "name": "FRITZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "We're not selling.", "name": "DANNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "Danny.", "name": "HENRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "We're not selling it, Henry.", "name": "DANNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "No.", "name": "MARGO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "Then we run it. All four of us. Like he did.", "name": "HENRY", "speaker": 1, "ext": [], "paren": ["rising, pulling at his tie"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "dialogue", "text": "Five.", "name": "ROSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "She nods at Fritz.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "He lifts the broom in salute.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "Henry crosses to the register and takes the cigar box in both hands, and Rose lets him.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}]}