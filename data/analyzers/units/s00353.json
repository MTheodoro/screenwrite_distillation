{"scene_id": "s00353", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00353.fountain", "heading": "INT. FUNERAL PARLOR SPEAKEASY - 1927 - NIGHT", "cast": [{"id": 0, "name": "MAGDA", "names": ["MAGDA"], "gender": "?", "first": 3, "spoke": 1}, {"id": 1, "name": "FOSTER", "names": ["FOSTER"], "gender": "m", "first": 4, "spoke": 1}, {"id": 2, "name": "LENNY", "names": ["LENNY"], "gender": "m", "first": 5, "spoke": 0}, {"id": 3, "name": "ODETTE", "names": ["ODETTE"], "gender": "?", "first": 6, "spoke": 0}, {"id": 4, "name": "PIANIST", "names": ["PIANIST"], "gender": "?", "first": 7, "spoke": 0}, {"id": 5, "name": "MAN", "names": ["MAN"], "gender": "?", "first": 8, "spoke": 0}, {"id": 6, "name": "DIRECTOR", "names": ["DIRECTOR"], "gender": "?", "first": 13, "spoke": 2}, {"id": 7, "name": "WHITCOMB", "names": ["WHITCOMB"], "gender": "?", "first": 15, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. FUNERAL PARLOR SPEAKEASY - 1927 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Velvet drapes, casket stands doubling as bars.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A jazz trio plays muted.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "MAGDA, thirties, a bartender, pours gin into teacups.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "FOSTER, forties, a bootlegger, counts bills.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "LENNY, twenties, his nephew, dozes in a coffin cushion.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "ODETTE, twenties, a singer, sips at the piano.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "THE PIANIST, sixties, plays on.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "A MAN, fifties, in a black frock coat and a funeral director's pin, steps in from the foyer.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "Fosse's here.", "name": "MAGDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "She sets down the bottle.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "He surveys the room.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "Foster pockets his cash.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Evening. I run this establishment.", "name": "DIRECTOR", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "We've been paying your rent.", "name": "FOSTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "I'm told that was not rent. I am Mr. Whitcomb.", "name": "DIRECTOR", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 16, "kind": "dialogue", "text": "And I'd like my casket stands back.", "name": "WHITCOMB", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 17, "kind": "action", "text": "Lenny wakes.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 18, "kind": "action", "text": "He rolls out of the cushion.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 19, "kind": "action", "text": "Odette stops singing.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 20, "kind": "action", "text": "The pianist plays one wrong note and stops.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}