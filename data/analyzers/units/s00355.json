1, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "dialogue", "text": "Greg, your call time is nine minutes.", "name": "BARB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "It's the sea, Barb. Signal drifts.", "name": "GREG", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "Barb, how do I unmute?", "name": "TRISH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "Trish, you're not muted.", "name": "BARB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "Hello? Is this the help line? My cabin is on fire.", "name": "CUSTOMER", "speaker": 0, "ext": ["V.O."], "paren": ["over headset"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "Please hold. Your call is important.", "name": "GREG", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "action", "text": "The Auditor stands.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "action", "text": "He strides to Barb.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "Barbara Finch?", "name": "THE AUDITOR", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "It's Barb.", "name": "BARB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "It is now \"Ms. Finch, Director of Delight.\"", "name": "AUDITOR", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "I got promoted.", "name": "BARB", "speaker": 1, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Of course she did.", "name": "OMAR", "speaker": 4, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "Nikolai drops the mop.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "The ship lurches.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "action", "text": "Greg pulls off his headset.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "Barb? About that fire.", "name": "GREG", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}