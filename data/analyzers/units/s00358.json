{"scene_id": "s00358", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00358.fountain", "heading": "EXT. FIELD BAKERY - ARMY CAMP - DAWN", "cast": [{"id": 0, "name": "MOLLY HENDERSON", "names": ["MOLLY HENDERSON", "MOLLY"], "gender": "f", "first": 6, "spoke": 6}, {"id": 1, "name": "REUBEN ALVAREZ", "names": ["REUBEN ALVAREZ", "REUBEN"], "gender": "f", "first": 8, "spoke": 1}, {"id": 2, "name": "KIM SOO-JIN", "names": ["KIM SOO-JIN"], "gender": "?", "first": 10, "spoke": 0}, {"id": 3, "name": "ISAAC BERNSTEIN", "names": ["ISAAC BERNSTEIN", "ISAAC"], "gender": "m", "first": 11, "spoke": 3}, {"id": 4, "name": "TATUM", "names": ["TATUM"], "gender": "?", "first": 13, "spoke": 0}, {"id": 5, "name": "GENERAL'S AIDE", "names": ["GENERAL'S AIDE", "AIDE"], "gender": "?", "first": 25, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FIELD BAKERY - ARMY CAMP - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A canvas-roofed bakery tent in a muddy field.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Brick ovens glow.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Flour dusts the air.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Beyond the tent flap, a line of tanks sleeps under camouflage netting.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "It is quiet, too quiet.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "SGT. MOLLY HENDERSON, forties, a head baker with floury forearms, kneads dough at a steel table, humming.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "CPL.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "REUBEN ALVAREZ, twenties, shapes loaves beside her.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "PVT.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "KIM SOO-JIN, twenty, feeds the oven with split logs.", "para": 1, "sent": 4, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "CAPT. ISAAC BERNSTEIN, thirties, the camp quartermaster, leans on a crate eating a crust.", "para": 1, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "PVT.", "para": 1, "sent": 6, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "WILLIAM \"BILLY\" TATUM, nineteen, sweeps flour into a pan.", "para": 1, "sent": 7, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Molly flips the dough, slaps it on the table, and calls out the count while Reuben rolls two loaves onto a peel and slides them into the oven, Soo-Jin ladling water over the bricks to make steam, and Isaac tears his crust in half and offers it to Billy, who takes it and chews with his broom in his other hand.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Forty loaves by six.", "name": "MOLLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Thirty-eight, Sarge. Two burned.", "name": "REUBEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Then forty by six-fifteen.", "name": "MOLLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "It's a fine morning for it.", "name": "ISAAC", "speaker": 3, "ext": [], "paren": ["to Molly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "It's a fine morning, Captain.", "name": "MOLLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "A shadow passes over the tent flap.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "They don't notice.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "The humming resumes.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Billy sweeps.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Soo-Jin stokes the fire.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "A GENERAL'S AIDE, thirties, in a crisp uniform, lifts the flap and steps in, carrying a telegram.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "He stands, scanning the faces.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Molly looks up.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Her hands go still.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Sergeant Henderson?", "name": "AIDE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Speaking.", "name": "MOLLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "The Captain is to report to Command at once.", "name": "AIDE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "What for?", "name": "ISAAC", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "The convoy's been turned back. The bridge at Sainte-Marie is gone.", "name": "AIDE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "The tent goes quiet.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Reuben sets down the peel.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Soo-Jin drops a log.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Billy lets the broom fall.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Isaac swallows the last of his crust.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Molly wipes her hands on her apron one finger at a time.", "para": 5, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Nobody panic. Forty loaves by six.", "name": "MOLLY", "speaker": 0, "ext": [], "paren": ["to the group"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Molly.", "name": "ISAAC", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Captain, men fight on bread.", "name": "MOLLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "He nods.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "He turns and follows the Aide out.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "The flap falls shut.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Reuben picks up the peel.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "Soo-Jin picks up a log.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "Billy picks up the broom.", "para": 6, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "Molly resumes kneading, slowly, harder than before, and the humming does not come back.", "para": 6, "sent": 6, "present": [0, 1, 2, 3, 4, 5]}]}