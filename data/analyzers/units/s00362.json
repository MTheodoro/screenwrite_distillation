{"scene_id": "s00362", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00362.fountain", "heading": "EXT. ICE-FISHING SHACK VILLAGE - FROZEN LAKE - DUSK", "cast": [{"id": 0, "name": "HALVARD", "names": ["HALVARD"], "gender": "?", "first": 3, "spoke": 3}, {"id": 1, "name": "ANNIKA", "names": ["ANNIKA"], "gender": "m", "first": 4, "spoke": 4}, {"id": 2, "name": "RUSLAN", "names": ["RUSLAN"], "gender": "?", "first": 5, "spoke": 2}, {"id": 3, "name": "TOVA", "names": ["TOVA"], "gender": "m", "first": 6, "spoke": 1}, {"id": 4, "name": "BJORN", "names": ["BJORN"], "gender": "?", "first": 7, "spoke": 1}, {"id": 5, "name": "OLD MARGIT", "names": ["OLD MARGIT", "MARGIT"], "gender": "?", "first": 8, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ICE-FISHING SHACK VILLAGE - FROZEN LAKE - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "A scatter of tarpaper shacks on a vast white lake, each with a stovepipe breathing smoke.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The wind has a knife in it.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "HALVARD, sixties, a fisherman in a fur hat, crouches at a hole with a jig.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "ANNIKA, thirties, his daughter, holds a thermos.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "RUSLAN, forties, a stranger in a thin jacket, stands in the doorway.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "TOVA, ten, sits on a bucket.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "BJORN, thirties, Annika's husband, tends the stove.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "OLD MARGIT, eighties, wrapped in two blankets, dozes in the corner.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "action", "text": "Halvard hauls up a line.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "Nothing on it.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "He drops it back.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "Ruslan watches, shivering.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "Annika offers him the thermos.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "He takes it with both hands.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Thank you.", "name": "RUSLAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Close the door.", "name": "ANNIKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "My car is dead.", "name": "RUSLAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Sit by the stove.", "name": "BJORN", "speaker": 4, "ext": [], "paren": ["to Ruslan"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Ruslan sits.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Tova stares at his shoes.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Margit stirs.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Ice is thinning.", "name": "MARGIT", "speaker": 5, "ext": [], "paren": ["to nobody"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Margit, sleep.", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Papa, listen.", "name": "ANNIKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "A groan from the lake, long and deep, like a whale turning.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Everyone looks at the floor.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Out. All of us.", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Papa, the ice...", "name": "ANNIKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Now!", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Mama!", "name": "TOVA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Go!", "name": "ANNIKA", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4, 5]}]}