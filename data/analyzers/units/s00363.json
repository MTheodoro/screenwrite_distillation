{"scene_id": "s00363", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00363.fountain", "heading": "INT. SEED VAULT - ARCTIC ISLAND - NIGHT", "cast": [{"id": 0, "name": "IVO LUNDQVIST", "names": ["IVO LUNDQVIST", "IVO"], "gender": "m", "first": 3, "spoke": 4}, {"id": 1, "name": "NORA", "names": ["NORA"], "gender": "?", "first": 5, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. SEED VAULT - ARCTIC ISLAND - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A frozen concrete tunnel, shelves of sealed foil packets disappearing into the dark.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Every breath is a cloud.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "IVO LUNDQVIST, forties, a thief in a thermal suit, kneels at a steel case, a pry bar in his gloved hands.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "His earpiece crackles.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "dialogue", "text": "Ivo, you have six minutes before the guard rotation.", "name": "NORA", "speaker": 1, "ext": ["V.O."], "paren": ["over earpiece"], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "I know.", "name": "IVO", "speaker": 0, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He cracks the case.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "It opens.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Inside lies a single glass vial, pale gold.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Don't touch it. Is it the right strain?", "name": "NORA", "speaker": 1, "ext": ["V.O."], "paren": ["over earpiece"], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He lifts it to the light.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He turns it.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He sets it back.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Wrong label.", "name": "IVO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Then try the next case.", "name": "NORA", "speaker": 1, "ext": ["V.O."], "paren": ["over earpiece"], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He rises.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He crosses the tunnel in three strides.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He pries the second case.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "A siren starts low and climbs.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Ivo lunges backward, slips on the ice, and the vial flies out of his hand.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Ivo! What happened?", "name": "NORA", "speaker": 1, "ext": ["V.O."], "paren": ["over earpiece"], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Ivo and the vial hang in the air for a long beat.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "He catches it a hand's width above the floor.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "The siren stops.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Silence.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Got it.", "name": "IVO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Good. Now turn around.", "name": "NORA", "speaker": 1, "ext": ["V.O."], "paren": ["over earpiece, quiet"], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "He does.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "A single red dot rests on his chest.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "At the end of the tunnel, the guard lowers a rifle.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Nora?", "name": "IVO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "He pays better.", "name": "NORA", "speaker": 1, "ext": ["V.O."], "paren": ["over earpiece"], "dual": false, "present": [0, 1]}]}