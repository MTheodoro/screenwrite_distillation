{"scene_id": "s00365", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00365.fountain", "heading": "EXT. ROWBOAT - MIDDLE OF A MIST-BOUND LAKE - DAWN", "cast": [{"id": 0, "name": "BEATRIX LOWELL", "names": ["BEATRIX LOWELL", "BEATRIX"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "CAROLINE LOWELL", "names": ["CAROLINE LOWELL", "CAROLINE"], "gender": "?", "first": 4, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ROWBOAT - MIDDLE OF A MIST-BOUND LAKE - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A battered rowboat drifts on glass-flat water, fog pressing in from every side.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The oars lie shipped.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A tackle box rests open between two seats.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "BEATRIX LOWELL, sixties, in a yellow slicker, holds a rod.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Her daughter CAROLINE LOWELL, thirties, sits opposite, hands wrapped round a thermos.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Neither has caught a thing.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Neither has spoken for an hour.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "A loon calls across the water.", "para": 1, "sent": 4, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Beatrix reels in.", "para": 1, "sent": 5, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Caroline watches the line.", "para": 1, "sent": 6, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "You never liked fishing.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I liked sitting with you.", "name": "CAROLINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "That's not the same.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "It was for me.", "name": "CAROLINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Beatrix casts again.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "The lure arcs, plops.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She does not look up.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "She called me, you know.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Who?", "name": "CAROLINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Your sister. She said you'd been dodging her.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "She's the one who stopped answering.", "name": "CAROLINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "That's not what she said.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Mother, please.", "name": "CAROLINE", "speaker": 1, "ext": [], "paren": ["rising from the seat"], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Sit down before you tip us!", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "You always do this!", "name": "CAROLINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "She stands.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "The boat rocks.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Beatrix grabs the gunwale.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "She lifts her eyes, finally, and the two women glare at each other across the fog, the loon crying again, closer.", "para": 3, "sent": 3, "present": [0, 1]}]}