{"scene_id": "s00366", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00366.fountain", "heading": "INT. MATTRESS SHOWROOM - DAY", "cast": [{"id": 0, "name": "DUANE PETTIGREW", "names": ["DUANE PETTIGREW", "DUANE"], "gender": "m", "first": 4, "spoke": 2}, {"id": 1, "name": "LUCINDA FROST", "names": ["LUCINDA FROST", "LUCINDA"], "gender": "m", "first": 5, "spoke": 2}, {"id": 2, "name": "THEO FROST", "names": ["THEO FROST", "THEO"], "gender": "?", "first": 5, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. MATTRESS SHOWROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A cavernous warehouse of beds.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Banners scream \"BLOWOUT.\"", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A fake sunrise glows over a king-size.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DUANE PETTIGREW, forties, a salesman in a shiny tie, hovers over a couple.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "LUCINDA FROST, thirties, bounces gently on a firm model.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "Her husband THEO FROST, thirties, lies flat on a plush one with his shoes on.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "This one has four layers of memory foam.", "name": "DUANE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "I'll take your word.", "name": "LUCINDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Duane clasps his hands.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Theo rolls over and sinks into the foam with a long sigh while Lucinda stands and moves to a third bed, which Duane hurriedly pats, and while Theo's shoes drag a smear of mud across the quilted top, Duane gasps and lunges with a wipe, and Lucinda kneels to inspect the springs.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I can't get up.", "name": "THEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "It's only a mattress.", "name": "LUCINDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "It has me.", "name": "THEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "That's the contouring technology!", "name": "DUANE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Duane takes Theo's arm and heaves.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Theo comes up an inch and falls back.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Lucinda grabs his other arm.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "They pull in unison and the three tumble off the edge of the bed in a heap, the sign \"BLOWOUT\" swaying overhead.", "para": 3, "sent": 3, "present": [0, 1, 2]}]}