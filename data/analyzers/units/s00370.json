{"scene_id": "s00370", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00370.fountain", "heading": "INT. GRAIN BARGE \"MARIE LOUISE\" - GALLEY - NIGHT", "cast": [{"id": 0, "name": "HALVARD KROGH", "names": ["HALVARD KROGH", "HALVARD"], "gender": "m", "first": 4, "spoke": 11}, {"id": 1, "name": "INGRID", "names": ["INGRID"], "gender": "?", "first": 5, "spoke": 8}, {"id": 2, "name": "TOBY", "names": ["TOBY"], "gender": "?", "first": 6, "spoke": 5}, {"id": 3, "name": "BRONWEN PELL", "names": ["BRONWEN PELL", "BRONWEN"], "gender": "?", "first": 7, "spoke": 4}, {"id": 4, "name": "KNOCK", "names": ["KNOCK"], "gender": "?", "first": 20, "spoke": 0}, {"id": 5, "name": "STRANGER", "names": ["STRANGER"], "gender": "m", "first": 27, "spoke": 3}, {"id": 6, "name": "OSKAR", "names": ["OSKAR"], "gender": "?", "first": 34, "spoke": 14}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRAIN BARGE \"MARIE LOUISE\" - GALLEY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A narrow cabin frozen into the river ice.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A cast-iron stove ticks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Frost feathers the porthole.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "HALVARD KROGH, 60, barge captain, bearded, patient hands, ladles thin soup into tin bowls.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "His daughter INGRID, 30, wrapped in a army blanket, counts crackers into piles on the table.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "TOBY, 10, Ingrid's son, sits cross-legged on the bunk, tracing a face in the frost on the glass.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "BRONWEN PELL, 70, a retired schoolteacher with a deaf ear and a sharp one, knits something that is clearly never going to be finished.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Eight days. The ice master said ten at most.", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "He also said the thaw would come on the first.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "What was that?", "name": "BRONWEN", "speaker": 3, "ext": [], "paren": ["too loud"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Nothing, Mrs. Pell.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Grandpa, the stove's quiet.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "It's saving its strength.", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "A calm settles.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "The soup steams.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Even the wind seems to have gone to bed.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Ingrid slides a cracker pile toward her son and he slides it back.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Eat, Toby.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "You first.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "A KNOCK on the hull.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Three slow raps.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Everyone stops.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Halvard sets down the ladle.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "He takes a boat hook from the wall and opens the hatch.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Snow blows in.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "A man stands on the ice, hatless, rimed white, a canvas sack over one shoulder.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "This is the STRANGER, 40s, soft-spoken, smiling with the lower half of his face only.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Forgive me. I saw your smoke from the north bank. I walked a long way.", "name": "STRANGER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Nobody walks that ice. It's rotten past the channel buoy.", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Then I walked carefully.", "name": "STRANGER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Halvard weighs him, then steps back.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "The stranger climbs down and sits where he is told, nearest the stove.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "What's your name?", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Oskar. Oskar Venn.", "name": "STRANGER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "Venn? I taught a Venn. Little boy, wet cough, always drew boats.", "name": "BRONWEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "Not me, I'm afraid.", "name": "OSKAR", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "Ingrid. Soup.", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "Ingrid hands Oskar a bowl.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "He holds it with both hands and does not drink.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "Is it only the four of you?", "name": "OSKAR", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "dialogue", "text": "Does it matter?", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "dialogue", "text": "Only in the way that counting matters.", "name": "OSKAR", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "dialogue", "text": "We're not four. There's Gunnar.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "dialogue", "text": "Toby.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "He's under the deck.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "action", "text": "Silence.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "Halvard looks at his daughter.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "She looks at the floor.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "dialogue", "text": "Under the deck.", "name": "OSKAR", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "dialogue", "text": "My deckhand. He went through the ice on the third day, going for the line. We brought him back. We have not been able to take him ashore.", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "dialogue", "text": "I'm sorry.", "name": "OSKAR", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "dialogue", "text": "You're not.", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "dialogue", "text": "No. I'm not. I'm relieved. I won't have to explain myself to a man who's still looking for his friend.", "name": "OSKAR", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "dialogue", "text": "What did he say?", "name": "BRONWEN", "speaker": 3, "ext": [], "paren": ["very loud"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "dialogue", "text": "Mr. Venn, tell me why you walked out here.", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "dialogue", "text": "There were nine of us on the grain wharf at the start. We drew straws for who walked the river. The others are sleeping in a warehouse with the doors chained. I did not draw a short straw, Captain. I drew the only straw that said the barge had food.", "name": "OSKAR", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "dialogue", "text": "Who told you we had food?", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "dialogue", "text": "The man who sold you the flour, three weeks ago. He sold it to us as well. He kept a ledger of every boat that bought from him, and every boat that did not leave before the freeze.", "name": "OSKAR", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 59, "kind": "dialogue", "text": "You're from the company.", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 60, "kind": "dialogue", "text": "I'm from the harbor. The company is a letter on the door. Nobody's coming for this barge, Captain. Not on the first. Not on the tenth. They wrote you off the day the ice closed, and the river has been kind to them by taking you quietly.", "name": "OSKAR", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 61, "kind": "dialogue", "text": "Mom?", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 62, "kind": "dialogue", "text": "Hush.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 63, "kind": "dialogue", "text": "I have bread in this sack. And salt. And a lantern, which is how I found you. I came to trade.", "name": "OSKAR", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 64, "kind": "dialogue", "text": "Trade what?", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 65, "kind": "dialogue", "text": "Passage. There is a way across that holds. I walked it. I can take two more tonight, three if the child is small and nobody argues.", "name": "OSKAR", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 66, "kind": "dialogue", "text": "Two?", "name": "BRONWEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 67, "kind": "dialogue", "text": "Three.", "name": "OSKAR", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 68, "kind": "action", "text": "Halvard lowers the boat hook.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 69, "kind": "action", "text": "Ingrid stands.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 70, "kind": "action", "text": "The stove pops, loud as a shot, and nobody looks at it.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 71, "kind": "dialogue", "text": "Three of five.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 72, "kind": "dialogue", "text": "Three of five. I did not draw the numbers.", "name": "OSKAR", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 73, "kind": "action", "text": "Halvard slowly turns to the hatch, reaches for the lantern, and blows it out.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 74, "kind": "action", "text": "The galley falls dark but for the red slot of the stove.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 75, "kind": "dialogue", "text": "Then you will wait for morning, Mr. Venn. And in the morning, you will show me this way across. Alone.", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 76, "kind": "dialogue", "text": "That is not the arrangement.", "name": "OSKAR", "speaker": 6, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 77, "kind": "action", "text": "In the dark, the sound of a knife leaving a sheath.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 78, "kind": "action", "text": "It is not Halvard's.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}]}