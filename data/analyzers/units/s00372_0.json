{"scene_id": "s00372_0", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00372.fountain", "heading": "INT. ROLLER RINK - AFTER CLOSING - NIGHT", "cast": [{"id": 0, "name": "JUNE ABARA", "names": ["JUNE ABARA", "JUNE"], "gender": "f", "first": 4, "spoke": 3}, {"id": 1, "name": "CALVIN", "names": ["CALVIN"], "gender": "m", "first": 5, "spoke": 2}, {"id": 2, "name": "RAFA", "names": ["RAFA"], "gender": "?", "first": 6, "spoke": 3}, {"id": 3, "name": "PRIYA", "names": ["PRIYA"], "gender": "f", "first": 6, "spoke": 2}, {"id": 4, "name": "DUBOIS", "names": ["DUBOIS", "MR. DUBOIS"], "gender": "m", "first": 7, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROLLER RINK - AFTER CLOSING - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Half the lights are off.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The disco ball turns slowly over an empty floor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rental skates hang in pairs along a wall.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "JUNE ABARA, 16, sits on the carpeted bench lacing a skate she has already laced.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her brother CALVIN, 19, stacks chairs with his back to her.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "RAFA, 17, and PRIYA, 16, hover near the snack counter, sharing one bag of chips and not eating them.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "MR. DUBOIS, 55, rink manager, jingles keys by the front door.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "Ten minutes, kids. I'm not paying the electric for a goodbye.", "name": "MR. DUBOIS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "Nobody moves.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Calvin sets one chair down harder than needed.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "You could have said something, June.", "name": "RAFA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "I said it.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Not to her.", "name": "RAFA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Priya looks at the floor.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "June pulls the lace tighter and the skate goes white at the toe.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Mom's in the car.", "name": "CALVIN", "speaker": 1, "ext": [], "paren": ["not turning"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "I know.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "She's been in the car forty minutes.", "name": "CALVIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "June stands.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "She wobbles, steadies, rolls two feet toward the floor, and stops at the edge like it is a curb.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "I'll go with you.", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "I'll go with you.", "name": "RAFA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "They say it together.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Both stop.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Neither looks at the other.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "I'll go with you. ^RAFA I'll go with you.", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "You two are the worst.", "name": "JUNE", "speaker": 0, "ext": [], "paren": ["a small laugh that dies"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "She rolls out onto the floor.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "One slow lap.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Priya and Rafa watch.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Calvin has stopped stacking.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Halfway round she tips her head back to the disco ball.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "It throws small white dots across her face, and she lets them.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "June. That's time.", "name": "MR. DUBOIS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "She finishes the lap.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "At the bench she sits, unlaces the skate, and hands it to Calvin.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "He takes it without a word and puts it on the shelf.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "He holds her shoe out.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "She puts it on.", "para": 10, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "At the door, Priya hands her the bag of chips.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "June takes one.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Eats it.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Gives the bag back.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4]}]}