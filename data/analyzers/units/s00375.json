{"scene_id": "s00375", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00375.fountain", "heading": "INT. GONDOLA CABLE CAR - ABOVE A GORGE - DAY", "cast": [{"id": 0, "name": "TESS", "names": ["TESS"], "gender": "f", "first": 4, "spoke": 4}, {"id": 1, "name": "RUBEN", "names": ["RUBEN"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "AMARA", "names": ["AMARA"], "gender": "f", "first": 6, "spoke": 4}, {"id": 3, "name": "WEN", "names": ["WEN"], "gender": "m", "first": 7, "spoke": 3}, {"id": 4, "name": "STRANGER", "names": ["STRANGER"], "gender": "m", "first": 8, "spoke": 4}, {"id": 5, "name": "DELPHINE", "names": ["DELPHINE"], "gender": "?", "first": 27, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. GONDOLA CABLE CAR - ABOVE A GORGE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Stalled mid-span.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wind rocks the cabin.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A hundred meters of nothing below.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "TESS, 30s, climbing jacket, sits on the floor with her back to the door.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "RUBEN, 40s, her husband, stands with his palms on the glass.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "AMARA, 16, headphones around her neck, picks at a hole in her sleeve.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "WEN, 70s, in a wool cap, eats sunflower seeds with great deliberation.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "A fifth figure sits apart: a STRANGER, 50s, in a rain shell, sunglasses on, a duffel on his lap.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "He hasn't said a word in two hours.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "The next car's at the station. They said an hour.", "name": "RUBEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "They said an hour at the last hour.", "name": "TESS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Wen spits a shell into his palm.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Amara watches the bag in the stranger's lap.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "What's in the bag?", "name": "AMARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "The Stranger turns his head.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Smiles.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Rope.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Real rope?", "name": "TESS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Forty meters. Rated.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Why didn't you say?", "name": "RUBEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "You'd have wanted to use it.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "The cabin sways.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Tess swallows.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Nobody speaks.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "The Stranger takes off his glasses.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "His eyes are red, tired.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Delphine. My name. I was the one who rode the line crew when they rebuilt this span in '09.", "name": "STRANGER", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "You're the engineer.", "name": "WEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "I was. I signed the inspection. I come up here every year on the same day.", "name": "DELPHINE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Why?", "name": "RUBEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Because the weld under your feet has a crack I wrote off as cosmetic.", "name": "DELPHINE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Tess's eyes go slowly to the floor under her.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Amara pulls her knees up.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Ruben stops breathing.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "How long?", "name": "TESS", "speaker": 0, "ext": [], "paren": ["very quiet"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "It hasn't moved in fifteen years. But then it hasn't been stopped in the wind before, either.", "name": "DELPHINE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Is the rope for us?", "name": "WEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "It's for one at a time. Down the cable, to the pylon. It's two hundred meters, and a harness I made out of seatbelt.", "name": "DELPHINE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "I'll go.", "name": "AMARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "No.", "name": "TESS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "I'm lightest.", "name": "AMARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "Amara, sit.", "name": "RUBEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "I'm the one who said it, so I'm the one who goes.", "name": "AMARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Nobody goes yet. I don't want to be right today. I want to be wrong, and I want a rescue car to come over that hill with a man in a yellow helmet who tells me I'm an idiot.", "name": "DELPHINE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Out of the gray, a distant engine.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "Everyone turns.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "Wen slowly puts a seed in his mouth.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "I'd like that too.", "name": "WEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "The engine grows louder.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Delphine does not look up.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "She is watching the floor.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}