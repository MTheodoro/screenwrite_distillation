{"scene_id": "s00378", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00378.fountain", "heading": "INT. ABANDONED PLANETARIUM - NIGHT", "cast": [{"id": 0, "name": "BILLIE STROUD", "names": ["BILLIE STROUD", "BILLIE"], "gender": "?", "first": 4, "spoke": 7}, {"id": 1, "name": "PEREGRINE LOWE", "names": ["PEREGRINE LOWE", "PEREGRINE"], "gender": "?", "first": 6, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED PLANETARIUM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A dead dome.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Seats in tiers.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dust turns slowly in a flashlight beam.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "BILLIE STROUD, 40s, detective, coat open, steps over a tipped chair.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "A projector lies on its side.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "dialogue", "text": "Peregrine Lowe.", "name": "BILLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "From the dark of the control booth, a man leans into the light: PEREGRINE LOWE, 60s, tweed, handsome in a ruined way, a lantern on his knee.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Detective Stroud. You found it faster than I'd hoped.", "name": "PEREGRINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "The ticket stub in the victim's coat.", "name": "BILLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I thought you'd miss it.", "name": "PEREGRINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "You wanted me to find it.", "name": "BILLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Billie, I wanted you to look up.", "name": "PEREGRINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Billie lifts the flashlight.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Overhead, the dome is painted with constellations, hand-lettered.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "One star is circled in red.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "That isn't Orion.", "name": "BILLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "It's the only wrong star in the sky. That's how Marguerite signed her work.", "name": "PEREGRINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "She's been dead since 1998.", "name": "BILLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "That's what I was told.", "name": "PEREGRINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "He turns off the lantern.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "The dome goes black.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Then, soft, a hum, and the ceiling begins to glow, one star at a time.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Peregrine. What did you start?", "name": "BILLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Nothing. Watch.", "name": "PEREGRINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Billie lowers the flashlight.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "The wrong star pulses.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "A door she hasn't seen opens in the dome's painted rim.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Who's behind that?", "name": "BILLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Billie. She has been waiting a long time to be asked.", "name": "PEREGRINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}