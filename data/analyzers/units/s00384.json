{"scene_id": "s00384", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00384.fountain", "heading": "INT. WITCH'S TOWER - SPIRAL STAIR - NIGHT", "cast": [{"id": 0, "name": "ZEPHYRINE", "names": ["ZEPHYRINE"], "gender": "f", "first": 4, "spoke": 9}, {"id": 1, "name": "BRYNJA", "names": ["BRYNJA"], "gender": "?", "first": 5, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. WITCH'S TOWER - SPIRAL STAIR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Stone.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Torchlight.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wind howling through arrow slits.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ZEPHYRINE, 50, witch, robes patched with stolen feathers, climbs backward, pointing a staff down the stairwell.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "BRYNJA, 30, knight, dented plate, longsword out, climbs forward, pushing up.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "They meet at a landing and stop.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "You're the witch.", "name": "BRYNJA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You're the knight.", "name": "ZEPHYRINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "You're under arrest.", "name": "BRYNJA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Under what?", "name": "ZEPHYRINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "The king's law.", "name": "BRYNJA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Which king?", "name": "ZEPHYRINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Brynja's sword drops an inch.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She hadn't thought about that.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "The one with the crown.", "name": "BRYNJA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "He's been dead nine years.", "name": "ZEPHYRINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Brynja steps up one stair.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Zephyrine raises the staff.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "A spark jumps from the tip and sizzles across the stone.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Don't.", "name": "BRYNJA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Then don't push.", "name": "ZEPHYRINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Brynja pushes.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She grabs the staff and wrenches it to one side.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "The spark lands on a torch, which flares.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Both stumble.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "She tumbles into a wall, but she keeps hold of the staff.", "para": 5, "sent": 4, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "That's mine.", "name": "ZEPHYRINE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Not anymore.", "name": "BRYNJA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Zephyrine kicks her in the shin.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Brynja yelps and lets go.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Zephyrine seizes the staff, and now they stand eye to eye, panting.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Why did you steal the bell?", "name": "BRYNJA", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "It was singing in her sleep.", "name": "ZEPHYRINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Whose?", "name": "BRYNJA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Yours. Your daughter's.", "name": "ZEPHYRINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "The wind quiets.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Brynja steps back.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "The sword lowers fully.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "How do you know that?", "name": "BRYNJA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Zephyrine looks at her for a long time.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Come up. I'll show you.", "name": "ZEPHYRINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "She turns and climbs.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Brynja, shoulders heavy, sheathes the sword and follows.", "para": 9, "sent": 1, "present": [0, 1]}]}