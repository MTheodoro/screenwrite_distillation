{"scene_id": "s00385", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00385.fountain", "heading": "INT. ICE-DRILL RIG \"CALLISTO ONE\" - CONTROL CAGE - NIGHT", "cast": [{"id": 0, "name": "NASRIN", "names": ["NASRIN"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "JOSEPH", "names": ["JOSEPH"], "gender": "?", "first": 5, "spoke": 2}, {"id": 2, "name": "NAKAMURA", "names": ["NAKAMURA"], "gender": "?", "first": 7, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. ICE-DRILL RIG \"CALLISTO ONE\" - CONTROL CAGE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A steel box bolted to a frozen moon.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Gauges flicker.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A tiny window shows black sky and a bruised planet.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "NASRIN, 38, mission engineer, holds a pressure valve with both hands.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "JOSEPH, 50, geologist, lies on the floor with a bleeding scalp and a laugh like a cough.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "The radio SQUEALS.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Callisto One, Nakamura at Orbital. Report depth.", "name": "NAKAMURA", "speaker": 2, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Nasrin thumbs the key.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Four kilometers. We hit something.", "name": "NASRIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Define something.", "name": "NAKAMURA", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "It rang. Like a bell.", "name": "NASRIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Joseph sits up.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "He grips her ankle, and she looks down.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Don't pull the bit.", "name": "JOSEPH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Pressure's spiking.", "name": "NASRIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Don't pull the bit.", "name": "JOSEPH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "She doesn't.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "The gauges climb.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Alarms scream.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Then, all at once, every needle drops to zero.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Silence.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Callisto One, say again.", "name": "NAKAMURA", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Nasrin looks at Joseph.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "He is staring at the floor, where a pale blue light is rising through the grating, and he is smiling.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Nakamura. We're through.", "name": "NASRIN", "speaker": 0, "ext": [], "paren": ["into radio"], "dual": false, "present": [0, 1, 2]}]}