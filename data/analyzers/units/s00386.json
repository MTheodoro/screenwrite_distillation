{"scene_id": "s00386", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00386.fountain", "heading": "INT. THE CROWN AND ANCHOR TAVERN - 1783 - NIGHT", "cast": [{"id": 0, "name": "GILES", "names": ["GILES"], "gender": "?", "first": 5, "spoke": 5}, {"id": 1, "name": "MARGUERITE", "names": ["MARGUERITE"], "gender": "?", "first": 6, "spoke": 5}, {"id": 2, "name": "JEB", "names": ["JEB"], "gender": "?", "first": 7, "spoke": 2}, {"id": 3, "name": "CAPTAIN SILAS", "names": ["CAPTAIN SILAS"], "gender": "f", "first": 8, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. THE CROWN AND ANCHOR TAVERN - 1783 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Low beams.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A fire.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Tallow smoke.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A cracked auction block stands in the middle of the floor, and the room is crowded to the walls.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "GILES, 50, the auctioneer, stands on the block with a gavel and a face like wet bread.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "MARGUERITE, 30, a widow in good black, sits at the front, hands folded.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "JEB, 20s, a ship's boy, hovers behind her chair.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "CAPTAIN SILAS, 60, in a salt-stiff coat, lounges near the hearth.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Lot forty. One brig, the Halcyon, hull sound, rigging poor. Do I hear fifty guineas?", "name": "GILES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Forty.", "name": "CAPTAIN SILAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Sixty.", "name": "MARGUERITE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Missus, we cannot afford sixty.", "name": "JEB", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Sixty-five.", "name": "CAPTAIN SILAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Seventy.", "name": "MARGUERITE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Seventy from the lady. Do I hear seventy-five?", "name": "GILES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Missus!", "name": "JEB", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Seventy-five.", "name": "CAPTAIN SILAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Eighty.", "name": "MARGUERITE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Eighty. Going once.", "name": "GILES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "The room hushes.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Silas looks at her across the smoke.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "She looks back.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Neither blinks.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "He lifts a single finger.", "para": 2, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Ninety.", "name": "CAPTAIN SILAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Marguerite stands.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "She turns to Jeb, takes the purse from his belt, and puts it on the block.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "That is everything I own, Mr. Giles.", "name": "MARGUERITE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "It's one hundred and twelve.", "name": "GILES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Then it is a hundred and twelve.", "name": "MARGUERITE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Silas laughs, then stops.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "She has not moved.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Sold.", "name": "GILES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}