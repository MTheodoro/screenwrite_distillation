{"scene_id": "s00387", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00387.fountain", "heading": "INT. LIGHTHOUSE KEEPER'S COTTAGE - HOMEOWNERS ASSOCIATION MEETING - NIGHT", "cast": [{"id": 0, "name": "COASTLINE ESTATES HOA", "names": ["COASTLINE ESTATES HOA"], "gender": "?", "first": 3, "spoke": 0}, {"id": 1, "name": "BEATRIZ", "names": ["BEATRIZ"], "gender": "f", "first": 5, "spoke": 13}, {"id": 2, "name": "DWIGHT", "names": ["DWIGHT"], "gender": "?", "first": 6, "spoke": 8}, {"id": 3, "name": "KOFI", "names": ["KOFI"], "gender": "m", "first": 7, "spoke": 8}, {"id": 4, "name": "MARISOL", "names": ["MARISOL"], "gender": "f", "first": 8, "spoke": 6}, {"id": 5, "name": "TREMBLAY", "names": ["TREMBLAY"], "gender": "?", "first": 9, "spoke": 0}, {"id": 6, "name": "BIG A", "names": ["BIG A"], "gender": "?", "first": 19, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. LIGHTHOUSE KEEPER'S COTTAGE - HOMEOWNERS ASSOCIATION MEETING - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped round room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Folding chairs in a circle.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A banner reads \"COASTLINE ESTATES HOA - TOGETHER WE'RE SAFE.\"", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "A tray of lemon bars sits under cling film.", "para": 0, "sent": 3, "present": [0]}, {"u": 5, "kind": "action", "text": "BEATRIZ, 50s, board president, bangs a gavel made from a baseball bat.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "DWIGHT, 40s, treasurer, shuffles receipts.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "KOFI, 30s, a new resident, holds a clipboard he didn't ask for.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "MARISOL, 60s, the neighborhood gossip, sits with her arms crossed.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "ARNOLD \"BIG A\" TREMBLAY, 70, a retired harbor pilot, eats lemon bars.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Order. Order! First item. The lighthouse.", "name": "BEATRIZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "What about it?", "name": "DWIGHT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "It's a lighthouse.", "name": "BEATRIZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "We know that.", "name": "DWIGHT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "It's lit.", "name": "BEATRIZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Isn't that the point?", "name": "KOFI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "It shines in my kitchen.", "name": "MARISOL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Marisol, it shines in everyone's kitchen.", "name": "BEATRIZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Yes, but it shines in mine.", "name": "MARISOL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "I like it.", "name": "BIG A", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "Arnold, you aren't on the agenda.", "name": "BEATRIZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "I'm on the cake.", "name": "BIG A", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Lemon bars aren't cake.", "name": "DWIGHT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "I'm on the lemon bars.", "name": "BIG A", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "Can I add something?", "name": "KOFI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "No.", "name": "BEATRIZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "Okay, but I measured the beam.", "name": "KOFI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "You measured it?", "name": "MARISOL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "Forty-one seconds between sweeps.", "name": "KOFI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "It's supposed to be thirty.", "name": "DWIGHT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "It is thirty.", "name": "BEATRIZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "It's forty-one.", "name": "KOFI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "It's thirty!", "name": "BEATRIZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "It's forty-one. I piloted that channel for twenty-two years.", "name": "BIG A", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "You? You weren't even there for the vote.", "name": "MARISOL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "I was at the cake.", "name": "BIG A", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "It's not cake!", "name": "DWIGHT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "Beatriz bangs the bat-gavel on the arm of her chair.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "The cling film jumps.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "Motion to table the lighthouse until we can agree on the time!", "name": "BEATRIZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "Seconded!", "name": "DWIGHT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "dialogue", "text": "Opposed!", "name": "MARISOL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "dialogue", "text": "Opposed!", "name": "KOFI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "dialogue", "text": "Who's counting?", "name": "BIG A", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "dialogue", "text": "I'm counting!", "name": "BEATRIZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "Then why is it forty-one?", "name": "KOFI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "dialogue", "text": "It's thirty!", "name": "BEATRIZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "The lighthouse beam sweeps across the room's curved window, throwing a white bar over their faces.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "They all freeze, counting under their breath.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "dialogue", "text": "Thirty-one... thirty-two...", "name": "BEATRIZ", "speaker": 1, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "dialogue", "text": "Thirty-eight...", "name": "DWIGHT", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "dialogue", "text": "Forty.", "name": "KOFI", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "dialogue", "text": "Forty-one.", "name": "BIG A", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "action", "text": "The beam sweeps again.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "action", "text": "A long, silent beat.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "action", "text": "Beatriz sets the bat down very gently.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "dialogue", "text": "Motion to table the clock.", "name": "BEATRIZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "dialogue", "text": "Seconded.", "name": "DWIGHT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "dialogue", "text": "Fine. I'll take a lemon bar.", "name": "MARISOL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 59, "kind": "dialogue", "text": "There aren't any.", "name": "BIG A", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}