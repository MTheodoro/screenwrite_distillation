{"scene_id": "s00389", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00389.fountain", "heading": "INT. HOLLOWAY & SONS FUNERAL HOME - CATERING KITCHEN - DAY", "cast": [{"id": 0, "name": "ROSALIND", "names": ["ROSALIND"], "gender": "f", "first": 3, "spoke": 7}, {"id": 1, "name": "BART", "names": ["BART"], "gender": "?", "first": 4, "spoke": 8}, {"id": 2, "name": "NGOZI", "names": ["NGOZI"], "gender": "?", "first": 5, "spoke": 4}, {"id": 3, "name": "HECTOR", "names": ["HECTOR"], "gender": "?", "first": 6, "spoke": 6}, {"id": 4, "name": "AGNES", "names": ["AGNES"], "gender": "?", "first": 7, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOLLOWAY & SONS FUNERAL HOME - CATERING KITCHEN - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Steel counters, sheet pans of sandwiches, a coffee urn the size of a toddler.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Through the swinging door, organ music murmurs.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "ROSALIND, 50s, in a black apron, assembles egg-salad triangles with a surgeon's calm.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "BART, 60s, the director, in a charcoal suit, counts napkins into a stack.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "NGOZI, 20s, a server, polishes a serving spoon until it screams.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "HECTOR, 40s, the cook, scrubs a pot that is already clean.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "At the back, AGNES, 8, in a velvet dress and sneakers, sits under a prep table with a coloring book.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "That's the thirty-second triangle.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "We need forty.", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "We need thirty-eight.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "We need forty. Mr. Okonkwo's family is large.", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "It's always the ones who say it's small.", "name": "NGOZI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "My aunt said it would be small. They came by the busload.", "name": "HECTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Hector, did you do the coffee?", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "I did the coffee.", "name": "HECTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Was it decaf?", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Some of it.", "name": "HECTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Which?", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "The urn on the left.", "name": "HECTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "That's the regular.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Then the urn on the right.", "name": "HECTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "That's also the regular.", "name": "NGOZI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Then it's all regular.", "name": "HECTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Thank you for telling us.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Mr. Okonkwo did enjoy his coffee.", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Bart.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "I'm only saying he'd approve.", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Ngozi puts down the spoon.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "She picks up another.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Agnes, are you okay under there?", "name": "NGOZI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "I'm coloring.", "name": "AGNES", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "What are you coloring?", "name": "NGOZI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Grandpa.", "name": "AGNES", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "A quiet settles.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Rosalind lays down her knife.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Bart straightens a napkin that is already straight.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Hector stops scrubbing.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Is it a good one?", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "It's not finished.", "name": "AGNES", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Rosalind wipes her hands on her apron and crouches to look under the table.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Hector sets down the pot.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Ngozi opens the swinging door a crack.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "The organ music swells.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Agnes holds up the book.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "On the page, a very large crayon man in a very large crayon hat, and next to him, a smaller crayon girl holding his hand.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Both are bright orange.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "He liked orange.", "name": "AGNES", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Rosalind nods.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "She stands, takes a sandwich, and puts it on a plate.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Then another.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Then another.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "Forty.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "Forty.", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "He picks up the tray.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}]}