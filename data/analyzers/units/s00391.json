{"scene_id": "s00391", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00391.fountain", "heading": "EXT. GRASS PLAINS - DUSK", "cast": [{"id": 0, "name": "JEDEDIAH CROW", "names": ["JEDEDIAH CROW", "JEDEDIAH"], "gender": "?", "first": 2, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. GRASS PLAINS - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "A lone horse, a lone man.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "JEDEDIAH CROW, 60s, in a duster gone to rags, sits on a stump beside a dead fire.", "para": 0, "sent": 1, "present": [0]}, {"u": 3, "kind": "action", "text": "He reads a letter.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "His lips move.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "dialogue", "text": "Dear Hannah. I got to the river. It was dry.", "name": "JEDEDIAH", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0]}, {"u": 6, "kind": "action", "text": "He folds the page.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Unfolds it.", "para": 2, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "Looks at the horizon.", "para": 2, "sent": 2, "present": [0]}, {"u": 9, "kind": "dialogue", "text": "I buried the mare. Dug it with a pan.", "name": "JEDEDIAH", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 10, "kind": "action", "text": "A hawk circles.", "para": 3, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "He ignores it.", "para": 3, "sent": 1, "present": [0]}, {"u": 12, "kind": "dialogue", "text": "I am coming home. It may take a while.", "name": "JEDEDIAH", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 13, "kind": "action", "text": "He tears the letter in half, then in half again.", "para": 4, "sent": 0, "present": [0]}, {"u": 14, "kind": "action", "text": "The pieces blow across the grass.", "para": 4, "sent": 1, "present": [0]}, {"u": 15, "kind": "action", "text": "He stands, dusts his knees, and whistles.", "para": 4, "sent": 2, "present": [0]}, {"u": 16, "kind": "action", "text": "The horse lifts its head.", "para": 4, "sent": 3, "present": [0]}, {"u": 17, "kind": "dialogue", "text": "Come on.", "name": "JEDEDIAH", "speaker": 0, "ext": [], "paren": ["quiet"], "dual": false, "present": [0]}, {"u": 18, "kind": "action", "text": "He swings up into the saddle and turns the horse east.", "para": 5, "sent": 0, "present": [0]}]}