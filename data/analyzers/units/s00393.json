{"scene_id": "s00393", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00393.fountain", "heading": "INT. NIGHT FERRY \"ADELAIDE\" - GALLEY - NIGHT", "cast": [{"id": 0, "name": "ARASH", "names": ["ARASH"], "gender": "?", "first": 4, "spoke": 2}, {"id": 1, "name": "CLEMENTINE", "names": ["CLEMENTINE"], "gender": "?", "first": 5, "spoke": 19}, {"id": 2, "name": "ABEL", "names": ["ABEL"], "gender": "?", "first": 6, "spoke": 19}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT FERRY \"ADELAIDE\" - GALLEY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A tiny steel kitchen.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A porthole shows black water.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Pans hang on a rail and sway with the swell.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ARASH, 60, cook, in a white apron, rolls dough on a floured board.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "CLEMENTINE, 30s, in a navy coat, sits on a stool by the oven.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "ABEL, 30s, in shirtsleeves, leans in the doorway with a paper cup of tea.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "You two can talk. I'm deaf in the oven ear.", "name": "ARASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "You don't have an oven ear.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "I have a lot of ears.", "name": "ARASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Clem.", "name": "ABEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Abel.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Thirty-one days.", "name": "ABEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Thirty-two. It's after midnight.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Thirty-two, then.", "name": "ABEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "I wrote you.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "You wrote me once.", "name": "ABEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I wrote you a very good one.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "It was good. It said you'd be somewhere else. It didn't say where.", "name": "ABEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I didn't know where.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "You're on a ferry.", "name": "ABEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "It was where the ferry was going.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Arash turns the dough, folds it, turns it again.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "The ferry rolls.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The pans clang softly.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "You could have called.", "name": "ABEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "So could you.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "I did. Four times.", "name": "ABEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "I know.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "You knew.", "name": "ABEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "I listened to every one.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "And?", "name": "ABEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "And I didn't pick up.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Why not?", "name": "ABEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Because you'd have asked me to come back, and I'd have said yes.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "A silence.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "The oven ticks.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Arash's hands slow on the dough.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "And that's bad.", "name": "ABEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "It was then.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "And now?", "name": "ABEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Now I'd ask you to get on the ferry.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "I am on the ferry.", "name": "ABEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "I know. I saw you at the dock.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "You saw me.", "name": "ABEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Thirty-two days. I know your walk from a quarter mile.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Abel sets down the tea.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Arash, without turning, sets down the rolling pin.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "He wipes his hands, takes his coat from the hook, and goes out.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "The door swings shut behind him.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Is it too late for the thing I wrote?", "name": "ABEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Which thing?", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "The reply.", "name": "ABEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "You never sent a reply.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "I wrote one every night.", "name": "ABEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "He pulls a bundle of letters from his jacket, tied with kitchen twine.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "She stares at it, then takes it.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Her thumb passes across the top envelope.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "Read me the first.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "It just says your name.", "name": "ABEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "She nods.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "He begins to say it.", "para": 6, "sent": 1, "present": [0, 1, 2]}]}