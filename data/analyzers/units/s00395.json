{"scene_id": "s00395", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00395.fountain", "heading": "INT. FERNBANK TAXIDERMY - BACK ROOM - NIGHT", "cast": [{"id": 0, "name": "MERCEDES OYELARAN", "names": ["MERCEDES OYELARAN", "MERCEDES"], "gender": "f", "first": 4, "spoke": 18}, {"id": 1, "name": "DUNCAN HALE", "names": ["DUNCAN HALE", "DUNCAN"], "gender": "?", "first": 12, "spoke": 19}], "units": [{"u": 0, "kind": "heading", "text": "INT. FERNBANK TAXIDERMY - BACK ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A windowless workshop stuffed with animals: owls on perches, a bear on hind legs, a fox mid-leap, a glass case of moths.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single lamp over a steel table.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The air smells of formaldehyde and old straw.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MERCEDES OYELARAN, 30s, in a leather apron, her sleeves rolled, bends over the table with a curved needle.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "On it lies the half-mounted body of a barn owl, its eyes still clouded.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "She works with the quiet of someone alone in a church.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "The front-door bell JINGLES in the next room.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "She doesn't look up.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "dialogue", "text": "We're closed.", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 10, "kind": "action", "text": "Footsteps.", "para": 3, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "Slow.", "para": 3, "sent": 1, "present": [0]}, {"u": 12, "kind": "action", "text": "A man's shadow slides across the doorway: DUNCAN HALE, 40s, in a damp raincoat, holding a hat.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He takes in the animals and stays on the threshold.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Forgive me. The door was unlocked.", "name": "DUNCAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "It's not.", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "It opened.", "name": "DUNCAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She sets down the needle and turns.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "They regard each other.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "What do you want?", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "My wife's cat died last week. I was told you could do something.", "name": "DUNCAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "I do animals. I don't do grief.", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "It's the same work, I'm told.", "name": "DUNCAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She wipes her hands on her apron.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "He steps in.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "He's taller than the doorway made him look, and he moves with a care that suggests he's learned not to bump into things.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Where's the cat?", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "In the car.", "name": "DUNCAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "You brought it in the rain.", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "I didn't want to leave her.", "name": "DUNCAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "She nods slowly.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "A faint relaxation.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "She crosses to the sink and washes her hands.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "You'll have to bring her in. Not the carrier. The towel.", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "I don't have a towel.", "name": "DUNCAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Then your coat.", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "She's not wrapped in anything.", "name": "DUNCAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "She turns off the tap.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "The room is very still.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "The owl on the table seems to be looking at her.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Mr. Hale. What is in the car?", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "A cat.", "name": "DUNCAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Is it a cat?", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "He lowers his eyes.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "He turns the hat in his hands once, twice.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "She said you'd ask.", "name": "DUNCAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Who did?", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "My wife.", "name": "DUNCAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Your wife is dead.", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Last week. Yes.", "name": "DUNCAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "Mercedes picks up a long scalpel from the tray and holds it low, behind her apron.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Then who is in the car?", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "I came to find out.", "name": "DUNCAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "He reaches into his coat.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "Mercedes grips the scalpel.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "He draws out a photograph and holds it toward her across the table.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "That's the shop. The year it opened. The woman behind the counter.", "name": "DUNCAN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "Mercedes does not take it.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "She does not need to.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "That's my mother.", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "She's the one who mounted my wife's first cat. Thirty years ago.", "name": "DUNCAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "My mother's been gone since '04.", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "I know. I thought you'd want to see it.", "name": "DUNCAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "He lays the photograph on the table beside the owl.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "Mercedes looks at it.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "Her grip on the scalpel eases.", "para": 12, "sent": 2, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "Why?", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "Because last night, my wife came home.", "name": "DUNCAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "Mr. Hale.", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "She's in the car. She's not a cat. She's not breathing, and she's not cold, and she asked me to bring her here.", "name": "DUNCAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "action", "text": "The lamp flickers.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "The animals do not move.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "Mercedes looks past him, through the doorway, to the front window.", "para": 13, "sent": 2, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "A car idles at the curb, headlights off.", "para": 13, "sent": 3, "present": [0, 1]}, {"u": 74, "kind": "action", "text": "In the back seat, a shape sits very upright.", "para": 13, "sent": 4, "present": [0, 1]}, {"u": 75, "kind": "dialogue", "text": "Why here?", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1]}, {"u": 76, "kind": "dialogue", "text": "She says you know how to make things stay.", "name": "DUNCAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 77, "kind": "action", "text": "The bell above the front door jingles again, though the door has not opened.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 78, "kind": "action", "text": "Mercedes sets down the scalpel.", "para": 14, "sent": 1, "present": [0, 1]}]}