{"scene_id": "s00396", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00396.fountain", "heading": "INT. ROOTHOUSE TEAROOM - AFTERNOON", "cast": [{"id": 0, "name": "ALDOUS", "names": ["ALDOUS"], "gender": "m", "first": 5, "spoke": 7}, {"id": 1, "name": "SEREN", "names": ["SEREN"], "gender": "f", "first": 6, "spoke": 6}, {"id": 2, "name": "PIP", "names": ["PIP"], "gender": "m", "first": 7, "spoke": 5}, {"id": 3, "name": "WIDOW HARROWGATE", "names": ["WIDOW HARROWGATE"], "gender": "?", "first": 25, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROOTHOUSE TEAROOM - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "A parlor grown inside the hollow of an immense oak.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The walls are living bark, polished by decades of elbows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Honey-colored light falls through a knothole window, and tiny lanterns of captured fireflies hang from the ceiling on spider-silk.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A kettle on a mushroom-stool burner sings.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ALDOUS, 70, a wizard in a tea-stained cardigan, pours from a pot shaped like a sleeping badger.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "SEREN, 20s, an apprentice in a patched green cloak, stirs her cup and stirs it again.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "PIP, 9, a boy with soot on his chin, sits under the table feeding crumbs to something invisible.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Milk?", "name": "ALDOUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Please.", "name": "SEREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Is it a lot of milk?", "name": "PIP", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "It's enough.", "name": "ALDOUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "It's a bit much.", "name": "SEREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "You said please.", "name": "ALDOUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Seren said please, I said please, Master Aldous said please.", "name": "PIP", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Nobody said please to the cat.", "name": "SEREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "We have a cat?", "name": "ALDOUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "We have a cat under the table.", "name": "PIP", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "We don't have a cat.", "name": "SEREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "It's a very quiet cat.", "name": "PIP", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Aldous passes Seren her tea.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "She holds it, not drinking.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "She watches the knothole.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "A shadow crosses the window.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The door, a round slab of bark on a leather hinge, swings inward.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "WIDOW HARROWGATE, 80s, small and square in a black bonnet, leans on a cane carved from a single antler.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "She has the look of a woman who has been on her way for a very long time.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Mrs. Harrowgate.", "name": "ALDOUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Aldous. You've aged.", "name": "WIDOW HARROWGATE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "You're early.", "name": "ALDOUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "I'm precisely on time. You were always late.", "name": "WIDOW HARROWGATE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Tea?", "name": "SEREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Not today, girl.", "name": "WIDOW HARROWGATE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Is she the one with the owl?", "name": "PIP", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Pip.", "name": "SEREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "I am the one with the owl.", "name": "WIDOW HARROWGATE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Sit, Hester.", "name": "ALDOUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "I'll stand.", "name": "WIDOW HARROWGATE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "She doesn't.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "She lowers herself into the nearest chair, set at the head of the table like a throne.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "The firefly lanterns brighten very slightly.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Nobody says anything.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Aldous refills his cup.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Seren stirs.", "para": 4, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Pip, under the table, tugs at the invisible cat's tail.", "para": 4, "sent": 6, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "The kettle sings on.", "para": 4, "sent": 7, "present": [0, 1, 2, 3]}]}