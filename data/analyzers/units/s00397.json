{"scene_id": "s00397", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00397.fountain", "heading": "INT. CAR WASH TUNNEL - NIGHT", "cast": [{"id": 0, "name": "SOLEDAD", "names": ["SOLEDAD"], "gender": "f", "first": 4, "spoke": 3}, {"id": 1, "name": "KWAME", "names": ["KWAME"], "gender": "m", "first": 5, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. CAR WASH TUNNEL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A beat-up hatchback inches through the dark.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Foam slides down the windshield in thick white curtains.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Brushes thump and whirl.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SOLEDAD, 18, sits in the driver's seat in her graduation gown, cap still on.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "KWAME, 18, in the passenger seat, holds a diploma cover on his lap.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "She stares ahead.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He stares at the foam.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "The car stops in a pool of blue light.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Water drums on the roof.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "We could've gone to the party.", "name": "KWAME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "You hate parties.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I hate that one.", "name": "KWAME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She nods.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Her hands tighten on the wheel.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "The brushes retreat.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "A jet of water hits the glass, and for a moment the world outside is nothing but a trembling white.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "You got the letter.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Yeah.", "name": "KWAME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Where?", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Out west.", "name": "KWAME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She says nothing.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "He turns the diploma cover over in his hands.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She puts the car in drive, and it rolls forward into the dryers, which roar.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "He rolls his window down and lets the warm air in.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "She takes off her cap and places it on the dash.", "para": 6, "sent": 1, "present": [0, 1]}]}