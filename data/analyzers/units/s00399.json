{"scene_id": "s00399", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00399.fountain", "heading": "INT. STALLED ELEVATOR - DAY", "cast": [{"id": 0, "name": "WINIFRED", "names": ["WINIFRED"], "gender": "f", "first": 3, "spoke": 3}, {"id": 1, "name": "LEOPOLD", "names": ["LEOPOLD"], "gender": "?", "first": 4, "spoke": 1}, {"id": 2, "name": "DANIKA", "names": ["DANIKA"], "gender": "?", "first": 5, "spoke": 2}, {"id": 3, "name": "VIJAY", "names": ["VIJAY"], "gender": "?", "first": 6, "spoke": 3}, {"id": 4, "name": "MAINTENANCE", "names": ["MAINTENANCE"], "gender": "?", "first": 14, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. STALLED ELEVATOR - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Four people, mirrored walls, a dead floor indicator.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Muzak plays softly.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "WINIFRED, 50s, in a pantsuit, holds a cake box.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "LEOPOLD, 30s, in a delivery uniform, holds a balloon bouquet.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "DANIKA, 20s, in a bridesmaid dress, holds a phone with no signal.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "VIJAY, 40s, in a tux, holds nothing but a ring box.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "Everyone smiles tightly.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "It's fine. It's a minor delay.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": ["to the group"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "You're the groom?", "name": "DANIKA", "speaker": 2, "ext": [], "paren": ["to Vijay"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Best man.", "name": "VIJAY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Where's the ring?", "name": "DANIKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "In the box. It's in the box. It's in the box.", "name": "VIJAY", "speaker": 3, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "The intercom crackles.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Hello in there? Is anyone in the elevator?", "name": "MAINTENANCE", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Four of us!", "name": "LEOPOLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Great. Quick question. Do any of you have a wedding to be at?", "name": "MAINTENANCE", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "All four stare at one another.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Why do you ask?", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": ["to the group"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Because the groom just called. He says the bride's mother is stuck in an elevator with a cake, the best man, and a bridesmaid, and a balloon guy.", "name": "MAINTENANCE", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Winifred closes her eyes.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "I am the mother.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Vijay opens the ring box.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "It's empty.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Okay.", "name": "VIJAY", "speaker": 3, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}]}