{"scene_id": "s00401", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00401.fountain", "heading": "INT. MERCANTILE TRUST BANK - SUBLEVEL VAULT CORRIDOR - NIGHT", "cast": [{"id": 0, "name": "ARTUR VOSS", "names": ["ARTUR VOSS", "ARTUR"], "gender": "m", "first": 5, "spoke": 18}, {"id": 1, "name": "LENNOX BAILEY", "names": ["LENNOX BAILEY", "LENNOX"], "gender": "m", "first": 7, "spoke": 17}, {"id": 2, "name": "SHERWIN", "names": ["SHERWIN"], "gender": "m", "first": 52, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. MERCANTILE TRUST BANK - SUBLEVEL VAULT CORRIDOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Concrete.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fluorescent hum.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A steel door the size of a garage stands half-open at the end of the hall.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A cleaning cart is parked against the wall, its mop bucket empty.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ARTUR VOSS, 40s, in a gray cleaner's coverall, walks down the corridor with a push broom.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "He moves with a lazy rhythm, humming.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "LENNOX BAILEY, 30s, in an identical coverall, follows a few steps behind, carrying a clipboard.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You're nervous.", "name": "ARTUR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I'm not nervous.", "name": "LENNOX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "You're humming.", "name": "ARTUR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "You're humming.", "name": "LENNOX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I always hum.", "name": "ARTUR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Then so do I.", "name": "LENNOX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "They stop at the vault door.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "The broom hangs from Artur's hand.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Lennox taps the clipboard on his thigh.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Check the schedule.", "name": "ARTUR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "It says night staff leaves at midnight.", "name": "LENNOX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "What time is it?", "name": "ARTUR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Eleven fifty-one.", "name": "LENNOX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "He's late.", "name": "ARTUR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "He's early. He said eleven fifty-five.", "name": "LENNOX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Who said?", "name": "ARTUR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "He did.", "name": "LENNOX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Which he?", "name": "ARTUR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "The one with the keys.", "name": "LENNOX", "speaker": 1, "ext": [], "paren": ["a beat"], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Artur's smile is thin.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "He leans the broom against the wall and wipes his palms on his hips.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "He told you eleven fifty-five.", "name": "ARTUR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "He told me.", "name": "LENNOX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "He told me twelve ten.", "name": "ARTUR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Then one of us is lying.", "name": "LENNOX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Or he is.", "name": "ARTUR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "They look at each other.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Lennox's clipboard has stopped moving.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Down the corridor, an elevator DINGS.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Both turn.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "That's early.", "name": "LENNOX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Someone's coming.", "name": "ARTUR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Which one's he?", "name": "LENNOX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "I don't know.", "name": "ARTUR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "They stand very still as the elevator doors slide open.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "A figure steps out, but it is cast in shadow and light, impossible to read.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "He holds a ring of keys that jingles with each step.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "The figure raises one hand.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Lennox's hand goes to his coverall pocket.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Artur's goes to the mop handle.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Who is it?", "name": "LENNOX", "speaker": 1, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Don't move.", "name": "ARTUR", "speaker": 0, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "The figure stops ten feet away.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "In the light, a chin, a mouth, a nervous smile.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Mr. Sherwin.", "name": "LENNOX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Evening, boys.", "name": "SHERWIN", "speaker": 2, "ext": [], "paren": ["off"], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Artur lets his breath out.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Lennox lets his out, too, and both look sheepish.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "You're late.", "name": "ARTUR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "He's early.", "name": "LENNOX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "The keys jingle.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Sherwin steps closer, and in the corridor light we see what the shadows hid: a revolver, hanging loose at his side.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "I'm exactly on time.", "name": "SHERWIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "Neither man moves.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "Mr. Sherwin. What's the gun for?", "name": "ARTUR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "For the one of you who's going to ask what the gun is for.", "name": "SHERWIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "That's Artur.", "name": "LENNOX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "That's Lennox.", "name": "ARTUR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "It doesn't matter.", "name": "SHERWIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "He raises the gun.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "Artur dives behind the cart.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "Lennox hits the floor.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "The shot rings off concrete and the cart bucket rolls across the corridor, ringing like a bell.", "para": 11, "sent": 3, "present": [0, 1, 2]}, {"u": 71, "kind": "dialogue", "text": "He's got six! I count five!", "name": "ARTUR", "speaker": 0, "ext": [], "paren": ["from behind the cart"], "dual": false, "present": [0, 1, 2]}, {"u": 72, "kind": "dialogue", "text": "Count again!", "name": "LENNOX", "speaker": 1, "ext": [], "paren": ["from the floor"], "dual": false, "present": [0, 1, 2]}, {"u": 73, "kind": "action", "text": "Another shot.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 74, "kind": "action", "text": "The fluorescent tube above them bursts.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 75, "kind": "action", "text": "Sparks.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 76, "kind": "action", "text": "Darkness.", "para": 12, "sent": 3, "present": [0, 1, 2]}, {"u": 77, "kind": "action", "text": "The echo dies in the corridor, and in the dark someone, slowly, begins to hum.", "para": 12, "sent": 4, "present": [0, 1, 2]}]}