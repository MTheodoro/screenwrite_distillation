{"scene_id": "s00404", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00404.fountain", "heading": "INT. FAMILY ATTIC - LATE AFTERNOON", "cast": [{"id": 0, "name": "HENRIK LUND", "names": ["HENRIK LUND", "HENRIK"], "gender": "m", "first": 4, "spoke": 21}, {"id": 1, "name": "SIGRID", "names": ["SIGRID"], "gender": "?", "first": 5, "spoke": 20}], "units": [{"u": 0, "kind": "heading", "text": "INT. FAMILY ATTIC - LATE AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Slanted rafters.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dust motes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A circular window throws a pale coin of light on boxes, a dress form, and an old trunk with brass corners.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "HENRIK LUND, 70, in a cardigan, sits on the trunk with a cardboard box in his lap.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "His daughter SIGRID, 40, stands by the window with a roll of packing tape and a marker.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "This one says \"Christmas.\"", "name": "HENRIK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Then keep it.", "name": "SIGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "It's got one ornament in it.", "name": "HENRIK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Then it's the right box.", "name": "SIGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Your mother wrapped them in newspaper. It's from 1979.", "name": "HENRIK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Dad.", "name": "SIGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "It's a very nice paper.", "name": "HENRIK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Dad, we have to be out by Friday.", "name": "SIGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "I know the date.", "name": "HENRIK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "The buyers are bringing a truck.", "name": "SIGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "I know about the truck.", "name": "HENRIK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Then what are you doing?", "name": "SIGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "I'm reading the newspaper.", "name": "HENRIK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "It's forty years old.", "name": "SIGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Yes. It says the harbor froze. There's a photo of your uncle on the ice.", "name": "HENRIK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Uncle Jonas?", "name": "SIGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "With a fish as long as his arm.", "name": "HENRIK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "He lied about that fish.", "name": "SIGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "He lied about all of them.", "name": "HENRIK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "You could take the photo.", "name": "SIGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "I could.", "name": "HENRIK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "You could take the box.", "name": "SIGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "I could take the ornament.", "name": "HENRIK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "That's the idea.", "name": "SIGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Sigrid.", "name": "HENRIK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Yes.", "name": "SIGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "When I'm gone, who will remember where the box was?", "name": "HENRIK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Me.", "name": "SIGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "You won't.", "name": "HENRIK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "I will.", "name": "SIGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "You'll be in another country.", "name": "HENRIK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Then I'll remember it from there.", "name": "SIGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "That's not the same.", "name": "HENRIK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "No. It's not.", "name": "SIGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "But it's what we have.", "name": "HENRIK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "It's what we have.", "name": "SIGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Hand me the tape.", "name": "HENRIK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "You're keeping it?", "name": "SIGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "I'm closing it. You said I could keep it.", "name": "HENRIK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "I did.", "name": "SIGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Then keep the tape.", "name": "HENRIK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "She hands him the roll.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "He seals the box, slowly, the tape shrieking, and she writes on the lid in marker: HENRIK, LAST BOX.", "para": 2, "sent": 1, "present": [0, 1]}]}