{"scene_id": "s00405", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00405.fountain", "heading": "INT. RUINED CHURCH - MOUNTAIN PASS - DAWN", "cast": [{"id": 0, "name": "SERGEANT MALLORY", "names": ["SERGEANT MALLORY", "MALLORY"], "gender": "m", "first": 6, "spoke": 10}, {"id": 1, "name": "PRIVATE DIAZ", "names": ["PRIVATE DIAZ", "DIAZ"], "gender": "?", "first": 9, "spoke": 3}, {"id": 2, "name": "CORPORAL OKONJO", "names": ["CORPORAL OKONJO", "OKONJO"], "gender": "m", "first": 10, "spoke": 6}, {"id": 3, "name": "PRIVATE FENWICK", "names": ["PRIVATE FENWICK", "FENWICK"], "gender": "m", "first": 9, "spoke": 2}, {"id": 4, "name": "PADRE LUCIANO", "names": ["PADRE LUCIANO"], "gender": "m", "first": 39, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. RUINED CHURCH - MOUNTAIN PASS - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "The roof is gone.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Gray light falls in cold shafts between blackened beams.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Pews are splintered kindling.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Over the altar, a cracked stone Madonna still holds up one hand.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Snow has drifted through the nave, and boot prints cross it in a ragged line.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "SERGEANT MALLORY, 40s, a lean, gray-stubbled man with a rifle across his back, crouches behind the altar rail.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "His eyes are red from no sleep.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "He peers over the stone at the door.", "para": 1, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "PRIVATE DIAZ, 19, lies on a pew with a bandaged thigh, face pale as paper, watching the sky through the roof.", "para": 2, "sent": 0, "present": [0, 1, 3]}, {"u": 10, "kind": "action", "text": "CORPORAL OKONJO, 30s, tall and broad, with a radio on his back, stands guard at a side window.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "PRIVATE FENWICK, 20s, a freckled kid in a helmet two sizes too big, sits against the wall, cleaning his rifle with trembling hands.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Quiet out there.", "name": "OKONJO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Too quiet.", "name": "MALLORY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "I like quiet.", "name": "DIAZ", "speaker": 1, "ext": [], "paren": ["weak"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "You like everything.", "name": "FENWICK", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "I like being alive.", "name": "DIAZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Mallory crosses the nave and kneels beside him.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "He checks the bandage.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "It's soaked through.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "He doesn't comment.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "He just pulls his scarf from his neck and ties it over the wound.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Okonjo. Raise HQ.", "name": "MALLORY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Tried. Nothing.", "name": "OKONJO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Try again.", "name": "MALLORY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Okonjo cranks the radio.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Static.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "He tries another frequency.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Static.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "He puts the handset down and leans against the window.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Sergeant, something's moving in the pass.", "name": "OKONJO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Mallory goes to the window.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Down the slope, in the gray, a figure toils up the path, small, bent against the wind.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "He raises his binoculars.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "One man. No weapon. Carrying something.", "name": "MALLORY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Could be a decoy.", "name": "FENWICK", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Could be.", "name": "MALLORY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "The door of the church swings open.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "They whirl, rifles up.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "In the doorway stands PADRE LUCIANO, 60s, a priest in a black cassock crusted with ice, holding a battered wooden crate to his chest.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "His face is red with cold and weeping with exhaustion.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "He lifts his chin.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Please. Don't shoot. This is my church.", "name": "PADRE LUCIANO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Nobody lowers a weapon.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Father, this is a war zone.", "name": "MALLORY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "It was my church before it was a war zone.", "name": "PADRE LUCIANO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "He steps inside.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Snow melts off his shoulders.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "He does not seem to see the rifles.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "He walks past them, up the nave, to the altar, and sets the crate on it with great care.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Sergeant?", "name": "OKONJO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "Wait.", "name": "MALLORY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "The priest opens the crate.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Inside, nestled in straw, are five loaves of bread, a corked bottle, and a small bundle wrapped in oilcloth.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "He takes out a loaf and holds it to the light.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "My parishioners buried this in the cellar before the shelling. I dug it out this morning.", "name": "PADRE LUCIANO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Is that bread?", "name": "DIAZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "It's bread, my son.", "name": "PADRE LUCIANO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Fenwick lowers his rifle first.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "Then Okonjo.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "Mallory is last, and slowest, and he does it with a long breath.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "We can't pay.", "name": "MALLORY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "dialogue", "text": "I have not asked.", "name": "PADRE LUCIANO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "He breaks the loaf and offers a piece to Diaz.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "Diaz takes it with both hands and eats like a child.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "The priest moves down the pew, giving, and the soldiers come to him one by one.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "Mallory stays by the window.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "action", "text": "He watches the pass.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "action", "text": "The wind picks up.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "Far off, in the gray, a sound: the low drone of engines.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "dialogue", "text": "Okonjo.", "name": "MALLORY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "dialogue", "text": "I hear it.", "name": "OKONJO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "dialogue", "text": "How long?", "name": "MALLORY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "dialogue", "text": "Ten minutes. Maybe less.", "name": "OKONJO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "dialogue", "text": "Then we eat quickly.", "name": "PADRE LUCIANO", "speaker": 4, "ext": [], "paren": ["calm"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "action", "text": "He turns to the Madonna and bows his head.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 76, "kind": "action", "text": "The soldiers do not pray, but they do not speak either.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 77, "kind": "action", "text": "The engines grow louder.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 78, "kind": "action", "text": "Fenwick is the first to stand.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 79, "kind": "action", "text": "He sets down his rifle, picks up the priest's empty crate, and begins to stack broken pews against the door.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}]}