{"scene_id": "s00406", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00406.fountain", "heading": "INT. SAGEBRUSH SALOON - EVENING", "cast": [{"id": 0, "name": "COLTER", "names": ["COLTER"], "gender": "m", "first": 5, "spoke": 11}, {"id": 1, "name": "DEACON", "names": ["DEACON"], "gender": "?", "first": 6, "spoke": 11}, {"id": 2, "name": "MAX", "names": ["MAX"], "gender": "m", "first": 7, "spoke": 3}, {"id": 3, "name": "SADIE", "names": ["SADIE"], "gender": "f", "first": 8, "spoke": 1}, {"id": 4, "name": "JUBILEE", "names": ["JUBILEE"], "gender": "?", "first": 9, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. SAGEBRUSH SALOON - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "A low, smoky room of rough planks and yellow lamplight.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A piano stands in a corner, one leg propped on a barrel.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The bar is a single long board across two whiskey casks.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Dust hangs in the air like flour.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "COLTER, 40s, a lean sheriff in a sweat-stained hat, sits at a corner table with his boots on a chair.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across from him, DEACON, 50s, a heavyset rancher in a clean white shirt, plays solitaire.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "MAX, 20s, a nervous young deputy, stands at the bar.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "SADIE, 30s, the barkeep, polishes a glass with a rag the color of old bone.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "JUBILEE, 60s, a woman in a feathered hat, sits at the piano, picking out one lonely note.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Deacon, you're short a king.", "name": "COLTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "I know it.", "name": "DEACON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Someone took it.", "name": "COLTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "I took it.", "name": "DEACON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Why?", "name": "COLTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Because I wanted a king.", "name": "DEACON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "The piano note rings again.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Max shifts his weight.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "He drums his fingers on the bar.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Sheriff, he's wearing a gun.", "name": "MAX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Everyone's wearing a gun.", "name": "COLTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "I mean under the shirt.", "name": "MAX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Max.", "name": "SADIE", "speaker": 3, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Deacon sweeps the cards into a pile.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "He stands, all six feet and two hundred pounds of him, and walks across the room to the piano.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Jubilee does not look up.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "He lays a coin on the lid.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Play something.", "name": "DEACON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "I only know the one.", "name": "JUBILEE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Then play it.", "name": "DEACON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "She plays it.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Slow, off-key, a hymn.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Colter lowers his boots from the chair.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Max backs against the bar.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Sadie sets down her glass.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Deacon. You're not welcome in town.", "name": "COLTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "I'm not in town. I'm in a saloon.", "name": "DEACON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Same thing.", "name": "COLTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Not if I buy a drink.", "name": "DEACON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "He turns to the bar.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Max reaches for his holster.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Colter's hand shoots out and catches the boy's wrist.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Easy.", "name": "COLTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Deacon sets a coin on the bar.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Sadie looks at it.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "She looks at Colter.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Then she pours, a clear shot of something amber.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Deacon lifts it and drinks.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "I came to say a thing.", "name": "DEACON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Then say it.", "name": "COLTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Your brother is not dead.", "name": "DEACON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "The room goes still.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "The piano stops.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Jubilee's hands hover over the keys.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "Max stares at the sheriff.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "Say it again.", "name": "COLTER", "speaker": 0, "ext": [], "paren": ["very quiet"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Deacon sets down the glass.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "He and Colter regard each other across the silent room.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "Brother's alive, Sheriff. He's riding with the Hendricks gang. I seen him Tuesday.", "name": "DEACON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "Colter stands.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "His chair scrapes loud.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "His hand hangs, loose, over his holster.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "dialogue", "text": "Sheriff. Sheriff, don't.", "name": "MAX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "dialogue", "text": "Deacon.", "name": "COLTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "dialogue", "text": "Yes.", "name": "DEACON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "Step outside.", "name": "COLTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "Deacon nods.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "action", "text": "He turns to the door, and Colter follows.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "action", "text": "At the threshold, they both stop.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "Behind them, the piano resumes: the same note, one note, again and again.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4]}]}