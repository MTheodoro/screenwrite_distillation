{"scene_id": "s00407", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00407.fountain", "heading": "INT. GLASS GREENHOUSE - WEDDING REHEARSAL - EVENING", "cast": [{"id": 0, "name": "ROSEMARY", "names": ["ROSEMARY"], "gender": "?", "first": 6, "spoke": 7}, {"id": 1, "name": "DEVLIN", "names": ["DEVLIN"], "gender": "f", "first": 7, "spoke": 6}, {"id": 2, "name": "ANTOINETTE", "names": ["ANTOINETTE"], "gender": "f", "first": 8, "spoke": 4}, {"id": 3, "name": "KIERAN", "names": ["KIERAN"], "gender": "?", "first": 9, "spoke": 5}, {"id": 4, "name": "SEUN", "names": ["SEUN"], "gender": "?", "first": 10, "spoke": 2}, {"id": 5, "name": "LAVINIA", "names": ["LAVINIA"], "gender": "?", "first": 11, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. GLASS GREENHOUSE - WEDDING REHEARSAL - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Ranks of potted orchids.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Warm fog on the panes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A white aisle runner laid between fern beds.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Folding chairs.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A trellis arch drapes with unlit fairy lights.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "ROSEMARY, 30s, the bride, in jeans and a linen blouse, stands at the arch.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "DEVLIN, 30s, the groom, in a rumpled suit, stands beside her.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "ANTOINETTE, 60s, the officiant, in a shawl, holds an index card.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "KIERAN, 30s, the best man, slouches against a pot of cymbidiums.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "SEUN, 20s, the maid of honor, in a floral wrap dress, holds a bouquet of paper flowers.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "LAVINIA, 50s, Rosemary's mother, perches on a chair with a clipboard.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "All right, everyone. Positions!", "name": "LAVINIA", "speaker": 5, "ext": [], "paren": ["to the group"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Where do I stand?", "name": "KIERAN", "speaker": 3, "ext": [], "paren": ["to Seun"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Next to the groom.", "name": "SEUN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Which one's the groom?", "name": "KIERAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "I'm the groom.", "name": "DEVLIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Oh. Yeah.", "name": "KIERAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Dearly beloved.", "name": "ANTOINETTE", "speaker": 2, "ext": [], "paren": ["reading"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Do we say that?", "name": "ROSEMARY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "It's traditional.", "name": "ANTOINETTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "It's a little dead.", "name": "ROSEMARY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "It's very old.", "name": "ANTOINETTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "They'll be late for the caterer.", "name": "LAVINIA", "speaker": 5, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Seun glances at Kieran.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Kieran glances at Seun.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Both look away.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "She straightens the bouquet.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "He picks at a leaf.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "The fairy lights flick on, then off.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "You look nervous.", "name": "DEVLIN", "speaker": 1, "ext": [], "paren": ["to Rosemary"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "I'm not.", "name": "ROSEMARY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "You're holding your breath.", "name": "DEVLIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "It's the humidity.", "name": "ROSEMARY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Ro.", "name": "DEVLIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "He looked at her.", "name": "ROSEMARY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Who?", "name": "DEVLIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Kieran. At Seun.", "name": "ROSEMARY", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "They're the best man and the maid of honor. They're supposed to look at each other.", "name": "DEVLIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Not like that.", "name": "ROSEMARY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Antoinette clears her throat and taps the card.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Does anyone object?", "name": "ANTOINETTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "A silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Everyone looks at one another.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "It's a rehearsal. No one objects.", "name": "LAVINIA", "speaker": 5, "ext": [], "paren": ["to the group"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Actually.", "name": "KIERAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "All heads turn.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "Kieran is looking at Seun.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "She stares back, wide-eyed.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "Nope. Never mind.", "name": "KIERAN", "speaker": 3, "ext": ["CONT'D"], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "Oh no.", "name": "SEUN", "speaker": 4, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "The fairy lights blaze on, all at once, and a hundred small gold stars shine above the arch.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}