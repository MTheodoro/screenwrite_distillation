{"scene_id": "s00408", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00408.fountain", "heading": "EXT. APARTMENT ROOFTOP - WATER TANK - DAY", "cast": [{"id": 0, "name": "DANTE", "names": ["DANTE"], "gender": "m", "first": 5, "spoke": 18}, {"id": 1, "name": "REMY", "names": ["REMY"], "gender": "?", "first": 6, "spoke": 21}, {"id": 2, "name": "ALVAREZ", "names": ["ALVAREZ"], "gender": "f", "first": 48, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. APARTMENT ROOFTOP - WATER TANK - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Tar paper and heat shimmer.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A wooden water tower hunches on iron legs.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A rusted ladder climbs its side.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Below, a city sprawls into haze.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DANTE, 17, in a stained T-shirt, scrapes flaking paint from a pipe with a putty knife.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "His brother REMY, 14, holds a bucket of sealant and a rag.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Dante.", "name": "REMY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Yeah.", "name": "DANTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Can I try?", "name": "REMY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "You'll drop it.", "name": "DANTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I won't.", "name": "REMY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "You dropped the last one.", "name": "DANTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "That was a wrench.", "name": "REMY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "It's the same thing.", "name": "DANTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Remy sets the bucket down.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He plants his hands on his hips.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Dante keeps scraping.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Dad said we could split it.", "name": "REMY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Dad said I could handle it.", "name": "DANTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "He said split.", "name": "REMY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "He said it to be nice.", "name": "DANTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Dante.", "name": "REMY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Remy.", "name": "DANTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "I'm fourteen.", "name": "REMY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "You're fourteen and a half.", "name": "DANTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "That's what I said.", "name": "REMY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Dante sighs.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "He hands over the knife.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Remy takes it, and the metal catches the sun.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "He crouches by the pipe, tongue between his teeth, and scrapes.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Not that hard.", "name": "DANTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "It's rusty.", "name": "REMY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "It's rusty, not stubborn.", "name": "DANTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "You don't know that.", "name": "REMY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "A chunk of paint falls away.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Underneath, the pipe gleams, a bright silver gash.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Remy beams.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Look!", "name": "REMY", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Nice.", "name": "DANTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "You didn't look.", "name": "REMY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "I looked.", "name": "DANTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "You didn't.", "name": "REMY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Dante turns.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "The pipe shines.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "Something in his face changes.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "He reaches out, as if to touch it, and then the ladder rattles.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Both freeze.", "para": 5, "sent": 4, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "A head pokes over the edge of the roof: MRS. ALVAREZ, from 4C, an old woman in a housecoat, hauling a laundry basket.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "No.", "name": "DANTE", "speaker": 0, "ext": ["CONT'D"], "paren": ["under his breath"], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "She's going to see.", "name": "REMY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "She won't see.", "name": "DANTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "She's looking right at it.", "name": "REMY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Mrs. Alvarez squints, adjusts her glasses, and sets the basket on the tar paper.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "She says nothing.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Dante and Remy stare at her.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "She stares back, and then, slowly, she turns and begins to hang a towel on the line.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "She's not going to say anything.", "name": "REMY", "speaker": 1, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "Don't talk.", "name": "DANTE", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "They crouch together behind the tank.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "Remy hands Dante the knife.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "Dante hands Remy the rag.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "They go back to work, shoulder to shoulder, trading the tools without looking.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "Dante drops the knife.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "It clatters.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "They both freeze again.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "You dropped it.", "name": "REMY", "speaker": 1, "ext": [], "paren": ["grinning"], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "dialogue", "text": "Shut up.", "name": "DANTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 68, "kind": "dialogue", "text": "You dropped it, Dante.", "name": "REMY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 69, "kind": "dialogue", "text": "It slipped.", "name": "DANTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 70, "kind": "dialogue", "text": "It slipped.", "name": "REMY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 71, "kind": "action", "text": "Dante shoves him.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 72, "kind": "action", "text": "Remy shoves back.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 73, "kind": "action", "text": "They tumble into the bucket, which tips, and sealant oozes across the roof in a black tongue.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 74, "kind": "action", "text": "Mrs. Alvarez, at the line, calmly continues hanging her wash.", "para": 10, "sent": 3, "present": [0, 1, 2]}, {"u": 75, "kind": "dialogue", "text": "Look what you did.", "name": "DANTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 76, "kind": "dialogue", "text": "Look what you did!", "name": "REMY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 77, "kind": "action", "text": "They both scramble for the spill, rags and hands, then laugh, because there is nothing else to do.", "para": 11, "sent": 0, "present": [0, 1, 2]}]}