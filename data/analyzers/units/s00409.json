{"scene_id": "s00409", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00409.fountain", "heading": "INT. BASEMENT REC ROOM - PING-PONG TOURNAMENT - NIGHT", "cast": [{"id": 0, "name": "SUNNY", "names": ["SUNNY"], "gender": "f", "first": 4, "spoke": 5}, {"id": 1, "name": "BOOKER", "names": ["BOOKER"], "gender": "m", "first": 4, "spoke": 3}, {"id": 2, "name": "MILO", "names": ["MILO"], "gender": "?", "first": 7, "spoke": 4}, {"id": 3, "name": "FRANCESCA", "names": ["FRANCESCA"], "gender": "?", "first": 8, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. BASEMENT REC ROOM - PING-PONG TOURNAMENT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Wood paneling and low ceiling.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single table under a bare bulb.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Folding chairs hold a dozen onlookers, cans of soda in hand.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A chalkboard bracket hangs on the wall, with SUNNY and BOOKER circled at the bottom.", "para": 0, "sent": 3, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "SUNNY, 20s, a wiry woman in a headband and a retro track jacket, bounces the ball on her paddle.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "BOOKER, 40s, a big, slow man in a cardigan, wipes his hands on his pants.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "MILO, 12, the referee, sits on a stepladder with a whistle and a clipboard.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "FRANCESCA, 50s, Booker's wife, holds a thermos at courtside.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Nine to eight, Sunny.", "name": "MILO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "I know.", "name": "SUNNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I know.", "name": "BOOKER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "They say it together.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Both flinch.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "I know the score. ^BOOKER Let's finish this.", "name": "SUNNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Serve.", "name": "MILO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Sunny serves.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Booker slams it back.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "The ball skims the net and drops onto Sunny's side, where it rolls off the table's edge and under a chair.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Point, Booker!", "name": "FRANCESCA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Nine to nine. Final game point.", "name": "MILO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "The crowd murmurs.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Sunny retrieves the ball, blows on it, and tosses it to Booker.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Your serve.", "name": "SUNNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "You sure?", "name": "BOOKER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "I like to win clean.", "name": "SUNNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Booker grins.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "He rolls his shoulders, steps back, and lets the ball fly.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Sunny returns it with a snap.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "It arcs high.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Booker drives it down in a smash that rings on the table.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Sunny dives, paddle outstretched, and flicks it back from the floor.", "para": 5, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "The ball hangs in the air.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Everyone holds their breath.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "It lands, clips the edge, and drops.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Point... Sunny.", "name": "MILO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "The room erupts.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Sunny leaps up, fists raised.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Booker bows his head, laughs, and holds out a hand.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Well played.", "name": "BOOKER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "You almost had me.", "name": "SUNNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "He always almost has them.", "name": "FRANCESCA", "speaker": 3, "ext": [], "paren": ["to Sunny"], "dual": false, "present": [0, 1, 2, 3]}]}