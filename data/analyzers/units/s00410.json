{"scene_id": "s00410", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00410.fountain", "heading": "EXT. DESERT WELL - DUSK", "cast": [{"id": 0, "name": "AMOS", "names": ["AMOS"], "gender": "?", "first": 4, "spoke": 8}, {"id": 1, "name": "HESTER", "names": ["HESTER"], "gender": "?", "first": 7, "spoke": 6}, {"id": 2, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 8, "spoke": 3}, {"id": 3, "name": "CALLOWAY", "names": ["CALLOWAY"], "gender": "?", "first": 26, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DESERT WELL - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "A dry well, a rope, a bucket.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sage and rock.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The sun is a red coin.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "AMOS, 60s, a grizzled prospector, hauls the bucket up hand over hand.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Empty.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "He tosses it aside.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "Beside him, HESTER, 30s, in a long gray coat, holds a rifle loosely.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "A STRANGER, 40s, stands thirty yards off on a ridge, a black silhouette against the sky.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "He's been there an hour.", "name": "HESTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "He's patient.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Or dumb.", "name": "HESTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Maybe both.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "The Stranger lifts a hand.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "He starts down the slope, slow, each step careful.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Want me to?", "name": "HESTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Not yet.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "He reaches the well.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Close up, he's older than he seemed, with a gray beard and a limp.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "He tips his hat.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Afternoon.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Evening.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Is there water?", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Not for a week.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The Stranger nods.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "He sits on a rock, puts down his pack.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "I'm Calloway. Samuel Calloway.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Great.", "name": "HESTER", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "You know me.", "name": "CALLOWAY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "We know the name.", "name": "HESTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Amos stiffens.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "His hand goes to his belt.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Hester's thumb finds the hammer.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "I'm not here for trouble.", "name": "CALLOWAY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Then why?", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Because the man who shot your son is dead.", "name": "CALLOWAY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "A beat.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "The wind drops.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Hester's rifle sags.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Amos stares at the Stranger for a long moment, his eyes wet in the red light.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Who did it?", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "I did.", "name": "CALLOWAY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Silence.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Amos turns, picks up the bucket, and walks back to the well.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "He hangs it on its hook.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "His hand lingers on the rope.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Amos.", "name": "HESTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Give him your canteen.", "name": "AMOS", "speaker": 0, "ext": [], "paren": ["without turning"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Hester doesn't move.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Then, slowly, she unslings it and tosses it to the man on the rock.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}]}