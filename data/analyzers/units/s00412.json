{"scene_id": "s00412", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00412.fountain", "heading": "INT. LATE-NIGHT NOODLE BAR - NIGHT", "cast": [{"id": 0, "name": "JOSEFINA", "names": ["JOSEFINA"], "gender": "?", "first": 5, "spoke": 17}, {"id": 1, "name": "CASPIAN", "names": ["CASPIAN"], "gender": "?", "first": 6, "spoke": 18}, {"id": 2, "name": "WREN", "names": ["WREN"], "gender": "m", "first": 7, "spoke": 3}, {"id": 3, "name": "BASIL", "names": ["BASIL"], "gender": "m", "first": 8, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. LATE-NIGHT NOODLE BAR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Steam.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fluorescent.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Six stools at a counter, two booths.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A neon sign buzzes: OPEN 'TIL SOMEONE LEAVES.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "JOSEFINA, 28, in a rain-soaked red coat, sits alone at the counter slurping noodles.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "CASPIAN, 30, in a bicycle courier's jacket, drips onto the stool next to hers.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "WREN, 60s, the owner, wipes the counter.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "BASIL, 20s, the dishwasher, drags a bus tub of bowls through the kitchen door.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Is this seat free?", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "It's a counter.", "name": "JOSEFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "That's not a no.", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "That's a counter.", "name": "JOSEFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "He sits.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Wren sets a bowl in front of him without being asked.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Caspian. Usual.", "name": "WREN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Thanks, Wren.", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "You're a regular.", "name": "JOSEFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Eleven months.", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "I've been coming for three years.", "name": "JOSEFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "I would've remembered.", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "I'm very forgettable.", "name": "JOSEFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "You're wearing a red coat.", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "She looks down at it, then at him.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "A noodle dangles from her chopsticks.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Basil emerges from the kitchen, sees them, and pauses.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Wren, do we have more broth?", "name": "BASIL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Back left.", "name": "WREN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Okay.", "name": "BASIL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "He leaves.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Josefina and Caspian eat in silence.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "The neon buzzes.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "I have a question.", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Okay.", "name": "JOSEFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Why do you sit at the counter?", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Why do you?", "name": "JOSEFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Because the booths have a wall. You can't see anyone.", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "That's the point.", "name": "JOSEFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Of the booth?", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Of not wanting to be seen.", "name": "JOSEFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "A pause.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Caspian lays down his chopsticks.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "He turns his stool slightly toward her.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Are you hiding?", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "From who?", "name": "JOSEFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "I don't know. From the night?", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "That's very poetic.", "name": "JOSEFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "It's very late.", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "It's two a.m.", "name": "JOSEFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "I know. I've been delivering since six.", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "You work twenty hours?", "name": "JOSEFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Nineteen. I get a nap.", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "She laughs, a short, startled sound.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "She covers her mouth, embarrassed, and Wren glances up with a small smile.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "You're a bad influence.", "name": "JOSEFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "You're a good listener.", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "I haven't said anything.", "name": "JOSEFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "That's the best kind.", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "She meets his eyes.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "A beat.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "She nudges her half-eaten bowl toward him with one finger.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "Finish it.", "name": "JOSEFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "Are you sure?", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "You've been nineteen hours.", "name": "JOSEFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "He takes the bowl.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "Wren sets a second pair of chopsticks beside it.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "Basil, in the kitchen doorway, shakes his head in awe.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "She never shares.", "name": "BASIL", "speaker": 3, "ext": [], "paren": ["to Wren"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "Back to the dishes.", "name": "WREN", "speaker": 2, "ext": [], "paren": ["to Basil"], "dual": false, "present": [0, 1, 2, 3]}]}