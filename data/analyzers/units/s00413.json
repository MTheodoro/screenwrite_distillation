{"scene_id": "s00413", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00413.fountain", "heading": "EXT. GLACIER CAVE MOUTH - DAWN", "cast": [{"id": 0, "name": "MORWENNA", "names": ["MORWENNA"], "gender": "f", "first": 5, "spoke": 2}, {"id": 1, "name": "IVAR", "names": ["IVAR"], "gender": "f", "first": 6, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. GLACIER CAVE MOUTH - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A cathedral of blue ice.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cold fire glints along its roof.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wind keens through a crack as tall as a house.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Snow whips past the entrance.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MORWENNA, 30s, a ranger in a hooded sealskin cloak with a spear, plants her feet at the cave mouth.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "IVAR, 70s, her mentor, white-bearded, leaning on a staff of driftwood, wheezes beside her.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "It's in there.", "name": "MORWENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "It's always been in there.", "name": "IVAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "She steps forward.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "The ice floor groans.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "A low note thrums from deep inside the cave, a note too big for a throat.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "They both freeze.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "The crack in the ceiling widens by a finger's width, and a skein of powder sifts down on their shoulders.", "para": 2, "sent": 4, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "It knows you.", "name": "IVAR", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "It doesn't.", "name": "MORWENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Out of the dark, an eye opens, pale as a moon, vertically slit.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "It regards them.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Morwenna lifts her spear.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Ivar grabs her wrist.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "They struggle, once, hard, until the spear clatters on the ice.", "para": 3, "sent": 4, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "No weapons. Never weapons.", "name": "IVAR", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "The eye blinks.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "The wind falls away.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Morwenna looks at the old man, then at the eye, and slowly, she kneels.", "para": 4, "sent": 2, "present": [0, 1]}]}