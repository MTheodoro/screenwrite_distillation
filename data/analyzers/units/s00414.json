{"scene_id": "s00414", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00414.fountain", "heading": "INT. TINY TEA SHOP - MORNING", "cast": [{"id": 0, "name": "PERPETUA OLDFIELD", "names": ["PERPETUA OLDFIELD", "PERPETUA"], "gender": "?", "first": 6, "spoke": 14}, {"id": 1, "name": "SAMUEL", "names": ["SAMUEL"], "gender": "m", "first": 7, "spoke": 14}], "units": [{"u": 0, "kind": "heading", "text": "INT. TINY TEA SHOP - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "A shop the width of a hallway.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Shelves of tins to the ceiling.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A brass scale.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A counter polished by decades of elbows.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A bell above the door.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "PERPETUA OLDFIELD, 60s, in a lilac cardigan, stands behind the counter arranging tins by color.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "SAMUEL, 30s, a young man in an ill-fitting blazer, stands at the other side with a clipboard.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Mrs. Oldfield, I'm from the council.", "name": "SAMUEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Lovely. Tea?", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I'm not supposed to.", "name": "SAMUEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Of course. Which kind?", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Whatever you have.", "name": "SAMUEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "I have two hundred and fourteen.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Whichever is fastest.", "name": "SAMUEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Oh, that would be a gunpowder green. It rolls itself.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She takes a tin down, measures leaves onto the brass scale, adds one, takes one away.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "It's about the inspection.", "name": "SAMUEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Mm.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Your sign is two inches over the permitted size.", "name": "SAMUEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Is it?", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "By code.", "name": "SAMUEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Which code?", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Section nineteen. Paragraph four. Subsection... B.", "name": "SAMUEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Subsection B has always been my favorite.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "She pours hot water from a kettle into a small white pot.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "The steam rises between them.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Samuel adjusts his tie.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "I don't want to give you a violation.", "name": "SAMUEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Then don't.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "It's the law.", "name": "SAMUEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "So it is.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "She sets a cup in front of him.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "He looks at it.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "He looks at his clipboard.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "I really shouldn't.", "name": "SAMUEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "It's only tea.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "He takes the cup.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Sips.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "His eyes widen slightly.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "He lowers the clipboard onto the counter.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "This is very good.", "name": "SAMUEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "It's the leaf.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Is it the sign?", "name": "SAMUEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Excuse me?", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "The sign. Is it good tea because of the sign?", "name": "SAMUEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Mr. Samuel. I think you should take another sip.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": ["smiling"], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "He does.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "He sits on the stool by the counter.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "She goes back to arranging tins.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "The bell does not ring.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "Outside, the sign, two inches too large, swings gently in the wind.", "para": 6, "sent": 4, "present": [0, 1]}]}