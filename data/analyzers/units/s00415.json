{"scene_id": "s00415", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00415.fountain", "heading": "INT. SALT-MINE OBSERVATORY - NIGHT", "cast": [{"id": 0, "name": "CASSIA", "names": ["CASSIA"], "gender": "?", "first": 4, "spoke": 7}, {"id": 1, "name": "DOMINIC", "names": ["DOMINIC"], "gender": "f", "first": 5, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. SALT-MINE OBSERVATORY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cavern hewn from white crystal, three kilometers under a desert.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Great mirrors tilt on rails, collecting the dark.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Salt crystals glitter in the lamplight like frozen stars.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CASSIA, 30s, an astronomer in a headlamp and thermal suit, crouches over a console.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across the cavern, DOMINIC, 50s, her supervisor, stands at a railing, staring into the largest mirror.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Dominic. Come see this.", "name": "CASSIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "I'm busy.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "It isn't noise.", "name": "CASSIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "It's always noise.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "It repeats every eleven seconds.", "name": "CASSIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He turns.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He walks toward her, slowly, and the walk becomes a stride.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "At the console, he leans over her shoulder.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "That's the same signal.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "That's what I said.", "name": "CASSIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "From the same place?", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "From inside the planet.", "name": "CASSIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "A long pause.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "In the mirror behind them, the dark ripples, as though it has caught its own breath.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Cassia, switch off the receivers.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": ["very quiet"], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Why?", "name": "CASSIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Because it's answering.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "The console beeps.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "A new line of numbers scrolls across the screen, an eleven-second pulse, perfectly in time with her heartbeat.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Dominic.", "name": "CASSIA", "speaker": 0, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "I know.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "She lays her hand over the switch.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "He lays his hand over hers.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Neither pulls it down.", "para": 5, "sent": 2, "present": [0, 1]}]}