{"scene_id": "s00416", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00416.fountain", "heading": "INT. VANTAGE LOGISTICS - CONFERENCE ROOM - DAY", "cast": [{"id": 0, "name": "GLORIA", "names": ["GLORIA"], "gender": "m", "first": 4, "spoke": 4}, {"id": 1, "name": "MURRAY", "names": ["MURRAY"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "FITZGERALD", "names": ["FITZGERALD"], "gender": "?", "first": 14, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. VANTAGE LOGISTICS - CONFERENCE ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A glass box with a long table and a screen.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A \"Q3 SYNERGY ROADMAP\" slide glows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A bowl of unopened mints sits at the center.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "GLORIA, 40s, regional director, taps a laser pointer on the screen.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "MURRAY, 50s, a senior manager, scribbles notes with a pen that has clearly run out of ink.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Neither looks at the other.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "We'll circle back.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "We circled back last week.", "name": "MURRAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "We'll circle back again.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Murray presses harder on the pen.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "The pen refuses.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He sets it down and eyes the mints.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "The door opens.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "FITZGERALD, 20s, the new hire, in a suit too bright for the room, peeks in with a stack of binders.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "He has the face of someone who's been told \"it's easy\" many times.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Sorry. Is this the roadmap meeting?", "name": "FITZGERALD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "It's the road. We're still waiting on the map.", "name": "MURRAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Great! I brought binders.", "name": "FITZGERALD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Gloria and Murray exchange a look.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Fitzgerald distributes the binders.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "He gives one to Murray, who weighs it as if it were a brick.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "He gives one to Gloria, who doesn't open it.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "So, where are we on the deliverables?", "name": "FITZGERALD", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "He asked about deliverables.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "He asked about deliverables.", "name": "MURRAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Is that bad?", "name": "FITZGERALD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Murray reaches for a mint.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "He unwraps it, slowly, popping it into his mouth.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "He chews.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Gloria watches him.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Fitzgerald watches both.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "The deliverables, Fitzgerald, are the things we deliver.", "name": "MURRAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "And what do we deliver?", "name": "FITZGERALD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Meetings.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "A long silence.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Fitzgerald nods, writing it down.", "para": 6, "sent": 1, "present": [0, 1, 2]}]}