{"scene_id": "s00418", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00418.fountain", "heading": "INT. DRIVEWAY BASKETBALL COURT - EVENING", "cast": [{"id": 0, "name": "TEO", "names": ["TEO"], "gender": "?", "first": 5, "spoke": 17}, {"id": 1, "name": "LUKA", "names": ["LUKA"], "gender": "m", "first": 6, "spoke": 18}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRIVEWAY BASKETBALL COURT - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "A cracked asphalt pad under a flickering floodlight.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A hoop with a ragged net.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Moths whirl in the beam.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A bike lies on its side near the garage.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "TEO, 16, in an oversized hoodie, dribbles the ball in a slow, thoughtful rhythm.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "His cousin LUKA, 17, taller, leans against the garage door with his arms crossed.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "You're stalling, Teo.", "name": "LUKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "I'm warming up.", "name": "TEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "You're stalling.", "name": "LUKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I'm warming up for stalling.", "name": "TEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Luka pushes off the door.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He strides to the court and holds out his hands.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Teo hesitates, then bounce-passes.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Luka catches it.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Twenty-one. Ball to the winner.", "name": "LUKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "It's your ball.", "name": "TEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "It's about to be your ball.", "name": "LUKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "You're so sure?", "name": "TEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "I'm sure you're afraid.", "name": "LUKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Teo says nothing.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Luka checks the ball to him.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Teo catches it, plants a foot, fakes left, goes right.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Luka slides.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Teo's shot sails up and drops through the net with a clean swish.", "para": 3, "sent": 4, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "One.", "name": "TEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Lucky.", "name": "LUKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "One.", "name": "TEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Luka snatches the ball and dribbles up the court.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "He drives, bumps Teo's shoulder, and puts up a floater.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "It clanks off the rim.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "They both rush for the rebound.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Their arms tangle.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "They both fall, and the ball bounces away into the shadows.", "para": 4, "sent": 5, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Foul.", "name": "TEO", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "It's not a foul.", "name": "LUKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "You hit me.", "name": "TEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "You hit me.", "name": "LUKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "They lie there on the asphalt, breathing hard, staring at the floodlight.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "A moth circles above their faces.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Neither moves to retrieve the ball.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Teo.", "name": "LUKA", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Yeah.", "name": "TEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Your dad called.", "name": "LUKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "I know.", "name": "TEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "He said you're not coming home.", "name": "LUKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "He said what?", "name": "TEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "That you're staying with us. Through the summer.", "name": "LUKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Teo sits up.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "His face closes.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "He pulls his hood over his head and stares at the garage door.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "He didn't tell me.", "name": "TEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Maybe he wanted me to.", "name": "LUKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "That's cold, Luka.", "name": "TEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "He's not cold. He's scared.", "name": "LUKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "Of me?", "name": "TEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "Of whatever he's got to say.", "name": "LUKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "Teo gets up.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "He walks to the edge of the court, stops.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "The ball rolls out of the dark toward his foot.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "He stops it with a toe, kicks it up, catches it.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "Twenty-one.", "name": "TEO", "speaker": 0, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "What?", "name": "LUKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "We play to twenty-one. I'm up by one.", "name": "TEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "Luka rises.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "A pause.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "He wipes his hands on his shorts and gets into a defensive crouch.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "Then check.", "name": "LUKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "Teo checks the ball.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "Luka taps it back.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 70, "kind": "action", "text": "Teo spins, dribbles, and drives to the hoop.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "Luka slams into him, both of them tumbling again.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "The ball flies out of bounds, and the floodlight clicks off, and the court goes dark.", "para": 9, "sent": 4, "present": [0, 1]}, {"u": 73, "kind": "dialogue", "text": "Foul.", "name": "LUKA", "speaker": 1, "ext": ["CONT'D"], "paren": ["in the dark"], "dual": false, "present": [0, 1]}, {"u": 74, "kind": "dialogue", "text": "It's not a foul!", "name": "TEO", "speaker": 0, "ext": [], "paren": ["in the dark, laughing"], "dual": false, "present": [0, 1]}]}