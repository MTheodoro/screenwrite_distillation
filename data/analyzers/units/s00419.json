{"scene_id": "s00419", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00419.fountain", "heading": "EXT. SHELL CRATER - NIGHT", "cast": [{"id": 0, "name": "CORPORAL AHN", "names": ["CORPORAL AHN", "AHN"], "gender": "m", "first": 4, "spoke": 7}, {"id": 1, "name": "PRIVATE BOYD", "names": ["PRIVATE BOYD", "BOYD"], "gender": "m", "first": 5, "spoke": 6}, {"id": 2, "name": "LIEUTENANT SHARMA", "names": ["LIEUTENANT SHARMA", "SHARMA"], "gender": "m", "first": 6, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SHELL CRATER - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Mud.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rain.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A flare drifts down over a torn field, throwing hard green light on three men in a hole.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CORPORAL AHN, 30s, crouches with a rifle across his knees.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "PRIVATE BOYD, 19, shivers beside him, clutching a canteen.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "LIEUTENANT SHARMA, 40s, lies on his back at the crater's rim with binoculars, watching.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Quiet.", "name": "SHARMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "It's all quiet.", "name": "BOYD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Boyd.", "name": "AHN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I'm just saying.", "name": "BOYD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Mortar fire thuds far off.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "The flare dies.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Dark.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Two hundred meters. Wire line. A sentry.", "name": "SHARMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "One?", "name": "AHN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "One.", "name": "SHARMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I'll take him.", "name": "BOYD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "You won't.", "name": "AHN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I'm the best shot.", "name": "BOYD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "You're the loudest breather.", "name": "AHN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "That's not a reason.", "name": "BOYD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Boyd, stay.", "name": "SHARMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "I'll go.", "name": "AHN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Wait for the next flare.", "name": "SHARMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "They wait.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Rain taps the helmets.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Boyd takes a swallow from the canteen.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Ahn watches the rim, and the three of them hold their breath.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Another flare rises, hisses, bursts.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Now.", "name": "AHN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Now!", "name": "BOYD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "They say it together.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Go. ^BOYD Go.", "name": "AHN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Ahn is up and over the rim.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Boyd scrambles after.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Sharma slides back down into the crater, alone.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "He cradles the binoculars and watches them dwindle, two shapes, bent low, running toward the wire.", "para": 6, "sent": 3, "present": [0, 1, 2]}]}