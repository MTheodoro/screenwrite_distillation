{"scene_id": "s00427", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00427.fountain", "heading": "INT. REFRIGERATED DELIVERY TRUCK - CARGO BAY - NIGHT", "cast": [{"id": 0, "name": "POLO", "names": ["POLO"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "REYES", "names": ["REYES"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "NADIA FARRAH", "names": ["NADIA FARRAH", "NADIA"], "gender": "f", "first": 5, "spoke": 3}, {"id": 3, "name": "MAEVE DUNLEAVY", "names": ["MAEVE DUNLEAVY", "MAEVE"], "gender": "?", "first": 6, "spoke": 3}, {"id": 4, "name": "HIDEKI OTA", "names": ["HIDEKI OTA", "HIDEKI"], "gender": "m", "first": 7, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. REFRIGERATED DELIVERY TRUCK - CARGO BAY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Frost on the walls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Crates of frozen fish and one steel case chained to the floor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Four people crouch in the cold, their breath hanging in the weak red work light.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LEOPOLDO \"POLO\" REYES (50s, ski cap) is working the case's lock with a pick.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "NADIA FARRAH (30s, hooded parka) holds a flashlight.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "MAEVE DUNLEAVY (20s, driver's gloves) watches a phone.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "HIDEKI OTA (40s, quiet, a thermal bag at his hip) counts seconds under his breath.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "Hold it steady.", "name": "POLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "I am holding it steady.", "name": "NADIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Two minutes to the checkpoint.", "name": "MAEVE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Ninety seconds. Maybe.", "name": "HIDEKI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Quiet, I'm listening for the tumblers.", "name": "POLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "You can't hear tumblers in a freezer, Polo.", "name": "NADIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "He's hearing something.", "name": "MAEVE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Sixty seconds.", "name": "HIDEKI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "He taps his wrist.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "She flinches.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "He doesn't.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "The lock gives with a small, sweet click.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Got it.", "name": "POLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Open it.", "name": "NADIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Thirty seconds, open it!", "name": "MAEVE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "He lifts the lid.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Nobody breathes.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Inside, a velvet tray holds six lumpy brown bundles.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "He peels one open: a salted cod.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "It's fish.", "name": "HIDEKI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "It's all fish.", "name": "POLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Nadia swears under her breath.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Maeve laughs once, high and brittle.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "The truck slows.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Brakes hiss.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Somewhere outside, a guard's voice calls a greeting.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4]}]}