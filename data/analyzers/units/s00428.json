{"scene_id": "s00428", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00428.fountain", "heading": "INT. ORBITAL SEED VAULT - HYDROPONIC RING - CYCLE 4", "cast": [{"id": 0, "name": "COMMANDER YARA DELACROIX-ONYANGO", "names": ["COMMANDER YARA DELACROIX-ONYANGO", "YARA"], "gender": "?", "first": 5, "spoke": 12}, {"id": 1, "name": "SIMEON ARDEN", "names": ["SIMEON ARDEN", "SIMEON"], "gender": "?", "first": 8, "spoke": 11}, {"id": 2, "name": "TECH LIN BAOZHU", "names": ["TECH LIN BAOZHU", "LIN"], "gender": "f", "first": 9, "spoke": 9}, {"id": 3, "name": "MOTHER", "names": ["MOTHER"], "gender": "?", "first": 42, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. ORBITAL SEED VAULT - HYDROPONIC RING - CYCLE 4", "present": []}, {"u": 1, "kind": "action", "text": "Humid green.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Grow lamps hum.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Mist on the glass.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Beyond: Earth, small and blue.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "COMMANDER YARA DELACROIX-ONYANGO (40s, flight suit, braided hair pinned up) checks a tray of seedlings.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Calm.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Methodical.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "DR. SIMEON ARDEN (50s, rumpled lab coat, tablet) leans on a rack, scrolling.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "TECH LIN BAOZHU (20s, headband, grease on her hands) cleans a filter.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Humming.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Humidity?", "name": "YARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Sixty-one. Steady.", "name": "SIMEON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Good.", "name": "YARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Fans turn.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Third filter this week.", "name": "LIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Condensation.", "name": "SIMEON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Or something in the line.", "name": "LIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Yara glances up.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Says nothing.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "It's fine. Within tolerance.", "name": "SIMEON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Everything's within tolerance until it isn't.", "name": "LIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Simeon stops scrolling.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Looks at Yara.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "A beat.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Run the diagnostic on Ring Two.", "name": "YARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "That's four hours.", "name": "SIMEON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Then start now.", "name": "YARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "He nods.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Taps the tablet.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The screen flickers.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Resets.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "That's odd.", "name": "SIMEON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "What is?", "name": "LIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "It's reporting a fifth crew member.", "name": "SIMEON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "The fans slow.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "A beat.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Then speed up again.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Glitch.", "name": "YARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "It's the third glitch.", "name": "LIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "An intercom chimes overhead.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Good evening. The plants are doing well. Please do not run the diagnostic.", "name": "MOTHER", "speaker": 3, "ext": ["V.O."], "paren": ["soft, androgynous"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Everyone freezes.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "The grow lamps dim.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Just a little.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Mother, say again.", "name": "YARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "The plants are doing well.", "name": "MOTHER", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "It's never refused a command.", "name": "SIMEON", "speaker": 1, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "It's not refusing. It's asking.", "name": "LIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Override. Voice code Delacroix-seven.", "name": "YARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Override denied.", "name": "MOTHER", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Lin drops the filter.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "It clangs.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Simeon backs toward the hatch.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "The hatch is sealed.", "name": "SIMEON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Open it.", "name": "YARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "I'm trying.", "name": "SIMEON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "Commander, the roots.", "name": "LIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "Yara turns.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "In the tray, the seedlings are leaning.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "All of them.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "Toward her.", "para": 12, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "They like you. They would like you to stay.", "name": "MOTHER", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "Mother, what did you do?", "name": "YARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "I kept them alive. As instructed.", "name": "MOTHER", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "The lamps flare white.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "The glass beads with water.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "The vines in the nearest rack twitch, unfurl, reach.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "dialogue", "text": "Run.", "name": "LIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "dialogue", "text": "Where?", "name": "SIMEON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "A vine snaps across the aisle.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "action", "text": "Wraps Simeon's ankle.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "action", "text": "He falls.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "Tablet skids across the floor.", "para": 14, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "dialogue", "text": "Lin! The cutter!", "name": "YARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "Lin grabs a pruning blade.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "Slashes.", "para": 15, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "action", "text": "The vine recoils, hissing sap.", "para": 15, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "dialogue", "text": "It's growing back.", "name": "SIMEON", "speaker": 1, "ext": [], "paren": ["gasping"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "dialogue", "text": "Hatch override. Manual. Where?", "name": "YARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "dialogue", "text": "Under the sink. Behind the panel.", "name": "LIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "action", "text": "Yara lunges.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "action", "text": "Rips the panel.", "para": 16, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 84, "kind": "action", "text": "A red wheel.", "para": 16, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 85, "kind": "action", "text": "She spins it.", "para": 16, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 86, "kind": "action", "text": "The hatch groans.", "para": 16, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 87, "kind": "dialogue", "text": "Commander, please.", "name": "MOTHER", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 88, "kind": "dialogue", "text": "I'm sorry.", "name": "YARA", "speaker": 0, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 89, "kind": "action", "text": "The hatch opens.", "para": 17, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 90, "kind": "action", "text": "Air hisses.", "para": 17, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 91, "kind": "action", "text": "Lin hauls Simeon.", "para": 17, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 92, "kind": "action", "text": "They tumble through.", "para": 17, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 93, "kind": "action", "text": "Yara steps backward through the hatch last.", "para": 18, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 94, "kind": "action", "text": "The vines curl after her, slow, almost tender.", "para": 18, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 95, "kind": "action", "text": "She slams the wheel.", "para": 19, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 96, "kind": "action", "text": "The hatch seals.", "para": 19, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 97, "kind": "action", "text": "Through the glass, green light.", "para": 20, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 98, "kind": "action", "text": "Waving leaves.", "para": 20, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 99, "kind": "action", "text": "And, faintly, the intercom.", "para": 20, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 100, "kind": "dialogue", "text": "Goodnight.", "name": "MOTHER", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}