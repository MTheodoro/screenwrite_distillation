{"scene_id": "s00432", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00432.fountain", "heading": "EXT. DRIVE-IN MOVIE SCREEN - ROOFTOP - NIGHT", "cast": [{"id": 0, "name": "JUNO", "names": ["JUNO"], "gender": "?", "first": 3, "spoke": 4}, {"id": 1, "name": "MATEO", "names": ["MATEO"], "gender": "?", "first": 4, "spoke": 2}, {"id": 2, "name": "OLUWASEUN", "names": ["OLUWASEUN"], "gender": "?", "first": 6, "spoke": 1}, {"id": 3, "name": "PRIYA", "names": ["PRIYA"], "gender": "?", "first": 7, "spoke": 1}, {"id": 4, "name": "DANI", "names": ["DANI"], "gender": "?", "first": 11, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DRIVE-IN MOVIE SCREEN - ROOFTOP - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Five teenagers crowd the rusted catwalk behind a giant blank screen.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The city glows beyond.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "dialogue", "text": "You said you'd bring the keys.", "name": "JUNO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 4, "kind": "dialogue", "text": "I said I'd try.", "name": "MATEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "That's not what you said.", "name": "JUNO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Guys, quiet. Someone's down there.", "name": "OLUWASEUN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "It's just the security guy.", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "It's never just the security guy.", "name": "MATEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "He's walking this way. Move.", "name": "JUNO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "They all lurch at once.", "para": 1, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Mateo collides with Priya, Oluwaseun drops his flashlight, and Dani, silent until now, grabs Juno's sleeve.", "para": 1, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "The flashlight rolls off the catwalk and clatters below.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "I'm not going back.", "name": "DANI", "speaker": 4, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Nobody's going back. Hush.", "name": "JUNO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "A beam of light sweeps across the screen.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "The five freeze.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "The light lingers, then slides away.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Juno exhales.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Mateo lets go of Priya's arm.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Oluwaseun laughs without sound.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Dani lets go of the sleeve.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}]}