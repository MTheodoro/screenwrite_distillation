FRANCISCO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "You're late. Hand it over.", "name": "NINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Both of you, calm down.", "name": "ROLAND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "He's got a gun.", "name": "FRANCISCO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "I know he's got a gun.", "name": "NINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "She lunges for the satchel.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "He lunges for her wrist.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "They collide and go down, the satchel skidding across the concrete.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Roland steps forward and plants a boot on it.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "That's enough. Both of you, up.", "name": "ROLAND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "They rise slowly, breathing hard.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Roland picks up the satchel and weighs it in his hand.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Then he tosses it back at Francisco, and walks away.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "What was that?", "name": "NINA", "speaker": 1, "ext": [], "paren": ["staring after him"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Francisco unzips the satchel.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Inside, it is empty.", "para": 4, "sent": 1, "present": [0, 1, 2]}]}