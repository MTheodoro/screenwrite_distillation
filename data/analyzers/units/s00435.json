{"scene_id": "s00435", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00435.fountain", "heading": "INT. LAUNDROMAT - NIGHT", "cast": [{"id": 0, "name": "ROSALIND", "names": ["ROSALIND"], "gender": "?", "first": 4, "spoke": 7}, {"id": 1, "name": "MAN IN HOODIE", "names": ["YOUNG MAN", "MAN IN HOODIE"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "ABUELA TERESA", "names": ["ABUELA TERESA"], "gender": "?", "first": 7, "spoke": 2}, {"id": 3, "name": "TEEN GIRL", "names": ["TEEN GIRL"], "gender": "?", "first": 9, "spoke": 2}, {"id": 4, "name": "DARIO", "names": ["DARIO"], "gender": "?", "first": 10, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAUNDROMAT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Humming dryers.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A flickering fluorescent tube.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Five people, one crowded bench.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "dialogue", "text": "That's my machine.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 5, "kind": "dialogue", "text": "It was empty.", "name": "YOUNG MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "It was paused.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Mija, let him have it.", "name": "ABUELA TERESA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Mama, I've been here since six.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Y'all are loud.", "name": "TEEN GIRL", "speaker": 3, "ext": [], "paren": ["not looking up from phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "I'm Dario, by the way.", "name": "YOUNG MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "I don't care, Dario.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Dario, you want a tamale?", "name": "ABUELA TERESA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Yes, ma'am.", "name": "DARIO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Mama!", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Can someone cover me for the dryer? I need quarters.", "name": "MAN IN HOODIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Nobody has quarters.", "name": "TEEN GIRL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "I have quarters.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "God bless you.", "name": "MAN IN HOODIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Take the machine, Dario.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Thank you. Really.", "name": "DARIO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}