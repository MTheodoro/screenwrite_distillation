{"scene_id": "s00438", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00438.fountain", "heading": "INT. OPERA HOUSE - PROPERTY ROOM - 1912 - NIGHT", "cast": [{"id": 0, "name": "LADY CORDELIA ASHWORTH", "names": ["LADY CORDELIA ASHWORTH", "CORDELIA"], "gender": "?", "first": 6, "spoke": 2}, {"id": 1, "name": "FERDINAND LACROIX", "names": ["FERDINAND LACROIX", "FERDINAND"], "gender": "?", "first": 10, "spoke": 3}, {"id": 2, "name": "INSPECTOR GRIMSBY", "names": ["INSPECTOR GRIMSBY", "GRIMSBY"], "gender": "m", "first": 24, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. OPERA HOUSE - PROPERTY ROOM - 1912 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Costumes on hooks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Painted swords.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Plaster saints.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "One lantern.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Silence.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "LADY CORDELIA ASHWORTH (30s, velvet cloak) kneels by a trunk.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "She lifts a lid.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "Reaches inside.", "para": 1, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "Draws out a glass vial.", "para": 1, "sent": 3, "present": [0]}, {"u": 10, "kind": "action", "text": "Behind her, MR. FERDINAND LACROIX (50s, theater manager, waistcoat) watches from a rack of wigs.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He coughs.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She does not turn.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Lady Ashworth. Still here?", "name": "FERDINAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Looking for a prop.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Ah.", "name": "FERDINAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He steps closer.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She slips the vial into her sleeve.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He smiles.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Rehearsal ended hours ago.", "name": "FERDINAND", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "I'm very dedicated.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "A door bangs.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Heavy boots.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Voices from the corridor.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "A broad figure fills the doorway: INSPECTOR GRIMSBY (40s, bowler, mud on his boots).", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "He scans the room.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "His eyes settle on the trunk.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Evening.", "name": "GRIMSBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Ferdinand lunges for the lantern.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Cordelia slams the trunk lid.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Grimsby draws his truncheon.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The lantern falls.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Darkness.", "para": 6, "sent": 4, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Scuffle.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "A curse.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Glass shatters.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "The lantern rolls and rights itself, still burning.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "They stand frozen, three in a triangle.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "He holds the broken vial.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "She holds a fencing foil.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "He holds the truncheon.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Well, then.", "name": "GRIMSBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}