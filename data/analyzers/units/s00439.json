{"scene_id": "s00439", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00439.fountain", "heading": "EXT. HIGH DESERT WINDMILL - DAY", "cast": [{"id": 0, "name": "EZRA", "names": ["EZRA"], "gender": "?", "first": 3, "spoke": 5}, {"id": 1, "name": "HATTIE", "names": ["HATTIE"], "gender": "?", "first": 4, "spoke": 6}, {"id": 2, "name": "TOM", "names": ["TOM"], "gender": "?", "first": 6, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. HIGH DESERT WINDMILL - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A creaking windmill over a stock tank.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Three riders sit their horses in the shade.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "dialogue", "text": "Water's low.", "name": "EZRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 4, "kind": "dialogue", "text": "Water's always low.", "name": "HATTIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "Then why're we out here?", "name": "EZRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Because Tom says the old man buried something under this mill.", "name": "HATTIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "I never said that.", "name": "TOM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "You said it Tuesday.", "name": "HATTIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "I said somebody told me a man told me.", "name": "TOM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "That's three hands removed from nothing.", "name": "EZRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Dig.", "name": "HATTIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "With what?", "name": "TOM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Your spurs.", "name": "HATTIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Hattie, I'm too old to dig.", "name": "EZRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Then watch Tom.", "name": "HATTIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "I'm not digging, either.", "name": "TOM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Well, somebody better.", "name": "EZRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "A long wind moves through the blades.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "The mill creaks.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "The three sit and look at one another.", "para": 1, "sent": 2, "present": [0, 1, 2]}]}