{"scene_id": "s00440", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00440.fountain", "heading": "INT. HOT-AIR BALLOON BASKET - SUNSET", "cast": [{"id": 0, "name": "CELESTE ARNAULT", "names": ["CELESTE ARNAULT", "CELESTE"], "gender": "?", "first": 4, "spoke": 7}, {"id": 1, "name": "BEN", "names": ["BEN"], "gender": "?", "first": 5, "spoke": 6}, {"id": 2, "name": "ADEYEMI-CROSS", "names": ["ADEYEMI-CROSS"], "gender": "?", "first": 5, "spoke": 0}, {"id": 3, "name": "FARMER", "names": ["FARMER"], "gender": "m", "first": 27, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOT-AIR BALLOON BASKET - SUNSET", "present": []}, {"u": 1, "kind": "action", "text": "A basket drifts over patchwork fields.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Gold light.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A burner roars, falls silent.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CELESTE ARNAULT (30s, windbreaker) grips the ropes.", "para": 0, "sent": 3, "present": [0]}, {"u": 5, "kind": "action", "text": "BENEDICT \"BEN\" ADEYEMI-CROSS (30s, scarf) stands opposite, holding a small velvet box he has not opened.", "para": 0, "sent": 4, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "We're losing height.", "name": "CELESTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "I know.", "name": "BEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Then burn.", "name": "CELESTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "He pulls the cord.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "The flame roars.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "They rise a little.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Celeste exhales.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Celeste, I need to say something.", "name": "BEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Of course you do. At two thousand feet.", "name": "CELESTE", "speaker": 0, "ext": [], "paren": ["to the sky, quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "I had a speech.", "name": "BEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Everyone has a speech.", "name": "CELESTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "He fumbles with the box.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "It slips and bounces on the wicker floor.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "They both dive.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Their hands meet on the lid.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Sorry.", "name": "BEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Don't be.", "name": "CELESTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "They hold the box together.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Neither opens it.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "The balloon drifts through a low cloud.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "A voice shouts from below, faint and cheerful.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "An old FARMER (60s, overalls, straw hat) stands in a field waving both arms, a pitchfork leaning at his side.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "You two want a ride back?!", "name": "FARMER", "speaker": 3, "ext": [], "paren": ["distant"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "We're fine, thank you!", "name": "BEN", "speaker": 1, "ext": [], "paren": ["calling down"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "We are not fine.", "name": "CELESTE", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "She laughs.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Ben laughs.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "She takes the box, opens it, and looks for a long time.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Ask me on the ground.", "name": "CELESTE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "On the ground.", "name": "BEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "He pulls the cord.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "The flame sighs.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}]}