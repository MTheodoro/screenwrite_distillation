{"scene_id": "s00441", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00441.fountain", "heading": "INT. GRAND HOTEL - HONEYMOON SUITE - MORNING", "cast": [{"id": 0, "name": "HARRY", "names": ["HARRY"], "gender": "?", "first": 4, "spoke": 2}, {"id": 1, "name": "FOSTER-WELLS", "names": ["FOSTER-WELLS"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "GWENDOLYN", "names": ["GWENDOLYN"], "gender": "?", "first": 5, "spoke": 2}, {"id": 3, "name": "MILDRED PETTIBONE", "names": ["MILDRED PETTIBONE", "MILDRED"], "gender": "?", "first": 6, "spoke": 2}, {"id": 4, "name": "LIONEL", "names": ["LIONEL"], "gender": "?", "first": 6, "spoke": 2}, {"id": 5, "name": "PARROT", "names": ["PARROT"], "gender": "?", "first": 12, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRAND HOTEL - HONEYMOON SUITE - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "A fat canopy bed buried in pink pillows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Champagne bucket tipped over.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A parrot on a brass stand.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "HARRIGAN \"HARRY\" FOSTER-WELLS (50s, bathrobe, one slipper) staggers from the bathroom clutching a toothbrush.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "His new wife GWENDOLYN (40s, silk turban) shrieks from the bed, flings a pillow, and knocks the champagne bucket into the parrot's cage.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "Her sister MILDRED PETTIBONE (60s, stern, steaming iron in hand) bursts in through the connecting door, ignoring both of them, while the bellhop LIONEL (20s, brass buttons) wheels in a breakfast cart with a cheerful whistle.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "action", "text": "He trips on the cart.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "It careens across the room.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "She leaps aside.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "He catches it.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "The parrot lands on his head.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Congratulations!", "name": "PARROT", "speaker": 5, "ext": [], "paren": ["squawking"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Get it off!", "name": "HARRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Don't hurt Percival!", "name": "GWENDOLYN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "I told you not to marry him.", "name": "MILDRED", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Breakfast, sir!", "name": "LIONEL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Harry spins.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "The parrot flaps.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "The toothbrush flies.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "It hits the iron.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "The iron hits the bucket.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "A fountain of ice erupts.", "para": 3, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Harry, the pearls!", "name": "GWENDOLYN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "What pearls?", "name": "HARRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "The pearls on the tray, sir.", "name": "LIONEL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Everyone looks at the tray.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "On a silver plate, beside the croissants, sits a double strand of pearls.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "I'll take those.", "name": "MILDRED", "speaker": 3, "ext": [], "paren": ["grimly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "She plucks them.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "He bows.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "She exits through the connecting door, slamming it.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "The parrot settles on Harry's shoulder and preens.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Till death!", "name": "PARROT", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}