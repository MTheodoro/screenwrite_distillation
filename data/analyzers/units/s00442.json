{"scene_id": "s00442", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00442.fountain", "heading": "INT. STRANDED GONDOLA - ALPINE CABLE LINE - NIGHT", "cast": [{"id": 0, "name": "ANSELMO RIVERA-FOX", "names": ["ANSELMO RIVERA-FOX", "ANSELMO"], "gender": "?", "first": 6, "spoke": 4}, {"id": 1, "name": "TILLY HARGREAVES", "names": ["TILLY HARGREAVES", "TILLY"], "gender": "?", "first": 7, "spoke": 2}, {"id": 2, "name": "SASHA", "names": ["SASHA"], "gender": "?", "first": 8, "spoke": 3}, {"id": 3, "name": "BONDAR", "names": ["BONDAR"], "gender": "?", "first": 8, "spoke": 0}, {"id": 4, "name": "MAYA KOTHARI", "names": ["MAYA KOTHARI", "MAYA"], "gender": "?", "first": 9, "spoke": 4}, {"id": 5, "name": "BARNABY QUILL", "names": ["BARNABY QUILL", "BARNABY"], "gender": "m", "first": 10, "spoke": 2}, {"id": 6, "name": "DISPATCH", "names": ["DISPATCH"], "gender": "?", "first": 13, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. STRANDED GONDOLA - ALPINE CABLE LINE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Wind howls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The cabin sways.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Frost etches the windows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Five climbers jammed in a space for four.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A radio crackles on the dashboard.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "ANSELMO RIVERA-FOX (40s, guide, orange parka) clutches the door lever.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "TILLY HARGREAVES (20s, injured ankle) sits wedged against the wall, face gray.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "OLEKSANDR \"SASHA\" BONDAR (50s, beard, ice axe) tries the radio.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "MAYA KOTHARI (30s, medic bag) kneels at Tilly's ankle.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "And young BARNABY QUILL (teens, headphones around his neck) holds the cabin's last flare.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Don't open that door.", "name": "ANSELMO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "I'm not touching the door.", "name": "SASHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Gondola Four, this is Valley Control. We have a crew on the way. Estimated ninety minutes.", "name": "DISPATCH", "speaker": 6, "ext": ["V.O."], "paren": ["crackling"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "Ninety minutes! She won't last!", "name": "SASHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "She'll last. Keep her warm.", "name": "MAYA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "I'm fine.", "name": "TILLY", "speaker": 1, "ext": [], "paren": ["through gritted teeth"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "Say again, Gondola Four?", "name": "DISPATCH", "speaker": 6, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "Tell them to hurry!", "name": "ANSELMO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "Can I fire the flare?", "name": "BARNABY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "Not yet.", "name": "ANSELMO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "Not yet, kid.", "name": "SASHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "I can see the lights on the ridge.", "name": "BARNABY", "speaker": 5, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "Sasha, hold her leg while I wrap it.", "name": "MAYA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "Sasha drops the radio and grips the ankle with both hands.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "action", "text": "Tilly cries out.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "action", "text": "Maya winds the bandage, tight and fast, while Anselmo braces his boots against the sliding door, Barnaby tucks the flare inside his coat to keep it dry, and the cabin lurches another foot into the dark.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "Gondola Four, report.", "name": "DISPATCH", "speaker": 6, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "Four's holding. Seventy-five minutes.", "name": "ANSELMO", "speaker": 0, "ext": [], "paren": ["to the radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "Seventy-five minutes. Talk to me about anything.", "name": "MAYA", "speaker": 4, "ext": [], "paren": ["to Tilly, softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "My dog.", "name": "TILLY", "speaker": 1, "ext": [], "paren": ["barely"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "Tell me about your dog.", "name": "MAYA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}