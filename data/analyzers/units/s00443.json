{"scene_id": "s00443", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00443.fountain", "heading": "INT. SLEEPER TRAIN - DINING CAR - NIGHT", "cast": [{"id": 0, "name": "DETECTIVE HORTENSE VANDERBILT-OKAFOR", "names": ["DETECTIVE HORTENSE VANDERBILT-OKAFOR", "HORTENSE"], "gender": "f", "first": 5, "spoke": 4}, {"id": 1, "name": "LEOPOLD PRUITT", "names": ["LEOPOLD PRUITT"], "gender": "m", "first": 10, "spoke": 0}, {"id": 2, "name": "GRETA LINDQVIST", "names": ["GRETA LINDQVIST", "GRETA"], "gender": "f", "first": 12, "spoke": 2}, {"id": 3, "name": "CAPTAIN DESMOND TREVELYAN", "names": ["CAPTAIN DESMOND TREVELYAN", "TREVELYAN"], "gender": "?", "first": 14, "spoke": 1}, {"id": 4, "name": "YOUNG MISS ADELAIDE FOX", "names": ["YOUNG MISS ADELAIDE FOX", "ADELAIDE"], "gender": "f", "first": 17, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. SLEEPER TRAIN - DINING CAR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "White tablecloths.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Swaying chandeliers.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain drums the windows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Five passengers sit at a long table set for dinner.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DETECTIVE HORTENSE VANDERBILT-OKAFOR (50s, tweed) cuts her steak.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She watches her left.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "He pushes his food around, shaking.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "She watches her right.", "para": 1, "sent": 3, "present": [0]}, {"u": 9, "kind": "action", "text": "They sip wine, calm, bored.", "para": 1, "sent": 4, "present": [0]}, {"u": 10, "kind": "action", "text": "MR. LEOPOLD PRUITT (60s, banker) coughs into a napkin.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He glances at the clock.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "MRS. GRETA LINDQVIST (40s, black gloves) dabs her mouth.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She studies the door.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "CAPTAIN DESMOND TREVELYAN (40s, uniform) sits across from them, jaw tight.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "He taps the table.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "His glass trembles.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "YOUNG MISS ADELAIDE FOX (20s, curls) looks at her plate.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "She has not eaten.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "The train enters a tunnel.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "The lights flicker.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "A scream, short and cut off.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "The lights return.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Pruitt slumps in his chair, a steak knife in his chest.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "She leaps up.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "He gasps.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "They freeze.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "He knocks over his water.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "She slaps the table.", "para": 6, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Nobody move.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "She crosses to the body and lifts his wrist.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "She shakes her head.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "She looks at each face in turn, and they stare back.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Detective, I assure you--", "name": "TREVELYAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Captain, sit down.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "He sits.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "She studies the knife, then the table settings.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "That was my knife.", "name": "GRETA", "speaker": 2, "ext": [], "paren": ["barely a whisper"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "All heads turn to her.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "She holds up her hands, palms open, gloves still on.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "I mean, it was set at my place. Someone switched it.", "name": "GRETA", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Detective, the train is locked.", "name": "ADELAIDE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Yes, Miss Fox. It is.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "She picks up the cold dinner roll from her plate, tears it in half, and sets it down.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Then one of you is lying.", "name": "HORTENSE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}