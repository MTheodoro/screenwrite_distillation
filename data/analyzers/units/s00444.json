{"scene_id": "s00444", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00444.fountain", "heading": "EXT. ABANDONED BOWLING ALLEY - ROOF - DAY", "cast": [{"id": 0, "name": "MINA SUNDARESAN", "names": ["MINA SUNDARESAN", "MINA"], "gender": "f", "first": 3, "spoke": 9}, {"id": 1, "name": "JASPER", "names": ["JASPER"], "gender": "?", "first": 4, "spoke": 4}, {"id": 2, "name": "HOLLIS WADE", "names": ["HOLLIS WADE", "HOLLIS"], "gender": "?", "first": 5, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ABANDONED BOWLING ALLEY - ROOF - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Tar paper and a rusted neon sign shaped like a pin.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Three kids sit on the edge, legs swinging, passing a warm soda.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "MINA SUNDARESAN (16, ponytail, skateboard on her lap).", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "Her brother JASPER (14, braces) beside her.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Their neighbor HOLLIS WADE (17, varsity jacket) stretched out behind them.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Okay, truth or dare.", "name": "MINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Truth.", "name": "HOLLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Do you actually like Priscilla, or are you just doing it because everyone expects you to?", "name": "MINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "That's two questions.", "name": "HOLLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "It's one question with two parts.", "name": "JASPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Shut up, Jasper.", "name": "HOLLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Answer.", "name": "MINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "I don't know. Maybe I like the idea of her.", "name": "HOLLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "That's what Dad said about the boat.", "name": "JASPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Jasper.", "name": "MINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "What? He sold it.", "name": "JASPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Your dad sold the boat?", "name": "HOLLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Last week. Don't tell anyone.", "name": "MINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I won't.", "name": "HOLLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Mina cried.", "name": "JASPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "I did not.", "name": "MINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "It's okay if you did.", "name": "HOLLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Truth or dare, Hollis. Your turn.", "name": "MINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Dare.", "name": "HOLLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Jump off the roof.", "name": "MINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Funny.", "name": "HOLLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Dare you to tell her the truth.", "name": "MINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "He grins, takes the soda, and finishes it.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "She smiles.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Jasper looks back and forth between them and stays quiet.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Fine.", "name": "HOLLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}