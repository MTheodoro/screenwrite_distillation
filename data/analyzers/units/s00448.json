{"scene_id": "s00448", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00448.fountain", "heading": "INT. DEEP-SPACE MINING BARGE - CONTROL ROOM - CONTINUOUS", "cast": [{"id": 0, "name": "CAPTAIN RUTH ESCOBAR-LINDGREN", "names": ["CAPTAIN RUTH ESCOBAR-LINDGREN", "RUTH"], "gender": "?", "first": 4, "spoke": 7}, {"id": 1, "name": "JUBAL TIDWELL", "names": ["JUBAL TIDWELL", "JUBAL"], "gender": "?", "first": 6, "spoke": 4}, {"id": 2, "name": "PRI", "names": ["PRI"], "gender": "f", "first": 8, "spoke": 4}, {"id": 3, "name": "NAGARAJAN", "names": ["NAGARAJAN"], "gender": "?", "first": 8, "spoke": 0}, {"id": 4, "name": "WREN MALLORY", "names": ["WREN MALLORY", "WREN"], "gender": "f", "first": 10, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. DEEP-SPACE MINING BARGE - CONTROL ROOM - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Steel.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Screens.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Asteroid dust drifting past the viewport.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CAPTAIN RUTH ESCOBAR-LINDGREN (50s, scarred cheek, gray crewcut).", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Hands on the console.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "First Mate JUBAL TIDWELL (30s, headset, nervous).", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Eyes on the scanner.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "ENGINEER PRIYAMVADA \"PRI\" NAGARAJAN (40s, goggles pushed up).", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Wrench in her fist.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Cadet WREN MALLORY (teen, oversized helmet).", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Wide-eyed.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Jubal. Status.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Hull at sixty percent, Captain.", "name": "JUBAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Pri. Engines.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Coughing. But alive, Ruth.", "name": "PRI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Wren. Stay low.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Yes, Captain.", "name": "WREN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "A rumble.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "The deck shudders.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Dust sifts from the ceiling.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Another impact. Starboard.", "name": "JUBAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Jubal, that's the third this hour.", "name": "PRI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Pri, patch it.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "With what? Spit?", "name": "PRI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "With whatever you've got.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Pri sighs, swings her goggles down, and heads for the hatch.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Wren scrambles after her.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Pri, can I help?", "name": "WREN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Hold the light, kid.", "name": "PRI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "The hatch seals behind them.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Ruth and Jubal watch the scanner.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "A red dot creeps closer.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Captain, it's matching our speed.", "name": "JUBAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "I see it.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "What do we do?", "name": "JUBAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "We wait.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}