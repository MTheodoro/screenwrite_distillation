{"scene_id": "s00451", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00451.fountain", "heading": "INT. FLOODED COUNTY ARCHIVE - BASEMENT - NIGHT", "cast": [{"id": 0, "name": "ATTORNEY SIGRID HOLMGREN-DADA", "names": ["ATTORNEY SIGRID HOLMGREN-DADA", "SIGRID"], "gender": "f", "first": 4, "spoke": 5}, {"id": 1, "name": "CASS", "names": ["CASS"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "LEBEAU", "names": ["LEBEAU"], "gender": "?", "first": 5, "spoke": 0}, {"id": 3, "name": "WINSTON PELLEGRINO", "names": ["WINSTON PELLEGRINO", "WINSTON"], "gender": "?", "first": 6, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. FLOODED COUNTY ARCHIVE - BASEMENT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Knee-deep brown water.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Floating file boxes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A string of emergency bulbs.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ATTORNEY SIGRID HOLMGREN-DADA (40s, waders over her suit) wades between shelves.", "para": 0, "sent": 3, "present": [0]}, {"u": 5, "kind": "action", "text": "Her paralegal CASIMIR \"CASS\" LEBEAU (20s, headlamp) carries a dripping box.", "para": 0, "sent": 4, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "And the archivist, MR. WINSTON PELLEGRINO (70s, rubber apron), shouts from the staircase above.", "para": 0, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "The 1974 deed books are on the third shelf!", "name": "WINSTON", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "They're underwater, Winston!", "name": "SIGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Then they're on the bottom shelf!", "name": "WINSTON", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Ms. Holmgren-Dada, found it. Box 41.", "name": "CASS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "She lunges across the aisle.", "para": 1, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "He lifts the box.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "She grabs the other side.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "They tug, and the box splits.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Papers fan out across the black water.", "para": 1, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Cass!", "name": "SIGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "It was your end that tore!", "name": "CASS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "What's happening down there?", "name": "WINSTON", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Nothing!", "name": "SIGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Everything!", "name": "CASS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "They scramble after the pages, snatching them from the current.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Sigrid pins one against a shelf, and Cass pins another against his chest.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "A third floats past, and both reach, and both miss.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Is it the deed?", "name": "WINSTON", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Sigrid fishes the page out of the water and reads it by headlamp.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Her face falls, then hardens.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Winston, come down here. Bring a camera.", "name": "SIGRID", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "I'm too old for stairs!", "name": "WINSTON", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "It's the signature, isn't it.", "name": "CASS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "It's a forgery.", "name": "SIGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "The three of them stand in the black water, one overhead bulb swinging above them, as the page drips in her hand.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "I'm coming.", "name": "WINSTON", "speaker": 3, "ext": ["O.S."], "paren": ["pause"], "dual": false, "present": [0, 1, 2, 3]}]}