{"scene_id": "s00452", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00452.fountain", "heading": "INT. NIGHT-SHIFT BUS DEPOT - CANTEEN - NIGHT", "cast": [{"id": 0, "name": "HILARY NWOSU-ABRAMS", "names": ["HILARY NWOSU-ABRAMS", "HILARY"], "gender": "f", "first": 4, "spoke": 4}, {"id": 1, "name": "WALT", "names": ["WALT"], "gender": "m", "first": 5, "spoke": 4}, {"id": 2, "name": "GRZESKOWIAK", "names": ["GRZESKOWIAK"], "gender": "?", "first": 5, "spoke": 0}, {"id": 3, "name": "DARNELL FAIRWEATHER", "names": ["DARNELL FAIRWEATHER", "DARNELL"], "gender": "?", "first": 6, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT-SHIFT BUS DEPOT - CANTEEN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Steel tables.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A buzzing vending machine.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Three drivers on break.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "HILARY NWOSU-ABRAMS (50s, thermos) stirs her coffee.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "WALTER \"WALT\" GRZESKOWIAK (60s, reading glasses) does a crossword.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "And newcomer DARNELL FAIRWEATHER (20s, new uniform) sits stiffly, hands folded.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Seven letters. \"Bus stop's neighbor.\"", "name": "WALT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Shelter.", "name": "HILARY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "That's seven. Thanks.", "name": "WALT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Is it always this quiet?", "name": "DARNELL", "speaker": 3, "ext": [], "paren": ["to the group"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Hilary shrugs.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Walt doesn't look up.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "I mean, I thought there'd be more people.", "name": "DARNELL", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "People go home, honey.", "name": "HILARY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Right.", "name": "DARNELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "He rubs his palms on his knees.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "She watches him over the rim of her cup.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "First night?", "name": "HILARY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Third. But the first two I was shadowing.", "name": "DARNELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Walt fills in a word.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Hilary taps the table twice.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "He's going to ask.", "name": "HILARY", "speaker": 0, "ext": [], "paren": ["to Walt, low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Six down. \"Lonely.\"", "name": "WALT", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Ask what?", "name": "DARNELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Hilary smiles and slides her thermos across the table.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "He pours a little, hesitates, and sips.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "She nods.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Walt finally looks up and gives him the pencil.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Do you know a four-letter word for \"home\"?", "name": "WALT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Darnell takes the pencil and studies the grid.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "The vending machine hums in the quiet.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Nest.", "name": "DARNELL", "speaker": 3, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Walt writes it in.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "He pushes the paper to the middle of the table, and the three of them lean over it together.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}]}