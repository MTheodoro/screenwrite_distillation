{"scene_id": "s00453", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00453.fountain", "heading": "INT. DERELICT BASEBALL STADIUM - HOME DUGOUT - NIGHT", "cast": [{"id": 0, "name": "LEFTY", "names": ["LEFTY"], "gender": "m", "first": 4, "spoke": 13}, {"id": 1, "name": "OKONKWO-REYES", "names": ["OKONKWO-REYES"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "MARCUS", "names": ["MARCUS"], "gender": "m", "first": 5, "spoke": 8}, {"id": 3, "name": "TRENT", "names": ["TRENT"], "gender": "?", "first": 5, "spoke": 0}, {"id": 4, "name": "ANNOUNCER", "names": ["ANNOUNCER"], "gender": "?", "first": 7, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. DERELICT BASEBALL STADIUM - HOME DUGOUT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cavern of concrete and shadow.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of empty seats rise behind the dugout like an audience of the dead.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single stadium light flickers over the infield, where weeds have pushed through the dirt.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "COACH LEONARD \"LEFTY\" OKONKWO-REYES (70s, faded Cubs-blue cap, hands like old leather gloves) sits on the bench with a bat across his knees.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Beside him, his former star pitcher, MARCUS \"THE ARM\" TRENT (40s, scarred right elbow, expensive coat), stares at the empty mound.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "action", "text": "And a sports radio crackles from a battered transistor on the bench.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "...and that's the final out. The Wolves take the series, four games to one.", "name": "ANNOUNCER", "speaker": 4, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "Lefty turns the dial.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "The voice dies in static.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Forty years I listened to that.", "name": "LEFTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Coach, you didn't have to come out here.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "You called me.", "name": "LEFTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "I called to say I'm sorry.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Then say it.", "name": "LEFTY", "speaker": 0, "ext": [], "paren": ["not looking at him"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Marcus opens his mouth.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Closes it.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "He stands and walks to the dugout steps.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "I sold the game, Lefty.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Lefty doesn't flinch.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "The stadium light buzzes.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "A bat taps a slow rhythm on the concrete.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "I know.", "name": "LEFTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "You know?", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "I've known since the sixth inning.", "name": "LEFTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Marcus leans on the rail.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "His breath comes out ragged.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Lefty rises, joints popping, and joins him.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "You threw a curve on 3-and-2.", "name": "LEFTY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Coach--", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "You never threw a curve on 3-and-2. Not once in eleven years.", "name": "LEFTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Marcus slides down the rail and sits on the top step, head bowed.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Lefty looks out across the field.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "The infield dirt seems to shimmer in the flicker.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "You think I came out here to hit you?", "name": "LEFTY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "I think you should.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "I came out here to hit you a few grounders.", "name": "LEFTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "He pulls a baseball from his coat pocket and holds it out.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Marcus stares at it for a long moment.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Then he takes it.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "I'm forty years old.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "I'm seventy-four.", "name": "LEFTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "He picks up the bat.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Marcus gets to his feet slowly.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Lefty gestures at the mound.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Go on. Take your spot.", "name": "LEFTY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Marcus walks out of the dugout onto the field.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "The weeds brush his coat.", "para": 9, "sent": 1, "present": [0, 1, 3, 4]}, {"u": 48, "kind": "action", "text": "He climbs the mound and turns to face home plate.", "para": 9, "sent": 2, "present": [0, 1, 3, 4]}, {"u": 49, "kind": "action", "text": "Lefty steps out of the dugout, takes a stance at the empty plate, and lifts the bat.", "para": 10, "sent": 0, "present": [0, 1, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Fastball, Arm. Right down the middle.", "name": "LEFTY", "speaker": 0, "ext": ["CONT'D"], "paren": ["calling"], "dual": false, "present": [0, 1, 3, 4]}, {"u": 51, "kind": "action", "text": "Marcus winds up.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "He throws.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "The ball cracks off the bat and sails into the darkness.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "They both watch it go.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "Foul?", "name": "MARCUS", "speaker": 2, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Gone.", "name": "LEFTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "They stand there, the old man and the young one, as the stadium light gives one last flicker and the radio on the bench, left on by no one, murmurs a single faint syllable.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "...next.", "name": "ANNOUNCER", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "Lefty lowers the bat.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "Marcus lowers his arm.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}]}