{"scene_id": "s00455", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00455.fountain", "heading": "INT. UNDERGROUND BOXING GYM - FORMER SUBWAY STATION - NIGHT", "cast": [{"id": 0, "name": "COACH IMELDA", "names": ["COACH IMELDA", "IMELDA"], "gender": "?", "first": 6, "spoke": 13}, {"id": 1, "name": "DUARTE-OSEI", "names": ["DUARTE-OSEI"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "NICO VASQUEZ-BELL", "names": ["NICO VASQUEZ-BELL", "NICO"], "gender": "m", "first": 7, "spoke": 11}, {"id": 3, "name": "SILAS KRAUSE", "names": ["SILAS KRAUSE", "SILAS"], "gender": "?", "first": 9, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. UNDERGROUND BOXING GYM - FORMER SUBWAY STATION - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A tiled platform converted into a gym.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A ring sits where the tracks used to run.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Ceiling pipes sweat.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Bare bulbs swing from wires.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Old posters curl on the walls.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "COACH IMELDA \"MA\" DUARTE-OSEI (60s, towel around neck, gnarled hands) wraps tape around a fighter's fist.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "The fighter is NICO VASQUEZ-BELL (20s, shirtless, shaved head, a tattooed rosary across his collarbone).", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "He is staring at the floor.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "At the edge of the ring, leaning on the rope, stands their rival's manager, SILAS KRAUSE (50s, camel coat, gold watch).", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Imelda. Lovely venue.", "name": "SILAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Silas. You're early.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "I like to watch the boy warm up.", "name": "SILAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "I'm warm.", "name": "NICO", "speaker": 2, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Of course you are.", "name": "SILAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Imelda finishes the tape.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Snips it.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Pats Nico's glove.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Don't listen to him.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "I'm not.", "name": "NICO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "I've brought a gift for the champion.", "name": "SILAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "He places a thick envelope on the ring apron.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "No one touches it.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "We don't take gifts.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "It's not a gift. It's an opportunity.", "name": "SILAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Ma, what is he talking about?", "name": "NICO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Imelda doesn't answer.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "She stares at Silas.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "He stares back.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Get out of my gym.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Imelda, be sensible.", "name": "SILAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Get out.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Silas lifts both hands in surrender and steps off the platform.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "He pauses at the edge.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Think about the boy's future.", "name": "SILAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "He walks off along the dark tunnel.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "His footsteps echo and fade.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Nico finally lifts his head.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "How much?", "name": "NICO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Don't.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "How much, Ma?", "name": "NICO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "She picks up the envelope and weighs it in her palm.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Then she tosses it onto the ring floor.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Open it.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Nico climbs into the ring and tears it open.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Inside: stacked bills.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "And a folded note.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "He reads it.", "para": 10, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "His jaw tightens.", "para": 10, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "He wants me to go down in the fourth.", "name": "NICO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "And?", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "And nothing.", "name": "NICO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "He crumples the note, drops it, and begins to shadowbox.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Fast.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Ugly.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Violent.", "para": 11, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "The bulbs swing above him.", "para": 11, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Imelda watches from the apron, arms folded.", "para": 11, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "Again.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "He keeps punching.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "Faster.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "His breath comes in sobs.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "The shadows leap across the tile.", "para": 12, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "Forty years you've been in this gym.", "name": "NICO", "speaker": 2, "ext": [], "paren": ["through his teeth"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "Forty-three.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "Why'd you let him in?", "name": "NICO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "Because I needed to see what you'd do.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "He stops.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "He stands in the center of the ring, chest heaving.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "The envelope lies at his feet.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "dialogue", "text": "And?", "name": "NICO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "dialogue", "text": "And you're ready.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "action", "text": "She tosses him a mouthguard.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "action", "text": "He catches it.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "A train rumbles in the distance, though no trains have run here for decades, and the entire platform trembles.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "dialogue", "text": "Fourth round.", "name": "NICO", "speaker": 2, "ext": [], "paren": ["grinning, wild"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "dialogue", "text": "Fourth round.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "He bites down on the mouthguard.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "action", "text": "She ducks through the ropes with the stool.", "para": 15, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "action", "text": "The bulbs go out.", "para": 15, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "action", "text": "In the dark, a single bell rings.", "para": 15, "sent": 3, "present": [0, 1, 2, 3]}]}