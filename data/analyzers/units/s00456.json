{"scene_id": "s00456", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00456.fountain", "heading": "EXT. DRAINED COMMUNITY POOL - NIGHT", "cast": [{"id": 0, "name": "PAISLEY OKORO-WEST", "names": ["PAISLEY OKORO-WEST", "PAISLEY"], "gender": "f", "first": 6, "spoke": 4}, {"id": 1, "name": "TIBBY", "names": ["TIBBY"], "gender": "?", "first": 7, "spoke": 6}, {"id": 2, "name": "LUNDGREN", "names": ["LUNDGREN"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "FARRUKH SAIDOV", "names": ["FARRUKH SAIDOV", "FARRUKH"], "gender": "m", "first": 8, "spoke": 2}, {"id": 4, "name": "DEL", "names": ["DEL"], "gender": "?", "first": 9, "spoke": 6}, {"id": 5, "name": "ARCEO", "names": ["ARCEO"], "gender": "?", "first": 9, "spoke": 0}, {"id": 6, "name": "LUCA BERNARDI", "names": ["LUCA BERNARDI", "LUCA"], "gender": "f", "first": 9, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DRAINED COMMUNITY POOL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "An empty concrete basin under a bruised sky.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Chain-link sagging.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Leaves in the deep end.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Graffiti: a faded dolphin.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Five teenagers perch on the diving board and the ladder rails, passing a flask.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "PAISLEY OKORO-WEST (17, braids, a rolled cigarette behind her ear) dangles upside down from the high rail.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Her cousin TIBERIUS \"TIBBY\" LUNDGREN (16, glasses, secondhand letterman) lies spread on the board.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Next to him sits FARRUKH SAIDOV (17, soccer shorts), cross-legged.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Below them, in the shallow end, DELPHINE \"DEL\" ARCEO (18, black nail polish) paces, and LUCA BERNARDI (17, fresh sunburn) leans on the wall.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "dialogue", "text": "Tibby, you're going to fall.", "name": "PAISLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "That's the plan.", "name": "TIBBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "Tibby, don't.", "name": "FARRUKH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "Let him. He's been dramatic all week.", "name": "DEL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "Del, relax.", "name": "LUCA", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "I'm relaxed, Luca.", "name": "DEL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "You're pacing a trench.", "name": "PAISLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "action", "text": "Tibby sits up.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "action", "text": "The board bounces.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "action", "text": "Farrukh grabs the rail.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "I got into Michigan.", "name": "TIBBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "action", "text": "The pool goes silent.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "action", "text": "Paisley drops from the rail and lands in a crouch.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "Tibby!", "name": "PAISLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "Congratulations, man.", "name": "FARRUKH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "That's great.", "name": "LUCA", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "Great.", "name": "DEL", "speaker": 4, "ext": [], "paren": ["flat"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "She lifts the flask and drinks.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "Luca watches her.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "She hands it to him without looking.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "I wasn't going to tell anybody.", "name": "TIBBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "Why not?", "name": "DEL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "Because she'd be like that.", "name": "TIBBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "He jerks his chin at her.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "She spins on him.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "He holds up both hands.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "Not mean. Just. You know.", "name": "TIBBY", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "Del, he's allowed to leave.", "name": "PAISLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "dialogue", "text": "I know he is.", "name": "DEL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "She says it with her back turned.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "The sky flickers with distant lightning.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "Farrukh slides down from the board.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "Luca hands her the flask back.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "She takes it, and drinks again.", "para": 7, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "dialogue", "text": "Save me a spot in the dorm.", "name": "DEL", "speaker": 4, "ext": ["CONT'D"], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "action", "text": "Tibby laughs, and the laugh turns into something else.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "action", "text": "Paisley hops onto the board and puts her arm around him.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "He leans into her shoulder.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "Farrukh climbs the ladder to the deep end and lowers himself into the dry basin.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "action", "text": "The others follow, one by one, until all five sit in the center on the leaf-strewn concrete.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "dialogue", "text": "So. Michigan.", "name": "LUCA", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "dialogue", "text": "So. Michigan.", "name": "TIBBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "action", "text": "Thunder rolls.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "action", "text": "The first drops of rain hit the bottom of the pool.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}]}