{"scene_id": "s00457", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00457.fountain", "heading": "EXT. SNOWBOUND FERRY LANDING - 1840s - DUSK", "cast": [{"id": 0, "name": "FERRYMAN ODO BRANDYWINE", "names": ["FERRYMAN ODO BRANDYWINE", "ODO"], "gender": "m", "first": 4, "spoke": 10}, {"id": 1, "name": "STRANGER", "names": ["STRANGER"], "gender": "m", "first": 5, "spoke": 5}, {"id": 2, "name": "WILHELMINA", "names": ["WILHELMINA"], "gender": "?", "first": 20, "spoke": 1}, {"id": 3, "name": "THADDEUS", "names": ["THADDEUS"], "gender": "m", "first": 22, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SNOWBOUND FERRY LANDING - 1840s - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "A frozen river, a sagging dock, a single lantern swaying.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wind drives powder across the ice.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A barge hull is locked in the freeze like a fly in amber.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "FERRYMAN ODO BRANDYWINE (50s, sealskin hat) pokes the ice with a long pole.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside him a gaunt STRANGER (30s, black greatcoat, scholar's satchel) watches the far shore.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Nobody's crossing tonight!", "name": "ODO", "speaker": 0, "ext": [], "paren": ["to the empty landing"], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "I paid for a crossing.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You paid for a ferry. This is a skating rink.", "name": "ODO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Then I will walk.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "You'll die.", "name": "ODO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Everyone does.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Odo spits.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He jabs the pole at the ice, and it cracks like a pistol.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "They both flinch.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Mad as a March hare.", "name": "ODO", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "A woman's cry carries across the river.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Both men turn.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "On the far bank, a small figure waves a lantern.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "The Stranger sets down his satchel and shouts.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Wilhelmina!", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "You know her?", "name": "ODO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Thaddeus! The ice is thin!", "name": "WILHELMINA", "speaker": 2, "ext": ["O.S."], "paren": ["distant"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "I'm coming!", "name": "STRANGER", "speaker": 1, "ext": [], "paren": ["calling"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Thaddeus. Is that your name?", "name": "ODO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "It is.", "name": "THADDEUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Well, Thaddeus, you are about to be a dead one.", "name": "ODO", "speaker": 0, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Thaddeus picks up his satchel and steps onto the ice.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Odo grabs his coat.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Wait! At least take the pole!", "name": "ODO", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Thaddeus takes it.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "He tests the ice with the pole.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "It holds.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Another step.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Another.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "The lantern on the far bank swings in time with his footsteps.", "para": 5, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "If you see the river open, do not stop for love!", "name": "ODO", "speaker": 0, "ext": ["CONT'D"], "paren": ["shouting after him"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "I never have.", "name": "THADDEUS", "speaker": 3, "ext": [], "paren": ["over his shoulder"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Odo watches him shrink to a speck against the blue snow.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "The ice groans.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "A long crack races beneath the ferry.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "God keep you, you fool.", "name": "ODO", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3]}]}