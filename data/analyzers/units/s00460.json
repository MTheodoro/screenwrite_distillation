{"scene_id": "s00460", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00460.fountain", "heading": "INT. FOURTH-FLOOR LAUNDRY ROOM - APARTMENT BUILDING - NIGHT", "cast": [{"id": 0, "name": "ADAEZE OBI-LINDGREN", "names": ["ADAEZE OBI-LINDGREN", "ADAEZE"], "gender": "m", "first": 4, "spoke": 5}, {"id": 1, "name": "GRETCHEN VOSKUIJLEN", "names": ["GRETCHEN VOSKUIJLEN", "GRETCHEN"], "gender": "?", "first": 5, "spoke": 5}, {"id": 2, "name": "TEO", "names": ["TEO"], "gender": "?", "first": 23, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. FOURTH-FLOOR LAUNDRY ROOM - APARTMENT BUILDING - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Two washers, one broken.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A folding table with a wobbly leg.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Fluorescent hum.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ADAEZE OBI-LINDGREN (30s, scrubs, tired) folds towels.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her neighbor GRETCHEN VOSKUIJLEN (60s, curlers, quilted robe) watches the dryer spin.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "You work too much, dear.", "name": "GRETCHEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Somebody has to.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Mm.", "name": "GRETCHEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "She nods at the dryer.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Adaeze keeps folding.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "A towel.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Another towel.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "A baby's sleeper, tiny.", "para": 2, "sent": 4, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Is that new?", "name": "GRETCHEN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Hand-me-down.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "From your sister?", "name": "GRETCHEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "From a friend.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "The dryer buzzes.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Gretchen opens the door and fishes out warm sheets.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Adaeze takes one end.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "They fold together, corner to corner, without a word.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "The door opens.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "A tall boy of thirteen, TEO (13, hoodie, earbuds), pads in with a hamper.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Mom, you said eleven.", "name": "TEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "I know. One more load.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Hi, Mrs. Voskuijlen.", "name": "TEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Hello, Teo.", "name": "GRETCHEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "He sets the hamper down and sits cross-legged on the floor.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Adaeze hands him the baby's sleeper.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Fold that for me.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "He folds it.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Neat.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Careful.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "She watches.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Gretchen smiles at the dryer.", "para": 6, "sent": 4, "present": [0, 1, 2]}]}