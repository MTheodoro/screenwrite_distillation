{"scene_id": "s00461", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00461.fountain", "heading": "INT. ABANDONED RADIO OBSERVATORY - CONTROL ROOM - NIGHT", "cast": [{"id": 0, "name": "ILSA", "names": ["ILSA"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "BAYO", "names": ["BAYO"], "gender": "?", "first": 5, "spoke": 5}, {"id": 2, "name": "KESTER", "names": ["KESTER"], "gender": "?", "first": 6, "spoke": 4}, {"id": 3, "name": "PETRA", "names": ["PETRA"], "gender": "?", "first": 10, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED RADIO OBSERVATORY - CONTROL ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cathedral of dead dials.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Moonlight through a cracked dish window.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Four people stand around a console that has begun, impossibly, to hum.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "dialogue", "text": "I told you the power was cut.", "name": "ILSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 5, "kind": "dialogue", "text": "It was cut. I cut it myself.", "name": "BAYO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Then what's that?", "name": "KESTER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "A signal.", "name": "ILSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "From where?", "name": "BAYO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Does it matter?", "name": "KESTER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "It matters to me.", "name": "PETRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Petra, step back from the console.", "name": "ILSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "It's saying my name.", "name": "PETRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "It's static.", "name": "BAYO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "It's saying my name, Bayo.", "name": "PETRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Everybody, shut up and listen.", "name": "KESTER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Silence.", "para": 1, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "The hum deepens.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Beneath it, a thin, pulsing voice rises and falls like breathing.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Turn it off.", "name": "BAYO", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "There's no switch.", "name": "ILSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Pull the plug.", "name": "KESTER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "There is no plug. We cut the line!", "name": "BAYO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "It's been waiting forty years for someone to answer.", "name": "PETRA", "speaker": 3, "ext": [], "paren": ["calmly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Petra, don't.", "name": "ILSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Hello?", "name": "PETRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "The hum stops.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Every light in the room flares white.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}]}