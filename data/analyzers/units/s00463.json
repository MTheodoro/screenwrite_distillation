{"scene_id": "s00463", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00463.fountain", "heading": "INT. OPEN-PLAN OFFICE - \"SYNERGY POD\" - DAY", "cast": [{"id": 0, "name": "BARNABY CHOWDHURY-PELL", "names": ["BARNABY CHOWDHURY-PELL", "BARNABY"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "ODALYS FERREIRA", "names": ["ODALYS FERREIRA", "ODALYS"], "gender": "f", "first": 5, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. OPEN-PLAN OFFICE - \"SYNERGY POD\" - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A grey carpet-tiled field of identical desks under a ceiling of recessed fluorescent squares.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A motivational poster of a rowing team hangs crooked on a pillar.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Nothing in the room is on fire, which seems to be the best that can be said for it.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "BARNABY CHOWDHURY-PELL (40s, lanyard, forced cheer) stands at a whiteboard, marker raised.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "His direct report, ODALYS FERREIRA (30s, headphones around her neck), sits very still at the front of the room.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "He caps the marker.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He uncaps it.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He smiles at her.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Great news. Nobody's getting fired.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Okay.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": ["flat"], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He nods.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She nods.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He draws a circle on the whiteboard and does not explain it.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Instead, we're pivoting to a flat org chart.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Meaning?", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Meaning nobody has a manager.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He caps the marker once more and sets it down with great care.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She watches him do it.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Including you.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Especially me.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "He beams.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "She slowly removes her headphones, lays them on the desk, and stands.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "He does not stop smiling as she gathers her bag and walks out.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "The circle on the whiteboard stays unexplained.", "para": 5, "sent": 3, "present": [0, 1]}]}