: 6, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "For God's sake, stop the eleven-fifteen.", "name": "PERCY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "The eleven-fifteen isn't due until midnight.", "name": "ARCHIBALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "It left at nine.", "name": "PERCY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Archibald turns toward the board.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Florencia lunges for a lever.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "He grabs her wrist.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "They freeze.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Far away, a whistle shrieks.", "para": 7, "sent": 4, "present": [0, 1, 2]}]}