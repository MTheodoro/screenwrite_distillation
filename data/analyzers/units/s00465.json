{"scene_id": "s00465", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00465.fountain", "heading": "EXT. PACK-ICE FLOE - ARCTIC OCEAN - DAWN", "cast": [{"id": 0, "name": "CAPTAIN ISOLDE MARCHETTI-OKORO", "names": ["CAPTAIN ISOLDE MARCHETTI-OKORO", "ISOLDE"], "gender": "m", "first": 7, "spoke": 13}, {"id": 1, "name": "WILFRED ACHTERBERG", "names": ["WILFRED ACHTERBERG", "WILFRED"], "gender": "m", "first": 8, "spoke": 4}, {"id": 2, "name": "TEMI", "names": ["TEMI"], "gender": "m", "first": 9, "spoke": 5}, {"id": 3, "name": "BOLDBAATAR", "names": ["BOLDBAATAR"], "gender": "?", "first": 9, "spoke": 0}, {"id": 4, "name": "GWENLLIAN PRYCE-ADEYEMI", "names": ["GWENLLIAN PRYCE-ADEYEMI", "GWENLLIAN"], "gender": "f", "first": 10, "spoke": 4}, {"id": 5, "name": "CAS", "names": ["CAS"], "gender": "m", "first": 11, "spoke": 3}, {"id": 6, "name": "WOLFE", "names": ["WOLFE"], "gender": "?", "first": 11, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. PACK-ICE FLOE - ARCTIC OCEAN - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A vast white plain, riven with blue cracks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A sled lies overturned, its runners splintered.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Gray light bleeds into a pale horizon.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The wind has dropped, leaving an unnatural hush.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Four dogs lie curled in the lee of the wreck.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "Beside them, five survivors huddle around a small spirit stove, its flame hardly bigger than a thumbnail.", "para": 1, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "CAPTAIN ISOLDE MARCHETTI-OKORO (50s, frost-crusted beard of scarf, steady eyes) crouches closest to the flame.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "DR. WILFRED ACHTERBERG (60s, bruised cheek, wire spectacles) rubs a bandaged hand.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "The navigator, TEMUJIN \"TEMI\" BOLDBAATAR (30s, parka hood rimmed with fur), studies a brass compass.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "The cook, GWENLLIAN PRYCE-ADEYEMI (40s, wool cap pulled to her eyebrows), stirs a pot of gray broth.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "And the youngest, CASPIAN \"CAS\" WOLFE (teens, voice cracked, eyelashes iced), sits wrapped in two blankets and shivers.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "Rations.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "Three days if we stretch it, Captain.", "name": "GWENLLIAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "Stretch it.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "Isolde, the ice is moving.", "name": "WILFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "I know, Wilfred.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "Captain, the compass is spinning.", "name": "TEMI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "action", "text": "Isolde crosses to him and takes the compass.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "action", "text": "The needle swings in slow circles, never settling.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "Close to the pole?", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "Too close. Or too far.", "name": "TEMI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Does that mean we're lost?", "name": "CAS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "Hush, Cas. Drink your broth.", "name": "GWENLLIAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "She hands him a tin cup.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "action", "text": "He takes it in both mittens.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "Wilfred, the hand.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "It will mend.", "name": "WILFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "It will blacken.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "Then it will blacken.", "name": "WILFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "He tucks it inside his coat.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "Isolde regards him for a long moment, then turns away.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "Temi, pick a heading. Any heading. We cannot stay.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "East.", "name": "TEMI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "Why east?", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "Because the sun comes from there.", "name": "TEMI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "That's as good a reason as any.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": ["almost smiling"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "Cas lifts his head.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "His voice is small.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "Captain, will the dogs come?", "name": "CAS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "The dogs always come.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "dialogue", "text": "Not Bramble. Bramble's leg.", "name": "GWENLLIAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "dialogue", "text": "Then we carry Bramble.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "They all look at the old gray husky in the snow.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "Bramble thumps her tail once.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "Isolde, we can barely carry ourselves.", "name": "WILFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "dialogue", "text": "We will carry her anyway.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "A silence settles.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "The stove flickers.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "action", "text": "Temi folds the compass shut and tucks it into his sleeve.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "dialogue", "text": "East, then.", "name": "TEMI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "dialogue", "text": "East.", "name": "GWENLLIAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "dialogue", "text": "East.", "name": "CAS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "action", "text": "They begin to rise, one by one, creaking, stiff.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "action", "text": "Isolde kicks snow over the stove, and the flame dies.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "action", "text": "Wilfred lifts Bramble gently into his arms.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "action", "text": "Gwenllian shoulders the pack.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "action", "text": "Cas pulls his blankets tight.", "para": 9, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "action", "text": "Temi checks the sky.", "para": 9, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 59, "kind": "action", "text": "Isolde stands last, looking back at the broken sled.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 60, "kind": "action", "text": "She lays a gloved hand on the splintered runner, as if on the flank of an animal.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 61, "kind": "dialogue", "text": "Good work, old girl.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 62, "kind": "action", "text": "She turns and walks east, and the others fall in behind her, five dark figures dwindling on the endless white.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}]}