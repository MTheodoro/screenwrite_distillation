{"scene_id": "s00466", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00466.fountain", "heading": "INT. VICTORIAN CHEMIST SHOP - AFTER HOURS - NIGHT", "cast": [{"id": 0, "name": "EZEKIEL FAIRBROTHER", "names": ["EZEKIEL FAIRBROTHER", "EZEKIEL"], "gender": "m", "first": 5, "spoke": 8}, {"id": 1, "name": "NELLIE QUINTANILLA-GRAY", "names": ["NELLIE QUINTANILLA-GRAY", "NELLIE"], "gender": "?", "first": 6, "spoke": 4}, {"id": 2, "name": "AUGUSTUS HELLEBORE", "names": ["AUGUSTUS HELLEBORE", "AUGUSTUS"], "gender": "?", "first": 7, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. VICTORIAN CHEMIST SHOP - AFTER HOURS - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Rows of blue glass bottles gleam like sleeping eyes.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Mahogany drawers labeled in copperplate.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A brass scale, a mortar and pestle.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single gas lamp hisses above the counter.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MR. EZEKIEL FAIRBROTHER (60s, black apron, half-moon spectacles) stands behind the counter, wiping a pipette with a cloth.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "His apprentice, NELLIE QUINTANILLA-GRAY (teens, ink-stained cuffs, a braid pinned up), sweeps the floor too slowly.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "And by the door, shaking rain from his umbrella, stands DR. AUGUSTUS HELLEBORE (50s, silk hat, black bag).", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Fairbrother. A word.", "name": "AUGUSTUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Doctor. We are closed.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I am aware.", "name": "AUGUSTUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Then you will understand if I say good night.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "I want to know about the foxglove.", "name": "AUGUSTUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Nellie stops sweeping.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Ezekiel folds the cloth in thirds and lays it on the counter.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Foxglove is a common remedy.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "In the quantity you dispensed to Mrs. Pennywhistle?", "name": "AUGUSTUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I dispensed what was prescribed.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "By whom?", "name": "AUGUSTUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "By you.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I prescribed a pinch.", "name": "AUGUSTUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "You prescribed a teaspoon, Doctor. In your own hand.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "I did no such thing.", "name": "AUGUSTUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "I have the slip, sir.", "name": "NELLIE", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Both men turn.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Nellie reaches under the counter and draws out a folded paper.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Her hand is steady.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "She lays it flat.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "That is a forgery.", "name": "AUGUSTUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "It is your signature.", "name": "NELLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Child, you do not know what you are saying.", "name": "AUGUSTUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "I know my letters, sir. I learned them from Mr. Fairbrother.", "name": "NELLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Ezekiel nods, slowly.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Augustus's face changes, the polite mask slipping, and beneath it something older and colder looks out.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "His fingers close around the handle of his black bag.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Fairbrother, you will regret this.", "name": "AUGUSTUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Doctor, I have regretted many things. This is not one of them.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Augustus stares at the paper.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Then he snaps up his umbrella, turns, and strides out into the rain.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "The door slams.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "The bell above it jangles for a long time.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Nellie lets out a breath.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Ezekiel takes up his cloth again and resumes wiping the pipette.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "You were right to keep it.", "name": "EZEKIEL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "You taught me that, too.", "name": "NELLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}