{"scene_id": "s00467", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00467.fountain", "heading": "INT. FARMHOUSE KITCHEN - MORNING", "cast": [{"id": 0, "name": "GRANDMOTHER AGATHA TSVETKOVA-BELL", "names": ["GRANDMOTHER AGATHA TSVETKOVA-BELL", "AGATHA"], "gender": "?", "first": 5, "spoke": 4}, {"id": 1, "name": "DAMIEN OKAFOR-LINDSAY", "names": ["DAMIEN OKAFOR-LINDSAY", "DAMIEN"], "gender": "?", "first": 6, "spoke": 2}, {"id": 2, "name": "NOELLE", "names": ["NOELLE"], "gender": "f", "first": 7, "spoke": 3}, {"id": 3, "name": "BOY", "names": ["BOY"], "gender": "m", "first": 8, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. FARMHOUSE KITCHEN - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "A long scrubbed-pine table.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sunlight through gingham curtains.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cast-iron stove ticks as it warms.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Four people, four chairs, one pot of oatmeal between them.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "GRANDMOTHER AGATHA TSVETKOVA-BELL (70s, apron, silver bun) ladles porridge.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "At her left sits her son-in-law DAMIEN OKAFOR-LINDSAY (40s, work shirt, reading the paper).", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Across from him, his wife NOELLE (40s, hair still wet from the shower) butters toast.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "And at the end, in a chair too big for him, sits a quiet BOY (8, striped pajamas) who has not touched his bowl.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Eat, child.", "name": "AGATHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Not hungry.", "name": "BOY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Just a little.", "name": "NOELLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Not hungry.", "name": "BOY", "speaker": 3, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "The two voices overlap, hers soft and his small.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Damien lowers the paper.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Let him be.", "name": "DAMIEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "He was up all night. I heard him on the stairs.", "name": "AGATHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Was he sleepwalking?", "name": "NOELLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "He was talking.", "name": "AGATHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Damien turns a page.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Noelle sets the knife down.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "The Boy stirs his oatmeal with one finger.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Who were you talking to, sweetheart?", "name": "NOELLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "The man.", "name": "BOY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "What man?", "name": "DAMIEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "The one at the end of the hall. He said you'd be angry.", "name": "BOY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Agatha's ladle stops in the air.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Damien sets the paper on the table.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Noelle looks at the stove, and then at her mother.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Eat your breakfast.", "name": "AGATHA", "speaker": 0, "ext": [], "paren": ["to the table"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "She resumes ladling, and nobody speaks again.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}]}