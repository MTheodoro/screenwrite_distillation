 1]}, {"u": 10, "kind": "action", "text": "ARJUN (17, rental skis between his knees) checks his phone.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "No bars.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "He checks it again.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "MIREILLE (40s, immaculate parka, one glove missing) tucks her bare hand into her armpit and says nothing about it.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "BRAM (50s, broad, red-faced) holds his square of chocolate without eating it.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "PIP (8) licks hers slowly, making it last.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Wind drops by morning. They send the snowcat.", "name": "TEODOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Good.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "BRAM passes his chocolate to Pip.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Pip looks at Oksana.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Oksana nods once.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Pip takes it.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "MIREILLE slides her glove off the other hand and gives it to Arjun without looking at him.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "He puts it on.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "The car sways.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Nobody mentions it.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}