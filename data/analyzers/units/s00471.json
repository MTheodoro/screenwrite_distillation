{"scene_id": "s00471", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00471.fountain", "heading": "INT. MUNICIPAL SWIMMING POOL - DRAINED - DAY", "cast": [{"id": 0, "name": "HOLLIS BRANDVOLD", "names": ["HOLLIS BRANDVOLD", "HOLLIS"], "gender": "?", "first": 5, "spoke": 6}, {"id": 1, "name": "NADIA BRANDVOLD", "names": ["NADIA BRANDVOLD", "NADIA"], "gender": "?", "first": 5, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. MUNICIPAL SWIMMING POOL - DRAINED - DAY", "present": []}, {"u": 1, "kind": "action", "text": "An Olympic-length basin, empty to the tiles.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Lane lines still hang from their reels, slack as old rope.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A faded blue fish is painted at the deep end.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Pigeons walk the gutter.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "HOLLIS BRANDVOLD (60s, lanky, a lifeguard whistle still on a cord around his neck) stands on the pool floor with a push broom.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "He sweeps nothing in particular.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "NADIA BRANDVOLD (30s, his daughter, city-council lanyard, work shoes ill-suited to wet tile) climbs down the steel ladder one rung at a time.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "At the bottom she stops and looks up at the ceiling lights.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He keeps sweeping.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She walks toward him.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Careful by the drain. It's slick.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "It's been closed since March.", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Still slick.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She reaches him.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "He doesn't stop.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She takes hold of the broom handle.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He lets her.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "For a moment they both hold it, neither moving.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "They vote Thursday.", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "I heard.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "I'm going to vote yes.", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "He nods at the painted fish.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "His thumb rubs the whistle.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Your mother used to swim here at six a.m. Every day. Forty laps.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I know.", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "She hated the cold water. She did it anyway.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Dad.", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "He takes the broom back.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "She lets go.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "He sets it against the wall and they both look at the deep end, where the tile is cracked in a long, clean line.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Fill it with dirt. Plant something.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "That's the plan.", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "He nods.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "She stands beside him.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Neither leaves.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "A pigeon lifts out of the gutter and crosses the empty basin, and both of them follow it with their eyes until it clears the rim.", "para": 7, "sent": 3, "present": [0, 1]}]}