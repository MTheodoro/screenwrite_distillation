{"scene_id": "s00474", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00474.fountain", "heading": "INT. BOWLING ALLEY - PARTY ROOM - DAY", "cast": [{"id": 0, "name": "GUS PRICE", "names": ["GUS", "GUS PRICE"], "gender": "m", "first": 3, "spoke": 1}, {"id": 1, "name": "YOLANDA PRICE", "names": ["YOLANDA PRICE", "YOLANDA"], "gender": "?", "first": 4, "spoke": 2}, {"id": 2, "name": "KENJI PRICE", "names": ["KENJI PRICE"], "gender": "?", "first": 4, "spoke": 0}, {"id": 3, "name": "DOROTHEA PRICE", "names": ["DOROTHEA PRICE", "DOROTHEA"], "gender": "?", "first": 4, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. BOWLING ALLEY - PARTY ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Streamers, a sheet cake, paper plates.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Lane 9 thunders next door.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A banner reads HAPPY 80TH, GUS.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "YOLANDA PRICE (50s) cuts the cake into squares too small for anyone.", "para": 1, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 5, "kind": "action", "text": "GUS PRICE (80, her father, party hat crooked) watches the knife.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "action", "text": "KENJI PRICE (20s, her son) sits at the end of the table scrolling through his phone.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "DOROTHEA PRICE (50s, Yolanda's sister, fresh off a flight) drops her coat across a chair and stays standing.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Nobody told me it was today.", "name": "DOROTHEA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "I texted you.", "name": "YOLANDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "You texted me Tuesday.", "name": "DOROTHEA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Yolanda sets a plate in front of Gus.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Dorothea moves it six inches to the left.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Yolanda moves it back.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "They both let go at the same time.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "I like the corner piece.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Kenji looks up.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Yolanda and Dorothea lunge for the cake knife at once.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "They stop, hands on the handle, faces close.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "I'll do it.", "name": "YOLANDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "You've done everything. Clearly.", "name": "DOROTHEA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "She yanks the knife.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Frosting smears across the tablecloth.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Kenji stands.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Gus lifts his hat off his head and sets it on the table, very gently, like a man laying down a hand of cards.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Through the wall, Lane 9 roars.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Nobody at the table flinches.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}]}