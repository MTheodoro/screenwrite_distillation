{"scene_id": "s00477", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00477.fountain", "heading": "INT. MATTRESS SHOWROOM - NIGHT", "cast": [{"id": 0, "name": "MAN", "names": ["MAN"], "gender": "?", "first": 5, "spoke": 8}, {"id": 1, "name": "GUARD DESHAWN", "names": ["GUARD DESHAWN"], "gender": "?", "first": 6, "spoke": 20}, {"id": 2, "name": "GILBERT", "names": ["GILBERT"], "gender": "m", "first": 25, "spoke": 13}], "units": [{"u": 0, "kind": "heading", "text": "INT. MATTRESS SHOWROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Ninety beds in perfect rows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A neon sign: SLEEP KINGDOM.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain on the roll-up door.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "One security light, buzzing.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A MAN in a bathrobe (50s, slippers, a thermos of soup) sits on the edge of a king-size display, staring at the ceiling.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "GUARD DESHAWN (30s, polyester uniform, flashlight) enters from the back office.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Stops.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Raises the flashlight.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Sir.", "name": "GUARD DESHAWN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "The man waves without looking.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Evening.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Sir. We are closed.", "name": "GUARD DESHAWN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "I know.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "How did you get in?", "name": "GUARD DESHAWN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Ordered a delivery. Left the door ajar. Your driver was very nice.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "You can't be here.", "name": "GUARD DESHAWN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "I haven't slept in six weeks. Do you know what that does to a person?", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "No.", "name": "GUARD DESHAWN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "It does something. Not good. I keep seeing a man in the corner of the room. Turns out it's a coat rack. But the point stands.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Sir. I will have to call someone.", "name": "GUARD DESHAWN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Call whoever you like. Let me just try this one for ten minutes.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "It's a three-thousand-dollar mattress.", "name": "GUARD DESHAWN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Hence the ten minutes.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "I'm going to need your name.", "name": "GUARD DESHAWN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Gilbert.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Gilbert what?", "name": "GUARD DESHAWN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Gilbert Ferreira-Whitlock. Hyphenated, a long story, involves a cousin.", "name": "GILBERT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Mr. Whitlock.", "name": "GUARD DESHAWN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Ferreira-Whitlock. The hyphen is the whole point.", "name": "GILBERT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Gilbert. My shift ends at six.", "name": "GUARD DESHAWN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Then we have six hours.", "name": "GILBERT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "You don't have six hours. You have until I call my manager.", "name": "GUARD DESHAWN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Your manager is Brenda. Brenda told me, and I quote, \"he's a sweetheart, let him sleep.\"", "name": "GILBERT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "When?", "name": "GUARD DESHAWN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Tuesday. At the open house. I do not remember it clearly but I trust Brenda.", "name": "GILBERT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "There is no open house on Tuesday.", "name": "GUARD DESHAWN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Then it was a dream. A very restful dream.", "name": "GILBERT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Gilbert, please.", "name": "GUARD DESHAWN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Deshawn. May I call you Deshawn? It says Deshawn on the tag.", "name": "GILBERT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "It says GUARD DESHAWN on the tag.", "name": "GUARD DESHAWN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "That's what I said.", "name": "GILBERT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "You said Deshawn.", "name": "GUARD DESHAWN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "It's a lovely name.", "name": "GILBERT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Deshawn sits on the next bed over.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Springs sigh.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "He puts the flashlight on his knee.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "My mother had a bed like this.", "name": "GUARD DESHAWN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Did she sleep well?", "name": "GILBERT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "She did.", "name": "GUARD DESHAWN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "There. You see.", "name": "GILBERT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Gilbert lies down in his robe, hands folded on his chest.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "He closes his eyes.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Don't leave. I might wake up.", "name": "GILBERT", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "Ten minutes.", "name": "GUARD DESHAWN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "Ten minutes.", "name": "GILBERT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Deshawn lies back.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "The neon buzzes.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "The rain keeps on.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Two snores, nearly in unison.", "para": 7, "sent": 0, "present": [0, 1, 2]}]}