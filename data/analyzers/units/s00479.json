{"scene_id": "s00479", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00479.fountain", "heading": "INT. ICE-FISHING HUT - NIGHT", "cast": [{"id": 0, "name": "ELSPETH CRANE", "names": ["ELSPETH CRANE", "ELSPETH"], "gender": "f", "first": 5, "spoke": 6}, {"id": 1, "name": "LENNART BOYD", "names": ["LENNART BOYD", "LENNART"], "gender": "m", "first": 7, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. ICE-FISHING HUT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A plywood box on a frozen lake.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "One lantern.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Two stools around a hole cut in the ice, black water glinting.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Lines run down into it, motionless.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ELSPETH CRANE (60s, wool cap, thermos) sits with her rod across her knees.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She hasn't touched her tea.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "LENNART BOYD (30s, her nephew, borrowed parka) holds his rod with both hands, jaw tight.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "The ice groans somewhere out in the dark.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "A long, falling note.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "That's normal.", "name": "LENNART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Mm.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Lennart reels in an inch.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "You said nothing bites after midnight.", "name": "LENNART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I said nothing should.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She pours tea into the lid and sets it by his boot.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He doesn't pick it up.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Down in the hole, the black water is perfectly still.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Then a ring spreads outward from its center.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Small, round, deliberate.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Neither of them looks at it.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Aunt Elspeth.", "name": "LENNART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Hush.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Lennart's line begins to run.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "The reel clicks.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Faster.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "He grips it harder; his knuckles whiten.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Elspeth rests one hand on his wrist.", "para": 8, "sent": 4, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Let it go.", "name": "ELSPETH", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "It's a good one.", "name": "LENNART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Let it go.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "He lets go.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "The rod slides across the ice and down the hole without a splash.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "The line sings out, then stops.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "The water goes still again.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Elspeth screws the cap on her thermos.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "She stands and gathers the stools.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Lennart stays seated, looking at the hole, his hands open in his lap.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Come on.", "name": "ELSPETH", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "He rises, slowly.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "She turns the lantern down.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "In the last light, the water in the hole is already skinning over with fresh ice.", "para": 11, "sent": 2, "present": [0, 1]}]}