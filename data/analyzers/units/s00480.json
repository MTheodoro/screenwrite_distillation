{"scene_id": "s00480", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00480.fountain", "heading": "INT. HIGH SCHOOL GYMNASIUM - WRESTLING WEIGH-IN - MORNING", "cast": [{"id": 0, "name": "COACH ANTONIA BELLWETHER", "names": ["COACH ANTONIA BELLWETHER", "BELLWETHER"], "gender": "m", "first": 4, "spoke": 18}, {"id": 1, "name": "DEX", "names": ["DEX"], "gender": "?", "first": 7, "spoke": 6}, {"id": 2, "name": "MAHLER", "names": ["MAHLER"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "ZAVALA", "names": ["ZAVALA"], "gender": "?", "first": 9, "spoke": 0}, {"id": 4, "name": "ASSISTANT", "names": ["ASSISTANT"], "gender": "?", "first": 10, "spoke": 0}, {"id": 5, "name": "PRIYA MENON", "names": ["PRIYA MENON", "PRIYA"], "gender": "?", "first": 10, "spoke": 6}, {"id": 6, "name": "RAM\u00d3N", "names": ["RAM\u00d3N"], "gender": "?", "first": 9, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. HIGH SCHOOL GYMNASIUM - WRESTLING WEIGH-IN - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Folding tables, a digital scale on a plywood riser, a banner for the Regional Qualifier.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Bleachers half pulled out.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The smell of floor wax and cut-up oranges.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "COACH ANTONIA BELLWETHER (50s, track jacket, stopwatch on a lanyard) stands beside the scale with a clipboard.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Calm.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Her whistle hangs unused.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "DEXTER \"DEX\" MAHLER (17, 132 pounds on a good day, hoodie soaked through) waits in line in his socks.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "He's been running in trash bags since five a.m.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "OFFICIAL RAM\u00d3N ZAVALA (60s, striped shirt, reading glasses low) hunches over the scale display.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 6]}, {"u": 10, "kind": "action", "text": "Behind him, a young ASSISTANT, PRIYA MENON (20s, volunteer lanyard), writes weights in a ledger.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "Next.", "name": "RAM\u00d3N", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "action", "text": "Dex steps up.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "action", "text": "The scale hums.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "action", "text": "The digital readout flickers.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "One thirty-one point six.", "name": "RAM\u00d3N", "speaker": 6, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "Pass.", "name": "PRIYA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "action", "text": "Coach Bellwether nods.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "action", "text": "She doesn't smile.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "action", "text": "She writes a tick mark.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "Thanks.", "name": "DEX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "action", "text": "He steps down.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "action", "text": "His legs are slightly wobbly.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "Bellwether hands him a banana without looking.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "Eat that slow. Drink the water slow. You wrestle at two.", "name": "BELLWETHER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "Yes, Coach.", "name": "DEX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "Sit.", "name": "BELLWETHER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "He sits on the bottom bleacher.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "Peels the banana.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "Eats a quarter of it.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "Closes his eyes.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "Priya turns a page.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "action", "text": "Ram\u00f3n wipes the scale platform with a towel.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "Bellwether crosses to the table and pours coffee into a paper cup.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "He looks good.", "name": "PRIYA", "speaker": 5, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "He looks like a kid who hasn't had a meal in four days.", "name": "BELLWETHER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "He made weight.", "name": "PRIYA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "He did.", "name": "BELLWETHER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "She sips.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "She watches Dex across the gym, and for a long moment she is very still.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "Ram\u00f3n. Can I see the scale certification?", "name": "BELLWETHER", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "dialogue", "text": "It's on the wall.", "name": "RAM\u00d3N", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "dialogue", "text": "I'd like to see it. Please.", "name": "BELLWETHER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "Ram\u00f3n looks at her over his glasses.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "He takes a laminated card from a clip on the table and hands it over.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "action", "text": "Bellwether reads it.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "action", "text": "Reads the date.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "Her thumb pauses on the line.", "para": 10, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "dialogue", "text": "Expired in August.", "name": "BELLWETHER", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "dialogue", "text": "That's a typo.", "name": "RAM\u00d3N", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "dialogue", "text": "Is it.", "name": "BELLWETHER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "dialogue", "text": "Coach, I think the district renewed it. I can check.", "name": "PRIYA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "dialogue", "text": "Do.", "name": "BELLWETHER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "action", "text": "Priya hurries out.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "action", "text": "The gym is very quiet.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "action", "text": "In the bleachers, Dex has opened his eyes.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "action", "text": "He watches the coach.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "dialogue", "text": "Coach?", "name": "DEX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "dialogue", "text": "Eat your banana.", "name": "BELLWETHER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 59, "kind": "dialogue", "text": "What's wrong?", "name": "DEX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 60, "kind": "dialogue", "text": "Eat.", "name": "BELLWETHER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 61, "kind": "action", "text": "She walks to the scale and steps onto the platform in her shoes.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 62, "kind": "action", "text": "The readout flashes: 148.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 63, "kind": "action", "text": "She steps off.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 64, "kind": "action", "text": "Takes a gym bag from beneath the table.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 65, "kind": "action", "text": "Sets it on the platform.", "para": 12, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 66, "kind": "action", "text": "Zero.", "para": 12, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 67, "kind": "action", "text": "She sets a ten-pound weight from her pocket on top.", "para": 12, "sent": 6, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 68, "kind": "action", "text": "The scale reads 3.", "para": 12, "sent": 7, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 69, "kind": "action", "text": "Ram\u00f3n's face does not change.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 70, "kind": "dialogue", "text": "Three.", "name": "BELLWETHER", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 71, "kind": "dialogue", "text": "It drifts.", "name": "RAM\u00d3N", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 72, "kind": "dialogue", "text": "It drifts by seven pounds. In whose favor, Ram\u00f3n?", "name": "BELLWETHER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 73, "kind": "dialogue", "text": "Coach, I'm just the official.", "name": "RAM\u00d3N", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 74, "kind": "dialogue", "text": "You are the official who has been rejecting my kids since September.", "name": "BELLWETHER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 75, "kind": "action", "text": "Dex stands, the banana forgotten in his fist.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 76, "kind": "dialogue", "text": "So I didn't make weight?", "name": "DEX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 77, "kind": "dialogue", "text": "You made weight. You made it four times over. Your actual weight is a hundred and thirty-eight.", "name": "BELLWETHER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 78, "kind": "dialogue", "text": "That's...", "name": "DEX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 79, "kind": "dialogue", "text": "Over. Over by six. You've been under-reported all season on this scale and over-reported on that one.", "name": "BELLWETHER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 80, "kind": "action", "text": "She takes the clipboard and tucks it under her arm.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 81, "kind": "dialogue", "text": "Priya is going to come back with a form. And you will not sign anything, Ram\u00f3n, until a state official arrives.", "name": "BELLWETHER", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 82, "kind": "action", "text": "Priya re-enters at the door.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 83, "kind": "action", "text": "She stops.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 84, "kind": "action", "text": "She sees the three of them frozen in the long light from the high windows.", "para": 16, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 85, "kind": "dialogue", "text": "It was renewed.", "name": "PRIYA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 86, "kind": "dialogue", "text": "I know.", "name": "BELLWETHER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 87, "kind": "dialogue", "text": "Coach, the district never renewed it. I called. The man said you'd been asking since August.", "name": "PRIYA", "speaker": 5, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 88, "kind": "action", "text": "Ram\u00f3n sits down on the riser.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 89, "kind": "action", "text": "The scale behind him gives a soft electronic chime, as if politely clearing its throat.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}]}