{"scene_id": "s00481", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00481.fountain", "heading": "INT. AMBULANCE - PARADE ROUTE - DAY", "cast": [{"id": 0, "name": "PARAMEDIC LUCIANA ORTEGA", "names": ["PARAMEDIC LUCIANA ORTEGA", "LUCIANA"], "gender": "f", "first": 5, "spoke": 6}, {"id": 1, "name": "MAN", "names": ["MAN"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "FITZ", "names": ["FITZ"], "gender": "f", "first": 7, "spoke": 4}, {"id": 3, "name": "BOYLE", "names": ["BOYLE"], "gender": "?", "first": 7, "spoke": 0}, {"id": 4, "name": "INTERN SUNITA RAO", "names": ["INTERN SUNITA RAO", "SUNITA"], "gender": "?", "first": 8, "spoke": 5}, {"id": 5, "name": "DRIVER MOSES BELL", "names": ["DRIVER MOSES BELL", "MOSES"], "gender": "?", "first": 9, "spoke": 2}, {"id": 6, "name": "DELACROIX-NGUYEN", "names": ["DELACROIX-NGUYEN", "MRS. DELACROIX-NGUYEN"], "gender": "f", "first": 10, "spoke": 1}, {"id": 7, "name": "SON", "names": ["SON"], "gender": "?", "first": 11, "spoke": 0}, {"id": 8, "name": "JOON-HO KANG", "names": ["JOON-HO KANG", "JOON-HO"], "gender": "?", "first": 11, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. AMBULANCE - PARADE ROUTE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Siren off.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Confetti on the windshield.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A marching band thumps outside.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The rig is parked in a crowd.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "PARAMEDIC LUCIANA ORTEGA (30s, ponytail) kneels over a MAN on the gurney.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "He is gray, gasping.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "PARAMEDIC FITZGERALD \"FITZ\" BOYLE (50s, mustache) shoves an oxygen mask over his face.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "INTERN SUNITA RAO (20s, first week) clutches the monitor.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "DRIVER MOSES BELL (40s, hi-vis vest) leans in from the front seat.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "A bystander, MRS. DELACROIX-NGUYEN (70s, parade sash), clambers in uninvited.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "action", "text": "A SON, JOON-HO KANG (20s, shaking), hovers at the rear doors.", "para": 1, "sent": 6, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 12, "kind": "dialogue", "text": "Fitz, line, now.", "name": "LUCIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 13, "kind": "dialogue", "text": "Doing it, Lu.", "name": "FITZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 14, "kind": "dialogue", "text": "Pressure's ninety over fifty!", "name": "SUNITA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 15, "kind": "dialogue", "text": "Do I roll?", "name": "MOSES", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 16, "kind": "dialogue", "text": "He's my neighbor! He sings in the choir!", "name": "MRS. DELACROIX-NGUYEN", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 17, "kind": "dialogue", "text": "Ma'am, out.", "name": "LUCIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 18, "kind": "dialogue", "text": "Dad! Dad, look at me!", "name": "JOON-HO", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 19, "kind": "dialogue", "text": "Joon-ho, back up, give her room.", "name": "FITZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 20, "kind": "dialogue", "text": "Eighty over forty!", "name": "SUNITA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 21, "kind": "dialogue", "text": "Push epi. Sunita, you push it.", "name": "LUCIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 22, "kind": "dialogue", "text": "Me?", "name": "SUNITA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 23, "kind": "dialogue", "text": "You.", "name": "LUCIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 24, "kind": "action", "text": "Sunita takes the syringe.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 25, "kind": "action", "text": "Her hand trembles.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 26, "kind": "action", "text": "Fitz steadies her wrist.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 27, "kind": "dialogue", "text": "Easy, kid. Slow.", "name": "FITZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 28, "kind": "action", "text": "She pushes.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 29, "kind": "action", "text": "Everyone holds still.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 30, "kind": "action", "text": "The band outside blares a brass chord.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 31, "kind": "action", "text": "The monitor beeps.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 32, "kind": "action", "text": "Beeps again.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 33, "kind": "action", "text": "Settles into a rhythm.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 34, "kind": "dialogue", "text": "Ninety-five over sixty.", "name": "SUNITA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 35, "kind": "dialogue", "text": "Moses is rolling.", "name": "MOSES", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 36, "kind": "action", "text": "Luciana sits back on her heels and exhales.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 37, "kind": "action", "text": "Mrs. Delacroix-Nguyen crosses herself.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 38, "kind": "action", "text": "Joon-ho grips the rail.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 39, "kind": "dialogue", "text": "Is he okay?", "name": "JOON-HO", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 40, "kind": "dialogue", "text": "He's coming back, Joon-ho. You did good.", "name": "LUCIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 41, "kind": "dialogue", "text": "Sunita did good.", "name": "FITZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 42, "kind": "dialogue", "text": "I did good?", "name": "SUNITA", "speaker": 4, "ext": [], "paren": ["shaking, grinning"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 43, "kind": "dialogue", "text": "You did good, rookie.", "name": "LUCIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 44, "kind": "action", "text": "Moses pulls out.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 45, "kind": "action", "text": "The crowd parts.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 46, "kind": "action", "text": "A tuba player salutes.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}]}