{"scene_id": "s00483", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00483.fountain", "heading": "INT. PLANETARIUM - DOME CHAMBER - NIGHT", "cast": [{"id": 0, "name": "FIGURE ONE", "names": ["FIGURE", "FIGURE ONE", "FIGURE TWO"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "TEO", "names": ["TEO"], "gender": "?", "first": 21, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. PLANETARIUM - DOME CHAMBER - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Concrete ring under a hemispherical ceiling.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Tilted seats.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A star projector crouches in the center like a black insect.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A FIGURE in coveralls, faceless behind a balaclava, clips a harness to the projector's rail.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Quick, practiced.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "A radio crackles at his hip.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "A second FIGURE (a woman, short, headlamp off) climbs the access ladder with a canvas bag.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "dialogue", "text": "Eleven minutes.", "name": "FIGURE ONE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 9, "kind": "dialogue", "text": "Ten.", "name": "FIGURE TWO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 10, "kind": "action", "text": "She unzips the bag.", "para": 3, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "Inside, a glass cylinder wrapped in foam: the meteorite on loan from Geneva.", "para": 3, "sent": 1, "present": [0]}, {"u": 12, "kind": "action", "text": "Footsteps in the corridor outside.", "para": 4, "sent": 0, "present": [0]}, {"u": 13, "kind": "action", "text": "A key ring jingles.", "para": 4, "sent": 1, "present": [0]}, {"u": 14, "kind": "action", "text": "Both freeze.", "para": 4, "sent": 2, "present": [0]}, {"u": 15, "kind": "action", "text": "Her hand lands on his sleeve.", "para": 4, "sent": 3, "present": [0]}, {"u": 16, "kind": "action", "text": "Neither moves.", "para": 5, "sent": 0, "present": [0]}, {"u": 17, "kind": "action", "text": "His breathing slows.", "para": 5, "sent": 1, "present": [0]}, {"u": 18, "kind": "action", "text": "Her thumb presses his wrist, once, twice.", "para": 5, "sent": 2, "present": [0]}, {"u": 19, "kind": "action", "text": "The footsteps recede.", "para": 6, "sent": 0, "present": [0]}, {"u": 20, "kind": "action", "text": "They exhale together.", "para": 6, "sent": 1, "present": [0]}, {"u": 21, "kind": "dialogue", "text": "Name's Teo. Since we're doing this.", "name": "FIGURE ONE", "speaker": 0, "ext": [], "paren": ["pulling off the balaclava"], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Marisol.", "name": "FIGURE TWO", "speaker": 0, "ext": [], "paren": ["pulling off hers"], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Don't tell me the rest.", "name": "TEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She wraps the cylinder.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "He doesn't look at it.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "He looks at the dome, where a single painted star glows, forgotten by the maintenance crew.", "para": 7, "sent": 2, "present": [0, 1]}]}