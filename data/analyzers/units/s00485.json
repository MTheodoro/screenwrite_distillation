{"scene_id": "s00485", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00485.fountain", "heading": "INT. ROLLER DERBY ARENA - HOME LOCKER ROOM - NIGHT", "cast": [{"id": 0, "name": "ROSIE RIOT", "names": ["ROSIE RIOT", "ROSIE"], "gender": "f", "first": 5, "spoke": 5}, {"id": 1, "name": "DUARTE", "names": ["DUARTE"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "JUNE", "names": ["JUNE"], "gender": "?", "first": 6, "spoke": 1}, {"id": 3, "name": "ABARA", "names": ["ABARA"], "gender": "?", "first": 6, "spoke": 0}, {"id": 4, "name": "ZEKE", "names": ["ZEKE"], "gender": "m", "first": 7, "spoke": 6}, {"id": 5, "name": "WARDELL", "names": ["WARDELL"], "gender": "?", "first": 7, "spoke": 0}, {"id": 6, "name": "BIX", "names": ["BIX"], "gender": "?", "first": 8, "spoke": 3}, {"id": 7, "name": "HOLLANDER-SINGH", "names": ["HOLLANDER-SINGH"], "gender": "?", "first": 8, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROLLER DERBY ARENA - HOME LOCKER ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cinderblock walls painted purple.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Metal lockers, dented.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Skates in a heap, laces knotted.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A boombox plays muffled brass from the rink upstairs.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CAPTAIN ROSALIE \"ROSIE RIOT\" DUARTE (30s, shoulders like a door, fishnet sleeves) paces the room with her helmet under one arm.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "JUNE \"JUNEBUG\" ABARA (20s, jammer, a half-eaten banana in her fist) sits cross-legged on a bench.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "COACH EZEKIEL \"ZEKE\" WARDELL (60s, cardigan, bad knee) props himself against a locker and consults a clipboard.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "action", "text": "BEATRIX \"BIX\" HOLLANDER-SINGH (40s, the team's blocker, mouthguard hung on her neck) kneels to lace a skate, while Rosie stops, looks at Junebug, looks at Zeke, and starts pacing again, and June takes a bite of banana and offers Bix the other half, which Bix waves off without lifting her eyes from her laces.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 9, "kind": "dialogue", "text": "They're quick but they're not smart. First jam, don't engage.", "name": "ZEKE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 10, "kind": "dialogue", "text": "We don't engage?", "name": "ROSIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 11, "kind": "dialogue", "text": "You hold the line. June skates.", "name": "ZEKE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 12, "kind": "dialogue", "text": "I skate.", "name": "JUNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 13, "kind": "dialogue", "text": "Hold the line.", "name": "ROSIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 14, "kind": "dialogue", "text": "Hold the line.", "name": "BIX", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 15, "kind": "dialogue", "text": "Hold the line.", "name": "ROSIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 16, "kind": "dialogue", "text": "Hold the line.", "name": "BIX", "speaker": 6, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 17, "kind": "action", "text": "They laugh.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 18, "kind": "action", "text": "Zeke does not.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 19, "kind": "dialogue", "text": "Rosie. A word.", "name": "ZEKE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 20, "kind": "action", "text": "She crosses to him.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 21, "kind": "action", "text": "They step into the corridor.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 22, "kind": "action", "text": "A pipe drips.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 23, "kind": "action", "text": "He does not look at her for a while, then he takes his glasses off and rubs the bridge of his nose.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 24, "kind": "dialogue", "text": "My knee's done after tonight.", "name": "ZEKE", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 25, "kind": "dialogue", "text": "I know.", "name": "ROSIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 26, "kind": "dialogue", "text": "You're getting the whistle next season.", "name": "ZEKE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 27, "kind": "action", "text": "She stands very straight.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 28, "kind": "action", "text": "Her gloved hand finds the doorframe.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 29, "kind": "dialogue", "text": "Win first.", "name": "ROSIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "dialogue", "text": "Win first.", "name": "ZEKE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "action", "text": "Down the hall, the brass band reaches its finale.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "action", "text": "Bix calls from inside.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "dialogue", "text": "Captain! They're announcing us!", "name": "BIX", "speaker": 6, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "action", "text": "Rosie squares her shoulders.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "action", "text": "Zeke tucks the clipboard under his arm.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "action", "text": "Together they go in.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}