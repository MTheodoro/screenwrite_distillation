{"scene_id": "s00486", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00486.fountain", "heading": "INT. ROOFTOP RADIO SHACK - NIGHT", "cast": [{"id": 0, "name": "TEDDY", "names": ["TEDDY"], "gender": "?", "first": 5, "spoke": 7}, {"id": 1, "name": "LINDGREN", "names": ["LINDGREN"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "VOICE", "names": ["VOICE"], "gender": "?", "first": 12, "spoke": 4}, {"id": 3, "name": "GUNNAR", "names": ["GUNNAR"], "gender": "?", "first": 20, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROOFTOP RADIO SHACK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A tarpaper hut on a flat roof above a laundromat.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Antenna wire runs out the window like a clothesline.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A ham-radio rig glows green.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A desk lamp, a scatter of QSL cards, a cracked globe.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "THEODORA \"TEDDY\" LINDGREN (16, braids, headphones around her neck) leans over the microphone, one foot tucked under her.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "She's been here for hours.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "She presses the key.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "CQ, CQ. This is Whiskey Two Tango Lima. Anyone out there?", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Static rolls.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She turns the dial.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "A faint voice surfaces.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Whiskey Two Tango Lima, this is Kilo Nine Echo. I read you, three by three.", "name": "VOICE", "speaker": 2, "ext": ["V.O."], "paren": ["over radio, crackly"], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Teddy grins.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "She grabs the mic.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Kilo Nine Echo! Where are you?", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Outside Reykjavik. Fishing boat. You're my first contact this month.", "name": "VOICE", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Seriously? I'm on a roof in Newark.", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Newark. Lovely. What's your name, Newark?", "name": "VOICE", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Teddy.", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Teddy. I'm Gunnar.", "name": "VOICE", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Her smile grows.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Then, from below, a door slams.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Footsteps on the stairwell.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "A heavy knock on the roof hatch, twice.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "She freezes, mic in hand.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "The green light flickers on her face.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Gunnar, I gotta go. My dad's home.", "name": "TEDDY", "speaker": 0, "ext": [], "paren": ["whispering into the mic"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Come back tomorrow?", "name": "GUNNAR", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Maybe.", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Another knock, louder.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "She switches the rig off.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "The glow dies.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "She sits in the dark, hand on the dial, listening to the quiet.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Then, softly, she clicks the lamp back on and taps out three beeps on the key.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Dit dit dit.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Dah dah dah.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Dit dit dit.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "See you tomorrow, Gunnar.", "name": "TEDDY", "speaker": 0, "ext": ["CONT'D"], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "She grabs her headphones and heads for the door.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}]}