{"scene_id": "s00487", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00487.fountain", "heading": "INT. BOOKMOBILE - PARKED AT LAKE OVERLOOK - DUSK", "cast": [{"id": 0, "name": "MAEVE O'DONNELL-KAUR", "names": ["MAEVE O'DONNELL-KAUR", "MAEVE"], "gender": "?", "first": 5, "spoke": 8}, {"id": 1, "name": "SULLY", "names": ["SULLY"], "gender": "?", "first": 9, "spoke": 10}, {"id": 2, "name": "ADEBAYO", "names": ["ADEBAYO"], "gender": "?", "first": 11, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. BOOKMOBILE - PARKED AT LAKE OVERLOOK - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "A converted school bus lined floor to ceiling with paperbacks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fairy lights strung along the roof.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A foldout desk by the driver's seat.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Through the windshield: a lake the color of brass.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MAEVE O'DONNELL-KAUR (30s, librarian, cardigan with a pen in the pocket) stamps a stack of returns.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Fast.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Tidy.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "A knock on the door glass.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "dialogue", "text": "You still open?", "name": "SULLY", "speaker": 1, "ext": ["O.S."], "paren": ["muffled, outside"], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "The door hisses open.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "SULLIVAN \"SULLY\" ADEBAYO (30s, rain-wet jacket, a duffel on one shoulder) steps up.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "He holds a paperback against his chest.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "You're eleven years late.", "name": "MAEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "That's fair.", "name": "SULLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "He sets the paperback on the desk.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "A dog-eared Neruda.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "She looks at the cover and then at him.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "That's mine.", "name": "MAEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "It is.", "name": "SULLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Her phone buzzes on the desk.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "She lifts it, stares at the screen, declines the call.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "It buzzes again.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "She silences it.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Sully watches the phone go dark.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "You married.", "name": "SULLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Seven years in June.", "name": "MAEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Good. That's good.", "name": "SULLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Don't say good like that.", "name": "MAEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Like what?", "name": "SULLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Like you're being brave about it.", "name": "MAEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "He laughs, then stops.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The lake light turns his face gold.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "I wrote in the margins. Page forty. I never knew how to send it.", "name": "SULLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "She opens the book.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Page forty.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "A line in his handwriting, faded, underlined twice.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "She reads.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Her mouth moves slightly, silent.", "para": 8, "sent": 4, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "The phone buzzes a third time.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "She lets it.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "It's overdue.", "name": "MAEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "How much do I owe?", "name": "SULLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Eleven years. Fifty cents a day.", "name": "MAEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "That's, what, two thousand dollars?", "name": "SULLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Two thousand and change.", "name": "MAEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "I'll pay in installments.", "name": "SULLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "She closes the book against her chest, the same way he held it.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "The fairy lights flicker.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "She picks up the phone.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Holds the power button until the screen goes black.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Then she sits on the edge of the desk, the book in both hands, and does not tell him to leave.", "para": 11, "sent": 2, "present": [0, 1, 2]}]}