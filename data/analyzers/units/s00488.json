{"scene_id": "s00488", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00488.fountain", "heading": "EXT. HEDGE MAZE - WEDDING VENUE - AFTERNOON", "cast": [{"id": 0, "name": "PRU", "names": ["PRU"], "gender": "f", "first": 5, "spoke": 8}, {"id": 1, "name": "SHETTY", "names": ["SHETTY"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "SANTANA-REYES", "names": ["SANTANA-REYES"], "gender": "?", "first": 9, "spoke": 0}, {"id": 3, "name": "JOAQU\u00cdN", "names": ["JOAQU\u00cdN"], "gender": "?", "first": 6, "spoke": 7}, {"id": 4, "name": "ODALYS FONTENOT", "names": ["ODALYS FONTENOT", "ODALYS"], "gender": "?", "first": 19, "spoke": 8}, {"id": 5, "name": "OFFICIANT DESMOND VANTERPOOL", "names": ["OFFICIANT DESMOND VANTERPOOL", "DESMOND"], "gender": "m", "first": 33, "spoke": 6}, {"id": 6, "name": "FLOWER GIRL", "names": ["FLOWER GIRL"], "gender": "?", "first": 37, "spoke": 0}, {"id": 7, "name": "TILLY BRANDT", "names": ["TILLY BRANDT", "TILLY"], "gender": "?", "first": 37, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. HEDGE MAZE - WEDDING VENUE - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Eight-foot yew walls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Gravel paths.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A white tent glimpsed over the green.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A string quartet drifts in from somewhere unseen.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "PRUDENCE \"PRU\" SHETTY (30s, bridesmaid in sage satin, flats in her hand) strides down a corridor of hedge, scanning left and right.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Joaqu\u00edn? Joaqu\u00edn!", "name": "PRU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 7, "kind": "action", "text": "She reaches a fork.", "para": 2, "sent": 0, "present": [0, 1, 3]}, {"u": 8, "kind": "action", "text": "A pair of legs in tuxedo trousers sticks out from under a bench at the end of a dead-end.", "para": 2, "sent": 1, "present": [0, 1, 3]}, {"u": 9, "kind": "action", "text": "JOAQU\u00cdN SANTANA-REYES (30s, groom, tie undone, a flask in his fist) is lying there, staring at the underside of the bench.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "You are forty minutes late to your own wedding.", "name": "PRU", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I'm not late. I'm lost.", "name": "JOAQU\u00cdN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "It's the same thing with a bow tie.", "name": "PRU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "She drops to her knees beside him.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "He offers the flask.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "She takes a swig and grimaces.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "That's cough syrup.", "name": "PRU", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "It was all I could find.", "name": "JOAQU\u00cdN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Gravel crunches.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "ODALYS FONTENOT (20s, bride, veil pinned to her wrist like a bracelet, running shoes under the gown) rounds the corner and halts.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "There you are.", "name": "ODALYS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Odalys.", "name": "JOAQU\u00cdN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "I've been through this maze eleven times.", "name": "ODALYS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Eleven?", "name": "PRU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Well, nine. Two were the same dead end.", "name": "ODALYS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "I can't remember the vows.", "name": "JOAQU\u00cdN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "I wrote them down.", "name": "ODALYS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "I lost the card.", "name": "JOAQU\u00cdN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "I have a copy.", "name": "ODALYS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Jo, breathe.", "name": "PRU", "speaker": 0, "ext": [], "paren": ["over her"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "I'm breathing.", "name": "JOAQU\u00cdN", "speaker": 3, "ext": [], "paren": ["over Pru"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "You are not breathing, you're panicking, which is different, and it's adorable.", "name": "ODALYS", "speaker": 4, "ext": [], "paren": ["over both"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "A new voice, deep and calm, cuts in from behind the hedge.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "OFFICIANT DESMOND VANTERPOOL (60s, black robe, rain boots) strides around the corner with a clipboard, a walkie-talkie squawking at his belt.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Found them. Both of them. And the maid of honor.", "name": "DESMOND", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Bridesmaid.", "name": "PRU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Bridesmaid. Of course.", "name": "DESMOND", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "A FLOWER GIRL, TILLY BRANDT (7, petals in her fist, grass-stained knees), skids in behind him and points at everyone in turn.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "dialogue", "text": "Is this the wedding?", "name": "TILLY", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "dialogue", "text": "It's the pre-wedding.", "name": "DESMOND", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "action", "text": "He looks at the four of them in the gravel.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 41, "kind": "action", "text": "He checks his watch.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 42, "kind": "dialogue", "text": "The guests are on their third appetizer. I can do this right here, if you'd like.", "name": "DESMOND", "speaker": 5, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 43, "kind": "dialogue", "text": "Here?", "name": "JOAQU\u00cdN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 44, "kind": "dialogue", "text": "There's a bench.", "name": "DESMOND", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 45, "kind": "dialogue", "text": "Pru, hold the veil.", "name": "ODALYS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 46, "kind": "dialogue", "text": "I'm the witness?", "name": "PRU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 47, "kind": "dialogue", "text": "You're the witness.", "name": "ODALYS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 48, "kind": "action", "text": "Joaqu\u00edn scrambles out from under the bench.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 49, "kind": "action", "text": "Odalys takes his hands.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 50, "kind": "action", "text": "Desmond opens a small book.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 51, "kind": "action", "text": "Pru, still holding her shoes, raises one in the air like a toast.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 52, "kind": "dialogue", "text": "Dearly beloved, and also hedge.", "name": "DESMOND", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}