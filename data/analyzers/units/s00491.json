{"scene_id": "s00491", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00491.fountain", "heading": "EXT. JUNKYARD - ABANDONED SCHOOL BUS - NIGHT", "cast": [{"id": 0, "name": "NOMI", "names": ["NOMI"], "gender": "?", "first": 3, "spoke": 10}, {"id": 1, "name": "ESKANDARI", "names": ["ESKANDARI"], "gender": "?", "first": 3, "spoke": 0}, {"id": 2, "name": "INEZ BRAND", "names": ["INEZ BRAND", "INEZ"], "gender": "f", "first": 4, "spoke": 12}, {"id": 3, "name": "DAISY", "names": ["DAISY"], "gender": "?", "first": 5, "spoke": 5}, {"id": 4, "name": "OMONDI", "names": ["OMONDI"], "gender": "?", "first": 5, "spoke": 0}, {"id": 5, "name": "WADE KOWALCZYK", "names": ["WADE KOWALCZYK", "WADE"], "gender": "m", "first": 7, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "EXT. JUNKYARD - ABANDONED SCHOOL BUS - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A yellow bus nosed into a heap of tires, its windows long gone, its seats stuffed with sleeping bags and fairy lights run off a car battery.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Beyond the fence, a refinery burns orange against the sky.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "NAOMI \"NOMI\" ESKANDARI (17, hoodie, cigarette she doesn't smoke) sits on the bus steps flicking a lighter.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "INEZ BRAND\u00c3O (16, her cousin, buzz cut, arms crossed) paces the gravel.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 5, "kind": "action", "text": "DESHI \"DAISY\" OMONDI (17, the youngest-looking, glasses, a tote bag stuffed with chips) sits on an upturned bucket.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 6, "kind": "action", "text": "And inside the bus, hidden in the dark, a fourth shape stirs under a blanket.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "dialogue", "text": "Where's Wade?", "name": "INEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "dialogue", "text": "He said nine.", "name": "NOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "It's nine-forty.", "name": "DAISY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "He's not coming.", "name": "INEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "He is. He said he'd bring the speaker.", "name": "NOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "He said a lot of things.", "name": "DAISY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "He said a lot of things last time, too.", "name": "INEZ", "speaker": 2, "ext": [], "paren": ["over Daisy"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Can we not?", "name": "NOMI", "speaker": 0, "ext": [], "paren": ["over both"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "The shape under the blanket sits up.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "WADE KOWALCZYK (18, bleary, a speaker the size of a brick in his lap) pulls the blanket off his head.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "I've been here since seven.", "name": "WADE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Wade.", "name": "NOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "I fell asleep.", "name": "WADE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "You fell asleep in the bus we told you not to sleep in.", "name": "INEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "It's comfortable.", "name": "WADE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Wade, you smell like gasoline.", "name": "DAISY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "The tank leaks. I patched it.", "name": "WADE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "With what?", "name": "NOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Gum.", "name": "WADE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Daisy hands him a bag of chips.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "He takes it without a word.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Inez kicks a hubcap across the gravel.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "It rings.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Next week I'm not here.", "name": "INEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "What?", "name": "NOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Mom says we're moving. Tulsa.", "name": "INEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "The refinery flare hisses.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Inez.", "name": "DAISY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Wait, seriously?", "name": "WADE", "speaker": 5, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "When did she tell you?", "name": "NOMI", "speaker": 0, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Tuesday.", "name": "INEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "It's Saturday.", "name": "NOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "I know what day it is.", "name": "INEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Nomi stands.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "She puts the lighter in her pocket.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "She walks to Inez and stops.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Say it again.", "name": "NOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "I said Tulsa.", "name": "INEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Not that part. The part where you didn't tell us for four days.", "name": "NOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "Because I didn't want it to be real.", "name": "INEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "Wade turns on the speaker.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "A thin, tinny song starts, something old and dumb that they all know.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "Nobody tells him to stop.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Daisy sings the first line under her breath.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "Nomi lets go.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "She sits on the step.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "Inez sits beside her.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "Wade sets the speaker on the dashboard.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "Is there a bus in Tulsa?", "name": "DAISY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "I'll find one.", "name": "INEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "dialogue", "text": "I can fix it up.", "name": "WADE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "You can't even fix your tank.", "name": "INEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "It's gum. It holds.", "name": "WADE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "They laugh a little.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "The song plays out.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "Over the junkyard fence, the flare finally goes dark.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}