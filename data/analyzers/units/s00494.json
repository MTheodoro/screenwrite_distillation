{"scene_id": "s00494", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00494.fountain", "heading": "INT. MASCOT DRESSING ROOM - MINOR LEAGUE BASEBALL STADIUM - DAY", "cast": [{"id": 0, "name": "BEAR MAN", "names": ["MAN", "BEAR MAN"], "gender": "?", "first": 4, "spoke": 1}, {"id": 1, "name": "BEAR SUIT", "names": ["BEAR SUIT"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "ARCHIE", "names": ["ARCHIE"], "gender": "m", "first": 5, "spoke": 16}, {"id": 3, "name": "PELL", "names": ["PELL"], "gender": "?", "first": 5, "spoke": 0}, {"id": 4, "name": "WALLY", "names": ["WALLY"], "gender": "?", "first": 7, "spoke": 14}], "units": [{"u": 0, "kind": "heading", "text": "INT. MASCOT DRESSING ROOM - MINOR LEAGUE BASEBALL STADIUM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Cinderblock closet.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A rack of foam heads: a bear, a hot dog, a giant baseball bat.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Two benches, a mini-fridge, a fan that rotates uselessly.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A MAN IN A BEAR SUIT (30s, head under his arm, drenched in sweat) sits on a bench staring at his hands.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "ARCHIBALD \"ARCHIE\" PELL (50s, team's mascot coordinator, polo shirt, clip-on tie) enters with a clipboard.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "dialogue", "text": "Walter.", "name": "ARCHIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "It's Wally.", "name": "BEAR MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "It's on your contract as Walter.", "name": "ARCHIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Then it's Walter on paper and Wally in my heart.", "name": "WALLY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Archie sits.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "The bench creaks.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Sixth inning. The children's race.", "name": "ARCHIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "I know.", "name": "WALLY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "The hot dog was supposed to win.", "name": "ARCHIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "I know.", "name": "WALLY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "The hot dog is a nine-year-old with a sprained wrist now.", "name": "ARCHIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "He cut me off.", "name": "WALLY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "He's nine.", "name": "ARCHIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "He cut me off and he looked at me.", "name": "WALLY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Walter.", "name": "ARCHIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Wally.", "name": "WALLY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "He was wearing the suit. He couldn't see anything.", "name": "ARCHIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "He saw me.", "name": "WALLY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Listen to me. I need you to apologize.", "name": "ARCHIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "To a boy dressed as a hot dog.", "name": "WALLY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "To his mother. In person. By the concessions.", "name": "ARCHIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "She's terrifying.", "name": "WALLY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "She's a dental hygienist.", "name": "ARCHIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Same thing.", "name": "WALLY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "They both stand at the same time.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Archie holds the clipboard to his chest; Wally holds the bear head to his.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "They say the next line together, in unison.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "We don't have to do this.", "name": "WALLY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "We have to do this.", "name": "ARCHIE", "speaker": 2, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "They stop.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "They look at each other.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "That was strange.", "name": "ARCHIE", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "You first.", "name": "WALLY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "No, you.", "name": "ARCHIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "They both reach for the door at the same moment.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Their hands collide on the knob.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Neither lets go.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Archie, I'm sorry about the hot dog.", "name": "WALLY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Walter, it's fine.", "name": "ARCHIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Wally.", "name": "WALLY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Wally. It's fine.", "name": "ARCHIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "He opens the door.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "A burst of crowd noise floods the room.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Wally pulls the bear head back on, and with it, becomes a different man: huge, cheerful, waving.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Archie shakes his head and follows him out.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}]}