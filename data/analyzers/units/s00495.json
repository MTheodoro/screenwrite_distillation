{"scene_id": "s00495", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00495.fountain", "heading": "INT. CAPSIZED SAILBOAT - UPSIDE-DOWN CABIN - NIGHT", "cast": [{"id": 0, "name": "LAKSHMI VENKAT", "names": ["LAKSHMI VENKAT", "LAKSHMI"], "gender": "?", "first": 5, "spoke": 5}, {"id": 1, "name": "OTIS BRANNIGAN", "names": ["OTIS BRANNIGAN", "OTIS"], "gender": "m", "first": 8, "spoke": 6}, {"id": 2, "name": "HENRIK SOLBERG", "names": ["HENRIK SOLBERG", "HENRIK"], "gender": "m", "first": 9, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. CAPSIZED SAILBOAT - UPSIDE-DOWN CABIN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Hull turned to ceiling.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Black water at knee height, sloshing.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A galley stove hangs overhead like a bat.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "One headlamp.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LAKSHMI VENKAT (30s, navigator, orange float coat) clings to a bunk rail.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Water to her ribs.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Breath fogging.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "OTIS BRANNIGAN (50s, skipper, split eyebrow) wedges himself against the companionway, shoulder to the hatch.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Third: HENRIK SOLBERG (20s, deckhand, teeth chattering) pulls himself up on a pipe cot.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Count off.", "name": "OTIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "One.", "name": "LAKSHMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Two.", "name": "HENRIK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Three. Good. Air?", "name": "OTIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "We've got maybe an hour.", "name": "LAKSHMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Less. I can taste it.", "name": "HENRIK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Otis slams the hatch with his shoulder.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Water spits through the seams.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Lakshmi swings the headlamp to the porthole, where something white and heavy bobs against the glass, and Henrik grabs a boat hook off the wall and jabs at the hatch latch while Otis hauls himself up the ladder, and the whole hull rolls another few degrees, tipping a gush of black over all three of them.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "It's moving!", "name": "LAKSHMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Hold on!", "name": "OTIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "We're going down!", "name": "HENRIK", "speaker": 2, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "We're not going down, we're settling!", "name": "LAKSHMI", "speaker": 0, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Both of you, quiet!", "name": "OTIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "They go quiet.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "The hull ticks.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Somewhere far above, faint through steel: an engine.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Is that...", "name": "HENRIK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Shh.", "name": "OTIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "It's a ship.", "name": "LAKSHMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Bang the hull. Everyone.", "name": "OTIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "They bang the hull with fists, with the boat hook, with a skillet from the galley.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Three rhythms, three desperate voices.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "The engine slows.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Stops.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Then, from above: three knocks.", "para": 7, "sent": 1, "present": [0, 1, 2]}]}