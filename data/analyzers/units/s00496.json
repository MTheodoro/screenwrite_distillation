{"scene_id": "s00496", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00496.fountain", "heading": "INT. COUNTY HOSPITAL - NIGHT WARD - NIGHT", "cast": [{"id": 0, "name": "WINIFRED OSEI", "names": ["WINIFRED OSEI", "WINIFRED"], "gender": "f", "first": 5, "spoke": 5}, {"id": 1, "name": "NURSE CARMELA BRUNO", "names": ["NURSE CARMELA BRUNO", "CARMELA"], "gender": "f", "first": 6, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. COUNTY HOSPITAL - NIGHT WARD - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A long ward at lights-low.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A dozen iron beds, white curtains drawn on half.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A ceiling fan turns slowly.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A clock above the door reads 3:10.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. WINIFRED OSEI (40s, white coat, stethoscope slung like a scarf) sits on the edge of an empty bed, shoes off, rubbing her arch.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "NURSE CARMELA BRUNO (50s, starched cap, cardigan over her uniform) crosses the aisle with a tray of paper cups, sets one down beside the doctor, pours her own, and sits on the next bed over; she lifts her feet onto the rail, Winifred leans back on her elbows, and the two women sit in the pool of lamplight like old friends on a porch.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Bed nine?", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Asleep. Finally.", "name": "CARMELA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Good.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "She asked for you.", "name": "CARMELA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "She asks for everyone.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "She asked for you twice.", "name": "CARMELA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Winifred sips the tea.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She makes a face.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "What is this?", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Chamomile.", "name": "CARMELA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "It tastes like a hay bale.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "It's good for you.", "name": "CARMELA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "They both look down the ward.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "A patient coughs behind a curtain and settles.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "The fan ticks.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Carmela raises her paper cup an inch.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Winifred taps it with hers.", "para": 3, "sent": 4, "present": [0, 1]}]}