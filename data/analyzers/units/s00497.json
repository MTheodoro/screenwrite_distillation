{"scene_id": "s00497", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00497.fountain", "heading": "INT. PARKING GARAGE - LEVEL 3 - NIGHT", "cast": [{"id": 0, "name": "FRANKIE DELACORTE", "names": ["FRANKIE DELACORTE", "FRANKIE"], "gender": "m", "first": 4, "spoke": 9}, {"id": 1, "name": "MALIK OYELARAN", "names": ["MALIK OYELARAN", "MALIK"], "gender": "m", "first": 5, "spoke": 12}, {"id": 2, "name": "BLYTHE ARMSTRONG-LEE", "names": ["BLYTHE ARMSTRONG-LEE", "BLYTHE"], "gender": "f", "first": 6, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. PARKING GARAGE - LEVEL 3 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Concrete pillars.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fluorescent tubes buzzing.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A rented limousine idling with its doors open, bass pulsing faintly from a dance hall a block away.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "FRANKIE DELACORTE (17, rented tuxedo two sizes large, corsage crushed in his fist) sits on the limo bumper.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "MALIK OYELARAN (17, his best friend, bow tie hanging) leans against a pillar, spinning a set of car keys on one finger.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "BLYTHE ARMSTRONG-LEE (17, Frankie's date, silver dress, heels in one hand) stands at the edge of the headlights, arms folded.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Nobody speaks for a long while.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Well. That was a dance.", "name": "MALIK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Don't.", "name": "FRANKIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I'm only saying.", "name": "MALIK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "He's only saying.", "name": "BLYTHE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Blythe.", "name": "FRANKIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "You said you'd tell him.", "name": "BLYTHE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I was going to.", "name": "FRANKIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "You said, quote, \"Tonight.\"", "name": "BLYTHE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Malik stops spinning the keys.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "He looks from one to the other, then at the floor.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Frankie stands, brushes his knees, and takes a step toward Blythe; she steps back; Malik takes a step forward as if to separate them; and all three of them stop at once, caught in the light like three deer on a road.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Tell me what?", "name": "MALIK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Nothing.", "name": "FRANKIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "That he's moving to Denver.", "name": "BLYTHE", "speaker": 2, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "You told her first.", "name": "MALIK", "speaker": 1, "ext": [], "paren": ["to Frankie"], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Mal.", "name": "FRANKIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "You told her before me.", "name": "MALIK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "It was an accident.", "name": "FRANKIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "How do you accidentally tell someone you're leaving?", "name": "MALIK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "He doesn't leave till August.", "name": "BLYTHE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "August is three months.", "name": "MALIK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Three months is a long time.", "name": "BLYTHE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "It's the length of a summer, Blythe.", "name": "MALIK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Hey. I'm standing right here.", "name": "FRANKIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Then say something.", "name": "MALIK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Frankie opens his mouth.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Closes it.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "His corsage drops to the concrete.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Malik shoves him, once, in the chest, not hard.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Frankie stumbles back against the limo.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Neither moves.", "para": 4, "sent": 5, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Blythe sets her heels on the hood and wraps her arms around herself.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "A car alarm chirps somewhere on the level below.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "I didn't want it to end like this.", "name": "FRANKIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "It's not ending. It's Denver.", "name": "MALIK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "It's the same thing.", "name": "FRANKIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "It is not.", "name": "MALIK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "He picks up the corsage.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "He hands it back.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Frankie turns it over in his hand, then holds it out to Blythe, who looks at it, takes it, and pins it to Malik's lapel.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "There. Now we all have a flower.", "name": "BLYTHE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "I'm not wearing this.", "name": "MALIK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "You are.", "name": "BLYTHE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "He lets it stay.", "para": 7, "sent": 0, "present": [0, 1, 2]}]}