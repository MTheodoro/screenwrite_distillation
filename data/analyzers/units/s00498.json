{"scene_id": "s00498", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00498.fountain", "heading": "EXT. PETTING ZOO - BIRTHDAY PARTY - DAY", "cast": [{"id": 0, "name": "DARIUS FENWICK-ODOM", "names": ["DARIUS FENWICK-ODOM", "DARIUS"], "gender": "?", "first": 3, "spoke": 3}, {"id": 1, "name": "SOLEDAD", "names": ["SOLEDAD"], "gender": "m", "first": 4, "spoke": 3}, {"id": 2, "name": "PAULINE", "names": ["PAULINE"], "gender": "f", "first": 5, "spoke": 3}, {"id": 3, "name": "ZOO KEEPER", "names": ["ZOO KEEPER"], "gender": "?", "first": 6, "spoke": 0}, {"id": 4, "name": "RIBEIRO", "names": ["RIBEIRO", "MR. RIBEIRO"], "gender": "?", "first": 6, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. PETTING ZOO - BIRTHDAY PARTY - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A fenced paddock, hay bales, a goat in a party hat.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Kids shriek in the distance.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "DARIUS FENWICK-ODOM (40s, host dad, apron over a polo) carries a tray of juice boxes to the pen, whistling.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "His wife SOLEDAD (40s, sunglasses, a phone in each hand) trails him, texting.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Her mother PAULINE (70s, lawn chair, thermos) watches from the gate.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "The ZOO KEEPER, MR. RIBEIRO (50s, overalls, bucket), leans on a fence post.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "action", "text": "He sets down the tray.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "She sets down a phone.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "Pauline lifts her thermos in salute.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Seven kids. One goat. What could go wrong?", "name": "DARIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Don't say that.", "name": "MR. RIBEIRO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Darius, don't.", "name": "SOLEDAD", "speaker": 1, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Let the man speak.", "name": "PAULINE", "speaker": 2, "ext": [], "paren": ["over her"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "The goat lowers its head.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "It eyes the tray.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "It eyes Darius.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Nice goat.", "name": "DARIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "That's Gerald.", "name": "MR. RIBEIRO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Gerald is wearing a party hat.", "name": "SOLEDAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "So is the cake.", "name": "PAULINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "They all turn.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Behind them, the cake sits on a hay bale, fully intact, a three-tier unicorn.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Gerald trots toward it.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Gerald, no.", "name": "DARIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Gerald, heel!", "name": "MR. RIBEIRO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Mother, move your chair!", "name": "SOLEDAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Gerald hits the hay bale at a full run.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Frosting rains over all four of them.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Pauline, sprayed pink from head to toe, lowers her thermos and says, perfectly calm:", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Well. That's a fun party.", "name": "PAULINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}