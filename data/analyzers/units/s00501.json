{"scene_id": "s00501", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00501.fountain", "heading": "EXT. SALT FLATS - HIGH NOON", "cast": [{"id": 0, "name": "ZEB", "names": ["ZEB"], "gender": "?", "first": 6, "spoke": 11}, {"id": 1, "name": "CULLEN", "names": ["CULLEN"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "MATT", "names": ["MATT"], "gender": "m", "first": 7, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SALT FLATS - HIGH NOON", "present": []}, {"u": 1, "kind": "action", "text": "A white plain without edges, hammered flat by heat.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The horizon trembles in the glare.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A dead wagon sits crooked, one wheel lost in a crust of salt.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "No wind.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "No shadow of any bird.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "ZEBEDIAH \"ZEB\" CULLEN (40s, black coat bleached gray at the shoulders, a dry tongue worrying the corner of his mouth) leads a stumbling mule across the white.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "On the mule's back, slumped like a sack of grain, rides his boy, MATTHIAS \"MATT\" CULLEN (14, hat tied under his chin with twine, lips cracked red).", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Matt.", "name": "ZEB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Pa.", "name": "MATT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Eyes open.", "name": "ZEB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "They are.", "name": "MATT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Open wider.", "name": "ZEB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "The boy grins weakly.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "A hard grin, with no water behind it.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "The mule stops.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Zeb pulls the lead and the mule refuses.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "He turns and sees the mule's legs trembling, a thin line of foam on its lip.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Not now, old girl.", "name": "ZEB", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "He draws the canteen from his hip, shakes it.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "A slosh.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "A single mouthful.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "He holds it out to Matt.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "You first.", "name": "MATT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Drink.", "name": "ZEB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Pa, you drink.", "name": "MATT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Matthias.", "name": "ZEB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "The boy takes the canteen with both hands.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "He drinks half the mouthful.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "He passes it back.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Zeb tips what remains onto the mule's tongue.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The animal shudders and walks on.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Then the sound comes: a low rumble, like thunder under a floor.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "The horizon darkens.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "A black line rises along the edge of the world, spreading wide as a mountain.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Pa, what is that?", "name": "MATT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Storm.", "name": "ZEB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "There's no clouds.", "name": "MATT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Dust. It's dust. Get down. Get down, boy!", "name": "ZEB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "He drags Matt from the saddle and presses him flat into the salt, throws his coat over them both, and lies on top, bracing.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "The mule bolts.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "The wall of dust crashes over them with a howl that swallows speech, a white-brown roar that fills the sky from end to end, and for a long minute there is nothing in the world but weight and wind.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Then, as quickly as it came, it is gone.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "The sky is clear.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "The plain is flat.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Under the coat, two breaths.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Zeb lifts the edge.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Salt streams off his shoulders.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "He looks down.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Matt?", "name": "ZEB", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "I'm here.", "name": "MATT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Good.", "name": "ZEB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Did we lose the mule?", "name": "MATT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Not yet.", "name": "ZEB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Far across the white, a small gray shape stands patient in the shimmer, waiting for them.", "para": 9, "sent": 0, "present": [0, 1, 2]}]}