{"scene_id": "s00503", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00503.fountain", "heading": "INT. OPEN-PLAN OFFICE - CUBICLE 14C - DAY", "cast": [{"id": 0, "name": "PERSEVERE", "names": ["PERSEVERE"], "gender": "?", "first": 4, "spoke": 0}, {"id": 1, "name": "NORBERT PLUM", "names": ["NORBERT PLUM", "NORBERT"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "IMOGEN TRAVIS-OKORO", "names": ["IMOGEN TRAVIS-OKORO", "IMOGEN"], "gender": "?", "first": 7, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. OPEN-PLAN OFFICE - CUBICLE 14C - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Grey carpet tiles.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Grey partitions.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A ficus, plastic, gathering dust on a filing cabinet.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A motivational poster: PERSEVERE, with a kayaker in a flooded canyon.", "para": 0, "sent": 3, "present": [0]}, {"u": 5, "kind": "action", "text": "NORBERT PLUM (50s, short-sleeved dress shirt, lanyard overlong) types with two fingers.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "He hasn't smiled since 2011.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "IMOGEN TRAVIS-OKORO (20s, new hire, cardigan with a sticker still on the sleeve) appears at the cubicle opening with a box of donuts.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Hi! I'm Imogen. I'm in 14D.", "name": "IMOGEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Norbert doesn't look up.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "There's no 14D.", "name": "NORBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "They built it this morning.", "name": "IMOGEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Hm.", "name": "NORBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She sets the box on his desk.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "He finally looks at it.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Then at her.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Then, very slowly, he opens the lid and takes a donut.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Thank you.", "name": "NORBERT", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "You're welcome!", "name": "IMOGEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "He bites.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "His eyes close.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "A tear slides from one of them.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Are you okay?", "name": "IMOGEN", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Fourteen years. Nobody has ever brought me a donut.", "name": "NORBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "He wipes his face with the lanyard.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "She pulls over a chair and sits.", "para": 6, "sent": 1, "present": [0, 1, 2]}]}