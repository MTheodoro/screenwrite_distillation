{"scene_id": "s00505", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00505.fountain", "heading": "INT. ROLLER RINK - SNACK COUNTER - NIGHT", "cast": [{"id": 0, "name": "PETRA WOLANSKA", "names": ["PETRA WOLANSKA", "PETRA"], "gender": "f", "first": 5, "spoke": 7}, {"id": 1, "name": "LEVI NAKASHIMA-BOYD", "names": ["LEVI NAKASHIMA-BOYD", "LEVI"], "gender": "m", "first": 7, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROLLER RINK - SNACK COUNTER - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A wood-floored barn with a mirror ball turning slow.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Neon palm trees on the walls.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The air smells of nacho cheese and floor polish.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A disco anthem thumps under the skaters' wheels.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "PETRA WOLANSKA (15, braces, borrowed rental skates laced wrong) sits on the end of a bench, holding a paper cone of fries she isn't eating.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her eyes track the rink.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "LEVI NAKASHIMA-BOYD (16, concession apron over a hockey jersey, wheels strapped to his work shoes with zip ties) rolls up on the other side of the counter and leans there.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You're not skating.", "name": "LEVI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I'm resting.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "For forty minutes?", "name": "LEVI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "It's a long rest.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He laughs.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She almost does.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She scoops a fry into her mouth.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Come on. I'll show you.", "name": "LEVI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "I'll fall.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Everyone falls.", "name": "LEVI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "I'll fall in front of people.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Those people are eight years old.", "name": "LEVI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She stands, wobbling, and he reaches over the counter, swings out the gate, and glides to her side.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "He offers an elbow.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "She grabs it with both hands and they shuffle out onto the boards, Petra rigid as a plank, Levi sliding backward, murmuring instructions, and a group of small children whips past like startled birds.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Don't let go.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "I won't.", "name": "LEVI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "You're letting go.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "I'm not.", "name": "LEVI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "He lets go.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "She glides, three feet, five, ten, arms out, eyes huge.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "She doesn't fall.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Levi! Levi, look!", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "I'm looking!", "name": "LEVI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "She laughs, a real laugh now, bright and cracked.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "The mirror ball throws spots of light across her face, one after another, like small applause.", "para": 6, "sent": 1, "present": [0, 1]}]}