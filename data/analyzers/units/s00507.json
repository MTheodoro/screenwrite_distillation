{"scene_id": "s00507", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00507.fountain", "heading": "INT. VENTRILOQUIST'S ATTIC - NIGHT", "cast": [{"id": 0, "name": "MAXIMILIAN ROOK", "names": ["MAXIMILIAN ROOK", "MAXIMILIAN"], "gender": "m", "first": 5, "spoke": 20}, {"id": 1, "name": "KNOCK", "names": ["KNOCK"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "WOMAN", "names": ["WOMAN"], "gender": "f", "first": 7, "spoke": 0}, {"id": 3, "name": "JOURNALIST", "names": ["JOURNALIST"], "gender": "?", "first": 8, "spoke": 5}, {"id": 4, "name": "ODELIA", "names": ["ODELIA"], "gender": "?", "first": 19, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. VENTRILOQUIST'S ATTIC - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A low, slant-roofed room under the eaves.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dozens of wooden dummies sit in rows on rickety shelves, glass eyes gleaming.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A steamer trunk lies open on the floor, lined with red velvet.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain taps the skylight.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MAXIMILIAN ROOK (70s, bow tie askew, dressing gown, white gloves) kneels beside the trunk, tenderly arranging the limbs of a dummy: a small boy in a sailor suit with a painted smile.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A KNOCK at the attic hatch.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "A WOMAN climbs through (30s, trench coat, a recorder in her hand), a journalist, shaking rain from her collar.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Mr. Rook? I rang the bell.", "name": "JOURNALIST", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "The bell doesn't work.", "name": "MAXIMILIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "I noticed. The door was open.", "name": "JOURNALIST", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "It always is.", "name": "MAXIMILIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "She looks around, scanning the shelves.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Quite the audience.", "name": "JOURNALIST", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "They're my family.", "name": "MAXIMILIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "All of them?", "name": "JOURNALIST", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Forty-one. Forty-two, with Percy.", "name": "MAXIMILIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "He pats the sailor-boy.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Its head lolls, and the painted smile shifts in the lamplight.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Odelia Fairweather, from the Courier. May I?", "name": "JOURNALIST", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "She sets her recorder on the trunk, clicks it on.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Mr. Rook, you retired in 1974. People say you stopped because you could no longer tell where your voice ended and theirs began.", "name": "ODELIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "People say a great deal.", "name": "MAXIMILIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Is it true?", "name": "ODELIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Ask Percy.", "name": "MAXIMILIAN", "speaker": 0, "ext": [], "paren": ["gently"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "I'd rather ask you.", "name": "ODELIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "But he's the one who knows.", "name": "MAXIMILIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "He lifts Percy onto his knee.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "His hand slides inside the dummy's back.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Its jaw clacks.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Hello, lady.", "name": "MAXIMILIAN", "speaker": 0, "ext": [], "paren": ["a piping boy's voice, lips unmoving"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Odelia laughs, uneasy.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Very good.", "name": "ODELIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Max is old. He forgets to eat.", "name": "MAXIMILIAN", "speaker": 0, "ext": [], "paren": ["the boy's voice, lips unmoving"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Percy.", "name": "MAXIMILIAN", "speaker": 0, "ext": [], "paren": ["in his own voice, startled"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "He forgets to sleep. He forgets which of us is which.", "name": "MAXIMILIAN", "speaker": 0, "ext": [], "paren": ["the boy's voice, lips unmoving"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "That is enough.", "name": "MAXIMILIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Max, stop moving your lips.", "name": "MAXIMILIAN", "speaker": 0, "ext": [], "paren": ["the boy's voice, lips unmoving"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Maximilian's hand withdraws.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "He stares at it.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "The dummy's jaw hangs open.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Silence in the attic.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Rain.", "para": 8, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Mr. Rook?", "name": "ODELIA", "speaker": 4, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "I did not say that.", "name": "MAXIMILIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "I know.", "name": "ODELIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "I was not saying it.", "name": "MAXIMILIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Odelia reaches for the recorder.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Her hand trembles.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "The little red light blinks.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "From the shelves, one by one, the painted heads begin to turn, wood clicking against wood, until forty-one pairs of glass eyes rest upon the journalist.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "Hello, lady. Do stay.", "name": "MAXIMILIAN", "speaker": 0, "ext": [], "paren": ["the boy's voice, lips unmoving"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Maximilian lifts his gloved hands and lets the dummy slide back into the velvet.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "It settles with a soft sigh.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "He stands, gown trailing.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "Miss Fairweather. You had better go.", "name": "MAXIMILIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Mr. Rook, I...", "name": "ODELIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "Go down the stairs. Do not look at the shelves. Do not answer if anyone calls your name.", "name": "MAXIMILIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "She snatches the recorder.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "She crosses to the hatch, one step at a time.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "Behind her, in the dark, forty-two small voices begin, very quietly, to hum.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "At the hatch she stops.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "dialogue", "text": "Will you be all right?", "name": "ODELIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "dialogue", "text": "They've never hurt me.", "name": "MAXIMILIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "dialogue", "text": "That isn't what I asked.", "name": "ODELIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "He turns to the shelves.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "The old man's shoulders drop, and he smiles for the first time, the exact smile painted on Percy's face.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "dialogue", "text": "Goodnight, my dear.", "name": "MAXIMILIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "action", "text": "She climbs down.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "The hatch closes on its own.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}]}