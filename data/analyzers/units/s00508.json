{"scene_id": "s00508", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00508.fountain", "heading": "INT. FERRY TERMINAL - WAITING ROOM - EARLY MORNING", "cast": [{"id": 0, "name": "PERPETUA OSEI-ADJEI", "names": ["PERPETUA OSEI-ADJEI", "PERPETUA"], "gender": "?", "first": 5, "spoke": 15}, {"id": 1, "name": "MAN", "names": ["MAN"], "gender": "?", "first": 14, "spoke": 0}, {"id": 2, "name": "JULIAN OSEI-ADJEI", "names": ["JULIAN OSEI-ADJEI", "JULIAN"], "gender": "?", "first": 5, "spoke": 17}], "units": [{"u": 0, "kind": "heading", "text": "INT. FERRY TERMINAL - WAITING ROOM - EARLY MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Plastic benches bolted in rows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A vending machine glowing blue.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A departures board reads CANCELLED in red beside every sailing.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Fog presses at the windows like a hand.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "PERPETUA OSEI-ADJEI (60s, camel coat, a small suitcase between her feet) sits alone with her purse on her lap.", "para": 1, "sent": 0, "present": [0, 2]}, {"u": 6, "kind": "action", "text": "She has not taken off her gloves.", "para": 1, "sent": 1, "present": [0, 2]}, {"u": 7, "kind": "action", "text": "She watches the board.", "para": 2, "sent": 0, "present": [0, 2]}, {"u": 8, "kind": "action", "text": "She watches the door.", "para": 2, "sent": 1, "present": [0, 2]}, {"u": 9, "kind": "action", "text": "She watches nothing.", "para": 2, "sent": 2, "present": [0, 2]}, {"u": 10, "kind": "action", "text": "A clock ticks, loud in the silence.", "para": 3, "sent": 0, "present": [0, 2]}, {"u": 11, "kind": "action", "text": "A gull lands on the sill, regards her, and leaves.", "para": 3, "sent": 1, "present": [0, 2]}, {"u": 12, "kind": "action", "text": "The door opens.", "para": 4, "sent": 0, "present": [0, 2]}, {"u": 13, "kind": "action", "text": "Cold air.", "para": 4, "sent": 1, "present": [0, 2]}, {"u": 14, "kind": "action", "text": "A MAN steps in, shaking out a wet umbrella: JULIAN OSEI-ADJEI (30s, her son, scarf, luggage on wheels).", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "He sees her and stops dead.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Mother.", "name": "JULIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "You came.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "You said the 6:15.", "name": "JULIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "It's cancelled.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I saw the board.", "name": "JULIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "He crosses to the vending machine.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "He studies it without buying.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "They say it will clear by noon.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "They always say that.", "name": "JULIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "He sits, one bench away.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "He sets the umbrella down.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "It drips on the linoleum between them.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Your father would have liked the fog.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Would he.", "name": "JULIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "He said fog was honest. Everything looks the way it feels.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Julian says nothing.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "He picks at the handle of his suitcase.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Did you eat?", "name": "JULIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "A little.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "What did you eat?", "name": "JULIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Toast.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "That isn't a meal.", "name": "JULIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "It is if you are me.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "He almost smiles.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "He rises, crosses to the vending machine, feeds a coin.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "A packet drops.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "He brings it to her.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Biscuits.", "para": 8, "sent": 4, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "She takes them, turns the packet over, reads the ingredients as though they were a letter.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Too much sugar.", "name": "PERPETUA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Eat them anyway.", "name": "JULIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "She opens the packet.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "She eats one.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "She offers him the packet.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "He takes one.", "para": 10, "sent": 3, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "They chew in silence.", "para": 10, "sent": 4, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "When did you last visit the grave?", "name": "JULIAN", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Sunday.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "I haven't been in a year.", "name": "JULIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "I know.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "I didn't know what to say to him.", "name": "JULIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "He wouldn't have talked back.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "That's the problem.", "name": "JULIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "A soft laugh.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "She folds the packet and tucks it into her purse.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "The loudspeaker clicks on: a bored recorded voice announces a one-hour delay.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "One hour.", "name": "JULIAN", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "One hour.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "We could go.", "name": "JULIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "Where?", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "The grave. It's ten minutes by taxi.", "name": "JULIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "She looks at him.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "Her gloved hands tighten on the purse.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "Her eyes go to the window, where the fog is thinning.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 70, "kind": "dialogue", "text": "I'll need to freshen my lipstick.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 71, "kind": "dialogue", "text": "Take your time.", "name": "JULIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 72, "kind": "action", "text": "She stands.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 73, "kind": "action", "text": "She straightens her coat.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 74, "kind": "action", "text": "She picks up her small suitcase, and he, without being asked, takes it from her hand.", "para": 13, "sent": 2, "present": [0, 1, 2]}, {"u": 75, "kind": "action", "text": "They walk to the door together.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 76, "kind": "action", "text": "At the threshold he holds it open, and she goes through first, into the gray.", "para": 14, "sent": 1, "present": [0, 1, 2]}]}