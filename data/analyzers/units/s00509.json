{"scene_id": "s00509", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00509.fountain", "heading": "INT. COURTHOUSE - BASEMENT BOILER ROOM - NIGHT", "cast": [{"id": 0, "name": "ATTORNEY NADINE KOWALSKI-BEAUFORT", "names": ["ATTORNEY NADINE KOWALSKI-BEAUFORT", "NADINE"], "gender": "f", "first": 5, "spoke": 17}, {"id": 1, "name": "CUSTODIAN", "names": ["CUSTODIAN"], "gender": "m", "first": 8, "spoke": 3}, {"id": 2, "name": "WALTER", "names": ["WALTER"], "gender": "?", "first": 6, "spoke": 14}, {"id": 3, "name": "PROSECUTOR LEOPOLD ASHWORTH", "names": ["PROSECUTOR LEOPOLD ASHWORTH", "ASHWORTH"], "gender": "?", "first": 61, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. COURTHOUSE - BASEMENT BOILER ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Pipes the width of tree trunks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A hissing furnace.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single caged bulb.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "On a workbench: a jar of coffee and a radio playing low jazz.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ATTORNEY NADINE KOWALSKI-BEAUFORT (40s, wet raincoat, briefcase) picks her way between the pipes, calling softly.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "dialogue", "text": "Mr. Fitch? Walter Fitch?", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 2]}, {"u": 7, "kind": "action", "text": "A rattle of keys.", "para": 2, "sent": 0, "present": [0, 2]}, {"u": 8, "kind": "action", "text": "An old CUSTODIAN (60s, coveralls, ring of keys at his belt) steps from behind the boiler, wiping his hands on a rag.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "You're not allowed down here.", "name": "CUSTODIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I'm Nadine Kowalski. Your daughter's attorney.", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Celeste has an attorney?", "name": "CUSTODIAN", "speaker": 1, "ext": [], "paren": ["a pause"], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "She does now.", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "He sets the rag on the workbench, studies her, then pulls a second stool from the shadows.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "She sits.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "He pours coffee into a chipped mug and slides it across.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Black. Sorry. No cream.", "name": "CUSTODIAN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Black's fine.", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "The jazz plays.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "The furnace ticks.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Mr. Fitch, your daughter is on trial tomorrow.", "name": "NADINE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "I know.", "name": "WALTER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "She says she was at home the night of the break-in. She says she was with you.", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "I'd say the same.", "name": "WALTER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Were you?", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "He rubs his jaw.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The keys clink at his belt.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "I'm the night janitor. I'm here nights.", "name": "WALTER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "So you weren't with her.", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "No.", "name": "WALTER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Then why would she say it?", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Because I told her to.", "name": "WALTER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "She puts down her mug.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Slowly, she folds her hands.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Mr. Fitch, I need you to repeat that very carefully.", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "I told her to say it. I knew the judge would believe a father.", "name": "WALTER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "You knew she wasn't home.", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "I knew where she was.", "name": "WALTER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Where?", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Here.", "name": "WALTER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "The caged bulb swings.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Shadows lurch across the pipes.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Nadine stands.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Here? In the courthouse?", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Down here. With me. She came to fix a pipe.", "name": "WALTER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Why would she\u2014", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "She's a plumber, Ms. Kowalski. She works nights. She was in the east vault, patching a leak, the night someone cleaned out the evidence room upstairs.", "name": "WALTER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "So she had access.", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "She had a keycard I gave her.", "name": "WALTER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "And you didn't tell the police.", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "I'm telling you.", "name": "WALTER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Why now?", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Why now?", "name": "WALTER", "speaker": 2, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "They stop.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "The radio plays a soft saxophone note.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "He smiles, grimly.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "Because the man who stole it is the one prosecuting her.", "name": "WALTER", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Nadine sits down very slowly.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "The mug rattles on the bench.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "High above, a door opens.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "Footsteps descend the iron stairs, unhurried.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "A silhouette stops at the bottom step: PROSECUTOR LEOPOLD ASHWORTH (50s, charcoal suit, cufflinks catching the bulb).", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "Evening, Walter. Visitors?", "name": "ASHWORTH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "Walter does not turn.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "Nadine slowly closes her briefcase.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}]}