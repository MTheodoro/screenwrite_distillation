{"scene_id": "s00510", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00510.fountain", "heading": "INT. BANQUET HALL - QUINCEA\u00d1ERA - NIGHT", "cast": [{"id": 0, "name": "DJ", "names": ["DJ"], "gender": "?", "first": 5, "spoke": 0}, {"id": 1, "name": "XIMENA DELGADILLO-PARK", "names": ["XIMENA DELGADILLO-PARK", "XIMENA"], "gender": "?", "first": 6, "spoke": 13}, {"id": 2, "name": "ABUELA CONSUELO", "names": ["ABUELA CONSUELO", "CONSUELO"], "gender": "?", "first": 7, "spoke": 6}, {"id": 3, "name": "RAMIRO", "names": ["RAMIRO"], "gender": "m", "first": 8, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. BANQUET HALL - QUINCEA\u00d1ERA - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Crepe-paper arches.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A chocolate fountain.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A disco ball.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Tables set with pink linen, centerpieces of plastic roses.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A DJ booth sits abandoned, the music paused mid-song.", "para": 0, "sent": 4, "present": [0]}, {"u": 6, "kind": "action", "text": "XIMENA DELGADILLO-PARK (15, ball gown, tiara slipping, sneakers visible beneath the hem) stands alone on the dance floor, spotlit by a single light.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Behind a pillar, ABUELA CONSUELO (70s, black lace, rosary bracelet) watches her.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Across the room by the buffet, T\u00cdO RAMIRO (50s, shiny suit, tie loosened, wine glass in hand) leans on a table.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Where is he?", "name": "XIMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Nobody answers.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Where is my father?", "name": "XIMENA", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Ramiro sets his glass down.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Consuelo steps out from behind the pillar.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Mija.", "name": "CONSUELO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "He promised.", "name": "XIMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "He's on his way.", "name": "RAMIRO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "He said that at the church.", "name": "XIMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Traffic.", "name": "RAMIRO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "It's a Saturday, T\u00edo.", "name": "XIMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "The disco ball turns.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Little diamonds of light slide over the tables.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Come. Dance with your grandmother.", "name": "CONSUELO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "I don't want to dance.", "name": "XIMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Ximena.", "name": "CONSUELO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "It's my party and he isn't here.", "name": "XIMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "She yanks the tiara off and throws it across the floor.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "It skitters and spins under a table.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Ramiro starts forward; Consuelo raises a hand to stop him.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Ximena kicks off one sneaker, then the other.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "They bounce off the stage.", "para": 7, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Don't do this.", "name": "RAMIRO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Do what? Embarrass him?", "name": "XIMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Embarrass yourself.", "name": "RAMIRO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Good.", "name": "XIMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "She storms to the banquet table, grabs a tray of cupcakes, and sends it crashing to the floor.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "The hall freezes.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Frosting splatters.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "A distant guest gasps.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Consuelo and Ramiro both advance on her.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "She backs against the fountain and the chocolate wobbles in its tiers.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Mi amor.", "name": "CONSUELO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Don't call me that.", "name": "XIMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Ramiro stops.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Consuelo keeps coming.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "She holds out her arms, the rosary jangling.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "He isn't coming.", "name": "XIMENA", "speaker": 1, "ext": ["CONT'D"], "paren": ["a whisper"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "No.", "name": "CONSUELO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "He's never coming.", "name": "XIMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "No.", "name": "CONSUELO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "The girl crumples into her grandmother's arms.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "They stand there, a small black-lace shape and a large pink one, rocking.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Ramiro takes off his jacket and lays it on Ximena's shoulders.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "The DJ booth crackles.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "The paused song restarts, soft and slow.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "I'll dance with you, mija. I'm a terrible dancer.", "name": "RAMIRO", "speaker": 3, "ext": [], "paren": ["gruff"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Ximena laughs into the lace.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "She wipes her face.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "She looks up.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "You're the worst dancer I know.", "name": "XIMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "And yet here I am.", "name": "RAMIRO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "He offers his hand.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "She takes it.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "They walk onto the floor in her bare feet and his dress shoes, and Consuelo stands to the side, one hand to her heart.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}]}