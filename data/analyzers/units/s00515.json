{"scene_id": "s00515", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00515.fountain", "heading": "INT. CARTOGRAPHER'S MAP ROOM - ROYAL GEOGRAPHICAL SOCIETY - DAY - 1887", "cast": [{"id": 0, "name": "SIR RUPERT ASHBY-LOVELL", "names": ["SIR RUPERT ASHBY-LOVELL", "SIR RUPERT"], "gender": "?", "first": 5, "spoke": 11}, {"id": 1, "name": "MISS ANNELIESE BASU", "names": ["MISS ANNELIESE BASU", "ANNELIESE"], "gender": "?", "first": 7, "spoke": 7}, {"id": 2, "name": "THADDEUS OKEKE", "names": ["THADDEUS OKEKE", "THADDEUS"], "gender": "?", "first": 9, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. CARTOGRAPHER'S MAP ROOM - ROYAL GEOGRAPHICAL SOCIETY - DAY - 1887", "present": []}, {"u": 1, "kind": "action", "text": "A long hall lined with oak map drawers.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A skylight pours soft gray light onto a drafting table the size of a rowboat.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Globes in brass frames.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A smell of vellum, ink, and cold tea.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SIR RUPERT ASHBY-LOVELL (60s, silver whiskers, frock coat) stoops over the table, magnifying glass in hand.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A half-finished map of the Zambezi lies pinned open.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "MISS ANNELIESE BASU (30s, drafting apron, spectacles pushed up into her hair) stands at his shoulder, holding a bottle of india ink.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She is the only woman in the building not carrying a tray.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "On the far side of the table, MR. THADDEUS OKEKE (40s, young curator, ink stains on his cuffs, a chart tube under his arm) fidgets with a ruler.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "The river bends.", "name": "SIR RUPERT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "It does not.", "name": "ANNELIESE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "I have seen the sketches. It bends east.", "name": "SIR RUPERT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "You have seen one sketch. By a man who was never within a hundred miles.", "name": "ANNELIESE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Sir Rupert, if I may.", "name": "THADDEUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "You may not.", "name": "SIR RUPERT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "He may.", "name": "ANNELIESE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Miss Basu.", "name": "SIR RUPERT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Mr. Okeke measured it himself.", "name": "ANNELIESE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Three summers, sir. On foot. With a theodolite and a very bad mule.", "name": "THADDEUS", "speaker": 2, "ext": [], "paren": ["unrolling the chart"], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Sir Rupert straightens.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "The magnifying glass lowers.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "For a moment nobody speaks.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "A clock ticks.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Show me.", "name": "SIR RUPERT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Thaddeus spreads the chart.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The river on it runs straight, then bends west, a long soft curve.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Anneliese sets the india ink beside it.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Sir Rupert bends close.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "That is not on my map.", "name": "SIR RUPERT", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "No, sir.", "name": "ANNELIESE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "This will cost the Society a reprint.", "name": "SIR RUPERT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Seven hundred pounds.", "name": "THADDEUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Seven hundred.", "name": "SIR RUPERT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "It is a very small sum for being right.", "name": "ANNELIESE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "He eyes her.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "She meets his eye.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "A long, silent, civil duel of gazes.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Miss Basu, you are impertinent.", "name": "SIR RUPERT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Yes, sir.", "name": "ANNELIESE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Mr. Okeke, you are insubordinate.", "name": "SIR RUPERT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Yes, sir.", "name": "THADDEUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "You are both entirely correct.", "name": "SIR RUPERT", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "He takes the pen from the stand and, with a hand that trembles only slightly, strikes through the old river and begins to draw the new one.", "para": 7, "sent": 0, "present": [0, 1, 2]}]}