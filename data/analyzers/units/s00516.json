{"scene_id": "s00516", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00516.fountain", "heading": "INT. COURTROOM 4B - NIGHT", "cast": [{"id": 0, "name": "JUDGE HARRIET BALOGUN-REYNOLDS", "names": ["JUDGE HARRIET BALOGUN-REYNOLDS", "HARRIET"], "gender": "f", "first": 6, "spoke": 11}, {"id": 1, "name": "ATTORNEY QUIGLEY", "names": ["ATTORNEY QUIGLEY", "QUIGLEY"], "gender": "?", "first": 10, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. COURTROOM 4B - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A vast oak-paneled room, dark except for the red glow of an emergency exit sign.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A power outage has stopped the clocks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Benches are empty.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A stenographer's chair sits angled away from the bench.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The witness box stands open like an unlit stage.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "JUDGE HARRIET BALOGUN-REYNOLDS (60s, black robe, flashlight under her chin) sits at the bench, peering through reading glasses at a conference phone placed before her.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Its tiny green light is the only steady glow in the room.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "dialogue", "text": "For the record, we are proceeding under emergency conditions.", "name": "HARRIET", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0]}, {"u": 9, "kind": "action", "text": "The phone crackles.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "dialogue", "text": "Your Honor, I'm in the parking structure. My signal is poor. Can you hear me?", "name": "ATTORNEY QUIGLEY", "speaker": 1, "ext": ["V.O."], "paren": ["through the speaker, tinny"], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Barely, Counselor.", "name": "HARRIET", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Your Honor, I move for a continuance.", "name": "QUIGLEY", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Denied.", "name": "HARRIET", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Your Honor, the power is out.", "name": "QUIGLEY", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "The law is not.", "name": "HARRIET", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She sets down her flashlight.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "It rolls.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She chases it with two fingers, mutters.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Forty years. Never a continuance for weather.", "name": "HARRIET", "speaker": 0, "ext": ["CONT'D"], "paren": ["to herself"], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "I didn't catch that.", "name": "QUIGLEY", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "You weren't meant to.", "name": "HARRIET", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "She rubs her eyes.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "The sign hums.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "The silence stretches.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Counselor, your client has been waiting nine months for this hearing.", "name": "HARRIET", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "He's waiting in the car.", "name": "QUIGLEY", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Bring him up.", "name": "HARRIET", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Your Honor?", "name": "QUIGLEY", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Stairs. Eleven flights. By candlelight if necessary.", "name": "HARRIET", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Your Honor, he's seventy-eight.", "name": "QUIGLEY", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "I know how old he is.", "name": "HARRIET", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "A pause.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "A long breath crackles on the line.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "We'll be there in twenty minutes.", "name": "QUIGLEY", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Take thirty.", "name": "HARRIET", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "She switches off the flashlight.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "The red sign glows.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "She folds her hands, a small figure in a great black robe, and waits.", "para": 6, "sent": 2, "present": [0, 1]}]}