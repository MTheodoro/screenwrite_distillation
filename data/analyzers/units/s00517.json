{"scene_id": "s00517", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00517.fountain", "heading": "EXT. WATER TOWER - STALLED TRAIN - HIGH DESERT - DAY", "cast": [{"id": 0, "name": "ENGINEER SILAS DUNBAR", "names": ["ENGINEER SILAS DUNBAR", "SILAS"], "gender": "?", "first": 6, "spoke": 2}, {"id": 1, "name": "FIREMAN CALLUM NAKAGAWA", "names": ["FIREMAN CALLUM NAKAGAWA", "CALLUM"], "gender": "?", "first": 7, "spoke": 2}, {"id": 2, "name": "MARSHAL DELPHINE ARCENEAUX", "names": ["MARSHAL DELPHINE ARCENEAUX", "DELPHINE"], "gender": "f", "first": 8, "spoke": 4}, {"id": 3, "name": "CONDUCTOR BARTHOLOMEW ENGSTROM", "names": ["CONDUCTOR BARTHOLOMEW ENGSTROM", "BARTHOLOMEW"], "gender": "?", "first": 10, "spoke": 1}, {"id": 4, "name": "TELEGRAPH CLERK", "names": ["TELEGRAPH CLERK"], "gender": "?", "first": 12, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. WATER TOWER - STALLED TRAIN - HIGH DESERT - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A locomotive idles at a sun-blasted siding.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The wooden tank towers above, dripping from its spout.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dust.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A coil of rope.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A line of boxcars stretching behind into the heat.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "ENGINEER SILAS DUNBAR (50s, striped cap, grease to the elbows) hangs from the water spout, wrestling the chain.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Below him, FIREMAN CALLUM NAKAGAWA (20s, bare-chested, black with soot) braces the ladder.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Standing in the shade of the tank, hand on her pistol, waits MARSHAL DELPHINE ARCENEAUX (40s, tan duster, silver badge).", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "A telegraph key chatters from the little station beside the track.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Up on the first boxcar roof, CONDUCTOR BARTHOLOMEW ENGSTROM (60s, brass buttons, pocket watch) cups his hands to his mouth.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Passengers inside! Shutters down!", "name": "BARTHOLOMEW", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Marshal! Wire from Santa Fe! Riders on the ridge!", "name": "TELEGRAPH CLERK", "speaker": 4, "ext": ["O.S."], "paren": ["shouting from the station"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "How many?", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Eight! Maybe ten!", "name": "TELEGRAPH CLERK", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Callum, haul!", "name": "SILAS", "speaker": 0, "ext": [], "paren": ["from the spout"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Hauling!", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Silas, how long for the tank?", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Five minutes!", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "You have two.", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Callum strains on the chain.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "The spout swings; water crashes down in a silver wall, drenching the three of them as they grab the ladder, the pipe, the pistol, and scatter in separate directions.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Silas drops to the ties.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Callum leaps for the cab.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Delphine drops to one knee and raises her rifle toward the ridge.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "On the ridge, tiny horsemen appear against the sky.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Callum! Full steam!", "name": "DELPHINE", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Aye!", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "The locomotive shrieks.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Steam bursts.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "The train lurches forward.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}]}