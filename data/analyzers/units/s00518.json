{"scene_id": "s00518", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00518.fountain", "heading": "INT. FUNICULAR RAILWAY - CAR 2 - NIGHT", "cast": [{"id": 0, "name": "IMANI KARANJA-WELLS", "names": ["IMANI KARANJA-WELLS", "IMANI"], "gender": "?", "first": 5, "spoke": 17}, {"id": 1, "name": "MAN", "names": ["MAN"], "gender": "?", "first": 11, "spoke": 0}, {"id": 2, "name": "IGNATIUS ABRAMOWITZ", "names": ["IGNATIUS ABRAMOWITZ", "IGNATIUS"], "gender": "?", "first": 11, "spoke": 16}, {"id": 3, "name": "ENRIQUE VALD", "names": ["ENRIQUE VALD", "ENRIQUE"], "gender": "?", "first": 57, "spoke": 1}, {"id": 4, "name": "S-MORROW", "names": ["S-MORROW"], "gender": "?", "first": 57, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. FUNICULAR RAILWAY - CAR 2 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A steep little tram climbing a mountain of lights.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wooden benches, brass rails, windows fogged from breath.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Below, the city sprawls like spilled jewelry.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The cable hums.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "IMANI KARANJA-WELLS (30s, wool coat, camera bag) sits alone on a bench, bundled against the cold.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She gazes at the city.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "A thermos cup warms her hands.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "Across the aisle, at the far end, an old couple's empty seats.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "A conductor's bell hangs unrung.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "The car climbs, slow and gentle.", "para": 2, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "At the next stop, the doors hiss open and a MAN steps in, dusting snow from his shoulders: IGNATIUS ABRAMOWITZ (30s, big red scarf, paper bag of roasted chestnuts).", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "He freezes at the sight of her.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Imani?", "name": "IGNATIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Ignatius.", "name": "IMANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "I thought you were in Lisbon.", "name": "IGNATIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "I was in Lisbon. Then I wasn't.", "name": "IMANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "How long?", "name": "IGNATIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Three weeks.", "name": "IMANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "He nods.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "He sits down, one bench across.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "The doors close.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "The car climbs on.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Chestnut?", "name": "IGNATIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Sure.", "name": "IMANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "He passes the bag.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "She takes one.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "It burns her fingers.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "She tosses it from hand to hand.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "They're hot.", "name": "IGNATIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "I noticed.", "name": "IMANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The city drops away below the windows.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "I got your postcard.", "name": "IGNATIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Did you?", "name": "IMANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Three of them. They all said the same thing.", "name": "IGNATIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Which was?", "name": "IMANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "\"Wish you were here.\"", "name": "IGNATIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "That's the whole message.", "name": "IMANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "It's an interesting message to send to a man you left.", "name": "IGNATIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "She says nothing.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "She cracks the chestnut.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Eats half.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Offers him the rest.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "He takes it.", "para": 7, "sent": 4, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "I didn't leave you.", "name": "IMANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "You left a note.", "name": "IGNATIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "I left a note because I couldn't say it.", "name": "IMANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Say what?", "name": "IGNATIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "That I was scared.", "name": "IMANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "A light flickers on the car's ceiling.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "The funicular shudders to a halt.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Silence.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "The cable stops humming.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "Are we stuck?", "name": "IGNATIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "Looks like it.", "name": "IMANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "A third voice, rough and breathless, cuts in from the platform as the door slides open.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "A conductor in a gray cap, ENRIQUE VALD\u00c9S-MORROW (60s, whistle around his neck, lantern swinging), leans into the car.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "Power cut, folks. Ten minutes. Sit tight.", "name": "ENRIQUE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "Thank you.", "name": "IMANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "We're not going anywhere.", "name": "IGNATIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "Enrique glances from one to the other.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "He tips his cap and slides the door shut.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "dialogue", "text": "You said that on purpose.", "name": "IMANI", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "dialogue", "text": "Which part?", "name": "IGNATIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "We're not going anywhere.", "name": "IMANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "He looks at the city.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "action", "text": "Its lights shimmer through the fogged glass.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "dialogue", "text": "I meant it.", "name": "IGNATIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "She leans her head against the window.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "action", "text": "A tiny smile.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "dialogue", "text": "Ten minutes.", "name": "IMANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "dialogue", "text": "Ten minutes.", "name": "IGNATIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "dialogue", "text": "Then say something.", "name": "IMANI", "speaker": 0, "ext": [], "paren": ["very softly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "action", "text": "He opens his mouth.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "action", "text": "Outside, all the lights in the city flicker, die, and then, one by one, come back.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}]}