{"scene_id": "s00519", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00519.fountain", "heading": "INT. CLOCK REPAIR SHOP - DAY", "cast": [{"id": 0, "name": "CLEMENTINE HAWTHORNE-DIAZ", "names": ["CLEMENTINE HAWTHORNE-DIAZ", "CLEMENTINE"], "gender": "f", "first": 6, "spoke": 6}, {"id": 1, "name": "BLESSING OYELARAN", "names": ["BLESSING OYELARAN", "BLESSING"], "gender": "?", "first": 7, "spoke": 4}, {"id": 2, "name": "DETECTIVE MARCELLINE ROUX", "names": ["DETECTIVE MARCELLINE ROUX", "ROUX"], "gender": "f", "first": 8, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. CLOCK REPAIR SHOP - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A cramped shop crowded with ticking.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wall clocks, cuckoo clocks, a grandfather in a corner.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Brass gears on a velvet tray.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A lamp with a magnifying arm.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Dust motes drift in the window light.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "CLEMENTINE HAWTHORNE-DIAZ (50s, watchmaker's loupe on a headband, apron full of tiny tools) bends over a pocket watch, tweezers in hand.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Her assistant BLESSING OYELARAN (20s, sleeves pushed up) sits at a second bench polishing a mainspring.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Across the counter stands DETECTIVE MARCELLINE ROUX (40s, trench coat, notebook), who has been silent for some time.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "It stopped at 9:47.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I know.", "name": "ROUX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Someone smashed the crystal.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "I know.", "name": "ROUX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "And bent the hands. Somebody wanted it to stop there.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Yes.", "name": "ROUX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "She sets down the tweezers.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Blessing looks up.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Roux flips a page of her notebook.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "When did you sell it?", "name": "ROUX", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "March. A woman came in. Tall. Hat. She paid in cash.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Name?", "name": "ROUX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "She didn't give one.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "She did.", "name": "BLESSING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Clementine turns to her.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Blessing shrinks.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "When I wrote the receipt. She said Pettigrew.", "name": "BLESSING", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Pettigrew?", "name": "ROUX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "She spelled it. P-E-T-T-I-G-R-E-W.", "name": "BLESSING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "That's the victim's name.", "name": "ROUX", "speaker": 2, "ext": [], "paren": ["writing"], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "A cuckoo clock chimes.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "The bird shoots out, crying, and retreats.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Clementine waits for it to finish before she speaks.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "She bought her own watch.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Or someone wanted me to think so.", "name": "ROUX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Why would she smash it?", "name": "BLESSING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Because she wasn't the one who died at 9:47.", "name": "ROUX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "The grandfather clock ticks once.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Twice.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Roux closes her notebook and gazes at the face of every clock in the room.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Every one of them shows a slightly different time.", "para": 6, "sent": 0, "present": [0, 1, 2]}]}