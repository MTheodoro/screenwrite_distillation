{"scene_id": "s00520", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00520.fountain", "heading": "INT. CHEESE AGING CAVE - NIGHT", "cast": [{"id": 0, "name": "OSEI ADJEI-BOATENG", "names": ["OSEI ADJEI-BOATENG", "OSEI"], "gender": "m", "first": 5, "spoke": 13}, {"id": 1, "name": "PRIYA RAMANATHAN", "names": ["PRIYA RAMANATHAN", "PRIYA"], "gender": "m", "first": 8, "spoke": 11}, {"id": 2, "name": "RADIO", "names": ["RADIO"], "gender": "m", "first": 53, "spoke": 0}, {"id": 3, "name": "MARGUERITE", "names": ["MARGUERITE"], "gender": "?", "first": 54, "spoke": 4}, {"id": 4, "name": "DMITRI VOLKOV", "names": ["DMITRI VOLKOV", "DMITRI"], "gender": "m", "first": 67, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. CHEESE AGING CAVE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Limestone walls sweat.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Racks of wheels, floor to ceiling.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Cold.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Blue work-lights hum.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "OSEI ADJEI-BOATENG, 40s, hairnet, rubber apron, taps a wheel with a brass mallet.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Listens.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Moves on.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "PRIYA RAMANATHAN, 20s, clipboard, headlamp, trails him.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "New hire.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Overeager.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Eleven months on that one?", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Fourteen.", "name": "OSEI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "It sounds hollow.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "It sounds fine.", "name": "OSEI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "He keeps walking.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She keeps writing.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "A rack of Alpine wheels.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Humidity gauge.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Everything in order.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Nobody else works nights?", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Nobody else wants to.", "name": "OSEI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Why do you?", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Quiet.", "name": "OSEI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "A drip.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Somewhere deep in the cave, metal clicks.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Soft.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Regular.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Priya glances up.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Osei does not.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Is that --", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Pipes.", "name": "OSEI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Beat.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "The clicking stops.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Priya relaxes.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Laughs at herself.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Sorry. First week. Everything's a ghost.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "There's coffee in the cold room. Go. Warm up.", "name": "OSEI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "You sure?", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Go.", "name": "OSEI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "She goes.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Her headlamp swings away down the aisle.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Osei waits.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Counts her footsteps.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "Silence.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "He crouches.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Pulls a wheel half out of the lowest rack.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Behind it: a gap.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Duffel bag.", "para": 11, "sent": 3, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "He unzips it.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "Cash.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "Banded.", "para": 12, "sent": 2, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "Stacks of it.", "para": 12, "sent": 3, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "A RADIO crackles on his belt.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "Osei. Dock camera shows a van.", "name": "MARGUERITE", "speaker": 3, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Not mine.", "name": "OSEI", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Nobody's on the schedule tonight. Nobody.", "name": "MARGUERITE", "speaker": 3, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Osei zips the bag.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "Stands.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "Looks toward the cold room.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "The new girl. Who hired her?", "name": "OSEI", "speaker": 0, "ext": [], "paren": ["into radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "Nobody hired her.", "name": "MARGUERITE", "speaker": 3, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "Osei's hand goes to the mallet.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "Footsteps.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "Not Priya's.", "para": 16, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "Heavy.", "para": 16, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "Behind him.", "para": 16, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "DMITRI VOLKOV, 50s, wet wool coat, gray stubble, steps out from between two racks.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "action", "text": "Hands in pockets.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "Smiling like a man at a funeral reception.", "para": 17, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "dialogue", "text": "Osei. Good. Saved me the search.", "name": "DMITRI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "dialogue", "text": "You're early.", "name": "OSEI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "dialogue", "text": "She's very good, no? The girl. Two weeks of paperwork. Fourteen months of cheese.", "name": "DMITRI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "action", "text": "Priya returns.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "action", "text": "No clipboard.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "action", "text": "No headlamp.", "para": 18, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 76, "kind": "action", "text": "A small pistol, held steady.", "para": 18, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 77, "kind": "dialogue", "text": "Bag.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": ["flat"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 78, "kind": "action", "text": "Osei lifts the duffel.", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 79, "kind": "action", "text": "Slowly.", "para": 19, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 80, "kind": "dialogue", "text": "Your coffee's cold.", "name": "OSEI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 81, "kind": "dialogue", "text": "So are you.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 82, "kind": "action", "text": "Dmitri takes the bag.", "para": 20, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 83, "kind": "action", "text": "Weighs it in one hand.", "para": 20, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 84, "kind": "dialogue", "text": "Count it.", "name": "DMITRI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 85, "kind": "dialogue", "text": "I did. Last Tuesday.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 86, "kind": "action", "text": "Osei looks at the mallet.", "para": 21, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 87, "kind": "action", "text": "At the wheel.", "para": 21, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 88, "kind": "action", "text": "At the exit.", "para": 21, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 89, "kind": "dialogue", "text": "Osei? Osei, answer me.", "name": "MARGUERITE", "speaker": 3, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 90, "kind": "action", "text": "Dmitri plucks the radio off his belt.", "para": 22, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 91, "kind": "action", "text": "Turns it off.", "para": 22, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 92, "kind": "dialogue", "text": "She talks a lot, your wife.", "name": "DMITRI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 93, "kind": "action", "text": "Osei's jaw sets.", "para": 23, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 94, "kind": "dialogue", "text": "She's calling the police.", "name": "OSEI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 95, "kind": "dialogue", "text": "She is calling the dock. The dock is mine.", "name": "DMITRI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 96, "kind": "action", "text": "Priya cocks the pistol.", "para": 24, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 97, "kind": "action", "text": "The click echoes down the cave.", "para": 24, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 98, "kind": "action", "text": "The same click from before.", "para": 24, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 99, "kind": "action", "text": "Osei closes his eyes.", "para": 25, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 100, "kind": "dialogue", "text": "Pipes.", "name": "OSEI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 101, "kind": "dialogue", "text": "Pipes.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}