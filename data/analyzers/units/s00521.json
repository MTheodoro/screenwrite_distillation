{"scene_id": "s00521", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00521.fountain", "heading": "INT. LAUNDROMAT - 3 A.M.", "cast": [{"id": 0, "name": "NKEM OKPARA", "names": ["NKEM OKPARA", "NKEM"], "gender": "?", "first": 3, "spoke": 6}, {"id": 1, "name": "BART", "names": ["BART"], "gender": "?", "first": 4, "spoke": 6}, {"id": 2, "name": "LENNOX", "names": ["LENNOX"], "gender": "?", "first": 4, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAUNDROMAT - 3 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent hum.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "One dryer turning, a single red sock tumbling.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "NKEM OKPARA, 30s, in a hospital lanyard, stares at a folded child's pajama set.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "BARTHOLOMEW \"BART\" LENNOX, 60s, mop in hand, watches from the doorway.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "You been here since midnight. Machine two's been done since one.", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "I know.", "name": "NKEM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "She does not move.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Bart steps closer.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Whose are they?", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Mine! They were -- they're mine, I'm allowed to wash them!", "name": "NKEM", "speaker": 0, "ext": [], "paren": ["sudden, loud"], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "She hurls the pajamas at the dryer.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "They slap the glass.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Bart does not flinch.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Nobody said you weren't.", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Stop being nice to me.", "name": "NKEM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Can't help it.", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I SAID --", "name": "NKEM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Okay.", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Stop!", "name": "NKEM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "The red sock turns.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Nkem slides down the machine to the floor.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "She's seven. She's fine. She's in a bed upstairs, and she's fine.", "name": "NKEM", "speaker": 0, "ext": ["CONT'D"], "paren": ["quiet"], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Bart sits on an upturned bucket.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Then fold the rest.", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}