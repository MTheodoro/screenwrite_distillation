{"scene_id": "s00522", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00522.fountain", "heading": "INT. NIGHT FERRY - CAR DECK - NIGHT", "cast": [{"id": 0, "name": "ISOLDE VANTERPOOL", "names": ["ISOLDE VANTERPOOL", "ISOLDE"], "gender": "f", "first": 5, "spoke": 13}, {"id": 1, "name": "RAFFERTY KANE", "names": ["RAFFERTY KANE", "RAFFERTY"], "gender": "f", "first": 11, "spoke": 7}, {"id": 2, "name": "JUNG-HO PARK", "names": ["JUNG-HO PARK", "JUNG-HO"], "gender": "m", "first": 18, "spoke": 4}, {"id": 3, "name": "WINNIE ASHCROFT-DELANEY", "names": ["WINNIE ASHCROFT-DELANEY", "WINNIE"], "gender": "f", "first": 25, "spoke": 5}, {"id": 4, "name": "SALAZAR", "names": ["SALAZAR"], "gender": "?", "first": 36, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT FERRY - CAR DECK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Diesel.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Chains rattling.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Forty cars, bumper to bumper, under caged yellow lights.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The ship rolls, barely.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ISOLDE VANTERPOOL, 30s, purser's vest, walks the lanes with a flashlight.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She checks each windshield.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Ticks a list.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "She stops at a white delivery van.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Taps the hood.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "Moves on.", "para": 2, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "RAFFERTY KANE, 50s, a trucker in a stained cap, sits on a bumper with a thermos.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He raises it in greeting.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Evening, miss. Lovely crossing.", "name": "RAFFERTY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Smooth water tonight.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "That's what I said to my ex-wife. Look how that ended.", "name": "RAFFERTY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She almost smiles.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Writes something down.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "JUNG-HO PARK, 20s, headphones around his neck, leans out of a hatchback, bleary.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "He yawns.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Is there a vending machine on this deck?", "name": "JUNG-HO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Passenger lounge. Deck four.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Of course there is.", "name": "JUNG-HO", "speaker": 2, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "He ducks back in.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Isolde keeps walking.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "WINNIE ASHCROFT-DELANEY, 70s, a tartan blanket over her knees, sits in a small hatchback, window cracked.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "A cat carrier on her lap.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Does anybody know if the cats are allowed out for the crossing?", "name": "WINNIE", "speaker": 3, "ext": [], "paren": ["to the group, generally"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Rules say no.", "name": "RAFFERTY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Rules say. Hm.", "name": "WINNIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Isolde leans down to her window.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Ma'am, I'll check on her in an hour. Promise.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "It's a him.", "name": "WINNIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "I'll check on him in an hour.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "She straightens.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Her radio squawks.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Purser to bridge. Purser to bridge. Please confirm car count.", "name": "SALAZAR", "speaker": 4, "ext": ["V.O."], "paren": ["over PA"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Isolde keys her radio.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Forty-one, Captain. Forty-one vehicles.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Say again.", "name": "SALAZAR", "speaker": 4, "ext": ["V.O."], "paren": ["over PA"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Forty-one.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "A long pause.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Static.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Manifest says forty.", "name": "SALAZAR", "speaker": 4, "ext": ["V.O."], "paren": ["over PA"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "She stops walking.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Forty-one.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": ["quietly, to herself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "She turns slowly.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Eyes down the lanes.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Counting under her breath.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Rafferty watches her.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "The thermos stops halfway to his mouth.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "Something wrong, love?", "name": "RAFFERTY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "Nothing. Routine.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "She isn't convincing.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "She moves down the aisle, flashlight low.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Stops at the white van again.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Plates: out of state.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "Not on her list.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "She hadn't ticked it because she hadn't noticed it.", "para": 16, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "It had been there, quiet, like furniture.", "para": 16, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "She reaches for the rear door handle.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "Locked.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "dialogue", "text": "Hey, uh. That van was here when I parked.", "name": "JUNG-HO", "speaker": 2, "ext": [], "paren": ["from his car"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "dialogue", "text": "Which means?", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "dialogue", "text": "Means nobody got out of it. Not once. I've been watching.", "name": "JUNG-HO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "Rafferty sets down the thermos.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "Stands up.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "action", "text": "Slow.", "para": 18, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "dialogue", "text": "Miss. Step back.", "name": "RAFFERTY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "dialogue", "text": "Why?", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "dialogue", "text": "Because I'm a driver. And I know what that engine sounds like when it's not an engine.", "name": "RAFFERTY", "speaker": 1, "ext": [], "paren": ["very calm"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "action", "text": "Isolde listens.", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "action", "text": "Underneath the diesel and the chains, a thin electric whine.", "para": 19, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "action", "text": "Steady.", "para": 19, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "action", "text": "Patient.", "para": 19, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "action", "text": "She backs away.", "para": 20, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 76, "kind": "action", "text": "One step.", "para": 20, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 77, "kind": "action", "text": "Two.", "para": 20, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 78, "kind": "dialogue", "text": "Captain. Evacuate the car deck. All hands. Now.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": ["into radio, steady"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 79, "kind": "dialogue", "text": "Purser, what is it?", "name": "SALAZAR", "speaker": 4, "ext": ["V.O."], "paren": ["over PA"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 80, "kind": "action", "text": "Winnie rolls her window up.", "para": 21, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 81, "kind": "action", "text": "Clutches the carrier.", "para": 21, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 82, "kind": "dialogue", "text": "Hush, hush, hush.", "name": "WINNIE", "speaker": 3, "ext": [], "paren": ["to the cat, muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 83, "kind": "action", "text": "Jung-Ho is already out of the hatchback, running for the stairwell.", "para": 22, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 84, "kind": "action", "text": "The van's side door slides open an inch.", "para": 23, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 85, "kind": "action", "text": "A single hand reaches out.", "para": 23, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 86, "kind": "action", "text": "Pale.", "para": 23, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 87, "kind": "action", "text": "Gloved.", "para": 23, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 88, "kind": "action", "text": "It sets a small black box on the deck.", "para": 23, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 89, "kind": "action", "text": "Then the door slides shut again.", "para": 24, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 90, "kind": "action", "text": "The whine climbs.", "para": 25, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 91, "kind": "dialogue", "text": "EVERYBODY OUT! MOVE!", "name": "RAFFERTY", "speaker": 1, "ext": [], "paren": ["shouting to the whole deck"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 92, "kind": "action", "text": "Isolde grabs Winnie's door.", "para": 26, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 93, "kind": "action", "text": "Yanks it open.", "para": 26, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 94, "kind": "dialogue", "text": "Ma'am. Leave the car.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 95, "kind": "dialogue", "text": "The cat --", "name": "WINNIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 96, "kind": "dialogue", "text": "Bring the cat.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 97, "kind": "action", "text": "They run.", "para": 27, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 98, "kind": "action", "text": "Behind them the black box blinks once.", "para": 27, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 99, "kind": "action", "text": "Green.", "para": 27, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 100, "kind": "action", "text": "Then red.", "para": 28, "sent": 0, "present": [0, 1, 2, 3, 4]}]}