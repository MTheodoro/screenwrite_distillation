{"scene_id": "s00523", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00523.fountain", "heading": "EXT. RICE TERRACE BUNKER - DAWN", "cast": [{"id": 0, "name": "LIEUTENANT NIKOLA VASKO", "names": ["LIEUTENANT NIKOLA VASKO", "VASKO"], "gender": "m", "first": 5, "spoke": 6}, {"id": 1, "name": "CORPORAL ABEBE TESFAYE", "names": ["CORPORAL ABEBE TESFAYE", "ABEBE"], "gender": "m", "first": 7, "spoke": 7}, {"id": 2, "name": "LINNEA STROM", "names": ["LINNEA STROM", "LINNEA"], "gender": "f", "first": 33, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. RICE TERRACE BUNKER - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Mud.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Standing water, ankle deep.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Sandbags slumped like drunks.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A shell crater full of rain.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LIEUTENANT NIKOLA VASKO, 30s, helmet gone, one sleeve black with blood, sits against the sandbags.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Staring at nothing.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "CORPORAL ABEBE TESFAYE, 20s, kneels beside him.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Rifle across his knees.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Hands shaking.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "The guns have stopped.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "That is the horror of it.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Sir. Sir, it's quiet.", "name": "ABEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "I hear.", "name": "VASKO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Should we go?", "name": "ABEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Where?", "name": "VASKO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Abebe has no answer.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "A bird starts up in the flooded trees.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Another.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "They're singing.", "name": "ABEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "They don't know.", "name": "VASKO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Abebe unslings his canteen.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Offers it.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Vasko drinks.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Hands it back.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "How many?", "name": "VASKO", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Two of us.", "name": "ABEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Three. Count the radio man.", "name": "VASKO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "He's not -- sir. He's not counting.", "name": "ABEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Vasko closes his eyes.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Nods.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Boots in the mud.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Abebe snaps his rifle up.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "LINNEA STROM, 30s, a red cross on her armband, comes over the dike with a canvas bag.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "She is soaked to the thigh.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "She raises both hands slowly.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Medic. Don't.", "name": "LINNEA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Abebe lowers the rifle an inch.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Which side?", "name": "ABEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Yours. I think.", "name": "LINNEA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "She kneels at Vasko.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Cuts the sleeve with scissors.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "He doesn't look.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Lieutenant. Stay with me.", "name": "LINNEA", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "I'm here.", "name": "VASKO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Good. Keep being here.", "name": "LINNEA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Abebe sits.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "The rifle slides into the water.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "He lets it.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Is it over?", "name": "ABEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "For today.", "name": "LINNEA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "She pulls a bandage tight.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Vasko hisses.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "The sun clears the ridge.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Light spills across the flooded terrace, gold on grey.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Nobody speaks.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Birds go on singing.", "para": 14, "sent": 1, "present": [0, 1, 2]}]}