{"scene_id": "s00524", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00524.fountain", "heading": "INT. PELL & SONS CLOCKMAKERS - NIGHT", "cast": [{"id": 0, "name": "INSPECTOR FOLASADE OYELARAN", "names": ["INSPECTOR FOLASADE OYELARAN", "OYELARAN"], "gender": "?", "first": 5, "spoke": 16}, {"id": 1, "name": "CEDRIC PELL", "names": ["CEDRIC PELL", "PELL"], "gender": "m", "first": 6, "spoke": 14}, {"id": 2, "name": "TELEPHONE", "names": ["TELEPHONE"], "gender": "?", "first": 34, "spoke": 0}, {"id": 3, "name": "DELPHINE", "names": ["DELPHINE"], "gender": "?", "first": 45, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. PELL & SONS CLOCKMAKERS - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A narrow shop that has outlived its century.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Two hundred clocks line the walls, each a different hour, each ticking out of step, so that the room breathes like a sleeping animal.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Brass, walnut, bone.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single green-shaded lamp burns on the workbench.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "INSPECTOR FOLASADE OYELARAN, 50s, a grey raincoat dripping onto the floorboards, stands in the middle of this noise with the stillness of someone used to being the only quiet thing in a room.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "CEDRIC PELL, 60s, watchmaker's loupe pushed up into thinning hair, sits at the bench, a half-assembled movement before him.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "His hands are steady.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "His eyes are not.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Mr. Pell, you told the constable you were home all evening.", "name": "OYELARAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I was home. Upstairs. I live above the shop, Inspector.", "name": "PELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Yet your lamp was lit down here at nine.", "name": "OYELARAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Clocks do not repair themselves.", "name": "PELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "A cuckoo bursts from a wall case.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Nine-thirty on some forgotten schedule.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Pell flinches.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Oyelaran does not.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "You flinch at that one.", "name": "OYELARAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "It was my wife's. She wound it every morning for thirty years.", "name": "PELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "And Mr. Hartigan? Did he wind anything?", "name": "OYELARAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "I don't know a Hartigan.", "name": "PELL", "speaker": 1, "ext": [], "paren": ["too quickly"], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "The cuckoo retreats.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "A grandfather clock tolls once, deep and wet, as though underwater.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Oyelaran crosses to the bench.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Lifts the movement between two fingers.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Turns it to the light.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Interesting. The mainspring is brand new. The rest is a hundred years old.", "name": "OYELARAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Restorations are mixed.", "name": "PELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Mr. Hartigan's watch was found in the canal this afternoon. Stopped at 8:52.", "name": "OYELARAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Pell goes very still.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Water does that.", "name": "PELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Water doesn't wind a mainspring backward, Mr. Pell.", "name": "OYELARAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Two hundred clocks and not one of them says the same time.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "A TELEPHONE rings on the wall.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Old rotary.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Black.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "It rings and rings.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Let it.", "name": "PELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "No. I think you should answer.", "name": "OYELARAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Pell rises.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Crosses.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Lifts the receiver.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Listens.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "His face loses its color.", "para": 9, "sent": 4, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Cedric? Papa? Are they there yet?", "name": "DELPHINE", "speaker": 3, "ext": ["V.O."], "paren": ["over phone, thin"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Delphine, not now.", "name": "PELL", "speaker": 1, "ext": [], "paren": ["into phone, hoarse"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "I did what you said. I put the watch in the canal. But Papa, it was still ticking when I --", "name": "DELPHINE", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Pell slams the receiver down.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Too late.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "The line was open long enough.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Oyelaran has not moved.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Her voice is gentle, almost tender.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Your daughter is very honest.", "name": "OYELARAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "She is a child.", "name": "PELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "She is twenty-six.", "name": "OYELARAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Pell sinks onto the stool.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "The loupe falls from his hair and rolls across the bench, stopping against a screwdriver.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "He came for the shop. He wanted the building. Hartigan, he said it was only a matter of time before the street --", "name": "PELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "So you wound his watch backward and put him in the canal.", "name": "OYELARAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "No!", "name": "PELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "He stands again, trembling.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "The anger rises up out of him like steam.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "No. I did not touch the man. He fell. I swear to you, he fell, he was on the stairs, he laughed at me, Inspector, he laughed at my wife's cuckoo --", "name": "PELL", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "Mr. Pell.", "name": "OYELARAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "-- and I only wanted him quiet --", "name": "PELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "Cedric.", "name": "OYELARAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "He stops.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "Breathing hard.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "dialogue", "text": "Sit down.", "name": "OYELARAN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "He sits.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "The cuckoo bursts again, absurd, bright.", "para": 15, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "action", "text": "Both of them watch it.", "para": 15, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "She never could stand that bird.", "name": "PELL", "speaker": 1, "ext": [], "paren": ["small"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "Oyelaran almost smiles.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "Almost.", "para": 16, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "dialogue", "text": "I will need the key to the cellar.", "name": "OYELARAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "Pell's hand moves to his waistcoat.", "para": 17, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "action", "text": "The chain.", "para": 17, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "action", "text": "A small brass key.", "para": 17, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "action", "text": "He holds it out across the bench.", "para": 17, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "action", "text": "She takes it.", "para": 18, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "action", "text": "The lamp flickers.", "para": 18, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "action", "text": "The telephone begins to ring again.", "para": 19, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 84, "kind": "dialogue", "text": "Let it ring.", "name": "OYELARAN", "speaker": 0, "ext": ["CONT'D"], "paren": ["gently"], "dual": false, "present": [0, 1, 2, 3]}]}