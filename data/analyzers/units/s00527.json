{"scene_id": "s00527", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00527.fountain", "heading": "EXT. SALT FLATS TELEGRAPH RELAY - DAY", "cast": [{"id": 0, "name": "SADIE MULVANEY", "names": ["SADIE MULVANEY", "SADIE"], "gender": "?", "first": 5, "spoke": 13}, {"id": 1, "name": "ELIAS CROW", "names": ["ELIAS CROW", "ELIAS"], "gender": "?", "first": 7, "spoke": 12}, {"id": 2, "name": "TEODORA VEGA", "names": ["TEODORA VEGA", "TEODORA"], "gender": "f", "first": 19, "spoke": 8}, {"id": 3, "name": "PIKE", "names": ["PIKE"], "gender": "m", "first": 28, "spoke": 8}, {"id": 4, "name": "WHISTLER", "names": ["WHISTLER"], "gender": "m", "first": 29, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SALT FLATS TELEGRAPH RELAY - DAY", "present": []}, {"u": 1, "kind": "action", "text": "White to every horizon.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A shack on stilts.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single pole line running away into heat shimmer.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The sky is the color of a new nickel.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SADIE MULVANEY, 30s, hat low, Winchester across her lap, sits on the porch rail.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She is shelling pistachios with one hand.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "ELIAS CROW, 50s, relay operator, bald, sleeves rolled, sits on a barrel beside her, drinking from a tin cup.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Calm.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Too calm.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Inside, through the open door: the steady TAP-TAP-TAP of the key.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Wire's working.", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Always does.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Thought they cut the line at Dry Fork.", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "They did.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She looks at him.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He keeps drinking.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "A dust plume.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Three riders, far off, coming slow.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "TEODORA VEGA, 20s, a bandolier and a bad limp, steps out of the shack carrying a coffeepot.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "She sets it down on the boards.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Riders.", "name": "TEODORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "I see them.", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Elias, did you --", "name": "TEODORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Sit, Teo. Pour.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "She pours.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Sadie accepts a cup.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "The riders grow.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "PIKE, 40s, a grey duster, leads them in on a bay mare.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Behind him, WHISTLER, 20s, a boy with a tin whistle in his teeth, and no one else.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Just two.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "They stop at the hitching rail.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Pike tips his hat.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Miss Mulvaney.", "name": "PIKE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Pike.", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Heard you were dead.", "name": "PIKE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Heard the same about you.", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Whistler blows a thin note and grins.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Teodora's hand drifts toward her hip.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Tell the boy to quit that.", "name": "TEODORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Tell the lady I'm sorry.", "name": "WHISTLER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Easy, Whistle.", "name": "PIKE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Gentlemen. There's coffee. There's shade. Nobody needs to die before noon.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Elias, you old rat. You look well.", "name": "PIKE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "I look the same.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "You knew they were coming.", "name": "SADIE", "speaker": 0, "ext": [], "paren": ["to Elias"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Didn't know. Hoped.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "That's not the same thing.", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "What did you do, Elias?", "name": "TEODORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "He sent the wire.", "name": "PIKE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Quiet.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "The tapping inside goes on.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "No one is at the key.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Sadie looks at the door.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "Then at Teodora.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Then at Elias, who sets his tin cup carefully on the rail.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Autopilot. Rig's on a timer.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "A timer for what?", "name": "TEODORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "The Army, Teo. Forty men. Forty-one miles. They'll be here before dark.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "You sold us.", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "I sold a salt shack and a dead line. And bought a year of my life.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "Whistler's whistle drops from his mouth.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "dialogue", "text": "Pike, you said it was only --", "name": "WHISTLER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "dialogue", "text": "Shut up, Whistle.", "name": "PIKE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "dialogue", "text": "Teodora. Pike's going to draw. Left side.", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "I know.", "name": "TEODORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "dialogue", "text": "Now that's rude, Miss Mulvaney --", "name": "PIKE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "action", "text": "Sadie fires first.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "action", "text": "The Winchester cracks.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "Pike's hat goes spinning out over the flats.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "dialogue", "text": "God, I'm sorry -- I'm sorry --", "name": "WHISTLER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "action", "text": "He drops his gun in the salt.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "action", "text": "Raises both hands.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "action", "text": "Pike sits in the dust, staring at his empty head.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "dialogue", "text": "Sadie. That was my good hat.", "name": "PIKE", "speaker": 3, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "dialogue", "text": "Sadie. Let them go. Both of them.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 76, "kind": "dialogue", "text": "Why should I?", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 77, "kind": "dialogue", "text": "Because the Army's still coming for us. And I'd like fewer witnesses.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 78, "kind": "action", "text": "She levers another round.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 79, "kind": "action", "text": "Lowers the barrel.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 80, "kind": "dialogue", "text": "Take the horses. Ride south. Don't stop.", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 81, "kind": "action", "text": "Pike nods.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 82, "kind": "action", "text": "He and Whistler mount.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 83, "kind": "action", "text": "They go, slow at first, then not.", "para": 17, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 84, "kind": "action", "text": "Teodora looks at Elias.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 85, "kind": "action", "text": "Her voice is level.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 86, "kind": "dialogue", "text": "You get a head start. One hour. After that, I come looking.", "name": "TEODORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 87, "kind": "dialogue", "text": "Fair.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 88, "kind": "action", "text": "He takes his hat from the porch nail.", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 89, "kind": "action", "text": "Steps off the boards into the white glare and starts walking.", "para": 19, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 90, "kind": "action", "text": "No horse.", "para": 19, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 91, "kind": "action", "text": "No bag.", "para": 19, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 92, "kind": "action", "text": "Sadie watches until he is a speck.", "para": 20, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 93, "kind": "dialogue", "text": "Teo.", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 94, "kind": "dialogue", "text": "Yeah.", "name": "TEODORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 95, "kind": "dialogue", "text": "Cut the wire.", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}