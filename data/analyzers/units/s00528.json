{"scene_id": "s00528", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00528.fountain", "heading": "INT. VELVET HOURS FUNERAL PARLOR - BACK ROOM - NIGHT", "cast": [{"id": 0, "name": "LOU DEVEREAUX", "names": ["LOU DEVEREAUX", "LOU"], "gender": "m", "first": 4, "spoke": 10}, {"id": 1, "name": "MISS ALTHEA CROWNINSHIELD", "names": ["MISS ALTHEA CROWNINSHIELD", "ALTHEA"], "gender": "?", "first": 5, "spoke": 11}, {"id": 2, "name": "SPATS", "names": ["SPATS"], "gender": "?", "first": 24, "spoke": 1}, {"id": 3, "name": "BRINDISI", "names": ["BRINDISI"], "gender": "?", "first": 24, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. VELVET HOURS FUNERAL PARLOR - BACK ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Satin-lined caskets on trestles.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Potted ferns.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A gramophone plays a muted waltz.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LOU DEVEREAUX, 40s, camel overcoat, snap-brim hat, sits in a leather chair, dealing himself solitaire on the lid of a coffin.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "MISS ALTHEA CROWNINSHIELD, 50s, the proprietor, in black crepe and pearls, pours two glasses of sherry.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Her hand is perfectly steady.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "You're early, Mr. Devereaux.", "name": "ALTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Early's polite. Late's a funeral.", "name": "LOU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "You find that amusing?", "name": "ALTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "In this business? Everything.", "name": "LOU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She hands him a glass.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He sips.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Nods approval.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Good sherry.", "name": "LOU", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "My late husband's.", "name": "ALTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "He had taste.", "name": "LOU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "He had a will.", "name": "ALTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Lou smiles.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Lays a red queen on a black king.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "About that. The boys tell me the account at First Mercantile is a little light.", "name": "LOU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "They are mistaken.", "name": "ALTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Seventeen thousand light, Miss Crowninshield.", "name": "LOU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Then someone has been careless with my money.", "name": "ALTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "ANGELO \"SPATS\" BRINDISI, 30s, white spats, a pencil moustache, slides in from the hallway holding a ledger like a hymn book.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "He nods at Althea with exaggerated courtesy.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Evening, Ma'am. Boss.", "name": "SPATS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Spats. Show the lady.", "name": "LOU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Spats opens the ledger on the coffin.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Althea does not glance at it.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "I know what it says.", "name": "ALTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Then you know the numbers don't lie.", "name": "LOU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Numbers never do, Mr. Devereaux. People do.", "name": "ALTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "She crosses to a tall ferns pot.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Lifts a fern.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Beneath it, a small brass bell on a cord.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "She rings it, once.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "A bright, silly chime.", "para": 7, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "What's that for?", "name": "LOU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "A courtesy.", "name": "ALTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Every one of the coffin lids in the room creaks open an inch.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "A dozen gun barrels slide out, gleaming, steady.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Spats drops the ledger.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Lou's cards scatter.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "My husband always said: never trust a man who rushes a funeral.", "name": "ALTHEA", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Well. To your late husband.", "name": "LOU", "speaker": 0, "ext": [], "paren": ["raising his glass slowly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "To the late Mr. Devereaux.", "name": "ALTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "She clinks her glass to his.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "The waltz plays on.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}]}