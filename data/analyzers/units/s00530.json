{"scene_id": "s00530", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00530.fountain", "heading": "INT. ABANDONED GRAIN ELEVATOR - NIGHT", "cast": [{"id": 0, "name": "DEKE MARSHALL", "names": ["DEKE MARSHALL", "DEKE"], "gender": "?", "first": 3, "spoke": 2}, {"id": 1, "name": "OLLIE", "names": ["OLLIE"], "gender": "?", "first": 3, "spoke": 1}, {"id": 2, "name": "MIRIAM MARSHALL", "names": ["MIRIAM MARSHALL", "MIRIAM"], "gender": "?", "first": 3, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED GRAIN ELEVATOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dust hangs in the flashlight beam like smoke.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rusted chutes, a floor of old husk, a ladder going up into black.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "DEKE MARSHALL, 40s, a farmer's jacket, grips a flashlight in one hand and OLLIE, 8, by the wrist with the other, hauling him toward the door while MIRIAM MARSHALL, 40s, Deke's wife, swings a crowbar at the ladder's base and screams at the dark above, and Ollie, crying, drops his stuffed rabbit, turns back for it, and Deke yanks him so hard the boy's shoe slides off in the grain.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 4, "kind": "action", "text": "Something heavy shifts overhead.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 5, "kind": "action", "text": "Husk rains down.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Don't look up.", "name": "DEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Don't look up!", "name": "MIRIAM", "speaker": 2, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Daddy, it knows my name!", "name": "OLLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "The beam shakes.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "The door is three steps away, chained from outside.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Deke. The chain.", "name": "MIRIAM", "speaker": 2, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "I see it.", "name": "DEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "The ladder creaks.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "One rung at a time.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Slowly now.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Ollie goes silent.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Stops crying.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Holds his father's hand and stares at the door.", "para": 5, "sent": 2, "present": [0, 1, 2]}]}