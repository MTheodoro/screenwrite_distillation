{"scene_id": "s00531", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00531.fountain", "heading": "EXT. CABLE CAR GONDOLA - HIGH OVER A HARBOR - NIGHT", "cast": [{"id": 0, "name": "CALLUM DRUMMOND-OKAFOR", "names": ["CALLUM DRUMMOND-OKAFOR", "CALLUM"], "gender": "f", "first": 7, "spoke": 9}, {"id": 1, "name": "SUNITA RAO", "names": ["SUNITA RAO", "SUNITA"], "gender": "?", "first": 8, "spoke": 9}, {"id": 2, "name": "REYES", "names": ["REYES"], "gender": "?", "first": 22, "spoke": 3}, {"id": 3, "name": "FELIX ODUYA", "names": ["FELIX ODUYA", "FELIX"], "gender": "m", "first": 36, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. CABLE CAR GONDOLA - HIGH OVER A HARBOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A glass bubble swinging a hundred meters above black water.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "City lights fall away in every direction.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wind leans on the cabin.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The gondola has stopped.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "Dead stop.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "It sways.", "para": 1, "sent": 2, "present": []}, {"u": 7, "kind": "action", "text": "CALLUM DRUMMOND-OKAFOR, 30s, rumpled tuxedo, bow tie undone, grips the handrail.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "SUNITA RAO, 30s, bridesmaid's dress the color of a bruised plum, heels in one hand, leans against the opposite glass.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "We're fine.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "We are not fine. We are stuck.", "name": "SUNITA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Stuck is a kind of fine.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "The cabin sways.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "They both grab the rail.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Eyes meet.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Both freeze.", "para": 3, "sent": 4, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "You look terrible.", "name": "SUNITA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "You left the wedding.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "You followed me.", "name": "SUNITA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Also terrible, I know.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "A speaker crackles near the ceiling.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Gondola four, this is control. Are you hurt? Over.", "name": "REYES", "speaker": 2, "ext": ["V.O."], "paren": ["over intercom"], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "No. Just stuck. Are we going to move?", "name": "CALLUM", "speaker": 0, "ext": [], "paren": ["to the speaker"], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Power's out on the whole peak. Twenty minutes. Maybe thirty. Please sit down.", "name": "REYES", "speaker": 2, "ext": ["V.O."], "paren": ["over intercom"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Sunita sits on the bench.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Callum sits across from her.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Their knees almost touch.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Twenty minutes.", "name": "SUNITA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "I can count to twenty minutes of anything.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "You said that about your marriage.", "name": "SUNITA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "His mouth twitches.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "A pained half-smile.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Twelve minutes in, I'll have thought of something good.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Light blooms in the next gondola, thirty feet away, swaying.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "A silhouette stands at the glass, waving both arms.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "FELIX ODUYA, 30s, in a groom's white jacket, pounds on the glass of the adjacent cabin and mouths words.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Don't look.", "name": "SUNITA", "speaker": 1, "ext": [], "paren": ["without turning"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Is that --", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Don't.", "name": "SUNITA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Felix cups his hands against the glass.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Shouts.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Muffled, through two walls of glass and a gale.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "SUNITA! I CAN EXPLAIN!", "name": "FELIX", "speaker": 3, "ext": ["O.S."], "paren": ["muffled"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Callum and Sunita both stand.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "They crash together at the center of the cabin, arguing, then not arguing, her hand fisted in his lapel, his on her wrist, then her jaw.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "The gondola lurches.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "They fall back to the bench, laughing, helpless, horrified.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "I can't believe he's the groom.", "name": "SUNITA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "I can't believe you're the one who brought the ring.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Gondola four? I'm hearing a lot of shouting. Everyone okay?", "name": "REYES", "speaker": 2, "ext": ["V.O."], "paren": ["over intercom"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Never better.", "name": "SUNITA", "speaker": 1, "ext": [], "paren": ["to the speaker"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "The lights flicker on.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "The cable shudders.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "The gondola begins, slowly, to move, toward the shore, toward the other cabin, toward whatever comes next.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Callum offers her his hand.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "She takes it.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}]}