{"scene_id": "s00533", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00533.fountain", "heading": "EXT. STOCKYARD AUCTION RING - DAY", "cast": [{"id": 0, "name": "HEIFER", "names": ["HEIFER"], "gender": "?", "first": 3, "spoke": 0}, {"id": 1, "name": "HOLLIS BRADDOCK", "names": ["HOLLIS BRADDOCK", "HOLLIS"], "gender": "m", "first": 5, "spoke": 1}, {"id": 2, "name": "MARIBEL BRADDOCK", "names": ["MARIBEL BRADDOCK", "MARIBEL"], "gender": "m", "first": 5, "spoke": 1}, {"id": 3, "name": "TAVISH DOYLE", "names": ["TAVISH DOYLE"], "gender": "m", "first": 7, "spoke": 0}, {"id": 4, "name": "DOLLY", "names": ["DOLLY"], "gender": "f", "first": 8, "spoke": 0}, {"id": 5, "name": "AUCTIONEER", "names": ["AUCTIONEER"], "gender": "?", "first": 9, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. STOCKYARD AUCTION RING - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Plank bleachers.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dust.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A hand-lettered sign: LOT 14, HEIFER, OPEN BIDDING.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "Flies work the heat.", "para": 0, "sent": 3, "present": [0]}, {"u": 5, "kind": "action", "text": "HOLLIS BRADDOCK, 60s, a hat older than his marriage, sits in the third row with his hands in his lap.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "Beside him MARIBEL BRADDOCK, 50s, stares straight ahead, ring finger bare.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Across the aisle TAVISH DOYLE, 40s, in a clean vest, a bidder's card in his fist, doesn't look at either of them.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "DOLLY, 12, Hollis's granddaughter, sits at the rail with her boots dangling and watches all three.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Who'll give me four? Four hundred, four, I got four, now five, five, who'll give five?", "name": "AUCTIONEER", "speaker": 5, "ext": ["O.S."], "paren": ["over the loudspeaker"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "Tavish lifts his card.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "Hollis does not move.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "Maribel's jaw tightens.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Five, I got five from the man in the vest, now six? Six for a good milker, six?", "name": "AUCTIONEER", "speaker": 5, "ext": ["O.S.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "Hollis shifts in his seat.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Takes off his hat, turns it twice by the brim, puts it back on.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Maribel slides one foot six inches away from his.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Dolly picks at a splinter and keeps looking at her grandfather's hands.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Six anywhere? Going once --", "name": "AUCTIONEER", "speaker": 5, "ext": ["O.S.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Hollis lifts one finger.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Barely.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Six, I got six! Seven?", "name": "AUCTIONEER", "speaker": 5, "ext": ["O.S.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Tavish glances over, nods at Hollis, once.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Lifts his card.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Eleven years.", "name": "MARIBEL", "speaker": 2, "ext": [], "paren": ["to the air"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Mm.", "name": "HOLLIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Seven, going --", "name": "AUCTIONEER", "speaker": 5, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Hollis lowers his hand.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Dolly looks at Maribel.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Maribel looks at Tavish.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Gavel.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}