{"scene_id": "s00538", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00538.fountain", "heading": "INT. BRIGHTWAVE SYNERGY SOLUTIONS - OPEN-PLAN FLOOR - MORNING", "cast": [{"id": 0, "name": "TRIP HALVERSEN", "names": ["TRIP HALVERSEN", "TRIP"], "gender": "m", "first": 3, "spoke": 10}, {"id": 1, "name": "LEAN", "names": ["LEAN"], "gender": "?", "first": 3, "spoke": 0}, {"id": 2, "name": "LAKSHMI PILLAI", "names": ["LAKSHMI PILLAI", "LAKSHMI"], "gender": "f", "first": 4, "spoke": 4}, {"id": 3, "name": "GUS ABERNETHY", "names": ["GUS ABERNETHY", "GUS"], "gender": "m", "first": 5, "spoke": 5}, {"id": 4, "name": "DEBORAH-LYNN FOSTER", "names": ["DEBORAH-LYNN FOSTER", "DEBORAH-LYNN"], "gender": "?", "first": 6, "spoke": 6}, {"id": 5, "name": "VP", "names": ["VP"], "gender": "?", "first": 6, "spoke": 0}, {"id": 6, "name": "BEIGE MAN", "names": ["MAN", "BEIGE MAN"], "gender": "?", "first": 25, "spoke": 4}, {"id": 7, "name": "BEIGE SUIT", "names": ["BEIGE SUIT"], "gender": "?", "first": 25, "spoke": 0}, {"id": 8, "name": "KENT", "names": ["KENT"], "gender": "?", "first": 44, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. BRIGHTWAVE SYNERGY SOLUTIONS - OPEN-PLAN FLOOR - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Standing desks, kombucha taps, a neon sign that reads GOOD VIBES ONLY.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "In the center of the floor, a bounce house shaped like a giant inflatable castle wobbles under fluorescent light.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "TRIP HALVERSEN, 30s, \"Chief Happiness Officer,\" in a vest that says LEAN IN, stands on a cube with a wireless mic.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "LAKSHMI PILLAI, 30s, a project manager, sits at her desk with a laptop, headphones, and a thousand-yard stare.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 5, "kind": "action", "text": "GUS ABERNETHY, 50s, a senior accountant, stands at the water cooler, holding a paper cone.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "action", "text": "DEBORAH-LYNN FOSTER, 40s, the VP of People, arranges lanyards on a folding table.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 7, "kind": "dialogue", "text": "Good morning, Brightwavers! Today's wellness initiative: Synergy Jump!", "name": "TRIP", "speaker": 0, "ext": [], "paren": ["into mic"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "action", "text": "No one moves.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "action", "text": "Lakshmi turns a page.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Everybody grab a partner and bounce toward your quarterly goals!", "name": "TRIP", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "I have goals. They're not in a castle.", "name": "GUS", "speaker": 3, "ext": [], "paren": ["to the cooler"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Gus, participation is a core value.", "name": "DEBORAH-LYNN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Participation is a hostage situation.", "name": "GUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Deborah-Lynn, I have a deadline.", "name": "LAKSHMI", "speaker": 2, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Everyone has a deadline, Lakshmi.", "name": "DEBORAH-LYNN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Great energy! Love the energy!", "name": "TRIP", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "The castle's blower sputters.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "A cough of air.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "One turret sags.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Lakshmi finally pulls off her headphones.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Is that structurally sound?", "name": "LAKSHMI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "It's rated for three hundred pounds.", "name": "TRIP", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Rated by whom?", "name": "GUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "By... the rental company.", "name": "TRIP", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "A MAN IN A BEIGE SUIT, 50s, no lanyard, no smile, steps out of the elevator carrying a briefcase.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 26, "kind": "action", "text": "He moves through the floor like a shark through kelp.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 27, "kind": "action", "text": "Nobody stops him.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 28, "kind": "dialogue", "text": "Who is that?", "name": "DEBORAH-LYNN", "speaker": 4, "ext": [], "paren": ["whispering to Trip"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 29, "kind": "dialogue", "text": "I thought he was yours.", "name": "TRIP", "speaker": 0, "ext": [], "paren": ["whispering back"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "action", "text": "The man in the beige suit stops at the castle.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "action", "text": "Looks up at it.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "action", "text": "Looks at the mic.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "action", "text": "Looks at Trip.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "dialogue", "text": "Mr. Halversen?", "name": "BEIGE MAN", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "dialogue", "text": "Halverson. Trip.", "name": "TRIP", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "dialogue", "text": "Halverson. I'm from the insurance carrier.", "name": "BEIGE MAN", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "action", "text": "The blower sputters again.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "action", "text": "Another turret sags.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "action", "text": "Gus sips his water.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "dialogue", "text": "We're in the middle of a team-building --", "name": "DEBORAH-LYNN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 41, "kind": "dialogue", "text": "Yes. I can see.", "name": "BEIGE MAN", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 42, "kind": "action", "text": "Lakshmi starts typing again, smiling now.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 43, "kind": "dialogue", "text": "Sir, with respect, this is a culture initiative --", "name": "TRIP", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 44, "kind": "dialogue", "text": "My name is Kent. Kent Aldrich-Bowman. And I am here to tell you that your policy lapsed Monday.", "name": "BEIGE MAN", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 45, "kind": "action", "text": "Silence.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 46, "kind": "action", "text": "The castle exhales.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 47, "kind": "action", "text": "Nobody speaks.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 48, "kind": "dialogue", "text": "That's... that can't be right.", "name": "TRIP", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 49, "kind": "dialogue", "text": "Which is why I brought the paperwork.", "name": "KENT", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 50, "kind": "action", "text": "He opens the briefcase.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 51, "kind": "action", "text": "Takes out a stack of forms, each tabbed with little yellow flags.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 52, "kind": "dialogue", "text": "Great! We love paperwork! Trip, give Kent a lanyard.", "name": "DEBORAH-LYNN", "speaker": 4, "ext": [], "paren": ["brightly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 53, "kind": "dialogue", "text": "Everyone, please welcome Kent from... Risk.", "name": "TRIP", "speaker": 0, "ext": [], "paren": ["into mic, shaky"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 54, "kind": "dialogue", "text": "It's a trap.", "name": "GUS", "speaker": 3, "ext": [], "paren": ["to Lakshmi"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 55, "kind": "dialogue", "text": "It's a rental.", "name": "LAKSHMI", "speaker": 2, "ext": [], "paren": ["under her breath"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 56, "kind": "action", "text": "The castle's front wall folds inward with a long, sad hiss.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 57, "kind": "action", "text": "Trip, still clutching his mic, topples slowly into the collapsing fabric and vanishes.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 58, "kind": "dialogue", "text": "Please note the time.", "name": "KENT", "speaker": 8, "ext": [], "paren": ["calmly, to the room"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 59, "kind": "dialogue", "text": "It's 9:14.", "name": "DEBORAH-LYNN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 60, "kind": "dialogue", "text": "Thank you. 9:14.", "name": "KENT", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 61, "kind": "action", "text": "He writes it on a form.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 62, "kind": "dialogue", "text": "Does that cover the kombucha?", "name": "LAKSHMI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 63, "kind": "dialogue", "text": "Nothing covers the kombucha.", "name": "KENT", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 64, "kind": "action", "text": "Gus raises his paper cone, solemn, as to a toast.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 65, "kind": "dialogue", "text": "To synergy.", "name": "GUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}]}