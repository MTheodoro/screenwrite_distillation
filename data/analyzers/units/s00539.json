{"scene_id": "s00539", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00539.fountain", "heading": "INT. ST. ELMO'S HOSPITAL - HYPERBARIC CHAMBER - NIGHT", "cast": [{"id": 0, "name": "NIAMH FENWICK", "names": ["NIAMH FENWICK", "FENWICK"], "gender": "f", "first": 6, "spoke": 12}, {"id": 1, "name": "NURSE ILSE BRANDTNER", "names": ["NURSE ILSE BRANDTNER", "ILSE"], "gender": "m", "first": 8, "spoke": 6}, {"id": 2, "name": "IGOR DOBROVOLSKY", "names": ["IGOR DOBROVOLSKY", "DOBROVOLSKY"], "gender": "m", "first": 9, "spoke": 17}], "units": [{"u": 0, "kind": "heading", "text": "INT. ST. ELMO'S HOSPITAL - HYPERBARIC CHAMBER - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A steel cylinder the size of a bus, portholes glowing amber.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Gauges tick.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Pumps breathe.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A cot is bolted to the floor inside; its occupant lies under a clear oxygen hood.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The room smells of rubber and warm metal.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "DR. NIAMH FENWICK, 50s, short grey hair, scrubs washed pale, sits on a stool beside the cot.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "She keeps one hand on a pressure dial.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "NURSE ILSE BRANDTNER, 30s, ponytail, tired eyes, checks a drip bag.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "MR. IGOR DOBROVOLSKY, 70s, the patient, thin as a rake, a diver's tattoo on his forearm, lies back with a hissing mask over his mouth.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "She watches the dial.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He watches the ceiling.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "They both know the dive was a long time ago.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Doctor. How long?", "name": "DOBROVOLSKY", "speaker": 2, "ext": [], "paren": ["muffled by mask"], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Forty more minutes, Mr. Dobrovolsky.", "name": "FENWICK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "You said that an hour ago.", "name": "DOBROVOLSKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "I was optimistic.", "name": "FENWICK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "He chuckles.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "It becomes a cough.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Ilse leans in and adjusts the hood.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Easy, Mr. D. Slow breaths.", "name": "ILSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "I have been breathing for seventy-two years.", "name": "DOBROVOLSKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Then you should be good at it.", "name": "ILSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "He closes his eyes, smiling faintly.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "She checks the line.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Then glances at Fenwick.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "A look passes between them: this one is not going well.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Fenwick rises.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Crosses to the porthole.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Stares out at the dark corridor.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Ilse. His carboxy levels?", "name": "FENWICK", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Fourteen. Down from nineteen.", "name": "ILSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "That's good.", "name": "FENWICK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "It's slow.", "name": "ILSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Fenwick rubs the bridge of her nose.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "She says nothing.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Behind them the old man's chest rises and falls under the plastic.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Doctor Fenwick?", "name": "DOBROVOLSKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Yes?", "name": "FENWICK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "You are not telling me something.", "name": "DOBROVOLSKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "She turns.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Comes back to the cot.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Sits.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "No. I'm not.", "name": "FENWICK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Good. I like honesty. Say it.", "name": "DOBROVOLSKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "The damage to your lungs is more extensive than we thought.", "name": "FENWICK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "He nods slowly.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "His hand finds hers on the rail.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Is it the sea?", "name": "DOBROVOLSKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "It's the years of it.", "name": "FENWICK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Ah. Then I cannot complain. She was always generous.", "name": "DOBROVOLSKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Ilse turns away, adjusting a monitor that doesn't need adjusting.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Nurse Brandtner. Do not cry in front of a Russian.", "name": "DOBROVOLSKY", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "I'm not.", "name": "ILSE", "speaker": 1, "ext": [], "paren": ["wiping her eye"], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "You are. It is all right. We cry also. We just hide it in vodka.", "name": "DOBROVOLSKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Fenwick laughs.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "A real one, helpless, short.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "She presses the back of her wrist to her mouth.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "Mr. Dobrovolsky, you are impossible.", "name": "FENWICK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "It is my best quality.", "name": "DOBROVOLSKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "The pressure dial ticks down.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "A soft chime.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "The pumps slow.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "He watches the needle fall, calm, like a man watching tide.", "para": 11, "sent": 3, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "When I came up the first time... nineteen seventy-nine. Off Sakhalin. The light was the color of this room. I thought: I will never see anything more beautiful.", "name": "DOBROVOLSKY", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "And now?", "name": "FENWICK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "Now I think the same. But I am not afraid.", "name": "DOBROVOLSKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "Ilse takes his other hand.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "He squeezes it.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 69, "kind": "dialogue", "text": "Do you want us to call anyone?", "name": "ILSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 70, "kind": "dialogue", "text": "There is a daughter in Vladivostok. She has not spoken to me in nine years.", "name": "DOBROVOLSKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 71, "kind": "dialogue", "text": "We'll call her.", "name": "FENWICK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 72, "kind": "dialogue", "text": "She will not answer.", "name": "DOBROVOLSKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 73, "kind": "dialogue", "text": "Then we'll leave a message.", "name": "FENWICK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 74, "kind": "action", "text": "He thinks about it.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 75, "kind": "action", "text": "The gauges tick.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 76, "kind": "dialogue", "text": "Tell her... the sea says hello.", "name": "DOBROVOLSKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 77, "kind": "action", "text": "Ilse nods.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 78, "kind": "action", "text": "Fenwick nods.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 79, "kind": "action", "text": "The dial reaches zero.", "para": 14, "sent": 2, "present": [0, 1, 2]}, {"u": 80, "kind": "action", "text": "A long hiss as the chamber decompresses.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 81, "kind": "action", "text": "The hatch unseals.", "para": 15, "sent": 1, "present": [0, 1, 2]}, {"u": 82, "kind": "action", "text": "Cool air rolls in, and the light from the corridor falls across his face, pale and ordinary.", "para": 15, "sent": 2, "present": [0, 1, 2]}, {"u": 83, "kind": "action", "text": "He opens his eyes.", "para": 16, "sent": 0, "present": [0, 1, 2]}, {"u": 84, "kind": "action", "text": "Looks at the doorway.", "para": 16, "sent": 1, "present": [0, 1, 2]}, {"u": 85, "kind": "action", "text": "Smiles.", "para": 16, "sent": 2, "present": [0, 1, 2]}, {"u": 86, "kind": "dialogue", "text": "There it is.", "name": "DOBROVOLSKY", "speaker": 2, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}]}