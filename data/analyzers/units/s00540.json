{"scene_id": "s00540", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00540.fountain", "heading": "EXT. LIFE RAFT - SOUTHERN OCEAN - DAWN", "cast": [{"id": 0, "name": "CAPTAIN HAAKON LUNDQVIST", "names": ["CAPTAIN HAAKON LUNDQVIST", "HAAKON"], "gender": "m", "first": 4, "spoke": 14}, {"id": 1, "name": "MBEKI NTULI", "names": ["MBEKI NTULI", "MBEKI"], "gender": "m", "first": 5, "spoke": 11}, {"id": 2, "name": "LUCIANA FARIAS", "names": ["LUCIANA FARIAS", "LUCIANA"], "gender": "m", "first": 6, "spoke": 10}, {"id": 3, "name": "PIP", "names": ["PIP"], "gender": "?", "first": 7, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. LIFE RAFT - SOUTHERN OCEAN - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A yellow canopy bobbing on a swell the color of slate.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fog lies in the troughs.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The sea has gone, for the first time in nine days, almost still.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CAPTAIN HAAKON LUNDQVIST, 60s, a beard crusted with salt, sits at the hatch with a flare gun across his knees.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "MBEKI NTULI, 30s, the first mate, bails with a plastic cup, steady as a metronome.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "LUCIANA FARIAS, 20s, the cook, huddles in a foil blanket, lips cracked.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "PIP, 16, the cabin boy, lies asleep with his head in her lap.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "It's flat.", "name": "HAAKON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "It's flat.", "name": "MBEKI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Is that good?", "name": "LUCIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "It means the storm's gone.", "name": "HAAKON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "It means the storm's behind us.", "name": "MBEKI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Is that different?", "name": "LUCIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Ask me tomorrow.", "name": "MBEKI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Water?", "name": "HAAKON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Half a cup each. I measured.", "name": "LUCIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Split Pip's.", "name": "HAAKON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "He's nine days younger than the rest of us.", "name": "MBEKI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Give him less, then.", "name": "HAAKON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "No. I'm giving him more.", "name": "LUCIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Luciana --", "name": "HAAKON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "He told me his mother's name. Last night. He thought I was asleep. He kept saying it. Over and over. Adelheid. Adelheid.", "name": "LUCIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Captain, the boy's all right.", "name": "MBEKI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "The boy's fine.", "name": "HAAKON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "You keep saying that like it's a prayer.", "name": "LUCIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "It's a log entry.", "name": "HAAKON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "It's both.", "name": "MBEKI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Pip stirs.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Murmurs.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Luciana strokes his forehead.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "All three wait for him to settle.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Mbeki. Last night. Did you hear it?", "name": "HAAKON", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "The engine?", "name": "MBEKI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Not an engine.", "name": "HAAKON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "What are you two talking about?", "name": "LUCIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "A low sound. Like a drum, far off.", "name": "MBEKI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "I thought I dreamed it.", "name": "HAAKON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "We didn't both dream it.", "name": "MBEKI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Could it be a ship?", "name": "LUCIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Ships don't sound like that.", "name": "HAAKON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Then what?", "name": "LUCIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Whales. Or ice. Or --", "name": "HAAKON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "He stops.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "The fog parts.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "In the trough ahead, a wall of white rises, hundreds of feet high, glittering.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Iceberg.", "name": "MBEKI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "It's beautiful.", "name": "LUCIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "It's moving toward us.", "name": "HAAKON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Everything moves toward us, Captain.", "name": "MBEKI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Pip sits up.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Rubs his eyes.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Looks at the berg and the three adults, all staring, none speaking.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Is it breakfast?", "name": "PIP", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Luciana laughs, ragged, helpless, near tears.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Mbeki lowers his bailing cup.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Haakon lifts the flare gun, aims into the gray sky, and fires.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "A red star blooms above them.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "Four faces turn up to it, lit crimson, silent.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}]}