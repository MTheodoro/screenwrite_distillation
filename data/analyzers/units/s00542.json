{"scene_id": "s00542", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00542.fountain", "heading": "INT. ORBITAL HYDROPONICS RING - NIGHT CYCLE", "cast": [{"id": 0, "name": "KESTREL ODUYA", "names": ["KESTREL ODUYA", "KESTREL"], "gender": "f", "first": 5, "spoke": 7}, {"id": 1, "name": "IXCHEL TORRES-WAI", "names": ["IXCHEL TORRES-WAI", "IXCHEL"], "gender": "f", "first": 8, "spoke": 1}, {"id": 2, "name": "BRAM VANDERHOEK", "names": ["BRAM VANDERHOEK", "BRAM"], "gender": "m", "first": 9, "spoke": 4}, {"id": 3, "name": "OMAR EL-SAYED", "names": ["OMAR EL-SAYED", "OMAR"], "gender": "?", "first": 33, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. ORBITAL HYDROPONICS RING - NIGHT CYCLE", "present": []}, {"u": 1, "kind": "action", "text": "Rows of green under violet LEDs.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Nutrient mist.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Tomatoes on vines the length of a bus.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Everything is damp and humming.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "KESTREL ODUYA, 30s, a botanist in a stained lab coat, pinches leaves between her fingers.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Cuts a sample.", "para": 1, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "Bags it.", "para": 1, "sent": 2, "present": []}, {"u": 8, "kind": "action", "text": "IXCHEL TORRES-WAI, 20s, her junior, trails with a tablet, scribbling.", "para": 1, "sent": 3, "present": [1]}, {"u": 9, "kind": "action", "text": "BRAM VANDERHOEK, 40s, a station tech, jogs down the central aisle, wrench in hand.", "para": 1, "sent": 4, "present": [1, 2]}, {"u": 10, "kind": "dialogue", "text": "Kes. The mist valves are fluctuating.", "name": "BRAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [1, 2]}, {"u": 11, "kind": "dialogue", "text": "How badly?", "name": "KESTREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Row twelve is flooding.", "name": "BRAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She runs.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Ixchel follows.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "The mist thickens as they go, and the LEDs flicker, a violet strobe.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Row twelve.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "A tomato plant slumps, roots exposed, water pooling at its base.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Bram kneels, jams the wrench under the manifold.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "He grunts.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Pulls.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "The pipe bursts.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Water jets across the aisle.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Ixchel yelps.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Kestrel ducks.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Bram swears and falls backward onto the deck, drenched.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Shut it off!", "name": "KESTREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "I'm trying!", "name": "BRAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "They scramble.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Kestrel finds the valve.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "She yanks it.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The spray dies.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The three of them stand soaked and breathless.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "OMAR EL-SAYED, 40s, a surveyor in a grey jumpsuit, appears at the end of the row, a sealed data case in one hand and a badge on a lanyard.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "He doesn't smile.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "He holds out the badge.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Station Authority. Section audit.", "name": "OMAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Tonight?", "name": "KESTREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Tonight.", "name": "OMAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "He walks down the row, stepping over puddles.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "His eyes find the broken pipe.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "The slumped plant.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "The sample bag.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Kestrel steps in front of it.", "para": 8, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "That's not on the schedule.", "name": "BRAM", "speaker": 2, "ext": [], "paren": ["whispering to Ixchel"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "It never is.", "name": "IXCHEL", "speaker": 1, "ext": [], "paren": ["whispering back"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Dr. Oduya. You've been logging Row twelve as nominal for six months.", "name": "OMAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Because it was.", "name": "KESTREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Your yield numbers say otherwise.", "name": "OMAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "He opens the case.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "A screen flares to life.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Columns of numbers, red.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Ixchel grabs Bram's sleeve.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Bram sets down his wrench.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Slowly, Kestrel picks up the sample bag and holds it behind her back.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "The plant's mutated.", "name": "KESTREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "I know.", "name": "OMAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Silence.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "The mist hisses.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "So does the Council. They sent me to see if it's dangerous.", "name": "OMAR", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "And?", "name": "KESTREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "He crouches.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "Touches a root.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "It wriggles.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "All four step back at once.", "para": 12, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "Doctor. Is it supposed to do that?", "name": "OMAR", "speaker": 3, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "The root coils around his finger.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "Ixchel screams.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "Bram lunges.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "Kestrel grabs her scalpel.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "Omar yanks back, but the root holds, and the plant lifts, slowly, from the soil, a green fist rising out of the dark.", "para": 14, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "dialogue", "text": "Everybody out. Now.", "name": "KESTREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "action", "text": "They run, boots slapping through water, the violet lights flashing behind them, the plant unfolding into the aisle like a waking god.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}]}