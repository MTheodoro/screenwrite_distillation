{"scene_id": "s00543", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00543.fountain", "heading": "EXT. PARKING GARAGE ROOFTOP - NIGHT", "cast": [{"id": 0, "name": "FRANCINE OYELOWO", "names": ["FRANCINE OYELOWO", "OYELOWO", "FRANCINE"], "gender": "?", "first": 5, "spoke": 22}, {"id": 1, "name": "LENNY", "names": ["LENNY"], "gender": "?", "first": 6, "spoke": 24}], "units": [{"u": 0, "kind": "heading", "text": "EXT. PARKING GARAGE ROOFTOP - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Sodium lights.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Oil stains.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "One car left, a faded blue sedan with a flat front tire.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The city glows beyond the low concrete wall.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "FRANCINE OYELOWO, 40s, a dental hygienist's scrubs under a trench coat, kneels at the flat with a jack and a lug wrench.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her younger brother LEONARD \"LENNY\" OYELOWO, 30s, a rumpled courier's jacket, leans against the wall with a cigarette he hasn't lit.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "She wrestles a lug nut.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "It doesn't budge.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Want me to?", "name": "LENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "No.", "name": "FRANCINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "It's been twenty minutes.", "name": "LENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Then it's been twenty minutes.", "name": "FRANCINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He pockets the cigarette.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Watches.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She grunts, adjusts her grip, tries again.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Fran.", "name": "LENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Don't.", "name": "FRANCINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "I didn't say anything.", "name": "LENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "You said \"Fran\" like you were going to say something.", "name": "FRANCINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "He lets that sit.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Wind carries the faint sound of a siren from the street.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Mom called.", "name": "LENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She stops.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "The wrench hangs from her hand.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "When?", "name": "FRANCINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "This morning. She asked if you were coming Sunday.", "name": "LENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "And what did you say?", "name": "FRANCINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "I said I'd ask.", "name": "LENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Why would you ask me?", "name": "FRANCINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Because you won't answer her.", "name": "LENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "She resumes.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Harder.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "The wrench scrapes.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "The lug nut turns half a rotation.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "She's been telling people I'm \"away on business.\"", "name": "FRANCINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "It's easier than saying you left.", "name": "LENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "I didn't leave. I moved.", "name": "FRANCINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Four hundred miles is leaving.", "name": "LENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "She rocks back on her heels.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Looks up at him.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Her face is wet, but her voice is level.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "You want to talk about leaving? You sent a postcard for two years.", "name": "FRANCINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "It was a good postcard.", "name": "LENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "It said, \"Weather's nice.\"", "name": "FRANCINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "It was.", "name": "LENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "A brittle laugh escapes her.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "He allows himself a half smile.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Then it fades.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "I should've called.", "name": "LENNY", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Yes.", "name": "FRANCINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "I should've come.", "name": "LENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Yes.", "name": "FRANCINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "I'm here now.", "name": "LENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "You're here because my car broke down.", "name": "FRANCINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "No. I'm here because I got the text.", "name": "LENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "She stares.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "He takes the wrench from her hand, kneels, fits it on the lug nut.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "Braces.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "Leans his full weight.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "It gives with a crack.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "Show-off.", "name": "FRANCINE", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "Always.", "name": "LENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "He keeps going.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "Four nuts, a flat, the spare.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "She hands him each tool before he asks.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "They work in silence for a long minute, side by side, in the rhythm of two people who learned this from the same father.", "para": 11, "sent": 3, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "Dad hated the way you held the wrench.", "name": "FRANCINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "Dad hated everything I held.", "name": "LENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "That isn't true.", "name": "FRANCINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "He hated the way I held you. When you cried.", "name": "LENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "She freezes.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 72, "kind": "dialogue", "text": "You remember that?", "name": "FRANCINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 73, "kind": "dialogue", "text": "Every day.", "name": "LENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 74, "kind": "action", "text": "She turns away, looks out over the wall at the lit city.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 75, "kind": "action", "text": "Her shoulders shake once.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 76, "kind": "action", "text": "He doesn't touch her.", "para": 13, "sent": 2, "present": [0, 1]}, {"u": 77, "kind": "action", "text": "He keeps working.", "para": 13, "sent": 3, "present": [0, 1]}, {"u": 78, "kind": "dialogue", "text": "Why now?", "name": "FRANCINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 79, "kind": "dialogue", "text": "Because Mom's sick, Fran.", "name": "LENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 80, "kind": "action", "text": "The words hang.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 81, "kind": "action", "text": "She does not turn.", "para": 14, "sent": 1, "present": [0, 1]}, {"u": 82, "kind": "dialogue", "text": "How sick?", "name": "FRANCINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 83, "kind": "dialogue", "text": "Sick.", "name": "LENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 84, "kind": "action", "text": "She closes her eyes.", "para": 15, "sent": 0, "present": [0, 1]}, {"u": 85, "kind": "action", "text": "Presses both hands against the cold concrete.", "para": 15, "sent": 1, "present": [0, 1]}, {"u": 86, "kind": "dialogue", "text": "You waited till the rooftop to tell me.", "name": "FRANCINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 87, "kind": "dialogue", "text": "You wouldn't have heard it anywhere else.", "name": "LENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 88, "kind": "action", "text": "She nods.", "para": 16, "sent": 0, "present": [0, 1]}, {"u": 89, "kind": "action", "text": "Slowly.", "para": 16, "sent": 1, "present": [0, 1]}, {"u": 90, "kind": "action", "text": "A man's hand and a woman's hand finally touch on the wrench, and neither moves.", "para": 16, "sent": 2, "present": [0, 1]}, {"u": 91, "kind": "dialogue", "text": "Sunday.", "name": "FRANCINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 92, "kind": "dialogue", "text": "Sunday.", "name": "LENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 93, "kind": "action", "text": "She takes the wrench.", "para": 17, "sent": 0, "present": [0, 1]}, {"u": 94, "kind": "action", "text": "Finishes the last nut herself.", "para": 17, "sent": 1, "present": [0, 1]}]}