{"scene_id": "s00544", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00544.fountain", "heading": "EXT. DRAINED BACKYARD POOL - DAY", "cast": [{"id": 0, "name": "MOSES AGYEMAN", "names": ["MOSES AGYEMAN", "MOSES"], "gender": "?", "first": 5, "spoke": 3}, {"id": 1, "name": "JAI KAPOOR", "names": ["JAI KAPOOR", "JAI"], "gender": "?", "first": 6, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DRAINED BACKYARD POOL - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Cracked blue paint.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Leaves in the deep end.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Two boards leaned against the lip.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Heat bends the air.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MOSES AGYEMAN, 15, hoodie, scabbed knees, stands at the top of the transition.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "JAI KAPOOR, 15, a cap on backward, a stolen helmet, grips the coping with both hands.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He drops in.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He wobbles.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He rolls out.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He grins.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He doesn't see the other one.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He drops in too, harder, faster, and clips the edge of the first board.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Both skate out and slam into the shallow end together, a tangle of wheels and limbs.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He laughs first.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Then he does.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Then neither can breathe.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He pulls himself up.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He pulls him up.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Blood on a palm.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Dust on a cheek.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "You see that?", "name": "MOSES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "I felt that.", "name": "JAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "That was clean.", "name": "MOSES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "That was a car crash.", "name": "JAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Again?", "name": "MOSES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Again.", "name": "JAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "They climb the ladder.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Side by side.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Neither says it.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Both are too happy to say it.", "para": 7, "sent": 3, "present": [0, 1]}]}