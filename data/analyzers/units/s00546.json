{"scene_id": "s00546", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00546.fountain", "heading": "INT. NORTHERN LIGHTS CURLING CLUB - SHEET THREE - NIGHT", "cast": [{"id": 0, "name": "SKIP BRITTA LINDGREN-KOWALSKI", "names": ["SKIP BRITTA LINDGREN-KOWALSKI", "BRITTA"], "gender": "f", "first": 5, "spoke": 3}, {"id": 1, "name": "MURDOCH FINLAY", "names": ["MURDOCH FINLAY"], "gender": "f", "first": 6, "spoke": 0}, {"id": 2, "name": "YUKI TANAKA-REID", "names": ["YUKI TANAKA-REID", "YUKI"], "gender": "f", "first": 7, "spoke": 2}, {"id": 3, "name": "TERRENCE ODUMODU", "names": ["TERRENCE ODUMODU", "TERRENCE"], "gender": "?", "first": 8, "spoke": 2}, {"id": 4, "name": "OLUWASEUN ADEBAYO", "names": ["OLUWASEUN ADEBAYO", "OLUWASEUN"], "gender": "?", "first": 28, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. NORTHERN LIGHTS CURLING CLUB - SHEET THREE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Pebbled ice, white and hard under flat lights.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Red and yellow rings painted beneath the surface.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A scoreboard ticks.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The crowd, forty fans in parkas, hushes.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SKIP BRITTA LINDGREN-KOWALSKI, 40s, a wool toque and a steady squint, crouches in the house with her broom held like a rudder.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "At the hack, MURDOCH FINLAY, 50s, her veteran lead, gathers a stone.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "At the sideline, YUKI TANAKA-REID, 20s, the youngest on the team, grips a broom and bites her lip.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "TERRENCE ODUMODU, 30s, the vice-skip, in a quilted vest, watches the scoreboard like a hawk.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Hurry hard!", "name": "BRITTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Murdoch releases.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "The stone glides.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "The broom crew sprints alongside it.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Hard! Hard!", "name": "YUKI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Hard!", "name": "TERRENCE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "HARD!", "name": "BRITTA", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "The stone slides, hovers at the edge of the button.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Nothing moves.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Forty parkas hold their breath.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Then it curls.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "A gentle arc.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "A sliver of daylight.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "It nudges the opponent's stone aside and settles dead center.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "The crowd explodes.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Yuki jumps and flings her broom in the air.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Terrence hugs Murdoch so hard he lifts him.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Britta stays crouched, forehead on her broom handle, shaking.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "A woman in an official's jacket strides across the ice, clipboard in hand.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "OLUWASEUN ADEBAYO, 50s, the head official, wears a tight bun and a sour look.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "She inspects the stone with a tape measure.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Measure's confirmed. Team Lindgren takes the end.", "name": "OLUWASEUN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Britta looks up.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Eyes wide.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "We won?", "name": "BRITTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "You won the end. The match is Thursday.", "name": "OLUWASEUN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Britta laughs, helpless.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "The crowd roars again.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Was that real?", "name": "TERRENCE", "speaker": 3, "ext": [], "paren": ["to Yuki"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "I think so.", "name": "YUKI", "speaker": 2, "ext": [], "paren": ["breathless"], "dual": false, "present": [0, 1, 2, 3, 4]}]}