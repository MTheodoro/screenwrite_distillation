{"scene_id": "s00547", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00547.fountain", "heading": "INT. NIGHT TRAIN \"ALBATROSS\" - SLEEPER CAR - NIGHT", "cast": [{"id": 0, "name": "INSPECTOR ABEL STROM", "names": ["INSPECTOR ABEL STROM", "STROM"], "gender": "m", "first": 5, "spoke": 12}, {"id": 1, "name": "MADAME VALENTINE ROUX", "names": ["MADAME VALENTINE ROUX", "ROUX"], "gender": "?", "first": 9, "spoke": 4}, {"id": 2, "name": "HESTER PRYCE", "names": ["HESTER PRYCE", "PRYCE"], "gender": "m", "first": 26, "spoke": 8}, {"id": 3, "name": "PORTER GILES", "names": ["PORTER GILES", "GILES"], "gender": "m", "first": 31, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT TRAIN \"ALBATROSS\" - SLEEPER CAR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A narrow corridor of polished mahogany and brass fixtures.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Curtains drawn over the windows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Beyond them, the dark rushes by.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The carriage sways in a long steady pulse.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "INSPECTOR ABEL STROM, 50s, a hat too small for his head, a ticket punch in one hand, walks the corridor slowly, checking doors, listening.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "At each cabin he pauses.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "At the third he knocks.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "A door opens a crack.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "MADAME VALENTINE ROUX, 60s, a silk robe and a cold cream mask, peers out with an eye like a coin.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Yes?", "name": "ROUX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Madame. A disturbance reported. Did you hear anything?", "name": "STROM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I hear the train. I hear my own pulse. I hear a gentleman in the corridor who will not let a woman sleep.", "name": "ROUX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "My apologies. Have you seen anyone pass?", "name": "STROM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She considers him.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Behind her, a light flicks on in the next compartment.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Only the doctor.", "name": "ROUX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Which doctor?", "name": "STROM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "The one in four.", "name": "ROUX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She shuts the door.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "He moves on.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Cabin four.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "He raises his hand to knock, hesitates, listens.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "A soft murmur inside, a woman's voice.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "He taps.", "para": 4, "sent": 5, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "The door opens.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "DR. HESTER PRYCE, 40s, a black medical bag in one hand and a wet handkerchief in the other, regards him with sleepless composure.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Inspector.", "name": "PRYCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Doctor. I'm told you were attending someone.", "name": "STROM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "A porter. A faint. Nothing serious.", "name": "PRYCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Which porter?", "name": "STROM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "The young one. Giles.", "name": "PRYCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Ah.", "name": "STROM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "He peers past her shoulder.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "The compartment is dim.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "A figure lies on the lower berth, motionless under a blanket.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "PORTER GILES, 20s, in a half-buttoned uniform, one hand pressed to his temple, lifts his head and gives a weak, apologetic smile.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Sorry for the fuss, sir.", "name": "GILES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Nothing to apologize for, my boy. Rest.", "name": "STROM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "He steps back.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Pryce eases the door half closed.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "For a moment their eyes hold.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "She is calm.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "He is polite.", "para": 8, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Neither blinks.", "para": 8, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Doctor, a curious thing. The ticket in your name was bought in Vienna.", "name": "STROM", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "It was.", "name": "PRYCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "And yet the conductor reports you boarded in Prague.", "name": "STROM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "He's mistaken.", "name": "PRYCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "He rarely is.", "name": "STROM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "She smiles.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "It is a small, tired smile.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Inspector, would you care for tea?", "name": "PRYCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "I would like the truth, Doctor.", "name": "STROM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Over tea.", "name": "PRYCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "He thinks.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Nods once.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "She opens the door wider.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "He enters.", "para": 10, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "The compartment smells of lavender and iodine.", "para": 10, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "On the lower berth, Giles has gone still.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "His eyes are open.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "He is not looking at the Inspector.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "He is looking at Pryce.", "para": 11, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "Doctor. Your patient is not breathing.", "name": "STROM", "speaker": 0, "ext": [], "paren": ["gently"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "Pryce does not turn.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "I know.", "name": "PRYCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "She closes the door.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "The latch clicks.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "In the corridor, Madame Roux's door opens again, an inch, and a single coin-bright eye peers out.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "It watches the door of cabin four for a long time.", "para": 13, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "Then, quietly, it shuts.", "para": 13, "sent": 4, "present": [0, 1, 2, 3]}]}