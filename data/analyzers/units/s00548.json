{"scene_id": "s00548", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00548.fountain", "heading": "INT. WILLOWBROOK CRICKET PAVILION - RAIN DELAY - DAY", "cast": [{"id": 0, "name": "BHASKAR VENKATARAMAN", "names": ["BHASKAR VENKATARAMAN", "BHASKAR"], "gender": "?", "first": 6, "spoke": 14}, {"id": 1, "name": "LORD WILLOUGHBY", "names": ["LORD WILLOUGHBY", "WILLOUGHBY"], "gender": "m", "first": 9, "spoke": 18}, {"id": 2, "name": "FANSHAWE", "names": ["FANSHAWE"], "gender": "?", "first": 9, "spoke": 0}, {"id": 3, "name": "FLORENCE OKONKWO-BEAUFORT", "names": ["FLORENCE OKONKWO-BEAUFORT", "FLORENCE"], "gender": "f", "first": 31, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. WILLOWBROOK CRICKET PAVILION - RAIN DELAY - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Dark wood.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A bar with brass taps.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Team photographs from a century of afternoons.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain hammers the tin roof so hard the room rings.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Through the long window, the pitch is a lake.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "BHASKAR VENKATARAMAN, 40s, the home captain, in whites stained green at the knee, stands at the window, arms crossed.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "He is silent.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "He has been silent for forty minutes.", "para": 1, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "LORD WILLOUGHBY \"BILLY\" FANSHAWE, 60s, the visiting captain, a blazer and a cravat, sits in a leather armchair with a tumbler of whisky and a newspaper.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "He turns a page.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He sips.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Awful weather.", "name": "WILLOUGHBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Mm.", "name": "BHASKAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Might be a draw.", "name": "WILLOUGHBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Mm.", "name": "BHASKAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "I say, are you going to say anything other than \"Mm\"?", "name": "WILLOUGHBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I am conserving words.", "name": "BHASKAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "For what?", "name": "WILLOUGHBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "For when you apologize.", "name": "BHASKAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Willoughby lowers the paper.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Studies him over his glasses.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Apologize? For what, pray?", "name": "WILLOUGHBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "For the run-out.", "name": "BHASKAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Ah. That.", "name": "WILLOUGHBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Yes. That.", "name": "BHASKAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "It was a perfectly legal run-out.", "name": "WILLOUGHBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "It was a gentleman's agreement. We had it. You broke it.", "name": "BHASKAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Gentlemen's agreements are a bit rich, aren't they? Between you and me?", "name": "WILLOUGHBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Rain thunders.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Somewhere a gutter overflows.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "FLORENCE OKONKWO-BEAUFORT, 70s, the club umpire, in a white coat and a flat cap, pushes in through the side door with a golf umbrella that is not helping.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "She stamps her boots.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Gentlemen! Ground's unplayable. I've called it.", "name": "FLORENCE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Thank you, Florence.", "name": "BHASKAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Dreadful, Florence. Utterly dreadful.", "name": "WILLOUGHBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Don't you \"dreadful\" me, Billy Fanshawe. I saw that run-out.", "name": "FLORENCE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Madam --", "name": "WILLOUGHBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "She saw it.", "name": "BHASKAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Thank you, Bhaskar, I can speak for myself --", "name": "WILLOUGHBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "I've umpired for thirty-one years. I've seen every kind of foul play. But I've never seen a man do it with such a smile.", "name": "FLORENCE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "It was an honest mistake.", "name": "WILLOUGHBY", "speaker": 1, "ext": [], "paren": ["stiffly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "It wasn't.", "name": "BHASKAR", "speaker": 0, "ext": [], "paren": ["to Florence"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "It wasn't.", "name": "FLORENCE", "speaker": 3, "ext": [], "paren": ["to Bhaskar"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Willoughby sets down his glass.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "The ice clinks.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "He stands, too fast, and knocks his knee against the table.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Very well! I concede! It was a bad piece of sportsmanship!", "name": "WILLOUGHBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Rain.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "The old photographs watch from the walls.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "And?", "name": "BHASKAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "And... I apologize.", "name": "WILLOUGHBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "To whom?", "name": "BHASKAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "To you, Captain Venkataraman.", "name": "WILLOUGHBY", "speaker": 1, "ext": [], "paren": ["through his teeth"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "And?", "name": "BHASKAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "And to Florence.", "name": "WILLOUGHBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "And?", "name": "FLORENCE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "And... to the game.", "name": "WILLOUGHBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "The tin roof crackles.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "Bhaskar's mouth twitches.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "Florence shakes her umbrella, spraying them both.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "Thank you.", "name": "BHASKAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "Tea?", "name": "FLORENCE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "Whisky.", "name": "WILLOUGHBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "Tea.", "name": "FLORENCE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "She pours three cups from a brown pot.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "They sit around the table, three old foes in damp white, listening to the water drown the pitch.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}]}