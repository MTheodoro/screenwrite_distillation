{"scene_id": "s00549", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00549.fountain", "heading": "INT. LUNAR RADIO OBSERVATORY - CONTROL ROOM - DAY", "cast": [{"id": 0, "name": "COMMANDER NATHANIEL ASHBY", "names": ["COMMANDER NATHANIEL ASHBY", "ASHBY"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "PRIYAMVADA LUTHRA", "names": ["PRIYAMVADA LUTHRA", "LUTHRA"], "gender": "?", "first": 5, "spoke": 6}, {"id": 2, "name": "PETROVSKY", "names": ["PETROVSKY"], "gender": "?", "first": 6, "spoke": 3}, {"id": 3, "name": "MISS ELLINGTON", "names": ["MISS ELLINGTON", "ELLINGTON"], "gender": "?", "first": 7, "spoke": 3}, {"id": 4, "name": "TECH DOYLE", "names": ["TECH DOYLE", "DOYLE"], "gender": "?", "first": 8, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. LUNAR RADIO OBSERVATORY - CONTROL ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A cramped steel room lit by banks of green screens.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Out the porthole, a grey plain of regolith and a dish the size of a stadium tilting toward the stars.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The air tastes of recycled coffee.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "COMMANDER NATHANIEL ASHBY, 50s, a command jacket and a weary jaw, sits in the center seat.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "DR. PRIYAMVADA LUTHRA, 40s, in a lab coat, stands at the main console.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "MR. PETROVSKY, 60s, the old engineer, eats from a tube.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "MISS ELLINGTON, 30s, a communications officer with a headset.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "TECH DOYLE, 20s, a freckled intern, hugs a clipboard.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Dr. Luthra. Report.", "name": "ASHBY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Three signals. Same source. Same frequency. Same pattern every eleven minutes.", "name": "LUTHRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "It repeats exactly.", "name": "ELLINGTON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "No natural source repeats exactly.", "name": "PETROVSKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Could it be a pulsar?", "name": "DOYLE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Pulsars drift. This doesn't.", "name": "LUTHRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Origin?", "name": "ASHBY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Sagittarius. Forty light years.", "name": "LUTHRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "So whoever sent it, sent it forty years ago.", "name": "PETROVSKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Or they're still sending.", "name": "ELLINGTON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Does it say anything?", "name": "DOYLE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "It's a prime sequence. Two, three, five, seven, eleven. Then a gap. Then --", "name": "LUTHRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Then?", "name": "ASHBY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Then our own coordinates.", "name": "LUTHRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Silence.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "The dish groans outside, a long metallic sound.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Our coordinates. The Moon's.", "name": "PETROVSKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "The Moon's. Down to the meter.", "name": "LUTHRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Somebody knows we're here.", "name": "ELLINGTON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Or somebody always did.", "name": "DOYLE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Ashby stands.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Looks at the screens.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Looks at the porthole.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "The dish turns another degree.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Send nothing. Log everything. Nobody leaves this room.", "name": "ASHBY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}