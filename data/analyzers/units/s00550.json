{"scene_id": "s00550", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00550.fountain", "heading": "INT. MUSEUM OF LOCKS AND KEYS - GALLERY OF CURIOSITIES - NIGHT", "cast": [{"id": 0, "name": "CLEO ANTONOPOULOS", "names": ["CLEO ANTONOPOULOS", "CLEO"], "gender": "?", "first": 4, "spoke": 11}, {"id": 1, "name": "BARNABY SOUTHWORTH", "names": ["BARNABY SOUTHWORTH", "BARNABY"], "gender": "?", "first": 11, "spoke": 11}, {"id": 2, "name": "GUARD ENOCH BALOGUN", "names": ["GUARD ENOCH BALOGUN", "ENOCH"], "gender": "m", "first": 45, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. MUSEUM OF LOCKS AND KEYS - GALLERY OF CURIOSITIES - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Glass cases glow under museum spots.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Padlocks shaped like hearts, a chastity belt, a Houdini handcuff, a Chubb detector from 1818.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The marble floor is clean enough to eat from.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CLEO ANTONOPOULOS, 30s, in a cleaner's grey uniform, pushes a mop bucket along the aisle.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Slow.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Humming.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "Wringing the mop, slopping water.", "para": 1, "sent": 3, "present": [0]}, {"u": 8, "kind": "action", "text": "At the far end of the gallery a vault door waits, painted gold.", "para": 1, "sent": 4, "present": [0]}, {"u": 9, "kind": "action", "text": "Fake.", "para": 1, "sent": 5, "present": [0]}, {"u": 10, "kind": "action", "text": "Almost.", "para": 1, "sent": 6, "present": [0]}, {"u": 11, "kind": "action", "text": "BARNABY SOUTHWORTH, 50s, the curator, in a cardigan and bow tie, sits at the security desk with a crossword.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He is happy.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "The room is quiet.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "A radio plays softly.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Seven letters. \"Opener of doors.\"", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Key?", "name": "CLEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Too short.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Skeleton?", "name": "CLEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Nine.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Master.", "name": "CLEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Six.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Cleo smiles.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Wrings the mop.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Water pools near a floor drain by the case of antique keys.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "You're very diligent, Cleo.", "name": "BARNABY", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "It's a good floor.", "name": "CLEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Most of the staff would've gone home.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Most of the staff aren't paid by the hour.", "name": "CLEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "He laughs.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "She pushes the bucket another yard.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "The wheels squeak.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "He doesn't look up.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "She taps a button on the handle of the mop.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "A quiet click.", "para": 4, "sent": 5, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "The security camera in the corner swivels, slow, until it faces the wall.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "\"Skeleton\" doesn't fit, does it?", "name": "BARNABY", "speaker": 1, "ext": [], "paren": ["still filling the crossword"], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "No.", "name": "CLEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Well, I'm stuck.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "I'll help.", "name": "CLEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "She sets down the mop.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Walks to the golden vault door and, from her bucket, produces a stethoscope and a small brass pick.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "She presses her ear to the cold gold.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Turns a tumbler.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "Another.", "para": 6, "sent": 4, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "GUARD ENOCH BALOGUN, 40s, a thick neck and a creaking belt, rounds the corner with a flashlight, whistling.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "He stops.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Looks at Cleo.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Looks at the open bucket.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Looks at the camera facing the wall.", "para": 7, "sent": 4, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Ma'am.", "name": "ENOCH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Evening, Enoch.", "name": "CLEO", "speaker": 0, "ext": [], "paren": ["without turning"], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "That's not on the schedule.", "name": "ENOCH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "No.", "name": "CLEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Barnaby finally looks up, sees the guard, sees Cleo, sees the pick.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "His pencil stops.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "Oh, dear.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Enoch's hand drifts toward his radio.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Cleo's hand does not leave the vault.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Tumbler clicks.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "A heavy thunk.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Enoch. Put the radio down.", "name": "CLEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "Ma'am --", "name": "ENOCH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "Please.", "name": "CLEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "He considers.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "The radio comes down.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "He steps aside, and with a courtly gesture, motions toward the vault.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 67, "kind": "dialogue", "text": "After you.", "name": "ENOCH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "Cleo pulls.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "The door swings open on an empty velvet chamber with a single card: GONE FISHING.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "She stares.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 71, "kind": "dialogue", "text": "Seven letters. \"Opener of doors.\"", "name": "BARNABY", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}, {"u": 72, "kind": "dialogue", "text": "Trickster.", "name": "ENOCH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 73, "kind": "dialogue", "text": "Yes, that's it.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}