{"scene_id": "s00551", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00551.fountain", "heading": "INT. ARCTIC SEAFOOD COLD STORAGE - LOADING BAY - NIGHT", "cast": [{"id": 0, "name": "SOLEDAD RIVERA", "names": ["SOLEDAD RIVERA", "SOLEDAD"], "gender": "?", "first": 7, "spoke": 10}, {"id": 1, "name": "WYATT PRUITT", "names": ["WYATT PRUITT", "WYATT"], "gender": "?", "first": 8, "spoke": 3}, {"id": 2, "name": "LINH TRAN", "names": ["LINH TRAN", "LINH"], "gender": "?", "first": 9, "spoke": 5}, {"id": 3, "name": "IGNATIUS OKORO", "names": ["IGNATIUS OKORO", "IGNATIUS"], "gender": "?", "first": 10, "spoke": 6}, {"id": 4, "name": "FERN HALLORAN-BOSE", "names": ["FERN HALLORAN-BOSE", "FERN"], "gender": "f", "first": 11, "spoke": 6}, {"id": 5, "name": "BOONE DAKOTA", "names": ["BOONE DAKOTA", "BOONE"], "gender": "?", "first": 12, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. ARCTIC SEAFOOD COLD STORAGE - LOADING BAY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Minus twenty-five.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Breath fogs the air like cigar smoke.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Pallets of frozen cod stacked ten feet high, shrink-wrapped, glittering with frost.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A forklift sleeps beside a hanging scale.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Strip lights hum.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "Six figures in white parkas move through the aisle with the quiet efficiency of a crew that has done this before.", "para": 1, "sent": 0, "present": []}, {"u": 7, "kind": "action", "text": "SOLEDAD RIVERA, 40s, the planner, leads, carrying a blueprint rolled in a tube.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "WYATT PRUITT, 30s, the driver, gnaws a toothpick and watches the door.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "LINH TRAN, 30s, the safecracker, drags a rolling case with a plasma cutter.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "IGNATIUS OKORO, 50s, the inside man, in a foreman's hard hat, jingles a ring of keys.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "FERN HALLORAN-BOSE, 20s, a hacker, cradles a laptop in gloved hands.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "BOONE DAKOTA, 40s, the muscle, carries a duffel in each fist.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Remember. We're out in twelve.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Van's at the dock.", "name": "WYATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Cameras are looped.", "name": "FERN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Vault's behind the tuna. Third freezer.", "name": "LINH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "That's the one with the red tag.", "name": "IGNATIUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Boone. Door.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "On it.", "name": "BOONE", "speaker": 5, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "He sets the duffels down and shoulders a heavy steel door, the hinge shrieking in the cold.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "They enter a smaller freezer.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Hanging halves of beef sway.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Linh crouches at a steel panel in the back wall.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Here.", "name": "LINH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "She flips a switch.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "The plasma cutter hisses, blue-white, and begins to draw a circle on the steel.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Sparks fall like snow.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Fern stands guard with the laptop open, tapping.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Come on, come on, stay dumb...", "name": "FERN", "speaker": 4, "ext": [], "paren": ["muttering to herself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Twelve minutes.", "name": "WYATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Eleven.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Is it always this cold?", "name": "IGNATIUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "It's a freezer.", "name": "BOONE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "I meant the vault.", "name": "IGNATIUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "The vault's not cold. It's a safe room. It has a heater.", "name": "LINH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Why would it have a heater?", "name": "IGNATIUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Because someone puts a person in it.", "name": "LINH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "They all look at her.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "She doesn't look up.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "The cutter sputters.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Let's keep our heads. Boone, how's the watch?", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": ["to the group"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Quiet.", "name": "BOONE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "Quiet is bad.", "name": "WYATT", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Fern's laptop chirps.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "A red banner scrolls across the screen.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Her face drains.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "Sol.", "name": "FERN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "What?", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "The loop broke.", "name": "FERN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "Linh kills the cutter.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "The silence is enormous.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "How long?", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "Ninety seconds.", "name": "FERN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "That's impossible. I set the loop.", "name": "IGNATIUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "Somebody else did.", "name": "BOONE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "They freeze.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "Down the corridor, far off, boots on concrete.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "Several pairs.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "Unhurried.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "Positions.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "Wyatt slides behind a pallet.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "Boone pulls the door shut.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "Linh unsnaps a pocket.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "Fern closes her laptop and puts it on the floor, very gently.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "Ignatius backs against a hanging side of beef.", "para": 9, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "dialogue", "text": "Ignatius. Who knew about this?", "name": "SOLEDAD", "speaker": 0, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "dialogue", "text": "Just us.", "name": "IGNATIUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "dialogue", "text": "Just us.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "action", "text": "She stares at him.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "action", "text": "Slowly, his hand goes to his hard hat.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "action", "text": "He removes it, as if to scratch his head, and the strip light catches a small black earpiece in his ear.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "dialogue", "text": "Oh, Ignatius.", "name": "LINH", "speaker": 2, "ext": [], "paren": ["very quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "action", "text": "The freezer door swings open on its own.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "action", "text": "Beyond it, only the dark corridor and the sound of boots, closer.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 75, "kind": "dialogue", "text": "It's a trap.", "name": "FERN", "speaker": 4, "ext": [], "paren": ["under her breath"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 76, "kind": "dialogue", "text": "Of course it's a trap, Fern. It's always a trap.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 77, "kind": "action", "text": "Boone raises a fist.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 78, "kind": "action", "text": "Wyatt cocks a pistol.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 79, "kind": "action", "text": "Linh lifts the cutter like a lance.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 80, "kind": "action", "text": "The boots stop outside, and the frost between them seems to hold its breath.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}]}