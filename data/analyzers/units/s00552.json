{"scene_id": "s00552", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00552.fountain", "heading": "INT. HOSPITAL CORRIDOR - VENDING ALCOVE - 4 A.M.", "cast": [{"id": 0, "name": "AGNES PRZYBYLSKI", "names": ["AGNES PRZYBYLSKI", "AGNES"], "gender": "?", "first": 4, "spoke": 23}, {"id": 1, "name": "WALTER OKAFOR", "names": ["WALTER OKAFOR", "WALTER"], "gender": "f", "first": 9, "spoke": 23}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOSPITAL CORRIDOR - VENDING ALCOVE - 4 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "A narrow nook off the oncology ward.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A humming vending machine with half its snacks sold out, a stained couch, a wall clock that has lost its minute hand.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Fluorescent light falls flat across everything.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "AGNES PRZYBYLSKI, 70s, in a cardigan buttoned wrong, feeds a dollar bill into the machine.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "The machine spits it back.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "She smooths it on the glass.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "Feeds it again.", "para": 1, "sent": 3, "present": [0]}, {"u": 8, "kind": "action", "text": "It spits it back.", "para": 1, "sent": 4, "present": [0]}, {"u": 9, "kind": "action", "text": "WALTER OKAFOR, 70s, in a hospital gown and a pair of borrowed slippers, shuffles in with an IV pole, and settles onto the couch, wincing, and watches her fail a third time.", "para": 1, "sent": 5, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "It doesn't like that one.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "It's a dollar.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Not that dollar.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She tries a different bill.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "The machine takes it.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "A coil turns.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "A bag of pretzels falls.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Thank you.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "You're welcome.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "I wasn't talking to you.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "I know.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She retrieves the pretzels and sits on the other end of the couch.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "She opens the bag.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Offers him one without looking.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "He takes it.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "My husband's in 412.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Mine's in 414.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Your husband?", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "My wife. I misspoke. It's the hour.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Mm.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "They chew.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "The vending machine hums.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "A cart rattles somewhere down the hall.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "What's he got?", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Lungs.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Mine's a pancreas.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "That's a bad one.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "It is.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Mine too, I suppose.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "You suppose.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "She turns the empty bag in her hands, folds it into a precise little triangle.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "I'm supposed to be strong. He's the one in the bed. But I'm the one who needs to be told what to eat.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "I eat nothing. I just carry the pole around.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Does it help?", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Somewhat. It gives me something to hold.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "She laughs, a real, small laugh.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "He smiles.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "They sit with that for a minute.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "The clock without a minute hand shows 4:00, as it has for years.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "What's her name?", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Delia.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Delia. That's pretty.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "It is.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "And does she know you're out here?", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "She's asleep.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "Does yours?", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "Walter?", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "No. I'm Agnes. Your wife.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "I know who you are.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "You called me Delia.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "He stops.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "A beat.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "He looks at his own hand, the cuff of the gown, the IV.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "He looks at her.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "His whole face collapses and reassembles itself.", "para": 7, "sent": 4, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "Agnes.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "Yes.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "You're the one in 414.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "I'm the one in 412. You're 414.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "Then who's in 412?", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "My husband.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "dialogue", "text": "Who's your husband?", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 72, "kind": "dialogue", "text": "You, Walter.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "He nods slowly.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 74, "kind": "action", "text": "His eyes fill.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 75, "kind": "action", "text": "She takes his hand, the one without the IV, and holds it in both of hers.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 76, "kind": "dialogue", "text": "It's four in the morning. Let's go back.", "name": "AGNES", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 77, "kind": "dialogue", "text": "Can I have a pretzel first?", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 78, "kind": "action", "text": "She hands him the empty bag.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 79, "kind": "action", "text": "He holds it like a relic.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 80, "kind": "dialogue", "text": "They're all gone.", "name": "WALTER", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 81, "kind": "dialogue", "text": "We'll get more.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 82, "kind": "action", "text": "She feeds the machine another dollar.", "para": 10, "sent": 0, "present": [0, 1]}]}