{"scene_id": "s00553", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00553.fountain", "heading": "INT. STRIKE ZONE LANES - LOCKER ROOM - NIGHT", "cast": [{"id": 0, "name": "COACH WENDELL HUXLEY", "names": ["COACH WENDELL HUXLEY", "HUXLEY"], "gender": "m", "first": 5, "spoke": 17}, {"id": 1, "name": "DEXTER MALONE-ADEYEMI", "names": ["DEXTER MALONE-ADEYEMI", "DEXTER"], "gender": "m", "first": 7, "spoke": 11}, {"id": 2, "name": "ROMEO BALDERRAMA", "names": ["ROMEO BALDERRAMA", "ROMEO"], "gender": "m", "first": 8, "spoke": 11}], "units": [{"u": 0, "kind": "heading", "text": "INT. STRIKE ZONE LANES - LOCKER ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dented lockers.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A bench scarred with initials.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single bulb swings over a pile of bowling bags.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The sound of the league championship, the other team cheering, drifts through the wall like a taunt.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "COACH WENDELL HUXLEY, 60s, in a polyester team jacket and bifocals, sits on an upturned bucket, clipboard on his knee.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "He does not look at it.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "DEXTER MALONE-ADEYEMI, 30s, a gangling anchor bowler, sits on the bench, hands hanging between his knees.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "ROMEO BALDERRAMA, 20s, a rookie, paces in front of the lockers, rolling a ball from palm to palm.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Gentlemen.", "name": "HUXLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Don't say it.", "name": "ROMEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I will say it.", "name": "HUXLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "He's going to say it.", "name": "DEXTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "We lost.", "name": "HUXLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "We lost by six pins.", "name": "ROMEO", "speaker": 2, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Seven.", "name": "DEXTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Seven. Thank you, Dexter.", "name": "HUXLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "It was the tenth frame.", "name": "ROMEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "It was always going to be the tenth frame.", "name": "DEXTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Nothing is always going to be the tenth frame.", "name": "HUXLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Coach, I left the seven pin standing.", "name": "ROMEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "I know.", "name": "HUXLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "I had it. I had the whole lane.", "name": "ROMEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "You had a lane. You didn't have the whole lane. Nobody has the whole lane.", "name": "HUXLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Does anyone have a beer?", "name": "DEXTER", "speaker": 1, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "No.", "name": "HUXLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Because I would like a beer.", "name": "DEXTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Dexter, you're thirty-four. Behave.", "name": "HUXLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "I'm behaving. I'm behaving like a man who just threw a four-ten split in front of his mother.", "name": "DEXTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "She was clapping.", "name": "ROMEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "She was clapping out of pity.", "name": "DEXTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "She was clapping because you're her son.", "name": "HUXLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Same thing.", "name": "DEXTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "A beat.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Romeo laughs, short and ugly.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Dexter starts too.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Huxley fights it.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Fails.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "All right. All right. Listen. Both of you. I have coached this team for twenty-two years.", "name": "HUXLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Twenty-three.", "name": "ROMEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Twenty-three. And I have never once lost a championship by less than ten pins.", "name": "HUXLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "So this is progress.", "name": "DEXTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "This is the closest we've ever been.", "name": "HUXLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "That's supposed to make me feel better?", "name": "ROMEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "No. It's supposed to make you angry.", "name": "HUXLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "It does.", "name": "ROMEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Good. Hold that.", "name": "HUXLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "He stands.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Hands each of them a towel from a pile.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Dexter wipes his face.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Romeo hangs his around his neck like a boxer.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Next season, we come back. And we do not say sorry. We say hello.", "name": "HUXLEY", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the room, as to a crowd"], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Hello.", "name": "DEXTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Hello.", "name": "ROMEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "Louder.", "name": "HUXLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "HELLO!", "name": "DEXTER", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "HELLO!", "name": "ROMEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Beyond the wall, the cheering dies.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "A janitor starts a floor-buffer.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Huxley picks up his clipboard, crosses out something, and writes, in pencil: NEXT YEAR.", "para": 4, "sent": 2, "present": [0, 1, 2]}]}