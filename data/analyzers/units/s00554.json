{"scene_id": "s00554", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00554.fountain", "heading": "INT. ST. AMBROSE BAKERY - OVEN TUNNEL - NIGHT", "cast": [{"id": 0, "name": "ODILE LAFARGE-MENDOZA", "names": ["ODILE LAFARGE-MENDOZA", "ODILE"], "gender": "?", "first": 4, "spoke": 14}, {"id": 1, "name": "MARCELLUS TREMAINE", "names": ["MARCELLUS TREMAINE", "MARCELLUS"], "gender": "m", "first": 5, "spoke": 11}, {"id": 2, "name": "TOBIAS GR", "names": ["TOBIAS GR", "TOBIAS"], "gender": "m", "first": 6, "spoke": 15}, {"id": 3, "name": "NEWALD", "names": ["NEWALD"], "gender": "?", "first": 6, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. ST. AMBROSE BAKERY - OVEN TUNNEL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A brick vault, black with a century of smoke.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Iron doors, cooling racks, the slow smell of yesterday's bread.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "At the far end, a hole in the wall where the old coal chute used to be, just wide enough for a crouching man.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ODILE LAFARGE-MENDOZA, 40s, in a baker's apron over a black jumpsuit, kneels at the wall with a chisel and a mallet, coaxing a brick loose with a baker's patience.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "MARCELLUS TREMAINE, 60s, flour on his forearms, stands guard at the tunnel mouth, ear cocked toward the street.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "TOBIAS GR\u00dcNEWALD, 20s, the apprentice, hugs a lantern and a tray of rolls for cover.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Marcellus. Time.", "name": "ODILE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Eleven past.", "name": "MARCELLUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Then we have until half.", "name": "ODILE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "What happens at half?", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "The delivery truck.", "name": "MARCELLUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "I thought it came at four.", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "It does. But the driver likes to sit and smoke.", "name": "MARCELLUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Which gives us twenty minutes.", "name": "ODILE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "To do what?", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "To go through a wall.", "name": "ODILE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Tobias swallows.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Sets down the tray.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "The tunnel is hot and the lantern is trembling.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Odile pries the brick free.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "It falls with a soft cough.", "para": 2, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Beyond: dark, a draft of cold air, a faint metallic gleam.", "para": 2, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "That's it.", "name": "MARCELLUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "That's it.", "name": "ODILE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "What is?", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "The bank vault.", "name": "MARCELLUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "The bank is on the other side of the street.", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "And the bakery is on this side. And the tunnel crosses under.", "name": "ODILE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "You never said it was a bank.", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "We said it was bread.", "name": "MARCELLUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "This is not bread!", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Hush.", "name": "ODILE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "She puts a finger to her lips.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "They listen.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "The tunnel breathes.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Somewhere above them, a car passes, tires hissing on wet cobbles.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Tobias. You've worked here three years.", "name": "ODILE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Yes.", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Have we ever been late with a loaf?", "name": "ODILE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "No.", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Have we ever been short?", "name": "ODILE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "No.", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "So do you trust me?", "name": "ODILE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "...Yes.", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Then hold the lantern.", "name": "ODILE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "He holds it.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "His hand stops shaking.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "She crawls into the hole.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Marcellus passes her the mallet, then the chisel, then a long, thin steel probe.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "She disappears into the dark.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "A scrape.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "A tap.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "A silence.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "A long, long silence.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "What's she doing?", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Listening.", "name": "MARCELLUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "To what?", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "To the lock.", "name": "MARCELLUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "Locks don't talk.", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "Everything talks, lad. You just have to be quiet enough.", "name": "MARCELLUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "A click.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "A heavy mechanical sigh.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "Odile's voice drifts out of the hole, muffled and amused.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "Gentlemen. We're in.", "name": "ODILE", "speaker": 0, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "Marcellus and Tobias exchange a look.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "Tobias laughs, a cracked, delighted laugh, and covers his mouth with a flour-white hand.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "Marcellus claps him on the back.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "The lantern swings, throwing gold across the old brick.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "dialogue", "text": "Twenty minutes, Odile.", "name": "MARCELLUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "dialogue", "text": "Eighteen.", "name": "ODILE", "speaker": 0, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "dialogue", "text": "What do we do?", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "We bake.", "name": "MARCELLUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}