{"scene_id": "s00555", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00555.fountain", "heading": "INT. DEEP-SEA RESEARCH STATION \"ABYSSAL ONE\" - OBSERVATION DOME - NIGHT", "cast": [{"id": 0, "name": "ARUNDHATI SENGUPTA", "names": ["ARUNDHATI SENGUPTA", "SENGUPTA"], "gender": "f", "first": 5, "spoke": 20}, {"id": 1, "name": "LIEUTENANT KAVEH MORTAZAVI", "names": ["LIEUTENANT KAVEH MORTAZAVI", "KAVEH"], "gender": "?", "first": 6, "spoke": 19}], "units": [{"u": 0, "kind": "heading", "text": "INT. DEEP-SEA RESEARCH STATION \"ABYSSAL ONE\" - OBSERVATION DOME - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A glass bubble on the ocean floor, three thousand meters down.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Beyond the curved glass: black water, drifting snow, a lamp throwing a lonely cone.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Pipes sweat.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A kettle ticks on a hot plate.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. ARUNDHATI SENGUPTA, 50s, a thermal sweater and wire-rimmed glasses, sits cross-legged on the deck with a thermos.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "LIEUTENANT KAVEH MORTAZAVI, 30s, in a naval jumpsuit, stands at the glass, one palm flat against it.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Did you see that?", "name": "KAVEH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "See what?", "name": "SENGUPTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Something moved.", "name": "KAVEH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Something always moves, Lieutenant. It's the deep sea.", "name": "SENGUPTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Not like that.", "name": "KAVEH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Describe it.", "name": "SENGUPTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Big. Slow. Pale. It went across the lamp and then, nothing.", "name": "KAVEH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Anglerfish. Or a squid. Or the reflection of your own eyelid.", "name": "SENGUPTA", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "It was not my eyelid.", "name": "KAVEH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Then it was a sperm whale.", "name": "SENGUPTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Not at this depth.", "name": "KAVEH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "No.", "name": "SENGUPTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She unscrews the thermos.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Pours.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Offers him a cup.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "He doesn't take it.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Kaveh. When did you last sleep?", "name": "SENGUPTA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "I don't remember.", "name": "KAVEH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Thirty-one hours. I counted.", "name": "SENGUPTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "You counted?", "name": "KAVEH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "I count everything. It's a scientific disorder.", "name": "SENGUPTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "He almost laughs.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Then the lamp flickers.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "The water beyond the glass shifts and the snow swirls into a vortex.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Kaveh steps back.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "There. There it is.", "name": "KAVEH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Sengupta rises.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Joins him.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "A vast pale shape, a flank, a curve, slides across the glass, brushing it, so close its skin leaves a smear in the silt.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "For a long moment the two of them simply stare.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Oh.", "name": "SENGUPTA", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "What is it?", "name": "KAVEH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "I have no name for it.", "name": "SENGUPTA", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "You always have a name.", "name": "KAVEH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Not for this.", "name": "SENGUPTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "The shape rolls.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "An eye the size of a dinner plate regards them through the glass, wet and black, ancient, unhurried.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "It's looking at us.", "name": "KAVEH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Yes.", "name": "SENGUPTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Is it dangerous?", "name": "KAVEH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "I think it's curious.", "name": "SENGUPTA", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Is that better?", "name": "KAVEH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "It depends on what it's curious about.", "name": "SENGUPTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "A low hum builds in the station walls, a vibration they feel in their teeth.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "The kettle rattles on the hot plate.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "The creature presses a flipper against the dome, and the glass creaks.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "Doctor.", "name": "KAVEH", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "I know.", "name": "SENGUPTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "That's a stress fracture.", "name": "KAVEH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "I know.", "name": "SENGUPTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "We should seal the dome.", "name": "KAVEH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "No. Wait.", "name": "SENGUPTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "She lifts one hand and, slowly, places her palm on the glass opposite the creature's flipper.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "The hum falls.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "The creak stops.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "The great eye blinks, and the creature drifts back, and back, until it is only a pale suggestion in the dark.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "Kaveh lets out a breath that fogs the glass.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "Sengupta lowers her hand, picks up the thermos, and pours herself a cup that shakes in her grip.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "You were right.", "name": "KAVEH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "About what?", "name": "SENGUPTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "Curious.", "name": "KAVEH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "I do hate being right at depth.", "name": "SENGUPTA", "speaker": 0, "ext": [], "paren": ["smiling, tired"], "dual": false, "present": [0, 1]}]}