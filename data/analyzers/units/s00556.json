{"scene_id": "s00556", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00556.fountain", "heading": "INT. THE GILDED MIC KARAOKE BAR - TUESDAY NIGHT", "cast": [{"id": 0, "name": "JOSEFINA OLIVEIRA", "names": ["JOSEFINA OLIVEIRA", "JOSEFINA"], "gender": "f", "first": 5, "spoke": 6}, {"id": 1, "name": "DARREN FITZWILLIAM", "names": ["DARREN FITZWILLIAM", "DARREN"], "gender": "?", "first": 6, "spoke": 7}, {"id": 2, "name": "MEI-LING CHOW", "names": ["MEI-LING CHOW", "MEI-LING"], "gender": "?", "first": 7, "spoke": 6}, {"id": 3, "name": "CHUKS", "names": ["CHUKS"], "gender": "?", "first": 8, "spoke": 4}, {"id": 4, "name": "EZEKWESILI", "names": ["EZEKWESILI"], "gender": "?", "first": 8, "spoke": 0}, {"id": 5, "name": "ANDRE BEAUCHAMP", "names": ["ANDRE BEAUCHAMP", "ANDRE"], "gender": "?", "first": 9, "spoke": 5}, {"id": 6, "name": "BETTINA KOWALSKI", "names": ["BETTINA KOWALSKI", "BETTINA"], "gender": "?", "first": 10, "spoke": 5}, {"id": 7, "name": "DJ", "names": ["DJ"], "gender": "?", "first": 10, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. THE GILDED MIC KARAOKE BAR - TUESDAY NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Sticky booths.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A disco ball missing half its mirrors.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A screen the size of a billboard scrolls lyrics in karaoke-blue.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Six strangers share one corner table, an enormous plate of fries between them.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "JOSEFINA OLIVEIRA, 30s, a leather jacket and a cautious smile, clutches a song binder.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "DARREN FITZWILLIAM, 30s, a shirt with too many buttons undone, leans back, king of the booth.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "MEI-LING CHOW, 20s, cat-eye glasses, sips a mocktail, eyes darting.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "CHUKWUEMEKA \"CHUKS\" EZEKWESILI, 30s, in a bright print shirt, drums the table with his thumbs.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "ANDRE BEAUCHAMP, 40s, quiet, nursing a ginger ale.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "BETTINA KOWALSKI, 50s, a sequined cardigan, waves her arm at the DJ.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 11, "kind": "dialogue", "text": "All right, kids. Who's going first?", "name": "BETTINA", "speaker": 6, "ext": [], "paren": ["to the table"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 12, "kind": "dialogue", "text": "Ladies first.", "name": "DARREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 13, "kind": "dialogue", "text": "That's sexist.", "name": "JOSEFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 14, "kind": "dialogue", "text": "It's chivalrous.", "name": "DARREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 15, "kind": "dialogue", "text": "It's a trap.", "name": "MEI-LING", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 16, "kind": "dialogue", "text": "I'll go.", "name": "CHUKS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 17, "kind": "dialogue", "text": "Chuks, you've been dying to go since we sat down.", "name": "ANDRE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 18, "kind": "dialogue", "text": "Because I have a gift, Andre. A gift.", "name": "CHUKS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 19, "kind": "dialogue", "text": "Do you have a number?", "name": "BETTINA", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 20, "kind": "dialogue", "text": "Eleven. \"Dancing Queen.\"", "name": "CHUKS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 21, "kind": "dialogue", "text": "Abba. Brave.", "name": "DARREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 22, "kind": "dialogue", "text": "He'll destroy it.", "name": "JOSEFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 23, "kind": "dialogue", "text": "I'll honor it.", "name": "CHUKS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 24, "kind": "action", "text": "He bounds to the stage.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 25, "kind": "action", "text": "The screen lights.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 26, "kind": "action", "text": "A familiar piano riff.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 27, "kind": "action", "text": "He grips the mic like a torch.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 28, "kind": "action", "text": "Sings the first line, loud, glorious, a note short of flat.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 29, "kind": "action", "text": "The table roars.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "dialogue", "text": "Go on, baby!", "name": "BETTINA", "speaker": 6, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "dialogue", "text": "Oh, he's actually good.", "name": "MEI-LING", "speaker": 2, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "dialogue", "text": "He's terrible.", "name": "JOSEFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "dialogue", "text": "He's terrible and good.", "name": "MEI-LING", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "dialogue", "text": "You should do one next.", "name": "DARREN", "speaker": 1, "ext": [], "paren": ["leaning toward Josefina"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "dialogue", "text": "I don't sing.", "name": "JOSEFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "dialogue", "text": "Everyone sings.", "name": "DARREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "dialogue", "text": "I sing in the shower.", "name": "JOSEFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "dialogue", "text": "Well, there's no shower here.", "name": "DARREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "dialogue", "text": "Thank God.", "name": "JOSEFINA", "speaker": 0, "ext": [], "paren": ["dry"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "dialogue", "text": "Do you want to go?", "name": "ANDRE", "speaker": 5, "ext": [], "paren": ["to Mei-Ling, quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 41, "kind": "dialogue", "text": "I'd rather die.", "name": "MEI-LING", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 42, "kind": "dialogue", "text": "I'll go with you.", "name": "ANDRE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 43, "kind": "action", "text": "She stares at him.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 44, "kind": "action", "text": "A small, astonished smile.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 45, "kind": "dialogue", "text": "You would?", "name": "MEI-LING", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 46, "kind": "dialogue", "text": "Duet. Whatever you pick.", "name": "ANDRE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 47, "kind": "dialogue", "text": "...Something slow.", "name": "MEI-LING", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 48, "kind": "dialogue", "text": "Slow's good.", "name": "ANDRE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 49, "kind": "dialogue", "text": "Look at this! Two matches and a marching band!", "name": "BETTINA", "speaker": 6, "ext": [], "paren": ["to the whole table"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 50, "kind": "dialogue", "text": "Bettina, you're a menace.", "name": "DARREN", "speaker": 1, "ext": [], "paren": ["under his breath"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 51, "kind": "dialogue", "text": "That's the nicest thing you've said all night, Darren.", "name": "BETTINA", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 52, "kind": "action", "text": "On stage, Chuks hits the chorus.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 53, "kind": "action", "text": "The whole bar sings along, shouting, tipsy, joyous.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 54, "kind": "action", "text": "Josefina, in spite of herself, mouths the words.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 55, "kind": "action", "text": "Darren sees.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 56, "kind": "action", "text": "He grins.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 57, "kind": "action", "text": "She catches him and glares, then laughs.", "para": 4, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}