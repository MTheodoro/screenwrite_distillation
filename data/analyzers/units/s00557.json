{"scene_id": "s00557", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00557.fountain", "heading": "INT. CONVERTED SCHOOL BUS BEDROOM - NIGHT", "cast": [{"id": 0, "name": "ADAEZE NWOSU", "names": ["ADAEZE", "ADAEZE NWOSU"], "gender": "f", "first": 9, "spoke": 14}], "units": [{"u": 0, "kind": "heading", "text": "INT. CONVERTED SCHOOL BUS BEDROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A decommissioned yellow bus, parked on cinder blocks in an overgrown field.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Inside, the seats are gone.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A mattress on the floor, a milk crate for a nightstand, string lights stapled to the ceiling.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A cassette recorder sits on the crate, a red light blinking.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "No one is here.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "Rain ticks on the roof.", "para": 1, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "The recorder clicks and begins to play.", "para": 2, "sent": 0, "present": []}, {"u": 8, "kind": "action", "text": "A girl's voice, young, bright, trying hard to sound older.", "para": 2, "sent": 1, "present": []}, {"u": 9, "kind": "dialogue", "text": "Test, test. Okay. It's July the ninth. I'm fourteen. I'm recording this for me. For the older me. If you're hearing it, you're, like, thirty or something.", "name": "ADAEZE", "speaker": 0, "ext": ["V.O."], "paren": ["recorded, tinny"], "dual": false, "present": [0]}, {"u": 10, "kind": "action", "text": "The bus door creaks open.", "para": 3, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "A gust of wet air.", "para": 3, "sent": 1, "present": [0]}, {"u": 12, "kind": "action", "text": "ADAEZE NWOSU, 17, a duffel bag slung over one shoulder, a high-school graduation tassel still pinned to her jacket, climbs the steps, pushing wet braids from her face.", "para": 4, "sent": 0, "present": [0]}, {"u": 13, "kind": "action", "text": "She does not see the recorder.", "para": 4, "sent": 1, "present": [0]}, {"u": 14, "kind": "action", "text": "She drops the duffel on the mattress and sits.", "para": 4, "sent": 2, "present": [0]}, {"u": 15, "kind": "dialogue", "text": "So here are my predictions. Number one. You live somewhere with a window that opens. Number two. You're not scared of anything.", "name": "ADAEZE", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": ["recorded"], "dual": false, "present": [0]}, {"u": 16, "kind": "action", "text": "Adaeze stops.", "para": 5, "sent": 0, "present": [0]}, {"u": 17, "kind": "action", "text": "Looks at the crate.", "para": 5, "sent": 1, "present": [0]}, {"u": 18, "kind": "action", "text": "Looks at the recorder.", "para": 5, "sent": 2, "present": [0]}, {"u": 19, "kind": "dialogue", "text": "No way.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0]}, {"u": 20, "kind": "dialogue", "text": "Number three. You've called Mom.", "name": "ADAEZE", "speaker": 0, "ext": ["V.O."], "paren": ["recorded"], "dual": false, "present": [0]}, {"u": 21, "kind": "action", "text": "The words hang.", "para": 6, "sent": 0, "present": [0]}, {"u": 22, "kind": "action", "text": "Adaeze sits very still.", "para": 6, "sent": 1, "present": [0]}, {"u": 23, "kind": "dialogue", "text": "I haven't.", "name": "ADAEZE", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the recorder"], "dual": false, "present": [0]}, {"u": 24, "kind": "dialogue", "text": "Number four. You've forgiven Dad.", "name": "ADAEZE", "speaker": 0, "ext": ["V.O."], "paren": ["recorded"], "dual": false, "present": [0]}, {"u": 25, "kind": "action", "text": "She turns the volume down with a finger.", "para": 7, "sent": 0, "present": [0]}, {"u": 26, "kind": "action", "text": "The room goes soft.", "para": 7, "sent": 1, "present": [0]}, {"u": 27, "kind": "dialogue", "text": "That one's harder.", "name": "ADAEZE", "speaker": 0, "ext": ["CONT'D"], "paren": ["quietly"], "dual": false, "present": [0]}, {"u": 28, "kind": "action", "text": "She pulls her knees up.", "para": 8, "sent": 0, "present": [0]}, {"u": 29, "kind": "action", "text": "Opens the duffel.", "para": 8, "sent": 1, "present": [0]}, {"u": 30, "kind": "action", "text": "Takes out a folded letter with a college seal.", "para": 8, "sent": 2, "present": [0]}, {"u": 31, "kind": "action", "text": "She turns it over twice.", "para": 8, "sent": 3, "present": [0]}, {"u": 32, "kind": "action", "text": "Tucks it back in.", "para": 8, "sent": 4, "present": [0]}, {"u": 33, "kind": "dialogue", "text": "Number five. You still have this tape, which means you didn't throw away anything good.", "name": "ADAEZE", "speaker": 0, "ext": ["V.O."], "paren": ["recorded"], "dual": false, "present": [0]}, {"u": 34, "kind": "action", "text": "She picks up the recorder.", "para": 9, "sent": 0, "present": [0]}, {"u": 35, "kind": "action", "text": "Holds it like a bird.", "para": 9, "sent": 1, "present": [0]}, {"u": 36, "kind": "dialogue", "text": "I kept it.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0]}, {"u": 37, "kind": "action", "text": "She rewinds a few seconds.", "para": 10, "sent": 0, "present": [0]}, {"u": 38, "kind": "action", "text": "Plays it again.", "para": 10, "sent": 1, "present": [0]}, {"u": 39, "kind": "dialogue", "text": "Number five. You still have this tape...", "name": "ADAEZE", "speaker": 0, "ext": ["V.O."], "paren": ["recorded"], "dual": false, "present": [0]}, {"u": 40, "kind": "action", "text": "Adaeze presses record.", "para": 11, "sent": 0, "present": [0]}, {"u": 41, "kind": "action", "text": "The little red light glows.", "para": 11, "sent": 1, "present": [0]}, {"u": 42, "kind": "action", "text": "She clears her throat, speaks into it, steady and careful.", "para": 11, "sent": 2, "present": [0]}, {"u": 43, "kind": "dialogue", "text": "Test, test. It's June the second. I'm seventeen. I'm recording this for the girl I used to be.", "name": "ADAEZE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 44, "kind": "action", "text": "She stops.", "para": 12, "sent": 0, "present": [0]}, {"u": 45, "kind": "action", "text": "Her voice cracks, then settles.", "para": 12, "sent": 1, "present": [0]}, {"u": 46, "kind": "dialogue", "text": "Here's what happened. I got in. I'm going. I'm scared. And I called Mom.", "name": "ADAEZE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 47, "kind": "action", "text": "She laughs, and it breaks, and she leans her forehead against the cold metal wall of the bus.", "para": 13, "sent": 0, "present": [0]}, {"u": 48, "kind": "dialogue", "text": "She said you were right about number three.", "name": "ADAEZE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 49, "kind": "action", "text": "Rain eases.", "para": 14, "sent": 0, "present": [0]}, {"u": 50, "kind": "action", "text": "The string lights shiver.", "para": 14, "sent": 1, "present": [0]}, {"u": 51, "kind": "action", "text": "She holds the recorder close to her mouth and whispers the last line, so that only the tape and the bus can hear.", "para": 14, "sent": 2, "present": [0]}, {"u": 52, "kind": "dialogue", "text": "Number four: I'm working on it.", "name": "ADAEZE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 53, "kind": "action", "text": "She clicks the recorder off.", "para": 15, "sent": 0, "present": [0]}]}