{"scene_id": "s00559", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00559.fountain", "heading": "INT. DR. FEINBERG'S DENTAL OFFICE - WAITING ROOM - EVENING", "cast": [{"id": 0, "name": "SURPRISE", "names": ["SURPRISE"], "gender": "?", "first": 3, "spoke": 0}, {"id": 1, "name": "GRANDMA ROSEMARY", "names": ["GRANDMA", "GRANDMA ROSEMARY"], "gender": "?", "first": 3, "spoke": 1}, {"id": 2, "name": "GLENDA PRZYBYLSKI", "names": ["GLENDA PRZYBYLSKI", "GLENDA"], "gender": "?", "first": 5, "spoke": 2}, {"id": 3, "name": "MARVIN", "names": ["MARVIN"], "gender": "?", "first": 5, "spoke": 1}, {"id": 4, "name": "SKYLER", "names": ["SKYLER"], "gender": "?", "first": 5, "spoke": 0}, {"id": 5, "name": "LAZLO KERESZTES", "names": ["LAZLO KERESZTES", "LAZLO"], "gender": "?", "first": 5, "spoke": 2}, {"id": 6, "name": "THADDEUS FEINBERG", "names": ["THADDEUS FEINBERG", "THADDEUS"], "gender": "?", "first": 5, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. DR. FEINBERG'S DENTAL OFFICE - WAITING ROOM - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Beige chairs, a fish tank, a wall of laminated posters of cheerful molars.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The lights are dim.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A banner above the receptionist's desk reads, in glitter: SURPRISE, GRANDMA!", "para": 0, "sent": 2, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "Six conspirators crouch behind furniture.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "GLENDA PRZYBYLSKI, 40s, in a party hat, ducks behind the water cooler holding a cake; her husband MARVIN, 50s, behind the ficus with a stack of paper cups, while their teenage daughter SKYLER, 16, hides under the receptionist's desk, filming on her phone; LAZLO KERESZTES, 30s, the nervous nephew, slips behind the coat stand with a party horn, and THADDEUS FEINBERG, 60s, the dentist, in scrubs and a pointy hat, sits on the reception counter, stifling a laugh, while everyone whispers, shushes, and knocks into everyone else.", "para": 1, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 6, "kind": "action", "text": "The front door chimes.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 7, "kind": "action", "text": "Everyone freezes.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 8, "kind": "action", "text": "A chair creaks.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 9, "kind": "action", "text": "Lazlo's horn squeaks.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "action", "text": "Marvin drops a paper cup.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "action", "text": "Glenda hisses at both of them.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "action", "text": "Skyler's phone beeps.", "para": 3, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "action", "text": "The door opens.", "para": 3, "sent": 6, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "action", "text": "Nobody enters.", "para": 3, "sent": 7, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "Where is she?", "name": "THADDEUS", "speaker": 6, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "She's coming.", "name": "GLENDA", "speaker": 2, "ext": [], "paren": ["whispering back"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "My knee is stuck.", "name": "MARVIN", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "Mine too.", "name": "LAZLO", "speaker": 5, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "action", "text": "The door chimes again.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "action", "text": "Nobody enters.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "action", "text": "Wind moves a magazine.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Well, that's the worst possible timing.", "name": "GLENDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "It's okay. She'll be here. She always is.", "name": "LAZLO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "The lights flip on.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "action", "text": "Everyone stands.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "action", "text": "In the doorway, in a flowered coat, is GRANDMA ROSEMARY, 80s, who looks at the banner, the cake, the party hats, and the open mouth of the dentist, and says, quite calmly:", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "I thought the appointment was tomorrow.", "name": "GRANDMA ROSEMARY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}