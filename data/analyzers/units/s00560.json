{"scene_id": "s00560", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00560.fountain", "heading": "INT. NEON PAWN & LOAN - NIGHT", "cast": [{"id": 0, "name": "DETECTIVE IRENA VALDEZ", "names": ["DETECTIVE IRENA VALDEZ", "VALDEZ"], "gender": "?", "first": 3, "spoke": 4}, {"id": 1, "name": "SNOW", "names": ["SNOW"], "gender": "?", "first": 3, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. NEON PAWN & LOAN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Barred windows, glass counters, a wall of guitars.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A buzzing OPEN sign paints everything red.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "DETECTIVE IRENA VALDEZ, 40s, a blazer and a tired stare, leans over the counter with a pistol held low and steady, while behind it SNOW, 30s, a bleached-blond pawnbroker in a Hawaiian shirt, backs toward a shelf of cameras with a baseball bat in one hand and a phone in the other, and a guitar slides off its hook, hits the floor, and both of them flinch, aim, freeze.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 4, "kind": "dialogue", "text": "Drop it.", "name": "VALDEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "You first.", "name": "SNOW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "I'm the one with the badge.", "name": "VALDEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "I'm the one with the lease.", "name": "SNOW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Neither moves.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "The sign buzzes.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Where's the ring?", "name": "VALDEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "What ring?", "name": "SNOW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "The one that came in at nine.", "name": "VALDEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Lots of rings come in at nine.", "name": "SNOW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Snow sets the bat on the counter.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Valdez lowers the pistol.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Both exhale.", "para": 3, "sent": 2, "present": [0, 1]}]}