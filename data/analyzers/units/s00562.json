{"scene_id": "s00562", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00562.fountain", "heading": "INT. NET SHED - HARBOR DOCK - DAWN", "cast": [{"id": 0, "name": "AUGUSTINE MORROW", "names": ["AUGUSTINE MORROW", "AUGUSTINE"], "gender": "?", "first": 5, "spoke": 10}, {"id": 1, "name": "LOTTE MORROW", "names": ["LOTTE MORROW", "LOTTE"], "gender": "f", "first": 5, "spoke": 11}, {"id": 2, "name": "DOMINIC SALVATORE", "names": ["DOMINIC SALVATORE", "DOMINIC"], "gender": "m", "first": 35, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. NET SHED - HARBOR DOCK - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A long timbered shed that smells of tar and brine.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Nets hang from rafters like drying ghosts.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Sunlight cuts through the cracks in thin gold blades.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A kettle sings on a cast-iron stove.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "AUGUSTINE MORROW, 60s, a weathered fisherman in an oilskin, sits on an upturned crate with a netting needle, mending a rip.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "His daughter LOTTE MORROW, 30s, in a fisherman's sweater, sets two tin mugs on a barrel.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "She pours.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Steam rises.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Drink.", "name": "LOTTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I'm working.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "You're sulking.", "name": "LOTTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "That too.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She puts the mug in his free hand.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He sips.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "The net rustles.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Gulls cry outside.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "The boat's fine, Pa.", "name": "LOTTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "The boat's mortgaged.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "So? We mortgage everything. It's tradition.", "name": "LOTTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Your mother would've said --", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Mama would've said \"Eat your eggs.\"", "name": "LOTTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "He nearly smiles.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "The kettle whistles.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She lifts it.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I got the loan. Three more seasons.", "name": "LOTTE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Where from?", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "A man in town.", "name": "LOTTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "What man?", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "A man who liked the boat.", "name": "LOTTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Augustine sets down the needle.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "The tension in the shed changes, thick and slow.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Lotte. Which man?", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "The door scrapes open.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "A rectangle of light.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "DOMINIC SALVATORE, 50s, a long camel coat, polished shoes, and a hat in his hand, steps in, carefully avoiding a coil of rope.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Morning, Captain.", "name": "DOMINIC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Augustine stands.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "The crate falls.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "The needle skitters across the planks.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Lotte steps between them, pours a third mug, and holds it out.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Dominic. Tea?", "name": "LOTTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Kind of you.", "name": "DOMINIC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "He takes it.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Sips.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Nods.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Looks at Augustine.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Your daughter tells me you're a stubborn man.", "name": "DOMINIC", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "She tells me you're a thief.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "She hasn't told you I hold the paper on every boat in this harbor.", "name": "DOMINIC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Augustine's face closes like a door.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "He grabs the nearest thing, the netting needle, and Dominic does not blink.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Lotte seizes her father's wrist.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "All three freeze, tea steaming, needle poised, the whole shed hanging on a breath.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "Get out of my shed.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "Three seasons, Captain. Think on it.", "name": "DOMINIC", "speaker": 2, "ext": [], "paren": ["setting down the mug"], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "He goes.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "The door bangs.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "The nets sway.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Lotte lets go of her father's wrist.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "You're welcome.", "name": "LOTTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "You knew.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": ["slowly"], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "I knew.", "name": "LOTTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "She picks up the fallen crate, sets it upright, sits.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "After a long moment, he sits beside her.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "Neither drinks.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "The gulls go on screaming.", "para": 10, "sent": 3, "present": [0, 1, 2]}]}