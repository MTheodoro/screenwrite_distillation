{"scene_id": "s00563", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00563.fountain", "heading": "INT. GRAND CALDERON HOTEL - STALLED ELEVATOR - NIGHT", "cast": [{"id": 0, "name": "HARLOW BENNETT", "names": ["HARLOW BENNETT", "HARLOW"], "gender": "?", "first": 4, "spoke": 7}, {"id": 1, "name": "PERPETUA ADEYEMI", "names": ["PERPETUA ADEYEMI", "PERPETUA"], "gender": "f", "first": 5, "spoke": 6}, {"id": 2, "name": "RUSSELL KOVACS", "names": ["RUSSELL KOVACS", "RUSSELL"], "gender": "?", "first": 6, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRAND CALDERON HOTEL - STALLED ELEVATOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A mirrored brass cage, lights flickering.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The floor indicator is frozen between 11 and 12.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A tinny recording of a hotel jingle loops through a speaker.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "HARLOW BENNETT, 40s, a rumpled suit, clutches a leather briefcase.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "PERPETUA ADEYEMI, 30s, a sharp black dress and silver heels, stares at her phone: no bars.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "RUSSELL KOVACS, 50s, a maintenance uniform, kneels at the control panel with a screwdriver.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "How long is this going to take?", "name": "HARLOW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Depends.", "name": "RUSSELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "On what?", "name": "HARLOW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "On whether you want the truth.", "name": "RUSSELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "We want the truth.", "name": "PERPETUA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Then forty minutes. Maybe an hour.", "name": "RUSSELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "An hour!", "name": "HARLOW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Harlow, breathe.", "name": "PERPETUA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Don't tell me to breathe, Perpetua, you know what's in this case.", "name": "HARLOW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Quiet.", "name": "PERPETUA", "speaker": 1, "ext": [], "paren": ["sharp"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "What's in the case?", "name": "RUSSELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Paperwork.", "name": "HARLOW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Paperwork that ticks?", "name": "RUSSELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Silence.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Harlow's grip tightens.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "The light flickers.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Perpetua glances at the briefcase, then at Harlow, then at the screwdriver in Russell's hand.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "It's been ticking since the lobby, friend.", "name": "RUSSELL", "speaker": 2, "ext": ["CONT'D"], "paren": ["gently"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Oh, Harlow.", "name": "PERPETUA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "It's a watch.", "name": "HARLOW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "It's a bomb.", "name": "RUSSELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "It's a watch!", "name": "HARLOW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "The ticking is loud now.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Regular.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Quick.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Russell. Can you open the hatch?", "name": "PERPETUA", "speaker": 1, "ext": [], "paren": ["very low"], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "I can.", "name": "RUSSELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Do it.", "name": "PERPETUA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}