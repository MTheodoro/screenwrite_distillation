{"scene_id": "s00564", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00564.fountain", "heading": "EXT. RAILROAD CROSSING - FIELD TRIP BUS - DAY", "cast": [{"id": 0, "name": "ROSCOE LANGSTON", "names": ["ROSCOE LANGSTON", "ROSCOE"], "gender": "m", "first": 5, "spoke": 15}, {"id": 1, "name": "PHOEBE ABERNATHY-LIU", "names": ["PHOEBE ABERNATHY-LIU", "PHOEBE"], "gender": "f", "first": 6, "spoke": 14}], "units": [{"u": 0, "kind": "heading", "text": "EXT. RAILROAD CROSSING - FIELD TRIP BUS - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A yellow school bus idles at a country crossing.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Barn-red freight cars clatter by, one after another, endless.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Heat shimmers over the tracks.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The bus is empty but for two.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ROSCOE LANGSTON, 13, in a buttoned-up shirt and a tie his mother chose, sits alone in the back with a field-trip permission slip folded in his fist.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across the aisle PHOEBE ABERNATHY-LIU, 13, in a denim vest with a patch for every band she has not heard, sprawls with her boots on the seat.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "The train rattles on.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Neither speaks.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He steals a look.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She steals one back.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Where's everyone?", "name": "ROSCOE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Museum.", "name": "PHOEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Why aren't we at the museum?", "name": "ROSCOE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Because I threw up.", "name": "PHOEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "And me?", "name": "ROSCOE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Because you volunteered to stay with me.", "name": "PHOEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "I did?", "name": "ROSCOE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "You raised your hand.", "name": "PHOEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He thinks about this.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "His ears go red.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Oh.", "name": "ROSCOE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "She grins.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Props her chin on her fist.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "He fiddles with his tie.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "The train keeps coming.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Have you ever counted them?", "name": "PHOEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "The cars?", "name": "ROSCOE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Yeah.", "name": "PHOEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "No.", "name": "ROSCOE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Want to?", "name": "PHOEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Okay.", "name": "ROSCOE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "They press their faces to the glass.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Their lips move.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Two voices, soft, almost in unison.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Forty-one. Forty-two.", "name": "ROSCOE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Forty-three.", "name": "PHOEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Forty-four.", "name": "ROSCOE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "She leans her shoulder against his.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "He freezes.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Does not pull away.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "The train goes on and on.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Sixty.", "name": "PHOEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Sixty-one.", "name": "ROSCOE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Roscoe.", "name": "PHOEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Yeah?", "name": "ROSCOE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Don't lose count.", "name": "PHOEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "He doesn't.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "The train thunders past, the whole bus trembles, and a line of sunlit boxcars flickers over their faces like a film.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Eighty-eight.", "name": "ROSCOE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Eighty-nine.", "name": "PHOEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "Her hand finds his on the seat.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "He turns his over.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "She laces her fingers with his.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "Neither looks away from the window.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "Ninety.", "name": "ROSCOE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "Ninety-one.", "name": "PHOEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "The last car passes.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "Silence rolls in behind it, long and bright.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "A crossing bell stops.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "Gates rise.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "Ninety-three.", "name": "ROSCOE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "Ninety-three.", "name": "PHOEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "She does not let go.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "The bus engine coughs.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "The driver, offscreen, honks twice.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "They stay where they are a moment longer.", "para": 10, "sent": 3, "present": [0, 1]}]}