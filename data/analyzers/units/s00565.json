{"scene_id": "s00565", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00565.fountain", "heading": "INT. SILVERADO HOTEL - BATHHOUSE - DAY", "cast": [{"id": 0, "name": "ABNER CALLOWAY", "names": ["ABNER CALLOWAY", "ABNER"], "gender": "m", "first": 5, "spoke": 12}, {"id": 1, "name": "CALEB DREWRY", "names": ["CALEB DREWRY", "CALEB"], "gender": "?", "first": 6, "spoke": 6}, {"id": 2, "name": "HESPER VANCE", "names": ["HESPER VANCE", "HESPER"], "gender": "f", "first": 20, "spoke": 4}, {"id": 3, "name": "ISAIAH RUTHERFORD", "names": ["ISAIAH RUTHERFORD", "ISAIAH"], "gender": "f", "first": 15, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. SILVERADO HOTEL - BATHHOUSE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Steam.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Brass taps, a copper tub, white tile gone yellow with age.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A kettle simmers on a wood stove.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A pocket-watch lies on a stool, ticking too loud.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ABNER CALLOWAY, 50s, a grey mustache and a hat he won't take off, sits in the tub with his arms along the rim, eyes shut.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "His younger partner CALEB DREWRY, 30s, rolls up his sleeves at the stove, sloshing a pot of water.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "You're slow.", "name": "ABNER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You're hot.", "name": "CALEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "That's the point of a bath, son.", "name": "ABNER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Caleb pours.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Steam billows.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Abner exhales, sinks lower.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "He's here.", "name": "CALEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Who?", "name": "ABNER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Isaiah.", "name": "CALEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 16, "kind": "action", "text": "Abner opens one eye.", "para": 3, "sent": 0, "present": [0, 1, 3]}, {"u": 17, "kind": "dialogue", "text": "Where?", "name": "ABNER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 18, "kind": "dialogue", "text": "Downstairs. Drinking.", "name": "CALEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 19, "kind": "dialogue", "text": "Alone?", "name": "ABNER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 20, "kind": "dialogue", "text": "With Hesper.", "name": "CALEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Hm.", "name": "ABNER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "HESPER VANCE, 20s, in a pressed shirt and a leather vest, leans in the doorway with a cup of coffee, a silver star on her chest.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "ISAIAH RUTHERFORD, 40s, in a black coat, steps in behind her, hat low, holding a short shotgun by the barrel.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Don't get up, Calloway.", "name": "HESPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Wasn't planning on it.", "name": "ABNER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "You boys been busy.", "name": "ISAIAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Not as busy as you.", "name": "CALEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Hm.", "name": "ISAIAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "He stands very still.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "The kettle sings.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Hesper sips.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "The pocket-watch ticks.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Abner moves one hand, slow, under the soapy water.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Whatever's under there, leave it.", "name": "HESPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "It's a bar of soap.", "name": "ABNER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Leave the soap.", "name": "HESPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Abner raises his hand, empty.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "A grin splits his beard.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Sheriff, you're a hard woman.", "name": "ABNER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Marshal.", "name": "HESPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Beg your pardon.", "name": "ABNER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Calloway. You know why I'm here.", "name": "ISAIAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Money.", "name": "ABNER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Yes.", "name": "ISAIAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "It's in the stove.", "name": "ABNER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Caleb drops the pot.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Hesper's eyes flick to the fire.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Isaiah steps toward it.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "In one smooth motion, Abner lunges up, soaking wet, a pistol in his fist, and fires.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "The lamp explodes.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Darkness.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Steam.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "A scream, a crash of copper, a gunshot, another.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "When the smoke clears, the tub is empty.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "The window is open.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Curtains lift.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Hesper stands at the sill, coffee spilled down her vest.", "para": 9, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "Isaiah picks the shotgun up off the tile.", "para": 9, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "He took the soap.", "name": "ISAIAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}