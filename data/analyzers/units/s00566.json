{"scene_id": "s00566", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00566.fountain", "heading": "EXT. RUINED WINDMILL - MINEFIELD - DAWN", "cast": [{"id": 0, "name": "SERGEANT PETER GARRITY", "names": ["SERGEANT PETER GARRITY", "GARRITY"], "gender": "m", "first": 5, "spoke": 9}, {"id": 1, "name": "LUCA FERRANTE", "names": ["LUCA FERRANTE", "LUCA"], "gender": "m", "first": 6, "spoke": 4}, {"id": 2, "name": "ANSELM VOGT", "names": ["ANSELM VOGT", "ANSELM"], "gender": "m", "first": 7, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "EXT. RUINED WINDMILL - MINEFIELD - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A stone tower, sails broken and hanging.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A field of tall grass ringed with rusted wire.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Fog clings to the ground.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A crow lands on the wire and shakes itself.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SERGEANT PETER GARRITY, 40s, a bandaged ear, crouches in the mill doorway with a rifle.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "LUCA FERRANTE, 20s, a radioman, hunches beside him, dials tuning, mouth open.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "ANSELM VOGT, 30s, a sapper with a prod and a headlamp, kneels in the grass ten yards out, probing the soil with infinite care.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Anselm. Talk to me.", "name": "GARRITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Clear for two meters.", "name": "ANSELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Move.", "name": "GARRITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Two meters. Don't rush me.", "name": "ANSELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "He edges forward.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Prods.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Prods.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "The grass whispers.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Luca checks the radio, jiggles a knob, curses.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "No signal.", "name": "LUCA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Keep trying.", "name": "GARRITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "It's the fog.", "name": "LUCA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "It's always the fog.", "name": "GARRITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Anselm stops.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "His prod hits something.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "A soft metallic knock.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "He freezes.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Garrity and Luca freeze too.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "A breath held by three men.", "para": 3, "sent": 5, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Contact.", "name": "ANSELM", "speaker": 2, "ext": [], "paren": ["very quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Type?", "name": "GARRITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Bounding. S-mine.", "name": "ANSELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Leave it.", "name": "GARRITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "I'm going around.", "name": "ANSELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Anselm.", "name": "GARRITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "I'm going around.", "name": "ANSELM", "speaker": 2, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "He shifts, belly down, wiggles past the mine, a hand's breadth at a time.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Garrity watches.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Luca crosses himself with the hand not holding the radio.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Fog rolls across the field.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "A SOUND.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "The crow bursts off the wire in a clatter of wings.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Anselm flinches.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "His elbow lands on a loose stone, the stone rocks, and a bootlace pulls taut.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "No. No, no, no --", "name": "ANSELM", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Down!", "name": "GARRITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Garrity and Luca drop flat.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Anselm throws himself backward.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "The mine leaps from the soil, a black can on a column of dust, and detonates in the air with a crack that tears the dawn.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Ringing.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Smoke.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Garrity lifts his head.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Luca gasps.", "para": 7, "sent": 4, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Anselm lies on his back in the grass, headlamp askew, staring up at the grey sky, bleeding from one forearm.", "para": 7, "sent": 5, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "I'm still here.", "name": "ANSELM", "speaker": 2, "ext": [], "paren": ["laughing, appalled"], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "Don't move!", "name": "GARRITY", "speaker": 0, "ext": [], "paren": ["sprinting to him"], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "Medic! MEDIC!", "name": "LUCA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Garrity kneels, rips a sleeve, presses a field dressing to the gash.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Luca stumbles through the grass, trips on a wire, falls.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "The radio flies from his hand.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "It lands in the weeds and crackles to life.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "Luca scrambles for it, shaking, grinning, weeping.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "Garbled static resolves into a hiss of carrier tone.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "This is Fox Two! Anyone! We're alive!", "name": "LUCA", "speaker": 1, "ext": [], "paren": ["into radio"], "dual": false, "present": [0, 1, 2]}]}