{"scene_id": "s00567", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00567.fountain", "heading": "INT. DRAWBRIDGE CONTROL HOUSE - NIGHT", "cast": [{"id": 0, "name": "HARRIET LOCKWOOD", "names": ["HARRIET LOCKWOOD", "HARRIET"], "gender": "?", "first": 5, "spoke": 19}, {"id": 1, "name": "NATHANIEL BRIGHT", "names": ["NATHANIEL BRIGHT", "NATHANIEL"], "gender": "m", "first": 9, "spoke": 17}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRAWBRIDGE CONTROL HOUSE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A glass booth perched high above a river, lit by a desk lamp and a bank of switches.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The bridge spans a quarter-mile of black water below.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Cars queue on both sides, headlights fogged.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A thermos, a paperback, a radio playing low jazz.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "HARRIET LOCKWOOD, 50s, a bridge tender in a cardigan, feet on the desk, reads by lamplight.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her hand rests on the control lever.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "The door bangs open.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "A gust of rain.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "NATHANIEL BRIGHT, 30s, soaked, panting, a pistol in one hand and a gym bag in the other, kicks the door shut and presses his back to it.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Don't move.", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I wasn't going to.", "name": "HARRIET", "speaker": 0, "ext": [], "paren": ["without looking up"], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Put the book down.", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "It's a good book.", "name": "HARRIET", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Put it down!", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She marks her page with a bus ticket.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Sets the paperback on the desk.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Raises both hands.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "There. Happy?", "name": "HARRIET", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Raise the bridge.", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "That's a lot of cars.", "name": "HARRIET", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "I said raise it!", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "There's an ambulance in that line, son. Third from the left.", "name": "HARRIET", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "He looks.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Through the glass, the pulsing blue of an ambulance in the waiting traffic.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "His arm wavers.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "I don't care.", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "You do.", "name": "HARRIET", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Raise it, or I swear --", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "You swear what?", "name": "HARRIET", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "He steps forward.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "The gun shakes.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "She stays perfectly still, hands up, face calm.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Everyone's safe up here, young man. It's only a bridge.", "name": "HARRIET", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the room, gently"], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Don't think. Don't think.", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Whoever's behind you, he's not coming for you here.", "name": "HARRIET", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Shut up.", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "He's not that fast.", "name": "HARRIET", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Nathaniel lowers the gym bag.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Unzips it with one hand.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Money, packed tight.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "He closes it again, hard.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Please. I'm asking.", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "You're not asking. You're aiming.", "name": "HARRIET", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Then what do I do?", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "She lowers her hands, slow.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Reaches for the thermos.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Pours a cup of coffee.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Holds it out.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "You drink this.", "name": "HARRIET", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Are you crazy?", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Thirty-one years on this bridge. You're the fourth.", "name": "HARRIET", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "He stares at the cup.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "The jazz plays on, a soft saxophone.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "Rain rattles the glass.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "...What happened to the other three?", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "One went to jail. One went home. One's the mayor.", "name": "HARRIET", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "He laughs, one broken sound.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "His arm sinks.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "I'm not going to jail.", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "You might.", "name": "HARRIET", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "I can't.", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "Then go home.", "name": "HARRIET", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "Headlights flare across the booth.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "Sirens, far off, rising.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "They're coming.", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "They're always coming.", "name": "HARRIET", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "action", "text": "He takes the coffee.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "Sets down the gun on the desk beside the paperback.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "His hands shake so hard the cup rattles on the saucer.", "para": 12, "sent": 2, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "Sit. You're dripping on my floor.", "name": "HARRIET", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "He sits.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "She lowers the lever.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "Far below, the bridge begins to rise, a vast iron hinge turning against the night sky, and every car on both banks goes still.", "para": 13, "sent": 2, "present": [0, 1]}, {"u": 74, "kind": "dialogue", "text": "What are you doing?", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 75, "kind": "dialogue", "text": "Giving the river a minute.", "name": "HARRIET", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 76, "kind": "action", "text": "The sirens grow.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 77, "kind": "action", "text": "The bridge lifts.", "para": 14, "sent": 1, "present": [0, 1]}, {"u": 78, "kind": "action", "text": "Two figures, the tender and the thief, sit side by side in the booth, drinking from the same thermos, listening to the jazz.", "para": 14, "sent": 2, "present": [0, 1]}]}