{"scene_id": "s00569", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00569.fountain", "heading": "INT. GRAND PALMERSTON HOTEL - VENTRILOQUISTS' CONVENTION - BACKSTAGE - NIGHT", "cast": [{"id": 0, "name": "ANNUAL INTERNATIONAL CONGRESS VENTRILOQUISTS", "names": ["ANNUAL INTERNATIONAL CONGRESS VENTRILOQUISTS"], "gender": "?", "first": 3, "spoke": 0}, {"id": 1, "name": "MORTIMER PLUMLEY", "names": ["MORTIMER PLUMLEY", "MORTIMER"], "gender": "m", "first": 5, "spoke": 14}, {"id": 2, "name": "BEATRICE OKONJO", "names": ["BEATRICE OKONJO", "BEATRICE"], "gender": "f", "first": 6, "spoke": 9}, {"id": 3, "name": "HUGO VANDERKELEN", "names": ["HUGO VANDERKELEN", "HUGO"], "gender": "?", "first": 7, "spoke": 15}, {"id": 4, "name": "MRS. PEMBERTON", "names": ["MRS. PEMBERTON"], "gender": "?", "first": 23, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRAND PALMERSTON HOTEL - VENTRILOQUISTS' CONVENTION - BACKSTAGE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped green room crowded with trunks of wooden dummies.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Glass eyes glint from hat boxes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A sign above the door reads: ANNUAL INTERNATIONAL CONGRESS OF VENTRILOQUISTS - 47TH YEAR.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "Muffled applause drifts through the wall.", "para": 0, "sent": 3, "present": [0]}, {"u": 5, "kind": "action", "text": "MORTIMER PLUMLEY, 50s, a tuxedo and a hairpiece, sits before a mirror, adjusting a dummy on his knee: a wooden schoolboy in a cap, grinning.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "BEATRICE OKONJO, 40s, in a sequined gown, tunes a puppet duck.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "HUGO VANDERKELEN, 30s, a nervous newcomer in a rented tux, clutches a lone lamb-shaped sock puppet.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Quiet, Hugo. You're twitching.", "name": "MORTIMER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "I'm not twitching.", "name": "HUGO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "You are twitching.", "name": "BEATRICE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "It's a tic.", "name": "HUGO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "A tic is fine. A twitch is a tell.", "name": "MORTIMER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Mortimer, I can't do this.", "name": "HUGO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Of course you can.", "name": "MORTIMER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "My lamb has no personality.", "name": "HUGO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Then give it one.", "name": "MORTIMER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "How?", "name": "HUGO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Just make it sassy!", "name": "MORTIMER", "speaker": 1, "ext": [], "paren": ["in his dummy's voice, high and cheeky"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "The dummy's mouth clacks.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Beatrice's duck quacks in agreement.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Hugo's lamb droops.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "A speaker above the door crackles.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Attention, ventriloquists. The Congress will begin the Grand Finale in ten minutes. Contestants please report to the stage left wing. That includes Mr. Vanderkelen.", "name": "MRS. PEMBERTON", "speaker": 4, "ext": ["V.O."], "paren": ["over PA, brisk"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "She said my name.", "name": "HUGO", "speaker": 3, "ext": [], "paren": ["squeaking"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "She says everyone's name.", "name": "BEATRICE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Don't wet yourself, kid.", "name": "MORTIMER", "speaker": 1, "ext": [], "paren": ["as the dummy"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "I'm going to be sick.", "name": "HUGO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Not on the duck.", "name": "BEATRICE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "She turns the duck away.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Mortimer's dummy slides off his knee and tumbles across the floor into a pile of trunks.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "He lunges.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Hugo lunges.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Beatrice lunges.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "All three collide, the duck squawking, the lamb flying through the air, wooden limbs rattling.", "para": 3, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Mortimer lands on top of Hugo.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Beatrice lands on both.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "The dummy lands upright on a trunk, grinning.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Get off.", "name": "MORTIMER", "speaker": 1, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "I can't.", "name": "HUGO", "speaker": 3, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Everyone get off me!", "name": "BEATRICE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Contestants. Eight minutes.", "name": "MRS. PEMBERTON", "speaker": 4, "ext": ["V.O."], "paren": ["over PA"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "They untangle.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Beatrice dusts off her gown.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Hugo retrieves the lamb, its ear torn.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Mortimer tests the dummy's jaw.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Is it broken?", "name": "HUGO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "Cheek's loose.", "name": "MORTIMER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Duct tape.", "name": "BEATRICE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "I don't carry duct tape to a gala.", "name": "MORTIMER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "I do.", "name": "BEATRICE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "She digs into her purse and produces a roll.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Together they bind the dummy's jaw, then the lamb's ear.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Hugo is breathing steadier now.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "It looks ridiculous.", "name": "HUGO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "Ridiculous wins.", "name": "MORTIMER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Ridiculous is the whole point.", "name": "BEATRICE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "What if I freeze?", "name": "HUGO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "Then freeze.", "name": "MORTIMER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "That's your advice?", "name": "HUGO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "Freeze convincingly.", "name": "MORTIMER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "Beatrice laughs.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "A spotlight flares in the doorway.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "The applause on the other side of the wall swells.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "dialogue", "text": "Five minutes!", "name": "MRS. PEMBERTON", "speaker": 4, "ext": ["V.O."], "paren": ["over PA"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "Five minutes!", "name": "HUGO", "speaker": 3, "ext": [], "paren": ["squeaking"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "dialogue", "text": "You'll be fine.", "name": "BEATRICE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "dialogue", "text": "Break a leg, lamb chop.", "name": "MORTIMER", "speaker": 1, "ext": [], "paren": ["as the dummy"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "dialogue", "text": "Baa.", "name": "HUGO", "speaker": 3, "ext": [], "paren": ["in a tiny lamb voice, trembling"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "They all stare at the lamb, which, for the first time, seems to look back.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "dialogue", "text": "There it is.", "name": "MORTIMER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "dialogue", "text": "That's personality.", "name": "BEATRICE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "dialogue", "text": "Baa!", "name": "HUGO", "speaker": 3, "ext": [], "paren": ["lamb voice, firm"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "action", "text": "He marches to the door, lamb on hand, chin up.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "action", "text": "Beatrice and Mortimer follow, one with a duck under her arm, one with a taped dummy on his shoulder.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "action", "text": "The curtain parts.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 76, "kind": "action", "text": "Light and applause flood in.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 77, "kind": "action", "text": "They step through.", "para": 9, "sent": 4, "present": [0, 1, 2, 3, 4]}]}