{"scene_id": "s00570", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00570.fountain", "heading": "INT. FUNICULAR CAR - MIDNIGHT - STUCK MID-SLOPE", "cast": [{"id": 0, "name": "DESMOND WREN", "names": ["DESMOND WREN", "DESMOND"], "gender": "?", "first": 4, "spoke": 7}, {"id": 1, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 5, "spoke": 6}, {"id": 2, "name": "ODALYS", "names": ["ODALYS"], "gender": "?", "first": 18, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. FUNICULAR CAR - MIDNIGHT - STUCK MID-SLOPE", "present": []}, {"u": 1, "kind": "action", "text": "Rain on glass.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "One bulb flickers.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Cable groans.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DESMOND WREN, 50s, ticket inspector, brass whistle on a cord, grips a clipboard.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across from him, a STRANGER in a dripping yellow poncho.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Smiling.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "We've been stopped eleven minutes.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Twelve.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "You're counting.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Everyone counts, Mr. Wren. You counted the passengers at the top. Forty-one up. Forty down.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "How do you know my name?", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Same way I know about the missing one. The man who rode up and never rode down.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Nobody's missing. The log is clean.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "You wrote the log.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Who are you?", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Who are you?", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Don't.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "My name is Odalys. His sister.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "The whistle snaps off its cord.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Where is he, Desmond?", "name": "ODALYS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Under the lower platform. God forgive me.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "The cable SCREAMS.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "The car lurches.", "para": 3, "sent": 1, "present": [0, 1, 2]}]}