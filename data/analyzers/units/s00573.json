{"scene_id": "s00573", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00573.fountain", "heading": "EXT. WHALE-RIB BRIDGE - DUSK", "cast": [{"id": 0, "name": "GRUB MAWDLEY", "names": ["GRUB MAWDLEY", "MAWDLEY"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "TAMSIN", "names": ["TAMSIN"], "gender": "?", "first": 6, "spoke": 3}, {"id": 2, "name": "ROOK", "names": ["ROOK"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 7, "spoke": 2}, {"id": 4, "name": "ZEPHYRINE", "names": ["ZEPHYRINE"], "gender": "?", "first": 30, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. WHALE-RIB BRIDGE - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "A bridge of bleached ribs over a gorge.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fog below.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A toll hut perched at the midpoint.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "GRUB MAWDLEY, goblin, one eye, sits on the toll barrel.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Chewing.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Two pilgrims approach: TAMSIN, young, sword too big for her, and ROOK, old, hooded, leaning on a staff.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Behind them, a STRANGER in grey rags, bare feet.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Silent.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Following.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Toll. Two coppers. Each.", "name": "MAWDLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "He's got no right. The queen abolished tolls.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": ["to Rook"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Queens abolish. Goblins collect.", "name": "ROOK", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Three coppers. I heard that.", "name": "MAWDLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Fine.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "She counts coins.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Mawdley bites each one.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "The Stranger steps up beside them.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "And you? Rags. Nothing to pay with?", "name": "MAWDLEY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "I pay differently.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Everybody says that.", "name": "MAWDLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Don't test him.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Don't test me.", "name": "MAWDLEY", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Tamsin and Mawdley glare at each other.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Fog thickens.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "The ribs begin to hum.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Step back. All of you. Now.", "name": "ROOK", "speaker": 2, "ext": [], "paren": ["to everyone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "The Stranger throws back the hood.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Silver hair.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Eyes like struck flint.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Zephyrine.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Mawdley drops the coin.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "The bridge SHUDDERS.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "I built this bridge. You've been charging for my bones.", "name": "ZEPHYRINE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Oh, no.", "name": "MAWDLEY", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "The ribs CRACK.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Light floods upward from the gorge.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}]}