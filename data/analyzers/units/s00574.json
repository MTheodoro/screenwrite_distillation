{"scene_id": "s00574", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00574.fountain", "heading": "INT. SIGNAL RELAY HUT - HIMALAYAN PASS - DAY", "cast": [{"id": 0, "name": "HAKIM BARAKZAI", "names": ["HAKIM BARAKZAI", "BARAKZAI"], "gender": "?", "first": 6, "spoke": 10}, {"id": 1, "name": "LUCJAN NOWAK", "names": ["LUCJAN NOWAK", "NOWAK"], "gender": "m", "first": 10, "spoke": 6}, {"id": 2, "name": "COMMAND", "names": ["COMMAND"], "gender": "?", "first": 18, "spoke": 3}, {"id": 3, "name": "MEDIC ANNELI SAARI", "names": ["MEDIC ANNELI SAARI", "SAARI"], "gender": "?", "first": 29, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. SIGNAL RELAY HUT - HIMALAYAN PASS - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Stone walls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Tin roof ticking in the wind.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A hand-crank radio on a plank table.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Frost on the window.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "1962.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "SGT. HAKIM BARAKZAI, 40, beard gone grey at the chin, sits on an ammo crate.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Mending a boot.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "Slow.", "para": 1, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "PVT.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "LUCJAN NOWAK, 19, shivering, wrapped in two blankets, stares at the stove.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Feeds it one stick at a time.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Last of the wood.", "name": "NOWAK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Burn the crate after.", "name": "BARAKZAI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Which crate?", "name": "NOWAK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "The one you're not sitting on.", "name": "BARAKZAI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Static.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "A crackle from the radio.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Relay Nine, Relay Nine. Report status. Over.", "name": "COMMAND", "speaker": 2, "ext": ["V.O."], "paren": ["garbled"], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Barakzai crosses and takes the handset.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Command, Relay Nine. Two men. One stove. No contact. Over.", "name": "BARAKZAI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Copy two men. Supply drop postponed. Weather. Over.", "name": "COMMAND", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Understood. Out.", "name": "BARAKZAI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "He hangs up.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Nowak keeps his eyes on the flames.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "That's the third postponement.", "name": "NOWAK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Fourth. You weren't counting.", "name": "BARAKZAI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "The door BANGS open.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Wind and snow.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "A figure in a white parka stumbles in, shoulders a medical satchel: MEDIC ANNELI SAARI, 30, Finnish, windburned face, ski goggles pushed up.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "She slams the door behind her.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Which of you is Barakzai?", "name": "SAARI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Me.", "name": "BARAKZAI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Good. I walked nine hours. Is there tea?", "name": "SAARI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "No.", "name": "NOWAK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Is there anything?", "name": "SAARI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Boiled snow.", "name": "BARAKZAI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Then boil it.", "name": "SAARI", "speaker": 3, "ext": [], "paren": ["dropping her satchel"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Nowak scrambles for the kettle.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Saari sits heavily next to Barakzai and pulls off a glove, examining her blue fingertips.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Command said no supply.", "name": "BARAKZAI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Command said nothing to me. I was sent for the private's feet.", "name": "SAARI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "My feet are fine.", "name": "NOWAK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Take your boots off.", "name": "SAARI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "They're fine.", "name": "NOWAK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Take them off, Lucjan.", "name": "BARAKZAI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Reluctantly, Nowak peels off a boot and a grey sock.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "The toes are white.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Saari looks, then at Barakzai.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Fine. For now.", "name": "SAARI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Relay Nine, be advised, weather window tomorrow oh-six-hundred. Over.", "name": "COMMAND", "speaker": 2, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Barakzai doesn't move to answer.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "He looks at the kettle, at the stove, at the two young faces.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Tomorrow, then.", "name": "BARAKZAI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}