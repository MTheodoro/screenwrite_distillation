{"scene_id": "s00575", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00575.fountain", "heading": "INT. COIN LAUNDROMAT - 3 A.M.", "cast": [{"id": 0, "name": "LINH TRAN", "names": ["LINH TRAN", "LINH"], "gender": "f", "first": 5, "spoke": 3}, {"id": 1, "name": "BAO", "names": ["BAO"], "gender": "?", "first": 6, "spoke": 2}, {"id": 2, "name": "DI HOA", "names": ["DI HOA"], "gender": "?", "first": 9, "spoke": 2}, {"id": 3, "name": "FAIRWEATHER", "names": ["FAIRWEATHER"], "gender": "?", "first": 17, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. COIN LAUNDROMAT - 3 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent hum.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of orange plastic chairs.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Forty dryers, all still.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain streaks the plate glass.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LINH TRAN, 32, wiry, scrubs under a parka, stands over a washer holding a pewter urn against her chest.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her brother BAO, 28, in a rumpled suit, blocks the aisle.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Give it to me.", "name": "BAO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You said you'd drive it to Da Nang. You haven't left the city in nine years.", "name": "LINH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "At the folding table, their aunt DI HOA, 60s, in a quilted housecoat, folds the same towel again and again.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Mom wanted it scattered. Not carried around in a laundromat.", "name": "BAO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "She wanted it by her sister.", "name": "LINH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "She wanted quiet.", "name": "DI HOA", "speaker": 2, "ext": [], "paren": ["without looking up"], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "They both turn.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Bao lunges for the urn.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Linh pivots; the urn swings between them, lid chattering.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "They both freeze, breath held.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "MR. FAIRWEATHER, 70s, the night attendant, cardigan and slippers, shuffles out of the back with a mop and a bucket.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Folks. Closing in ten.", "name": "FAIRWEATHER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "We're not done.", "name": "LINH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Ten minutes.", "name": "FAIRWEATHER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Bao and Linh drop their hands at the same moment.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "The lid slips and lands on the tile with a loud, clear ring.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Nobody moves.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Di Hoa stands, steps over, and picks it up.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "She sets it on the lid of the washer, puts the urn back on top, and clicks it shut.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Both of you. Sit.", "name": "DI HOA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "They sit.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "The rain keeps falling.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}]}