{"scene_id": "s00576", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00576.fountain", "heading": "INT. ABANDONED CANNERY - SUBLEVEL FREIGHT ELEVATOR - NIGHT", "cast": [{"id": 0, "name": "IONA MACREADY", "names": ["IONA MACREADY", "IONA"], "gender": "f", "first": 4, "spoke": 4}, {"id": 1, "name": "TEDDY BOLA", "names": ["TEDDY BOLA", "TEDDY"], "gender": "m", "first": 5, "spoke": 3}, {"id": 2, "name": "PRIYA SUNDARAM", "names": ["PRIYA SUNDARAM", "PRIYA"], "gender": "f", "first": 6, "spoke": 5}, {"id": 3, "name": "GIDEON FARROW", "names": ["GIDEON FARROW", "GIDEON"], "gender": "?", "first": 7, "spoke": 6}, {"id": 4, "name": "NICO", "names": ["NICO"], "gender": "m", "first": 8, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED CANNERY - SUBLEVEL FREIGHT ELEVATOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "The cage is the size of a small room, riveted iron gone the color of old blood.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single caged bulb swings on its wire.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Below the grated floor, black water slaps against pilings, in no rhythm that a tide would keep.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "IONA MACREADY, 30s, the surveyor, holds a clipboard against her chest like a shield.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside her, TEDDY BOLA\u00d1O, 20s, her assistant, shaves the dust off his lantern's glass with his thumb.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "DR. PRIYA SUNDARAM, 50s, a marine biologist with cropped silver hair and a field vest of many pockets, crouches to put her ear against the iron floor.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Against the far wall, GIDEON FARROW, 70s, the last cannery watchman, leans on a boat hook.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Tucked behind his legs, as if he did not want to be seen being there, is NICO, 8, his grandson, in a yellow slicker two sizes too big.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "How many floors down?", "name": "IONA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Four. Maybe five.", "name": "GIDEON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "The plans say three.", "name": "IONA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "The plans say a lot of things.", "name": "GIDEON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "The cage lurches.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "The bulb swings wild; shadows leap and tangle on the walls.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Nico grabs his grandfather's coat.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Something is moving the water. Not the tide.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": ["standing"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Maybe a pipe.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "A pipe doesn't breathe.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "They look at her.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Water below the floor pulls back, a long slow draw, as if the sea were inhaling.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "The grating rattles.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "All five freeze.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Granddad. It's in the elevator.", "name": "NICO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Hush.", "name": "GIDEON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "It's under my feet.", "name": "NICO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "The floor grating bulges upward.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Pale fingers, too many, slip through the slots.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Teddy screams, drops the lantern.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Iona yanks Nico into her arms while Gideon swings the boat hook down onto the grate with a hollow clang.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "The fingers withdraw, quick as eels.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Dark.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "A pulse of lamplight, then dark again.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "The bulb flickers back on.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Everyone is breathing hard.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Nobody speaks.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Then:", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "It didn't want us. It wanted the light.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "How do you know?", "name": "IONA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "It stopped when the lantern fell.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Then we stay in the dark.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "We tried that. Nineteen sixty-one. The lamp went out and the crew all rode down singing. Nobody rode back.", "name": "GIDEON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Why were they singing?", "name": "NICO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Because it asked them nicely.", "name": "GIDEON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "The cage drops.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Not a lurch this time: a plunge, a controlled, fast, deliberate fall.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Iona clutches the clipboard.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Priya braces against the wall.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Teddy sinks down with his head between his knees.", "para": 8, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Gideon lifts the hook and holds it level like a lance.", "para": 8, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "The fall stops.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "A soft thud.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "The iron door slides open on its own.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Beyond: a vaulted hall of wet stone, lit by something green and far off.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "A hum rises, many voices, tuneless, patient, familiar.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Nico, in Iona's arms, tilts his head.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Mama?", "name": "NICO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "No. No, baby. No.", "name": "IONA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "She turns his face into her shoulder.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "The hum grows warmer, kinder.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "I can hear my dad.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "Everyone, hold your breath. If you can't hear it, it can't use you.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "They hold.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "The hum swells to a sweet pitch, then breaks into a single laugh.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "Gideon lowers the boat hook.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "It's laughing at the rule.", "name": "GIDEON", "speaker": 3, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "The elevator door starts to close.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "action", "text": "The five of them stare at the narrowing gap, not one of them moving toward it, and not one of them moving away.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}]}