{"scene_id": "s00577", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00577.fountain", "heading": "EXT. GLACIER CREVASSE - DAY", "cast": [{"id": 0, "name": "KWABENA ADDO", "names": ["KWABENA ADDO", "KWABENA"], "gender": "m", "first": 4, "spoke": 21}, {"id": 1, "name": "BJORN HALVORSEN", "names": ["BJORN HALVORSEN", "BJORN"], "gender": "m", "first": 8, "spoke": 24}], "units": [{"u": 0, "kind": "heading", "text": "EXT. GLACIER CREVASSE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Blue walls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Forty feet of ice above, a slot of white sky.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wind whistles across the top like a flute.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "At the bottom, on a ledge no wider than a door: KWABENA ADDO, 40s, Ghanaian geologist, burly, beard crusted with frost, left leg bent wrong at the shin.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "A rope dangles ten feet above.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Swinging.", "para": 2, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Cut at the end.", "para": 2, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "Two meters below him, on a lower shelf: BJORN HALVORSEN, 50s, Norwegian guide, lean as a rake, gray eyes, bleeding from his scalp.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He doesn't move.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Bjorn.", "name": "KWABENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Nothing.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Bjorn!", "name": "KWABENA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "The wind.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "A dripping sound.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Bjorn's hand twitches.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Opens.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Closes.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Don't shout. The ice listens.", "name": "BJORN", "speaker": 1, "ext": [], "paren": ["hoarse"], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "You're alive.", "name": "KWABENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Don't sound so disappointed.", "name": "BJORN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "He rolls to his side.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Pushes up on one elbow.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Blood runs down his cheek.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "He wipes it with a glove, stares at the red.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Can you climb?", "name": "KWABENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Can you?", "name": "BJORN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "My leg.", "name": "KWABENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Then no.", "name": "BJORN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Bjorn crawls to the lip of his shelf.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Looks up the wall.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "His breath fogs.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "He reaches out and grips a protrusion of ice, tests it with his weight.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "It holds.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "He cut the rope.", "name": "KWABENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Who?", "name": "BJORN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Anders. He let go on purpose.", "name": "KWABENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "He was scared.", "name": "BJORN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "He was a coward.", "name": "KWABENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Same thing, down here.", "name": "BJORN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Silence.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Drips.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Far off, a deep CRACK rolls through the glacier like a door slamming in a house the size of a mountain.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Both men freeze.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "That's close.", "name": "KWABENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Don't breathe.", "name": "BJORN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "They don't.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Ice dust sifts down.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Settles on Kwabena's eyelashes.", "para": 12, "sent": 2, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "On Bjorn's shoulders.", "para": 12, "sent": 3, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "The crack fades.", "para": 12, "sent": 4, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Okay. Now you breathe.", "name": "BJORN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "Kwabena lets out a ragged exhale, laughs, coughs.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "You Norwegians.", "name": "KWABENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "You Ghanaians.", "name": "BJORN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "What about us?", "name": "KWABENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "You laugh when you should be afraid.", "name": "BJORN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "I laugh because I am afraid.", "name": "KWABENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "Bjorn considers this.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "Nods.", "para": 14, "sent": 1, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "Unslings his pack.", "para": 14, "sent": 2, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "Digs.", "para": 14, "sent": 3, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "He pulls out: a coil of thin cord, two ice screws, a pocket knife, half a chocolate bar.", "para": 15, "sent": 0, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "Inventory.", "name": "BJORN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "That's all?", "name": "KWABENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "That's all.", "name": "BJORN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "He tosses the chocolate.", "para": 16, "sent": 0, "present": [0, 1]}, {"u": 67, "kind": "action", "text": "Kwabena catches it one-handed.", "para": 16, "sent": 1, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "Breaks it in two.", "para": 16, "sent": 2, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "Throws half back.", "para": 16, "sent": 3, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "Your turn to eat.", "name": "KWABENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "dialogue", "text": "You're hurt worse.", "name": "BJORN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 72, "kind": "dialogue", "text": "Eat.", "name": "KWABENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "Bjorn eats.", "para": 17, "sent": 0, "present": [0, 1]}, {"u": 74, "kind": "action", "text": "Chews slowly.", "para": 17, "sent": 1, "present": [0, 1]}, {"u": 75, "kind": "action", "text": "Studies the wall.", "para": 17, "sent": 2, "present": [0, 1]}, {"u": 76, "kind": "dialogue", "text": "There's a lip. Twelve feet up. Past it, a chimney.", "name": "BJORN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 77, "kind": "dialogue", "text": "You can see that?", "name": "KWABENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 78, "kind": "dialogue", "text": "I can see the shadow of it.", "name": "BJORN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 79, "kind": "action", "text": "He clips an ice screw to his belt.", "para": 18, "sent": 0, "present": [0, 1]}, {"u": 80, "kind": "action", "text": "Twists the second between his fingers like a pen.", "para": 18, "sent": 1, "present": [0, 1]}, {"u": 81, "kind": "dialogue", "text": "I'll go up. Anchor. Drop the cord.", "name": "BJORN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 82, "kind": "dialogue", "text": "And if the ice breaks?", "name": "KWABENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 83, "kind": "dialogue", "text": "Then you'll have the chocolate.", "name": "BJORN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 84, "kind": "action", "text": "Kwabena shakes his head, grinning in spite of himself.", "para": 19, "sent": 0, "present": [0, 1]}, {"u": 85, "kind": "action", "text": "Bjorn plants a boot.", "para": 20, "sent": 0, "present": [0, 1]}, {"u": 86, "kind": "action", "text": "Presses a glove to the wall.", "para": 20, "sent": 1, "present": [0, 1]}, {"u": 87, "kind": "action", "text": "Begins to climb, metal clicking on blue.", "para": 20, "sent": 2, "present": [0, 1]}, {"u": 88, "kind": "action", "text": "Six feet.", "para": 21, "sent": 0, "present": [0, 1]}, {"u": 89, "kind": "action", "text": "Eight.", "para": 21, "sent": 1, "present": [0, 1]}, {"u": 90, "kind": "action", "text": "He stops.", "para": 21, "sent": 2, "present": [0, 1]}, {"u": 91, "kind": "action", "text": "He's breathing hard, forehead against the ice.", "para": 21, "sent": 3, "present": [0, 1]}, {"u": 92, "kind": "dialogue", "text": "Bjorn.", "name": "KWABENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 93, "kind": "dialogue", "text": "Quiet.", "name": "BJORN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 94, "kind": "action", "text": "Another CRACK, closer.", "para": 22, "sent": 0, "present": [0, 1]}, {"u": 95, "kind": "action", "text": "Bjorn flattens against the wall.", "para": 22, "sent": 1, "present": [0, 1]}, {"u": 96, "kind": "action", "text": "Kwabena braces his good leg against the ledge.", "para": 22, "sent": 2, "present": [0, 1]}, {"u": 97, "kind": "action", "text": "The wall shudders.", "para": 23, "sent": 0, "present": [0, 1]}, {"u": 98, "kind": "action", "text": "A sheet of ice the size of a car door sheers away from the opposite side and shatters on the shelf between them.", "para": 23, "sent": 1, "present": [0, 1]}, {"u": 99, "kind": "action", "text": "Silence.", "para": 24, "sent": 0, "present": [0, 1]}, {"u": 100, "kind": "action", "text": "Both men stare at the wreckage.", "para": 24, "sent": 1, "present": [0, 1]}, {"u": 101, "kind": "dialogue", "text": "Now.", "name": "BJORN", "speaker": 1, "ext": ["CONT'D"], "paren": ["quiet"], "dual": false, "present": [0, 1]}, {"u": 102, "kind": "action", "text": "He climbs.", "para": 25, "sent": 0, "present": [0, 1]}, {"u": 103, "kind": "action", "text": "Fast now.", "para": 25, "sent": 1, "present": [0, 1]}, {"u": 104, "kind": "action", "text": "Ten feet.", "para": 25, "sent": 2, "present": [0, 1]}, {"u": 105, "kind": "action", "text": "Eleven.", "para": 25, "sent": 3, "present": [0, 1]}, {"u": 106, "kind": "action", "text": "His hand finds the lip, grips, pulls.", "para": 25, "sent": 4, "present": [0, 1]}, {"u": 107, "kind": "action", "text": "He rolls over the top of the ledge and disappears.", "para": 25, "sent": 5, "present": [0, 1]}, {"u": 108, "kind": "action", "text": "Kwabena waits.", "para": 26, "sent": 0, "present": [0, 1]}, {"u": 109, "kind": "action", "text": "Seconds.", "para": 26, "sent": 1, "present": [0, 1]}, {"u": 110, "kind": "action", "text": "A minute.", "para": 26, "sent": 2, "present": [0, 1]}, {"u": 111, "kind": "action", "text": "Then the cord drops, snaking down, dancing in the draft.", "para": 27, "sent": 0, "present": [0, 1]}, {"u": 112, "kind": "action", "text": "It lands across his lap.", "para": 27, "sent": 1, "present": [0, 1]}, {"u": 113, "kind": "dialogue", "text": "Tie in. Slowly.", "name": "BJORN", "speaker": 1, "ext": ["O.S.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 114, "kind": "action", "text": "Kwabena ties the cord around his chest, hands trembling.", "para": 28, "sent": 0, "present": [0, 1]}, {"u": 115, "kind": "action", "text": "He tugs it twice.", "para": 28, "sent": 1, "present": [0, 1]}, {"u": 116, "kind": "action", "text": "Tugs again.", "para": 28, "sent": 2, "present": [0, 1]}, {"u": 117, "kind": "dialogue", "text": "Ready.", "name": "KWABENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 118, "kind": "dialogue", "text": "Say it in your language.", "name": "BJORN", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 119, "kind": "dialogue", "text": "Say what?", "name": "KWABENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 120, "kind": "dialogue", "text": "The thing you say before you do something stupid.", "name": "BJORN", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 121, "kind": "dialogue", "text": "Nyame nti.", "name": "KWABENA", "speaker": 0, "ext": [], "paren": ["smiling"], "dual": false, "present": [0, 1]}, {"u": 122, "kind": "dialogue", "text": "That. Do that.", "name": "BJORN", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 123, "kind": "action", "text": "The cord goes tight.", "para": 29, "sent": 0, "present": [0, 1]}, {"u": 124, "kind": "action", "text": "Kwabena lifts off the ledge, swinging, grunting, and rises into the white.", "para": 29, "sent": 1, "present": [0, 1]}]}