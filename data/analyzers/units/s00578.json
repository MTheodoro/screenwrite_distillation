{"scene_id": "s00578", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00578.fountain", "heading": "INT. ALLEY LANES BOWLING - BACK ROOM - NIGHT", "cast": [{"id": 0, "name": "DOMMY ESPOSITO", "names": ["DOMMY ESPOSITO", "DOMMY"], "gender": "?", "first": 5, "spoke": 19}, {"id": 1, "name": "BIG LOU DEVEREAUX", "names": ["BIG LOU DEVEREAUX", "BIG LOU"], "gender": "?", "first": 6, "spoke": 2}, {"id": 2, "name": "FINGERS MCAVOY", "names": ["FINGERS MCAVOY", "FINGERS"], "gender": "m", "first": 7, "spoke": 5}, {"id": 3, "name": "TILLIE KOWALCZYK", "names": ["TILLIE KOWALCZYK", "TILLIE"], "gender": "?", "first": 8, "spoke": 4}, {"id": 4, "name": "JUNE ABERNATHY-SOTO", "names": ["JUNE ABERNATHY-SOTO", "JUNE"], "gender": "m", "first": 9, "spoke": 3}, {"id": 5, "name": "SANDOVAL", "names": ["SANDOVAL"], "gender": "?", "first": 30, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. ALLEY LANES BOWLING - BACK ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "1950s.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A table under a hanging green lamp.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Smoke curls up through the cone of light.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Through a swinging door, the muffled crash of pins.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DOMMY ESPOSITO, 50, silk vest, pomaded hair, sits at the head of the table dealing a patience hand.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "At his right, BIG LOU DEVEREAUX, 40s, a mountain in an overcoat, looks at nothing.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Opposite them, FINGERS MCAVOY, 30s, nervous, a bandaged hand in his lap.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "TILLIE KOWALCZYK, 50s, bookkeeper, ledger open, sips cold coffee.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "JUNE ABERNATHY-SOTO, 20s, a waitress in a pink uniform, sets a tray of beers on the sideboard and tries to leave unnoticed.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Stay a second, June.", "name": "DOMMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Mr. Esposito, I have the four lanes.", "name": "JUNE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Four lanes can wait on a lady.", "name": "DOMMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "She stays.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Stands very still.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "The ledger's off by two thousand, Dommy.", "name": "TILLIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "I know, Tillie.", "name": "DOMMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "That's not a rounding error.", "name": "TILLIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "I know.", "name": "DOMMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "He turns a card.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Red queen.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "He puts it on a black king.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Fingers. How's the hand?", "name": "DOMMY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "It's getting better. Doc says six weeks.", "name": "FINGERS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Who did it?", "name": "DOMMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "A door.", "name": "FINGERS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "A door.", "name": "DOMMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Slammed on it. In the garage.", "name": "FINGERS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "He's lying, boss.", "name": "BIG LOU", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Lou, come on.", "name": "FINGERS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "You went to the track Tuesday. Sandoval's boys picked you up.", "name": "BIG LOU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "The phone on the sideboard RINGS.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Everyone looks at it.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "It rings again.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "June. Get that.", "name": "DOMMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "She picks it up with two fingers.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Alley Lanes.", "name": "JUNE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Put Dommy on.", "name": "SANDOVAL", "speaker": 5, "ext": ["O.S."], "paren": ["through the receiver, tinny"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Mr. Esposito, it's a Mr. Sandoval.", "name": "JUNE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Dommy takes the receiver, keeps his eyes on Fingers.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Ray. Good evening.", "name": "DOMMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Dommy. Your boy owes me four.", "name": "SANDOVAL", "speaker": 5, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Four thousand?", "name": "DOMMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "Four thousand and a hand's worth of apology.", "name": "SANDOVAL", "speaker": 5, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "You took the hand already.", "name": "DOMMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "I took the hand. I want the four.", "name": "SANDOVAL", "speaker": 5, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Dommy hangs up, gently.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "Looks at Tillie.", "para": 8, "sent": 1, "present": [1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "At Big Lou.", "para": 8, "sent": 2, "present": [1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "At Fingers, who shrinks.", "para": 8, "sent": 3, "present": [1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "Tillie. The two thousand that's missing.", "name": "DOMMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "Yes?", "name": "TILLIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "It's in Ray Sandoval's pocket.", "name": "DOMMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "Fingers puts his good hand over his face.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "Big Lou stands slowly.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "Dommy raises one finger and Big Lou sits again.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "Sit, Lou. We're a family here. June, honey, bring Fingers a whiskey.", "name": "DOMMY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "June pours a shot with a trembling hand and sets it in front of him.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "He doesn't touch it.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "Drink. It's an order.", "name": "DOMMY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "action", "text": "Fingers drinks.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "Dommy turns the next card.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "dialogue", "text": "Tomorrow you go pay Ray what you owe, out of your own pocket, over the next ten years. And you thank him.", "name": "DOMMY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "dialogue", "text": "Yes, boss.", "name": "FINGERS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "dialogue", "text": "Tillie, fix the books.", "name": "DOMMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "dialogue", "text": "It'll take till Friday.", "name": "TILLIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "dialogue", "text": "Take till Friday.", "name": "DOMMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "action", "text": "Out in the lanes, a ball thunders.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "action", "text": "Ten pins fall at once.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "action", "text": "A cheer goes up, far off, innocent.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "action", "text": "Dommy places the last card.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "dialogue", "text": "Game's out.", "name": "DOMMY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}