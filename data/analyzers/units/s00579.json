{"scene_id": "s00579", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00579.fountain", "heading": "EXT. EIFFEL TOWER - SECOND PLATFORM SCAFFOLD - DAY (1888)", "cast": [{"id": 0, "name": "ODETTE LACROIX", "names": ["ODETTE LACROIX", "ODETTE"], "gender": "f", "first": 5, "spoke": 4}, {"id": 1, "name": "JULES PERRIN", "names": ["JULES PERRIN", "JULES"], "gender": "?", "first": 7, "spoke": 4}, {"id": 2, "name": "INSPECTOR MAXIME BOUCHARD", "names": ["INSPECTOR MAXIME BOUCHARD", "BOUCHARD"], "gender": "f", "first": 28, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. EIFFEL TOWER - SECOND PLATFORM SCAFFOLD - DAY (1888)", "present": []}, {"u": 1, "kind": "action", "text": "Wind.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Paris spreads below like a map.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Iron beams ring with hammers.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "She crouches on a plank, a bolt of grey wool across her knees, stitching a harness.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "ODETTE LACROIX, 22, seamstress, calloused fingertips, a scar on her chin.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Twenty feet off, he walks a girder like a tightrope, a rivet gun on his hip.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "JULES PERRIN, 25, rivetter, cap low, easy balance.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She doesn't look up.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He grins anyway.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "That one for me?", "name": "JULES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "For whoever falls first.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He crosses the beam.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Drops beside her.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Close.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Then it's for you.", "name": "JULES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She bites the thread.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Hands him the harness.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Put it on.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He does.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She tightens the buckle with a brisk tug.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "He winces and smiles.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "She doesn't smile.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Her eyes slide to the beam behind him.", "para": 6, "sent": 4, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "A man's head rises from the ladder shaft.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Bowler hat.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Black coat.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Soft hands.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "INSPECTOR MAXIME BOUCHARD, 50, with a notebook, climbing like a man who hates heights.", "para": 7, "sent": 4, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Monsieur Perrin?", "name": "BOUCHARD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Jules turns.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Goes still.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Odette's needle stops in the wool.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "The foreman says you were here Tuesday night.", "name": "BOUCHARD", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "I was home.", "name": "JULES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "The foreman says otherwise.", "name": "BOUCHARD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Silence.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "The wind lifts his notebook pages.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "He grips them.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "He was with me.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Bouchard looks at her.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "A long moment.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Then he closes the notebook.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Of course he was.", "name": "BOUCHARD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "He turns and descends the ladder.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "They watch the bowler vanish.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "She exhales.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "He lets his shoulders drop.", "para": 11, "sent": 3, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "You didn't have to.", "name": "JULES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Yes.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "She picks the needle back up.", "para": 12, "sent": 0, "present": [0, 1, 2]}]}