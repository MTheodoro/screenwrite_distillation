{"scene_id": "s00582", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00582.fountain", "heading": "EXT. DRY LAKE SALT WORKS - DAY", "cast": [{"id": 0, "name": "MORT GILCHRIST", "names": ["MORT GILCHRIST", "MORT"], "gender": "?", "first": 8, "spoke": 20}, {"id": 1, "name": "ABEL STROUD", "names": ["ABEL STROUD", "ABEL"], "gender": "?", "first": 13, "spoke": 5}, {"id": 2, "name": "TENNESSEE PELL", "names": ["TENNESSEE PELL", "PELL"], "gender": "m", "first": 27, "spoke": 13}, {"id": 3, "name": "HOLCOMB VANCE", "names": ["HOLCOMB VANCE", "VANCE"], "gender": "?", "first": 29, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DRY LAKE SALT WORKS - DAY", "present": []}, {"u": 1, "kind": "action", "text": "White.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Everywhere white.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cracked lakebed baked flat.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Heat shimmer swallows the horizon.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A rusted rake the size of a gate.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "Mounded salt in rows like frozen waves.", "para": 0, "sent": 5, "present": []}, {"u": 7, "kind": "action", "text": "A tin-roofed shack leans against the wind that isn't there.", "para": 0, "sent": 6, "present": []}, {"u": 8, "kind": "action", "text": "MORT GILCHRIST, 60, owner.", "para": 1, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Leathery.", "para": 1, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "One suspender.", "para": 1, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "Sits on an overturned bucket in the shack's only shade.", "para": 1, "sent": 3, "present": [0]}, {"u": 12, "kind": "action", "text": "Whittling nothing.", "para": 1, "sent": 4, "present": [0]}, {"u": 13, "kind": "action", "text": "Beside him, ABEL STROUD, 17, his hired hand.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Sunburned nose.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Arms like fence rails.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Sorting salt crystals into jars.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "A cloud of dust on the horizon.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Growing.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Rider.", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Two.", "name": "MORT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "How d'you know?", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Dust's got two tails.", "name": "MORT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "The dust resolves into two horsemen.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Dark hats.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Long coats in the heat.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Both with rifles across their saddles.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "TENNESSEE PELL, 40s, in front.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Black beard, a gold tooth that catches the sun.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Behind him, HOLCOMB VANCE, 30s, thin, quiet, scar down the throat.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "They rein up at the shack.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Dismount.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Pell takes off his hat.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Water.", "name": "PELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Barrel's by the door.", "name": "MORT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Pell dips a tin cup and drinks.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Water dribbles down his chin into the salted dust.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "He hands the cup to Vance, who drinks without wiping it.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Heard you sell salt.", "name": "PELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Heard right.", "name": "MORT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "How much a sack?", "name": "PELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Two dollars.", "name": "MORT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Last man charged me one.", "name": "PELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Last man's dead.", "name": "MORT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Pell laughs.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Vance does not.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "He said you'd say that.", "name": "PELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Abel's hand drifts toward a shovel resting against the wall.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Mort pats the air, once, without looking.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Boy. Count the jars.", "name": "MORT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "I counted.", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Count again.", "name": "MORT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Abel counts.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "His lips move.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Pell watches him.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "How old's the kid?", "name": "PELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Old enough to count.", "name": "MORT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "Is he yours?", "name": "PELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "He's his own.", "name": "MORT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "Hm.", "name": "PELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "Pell takes a pinch of salt from a pile and tastes it.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "Spits.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "That's bitter.", "name": "PELL", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "It's lake salt. It's meant to be.", "name": "MORT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "Vance wanders toward the rake.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "Runs a hand along the rusted tines.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "Looks at the rows of mounded white, then at Mort.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "Quiet out here.", "name": "VANCE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "That's the idea.", "name": "MORT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "dialogue", "text": "How long you been alone?", "name": "VANCE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "dialogue", "text": "Since the wife.", "name": "MORT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "dialogue", "text": "He didn't say about a wife.", "name": "VANCE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "He wouldn't. He never met her.", "name": "MORT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "action", "text": "A long silence.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "The heat ticks in the tin roof.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "A fly lands on the lip of the tin cup.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "dialogue", "text": "Two sacks.", "name": "PELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "dialogue", "text": "Four dollars.", "name": "MORT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "dialogue", "text": "Three.", "name": "PELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "dialogue", "text": "Four.", "name": "MORT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "action", "text": "Pell reaches into his coat.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "action", "text": "Abel stiffens.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "action", "text": "Pell draws out, slowly, a leather purse.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "action", "text": "Counts four silver dollars onto the bucket lid.", "para": 14, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 84, "kind": "dialogue", "text": "Boy. Load them.", "name": "MORT", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 85, "kind": "action", "text": "Abel hefts two sacks onto the horses, one by one.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 86, "kind": "action", "text": "Vance steadies the animals with a hand on each nose.", "para": 15, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 87, "kind": "action", "text": "Nobody says a word.", "para": 15, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 88, "kind": "action", "text": "Pell mounts.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 89, "kind": "action", "text": "Looks down at Mort.", "para": 16, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 90, "kind": "dialogue", "text": "You ever need a partner?", "name": "PELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 91, "kind": "dialogue", "text": "No.", "name": "MORT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 92, "kind": "dialogue", "text": "Thought not.", "name": "PELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 93, "kind": "action", "text": "He turns the horse.", "para": 17, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 94, "kind": "action", "text": "Vance follows.", "para": 17, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 95, "kind": "action", "text": "The dust takes them, a slow smear of two tails, then one, then none.", "para": 17, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 96, "kind": "action", "text": "Abel exhales.", "para": 18, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 97, "kind": "dialogue", "text": "Were they gonna?", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 98, "kind": "dialogue", "text": "Maybe.", "name": "MORT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 99, "kind": "dialogue", "text": "What stopped them?", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 100, "kind": "dialogue", "text": "The salt. Nobody robs a man with no water to steal.", "name": "MORT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 101, "kind": "action", "text": "He picks up his whittling again.", "para": 19, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 102, "kind": "action", "text": "Looks at it, shakes his head.", "para": 19, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 103, "kind": "action", "text": "Tosses the stick onto the salt.", "para": 19, "sent": 2, "present": [0, 1, 2, 3]}]}