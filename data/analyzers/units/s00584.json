{"scene_id": "s00584", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00584.fountain", "heading": "INT. SERVER ROOM ELEVATOR - NIGHT", "cast": [{"id": 0, "name": "AGENT RAHEL YOHANNES", "names": ["AGENT RAHEL YOHANNES", "RAHEL"], "gender": "?", "first": 6, "spoke": 10}, {"id": 1, "name": "CORNELIUS BELL", "names": ["CORNELIUS BELL", "BELL"], "gender": "?", "first": 6, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. SERVER ROOM ELEVATOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Brushed steel.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Humming cold.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Floor indicator: 41.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "42.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "43.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "AGENT RAHEL YOHANNES, 30s, black suit, earpiece, one hand inside her jacket, watches the numbers climb while MR. CORNELIUS BELL, 60s, pinstriped, briefcase handcuffed to his wrist, stands at the opposite corner with a smile too relaxed for an elevator at 3 a.m., and neither of them looks at the other until the lights go out and the car stops between floors with a deep, deliberate clunk.", "para": 0, "sent": 5, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Dark.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Emergency red.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Breathing.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "You pressed something.", "name": "RAHEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I did not.", "name": "BELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Your elbow.", "name": "RAHEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "My elbow has been against this wall since the lobby.", "name": "BELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Then the building is on your side.", "name": "RAHEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Buildings are never on anyone's side, Agent Yohannes. They're just tall.", "name": "BELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "You know my name.", "name": "RAHEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "I know everyone's name. It's most of my job.", "name": "BELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Control, I've lost the lift. Repeat, lost the lift.", "name": "RAHEL", "speaker": 0, "ext": [], "paren": ["into earpiece, muttering"], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "They can't hear you. This shaft is shielded.", "name": "BELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "By whom?", "name": "RAHEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "By me. I paid for it.", "name": "BELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Mr. Bell, put the briefcase on the floor.", "name": "RAHEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "And if I don't?", "name": "BELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Then I'll find out how shielded you are.", "name": "RAHEL", "speaker": 0, "ext": [], "paren": ["drawing, steady"], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Agent, the case is not what you think. It isn't data. It's a key.", "name": "BELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "To what?", "name": "RAHEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "To this elevator. To every elevator in the building. At six a.m., the doors open on forty-three floors of sleeping people, and every one of them will be locked inside.", "name": "BELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Dear God.", "name": "RAHEL", "speaker": 0, "ext": [], "paren": ["quiet, to herself"], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Yes. Rather the point.", "name": "BELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "The red light pulses.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "The cable above them groans.", "para": 2, "sent": 1, "present": [0, 1]}]}