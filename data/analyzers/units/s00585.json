{"scene_id": "s00585", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00585.fountain", "heading": "INT. AGING CELLAR - CHEESE CAVE - NIGHT", "cast": [{"id": 0, "name": "GRETA SOLBERG", "names": ["GRETA SOLBERG", "GRETA"], "gender": "f", "first": 6, "spoke": 2}, {"id": 1, "name": "PASCAL ANTOINE", "names": ["PASCAL ANTOINE", "PASCAL"], "gender": "?", "first": 30, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. AGING CELLAR - CHEESE CAVE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A limestone tunnel hung with wheels of cheese on pine shelves, rows of pale moons receding into the dark.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cold, wet air.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The smell of ammonia and old milk.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A red headlamp sweeps the walls.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "She works alone.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "GRETA SOLBERG, 40s, compact, grey braid tucked into her collar, a stethoscope looped around her neck and a canvas roll of tools at her hip.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She runs her palm along the wall, ear tilted to a hidden hum.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "She stops at a barrel marked in chalk.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Taps it three times.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "Taps again, lower.", "para": 2, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "Behind the barrel: a steel door.", "para": 3, "sent": 0, "present": [0]}, {"u": 12, "kind": "action", "text": "Wall-sunk.", "para": 3, "sent": 1, "present": [0]}, {"u": 13, "kind": "action", "text": "Painted the same grey as the limestone, but no stone ever gleamed like that.", "para": 3, "sent": 2, "present": [0]}, {"u": 14, "kind": "action", "text": "She sets the stethoscope against the lock.", "para": 4, "sent": 0, "present": [0]}, {"u": 15, "kind": "action", "text": "Closes her eyes.", "para": 4, "sent": 1, "present": [0]}, {"u": 16, "kind": "action", "text": "Turns the dial a hair.", "para": 4, "sent": 2, "present": [0]}, {"u": 17, "kind": "action", "text": "Another.", "para": 4, "sent": 3, "present": [0]}, {"u": 18, "kind": "action", "text": "Her mouth moves, counting.", "para": 4, "sent": 4, "present": [0]}, {"u": 19, "kind": "action", "text": "The headlamp flickers.", "para": 5, "sent": 0, "present": [0]}, {"u": 20, "kind": "action", "text": "She freezes.", "para": 5, "sent": 1, "present": [0]}, {"u": 21, "kind": "action", "text": "Footsteps.", "para": 6, "sent": 0, "present": [0]}, {"u": 22, "kind": "action", "text": "Slow.", "para": 6, "sent": 1, "present": [0]}, {"u": 23, "kind": "action", "text": "From the entrance of the cave.", "para": 6, "sent": 2, "present": [0]}, {"u": 24, "kind": "action", "text": "She kills the lamp.", "para": 7, "sent": 0, "present": [0]}, {"u": 25, "kind": "action", "text": "Dark.", "para": 7, "sent": 1, "present": [0]}, {"u": 26, "kind": "action", "text": "She presses herself behind the barrel, a hand sliding to the pry bar at her belt.", "para": 7, "sent": 2, "present": [0]}, {"u": 27, "kind": "action", "text": "A flashlight beam wanders down the tunnel.", "para": 8, "sent": 0, "present": [0]}, {"u": 28, "kind": "action", "text": "Along the shelves.", "para": 8, "sent": 1, "present": [0]}, {"u": 29, "kind": "action", "text": "The beam bounces off the cheese rinds, ghost-white.", "para": 8, "sent": 2, "present": [0]}, {"u": 30, "kind": "action", "text": "PASCAL ANTOINE, 30s, climbs into frame.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Long coat.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Soft hat.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "A paper bag in one hand, a thermos in the other.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "He hums, off-key.", "para": 9, "sent": 4, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "He's not here for her.", "para": 9, "sent": 5, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "He's here for the night shift.", "para": 9, "sent": 6, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "He stops.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Sniffs the air.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Smells like feet again.", "name": "PASCAL", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "He sets his thermos on a shelf.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Eats something from the bag.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "The hum resumes.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "She waits, perfectly still.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "He turns his back and starts to inspect a wheel, tilting it to the light.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "She slides out from behind the barrel.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "One step.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Two.", "para": 13, "sent": 2, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Her boots make no sound on the damp stone.", "para": 13, "sent": 3, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "He stops humming.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "Doesn't turn.", "para": 14, "sent": 1, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "You're good.", "name": "PASCAL", "speaker": 1, "ext": ["CONT'D"], "paren": ["softly"], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "You're early.", "name": "GRETA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "You're late.", "name": "PASCAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "He turns, smiling.", "para": 15, "sent": 0, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "She lowers the bar.", "para": 15, "sent": 1, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "They regard each other for a long moment across the cheese.", "para": 15, "sent": 2, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "Did you get it open?", "name": "PASCAL", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "Two numbers left.", "name": "GRETA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "Then let me hold the light.", "name": "PASCAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "He flicks on his flashlight, angles it just so.", "para": 16, "sent": 0, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "She kneels at the dial.", "para": 16, "sent": 1, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "Her hands steady.", "para": 16, "sent": 2, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "The lock turns, a soft double click.", "para": 16, "sent": 3, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "The door swings open on darkness and a faint chill of something better than cheese.", "para": 17, "sent": 0, "present": [0, 1]}]}