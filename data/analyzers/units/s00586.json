{"scene_id": "s00586", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00586.fountain", "heading": "EXT. PIER 9 - PARKED ICE-CREAM TRUCK - NIGHT", "cast": [{"id": 0, "name": "RENATA GUILLORY", "names": ["RENATA GUILLORY", "RENATA"], "gender": "f", "first": 6, "spoke": 28}, {"id": 1, "name": "VIKTOR LAZAREV", "names": ["VIKTOR LAZAREV", "VIKTOR"], "gender": "?", "first": 10, "spoke": 29}], "units": [{"u": 0, "kind": "heading", "text": "EXT. PIER 9 - PARKED ICE-CREAM TRUCK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Harbor lights.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Gulls asleep on bollards.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A white truck with a cartoon cone on its side, awnings rolled, serving window shuttered.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Engine ticking as it cools.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Inside, a single dome light.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "RENATA GUILLORY, 40s, wears a chef's apron over a leather jacket.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Her wrists are zip-tied to the steering wheel.", "para": 2, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "Blood in one eyebrow.", "para": 2, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "She looks at the man in the passenger seat.", "para": 2, "sent": 3, "present": [0]}, {"u": 10, "kind": "action", "text": "VIKTOR LAZAREV, 50s, cleans a pistol with an ice-cream napkin.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Salt-and-pepper beard.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Soft Russian accent.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Very calm.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "You can't be serious.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I am always serious. It is my curse.", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "You're stealing a truck full of Rocky Road.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "I am recovering a truck full of something else.", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "There's nothing else.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "The second freezer.", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "That's for the sprinkles.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Renata.", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Fine. It's for the other thing.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Which is?", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Four kilos. You know it's four kilos.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I know it was five.", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Four.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "You took one.", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "I took what I was owed.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "By whom?", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "By you. You didn't pay me for the last three runs.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "That is not how it works.", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "That is exactly how it works, Viktor. I carry. You pay. This week you didn't.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "I was in Odessa.", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "You were in a hotel with a woman.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "My wife.", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Your other wife.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "A pause.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "A gull calls from far off.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "The water slaps against the pilings.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Who told you?", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "I make ice cream. People talk to ice-cream women.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "I am tired, Renata.", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": ["sighing"], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Then go home.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "I would like to. But I have a partner who says four when it is five.", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "And a partner who says five when it is four.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "You have a point.", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "Then cut me loose.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Why?", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "So I can show you where the fifth kilo is.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Why would you do that?", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Because I'm tired too.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "Long silence.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "He puts down the napkin.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "Puts down the gun on the dashboard, barrel pointed at the windshield.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "Produces a pocket knife and, without looking at her, saws through the tie on her left wrist.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "The other one when I see it.", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "Fair.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "She flexes her freed hand.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "Reaches under the seat, slowly, and pulls out a battered tin lunchbox.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "Opens it.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "Inside, wrapped in butcher paper, a brick the size of a loaf of bread.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "That's it?", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "That's it.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "Why did you keep it?", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "It was insurance.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "Against me?", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "Against anyone.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "Viktor picks up the brick.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "Weighs it in his palm.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 70, "kind": "action", "text": "Looks out at the dark harbor.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 71, "kind": "dialogue", "text": "You know, in Odessa my grandmother sold ice cream from a bicycle.", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 72, "kind": "dialogue", "text": "Is that true?", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 73, "kind": "dialogue", "text": "No.", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 74, "kind": "action", "text": "He puts the brick back in the lunchbox.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 75, "kind": "action", "text": "Closes it.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 76, "kind": "action", "text": "Sets it between them on the console.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 77, "kind": "dialogue", "text": "Keep it.", "name": "VIKTOR", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 78, "kind": "dialogue", "text": "What?", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 79, "kind": "dialogue", "text": "Keep it. Pay yourself. Call it back wages.", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 80, "kind": "dialogue", "text": "What's the catch?", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 81, "kind": "dialogue", "text": "No catch. I am retiring.", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 82, "kind": "dialogue", "text": "You can't retire.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 83, "kind": "dialogue", "text": "I have been retiring for six years. This is the first time anyone believed me.", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 84, "kind": "action", "text": "He cuts the other tie.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 85, "kind": "action", "text": "She rubs her wrists.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 86, "kind": "action", "text": "He holds out his hand.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 87, "kind": "action", "text": "She stares at it.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 88, "kind": "action", "text": "Takes it.", "para": 9, "sent": 4, "present": [0, 1]}, {"u": 89, "kind": "dialogue", "text": "Then what do I call you?", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 90, "kind": "dialogue", "text": "Viktor. A man who sells ice cream from a bicycle.", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 91, "kind": "dialogue", "text": "A bicycle.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 92, "kind": "dialogue", "text": "Of course.", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 93, "kind": "action", "text": "He opens the door.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 94, "kind": "action", "text": "Steps out into the harbor air.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 95, "kind": "action", "text": "Doesn't look back.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 96, "kind": "action", "text": "The door shuts with a soft thud.", "para": 10, "sent": 3, "present": [0, 1]}, {"u": 97, "kind": "action", "text": "The dome light goes dark.", "para": 10, "sent": 4, "present": [0, 1]}, {"u": 98, "kind": "action", "text": "Renata sits in the quiet, the lunchbox beside her, the engine finally silent.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 99, "kind": "action", "text": "She opens the serving window.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 100, "kind": "action", "text": "A cold wind off the water.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 101, "kind": "action", "text": "She breathes.", "para": 11, "sent": 3, "present": [0, 1]}]}