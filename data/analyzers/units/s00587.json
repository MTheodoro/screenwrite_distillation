{"scene_id": "s00587", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00587.fountain", "heading": "INT. GENERATION SHIP \"TERRA FIRMA\" - HYDROPONICS BAY 4 - NIGHT CYCLE", "cast": [{"id": 0, "name": "CAPTAIN ADAEZE NWOSU", "names": ["CAPTAIN ADAEZE NWOSU", "ADAEZE"], "gender": "f", "first": 5, "spoke": 14}, {"id": 1, "name": "MIKKEL HAVERLAND", "names": ["MIKKEL HAVERLAND", "MIKKEL"], "gender": "m", "first": 6, "spoke": 7}, {"id": 2, "name": "SOLENNE ARCHAMBAULT", "names": ["SOLENNE ARCHAMBAULT", "SOLENNE"], "gender": "?", "first": 7, "spoke": 13}, {"id": 3, "name": "YUSUF ADEYEMI", "names": ["YUSUF ADEYEMI", "YUSUF"], "gender": "m", "first": 8, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. GENERATION SHIP \"TERRA FIRMA\" - HYDROPONICS BAY 4 - NIGHT CYCLE", "present": []}, {"u": 1, "kind": "action", "text": "Rows of silver trays under violet grow-lamps.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Pale lettuce, tomato vines climbing steel trellises.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A mist-sprayer hisses at intervals.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The deck hums with the slow breath of recycled air.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CAPTAIN ADAEZE NWOSU, 50s, stands at a control panel, uniform jacket unbuttoned, tired eyes.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Beside her, DR. MIKKEL HAVERLAND, 40s, botanist, a smear of soil on his sleeve.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "SOLENNE ARCHAMBAULT, 30s, chief engineer, grease to the elbow, leans on a trellis.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "YUSUF ADEYEMI, 20s, junior technician, perches on an upturned bucket, a tablet on his knees.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Dr. Haverland, how long?", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Three weeks of yield. Four if we ration.", "name": "MIKKEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Four if we cut the second bay.", "name": "SOLENNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "We can't cut the second bay.", "name": "YUSUF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "We can cut whatever we like.", "name": "SOLENNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "It's the tomatoes.", "name": "YUSUF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Yusuf, nobody is dying for a tomato.", "name": "SOLENNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Quiet. All of you.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "A beat.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "The mist hisses.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Far off, a pump thunks.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "The blight is in Bay Three. If it crosses to Four, we lose the whole deck. I don't want a vote. I want a plan.", "name": "ADAEZE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "The only plan is isolation. We seal Three, burn it.", "name": "MIKKEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Burn it? That's six hundred kilos of food.", "name": "SOLENNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Contaminated food.", "name": "MIKKEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "We can't burn it, ma'am. The second generation was born in that bay.", "name": "YUSUF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "What?", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "The children. They used to play there. Before the sealing.", "name": "YUSUF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Yusuf, that's sentiment.", "name": "SOLENNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "It's memory.", "name": "YUSUF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Enough. Mikkel, can you save any of it?", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Maybe a tenth. If I graft cuttings now.", "name": "MIKKEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "A tenth is nothing.", "name": "SOLENNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "A tenth is seed stock. It's the future.", "name": "MIKKEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "It's a gamble.", "name": "SOLENNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "So is everything on this ship.", "name": "MIKKEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "So we graft?", "name": "YUSUF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "We graft. And we burn the rest.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Captain.", "name": "SOLENNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Solenne, prepare the incinerator.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "It's not designed for biomass.", "name": "SOLENNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Then redesign it by morning.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Forty hours without sleep and she wants miracles.", "name": "SOLENNE", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "I heard that.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Good.", "name": "SOLENNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Adaeze almost smiles.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "She rubs her eyes with the heels of her hands.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Looks out across the long rows of pale green.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Mikkel, take Yusuf. Cut what you can save.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Yes, Captain.", "name": "MIKKEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Can I keep one tomato?", "name": "YUSUF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "One.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "For the kids.", "name": "YUSUF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "For the kids.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Yusuf rises.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Mikkel slings a case of tools over his shoulder.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "The two of them move off down the aisle.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Solenne watches them go.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "You know it'll be the last tomato.", "name": "SOLENNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "I know.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "And you let him keep it.", "name": "SOLENNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "Somebody should.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "The lamps flicker, steady again.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "The mist hisses.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "From somewhere deep in the bay, a child's laughter echoes, a recording, looping, from a speaker long forgotten.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "Adaeze closes her eyes.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}]}