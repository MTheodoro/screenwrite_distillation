{"scene_id": "s00588", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00588.fountain", "heading": "INT. EMBASSY STAIRWELL - NIGHT", "cast": [{"id": 0, "name": "DELPHINE VOSKUIJLEN", "names": ["DELPHINE VOSKUIJLEN", "DELPHINE"], "gender": "?", "first": 4, "spoke": 11}, {"id": 1, "name": "GUARD", "names": ["GUARD"], "gender": "?", "first": 6, "spoke": 5}, {"id": 2, "name": "NASIR", "names": ["NASIR"], "gender": "?", "first": 24, "spoke": 8}, {"id": 3, "name": "THADDEUS", "names": ["THADDEUS"], "gender": "?", "first": 45, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. EMBASSY STAIRWELL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Concrete.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fluorescent tubes buzzing.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single door marked EXIT.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DELPHINE VOSKUIJLEN, 30s, trench coat, wet from rain, takes the stairs two at a time.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "A manila envelope pressed to her ribs.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "A GUARD blocks the landing.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Mid-forties, crew cut, hand on a holstered radio.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Ma'am. This level is closed.", "name": "GUARD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I have a pass.", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Not for this level.", "name": "GUARD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She slows.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Looks him up and down.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Steps closer.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "You're not on the roster.", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Neither are you.", "name": "GUARD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She lets out a short laugh.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He doesn't smile.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Who sent you?", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Nobody sends me. I come when I'm needed.", "name": "GUARD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "What do I call you?", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "He considers.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Behind him, the elevator DINGS.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Footsteps echo on the floor above.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Nasir.", "name": "GUARD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Nasir. I need to get to the ninth floor.", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "The ninth floor doesn't exist.", "name": "NASIR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Then I'll take the stairs that go to it.", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Ms. Voskuijlen, I read your file. I know who you are and what you're carrying. I also know who's waiting upstairs.", "name": "NASIR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Then step aside.", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "I can't.", "name": "NASIR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Why?", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Because if you go up, he kills you. And if I let you go, he kills me.", "name": "NASIR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Then we're both dead.", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Unless you give me the envelope.", "name": "NASIR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "She holds it tighter.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "He holds out an open palm.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Calm.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Almost kind.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Give it to me. Walk down. Leave the country by dawn. I will deliver it myself.", "name": "NASIR", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Why would I trust you?", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Because there's a third man behind you on the stairs. And he is not here to talk.", "name": "NASIR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "She doesn't turn.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Her shoulders stiffen.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Below, a boot scuffs concrete.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Thaddeus.", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Yes.", "name": "NASIR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "THADDEUS, 50s, silver hair, bespoke suit, stands two flights down, hands in pockets.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "He smiles up at them.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Delphine. Don't be dramatic.", "name": "THADDEUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "She looks at Nasir.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "At the envelope.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "At the open palm.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "She hands it over.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}]}