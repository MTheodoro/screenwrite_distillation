{"scene_id": "s00589", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00589.fountain", "heading": "INT. PAWNSHOP BACK OFFICE - NIGHT", "cast": [{"id": 0, "name": "ARLO DUNSMORE", "names": ["ARLO DUNSMORE", "ARLO"], "gender": "?", "first": 4, "spoke": 13}, {"id": 1, "name": "TREVOR PIKE", "names": ["TREVOR PIKE", "TREVOR"], "gender": "?", "first": 5, "spoke": 10}, {"id": 2, "name": "TALL WOMAN", "names": ["TALL WOMAN"], "gender": "?", "first": 6, "spoke": 5}, {"id": 3, "name": "GWENDOLYN", "names": ["GWENDOLYN"], "gender": "f", "first": 20, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. PAWNSHOP BACK OFFICE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Shelves of unclaimed saxophones.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A desk lamp with a green shade.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A safe, half-open.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ARLO DUNSMORE, 50s, tired eyes, cardigan, sits behind the desk.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "TREVOR PIKE, 30s, jittery, in a leather jacket, stands by the safe.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "In the doorway: a TALL WOMAN in a long coat, face hidden by a wide-brim hat.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Who's she?", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "She's with me.", "name": "TREVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "She's not with you. Look at her.", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I'm not with anyone.", "name": "TALL WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Then why are you here?", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "To collect.", "name": "TALL WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Collect what?", "name": "TREVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "What Arlo owes.", "name": "TALL WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "I owe you nothing.", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "He doesn't owe anybody. He pays his bills.", "name": "TREVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Not that bill.", "name": "TALL WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "She removes her hat.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Dark hair, a thin scar through one eyebrow.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "My name is Gwendolyn Marsh.", "name": "TALL WOMAN", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Marsh. Charlie Marsh's girl.", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Yes.", "name": "GWENDOLYN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Who's Charlie Marsh?", "name": "TREVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Shut up, Trevor.", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "No, who's Charlie Marsh?", "name": "TREVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "The man he sold out in sixty-eight.", "name": "GWENDOLYN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "I did not sell him out. He ran.", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "You gave them the address.", "name": "GWENDOLYN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Arlo, is that true?", "name": "TREVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "It was a long time ago.", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "He died in a ditch in Ohio.", "name": "GWENDOLYN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "I'm sorry.", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "You aren't.", "name": "GWENDOLYN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Look, lady, whatever this is, we're leaving.", "name": "TREVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "You're leaving?", "name": "GWENDOLYN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Yes.", "name": "TREVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "He grabs a satchel from the safe.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "He heads for the door.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "She steps aside, easily, and lets him pass.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "He stops at the threshold, confused.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "That's it?", "name": "TREVOR", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "It's not you I came for.", "name": "GWENDOLYN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Trevor, wait.", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "No. He's yours.", "name": "TREVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "He disappears.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Footsteps down the stairs.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "A door slams.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Arlo reaches for the desk drawer.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Gwendolyn pulls a revolver from her coat.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Not aiming.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Just showing.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Leave the drawer.", "name": "GWENDOLYN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "It's a bottle.", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "I know.", "name": "GWENDOLYN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "May I?", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "She nods.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "He pulls out a bottle of cheap bourbon and two glasses.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "Pours.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "Slides one across.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "To Charlie.", "name": "ARLO", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "To Charlie.", "name": "GWENDOLYN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "They drink.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "She sets down the empty glass and, after a moment, the revolver beside it.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}]}