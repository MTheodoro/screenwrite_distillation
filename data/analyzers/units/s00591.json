{"scene_id": "s00591", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00591.fountain", "heading": "INT. DECOMMISSIONED PLANETARIUM - NIGHT", "cast": [{"id": 0, "name": "OLIVER FAIRBANKS", "names": ["OLIVER FAIRBANKS", "OLIVER"], "gender": "?", "first": 5, "spoke": 13}, {"id": 1, "name": "BERTRAND KOWALIK", "names": ["BERTRAND KOWALIK", "BERTRAND"], "gender": "?", "first": 7, "spoke": 10}, {"id": 2, "name": "EMF", "names": ["EMF"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "HESTER PRYCE", "names": ["HESTER PRYCE", "HESTER"], "gender": "?", "first": 8, "spoke": 9}, {"id": 4, "name": "CLEMENTINE ROY", "names": ["CLEMENTINE ROY", "CLEMENTINE"], "gender": "f", "first": 9, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. DECOMMISSIONED PLANETARIUM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A domed room, round and hollow.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of tilted velvet seats facing a dead star-projector, a great black insect crouched at the center.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dust hangs in the beam of a single flashlight.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Somewhere, a pipe drips.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "OLIVER FAIRBANKS, 30s, in a corduroy jacket and glasses, plays the flashlight across the ceiling.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Painted constellations peel in long grey tongues.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Behind him, BERTRAND KOWALIK, 40s, heavyset, holds a tripod and an EMF meter, winded from the stairs.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "HESTER PRYCE, 50s, tiny, a medium's shawl over a cardigan, stands at the edge of the circle of light, eyes closed.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "CLEMENTINE ROY, 20s, a graduate student with a clipboard and a camera, hangs back by the door.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Bertrand, set it up on the projector.", "name": "OLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "You want it right on the thing?", "name": "BERTRAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Where else would a ghost go?", "name": "OLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "I don't think ghosts like to be told.", "name": "BERTRAND", "speaker": 1, "ext": [], "paren": ["setting down the tripod"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "It's already told you.", "name": "HESTER", "speaker": 3, "ext": [], "paren": ["eyes still shut"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Told us what?", "name": "CLEMENTINE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "To be careful.", "name": "HESTER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Of what?", "name": "OLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Of the stars.", "name": "HESTER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Silence.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "The pipe drips.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Oliver chuckles, brief and dry, and swings the beam at the dome.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "They're painted, Hester.", "name": "OLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "They were painted over other stars.", "name": "HESTER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Clementine lifts her camera.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Frames the ceiling.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Snaps.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "The flash fills the dome; for an instant every painted star blazes white.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "There's something in the shot.", "name": "CLEMENTINE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Show me.", "name": "OLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "She tilts the screen toward him.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "In the tiny image, high in the dome, a figure hangs, arms spread, hair drifting as if underwater.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "That's a trick of the flash.", "name": "BERTRAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "It's a reflection.", "name": "OLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Of what?", "name": "CLEMENTINE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Of... us.", "name": "OLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "There are only four of us.", "name": "BERTRAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "In the photo there are five.", "name": "CLEMENTINE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Oliver takes the camera.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Counts.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Counts again.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Swallows.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Bertrand, check the meter.", "name": "OLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Already pinned to red. It's been pinned since the stairs.", "name": "BERTRAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Turn off the light.", "name": "HESTER", "speaker": 3, "ext": [], "paren": ["opening her eyes"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "We're not turning off the light.", "name": "OLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Oliver, turn it off.", "name": "HESTER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "Maybe she's right.", "name": "BERTRAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "She's not right. She's a charlatan with a shawl.", "name": "OLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Yes. And she's still right.", "name": "HESTER", "speaker": 3, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "The flashlight flickers.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Dims.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Brightens.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "The projector, which has been dead for forty years, begins to hum.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "A dull amber glow swells in its eyes.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Everyone steps back.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Clementine grabs Hester's sleeve.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "Bertrand drops the tripod, which clangs across the floor.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "Oliver, I'm done. I'm leaving.", "name": "BERTRAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "Stay where you are.", "name": "OLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "I said I'm leaving.", "name": "BERTRAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "He turns to run.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "The door slams shut.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "The handle rattles under Clementine's hand.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "dialogue", "text": "It's locked!", "name": "CLEMENTINE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "It was never open.", "name": "HESTER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "The projector HUMS louder.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "action", "text": "A beam sweeps the dome: a slow wheel of constellations, bright, strange, wrong.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "action", "text": "Stars the wrong colors.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "Stars in the wrong places.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "action", "text": "A new constellation burns into the center, a shape like four small figures in a circle.", "para": 9, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "action", "text": "A fifth point of light appears, hovering, above and behind them.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "dialogue", "text": "Nobody move.", "name": "OLIVER", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "dialogue", "text": "Which one is he looking at?", "name": "BERTRAND", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "dialogue", "text": "Quiet.", "name": "OLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "dialogue", "text": "Which one?", "name": "BERTRAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 76, "kind": "dialogue", "text": "The one who counted.", "name": "HESTER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 77, "kind": "action", "text": "Oliver lowers the camera.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 78, "kind": "action", "text": "He doesn't breathe.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 79, "kind": "action", "text": "The fifth star pulses once, slow as a heartbeat, and begins to descend.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 80, "kind": "dialogue", "text": "Please.", "name": "CLEMENTINE", "speaker": 4, "ext": [], "paren": ["barely audible"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 81, "kind": "action", "text": "The beam goes out.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 82, "kind": "action", "text": "Darkness, total.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 83, "kind": "action", "text": "The drip.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 84, "kind": "action", "text": "Then, very close behind them all, the quiet scrape of a velvet seat folding down, as if someone had just sat to watch.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4]}]}