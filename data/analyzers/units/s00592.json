{"scene_id": "s00592", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00592.fountain", "heading": "INT. LAUNDROMAT-TURNED-TEAHOUSE - CHINATOWN BASEMENT - EVENING", "cast": [{"id": 0, "name": "BEATRIX LAU", "names": ["BEATRIX LAU", "BEATRIX"], "gender": "?", "first": 5, "spoke": 16}, {"id": 1, "name": "DELIVERY MAN", "names": ["DELIVERY MAN"], "gender": "m", "first": 6, "spoke": 9}, {"id": 2, "name": "CASSIUS", "names": ["CASSIUS"], "gender": "m", "first": 21, "spoke": 4}, {"id": 3, "name": "MALCOLM", "names": ["MALCOLM"], "gender": "m", "first": 38, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAUNDROMAT-TURNED-TEAHOUSE - CHINATOWN BASEMENT - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Steam.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Paper lanterns.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A row of dormant washing machines repurposed as tables, round windows full of potted jasmine.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A tea set on each.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "BEATRIX LAU, 40s, in a high-collared jacket and wire glasses, pours oolong at a corner table.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across from her: a DELIVERY MAN, 30s, in a rain-soaked windbreaker, cap low, a flat cardboard box beside his chair.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "You're early.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Traffic was light.", "name": "DELIVERY MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "In this city?", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I took the back streets.", "name": "DELIVERY MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She slides a cup across.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He takes it with both hands.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Sips.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Eyes closed.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "That's very good.", "name": "DELIVERY MAN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "My grandmother's blend.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "She taught you?", "name": "DELIVERY MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "She taught everyone. Whether they wanted lessons or not.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He laughs.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She smiles, small, practiced.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "At the bar, CASSIUS, 60s, silver beard, an old man in a tweed vest, stirs sugar into a glass and watches them in the mirror.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Ms. Lau, about the package.", "name": "DELIVERY MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Let's finish our tea.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Of course.", "name": "DELIVERY MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "They sip.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The jasmine nods in the steam.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Do you have family?", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "A brother in Oakland.", "name": "DELIVERY MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Do you call him?", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Sundays.", "name": "DELIVERY MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Good. A man should call his brother.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "She sets her cup down.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Taps the rim twice.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "At the bar, Cassius puts down his glass and turns on his stool.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Beatrix. Is this the one?", "name": "CASSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Yes, Cassius.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "What is this?", "name": "DELIVERY MAN", "speaker": 1, "ext": [], "paren": ["lifting the cap, eyes widening"], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Please. Keep your voice low. Your name is Malcolm Reyes.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "How do you know that?", "name": "MALCOLM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Because I paid for your last six months of silence.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "You? That was you?", "name": "MALCOLM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "It was both of us.", "name": "CASSIUS", "speaker": 2, "ext": [], "paren": ["approaching"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Oh, God.", "name": "MALCOLM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Malcolm, the box. Open it.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "I'd rather not.", "name": "MALCOLM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "I know.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "He fumbles with the lid.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Inside, nested in tissue paper, a single white teacup and a folded photograph.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "This isn't what they told me to deliver.", "name": "MALCOLM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "No. It's what you were meant to find.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "She turns the photo toward him.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "A young man at a laundromat counter, a younger Malcolm, smiling, with a woman at his side.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "His mother.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Where did you get this?", "name": "MALCOLM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "She kept the shop. Before it was this.", "name": "CASSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "She was my... she's dead. They said she was dead.", "name": "MALCOLM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "She died. Not the way they told you.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "Malcolm sits very still.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "The steam rises between them, soft and sweet.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "Drink your tea, son.", "name": "CASSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "Malcolm lifts the cup to his lips, hand trembling.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "He stops.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "Looks at Beatrix.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "Is it poisoned?", "name": "MALCOLM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "No. But I wanted you to wonder.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "He drinks anyway.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}]}