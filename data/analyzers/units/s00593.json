{"scene_id": "s00593", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00593.fountain", "heading": "INT. SKATE-RINK SNACK BAR - AFTERNOON", "cast": [{"id": 0, "name": "PORTIA", "names": ["PORTIA"], "gender": "?", "first": 5, "spoke": 5}, {"id": 1, "name": "KENJI", "names": ["KENJI"], "gender": "m", "first": 6, "spoke": 3}, {"id": 2, "name": "LUPE", "names": ["LUPE"], "gender": "f", "first": 7, "spoke": 4}, {"id": 3, "name": "ARCHIE", "names": ["ARCHIE"], "gender": "m", "first": 8, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. SKATE-RINK SNACK BAR - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Disco ball turning.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sticky floors.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The smell of nacho cheese.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Skates thump distantly on wooden floorboards beyond the glass.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "PORTIA, 16, in a too-large varsity jacket, slumps at a corner table, chewing a straw.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across from her, KENJI, 17, bleach-tipped hair, rubs the brim of his cap between his fingers.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "LUPE, 15, ponytail, braces, bounces on the balls of her feet at the counter.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "ARCHIE, 16, in a hoodie, stands guard by the arcade machine, arms folded.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Okay, okay, okay. She's coming.", "name": "LUPE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Who's coming?", "name": "KENJI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Mrs. Baptiste. With the clipboard.", "name": "LUPE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Hide the trophy.", "name": "PORTIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "What trophy?", "name": "ARCHIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "The one in your jacket, genius.", "name": "PORTIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "It's not in my jacket.", "name": "ARCHIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "It's sticking out of your jacket.", "name": "KENJI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Put it under the nachos.", "name": "LUPE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Under the nachos?", "name": "ARCHIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Under! The! Nachos!", "name": "PORTIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Archie drops the little gold figurine into the cheese tray and covers it with a napkin.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "The four of them freeze as an adult shape appears behind the glass, walking slowly, scanning.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "The shape passes.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "They exhale in unison.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Kenji laughs, too loud.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Portia kicks him under the table.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Ow!", "name": "KENJI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Sorry. Reflex.", "name": "PORTIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "She didn't see.", "name": "LUPE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Of course she didn't. I'm a professional.", "name": "ARCHIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "You are a thief.", "name": "PORTIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Borrower.", "name": "ARCHIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Behind the glass, the shape turns back.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "The four heads snap to the window.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Archie, in a panic, digs the trophy out of the cheese and shoves it in his hood.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "The shape keeps walking.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Out the door.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Gone.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "For a moment nobody moves.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Then Portia pulls the straw from her mouth and begins to laugh.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Kenji joins.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Lupe doubles over.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Archie, holding a hood full of nacho cheese, lets his head fall back against the arcade cabinet.", "para": 6, "sent": 4, "present": [0, 1, 2, 3]}]}