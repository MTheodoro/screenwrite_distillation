{"scene_id": "s00594", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00594.fountain", "heading": "INT. HOSPITAL WAITING ROOM - NIGHT", "cast": [{"id": 0, "name": "GLORIA PEMBERTON", "names": ["GLORIA PEMBERTON", "GLORIA"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "WALTER PEMBERTON", "names": ["WALTER PEMBERTON", "WALTER"], "gender": "m", "first": 4, "spoke": 5}, {"id": 2, "name": "DR. ESCOBEDO", "names": ["DR. ESCOBEDO"], "gender": "?", "first": 23, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOSPITAL WAITING ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Vinyl chairs bolted in rows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A vending machine glowing.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A muted TV showing a cooking competition.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "GLORIA PEMBERTON, 60s, in a church dress and orthopedic shoes, sits bolt upright, purse on her lap, rosary twisted around her fingers.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Next to her, WALTER PEMBERTON, 60s, in a windbreaker, stares at a single spot on the carpet.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "A coffee cup in his hand has gone cold.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "A phone rings on the reception desk, unattended.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Neither of them moves.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "It rings five times.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Stops.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Walter.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Yes.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Say something.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "What do you want me to say?", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Anything.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "It's a long night.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "That's something.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "On the TV, a chef flips an omelet.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Gloria's rosary beads click.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Walter shifts his weight, sets the cup on the floor, picks it up again.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "The intercom crackles overhead.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Family of Pemberton, please come to Room 4.", "name": "DR. ESCOBEDO", "speaker": 2, "ext": ["V.O."], "paren": ["over speaker, tinny"], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "They both rise at once, bump shoulders, step back.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Gloria goes first.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Walter hesitates, drops his cup in the trash, and grabs her arm, and they stand there a moment, staring at the closed door at the end of the corridor, her fingers digging into his sleeve while his hand covers hers, neither of them able to take the first step, until Gloria whispers a prayer, takes a breath, and moves, and Walter follows a half-step behind her, the way he has for forty years.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Mr. and Mrs. Pemberton. Take your time.", "name": "DR. ESCOBEDO", "speaker": 2, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "No. Not take my time.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": ["stopping"], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Gloria.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "If I take my time, I'll turn around.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Then we don't take our time.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "He squeezes her hand.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "She nods.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "They walk.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "At the door, she grips the handle, pauses, and pushes.", "para": 6, "sent": 3, "present": [0, 1, 2]}]}