{"scene_id": "s00597", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00597.fountain", "heading": "INT. GREAT HALL OF A SLEEPING KINGDOM - TWILIGHT", "cast": [{"id": 0, "name": "QUEEN RAVENNA", "names": ["QUEEN RAVENNA", "RAVENNA"], "gender": "?", "first": 4, "spoke": 3}, {"id": 1, "name": "THANE ALDRIC", "names": ["THANE ALDRIC", "ALDRIC"], "gender": "m", "first": 5, "spoke": 1}, {"id": 2, "name": "SEER IMBOLC", "names": ["SEER IMBOLC", "IMBOLC"], "gender": "f", "first": 6, "spoke": 4}, {"id": 3, "name": "BARD FENWICK", "names": ["BARD FENWICK"], "gender": "m", "first": 7, "spoke": 0}, {"id": 4, "name": "DAME DOLORES", "names": ["DAME DOLORES"], "gender": "f", "first": 8, "spoke": 0}, {"id": 5, "name": "LARK", "names": ["LARK"], "gender": "?", "first": 9, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. GREAT HALL OF A SLEEPING KINGDOM - TWILIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A long table laid for a feast no one has touched.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Candles burn low.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Every guest is awake, nobody eats.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "QUEEN RAVENNA, 50s, in a gown the color of old wine, sits at the head.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "THANE ALDRIC, 60s, broad, scarred, stares into his cup.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "SEER IMBOLC, 70s, blind, hands folded on her cane.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "BARD FENWICK, 30s, a lute on his knee, strings muted.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "DAME DOLORES, 40s, knight-errant, mud on her boots, gloves still on.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "LARK, 12, the page, stands behind the queen's chair holding a jug.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Seer. You may speak.", "name": "RAVENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "I'd rather not.", "name": "IMBOLC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "That wasn't a request.", "name": "RAVENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Then I'll say it once. The king sleeps tonight and does not wake.", "name": "IMBOLC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "The king is already asleep.", "name": "ALDRIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Not that sleep.", "name": "IMBOLC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Fenwick's hand slips on the lute.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "A string twangs and dies.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Dolores reaches slowly for her sword hilt.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Lark's jug trembles.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Who among us?", "name": "RAVENNA", "speaker": 0, "ext": [], "paren": ["very softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "The one who pours.", "name": "IMBOLC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Every head turns.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Lark goes white.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}