{"scene_id": "s00598", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00598.fountain", "heading": "EXT. CANYON RIM WAGON CAMP - TWILIGHT", "cast": [{"id": 0, "name": "SHERIFF EZEKIEL TOLLIVER", "names": ["SHERIFF EZEKIEL TOLLIVER", "TOLLIVER"], "gender": "m", "first": 5, "spoke": 11}, {"id": 1, "name": "MADAME CELESTINE", "names": ["MADAME CELESTINE", "CELESTINE"], "gender": "f", "first": 6, "spoke": 6}, {"id": 2, "name": "ROYCE BARLOW", "names": ["ROYCE BARLOW", "ROYCE"], "gender": "m", "first": 7, "spoke": 4}, {"id": 3, "name": "PEARL", "names": ["PEARL"], "gender": "f", "first": 8, "spoke": 3}, {"id": 4, "name": "SILAS", "names": ["SILAS"], "gender": "m", "first": 9, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. CANYON RIM WAGON CAMP - TWILIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A dry arroyo cuts the earth below, red walls blackening in the dusk.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single canvas-topped wagon, wheels sunk to the hubs.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cookfire sputters, spitting coals.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Beyond the light, ridge after ridge disappears into purple.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SHERIFF EZEKIEL TOLLIVER, 50s, long coat dusted white, sits on an overturned crate with a tin plate of beans, eating without hunger.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across the fire: MADAME CELESTINE, 40s, in a black traveling dress with a cameo at her throat, mending a glove with quick, exact stitches.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "ROYCE BARLOW, 30s, wiry, hat pulled low, cleans a rifle he doesn't need to clean.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "PEARL, 19, red braids, kneels at the wagon tongue feeding a mule from her palm.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "SILAS, 70s, gray beard, sits against a wheel with his eyes closed, a harmonica loose in his hand.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Madame. How far to the river?", "name": "TOLLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Two days. Maybe three.", "name": "CELESTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "With the mule or without?", "name": "TOLLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Without, we'd be there tomorrow.", "name": "CELESTINE", "speaker": 1, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "The mule's fine.", "name": "ROYCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Royce, I didn't ask the mule.", "name": "TOLLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Then I'll say it for the mule. He's fine.", "name": "ROYCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "A thin laugh from the wagon wheel.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Silas opens one eye.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Mule's older than you, Royce. Treat him respectful.", "name": "SILAS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Don't listen to them. You're beautiful.", "name": "PEARL", "speaker": 3, "ext": [], "paren": ["to the mule, murmuring"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Tolliver sets down his plate.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Studies the ridge line.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "A long silence.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Wind lifts embers off the fire and carries them over the rim.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Everyone sleep with a boot on.", "name": "TOLLIVER", "speaker": 0, "ext": [], "paren": ["to the group"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Why?", "name": "ROYCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Because I said.", "name": "TOLLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "He's seen something.", "name": "CELESTINE", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "I have not.", "name": "TOLLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "You've felt it, then.", "name": "CELESTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Damn this country.", "name": "TOLLIVER", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Sheriff?", "name": "PEARL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Yes, Pearl.", "name": "TOLLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "There's a light on the north ridge.", "name": "PEARL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "They all turn.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "High on the far ridge, tiny and steady, a single flame flickers.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Not a campfire.", "name": "SILAS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Too still.", "name": "ROYCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "It's a lantern. Someone is signaling.", "name": "CELESTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "To whom?", "name": "TOLLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "To us.", "name": "CELESTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Royce racks the rifle.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Pearl stands, one hand still on the mule.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Silas pushes himself up, grunting, the harmonica clenched in his fist.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Douse the fire.", "name": "TOLLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Pearl kicks dirt over the coals.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "The dark closes in.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Far above, the light on the ridge blinks once, twice, three times.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Nobody answers.", "name": "TOLLIVER", "speaker": 0, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "On the ridge, the light goes out.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "The canyon is silent.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "A coyote begins to cry, somewhere very near, and stops mid-note.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}]}