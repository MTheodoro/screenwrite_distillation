{"scene_id": "s00599", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00599.fountain", "heading": "INT. FISH MARKET OFFICE - 5 A.M.", "cast": [{"id": 0, "name": "KOVACS", "names": ["KOVACS"], "gender": "?", "first": 5, "spoke": 5}, {"id": 1, "name": "STELLA", "names": ["STELLA"], "gender": "?", "first": 6, "spoke": 1}, {"id": 2, "name": "NUNZIO", "names": ["NUNZIO"], "gender": "?", "first": 7, "spoke": 1}, {"id": 3, "name": "SPUDS", "names": ["SPUDS"], "gender": "m", "first": 8, "spoke": 4}, {"id": 4, "name": "MABEL", "names": ["MABEL"], "gender": "f", "first": 9, "spoke": 2}, {"id": 5, "name": "DEACON", "names": ["DEACON"], "gender": "m", "first": 10, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. FISH MARKET OFFICE - 5 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent tube.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Ice buckets.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Stacked styrofoam crates reeking of brine.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A cracked window shows the dark harbor.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MR. KOVACS, 60s, grey suit, sits behind a metal desk.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "STELLA, 30s, sleek in a trench coat, leans against a filing cabinet.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "NUNZIO, 40s, apron smeared with blood, wipes a cleaver on a rag.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "SPUDS, 20s, jittery, bounces his knee.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "MABEL, 50s, bookkeeper, spectacles on a chain, sorts receipts.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "DEACON, 70s, white-haired, in a church coat, sits quietly by the door with a fishing basket on his lap.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Where's the money, Spuds?", "name": "KOVACS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "I don't have it, Mr. K.", "name": "SPUDS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "He says that every week.", "name": "NUNZIO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Because every week it's true.", "name": "STELLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Hey! I'm right here.", "name": "SPUDS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Spuds, dear, you're nineteen thousand short.", "name": "MABEL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Mabel, you know I love you...", "name": "SPUDS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Don't \"Mabel\" me.", "name": "MABEL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Quiet, all of you.", "name": "KOVACS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "The room freezes.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Kovacs turns to Deacon, who has not moved.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Deacon. Open the basket.", "name": "KOVACS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "It's only fish, Mr. K.", "name": "DEACON", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Open it.", "name": "KOVACS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Deacon lifts the lid.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Inside, wrapped in newsprint, rows of banded bills.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Spuds gasps.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Stella steps back.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Nunzio lowers the cleaver.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Mabel drops her pen.", "para": 3, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "I was keeping it safe.", "name": "DEACON", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "For whom?", "name": "KOVACS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "For Spuds. The boy's got a baby coming.", "name": "DEACON", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "You what?", "name": "SPUDS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Don't thank me yet.", "name": "DEACON", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}