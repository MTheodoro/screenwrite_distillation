{"scene_id": "s00600", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00600.fountain", "heading": "INT. COUNTY COURTHOUSE - CRAMPED JURY DELIBERATION ROOM - NIGHT", "cast": [{"id": 0, "name": "AUDREY KESSLER", "names": ["AUDREY KESSLER", "AUDREY"], "gender": "?", "first": 6, "spoke": 11}, {"id": 1, "name": "SELLERS", "names": ["SELLERS"], "gender": "m", "first": 7, "spoke": 7}, {"id": 2, "name": "FRANKLIN OKORO", "names": ["FRANKLIN OKORO", "FRANKLIN"], "gender": "m", "first": 8, "spoke": 5}, {"id": 3, "name": "MAYBELLE TRUDEAU", "names": ["MAYBELLE TRUDEAU", "MAYBELLE"], "gender": "?", "first": 9, "spoke": 7}, {"id": 4, "name": "JUDGE ZAPATA", "names": ["JUDGE ZAPATA", "ZAPATA"], "gender": "?", "first": 55, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. COUNTY COURTHOUSE - CRAMPED JURY DELIBERATION ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "One table.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Five chairs.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A radiator that clanks.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A pitcher of water gone warm.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A single window painted shut.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "AUDREY KESSLER, 40s, foreperson, sleeves rolled, stands at a whiteboard.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "MR. SELLERS, 60s, retired machinist, sits with his arms crossed.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "FRANKLIN OKORO, 30s, an accountant with a calculator he keeps pressing.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "MAYBELLE TRUDEAU, 70s, knitting, needles clicking.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "All right. Another vote. Hands.", "name": "AUDREY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Nobody moves.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "The radiator clanks.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Guilty.", "name": "AUDREY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Sellers keeps his arms crossed.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Franklin presses a key on the calculator.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Maybelle's needles never pause.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Not guilty.", "name": "AUDREY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Sellers shifts.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Franklin sets the calculator down.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "The needles click.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "That's the same as the last four.", "name": "AUDREY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Then we vote again.", "name": "SELLERS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "We've voted all night.", "name": "AUDREY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "I can vote till Easter.", "name": "SELLERS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "The numbers don't add up.", "name": "FRANKLIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Which numbers?", "name": "AUDREY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "The defendant's timeline. Three minutes missing.", "name": "FRANKLIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Three minutes isn't a man's life.", "name": "SELLERS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "It is if you're counting.", "name": "FRANKLIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Everyone counts different, dear.", "name": "MAYBELLE", "speaker": 3, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Maybelle, what do you think?", "name": "AUDREY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "I think the boy looked at his mother when the verdict came up in his head.", "name": "MAYBELLE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "The verdict hasn't come up.", "name": "AUDREY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "It will.", "name": "MAYBELLE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "The needles click.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "You're going to hang us on a feeling.", "name": "SELLERS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "No. I'll hang us on a fact.", "name": "MAYBELLE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Which?", "name": "SELLERS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "The knot.", "name": "MAYBELLE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "What knot?", "name": "AUDREY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "The one in the rope. Exhibit nine. It's a fisherman's bend, not a hangman's. Whoever tied it was left-handed.", "name": "MAYBELLE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "The defendant is right-handed.", "name": "FRANKLIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "That's not in evidence.", "name": "SELLERS", "speaker": 1, "ext": [], "paren": ["slowly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "It's in the photo. I looked.", "name": "MAYBELLE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Audrey puts down the marker.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Sits.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "The room settles into an uneasy, new quiet.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Franklin picks up the calculator again and begins to type, fast.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "If he's right-handed, and the timeline's off by three minutes...", "name": "FRANKLIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Then we vote again.", "name": "AUDREY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Then we vote again.", "name": "SELLERS", "speaker": 1, "ext": [], "paren": ["grudging"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Two knocks.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "The door opens a hand's width.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "JUDGE ZAPATA, 50s, in robes, tired, leans in.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "The court reporter is leaving. Do you need the night?", "name": "ZAPATA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "We need the night.", "name": "AUDREY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "Then I'll tell the bailiff. Good evening.", "name": "ZAPATA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "The door closes.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}]}