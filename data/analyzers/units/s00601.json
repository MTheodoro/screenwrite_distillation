{"scene_id": "s00601", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00601.fountain", "heading": "INT. MANOR LIBRARY - NIGHT", "cast": [{"id": 0, "name": "INSPECTOR GRIMSBY", "names": ["INSPECTOR GRIMSBY", "GRIMSBY"], "gender": "m", "first": 5, "spoke": 11}, {"id": 1, "name": "LADY ONDINE VANTERPOOL", "names": ["LADY ONDINE VANTERPOOL", "ONDINE"], "gender": "?", "first": 5, "spoke": 6}, {"id": 2, "name": "FLORIAN AUBERT", "names": ["FLORIAN AUBERT", "FLORIAN"], "gender": "?", "first": 5, "spoke": 6}, {"id": 3, "name": "BRIDGET MULLANEY", "names": ["BRIDGET MULLANEY", "BRIDGET"], "gender": "?", "first": 5, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. MANOR LIBRARY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Leather spines.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A cold hearth.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A body-shaped chalk outline on the carpet beside a toppled globe.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain on the leaded windows.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "INSPECTOR GRIMSBY, 50s, rumpled, a pipe unlit in his teeth, circles the outline slowly while LADY ONDINE VANTERPOOL, 60s, in a black silk wrap, stands rigid by the fireplace, her cane planted like a flag, and FLORIAN AUBERT, 30s, the secretary, lingers in the doorway turning a pen over and over in his knuckles, and BRIDGET MULLANEY, 20s, the housemaid, hovers at a tray of cups, head bowed, eyes darting from one face to the next.", "para": 1, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "dialogue", "text": "Lady Ondine, the clock.", "name": "GRIMSBY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "What of it?", "name": "ONDINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Stopped at ten past eleven.", "name": "GRIMSBY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "It always stops.", "name": "ONDINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "It's an old clock.", "name": "FLORIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "My ma said it's cursed.", "name": "BRIDGET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Bridget, hush.", "name": "ONDINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Sorry, ma'am.", "name": "BRIDGET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Mr. Aubert, you were at the desk?", "name": "GRIMSBY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "All evening.", "name": "FLORIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "And you heard nothing?", "name": "GRIMSBY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Not a thing.", "name": "FLORIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "He is deaf in the left ear.", "name": "ONDINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Slightly.", "name": "FLORIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Convenient.", "name": "GRIMSBY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "It's a handicap, sir.", "name": "FLORIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "He hears fine when the cook mentions pudding.", "name": "BRIDGET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Bridget!", "name": "FLORIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Girl, to the kitchen.", "name": "ONDINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Yes, ma'am.", "name": "BRIDGET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "She doesn't move.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Grimsby sets his pipe in the ashtray.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Stay, Miss Mullaney. You've something to say.", "name": "GRIMSBY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "I have not.", "name": "BRIDGET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Then why the cups?", "name": "GRIMSBY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "What cups?", "name": "BRIDGET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "You've brought four. And there were five in the room.", "name": "GRIMSBY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Ondine's knuckles whiten on the cane.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Florian's pen stops turning.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Grimsby crosses to the globe, rights it, and spins it with one finger.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "The fifth cup was the dead man's. Someone took it. Someone with a reason.", "name": "GRIMSBY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Inspector, this is intolerable.", "name": "ONDINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "No, my lady. This is Tuesday.", "name": "GRIMSBY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Bridget lets out a tiny, strangled sound and sets down the tray.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "The cups rattle.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "She looks at Florian, who looks at the carpet.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Ondine looks at neither.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Miss Mullaney. Which of them told you to hide it?", "name": "GRIMSBY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Nobody told me. I thought the cup was... it was warm. He was still warm.", "name": "BRIDGET", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}]}