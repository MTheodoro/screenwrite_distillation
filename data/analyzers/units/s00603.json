{"scene_id": "s00603", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00603.fountain", "heading": "INT. FIELD HOSPITAL TENT - FLOODED RIVER DELTA - NIGHT", "cast": [{"id": 0, "name": "LIESEL VANTONGEREN", "names": ["LIESEL VANTONGEREN", "LIESEL"], "gender": "f", "first": 5, "spoke": 12}, {"id": 1, "name": "TOMAS", "names": ["TOMAS"], "gender": "?", "first": 12, "spoke": 12}], "units": [{"u": 0, "kind": "heading", "text": "INT. FIELD HOSPITAL TENT - FLOODED RIVER DELTA - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Rain hammers canvas.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Water laps at the plank floor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "One operating lamp swings on a chain, throwing quick shadows across a table where a patient lies under a blue drape.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Generators cough somewhere outside.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. LIESEL VANTONGEREN, 40s, mask down around her neck, gloves slick, leans over the table, hands deep in the dark work of an abdomen.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Sweat runs down her temple.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She does not wipe it.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "A satellite phone buzzes on a crate by her elbow.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "She ignores it.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "It buzzes again.", "para": 2, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "She jerks her head at the speaker button with her elbow and it clicks on.", "para": 2, "sent": 3, "present": [0]}, {"u": 12, "kind": "dialogue", "text": "Liesel? Can you hear me?", "name": "TOMAS", "speaker": 1, "ext": ["V.O."], "paren": ["distorted, far away"], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Not now, Tomas.", "name": "LIESEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "It's the bridge. They've closed the bridge.", "name": "TOMAS", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I'm in the middle of a resection.", "name": "LIESEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "The helicopter can't land. The water's too high.", "name": "TOMAS", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She stops.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Her hands go still inside the wound.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "The lamp swings.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Say again.", "name": "LIESEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "No extraction. Not tonight. Maybe not tomorrow.", "name": "TOMAS", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "She breathes in, slow, through her nose.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Reaches for a clamp without looking, finds it, clamps.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "The bleeding slows.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "She straightens her back, once, for a second only, and the table creaks.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Then you tell the captain I'm keeping him here.", "name": "LIESEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "He needs a surgeon, Liesel. A real theater.", "name": "TOMAS", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "He has a surgeon.", "name": "LIESEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "You have a spoon and a flashlight.", "name": "TOMAS", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "And twenty years.", "name": "LIESEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "A beat of static.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "The rain thunders.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "On the table the patient shudders, one hand twitching under the drape.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "All right. What do you need?", "name": "TOMAS", "speaker": 1, "ext": ["V.O."], "paren": ["quieter"], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Sutures. Two units of O negative. And you, on the radio, until sunrise.", "name": "LIESEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "I'm here.", "name": "TOMAS", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "She sets the clamp.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Reaches for a needle.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Threads it with fingers that, now, finally, are shaking, and does not stop.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Tomas.", "name": "LIESEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Yes.", "name": "TOMAS", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Talk to me about anything.", "name": "LIESEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Anything?", "name": "TOMAS", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Anything but this.", "name": "LIESEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "I bought a goat yesterday.", "name": "TOMAS", "speaker": 1, "ext": ["V.O."], "paren": ["a small laugh"], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "You didn't.", "name": "LIESEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "Her name is Margaret. She's already eaten my boots.", "name": "TOMAS", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Liesel almost smiles.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "The lamp swings.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "The needle dips and rises, dips and rises, a small steady rhythm under the downpour.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "The patient breathes.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "She does not look up.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "She does not stop.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "She says, very quietly:", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "Tell me about Margaret.", "name": "LIESEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}