{"scene_id": "s00605", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00605.fountain", "heading": "INT. ABANDONED OPERA HOUSE - STAGE - NIGHT", "cast": [{"id": 0, "name": "SABINE DELACROIX-NOLAN", "names": ["SABINE DELACROIX-NOLAN", "SABINE"], "gender": "f", "first": 4, "spoke": 14}, {"id": 1, "name": "EMERIC VASSEUR", "names": ["EMERIC VASSEUR", "EMERIC"], "gender": "?", "first": 8, "spoke": 14}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED OPERA HOUSE - STAGE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Bare boards, a ghost light burning on a pole, red velvet rows rising into dark.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The painted proscenium arch has cracked and flaked.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain taps in the rafters like a distant orchestra tuning.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SABINE DELACROIX-NOLAN, 30s, in a long black coat, steps into the pool of the ghost light, a briefcase swinging from one hand.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her eyes sweep the empty seats.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "She is looking for someone.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "From the shadows of the wings, a voice, mild and amused.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "dialogue", "text": "You came alone.", "name": "EMERIC VASSEUR", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "You told me to.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "EMERIC steps into the light.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "50s, white dinner jacket, bow tie undone, a face of soft, sad charm.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "A cut on his lip.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He holds a violin case in both arms like a child.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "That was the first mistake.", "name": "EMERIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Yours or mine?", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "I haven't decided.", "name": "EMERIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He walks the length of the stage, slowly, boot heels echoing in the empty hall.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Stops beside her.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Close enough to touch.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Does not.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Emeric.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Sabine.", "name": "EMERIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Where is it?", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Where is what?", "name": "EMERIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Don't. Not tonight.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "He smiles.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Lays the violin case at her feet, flicks the clasps, and opens the lid.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Inside, on a bed of velvet, nested like a jewel: a pistol.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "And a note, folded once.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "What is that?", "name": "SABINE", "speaker": 0, "ext": ["CONT'D"], "paren": ["not touching either"], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "A choice.", "name": "EMERIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "I don't want a choice.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Everyone wants a choice. It is merely a matter of whether they would rather make it or be made by it.", "name": "EMERIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "You're quoting your father again.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "My father was an idiot, Sabine. He was also right.", "name": "EMERIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "She bends.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Picks up the note.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Reads.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Her shoulders go slack, then rigid, then slack again.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "She looks up, and for the first time her composure fractures, a trembling at the mouth.", "para": 7, "sent": 4, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "This is her handwriting.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Yes.", "name": "EMERIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "When did she write it?", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Eleven days ago.", "name": "EMERIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "You knew.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "I was asked not to say.", "name": "EMERIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "She folds the note.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Closes her fist around it.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "Her breath catches and then steadies.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Is she alive?", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "I don't know.", "name": "EMERIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Emeric.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "I honestly do not know.", "name": "EMERIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "The ghost light flickers.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "The rain thickens in the rafters.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "Sabine lifts her eyes to the dark upper galleries, then to the pistol.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "Then I choose.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "Which?", "name": "EMERIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "She takes the gun.", "para": 10, "sent": 0, "present": [0, 1]}]}