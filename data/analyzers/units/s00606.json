{"scene_id": "s00606", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00606.fountain", "heading": "INT. FUNERAL HOME - FAMILY ROOM - AFTERNOON", "cast": [{"id": 0, "name": "DOLLY SUTHERLAND", "names": ["DOLLY SUTHERLAND", "DOLLY"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "RAY-RAY SUTHERLAND", "names": ["RAY-RAY SUTHERLAND", "RAY-RAY"], "gender": "?", "first": 4, "spoke": 3}, {"id": 2, "name": "UNCLE WENDELL", "names": ["UNCLE WENDELL", "WENDELL"], "gender": "?", "first": 6, "spoke": 3}, {"id": 3, "name": "AUNT PRISCILLA", "names": ["AUNT PRISCILLA", "PRISCILLA"], "gender": "f", "first": 7, "spoke": 6}, {"id": 4, "name": "CAROL BENNING", "names": ["CAROL BENNING", "CAROL"], "gender": "?", "first": 8, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. FUNERAL HOME - FAMILY ROOM - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Sour coffee.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A sheet cake with a cut missing.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Folding chairs facing a closed door.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DOLLY SUTHERLAND, 50s, pulls tissues from a box.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "RAY-RAY SUTHERLAND, 20s, tugs at a tie.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "UNCLE WENDELL, 70s, in a brown suit, pours coffee into a paper cup.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "AUNT PRISCILLA, 60s, in a lavender dress, adjusts a hat.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "CAROL BENNING, 40s, the neighbor, holds a covered dish.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "She wanted the blue one.", "name": "DOLLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "She did not. She wanted the green.", "name": "PRISCILLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Aunt Dolly said blue.", "name": "RAY-RAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Blue is for babies.", "name": "WENDELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Wendell, hush.", "name": "PRISCILLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "I brought the casserole.", "name": "CAROL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Carol, you shouldn't have.", "name": "DOLLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "It's tuna.", "name": "CAROL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Lord.", "name": "WENDELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Does anyone know where she put the will?", "name": "RAY-RAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Ray-Ray!", "name": "PRISCILLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Not here.", "name": "DOLLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Then where?", "name": "RAY-RAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Not today, son.", "name": "WENDELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "I'll just put this in the kitchen.", "name": "CAROL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "She was my mother, Priscilla.", "name": "DOLLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "She was my sister.", "name": "PRISCILLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "She was my mother first.", "name": "DOLLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "She was my sister longer.", "name": "PRISCILLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "They both stop.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Their eyes meet.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Dolly looks away first.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Priscilla straightens her hat.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "The green one, then.", "name": "PRISCILLA", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "The green.", "name": "DOLLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}