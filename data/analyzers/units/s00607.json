{"scene_id": "s00607", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00607.fountain", "heading": "EXT. ABANDONED GREENHOUSE - OVERGROWN LOT - DAY", "cast": [{"id": 0, "name": "BOY", "names": ["BOY"], "gender": "?", "first": 5, "spoke": 9}, {"id": 1, "name": "GIRL", "names": ["GIRL"], "gender": "?", "first": 8, "spoke": 7}, {"id": 2, "name": "SOLEDAD", "names": ["SOLEDAD"], "gender": "?", "first": 30, "spoke": 22}, {"id": 3, "name": "KIERAN", "names": ["KIERAN"], "gender": "?", "first": 37, "spoke": 18}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ABANDONED GREENHOUSE - OVERGROWN LOT - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Sun slants through cracked panes.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Vines thick as arms pour over rusted tables.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A pigeon coos from a rafter.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Somewhere in the weeds, a hose drips onto dry earth.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A BOY, 14, thin, pale, in a stained basketball jersey, crouches among shattered terracotta pots, sorting shards into a little wall.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "He builds quietly, tongue between his teeth.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "The wall is already knee-high.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "A GIRL, 14, in cutoffs and a straw hat, steps through a gap in the glass, carrying a rusty watering can.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "She stops.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Looks at him.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Looks at the wall.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "That's mine.", "name": "GIRL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "It's nobody's.", "name": "BOY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "I built the first row.", "name": "GIRL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "You left.", "name": "BOY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "I was sick.", "name": "GIRL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "For three weeks.", "name": "BOY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "I had the flu.", "name": "GIRL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Then you shouldn't have started something you couldn't finish.", "name": "BOY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She puts down the watering can.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Crosses to the wall.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Runs a finger along the top row, feeling the sharpness of the shards.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "You got the angles wrong.", "name": "GIRL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "They're not wrong.", "name": "BOY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "They're crooked.", "name": "GIRL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "It's called character.", "name": "BOY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "She laughs, short, surprised.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "He allows a tiny smile.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "She sits across from him on an overturned bucket.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "I'm Soledad.", "name": "GIRL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "I know.", "name": "BOY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "How?", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "It's on your bag.", "name": "BOY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "She looks down at the canvas satchel at her hip.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Stitched across the flap in yellow thread: SOLEDAD R.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Oh. Right. And you?", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Kieran.", "name": "BOY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Kieran what?", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Just Kieran.", "name": "KIERAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Okay, just Kieran.", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "She picks up a shard of blue ceramic.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Hands it to him.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Put that one in the middle. It'll catch the light.", "name": "SOLEDAD", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "He takes it.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Places it carefully.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Sun filters through, and the shard glows, a little blue window in the wall of broken things.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Huh.", "name": "KIERAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "See?", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Okay. You were right about the middle.", "name": "KIERAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "I'm right about a lot.", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "That's what I'm afraid of.", "name": "KIERAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "They work in silence for a while, passing shards back and forth, building the wall higher.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "A breeze stirs the vines.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "The pigeon watches from above.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Why do you come here?", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "It's quiet.", "name": "KIERAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "It's quiet at the library.", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "The library has people.", "name": "KIERAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "So do I, apparently.", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "Yeah. You're sort of an exception.", "name": "KIERAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "A long pause.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "She sets down the shard in her hand.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "My dad's moving us in September.", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "Where?", "name": "KIERAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "Phoenix.", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "That's far.", "name": "KIERAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "It's two states. I looked.", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "Will you come back?", "name": "KIERAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "dialogue", "text": "I don't know. Probably not.", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "Kieran stares at the half-built wall.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "His hands, which were so careful, are slack now.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "Then why'd you come back to finish the first row?", "name": "KIERAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "I don't know that either.", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "The hose drips.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "A bee drones in the vines.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "For a moment they simply sit, the wall between them, the afternoon holding.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "Then Kieran gets up.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "action", "text": "Walks to the far end of the greenhouse.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "action", "text": "Brings back a small glass jar.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "action", "text": "Inside, a single green sprout, thin, pale, reaching.", "para": 12, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "dialogue", "text": "Found it last week. Growing through the floor.", "name": "KIERAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "action", "text": "She takes the jar.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "action", "text": "Holds it up to the light.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 84, "kind": "action", "text": "The sprout seems to glow.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 85, "kind": "dialogue", "text": "It's a tomato.", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 86, "kind": "dialogue", "text": "How do you know?", "name": "KIERAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 87, "kind": "dialogue", "text": "Leaf shape. See the little hairs?", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 88, "kind": "dialogue", "text": "Oh.", "name": "KIERAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 89, "kind": "dialogue", "text": "It's from the old crop. Someone grew them here, years ago, and it's been waiting.", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 90, "kind": "dialogue", "text": "Waiting for what?", "name": "KIERAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 91, "kind": "dialogue", "text": "Whoever came along.", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 92, "kind": "action", "text": "She hands him the jar.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 93, "kind": "action", "text": "He cradles it with both hands.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 94, "kind": "dialogue", "text": "Then I guess it's ours.", "name": "KIERAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 95, "kind": "dialogue", "text": "For the summer.", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 96, "kind": "dialogue", "text": "For the summer.", "name": "KIERAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 97, "kind": "action", "text": "He sets the jar on top of the wall, in the middle, in the blue glow, and steps back to look.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 98, "kind": "action", "text": "The sun moves.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 99, "kind": "action", "text": "The wall shimmers.", "para": 16, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 100, "kind": "action", "text": "A shadow falls across it, long and thin, from the gap in the glass where nobody stands.", "para": 16, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 101, "kind": "action", "text": "Kieran turns.", "para": 17, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 102, "kind": "action", "text": "Soledad is watching the gap.", "para": 17, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 103, "kind": "action", "text": "Her hat has slipped to the back of her head.", "para": 17, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 104, "kind": "dialogue", "text": "Did you see that?", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 105, "kind": "dialogue", "text": "It's only the vines.", "name": "KIERAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 106, "kind": "dialogue", "text": "Right.", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 107, "kind": "action", "text": "Neither of them moves.", "para": 18, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 108, "kind": "action", "text": "The shadow shifts.", "para": 18, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 109, "kind": "action", "text": "A pigeon launches from the rafters in a clatter of wings.", "para": 18, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 110, "kind": "action", "text": "They both laugh, shaky, relieved, and then the laughter fades and they are two kids in a ruined place, holding very still.", "para": 19, "sent": 0, "present": [0, 1, 2, 3]}]}