{"scene_id": "s00608", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00608.fountain", "heading": "INT. PLANETARIUM CAFE - CLOSED - NIGHT", "cast": [{"id": 0, "name": "PHILOMENA CROSS", "names": ["PHILOMENA CROSS", "PHILOMENA"], "gender": "f", "first": 4, "spoke": 3}, {"id": 1, "name": "GRADY", "names": ["GRADY"], "gender": "m", "first": 5, "spoke": 5}, {"id": 2, "name": "TUCKER", "names": ["TUCKER"], "gender": "m", "first": 6, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. PLANETARIUM CAFE - CLOSED - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Chairs upturned on tables.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A cooler humming.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A faded mural of the solar system peeling above the counter.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "PHILOMENA CROSS, 40s, in a heavy knit sweater, sits very still at a window booth, a cold cup untouched before her.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across from her, GRADY, 30s, shirtsleeves rolled, taps a spoon against his saucer.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "On a stool at the counter, TUCKER, 30s, in a tweed jacket, spins slowly one way, then the other.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Nobody says anything.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "The spoon taps.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "He glances at her.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "She glances away.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He taps once more.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Stops.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Tucker lets the stool stop turning.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "He rests his elbows on the counter, studies the mural.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Jupiter's too small.", "name": "TUCKER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "It's accurate.", "name": "GRADY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "It's a third of the size it ought to be.", "name": "TUCKER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Ought to be where?", "name": "GRADY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "In the picture.", "name": "TUCKER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Philomena slides her cup an inch toward the center of the table.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Grady's eyes follow it.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "You want that reheated?", "name": "GRADY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "No.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "You'll catch cold.", "name": "GRADY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "I'll manage.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Grady scrapes his chair back.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Walks behind the counter.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Tucker watches him pass, lets his hand drift to the edge of a drawer, and closes it again.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "He turns his head, slow, toward Philomena.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "She is already looking at him.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "He stays still.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "She doesn't blink.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Grady comes back with a pot of coffee, a fresh cup.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "He pours.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "The smell of it fills the room.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Drink it. Please.", "name": "GRADY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "She holds the cup but doesn't lift it.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Steam curls up past her face.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "You don't have to say it.", "name": "TUCKER", "speaker": 2, "ext": [], "paren": ["not looking"], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "I wasn't going to.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Good.", "name": "TUCKER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Grady sets down the pot.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Rests one hand on the back of Tucker's stool, the other flat on the table, close to Philomena's.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "They sit like that, three of them, around a thing nobody names, until the cooler cycles off and the silence turns total.", "para": 10, "sent": 2, "present": [0, 1, 2]}]}