{"scene_id": "s00609", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00609.fountain", "heading": "EXT. RUINED CHURCH TOWER - NORMANDY - DAY (1944)", "cast": [{"id": 0, "name": "KAMAU NJOROGE", "names": ["KAMAU NJOROGE", "KAMAU"], "gender": "m", "first": 5, "spoke": 13}, {"id": 1, "name": "DUVALL", "names": ["DUVALL"], "gender": "?", "first": 7, "spoke": 6}, {"id": 2, "name": "SANTOS", "names": ["SANTOS"], "gender": "m", "first": 9, "spoke": 4}, {"id": 3, "name": "REYES", "names": ["REYES"], "gender": "?", "first": 12, "spoke": 3}, {"id": 4, "name": "BAR", "names": ["BAR"], "gender": "?", "first": 44, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. RUINED CHURCH TOWER - NORMANDY - DAY (1944)", "present": []}, {"u": 1, "kind": "action", "text": "A shattered bell tower, half the roof torn open to the sky.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Pigeons nest in broken beams.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Stone dust sifts on a floor strewn with prayer books.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Beyond the shell of the nave, a dim valley of poplars and burned barns.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LT. KAMAU NJOROGE, 30s, a Kenyan serving with the British, kneels at an arrow slit with binoculars, his helmet pushed back, a streak of soot across his forehead.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Beside him, CPL.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "DUVALL, 20s, a Louisiana man with a drawl and a mouth full of chewing tobacco, cradles a Browning automatic rifle.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "In the corner, PVT.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "SANTOS, 18, shivers under a blanket, a field radio on his lap, headset askew.", "para": 1, "sent": 4, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Quiet on the ground.", "name": "KAMAU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Ground's always quiet till it isn't.", "name": "DUVALL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Sir, Captain Reyes on the net.", "name": "SANTOS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Kamau crosses and takes the headset.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Santos hands it over with both hands, like a sacrament.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Tower Six, Lieutenant Njoroge.", "name": "KAMAU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Njoroge. Status?", "name": "REYES", "speaker": 3, "ext": ["V.O."], "paren": ["through static"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Two hundred meters. No movement. Barn on the left is empty. I'd say they've pulled back.", "name": "KAMAU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "I'd say they're resting. Hold your position. We push at fourteen hundred.", "name": "REYES", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Understood.", "name": "KAMAU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Njoroge. Make sure the boy eats.", "name": "REYES", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Yes, sir.", "name": "KAMAU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "He lowers the headset.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Turns to Santos, who is pale and trying not to look it.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Eat.", "name": "KAMAU", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "I'm not hungry.", "name": "SANTOS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Private, that wasn't a request.", "name": "KAMAU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Santos unwraps a ration bar with trembling fingers.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Duvall spits tobacco over the ledge, and the three of them listen to the valley breathe.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Somewhere below, wind rattles through the splintered pews.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Sir, you ever think about what happens after?", "name": "DUVALL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "After what?", "name": "KAMAU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "After this.", "name": "DUVALL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "I think about my mother's farm.", "name": "KAMAU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Mine's got a pecan orchard.", "name": "DUVALL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "I just want a hot bath.", "name": "SANTOS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Duvall chuckles.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Kamau almost smiles.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Then, far away, a single muffled THUMP.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Another.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Mortar shells.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "All three men freeze.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Dust trickles from the beams.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Santos covers his head.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Duvall rolls toward the slit, raising the BAR.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Hold.", "name": "KAMAU", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Sir?", "name": "DUVALL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "Not at us. They're shelling the road.", "name": "KAMAU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "They wait.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "The thumps continue, rhythmic, distant.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "The tower trembles.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "No shell comes near.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "At last Duvall lets his breath out.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "Hell of a thing, waiting.", "name": "DUVALL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "Yes.", "name": "KAMAU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Santos slowly lowers his hands from his head.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Looks up.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "Is that a hot bath coming?", "name": "SANTOS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "Possibly. In the next war.", "name": "KAMAU", "speaker": 0, "ext": [], "paren": ["smiling, finally"], "dual": false, "present": [0, 1, 2, 3, 4]}]}