{"scene_id": "s00611", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00611.fountain", "heading": "EXT. BRIAR FOREST CROSSROADS - DUSK", "cast": [{"id": 0, "name": "HOODED FIGURE", "names": ["HOODED FIGURE"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "GARRICK", "names": ["GARRICK"], "gender": "m", "first": 8, "spoke": 7}, {"id": 2, "name": "YSOLDE", "names": ["YSOLDE"], "gender": "f", "first": 9, "spoke": 4}, {"id": 3, "name": "PELLEGRIN", "names": ["PELLEGRIN"], "gender": "?", "first": 28, "spoke": 4}, {"id": 4, "name": "MAREN", "names": ["MAREN"], "gender": "f", "first": 39, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. BRIAR FOREST CROSSROADS - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "Four roads meet at a mossy standing stone.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Branches arch overhead, thick with fireflies.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A stag skull is nailed to a signpost, antlers hung with ribbons.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A HOODED FIGURE sits on the stone, legs crossed, cloak the color of old moss.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Hands rest on knees.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Waiting.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "From the north road, a mule-drawn cart creaks into view.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "GARRICK, 40s, wiry cartwright, perches on the driver's board, a long whip coiled in his lap.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Walking beside him, YSOLDE, 20s, a student of herbs in a patched green cloak, carries a basket under her arm.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "They stop at the stone.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Garrick tips his hat.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "The Hooded Figure doesn't acknowledge it.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Evening.", "name": "GARRICK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Evening.", "name": "HOODED FIGURE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Is this the road to Marrow Hill?", "name": "YSOLDE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "All four roads lead to Marrow Hill. Only one arrives.", "name": "HOODED FIGURE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Cryptic sort, aren't you?", "name": "GARRICK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "I am old.", "name": "HOODED FIGURE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Which one arrives?", "name": "YSOLDE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "The Hooded Figure lifts a hand and points, without looking, along the east road, then the west, then the south.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Not that one. Not that one. Not that one.", "name": "HOODED FIGURE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "That leaves the north.", "name": "GARRICK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "It does.", "name": "HOODED FIGURE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "We came from the north.", "name": "GARRICK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Then you have already arrived.", "name": "HOODED FIGURE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Ysolde and Garrick exchange a look.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "A rustle in the brush behind the stone.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "PELLEGRIN, 60s, a tall monk in a threadbare brown habit, steps into the road with a staff in each hand.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "He stops, taking in the cart, the girl, the stone.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Ah. Company.", "name": "PELLEGRIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Father.", "name": "GARRICK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Not Father. Just Pellegrin.", "name": "PELLEGRIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Do you know the way?", "name": "YSOLDE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "No. But I know when to stop.", "name": "PELLEGRIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "He plants both staffs and leans on them.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "The Hooded Figure rises from the stone.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Pulls back the hood.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "A woman, lined face, eyes bright as a bird's.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "MAREN, 70s, stands at the crossroads with her hands open.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "I am Maren. I've kept this crossing for sixty years.", "name": "MAREN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "For what?", "name": "GARRICK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "For those who are lost enough to ask directions.", "name": "MAREN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "And are we lost?", "name": "PELLEGRIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Obviously.", "name": "MAREN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "She sits again.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Opens a satchel at her side and takes out a loaf of bread.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Tears it in four.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Offers the pieces to each.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Thank you.", "name": "YSOLDE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "What's the catch?", "name": "GARRICK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "Eat. Then we'll see.", "name": "MAREN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "They eat.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "The fireflies drift.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "The stag skull watches, and the four roads stretch into the dark, patient as old dogs.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}]}