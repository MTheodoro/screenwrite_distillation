{"scene_id": "s00612", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00612.fountain", "heading": "INT. SUBURBAN KITCHEN - NIGHT", "cast": [{"id": 0, "name": "HATTIE BRANDT", "names": ["HATTIE BRANDT", "HATTIE"], "gender": "f", "first": 4, "spoke": 13}, {"id": 1, "name": "ROLAND", "names": ["ROLAND"], "gender": "?", "first": 13, "spoke": 12}], "units": [{"u": 0, "kind": "heading", "text": "INT. SUBURBAN KITCHEN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dishes drying on a rack.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A school calendar with a circled date.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A laptop open on the counter, its screen reflecting off a dark window.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "HATTIE BRANDT, 15, in an oversized hoodie, sits cross-legged on a stool, thumbing her phone, a half-eaten bowl of cereal in front of her.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She hasn't noticed the milk has gone warm.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "The phone vibrates.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "DAD flashes on the screen.", "para": 2, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "She watches it buzz.", "para": 2, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "Lets it go.", "para": 2, "sent": 3, "present": [0]}, {"u": 10, "kind": "action", "text": "It buzzes again.", "para": 3, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "She picks up.", "para": 4, "sent": 0, "present": [0]}, {"u": 12, "kind": "dialogue", "text": "What.", "name": "HATTIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 13, "kind": "dialogue", "text": "Hattie, hey. I'm outside.", "name": "ROLAND", "speaker": 1, "ext": ["V.O."], "paren": ["over speaker, a car interior, road noise"], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Outside where?", "name": "HATTIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Your house. Out front. In the driveway.", "name": "ROLAND", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She goes to the window, parts the blinds with two fingers.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "A car idles at the curb, headlights off, a silhouette behind the wheel.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Mom said you weren't coming till Saturday.", "name": "HATTIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "I know what she said.", "name": "ROLAND", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "She's going to freak out.", "name": "HATTIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "She's asleep.", "name": "ROLAND", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "She's not asleep. She's pretending to be asleep.", "name": "HATTIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Then she can keep pretending. Come out. Five minutes.", "name": "ROLAND", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "I have school tomorrow.", "name": "HATTIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Then ten minutes. I'll drive you around the block.", "name": "ROLAND", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Hattie hesitates, hand on the blind.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "She looks back at the kitchen, the cereal, the calendar.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "The circled date is tomorrow.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Dad. Why tonight?", "name": "HATTIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Because I've been parked here for an hour trying to knock on the door and I can't.", "name": "ROLAND", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Silence on the line.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Rain starts, soft, on the window.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "You can't come in.", "name": "HATTIE", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "I know.", "name": "ROLAND", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "She changed the locks.", "name": "HATTIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "I know, sweetheart.", "name": "ROLAND", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "But I can come out.", "name": "HATTIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "She takes her hoodie from the chair.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Pulls it on over her pajamas, zips it to the chin.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Take an umbrella.", "name": "ROLAND", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "It's drizzling.", "name": "HATTIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Take an umbrella anyway.", "name": "ROLAND", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "She almost laughs.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "Takes the umbrella from the stand by the door.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "Pauses at the back stairs, listening to the silence of the house.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Dad?", "name": "HATTIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "Yeah.", "name": "ROLAND", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "I'm coming out.", "name": "HATTIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "She lowers the phone, still connected, and slips quietly out the door.", "para": 10, "sent": 0, "present": [0, 1]}]}