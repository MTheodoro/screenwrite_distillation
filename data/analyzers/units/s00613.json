{"scene_id": "s00613", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00613.fountain", "heading": "INT. NIGHT TRAIN DINING CAR - MOVING", "cast": [{"id": 0, "name": "VERA KOSTOVA", "names": ["VERA KOSTOVA", "VERA"], "gender": "f", "first": 4, "spoke": 3}, {"id": 1, "name": "LENNOX BRADSHAW", "names": ["LENNOX BRADSHAW", "LENNOX"], "gender": "m", "first": 5, "spoke": 2}, {"id": 2, "name": "DMITRI SOKOLOV", "names": ["DMITRI SOKOLOV", "DMITRI"], "gender": "?", "first": 6, "spoke": 1}, {"id": 3, "name": "QUINN", "names": ["QUINN"], "gender": "?", "first": 7, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT TRAIN DINING CAR - MOVING", "present": []}, {"u": 1, "kind": "action", "text": "Candlelit tables, white cloths, silver trays.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rain streaks the black windows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The car sways.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "VERA KOSTOVA, 40s, in a charcoal suit, stirs her tea with unnatural calm.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across the aisle, LENNOX BRADSHAW, 50s, drums fingers on his knife.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Two tables away, DMITRI SOKOLOV, 30s, bulky in a fur-collared coat, studies the menu.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "A waitress carrying a tray: QUINN, 20s, red-haired, black apron, noticing everything.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "She sets the tray down at Vera's table.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Their eyes meet.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Quinn straightens a napkin that doesn't need straightening.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Anything else, ma'am?", "name": "QUINN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Just the check.", "name": "VERA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "The check, please.", "name": "LENNOX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Of course, sir.", "name": "QUINN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Neither woman moves.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Dmitri closes the menu, slides one hand beneath the table.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Vera's fingers tighten around the spoon.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "The train hits a switch.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "The car lurches.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "A glass tips, shatters on the floor.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Everyone looks down, then up.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Quinn is already gone.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Dmitri lifts a silenced pistol onto the cloth.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Lennox lifts a revolver from his coat.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Vera lifts nothing, but she has risen, spoon in hand, between the two of them.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Gentlemen.", "name": "VERA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Vera.", "name": "DMITRI", "speaker": 2, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Move, Vera.", "name": "LENNOX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Not a chance.", "name": "VERA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "He fires.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "She falls sideways.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "The candle goes out.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}]}