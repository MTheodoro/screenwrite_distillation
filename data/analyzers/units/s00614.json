{"scene_id": "s00614", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00614.fountain", "heading": "INT. GRANDMOTHER'S PORCH - EVENING", "cast": [{"id": 0, "name": "NANA", "names": ["NANA"], "gender": "f", "first": 5, "spoke": 8}, {"id": 1, "name": "OTIS", "names": ["OTIS"], "gender": "m", "first": 6, "spoke": 6}, {"id": 2, "name": "LUCINDA", "names": ["LUCINDA"], "gender": "m", "first": 7, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRANDMOTHER'S PORCH - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Screen door.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wicker chairs with faded cushions.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A pitcher of lemonade sweating on a card table.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Cicadas.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "NANA, 80, in a floral housedress and slippers, snaps green beans into a bowl.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "OTIS, 17, in a graduation gown, sits sprawled on the steps, tie loose, cap in his lap.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "LUCINDA, 16, his sister, in a satin prom dress and sneakers, leans on the porch rail, swinging one foot.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Nobody says anything about the empty chair.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Nana snaps a bean.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Otis peels the gold tassel off his cap.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Lucinda crosses to the card table, pours three glasses, and places one in front of the empty chair without comment.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Nana, you didn't have to come to the ceremony.", "name": "OTIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "I'm not dead yet.", "name": "NANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I know. But the bus is long.", "name": "OTIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "So is the road to Heaven.", "name": "NANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Drink.", "name": "LUCINDA", "speaker": 2, "ext": [], "paren": ["setting a glass in Nana's hand"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I'll drink when I'm done.", "name": "NANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "You're done.", "name": "LUCINDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Nana looks at the bowl.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Looks at her granddaughter.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Takes the glass.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "A car passes slowly on the road.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Headlights sweep the porch.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Otis turns his head to follow it, and Lucinda glances at the empty chair, and Nana keeps her eyes on the beans, and the car drives on, and the dust it raised settles slowly in the porch light.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "He said he'd be here.", "name": "OTIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "He said a lot of things.", "name": "NANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "He sent a card.", "name": "LUCINDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "A card isn't a person.", "name": "OTIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "It's better than nothing.", "name": "LUCINDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Is it?", "name": "OTIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Lucinda doesn't answer.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "She lifts the glass from the empty chair and drinks it herself.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Otis watches her.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "A cicada rasps, falls silent, rasps again.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Otis, come here.", "name": "NANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "He climbs the steps, kneels beside her chair.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "She puts her knotted hand on his head, over the hair he has cut short for the occasion.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "You walked across that stage like you owned it.", "name": "NANA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "I tripped.", "name": "OTIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "You recovered.", "name": "NANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "He laughs into her knee.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Lucinda looks away, out at the dark yard, the fireflies rising from the grass.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Lucinda. You too.", "name": "NANA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Lucinda hesitates.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Then crosses, sits on the other side, leans her head against Nana's shoulder.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Nana puts down the bowl and takes them both in, one in each arm, as she has done since they were babies.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "The empty chair stays empty.", "para": 9, "sent": 3, "present": [0, 1, 2]}]}