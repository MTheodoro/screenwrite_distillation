{"scene_id": "s00615", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00615.fountain", "heading": "INT. COACHING INN - COMMON ROOM - NIGHT (1815)", "cast": [{"id": 0, "name": "PETTIGREW", "names": ["PETTIGREW"], "gender": "f", "first": 4, "spoke": 2}, {"id": 1, "name": "CRABTREE", "names": ["CRABTREE"], "gender": "m", "first": 5, "spoke": 2}, {"id": 2, "name": "GOODY VANE", "names": ["GOODY VANE", "VANE"], "gender": "f", "first": 6, "spoke": 2}, {"id": 3, "name": "SOLDIER", "names": ["SOLDIER"], "gender": "m", "first": 7, "spoke": 3}, {"id": 4, "name": "ELIJAH", "names": ["ELIJAH"], "gender": "?", "first": 19, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. COACHING INN - COMMON ROOM - NIGHT (1815)", "present": []}, {"u": 1, "kind": "action", "text": "Low beams.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A roaring fire.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Pewter mugs, wet cloaks steaming on pegs.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MRS. PETTIGREW, 50s, the innkeeper, wipes the counter with her apron.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "MR. CRABTREE, 60s, a stout merchant, snores in the corner settle, his hat over his face.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "GOODY VANE, 70s, shawled, sips a thin soup.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "A SOLDIER in a mud-caked red coat sits by the fire with his boots off, staring into the flames, one arm bandaged to the elbow.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "More ale, sir?", "name": "PETTIGREW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Please.", "name": "SOLDIER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "She pours.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "He drinks in one gulp.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "They say Bonaparte's loose again.", "name": "VANE", "speaker": 2, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "They always say that.", "name": "CRABTREE", "speaker": 1, "ext": [], "paren": ["waking, muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Hush, both of you. The man is tired.", "name": "PETTIGREW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "I am. But I'll answer.", "name": "SOLDIER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "He stands.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "The room goes quiet.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "The fire pops.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "My name is Elijah Rowe. Sergeant, Thirty-third Foot. I walked from Brussels in four days.", "name": "SOLDIER", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Brussels?", "name": "VANE", "speaker": 2, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Yes, mother. And I will tell you one thing true. The Emperor is not loose. He is beaten.", "name": "ELIJAH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Beaten?", "name": "CRABTREE", "speaker": 1, "ext": [], "paren": ["sitting up, awed"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "At a place called Waterloo. Yesterday.", "name": "ELIJAH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "The room breathes out all at once.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Pettigrew crosses herself.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Vane lets her spoon fall.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Crabtree rises, takes off his hat and holds it to his chest.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "I wish it felt like a victory.", "name": "ELIJAH", "speaker": 4, "ext": ["CONT'D"], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}]}