"present": [0, 1]}, {"u": 11, "kind": "action", "text": "MEI-LING CHOW, 12, tiny, squints at a distant target through huge round glasses.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "DARIUS WELLS, 14, in a Lakers jersey, sulks.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "ROXY MARCH, 13, spikes of dyed purple hair, polishes an arrow on her shirt.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "WALDO PRESTON, 12, plump, hugs his bow to his chest like a teddy bear.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Where's Counselor Dave?", "name": "BIRDIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Probably asleep.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Probably dead.", "name": "DARIUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "He's not dead.", "name": "MEI-LING", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "How do you know?", "name": "ROXY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "I saw him at breakfast.", "name": "MEI-LING", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "He ate seven pancakes.", "name": "WALDO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Then he's asleep.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Should we start without him?", "name": "BIRDIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "I'm not getting killed by a rogue arrow.", "name": "DARIUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "You're more likely to get killed by Waldo's cooking.", "name": "ROXY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "That's not fair.", "name": "WALDO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "It's also not wrong.", "name": "ROXY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Mei-Ling raises her bow.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Squints.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Lets go.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "The arrow wobbles, lands in the grass ten feet short.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Oops.", "name": "MEI-LING", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "That's one way to do it.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "It's practice.", "name": "MEI-LING", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Okay. Everybody. Same time. On three.", "name": "BIRDIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "One.", "name": "DARIUS", "speaker": 3, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Two.", "name": "ROXY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Three!", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Six arrows fly.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Five hit the bale.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "One, Waldo's, thuds into the earth between Felix's boots.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Hey!", "name": "FELIX", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "Sorry!", "name": "WALDO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Everyone laughs.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Waldo hugs his bow tighter, red to the ears.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "A bell clangs from the mess hall.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "They lower their bows in unison.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}]}