{"scene_id": "s00617", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00617.fountain", "heading": "INT. DEEP-CRUST MINING STATION \"OROPESA\" - CONTROL ROOM - SHIFT CHANGE", "cast": [{"id": 0, "name": "OKSANA PETRENKO", "names": ["OKSANA PETRENKO", "OKSANA"], "gender": "f", "first": 5, "spoke": 12}, {"id": 1, "name": "BRAM VOLKOV", "names": ["BRAM VOLKOV", "BRAM"], "gender": "?", "first": 6, "spoke": 7}, {"id": 2, "name": "TAVITA FONOTI", "names": ["TAVITA FONOTI", "TAVITA"], "gender": "m", "first": 7, "spoke": 6}, {"id": 3, "name": "JOSIE AMARU", "names": ["JOSIE AMARU", "JOSIE"], "gender": "f", "first": 8, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. DEEP-CRUST MINING STATION \"OROPESA\" - CONTROL ROOM - SHIFT CHANGE", "present": []}, {"u": 1, "kind": "action", "text": "Low steel ceiling.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Banks of amber monitors, each showing a different tunnel.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Condensation drips from the pipes.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A heavy vibration runs through the floor, steady as a heartbeat.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "OKSANA PETRENKO, 40s, shift supervisor, stands at the central console, headset pushed down around her neck, tracking the cursor across a seismic readout that is steadily, quietly climbing.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "BRAM VOLKOV, 30s, her second, leans on the next desk, a mug of chicory in one hand.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "TAVITA FONOTI, 30s, a Samoan drill foreman, rests his weight against the door frame, still in his hard hat and orange vest, covered in grey rock dust.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "JOSIE AMARU, 20s, a trainee, sits at a minor station in the corner, eyes huge, hands flat on her knees.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Bram. Look at tunnel four.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "I'm looking.", "name": "BRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Is that normal?", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "No.", "name": "BRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "It's moving.", "name": "TAVITA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "The tunnel?", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "The wall.", "name": "TAVITA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "He crosses and leans over Bram's shoulder.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "On the monitor, a grey seam of rock ripples gently, as if breathing.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Bram sets down his mug.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Oksana adjusts the zoom.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Josie rises half out of her chair.", "para": 2, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Ma'am, should I call it in?", "name": "JOSIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Not yet.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "It's been moving for six minutes.", "name": "JOSIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "I know.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Oksana, if it's a fault line, we evacuate.", "name": "BRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "It's not a fault line.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Then what is it?", "name": "TAVITA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "I don't know.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "A deep, wet crack runs through the walls of the room.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Everyone freezes.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "The condensation drips faster.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "On the monitors, all six tunnel cameras show the same thing now: the rock seams opening, widening, a pale light pulsing behind them.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "That's not in the survey.", "name": "TAVITA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Nothing's in the survey.", "name": "BRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "All crews, this is control. Drop tools. Report to Lock Two. Repeat, drop tools and report to Lock Two.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": ["into the headset"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "No response but static.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "She tries again.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Bram grabs a second headset and flips switches.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Tavita grips the door frame with both hands as the vibration climbs in pitch.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Josie stands, shaky, and takes the emergency alarm cover in one trembling hand.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Ma'am?", "name": "JOSIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Pull it.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Josie flips the cover and presses the button.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "The siren shrieks.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Red light floods the room.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "The four of them stand motionless in the strobe, hearing the walls speak.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "He's right. It's breathing.", "name": "BRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Who's he?", "name": "TAVITA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "The rock.", "name": "BRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "On the central monitor, the seam splits wide.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "The pale light blooms.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "For one frozen second, the feed shows a vast, bright cavern beyond the tunnel, ribbed and glittering, stretching into the dark below the world.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Then the camera goes dead.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "One by one, the others follow.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Silence.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "The siren stops, mid-wail.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "The red lights hold.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "Everybody listen to me.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": ["very quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "They look at her.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "She takes a breath.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "Nobody goes down. Nobody. We seal the lifts, we flood the shafts, we get every person on this station topside and we stay topside until I say.", "name": "OKSANA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "They'll fire you.", "name": "TAVITA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "Let them.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "Oksana. What if they're already down there?", "name": "BRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "She doesn't answer.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "Her hand finds the lift control.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "Her thumb rests on the red cover.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "Behind them, the floor shudders again, gently, like something far below turning over in its sleep.", "para": 10, "sent": 3, "present": [0, 1, 2, 3]}]}