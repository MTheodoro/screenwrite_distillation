{"scene_id": "s00618", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00618.fountain", "heading": "EXT. FOXHOLE LINE - ARDENNES FOREST - DAWN (1944)", "cast": [{"id": 0, "name": "MORGENSTERN", "names": ["MORGENSTERN"], "gender": "m", "first": 6, "spoke": 9}, {"id": 1, "name": "WU", "names": ["WU"], "gender": "m", "first": 8, "spoke": 4}, {"id": 2, "name": "FAIRCHILD", "names": ["FAIRCHILD"], "gender": "?", "first": 9, "spoke": 6}, {"id": 3, "name": "BEAUMONT", "names": ["BEAUMONT"], "gender": "m", "first": 11, "spoke": 2}, {"id": 4, "name": "TSOSIE", "names": ["TSOSIE"], "gender": "?", "first": 13, "spoke": 3}, {"id": 5, "name": "DOC KOWALSKI", "names": ["DOC KOWALSKI", "KOWALSKI"], "gender": "?", "first": 14, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FOXHOLE LINE - ARDENNES FOREST - DAWN (1944)", "present": []}, {"u": 1, "kind": "action", "text": "Snow.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Frozen trees.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Breath hanging in the air.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A row of hastily dug holes, sandbag-lipped, branches over the top.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Smoke rises from a tin can fire hidden in a pit.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "SGT. MORGENSTERN, 40s, a rangy Wisconsin man with an icicle in his mustache, crouches over the fire, warming his hands.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "CPL.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "WU, 20s, scratching at a frostbitten ear, sits on an ammo box.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "LT. FAIRCHILD, 20s, fresh-faced, in a clean helmet, studies a map with a pencil.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "PVT.", "para": 1, "sent": 4, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "BEAUMONT, 19, hugging his rifle, shifts from foot to foot.", "para": 1, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "PVT.", "para": 1, "sent": 6, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "TSOSIE, 22, a Navajo man, crouches at the tree line watching the fog.", "para": 1, "sent": 7, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "DOC KOWALSKI, 30s, rummages in a bag, producing a tin of cold coffee.", "para": 1, "sent": 8, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Sergeant, how much longer?", "name": "FAIRCHILD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Till what, sir?", "name": "MORGENSTERN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Till we move.", "name": "FAIRCHILD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Till they tell us.", "name": "MORGENSTERN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "And when's that?", "name": "FAIRCHILD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Hell if I know.", "name": "MORGENSTERN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Everybody asks the same question.", "name": "WU", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Is it quiet because they're gone?", "name": "BEAUMONT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "No.", "name": "TSOSIE", "speaker": 4, "ext": [], "paren": ["without turning"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "How do you know?", "name": "BEAUMONT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "The birds. There aren't any.", "name": "TSOSIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Coffee, anyone?", "name": "KOWALSKI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "He hands out cups.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Each man takes one in silence.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Wu sips and winces.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "This is awful.", "name": "WU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "It's hot.", "name": "KOWALSKI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Hot isn't a flavor, Doc.", "name": "WU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Eat. Drink. Rest. Because soon we won't.", "name": "MORGENSTERN", "speaker": 0, "ext": [], "paren": ["to the group"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Sergeant.", "name": "FAIRCHILD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Lieutenant.", "name": "MORGENSTERN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Are we going to be all right?", "name": "FAIRCHILD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Sir, I've been asked that nine hundred times, and I've never once lied.", "name": "MORGENSTERN", "speaker": 0, "ext": [], "paren": ["a long pause, then"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "That's not an answer.", "name": "FAIRCHILD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "It's the best one I've got.", "name": "MORGENSTERN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Beaumont drains his cup, stares at the bottom of it.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Tsosie, still at the tree line, raises two fingers without looking back.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Quiet. Something's moving.", "name": "TSOSIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "They all freeze.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Morgenstern is on his feet before the word finishes.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Fairchild crouches.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Wu snatches his rifle.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "Kowalski drops the coffee tin.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "A deer steps out of the fog.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "It looks at them with huge, calm, dark eyes.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "Then it turns and walks, unhurried, back into the trees.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "No one speaks.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "Then Beaumont laughs, a single sharp breath, and Wu joins, and one by one they lower their weapons, until even Tsosie smiles faintly at the snow.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "Damn, that's a good-looking buck.", "name": "MORGENSTERN", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "Don't even think about it, Sarge.", "name": "WU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "I'm thinking about venison stew.", "name": "MORGENSTERN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "The fire crackles.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "Snow begins to fall.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}