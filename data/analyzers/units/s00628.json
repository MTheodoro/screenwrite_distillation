{"scene_id": "s00628", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00628.fountain", "heading": "INT. LAUNDROMAT - NIGHT", "cast": [{"id": 0, "name": "MARISOL", "names": ["MARISOL"], "gender": "?", "first": 8, "spoke": 2}, {"id": 1, "name": "DESMOND", "names": ["DESMOND"], "gender": "?", "first": 10, "spoke": 2}, {"id": 2, "name": "JUNIOR", "names": ["JUNIOR"], "gender": "?", "first": 12, "spoke": 1}, {"id": 3, "name": "TAMSIN", "names": ["TAMSIN"], "gender": "?", "first": 14, "spoke": 2}, {"id": 4, "name": "CONCEPCI\u00d3N", "names": ["CONCEPCI\u00d3N"], "gender": "?", "first": 6, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAUNDROMAT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dryers turning.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fluorescent hum.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A broken vending machine.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Five Hargrove-Delgados.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "One bench.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "GRANDMA CONCEPCI\u00d3N, eighties, folds towels.", "para": 2, "sent": 0, "present": [4]}, {"u": 7, "kind": "action", "text": "Slow.", "para": 2, "sent": 1, "present": [4]}, {"u": 8, "kind": "action", "text": "Her daughter, MARISOL, fifties, scrolls her phone.", "para": 3, "sent": 0, "present": [0, 4]}, {"u": 9, "kind": "action", "text": "Doesn't read it.", "para": 3, "sent": 1, "present": [0, 4]}, {"u": 10, "kind": "action", "text": "MARISOL's husband, DESMOND, sixties, reads a newspaper upside down.", "para": 4, "sent": 0, "present": [0, 1, 4]}, {"u": 11, "kind": "action", "text": "Maybe on purpose.", "para": 4, "sent": 1, "present": [0, 1, 4]}, {"u": 12, "kind": "action", "text": "Their son, JUNIOR, twenty, headphones.", "para": 5, "sent": 0, "present": [0, 1, 2, 4]}, {"u": 13, "kind": "action", "text": "Elsewhere.", "para": 5, "sent": 1, "present": [0, 1, 2, 4]}, {"u": 14, "kind": "action", "text": "Their niece, TAMSIN, nine, counts quarters.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Arranges them.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Rearranges them.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Almost done. Nobody move.", "name": "CONCEPCI\u00d3N", "speaker": 4, "ext": [], "paren": ["to everyone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Nobody's moving, Abuela.", "name": "JUNIOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Junior. Take those off.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "He doesn't.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "She sighs and goes back to her phone.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Forty minutes for two towels.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Uncle Des, you're holding it wrong.", "name": "TAMSIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "It's fine.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "She takes it from him, turns it right side up.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "He nods, gravely.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Tamsin, mija, how many?", "name": "CONCEPCI\u00d3N", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Eleven.", "name": "TAMSIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "We need twelve.", "name": "CONCEPCI\u00d3N", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "A pause.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "They all look at the machine.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "It hums back.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "We always need twelve.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": ["to no one"], "dual": false, "present": [0, 1, 2, 3, 4]}]}