{"scene_id": "s00629", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00629.fountain", "heading": "INT. HOSPICE WING - NIGHT SHIFT NURSES' STATION", "cast": [{"id": 0, "name": "GRACE", "names": ["GRACE"], "gender": "f", "first": 5, "spoke": 10}, {"id": 1, "name": "ADEYEMI", "names": ["ADEYEMI"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "DEVON MARSH", "names": ["DEVON MARSH", "DEVON"], "gender": "m", "first": 6, "spoke": 6}, {"id": 3, "name": "INTERCOM", "names": ["INTERCOM"], "gender": "?", "first": 7, "spoke": 2}, {"id": 4, "name": "DOREEN", "names": ["DOREEN"], "gender": "?", "first": 8, "spoke": 1}, {"id": 5, "name": "LEONIDAS MARSH", "names": ["LEONIDAS MARSH"], "gender": "?", "first": 6, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOSPICE WING - NIGHT SHIFT NURSES' STATION", "present": []}, {"u": 1, "kind": "action", "text": "Low light.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Quiet monitors.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A call button blinks red on a wall panel.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Somewhere down the hall, a television murmurs a game show to nobody.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "GRACELYN \"GRACE\" ADEYEMI, fifties, charge nurse, signs a chart and doesn't look at her visitor.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "DEVON MARSH, thirties, the patient's son, stands at the counter in a rumpled suit, a paper cup of cold coffee in his hand.", "para": 1, "sent": 1, "present": [0, 1, 2, 5]}, {"u": 7, "kind": "dialogue", "text": "Station, room fourteen. Mr. Marsh is asking for his son again.", "name": "INTERCOM", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5]}, {"u": 8, "kind": "dialogue", "text": "On my way, Doreen.", "name": "GRACE", "speaker": 0, "ext": [], "paren": ["into the panel"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "action", "text": "She lifts a finger to Devon.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "He doesn't move.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "He keeps calling me Walter.", "name": "DEVON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "That's his brother. Passed in '98.", "name": "GRACE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "I know who Walter is.", "name": "DEVON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Then you know it's not an insult.", "name": "GRACE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Devon puts down the cup.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "His hand shakes slightly.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Grace, I'm not ready for this.", "name": "DEVON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Nobody is, Devon. We just show up.", "name": "GRACE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Grace. He's asking for the window open.", "name": "INTERCOM", "speaker": 3, "ext": ["V.O."], "paren": ["softer"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Open it, Doreen. Let him have the air.", "name": "GRACE", "speaker": 0, "ext": [], "paren": ["into the panel"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "She turns back to Devon.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Go. Say you're Walter if you have to.", "name": "GRACE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "He'd know.", "name": "DEVON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "He'd know and he'd want it anyway.", "name": "GRACE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "A long breath.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Devon straightens his tie, then loosens it again.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "You've done this a lot.", "name": "DEVON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Thirty-one years.", "name": "GRACE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Does it get easier?", "name": "DEVON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "No. You get kinder.", "name": "GRACE", "speaker": 0, "ext": [], "paren": ["gently"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "He nods.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "He goes.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "She watches him go down the hall until the dark takes his shoulders.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Grace? He's saying hello to somebody.", "name": "DOREEN", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Good.", "name": "GRACE", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Walter? Is that you, Walter?", "name": "LEONIDAS MARSH", "speaker": 5, "ext": ["O.S."], "paren": ["faint, delighted"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Grace closes her eyes a moment.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "She picks up the pen and writes the time.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}