{"scene_id": "s00631", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00631.fountain", "heading": "INT. SHIPPING CONTAINER ON DRIFTING ICE FLOE - DAY", "cast": [{"id": 0, "name": "HALVOR NILSEN", "names": ["HALVOR NILSEN", "HALVOR"], "gender": "?", "first": 4, "spoke": 8}, {"id": 1, "name": "DEE ARMSTRONG", "names": ["DEE ARMSTRONG", "DEE"], "gender": "?", "first": 5, "spoke": 7}, {"id": 2, "name": "PASHA VOLKOV", "names": ["PASHA VOLKOV", "PASHA"], "gender": "m", "first": 6, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. SHIPPING CONTAINER ON DRIFTING ICE FLOE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Gray light through a rust hole.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Three bedrolls, a camp stove, a radio with its back off.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Stillness, finally.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "HALVOR NILSEN, 50s, sits on an overturned bucket.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "DEE ARMSTRONG, 30s, tends the stove.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "PASHA VOLKOV, 20s, lies on a bedroll, eyes closed, a dark stain on his sleeve.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "The wind's dropped.", "name": "HALVOR", "speaker": 0, "ext": [], "paren": ["to the container"], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Finally.", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Tell me it's warm out there.", "name": "PASHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "It's not warm. It's quiet.", "name": "HALVOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Quiet's the same as warm, right now.", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Dee, did you boil the rest of the coffee?", "name": "PASHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "I boiled all of it. We're out.", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Out of coffee.", "name": "PASHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Out of coffee.", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Out of coffee, out of fuel in two days, out of floe in three.", "name": "HALVOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Halvor.", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "I'm just saying the weather's good for talking.", "name": "HALVOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Then talk.", "name": "PASHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "The floe split in the night. The crack's under the east wall. I heard it.", "name": "HALVOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "You said the wind --", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "The wind dropped. The ice didn't.", "name": "HALVOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "How long?", "name": "PASHA", "speaker": 2, "ext": [], "paren": ["very quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Hours. Maybe less.", "name": "HALVOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Of course it did.", "name": "DEE", "speaker": 1, "ext": [], "paren": ["to no one"], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Open the door, Halvor.", "name": "PASHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Pasha --", "name": "HALVOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "I want to see it.", "name": "PASHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Halvor stands.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "The container groans, a long slow note like a cello, and the three of them look at the floor.", "para": 2, "sent": 1, "present": [0, 1, 2]}]}