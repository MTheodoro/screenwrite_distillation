{"scene_id": "s00633", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00633.fountain", "heading": "INT. FERRY GALLEY KITCHEN - EVENING", "cast": [{"id": 0, "name": "PHILOMENA OKAFOR-BRANDT", "names": ["PHILOMENA OKAFOR-BRANDT", "PHILOMENA"], "gender": "?", "first": 3, "spoke": 7}, {"id": 1, "name": "YOUNG MAN", "names": ["YOUNG MAN"], "gender": "m", "first": 4, "spoke": 3}, {"id": 2, "name": "LEO", "names": ["LEO"], "gender": "?", "first": 16, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. FERRY GALLEY KITCHEN - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "A steel counter, a rattling stockpot, windows fogged by the steam.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The boat rolls gently.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "PHILOMENA OKAFOR-BRANDT, seventies, the ferry's cook, stirs without looking.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "A YOUNG MAN, twenties, stands at the galley door, soaked, holding a small suitcase against his chest.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "We're closed to the public.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "I'm not the public.", "name": "YOUNG MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "She turns.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She sees his face.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "The ladle stays in her hand, dripping.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "You have your father's jaw.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "That's what Mum said.", "name": "YOUNG MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Sit.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He does.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She ladles soup into a mug and sets it before him, her hand trembling for an instant over the rim.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Name.", "name": "PHILOMENA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Leo.", "name": "YOUNG MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Leopold.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Leo.", "name": "LEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I was going to say it's a fine name.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": ["over him"], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "You didn't know I existed.", "name": "LEO", "speaker": 2, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "I knew every day.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "They both stop.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "They both stare into the soup.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The ferry's horn sounds, low and long, and the cups on the shelf chime against their hooks.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Leo takes up the spoon, and Philomena sits down across from him at last.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Their hands meet on the counter, and neither moves away.", "para": 5, "sent": 1, "present": [0, 1, 2]}]}