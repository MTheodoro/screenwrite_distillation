{"scene_id": "s00634", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00634.fountain", "heading": "INT. PLANETARIUM DOME, CITY SCIENCE MUSEUM - NIGHT", "cast": [{"id": 0, "name": "TOMASZ KR", "names": ["TOMASZ KR", "TOMASZ"], "gender": "?", "first": 6, "spoke": 12}, {"id": 1, "name": "KROL", "names": ["KROL"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "ADAORA NWOSU", "names": ["ADAORA NWOSU", "ADAORA"], "gender": "f", "first": 9, "spoke": 8}, {"id": 3, "name": "DEZ", "names": ["DEZ"], "gender": "m", "first": 11, "spoke": 6}, {"id": 4, "name": "HARTIGAN", "names": ["HARTIGAN"], "gender": "?", "first": 11, "spoke": 0}, {"id": 5, "name": "LUCINDA VASQUEZ-WILDE", "names": ["LUCINDA VASQUEZ-WILDE", "LUCINDA"], "gender": "?", "first": 12, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. PLANETARIUM DOME, CITY SCIENCE MUSEUM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A hemisphere of dark.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of reclined seats in concentric rings.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "At the center, the projector: a black iron dumbbell on a pedestal, gleaming.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Stars drift overhead, paused at midsummer.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The only other light is the emergency green over the exit.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "TOMASZ KR\u00d3L, fifties, in a security guard's jacket, a name tag reading T. KROL, stands at the dome's rim with a flashlight he isn't using.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "The projector's access hatch is open.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Inside, a woman's legs.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Then the rest of her: ADAORA NWOSU, forties, a technician's harness, clipboards of schematics.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "She is hanging from the dome's catwalk by two cables, laying a case onto a cart.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "DESHAWN \"DEZ\" HARTIGAN, thirties, in a docent's blazer, watches from the front row with his arms folded.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "LUCINDA VASQUEZ-WILDE, sixties, silver bob, pearl earrings, stands at the aisle, one hand resting on the back of a seat.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "She looks like she owns the dome.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "Perhaps she does.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Time check.", "name": "TOMASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Eleven fifty-two. Rounds at twelve fifteen.", "name": "DEZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "I need the lens case.", "name": "ADAORA", "speaker": 2, "ext": [], "paren": ["from the catwalk"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "It's by your left hand.", "name": "LUCINDA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "My left's holding a cable.", "name": "ADAORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Then use the right.", "name": "LUCINDA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Adaora does.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "She slides the case across and catches it.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Her wrist wobbles.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Dez rises half an inch from the seat, then sits again.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Easy.", "name": "DEZ", "speaker": 3, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "You said the lens was in the base.", "name": "TOMASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "It was in the base.", "name": "ADAORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "It's in the housing.", "name": "TOMASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Then it moved.", "name": "ADAORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Lenses don't move.", "name": "TOMASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "This one does.", "name": "LUCINDA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Tomasz turns the flashlight on at last.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "He sweeps it across the faces in the dark, one by one.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "They don't blink.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "How many people know it moved?", "name": "TOMASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Us.", "name": "DEZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "And the man who moved it.", "name": "TOMASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Whom you've never met.", "name": "LUCINDA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Yes I have.", "name": "TOMASZ", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "The stars hang overhead, patient as an audience.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Tomasz.", "name": "ADAORA", "speaker": 2, "ext": [], "paren": ["from above"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "Not now.", "name": "TOMASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Tomasz --", "name": "ADAORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "I said not now.", "name": "TOMASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "He lowers the light.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "Dez picks at a thread on his sleeve.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "Lucinda doesn't move.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "Whatever happens at twelve fifteen, I don't want to hear a word of it after.", "name": "TOMASZ", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "Understood.", "name": "DEZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "Naturally.", "name": "LUCINDA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "Understood.", "name": "ADAORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "He nods.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "He crosses the aisle.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "He looks up at the projector, at the delicate, oiled, indifferent machine, and puts his hand flat against its cold side as if feeling for a pulse.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "Thirty years.", "name": "TOMASZ", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "Dez stands.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "He walks to the aisle and stops beside Lucinda.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "She does not look at him.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "He's going to see it, you know. The last frame.", "name": "DEZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "dialogue", "text": "He already has.", "name": "LUCINDA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "Adaora lowers herself from the catwalk onto the stage, her boots clicking on the floor.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "She holds the lens case in both hands, the way you'd hold a sleeping child.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "dialogue", "text": "It's good. It's the real one.", "name": "ADAORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "dialogue", "text": "Of course it is.", "name": "LUCINDA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "action", "text": "Dez glances at his watch.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "dialogue", "text": "Eleven fifty-nine.", "name": "DEZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "action", "text": "Tomasz turns off the flashlight.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "action", "text": "The dome goes dark except for the green glow at the exit and the slow-turning stars.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "dialogue", "text": "Let's go.", "name": "TOMASZ", "speaker": 0, "ext": [], "paren": ["very low"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "action", "text": "They move.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "action", "text": "Not in a group, but each one separately, in a loose line along the aisle toward the exit, their footsteps muffled by the carpet.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "action", "text": "Lucinda is last.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "action", "text": "At the door, she stops.", "para": 13, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 75, "kind": "dialogue", "text": "Goodnight, old friend.", "name": "LUCINDA", "speaker": 5, "ext": [], "paren": ["to the empty dome"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 76, "kind": "action", "text": "She waits.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 77, "kind": "action", "text": "The stars shift an inch as if the dome were breathing.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 78, "kind": "action", "text": "Then she goes.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 79, "kind": "action", "text": "The projector sits alone on its pedestal, a dark dumbbell under a dead sky.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 80, "kind": "action", "text": "From the corridor, faintly, a key turns in a lock.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}