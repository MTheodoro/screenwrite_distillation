{"scene_id": "s00637", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00637.fountain", "heading": "INT. TRAVELING CINEMATOGRAPH TENT - LATE AFTERNOON", "cast": [{"id": 0, "name": "MAGDALENA PRZYBYLSKA", "names": ["MAGDALENA PRZYBYLSKA", "MAGDALENA"], "gender": "?", "first": 5, "spoke": 15}, {"id": 1, "name": "BART", "names": ["BART"], "gender": "m", "first": 9, "spoke": 11}, {"id": 2, "name": "CROWLEY", "names": ["CROWLEY"], "gender": "?", "first": 9, "spoke": 0}, {"id": 3, "name": "NICK", "names": ["NICK"], "gender": "m", "first": 13, "spoke": 5}, {"id": 4, "name": "LIPSKI", "names": ["LIPSKI"], "gender": "?", "first": 13, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. TRAVELING CINEMATOGRAPH TENT - LATE AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "1912.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A canvas tent pitched in a wheat field.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Bare benches, a sheet strung up for a screen, and sunlight leaking through the seams in thin gold blades.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Smell of hot dust and machine oil.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MAGDALENA PRZYBYLSKA, forties, hands rough as bark, a leather apron over a plain gray dress, cranks the projector at the back of the tent.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Slow.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Even.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "A woman who has done this ten thousand times.", "para": 1, "sent": 3, "present": [0]}, {"u": 9, "kind": "action", "text": "BARTHOLOMEW \"BART\" CROWLEY, fifties, thick-necked, in a checked waistcoat, paces the center aisle.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "He owns the tent.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He owns the sheet.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "He thinks he owns Magdalena.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "NIKODEM \"NICK\" LIPSKI, fifteen, thin, a cap too big for him, sits cross-legged on the front bench with a coil of film in his lap.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Doors in an hour. Not a seat taken yet.", "name": "BART", "speaker": 1, "ext": [], "paren": ["to the empty benches"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "It's harvest.", "name": "MAGDALENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Harvest is when they want a show.", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Harvest is when they want sleep.", "name": "MAGDALENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "He doesn't answer.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "He stops beside the boy and flicks the brim of his cap.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Nick. The reel.", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Mending it.", "name": "NICK", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Mend faster.", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Nick bends to his work.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Magdalena's hand keeps turning the crank.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Three towns, no profit. Three towns.", "name": "BART", "speaker": 1, "ext": ["CONT'D"], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Four, if you count the rain.", "name": "MAGDALENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "I don't count the rain.", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "You should.", "name": "MAGDALENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "The sheet stirs.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "A breeze lifts it, and a bar of light slides across the benches and falls across Nick's face.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "He looks up, startled, then smiles at it.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Magdalena sees.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "She slows the crank a fraction.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Nikodem. Come here.", "name": "MAGDALENA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "He crosses the aisle.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "She lifts the lens cap, and the sheet fills with a dancing square of white.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Hold your hand up.", "name": "MAGDALENA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "He raises it.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "The light turns his palm to a pale map, the lines in it dark as rivers.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "That's me.", "name": "NICK", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "That's you.", "name": "MAGDALENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "What's this?", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "He has come up quietly behind them.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Magdalena doesn't turn.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Teaching.", "name": "MAGDALENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "I pay for projecting, not for teaching.", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "Then don't pay.", "name": "MAGDALENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "A long pause.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Bart's ears go red.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Nick. Back to your bench.", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Nick looks at Magdalena.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "She nods once.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "He goes.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "Don't spoil him.", "name": "BART", "speaker": 1, "ext": ["CONT'D"], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "Spoil him? He's the only one in this tent who looks at the picture.", "name": "MAGDALENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Bart opens his mouth, closes it, and picks up the tin of film from the table.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "He tosses it from hand to hand, hard enough to ring.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "Doors in forty minutes.", "name": "BART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "We'll be ready.", "name": "MAGDALENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "He leaves.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "The flap swings shut behind him.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "Magdalena exhales.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "She turns the crank again, slowly, and the white square on the sheet flickers into a picture: a train arriving at a station, small and silent and bright.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "Nick comes back and sits in the front row.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "He doesn't speak.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "dialogue", "text": "Is it real?", "name": "NICK", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "dialogue", "text": "It was. Once.", "name": "MAGDALENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "action", "text": "She keeps turning.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "The train keeps coming.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "action", "text": "In the field outside, a harvester sounds its horn, far away, and the light on the sheet pulses once in time with it.", "para": 17, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "dialogue", "text": "Magdalena. Will you teach me the crank?", "name": "NICK", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "dialogue", "text": "Not today.", "name": "MAGDALENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "dialogue", "text": "When?", "name": "NICK", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "dialogue", "text": "When he's gone.", "name": "MAGDALENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "action", "text": "He nods.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 76, "kind": "action", "text": "Neither of them looks at the door.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 77, "kind": "action", "text": "The train pulls in, and the little silent crowd on the sheet waves at nobody.", "para": 18, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 78, "kind": "action", "text": "Magdalena lets the film run out.", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 79, "kind": "action", "text": "The sheet goes white, then gray, then plain canvas again.", "para": 19, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 80, "kind": "action", "text": "She stands, rubs her shoulder, and for a moment, in the thin gold light, she looks fifteen years younger.", "para": 20, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 81, "kind": "dialogue", "text": "Doors, then.", "name": "MAGDALENA", "speaker": 0, "ext": ["CONT'D"], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3, 4]}]}