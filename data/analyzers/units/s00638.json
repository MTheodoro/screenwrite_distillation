{"scene_id": "s00638", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00638.fountain", "heading": "INT. SCHOOL BUS ON CAR FERRY - NIGHT", "cast": [{"id": 0, "name": "JUNE", "names": ["JUNE"], "gender": "?", "first": 4, "spoke": 9}, {"id": 1, "name": "OKONKWO", "names": ["OKONKWO"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "ZEKE", "names": ["ZEKE"], "gender": "?", "first": 5, "spoke": 11}, {"id": 3, "name": "MAHLANGU", "names": ["MAHLANGU"], "gender": "?", "first": 5, "spoke": 0}, {"id": 4, "name": "LOTTIE FAIRBANKS-WU", "names": ["LOTTIE FAIRBANKS-WU", "LOTTIE"], "gender": "f", "first": 6, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. SCHOOL BUS ON CAR FERRY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "The bus is parked in the belly of the ferry, engine off, rain drumming on a steel ceiling.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Yellow seats, a cracked mirror, a faint smell of wet sneakers.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Three teenagers sit in the back rows, sharing a bag of chips.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "JUNIPER \"JUNE\" OKONKWO, seventeen, braids and a borrowed varsity jacket, sits sideways in her seat.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "EZEKIEL \"ZEKE\" MAHLANGU, eighteen, tall, quiet, holds a scholarship letter folded very small.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "action", "text": "LOTTIE FAIRBANKS-WU, sixteen, the youngest, wears her dad's headphones around her neck.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "dialogue", "text": "Okay, rule: nobody lies, nobody leaves, nobody tells.", "name": "JUNE", "speaker": 0, "ext": [], "paren": ["to everyone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "We're on a boat. Where would I leave to?", "name": "LOTTIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "She's got a point.", "name": "ZEKE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Zeke. Read it.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "No.", "name": "ZEKE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "You said you would.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "I said I'd think about it.", "name": "ZEKE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Is it from the university?", "name": "LOTTIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Yes.", "name": "ZEKE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Are you going?", "name": "LOTTIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "I don't know.", "name": "ZEKE", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Zeke. Read it.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "June, it's not a big deal.", "name": "ZEKE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "It's the biggest deal.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "He unfolds the paper.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "It crackles in the quiet.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "He holds it away from his face, squints, and drops his hand.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "They gave me the full ride.", "name": "ZEKE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Lottie looks at June.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "June looks at the window.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "That's... amazing, Zeke!", "name": "LOTTIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Is it?", "name": "ZEKE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "It is.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "You don't sound like it is.", "name": "ZEKE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Because I'm not happy for you. I'm happy for me, that you got it, and I'm furious for me, that you're leaving.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Oh.", "name": "LOTTIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "June --", "name": "ZEKE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Don't. Don't say anything. I'll be fine. I'll be fine in about four years.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "She pulls her knees up.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "The ferry rolls and the bus creaks.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Lottie slowly slides over to sit between them.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "I'll write to both of you. In pen.", "name": "LOTTIE", "speaker": 4, "ext": [], "paren": ["very quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "In pen?", "name": "ZEKE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Pen is permanent.", "name": "LOTTIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "For a moment nobody moves.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Then June starts to laugh, a wet, helpless laugh, and Zeke follows, and Lottie, a beat late, joins them, and the bus rocks with it, the whole yellow tube shaking in the dark.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Okay. Okay. Chips.", "name": "JUNE", "speaker": 0, "ext": [], "paren": ["to everyone, breathless"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Lottie passes the bag.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}]}