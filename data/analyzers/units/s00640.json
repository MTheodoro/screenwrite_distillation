{"scene_id": "s00640", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00640.fountain", "heading": "INT. TAXIDERMIST'S WORKSHOP - NIGHT", "cast": [{"id": 0, "name": "SASHA", "names": ["SASHA"], "gender": "?", "first": 4, "spoke": 9}, {"id": 1, "name": "MELNYK", "names": ["MELNYK"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "RAFFI", "names": ["RAFFI"], "gender": "m", "first": 7, "spoke": 8}, {"id": 3, "name": "COSTANZA", "names": ["COSTANZA"], "gender": "?", "first": 7, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. TAXIDERMIST'S WORKSHOP - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Glass eyes in trays.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A badger on a stand.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A fox mid-leap, forever.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "OLEKSANDR \"SASHA\" MELNYK, sixties, apron stiff with old plaster.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Scalpel in hand.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Steady.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "RAFAELLA \"RAFFI\" COSTANZA, forties.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Camel coat.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Sits on a stool among the heads.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Smiling.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "You're late with the money, Sasha.", "name": "RAFFI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "I'm late with everything. Ask the owl.", "name": "SASHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "The owl isn't my problem.", "name": "RAFFI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "The owl has been my problem six weeks. Every customer wants it perfect. Nobody wants to pay for perfect.", "name": "SASHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Neither do I.", "name": "RAFFI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "I told your brother in March. I said, give me till the autumn.", "name": "SASHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "It's autumn.", "name": "RAFFI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "It's the end of autumn.", "name": "SASHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Sasha. Sasha. I like you. I like the shop. I like that nobody's been in here since Easter and the place still smells like a church.", "name": "RAFFI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "That's the formaldehyde.", "name": "SASHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "That's what I said.", "name": "RAFFI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "You want the shop? Take it. You want the badger? Take the badger. But don't stand there telling me you like me.", "name": "SASHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "I do like you.", "name": "RAFFI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Then why are you in my chair?", "name": "SASHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "She stands.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Slowly.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Pulls a long glass jar from the shelf and weighs it in her palm.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Sasha lifts the scalpel an inch.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Put it down.", "name": "RAFFI", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "You put it down.", "name": "SASHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "The jar flies.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Sasha ducks.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Glass bursts on the badger.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Raffi lunges across the bench and they crash into the shelves.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Eyes spill across the floor, hundreds of them, rolling.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Raffi pins his wrist.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "He drives a knee into her ribs.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "She gasps.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "The scalpel skitters away under the fox.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "They stop.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Both breathing hard.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Both looking at the dozens of little glass eyes staring up from the floor.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Now you've made a mess.", "name": "SASHA", "speaker": 0, "ext": ["CONT'D"], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3]}]}