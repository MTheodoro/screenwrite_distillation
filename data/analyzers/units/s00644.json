{"scene_id": "s00644", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00644.fountain", "heading": "INT. GARAGE CANNING KITCHEN - AFTERNOON", "cast": [{"id": 0, "name": "FITZ", "names": ["FITZ"], "gender": "?", "first": 5, "spoke": 4}, {"id": 1, "name": "MULLIGAN", "names": ["MULLIGAN"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "SIOBHAN", "names": ["SIOBHAN"], "gender": "?", "first": 6, "spoke": 4}, {"id": 3, "name": "ROXANNE", "names": ["ROXANNE"], "gender": "?", "first": 6, "spoke": 3}, {"id": 4, "name": "KAI", "names": ["KAI"], "gender": "?", "first": 7, "spoke": 1}, {"id": 5, "name": "BEATA", "names": ["BEATA"], "gender": "?", "first": 7, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. GARAGE CANNING KITCHEN - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Steam, vinegar, dill.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Two folding tables of jars.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A burner humming under a tall pot.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The garage door is open on a sunny cul-de-sac.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "FITZGERALD \"FITZ\" MULLIGAN, seventies, stirs the brine with a wooden paddle.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "His daughters, SIOBHAN, fifties, and ROXANNE, forties, work the packing line, and neither has looked at the other in an hour.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "Two grandchildren hover: KAI, twelve, with a stack of lids, and BEATA, nine, with a roll of labels.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "dialogue", "text": "Dad, the salt's wrong.", "name": "SIOBHAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "It's fine.", "name": "ROXANNE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "It's too much, Rox.", "name": "SIOBHAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "It's been this recipe since 1971.", "name": "FITZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Siobhan counts every grain like it's evidence.", "name": "ROXANNE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Because someone has to!", "name": "SIOBHAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Can I put the lids on?", "name": "KAI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "I'm doing the labels, Kai.", "name": "BEATA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Everyone do their own thing.", "name": "FITZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Dad, you always say that!", "name": "SIOBHAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Roxanne drops a jar.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "It shatters.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Pickles skid across the floor.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Kai freezes, Beata squeals, Siobhan lunges to stop the brine from spilling, Fitz sets down the paddle and turns off the burner.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "That's enough. Everybody out.", "name": "FITZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Dad --", "name": "ROXANNE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Out. I'll finish.", "name": "FITZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "They leave, one by one.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "He sits on an overturned crate among the pickles and, very quietly, begins to laugh.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}