{"scene_id": "s00646", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00646.fountain", "heading": "EXT. LAKE - FOG - DAWN", "cast": [{"id": 0, "name": "KIRSTEN BLOMQVIST", "names": ["KIRSTEN BLOMQVIST", "KIRSTEN"], "gender": "?", "first": 5, "spoke": 3}, {"id": 1, "name": "RAJESH IYER", "names": ["RAJESH IYER", "RAJESH"], "gender": "?", "first": 6, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. LAKE - FOG - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A rowboat adrift on gray water.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "No shore in any direction.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The oars lie shipped.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A lantern burns without need of light.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "KIRSTEN BLOMQVIST, forties, sits at the stern, wrapped in a blanket, eyes fixed on a fixed point in the mist.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "RAJESH IYER, fifties, her husband, sits at the bow with a thermos between his knees.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "They have not spoken in an hour.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He unscrews the cap.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He pours half into the lid, passes it back along the boat without a word.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She takes it.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She drinks.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She returns it.", "para": 2, "sent": 4, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He sets the lid on the thwart.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He studies the water.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Did you hear something?", "name": "RAJESH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "No.", "name": "KIRSTEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "There was a bell.", "name": "RAJESH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "There's no bell.", "name": "KIRSTEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He listens.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "The fog presses in.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She pulls the blanket tighter and looks at his hands, which are shaking, and then at her own, which are not.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "She reaches under the seat.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She finds the second thermos.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She sets it on the bench between them, unopened.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "We'll want that later.", "name": "RAJESH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Yes.", "name": "KIRSTEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "He nods.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "She nods.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "They both look out at the gray.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Far off, faint, one clear note.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "A bell.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Neither of them turns.", "para": 8, "sent": 0, "present": [0, 1]}]}