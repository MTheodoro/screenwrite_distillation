, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "I pressed it.", "name": "RUFUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Again.", "name": "BRYNJA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "He does.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Nothing.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "The light flickers.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Hello? Is someone in the car?", "name": "INTERCOM", "speaker": 3, "ext": ["V.O."], "paren": ["distorted"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Yes! Three of us!", "name": "BRYNJA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Please remain calm. Maintenance is en route.", "name": "INTERCOM", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "How long?", "name": "CALLISTA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Forty minutes.", "name": "INTERCOM", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Forty minutes.", "name": "RUFUS", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Is anyone carrying a bag?", "name": "INTERCOM", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Brynja's grip tightens on the briefcase.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Rufus glances at it.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Callista looks up from her phone.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Why?", "name": "CALLISTA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "The intercom crackles.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Then, very quietly:", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Because the sensor says the car is heavier than it should be.", "name": "INTERCOM", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}