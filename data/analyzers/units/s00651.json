{"scene_id": "s00651", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00651.fountain", "heading": "INT. SEASIDE LIDO CAF\u00c9, OFF-SEASON - DUSK", "cast": [{"id": 0, "name": "ODALYS FONTAINE", "names": ["ODALYS FONTAINE", "ODALYS"], "gender": "f", "first": 3, "spoke": 8}, {"id": 1, "name": "JULIEN ARMAND-REYES", "names": ["JULIEN ARMAND-REYES", "JULIEN"], "gender": "m", "first": 4, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. SEASIDE LIDO CAF\u00c9, OFF-SEASON - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "Stacked chairs, a drained pool outside the glass wall, a wind-torn flag.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "One table is set in the middle of the empty floor: two cups, a plate of untouched pastries, a guttering candle in a jar.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "ODALYS FONTAINE sits with her back straight and her coat still on.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "JULIEN ARMAND-REYES stands at the counter with his hat in his hands, as if he had just come in and might still go back out.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "He crosses the room.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "She watches him come, and he sees her watching, and slows.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He puts the hat on the table instead of his chair, and sits, and she pours him coffee without being asked, her hand perfectly steady, and he looks at the cup and not at her.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You came.", "name": "JULIEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "You asked.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I wasn't sure you'd read it.", "name": "JULIEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I read it eleven times.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He smiles, briefly.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She doesn't.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She pushes the plate toward him with two fingers, and he takes a pastry, turns it over, and sets it down again without biting.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "You're angry.", "name": "JULIEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "I'm tired.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "It's the same thing, with you.", "name": "JULIEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "It's never been the same thing. That was always your mistake.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He lets that settle.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Outside, the wind drags a loose sheet of tarp across the empty pool, and the sound is like a long slow breath.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She hears it too.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "They both glance at the glass.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "For a moment, a gull hangs in the gray, perfectly still.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "I should say I'm sorry.", "name": "JULIEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "You should.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "I am.", "name": "JULIEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "I know.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "She stands.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "She buttons her coat to the throat, slowly, and he rises with her, awkward, wanting to reach for her sleeve and not daring.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "She takes a pastry from the plate and wraps it in a napkin, and slides it into her pocket, and looks at him one last time.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "For the train.", "name": "ODALYS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Odalys --", "name": "JULIEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Goodbye, Julien.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "She goes.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "He doesn't follow.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "He stands in the empty room with the candle burning down, and then, carefully, he sits back down and begins to drink her coffee.", "para": 6, "sent": 2, "present": [0, 1]}]}