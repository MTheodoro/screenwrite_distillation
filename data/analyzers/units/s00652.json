{"scene_id": "s00652", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00652.fountain", "heading": "INT. TRAMPOLINE PARK AFTER HOURS - NIGHT", "cast": [{"id": 0, "name": "PRIYA SANDOVAL-KHAN", "names": ["PRIYA SANDOVAL-KHAN", "PRIYA"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "NOAH BRENNAN", "names": ["NOAH BRENNAN", "NOAH"], "gender": "f", "first": 5, "spoke": 4}, {"id": 2, "name": "MARISELA TORRES", "names": ["MARISELA TORRES", "MARISELA"], "gender": "f", "first": 6, "spoke": 3}, {"id": 3, "name": "JAZZ", "names": ["JAZZ"], "gender": "?", "first": 7, "spoke": 2}, {"id": 4, "name": "ODUYA", "names": ["ODUYA"], "gender": "?", "first": 7, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. TRAMPOLINE PARK AFTER HOURS - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Wall-to-wall black mesh under strings of blue neon.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A foam pit like a cloud.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Four teenagers in socks, breathing hard from the climb, perch on the edge of the highest platform.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "PRIYA SANDOVAL-KHAN, sixteen, the ringleader.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "NOAH BRENNAN, seventeen, her ex.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "MARISELA TORRES, sixteen, her best friend.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "And JASPER \"JAZZ\" ODUYA, fifteen, the youngest, holding a phone like a torch.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "On three, we jump.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "You said that at two.", "name": "NOAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "She said it at one.", "name": "MARISELA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Can I film it?", "name": "JAZZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "No.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Yes.", "name": "NOAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Noah, if you film me --", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "What, Priya? What?", "name": "NOAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Guys --", "name": "MARISELA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Don't \"guys\" me.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "I'm going to jump now.", "name": "JAZZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Jazz, don't --", "name": "NOAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "He jumps.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "The rest scramble after him, shouting, a tangle of limbs.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Priya and Noah collide mid-air, bounce apart, land on opposite trampolines.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Marisela belly-flops into the pit and surfaces coughing foam.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Jazz lies spread-eagled on the mesh, laughing.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Everyone stops.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Everyone stares at each other.", "para": 2, "sent": 6, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "The neon hums.", "para": 2, "sent": 7, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "I think I broke something.", "name": "MARISELA", "speaker": 2, "ext": [], "paren": ["from the pit"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Me too.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4]}]}