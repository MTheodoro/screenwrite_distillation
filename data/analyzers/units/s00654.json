{"scene_id": "s00654", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00654.fountain", "heading": "INT. HEARSE, MOVING - NIGHT", "cast": [{"id": 0, "name": "TANDI", "names": ["TANDI"], "gender": "?", "first": 5, "spoke": 2}, {"id": 1, "name": "LAURENCE BECKFORD", "names": ["LAURENCE BECKFORD", "LAURENCE"], "gender": "?", "first": 8, "spoke": 2}, {"id": 2, "name": "MIREILLE DUVAL", "names": ["MIREILLE DUVAL", "MIREILLE"], "gender": "?", "first": 12, "spoke": 2}, {"id": 3, "name": "IZZY", "names": ["IZZY"], "gender": "?", "first": 12, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. HEARSE, MOVING - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dark road.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rain.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The coffin in back is empty of a body.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Full of cash.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "THANDIWE \"TANDI\" KOWALCZYK drives.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Gloves.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Eyes forward.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "LAURENCE BECKFORD sits shotgun.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Counts.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Loses count.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Counts again.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "In the back, folding the seats down, MIREILLE DUVAL and ISADORE \"IZZY\" NKEMELU.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "She tapes a bag.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "He wipes prints from a crowbar.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "She hums.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "He tells her to stop.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "She doesn't.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "He rubs his temples.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "She kicks the coffin lid shut.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Nobody speak.", "name": "LAURENCE", "speaker": 1, "ext": [], "paren": ["to the car"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "We're past that.", "name": "IZZY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "We're past everything.", "name": "MIREILLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "She laughs.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "He doesn't.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "He holds the crowbar a moment too long.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Eyes on the mirror. Both of you.", "name": "TANDI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "They look.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Headlights.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Far behind.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Two white dots, steady.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "She slows.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "He glances back at the dots, then at her.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "She doesn't speed up.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Tandi.", "name": "LAURENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "I see it.", "name": "TANDI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "The hearse drifts onto the shoulder.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "She cuts the engine.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Rain on the roof.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "The headlights grow.", "para": 10, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "They wait.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "He puts the crowbar down.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "She takes her gloves off, one finger at a time.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "The car passes.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "A taxi.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "It disappears into the rain.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Nobody moves for a long time.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Well. That's the last of the fear.", "name": "MIREILLE", "speaker": 2, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Is it?", "name": "IZZY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "She starts the engine.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}]}