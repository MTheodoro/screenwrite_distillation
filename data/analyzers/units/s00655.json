{"scene_id": "s00655", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00655.fountain", "heading": "INT. LAKESIDE BOATHOUSE - NIGHT", "cast": [{"id": 0, "name": "ELLIOTT VANCE", "names": ["ELLIOTT VANCE", "ELLIOTT"], "gender": "m", "first": 5, "spoke": 3}, {"id": 1, "name": "CLEM", "names": ["CLEM"], "gender": "?", "first": 8, "spoke": 8}, {"id": 2, "name": "ASHWORTH", "names": ["ASHWORTH"], "gender": "?", "first": 8, "spoke": 0}, {"id": 3, "name": "SAMUEL ABIODUN", "names": ["SAMUEL ABIODUN", "SAMUEL"], "gender": "?", "first": 9, "spoke": 5}, {"id": 4, "name": "NIAMH QUINLAN", "names": ["NIAMH QUINLAN", "NIAMH"], "gender": "?", "first": 10, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAKESIDE BOATHOUSE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dust and mildew.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A canoe on sawhorses.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain on the tin roof.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "One camp lantern on an oil drum.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ELLIOTT VANCE, forties, sits on an overturned crate with his hands bound in front of him.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "His shirt is wet.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "His eyes are open.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "CLEMENTINE \"CLEM\" ASHWORTH, thirties, stands by the door, a revolver at her hip.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Across the boathouse, DR. SAMUEL ABIODUN, sixties, rinses a cloth in a bucket.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "At the far window, NIAMH QUINLAN, twenties, watches the dock.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Clem, this is a mistake.", "name": "ELLIOTT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "It's not a mistake, Elliott. It's a Tuesday.", "name": "CLEM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Elliott, the cloth is cold. Hold still.", "name": "SAMUEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Sam. Sam, you're a doctor.", "name": "ELLIOTT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "I know what I am.", "name": "SAMUEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Headlights, Clem. On the north road.", "name": "NIAMH", "speaker": 4, "ext": [], "paren": ["not turning"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Clem straightens.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "She crosses to the window and looks, and Niamh steps aside to let her.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "That's Duncan.", "name": "CLEM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "He's early.", "name": "NIAMH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "He's never early.", "name": "CLEM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Then he knows something.", "name": "ELLIOTT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Shut up, Elliott.", "name": "CLEM", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "We should leave.", "name": "SAMUEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "We should finish.", "name": "CLEM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Sam looks at the revolver, at Elliott, at the rain on the glass.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "He puts down the cloth.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Clem. I won't.", "name": "SAMUEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Sam --", "name": "CLEM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "I won't.", "name": "SAMUEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Niamh looks from one to the other.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "The headlights swing across the boathouse wall and fall away.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "He's turned around.", "name": "NIAMH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "A long breath.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Clem lowers the revolver an inch.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Elliott, shaking, lets out a sound that is half a laugh.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Cut him loose.", "name": "CLEM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Are you sure?", "name": "NIAMH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "No.", "name": "CLEM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "She does it anyway.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}]}