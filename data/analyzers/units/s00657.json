{"scene_id": "s00657", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00657.fountain", "heading": "INT. NIGHT-SHIFT BAKERY - 4 A.M.", "cast": [{"id": 0, "name": "HILDEGARD BRANDT", "names": ["HILDEGARD BRANDT", "HILDEGARD"], "gender": "f", "first": 9, "spoke": 2}, {"id": 1, "name": "OSKAR WREN", "names": ["OSKAR WREN"], "gender": "f", "first": 10, "spoke": 0}, {"id": 2, "name": "PAOLA FERREIRA-LIN", "names": ["PAOLA FERREIRA-LIN"], "gender": "?", "first": 11, "spoke": 0}, {"id": 3, "name": "NADEEM ARSLAN", "names": ["NADEEM ARSLAN"], "gender": "m", "first": 12, "spoke": 0}, {"id": 4, "name": "RHIANNON POTTS", "names": ["RHIANNON POTTS"], "gender": "?", "first": 13, "spoke": 0}, {"id": 5, "name": "MOSES ABERNATHY-GRAY", "names": ["MOSES ABERNATHY-GRAY", "MOSES"], "gender": "m", "first": 14, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT-SHIFT BAKERY - 4 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "Flour-dusted steel.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A dozen racks of rising dough under heat lamps.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A radio hissing between stations.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The ovens tick as they warm.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Everything smells of yeast and, faintly, something sweeter.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "SIX BAKERS in white.", "para": 1, "sent": 0, "present": []}, {"u": 7, "kind": "action", "text": "Five move.", "para": 1, "sent": 1, "present": []}, {"u": 8, "kind": "action", "text": "One doesn't.", "para": 1, "sent": 2, "present": []}, {"u": 9, "kind": "action", "text": "HILDEGARD BRANDT, sixties, the head baker, kneads with the heel of her hand, never looking up.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "OSKAR WREN, twenties, shapes rolls beside her, a half-beat slower than the rhythm of the room.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "PAOLA FERREIRA-LIN, thirties, scores loaves with a razor, one clean cut after another.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "NADEEM ARSLAN, fifties, loads the oven, counts under his breath.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "RHIANNON POTTS, twenties, sweeps near the back door.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "And MOSES ABERNATHY-GRAY, forties, stands at the far counter with his back to the others, kneading nothing at all.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "The radio drifts to a station playing a slow waltz.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Nobody turns it off.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Moses. The dough.", "name": "HILDEGARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "I'm working it.", "name": "MOSES", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "There's no dough there.", "name": "HILDEGARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "He looks down at his hands.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "They are slick with flour.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "They have been pressing and folding an empty counter for an hour.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Paola's razor pauses.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Nadeem's lips stop moving.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "There was.", "name": "MOSES", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Nobody answers.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "The ovens tick.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "In the back, the door rattles once, as if someone had leaned on it from outside.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}