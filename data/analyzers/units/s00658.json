{"scene_id": "s00658", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00658.fountain", "heading": "INT. MATTRESS SHOWROOM - DAY", "cast": [{"id": 0, "name": "SLEEP BETTER", "names": ["SLEEP BETTER"], "gender": "?", "first": 2, "spoke": 0}, {"id": 1, "name": "REG", "names": ["REG"], "gender": "?", "first": 5, "spoke": 6}, {"id": 2, "name": "PAPADOPOULOS", "names": ["PAPADOPOULOS"], "gender": "?", "first": 5, "spoke": 0}, {"id": 3, "name": "GRETCHEN SUNDQVIST", "names": ["GRETCHEN SUNDQVIST", "GRETCHEN"], "gender": "?", "first": 6, "spoke": 6}, {"id": 4, "name": "OSWIN TREMBLAY", "names": ["OSWIN TREMBLAY", "OSWIN"], "gender": "?", "first": 7, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. MATTRESS SHOWROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Forty beds under bright lights.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Banners reading SLEEP BETTER, LIVE BETTER.", "para": 0, "sent": 1, "present": [0]}, {"u": 3, "kind": "action", "text": "A wall of pillows.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "Soft jazz.", "para": 0, "sent": 3, "present": [0]}, {"u": 5, "kind": "action", "text": "REGINALD \"REG\" PAPADOPOULOS, fifties, a salesman in a rumpled blazer, lies on a king-sized display bed with his hands folded on his chest, eyes shut.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "Across the aisle, GRETCHEN SUNDQVIST, thirties, an assistant manager with a tablet, taps without looking up.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "Between them, on a queen mattress, OSWIN TREMBLAY, seventy, a customer in a flat cap, sits and bounces gently, testing.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "This one has a nice give.", "name": "OSWIN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "It's our Premium Plus.", "name": "GRETCHEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "What's the premium?", "name": "OSWIN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "The plus.", "name": "GRETCHEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Mm.", "name": "OSWIN", "speaker": 4, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "He lies down beside Reg, who doesn't move.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "They lie shoulder to shoulder, staring at the ceiling.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Don't tell her I'm off the clock.", "name": "REG", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "I thought you were the salesman.", "name": "OSWIN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "I'm a man in bed.", "name": "REG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Reg. Customer.", "name": "GRETCHEN", "speaker": 3, "ext": [], "paren": ["without looking"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "I'm helping him.", "name": "REG", "speaker": 1, "ext": [], "paren": ["opening one eye"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "You're asleep.", "name": "GRETCHEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "I'm demonstrating.", "name": "REG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "We offer a hundred-night trial on all models.", "name": "GRETCHEN", "speaker": 3, "ext": [], "paren": ["to the showroom at large"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "A hundred nights?", "name": "OSWIN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Don't do it.", "name": "REG", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Why?", "name": "OSWIN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Because you'll sleep.", "name": "REG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Oswin considers this for a long moment.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "He turns his head toward Reg, and Reg turns toward him.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "I'll take it.", "name": "OSWIN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Excellent.", "name": "GRETCHEN", "speaker": 3, "ext": [], "paren": ["still tapping"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Neither of them gets up.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}]}