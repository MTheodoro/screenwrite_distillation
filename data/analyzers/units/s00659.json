{"scene_id": "s00659", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00659.fountain", "heading": "INT. LIBRARY INSIDE A WHALE SKELETON - NIGHT", "cast": [{"id": 0, "name": "OSRIC THISTLEDOWN", "names": ["OSRIC THISTLEDOWN", "OSRIC"], "gender": "m", "first": 5, "spoke": 18}, {"id": 1, "name": "MIRABEL ASHGROVE", "names": ["MIRABEL ASHGROVE", "MIRABEL"], "gender": "f", "first": 6, "spoke": 9}, {"id": 2, "name": "PETRONELLA VOSS", "names": ["PETRONELLA VOSS", "PETRONELLA"], "gender": "?", "first": 7, "spoke": 8}, {"id": 3, "name": "BRANWELL KESH", "names": ["BRANWELL KESH", "BRANWELL"], "gender": "?", "first": 48, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. LIBRARY INSIDE A WHALE SKELETON - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Ribs rise like cathedral arches over shelves of salt-warped books.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Lanterns hang from vertebrae.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A long table of driftwood.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Somewhere in the dark, water drips onto stone.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "OSRIC THISTLEDOWN, nineties, the Keeper, hunches over an open atlas, a quill behind each ear.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across the table sits MIRABEL ASHGROVE, forties, a courier in a salt-stained cloak, a sealed scroll tube beside her.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "At the end, fiddling with an abacus of bone beads, is PETRONELLA VOSS, twenties, the apprentice, sleepy-eyed.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "You said the tide was safe.", "name": "OSRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "I said it was passable.", "name": "MIRABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Those are different words.", "name": "OSRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "They're different tides.", "name": "MIRABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Master Osric, the abacus is stuck again.", "name": "PETRONELLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Hit it.", "name": "OSRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I did.", "name": "PETRONELLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Harder.", "name": "OSRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "May I ask what you're guarding in here?", "name": "MIRABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Everything.", "name": "OSRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "That's no answer.", "name": "MIRABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "It's the only answer. Every book in this room is the last of its kind. We keep them here because the sea took the rest.", "name": "OSRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "And the whale?", "name": "MIRABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "The whale was the first book. We just couldn't read it.", "name": "OSRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "I think I can.", "name": "PETRONELLA", "speaker": 2, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "You think a lot of things, child.", "name": "OSRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Let her speak.", "name": "MIRABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "She speaks. All day. It's the listening she lacks.", "name": "OSRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "There are marks on the ribs, Master. Inside, near the spine. Like writing. I've traced them.", "name": "PETRONELLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Marks are not writing.", "name": "OSRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "These repeat.", "name": "PETRONELLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Barnacles repeat.", "name": "OSRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "In sixes?", "name": "PETRONELLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "A silence.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Osric sets down his quill.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Show me.", "name": "OSRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "She hurries to a rib and presses her lantern against the bone.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "The marks leap out in the light: tiny, regular, deliberate.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Forty years I've sat under this.", "name": "OSRIC", "speaker": 0, "ext": ["CONT'D"], "paren": ["barely audible"], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "What does it say?", "name": "MIRABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "I don't know yet.", "name": "PETRONELLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Then we shall have to learn.", "name": "OSRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "A pause.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Mirabel rises from her chair and looks up.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "I'll stay the night.", "name": "MIRABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "You'll stay the winter.", "name": "OSRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "I have a delivery.", "name": "MIRABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Leave it here. Everything arrives, eventually.", "name": "OSRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "The scroll tube sits on the table, forgotten.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "At the doorway, the lantern light catches the wet footprints of someone who has just entered.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "A figure steps out of the dark: BRANWELL KESH, thirties, barefoot, soaked to the bone, carrying a dripping canvas sack and wearing a sea captain's coat three sizes too large.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Sorry. The door was open.", "name": "BRANWELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "There is no door.", "name": "OSRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Then I'm very sorry.", "name": "BRANWELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "He sets down the sack.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "A single book slides out, black with salt, and lands open on the table.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Petronella gasps.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "That's the same writing.", "name": "PETRONELLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Sit down, boy. Tell me where you found it.", "name": "OSRIC", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Branwell sits.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "The lantern light finds the page.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}]}