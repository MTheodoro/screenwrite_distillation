{"scene_id": "s00661", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00661.fountain", "heading": "INT. ABANDONED PLANETARIUM GIFT SHOP - NIGHT", "cast": [{"id": 0, "name": "ODELIA PEMBERTON-ROSS", "names": ["ODELIA PEMBERTON-ROSS", "ODELIA"], "gender": "f", "first": 5, "spoke": 2}, {"id": 1, "name": "ISAIAH TUPOU", "names": ["ISAIAH TUPOU", "ISAIAH"], "gender": "?", "first": 6, "spoke": 4}, {"id": 2, "name": "MINA", "names": ["MINA"], "gender": "?", "first": 7, "spoke": 2}, {"id": 3, "name": "CARVALHO", "names": ["CARVALHO"], "gender": "?", "first": 7, "spoke": 0}, {"id": 4, "name": "COLM DRISCOLL", "names": ["COLM DRISCOLL", "COLM"], "gender": "?", "first": 8, "spoke": 2}, {"id": 5, "name": "NERI", "names": ["NERI"], "gender": "?", "first": 9, "spoke": 5}, {"id": 6, "name": "GREGORY HALLORAN", "names": ["HALLORAN", "GREGORY HALLORAN", "GREGORY"], "gender": "?", "first": 9, "spoke": 4}, {"id": 7, "name": "MAN", "names": ["MAN"], "gender": "?", "first": 27, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED PLANETARIUM GIFT SHOP - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "The shelves are half empty: plastic telescopes, glow-in-the-dark star charts, a bin of rubber moons.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A velvet curtain hangs open onto the dark dome beyond.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Moonlight pours through a skylight and lays a pale blue rectangle on the tile.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Five teenagers have broken in and are pretending not to be nervous.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "ODELIA PEMBERTON-ROSS, seventeen, braids bound in a red scarf, sits on the checkout counter swinging her legs.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "ISAIAH TUPOU, eighteen, a rugby player's shoulders and a poet's quiet, stands by the curtain staring into the dark.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "WILHELMINA \"MINA\" CARVALHO, sixteen, tiny, fierce, rifles through a drawer of keychains.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "COLM DRISCOLL, seventeen, plugs a portable speaker into an outlet that has no power.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "And NERISSA \"NERI\" HALLORAN, seventeen, the host, sits cross-legged on the floor with a candle.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "dialogue", "text": "It's so quiet.", "name": "ODELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "It's a planetarium.", "name": "ISAIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "It's a tomb.", "name": "MINA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "It's a gift shop.", "name": "COLM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "It's mine for the night. Dad's the caretaker.", "name": "NERI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "Neri, you said he was at his sister's.", "name": "ODELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "He is.", "name": "NERI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "Then who's making that noise?", "name": "COLM", "speaker": 4, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "action", "text": "They listen.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "action", "text": "A slow metallic hum, from inside the dome.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "action", "text": "They look at the curtain.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "It's the cooling system.", "name": "ISAIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "There's no power.", "name": "MINA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "Backup, then.", "name": "ISAIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "Backup. Obviously.", "name": "NERI", "speaker": 5, "ext": [], "paren": ["too brightly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "action", "text": "Isaiah pulls the curtain wider.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "action", "text": "Inside, the dome's seats climb in dark rings, and at its center the old projector gleams, slowly turning on its pedestal, though nothing has turned it on.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "Beside it, in a work jacket and a flashlight beam, a MAN stands motionless, watching them: GREGORY HALLORAN, fifties, Neri's father, caretaker.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 28, "kind": "dialogue", "text": "Hello, Nerissa.", "name": "GREGORY", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 29, "kind": "dialogue", "text": "Dad.", "name": "NERI", "speaker": 5, "ext": [], "paren": ["small"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "dialogue", "text": "Your aunt called. She says you told her I was there.", "name": "GREGORY", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "dialogue", "text": "I didn't --", "name": "NERI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "dialogue", "text": "Hello, everybody. I'm Mr. Halloran. Would you like to see the stars properly?", "name": "GREGORY", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "action", "text": "Nobody moves.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "action", "text": "Odelia slides off the counter.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "action", "text": "Colm unplugs the speaker.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "action", "text": "Mina shuts the drawer, slowly.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "action", "text": "The projector hums higher.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "action", "text": "The dome goes dark, and then, all at once, it fills with light: ten thousand stars wheeling in a perfect, impossible sky.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "dialogue", "text": "Oh.", "name": "ISAIAH", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "dialogue", "text": "Sit. Sit. You've got till dawn.", "name": "GREGORY", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}