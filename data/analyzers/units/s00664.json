{"scene_id": "s00664", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00664.fountain", "heading": "EXT. SELF-STORAGE FACILITY ROOFTOP - NIGHT", "cast": [{"id": 0, "name": "CASSIDY ODEKUNLE", "names": ["CASSIDY ODEKUNLE", "CASSIDY"], "gender": "f", "first": 5, "spoke": 22}, {"id": 1, "name": "ELI", "names": ["ELI"], "gender": "?", "first": 6, "spoke": 22}, {"id": 2, "name": "BRANDVOLD", "names": ["BRANDVOLD"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "MOM", "names": ["MOM"], "gender": "?", "first": 55, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SELF-STORAGE FACILITY ROOFTOP - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A flat tar roof ringed by rows of orange doors.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A city glows beyond the chain-link.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Two lawn chairs, a cooler, a portable speaker playing something low.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A tangle of fairy lights strung across a vent pipe, half of them dead.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CASSIDY ODEKUNLE, seventeen, slouches in one chair in a thrift-store prom dress and sneakers, her knees drawn up.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Beside her, ELIJAH \"ELI\" BRANDVOLD, seventeen, sits in a rented tux with the bow tie loose, a paper cup of lukewarm soda balanced on his knee.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "You didn't have to come up here.", "name": "CASSIDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "You texted me the address.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "As a joke.", "name": "CASSIDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "It didn't read like a joke.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Everything reads like a joke when you're me.", "name": "CASSIDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "He sets the cup down on the tar.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "He leans back and looks at the sky, which has only three stars in it.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "You missed your own prom.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "I didn't miss it. I left it.", "name": "CASSIDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Why?", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Because Kayleigh Tran said my dress looked like a curtain.", "name": "CASSIDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "It does look like a curtain.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I know it looks like a curtain! It's my grandmother's curtain!", "name": "CASSIDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "She laughs, startled, and then her face crumples.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "She pulls the dress's hem over her knees and presses her forehead to it.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Hey.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Don't.", "name": "CASSIDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Cass.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "I said don't.", "name": "CASSIDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "He sits very still.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "The speaker's song ends.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "In the quiet, a train passes below, a long iron murmur.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "She wipes her face with her wrist.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "My mom doesn't know. She thinks I'm at the after-party.", "name": "CASSIDY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Is there an after-party?", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "There's always an after-party.", "name": "CASSIDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "I'll take you.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "I don't want to go.", "name": "CASSIDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Then I'll stay.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "You hate roofs.", "name": "CASSIDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "I hate heights. Roofs are just heights with furniture.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "She laughs, a small wet laugh.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "He holds out the cup of soda.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "She drinks, makes a face, and gives it back.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Warm.", "name": "CASSIDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Yeah.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "They watch the city.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Somewhere far off, a siren starts and fades.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Eli?", "name": "CASSIDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Yeah?", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Do you ever think everyone is faking?", "name": "CASSIDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "All the time.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Even Kayleigh?", "name": "CASSIDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Especially Kayleigh.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "She smiles.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "She slides her hand across the armrest and he takes it without looking, and they sit like that, two people on a roof among a hundred locked doors.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Then Eli's phone buzzes on the tar.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "They both glance at it.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "The screen lights: MOM \u2014 14 MISSED CALLS.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Oh no.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "Oh no.", "name": "CASSIDY", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "He grabs it.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "She snatches it from him and holds it up out of reach, and he lunges, and the chairs scrape, and the cooler topples, and ice spills across the roof in a bright white rush.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "Give it!", "name": "ELI", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "Not until you say it!", "name": "CASSIDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "Say what?", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "That you're glad you came.", "name": "CASSIDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "He stops.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "Ice crunches under his shoes.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "He looks at her, tux askew, face flushed, hair full of fairy-light glare.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "I'm glad I came.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "Good.", "name": "CASSIDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "She hands him the phone.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "He doesn't look at it.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "He puts it face-down on the tar.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "You owe me a dance.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "There's no music.", "name": "CASSIDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "dialogue", "text": "There's the speaker.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "She reaches over and taps it.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "A scratchy waltz starts up.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "She stands, awkward in her sneakers, and offers him her hand.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "dialogue", "text": "Don't step on my curtain.", "name": "CASSIDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "dialogue", "text": "I'll try.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}