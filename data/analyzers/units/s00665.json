{"scene_id": "s00665", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00665.fountain", "heading": "EXT. LIFE RAFT - OPEN OCEAN - DAY", "cast": [{"id": 0, "name": "CAPTAIN LUCIAN BRACKENRIDGE", "names": ["CAPTAIN LUCIAN BRACKENRIDGE", "LUCIAN"], "gender": "m", "first": 5, "spoke": 6}, {"id": 1, "name": "MARIANNE DELACROIX-SOTO", "names": ["MARIANNE DELACROIX-SOTO", "MARIANNE"], "gender": "f", "first": 6, "spoke": 2}, {"id": 2, "name": "ANDERS TELLEFSEN", "names": ["ANDERS TELLEFSEN", "ANDERS"], "gender": "m", "first": 7, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. LIFE RAFT - OPEN OCEAN - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A yellow raft on a flat blue sea.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The sun is a hammer.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A tattered canopy offers a stripe of shade.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Three castaways sit in a triangle, rationing silence.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CAPTAIN LUCIAN BRACKENRIDGE, fifties, sits at the bow with a sextant he no longer needs, his white uniform gone gray.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "At the stern, MARIANNE DELACROIX-SOTO, thirties, ship's doctor, tends a water pouch with the care of a priest.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Between them, hunched over his knees, is ANDERS TELLEFSEN, twenties, deckhand, lips cracked, eyes fixed on a point on the horizon that isn't there.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Lucian holds out a hand.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Marianne passes the pouch.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "He sips, and passes it to Anders.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Anders holds it and does not drink.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Drink, son.", "name": "LUCIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Later.", "name": "ANDERS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Now.", "name": "LUCIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Later, Captain.", "name": "ANDERS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Marianne watches.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "She says nothing.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "A wave slaps the hull, and spray flies over their faces and dries almost at once.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Anders.", "name": "MARIANNE", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Anders.", "name": "LUCIAN", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Anders looks up at them both, then down at the pouch.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "He lifts it, slowly, as if lifting a weight, and drinks.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Only a sip.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "He hands it back.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Marianne takes it.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "She tilts it to the light.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "It is almost empty.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "She looks at Lucian.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "He looks at the sea.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Two days.", "name": "MARIANNE", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Two days.", "name": "LUCIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "You're lying.", "name": "ANDERS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "A gull circles overhead, wheeling in the cloudless blue.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "There's one day. Maybe less.", "name": "ANDERS", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Anders --", "name": "LUCIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "You both knew.", "name": "ANDERS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Marianne starts to answer.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Lucian puts a hand on her wrist.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "She stops.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Anders is on his knees now, the raft rocking dangerously under him, and he lunges for the pouch.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Marianne pulls it away.", "para": 8, "sent": 4, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Lucian seizes his arm.", "para": 8, "sent": 5, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "The three of them crash together in a tangle, and the pouch splits, and the last of the water spills into the bottom of the raft and is gone.", "para": 8, "sent": 6, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Nobody moves.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Anders slumps back.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Marianne stares at the dark stain on the rubber.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Lucian lets go of Anders's arm and, very gently, closes his own eyes.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Well.", "name": "LUCIAN", "speaker": 0, "ext": ["CONT'D"], "paren": ["barely audible"], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "The gull wheels overhead, close now.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Marianne tilts her head back and looks up at it for a long time.", "para": 11, "sent": 1, "present": [0, 1, 2]}]}