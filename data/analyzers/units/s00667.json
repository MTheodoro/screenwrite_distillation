{"scene_id": "s00667", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00667.fountain", "heading": "INT. WAREHOUSE ROLLER DERBY RINK - NIGHT", "cast": [{"id": 0, "name": "BRUTAL BRON", "names": ["BRUTAL BRON", "BRON"], "gender": "f", "first": 6, "spoke": 1}, {"id": 1, "name": "SANTOS-WEBB", "names": ["SANTOS-WEBB"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "MAYHEM MO", "names": ["MAYHEM MO", "MO"], "gender": "?", "first": 9, "spoke": 2}, {"id": 3, "name": "OYELOWO", "names": ["OYELOWO"], "gender": "?", "first": 9, "spoke": 0}, {"id": 4, "name": "RAZOR", "names": ["RAZOR"], "gender": "f", "first": 11, "spoke": 1}, {"id": 5, "name": "VASQUEZ", "names": ["VASQUEZ"], "gender": "?", "first": 11, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. WAREHOUSE ROLLER DERBY RINK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A banked track marked in tape.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Folding chairs, a beer cooler, a hand-lettered scoreboard.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A hundred spectators in leather and sequins roar.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Three skaters.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "One jam left.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "BRONWYN \"BRUTAL BRON\" SANTOS-WEBB, thirties, jammer, star on her helmet.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Fast.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Bleeding from the lip.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "MONIQUE \"MAYHEM MO\" OYELOWO, forties, blocker.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Wide as a door.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "RENATA \"RAZOR\" VASQUEZ, twenties, blocker.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "Small.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "Dangerous.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "Whistle.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Bron charges.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Mo steps in.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Razor sweeps low.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Bron hops, spins, and slams into Mo's shoulder.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Razor's elbow takes her in the ribs.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "All three go down in a clattering heap, helmets cracking, wheels spinning in the air.", "para": 6, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "The crowd shrieks.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Is she okay?", "name": "BRON", "speaker": 0, "ext": [], "paren": ["from the floor"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "I'm fine!", "name": "MO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Not her. Her.", "name": "RAZOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "She points.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Bron sits up.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "She is clutching her wrist.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Mo and Razor look at each other.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "They roll away at the same moment, and she gets up first, holding a hand down to Bron.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Time out.", "name": "MO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "The crowd chants.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Bron laughs through the pain, takes the hand, and lets herself be hauled up.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Razor, grinning, high-fives her with the good one.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}