{"scene_id": "s00668", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00668.fountain", "heading": "INT. CORPORATE TEAM-BUILDING ESCAPE ROOM - DAY", "cast": [{"id": 0, "name": "FEE", "names": ["FEE"], "gender": "f", "first": 6, "spoke": 24}, {"id": 1, "name": "ADEYEMI-CROSS", "names": ["ADEYEMI-CROSS"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "GAVIN HOLLOWAY-PRICE", "names": ["GAVIN HOLLOWAY-PRICE", "GAVIN"], "gender": "m", "first": 9, "spoke": 18}], "units": [{"u": 0, "kind": "heading", "text": "INT. CORPORATE TEAM-BUILDING ESCAPE ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A fake dungeon.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rubber chains, plastic torches, a countdown clock mounted above a locked iron door.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The clock reads 47:00.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A speaker in the ceiling plays a looped, ominous drone.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Two coworkers stand in the center of the stone-effect floor.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "FIONNUALA \"FEE\" ADEYEMI-CROSS, forties, a senior accountant in a blazer.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Clipboard.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "No shoes.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "GAVIN HOLLOWAY-PRICE, thirties, a product lead in a company hoodie.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Earnest.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Sweating.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "A laminated sign reads: THERE IS NO \"I\" IN ESCAPE.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "The clue is on the wall.", "name": "FEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "The wall has seventeen clues.", "name": "GAVIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Then it's one of seventeen.", "name": "FEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "That's not how clues work.", "name": "GAVIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "That's exactly how clues work.", "name": "FEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "She taps a rubber torch.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "It falls off its bracket.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "She sighs, replaces it, and it falls again.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Okay. Okay. Think.", "name": "GAVIN", "speaker": 2, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Gavin, you're muttering.", "name": "FEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "I'm brainstorming.", "name": "GAVIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Out loud, to nobody.", "name": "FEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "I'm brainstorming to the room.", "name": "GAVIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The clock ticks: 44:12.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Something in the ceiling crackles, and then falls quiet.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Oh, God.", "name": "FEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Gavin immediately begins searching the floor on his hands and knees.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Fee watches him.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "It's a hotel conference room with a rug over it, Gavin. The key's in the rug.", "name": "FEE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "How do you know?", "name": "GAVIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Because I've been in forty of these.", "name": "FEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Forty?", "name": "GAVIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "It's called \"culture.\"", "name": "FEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "He lifts a corner of the rug.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "A brass key lies on the concrete.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "He holds it up like a medal.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Fee!", "name": "GAVIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Don't celebrate. It's the cheapest one.", "name": "FEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "He fits the key into the iron door.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "It turns.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "The door groans open and reveals a second room, identical to the first, with a clock reading 40:00.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "It resets.", "name": "GAVIN", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Of course it resets.", "name": "FEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Is it always like this?", "name": "GAVIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "It's always like this.", "name": "FEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "She sets down the clipboard.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "She sits cross-legged on the floor in the second room, and after a moment, he sits too.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Gavin, do you actually like working here?", "name": "FEE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "I... don't know.", "name": "GAVIN", "speaker": 2, "ext": [], "paren": ["caught off guard"], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Neither do I.", "name": "FEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "You've been here nineteen years.", "name": "GAVIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "It feels like a hobby I never chose.", "name": "FEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "He laughs, a surprised bark.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "The room hums.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "We know!", "name": "FEE", "speaker": 0, "ext": [], "paren": ["to the ceiling"], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "Should we try?", "name": "GAVIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "Try what?", "name": "FEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "The puzzle.", "name": "GAVIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "She considers him.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "Then the room.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "Then the clock.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "No.", "name": "FEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "No?", "name": "GAVIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "I'd like to sit here and not escape.", "name": "FEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "dialogue", "text": "For how long?", "name": "GAVIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 68, "kind": "dialogue", "text": "Till they open the door.", "name": "FEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "He nods slowly.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "He takes off his hoodie, folds it, and sets it on the floor like a cushion.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 71, "kind": "dialogue", "text": "Can I sit on yours?", "name": "GAVIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 72, "kind": "dialogue", "text": "Be my guest.", "name": "FEE", "speaker": 0, "ext": [], "paren": ["gesturing grandly"], "dual": false, "present": [0, 1, 2]}, {"u": 73, "kind": "action", "text": "They sit side by side.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 74, "kind": "action", "text": "The clock ticks.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 75, "kind": "action", "text": "The drone loops.", "para": 14, "sent": 2, "present": [0, 1, 2]}, {"u": 76, "kind": "action", "text": "After a while, Fee gets out her phone, and Gavin, hesitantly, opens his lunch.", "para": 14, "sent": 3, "present": [0, 1, 2]}, {"u": 77, "kind": "dialogue", "text": "Pretzel?", "name": "GAVIN", "speaker": 2, "ext": [], "paren": ["offering"], "dual": false, "present": [0, 1, 2]}, {"u": 78, "kind": "dialogue", "text": "Please.", "name": "FEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 79, "kind": "dialogue", "text": "We're fine, Brad. Stop checking.", "name": "FEE", "speaker": 0, "ext": [], "paren": ["calling up, without looking"], "dual": false, "present": [0, 1, 2]}, {"u": 80, "kind": "action", "text": "The drone resumes.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 81, "kind": "action", "text": "Gavin snorts.", "para": 15, "sent": 1, "present": [0, 1, 2]}, {"u": 82, "kind": "action", "text": "Fee, who has not smiled since the room began, tips her head back against the plastic wall and closes her eyes.", "para": 15, "sent": 2, "present": [0, 1, 2]}, {"u": 83, "kind": "dialogue", "text": "This is the best day I've had in years.", "name": "FEE", "speaker": 0, "ext": ["CONT'D"], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}]}