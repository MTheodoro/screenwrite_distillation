{"scene_id": "s00669", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00669.fountain", "heading": "INT. VETERINARY CLINIC WAITING ROOM - MEDIATION - DAY", "cast": [{"id": 0, "name": "SEBASTIAN OYELARAN-PRICE", "names": ["SEBASTIAN OYELARAN-PRICE", "SEBASTIAN"], "gender": "m", "first": 6, "spoke": 7}, {"id": 1, "name": "ANTONIA REYES-HOLLOWAY", "names": ["ANTONIA REYES-HOLLOWAY", "ANTONIA"], "gender": "f", "first": 7, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. VETERINARY CLINIC WAITING ROOM - MEDIATION - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Plastic chairs.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A scale for large dogs.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A poster: ARE YOUR PET'S TEETH TELLING YOU SOMETHING?", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A rack of leashes.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A mediator's empty chair sits between two others, its owner stepped out to find a pen.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "SEBASTIAN OYELARAN-PRICE, forties, in a camel coat, sits rigidly with a folder on his knees.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "ANTONIA REYES-HOLLOWAY, forties, in a tracksuit, clutches a cat carrier on her lap.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Biscuit is a Maine Coon.", "name": "SEBASTIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Biscuit is a cat.", "name": "ANTONIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I paid for the vaccinations.", "name": "SEBASTIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I clean the box.", "name": "ANTONIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "The carrier shifts.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "A paw pokes through the grille.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Antonia looks down, and her face softens.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Hello, my love.", "name": "ANTONIA", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Don't baby him. He's eleven.", "name": "SEBASTIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "He's a baby.", "name": "ANTONIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Six months each. Alternating. That's what she's going to propose.", "name": "SEBASTIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "He gets carsick because you drive like a lunatic.", "name": "ANTONIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "I drive like a person!", "name": "SEBASTIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "You drive like a person who's late for his own cat.", "name": "ANTONIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "The carrier jolts.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Both lunge for it.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Antonia pulls it to her chest, Sebastian grabs the handle, and for a moment the two of them are bent over it like surgeons, each with a hand on it.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "The latch pops.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Biscuit, enormous and orange, steps out.", "para": 3, "sent": 4, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Both freeze.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "The cat looks at one, then the other.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "It walks to the scale, hops on, and settles.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "The readout flickers: 19.4.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Nineteen pounds.", "name": "SEBASTIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Because you feed him cheese.", "name": "ANTONIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Because you feed him tuna.", "name": "SEBASTIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Neither moves toward the cat.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Then, slowly, Sebastian crouches and holds out a finger.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Antonia kneels beside him.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Biscuit sniffs, and begins to purr.", "para": 5, "sent": 3, "present": [0, 1]}]}