{"scene_id": "s00671", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00671.fountain", "heading": "INT. SKATELAND ROLLER RINK - PARTY ROOM - DAY", "cast": [{"id": 0, "name": "ODALYS", "names": ["ODALYS"], "gender": "f", "first": 4, "spoke": 2}, {"id": 1, "name": "PAULO REYES", "names": ["PAULO REYES", "PAULO"], "gender": "m", "first": 5, "spoke": 4}, {"id": 2, "name": "KIKI", "names": ["KIKI"], "gender": "?", "first": 6, "spoke": 3}, {"id": 3, "name": "DANTE FERREIRA", "names": ["DANTE FERREIRA", "DANTE"], "gender": "m", "first": 7, "spoke": 2}, {"id": 4, "name": "MARISOL", "names": ["MARISOL"], "gender": "?", "first": 8, "spoke": 1}, {"id": 5, "name": "TIO BETO", "names": ["TIO BETO"], "gender": "?", "first": 9, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. SKATELAND ROLLER RINK - PARTY ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Plastic tablecloths.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A sheet cake shaped like a sneaker.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Disco light spins across the wall.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ODALYS, 70s, church dress, guards the cake.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "PAULO REYES, 40s, a dad with a phone in each hand.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "KIKI, 8, birthday crown crooked.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "DANTE FERREIRA, 15, hood up, bored.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "MARISOL, 38, Paulo's sister, tying balloons.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "TIO BETO, 60s, mustache, holds a camcorder.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Everybody in the picture! Closer!", "name": "TIO BETO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "They bunch up.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "Kiki leans toward the candles.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Wait. Where's Mom?", "name": "KIKI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "Paulo's smile freezes.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "She's coming, mija.", "name": "PAULO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "She said that last year.", "name": "DANTE", "speaker": 3, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Paulo whips around.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Dante.", "name": "PAULO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Odalys slaps the table.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "The cake jumps.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Not today. Everyone sit. Now.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Nobody sits.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Marisol lets go of a balloon; it drifts to the ceiling.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Did you even call her?", "name": "MARISOL", "speaker": 4, "ext": [], "paren": ["to Paulo"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Three times.", "name": "PAULO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Is she not coming?", "name": "KIKI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "The disco light turns.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Dante pulls his hood down.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "She's coming. I texted her where we are.", "name": "DANTE", "speaker": 3, "ext": [], "paren": ["to Kiki"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Paulo stares at him.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Dante's phone buzzes.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "He reads it, turns the screen toward Paulo.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Paulo reads it and his shoulders drop.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "She's in the parking lot. Parking.", "name": "PAULO", "speaker": 1, "ext": [], "paren": ["to Kiki"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Mom's parking!", "name": "KIKI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "She is already running for the door.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Paulo exhales.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Odalys crosses herself and lights the candles.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Rolling. Finally rolling.", "name": "TIO BETO", "speaker": 5, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Sing. Loud.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": ["to everyone"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}