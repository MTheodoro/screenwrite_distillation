{"scene_id": "s00672", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00672.fountain", "heading": "INT. PLUMLEY'S CLOCK REPAIR - BACK WORKROOM - DAY", "cast": [{"id": 0, "name": "HORACE PLUMLEY", "names": ["HORACE PLUMLEY", "HORACE"], "gender": "m", "first": 2, "spoke": 3}, {"id": 1, "name": "CHESTER VOSS", "names": ["CHESTER VOSS", "CHESTER"], "gender": "m", "first": 3, "spoke": 2}, {"id": 2, "name": "WINNIFRED", "names": ["WINNIFRED"], "gender": "?", "first": 4, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. PLUMLEY'S CLOCK REPAIR - BACK WORKROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Forty ticking clocks, none agreeing.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "HORACE PLUMLEY, 60s, bow tie, loupe on his eye, bends over a gutted grandfather clock.", "para": 0, "sent": 1, "present": [0]}, {"u": 3, "kind": "action", "text": "CHESTER VOSS, 50s, a rival dealer in a camel coat, tiptoes in by the rear door.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "WINNIFRED, 60s, Horace's sister, sets down a tea tray.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "Horace, old friend. I'll give you five hundred for the Lindqvist clock.", "name": "CHESTER", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "It's not for sale.", "name": "HORACE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Everything is.", "name": "CHESTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "He reaches for the clock.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Horace grabs the pendulum.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Chester grabs the other end.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "They tug, nose to nose.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Gentlemen!", "name": "WINNIFRED", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Both men freeze.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "The pendulum swings between them and clangs a bell.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "They let go, then both lunge for the clock again and topple into a heap on the floor.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "He started it!", "name": "HORACE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "He did not. He's sitting on your hat.", "name": "WINNIFRED", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Chester pulls the hat from under him and offers it with a weak smile.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Horace snatches it.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Winnifred pours tea into three cups and hands one down to each of them.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Now. Five hundred?", "name": "WINNIFRED", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Make it six.", "name": "HORACE", "speaker": 0, "ext": [], "paren": ["sighs"], "dual": false, "present": [0, 1, 2]}]}