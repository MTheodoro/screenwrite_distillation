{"scene_id": "s00677", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00677.fountain", "heading": "INT. SUDS-N-GO LAUNDROMAT - NIGHT", "cast": [{"id": 0, "name": "ROSALIND", "names": ["ROSALIND"], "gender": "f", "first": 4, "spoke": 5}, {"id": 1, "name": "JUDE", "names": ["JUDE"], "gender": "?", "first": 7, "spoke": 6}, {"id": 2, "name": "NELL", "names": ["NELL"], "gender": "?", "first": 8, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. SUDS-N-GO LAUNDROMAT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Humming dryers.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Buzzing tube light.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain on glass.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ROSALIND, 40s, folds towels hard.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Snap.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Snap.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "JUDE, 12, sits on a washer, sneakers swinging, doing homework nobody asked about.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "NELL, 70s, in a quilted coat, watches both of them from a plastic chair.", "para": 1, "sent": 4, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Rosalind snaps a sheet.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "You folded that one already.", "name": "JUDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "No.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "She did, dear. Twice.", "name": "NELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "I'm not talking to you, Mom.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Nell nods, patient, as if this were weather.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "A dryer buzzes.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Nobody moves.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Mr. Pruitt said I could stay with Grandma if --", "name": "JUDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Don't.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I'm just saying.", "name": "JUDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "He could. It's a big house.", "name": "NELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Rosalind drops a towel.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Picks it up.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Folds it a third time.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Where's the other sock?", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Dad took it.", "name": "JUDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Rosalind's hands stop.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "A long beat.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "The tube light flickers.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Honey, get me a cup of cocoa from the machine.", "name": "NELL", "speaker": 2, "ext": [], "paren": ["to Jude"], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "It doesn't take dollars.", "name": "JUDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Then go find quarters.", "name": "NELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Jude slides off the washer, slow, watching.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "He leaves.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Rosalind keeps folding, fast now, jaw tight.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "You can stop the towels.", "name": "NELL", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "I can't.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Nell stands, crosses to the table, lays her hand flat over Rosalind's.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "The towel goes still between them.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Rosalind's shoulders shake once, silently.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Got one! Wait, it's a button.", "name": "JUDE", "speaker": 1, "ext": ["O.S."], "paren": ["far off, rattling a machine"], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Rosalind laughs once, wet, and wipes her face on the towel.", "para": 8, "sent": 0, "present": [0, 1, 2]}]}