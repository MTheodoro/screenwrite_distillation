{"scene_id": "s00682", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00682.fountain", "heading": "INT. LORNE HOUSE - LIBRARY - NIGHT", "cast": [{"id": 0, "name": "AUGUSTIN LORNE", "names": ["AUGUSTIN LORNE", "AUGUSTIN"], "gender": "?", "first": 4, "spoke": 8}, {"id": 1, "name": "BEATRIX", "names": ["BEATRIX"], "gender": "f", "first": 5, "spoke": 7}, {"id": 2, "name": "CEDRIC MOWBRAY", "names": ["CEDRIC MOWBRAY", "CEDRIC"], "gender": "?", "first": 6, "spoke": 7}, {"id": 3, "name": "HESTER QUAYLE", "names": ["HESTER QUAYLE", "HESTER"], "gender": "f", "first": 7, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. LORNE HOUSE - LIBRARY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A fire dying in a marble hearth.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Four chairs in a half-circle.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A decanter, four glasses, a ledger left open on the reading stand.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "AUGUSTIN LORNE, 60s, shrunken in a velvet smoking jacket, sits nearest the fire.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "His niece BEATRIX, 30s, stands behind his chair.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "CEDRIC MOWBRAY, 40s, the family solicitor, occupies a leather wingback.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "HESTER QUAYLE, 50s, the housekeeper, hovers at the door with her hands folded.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Beatrix pours for the men and does not pour for herself.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Cedric, the clause.", "name": "AUGUSTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "The clause is clear.", "name": "CEDRIC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Clear to whom?", "name": "BEATRIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "To anyone who reads.", "name": "CEDRIC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "I read it twice.", "name": "HESTER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Of course you did, Hester.", "name": "AUGUSTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "She was in the room when you signed.", "name": "BEATRIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "I was in the hall.", "name": "HESTER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Then you heard it through the door.", "name": "BEATRIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "The door was open.", "name": "HESTER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Doors are often open in this house.", "name": "CEDRIC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Not the study door.", "name": "AUGUSTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "No. The study door is always locked.", "name": "BEATRIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "It was open on Thursday.", "name": "HESTER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Thursday?", "name": "CEDRIC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "When the ledger went missing.", "name": "HESTER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "The ledger is here.", "name": "AUGUSTIN", "speaker": 0, "ext": [], "paren": ["slowly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Because someone put it back.", "name": "BEATRIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Or because it was never gone.", "name": "CEDRIC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Mr. Augustin, I told you I saw it on Thursday. Pages torn. Four of them.", "name": "HESTER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Four.", "name": "AUGUSTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "There are four of us.", "name": "BEATRIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "A silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "The fire pops.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Surely you are not suggesting --", "name": "CEDRIC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "I'm suggesting nothing. I'm counting.", "name": "BEATRIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Hester. The pages. Where?", "name": "AUGUSTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "In the second drawer of the hall cabinet. Under the umbrellas.", "name": "HESTER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "You looked?", "name": "CEDRIC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "I clean.", "name": "HESTER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Beatrix, fetch them.", "name": "AUGUSTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Beatrix does not move.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Cedric slowly sets his glass on the table, Hester's eyes find the carpet, and Augustin lifts the poker from its stand and holds it across his knees.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Whoever fetches them first.", "name": "AUGUSTIN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}