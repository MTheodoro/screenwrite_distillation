{"scene_id": "s00683", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00683.fountain", "heading": "EXT. SALT FLAT - DAY", "cast": [{"id": 0, "name": "NAOMI", "names": ["NAOMI"], "gender": "f", "first": 4, "spoke": 7}, {"id": 1, "name": "WOMAN", "names": ["WOMAN"], "gender": "?", "first": 10, "spoke": 5}, {"id": 2, "name": "ELSPETH", "names": ["ELSPETH"], "gender": "?", "first": 29, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SALT FLAT - DAY", "present": []}, {"u": 1, "kind": "action", "text": "White to the horizon.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Heat shimmer.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A burnt-out van tilts in the distance like a toy.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "NAOMI, 30s, sunburned, drags a jerry can by its handle.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her canteen is empty.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "She stops, swaying.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "dialogue", "text": "Keep walking. Keep walking.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0]}, {"u": 8, "kind": "action", "text": "A figure on the horizon.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Naomi shades her eyes.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "A WOMAN, 40s, in a ragged parka, wobbles closer.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She carries a water jug.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She sees Naomi and stops.", "para": 2, "sent": 4, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Is that water?", "name": "WOMAN", "speaker": 1, "ext": [], "paren": ["hoarse"], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Gas.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Damn.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Naomi sets down the can.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "The woman does the same with her jug.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "They stare across ten feet of white.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Where'd you come from?", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "East. A bus. I'm told there was a bus.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "There was. It left.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "The woman sits in the salt.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Naomi sits too.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Neither speaks.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "The wind scrapes the flat.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Anybody want to explain this?", "name": "NAOMI", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the sky"], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "What's your name?", "name": "WOMAN", "speaker": 1, "ext": [], "paren": ["to Naomi"], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Naomi.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Elspeth. My friends call me Elsie.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "ELSPETH nudges the jug across the salt.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Half each. You carry the gas. I carry the rest.", "name": "ELSPETH", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Naomi takes the jug.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "She drinks, passes it back, and nods.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "She'd have hated this, my mother. Heat.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Mine too.", "name": "ELSPETH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "They stand, shoulder to shoulder, and start toward the van.", "para": 7, "sent": 0, "present": [0, 1, 2]}]}