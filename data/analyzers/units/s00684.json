{"scene_id": "s00684", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00684.fountain", "heading": "INT. ASHGROVE MANOR - GREEN DRAWING ROOM - EVENING", "cast": [{"id": 0, "name": "BARNABY CREWE", "names": ["BARNABY CREWE", "CREWE"], "gender": "m", "first": 5, "spoke": 9}, {"id": 1, "name": "LADY PHILOMENA ASHGROVE", "names": ["LADY PHILOMENA ASHGROVE", "LADY PHILOMENA"], "gender": "?", "first": 6, "spoke": 7}, {"id": 2, "name": "ANSELM ROTH", "names": ["ANSELM ROTH", "ROTH"], "gender": "m", "first": 7, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. ASHGROVE MANOR - GREEN DRAWING ROOM - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Rain on tall windows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A grandfather clock.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A tea service on a low table.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A bust of a long-dead general on the mantel.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "BARNABY CREWE, 40s, a private inquirer in a rumpled coat, stands at the window with his back to the room.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "LADY PHILOMENA ASHGROVE, 70s, upright in a wing chair, regards him over the rim of her cup.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "DR. ANSELM ROTH, 50s, the family physician, sits on the settee with a black bag between his feet.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "She sets down her cup.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "He turns.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "You've been staring at that glass for ten minutes, Mr. Crewe.", "name": "LADY PHILOMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "It's an interesting pane.", "name": "CREWE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "It is a pane.", "name": "LADY PHILOMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "He moves to the mantel and runs his thumb over the bust, then wipes the dust on his handkerchief.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "She watches with disapproval.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Roth shifts and she glances at him.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Philomena, if Mr. Crewe has questions, let him ask.", "name": "ROTH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Thank you, Doctor.", "name": "CREWE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Ask, then.", "name": "LADY PHILOMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Who last saw Lord Ashgrove alive?", "name": "CREWE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I did.", "name": "LADY PHILOMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "I did.", "name": "ROTH", "speaker": 2, "ext": [], "paren": ["together with her"], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Both of you?", "name": "CREWE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "They look at each other.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "He leans forward, she lifts her chin.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "At dinner.", "name": "LADY PHILOMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "At the stairs, afterward.", "name": "ROTH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Which was first?", "name": "CREWE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Dinner.", "name": "LADY PHILOMENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "He was already tired.", "name": "ROTH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "She frowns at him.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "He studies the bag between his feet.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Crewe takes the poker from its stand, turns it over, and replaces it exactly where it was.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Doctor, what's in the bag?", "name": "CREWE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Medical instruments.", "name": "ROTH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "And the brown bottle?", "name": "CREWE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Roth's hand drops to the bag.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "She sets her cup down so softly it does not click.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "The clock begins to strike the hour, and in the third chime Crewe walks to the settee, kneels, and lifts the clasp.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Foxglove. Prepared.", "name": "CREWE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "It was for his heart.", "name": "LADY PHILOMENA", "speaker": 1, "ext": [], "paren": ["together with Roth"], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "It was for his heart.", "name": "ROTH", "speaker": 2, "ext": [], "paren": ["together with Lady Philomena"], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "They stop.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "The clock finishes.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Crewe stands with the bottle in his hand and looks from one to the other.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Strange. You rehearsed the same sentence.", "name": "CREWE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}