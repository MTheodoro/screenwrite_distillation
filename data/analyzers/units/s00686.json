{"scene_id": "s00686", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00686.fountain", "heading": "INT. NORTHBEAM SYNERGIES - OPEN OFFICE - MORNING", "cast": [{"id": 0, "name": "BRENDA KOWALCZYK", "names": ["BRENDA KOWALCZYK", "BRENDA"], "gender": "?", "first": 4, "spoke": 14}, {"id": 1, "name": "TREVOR NAKAMURA", "names": ["TREVOR NAKAMURA", "TREVOR"], "gender": "?", "first": 5, "spoke": 7}, {"id": 2, "name": "PRIYA VENKATARAMAN", "names": ["PRIYA VENKATARAMAN", "PRIYA"], "gender": "f", "first": 6, "spoke": 4}, {"id": 3, "name": "GUS TILLMAN", "names": ["GUS TILLMAN", "GUS"], "gender": "?", "first": 7, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. NORTHBEAM SYNERGIES - OPEN OFFICE - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Rows of identical desks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A motivational banner reads \"TOGETHER WE ALIGN.\"", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A broken printer wheezes in the corner.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "BRENDA KOWALCZYK, 50s, regional VP in a power blazer, stands on a chair with a clicker.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "TREVOR NAKAMURA, 30s, middle manager, holds a coffee like a shield.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "PRIYA VENKATARAMAN, 30s, a senior analyst with a headset around her neck, scrolls through a spreadsheet.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "GUS TILLMAN, 20s, an intern in a too-big tie, takes notes.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Team! Huddle up!", "name": "BRENDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Nobody huddles.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Trevor drifts closer.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Today we pivot. From synergy to hypersynergy.", "name": "BRENDA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Pivot where? We don't have a chair.", "name": "TREVOR", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Trevor, I heard that.", "name": "BRENDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "I said \"we don't have a chair.\" For the new hire.", "name": "TREVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "We hire the person, not the chair.", "name": "BRENDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Brenda, our Q3 numbers are down forty percent.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Which is why we pivot.", "name": "BRENDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "It would be easier to fix the number.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "We don't fix numbers, Priya. We reframe them.", "name": "BRENDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Can I ask a question?", "name": "GUS", "speaker": 3, "ext": [], "paren": ["raising a hand"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Gus. Welcome to the conversation.", "name": "BRENDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "What does hypersynergy mean?", "name": "GUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "It means synergy, but faster.", "name": "BRENDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "It means layoffs.", "name": "TREVOR", "speaker": 1, "ext": [], "paren": ["to Gus, low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "I heard that too.", "name": "BRENDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "I know. I wanted you to.", "name": "TREVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Brenda climbs down from the chair, slowly, crosses to Trevor, and lowers her voice to a whisper that carries across the entire floor.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "You're on a performance improvement plan.", "name": "BRENDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "For what?", "name": "TREVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "For saying \"layoffs\" out loud.", "name": "BRENDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Seven words. A new record.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": ["to herself, typing"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Does the plan come with a chair?", "name": "GUS", "speaker": 3, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Priya snorts.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Trevor stares at Brenda.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Brenda stares back.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Everyone back to your desks. We're going to have a very productive day.", "name": "BRENDA", "speaker": 0, "ext": [], "paren": ["to everyone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Nobody moves.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "The printer coughs and dies.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "I'm not on a plan.", "name": "TREVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "You are now.", "name": "BRENDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Then I quit.", "name": "TREVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Seconded.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Does that include interns?", "name": "GUS", "speaker": 3, "ext": [], "paren": ["very small"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Brenda looks at the banner, then at the three of them, then at the dead printer.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Her smile has not moved at all.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Everybody take fifteen. In fifteen minutes, we circle back to this.", "name": "BRENDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "She steps back up onto the chair.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}]}