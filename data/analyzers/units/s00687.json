{"scene_id": "s00687", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00687.fountain", "heading": "INT. CORBIN FARMHOUSE - CELLAR - NIGHT", "cast": [{"id": 0, "name": "CORBIN", "names": ["CORBIN"], "gender": "?", "first": 4, "spoke": 2}, {"id": 1, "name": "ALMA", "names": ["ALMA"], "gender": "m", "first": 5, "spoke": 2}, {"id": 2, "name": "JONAH PIKE", "names": ["JONAH PIKE", "JONAH"], "gender": "?", "first": 6, "spoke": 1}, {"id": 3, "name": "SADIE", "names": ["SADIE"], "gender": "?", "first": 7, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. CORBIN FARMHOUSE - CELLAR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dirt floor.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Jars of preserves.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "One bare bulb on a cord, swinging.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CORBIN, 50s, in a sweat-stained flannel, holds a lantern high.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "ALMA, 40s, his wife, grips the cellar ladder.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "JONAH PIKE, 20s, the hired hand, backs against a shelf.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "SADIE, 9, hugs a doll and stares at the far wall.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Something scratches.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Behind the wall.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Corbin lowers the lantern.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Rats.", "name": "CORBIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Rats don't knock.", "name": "ALMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Three slow knocks.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "From the other side.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Jonah slides along the shelf.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "A jar tips.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Smashes.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Sir. We should go up.", "name": "JONAH", "speaker": 2, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Quiet.", "name": "CORBIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Sadie walks to the wall.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Presses her ear to the dirt.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Sadie. Come here.", "name": "ALMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Sadie doesn't turn.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "It knows my name.", "name": "SADIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Alma lets go of the ladder.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Corbin swings the lantern toward the sound.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "A thin crack runs up the plaster.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "The bulb goes out.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Darkness.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Breathing.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Four of them.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Something wet drags along the floor.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}]}