{"scene_id": "s00689", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00689.fountain", "heading": "INT. MUSEUM OF CLOCKS - VAULT CORRIDOR - NIGHT", "cast": [{"id": 0, "name": "VESPER", "names": ["VESPER"], "gender": "f", "first": 3, "spoke": 3}, {"id": 1, "name": "ANTON KROL", "names": ["ANTON KROL"], "gender": "m", "first": 4, "spoke": 3}, {"id": 2, "name": "^ANTON KROL", "names": ["^ANTON KROL"], "gender": "?", "first": 4, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. MUSEUM OF CLOCKS - VAULT CORRIDOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Marble, silence, a thousand brass hearts ticking behind glass.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single laser, thin as a pencil line, hums across the corridor at ankle height.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "VESPER, 30s, in black from throat to boot, crouches before a keypad with a gloved thumb on her lip.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "ANTON KROL, 50s, her partner, broad and patient, kneels beside her holding a stethoscope against the vault door as if listening to a sleeping animal.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "Seven. Four. One.", "name": "VESPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Seven. Four. One.", "name": "ANTON KROL", "speaker": 1, "ext": [], "paren": ["simultaneously"], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Eight.", "name": "^ANTON KROL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Eight?", "name": "VESPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "The clock in the second room. It runs eight minutes fast.", "name": "ANTON KROL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "The keypad flickers green.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Then red.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "The ticking in the walls goes still, all at once.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Anton. Every clock just stopped.", "name": "VESPER", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Anton lifts the stethoscope from the door and holds out his open hand, palm flat, as if testing for rain.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Then somebody else is in here.", "name": "ANTON KROL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Vesper slides her pistol out.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "The laser along the floor blinks off.", "para": 4, "sent": 1, "present": [0, 1, 2]}]}