{"scene_id": "s00691", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00691.fountain", "heading": "EXT. THE WHISPER MARSH - DUSK", "cast": [{"id": 0, "name": "SORREL", "names": ["SORREL"], "gender": "?", "first": 4, "spoke": 7}, {"id": 1, "name": "TAMSIN", "names": ["TAMSIN"], "gender": "f", "first": 5, "spoke": 6}, {"id": 2, "name": "ORRIN", "names": ["ORRIN"], "gender": "?", "first": 6, "spoke": 9}, {"id": 3, "name": "BRIGID", "names": ["BRIGID"], "gender": "?", "first": 7, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "EXT. THE WHISPER MARSH - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "Black water, white reeds, and a mist that clings to the knees.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fireflies the size of thumbs drift between rotted posts.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A narrow plank path winds out of sight.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SORREL, 30s, a marsh-guide in oilcloth and thigh boots, leads with a long pole, testing each plank.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "TAMSIN, 20s, an apprentice healer with a satchel clutched across her chest, follows two steps behind.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "ORRIN, 50s, a one-eared merchant in a fur-lined cloak, labors in the middle with a heavy pack.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "BRIGID, 30s, a sell-sword with a cracked breastplate, brings up the rear and watches the reeds.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Stay on the planks. If you slip, don't thrash.", "name": "SORREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "What do I do?", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Hold still and call my name.", "name": "SORREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "And if you can't hold still?", "name": "ORRIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Then call louder.", "name": "SORREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "They walk.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "A heron lifts out of the reeds, and Brigid's hand goes to her hilt.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "We're being followed.", "name": "BRIGID", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "By what?", "name": "ORRIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "I don't know. It's quiet.", "name": "BRIGID", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Quiet is good.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Quiet is never good.", "name": "BRIGID", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Sorrel stops.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Tamsin bumps into her.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Sorry. Is something wrong?", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "The plank ahead is missing.", "name": "SORREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Missing how?", "name": "ORRIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Gone. Someone took it.", "name": "SORREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Or something did.", "name": "BRIGID", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "They peer ahead.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "The path ends in four feet of dark water, and past it, the plank resumes.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "We can jump that.", "name": "ORRIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Not with that pack.", "name": "SORREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Then I'll leave the pack.", "name": "ORRIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "You'll leave nothing. The pack is why we're here.", "name": "BRIGID", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "What's in the pack?", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Medicine. For the village at the far shore.", "name": "ORRIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "You said it was cloth.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "I said a lot of things.", "name": "ORRIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Orrin.", "name": "BRIGID", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Orrin sighs and unbuckles the pack.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Inside, wrapped in oilcloth, sits a small iron box with a hand-drawn seal.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "That's not medicine.", "name": "SORREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "It's humming.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": ["very quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "It always hums near water.", "name": "ORRIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Drop it in the marsh.", "name": "BRIGID", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "No.", "name": "ORRIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "It's what took the plank.", "name": "BRIGID", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Orrin closes the pack.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "In the reeds, something large and slow begins to move toward them, parting the white stalks without a sound.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}]}