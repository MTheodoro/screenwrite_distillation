{"scene_id": "s00692", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00692.fountain", "heading": "INT. CARGO WAREHOUSE - LOADING BAY 6 - NIGHT", "cast": [{"id": 0, "name": "AGENT FOLASADE ADEBAYO", "names": ["AGENT FOLASADE ADEBAYO"], "gender": "f", "first": 5, "spoke": 0}, {"id": 1, "name": "REUBEN MARSH", "names": ["REUBEN MARSH", "REUBEN"], "gender": "?", "first": 6, "spoke": 7}, {"id": 2, "name": "PD", "names": ["PD"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "FOLA", "names": ["FOLA"], "gender": "?", "first": 7, "spoke": 9}, {"id": 4, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 13, "spoke": 8}, {"id": 5, "name": "IMELDA DRAY", "names": ["IMELDA DRAY", "IMELDA"], "gender": "?", "first": 32, "spoke": 4}, {"id": 6, "name": "NIKOLAI", "names": ["NIKOLAI"], "gender": "?", "first": 43, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. CARGO WAREHOUSE - LOADING BAY 6 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Concrete.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Pallets.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Sodium lights buzzing.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A forklift idles.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "AGENT FOLASADE ADEBAYO, 30s, FBI jacket under a rain slicker, moves between shipping crates with her weapon low.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Behind her, REUBEN MARSH, 50s, local PD, wheezes, flashlight in hand.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Fola, wait.", "name": "REUBEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Keep your voice down.", "name": "FOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Nobody's here.", "name": "REUBEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Somebody dropped this.", "name": "FOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "She holds up a ring of keys.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Reuben shines the light on them.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "A STRANGER, 40s, in a dark wool coat, stands motionless at the end of the aisle.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Both swing their guns toward him.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Easy. Easy.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Hands where I can see them.", "name": "FOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "They're empty.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Name.", "name": "REUBEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "You first.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Fola takes a step forward.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "The Stranger smiles.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Agent Adebayo. You look tired.", "name": "STRANGER", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "How do you know my name?", "name": "FOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "I've read your reports.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "What reports?", "name": "REUBEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Reuben, don't.", "name": "FOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Detective Marsh. You should ask her about Lagos.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Reuben's light wavers on Fola's face.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "What's in Lagos?", "name": "REUBEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Nothing. He's playing us.", "name": "FOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Or I'm the only honest one here.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "IMELDA DRAY, 50s, steps out of the shadow behind Reuben, a silenced pistol pressed to the back of his neck.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "She is in a janitor's smock, calm as a clerk.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Drop it, Detective.", "name": "IMELDA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Reuben drops the flashlight.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "It rolls.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Imelda. Walk away.", "name": "FOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "I can't. Not until I get the ledger.", "name": "IMELDA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "I don't have it.", "name": "FOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "No. He does.", "name": "IMELDA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "All three look at the Stranger.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "He taps his coat.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "My name is Nikolai Orlov. I'd like to hand it over, if you'll all stop pointing things at me.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "dialogue", "text": "The ledger names every one of you.", "name": "NIKOLAI", "speaker": 6, "ext": [], "paren": ["CONT'D"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "Fola, what does he mean every one of us?", "name": "REUBEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "dialogue", "text": "It means somebody in this room is on the take.", "name": "FOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "dialogue", "text": "Or two.", "name": "IMELDA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "dialogue", "text": "Or three.", "name": "NIKOLAI", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "action", "text": "Silence.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "action", "text": "Rain on the roof.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "dialogue", "text": "I didn't do anything.", "name": "REUBEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "dialogue", "text": "Not yet.", "name": "NIKOLAI", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "action", "text": "Imelda cocks the pistol.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}]}