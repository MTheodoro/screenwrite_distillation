2, 3]}, {"u": 8, "kind": "action", "text": "In the doorway, an INTERN, 20s, holds a tray of pastries and wears a lanyard that says \"INTERN.\"", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Lovely morning.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Lovely.", "name": "KWAME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Lovely! We're so aligned.", "name": "SLOANE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Pink, yellow, blue.", "name": "PHIL", "speaker": 3, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "I brought croissants.", "name": "INTERN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Of course you did. You're our little sunbeam.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "The Intern sets down the tray.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Everyone takes one.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Everyone chews.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "A long, pleasant silence.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Marguerite and I wanted to thank you all for your hard work.", "name": "KWAME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Amazing work.", "name": "SLOANE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Sweetener's low.", "name": "PHIL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Phil, your numbers this quarter are impeccable.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Are they?", "name": "PHIL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Impeccable. Isn't that the word, Kwame?", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "It is.", "name": "KWAME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "The Intern smiles wider.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Sloane taps her iPad.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "So, as part of our culture refresh, we'll be transitioning a few roles.", "name": "SLOANE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Which roles?", "name": "PHIL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Phil.", "name": "KWAME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Which?", "name": "PHIL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Yours, dear.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Phil sets down the packets.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "The Intern's smile slips.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "I'm sorry, did you say transition?", "name": "INTERN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Offboarding, practically speaking.", "name": "SLOANE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Mine too?", "name": "INTERN", "speaker": 4, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Not at all. You'll be taking Phil's desk.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "I'm sorry. What's my name?", "name": "INTERN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Pardon?", "name": "KWAME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "You've called me intern for six months. I told you my name on day one.", "name": "INTERN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Did you? I'm sure it was lovely.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "It's Dewey.", "name": "INTERN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Dewey Park. I'm the one who built your billing system.", "name": "DEWEY", "speaker": 5, "ext": [], "paren": ["CONT'D"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "The fridge clicks.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "Phil, still holding a pink packet, looks at Dewey for the first time.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "He did.", "name": "PHIL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "We know.", "name": "KWAME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "Then you know the system doesn't run without me.", "name": "DEWEY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "We have a plan for that.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "Do you.", "name": "DEWEY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "He takes off the lanyard.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "Sets it on the tray.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "Then enjoy the croissants.", "name": "DEWEY", "speaker": 5, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}