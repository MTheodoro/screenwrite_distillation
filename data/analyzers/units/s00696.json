{"scene_id": "s00696", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00696.fountain", "heading": "EXT. ICE CAVE ENTRANCE - GLACIER - DAWN", "cast": [{"id": 0, "name": "ZEKE", "names": ["ZEKE"], "gender": "?", "first": 7, "spoke": 7}, {"id": 1, "name": "TALLMAN", "names": ["TALLMAN"], "gender": "?", "first": 7, "spoke": 0}, {"id": 2, "name": "ANNELIESE VOSS-HARTE", "names": ["ANNELIESE VOSS-HARTE", "ANNELIESE"], "gender": "?", "first": 8, "spoke": 3}, {"id": 3, "name": "RAFFERTY", "names": ["RAFFERTY"], "gender": "m", "first": 9, "spoke": 3}, {"id": 4, "name": "MAHINA", "names": ["MAHINA"], "gender": "f", "first": 10, "spoke": 3}, {"id": 5, "name": "SURVIVOR", "names": ["SURVIVOR"], "gender": "?", "first": 11, "spoke": 4}, {"id": 6, "name": "CORWIN", "names": ["CORWIN"], "gender": "m", "first": 31, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ICE CAVE ENTRANCE - GLACIER - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Blue-white.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wind.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Cliffs of ice stacked like cathedral organ pipes.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Five figures in orange survival suits crawl from a snow tunnel.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "Frost in their beards.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "Smoke from a flare rising behind them.", "para": 1, "sent": 2, "present": []}, {"u": 7, "kind": "action", "text": "EZEKIEL \"ZEKE\" TALLMAN, 40s, leader, hauls a rope.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "ANNELIESE VOSS-HARTE, 30s, glaciologist, clutches a sample case.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "RAFFERTY, 50s, a gruff guide, checks his compass.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "MAHINA, 20s, the youngest, coughs into her glove.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "A SURVIVOR, 40s, who joined them on the ice, trails behind in a torn red anorak.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Rest. Ten minutes.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "We can't. Whiteout's coming.", "name": "ANNELIESE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "She's right.", "name": "RAFFERTY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Ten.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Mahina sits.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Anneliese opens the case.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Cores are intact.", "name": "ANNELIESE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Good.", "name": "MAHINA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "The Survivor limps up.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Stops.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Looks at their faces.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "You have food?", "name": "SURVIVOR", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "A little.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Water?", "name": "SURVIVOR", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Melt snow.", "name": "RAFFERTY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Lighter?", "name": "SURVIVOR", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Rafferty tosses one.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "The man catches it, thanks him with a nod, and sits apart.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "What's your name?", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Corwin.", "name": "SURVIVOR", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "How'd you end up out here, Corwin?", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "Plane. Two days ago. Engines quit.", "name": "CORWIN", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "There were others?", "name": "MAHINA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "Yes.", "name": "CORWIN", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "Where?", "name": "ANNELIESE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "Corwin gestures north.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "dialogue", "text": "Gone.", "name": "CORWIN", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "No wreck on the radar. I checked.", "name": "RAFFERTY", "speaker": 3, "ext": [], "paren": ["low, to Zeke"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "Zeke studies Corwin.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "The man is feeding twigs to a tiny fire, humming.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "dialogue", "text": "Show me your hands.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": ["to Corwin"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "dialogue", "text": "Why?", "name": "CORWIN", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "dialogue", "text": "Humor me.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "action", "text": "Corwin opens his gloves.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "action", "text": "His fingers are clean, unfrostbitten, pink as a child's.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "dialogue", "text": "He's been out here two days?", "name": "MAHINA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "Corwin's humming stops.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "action", "text": "He closes his hands, rises smoothly, and the limp is gone.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "dialogue", "text": "Not two days.", "name": "CORWIN", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}