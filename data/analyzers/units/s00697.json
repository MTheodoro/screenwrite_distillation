{"scene_id": "s00697", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00697.fountain", "heading": "INT. VERONA GARDEN CENTER - GREENHOUSE - DAY", "cast": [{"id": 0, "name": "LUCIA ROSSI", "names": ["LUCIA ROSSI", "LUCIA"], "gender": "?", "first": 5, "spoke": 7}, {"id": 1, "name": "MATTEO BELLINI", "names": ["MATTEO BELLINI", "MATTEO"], "gender": "?", "first": 6, "spoke": 4}, {"id": 2, "name": "GWEN PRITCHARD", "names": ["GWEN PRITCHARD", "GWEN"], "gender": "f", "first": 7, "spoke": 6}, {"id": 3, "name": "DEV MALHOTRA", "names": ["DEV MALHOTRA", "DEV"], "gender": "?", "first": 8, "spoke": 6}, {"id": 4, "name": "AUNT FABIOLA", "names": ["AUNT FABIOLA"], "gender": "f", "first": 9, "spoke": 3}, {"id": 5, "name": "STAN", "names": ["STAN"], "gender": "?", "first": 10, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. VERONA GARDEN CENTER - GREENHOUSE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Humid.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of potted ferns and trays of seedlings.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A hand-painted sign: \"WEDDING SEASON SALE!\"", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Dust motes in the sun through fogged glass.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LUCIA ROSSI, 30s, in a green apron, lifts a tray of orchids.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "MATTEO BELLINI, 30s, in a suit, stands frozen with a bouquet of white roses.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "GWEN PRITCHARD, 30s, Matteo's fiancee, wears a sundress and sunglasses on her head.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "DEV MALHOTRA, 30s, Lucia's ex, leans against a potting bench.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "AUNT FABIOLA, 70s, in a floral housecoat, supervises from a folding chair.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "STAN, 50s, the garden center owner, holds a hose and a clipboard.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Lucia.", "name": "MATTEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Matteo.", "name": "LUCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "You two know each other?", "name": "GWEN", "speaker": 2, "ext": [], "paren": ["brightly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Know is a strong word.", "name": "DEV", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "They were engaged. Eight years ago. She threw a plate at him.", "name": "AUNT FABIOLA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "It was a saucer.", "name": "LUCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Folks, I've got a delivery of mulch at two. Can we speed this up?", "name": "STAN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Matteo, why didn't you tell me?", "name": "GWEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "I didn't think it mattered.", "name": "MATTEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "It matters.", "name": "DEV", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Dev, stay out of it.", "name": "LUCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "I'm standing in it.", "name": "DEV", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Stan, hose them.", "name": "AUNT FABIOLA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "I'm not hosing customers.", "name": "STAN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "I want the white roses. Just the roses.", "name": "GWEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "They're not for sale.", "name": "LUCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "I'm the customer.", "name": "GWEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "They're mine. I grew them.", "name": "LUCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Lucia, the wedding is Saturday.", "name": "MATTEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Then you'd better pick another florist.", "name": "LUCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Or another bride.", "name": "DEV", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Gwen takes off her sunglasses, slowly.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Say that again.", "name": "GWEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "I said --", "name": "DEV", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Enough! This is a greenhouse, not a telenovela.", "name": "AUNT FABIOLA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Actually, ma'am, the ficus are getting stressed.", "name": "STAN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Lucia sets down the orchids.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Matteo steps toward her, and the roses fall from his hands.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "I never stopped.", "name": "MATTEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Matteo!", "name": "GWEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Don't.", "name": "LUCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Finally.", "name": "DEV", "speaker": 3, "ext": [], "paren": ["under his breath"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Aunt Fabiola reaches into her housecoat, draws out a saucer, and holds it up like a trophy.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}