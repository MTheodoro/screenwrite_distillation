{"scene_id": "s00698", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00698.fountain", "heading": "EXT. BRIDGE OF MOSS - TWILIGHT", "cast": [{"id": 0, "name": "EIRWEN", "names": ["EIRWEN"], "gender": "?", "first": 3, "spoke": 4}, {"id": 1, "name": "BRAM", "names": ["BRAM"], "gender": "?", "first": 4, "spoke": 2}, {"id": 2, "name": "OLD NETTLE", "names": ["OLD NETTLE"], "gender": "?", "first": 5, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. BRIDGE OF MOSS - TWILIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A stone bridge arches over a stream that runs upward, against gravity, into a pink sky.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Lanterns drift like soap bubbles.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "EIRWEN, 30s, a ferrywoman with silver-streaked braids, sits on the parapet mending a net.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "BRAM, 20s, in a tunic too thin for the evening, stands at the near end with a satchel.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "OLD NETTLE, 80s, a toad-faced hermit, squats on the far end and eats a pear.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "Bram steps onto the bridge.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "The stones hum under his boot.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "You are early.", "name": "EIRWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "I walked all night.", "name": "BRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "You are still early.", "name": "EIRWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He reaches the middle.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Nettle chews.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Toll.", "name": "OLD NETTLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Bram opens the satchel.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Takes out a small bell.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Holds it out.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Nettle looks at it without touching it.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "That's not what she took last time.", "name": "OLD NETTLE", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Last time was not him.", "name": "EIRWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Bram lowers the bell.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "The stream runs up through the air behind them.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Is it enough?", "name": "BRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Eirwen finishes a knot.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Bites the thread.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Ask again at dawn.", "name": "EIRWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}