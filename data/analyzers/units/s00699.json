{"scene_id": "s00699", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00699.fountain", "heading": "EXT. SHELLED FARMHOUSE - DAWN", "cast": [{"id": 0, "name": "BRANDT", "names": ["BRANDT"], "gender": "m", "first": 5, "spoke": 7}, {"id": 1, "name": "ACHTERBERG", "names": ["ACHTERBERG"], "gender": "m", "first": 6, "spoke": 3}, {"id": 2, "name": "YOUNG SOLDIER", "names": ["YOUNG SOLDIER"], "gender": "?", "first": 7, "spoke": 2}, {"id": 3, "name": "KOWALSKI", "names": ["KOWALSKI"], "gender": "?", "first": 18, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SHELLED FARMHOUSE - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Smoke.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rubble.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A dead cow.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Ahead, a treeline hums with distant engines.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SGT. BRANDT, 40s, crouches behind a half-wall, rifle across his knees.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "LT. ACHTERBERG, 30s, studies a map, mud on his glasses.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "A YOUNG SOLDIER, 19, trembles beside them, helmet too big.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Heads down. Listen.", "name": "BRANDT", "speaker": 0, "ext": [], "paren": ["to everyone"], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "The engines swell.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "The Young Soldier lifts his head.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Down!", "name": "BRANDT", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Achterberg folds the map.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Armor. Two, maybe three.", "name": "ACHTERBERG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Our guns?", "name": "BRANDT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Dead.", "name": "ACHTERBERG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Mama. Mama. Mama.", "name": "YOUNG SOLDIER", "speaker": 2, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "What's your name, son?", "name": "BRANDT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Kowalski.", "name": "YOUNG SOLDIER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Kowalski. Look at me. On my word, you run for the ditch. You don't stop.", "name": "BRANDT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Sergeant, I can't --", "name": "KOWALSKI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "You can.", "name": "BRANDT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "A shell lands close.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Dirt rains on all three of them.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Now?", "name": "ACHTERBERG", "speaker": 1, "ext": [], "paren": ["to Brandt"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Now!", "name": "BRANDT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}