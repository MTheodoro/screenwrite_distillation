{"scene_id": "s00701", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00701.fountain", "heading": "INT. WESTSIDE MINI-GOLF - WINDMILL HOLE - SUNSET", "cast": [{"id": 0, "name": "JAMAL", "names": ["JAMAL"], "gender": "?", "first": 3, "spoke": 1}, {"id": 1, "name": "SKYE", "names": ["SKYE"], "gender": "f", "first": 4, "spoke": 2}, {"id": 2, "name": "MARCUS", "names": ["MARCUS"], "gender": "f", "first": 5, "spoke": 0}, {"id": 3, "name": "DOLORES", "names": ["DOLORES"], "gender": "?", "first": 6, "spoke": 2}, {"id": 4, "name": "PIM", "names": ["PIM"], "gender": "?", "first": 7, "spoke": 1}, {"id": 5, "name": "^MARCUS", "names": ["^MARCUS"], "gender": "?", "first": 11, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. WESTSIDE MINI-GOLF - WINDMILL HOLE - SUNSET", "present": []}, {"u": 1, "kind": "action", "text": "Fake turf, a creaking windmill, a sign: \"HOLE 9 - PAR 3.\"", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Plastic gnomes line the rail.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "JAMAL, 16, in a faded band tee, leans on his putter.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "SKYE, 16, purple streaks in her hair, chews gum.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "MARCUS, 17, stands too close to her.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "DOLORES, 60s, the attendant in a visor, perches on a stool with a clipboard.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "PIM, 12, Skye's little brother, crouches to peer into the windmill.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "Last group. Hole nine closes in five.", "name": "DOLORES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Skye, you're up.", "name": "JAMAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "I know.", "name": "SKYE", "speaker": 1, "ext": [], "paren": ["together"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "I know.", "name": "^MARCUS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "They glance at each other.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "Marcus looks away first.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "Skye lines up the putt.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Don't hit it too hard! The blade will smack it back!", "name": "PIM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Pim, back off.", "name": "SKYE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "He takes two steps back.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "She putts.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "The ball rolls, enters the windmill, and clatters out the wrong side.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Marcus laughs.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Skye glares.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Jamal hands her another ball without a word.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "That's a six.", "name": "DOLORES", "speaker": 3, "ext": [], "paren": ["writing"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}