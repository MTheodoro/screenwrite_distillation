{"scene_id": "s00702", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00702.fountain", "heading": "INT. THRONE ROOM OF OSRIC - DAY", "cast": [{"id": 0, "name": "KING OSRIC", "names": ["KING OSRIC"], "gender": "m", "first": 3, "spoke": 3}, {"id": 1, "name": "^LADY VANETH", "names": ["LADY VANETH", "^LADY VANETH"], "gender": "?", "first": 4, "spoke": 3}, {"id": 2, "name": "PIBBLE", "names": ["PIBBLE"], "gender": "m", "first": 5, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. THRONE ROOM OF OSRIC - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A hall of cracked marble and tattered banners.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dust in the shafts of light.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "KING OSRIC, 60s, slumped on a tarnished throne, tugs his gray beard.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "LADY VANETH, 40s, in a mourning gown, stands rigid at the foot of the dais.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "PIBBLE, the court fool, 30s, juggles three wooden spoons on the steps.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Vaneth. Another harvest report?", "name": "KING OSRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "The fields lie fallow, Majesty.", "name": "LADY VANETH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "The fields lie fallow, Majesty.", "name": "PIBBLE", "speaker": 2, "ext": [], "paren": ["together with Lady Vaneth"], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "The fields lie fallow, Majesty.", "name": "^LADY VANETH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Both stop.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Pibble catches a spoon and bows.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Lady Vaneth does not.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "You rehearse together, I see.", "name": "KING OSRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "We have a duet, sire.", "name": "PIBBLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "We have no such thing.", "name": "LADY VANETH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Pibble, play me a song.", "name": "KING OSRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Pibble tucks the spoons under his arm and hums.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "The King nods slowly.", "para": 3, "sent": 1, "present": [0, 1, 2]}]}