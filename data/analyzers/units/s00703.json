{"scene_id": "s00703", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00703.fountain", "heading": "INT. TRENCH DUGOUT - NIGHT", "cast": [{"id": 0, "name": "CAPTAIN OSTRANDER", "names": ["CAPTAIN OSTRANDER", "OSTRANDER"], "gender": "m", "first": 3, "spoke": 3}, {"id": 1, "name": "LT. PRUITT", "names": ["LT. PRUITT", "PRUITT"], "gender": "?", "first": 7, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. TRENCH DUGOUT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Timber props, a guttering candle, a field radio crackling on an ammo crate.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Shells thump overhead and dust sifts down.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "CAPTAIN OSTRANDER, 40s, sits against the wall with his helmet in his lap.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "He reaches for the handset, lifts it, and puts it down.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "action", "text": "He lifts it again.", "para": 1, "sent": 2, "present": [0]}, {"u": 6, "kind": "dialogue", "text": "Battalion, this is Fox Two. Do you read?", "name": "OSTRANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 7, "kind": "dialogue", "text": "Fox Two, Battalion. We read you. Say your status.", "name": "LT. PRUITT", "speaker": 1, "ext": ["V.O."], "paren": ["radio, faint"], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He closes his eyes.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "When he opens them he is steadier.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "We are holding. Half the company is gone. He wants us to fall back.", "name": "OSTRANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Negative, Fox Two. Hold position. Reinforcements at oh-four-hundred.", "name": "PRUITT", "speaker": 1, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Ostrander laughs, short and dry.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He wipes his face with a gloved hand.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "A shell lands closer.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "The candle gutters out.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "They'll be late.", "name": "OSTRANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Say again?", "name": "PRUITT", "speaker": 1, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He sets the handset in its cradle, and in the dark, listens.", "para": 4, "sent": 0, "present": [0, 1]}]}