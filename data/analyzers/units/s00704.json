{"scene_id": "s00704", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00704.fountain", "heading": "EXT. DEAD MULE CREEK - HOMESTEAD PORCH - DAWN", "cast": [{"id": 0, "name": "SHERIFF AMOS TULL", "names": ["SHERIFF AMOS TULL", "AMOS"], "gender": "m", "first": 5, "spoke": 11}, {"id": 1, "name": "JOSEPHINE CRANE", "names": ["JOSEPHINE CRANE", "JOSEPHINE"], "gender": "?", "first": 6, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DEAD MULE CREEK - HOMESTEAD PORCH - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A sagging cabin of sun-bleached cedar.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A rusted washtub.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A windmill ticks in the thin wind.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The prairie runs flat to the horizon, gold and empty.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SHERIFF AMOS TULL, 60s, gray mustache, dusty duster, sits on the top step with his hat in his hands.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "JOSEPHINE CRANE, 40s, sunburned, in a man's shirt and canvas trousers, stands at the screen door with a shotgun cradled like a baby.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Morning, Josephine.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Sheriff.", "name": "JOSEPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Coffee on?", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Not for you.", "name": "JOSEPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Fair enough.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "You ride all night?", "name": "JOSEPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Most of it.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "For what?", "name": "JOSEPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "For your husband.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "He's not here.", "name": "JOSEPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "I know. I found his horse at the creek.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "That mare throws riders.", "name": "JOSEPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "She does. Wasn't thrown, though. Wasn't anything. Just standing there, saddle empty.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Then he walked off.", "name": "JOSEPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Without his boots?", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "He doesn't like boots.", "name": "JOSEPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Josephine.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "I said he doesn't like boots.", "name": "JOSEPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I'm too old and too tired to argue. Is he in the cellar?", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "No.", "name": "JOSEPHINE", "speaker": 1, "ext": [], "paren": ["after a beat"], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "The well, then.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "She doesn't answer.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "The windmill ticks.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "He rises, puts his hat on, and she lowers the shotgun until the barrels touch the porch boards.", "para": 2, "sent": 2, "present": [0, 1]}]}