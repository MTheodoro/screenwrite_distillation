{"scene_id": "s00705", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00705.fountain", "heading": "INT. FINCH & DAUGHTERS PIANO MOVERS - TRUCK BED - DAY", "cast": [{"id": 0, "name": "BARRY FINCH", "names": ["BARRY FINCH", "BARRY"], "gender": "?", "first": 3, "spoke": 5}, {"id": 1, "name": "LOLA SANTANGELO", "names": ["LOLA SANTANGELO", "LOLA"], "gender": "?", "first": 4, "spoke": 4}, {"id": 2, "name": "KENJI MORI", "names": ["KENJI MORI", "KENJI"], "gender": "?", "first": 5, "spoke": 2}, {"id": 3, "name": "GLORIA DUPREE", "names": ["GLORIA DUPREE", "GLORIA"], "gender": "?", "first": 18, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. FINCH & DAUGHTERS PIANO MOVERS - TRUCK BED - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A grand piano wrapped in blankets and straps, wedged against a ramp.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Daylight spills in the open back.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "BARRY FINCH, 50s, sweating through a company polo, pushes from behind.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "LOLA SANTANGELO, 30s, in work gloves, pulls from the front.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "KENJI MORI, 20s, the new hire, stands on the ramp holding a clipboard and no idea.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "On three. One. Two --", "name": "BARRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Not on three. After three.", "name": "LOLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "That's what I said.", "name": "BARRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "You said \"on.\"", "name": "KENJI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Thank you, Kenji.", "name": "BARRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "They heave.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "The piano rolls three feet and stops.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Barry slips; Lola grabs the strap; the piano rocks.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "They both freeze as it teeters and then settles.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Nobody breathe.", "name": "LOLA", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "I'm breathing.", "name": "BARRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Breathe quieter.", "name": "LOLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "GLORIA DUPREE, 60s, the customer, in a silk robe and curlers, strides up the driveway with a pastry box.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Is that my Steinway?", "name": "GLORIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Yes, ma'am.", "name": "KENJI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "It's backward.", "name": "GLORIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Barry and Lola look at each other.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Both groan.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Kenji drops the clipboard.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "It clatters down the ramp, and the piano, as if answering, begins to roll.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Kenji!", "name": "LOLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Catch it!", "name": "BARRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "All three dive.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "The piano stops two inches from Gloria's slippers.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "She opens the pastry box and offers a donut.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Anyone?", "name": "GLORIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}