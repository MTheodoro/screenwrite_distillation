{"scene_id": "s00706", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00706.fountain", "heading": "INT. ALBRECHT HOUSE - KITCHEN - MORNING", "cast": [{"id": 0, "name": "MINA", "names": ["MINA"], "gender": "?", "first": 3, "spoke": 6}, {"id": 1, "name": "RAYMOND", "names": ["RAYMOND"], "gender": "?", "first": 8, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. ALBRECHT HOUSE - KITCHEN - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Yellow curtains, a toaster with a sticker of a cat on it, a calendar with a drawing of the sun.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cereal bowls in a sink.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "MINA, 8, in rain boots and pajamas, stands on a chair at the counter.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "She holds a spoon like a microphone.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "action", "text": "A cordless phone on the table rings.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She picks it up.", "para": 2, "sent": 1, "present": [0]}, {"u": 7, "kind": "dialogue", "text": "Hello? This is Mina.", "name": "MINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 8, "kind": "dialogue", "text": "Mina-bean. It's Dad.", "name": "RAYMOND", "speaker": 1, "ext": ["V.O."], "paren": ["phone"], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Where are you?", "name": "MINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Airport. The plane is late.", "name": "RAYMOND", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Again?", "name": "MINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Again. Is Grandma there?", "name": "RAYMOND", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "She's in the garden. She's yelling at the tomatoes.", "name": "MINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Tell her I said hi.", "name": "RAYMOND", "speaker": 1, "ext": ["V.O."], "paren": ["laughing"], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I will.", "name": "MINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She sets the spoon down.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Looks at the calendar.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Dad? Can you still make my recital?", "name": "MINA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Wouldn't miss it.", "name": "RAYMOND", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She nods and hangs up.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Outside, a voice calls over the tomatoes.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Mina grins.", "para": 4, "sent": 2, "present": [0, 1]}]}