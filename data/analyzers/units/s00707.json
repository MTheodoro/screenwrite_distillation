kind": "action", "text": "Nadia glances at the door.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Moe.", "name": "VINCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Yeah?", "name": "MOE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Whose turn was it to lock up?", "name": "VINCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Mine.", "name": "MOE", "speaker": 2, "ext": [], "paren": ["together with Dolly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Hers.", "name": "^DOLLY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "They look at each other.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Dolly's fold goes crooked.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Which?", "name": "VINCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "I locked it.", "name": "MOE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "I saw him. He locked it.", "name": "DOLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Vince sets down the cash.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Nadia presses the machine.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "It hisses.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Steam hides her face.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Kid, you got somewhere to be?", "name": "VINCE", "speaker": 0, "ext": [], "paren": ["to Nadia"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "No, sir.", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "You keep looking at that door.", "name": "VINCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Nadia lets go of the machine.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "A beat.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Moe picks up the iron again.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Behind her, the front bell chimes.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}]}