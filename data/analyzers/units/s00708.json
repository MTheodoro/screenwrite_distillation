{"scene_id": "s00708", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00708.fountain", "heading": "INT. BLACKWOOD LODGE - GREAT ROOM - NIGHT", "cast": [{"id": 0, "name": "PROFESSOR QUENTIN LAIRD", "names": ["PROFESSOR QUENTIN LAIRD", "QUENTIN"], "gender": "m", "first": 5, "spoke": 9}, {"id": 1, "name": "ODETTE", "names": ["ODETTE"], "gender": "f", "first": 6, "spoke": 3}, {"id": 2, "name": "BASIL", "names": ["BASIL"], "gender": "m", "first": 7, "spoke": 5}, {"id": 3, "name": "NGOZI", "names": ["NGOZI"], "gender": "f", "first": 8, "spoke": 4}, {"id": 4, "name": "HARLAN", "names": ["HARLAN"], "gender": "m", "first": 9, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. BLACKWOOD LODGE - GREAT ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A hunting lodge in deep snow.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Antlers on every wall.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A fire roars in a stone hearth.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Outside, a blizzard howls.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "PROFESSOR QUENTIN LAIRD, 60s, in a cardigan, stands before the fire.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "ODETTE, 30s, a journalist, sits cross-legged on a rug with a notebook.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "BASIL, 40s, the caretaker, nurses a whiskey at the bar.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "NGOZI, 30s, a doctor, stares at her phone, which shows no bars.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "HARLAN, 50s, in a camouflage vest, paces behind the sofa.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "I appreciate your patience. As you can see, we are snowed in.", "name": "QUENTIN", "speaker": 0, "ext": [], "paren": ["to everyone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "For how long?", "name": "ODETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Two days. Maybe three.", "name": "BASIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "No signal. Of course.", "name": "NGOZI", "speaker": 3, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Who called us here?", "name": "HARLAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "I did.", "name": "QUENTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "You said it was a reunion.", "name": "HARLAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "It was.", "name": "QUENTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Then why are we missing someone?", "name": "HARLAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Nobody answers.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "The fire cracks.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "You said the sixth guest would come at nine.", "name": "ODETTE", "speaker": 1, "ext": [], "paren": ["to Quentin"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "He will.", "name": "QUENTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "It's past eleven.", "name": "BASIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "He is very punctual, when he wants to be.", "name": "QUENTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Ngozi pockets her phone.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Harlan's pacing stops.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Quentin, who is he?", "name": "NGOZI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Someone we all knew, a long time ago.", "name": "QUENTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Name.", "name": "HARLAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Teddy Marsh.", "name": "QUENTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Basil drops his glass.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "It shatters.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Odette stops writing.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Teddy died. Twenty years ago.", "name": "BASIL", "speaker": 2, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Did he?", "name": "QUENTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "The front door rattles.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Everyone turns.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "The wind howls, and the rattling stops.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Quentin smiles faintly into the fire.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Stay calm. Stay calm.", "name": "ODETTE", "speaker": 1, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Basil. Check the door.", "name": "NGOZI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Why me?", "name": "BASIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Because you're the caretaker.", "name": "NGOZI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "It's not in my contract.", "name": "BASIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Harlan crosses the room and lays his hand on the latch.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "The rattling begins again, softer, and he draws back.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "Does anyone else hear that?", "name": "HARLAN", "speaker": 4, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Odette closes her notebook.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Quentin sits, finally, in the leather chair, and folds his hands.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "That would be him.", "name": "QUENTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}