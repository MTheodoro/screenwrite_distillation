{"scene_id": "s00710", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00710.fountain", "heading": "INT. TRELAWNEY HOUSE - FRONT HALL - LATE AFTERNOON", "cast": [{"id": 0, "name": "AGNES TRELAWNEY", "names": ["AGNES", "AGNES TRELAWNEY"], "gender": "f", "first": 7, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. TRELAWNEY HOUSE - FRONT HALL - LATE AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "A long hallway, floored in black-and-white tile, lined with portraits of unsmiling ancestors.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A grandfather clock.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dust in the window light.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A telephone table with an old answering machine blinking red.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The machine clicks.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "Whirs.", "para": 1, "sent": 1, "present": []}, {"u": 7, "kind": "dialogue", "text": "You've reached the Trelawney residence. We can't come to the phone right now. Leave a message and we'll ring you back.", "name": "AGNES", "speaker": 0, "ext": ["V.O."], "paren": ["recorded, bright"], "dual": false, "present": [0]}, {"u": 8, "kind": "action", "text": "BEEP.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "dialogue", "text": "Hello? It's me. It's Agnes. I know you're there. Pick up.", "name": "AGNES", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": ["recorded, older, hoarse"], "dual": false, "present": [0]}, {"u": 10, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "The machine clicks off.", "para": 3, "sent": 1, "present": [0]}, {"u": 12, "kind": "action", "text": "The front door opens.", "para": 4, "sent": 0, "present": [0]}, {"u": 13, "kind": "action", "text": "AGNES TRELAWNEY, 70s, in a long wool coat, rain on her shoulders, steps in.", "para": 4, "sent": 1, "present": [0]}, {"u": 14, "kind": "action", "text": "A battered leather suitcase in one hand, a key on a lanyard around her neck.", "para": 4, "sent": 2, "present": [0]}, {"u": 15, "kind": "action", "text": "She shuts the door slowly and stands listening to the house.", "para": 4, "sent": 3, "present": [0]}, {"u": 16, "kind": "dialogue", "text": "Hello?", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 17, "kind": "action", "text": "The clock ticks.", "para": 5, "sent": 0, "present": [0]}, {"u": 18, "kind": "action", "text": "She sets down the suitcase and crosses to the telephone table.", "para": 5, "sent": 1, "present": [0]}, {"u": 19, "kind": "dialogue", "text": "Four messages. Who calls a house that has been empty for a year?", "name": "AGNES", "speaker": 0, "ext": ["CONT'D"], "paren": ["to herself"], "dual": false, "present": [0]}, {"u": 20, "kind": "action", "text": "She presses the button.", "para": 6, "sent": 0, "present": [0]}, {"u": 21, "kind": "dialogue", "text": "Mother, it's me. Please call me back.", "name": "AGNES", "speaker": 0, "ext": ["V.O."], "paren": ["recorded, young"], "dual": false, "present": [0]}, {"u": 22, "kind": "action", "text": "She stops the machine.", "para": 7, "sent": 0, "present": [0]}, {"u": 23, "kind": "action", "text": "Presses it again.", "para": 7, "sent": 1, "present": [0]}, {"u": 24, "kind": "dialogue", "text": "Mother, it's me.", "name": "AGNES", "speaker": 0, "ext": ["V.O."], "paren": ["recorded, young"], "dual": false, "present": [0]}, {"u": 25, "kind": "action", "text": "She stops it.", "para": 8, "sent": 0, "present": [0]}, {"u": 26, "kind": "action", "text": "Her hand trembles on the casing.", "para": 8, "sent": 1, "present": [0]}, {"u": 27, "kind": "dialogue", "text": "That was my voice.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 28, "kind": "action", "text": "She lifts the receiver, listens to the dial tone, and sets it back.", "para": 9, "sent": 0, "present": [0]}, {"u": 29, "kind": "action", "text": "In the mirror above the table, the hall behind her is empty.", "para": 9, "sent": 1, "present": [0]}, {"u": 30, "kind": "dialogue", "text": "It's me, mother. I'm home.", "name": "AGNES", "speaker": 0, "ext": ["CONT'D"], "paren": ["softly"], "dual": false, "present": [0]}, {"u": 31, "kind": "action", "text": "Somewhere upstairs a door closes, gently, as if in answer.", "para": 10, "sent": 0, "present": [0]}]}