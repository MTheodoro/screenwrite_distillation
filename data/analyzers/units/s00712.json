{"scene_id": "s00712", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00712.fountain", "heading": "INT. PRECINCT 9 - INTERVIEW ROOM - NIGHT", "cast": [{"id": 0, "name": "OFFICER TAMAR HAIM", "names": ["OFFICER TAMAR HAIM", "TAMAR"], "gender": "?", "first": 5, "spoke": 8}, {"id": 1, "name": "UNKNOWN MAN", "names": ["UNKNOWN MAN"], "gender": "?", "first": 6, "spoke": 2}, {"id": 2, "name": "DISPATCH", "names": ["DISPATCH"], "gender": "?", "first": 12, "spoke": 3}, {"id": 3, "name": "DESMOND", "names": ["DESMOND"], "gender": "?", "first": 15, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. PRECINCT 9 - INTERVIEW ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cinderblock.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A table bolted to the floor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A two-way mirror.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A fluorescent tube with a wasp trapped inside it.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "OFFICER TAMAR HAIM, 30s, in uniform, sits with a legal pad.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across from her, an UNKNOWN MAN, 40s, in a damp jacket, holds a paper cup he has not drunk from.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Name.", "name": "TAMAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You tell me.", "name": "UNKNOWN MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "That's not how this works.", "name": "TAMAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Then I'm waiting.", "name": "UNKNOWN MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "A radio on Tamar's shoulder crackles.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Unit Nine, prints came back on your guy.", "name": "DISPATCH", "speaker": 2, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Tamar thumbs the mic.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Go ahead, Dispatch.", "name": "TAMAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Desmond Pryce. Forty-one. Two priors. Last known address, a storage unit off Route 6.", "name": "DISPATCH", "speaker": 2, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "She glances at the man.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "He keeps his eyes on the table.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Mr. Pryce.", "name": "TAMAR", "speaker": 0, "ext": [], "paren": ["to the man"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Don't.", "name": "DESMOND", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "That's your name?", "name": "TAMAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "It was my father's.", "name": "DESMOND", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Mr. Pryce, why are you holding the cup?", "name": "TAMAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Because my hands shake.", "name": "DESMOND", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Unit Nine, also, the storage unit's been flagged. Smell reported.", "name": "DISPATCH", "speaker": 2, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Desmond sets the cup down very carefully.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "What's in unit one-forty?", "name": "TAMAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Nothing you want.", "name": "DESMOND", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "That isn't a no.", "name": "TAMAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}