{"scene_id": "s00714", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00714.fountain", "heading": "INT. MARLIN HEIGHTS HIGH SCHOOL - GYMNASIUM - NIGHT", "cast": [{"id": 0, "name": "COACH RUSTY CALHOUN", "names": ["COACH RUSTY CALHOUN", "COACH CALHOUN", "^COACH CALHOUN"], "gender": "m", "first": 5, "spoke": 8}, {"id": 1, "name": "TAMIKA BOONE", "names": ["TAMIKA BOONE", "TAMIKA"], "gender": "m", "first": 6, "spoke": 2}, {"id": 2, "name": "DMITRI VOLKOV", "names": ["DMITRI VOLKOV", "DMITRI"], "gender": "m", "first": 7, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. MARLIN HEIGHTS HIGH SCHOOL - GYMNASIUM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Bleachers half full.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A banner: \"STATE SEMIFINAL.\"", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The scoreboard reads 58-58 with 0:04 left.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A buzzer hangs in the air.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "COACH RUSTY CALHOUN, 50s, in a windbreaker and clipboard, crouches at the sideline in the huddle.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "TAMIKA BOONE, 17, the point guard, sweat-soaked jersey, kneels beside him.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "DMITRI VOLKOV, 18, the center, towers over both, towel around his neck.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Four seconds. Ball goes in at half-court. Tamika, you take it. Dmitri, screen.", "name": "COACH CALHOUN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Coach, they'll double me.", "name": "TAMIKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "They'll double her.", "name": "DMITRI", "speaker": 2, "ext": [], "paren": ["together with Tamika"], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "They'll double you.", "name": "^COACH CALHOUN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "All three stop.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Dmitri grins.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Tamika laughs, short, nervous.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Then Dmitri slips the screen. Roll to the basket. Tamika, you hit him.", "name": "COACH CALHOUN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Over three defenders?", "name": "DMITRI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Over a hundred. You're seven feet of Ukrainian pride.", "name": "COACH CALHOUN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "I'm six-eight.", "name": "DMITRI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "And pride.", "name": "COACH CALHOUN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "The horn sounds.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "They break the huddle.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Calhoun grips Tamika's shoulder.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Whatever happens, I'm proud of you.", "name": "COACH CALHOUN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "That's what you say before we lose.", "name": "TAMIKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "That's what I say before we win, too.", "name": "COACH CALHOUN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The referee blows the whistle.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Dmitri steps up.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Tamika takes the ball at midcourt, faces the double team, and for one second looks at the rafters.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "She whips the pass over the defenders' heads.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Dmitri catches it at the rim, rises, and jams it through just as the horn blares.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The gym explodes.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Calhoun drops his clipboard.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Nobody tell them I cried.", "name": "COACH CALHOUN", "speaker": 0, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}]}