{"scene_id": "s00715", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00715.fountain", "heading": "INT. STRAND FARMHOUSE - KITCHEN - NIGHT", "cast": [{"id": 0, "name": "HAZEL STRAND", "names": ["HAZEL STRAND", "HAZEL"], "gender": "f", "first": 4, "spoke": 7}, {"id": 1, "name": "EWAN BLYTHE", "names": ["EWAN BLYTHE", "EWAN"], "gender": "m", "first": 5, "spoke": 7}, {"id": 2, "name": "MAGS DELANEY", "names": ["MAGS DELANEY", "MAGS"], "gender": "f", "first": 6, "spoke": 3}, {"id": 3, "name": "DEPUTY CUTTER", "names": ["DEPUTY CUTTER"], "gender": "?", "first": 17, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. STRAND FARMHOUSE - KITCHEN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A big country kitchen: scarred oak table, iron range, a window onto black fields.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A hurricane lamp.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A radio on the counter.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "HAZEL STRAND, 40s, in a flannel nightgown with a shawl, stands at the sink pumping water.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her brother-in-law EWAN BLYTHE, 50s, leans against the pantry door with a shotgun broken over his arm.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "At the table, MAGS DELANEY, 12, the neighbor's girl, sits wrapped in a quilt, her feet drawn up under her.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Mags, drink your milk.", "name": "HAZEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "It's cold.", "name": "MAGS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "It's meant to be.", "name": "HAZEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Ewan peers through the window curtains.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Nothing yet.", "name": "EWAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "There won't be.", "name": "HAZEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "You don't know that.", "name": "EWAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I do.", "name": "HAZEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "The radio crackles.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "A man's voice, thin with static.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Strand place, this is Cutter. Come in.", "name": "DEPUTY CUTTER", "speaker": 3, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Ewan snaps the shotgun shut and crosses to the radio.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Hazel lifts Mags's chin with one finger and checks her eyes.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Mags pulls away and tucks the quilt up to her ears.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Cutter. Go ahead.", "name": "EWAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Roads are washed out. I can't get to you till morning.", "name": "DEPUTY CUTTER", "speaker": 3, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Can't or won't?", "name": "EWAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Can't. The bridge is gone.", "name": "DEPUTY CUTTER", "speaker": 3, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Hazel sets down the pail.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Ewan turns the dial a quarter turn.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Static swells.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Ewan, don't.", "name": "HAZEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Cutter, you hear anything out there?", "name": "EWAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Like what?", "name": "DEPUTY CUTTER", "speaker": 3, "ext": ["V.O."], "paren": ["radio, faint"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Like something in the corn.", "name": "EWAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Silence on the radio.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Then a long, wet scraping sound comes through the speaker.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "It is not coming from the speaker.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "It is coming from outside the kitchen window.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "It's the same sound as at our house.", "name": "MAGS", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "What sound, sweetheart?", "name": "HAZEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "When they took my mom.", "name": "MAGS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Ewan raises the shotgun.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Hazel snuffs the lamp with a pinch of her fingers.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "The kitchen goes black.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Moonlight picks out the window.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Strand place? Strand place, do you copy?", "name": "DEPUTY CUTTER", "speaker": 3, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Something taps the glass, once, with a long fingernail.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Hazel, get her under the table.", "name": "EWAN", "speaker": 1, "ext": [], "paren": ["barely audible"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Already there.", "name": "HAZEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Hazel pulls Mags beneath the oak, and the three of them hold their breath as the tapping travels along the window, around the corner, toward the door.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}]}