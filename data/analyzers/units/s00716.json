{"scene_id": "s00716", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00716.fountain", "heading": "INT. PASCAL HOUSE - ATTIC - AFTERNOON", "cast": [{"id": 0, "name": "LEONA", "names": ["LEONA"], "gender": "?", "first": 5, "spoke": 10}, {"id": 1, "name": "PASCAL", "names": ["PASCAL"], "gender": "m", "first": 6, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. PASCAL HOUSE - ATTIC - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Slanted ceiling.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cardboard boxes marked in a dead man's handwriting.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A mannequin with a hat on it.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A small round window, dusty light.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LEONA, 40s, in jeans, kneels over a trunk.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her brother PASCAL, 40s, in a work jacket, stands at the top of the stairs with his arms folded.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "You took Dad's watch.", "name": "LEONA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "He gave it to me.", "name": "PASCAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "In the hospital. When he couldn't talk.", "name": "LEONA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "He pointed.", "name": "PASCAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "At you. Or at the window.", "name": "LEONA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "At me.", "name": "PASCAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Leona lifts a sweater from the trunk.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "A box of old photographs falls out.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She catches it.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Pascal takes a step forward, both hands out, and they hold the box between them for a moment, each with a grip on a corner.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Give me that.", "name": "PASCAL", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "You give it.", "name": "LEONA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "They tug.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "The lid pops.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Photographs scatter across the floor, and both stop, crouch, and begin gathering them without a word.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "This one. Do you remember?", "name": "LEONA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Don't.", "name": "PASCAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "You were nine. You had that haircut.", "name": "LEONA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "He cut it himself, with kitchen scissors.", "name": "PASCAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "You cried for a week.", "name": "LEONA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "I did not.", "name": "PASCAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "You hid in the car.", "name": "LEONA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Okay. I hid in the car.", "name": "PASCAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "She hands him the photograph.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "He studies it for a long time.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "His thumb moves over the face.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Take the watch.", "name": "PASCAL", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "I don't want the watch.", "name": "LEONA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Then why are we here?", "name": "PASCAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Because I don't want to be here alone.", "name": "LEONA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "He sits on the trunk.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "She sits beside him, and they look at the photographs spread across the boards like leaves.", "para": 5, "sent": 1, "present": [0, 1]}]}