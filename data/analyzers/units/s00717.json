{"scene_id": "s00717", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00717.fountain", "heading": "INT. COUNTY COURTHOUSE - COURTROOM 4B - DAY", "cast": [{"id": 0, "name": "DELIA WHITCOMBE", "names": ["DELIA WHITCOMBE", "DELIA"], "gender": "?", "first": 7, "spoke": 11}, {"id": 1, "name": "JUDGE HORATIO NG", "names": ["JUDGE HORATIO NG", "JUDGE NG"], "gender": "?", "first": 10, "spoke": 12}], "units": [{"u": 0, "kind": "heading", "text": "INT. COUNTY COURTHOUSE - COURTROOM 4B - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A cavernous room of dark oak and brass.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A ceiling fan turns lazily.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Afternoon light angles through tall, dusty windows onto a worn gallery bench.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The gallery is empty.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The jury box is empty.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "A court reporter's stenograph sits unmanned.", "para": 0, "sent": 5, "present": []}, {"u": 7, "kind": "action", "text": "DELIA WHITCOMBE, 40s, in a charcoal suit that has been pressed too many times, stands alone at the defense table with a stack of file folders.", "para": 1, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Her reading glasses hang from a chain.", "para": 1, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "Her jaw is set.", "para": 1, "sent": 2, "present": [0]}, {"u": 10, "kind": "action", "text": "On the bench above her, JUDGE HORATIO NG, 70s, white-haired, with a face carved of patience and old tobacco, peers down through half-moon spectacles.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Ms. Whitcombe, your motion is untimely.", "name": "JUDGE NG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Your Honor, the evidence was only disclosed yesterday.", "name": "DELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "By whom?", "name": "JUDGE NG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "By the prosecution. In a box. Left on my doorstep.", "name": "DELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "At what hour?", "name": "JUDGE NG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Ten past midnight.", "name": "DELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "And who delivered it?", "name": "JUDGE NG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "No one signed for it.", "name": "DELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "The judge removes his spectacles and polishes them on his sleeve.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "The ceiling fan creaks.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Ms. Whitcombe, I have sat on this bench for thirty-one years. I have heard a great many motions. This is the first one that arrived by phantom.", "name": "JUDGE NG", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "The contents are not phantom, Your Honor. They are bank records. They show the victim's account was emptied three weeks before the alleged crime.", "name": "DELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "By whom?", "name": "JUDGE NG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "By my client's accuser.", "name": "DELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Do you have a witness?", "name": "JUDGE NG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "I have the documents.", "name": "DELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Documents do not testify.", "name": "JUDGE NG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Then let me call the bank.", "name": "DELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Today?", "name": "JUDGE NG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Now.", "name": "DELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "He sets his glasses back on his nose.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "For a long moment he studies her, and the silence stretches.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Delia does not blink.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "You understand that if I allow this, and it fails, your client's sentence will be harsher.", "name": "JUDGE NG", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "I understand.", "name": "DELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "And you still wish to proceed?", "name": "JUDGE NG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "I have never wished anything more.", "name": "DELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Judge Ng nods once, slowly.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "He lifts his gavel, looks at it, and sets it down without striking.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Then bring in the bank.", "name": "JUDGE NG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}