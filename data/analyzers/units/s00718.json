{"scene_id": "s00718", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00718.fountain", "heading": "EXT. MOUNTAIN PASS - SNOWBOUND BUS - DAY", "cast": [{"id": 0, "name": "KIT", "names": ["KIT"], "gender": "f", "first": 7, "spoke": 5}, {"id": 1, "name": "BERNARD", "names": ["BERNARD"], "gender": "?", "first": 8, "spoke": 3}, {"id": 2, "name": "YARA", "names": ["YARA"], "gender": "f", "first": 9, "spoke": 2}, {"id": 3, "name": "LARS", "names": ["LARS"], "gender": "m", "first": 10, "spoke": 5}, {"id": 4, "name": "PILAR", "names": ["PILAR"], "gender": "f", "first": 11, "spoke": 1}, {"id": 5, "name": "RADIO", "names": ["RADIO"], "gender": "?", "first": 23, "spoke": 2}, {"id": 6, "name": "TOBIAS", "names": ["TOBIAS"], "gender": "?", "first": 39, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. MOUNTAIN PASS - SNOWBOUND BUS - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A stalled coach bus lists on a white slope, wheels buried to the axles.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wind hisses across the frozen glass.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Pines bend under the weight of snow.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Inside, a dim cabin.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "Frost on the windows.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "Seven seats cleared in a tight circle near the driver's cab.", "para": 1, "sent": 2, "present": []}, {"u": 7, "kind": "action", "text": "KIT, 40s, a nurse in a puffy coat, rubs a young girl's hands.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "BERNARD, 60s, a retired surveyor with a thick gray scarf, studies a folded map.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "YARA, 20s, a student with a backpack, shivers in her sleeping bag.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "LARS, 50s, the bus driver, in his uniform jacket, works a hand-crank radio.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "PILAR, 30s, a mother, holds a thermos of soup between her palms.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "They are all gaunt, hollow-eyed, patient.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Everyone drink something.", "name": "KIT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "We're low on water.", "name": "BERNARD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "We have snow.", "name": "KIT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Snow takes heat to melt.", "name": "LARS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Then we burn something.", "name": "YARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "We burned the seat covers yesterday.", "name": "BERNARD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Hold on, hold on.", "name": "PILAR", "speaker": 4, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Come on, you old brute.", "name": "LARS", "speaker": 3, "ext": [], "paren": ["cranking"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "The radio coughs.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "A thin, tinny voice breaks through.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "-- anyone -- copy --", "name": "RADIO", "speaker": 5, "ext": ["V.O."], "paren": ["garbled"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Everyone freezes.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Lars twists the dial.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "This is the Valmont Pass bus, number twelve. We're stranded at mile forty. Do you read?", "name": "LARS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "-- stay put -- help -- morning --", "name": "RADIO", "speaker": 5, "ext": ["V.O."], "paren": ["garbled"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Say again?", "name": "LARS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "The signal dies.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Lars slumps.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Pilar clutches the thermos.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Morning. That's something.", "name": "KIT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Whose morning?", "name": "YARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Don't start.", "name": "BERNARD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Kit pulls her glove off and checks the girl's pulse at the wrist.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "The girl, who has not spoken, turns her head toward the door.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "The bus door hisses open.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "A gust of snow sweeps in.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "A figure stands in the stairwell, bundled in white, a rifle slung over one shoulder: TOBIAS, 40s, a ranger, ice crusted on his beard.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "Got your signal. I'm Tobias. I'm here to get you out.", "name": "TOBIAS", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "Nobody moves.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "Then Pilar lets out a sob.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "Kit rises.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "Bernard folds the map.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "How many of you?", "name": "LARS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "dialogue", "text": "Just me. Sled's at the bottom. Two trips.", "name": "TOBIAS", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "dialogue", "text": "She goes first.", "name": "KIT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "dialogue", "text": "Who?", "name": "TOBIAS", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "dialogue", "text": "Her. And she goes with her.", "name": "KIT", "speaker": 0, "ext": [], "paren": ["gesturing"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "action", "text": "Pilar nods.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "action", "text": "She stands, takes the girl's hand, and moves to the door.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}]}