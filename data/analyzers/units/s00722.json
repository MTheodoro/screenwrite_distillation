{"scene_id": "s00722", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00722.fountain", "heading": "EXT. SALT-FLAT FERRY LANDING - NOON", "cast": [{"id": 0, "name": "DEACON CROWE", "names": ["DEACON CROWE", "DEACON"], "gender": "?", "first": 6, "spoke": 7}, {"id": 1, "name": "BIRDIE PRUETT", "names": ["BIRDIE PRUETT", "BIRDIE"], "gender": "?", "first": 15, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SALT-FLAT FERRY LANDING - NOON", "present": []}, {"u": 1, "kind": "action", "text": "White.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Everything white.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Heat shimmer.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A rotting dock jutting into a lake that dried up a decade ago.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A ferry sits stranded on cracked crust, hull tilted.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "DEACON CROWE, forties, sits on an upturned bucket by the ramp.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Black coat, grey with salt.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "Rifle across his knees.", "para": 1, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "He doesn't aim it.", "para": 1, "sent": 3, "present": [0]}, {"u": 10, "kind": "action", "text": "He just keeps it.", "para": 1, "sent": 4, "present": [0]}, {"u": 11, "kind": "action", "text": "Hoofbeats, slow.", "para": 2, "sent": 0, "present": [0]}, {"u": 12, "kind": "action", "text": "A shape resolves in the glare.", "para": 2, "sent": 1, "present": [0]}, {"u": 13, "kind": "action", "text": "Rider.", "para": 2, "sent": 2, "present": [0]}, {"u": 14, "kind": "action", "text": "Mule.", "para": 2, "sent": 3, "present": [0]}, {"u": 15, "kind": "action", "text": "BIRDIE PRUETT, thirties, wide hat, rolled sleeves.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Sunburnt nose.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She dismounts without hurry.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Ties the mule to a piling.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He watches.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Doesn't rise.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Deacon.", "name": "BIRDIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Birdie.", "name": "DEACON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She takes a canteen off the saddle.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Drinks.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Holds it out.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "He considers it.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Takes it.", "para": 5, "sent": 4, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "You're a long way from anybody.", "name": "BIRDIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "That's the idea.", "name": "DEACON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "She sits on the ramp's edge.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Boots dangling over dry crust.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "He caps the canteen, passes it back.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Neither says anything for a while.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "A gull cries.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Where it came from, no one knows.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Both look up.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Both look down again.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "They say the lake'll come back.", "name": "DEACON", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "They say a lot.", "name": "BIRDIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "He grins.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Small.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "It leaves quick.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "She pulls a folded paper from her vest.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "Turns it over in her fingers.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "He sees it.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Eyes narrow.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Rifle shifts a half inch on his knees.", "para": 9, "sent": 4, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "They both go still.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "Wind hushes the dock timbers.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "That mine?", "name": "DEACON", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Was yours. It's a telegram now.", "name": "BIRDIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Who from?", "name": "DEACON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "Your sister. Says come home.", "name": "BIRDIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "Don't have one.", "name": "DEACON", "speaker": 0, "ext": [], "paren": ["flat"], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "Then somebody's lying, Deacon.", "name": "BIRDIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "He stares at the ferry.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "Her eyes stay on him.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "The heat hums.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "She unfolds the paper.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "Holds it up between them like a card she doesn't want to play.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "Read it with me.", "name": "BIRDIE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "He doesn't take it.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "He doesn't leave.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "After a long moment he sets the rifle down on the planks.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "Slides over on the bucket.", "para": 14, "sent": 1, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "She shifts toward him, paper between them.", "para": 14, "sent": 2, "present": [0, 1]}, {"u": 67, "kind": "action", "text": "They read.", "para": 14, "sent": 3, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "Hell.", "name": "DEACON", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "Yeah.", "name": "BIRDIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "action", "text": "Salt glitters.", "para": 15, "sent": 0, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "Neither moves.", "para": 15, "sent": 1, "present": [0, 1]}]}