{"scene_id": "s00723", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00723.fountain", "heading": "INT. FERRIS WHEEL GONDOLA 14 - COMPLAINTS DEPARTMENT - DAY", "cast": [{"id": 0, "name": "PRIYA RAMANATHAN", "names": ["PRIYA RAMANATHAN", "PRIYA"], "gender": "?", "first": 5, "spoke": 15}, {"id": 1, "name": "HUGH BELLAMY", "names": ["HUGH BELLAMY", "HUGH"], "gender": "?", "first": 7, "spoke": 15}, {"id": 2, "name": "CORKY", "names": ["CORKY"], "gender": "?", "first": 24, "spoke": 8}, {"id": 3, "name": "WASHINGTON", "names": ["WASHINGTON"], "gender": "?", "first": 24, "spoke": 0}, {"id": 4, "name": "MS. FENWICK-ADEYEMI", "names": ["MS. FENWICK-ADEYEMI"], "gender": "?", "first": 50, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. FERRIS WHEEL GONDOLA 14 - COMPLAINTS DEPARTMENT - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A decommissioned gondola bolted to a service platform.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Two desks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "One window.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "One fire extinguisher nobody trusts.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "PRIYA RAMANATHAN, thirties, headset, ironed blouse.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Armour.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "HUGH BELLAMY, fifties, comb-over, mug reading WORLD'S OKAYEST BOSS.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He leans in the doorway.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Priya. Quarterly numbers.", "name": "HUGH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Good.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Good?", "name": "HUGH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Complaints are down forty percent.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Brilliant.", "name": "HUGH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Because the phone line's been unplugged since June.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Hugh freezes.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Smile stuck.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Unplugged.", "name": "HUGH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "By you. For \"restructuring.\"", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Hugh enters.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Sits on the desk.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Sighs like a man in a hot-air balloon.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Okay. Okay. Nobody tells Corporate.", "name": "HUGH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Corporate's in the next gondola.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "CORDELL \"CORKY\" WASHINGTON, twenties, pops up from under the other desk.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Headphones.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Cheese puff dust on his lip.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Morning!", "name": "CORKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "You live here?", "name": "HUGH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Gondola's got Wi-Fi.", "name": "CORKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "The gondola sways.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "All three grab something.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Why are we moving?", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Wheel's on. Maintenance said \"test.\"", "name": "CORKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Test what?", "name": "HUGH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Whether it still goes.", "name": "CORKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "The gondola lifts.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Rises.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Through the window the city tilts into view.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Hugh's mug slides.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "He catches it.", "para": 7, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "An old PHONE on the wall RINGS.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Everyone stares.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "That's connected?", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "That's not supposed to be connected.", "name": "HUGH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Ring.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Ring.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Priya answers.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Puts it on speaker.", "para": 9, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Complaints. Priya.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Ms. Ramanathan. Marjorie Fenwick-Adeyemi. Head of Customer Experience.", "name": "MS. FENWICK-ADEYEMI", "speaker": 4, "ext": ["V.O."], "paren": ["over phone, crisp"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Hugh mouths: Corporate.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Corky mouths: In the next gondola.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "I'm told your department has had no complaints in four months.", "name": "MS. FENWICK-ADEYEMI", "speaker": 4, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "That's correct.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "It's the most impressive thing I've ever seen.", "name": "MS. FENWICK-ADEYEMI", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Hugh straightens.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "Smiles.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Corky gives a thumbs-up.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "I'd like to put you in charge of the whole company.", "name": "MS. FENWICK-ADEYEMI", "speaker": 4, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "What?", "name": "PRIYA", "speaker": 0, "ext": [], "paren": ["beat"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "Say yes.", "name": "HUGH", "speaker": 1, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "dialogue", "text": "Mr. Bellamy is, of course, being let go.", "name": "MS. FENWICK-ADEYEMI", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "Hugh's mug hits the floor.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "dialogue", "text": "What?!", "name": "HUGH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "Oh, wow.", "name": "CORKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "dialogue", "text": "Can I call you back?", "name": "PRIYA", "speaker": 0, "ext": [], "paren": ["into phone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "dialogue", "text": "I'm in the next gondola.", "name": "MS. FENWICK-ADEYEMI", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "action", "text": "They all turn.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "Through the window, ten feet away, a woman in a grey suit lifts a phone.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "action", "text": "Waves.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "action", "text": "The wheel stops.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "action", "text": "Hangs.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "action", "text": "Wind.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "action", "text": "Silence.", "para": 14, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "action", "text": "Hugh drops onto the desk.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 76, "kind": "dialogue", "text": "Priya. I trained you.", "name": "HUGH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 77, "kind": "dialogue", "text": "You taught me where the mute button was.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 78, "kind": "dialogue", "text": "That's training!", "name": "HUGH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 79, "kind": "dialogue", "text": "I can see her lunch.", "name": "CORKY", "speaker": 2, "ext": [], "paren": ["to no one"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 80, "kind": "action", "text": "Priya hangs up.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 81, "kind": "action", "text": "Looks at Hugh.", "para": 16, "sent": 1, "present": [1, 2, 3, 4]}, {"u": 82, "kind": "action", "text": "At the extinguisher.", "para": 16, "sent": 2, "present": [1, 2, 3, 4]}, {"u": 83, "kind": "action", "text": "At the city below.", "para": 16, "sent": 3, "present": [1, 2, 3, 4]}, {"u": 84, "kind": "dialogue", "text": "I have a condition.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 85, "kind": "dialogue", "text": "Anything.", "name": "HUGH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 86, "kind": "dialogue", "text": "Plug the phones back in.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 87, "kind": "dialogue", "text": "Why?", "name": "HUGH", "speaker": 1, "ext": [], "paren": ["horrified"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 88, "kind": "dialogue", "text": "So we can hear what people actually think.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 89, "kind": "action", "text": "Hugh gulps.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 90, "kind": "action", "text": "The wheel jolts.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 91, "kind": "action", "text": "It starts to descend.", "para": 17, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 92, "kind": "dialogue", "text": "That's going to be loud.", "name": "CORKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 93, "kind": "dialogue", "text": "How loud?", "name": "HUGH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 94, "kind": "dialogue", "text": "Gondola loud.", "name": "CORKY", "speaker": 2, "ext": [], "paren": ["shrugs, eats a puff"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 95, "kind": "action", "text": "The wheel carries them down into the noise of the city.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4]}]}