{"scene_id": "s00724", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00724.fountain", "heading": "INT. CURLING RINK - 5 A.M.", "cast": [{"id": 0, "name": "INGRID SOLBERG", "names": ["INGRID SOLBERG", "INGRID"], "gender": "?", "first": 4, "spoke": 12}, {"id": 1, "name": "KAMALA JOSHI", "names": ["KAMALA JOSHI", "KAMALA"], "gender": "?", "first": 13, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. CURLING RINK - 5 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "Empty ice.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Frost smoke on the boards.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A zamboni hums somewhere far off.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "INGRID SOLBERG, thirties, national-team jacket, sits on the hack with a polishing cloth.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She buffs one granite stone.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Slow circles.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "Calm.", "para": 1, "sent": 3, "present": [0]}, {"u": 8, "kind": "action", "text": "She sets it down.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Picks up another.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "A door CLANKS at the far end.", "para": 3, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "Footsteps on rubber matting.", "para": 3, "sent": 1, "present": [0]}, {"u": 12, "kind": "action", "text": "Ingrid doesn't look up.", "para": 3, "sent": 2, "present": [0]}, {"u": 13, "kind": "action", "text": "KAMALA JOSHI, twenties, rookie, duffel bag, bright eyes.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Too bright.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She stops at the boards.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "You're early.", "name": "KAMALA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Always.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Coach said six.", "name": "KAMALA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Coach says a lot.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Kamala steps onto the ice.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Slides carefully.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Settles on a bench near the house.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "I watched your Oslo final. Eleven times.", "name": "KAMALA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Then you know the ending.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "She misses the draw. You win.", "name": "KAMALA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "She doesn't miss. I did.", "name": "INGRID", "speaker": 0, "ext": [], "paren": ["beat"], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Kamala laughs.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Ingrid doesn't.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "The cloth keeps circling.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "I'm second skip. They told me last night.", "name": "KAMALA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Ingrid's hand stops.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "A breath.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "She sets the stone down gently.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Did they say whose spot?", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "No. Just that it's open.", "name": "KAMALA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "It's not open.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "She stands.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Walks to the sheet.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Her jacket reads CAPTAIN in small stitching.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "I signed the release at midnight.", "name": "INGRID", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Kamala's face falls.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "You quit?", "name": "KAMALA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "I was cut. She was told to keep it quiet until you'd arrived.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Who told you?", "name": "KAMALA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Coach. Same one who said six.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "She holds out the stone's handle to Kamala.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "Throw it.", "name": "INGRID", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "I don't--", "name": "KAMALA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Throw it. I want to see what they chose.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "Kamala takes the handle.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "Sets her feet.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "Pushes.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "The stone glides, long and clean, to the button.", "para": 11, "sent": 3, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "Ingrid watches it stop.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "A small nod.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "Good.", "name": "INGRID", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "She picks up her bag and walks off the ice.", "para": 13, "sent": 0, "present": [0, 1]}]}