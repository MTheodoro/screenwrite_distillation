": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Tamsin grins.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Stands.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "The felt board rattles on its easel.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Let's go.", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}