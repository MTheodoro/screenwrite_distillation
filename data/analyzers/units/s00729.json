{"scene_id": "s00729", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00729.fountain", "heading": "EXT. CABLE CAR - ABOVE A GORGE - DUSK", "cast": [{"id": 0, "name": "BRONWYN DAVIES", "names": ["BRONWYN DAVIES", "BRONWYN"], "gender": "?", "first": 5, "spoke": 8}, {"id": 1, "name": "TEO", "names": ["TEO"], "gender": "?", "first": 6, "spoke": 9}, {"id": 2, "name": "BIANCHI", "names": ["BIANCHI"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "SAMIRA HADDAD", "names": ["SAMIRA HADDAD", "SAMIRA"], "gender": "?", "first": 7, "spoke": 9}, {"id": 4, "name": "KWAME BOATENG", "names": ["KWAME BOATENG", "KWAME"], "gender": "?", "first": 8, "spoke": 12}, {"id": 5, "name": "ASTRID NYGAARD", "names": ["ASTRID NYGAARD", "ASTRID"], "gender": "?", "first": 9, "spoke": 7}, {"id": 6, "name": "HIRO", "names": ["HIRO"], "gender": "?", "first": 10, "spoke": 9}, {"id": 7, "name": "KAWAGUCHI", "names": ["KAWAGUCHI"], "gender": "?", "first": 10, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. CABLE CAR - ABOVE A GORGE - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "A steel gondola dangles over a mile of nothing.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wind.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Fog beneath.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Six strangers are packed inside, breathing hard.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "BRONWYN DAVIES, fifties, retired nurse.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "TEODORO \"TEO\" BIANCHI, twenties, backpacker.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "SAMIRA HADDAD, forties, mother, clutching a thermos.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "KWAME BOATENG, sixties, engineer, calm.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "ASTRID NYGAARD, thirties, runner.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "HIROSHI \"HIRO\" KAWAGUCHI, eighties, quiet, folded into the corner.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 11, "kind": "action", "text": "The car swings once.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 12, "kind": "action", "text": "Settles.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 13, "kind": "dialogue", "text": "Everyone breathe. It's a power cut. The backup will come on.", "name": "KWAME", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 14, "kind": "dialogue", "text": "How long?", "name": "SAMIRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 15, "kind": "dialogue", "text": "Twenty minutes. Maybe thirty.", "name": "KWAME", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 16, "kind": "dialogue", "text": "It's been forty.", "name": "TEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 17, "kind": "dialogue", "text": "Then it's coming.", "name": "KWAME", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 18, "kind": "dialogue", "text": "I run this gorge every Sunday. There's a ranger hut on the north side. If we climb out--", "name": "ASTRID", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 19, "kind": "dialogue", "text": "We are not climbing out.", "name": "BRONWYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 20, "kind": "dialogue", "text": "It's four hundred feet to the ridge.", "name": "ASTRID", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 21, "kind": "dialogue", "text": "It's four hundred feet in the wrong direction.", "name": "BRONWYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 22, "kind": "dialogue", "text": "Please. The car rocks.", "name": "HIRO", "speaker": 6, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 23, "kind": "dialogue", "text": "He's right. Nobody move.", "name": "SAMIRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 24, "kind": "dialogue", "text": "I have a radio on my phone. No bars.", "name": "TEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 25, "kind": "dialogue", "text": "Try the emergency channel.", "name": "KWAME", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 26, "kind": "dialogue", "text": "It's not that kind of phone.", "name": "TEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 27, "kind": "dialogue", "text": "Then why do you have it?", "name": "ASTRID", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 28, "kind": "dialogue", "text": "For music.", "name": "TEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 29, "kind": "dialogue", "text": "Lord.", "name": "BRONWYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "dialogue", "text": "There is water in the thermos. Tea. We share.", "name": "SAMIRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "dialogue", "text": "Small sips.", "name": "KWAME", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "dialogue", "text": "Hiro, you first.", "name": "SAMIRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "dialogue", "text": "Thank you.", "name": "HIRO", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "dialogue", "text": "Hiro, how are you feeling?", "name": "BRONWYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "dialogue", "text": "I am eighty-four. I have been in worse. In fifty-eight, I was in a cave for two days.", "name": "HIRO", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "dialogue", "text": "What happened?", "name": "TEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "dialogue", "text": "We sang.", "name": "HIRO", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "dialogue", "text": "Sang what?", "name": "ASTRID", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "dialogue", "text": "Whatever we knew. Bad songs. Many verses.", "name": "HIRO", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "dialogue", "text": "Let's do that then.", "name": "SAMIRA", "speaker": 3, "ext": [], "paren": ["laughs"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 41, "kind": "dialogue", "text": "Singing in a swaying car is not--", "name": "KWAME", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 42, "kind": "dialogue", "text": "Kwame, let the man have his song.", "name": "BRONWYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 43, "kind": "dialogue", "text": "Fine. But quietly.", "name": "KWAME", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 44, "kind": "dialogue", "text": "I know one.", "name": "HIRO", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 45, "kind": "dialogue", "text": "Go.", "name": "TEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 46, "kind": "dialogue", "text": "\"Hotaru no hikari...\"", "name": "HIRO", "speaker": 6, "ext": [], "paren": ["sings, thin"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 47, "kind": "dialogue", "text": "I know this one! It's the school tune.", "name": "SAMIRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 48, "kind": "dialogue", "text": "Auld Lang Syne. We all know it.", "name": "BRONWYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 49, "kind": "dialogue", "text": "\"Should auld acquaintance be forgot...\"", "name": "ASTRID", "speaker": 5, "ext": [], "paren": ["joining"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 50, "kind": "dialogue", "text": "I don't know the words.", "name": "TEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 51, "kind": "dialogue", "text": "Hum.", "name": "KWAME", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 52, "kind": "action", "text": "All six now.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 53, "kind": "action", "text": "Low.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 54, "kind": "action", "text": "Wind carries them across the dark.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 55, "kind": "action", "text": "A groan from above.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 56, "kind": "action", "text": "The cable shudders.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 57, "kind": "action", "text": "Everyone stops.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 58, "kind": "dialogue", "text": "Did that--", "name": "ASTRID", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 59, "kind": "dialogue", "text": "Don't say it.", "name": "KWAME", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 60, "kind": "dialogue", "text": "It's the wheel. It's coming back on.", "name": "TEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 61, "kind": "dialogue", "text": "Or it's the other thing.", "name": "BRONWYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 62, "kind": "dialogue", "text": "What other thing?", "name": "SAMIRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 63, "kind": "dialogue", "text": "There's no other thing.", "name": "KWAME", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 64, "kind": "dialogue", "text": "There is always another thing.", "name": "HIRO", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 65, "kind": "action", "text": "The car lurches.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 66, "kind": "action", "text": "A hiss, a clunk.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 67, "kind": "action", "text": "The lights stutter on.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 68, "kind": "action", "text": "Motor whirs.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 69, "kind": "dialogue", "text": "YES!", "name": "TEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 70, "kind": "dialogue", "text": "Oh thank God.", "name": "ASTRID", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 71, "kind": "dialogue", "text": "Hiro, you did it.", "name": "SAMIRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 72, "kind": "dialogue", "text": "The song did it.", "name": "HIRO", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 73, "kind": "action", "text": "The gondola begins to move.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 74, "kind": "action", "text": "Slow.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 75, "kind": "action", "text": "Steady.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 76, "kind": "action", "text": "Toward the lit station.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 77, "kind": "dialogue", "text": "Funny. It's going the wrong way.", "name": "BRONWYN", "speaker": 0, "ext": [], "paren": ["low, to Kwame"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 78, "kind": "dialogue", "text": "That's not the station.", "name": "KWAME", "speaker": 4, "ext": [], "paren": ["looking out"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 79, "kind": "action", "text": "The lights ahead are a ranger hut.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 80, "kind": "action", "text": "A single window.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 81, "kind": "action", "text": "A figure with a rifle.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 82, "kind": "dialogue", "text": "Kwame?", "name": "SAMIRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 83, "kind": "dialogue", "text": "Nobody say anything.", "name": "KWAME", "speaker": 4, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}