{"scene_id": "s00731", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00731.fountain", "heading": "INT. FUNICULAR TICKET HOUSE - NIGHT", "cast": [{"id": 0, "name": "LOLA ITURBE", "names": ["LOLA ITURBE", "LOLA"], "gender": "?", "first": 5, "spoke": 20}, {"id": 1, "name": "JULIAN ASANTE-WRIGHT", "names": ["JULIAN ASANTE-WRIGHT", "JULIAN"], "gender": "?", "first": 14, "spoke": 23}], "units": [{"u": 0, "kind": "heading", "text": "INT. FUNICULAR TICKET HOUSE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Closed for the season.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rain on the glass.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A brass ticket machine.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A space heater ticking orange.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LOLA ITURBE, thirties, wool coat, soaked hair, sits on the counter with a thermos.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Alone.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She stares at the dead cable car through the window.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "She sips.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Checks her watch.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "Sips.", "para": 2, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "The door BANGS open.", "para": 3, "sent": 0, "present": [0]}, {"u": 12, "kind": "action", "text": "Wind.", "para": 3, "sent": 1, "present": [0]}, {"u": 13, "kind": "action", "text": "Wet leaves.", "para": 3, "sent": 2, "present": [0]}, {"u": 14, "kind": "action", "text": "JULIAN ASANTE-WRIGHT, late thirties, rain-slicked trench, a suitcase in one hand.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "He stops dead.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "You're not supposed to be here.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Neither are you.", "name": "LOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He shuts the door.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "It takes two tries.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She watches him fight it.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "He doesn't say thanks.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "The last train left at nine.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Eight forty.", "name": "LOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Eight forty.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "He sets the suitcase on the floor.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Looks at the heater.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "She slides the thermos along the counter.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "He doesn't take it.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Is that coffee?", "name": "JULIAN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Tea.", "name": "LOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Right.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "He takes it.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Sips.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Grimaces.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "That's awful.", "name": "JULIAN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "It's chamomile. It's meant to be.", "name": "LOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "She smiles.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Barely.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "He almost does.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "He sits on the bench by the wall.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "She stays on the counter.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Rain drums.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "How long have you been here?", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Since six.", "name": "LOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Why?", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "I had a ticket.", "name": "LOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "For the nine o'clock?", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "For the one last year.", "name": "LOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "He looks at her.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "Slowly she takes a crumpled ticket from her pocket.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "Holds it up, a stub, brown at the corners.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "He recognises it.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "His jaw tightens.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "Lola.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "You never came.", "name": "LOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "I wrote.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "You wrote a postcard. Of a lighthouse.", "name": "LOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "It was a nice lighthouse.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "She laughs, short and sharp.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "He doesn't.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "It's a year, Julian. A year since I stood on that platform.", "name": "LOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "I know.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "No, you don't. You were in Lisbon.", "name": "LOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "I was in a hospital.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "Silence.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "The heater ticks.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "What?", "name": "LOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "My mother. She had a stroke the night before. I couldn't--", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "You never said.", "name": "LOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "You never asked.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "She slides off the counter.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "Crosses to him.", "para": 14, "sent": 1, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "He stands.", "para": 14, "sent": 2, "present": [0, 1]}, {"u": 74, "kind": "dialogue", "text": "I waited here. Alone. I thought you'd--", "name": "LOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 75, "kind": "dialogue", "text": "Stop.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 76, "kind": "dialogue", "text": "I thought you'd chosen not to--", "name": "LOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 77, "kind": "dialogue", "text": "Lola, stop.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 78, "kind": "action", "text": "She doesn't.", "para": 15, "sent": 0, "present": [0, 1]}, {"u": 79, "kind": "action", "text": "He steps closer.", "para": 15, "sent": 1, "present": [0, 1]}, {"u": 80, "kind": "action", "text": "Her hands are shaking.", "para": 15, "sent": 2, "present": [0, 1]}, {"u": 81, "kind": "action", "text": "So are his.", "para": 15, "sent": 3, "present": [0, 1]}, {"u": 82, "kind": "dialogue", "text": "You could have called.", "name": "LOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 83, "kind": "dialogue", "text": "She was dying. I was holding her hand!", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 84, "kind": "dialogue", "text": "And I was holding a ticket!", "name": "LOLA", "speaker": 0, "ext": [], "paren": ["louder"], "dual": false, "present": [0, 1]}, {"u": 85, "kind": "action", "text": "The words hang.", "para": 16, "sent": 0, "present": [0, 1]}, {"u": 86, "kind": "action", "text": "Rain slams the glass.", "para": 16, "sent": 1, "present": [0, 1]}, {"u": 87, "kind": "action", "text": "Both breathe hard.", "para": 16, "sent": 2, "present": [0, 1]}, {"u": 88, "kind": "action", "text": "He reaches out.", "para": 17, "sent": 0, "present": [0, 1]}, {"u": 89, "kind": "action", "text": "She slaps his hand away.", "para": 17, "sent": 1, "present": [0, 1]}, {"u": 90, "kind": "action", "text": "He catches her wrist anyway.", "para": 17, "sent": 2, "present": [0, 1]}, {"u": 91, "kind": "action", "text": "Neither pulls back.", "para": 17, "sent": 3, "present": [0, 1]}, {"u": 92, "kind": "dialogue", "text": "She's alive.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 93, "kind": "dialogue", "text": "What?", "name": "LOLA", "speaker": 0, "ext": [], "paren": ["stunned"], "dual": false, "present": [0, 1]}, {"u": 94, "kind": "dialogue", "text": "She recovered. She asks about you every week.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 95, "kind": "action", "text": "Lola's face crumples.", "para": 18, "sent": 0, "present": [0, 1]}, {"u": 96, "kind": "action", "text": "She sags against him, forehead to his collar.", "para": 18, "sent": 1, "present": [0, 1]}, {"u": 97, "kind": "action", "text": "His arms close around her.", "para": 18, "sent": 2, "present": [0, 1]}, {"u": 98, "kind": "action", "text": "The suitcase tips over.", "para": 18, "sent": 3, "present": [0, 1]}, {"u": 99, "kind": "action", "text": "Neither notices.", "para": 18, "sent": 4, "present": [0, 1]}, {"u": 100, "kind": "dialogue", "text": "Idiot.", "name": "LOLA", "speaker": 0, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1]}, {"u": 101, "kind": "dialogue", "text": "Yes.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 102, "kind": "action", "text": "He rests his chin on her hair.", "para": 19, "sent": 0, "present": [0, 1]}, {"u": 103, "kind": "action", "text": "She grips his coat in both fists.", "para": 19, "sent": 1, "present": [0, 1]}, {"u": 104, "kind": "action", "text": "The funicular lights flicker.", "para": 20, "sent": 0, "present": [0, 1]}, {"u": 105, "kind": "action", "text": "A distant mechanical hum starts up.", "para": 20, "sent": 1, "present": [0, 1]}, {"u": 106, "kind": "action", "text": "The cable car, far above, begins to move.", "para": 20, "sent": 2, "present": [0, 1]}, {"u": 107, "kind": "action", "text": "They both lift their heads and stare.", "para": 21, "sent": 0, "present": [0, 1]}, {"u": 108, "kind": "dialogue", "text": "That's not scheduled.", "name": "JULIAN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 109, "kind": "dialogue", "text": "Then let's see where it goes.", "name": "LOLA", "speaker": 0, "ext": [], "paren": ["wiping her face"], "dual": false, "present": [0, 1]}]}