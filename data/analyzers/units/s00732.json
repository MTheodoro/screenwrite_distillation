{"scene_id": "s00732", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00732.fountain", "heading": "EXT. OPEN OCEAN - INFLATABLE DINGHY - DAY", "cast": [{"id": 0, "name": "GUNNAR PEDERSEN", "names": ["GUNNAR PEDERSEN", "GUNNAR"], "gender": "?", "first": 4, "spoke": 3}, {"id": 1, "name": "FELIX ODUYA", "names": ["FELIX ODUYA", "FELIX"], "gender": "m", "first": 5, "spoke": 2}, {"id": 2, "name": "TARIQ MANSOOR", "names": ["TARIQ MANSOOR", "TARIQ"], "gender": "m", "first": 6, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. OPEN OCEAN - INFLATABLE DINGHY - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A grey swell lifts the orange raft and lets it fall again, patient as a hand.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The sky has no edges.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Three men lie in the bottom of the boat like fish nobody wanted.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "GUNNAR PEDERSEN, fifties, sunburnt to the colour of brick, tends a bailing cup.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "FELIX ODUYA, thirties, the youngest, stares at his own cracked palms.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "TARIQ MANSOOR, forties, the engineer, sits upright against the pontoon with the last water jug cradled in his lap.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Give him some.", "name": "GUNNAR", "speaker": 0, "ext": [], "paren": ["hoarse"], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "He had his share.", "name": "TARIQ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "He is shaking.", "name": "GUNNAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "He is cold. He is not thirsty.", "name": "TARIQ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Felix lifts his head.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "His lips are split.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "I can hear it. Listen. A motor.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Gunnar and Tariq both go still.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Wind.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Slap of water on rubber.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Nothing.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "You hear the sea.", "name": "TARIQ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "It's a motor.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "He lurches to his knees, rocking the raft.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Gunnar grabs the rope.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Tariq clutches the jug.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Felix stands, arms high, waving at the empty horizon, shouting a name nobody recognises.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Sit, boy. Sit.", "name": "GUNNAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Felix collapses.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The jug tilts.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "A mouthful of water spills across Tariq's knees.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "He stares at it, soaking into the cloth.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Then, very slowly, he lifts the jug and offers it across the raft.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "His hand shakes.", "para": 5, "sent": 5, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "He is not looking at either of them.", "para": 5, "sent": 6, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Drink.", "name": "TARIQ", "speaker": 2, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}]}