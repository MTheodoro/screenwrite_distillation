{"scene_id": "s00735", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00735.fountain", "heading": "INT. MINIVAN - INSIDE AN AUTOMATIC CAR WASH TUNNEL - DAY", "cast": [{"id": 0, "name": "DESMOND", "names": ["DESMOND"], "gender": "?", "first": 3, "spoke": 16}, {"id": 1, "name": "PRU", "names": ["PRU"], "gender": "?", "first": 3, "spoke": 10}, {"id": 2, "name": "ROXY", "names": ["ROXY"], "gender": "?", "first": 3, "spoke": 10}, {"id": 3, "name": "POP-POP", "names": ["POP-POP"], "gender": "m", "first": 3, "spoke": 11}], "units": [{"u": 0, "kind": "heading", "text": "INT. MINIVAN - INSIDE AN AUTOMATIC CAR WASH TUNNEL - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Dark suds slide down the windshield in sheets.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Blue light, pink light, a roar of brushes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The Okafor-Lindgren family sits sealed inside a rocking cocoon: DESMOND, fifties, gripping the wheel at ten and two though the van is on rails; his wife PRUDENCE \"PRU\", fifties, turned sideways in the front seat; their daughter ROXANNE \"ROXY\", sixteen, wedged in back with her knees against her chest; and Pru's father BARTHOLOMEW \"POP-POP\", eighties, queen of the back seat, tucked in a plaid blanket and a hat.", "para": 0, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 4, "kind": "dialogue", "text": "Nobody touch the doors.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 5, "kind": "dialogue", "text": "Nobody is touching the doors.", "name": "PRU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "dialogue", "text": "Mom, I'm literally nowhere near the doors.", "name": "ROXY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Is it raining?", "name": "POP-POP", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "No, Daddy, it's a car wash.", "name": "PRU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Whose car?", "name": "POP-POP", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Ours.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I thought it was Desmond's.", "name": "POP-POP", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "It is mine. Ours. It's our car.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Pop-Pop, you've been in a car wash before.", "name": "ROXY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Not with a family in it.", "name": "POP-POP", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Desmond, the foam's coming in the vent.", "name": "PRU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "It is not coming in the vent.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "It's coming in the vent.", "name": "ROXY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Roxy, don't help.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "I'm not helping, I'm reporting.", "name": "ROXY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Roxanne, you look like your grandmother when you frown.", "name": "POP-POP", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Is that good?", "name": "ROXY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "She frightened me in the nineteen-sixties and I married her.", "name": "POP-POP", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Daddy, we've heard.", "name": "PRU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Pru, tell your father not to say \"frightened me\" while I'm in a tunnel.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "He can say what he wants.", "name": "PRU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "I'm eighty-four.", "name": "POP-POP", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "You're eighty-four and you're the reason we're in here. You said the van smelled like soup.", "name": "ROXY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "It did smell like soup.", "name": "POP-POP", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "It smelled like Pru's lasagne.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Excuse me?", "name": "PRU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "I like the lasagne!", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "You said it smelled.", "name": "PRU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Everything smells! It's a van!", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Dad, the sign says \"Put in neutral.\"", "name": "ROXY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "I know what it says.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Are you in neutral?", "name": "PRU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "I am in neutral.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Is it neutral?", "name": "POP-POP", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "It's neutral, Bartholomew.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Don't take that tone.", "name": "POP-POP", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Dad, you're supposed to be in neutral and also not touching the brakes.", "name": "ROXY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "I'm not touching the brakes!", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Your foot is on the brake.", "name": "PRU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "My foot is hovering.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Hovering on the brake.", "name": "ROXY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Is that why the brushes are stuck?", "name": "POP-POP", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Everyone falls silent.", "para": 1, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "The brushes slap the roof, steady, thudding, oddly intimate.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Desmond.", "name": "PRU", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "It's fine.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Is it fine?", "name": "ROXY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "It's fine!", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "The brushes lift.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "A wave of warm air blows through the tunnel.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Pop-Pop begins to laugh, a wheeze that grows and grows, and one by one the others join him, helpless, water running down the glass.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}]}