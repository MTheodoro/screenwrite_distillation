{"scene_id": "s00738", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00738.fountain", "heading": "EXT. HOT-AIR BALLOON BASKET - 2,000 FEET - SUNRISE", "cast": [{"id": 0, "name": "GERALDINE PLUMMER", "names": ["GERALDINE PLUMMER", "GERALDINE"], "gender": "?", "first": 4, "spoke": 9}, {"id": 1, "name": "PERCIVAL", "names": ["PERCIVAL"], "gender": "?", "first": 5, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "EXT. HOT-AIR BALLOON BASKET - 2,000 FEET - SUNRISE", "present": []}, {"u": 1, "kind": "action", "text": "A wicker basket the size of a closet drifts over a patchwork of farmland.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Gold light.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Cows like grains of rice.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "GERALDINE PLUMMER, sixties, floral scarf, holds a flask of champagne.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her husband PERCIVAL, sixties, straw hat, grips the burner cord with the stiff calm of a man who doesn't know what it does.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "It's lovely.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "It is.", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Forty years, and you finally took me up.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Forty-one.", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Forty-one.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She pours two paper cups.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "They clink.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "They sip.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Silence.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "The burner hisses.", "para": 2, "sent": 4, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Geraldine. There's something I should tell you.", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Oh?", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "The pilot didn't come.", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "What do you mean?", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "The man at the field. He had a cold. He said, \"You can manage.\"", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Percival.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "I read the manual.", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Percival!", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "It's a very short manual.", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "The basket tilts.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "A gust.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Geraldine grabs the rope.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "How do we land?", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "It says: \"Gently.\"", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Don't panic!", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "I'm not panicking!", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "They both scream as the balloon lurches toward a barn.", "para": 4, "sent": 0, "present": [0, 1]}]}