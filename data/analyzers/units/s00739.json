{"scene_id": "s00739", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00739.fountain", "heading": "EXT. ALPINE BIVOUAC LEDGE - NIGHT", "cast": [{"id": 0, "name": "LUCIEN DUMONT", "names": ["LUCIEN DUMONT", "LUCIEN"], "gender": "m", "first": 4, "spoke": 8}, {"id": 1, "name": "ODALYS FERRAND", "names": ["ODALYS FERRAND", "ODALYS"], "gender": "f", "first": 5, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ALPINE BIVOUAC LEDGE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A narrow shelf of rock, two thousand feet above a sleeping valley.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Snow hisses against a tiny orange tent pitched at an angle that argues with gravity.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A stove burns blue.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LUCIEN DUMONT, forties, bearded, ice in his moustache, stirs a pot of soup.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside him, ODALYS FERRAND, thirties, wrapped in a sleeping bag, her knees drawn up, sips from a battered tin mug.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "It's quiet, Lucien.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Too quiet, Oddy?", "name": "LUCIEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "No. Just quiet.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Good. We deserve it.", "name": "LUCIEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He ladles soup into her mug.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She smiles, small and grateful.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "They sit watching the stars come out above the ridge.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Far below, tiny lights flicker in a village.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Tomorrow, the summit.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Tomorrow, the summit.", "name": "LUCIEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "And a hot bath.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "And a hot bath.", "name": "LUCIEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She leans her head on his shoulder.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He lets her.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "For a moment, nothing in the world is wrong.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Then a thin hiss.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Not the stove.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Odalys lifts her head.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Lucien freezes, ladle in the air.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Both listen.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "The ice above them creaks.", "para": 4, "sent": 5, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Lucien--", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Don't move.", "name": "LUCIEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "They both look up.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "A crack runs across the overhang, bright and fine as a hair.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "We have to go.", "name": "LUCIEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "We have to go.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "They scramble.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "He grabs the rope, she grabs the pack.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "The tent lurches.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Soup spills, hissing on the stove.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Clip in! Clip in, Oddy!", "name": "LUCIEN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "I'm clipped, I'm clipped!", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "They tumble out of the tent together and dive into the snow at the ledge's edge as the overhang breaks free and thunders past.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "The tent is gone in a white roar.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "The avalanche dies into silence.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "They lie panting, tangled in the rope, their breath mingling in clouds.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Well. That was quiet.", "name": "ODALYS", "speaker": 1, "ext": ["CONT'D"], "paren": ["a shaky laugh"], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Very.", "name": "LUCIEN", "speaker": 0, "ext": [], "paren": ["laughs too"], "dual": false, "present": [0, 1]}]}