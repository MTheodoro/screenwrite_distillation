{"scene_id": "s00740", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00740.fountain", "heading": "INT. SYNERGY CLOSET - OFFICE SUPPLY ROOM - DAY", "cast": [{"id": 0, "name": "MORTIMER GRAY", "names": ["MORTIMER GRAY", "MORTIMER"], "gender": "?", "first": 3, "spoke": 17}, {"id": 1, "name": "LAKSHMI IYER", "names": ["LAKSHMI IYER", "LAKSHMI"], "gender": "?", "first": 3, "spoke": 10}, {"id": 2, "name": "DUNCAN OKORO", "names": ["DUNCAN OKORO", "DUNCAN"], "gender": "?", "first": 3, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. SYNERGY CLOSET - OFFICE SUPPLY ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A converted broom closet with a laminated sign reading SYNERGY CLOSET: THINK BIG.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Shelves of sticky notes and toner.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Three colleagues stand shoulder to shoulder with nowhere to put their elbows: MORTIMER GRAY, fifties, regional director; LAKSHMI IYER, thirties, project lead; DUNCAN OKORO, twenties, intern.", "para": 0, "sent": 2, "present": [0, 1, 2]}, {"u": 4, "kind": "dialogue", "text": "Right. Let's circle back on the circle-back.", "name": "MORTIMER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "We circled back last week.", "name": "LAKSHMI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "And what did we learn?", "name": "MORTIMER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "That we should circle back.", "name": "LAKSHMI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Sorry, can I ask what the project is?", "name": "DUNCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "The project is alignment.", "name": "MORTIMER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Aligned with what?", "name": "DUNCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "With the vision.", "name": "MORTIMER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Which is?", "name": "LAKSHMI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "It's in the deck.", "name": "MORTIMER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "The deck is forty slides and slide nine is a picture of a canoe.", "name": "LAKSHMI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "It's a metaphor.", "name": "MORTIMER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "For what?", "name": "DUNCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "For paddling.", "name": "MORTIMER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Together.", "name": "LAKSHMI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Exactly. Thank you, Lakshmi.", "name": "MORTIMER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I thought we were going to cancel the thing.", "name": "DUNCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "What thing?", "name": "MORTIMER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "The thing that the other thing replaced.", "name": "DUNCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Duncan, that was the original thing.", "name": "LAKSHMI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Oh.", "name": "DUNCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "We don't cancel things. We sunset them.", "name": "MORTIMER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Sunset them how?", "name": "LAKSHMI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Gently. With a runway.", "name": "MORTIMER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "What's at the end of the runway?", "name": "DUNCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Another meeting.", "name": "MORTIMER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Of course it is.", "name": "LAKSHMI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Do you have to be in the closet for this?", "name": "DUNCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "The conference room is booked.", "name": "MORTIMER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "For what?", "name": "LAKSHMI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "A meeting about the closet.", "name": "MORTIMER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "I need to get toner.", "name": "DUNCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Take whatever you need. This is a safe space.", "name": "MORTIMER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "It's a closet.", "name": "LAKSHMI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "A safe closet.", "name": "MORTIMER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Is anyone writing this down?", "name": "DUNCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "No. That's the beauty of it.", "name": "MORTIMER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}