{"scene_id": "s00742", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00742.fountain", "heading": "INT. COUNTY COURTHOUSE - ATTORNEY-CLIENT ROOM - MORNING", "cast": [{"id": 0, "name": "ARTEMIS CROSS", "names": ["ARTEMIS CROSS", "ARTEMIS"], "gender": "?", "first": 5, "spoke": 14}, {"id": 1, "name": "ROLLY", "names": ["ROLLY"], "gender": "?", "first": 10, "spoke": 13}, {"id": 2, "name": "PEARCE", "names": ["PEARCE"], "gender": "?", "first": 10, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. COUNTY COURTHOUSE - ATTORNEY-CLIENT ROOM - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "A grey cube.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Metal table.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Two chairs.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A buzzing fluorescent.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ARTEMIS CROSS, forties, public defender, sits with a thick file, pen clicking.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She doesn't look up.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "The door buzzes and swings open.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Chains.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "A shuffle.", "para": 2, "sent": 2, "present": [0]}, {"u": 10, "kind": "action", "text": "ROLLAND \"ROLLY\" PEARCE, twenties, county orange, cuffs front, wide shoulders, thin voice, enters.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "The door slams behind him.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Sit down, Rolly.", "name": "ARTEMIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Ms. Cross.", "name": "ROLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Artemis is fine.", "name": "ARTEMIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Ms. Cross is fine.", "name": "ROLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "He sits.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "She slides a photograph across the table.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "He doesn't look at it.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Do you know that man?", "name": "ARTEMIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "No.", "name": "ROLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "He says he knows you.", "name": "ARTEMIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "People say things.", "name": "ROLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "He said you were at the Dockside on the twelfth.", "name": "ARTEMIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "I was home.", "name": "ROLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Alone?", "name": "ARTEMIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "With my cat.", "name": "ROLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Rolly, the cat can't testify.", "name": "ARTEMIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Then you're in trouble.", "name": "ROLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "She stops clicking.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Locks eyes with him.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Listen to me. The DA offers eight years. Eight, Rolly. If we go to trial and lose, it's twenty.", "name": "ARTEMIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "And if we win?", "name": "ROLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "You walk.", "name": "ARTEMIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Then we win.", "name": "ROLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "That's not how it works.", "name": "ARTEMIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "That's how I want it to work.", "name": "ROLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "She flips a page.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Reads.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Turns another.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "The man in the photo recanted this morning.", "name": "ARTEMIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "What?", "name": "ROLLY", "speaker": 1, "ext": [], "paren": ["straightening"], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "The witness changed his story.", "name": "ARTEMIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "That's good.", "name": "ROLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "It's complicated, because someone leaned on him. And I think you know who.", "name": "ARTEMIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Rolly stares at the table.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "The fluorescent buzzes.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Ms. Cross. If I say a name, can you keep it in this room?", "name": "ROLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "That's the whole point of the room.", "name": "ARTEMIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "He leans forward.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "She lays down the pen.", "para": 8, "sent": 1, "present": [0, 1, 2]}]}