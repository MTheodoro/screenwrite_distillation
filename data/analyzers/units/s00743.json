{"scene_id": "s00743", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00743.fountain", "heading": "INT. COURTHOUSE ELEVATOR - DAY", "cast": [{"id": 0, "name": "NKIRU EZEIGBO", "names": ["NKIRU EZEIGBO", "NKIRU"], "gender": "f", "first": 4, "spoke": 5}, {"id": 1, "name": "WYATT MERRIWEATHER", "names": ["WYATT MERRIWEATHER", "WYATT"], "gender": "?", "first": 5, "spoke": 5}, {"id": 2, "name": "TOMASZ KOWAL", "names": ["TOMASZ KOWAL", "TOMASZ"], "gender": "m", "first": 6, "spoke": 2}, {"id": 3, "name": "JUDGE REYNOSO", "names": ["JUDGE REYNOSO"], "gender": "?", "first": 15, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. COURTHOUSE ELEVATOR - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Stainless steel.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Mirrored door.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Four floors of descent.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "NKIRU EZEIGBO, thirties, defence attorney, bangs her briefcase against her knee.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "WYATT MERRIWEATHER, forties, prosecutor, studies the floor numbers.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "TOMASZ KOWAL, fifties, bailiff, keeps both hands on his belt.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "The car shudders.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Lights flicker.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "The elevator stops between floors.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Of course.", "name": "NKIRU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "It does this.", "name": "WYATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Fourth time this month.", "name": "TOMASZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Nkiru's cell phone buzzes.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "She answers on speaker.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Counsel. Where are you?", "name": "JUDGE REYNOSO", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Stuck, Your Honour.", "name": "NKIRU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Both of you?", "name": "JUDGE REYNOSO", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Mr. Kowal is with us.", "name": "WYATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "I'm calling the jury. You have ten minutes.", "name": "JUDGE REYNOSO", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Wyatt, we need to settle.", "name": "NKIRU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "I know.", "name": "WYATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Then why did you reject my offer?", "name": "NKIRU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Because you didn't make one.", "name": "WYATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "I'm making one now.", "name": "NKIRU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "I'm making one now.", "name": "WYATT", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "They glare at each other in the mirror.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "For what it's worth, I'd take it.", "name": "TOMASZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Lights return.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "The elevator drops with a lurch.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "All three grab the rail.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}]}