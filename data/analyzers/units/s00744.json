{"scene_id": "s00744", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00744.fountain", "heading": "INT. NORMANDY FARMHOUSE - CELLAR - NIGHT (1944)", "cast": [{"id": 0, "name": "MARGUERITE LEBLANC", "names": ["MARGUERITE LEBLANC", "MARGUERITE"], "gender": "?", "first": 6, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. NORMANDY FARMHOUSE - CELLAR - NIGHT (1944)", "present": []}, {"u": 1, "kind": "action", "text": "Stone steps.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sacks of seed potatoes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wine racks lie smashed.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single oil lamp throws a trembling circle on the floor.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Above, the rhythmic thud of distant artillery sifts dust from the beams.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "MARGUERITE LEBLANC, thirties, war correspondent, trench coat torn at the shoulder, kneels over a wire recorder balanced on a crate.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Her hands are steady.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "Her face is not.", "para": 1, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "She threads the wire through the reel.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "Listens upward.", "para": 2, "sent": 1, "present": [0]}, {"u": 11, "kind": "action", "text": "Threads it again.", "para": 2, "sent": 2, "present": [0]}, {"u": 12, "kind": "action", "text": "She presses the record lever.", "para": 3, "sent": 0, "present": [0]}, {"u": 13, "kind": "action", "text": "A red light glows.", "para": 3, "sent": 1, "present": [0]}, {"u": 14, "kind": "dialogue", "text": "This is Marguerite LeBlanc. The ninth of June, nineteen forty-four. I am in a cellar outside Carentan. The Germans are in the next field.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": ["into the microphone, low"], "dual": false, "present": [0]}, {"u": 15, "kind": "action", "text": "A shell lands close.", "para": 4, "sent": 0, "present": [0]}, {"u": 16, "kind": "action", "text": "Dust rains.", "para": 4, "sent": 1, "present": [0]}, {"u": 17, "kind": "action", "text": "She flinches, covers the recorder with her body, then straightens.", "para": 4, "sent": 2, "present": [0]}, {"u": 18, "kind": "dialogue", "text": "They have been shelling for six hours. I have no food. I have a notebook and this machine.", "name": "MARGUERITE", "speaker": 0, "ext": ["CONT'D"], "paren": ["into the microphone"], "dual": false, "present": [0]}, {"u": 19, "kind": "action", "text": "She stops.", "para": 5, "sent": 0, "present": [0]}, {"u": 20, "kind": "action", "text": "Rewinds.", "para": 5, "sent": 1, "present": [0]}, {"u": 21, "kind": "action", "text": "Plays it back.", "para": 5, "sent": 2, "present": [0]}, {"u": 22, "kind": "dialogue", "text": "\"...I have no food. I have a notebook and this machine.\"", "name": "MARGUERITE", "speaker": 0, "ext": ["V.O."], "paren": ["from the machine, tinny"], "dual": false, "present": [0]}, {"u": 23, "kind": "action", "text": "She grimaces.", "para": 6, "sent": 0, "present": [0]}, {"u": 24, "kind": "action", "text": "Presses stop.", "para": 6, "sent": 1, "present": [0]}, {"u": 25, "kind": "action", "text": "Presses record again.", "para": 6, "sent": 2, "present": [0]}, {"u": 26, "kind": "dialogue", "text": "Correction. I have a notebook, this machine, and half a tin of sardines.", "name": "MARGUERITE", "speaker": 0, "ext": ["CONT'D"], "paren": ["into the microphone"], "dual": false, "present": [0]}, {"u": 27, "kind": "action", "text": "A wry twist of her mouth.", "para": 7, "sent": 0, "present": [0]}, {"u": 28, "kind": "action", "text": "She opens the tin with her penknife.", "para": 7, "sent": 1, "present": [0]}, {"u": 29, "kind": "action", "text": "Eats one fish with her fingers.", "para": 7, "sent": 2, "present": [0]}, {"u": 30, "kind": "action", "text": "Upstairs, a door BANGS.", "para": 8, "sent": 0, "present": [0]}, {"u": 31, "kind": "action", "text": "Boots on boards.", "para": 8, "sent": 1, "present": [0]}, {"u": 32, "kind": "action", "text": "She goes still.", "para": 8, "sent": 2, "present": [0]}, {"u": 33, "kind": "action", "text": "She slides the tin under the crate.", "para": 8, "sent": 3, "present": [0]}, {"u": 34, "kind": "action", "text": "She extinguishes the lamp with her palm.", "para": 8, "sent": 4, "present": [0]}, {"u": 35, "kind": "action", "text": "Darkness.", "para": 9, "sent": 0, "present": [0]}, {"u": 36, "kind": "action", "text": "Only the faint red glow of the recorder.", "para": 9, "sent": 1, "present": [0]}, {"u": 37, "kind": "action", "text": "She smothers it with her coat.", "para": 9, "sent": 2, "present": [0]}, {"u": 38, "kind": "action", "text": "Boots cross the floor above, step by step.", "para": 10, "sent": 0, "present": [0]}, {"u": 39, "kind": "action", "text": "Dust trickles.", "para": 10, "sent": 1, "present": [0]}, {"u": 40, "kind": "action", "text": "Her breath is shallow and quick.", "para": 10, "sent": 2, "present": [0]}, {"u": 41, "kind": "action", "text": "The boots stop directly overhead.", "para": 11, "sent": 0, "present": [0]}, {"u": 42, "kind": "action", "text": "A floorboard creaks.", "para": 11, "sent": 1, "present": [0]}, {"u": 43, "kind": "action", "text": "She does not move.", "para": 11, "sent": 2, "present": [0]}, {"u": 44, "kind": "action", "text": "She does not blink.", "para": 11, "sent": 3, "present": [0]}, {"u": 45, "kind": "action", "text": "A voice mutters in German.", "para": 12, "sent": 0, "present": [0]}, {"u": 46, "kind": "action", "text": "A second answers, lower.", "para": 12, "sent": 1, "present": [0]}, {"u": 47, "kind": "action", "text": "A laugh.", "para": 12, "sent": 2, "present": [0]}, {"u": 48, "kind": "action", "text": "The boots move away toward the front door.", "para": 12, "sent": 3, "present": [0]}, {"u": 49, "kind": "action", "text": "She exhales, long and slow.", "para": 13, "sent": 0, "present": [0]}, {"u": 50, "kind": "action", "text": "Lifts the coat.", "para": 13, "sent": 1, "present": [0]}, {"u": 51, "kind": "action", "text": "The recorder's red eye glows, defiant.", "para": 13, "sent": 2, "present": [0]}, {"u": 52, "kind": "action", "text": "She relights the lamp with trembling fingers.", "para": 14, "sent": 0, "present": [0]}, {"u": 53, "kind": "action", "text": "She pulls the microphone to her mouth.", "para": 14, "sent": 1, "present": [0]}, {"u": 54, "kind": "dialogue", "text": "They have gone. For now.", "name": "MARGUERITE", "speaker": 0, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0]}, {"u": 55, "kind": "action", "text": "She winds the wire back.", "para": 15, "sent": 0, "present": [0]}, {"u": 56, "kind": "action", "text": "Plays.", "para": 15, "sent": 1, "present": [0]}, {"u": 57, "kind": "dialogue", "text": "\"They have gone. For now.\"", "name": "MARGUERITE", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": ["from the machine"], "dual": false, "present": [0]}, {"u": 58, "kind": "action", "text": "She stares at the spinning reel.", "para": 16, "sent": 0, "present": [0]}, {"u": 59, "kind": "action", "text": "Then she reaches for her notebook and begins to write, fast, the pencil scratching in time with the shells.", "para": 16, "sent": 1, "present": [0]}, {"u": 60, "kind": "action", "text": "Another shell lands.", "para": 17, "sent": 0, "present": [0]}, {"u": 61, "kind": "action", "text": "Closer.", "para": 17, "sent": 1, "present": [0]}, {"u": 62, "kind": "action", "text": "Plaster falls from the ceiling and settles in her hair.", "para": 17, "sent": 2, "present": [0]}, {"u": 63, "kind": "action", "text": "She keeps writing.", "para": 18, "sent": 0, "present": [0]}, {"u": 64, "kind": "dialogue", "text": "The cellar door is the only way out. It is locked from the outside.", "name": "MARGUERITE", "speaker": 0, "ext": ["CONT'D"], "paren": ["into the microphone, steady"], "dual": false, "present": [0]}, {"u": 65, "kind": "action", "text": "She stops.", "para": 19, "sent": 0, "present": [0]}, {"u": 66, "kind": "action", "text": "Looks at the stairs.", "para": 19, "sent": 1, "present": [0]}, {"u": 67, "kind": "action", "text": "The top step is bright with a thin line of lamplight from under the door.", "para": 19, "sent": 2, "present": [0]}, {"u": 68, "kind": "action", "text": "She rises, climbs three steps, and tests the handle.", "para": 20, "sent": 0, "present": [0]}, {"u": 69, "kind": "action", "text": "It does not give.", "para": 20, "sent": 1, "present": [0]}, {"u": 70, "kind": "dialogue", "text": "Naturally.", "name": "MARGUERITE", "speaker": 0, "ext": ["CONT'D"], "paren": ["to herself"], "dual": false, "present": [0]}, {"u": 71, "kind": "action", "text": "She descends.", "para": 21, "sent": 0, "present": [0]}, {"u": 72, "kind": "action", "text": "Sits again at the recorder.", "para": 21, "sent": 1, "present": [0]}, {"u": 73, "kind": "action", "text": "Presses record.", "para": 21, "sent": 2, "present": [0]}, {"u": 74, "kind": "dialogue", "text": "If this recording is found, please send it to the Daily Courier, London. Tell them I filed on time.", "name": "MARGUERITE", "speaker": 0, "ext": ["CONT'D"], "paren": ["into the microphone"], "dual": false, "present": [0]}, {"u": 75, "kind": "action", "text": "She smiles at that.", "para": 22, "sent": 0, "present": [0]}, {"u": 76, "kind": "action", "text": "It does not last.", "para": 22, "sent": 1, "present": [0]}, {"u": 77, "kind": "action", "text": "The ceiling groans.", "para": 23, "sent": 0, "present": [0]}, {"u": 78, "kind": "action", "text": "A crack runs along the central beam.", "para": 23, "sent": 1, "present": [0]}, {"u": 79, "kind": "action", "text": "Sand drips in a steady stream.", "para": 23, "sent": 2, "present": [0]}, {"u": 80, "kind": "action", "text": "She gathers the notebook and the reel into her satchel.", "para": 24, "sent": 0, "present": [0]}, {"u": 81, "kind": "action", "text": "She slings it across her chest.", "para": 24, "sent": 1, "present": [0]}, {"u": 82, "kind": "action", "text": "She climbs the stairs, braces her shoulder against the door, and shoves.", "para": 24, "sent": 2, "present": [0]}, {"u": 83, "kind": "action", "text": "Once.", "para": 24, "sent": 3, "present": [0]}, {"u": 84, "kind": "action", "text": "Twice.", "para": 24, "sent": 4, "present": [0]}, {"u": 85, "kind": "action", "text": "The wood creaks but holds.", "para": 25, "sent": 0, "present": [0]}, {"u": 86, "kind": "action", "text": "She steps back, breathing hard, and looks for something.", "para": 26, "sent": 0, "present": [0]}, {"u": 87, "kind": "action", "text": "Anything.", "para": 26, "sent": 1, "present": [0]}, {"u": 88, "kind": "action", "text": "Her eyes land on the broken wine rack.", "para": 26, "sent": 2, "present": [0]}, {"u": 89, "kind": "action", "text": "She grabs a splintered post.", "para": 26, "sent": 3, "present": [0]}, {"u": 90, "kind": "action", "text": "She wedges it under the latch.", "para": 27, "sent": 0, "present": [0]}, {"u": 91, "kind": "action", "text": "She leans her whole weight on it.", "para": 27, "sent": 1, "present": [0]}, {"u": 92, "kind": "action", "text": "The door cracks.", "para": 28, "sent": 0, "present": [0]}, {"u": 93, "kind": "action", "text": "Light spills down the steps.", "para": 28, "sent": 1, "present": [0]}, {"u": 94, "kind": "action", "text": "She shoves harder, teeth bared.", "para": 28, "sent": 2, "present": [0]}, {"u": 95, "kind": "action", "text": "The door gives.", "para": 29, "sent": 0, "present": [0]}, {"u": 96, "kind": "action", "text": "She tumbles into a kitchen with half a roof, and lies on the floor for one breath, two, in the red glow of a burning barn through the window.", "para": 29, "sent": 1, "present": [0]}, {"u": 97, "kind": "action", "text": "She sits up.", "para": 30, "sent": 0, "present": [0]}, {"u": 98, "kind": "action", "text": "Checks the satchel.", "para": 30, "sent": 1, "present": [0]}, {"u": 99, "kind": "action", "text": "The reel is intact.", "para": 30, "sent": 2, "present": [0]}, {"u": 100, "kind": "dialogue", "text": "Filed.", "name": "MARGUERITE", "speaker": 0, "ext": ["CONT'D"], "paren": ["a whisper, almost a laugh"], "dual": false, "present": [0]}, {"u": 101, "kind": "action", "text": "She stands, pulls the coat tight, and walks out into the firelight.", "para": 31, "sent": 0, "present": [0]}]}