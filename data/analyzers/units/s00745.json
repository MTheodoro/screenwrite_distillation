{"scene_id": "s00745", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00745.fountain", "heading": "INT. PLANETARIUM DOME - AFTER HOURS", "cast": [{"id": 0, "name": "IMOGEN VASSEUR", "names": ["IMOGEN VASSEUR", "IMOGEN"], "gender": "f", "first": 4, "spoke": 4}, {"id": 1, "name": "TAVIAN OKONJO", "names": ["TAVIAN OKONJO", "TAVIAN"], "gender": "?", "first": 5, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. PLANETARIUM DOME - AFTER HOURS", "present": []}, {"u": 1, "kind": "action", "text": "The false sky hangs overhead, a hush of ten thousand painted stars.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Reclined seats form concentric rings below.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The projector at the centre hums like a sleeping animal.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "IMOGEN VASSEUR, thirties, in a green coat, sits in the third row with her shoes off, one foot tucked beneath her.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside her, TAVIAN OKONJO, thirties, tie loosened, holds a paper bag of roasted chestnuts, steam curling from the top.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Orion.", "name": "TAVIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "That's Cassiopeia.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "It has a belt.", "name": "TAVIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "It has a W.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "They laugh and reach into the bag at the same moment.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Their hands collide inside it.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "They both freeze, fingers touching chestnut shells, the heat of the paper between them.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Neither pulls away.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Overhead, the sky rotates one degree.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "A meteor streaks across the dome, projected, perfect.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Tavian. I got the fellowship.", "name": "IMOGEN", "speaker": 0, "ext": ["CONT'D"], "paren": ["softly"], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "His fingers loosen.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "The bag tilts.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Chestnuts roll out across the seat and fall one by one into the dark.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "He does not catch them.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Where?", "name": "TAVIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Santiago.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "They both look up at a sky that suddenly seems very large.", "para": 5, "sent": 0, "present": [0, 1]}]}