{"scene_id": "s00746", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00746.fountain", "heading": "EXT. JUNGLE CLEARING - CRASHED BUSH PLANE - DAY", "cast": [{"id": 0, "name": "CORA", "names": ["CORA"], "gender": "?", "first": 4, "spoke": 9}, {"id": 1, "name": "MALABANAN", "names": ["MALABANAN"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "IFEOMA NNADI", "names": ["IFEOMA NNADI", "IFEOMA"], "gender": "?", "first": 5, "spoke": 6}, {"id": 3, "name": "GRETCHEN HOLM", "names": ["GRETCHEN HOLM", "GRETCHEN"], "gender": "f", "first": 6, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "EXT. JUNGLE CLEARING - CRASHED BUSH PLANE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "The fuselage lies like a dead insect, one wing crumpled against a kapok tree.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Steam rises from the earth.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Insects drone.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CORAZON \"CORA\" MALABANAN, forties, pilot, sits on the wing with her leg splinted in a map.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "IFEOMA NNADI, thirties, geologist, kneels at a stream, filling bottles.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "GRETCHEN HOLM, twenties, intern, paces with a hand over her mouth.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Gretchen, sit.", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "I can't.", "name": "GRETCHEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "You can. You're just choosing not to.", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Water's clean. I tested it.", "name": "IFEOMA", "speaker": 2, "ext": [], "paren": ["from the stream"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "How do you test water?", "name": "GRETCHEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "I drank a mouthful an hour ago. I'm still here.", "name": "IFEOMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Practical.", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Cora, how long until the beacon pings?", "name": "IFEOMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Two days. Maybe three.", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Maybe four!", "name": "GRETCHEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Maybe four.", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Ifeoma crosses and hands Cora a bottle.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Cora drinks and passes it to Gretchen, who drinks and hands it back, shaking.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "It's so quiet.", "name": "GRETCHEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "It isn't. Listen.", "name": "IFEOMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "They listen.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "The drone swells.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Under it, something rhythmic.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Wood on wood.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "That's a drum.", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Is that good?", "name": "GRETCHEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Possibly.", "name": "IFEOMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Possibly not.", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "They look at each other.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "The drumming stops.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "A hush falls, absolute.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "What does that mean?", "name": "GRETCHEN", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "It means they know we're here.", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "It means they've been watching us.", "name": "IFEOMA", "speaker": 2, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Both women speak at once, voices overlapping.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Gretchen backs toward the plane.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Who are \"they\"?", "name": "GRETCHEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "The bushes part.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "A line of figures in painted masks emerges silently.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "The three women stand shoulder to shoulder.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Nobody run.", "name": "CORA", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}]}