{"scene_id": "s00748", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00748.fountain", "heading": "INT. CORPORATE OFFICE - 31ST FLOOR - MORNING", "cast": [{"id": 0, "name": "HORTENSE BELLWEATHER", "names": ["HORTENSE BELLWEATHER", "HORTENSE"], "gender": "f", "first": 5, "spoke": 19}, {"id": 1, "name": "ARCHIBALD DRUMMOND", "names": ["ARCHIBALD", "ARCHIBALD DRUMMOND"], "gender": "?", "first": 11, "spoke": 18}], "units": [{"u": 0, "kind": "heading", "text": "INT. CORPORATE OFFICE - 31ST FLOOR - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "An open-plan floor of the sort that wins architecture awards and loses employees.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Glass walls.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Beanbags nobody sits in.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A kombucha tap that dispenses nothing.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "In the corner office, behind a desk the size of a landing strip, sits HORTENSE BELLWEATHER, fifties, in a charcoal suit and a necklace of tiny silver clocks.", "para": 0, "sent": 4, "present": [0]}, {"u": 6, "kind": "action", "text": "She has the posture of a woman who has survived four mergers.", "para": 0, "sent": 5, "present": [0]}, {"u": 7, "kind": "action", "text": "On the desk, a speakerphone the colour of an old tooth.", "para": 1, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Beside it, a cold cup of tea.", "para": 1, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "She stares at the phone.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "It blinks green.", "para": 2, "sent": 1, "present": [0]}, {"u": 11, "kind": "dialogue", "text": "Archibald. Speak.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Hortense! Morning! Lovely morning. Are you looking out the window?", "name": "ARCHIBALD", "speaker": 1, "ext": ["V.O."], "paren": ["over speakerphone, jaunty"], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "I'm looking at my screen.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Look out the window.", "name": "ARCHIBALD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She turns her chair.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Across the plaza, in the opposing tower, a man in a cream suit waves from the thirty-first floor.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "ARCHIBALD DRUMMOND, sixties, silver hair, big teeth.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He holds his own phone to his ear and waves with the other hand.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "You moved your desk to face mine.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Corporate suggested \"transparency.\"", "name": "ARCHIBALD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Corporate suggested \"dialogue.\"", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Transparency is dialogue with glass.", "name": "ARCHIBALD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Hortense sets her tea down.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She does not smile.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "The clocks on her necklace jingle.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "What do you want?", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "A little chat. About the Henderson account.", "name": "ARCHIBALD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "The Henderson account is mine.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Is it?", "name": "ARCHIBALD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "I won it.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "You did. In 2016.", "name": "ARCHIBALD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "She taps a pen on the desk.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Across the plaza, Archibald pulls a thick binder from a drawer and holds it up to the glass, like a magician showing an empty hat.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "What's that?", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "The reorganisation.", "name": "ARCHIBALD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "I wasn't consulted.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "You were cc'd.", "name": "ARCHIBALD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "On a Friday at five.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Best day for news.", "name": "ARCHIBALD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "She rises and crosses to the window, pressing a hand to the cold glass.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Down below, the plaza fountain is dry, its basin full of cigarette butts and coins.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "A pigeon bathes in the dust.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Under the plan, who reports to whom?", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "You report to me.", "name": "ARCHIBALD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Say that again.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "You. Report. To me.", "name": "ARCHIBALD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Hortense nods slowly.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "She returns to her chair.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "She picks up the speakerphone and brings it close, until her mouth is inches from the grille.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Archibald. How many years have you worked here?", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Nineteen.", "name": "ARCHIBALD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "And how many have I?", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "Thirty-one.", "name": "ARCHIBALD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "Thirty-one. Do you know what I've learned?", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "That silence is golden?", "name": "ARCHIBALD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "That people with binders are afraid of people without them.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "Across the plaza, Archibald's smile flickers.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "He lowers the binder.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "Hortense, this isn't personal.", "name": "ARCHIBALD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "It's the most personal thing in this building.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "She opens a drawer.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "Withdraws a single sheet of paper and a gold fountain pen.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "She uncaps the pen with a small, decisive click.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "She writes.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "The nib scratches.", "para": 9, "sent": 4, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "Across the way, Archibald leans forward, squinting.", "para": 9, "sent": 5, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "What are you doing?", "name": "ARCHIBALD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "Redistributing.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "She holds the sheet to the window.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 70, "kind": "action", "text": "Large block letters, readable even at forty yards: I RESIGN.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "EFFECTIVE IMMEDIATELY.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "TAKE THE KOMBUCHA.", "para": 10, "sent": 3, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "Archibald's mouth opens.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 74, "kind": "action", "text": "The binder slips from his hands.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 75, "kind": "action", "text": "He bends to retrieve it and bumps his head on the desk.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 76, "kind": "dialogue", "text": "Hortense!", "name": "ARCHIBALD", "speaker": 1, "ext": ["V.O."], "paren": ["muffled, wincing"], "dual": false, "present": [0, 1]}, {"u": 77, "kind": "dialogue", "text": "Goodbye, Archibald.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 78, "kind": "action", "text": "She presses the button.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 79, "kind": "action", "text": "The line clicks dead.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 80, "kind": "action", "text": "She gathers her tea, her pen, and a single silver clock from the necklace, which she unhooks and places on the desk like a chess piece.", "para": 12, "sent": 2, "present": [0, 1]}, {"u": 81, "kind": "action", "text": "Then she walks out, heels ringing on the polished floor, past the empty beanbags and the silent tap, and into the elevator.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 82, "kind": "action", "text": "Across the plaza, Archibald presses his face to the glass.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 83, "kind": "action", "text": "Behind him, the floor has gone very quiet.", "para": 14, "sent": 1, "present": [0, 1]}]}