{"scene_id": "s00749", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00749.fountain", "heading": "INT. TAXIDERMIST'S WORKSHOP - NIGHT", "cast": [{"id": 0, "name": "BASTIAN VOLKERS", "names": ["BASTIAN VOLKERS", "BASTIAN"], "gender": "?", "first": 5, "spoke": 2}, {"id": 1, "name": "SOLENE", "names": ["SOLENE"], "gender": "?", "first": 5, "spoke": 1}, {"id": 2, "name": "MERIEL", "names": ["MERIEL"], "gender": "?", "first": 5, "spoke": 1}, {"id": 3, "name": "ROYSTON", "names": ["ROYSTON"], "gender": "?", "first": 5, "spoke": 1}, {"id": 4, "name": "GIRL", "names": ["GIRL"], "gender": "?", "first": 5, "spoke": 2}, {"id": 5, "name": "PIA", "names": ["PIA"], "gender": "?", "first": 21, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. TAXIDERMIST'S WORKSHOP - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A long room of glass eyes.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Foxes, owls, a stag with one antler snapped.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Moonlight crawls over the benches.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A power cut has stopped the wall clock at 2:14.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Five people stand in the dark with a single torch: BASTIAN VOLKERS, forties, who owns the place; his sister SOLENE, thirties; their cousin MERIEL, twenties; the neighbour ROYSTON, sixties; and a GIRL, perhaps ten, in a nightgown, whom no one has invited.", "para": 1, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 6, "kind": "dialogue", "text": "Who let you in?", "name": "BASTIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "action", "text": "The Girl says nothing.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "She stares at the stag.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Bas, she's soaked. Look at her feet.", "name": "SOLENE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Where are your parents, sweetheart?", "name": "MERIEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "The Girl lifts a hand and points.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Not at any of them.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "At the stag.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Her fingers tremble.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Child, that's a dead deer.", "name": "ROYSTON", "speaker": 3, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "He said I could sleep in him.", "name": "GIRL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "They freeze.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "The torch jerks.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Light skates across the glass eyes, and every one seems to turn.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Who said?", "name": "BASTIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "My name is Pia.", "name": "GIRL", "speaker": 4, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Behind her, the stag's head slowly lowers.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "He's very warm.", "name": "PIA", "speaker": 5, "ext": [], "paren": ["smiling"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}