{"scene_id": "s00750", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00750.fountain", "heading": "INT. CITY BANK - SUBTERRANEAN VAULT - NIGHT", "cast": [{"id": 0, "name": "SABINE ARROWOOD", "names": ["SABINE ARROWOOD", "SABINE"], "gender": "f", "first": 11, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. CITY BANK - SUBTERRANEAN VAULT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cathedral of steel.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of safe-deposit boxes climb the walls, thousands of little brass doors.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Cold light from a single emergency strip.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The great round door stands ajar, its locking bolts retracted like the fingers of a sleeper.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Empty.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "Silent.", "para": 1, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "A single security camera turns on its bracket and finds nothing.", "para": 1, "sent": 2, "present": []}, {"u": 8, "kind": "action", "text": "A footfall on the stairs.", "para": 2, "sent": 0, "present": []}, {"u": 9, "kind": "action", "text": "Another.", "para": 2, "sent": 1, "present": []}, {"u": 10, "kind": "action", "text": "Then the quiet scrape of a crowbar being laid down.", "para": 2, "sent": 2, "present": []}, {"u": 11, "kind": "action", "text": "SABINE ARROWOOD, forties, enters in a black jumpsuit, gloves tucked in her belt, a canvas bag over one shoulder.", "para": 3, "sent": 0, "present": [0]}, {"u": 12, "kind": "action", "text": "Dark hair under a cap.", "para": 3, "sent": 1, "present": [0]}, {"u": 13, "kind": "action", "text": "She pauses at the door, looks at the open bolts, and smiles slightly as if at a private joke.", "para": 3, "sent": 2, "present": [0]}, {"u": 14, "kind": "dialogue", "text": "Sloppy.", "name": "SABINE", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0]}, {"u": 15, "kind": "action", "text": "She crosses the vault, runs a gloved finger along the boxes.", "para": 4, "sent": 0, "present": [0]}, {"u": 16, "kind": "action", "text": "Stops at number 4417.", "para": 4, "sent": 1, "present": [0]}, {"u": 17, "kind": "action", "text": "She reaches into her bag and takes out a small recorder.", "para": 4, "sent": 2, "present": [0]}, {"u": 18, "kind": "action", "text": "She clicks it on.", "para": 4, "sent": 3, "present": [0]}, {"u": 19, "kind": "dialogue", "text": "\"If you're hearing this, Sabine, the door will be open, and the box will be empty. Don't panic. That's the plan.\"", "name": "SABINE", "speaker": 0, "ext": ["V.O."], "paren": ["from the recorder, her own voice, recorded days ago"], "dual": false, "present": [0]}, {"u": 20, "kind": "action", "text": "Sabine stares at the recorder.", "para": 5, "sent": 0, "present": [0]}, {"u": 21, "kind": "action", "text": "Her smile fades.", "para": 5, "sent": 1, "present": [0]}, {"u": 22, "kind": "action", "text": "She clicks it off.", "para": 5, "sent": 2, "present": [0]}, {"u": 23, "kind": "action", "text": "She slides the key into 4417.", "para": 5, "sent": 3, "present": [0]}, {"u": 24, "kind": "action", "text": "Turns.", "para": 5, "sent": 4, "present": [0]}, {"u": 25, "kind": "action", "text": "The door swings open.", "para": 5, "sent": 5, "present": [0]}, {"u": 26, "kind": "action", "text": "Nothing inside but a folded note.", "para": 5, "sent": 6, "present": [0]}, {"u": 27, "kind": "action", "text": "She unfolds it.", "para": 6, "sent": 0, "present": [0]}, {"u": 28, "kind": "action", "text": "Reads.", "para": 6, "sent": 1, "present": [0]}, {"u": 29, "kind": "dialogue", "text": "Clever girl.", "name": "SABINE", "speaker": 0, "ext": ["CONT'D"], "paren": ["softly"], "dual": false, "present": [0]}, {"u": 30, "kind": "action", "text": "She pockets the note, shoulders the bag, and strides to the open vault door.", "para": 7, "sent": 0, "present": [0]}, {"u": 31, "kind": "action", "text": "Alarms stay silent.", "para": 7, "sent": 1, "present": [0]}, {"u": 32, "kind": "action", "text": "She pauses at the threshold, glances back at the shining wall of boxes, and shuts the great door behind her.", "para": 7, "sent": 2, "present": [0]}]}