{"scene_id": "s00753", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00753.fountain", "heading": "INT. VILLAGE CHURCH - WEDDING - DAY", "cast": [{"id": 0, "name": "CONGRATS ROSALIND", "names": ["CONGRATS ROSALIND", "ROSALIND"], "gender": "?", "first": 3, "spoke": 3}, {"id": 1, "name": "GROOM FERDINAND", "names": ["FERDINAND", "GROOM FERDINAND"], "gender": "?", "first": 3, "spoke": 2}, {"id": 2, "name": "BRIDE ROSALIND", "names": ["BRIDE ROSALIND"], "gender": "?", "first": 3, "spoke": 0}, {"id": 3, "name": "FATHER MALACHY", "names": ["FATHER MALACHY"], "gender": "?", "first": 6, "spoke": 3}, {"id": 4, "name": "MOTHER IRENE", "names": ["MOTHER IRENE"], "gender": "?", "first": 7, "spoke": 1}, {"id": 5, "name": "BEST MAN", "names": ["BEST MAN"], "gender": "?", "first": 8, "spoke": 2}, {"id": 6, "name": "GIDEON", "names": ["GIDEON"], "gender": "?", "first": 15, "spoke": 1}, {"id": 7, "name": "DJ", "names": ["DJ"], "gender": "?", "first": 18, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. VILLAGE CHURCH - WEDDING - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Pews packed.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Organ droning.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A banner reading CONGRATS ROSALIND & FERDINAND, slightly crooked.", "para": 0, "sent": 2, "present": [0, 1, 2]}, {"u": 4, "kind": "action", "text": "At the altar: BRIDE ROSALIND, thirties, in a dress with a train like a snow drift.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 5, "kind": "action", "text": "GROOM FERDINAND, thirties, sweating through a rented tux.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "FATHER MALACHY, sixties, bearded officiant, clutching a prayer book.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "In the front pew, MOTHER IRENE, sixties, in a hat the size of a satellite dish.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "Beside Ferdinand: BEST MAN, twenties, hungover, swaying.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "If anyone objects to this union, speak now.", "name": "FATHER MALACHY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "A pause.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "The BEST MAN raises a hand.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Hang on.", "name": "BEST MAN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Oh, for God's sake.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "I just wanted to say I love you both.", "name": "BEST MAN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Thank you, Gideon.", "name": "FERDINAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "action", "text": "The Best Man, now GIDEON, beams.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "action", "text": "Over the church speakers, a booming voice.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "Ladies and gentlemen, give it up for the happy couple!", "name": "DJ", "speaker": 7, "ext": ["V.O."], "paren": ["over PA"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 19, "kind": "dialogue", "text": "We're not there yet!", "name": "FATHER MALACHY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 20, "kind": "dialogue", "text": "Who hired that man?", "name": "MOTHER IRENE", "speaker": 4, "ext": [], "paren": ["standing"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 21, "kind": "dialogue", "text": "Mother!", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 22, "kind": "dialogue", "text": "Drop the bass!", "name": "DJ", "speaker": 7, "ext": ["V.O."], "paren": ["over PA"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 23, "kind": "action", "text": "A thump rattles the pews.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 24, "kind": "action", "text": "Everyone ducks.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 25, "kind": "dialogue", "text": "Best. Day. Ever.", "name": "GIDEON", "speaker": 6, "ext": [], "paren": ["slurring"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 26, "kind": "dialogue", "text": "Rosalind, I do. I do. Can we just finish?", "name": "FERDINAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 27, "kind": "dialogue", "text": "Fine. I do!", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 28, "kind": "dialogue", "text": "You may now--", "name": "FATHER MALACHY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 29, "kind": "action", "text": "The organ explodes into a dance remix.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "action", "text": "Everyone throws up their hands.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}