{"scene_id": "s00758", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00758.fountain", "heading": "INT. MRI SUITE - HOSPITAL BASEMENT - NIGHT", "cast": [{"id": 0, "name": "SAOIRSE KEANE", "names": ["SAOIRSE KEANE", "SAOIRSE"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "TECH DELPHINE ABERNATHY", "names": ["TECH DELPHINE ABERNATHY", "DELPHINE"], "gender": "?", "first": 5, "spoke": 5}, {"id": 2, "name": "EUSTACE QUINN", "names": ["EUSTACE QUINN", "EUSTACE"], "gender": "?", "first": 6, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. MRI SUITE - HOSPITAL BASEMENT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A white tube hums at the centre of a cold room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Warning signs plaster the walls.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Through a glass window, a control booth glows green.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. SAOIRSE KEANE, forties, radiologist, leans on the console.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "TECH DELPHINE ABERNATHY, twenties, adjusts a dial.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "On the sliding table inside the machine lies EUSTACE QUINN, seventies, a patient in a gown, hands folded across his chest.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Mr. Quinn, we're starting. Try to stay still.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "I'm still.", "name": "EUSTACE", "speaker": 2, "ext": ["V.O."], "paren": ["over intercom, shaky"], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Good.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "The machine thumps.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "A grey image flickers onto the monitor.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Saoirse leans forward.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Delphine does the same.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Their faces light from below.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "There.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "I see it.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "That's not a tumour.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "It is not.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "They share a smile of relief.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Delphine reaches for the intercom.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Mr. Quinn, good news--", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "On the screen the image jolts.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "The table inside the machine slides forward.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Eustace's hand flies up.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "A metal tray flies across the room and clangs against the tube.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "His ring!", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Pull the table!", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Both women lunge.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Delphine slams the emergency button, Saoirse throws her weight on the stop lever.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "The magnet whines down.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "They rush into the room, drag the table free, and catch Eustace as he sits up, gasping, his wedding ring tugging at his finger.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Forty years it's never come off.", "name": "EUSTACE", "speaker": 2, "ext": [], "paren": ["laughing and wincing"], "dual": false, "present": [0, 1, 2]}]}