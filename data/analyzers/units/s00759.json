{"scene_id": "s00759", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00759.fountain", "heading": "INT. CRANE & SONS FUNERAL HOME - VIEWING ROOM B - DAY", "cast": [{"id": 0, "name": "BARNABAS FLINT", "names": ["BARNABAS FLINT", "BARNABAS"], "gender": "?", "first": 5, "spoke": 7}, {"id": 1, "name": "ROSAMUND ACHEBE", "names": ["ROSAMUND ACHEBE", "ROSAMUND"], "gender": "m", "first": 6, "spoke": 6}, {"id": 2, "name": "HOLLIS DUNMORE", "names": ["HOLLIS DUNMORE", "HOLLIS"], "gender": "m", "first": 7, "spoke": 8}, {"id": 3, "name": "JUNO PAREKH", "names": ["JUNO PAREKH", "JUNO"], "gender": "f", "first": 8, "spoke": 2}, {"id": 4, "name": "LEOPOLD ISHIGURO", "names": ["LEOPOLD ISHIGURO", "LEOPOLD"], "gender": "m", "first": 9, "spoke": 2}, {"id": 5, "name": "SELWYN CRANE", "names": ["SELWYN CRANE", "SELWYN"], "gender": "?", "first": 10, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. CRANE & SONS FUNERAL HOME - VIEWING ROOM B - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A deposition in a room meant for mourning.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Folding tables have been set among potted lilies.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "An empty casket stands on a draped bier at the head of the room, lid open, lined with white satin.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Soft organ music leaks from a ceiling speaker no one can find the switch for.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "BARNABAS FLINT, fifties, plaintiff's counsel, sits at the near table with a stack of exhibits.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "ROSAMUND ACHEBE, forties, defence counsel, sits across from him, calm as a priest.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "At the head of the table, HOLLIS DUNMORE, sixties, the witness, a retired claims adjuster in a navy blazer, lowers himself into a funeral parlour armchair.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "JUNO PAREKH, twenties, the videographer, hunches behind her tripod.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "LEOPOLD ISHIGURO, fifties, the court reporter, sets up his steno machine by the casket.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "MR. SELWYN CRANE, seventies, funeral director, hovers in the doorway with a box of tissues.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Mr. Dunmore, I'm going to ask you to identify Exhibit Twelve.", "name": "BARNABAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Of course.", "name": "HOLLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Objection. Foundation.", "name": "ROSAMUND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "He wrote it.", "name": "BARNABAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "He hasn't said that.", "name": "ROSAMUND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "I wrote it.", "name": "HOLLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Don't help him, Mr. Dunmore.", "name": "ROSAMUND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "I'm only saying.", "name": "HOLLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Please read the highlighted line.", "name": "BARNABAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "\"Claim denied pursuant to section nine.\"", "name": "HOLLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Sorry, can you speak up?", "name": "JUNO", "speaker": 3, "ext": [], "paren": ["from behind the tripod"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "\"Claim denied pursuant to section nine.\"", "name": "HOLLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Section nine or section \"nine-dash-b\"?", "name": "LEOPOLD", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Nine.", "name": "HOLLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "And what is section nine?", "name": "BARNABAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Objection. Calls for a legal conclusion.", "name": "ROSAMUND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Forgive me. Would anyone like a tissue?", "name": "SELWYN", "speaker": 5, "ext": [], "paren": ["from the door, softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "No, thank you, Mr. Crane.", "name": "BARNABAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Not at present.", "name": "ROSAMUND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "I'll take one.", "name": "HOLLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Selwyn glides in, sets the box beside Hollis, and glides out.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Juno steps from behind the tripod to adjust the lens and trips on a lily pot.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Leopold catches the pot.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Barnabas and Rosamund both reach for the water pitcher at once; their hands knock it over, and a flood runs across the exhibits.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Hollis grabs his own copy and holds it above his head like a man fording a river.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Barnabas, that's my notes!", "name": "ROSAMUND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "It's my exhibit!", "name": "BARNABAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Can we go off the record?", "name": "LEOPOLD", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "I'm still rolling.", "name": "JUNO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Does anyone have a towel?", "name": "HOLLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Our finest.", "name": "SELWYN", "speaker": 5, "ext": [], "paren": ["returning, with an armload of black linen"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "They mop in silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "The organ swells.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Water drips off the casket's satin.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Let's resume.", "name": "BARNABAS", "speaker": 0, "ext": [], "paren": ["wringing a page"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}