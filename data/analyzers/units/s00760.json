{"scene_id": "s00760", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00760.fountain", "heading": "INT. WAX MUSEUM - GRAND GALLERY - NIGHT", "cast": [{"id": 0, "name": "HAROLD WINTERBOTTOM", "names": ["HAROLD WINTERBOTTOM", "HAROLD"], "gender": "?", "first": 4, "spoke": 2}, {"id": 1, "name": "ZUZANA KRAJEWSKI", "names": ["ZUZANA KRAJEWSKI", "ZUZANA"], "gender": "?", "first": 5, "spoke": 2}, {"id": 2, "name": "MOSES TEMBO", "names": ["MOSES TEMBO", "MOSES"], "gender": "?", "first": 5, "spoke": 2}, {"id": 3, "name": "KAI NAKAMURA-REID", "names": ["KAI NAKAMURA-REID", "KAI"], "gender": "?", "first": 6, "spoke": 1}, {"id": 4, "name": "ILSE ARENDT", "names": ["ILSE ARENDT", "ILSE"], "gender": "?", "first": 7, "spoke": 2}, {"id": 5, "name": "VESPER LANE", "names": ["VESPER LANE", "VESPER"], "gender": "?", "first": 24, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. WAX MUSEUM - GRAND GALLERY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Hushed.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of figures in frozen poses: a queen, a boxer, a saint, a pirate.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Their glass eyes catch the sodium glow from a security lamp.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "HAROLD WINTERBOTTOM, sixties, night guard, sits on a stool with a thermos.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Near the pirate, cleaners ZUZANA KRAJEWSKI, forties, and MOSES TEMBO, thirties, sweep.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "Apprentice KAI NAKAMURA-REID, nineteen, polishes a cabinet.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "Curator ILSE ARENDT, fifties, taps a tablet by the door.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "Quiet night.", "name": "HAROLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "They're always quiet.", "name": "ILSE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Moses. The boxer moved.", "name": "ZUZANA", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "He did not.", "name": "MOSES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "His fist was down.", "name": "ZUZANA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "It's still down.", "name": "MOSES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Kai stops polishing.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "He looks at the boxer's fist.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "It is raised.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Ms. Arendt?", "name": "KAI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Don't be silly, Kai.", "name": "ILSE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "The lights dip.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Harold stands, torch in hand, the stool toppling.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Ilse's tablet blinks out.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Zuzana and Moses back toward the saint, brooms raised, and Kai edges to Harold's side, polishing cloth clutched in his fist like a talisman.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "The door at the far end creaks open.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "VESPER LANE, thirties, in a long grey coat and white gloves, steps in.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Pale.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Perfectly still.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Hair pinned.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "A lace veil tucked into her collar.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "She stops beside the queen.", "para": 5, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "She tilts her head and looks at the five living people the way someone looks at figures in a window.", "para": 5, "sent": 6, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "I'm so sorry I'm late.", "name": "VESPER", "speaker": 5, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "We're closed, miss.", "name": "HAROLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "I know. I'm the fiftieth figure.", "name": "VESPER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "She walks to an empty plinth near the pirate and steps onto it.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Turns.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Folds her hands.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "And stops, mid-breath, mid-smile, mid-blink.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "No one moves.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "The boxer's fist drops with a soft clack.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}