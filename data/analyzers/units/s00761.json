{"scene_id": "s00761", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00761.fountain", "heading": "INT. ICE-FISHING SHANTY - ARCTIC LAKE - NIGHT", "cast": [{"id": 0, "name": "WALLY", "names": ["WALLY"], "gender": "m", "first": 6, "spoke": 12}, {"id": 1, "name": "BRODERICK", "names": ["BRODERICK"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "EMMANUEL OKAFOR-NWANKWO", "names": ["EMMANUEL OKAFOR-NWANKWO", "EMMANUEL"], "gender": "m", "first": 7, "spoke": 8}, {"id": 3, "name": "STRANGER", "names": ["STRANGER"], "gender": "m", "first": 12, "spoke": 2}, {"id": 4, "name": "JONAS", "names": ["JONAS"], "gender": "m", "first": 21, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. ICE-FISHING SHANTY - ARCTIC LAKE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A plywood box on a frozen lake.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A stove glows red.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Two holes in the floor, black water showing, lines trembling.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Frost on the walls.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The wind outside is a crowd of ghosts.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "WALLACE \"WALLY\" BRODERICK, fifties, big man, gutting a fish at the table.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "EMMANUEL OKAFOR-NWANKWO, thirties, schoolteacher, huddles by the stove with a mug.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Neither says much.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "The door bangs.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Snow whips in.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "A figure in a snow-crusted parka stumbles inside, pulls the door shut, and leans against it, gasping.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Thank God. I saw the light.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Sit. Warm up.", "name": "WALLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "The Stranger drops onto a bucket, pulls off his hood.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "A young man, lips blue, eyebrows frosted.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "His hands shake.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Emmanuel passes him the mug without a word.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "He drinks.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "His eyes flick to the knife in Wally's hand, then to the fish, then away.", "para": 3, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "What's your name?", "name": "EMMANUEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Jonas.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Where are you headed, Jonas?", "name": "EMMANUEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "The north shore. My truck died.", "name": "JONAS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "There's no road on the north shore.", "name": "WALLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "There is a cabin.", "name": "JONAS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "There's no cabin.", "name": "WALLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Then I was lied to.", "name": "JONAS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "He laughs, uneasy.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Emmanuel sets a hand on the stove and warms it.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Wally slices the fish with a short, sure stroke, and for a while only the knife speaks.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "He's right, Wally. People get lost.", "name": "EMMANUEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "People do.", "name": "WALLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Jonas finishes the mug and sets it down.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "He stretches his hands to the fire and looks, for the first time, relaxed.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Wally slides a piece of fish across to him on the blade.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Jonas takes it, chews, nods thanks.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Who's got the line?", "name": "JONAS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "He does.", "name": "WALLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Wally nods at Emmanuel.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Emmanuel lifts the line.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "A fish thrashes.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "He hauls.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Jonas leans in to help.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "They both grip the line.", "para": 6, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Wally watches them, his knife stilled in his hand.", "para": 6, "sent": 6, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "The fish comes up, a fat lake trout, silver-black.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Emmanuel laughs.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Jonas laughs.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Wally doesn't.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "He wipes the blade on his sleeve.", "para": 7, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "You walked far?", "name": "WALLY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "All night.", "name": "JONAS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "In that wind.", "name": "WALLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "It wasn't so bad.", "name": "JONAS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Wally's gaze drops to Jonas's boots.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "They are clean.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "No snow packed in the treads, no ice at the laces.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Wally says nothing.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "Jonas, what do you do?", "name": "EMMANUEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "I'm a surveyor.", "name": "JONAS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "For who?", "name": "EMMANUEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "dialogue", "text": "The county.", "name": "JONAS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "Emmanuel nods.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "Wally tilts his head and studies Jonas's face, the thin line of his smile.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "Emmanuel.", "name": "WALLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "dialogue", "text": "Hm?", "name": "EMMANUEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "dialogue", "text": "Come help me with the stove.", "name": "WALLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "dialogue", "text": "It's fine.", "name": "EMMANUEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "dialogue", "text": "Come help me.", "name": "WALLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "action", "text": "Emmanuel stands.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "action", "text": "They cross to the stove together.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "action", "text": "Wally leans close, mouth by Emmanuel's ear.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "dialogue", "text": "He's got no breath.", "name": "WALLY", "speaker": 0, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "dialogue", "text": "What?", "name": "EMMANUEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "dialogue", "text": "In this cold. Watch.", "name": "WALLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 76, "kind": "action", "text": "Emmanuel looks.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 77, "kind": "action", "text": "Jonas sits by the table, his face pale in the lamp.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 78, "kind": "action", "text": "No fog drifts from his lips.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 79, "kind": "action", "text": "Not one thread.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 80, "kind": "action", "text": "Jonas turns his head and smiles, wide.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 81, "kind": "action", "text": "The stove light catches his eyes, and for a moment they are the colour of lake water under ice.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 82, "kind": "dialogue", "text": "Don't stop on my account.", "name": "JONAS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 83, "kind": "action", "text": "Wally lifts the knife.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 84, "kind": "action", "text": "Emmanuel grabs the poker.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 85, "kind": "action", "text": "Jonas stands up slowly, unfolding to a height the shanty cannot hold.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 86, "kind": "action", "text": "His head brushes the ceiling.", "para": 13, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 87, "kind": "dialogue", "text": "I was only looking for company.", "name": "JONAS", "speaker": 4, "ext": ["CONT'D"], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 88, "kind": "action", "text": "The lines in the holes go taut at once, all together, and something far below begins to pull.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}]}