{"scene_id": "s00762", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00762.fountain", "heading": "INT. FORWARD BUNKER - BELGIAN FARMLAND - DAWN", "cast": [{"id": 0, "name": "CAPTAIN MARIANA ESCOBAR", "names": ["CAPTAIN MARIANA ESCOBAR", "MARIANA"], "gender": "?", "first": 5, "spoke": 5}, {"id": 1, "name": "SERGEANT FITZROY BELL", "names": ["SERGEANT FITZROY BELL", "FITZROY"], "gender": "m", "first": 6, "spoke": 2}, {"id": 2, "name": "CORPORAL YASIR KARIMI", "names": ["CORPORAL YASIR KARIMI"], "gender": "m", "first": 7, "spoke": 0}, {"id": 3, "name": "PRIVATE LENNART SKOG", "names": ["PRIVATE LENNART SKOG", "LENNART"], "gender": "?", "first": 8, "spoke": 1}, {"id": 4, "name": "MAJOR TREMAINE", "names": ["MAJOR TREMAINE"], "gender": "?", "first": 18, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. FORWARD BUNKER - BELGIAN FARMLAND - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Sandbags lined with straw.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A paraffin stove smokes in the corner.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A radio set squats on an ammunition crate beside a tin of biscuits.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Outside, a pale mist drifts over silent fields.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CAPTAIN MARIANA ESCOBAR, forties, sits on a crate cleaning a pistol with a rag.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "SERGEANT FITZROY BELL, fifties, scratches at his stubble.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "CORPORAL YASIR KARIMI, twenties, sleeps against a wall with his boots on.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "PRIVATE LENNART SKOG, nineteen, stares through the firing slit at the grey horizon.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Fitz, anything on the net?", "name": "MARIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Static, ma'am. Nothing but.", "name": "FITZROY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Quiet is good.", "name": "MARIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Quiet is strange, Captain.", "name": "LENNART", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Private, it's dawn. Let the war have its tea.", "name": "MARIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Fitzroy chuckles.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "He pries open the biscuit tin and passes it around.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Yasir wakes, accepts one, and crunches it.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "The stove ticks.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Bunker Seven, this is Command. Do you read?", "name": "MAJOR TREMAINE", "speaker": 4, "ext": ["V.O."], "paren": ["over radio, crackling"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Everyone freezes.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Mariana lunges for the handset.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Command, this is Seven. Reading you.", "name": "MARIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Captain, the armistice has been signed. Hostilities cease at eleven hundred.", "name": "MAJOR TREMAINE", "speaker": 4, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Yasir lowers the biscuit.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Lennart turns from the slit.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Eleven.", "name": "FITZROY", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Say again, Command.", "name": "MARIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "It's over, Captain. It's over.", "name": "MAJOR TREMAINE", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Mariana sets the handset down.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "She looks at the others, one by one.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Nobody speaks.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Then, at the slit, Lennart begins to laugh, and cannot stop.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}]}