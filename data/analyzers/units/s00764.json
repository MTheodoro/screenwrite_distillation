{"scene_id": "s00764", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00764.fountain", "heading": "INT. NATATORIUM - POOL DECK - 5:30 A.M.", "cast": [{"id": 0, "name": "COACH RENATA BOSCH", "names": ["COACH RENATA BOSCH", "RENATA"], "gender": "m", "first": 5, "spoke": 7}, {"id": 1, "name": "MARCUS TULLY", "names": ["MARCUS TULLY", "MARCUS"], "gender": "?", "first": 6, "spoke": 4}, {"id": 2, "name": "DOLORES AMADI", "names": ["DOLORES AMADI", "DOLORES"], "gender": "f", "first": 7, "spoke": 3}, {"id": 3, "name": "NEW KID", "names": ["NEW KID"], "gender": "m", "first": 8, "spoke": 2}, {"id": 4, "name": "SUNNY", "names": ["SUNNY"], "gender": "?", "first": 14, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. NATATORIUM - POOL DECK - 5:30 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "Chlorine fog.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Blue water, glass-flat.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A scoreboard reading 00:00.00.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "On the bench: three swimmers wrapped in towels.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "COACH RENATA BOSCH, forties, with a whistle and a stopwatch, paces the deck.", "para": 0, "sent": 4, "present": [0]}, {"u": 6, "kind": "action", "text": "MARCUS TULLY, twenties, anchor leg, stares at the water.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "DOLORES AMADI, twenties, lead-off, blows into her hands.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "A NEW KID, sixteen, in a team parka too big for him, sits at the very end of the bench with his goggles in his lap.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Warm-up in five. Four hundred easy, then pace sets.", "name": "RENATA", "speaker": 0, "ext": [], "paren": ["to the group"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "You hear about the sponsor?", "name": "MARCUS", "speaker": 1, "ext": [], "paren": ["to Dolores, low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Pulled out.", "name": "DOLORES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Don't ask. Don't ask.", "name": "NEW KID", "speaker": 3, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Kid. You are?", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Sunny.", "name": "NEW KID", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Sunny what?", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Sunny Park.", "name": "SUNNY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Sunny, you swim third leg.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Third? That's my relay split.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "That's what I said.", "name": "DOLORES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "I'm not asking.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Coach, he's sixteen.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Seventeen in March.", "name": "SUNNY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Marcus, he's fast.", "name": "DOLORES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "I didn't say he wasn't.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Everybody in!", "name": "RENATA", "speaker": 0, "ext": [], "paren": ["blowing the whistle"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "They all drop their towels and dive.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Sunny hesitates.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Renata stops beside him.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Sunny. It's only water.", "name": "RENATA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "That's what scares me.", "name": "SUNNY", "speaker": 4, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}]}