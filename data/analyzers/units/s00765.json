{"scene_id": "s00765", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00765.fountain", "heading": "INT. BOXING RING - CORNER - NIGHT", "cast": [{"id": 0, "name": "PRISS", "names": ["PRISS"], "gender": "f", "first": 4, "spoke": 6}, {"id": 1, "name": "VANTONGEREN", "names": ["VANTONGEREN"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "MEL BRANDVOLD", "names": ["MEL BRANDVOLD", "MEL"], "gender": "m", "first": 6, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. BOXING RING - CORNER - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A hot arena.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A roaring crowd that is only noise.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Bright ropes, spit buckets, a canvas stained the colour of old tea.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "PRISCILLA \"PRISS\" VANTONGEREN, twenties, in red trunks, sits on the stool between rounds, chest heaving, a swollen eye closing.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "She wears a wireless earpiece.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Her coach, old MEL BRANDVOLD, sixty-eight, stands at ringside two states away on a hospital bed phone, his voice crackling through the bud.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Priss. Priss, look at me. Can you see?", "name": "MEL", "speaker": 2, "ext": ["V.O."], "paren": ["over earpiece"], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "I can see.", "name": "PRISS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "How many fingers?", "name": "MEL", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I can't see you, Mel. You're in Tulsa.", "name": "PRISS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Humour me.", "name": "MEL", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Three.", "name": "PRISS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Good girl. Listen. Round seven. She drops her left every time she throws the hook.", "name": "MEL", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I know.", "name": "PRISS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Step in and counter.", "name": "MEL", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "What if I'm too tired?", "name": "PRISS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Priss, I've seen you tired. I've never seen you quit.", "name": "MEL", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "The bell rings.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "She rises, mouthguard in, gloves up.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Across the ring her opponent circles, taller, quicker.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Priss bobs, weaves, takes a jab on the shoulder, slips a second, and steps in.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "The hook sails past her ear.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Now.", "name": "PRISS", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "She throws the right.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "It lands.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The opponent staggers, drops her guard, and Priss follows with the left, a short chopping blow that snaps the head back and sends the crowd to its feet.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "That's it! That's my girl!", "name": "MEL", "speaker": 2, "ext": ["V.O."], "paren": ["over earpiece, shouting"], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "The referee steps between.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Priss stands over her opponent, trembling.", "para": 4, "sent": 1, "present": [0, 1, 2]}]}