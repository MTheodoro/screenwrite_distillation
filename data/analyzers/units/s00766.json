{"scene_id": "s00766", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00766.fountain", "heading": "INT. NIGHT FERRY - CAR DECK - NIGHT", "cast": [{"id": 0, "name": "DETECTIVE ISAAC MORROW", "names": ["DETECTIVE ISAAC MORROW", "ISAAC"], "gender": "m", "first": 6, "spoke": 12}, {"id": 1, "name": "LIONEL FARR", "names": ["LIONEL FARR", "LIONEL"], "gender": "m", "first": 7, "spoke": 13}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT FERRY - CAR DECK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cavernous steel hold.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dozens of parked cars bolted to the deck.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The engine thrums through the floor.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Chains rattle.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A single bulb sways overhead.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "DETECTIVE ISAAC MORROW, forties, trench coat, hand on his holster, walks slowly between the cars.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "At the end of the row, LIONEL FARR, thirties, in a leather jacket, leans on the bonnet of a black sedan, arms crossed.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He looks at Isaac.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He does not move.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Lionel.", "name": "ISAAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Isaac.", "name": "LIONEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "You're a long way from home.", "name": "ISAAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "So are you.", "name": "LIONEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Isaac stops ten feet away.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Lionel uncrosses his arms, hands open, empty.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Where's the ledger?", "name": "ISAAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Where's your warrant?", "name": "LIONEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "I don't need one on a boat.", "name": "ISAAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "You do if I'm in international waters.", "name": "LIONEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "We're nine miles out.", "name": "ISAAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Twelve is the limit.", "name": "LIONEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Isaac says nothing.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "The hull groans.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "A wave slaps the steel.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "The bulb swings over their faces, light, shadow, light.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "You came alone.", "name": "LIONEL", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "So did you.", "name": "ISAAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Not exactly.", "name": "LIONEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Behind Isaac, a car door clunks.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "He spins, gun half drawn.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Nobody.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Lionel laughs.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Relax. It's the sea.", "name": "LIONEL", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Isaac turns back.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "His hand shakes slightly.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "He steadies it.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Hand over the ledger and I let you walk off in Calais.", "name": "ISAAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "And if I don't?", "name": "LIONEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Then I walk off. And you don't.", "name": "ISAAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Lionel studies him.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "A long moment.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "He reaches slowly into his jacket.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Isaac draws.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "Lionel freezes, hand inside his coat.", "para": 6, "sent": 4, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Slow.", "name": "ISAAC", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "I'm slow.", "name": "LIONEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "He draws out a small black book.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Holds it up between two fingers.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Here.", "name": "LIONEL", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Toss it.", "name": "ISAAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "Lionel tosses it.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "It lands at Isaac's feet.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "Isaac kneels, picks it up, flips through.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "His shoulders drop an inch.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "It's blank.", "name": "ISAAC", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "Of course it's blank.", "name": "LIONEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "Isaac looks up, furious.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "Lionel is already laughing, the sound ricocheting off the steel.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "Isaac lowers the gun, then, slowly, he begins to laugh too.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "Two men in a steel hold, laughing at a blank book.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "You're a bastard, Lionel.", "name": "ISAAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "And you're still a detective.", "name": "LIONEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "He pushes off the sedan and walks past Isaac toward the stairs.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "Isaac lets him go.", "para": 10, "sent": 1, "present": [0, 1]}]}