{"scene_id": "s00767", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00767.fountain", "heading": "INT. SUBMARINE USS HALCYON - CONTROL ROOM - NIGHT", "cast": [{"id": 0, "name": "CAPTAIN DOMINIC ARCHER-LYLE", "names": ["CAPTAIN DOMINIC ARCHER-LYLE", "ARCHER-LYLE"], "gender": "m", "first": 5, "spoke": 21}, {"id": 1, "name": "NOLAN", "names": ["NOLAN"], "gender": "?", "first": 6, "spoke": 15}, {"id": 2, "name": "AUGUSTO", "names": ["AUGUSTO"], "gender": "?", "first": 13, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. SUBMARINE USS HALCYON - CONTROL ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Red battle lamps.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Pipes sweating.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dials and valves everywhere.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The hull creaks like an old ship's timbers.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CAPTAIN DOMINIC ARCHER-LYLE, fifties, hands clasped behind his back, stands before the periscope well.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "LIEUTENANT PATRICIA \"PAT\" NOLAN, thirties, executive officer, checks a depth gauge.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "From a speaker in the bulkhead, the voice of the sonar operator, unseen.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Gentlemen, we hold at two hundred feet. Silent running.", "name": "ARCHER-LYLE", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Aye, sir.", "name": "NOLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Mr. Nolan, report.", "name": "ARCHER-LYLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "All systems nominal, Captain. Battery at seventy percent.", "name": "NOLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Seventy. Enough for a day.", "name": "ARCHER-LYLE", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Control, sonar. Surface contact, bearing one-two-zero. Single screw. Slow.", "name": "AUGUSTO", "speaker": 2, "ext": ["V.O."], "paren": ["over intercom"], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Merchant?", "name": "ARCHER-LYLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Can't say, sir. No transponder.", "name": "AUGUSTO", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Pat, plot it.", "name": "ARCHER-LYLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Plotting.", "name": "NOLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "She bends over a chart table.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "A ruler, a pencil, a quiet scratch.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "The sub rocks gently.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Quiet night.", "name": "ARCHER-LYLE", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Too quiet, sir?", "name": "NOLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Never say that on my boat.", "name": "ARCHER-LYLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "She smiles.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "A drip falls from a pipe onto the chart.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "She wipes it.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Control, contact is stationary. Engines idle.", "name": "AUGUSTO", "speaker": 2, "ext": ["V.O."], "paren": ["over intercom"], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Odd.", "name": "ARCHER-LYLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Waiting for us?", "name": "NOLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Or for someone else.", "name": "ARCHER-LYLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The lamps pulse.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Nolan straightens.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Captain, request permission to raise the scope.", "name": "NOLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Granted. Slowly.", "name": "ARCHER-LYLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "She turns the wheel.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "The periscope hums up.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "She folds the handles and puts her eye to it.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Her face tightens.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Well?", "name": "ARCHER-LYLE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "It's a hospital ship, sir.", "name": "NOLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "A hospital ship.", "name": "ARCHER-LYLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "White hull. Red crosses. All lit up.", "name": "NOLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Of course.", "name": "ARCHER-LYLE", "speaker": 0, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Control, sonar. New contact. Fast. Bearing zero-nine-five. Closing.", "name": "AUGUSTO", "speaker": 2, "ext": ["V.O."], "paren": ["over intercom"], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Captain!", "name": "NOLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Range?", "name": "ARCHER-LYLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Two thousand yards.", "name": "AUGUSTO", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Is it hostile?", "name": "ARCHER-LYLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "It's ours, sir. Destroyer.", "name": "AUGUSTO", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Then why is it running dark?", "name": "NOLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Because it's escorting.", "name": "ARCHER-LYLE", "speaker": 0, "ext": [], "paren": ["very quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Escorting what?", "name": "NOLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "The hospital ship, Pat. Which means--", "name": "ARCHER-LYLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "Torpedo in the water! Bearing one-eight-zero! Not ours!", "name": "AUGUSTO", "speaker": 2, "ext": ["V.O."], "paren": ["over intercom, sharp"], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "Dive! Dive! Rig for impact!", "name": "ARCHER-LYLE", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Klaxons.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Red lamps flash.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "The deck tilts.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "Nolan grabs a rail.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Captain, they're targeting the ship!", "name": "NOLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "Then we are the only thing in the way.", "name": "ARCHER-LYLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "Sir?", "name": "NOLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "Come to heading one-eight-zero. Full ahead.", "name": "ARCHER-LYLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "Sir, that's suicide!", "name": "NOLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "That is the job.", "name": "ARCHER-LYLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "She stares at him.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "He stares back.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "She breathes in once.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 70, "kind": "dialogue", "text": "Aye aye, sir.", "name": "NOLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 71, "kind": "action", "text": "She spins the wheel.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 72, "kind": "action", "text": "The engines roar.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 73, "kind": "action", "text": "The sub heels hard.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 74, "kind": "action", "text": "In the periscope's last frame, a white hull glides unknowing through the dark, and between it and the death streaking toward it, a long grey shape cuts across.", "para": 8, "sent": 3, "present": [0, 1, 2]}]}