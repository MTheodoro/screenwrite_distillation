{"scene_id": "s00768", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00768.fountain", "heading": "INT. FLOODED SUBWAY TUNNEL - NIGHT", "cast": [{"id": 0, "name": "ROSARIO VEGA", "names": ["ROSARIO VEGA", "ROSARIO"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "TIMOTHY BANKS", "names": ["TIMOTHY BANKS", "TIMOTHY"], "gender": "?", "first": 4, "spoke": 6}, {"id": 2, "name": "BEATRIX ORLOV", "names": ["BEATRIX ORLOV", "BEATRIX"], "gender": "?", "first": 4, "spoke": 10}, {"id": 3, "name": "DISPATCH", "names": ["DISPATCH"], "gender": "?", "first": 15, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. FLOODED SUBWAY TUNNEL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Black water to the knees.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Emergency lights flicker amber on slimed tiles.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A stalled train lies like a dead worm along the track.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Three survivors wade toward an iron ladder: ROSARIO VEGA, thirties, nurse, carrying a child's backpack; TIMOTHY BANKS, forties, accountant, limping; BEATRIX ORLOV, seventies, retired conductor, steady as a rock.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "The ladder is at the next platform.", "name": "BEATRIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "How far?", "name": "TIMOTHY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Two hundred yards.", "name": "BEATRIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "He's bleeding.", "name": "ROSARIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "We all are.", "name": "BEATRIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Timothy grimaces.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "His hand is wrapped in a torn shirt.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Rosario takes his arm and slings it over her shoulder.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "They move.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "A radio crackles from Beatrix's belt.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Unit nine, unit nine. Do you copy?", "name": "DISPATCH", "speaker": 3, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Beatrix grabs it.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Dispatch. We're alive. Three of us. Tunnel six.", "name": "BEATRIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Copy. Rescue is en route. Stay put. Ten minutes.", "name": "DISPATCH", "speaker": 3, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Ten minutes?", "name": "TIMOTHY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "We can wait ten.", "name": "ROSARIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "The water's rising.", "name": "TIMOTHY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "It's been rising an hour.", "name": "ROSARIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "She's right. It's slowed.", "name": "BEATRIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "They stop on a ledge above the tracks and sit in a line.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "For a moment there is peace.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Rosario fishes a granola bar from the backpack, breaks it in three, hands out the pieces.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "They chew in silence.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "This is nice.", "name": "TIMOTHY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Don't.", "name": "BEATRIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "What?", "name": "TIMOTHY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "You'll jinx it.", "name": "BEATRIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Rosario smiles.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Timothy smiles.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Beatrix doesn't.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Unit nine, new report. Upstream dam is failing. Move to high ground immediately.", "name": "DISPATCH", "speaker": 3, "ext": ["V.O."], "paren": ["over radio, urgent"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "There is no high ground.", "name": "ROSARIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "There is a ladder.", "name": "BEATRIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "I can't climb.", "name": "TIMOTHY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Yes you can.", "name": "ROSARIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Yes you can.", "name": "BEATRIX", "speaker": 2, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "A distant roar rolls down the tunnel, wind pushing ahead of water.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "The amber lights shiver.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Rosario hauls Timothy upright.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Beatrix is already wading.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Run!", "name": "BEATRIX", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}