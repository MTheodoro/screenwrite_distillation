{"scene_id": "s00769", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00769.fountain", "heading": "EXT. SLED-DOG CHECKPOINT - ALASKAN WILDERNESS - DAWN", "cast": [{"id": 0, "name": "MUSHER HALVARD OKONKWO-REID", "names": ["MUSHER HALVARD OKONKWO-REID", "HALVARD"], "gender": "m", "first": 5, "spoke": 12}, {"id": 1, "name": "VET IMELDA TORRES-BAIRD", "names": ["VET IMELDA TORRES-BAIRD", "IMELDA"], "gender": "f", "first": 6, "spoke": 5}, {"id": 2, "name": "GRAHAM FELLOWES", "names": ["GRAHAM FELLOWES", "GRAHAM"], "gender": "?", "first": 7, "spoke": 9}, {"id": 3, "name": "RACE CONTROL", "names": ["RACE CONTROL"], "gender": "?", "first": 4, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SLED-DOG CHECKPOINT - ALASKAN WILDERNESS - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A log cabin half-buried in drift.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sled dogs asleep in curled rows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Smoke rises from a chimney.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Race flags snap in a thin wind.", "para": 0, "sent": 3, "present": [3]}, {"u": 5, "kind": "action", "text": "MUSHER HALVARD OKONKWO-REID, thirties, sits on his sled, dog booties in his lap.", "para": 1, "sent": 0, "present": [0, 3]}, {"u": 6, "kind": "action", "text": "Beside him, VET IMELDA TORRES-BAIRD, fifties, listens to a husky's chest with a stethoscope.", "para": 1, "sent": 1, "present": [0, 1, 3]}, {"u": 7, "kind": "action", "text": "Official GRAHAM FELLOWES, sixties, stands at the checkpoint with a clipboard.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "You're twelve minutes ahead.", "name": "GRAHAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "That's good.", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "That's very good.", "name": "GRAHAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "He's sound. Lungs are clear.", "name": "IMELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Thank you.", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "She's your lead dog?", "name": "IMELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Aurora. Eight years.", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "She's tired.", "name": "IMELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "She's always tired. She never shows it.", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "A radio on Graham's belt hisses.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Checkpoint Four, Race Control. Be advised: Musher Delacroix is withdrawn. Repeat, withdrawn.", "name": "RACE CONTROL", "speaker": 3, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Copy.", "name": "GRAHAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Delacroix? He was my main rival.", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Was.", "name": "GRAHAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "What happened?", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "His team went through the ice.", "name": "GRAHAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Halvard lowers the booties.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Imelda lifts her stethoscope from Aurora's chest.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Oh, no.", "name": "IMELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Is he--", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Alive. Frostbite. Two dogs lost.", "name": "GRAHAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "I'm sorry.", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "You can go.", "name": "GRAHAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "I think I should stop.", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Now?", "name": "GRAHAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Now?", "name": "IMELDA", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "If the ice is bad ahead--", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "It's not bad. He cut a corner. He was in a hurry.", "name": "GRAHAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Halvard stares at Aurora.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Aurora stares at him.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "She yawns.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Slowly he laces the booties.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Then I won't be in a hurry.", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "He rises and calls the team.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "One by one the huskies stand and shake out their coats.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "The sled creaks.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Halvard steps onto the runners.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Hike.", "name": "HALVARD", "speaker": 0, "ext": ["CONT'D"], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3]}]}