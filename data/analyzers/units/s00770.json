{"scene_id": "s00770", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00770.fountain", "heading": "INT. FUNHOUSE MIRROR MAZE - NIGHT", "cast": [{"id": 0, "name": "BIRDIE OKAFOR", "names": ["BIRDIE OKAFOR", "BIRDIE"], "gender": "?", "first": 4, "spoke": 7}, {"id": 1, "name": "DEZ PRYCE", "names": ["DEZ PRYCE", "DEZ"], "gender": "?", "first": 6, "spoke": 6}, {"id": 2, "name": "FERENC VASS", "names": ["FERENC VASS", "FERENC"], "gender": "?", "first": 27, "spoke": 4}, {"id": 3, "name": "INSPECTOR TAMSIN WHITLOCK", "names": ["INSPECTOR TAMSIN WHITLOCK", "TAMSIN"], "gender": "?", "first": 39, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. FUNHOUSE MIRROR MAZE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cracked glass.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dead carnival.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Flashlight beams ricochet everywhere.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "BIRDIE OKAFOR, 30s, tool belt, glitter on one cheek, scrapes at a mirror frame.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Up a ladder.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "DEZ PRYCE, 20s, sweaty intern in a clown wig, \"holds\" the ladder.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Dez. Ladder.", "name": "BIRDIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Holding it, Birdie.", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "The ladder wobbles.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Dez grips harder.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Wobbles more.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "You hold it like a baby bird.", "name": "BIRDIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "You're named Birdie. That's on you.", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Squeegee. Now.", "name": "BIRDIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Dez hands up a rubber chicken.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Chicken. Not squeegee.", "name": "BIRDIE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "They were next to each other!", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Reflections.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Six Dezes.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Six Birdies.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Total chaos.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Which one's you?", "name": "BIRDIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Hi.", "name": "DEZ", "speaker": 1, "ext": [], "paren": ["to all six"], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Footsteps.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Squeaky soles.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "A pie, held like a weapon.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "FERENC VASS, 70s, tuxedo jacket over pajamas, owner of everything rotting here, shuffles in.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Who is breaking my maze?", "name": "FERENC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Fixing, Mr. Vass. Fixing your maze.", "name": "BIRDIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Dez, is that my wig?", "name": "FERENC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Borrowed, Mr. Vass.", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Birdie, I pay for repairs. Not for humming.", "name": "FERENC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "I wasn't humming.", "name": "BIRDIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "She was. Loudly.", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Ferenc offers the pie.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Nobody takes it.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Everybody looks at it.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "A flashlight beam, bright and official, slices through the mirrors.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "INSPECTOR TAMSIN WHITLOCK, 40s, clipboard, zero humor, steps in.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Fire marshal. Who's in charge?", "name": "TAMSIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "All three point at each other.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Six Dezes point.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Six Birdies point.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Pie?", "name": "FERENC", "speaker": 2, "ext": [], "paren": ["re: the pie"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Obviously.", "name": "TAMSIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}