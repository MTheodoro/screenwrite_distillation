{"scene_id": "s00771", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00771.fountain", "heading": "INT. NIGHT FERRY - VENDING ALCOVE - NIGHT", "cast": [{"id": 0, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 4, "spoke": 1}, {"id": 1, "name": "ROSALIND ACHTERBERG", "names": ["ROSALIND ACHTERBERG", "ROSALIND"], "gender": "?", "first": 6, "spoke": 5}, {"id": 2, "name": "ELIAS", "names": ["ELIAS"], "gender": "?", "first": 13, "spoke": 2}, {"id": 3, "name": "TEO", "names": ["TEO"], "gender": "m", "first": 18, "spoke": 1}, {"id": 4, "name": "DECKHAND", "names": ["DECKHAND"], "gender": "?", "first": 23, "spoke": 0}, {"id": 5, "name": "PRIYA", "names": ["PRIYA"], "gender": "?", "first": 23, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT FERRY - VENDING ALCOVE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Humming machines.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sticky floor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dark windows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A STRANGER, 50s, wet coat, sits on the bench.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He stares at his hands.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "ROSALIND ACHTERBERG, 60s, steps in with a paper cup.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "She stops.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Her grip tightens on the cup.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "You're on my bench.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I don't know you.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She studies him.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Something in his jaw.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Elias.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "He looks up.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Long beat.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Rosalind. You got old.", "name": "ELIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Twenty years will do that.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "TEO, 9, in a hoodie too big for him, peeks from behind the snack machine.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "He clutches a bag of chips.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Grandma, who's that?", "name": "TEO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Nobody, Teo. Go find your mother.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Teo. Good name.", "name": "ELIAS", "speaker": 2, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "A DECKHAND, PRIYA, 20s, orange vest, leans in.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Ma'am, we dock in ten. Everyone okay?", "name": "PRIYA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Rosalind sits.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Not beside him.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Near.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "We're fine, Priya.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "He nods once.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "She sips.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "The ferry rocks.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}