{"scene_id": "s00772", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00772.fountain", "heading": "INT. FISH MARKET - WALK-IN FREEZER - NIGHT", "cast": [{"id": 0, "name": "MAURA KESSLER-DIAZ", "names": ["MAURA KESSLER-DIAZ", "MAURA"], "gender": "?", "first": 4, "spoke": 15}, {"id": 1, "name": "TIB", "names": ["TIB"], "gender": "f", "first": 11, "spoke": 17}, {"id": 2, "name": "NAGY", "names": ["NAGY"], "gender": "?", "first": 11, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. FISH MARKET - WALK-IN FREEZER - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Frost on everything.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Hanging tuna like pale bells.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Breath clouds.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MAURA KESSLER-DIAZ, 40s, black parka, lockpick case, crouches at a floor safe.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "The heavy door SCRATCHES open.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Light slices in.", "para": 2, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She kills her penlight.", "para": 3, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Flattens against the shelving.", "para": 3, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "Boots.", "para": 4, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "Slow.", "para": 4, "sent": 1, "present": [0]}, {"u": 11, "kind": "action", "text": "TIBOR \"TIB\" NAGY, 50s, market night manager, rubber apron, a gaff hook in one fist, walks in.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "He stops.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Smells the air.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I know somebody's in here.", "name": "TIB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Drip.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Fans.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Cameras went dark an hour ago. That's not luck.", "name": "TIB", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Hello, Tib.", "name": "MAURA", "speaker": 0, "ext": [], "paren": ["stepping out"], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "He doesn't flinch.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Raises the hook.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Maura. You left your hair dye in my sink last time.", "name": "TIB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Brown. Not my color.", "name": "MAURA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "You're stealing from the wrong man.", "name": "TIB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Everybody says that.", "name": "MAURA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "They circle.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Tuna swing between them.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Put the picks down.", "name": "TIB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Put the hook down.", "name": "MAURA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Neither does.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Your brother used to say you talk too much.", "name": "TIB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "My brother used to say a lot of things. Then he said nothing.", "name": "MAURA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Tib's jaw tightens.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "That wasn't me.", "name": "TIB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "It was your safe.", "name": "MAURA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "He lunges.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "She drops the case.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "They collide.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "The shelving rattles.", "para": 12, "sent": 3, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Fish rain.", "para": 12, "sent": 4, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "They grapple, hook against forearm, her knee into his ribs.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Stop it!", "name": "TIB", "speaker": 1, "ext": ["CONT'D"], "paren": ["grunting"], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "You stop it!", "name": "MAURA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Tib slams her into a shelf.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Ice cracks loose.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "They both slide to the floor.", "para": 14, "sent": 2, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Both freeze.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "A distant sound: a truck engine.", "para": 15, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "That's my deliveries.", "name": "TIB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "You have deliveries at two a.m.?", "name": "MAURA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Fish don't keep hours.", "name": "TIB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "The engine idles.", "para": 16, "sent": 0, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Voices outside, muffled.", "para": 16, "sent": 1, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "They look at each other.", "para": 17, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "At the safe.", "para": 17, "sent": 1, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "At the door.", "para": 17, "sent": 2, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "Who's out there, Tib?", "name": "MAURA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "Not mine.", "name": "TIB", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "Then whose?", "name": "MAURA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "Tib lowers the hook.", "para": 18, "sent": 0, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "A fraction.", "para": 18, "sent": 1, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "The man who owns the safe.", "name": "TIB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "You said it was yours.", "name": "MAURA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "I lied. Everybody does.", "name": "TIB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "The door handle turns.", "para": 19, "sent": 0, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "They both dive behind the tuna rack.", "para": 19, "sent": 1, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "They crouch shoulder to shoulder.", "para": 20, "sent": 0, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "Her breath on his collar.", "para": 20, "sent": 1, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "His hand over her mouth.", "para": 20, "sent": 2, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "She bites it.", "para": 21, "sent": 0, "present": [0, 1, 2]}, {"u": 71, "kind": "dialogue", "text": "Ow!", "name": "TIB", "speaker": 1, "ext": ["CONT'D"], "paren": ["whisper-yelling"], "dual": false, "present": [0, 1, 2]}, {"u": 72, "kind": "dialogue", "text": "Quiet!", "name": "MAURA", "speaker": 0, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2]}, {"u": 73, "kind": "action", "text": "A shadow crosses the frosted glass.", "para": 22, "sent": 0, "present": [0, 1, 2]}, {"u": 74, "kind": "action", "text": "Stops.", "para": 22, "sent": 1, "present": [0, 1, 2]}, {"u": 75, "kind": "action", "text": "They go still.", "para": 23, "sent": 0, "present": [0, 1, 2]}, {"u": 76, "kind": "action", "text": "Fans hum.", "para": 23, "sent": 1, "present": [0, 1, 2]}, {"u": 77, "kind": "action", "text": "A fish drips onto Maura's hood.", "para": 23, "sent": 2, "present": [0, 1, 2]}, {"u": 78, "kind": "dialogue", "text": "When he opens the door, you take the left.", "name": "TIB", "speaker": 1, "ext": ["CONT'D"], "paren": ["barely audible"], "dual": false, "present": [0, 1, 2]}, {"u": 79, "kind": "dialogue", "text": "Why would I take anything from you?", "name": "MAURA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 80, "kind": "dialogue", "text": "Because he kills us both if you don't.", "name": "TIB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 81, "kind": "action", "text": "The shadow leans in.", "para": 24, "sent": 0, "present": [0, 1, 2]}, {"u": 82, "kind": "action", "text": "A knuckle taps the glass.", "para": 24, "sent": 1, "present": [0, 1, 2]}, {"u": 83, "kind": "action", "text": "Twice.", "para": 24, "sent": 2, "present": [0, 1, 2]}, {"u": 84, "kind": "action", "text": "Tib and Maura exchange a look.", "para": 25, "sent": 0, "present": [0, 1, 2]}, {"u": 85, "kind": "action", "text": "Then, together, they stand.", "para": 25, "sent": 1, "present": [0, 1, 2]}, {"u": 86, "kind": "dialogue", "text": "On three.", "name": "MAURA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 87, "kind": "dialogue", "text": "One.", "name": "TIB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 88, "kind": "dialogue", "text": "Two.", "name": "MAURA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 89, "kind": "action", "text": "The door swings wide.", "para": 26, "sent": 0, "present": [0, 1, 2]}, {"u": 90, "kind": "action", "text": "They launch.", "para": 27, "sent": 0, "present": [0, 1, 2]}]}