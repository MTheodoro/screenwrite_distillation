{"scene_id": "s00773", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00773.fountain", "heading": "INT. SKI GONDOLA CABIN - DUSK", "cast": [{"id": 0, "name": "KAVEH ZANDI", "names": ["KAVEH ZANDI", "KAVEH"], "gender": "?", "first": 4, "spoke": 12}, {"id": 1, "name": "LINNEA STRAND", "names": ["LINNEA STRAND", "LINNEA"], "gender": "f", "first": 5, "spoke": 15}, {"id": 2, "name": "OSWIN PELL", "names": ["OSWIN PELL", "OSWIN"], "gender": "m", "first": 6, "spoke": 16}, {"id": 3, "name": "JUNO MARCHETTI", "names": ["JUNO MARCHETTI", "JUNO"], "gender": "f", "first": 7, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. SKI GONDOLA CABIN - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "Stopped dead mid-cable.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wind knocks the glass.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Four seats, four strangers, one dying lamp.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "KAVEH ZANDI, 30s, parka, nervous hands, sits facing the door.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "LINNEA STRAND, 40s, ski patrol jacket, radio at her hip, stands braced against the wall.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "OSWIN PELL, 60s, tweed under his shell, a briefcase chained to his wrist.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "JUNO MARCHETTI, 20s, snowboard across her knees, earbuds around her neck.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "The cabin lurches.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Everyone grabs something.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "That's not supposed to happen.", "name": "JUNO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "It's wind. Stay seated.", "name": "LINNEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Kaveh stares at the briefcase.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "What's in the case?", "name": "KAVEH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Paperwork.", "name": "OSWIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Chained paperwork.", "name": "KAVEH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Very important paperwork.", "name": "OSWIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Linnea thumbs her radio.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Static.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Nothing.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Base, this is Strand. Base?", "name": "LINNEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Static.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Phones?", "name": "JUNO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Kaveh, Juno, Oswin check phones.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Three heads shake.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "No bars. At all.", "name": "JUNO", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Someone cut the tower.", "name": "KAVEH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Don't be dramatic.", "name": "LINNEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Nobody jams a tower by accident, Linnea.", "name": "KAVEH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "You don't know my name.", "name": "LINNEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "It's on your jacket.", "name": "KAVEH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Beat.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Linnea glances down.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Her own name patch.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "She exhales.", "para": 10, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "The cabin sways.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Oswin grips the chain.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "I was told this would be a quiet trip.", "name": "OSWIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Told by who?", "name": "JUNO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Oswin says nothing.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Open it.", "name": "KAVEH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Absolutely not.", "name": "OSWIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Open it or I do.", "name": "KAVEH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Kaveh stands.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "The cabin tilts.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Linnea steps between them.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Sit. Down.", "name": "LINNEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Kaveh lunges for the case.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Oswin swings it.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "It cracks Kaveh's chin.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Kaveh crashes into Linnea.", "para": 14, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Juno yanks her board up as a shield.", "para": 14, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "They all collide into the glass.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "It groans.", "para": 15, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Everybody freezes.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Nobody move.", "name": "JUNO", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "A long crack spiderwebs across the window.", "para": 17, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Nobody breathes.", "para": 17, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "I have a key.", "name": "OSWIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "Then use it.", "name": "LINNEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "It's in my coat. Left pocket.", "name": "OSWIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "Don't touch his pocket.", "name": "KAVEH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "Shut up, Kaveh.", "name": "LINNEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "Juno slides a hand into Oswin's left pocket.", "para": 18, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "Pulls out a small brass key.", "para": 18, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "This it?", "name": "JUNO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "Yes. Please. Careful.", "name": "OSWIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "Juno unlocks the chain.", "para": 19, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "The briefcase pops.", "para": 19, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "Papers spill.", "para": 19, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "dialogue", "text": "Those are maps.", "name": "LINNEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "dialogue", "text": "Of the mountain.", "name": "KAVEH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "Of the cable. Of the towers. With dates.", "name": "JUNO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "action", "text": "Linnea picks one up.", "para": 20, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "Reads.", "para": 20, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "Her face goes still.", "para": 20, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "dialogue", "text": "This is my father's handwriting.", "name": "LINNEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "dialogue", "text": "I'm sorry.", "name": "OSWIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "dialogue", "text": "Explain.", "name": "LINNEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "dialogue", "text": "Your father sold the design flaw to my company twenty years ago. I came to see if it had held.", "name": "OSWIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "dialogue", "text": "It hasn't held.", "name": "KAVEH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "dialogue", "text": "No.", "name": "OSWIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "dialogue", "text": "So this is a test.", "name": "LINNEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "dialogue", "text": "A confirmation.", "name": "OSWIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 84, "kind": "dialogue", "text": "You rode a broken gondola to confirm it's broken?", "name": "JUNO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 85, "kind": "dialogue", "text": "I needed to see the cable fray with my own eyes before I testify.", "name": "OSWIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 86, "kind": "dialogue", "text": "Testify to what?", "name": "KAVEH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 87, "kind": "dialogue", "text": "That the company knew. That your fathers knew. That every one of us in this cabin is here because of a decision made at a conference table.", "name": "OSWIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 88, "kind": "dialogue", "text": "My father is dead.", "name": "LINNEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 89, "kind": "dialogue", "text": "I know. That's why I came.", "name": "OSWIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 90, "kind": "action", "text": "The cabin shudders.", "para": 21, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 91, "kind": "action", "text": "A deep grind.", "para": 21, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 92, "kind": "action", "text": "Everyone looks up.", "para": 21, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 93, "kind": "dialogue", "text": "That's the cable.", "name": "JUNO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 94, "kind": "dialogue", "text": "Yes.", "name": "OSWIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 95, "kind": "dialogue", "text": "How long?", "name": "LINNEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 96, "kind": "dialogue", "text": "Minutes.", "name": "OSWIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 97, "kind": "action", "text": "Kaveh bolts for the door.", "para": 22, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 98, "kind": "action", "text": "Linnea grabs his collar.", "para": 22, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 99, "kind": "action", "text": "He swings.", "para": 22, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 100, "kind": "action", "text": "She ducks.", "para": 22, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 101, "kind": "action", "text": "Juno wedges her board between them.", "para": 22, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 102, "kind": "action", "text": "They scuffle in the narrow aisle.", "para": 23, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 103, "kind": "action", "text": "The cabin tips hard to the left.", "para": 23, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 104, "kind": "action", "text": "All four slide to one side.", "para": 23, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 105, "kind": "action", "text": "The lamp dies.", "para": 24, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 106, "kind": "action", "text": "Darkness.", "para": 25, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 107, "kind": "action", "text": "Wind.", "para": 25, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 108, "kind": "action", "text": "A single metallic SNAP.", "para": 25, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 109, "kind": "action", "text": "Then silence.", "para": 26, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 110, "kind": "action", "text": "Then, far below, a motor kicks on.", "para": 27, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 111, "kind": "action", "text": "The cabin jerks.", "para": 27, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 112, "kind": "action", "text": "Moves.", "para": 27, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 113, "kind": "action", "text": "Upward.", "para": 27, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 114, "kind": "action", "text": "Light floods in from the station.", "para": 28, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 115, "kind": "action", "text": "They sit in a heap, panting.", "para": 29, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 116, "kind": "dialogue", "text": "We're moving.", "name": "JUNO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 117, "kind": "dialogue", "text": "Who turned it on?", "name": "KAVEH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 118, "kind": "dialogue", "text": "Backup generator. Somebody finally got to it.", "name": "LINNEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 119, "kind": "action", "text": "She looks at Oswin.", "para": 30, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 120, "kind": "action", "text": "At the maps.", "para": 30, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 121, "kind": "action", "text": "At the three faces.", "para": 30, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 122, "kind": "dialogue", "text": "Base, Strand. Four aboard. We're fine. Everybody's fine.", "name": "LINNEA", "speaker": 1, "ext": ["CONT'D"], "paren": ["into radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 123, "kind": "action", "text": "She tucks a map inside her jacket.", "para": 31, "sent": 0, "present": [0, 1, 2, 3]}]}