{"scene_id": "s00775", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00775.fountain", "heading": "INT. PIGEON RACING CLUB - BACK ROOM - NIGHT", "cast": [{"id": 0, "name": "GLORIA HUANG", "names": ["GLORIA HUANG", "GLORIA"], "gender": "?", "first": 5, "spoke": 6}, {"id": 1, "name": "HAROLD OYELARAN", "names": ["HAROLD OYELARAN", "HAROLD"], "gender": "?", "first": 8, "spoke": 4}, {"id": 2, "name": "MARISOL TREVI", "names": ["MARISOL TREVI", "MARISOL"], "gender": "f", "first": 11, "spoke": 3}, {"id": 3, "name": "DEACON PRATT", "names": ["DEACON PRATT", "DEACON"], "gender": "m", "first": 15, "spoke": 2}, {"id": 4, "name": "CORNELIA ASHBY-REID", "names": ["CORNELIA ASHBY-REID", "CORNELIA"], "gender": "?", "first": 17, "spoke": 2}, {"id": 5, "name": "TEDDY NKEMELU", "names": ["TEDDY NKEMELU", "TEDDY"], "gender": "?", "first": 30, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. PIGEON RACING CLUB - BACK ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Folding chairs.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A coffee urn.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Trophies with tiny gilded birds.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A banner reads \"ANNUAL MEMBERSHIP MEETING.\"", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "GLORIA HUANG chairs the meeting from a card table.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She taps a gavel.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "dialogue", "text": "Item four. The clubhouse roof.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 8, "kind": "action", "text": "HAROLD OYELARAN, seventies, raises a hand.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He wears a bow tie and a tired expression.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I move we ignore it.", "name": "HAROLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "MARISOL TREVI\u00d1O, a retired postal worker, shakes her head.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "She holds a casserole dish on her lap.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Harold, it rains inside.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "So do the birds.", "name": "HAROLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "DEACON PRATT, the treasurer, adjusts his hearing aid and beams at no one.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "What did he say?", "name": "DEACON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "CORNELIA ASHBY-REID sits beside him, knitting something blue.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "She leans over and speaks into his ear.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Harold wants to ignore the roof.", "name": "CORNELIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Bold.", "name": "DEACON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "We have eleven hundred dollars.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "The roofer wants four thousand.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "We could hold a raffle.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "We held one last year.", "name": "HAROLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "And?", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Somebody won the casserole.", "name": "HAROLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "All eyes drop to Marisol's dish.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "She shrugs.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "It was a very good casserole.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "TEDDY NKEMELU, the youngest member by forty years, sits in the back with a bag of seed.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "He pipes up.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "What if we race for it?", "name": "TEDDY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Race what?", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "The birds. Winner takes a share. Entry fee goes to the roof.", "name": "TEDDY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Gloria looks at Harold.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "He looks at Marisol.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "She looks at the casserole.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "She nods first.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Then he does.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Then everyone.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Gloria raises the gavel.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Motion carried. Somebody write that down.", "name": "GLORIA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Cornelia holds up her knitting.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "It is, on closer look, a tiny sweater for a pigeon.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Already on it.", "name": "CORNELIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}