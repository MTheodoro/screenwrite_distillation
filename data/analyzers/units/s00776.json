{"scene_id": "s00776", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00776.fountain", "heading": "INT. ORBITAL SEED VAULT - GREENHOUSE RING - DAY", "cast": [{"id": 0, "name": "ODALYS VANTERPOOL", "names": ["ODALYS VANTERPOOL", "ODALYS"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "PETRA ISHIGURO", "names": ["PETRA ISHIGURO", "PETRA"], "gender": "f", "first": 6, "spoke": 1}, {"id": 2, "name": "CALLUM ROUKEMA", "names": ["CALLUM ROUKEMA", "CALLUM"], "gender": "?", "first": 7, "spoke": 8}, {"id": 3, "name": "MIREILLE TANDON", "names": ["MIREILLE TANDON", "MIREILLE"], "gender": "f", "first": 9, "spoke": 2}, {"id": 4, "name": "SUNDARAM OKONKWO", "names": ["SUNDARAM OKONKWO", "SUNDARAM"], "gender": "m", "first": 10, "spoke": 6}, {"id": 5, "name": "KESTREL", "names": ["KESTREL"], "gender": "?", "first": 12, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. ORBITAL SEED VAULT - GREENHOUSE RING - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Curved walls of white panel.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of sealed trays glow violet under grow-lamps.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A slow hum, the sound of a place that never sleeps.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ODALYS VANTERPOOL, 50s, station botanist, checks a tray with gloved hands.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her coffee has been cold for hours.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "PETRA ISHIGURO, 30s, engineer, kneels at an access panel with a tablet and a mouthful of screws.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "CALLUM ROUKEMA, 40s, commander, stands at the viewport.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "He doesn't look at the Earth below.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "MIREILLE TANDON, 20s, intern, carries a tray of seedlings in both hands, like something that might break.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "DR. SUNDARAM OKONKWO, 60s, medical officer, leans in the doorway.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "He watches Callum's back.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "KESTREL, a station AI, speaks from a speaker above the door.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "Calm.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "Warm.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Exact.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Humidity in ring three is up four percent.", "name": "KESTREL", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "I see it.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "I'll check the condensers.", "name": "PETRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Callum turns from the window.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "He walks the row.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "His fingers brush a leaf.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "He stops at an empty tray.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "This one was labeled.", "name": "CALLUM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "It failed.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "It failed a month ago.", "name": "CALLUM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Yes.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Should I log it?", "name": "MIREILLE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "I did.", "name": "CALLUM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Silence.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "The lamps buzz.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Sundaram steps in, hands in his coat pockets.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "You didn't mention it at breakfast.", "name": "SUNDARAM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Nothing to mention.", "name": "CALLUM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Callum.", "name": "SUNDARAM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Sundaram.", "name": "CALLUM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "They both speak at once.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "The lab results came back.", "name": "SUNDARAM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "The cargo window opens Friday.", "name": "CALLUM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "It would help if you slept.", "name": "SUNDARAM", "speaker": 4, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "I'll check the manifest.", "name": "CALLUM", "speaker": 2, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Both stop.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Neither moves.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Petra, from the floor, pretends to read the tablet.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Mireille shifts the seedlings to her other arm.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Mireille, those need water.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Right. Yes.", "name": "MIREILLE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "She leaves in a hurry.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "The door sighs shut.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "Sundaram unclasps his hands.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "Holds something out: a small flat seed packet, yellowed at the edges.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "Take it.", "name": "SUNDARAM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "Callum does not.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "It's the last one from the old crop.", "name": "SUNDARAM", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "Callum takes it.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "Turns it over.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "Pockets it.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "Commander, a transmission is waiting.", "name": "KESTREL", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "dialogue", "text": "Later.", "name": "CALLUM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "He walks out.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "action", "text": "The door seals behind him.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "Odalys finally looks up.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "Petra sets down her screwdriver.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "Sundaram sits on an upturned crate.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "Nobody says anything.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "The lamps hum on.", "para": 18, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}