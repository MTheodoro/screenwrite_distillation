{"scene_id": "s00778", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00778.fountain", "heading": "EXT. MUNICIPAL POOL - TEN-METER DIVING TOWER - NIGHT", "cast": [{"id": 0, "name": "IZZY PAREDES", "names": ["IZZY PAREDES", "IZZY"], "gender": "m", "first": 5, "spoke": 15}, {"id": 1, "name": "WYATT BRODERICK", "names": ["WYATT BRODERICK", "WYATT"], "gender": "f", "first": 7, "spoke": 12}, {"id": 2, "name": "SOLENNE ADEYEMI-CHANG", "names": ["SOLENNE ADEYEMI-CHANG", "SOLENNE"], "gender": "f", "first": 8, "spoke": 11}], "units": [{"u": 0, "kind": "heading", "text": "EXT. MUNICIPAL POOL - TEN-METER DIVING TOWER - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Chain-link fence.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Empty bleachers.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The water is black, lit only by one emergency lamp.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Three teens climb the concrete tower.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "IZZY PAREDES, 16, steps onto the platform first.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Hoodie, bare feet, a bag of stolen fireworks.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "WYATT BRODERICK, 17, follows, taller, breathing hard from the stairs.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "SOLENNE ADEYEMI-CHANG, 16, brings up the rear with her phone light off.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "She keeps one hand on the rail.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Look at that. Whole town.", "name": "IZZY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "It's a parking lot and a Taco Bell.", "name": "WYATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "It's our parking lot.", "name": "IZZY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Can we just go back down?", "name": "SOLENNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "You said you wanted to see it.", "name": "IZZY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "From the bottom.", "name": "SOLENNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Wyatt laughs.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Solenne glares.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "You jumped from the five last summer.", "name": "WYATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I fell from the five.", "name": "SOLENNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Izzy digs in the bag.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Pulls out a firework.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Holds it up like a trophy.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Tonight we send Mr. Hendricks off.", "name": "IZZY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "He's not dead, Izzy. He retired.", "name": "WYATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Same thing. Teachers don't get better.", "name": "IZZY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "She flicks a lighter.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Nothing.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Again.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Nothing.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Give it.", "name": "WYATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "No.", "name": "IZZY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "You'll blow your hand off.", "name": "WYATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "You'll blow your hand off.", "name": "IZZY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "They tussle.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "The firework drops.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Rolls.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Solenne dives and catches it with both hands.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Stop it! Both of you!", "name": "SOLENNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "They freeze.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Wyatt's hand still on Izzy's sleeve.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Quiet.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Wind on the water.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Far below, a car passes.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Sorry.", "name": "WYATT", "speaker": 1, "ext": [], "paren": ["softer"], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Yeah.", "name": "IZZY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "They let go.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Izzy sits on the edge, legs over.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Wyatt sits beside her.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Solenne stays upright.", "para": 10, "sent": 3, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Is it weird that I'm going to miss this place?", "name": "SOLENNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "It's a pool.", "name": "WYATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "It's where we learned to swim.", "name": "SOLENNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "I learned to swim in a bathtub.", "name": "IZZY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "That's not swimming. That's drowning slowly.", "name": "WYATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Izzy shoves him.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "He shoves back.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "They both nearly tip.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Solenne yanks both by the hoods.", "para": 11, "sent": 3, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "Okay! No dying tonight. We have prom.", "name": "SOLENNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "Prom is stupid.", "name": "IZZY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Prom is the last thing before everything.", "name": "SOLENNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "Silence.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "Izzy picks at the platform's grit.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "My mom's moving us to Tucson.", "name": "IZZY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "When?", "name": "WYATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "August.", "name": "IZZY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "dialogue", "text": "You didn't tell us.", "name": "WYATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 68, "kind": "dialogue", "text": "I'm telling you now.", "name": "IZZY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "Solenne sits.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "All three in a row.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 71, "kind": "action", "text": "Legs dangling.", "para": 13, "sent": 2, "present": [0, 1, 2]}, {"u": 72, "kind": "dialogue", "text": "We could jump.", "name": "SOLENNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 73, "kind": "dialogue", "text": "We could.", "name": "WYATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 74, "kind": "dialogue", "text": "All three?", "name": "IZZY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 75, "kind": "dialogue", "text": "All three.", "name": "SOLENNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 76, "kind": "action", "text": "They stand.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 77, "kind": "action", "text": "Hold hands.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 78, "kind": "action", "text": "Breathe.", "para": 14, "sent": 2, "present": [0, 1, 2]}, {"u": 79, "kind": "dialogue", "text": "On three.", "name": "WYATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 80, "kind": "dialogue", "text": "On one. Three is a trap.", "name": "IZZY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 81, "kind": "dialogue", "text": "One!", "name": "SOLENNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 82, "kind": "action", "text": "They leap together, screaming, into the black.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 83, "kind": "action", "text": "SPLASH.", "para": 16, "sent": 0, "present": [0, 1, 2]}, {"u": 84, "kind": "action", "text": "Then laughter.", "para": 16, "sent": 1, "present": [0, 1, 2]}, {"u": 85, "kind": "action", "text": "Echoing.", "para": 16, "sent": 2, "present": [0, 1, 2]}, {"u": 86, "kind": "action", "text": "Overhead, a floodlight clicks on.", "para": 17, "sent": 0, "present": [0, 1, 2]}, {"u": 87, "kind": "action", "text": "A flashlight beam sweeps the water.", "para": 17, "sent": 1, "present": [0, 1, 2]}, {"u": 88, "kind": "action", "text": "A whistle shrieks from the fence line.", "para": 18, "sent": 0, "present": [0, 1, 2]}, {"u": 89, "kind": "action", "text": "The three scramble out, shrieking, dripping, stumbling over each other, laughing so hard they can barely climb the fence.", "para": 19, "sent": 0, "present": [0, 1, 2]}]}