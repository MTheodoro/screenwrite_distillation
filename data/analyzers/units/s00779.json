{"scene_id": "s00779", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00779.fountain", "heading": "INT. TAXIDERMY CLASSROOM - NIGHT", "cast": [{"id": 0, "name": "PRUDENCE LOVELACE-AKINS", "names": ["PRUDENCE LOVELACE-AKINS", "PRUDENCE"], "gender": "?", "first": 5, "spoke": 5}, {"id": 1, "name": "ISAAC TOMLINSON", "names": ["ISAAC TOMLINSON", "ISAAC"], "gender": "?", "first": 6, "spoke": 4}, {"id": 2, "name": "JAMES TALLCHIEF", "names": ["JAMES TALLCHIEF", "JAMES"], "gender": "?", "first": 33, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. TAXIDERMY CLASSROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Glass eyes in rows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fox, owl, a badger mid-snarl.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single desk lamp.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Moonlight on frozen fur.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "PRUDENCE LOVELACE-AKINS, 30s, instructor, lays a half-stuffed heron on the worktable.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across from her, ISAAC TOMLINSON, 20s, her student, wipes his hands on a towel and keeps glancing at the badger.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Did that move?", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "It's a badger, Isaac. It's dead.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "It was facing the door before.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "You're tired.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She picks up a scalpel.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Isaac backs toward the shelves.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Come here. Hold the wing.", "name": "PRUDENCE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He does.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "His fingers tremble on the feather.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Behind them, the badger turns its head.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Neither sees.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "The lamp flickers.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Prudence cuts a clean line along the heron's belly, and Isaac jerks the wing aside.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "The fox on the shelf shifts a paw.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "The owl's neck rotates.", "para": 5, "sent": 4, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Prudence reaches for the thread.", "para": 5, "sent": 5, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Isaac bumps the table.", "para": 5, "sent": 6, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "A jar of glass eyes rolls.", "para": 5, "sent": 7, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Every eye in the room is suddenly pointed at the two of them.", "para": 5, "sent": 8, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Prudence.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Hold still.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Prudence!", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "She looks up.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "The room is full of eyes.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Footsteps in the hall.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "The door swings wide.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "JAMES TALLCHIEF, 50s, the night janitor, mop in hand, steps in.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "He stops.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Takes it in.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Ladies, gentlemen. And whoever you are.", "name": "JAMES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "The animals all freeze mid-turn.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Silence.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "James sets the mop down.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Walks to the badger.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Picks it up by the scruff.", "para": 11, "sent": 3, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Turns it around, facing the wall.", "para": 11, "sent": 4, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "They do that when they're lonely.", "name": "JAMES", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "They do WHAT?", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Somebody leave a radio on for them. Classical.", "name": "JAMES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "He leaves.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Isaac exhales for the first time in a minute.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Prudence puts down the scalpel.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Reaches for the radio.", "para": 13, "sent": 1, "present": [0, 1, 2]}]}