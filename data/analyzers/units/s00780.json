{"scene_id": "s00780", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00780.fountain", "heading": "EXT. INK RIVER - FERRYMAN'S TOLL BOOTH - TWILIGHT", "cast": [{"id": 0, "name": "MAGDA ORLOVSKAYA-FELL", "names": ["MAGDA ORLOVSKAYA-FELL", "MAGDA"], "gender": "f", "first": 5, "spoke": 9}, {"id": 1, "name": "BASIL THORNQUIST", "names": ["BASIL THORNQUIST", "BASIL"], "gender": "m", "first": 6, "spoke": 7}, {"id": 2, "name": "SIX-FINGERED JO", "names": ["SIX-FINGERED JO", "JO"], "gender": "?", "first": 8, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. INK RIVER - FERRYMAN'S TOLL BOOTH - TWILIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Black water.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Slow.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Letters swim in it like minnows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A crooked booth on stilts.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MAGDA ORLOVSKAYA-FELL, 60s, tollkeeper, lantern for a left hand, counts coins into a jar.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "BASIL THORNQUIST, 30s, pilgrim, muddy cloak, stands at the booth window.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "A satchel at his feet.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "SIX-FINGERED JO, ageless, a heron the height of a man, stalks along the dock.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Toll's a memory.", "name": "MAGDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "A memory?", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Of your own. Not borrowed.", "name": "MAGDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Basil digs in his satchel.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Pulls out a pebble.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Holds it up.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "My mother's garden.", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Magda sniffs the pebble.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Shakes her head.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Too small.", "name": "MAGDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "It's a good memory.", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "It's a pebble.", "name": "MAGDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Jo ruffles.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Taps the dock with a long beak.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Let him pass, Magda.", "name": "JO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Don't tell me my business, bird.", "name": "MAGDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "He's carrying something heavy.", "name": "JO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "They all are.", "name": "MAGDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Basil lifts the satchel.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Sets it on the sill.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "The booth creaks.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "What if I told you what's inside?", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Magda and Jo lean in.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Tell.", "name": "MAGDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Tell.", "name": "JO", "speaker": 2, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "They share a look.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Both clear their throats.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Basil smiles faintly.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "A name.", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Whose?", "name": "MAGDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Whose?", "name": "JO", "speaker": 2, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Mine. I left it at home.", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Magda writes in her ledger.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Crosses out a line.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "That'll do.", "name": "MAGDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "She slides a coin through.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "It's blank on both sides.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Basil takes it.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Mind the third current.", "name": "JO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Thank you.", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "The ferry is a hollow boat of reeds.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "It nudges the dock.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Basil steps aboard.", "para": 12, "sent": 2, "present": [0, 1, 2]}]}