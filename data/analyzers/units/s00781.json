{"scene_id": "s00781", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00781.fountain", "heading": "INT. CAR WASH CONTROL ROOM - NIGHT", "cast": [{"id": 0, "name": "NADIA ROSTOVA-BELL", "names": ["NADIA ROSTOVA-BELL", "NADIA"], "gender": "?", "first": 5, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. CAR WASH CONTROL ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cinderblock.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Buzzing fluorescents.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Soap suds crawl down a window.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Beyond it, a dark tunnel of brushes, still.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "NADIA ROSTOVA-BELL, 30s, courier jacket, sits on an overturned crate.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A phone in her hand.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "A duffel at her feet.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "She presses play.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "dialogue", "text": "Memo one. Tuesday. If you hear this, the handoff went fine.", "name": "NADIA", "speaker": 0, "ext": ["V.O."], "paren": ["recorded, steady"], "dual": false, "present": [0]}, {"u": 10, "kind": "action", "text": "Nadia winces.", "para": 3, "sent": 0, "present": [0]}, {"u": 11, "kind": "dialogue", "text": "Package is in the blue duffel. Do not open it.", "name": "NADIA", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 12, "kind": "action", "text": "She looks at the duffel.", "para": 4, "sent": 0, "present": [0]}, {"u": 13, "kind": "action", "text": "Doesn't move.", "para": 4, "sent": 1, "present": [0]}, {"u": 14, "kind": "dialogue", "text": "Memo two. Wednesday. Someone followed me from the depot.", "name": "NADIA", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 15, "kind": "action", "text": "She pauses it.", "para": 5, "sent": 0, "present": [0]}, {"u": 16, "kind": "action", "text": "Breathes.", "para": 5, "sent": 1, "present": [0]}, {"u": 17, "kind": "action", "text": "Presses again.", "para": 5, "sent": 2, "present": [0]}, {"u": 18, "kind": "dialogue", "text": "Memo three. They know the car wash. I don't know how.", "name": "NADIA", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": ["recorded, thinner"], "dual": false, "present": [0]}, {"u": 19, "kind": "action", "text": "Nadia stands.", "para": 6, "sent": 0, "present": [0]}, {"u": 20, "kind": "action", "text": "Checks the door.", "para": 6, "sent": 1, "present": [0]}, {"u": 21, "kind": "action", "text": "The deadbolt.", "para": 6, "sent": 2, "present": [0]}, {"u": 22, "kind": "action", "text": "The window.", "para": 6, "sent": 3, "present": [0]}, {"u": 23, "kind": "action", "text": "The tunnel.", "para": 6, "sent": 4, "present": [0]}, {"u": 24, "kind": "action", "text": "A drip.", "para": 7, "sent": 0, "present": [0]}, {"u": 25, "kind": "action", "text": "A distant clank.", "para": 7, "sent": 1, "present": [0]}, {"u": 26, "kind": "action", "text": "She freezes.", "para": 8, "sent": 0, "present": [0]}, {"u": 27, "kind": "action", "text": "Nothing.", "para": 9, "sent": 0, "present": [0]}, {"u": 28, "kind": "action", "text": "She sits again.", "para": 10, "sent": 0, "present": [0]}, {"u": 29, "kind": "dialogue", "text": "Memo four. I'm going to open the duffel. Whoever you are, I'm sorry.", "name": "NADIA", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": ["recorded"], "dual": false, "present": [0]}, {"u": 30, "kind": "action", "text": "Nadia stares at the phone.", "para": 11, "sent": 0, "present": [0]}, {"u": 31, "kind": "dialogue", "text": "I never recorded this one.", "name": "NADIA", "speaker": 0, "ext": [], "paren": ["whisper"], "dual": false, "present": [0]}, {"u": 32, "kind": "action", "text": "She scrolls.", "para": 12, "sent": 0, "present": [0]}, {"u": 33, "kind": "action", "text": "The memo is dated tomorrow.", "para": 12, "sent": 1, "present": [0]}, {"u": 34, "kind": "action", "text": "The voice continues, gentler.", "para": 13, "sent": 0, "present": [0]}, {"u": 35, "kind": "dialogue", "text": "It's just a hard drive. It's always been just a hard drive. Walk away.", "name": "NADIA", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": ["recorded"], "dual": false, "present": [0]}, {"u": 36, "kind": "action", "text": "Nadia lifts the duffel.", "para": 14, "sent": 0, "present": [0]}, {"u": 37, "kind": "action", "text": "Unzips it.", "para": 14, "sent": 1, "present": [0]}, {"u": 38, "kind": "action", "text": "A small black drive, a Post-it: \"SORRY.\"", "para": 14, "sent": 2, "present": [0]}, {"u": 39, "kind": "action", "text": "She laughs.", "para": 15, "sent": 0, "present": [0]}, {"u": 40, "kind": "action", "text": "Short.", "para": 15, "sent": 1, "present": [0]}, {"u": 41, "kind": "action", "text": "Hollow.", "para": 15, "sent": 2, "present": [0]}, {"u": 42, "kind": "action", "text": "Then not.", "para": 15, "sent": 3, "present": [0]}, {"u": 43, "kind": "action", "text": "She pockets the drive.", "para": 16, "sent": 0, "present": [0]}, {"u": 44, "kind": "action", "text": "Shoulders the duffel.", "para": 16, "sent": 1, "present": [0]}, {"u": 45, "kind": "action", "text": "At the door she hesitates.", "para": 17, "sent": 0, "present": [0]}, {"u": 46, "kind": "action", "text": "Presses delete.", "para": 17, "sent": 1, "present": [0]}, {"u": 47, "kind": "dialogue", "text": "Memo five.", "name": "NADIA", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the phone"], "dual": false, "present": [0]}, {"u": 48, "kind": "action", "text": "She exits.", "para": 18, "sent": 0, "present": [0]}, {"u": 49, "kind": "action", "text": "The brushes begin to spin behind her.", "para": 18, "sent": 1, "present": [0]}]}