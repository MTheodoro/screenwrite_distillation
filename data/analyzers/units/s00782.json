{"scene_id": "s00782", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00782.fountain", "heading": "INT. FIELD HOSPITAL - CONVERTED ICE RINK - NIGHT", "cast": [{"id": 0, "name": "LUCIA FONTANILLA", "names": ["LUCIA FONTANILLA", "LUCIA"], "gender": "m", "first": 5, "spoke": 10}, {"id": 1, "name": "NURSE GRETA HOLMQVIST", "names": ["NURSE GRETA HOLMQVIST", "GRETA"], "gender": "?", "first": 6, "spoke": 3}, {"id": 2, "name": "ABEL TESFAYE", "names": ["ABEL TESFAYE", "ABEL"], "gender": "m", "first": 7, "spoke": 3}, {"id": 3, "name": "RAFI", "names": ["RAFI"], "gender": "?", "first": 18, "spoke": 3}, {"id": 4, "name": "CORDERO", "names": ["CORDERO"], "gender": "?", "first": 18, "spoke": 0}, {"id": 5, "name": "KOFI", "names": ["KOFI"], "gender": "m", "first": 19, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. FIELD HOSPITAL - CONVERTED ICE RINK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cots on the ice mats.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Generators drone.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Breath hangs in the cold.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A Zamboni bay is now supply storage.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. LUCIA FONTANILLA, 40s, scrubs under a parka, works over a patient on a gurney.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "NURSE GRETA HOLMQVIST, 50s, holds the instrument tray.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "The patient, ABEL TESFAYE, 30s, grips the rail, sweating.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Pressure?", "name": "LUCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Ninety over fifty.", "name": "GRETA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Drop another liter.", "name": "LUCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Greta hangs a bag.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "The line tangles.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She curses and fixes it.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Lucia presses on Abel's side.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "He groans.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Doc, it's okay. Stop.", "name": "ABEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "It's not okay, Abel.", "name": "LUCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "RAFAEL \"RAFI\" CORDERO, 20s, paramedic, bursts through the doors with a teenage boy in tow.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "The boy, KOFI, 15, has a bandaged hand.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Doctor! Triage says you've got a bed.", "name": "RAFI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "I've got a floor.", "name": "LUCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Then I'll take the floor.", "name": "RAFI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Is that my brother?", "name": "KOFI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Abel turns his head.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Kofi.", "name": "ABEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Kofi runs.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Rafi grabs for him, misses.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Kofi barrels into Greta.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "The tray flies.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Scalpels clatter across the ice.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Lucia lunges to catch the tray and slips.", "para": 5, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Rafi catches her.", "para": 5, "sent": 6, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "They fall together, tangled, in a heap by the gurney.", "para": 5, "sent": 7, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "She is first up.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "She looks down at Abel.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "His monitor flatlines.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Greta! Paddles!", "name": "LUCIA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Charging!", "name": "GRETA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "She slaps the paddles together.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Lucia takes them.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Kofi freezes at the foot of the cot, hands over his mouth.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Clear!", "name": "LUCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Abel arches.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Falls.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "A blip.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Another blip.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "We've got him.", "name": "GRETA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "She exhales.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "Lucia lets the paddles drop on his chest.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "Her hands shake.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "Is he okay?", "name": "KOFI", "speaker": 5, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "He's okay.", "name": "RAFI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "Lucia turns to Kofi, steps close.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "She inspects the bandaged hand.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "Who did this wrap?", "name": "LUCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "Me.", "name": "KOFI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "It's terrible.", "name": "LUCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "dialogue", "text": "Sorry.", "name": "KOFI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "Sit. I'll redo it. After.", "name": "LUCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "action", "text": "Kofi sits on the ice.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "Abel's eyes flutter open.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "dialogue", "text": "Doc?", "name": "ABEL", "speaker": 2, "ext": [], "paren": ["faint"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "dialogue", "text": "Still here.", "name": "LUCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}