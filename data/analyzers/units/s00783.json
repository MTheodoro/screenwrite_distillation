{"scene_id": "s00783", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00783.fountain", "heading": "INT. SPEAKEASY BEHIND A FUNERAL PARLOR - NIGHT, 1923", "cast": [{"id": 0, "name": "MAMIE DUPREE", "names": ["MAMIE DUPREE", "MAMIE"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "MAN IN GREY HAT", "names": ["MAN", "MAN IN GREY HAT"], "gender": "?", "first": 6, "spoke": 3}, {"id": 2, "name": "GREY HAT", "names": ["GREY HAT"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "BARNABY SCOTT", "names": ["BARNABY SCOTT", "BARNABY"], "gender": "m", "first": 9, "spoke": 1}, {"id": 4, "name": "ACKERLY", "names": ["ACKERLY"], "gender": "?", "first": 24, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. SPEAKEASY BEHIND A FUNERAL PARLOR - NIGHT, 1923", "present": []}, {"u": 1, "kind": "action", "text": "Caskets stacked as bar-backs.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A gramophone croons.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Candlelight.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MAMIE DUPREE, 30s, bartender, silver flapper dress, polishes a glass.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Everything is lovely and slow.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "A MAN IN A GREY HAT, 40s, sits at the bar.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "He turns his drink in circles.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Doesn't drink.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "BARNABY SCOTT, 60s, the undertaker, dozes on a coffin lid in the corner.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "You're not from here.", "name": "MAMIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "No.", "name": "MAN IN GREY HAT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "You like the music?", "name": "MAMIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "It's fine.", "name": "MAN IN GREY HAT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "It's a funeral parlor. We play what the dead like.", "name": "MAMIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "He almost smiles.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Takes a sip.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Sets the glass down.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Your license?", "name": "MAN IN GREY HAT", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Mamie's polishing stops.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Barnaby's snore stops.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Pardon?", "name": "MAMIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "The man pulls back his coat.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "A badge.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Solomon Ackerly. Prohibition Bureau.", "name": "ACKERLY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Mamie lowers the glass.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Slowly.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Barnaby sits up in his coffin.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Mamie. The other room.", "name": "BARNABY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Detective, we're only mourning.", "name": "MAMIE", "speaker": 0, "ext": [], "paren": ["calm"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "In evening dress.", "name": "ACKERLY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "She glances at the gramophone.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Reaches.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Turns the volume UP.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "The gramophone swells.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Behind the bar, the wall begins to slide open.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}]}