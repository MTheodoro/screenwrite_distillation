{"scene_id": "s00784", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00784.fountain", "heading": "INT. MATTRESS SHOWROOM - NIGHT", "cast": [{"id": 0, "name": "MARV QUIGLEY", "names": ["MARV QUIGLEY", "MARV"], "gender": "m", "first": 5, "spoke": 12}, {"id": 1, "name": "SECURITY GUARD", "names": ["SECURITY GUARD"], "gender": "?", "first": 7, "spoke": 5}, {"id": 2, "name": "DARNELL", "names": ["DARNELL"], "gender": "?", "first": 25, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. MATTRESS SHOWROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Rows of beds under cold light.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A tripod.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A ring light.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A laptop showing a chat window scrolling.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MARV QUIGLEY, 50s, polyester suit, headset mic, bounces on a king-size to show springs.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "dialogue", "text": "Folks, welcome to the Midnight Mattress Marathon!", "name": "MARV", "speaker": 0, "ext": [], "paren": ["to camera"], "dual": false, "present": [0]}, {"u": 7, "kind": "action", "text": "A SECURITY GUARD, 30s, in a windbreaker, stands in the doorway with a flashlight.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Marv doesn't see him.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Three hundred viewers! That's a record, folks!", "name": "MARV", "speaker": 0, "ext": ["CONT'D"], "paren": ["to camera"], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "The guard coughs.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Not now, Brenda.", "name": "MARV", "speaker": 0, "ext": ["CONT'D"], "paren": ["not turning"], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I'm not Brenda.", "name": "SECURITY GUARD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Marv spins.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He sees the flashlight.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Drops to a sit.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Who the hell are you?", "name": "MARV", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Mall security.", "name": "SECURITY GUARD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "At a standalone store?", "name": "MARV", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "It's a big parking lot.", "name": "SECURITY GUARD", "speaker": 1, "ext": [], "paren": ["shrugs"], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Folks, ignore the man in the windbreaker.", "name": "MARV", "speaker": 0, "ext": [], "paren": ["to camera"], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "The guard steps into frame.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Waves at the camera.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Hi, Mom.", "name": "SECURITY GUARD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Oh, no.", "name": "MARV", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I'm Darnell, by the way.", "name": "SECURITY GUARD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Darnell, you're ruining my numbers.", "name": "MARV", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "The chat says they like me.", "name": "DARNELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "\"Who's the guard? Marry him.\" Okay. Fine.", "name": "MARV", "speaker": 0, "ext": [], "paren": ["reading laptop"], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Darnell sits on the next bed.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "He bounces.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "His face softens.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Wow.", "name": "DARNELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Memory foam.", "name": "MARV", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "I could sleep here.", "name": "DARNELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "That's the idea, Darnell.", "name": "MARV", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "No. Like, tonight.", "name": "DARNELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Marv looks at the camera.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "At Darnell.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "At the chat.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Folks, we're extending the marathon.", "name": "MARV", "speaker": 0, "ext": [], "paren": ["to camera"], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Best shift ever.", "name": "DARNELL", "speaker": 2, "ext": [], "paren": ["to self"], "dual": false, "present": [0, 1, 2]}]}