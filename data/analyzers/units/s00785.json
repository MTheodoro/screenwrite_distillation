{"scene_id": "s00785", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00785.fountain", "heading": "INT. COASTAL RADAR SHACK - NIGHT, 1944", "cast": [{"id": 0, "name": "CORPORAL AGNES TILLMAN-REED", "names": ["CORPORAL AGNES TILLMAN-REED", "AGNES"], "gender": "?", "first": 5, "spoke": 5}, {"id": 1, "name": "SERGEANT BARTHOLOMEW OYELOWO", "names": ["SERGEANT BARTHOLOMEW OYELOWO"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "PRIVATE LUCIEN FAIVRE", "names": ["PRIVATE LUCIEN FAIVRE", "LUCIEN"], "gender": "m", "first": 7, "spoke": 2}, {"id": 3, "name": "BART", "names": ["BART"], "gender": "?", "first": 13, "spoke": 7}, {"id": 4, "name": "COMMANDER HALLORAN", "names": ["COMMANDER HALLORAN", "HALLORAN"], "gender": "?", "first": 22, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. COASTAL RADAR SHACK - NIGHT, 1944", "present": []}, {"u": 1, "kind": "action", "text": "Plywood walls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A glowing scope.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A kettle on a hot plate.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain on tin.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CORPORAL AGNES TILLMAN-REED, 20s, headset, hunches at the scope.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "SERGEANT BARTHOLOMEW OYELOWO, 40s, reads a magazine upside down.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "PRIVATE LUCIEN FAIVRE, 19, stirs tea he isn't drinking.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "She taps the glass.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Leans closer.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Contact. Bearing two-seven-zero.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He drops the magazine.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Rolls the chair beside her.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Range?", "name": "BART", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Thirty miles. Slow.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Ours?", "name": "BART", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "No transponder.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "He swears under his breath.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "The other boy stops stirring.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Should I wake the captain?", "name": "LUCIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Not yet. Let it come.", "name": "BART", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "The radio crackles on the shelf.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Shack Seven, Halloran. Report.", "name": "COMMANDER HALLORAN", "speaker": 4, "ext": ["V.O."], "paren": ["through static"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Bart grabs the handset.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Agnes turns the dial.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Single contact. Unidentified. Approaching.", "name": "BART", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Hold position. Do not engage.", "name": "HALLORAN", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Understood, sir.", "name": "BART", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "He sets the handset down.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "She watches the scope.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "The blip crawls.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Closing.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Maybe it's a fishing boat.", "name": "LUCIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "At night, in a blackout?", "name": "BART", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "He doesn't answer.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "He pours the tea down the sink.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "The blip stops.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Hangs.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Starts to fade.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "It's turning.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "She leans back.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Exhales.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "He rubs his face with both hands.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Good.", "name": "BART", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "The radio crackles again.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Shack Seven, stand down. It was ours.", "name": "HALLORAN", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Bart picks up the magazine.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Right side up this time.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}]}