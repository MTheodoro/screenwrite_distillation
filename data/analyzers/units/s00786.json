{"scene_id": "s00786", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00786.fountain", "heading": "INT. HOTEL ROOM - GRAND PACIFIC - NIGHT, 1951", "cast": [{"id": 0, "name": "VIVIENNE LAROCHE-STANTON", "names": ["VIVIENNE LAROCHE-STANTON", "VIVIENNE"], "gender": "?", "first": 4, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOTEL ROOM - GRAND PACIFIC - NIGHT, 1951", "present": []}, {"u": 1, "kind": "action", "text": "Art deco lamp.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A rain-streaked window.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A wire recorder on the writing desk, its spools motionless.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "VIVIENNE LAROCHE-STANTON, 30s, evening gown, unpinned hair, sits on the edge of the bed.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She stares at the recorder as though it might speak first.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "She stands.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Crosses.", "para": 2, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "Presses PLAY.", "para": 2, "sent": 2, "present": [0]}, {"u": 9, "kind": "dialogue", "text": "Darling, it's me. If you're hearing this, I've made it to San Francisco and the hotel has the most dreadful wallpaper.", "name": "VIVIENNE", "speaker": 0, "ext": ["V.O."], "paren": ["recorded, bright"], "dual": false, "present": [0]}, {"u": 10, "kind": "action", "text": "Vivienne smiles at the wallpaper.", "para": 3, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "It is dreadful.", "para": 3, "sent": 1, "present": [0]}, {"u": 12, "kind": "dialogue", "text": "I'll see you at the Cliff House at nine. Wear the blue tie.", "name": "VIVIENNE", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 13, "kind": "action", "text": "She stops it.", "para": 4, "sent": 0, "present": [0]}, {"u": 14, "kind": "action", "text": "Crosses to the window.", "para": 4, "sent": 1, "present": [0]}, {"u": 15, "kind": "action", "text": "Checks her wristwatch.", "para": 4, "sent": 2, "present": [0]}, {"u": 16, "kind": "action", "text": "11:40.", "para": 4, "sent": 3, "present": [0]}, {"u": 17, "kind": "dialogue", "text": "Nine.", "name": "VIVIENNE", "speaker": 0, "ext": [], "paren": ["quiet"], "dual": false, "present": [0]}, {"u": 18, "kind": "action", "text": "She returns.", "para": 5, "sent": 0, "present": [0]}, {"u": 19, "kind": "action", "text": "Rewinds.", "para": 5, "sent": 1, "present": [0]}, {"u": 20, "kind": "action", "text": "Plays again.", "para": 5, "sent": 2, "present": [0]}, {"u": 21, "kind": "dialogue", "text": "Darling, it's me.", "name": "VIVIENNE", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": ["recorded, bright"], "dual": false, "present": [0]}, {"u": 22, "kind": "action", "text": "She snaps it off.", "para": 6, "sent": 0, "present": [0]}, {"u": 23, "kind": "action", "text": "Paces.", "para": 6, "sent": 1, "present": [0]}, {"u": 24, "kind": "action", "text": "Picks up the telephone receiver.", "para": 6, "sent": 2, "present": [0]}, {"u": 25, "kind": "action", "text": "Puts it down.", "para": 6, "sent": 3, "present": [0]}, {"u": 26, "kind": "action", "text": "She opens the closet.", "para": 7, "sent": 0, "present": [0]}, {"u": 27, "kind": "action", "text": "A blue tie hangs there, tags still on.", "para": 7, "sent": 1, "present": [0]}, {"u": 28, "kind": "action", "text": "She pulls it free.", "para": 7, "sent": 2, "present": [0]}, {"u": 29, "kind": "action", "text": "Holds it.", "para": 7, "sent": 3, "present": [0]}, {"u": 30, "kind": "dialogue", "text": "You said you'd come.", "name": "VIVIENNE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 31, "kind": "action", "text": "She wraps the tie around her fist.", "para": 8, "sent": 0, "present": [0]}, {"u": 32, "kind": "dialogue", "text": "You said you'd come, and you didn't, and I wore the dress.", "name": "VIVIENNE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 33, "kind": "action", "text": "She flings the tie across the room.", "para": 9, "sent": 0, "present": [0]}, {"u": 34, "kind": "action", "text": "It slaps the wall.", "para": 9, "sent": 1, "present": [0]}, {"u": 35, "kind": "action", "text": "She picks up the recorder, lifts it above her head, and hurls it at the wardrobe mirror.", "para": 9, "sent": 2, "present": [0]}, {"u": 36, "kind": "action", "text": "CRASH.", "para": 10, "sent": 0, "present": [0]}, {"u": 37, "kind": "action", "text": "The mirror shatters.", "para": 10, "sent": 1, "present": [0]}, {"u": 38, "kind": "action", "text": "The spools unspool in long brown ribbons.", "para": 10, "sent": 2, "present": [0]}, {"u": 39, "kind": "action", "text": "Silence.", "para": 11, "sent": 0, "present": [0]}, {"u": 40, "kind": "action", "text": "Rain.", "para": 11, "sent": 1, "present": [0]}, {"u": 41, "kind": "action", "text": "She stands among the shards, breathing.", "para": 11, "sent": 2, "present": [0]}, {"u": 42, "kind": "action", "text": "Then, from the broken machine, a last crackle of voice.", "para": 12, "sent": 0, "present": [0]}, {"u": 43, "kind": "dialogue", "text": "...and darling, whatever happens, I'll wait.", "name": "VIVIENNE", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": ["recorded"], "dual": false, "present": [0]}, {"u": 44, "kind": "action", "text": "Vivienne sinks to the floor.", "para": 13, "sent": 0, "present": [0]}, {"u": 45, "kind": "action", "text": "The lamp flickers.", "para": 13, "sent": 1, "present": [0]}]}