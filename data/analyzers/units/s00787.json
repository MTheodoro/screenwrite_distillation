{"scene_id": "s00787", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00787.fountain", "heading": "INT. FERRY GALLEY - ARBITRATION - DAY", "cast": [{"id": 0, "name": "ARBITRATOR HENRIETTA OSEI-BONSU", "names": ["ARBITRATOR HENRIETTA OSEI-BONSU", "HENRIETTA"], "gender": "f", "first": 5, "spoke": 6}, {"id": 1, "name": "PELAGIA STAVROU", "names": ["PELAGIA STAVROU", "PELAGIA"], "gender": "f", "first": 6, "spoke": 6}, {"id": 2, "name": "RHYS MOLYNEUX", "names": ["RHYS MOLYNEUX", "RHYS"], "gender": "f", "first": 7, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. FERRY GALLEY - ARBITRATION - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A docked ferry's galley, converted for the day.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Stainless counters.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Sandwich trays.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A folding table with three chairs and a pitcher of water.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ARBITRATOR HENRIETTA OSEI-BONSU, 60s, sits at the head.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "PELAGIA STAVROU, 40s, counsel for the claimant, sits to her left.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "RHYS MOLYNEUX, 50s, counsel for the respondent, sits to her right.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "He loosens his tie.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "She straightens her blazer.", "para": 1, "sent": 4, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Henrietta clicks a pen.", "para": 1, "sent": 5, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Counsel. You've had a week. Is there a deal?", "name": "HENRIETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "None, Your Honor.", "name": "PELAGIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Not at the number she's asking.", "name": "RHYS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Which is?", "name": "HENRIETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Two point four million.", "name": "PELAGIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Preposterous.", "name": "RHYS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "It's modest.", "name": "PELAGIA", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "It's insane.", "name": "RHYS", "speaker": 2, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Both stop.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Henrietta lifts a hand.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Silence.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "One at a time.", "name": "HENRIETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "She pours water.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Slides the pitcher toward Rhys.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "He doesn't take it.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Pelagia does.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "The respondent's captain falsified the maintenance log. We have the original.", "name": "PELAGIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "She opens a folder.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Slaps a photocopy on the table.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "He leans in.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "She leans back.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Henrietta puts on reading glasses and studies the page, line by line, as the ferry creaks against its moorings.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "That's not authenticated.", "name": "RHYS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "It's his handwriting.", "name": "PELAGIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Anyone can forge handwriting.", "name": "RHYS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Anyone can try.", "name": "PELAGIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Henrietta lifts her head.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Mr. Molyneux. Is that your client's signature?", "name": "HENRIETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Rhys glances at the page.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "A long beat.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "His mouth opens, closes.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "I would need to confer.", "name": "RHYS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Then confer.", "name": "HENRIETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "He stands.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Hesitates.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Sits.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "It's his.", "name": "RHYS", "speaker": 2, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Pelagia exhales.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Henrietta takes off her glasses.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Break for lunch. Take the sandwiches.", "name": "HENRIETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "They rise.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "He holds the door for her.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "She nods once, without triumph.", "para": 9, "sent": 2, "present": [0, 1, 2]}]}