{"scene_id": "s00788", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00788.fountain", "heading": "INT. AGING CAVE - ALPINE CHEESE VAULT - NIGHT", "cast": [{"id": 0, "name": "MARGUERITE LOUVEL", "names": ["MARGUERITE LOUVEL", "MARGUERITE"], "gender": "f", "first": 5, "spoke": 13}, {"id": 1, "name": "JUNIOR TWOMBLY", "names": ["JUNIOR TWOMBLY", "JUNIOR"], "gender": "?", "first": 7, "spoke": 6}, {"id": 2, "name": "DEL", "names": ["DEL"], "gender": "f", "first": 9, "spoke": 6}, {"id": 3, "name": "WRAY", "names": ["WRAY"], "gender": "?", "first": 9, "spoke": 0}, {"id": 4, "name": "OSCAR PELLEGRINI-OKAFOR", "names": ["OSCAR PELLEGRINI-OKAFOR", "OSCAR"], "gender": "?", "first": 11, "spoke": 2}, {"id": 5, "name": "MAN IN WHITE APRON", "names": ["MAN", "MAN IN WHITE APRON"], "gender": "?", "first": 35, "spoke": 3}, {"id": 6, "name": "WHITE APRON", "names": ["WHITE APRON"], "gender": "?", "first": 35, "spoke": 0}, {"id": 7, "name": "BERTRAND", "names": ["BERTRAND"], "gender": "?", "first": 52, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. AGING CAVE - ALPINE CHEESE VAULT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Carved stone.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wheels of cheese on spruce shelves, rows upon rows, rind blooming white and grey.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single gas lamp.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The air tastes of salt and earth.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MARGUERITE LOUVEL, 40s, immaculate trench coat, strolls the aisle with her hands behind her back.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She might be visiting an aunt.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "JUNIOR TWOMBLY, 30s, safecracker, sweater too warm for the cave, kneels at a steel door set into the rock.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He listens, ear to the dial.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "DELPHINE \"DEL\" WRAY, 20s, getaway driver, sits cross-legged on a barrel, a thermos on her knee.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "She watches the entrance.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "OSCAR PELLEGRINI-OKAFOR, 50s, the inside man, wears a cheesemonger's smock and sweats through it.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "He hovers by the door and checks his watch every few seconds.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "How long?", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Ten minutes.", "name": "JUNIOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "He said ten minutes at midnight.", "name": "OSCAR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Oscar. Breathe.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "I am breathing. I'm breathing very hard.", "name": "OSCAR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "He said that ten minutes ago.", "name": "DEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "He is a patient man.", "name": "JUNIOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Del, the road?", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Quiet. Too quiet.", "name": "DEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Marguerite touches a wheel of cheese.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Leaves a fingerprint in the rind.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "She looks at it.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Wipes it carefully.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Gloves.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "I'm wearing gloves.", "name": "JUNIOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Del.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Bare. Sorry.", "name": "DEL", "speaker": 2, "ext": [], "paren": ["holds up hands"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "She pulls on gloves.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Junior turns the dial.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "A click.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Another.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "A shape detaches itself from the shadow between shelves.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "A MAN IN A WHITE APRON, 60s, holds a cheese iron like a sword.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "You're in my cave.", "name": "MAN IN WHITE APRON", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "Everyone freezes.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "Del slides off the barrel.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "Marguerite doesn't flinch.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "We're expected.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "dialogue", "text": "By who?", "name": "MAN IN WHITE APRON", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "dialogue", "text": "By the cheese.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "His eyes narrow.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "The cheese iron drops a few inches.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "Marguerite.", "name": "JUNIOR", "speaker": 1, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "dialogue", "text": "Keep dialing.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": ["quietly, to him"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "dialogue", "text": "What do you want?", "name": "MAN IN WHITE APRON", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "dialogue", "text": "The Reserve. 1978.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "action", "text": "He studies her.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "action", "text": "She holds his eyes.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "action", "text": "The lamp hisses.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "dialogue", "text": "I am Bertrand Blanchet. I have been guarding that wheel for forty years.", "name": "BERTRAND", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 53, "kind": "dialogue", "text": "Then you know it was never meant to be sold.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 54, "kind": "dialogue", "text": "It was not.", "name": "BERTRAND", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 55, "kind": "dialogue", "text": "Mr. Blanchet, with respect, it's two million dollars of dairy.", "name": "DEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 56, "kind": "dialogue", "text": "It is two million dollars of my wife.", "name": "BERTRAND", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 57, "kind": "action", "text": "Silence.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 58, "kind": "action", "text": "The lamp.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 59, "kind": "action", "text": "A drip somewhere.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 60, "kind": "action", "text": "Junior stops turning the dial.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 61, "kind": "dialogue", "text": "Marguerite. Your call.", "name": "JUNIOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 62, "kind": "action", "text": "Marguerite takes a long breath.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 63, "kind": "action", "text": "Walks toward Bertrand.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 64, "kind": "action", "text": "Stops an arm's length away.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 65, "kind": "dialogue", "text": "What if we only take half?", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 66, "kind": "dialogue", "text": "Half?", "name": "BERTRAND", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 67, "kind": "dialogue", "text": "You keep half. We sell half. You buy a new roof.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 68, "kind": "dialogue", "text": "The roof is fine.", "name": "BERTRAND", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 69, "kind": "dialogue", "text": "It's not, though. I saw the leak by the entrance.", "name": "DEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 70, "kind": "dialogue", "text": "That is a decorative leak.", "name": "BERTRAND", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 71, "kind": "dialogue", "text": "Is anybody else confused?", "name": "JUNIOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 72, "kind": "dialogue", "text": "Quiet, Junior.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 73, "kind": "action", "text": "She holds out her gloved hand.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 74, "kind": "action", "text": "Bertrand looks at it.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 75, "kind": "action", "text": "Lowers the cheese iron.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 76, "kind": "dialogue", "text": "Half.", "name": "BERTRAND", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 77, "kind": "action", "text": "He shakes.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 78, "kind": "action", "text": "The safe door clicks open behind them.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 79, "kind": "action", "text": "Junior pulls it wide.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 80, "kind": "action", "text": "Inside, nestled in straw: a single, enormous, dark wheel.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 81, "kind": "action", "text": "Everyone stares.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 82, "kind": "action", "text": "Del lifts her thermos.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 83, "kind": "dialogue", "text": "To the wife.", "name": "DEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 84, "kind": "action", "text": "They raise nothing, because they have nothing.", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 85, "kind": "action", "text": "Bertrand takes the thermos, drinks, hands it back.", "para": 19, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}