{"scene_id": "s00789_0", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00789.fountain", "heading": "EXT. SALT FLAT - TELEGRAPH STATION - NOON", "cast": [{"id": 0, "name": "ZEKE PIPKIN", "names": ["ZEKE PIPKIN", "ZEKE"], "gender": "m", "first": 4, "spoke": 6}, {"id": 1, "name": "SILAS CRANE", "names": ["SILAS CRANE", "SILAS"], "gender": "m", "first": 8, "spoke": 5}, {"id": 2, "name": "MAHALA TWOFEATHERS", "names": ["MAHALA TWOFEATHERS", "MAHALA"], "gender": "f", "first": 9, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SALT FLAT - TELEGRAPH STATION - NOON", "present": []}, {"u": 1, "kind": "action", "text": "White to the horizon.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Heat shimmers.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A sagging shack with a copper wire strung to nowhere.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ZEKE PIPKIN, 50s, telegraph operator, spectacles and sleeve garters, sits on the porch tapping a key that isn't connected to anything.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He is humming.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Hoofbeats.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Two riders emerge from the glare.", "para": 2, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "SILAS CRANE, 40s, long duster, silver at the temples, a rifle across his saddle.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Beside him, MAHALA TWOFEATHERS, 30s, braided hair, wide-brimmed hat, a coiled rope at her hip.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "They slow to a walk and dismount without speaking.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Afternoon, folks. Wire's down.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "We know.", "name": "SILAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Been down since Tuesday.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "We know that too.", "name": "MAHALA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Zeke stops tapping.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Silas ties his horse to the porch rail with one hand, the rifle still in the other.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Mahala watches the shack's window, then the roof, then the horizon, her fingers on the rope.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Where's the payroll?", "name": "SILAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Payroll?", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "The Sunday coach. The strongbox. It was routed through here.", "name": "MAHALA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Nothing came through.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Zeke.", "name": "SILAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Mr. Crane, I swear on my mother.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Your mother's dead.", "name": "MAHALA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "That's why I swear on her.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Silas steps onto the porch.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Boards groan.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "He peers through the window, then shoulders the door open.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Well.", "name": "SILAS", "speaker": 1, "ext": [], "paren": ["inside"], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "What?", "name": "MAHALA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Come look.", "name": "SILAS", "speaker": 1, "ext": [], "paren": ["inside"], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "She follows.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Zeke trails after, wringing his hands.", "para": 6, "sent": 1, "present": [0, 1, 2]}]}