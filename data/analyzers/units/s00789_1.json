{"scene_id": "s00789_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00789.fountain", "heading": "INT. TELEGRAPH STATION - CONTINUOUS", "cast": [{"id": 0, "name": "SILAS", "names": ["SILAS"], "gender": "m", "first": 6, "spoke": 10}, {"id": 1, "name": "ZEKE", "names": ["ZEKE"], "gender": "m", "first": 7, "spoke": 10}, {"id": 2, "name": "MAHALA", "names": ["MAHALA"], "gender": "f", "first": 8, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. TELEGRAPH STATION - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Dim.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A cot.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A stove.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A stack of crates labeled \"PROPERTY OF THE WELLS CONSOLIDATED.\"", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "In the middle of the floor: a heavy iron strongbox, lid open, empty.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "dialogue", "text": "You said nothing came through.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 7, "kind": "dialogue", "text": "Nothing came through. This came OUT.", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Out of what?", "name": "MAHALA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Out of the floorboards.", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Silas kneels.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Pries up a plank.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Beneath: a dark hole, a rope ladder dropping into earth.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "A tunnel.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "To where?", "name": "MAHALA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "I never looked.", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "You never looked.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "You live on top of it.", "name": "MAHALA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "I never LOOKED!", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Mahala drops to her knees.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Lowers her head into the hole.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "A pause.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Footprints.", "name": "MAHALA", "speaker": 2, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Fresh?", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Warm.", "name": "MAHALA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "She pulls out, stands, and grabs the rope off her hip.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Silas cocks the rifle.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Zeke retreats toward the stove.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Now wait a minute. Wait. If you go down there and they're still down there, I'm the one who has to explain.", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Explain what?", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Why I didn't wire it in.", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "There's no wire.", "name": "MAHALA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "No. There isn't.", "name": "ZEKE", "speaker": 1, "ext": [], "paren": ["small"], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Silas peers into the hole again.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Mahala. You take the rope. I'll go first.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "No. I go first. You're too slow.", "name": "MAHALA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "I'm not slow.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "You're thoughtful. It's a different kind of slow.", "name": "MAHALA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "She swings her legs into the hole.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Clambers down.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Silas watches her disappear, then glances at Zeke.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "You stay.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "I was going to.", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Don't touch the key.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "It's not connected.", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Don't touch it anyway.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "He lowers himself into the dark.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "The rope creaks.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "The rifle barrel scrapes the wood.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Zeke is alone.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "He drifts to the window.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Looks at the white flat.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "A line of dust far out on the salt.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Riders.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Many.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "Oh, no.", "name": "ZEKE", "speaker": 1, "ext": ["CONT'D"], "paren": ["whisper"], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "He shuts the door.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Sets the bar.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Presses his back to it, closes his eyes, and begins, softly, to hum.", "para": 9, "sent": 2, "present": [0, 1, 2]}]}