{"scene_id": "s00790", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00790.fountain", "heading": "INT. COURTHOUSE ELEVATOR - DAY", "cast": [{"id": 0, "name": "CORDELIA FAIRCHILD-NWOSU", "names": ["CORDELIA FAIRCHILD-NWOSU", "CORDELIA"], "gender": "m", "first": 4, "spoke": 7}, {"id": 1, "name": "TOBIAS REINHOLT", "names": ["TOBIAS REINHOLT", "TOBIAS"], "gender": "f", "first": 5, "spoke": 5}, {"id": 2, "name": "DESHAWN KOROMA", "names": ["DESHAWN KOROMA", "DESHAWN"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "DISPATCHER YBARRA", "names": ["DISPATCHER YBARRA", "YBARRA"], "gender": "?", "first": 16, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. COURTHOUSE ELEVATOR - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Brass.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Mirrored walls.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A floor indicator that blinks between three and four.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CORDELIA FAIRCHILD-NWOSU, 40s, defense attorney, navy suit, files hugged to her chest, rides in silence.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside her, TOBIAS REINHOLT, 30s, her client, tie knotted wrong, sweats through his shirt.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "In the corner, bailiff DESHAWN KOROMA, 50s, stands like a statue, arms crossed.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "The elevator shudders.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Stops.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "The lights dip.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Is it supposed to do that?", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Yes.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "No.", "name": "DESHAWN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Cordelia glances at him.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "He shrugs.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "A buzz crackles from the speaker panel.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Elevator two, status?", "name": "DISPATCHER YBARRA", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Stuck. Third and fourth.", "name": "DESHAWN", "speaker": 2, "ext": [], "paren": ["into panel"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Technician's twenty minutes out.", "name": "YBARRA", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Twenty? I've got a verdict at ten.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Ma'am, I don't control the building.", "name": "YBARRA", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Cordelia faces the mirror.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Tobias watches her in reflection.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Miss Fairchild. Before we go in.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Not now.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "I lied to you.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "She does not turn.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "I know.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "You know?", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "I read the file. I read the lab report you didn't mention. I've known since Tuesday.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Deshawn stares at the ceiling with great concentration.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Then why did you stay?", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Because everyone deserves a defense. Even you.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "The lights flicker.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "The elevator drops six inches and catches.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Tobias grabs the rail.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Cordelia finally turns and puts a hand on his.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "When the doors open, you say nothing. Not one word.", "name": "CORDELIA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Elevator two, repairs arriving.", "name": "YBARRA", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "The doors groan apart.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Light from the hallway.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Cordelia steps out first.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}]}