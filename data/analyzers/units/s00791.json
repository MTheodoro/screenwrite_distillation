{"scene_id": "s00791", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00791.fountain", "heading": "INT. HOTEL BALLROOM - AFTER THE WEDDING - NIGHT", "cast": [{"id": 0, "name": "WOMAN", "names": ["WOMAN"], "gender": "?", "first": 10, "spoke": 3}, {"id": 1, "name": "CATALINA", "names": ["CATALINA"], "gender": "?", "first": 25, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOTEL BALLROOM - AFTER THE WEDDING - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Folding chairs askew.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A deflated balloon arch.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Half-eaten cake under a plastic dome.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Streamers on the floor like cut ribbon.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The chandelier still burns, as if nobody has told it.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "Nothing moves.", "para": 1, "sent": 0, "present": []}, {"u": 7, "kind": "action", "text": "A clock ticks.", "para": 1, "sent": 1, "present": []}, {"u": 8, "kind": "action", "text": "A side door opens.", "para": 2, "sent": 0, "present": []}, {"u": 9, "kind": "action", "text": "Heels on parquet.", "para": 2, "sent": 1, "present": []}, {"u": 10, "kind": "action", "text": "A WOMAN in a green evening dress, 50s, steps in, shoes in hand.", "para": 3, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "Mascara tracked down one cheek.", "para": 3, "sent": 1, "present": [0]}, {"u": 12, "kind": "action", "text": "She surveys the wreckage and her mouth tightens.", "para": 3, "sent": 2, "present": [0]}, {"u": 13, "kind": "action", "text": "She crosses to the head table.", "para": 4, "sent": 0, "present": [0]}, {"u": 14, "kind": "action", "text": "Finds a tape recorder among the centerpieces, the kind guests were meant to speak into.", "para": 4, "sent": 1, "present": [0]}, {"u": 15, "kind": "action", "text": "She lifts it.", "para": 4, "sent": 2, "present": [0]}, {"u": 16, "kind": "action", "text": "Examines it.", "para": 4, "sent": 3, "present": [0]}, {"u": 17, "kind": "action", "text": "Presses record.", "para": 4, "sent": 4, "present": [0]}, {"u": 18, "kind": "dialogue", "text": "Testing. One, two.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 19, "kind": "action", "text": "She stops.", "para": 5, "sent": 0, "present": [0]}, {"u": 20, "kind": "action", "text": "Rewinds.", "para": 5, "sent": 1, "present": [0]}, {"u": 21, "kind": "action", "text": "Plays back.", "para": 5, "sent": 2, "present": [0]}, {"u": 22, "kind": "dialogue", "text": "Testing. One, two.", "name": "WOMAN", "speaker": 0, "ext": ["V.O."], "paren": ["recorded, faint"], "dual": false, "present": [0]}, {"u": 23, "kind": "action", "text": "She nods.", "para": 6, "sent": 0, "present": [0]}, {"u": 24, "kind": "action", "text": "Records again.", "para": 6, "sent": 1, "present": [0]}, {"u": 25, "kind": "dialogue", "text": "This is Catalina Rousseau-Mbeki, mother of the groom. I would like to say something I didn't say at the toast.", "name": "WOMAN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "She stops.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Her jaw works.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "She sits on the edge of the stage.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "I'm sorry I wore green. I was told it wasn't hers.", "name": "CATALINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "She lowers the recorder to her lap.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Looks at the cake.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Rewinds.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Plays the last of it.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "I'm sorry I wore green.", "name": "CATALINA", "speaker": 1, "ext": ["V.O."], "paren": ["recorded"], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "A phone rings in her purse.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "She lets it ring.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "It rings again.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Not tonight.", "name": "CATALINA", "speaker": 1, "ext": [], "paren": ["to the ceiling"], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "The phone stops.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "She raises the recorder.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "He looked happy. That's all. Remember that. He looked happy.", "name": "CATALINA", "speaker": 1, "ext": ["CONT'D"], "paren": ["to the tape"], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "She sets the recorder on the stage, still running.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Picks up her shoes.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "Crosses to the exit.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "At the door, she turns off the chandelier switch.", "para": 11, "sent": 3, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Darkness.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "A tiny red light glows on the stage.", "para": 12, "sent": 1, "present": [0, 1]}]}