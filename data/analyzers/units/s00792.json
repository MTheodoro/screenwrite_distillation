{"scene_id": "s00792", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00792.fountain", "heading": "INT. STARLITE LANES - BOWLING ALLEY - NIGHT", "cast": [{"id": 0, "name": "PHOEBE ADEBAYO", "names": ["PHOEBE ADEBAYO", "PHOEBE"], "gender": "f", "first": 6, "spoke": 5}, {"id": 1, "name": "KENJI MORIKAWA", "names": ["KENJI MORIKAWA", "KENJI"], "gender": "?", "first": 7, "spoke": 2}, {"id": 2, "name": "LOCKY", "names": ["LOCKY"], "gender": "m", "first": 8, "spoke": 2}, {"id": 3, "name": "DUNMORE", "names": ["DUNMORE"], "gender": "?", "first": 8, "spoke": 0}, {"id": 4, "name": "BEATRIX SOKOLOWSKI", "names": ["BEATRIX SOKOLOWSKI", "BEATRIX"], "gender": "f", "first": 9, "spoke": 3}, {"id": 5, "name": "COSMO ABARA", "names": ["COSMO ABARA", "COSMO"], "gender": "?", "first": 10, "spoke": 3}, {"id": 6, "name": "HORACE LINDQVIST", "names": ["HORACE LINDQVIST", "HORACE"], "gender": "m", "first": 11, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. STARLITE LANES - BOWLING ALLEY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "The neon is half dead.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Lane nine glows pink.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A disco ball turns slowly over the shoe counter, throwing coins of light across a carpet printed with comets.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "It smells of fryer oil and rental-shoe disinfectant.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The last night of high school, and the party has thinned to six.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "PHOEBE ADEBAYO, 18, still in her cap and gown, kneels on lane six and rolls the ball down the gutter on purpose.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "KENJI MORIKAWA, 18, tie around his forehead, sits on the ball return and watches her.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "LACHLAN \"LOCKY\" DUNMORE, 18, hair gelled for an event that has ended, flips a keychain in one hand.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "BEATRIX SOKOLOWSKI, 17, writes in a notebook with her tongue between her teeth.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "COSMO ABARA, 18, who sold the most tickets to the dance and attended none of it, eats fries from a paper boat.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "HORACE LINDQVIST, 60s, the night manager, leans on the counter with a rag over his shoulder and counts a cash drawer.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "Last frame, kids. I'm closing.", "name": "HORACE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "Five more minutes, Mr. Lindqvist.", "name": "PHOEBE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "That's what you said at the last five.", "name": "HORACE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "Mr. Lindqvist, this is history.", "name": "KENJI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "It's a Tuesday.", "name": "HORACE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "It's a Tuesday in history.", "name": "BEATRIX", "speaker": 4, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "action", "text": "Locky tosses his keys.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "action", "text": "Cosmo catches them in a fry.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "action", "text": "A beat.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "action", "text": "Everyone looks at the fry-wrapped keys.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "I regret nothing.", "name": "COSMO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "Those are my dad's keys.", "name": "LOCKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "Then I regret one thing.", "name": "COSMO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "action", "text": "Phoebe lines up the ball again.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "action", "text": "Kenji slides off the return.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "Beatrix closes the notebook.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "Okay. Real talk.", "name": "BEATRIX", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "Oh no.", "name": "PHOEBE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "Does anyone actually know what they're doing in September?", "name": "BEATRIX", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "Michigan.", "name": "KENJI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "Shop. My uncle's.", "name": "LOCKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "Community college. Then, like, the world.", "name": "COSMO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "Nothing.", "name": "PHOEBE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "They look at her.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "I don't know. Nothing's planned. That's the plan.", "name": "PHOEBE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "The disco ball turns.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "Light slides across their faces, one by one.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "Last call. Or I turn off lane six.", "name": "HORACE", "speaker": 6, "ext": [], "paren": ["calling"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "Phoebe takes a breath.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "Rolls the ball.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "It wobbles, wobbles, and drifts toward the pins.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "Nobody breathes.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "It hits the head pin, perfect.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "action", "text": "Pins explode.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "action", "text": "STRIKE flashes on the screen in dying neon.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "They don't cheer.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "They stand there, grinning, like people who have just remembered how.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "dialogue", "text": "Huh.", "name": "PHOEBE", "speaker": 0, "ext": ["CONT'D"], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}