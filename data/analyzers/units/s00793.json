{"scene_id": "s00793", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00793.fountain", "heading": "INT. MINIVAN - TOLL PLAZA - DAY", "cast": [{"id": 0, "name": "GERALD OKONJO-HART", "names": ["GERALD OKONJO-HART", "GERALD"], "gender": "m", "first": 4, "spoke": 4}, {"id": 1, "name": "SUNITA", "names": ["SUNITA"], "gender": "f", "first": 5, "spoke": 3}, {"id": 2, "name": "GUS", "names": ["GUS"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "PIPER", "names": ["PIPER"], "gender": "f", "first": 7, "spoke": 1}, {"id": 4, "name": "GRANDMA BERNADETTE", "names": ["GRANDMA BERNADETTE"], "gender": "?", "first": 8, "spoke": 3}, {"id": 5, "name": "TOLL ATTENDANT", "names": ["TOLL ATTENDANT", "ATTENDANT"], "gender": "?", "first": 13, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. MINIVAN - TOLL PLAZA - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Crammed.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Juice boxes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A dashboard phone holder with a call in progress.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "GERALD OKONJO-HART, 40s, grips the wheel.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "SUNITA, 40s, wedges a map between her knees.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "In the back, GUS, 10, kicks the seat.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "PIPER, 14, stares at her phone.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Are you there yet? Dinner's getting cold.", "name": "GRANDMA BERNADETTE", "speaker": 4, "ext": ["V.O."], "paren": ["over speaker"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "We're at the toll, Mom.", "name": "GERALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Mom, tell Piper to stop breathing on me.", "name": "GUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "I'm not even close.", "name": "PIPER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Both of you. Quiet.", "name": "SUNITA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "At the booth, a TOLL ATTENDANT, 20s, leans out.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "He eyes the van's tangle of wires and limbs.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Four fifty.", "name": "ATTENDANT", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Gerald pats his pocket.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Pats the other.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Pats the dashboard.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Sunita. Wallet?", "name": "GERALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "You had it.", "name": "SUNITA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "I gave it to you.", "name": "GERALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "You gave me nothing.", "name": "SUNITA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Is that a toll? Gerald, I told you to take the back road!", "name": "GRANDMA BERNADETTE", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "The van behind them honks.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Then another.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Gus presses the window button.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Dollar bills and napkins fly out.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "The attendant snatches one.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "That's a coupon for sandwiches.", "name": "ATTENDANT", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Is it good?", "name": "GUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Buy one get one.", "name": "ATTENDANT", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "He waves them through.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Gerald stares at him.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "The bar lifts.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Did you pay?", "name": "GRANDMA BERNADETTE", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "We did, Mom. Sort of.", "name": "GERALD", "speaker": 0, "ext": [], "paren": ["driving away"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}