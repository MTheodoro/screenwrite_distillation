{"scene_id": "s00794", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00794.fountain", "heading": "INT. EMPTY COURTROOM - EVENING", "cast": [{"id": 0, "name": "ALISTAIR VAN TONGEREN", "names": ["ALISTAIR VAN TONGEREN", "ALISTAIR"], "gender": "m", "first": 4, "spoke": 9}, {"id": 1, "name": "ROXANNE KIPCHOGE", "names": ["ROXANNE KIPCHOGE", "ROXANNE"], "gender": "?", "first": 5, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. EMPTY COURTROOM - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Rows of oak benches.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The jury box sits dark.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single banker's lamp glows on the bench.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ALISTAIR VAN TONGEREN, 50s, prosecutor, rehearses before the empty jury box, one hand on the rail.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "ROXANNE KIPCHOGE, 40s, defense counsel, sits in the gallery eating sunflower seeds from a paper cone.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "She does not interrupt.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Ladies and gentlemen of the jury.", "name": "ALISTAIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He pauses to let them settle.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "No one is there.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He lets them settle anyway.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "You will hear that my opponent's client is a good man. A family man. A man who coaches Little League.", "name": "ALISTAIR", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Roxanne cracks a seed.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Twelve years.", "name": "ROXANNE", "speaker": 1, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "You're not allowed to heckle the dress rehearsal.", "name": "ALISTAIR", "speaker": 0, "ext": [], "paren": ["not turning"], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I'm not heckling. I'm counting.", "name": "ROXANNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He turns.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Leans against the rail.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "You're early.", "name": "ALISTAIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "So are you.", "name": "ROXANNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "I'm an early man.", "name": "ALISTAIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "You're a nervous man.", "name": "ROXANNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Alistair straightens his tie.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Looks at the empty seats.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Ladies and gentlemen. The evidence will show...", "name": "ALISTAIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "The evidence will show a boy with a wrench and a bad alibi.", "name": "ROXANNE", "speaker": 1, "ext": [], "paren": ["over him"], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Roxanne.", "name": "ALISTAIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Alistair.", "name": "ROXANNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "She drops the cone.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Stands.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "My client didn't do it.", "name": "ROXANNE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Then prove it.", "name": "ALISTAIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "That's your job to disprove, remember?", "name": "ROXANNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "God help us both.", "name": "ALISTAIR", "speaker": 0, "ext": [], "paren": ["under his breath"], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "He gathers his notes.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "She walks to the defense table and sits.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "He sits at the prosecution's.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "The lamp hums between them.", "para": 7, "sent": 3, "present": [0, 1]}]}