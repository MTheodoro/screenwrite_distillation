{"scene_id": "s00795", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00795.fountain", "heading": "INT. FLORIST'S WALK-IN COOLER - NIGHT", "cast": [{"id": 0, "name": "DETECTIVE IMELDA STROUD", "names": ["DETECTIVE IMELDA STROUD", "IMELDA"], "gender": "?", "first": 5, "spoke": 28}, {"id": 1, "name": "KARINA VOLKOVA", "names": ["KARINA VOLKOVA", "KARINA"], "gender": "f", "first": 7, "spoke": 27}], "units": [{"u": 0, "kind": "heading", "text": "INT. FLORIST'S WALK-IN COOLER - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Buckets of lilies.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Roses in sleeves.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Cold fog off the compressor.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single caged bulb.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DETECTIVE IMELDA STROUD, 40s, gloves, trench coat, closes the door and lets it click.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She leans on a shelf of carnations.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "KARINA VOLKOVA, 30s, florist, apron stained green, stands rigid with a pair of pruning shears in both hands.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Put those down.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "No.", "name": "KARINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Karina.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "You said you were alone.", "name": "KARINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I am alone.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "You said you'd tell no one.", "name": "KARINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "I haven't.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Karina's eyes flick to the door.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "To the shears.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Back.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "He's going to find out.", "name": "KARINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Who?", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "You know who.", "name": "KARINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Say his name.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Karina shakes her head.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Her knuckles whiten on the handles.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Then say what he did.", "name": "IMELDA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "He bought the van. He bought the van, and the lilies, and the church.", "name": "KARINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Which church?", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "St. Anselm's. He bought the whole front pew.", "name": "KARINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Imelda takes a step.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Karina lifts the shears.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Imelda stops.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "You think I'm here to arrest you.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Aren't you?", "name": "KARINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "No.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Then why the gloves?", "name": "KARINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "It's twenty degrees in here.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "A pause.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "A drip.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "The compressor hums.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Oh.", "name": "KARINA", "speaker": 1, "ext": [], "paren": ["small"], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Karina lowers the shears an inch.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Imelda holds out a hand, palm up.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Give them to me.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "No.", "name": "KARINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "I'll give them back.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "You won't.", "name": "KARINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "I will. When this is over.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Karina laughs, a short bitter sound.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "It's never over.", "name": "KARINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "It's over when you testify.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "He has a brother.", "name": "KARINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "I know about the brother.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "He has a cousin on the force.", "name": "KARINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "I know about the cousin.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "Do you know about the judge?", "name": "KARINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "Imelda goes still.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "No.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "Judge Morales buys flowers every Sunday. Lilies. Always lilies.", "name": "KARINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "Imelda exhales a long white plume.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "Takes off one glove.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "Thank you.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "She extends her bare hand again.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "Karina studies it.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "The shears slip a little.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "He'll know it was me.", "name": "KARINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "Not if you walk out of here with a bouquet and a smile.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "I don't smile.", "name": "KARINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "You'll learn.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "Karina drops the shears into a bucket of water.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "They sink.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 70, "kind": "action", "text": "She wipes her palms on her apron, trembling.", "para": 12, "sent": 2, "present": [0, 1]}, {"u": 71, "kind": "dialogue", "text": "I'm so tired.", "name": "KARINA", "speaker": 1, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1]}, {"u": 72, "kind": "dialogue", "text": "I know.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 73, "kind": "dialogue", "text": "Do you?", "name": "KARINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 74, "kind": "dialogue", "text": "My sister ran a shop like this.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 75, "kind": "dialogue", "text": "What happened?", "name": "KARINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 76, "kind": "dialogue", "text": "She stopped being afraid.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 77, "kind": "dialogue", "text": "And?", "name": "KARINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 78, "kind": "dialogue", "text": "She sleeps now.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 79, "kind": "action", "text": "Karina lets out a ragged breath.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 80, "kind": "action", "text": "A smile, almost.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 81, "kind": "action", "text": "She sits on an overturned crate.", "para": 13, "sent": 2, "present": [0, 1]}, {"u": 82, "kind": "action", "text": "Imelda sits on another.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 83, "kind": "action", "text": "Their knees nearly touch.", "para": 14, "sent": 1, "present": [0, 1]}, {"u": 84, "kind": "dialogue", "text": "Can I have a cigarette?", "name": "KARINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 85, "kind": "dialogue", "text": "No smoking near the lilies.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 86, "kind": "dialogue", "text": "Right. Sorry.", "name": "KARINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 87, "kind": "dialogue", "text": "Take this instead.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 88, "kind": "action", "text": "She pulls a peppermint from her pocket.", "para": 15, "sent": 0, "present": [0, 1]}, {"u": 89, "kind": "action", "text": "Karina unwraps it.", "para": 15, "sent": 1, "present": [0, 1]}, {"u": 90, "kind": "action", "text": "Puts it in her mouth.", "para": 15, "sent": 2, "present": [0, 1]}, {"u": 91, "kind": "action", "text": "They sit like that.", "para": 16, "sent": 0, "present": [0, 1]}, {"u": 92, "kind": "action", "text": "The fog drifts.", "para": 16, "sent": 1, "present": [0, 1]}, {"u": 93, "kind": "action", "text": "The compressor cycles off.", "para": 16, "sent": 2, "present": [0, 1]}, {"u": 94, "kind": "action", "text": "Silence settles, soft as pollen.", "para": 16, "sent": 3, "present": [0, 1]}, {"u": 95, "kind": "dialogue", "text": "Tomorrow?", "name": "KARINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 96, "kind": "dialogue", "text": "Tomorrow.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 97, "kind": "action", "text": "Karina nods once.", "para": 17, "sent": 0, "present": [0, 1]}, {"u": 98, "kind": "action", "text": "Pulls a single white lily from a bucket.", "para": 17, "sent": 1, "present": [0, 1]}, {"u": 99, "kind": "action", "text": "Hands it over.", "para": 17, "sent": 2, "present": [0, 1]}, {"u": 100, "kind": "dialogue", "text": "For the front pew.", "name": "KARINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}