{"scene_id": "s00796", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00796.fountain", "heading": "INT. GLACIER CREVASSE - ICE CHAMBER - DAY", "cast": [{"id": 0, "name": "THEO MARSH-ADEYEMI", "names": ["THEO MARSH-ADEYEMI", "THEO"], "gender": "m", "first": 5, "spoke": 7}, {"id": 1, "name": "ISOLDE KARLSEN", "names": ["ISOLDE KARLSEN", "ISOLDE"], "gender": "f", "first": 6, "spoke": 12}, {"id": 2, "name": "BO PETRAKIS", "names": ["BO PETRAKIS", "BO"], "gender": "m", "first": 7, "spoke": 9}, {"id": 3, "name": "COORDINATOR NAKAGAWA", "names": ["COORDINATOR NAKAGAWA", "NAKAGAWA"], "gender": "?", "first": 31, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. GLACIER CREVASSE - ICE CHAMBER - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Blue light filtered through forty feet of ice.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The walls drip in slow, patient beads.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A shelf of old snow juts out above a bottomless dark.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Three climbers lie wedged where the fall stopped them, their breath rising like prayers.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "THEO MARSH-ADEYEMI, 40s, broad-shouldered, rope burn weeping through his glove, props himself against the wall.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Beside him ISOLDE KARLSEN, 30s, wiry, a headlamp dangling from her wrist, ties a sling from a torn jacket.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "A few feet farther BO PETRAKIS, 19, the youngest, sits with knees to chest and stares at his boots as if they might be someone else's.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "An old handheld radio lies in Isolde's lap, wrapped in a glove for warmth.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Hold still, Theo.", "name": "ISOLDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I am still.", "name": "THEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "You're shaking.", "name": "ISOLDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "That's the cold.", "name": "THEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "That's your shoulder.", "name": "ISOLDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "She ties the knot.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "He hisses.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "The ice around them creaks softly.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Bo lifts his head.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Is it supposed to do that?", "name": "BO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "The ice? It sings. It means it's alive.", "name": "THEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I don't like it.", "name": "BO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Nobody does.", "name": "THEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Isolde unwraps the radio, thumbs the switch.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "A hiss of static, thin as a thread.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Rescue, Rescue, this is Karlsen. Do you copy?", "name": "ISOLDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Static.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "She waits.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "The ice drips.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Rescue, Rescue. Three alive. Repeat, three alive.", "name": "ISOLDE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "A long hiss.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Then, faint:", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Karlsen, Nakagawa. Read you weak. Say position.", "name": "COORDINATOR NAKAGAWA", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Isolde closes her eyes, one second, as though she has been holding her breath since morning.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Crevasse, east of the col. Approximately forty feet down. One injured, shoulder.", "name": "ISOLDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Copy. Helicopter is grounded. Weather. Ground team is four hours out.", "name": "NAKAGAWA", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Theo says nothing.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Bo's boots go suddenly very interesting.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Four hours.", "name": "ISOLDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Conserve heat. Conserve battery. Do not sleep.", "name": "NAKAGAWA", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Understood.", "name": "ISOLDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "You'll be fine, Isolde. I mean that.", "name": "NAKAGAWA", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "She smiles, the kind of smile that has no use for the words.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "We'll be here.", "name": "ISOLDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "She turns the radio off.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Sets it back in the glove.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Slides over to Bo, shoulder to shoulder.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Four hours.", "name": "BO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "That's nothing.", "name": "ISOLDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "It feels like a year.", "name": "BO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Then tell me a story.", "name": "ISOLDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "I don't have one.", "name": "BO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Everyone has one.", "name": "THEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Mine's boring.", "name": "BO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Good. Boring is what we want.", "name": "THEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Bo almost laughs.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "The sound dies in his throat and becomes a small cough.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "When I was eight, my dog got lost in a snowstorm.", "name": "BO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "Did you find her?", "name": "ISOLDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "He came home on his own, three days later. Covered in ice.", "name": "BO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "Smart dog.", "name": "THEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "Stubborn.", "name": "BO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "The ice sings again, softer.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "Theo leans his head back.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "Overhead, a thread of light from the crevasse mouth slides across the wall, slow as a minute hand, and begins to fade.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}]}