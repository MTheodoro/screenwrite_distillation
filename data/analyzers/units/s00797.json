{"scene_id": "s00797", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00797.fountain", "heading": "INT. UNDERWATER HOCKEY POOL - NIGHT", "cast": [{"id": 0, "name": "COACH BEVERLY STANISLAUS", "names": ["COACH BEVERLY STANISLAUS", "BEVERLY"], "gender": "f", "first": 5, "spoke": 2}, {"id": 1, "name": "RUSLAN VOLODIN", "names": ["RUSLAN VOLODIN", "RUSLAN"], "gender": "m", "first": 6, "spoke": 4}, {"id": 2, "name": "LOTTIE FAIRBANKS", "names": ["LOTTIE FAIRBANKS", "LOTTIE"], "gender": "?", "first": 7, "spoke": 2}, {"id": 3, "name": "DEWAYNE PICKETT", "names": ["DEWAYNE PICKETT", "DEWAYNE"], "gender": "f", "first": 7, "spoke": 4}, {"id": 4, "name": "PHAM", "names": ["PHAM"], "gender": "m", "first": 8, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. UNDERWATER HOCKEY POOL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Chlorine haze.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A tiled deck.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Six lanes taped off with orange cones.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Snorkels and fins in rows along the wall.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "COACH BEVERLY STANISLAUS, 50s, whistle between her teeth, paces the deck.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "RUSLAN VOLODIN, 20s, the team captain, sits on the edge with his feet in the water, taping his stick.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "LOTTIE FAIRBANKS, 19, adjusts her mask, while DEWAYNE PICKETT, 22, the goalie, bounces on his toes and glares at the scoreboard.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "On the far side, MR. PHAM, 40s, the referee, in a black-and-white striped rash guard, checks his watch and says nothing.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "Beverly stops pacing.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "She blows the whistle once.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Ruslan looks up.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Lottie flinches.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Dewayne turns from the board and starts toward her, but she holds up a hand and he stops.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Four seconds on the clock. Down one. Who wants it?", "name": "BEVERLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "I do.", "name": "RUSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "You always do.", "name": "DEWAYNE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Somebody has to.", "name": "RUSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "I'll take it, Coach.", "name": "LOTTIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "You'll take the pass.", "name": "BEVERLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "That's what I said.", "name": "LOTTIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "That's not what you said.", "name": "DEWAYNE", "speaker": 3, "ext": [], "paren": ["under his breath"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Lottie's mask snaps down.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Ruslan rises, water streaming off his legs.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Say it again, Dewayne.", "name": "RUSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "I said it was a bad idea. Four seconds, one shot, all on you.", "name": "DEWAYNE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Then block better.", "name": "RUSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "I'm a goalie, not a miracle.", "name": "DEWAYNE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Beverly steps between them.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Pham finally blows his own whistle, a thin shriek.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Everyone turns.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Gentlemen. Ladies. Positions.", "name": "PHAM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "They slip into the water in single file, silent.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Beverly stands on the deck, hands on her hips, watching the surface close over their heads.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Under the lights, the pool goes still.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Then a ripple.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Then a roar of bubbles.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}]}