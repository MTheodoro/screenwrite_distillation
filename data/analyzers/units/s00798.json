{"scene_id": "s00798", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00798.fountain", "heading": "INT. PLANETARIUM DOME - NIGHT", "cast": [{"id": 0, "name": "ARCHIE SOLOMONS", "names": ["ARCHIE SOLOMONS", "ARCHIE"], "gender": "?", "first": 4, "spoke": 11}, {"id": 1, "name": "BILLIE CROSS", "names": ["BILLIE CROSS", "BILLIE"], "gender": "?", "first": 5, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. PLANETARIUM DOME - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Empty rows of recliners.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The ceiling swims with painted stars.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A projector the size of a dumbbell hums at the center.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ARCHIE SOLOMONS, 40s, black turtleneck, wire cutters, hangs upside down from a catwalk and works on a panel.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "BILLIE CROSS, 30s, bandana, pushes a cart of equipment between the seats.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Billie. Light.", "name": "ARCHIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Archie, we're in a planetarium.", "name": "BILLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "So?", "name": "ARCHIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "So it's a room full of light.", "name": "BILLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Not that kind. Flashlight.", "name": "ARCHIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She tosses one up.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He catches it with his teeth.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Gross.", "name": "BILLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Efficient.", "name": "ARCHIE", "speaker": 0, "ext": [], "paren": ["mumbling around it"], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "He yanks a wire.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "The stars flicker.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "The dome goes dark for an instant, then returns as a different sky.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "That's not our constellation.", "name": "BILLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "It's Orion's cousin.", "name": "ARCHIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Orion doesn't have cousins.", "name": "BILLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Everybody has cousins, Billie.", "name": "ARCHIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "She rolls the cart under the projector.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Pops its lid.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Inside, a velvet-lined case.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Inside the case: a glittering meteorite, black as oil.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "There she is.", "name": "BILLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Don't breathe on it.", "name": "ARCHIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "I'm not breathing.", "name": "BILLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "You're breathing loudly.", "name": "ARCHIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "She holds her breath.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Slides the rock into a lead bag.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "The dome shivers.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Music swells.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "The stars begin to wheel on a timer.", "para": 5, "sent": 4, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "They freeze.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Archie drops from the catwalk.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Lands in a crouch.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Out. Now.", "name": "ARCHIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Archie.", "name": "BILLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "What?", "name": "ARCHIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "That was only the nine o'clock show on a timer.", "name": "BILLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Oh.", "name": "ARCHIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}