{"scene_id": "s00799", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00799.fountain", "heading": "INT. MERIDIAN DYNAMICS - \"SYNERGY POD\" - DAY", "cast": [{"id": 0, "name": "PRISCILLA NWANKWO", "names": ["PRISCILLA NWANKWO", "PRISCILLA"], "gender": "f", "first": 2, "spoke": 6}, {"id": 1, "name": "GARETH BLOUNT-SATO", "names": ["GARETH BLOUNT-SATO", "GARETH"], "gender": "?", "first": 6, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. MERIDIAN DYNAMICS - \"SYNERGY POD\" - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A windowless closet with two beanbags, a motivational poster of a rowing team, and a whiteboard that reads \"BRAINSTORM!!\" in a hand that gave up.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "PRISCILLA NWANKWO, 30s, lanyard with seven badges, sits cross-legged on a beanbag with a laptop balanced on her knees.", "para": 1, "sent": 0, "present": [0]}, {"u": 3, "kind": "action", "text": "She types, deletes, types.", "para": 1, "sent": 1, "present": [0]}, {"u": 4, "kind": "action", "text": "A sticky note on her forehead reads \"SYNERGY.\"", "para": 1, "sent": 2, "present": [0]}, {"u": 5, "kind": "action", "text": "The door opens.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "GARETH BLOUNT-SATO, 40s, vest over a tie, enters with a clipboard and a smile that has never been challenged.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He doesn't knock.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He never has.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Priscilla! How's the pod?", "name": "GARETH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Small.", "name": "PRISCILLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Cozy! Love it. I'm doing the quarterly culture walk. Are you feeling aligned?", "name": "GARETH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I'm feeling beanbagged.", "name": "PRISCILLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Gareth laughs a hair too loud.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He lowers himself onto the second beanbag, which sighs under him and lowers him farther than he intended.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "He flails, recovers, writes something on the clipboard, then holds it up so she can see: a smiley face with a frown on its forehead.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Quick pulse check. Scale of one to ten, how much do you love Meridian?", "name": "GARETH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Is this for HR?", "name": "PRISCILLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "It's for me.", "name": "GARETH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Seven.", "name": "PRISCILLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Seven is fantastic. Seven means we have room to grow.", "name": "GARETH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She slides her laptop around.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "On it, a spreadsheet: a column of resignation dates, hers the first.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "It's a two on Friday.", "name": "PRISCILLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Interesting. Interesting. Interesting.", "name": "GARETH", "speaker": 1, "ext": [], "paren": ["reading, still smiling"], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "He peels off the sticky note she's been wearing and sticks it to the clipboard.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Stands.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "The beanbag releases him with a soft sound.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Let's circle back Monday.", "name": "GARETH", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "I'll be at the lake.", "name": "PRISCILLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}