{"scene_id": "s00800", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00800.fountain", "heading": "INT. P\u00c2TISSERIE DU MATIN - BACK ROOM - PRE-DAWN", "cast": [{"id": 0, "name": "LEONID TARASOV", "names": ["LEONID TARASOV", "LEONID"], "gender": "m", "first": 5, "spoke": 6}, {"id": 1, "name": "CASPIAN ROWE", "names": ["CASPIAN ROWE", "CASPIAN"], "gender": "m", "first": 6, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. P\u00c2TISSERIE DU MATIN - BACK ROOM - PRE-DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Flour on every surface.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cooling racks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A walk-in oven the size of a closet.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "In the corner, a three-tier wedding cake on a steel cart.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LEONID TARASOV, 40s, ski mask pushed up on his forehead, wedges a crowbar under the cake's base.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "CASPIAN ROWE, 30s, glasses, gloves, stands guard at the door with a cold coffee.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Leo. It's a cake.", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "It's a safe.", "name": "LEONID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "It's a cake with a safe in it.", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Which makes it a safe.", "name": "LEONID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He pries.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "The base creaks.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "A hidden panel pops.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Inside: a small steel door, a keypad.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Four digits.", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Try his birthday.", "name": "LEONID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "He's seventy.", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Try it.", "name": "LEONID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Caspian punches in numbers.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Nothing.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "He tries again.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "A red light flashes.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "A tiny alarm warbles inside the cake.", "para": 3, "sent": 4, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "They freeze.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Leonid grabs the cake.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Caspian grabs Leonid.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "They topple into the cart, tier two sliding off and splattering across the floor in a wet pink avalanche.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "The alarm dies.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Both men lie in frosting.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "You did that.", "name": "LEONID", "speaker": 0, "ext": ["CONT'D"], "paren": ["whisper"], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "You pushed me!", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "You grabbed me!", "name": "LEONID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "They scramble up, slipping.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Leonid lunges for the keypad.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Caspian shoves him aside, jabs at the buttons.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "The light turns green.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "The little door swings open.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Inside: a single plastic bag, a scribbled note.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Caspian reads it aloud.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "\"Nice try. -Mom.\"", "name": "CASPIAN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "They stare at each other.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Frosting drips from both their chins.", "para": 9, "sent": 1, "present": [0, 1]}]}