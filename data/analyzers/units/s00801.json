{"scene_id": "s00801", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00801.fountain", "heading": "EXT. HOT-AIR BALLOON - THREE THOUSAND FEET - DAWN", "cast": [{"id": 0, "name": "PERPETUA VANCE-OLUWOLE", "names": ["PERPETUA VANCE-OLUWOLE", "PERPETUA"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "ARABELLA HOLT", "names": ["ARABELLA HOLT", "ARABELLA"], "gender": "f", "first": 5, "spoke": 4}, {"id": 2, "name": "MURDOCH ABERNETHY", "names": ["MURDOCH ABERNETHY", "MURDOCH"], "gender": "f", "first": 6, "spoke": 4}, {"id": 3, "name": "FITZ", "names": ["FITZ"], "gender": "?", "first": 6, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. HOT-AIR BALLOON - THREE THOUSAND FEET - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A wicker basket the size of a small closet swings under a great striped envelope of orange and teal.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fields below are a quilt of green.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The burner roars, rests, roars again.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "PERPETUA VANCE-OLUWOLE, 50s, pilot, leather cap and a scarf the length of a river, works the valve and looks at no one.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside her, ARABELLA HOLT, 40s, passenger in a sequined jacket, clutches the rim with white knuckles.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "At the far side MURDOCH ABERNETHY, 60s, her father-in-law, dozes upright against a sandbag, and FITZ, 20s, deckhand, practically a vine, clings to a rigging line with a grin that will not stay on.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "We're at altitude, folks. Enjoy the view.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": ["to the basket, all of them"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Arabella lets out a very small scream.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Fitz applauds.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Is it over?", "name": "MURDOCH", "speaker": 2, "ext": [], "paren": ["waking"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "No, Murdoch.", "name": "ARABELLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Then why am I awake?", "name": "MURDOCH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Three thousand feet, two idiots, and a prayer.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Arabella glares at her.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Perpetua fires the burner with a cheerful roar.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Excuse me?", "name": "ARABELLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Nothing.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "You can see your house from here!", "name": "FITZ", "speaker": 3, "ext": [], "paren": ["to Murdoch"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "I sold my house.", "name": "MURDOCH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "You can see the new owner's house!", "name": "FITZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Murdoch peers over the rim.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Squints.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Nods slowly.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "He mowed the lawn badly.", "name": "MURDOCH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Can we land now? Please?", "name": "ARABELLA", "speaker": 1, "ext": [], "paren": ["to everyone, brittle"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Landing's a negotiation, dear.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "With whom?", "name": "ARABELLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "The wind.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "A gust shoves the basket sideways.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Arabella shrieks and drops to her knees.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Murdoch grabs her sequined shoulder, delighted.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Fitz whoops.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Perpetua, unbothered, adjusts the valve.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}]}