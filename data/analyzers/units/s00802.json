{"scene_id": "s00802", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00802.fountain", "heading": "INT. GOLDEN TIGER KARAOKE - PRIVATE ROOM 4 - NIGHT", "cast": [{"id": 0, "name": "MINH-ANH LE", "names": ["MINH-ANH LE", "MINH-ANH"], "gender": "f", "first": 5, "spoke": 2}, {"id": 1, "name": "DUKE FONTENOT", "names": ["DUKE FONTENOT", "DUKE"], "gender": "m", "first": 6, "spoke": 4}, {"id": 2, "name": "TANYA FROST", "names": ["TANYA FROST", "TANYA"], "gender": "m", "first": 7, "spoke": 2}, {"id": 3, "name": "INES CALDER", "names": ["INES CALDER", "INES"], "gender": "?", "first": 8, "spoke": 3}, {"id": 4, "name": "MAN IN LEATHER COAT", "names": ["MAN", "MAN IN LEATHER COAT"], "gender": "?", "first": 9, "spoke": 3}, {"id": 5, "name": "LEATHER COAT", "names": ["LEATHER COAT"], "gender": "?", "first": 9, "spoke": 0}, {"id": 6, "name": "CASIMIR", "names": ["CASIMIR"], "gender": "?", "first": 27, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. GOLDEN TIGER KARAOKE - PRIVATE ROOM 4 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Velvet booths.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A neon tiger glows on the wall.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A screen shows lyrics to a song nobody is singing.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "On the table: a bucket of ice, a tray of cheap whiskey, and a leather briefcase.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MINH-ANH LE, 30s, black dress, sits very still and watches the door.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "DUKE FONTENOT, 50s, linen jacket, rotates a microphone in his hands like a cigar.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "TANYA FROST, 40s, beside him, shuffles a deck of cards without looking at them.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "INES CALDER\u00d3N, 20s, the room's waitress, hovers with a tray and a wary smile.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "A MAN IN A LEATHER COAT, 50s, comes in without knocking.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "He shuts the door gently behind him.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Evening, all.", "name": "MAN IN LEATHER COAT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "You're early.", "name": "DUKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "You're late.", "name": "MAN IN LEATHER COAT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "He drops into the booth.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Takes a glass off Ines's tray and drinks it in one pull.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "She lowers the tray and backs toward the door.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Stay, honey.", "name": "TANYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "I should refill the ice.", "name": "INES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "We have ice.", "name": "TANYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Ines freezes.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Minh-Anh doesn't blink.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "So. The briefcase.", "name": "MINH-ANH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "What about it?", "name": "MAN IN LEATHER COAT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Open it.", "name": "MINH-ANH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "He doesn't move.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Duke sets down the microphone.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Casimir.", "name": "DUKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "There it is.", "name": "CASIMIR", "speaker": 6, "ext": [], "paren": ["slowly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "Don't be dramatic.", "name": "DUKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "You said my name like a bad word.", "name": "CASIMIR", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "It is a bad word, Casimir.", "name": "DUKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "action", "text": "Tanya's cards stop.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "Minh-Anh's hand drifts to her purse.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "Ines, sweetheart, put on a song.", "name": "CASIMIR", "speaker": 6, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "Sir?", "name": "INES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "Anything. Something loud.", "name": "CASIMIR", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "She taps the screen.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "A power ballad erupts, drums and strings.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "Casimir stands.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "Reaches into his coat.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "Duke lunges.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "Minh-Anh rolls over the table.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "Tanya slams the briefcase shut.", "para": 8, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "In three seconds the booth is a knot of elbows, glass shattering, whiskey flying.", "para": 8, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "action", "text": "The song soars on.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "action", "text": "A pistol clatters to the floor.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "Everybody stops.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "Everybody looks at it.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "dialogue", "text": "That's not my ice.", "name": "INES", "speaker": 3, "ext": [], "paren": ["very small"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}