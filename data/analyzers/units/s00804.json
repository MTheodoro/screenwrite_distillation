{"scene_id": "s00804", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00804.fountain", "heading": "INT. AVALANCHE RESCUE HUT - NIGHT", "cast": [{"id": 0, "name": "INGRID LJUNGBERG", "names": ["INGRID LJUNGBERG", "INGRID"], "gender": "?", "first": 5, "spoke": 9}, {"id": 1, "name": "ALEX", "names": ["ALEX"], "gender": "f", "first": 6, "spoke": 6}, {"id": 2, "name": "SOTOMAYOR", "names": ["SOTOMAYOR"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "RANGER PALOMAKI", "names": ["RANGER PALOMAKI", "PALOMAKI"], "gender": "?", "first": 30, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. AVALANCHE RESCUE HUT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "One room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A woodstove ticking.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Bunks bolted to the wall.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Snow whispers on the shutters.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "INGRID LJUNGBERG, 30s, wool hat, sits cross-legged by the stove feeding it splinters.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "ALEJANDRO \"ALEX\" SOTOMAYOR, 20s, sleeping bag to his chin, sips tea and watches her.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "A radio on the shelf murmurs low static.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "It's quiet.", "name": "ALEX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Good quiet.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Is there another kind?", "name": "ALEX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Yes.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "The stove pops.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Alex smiles faintly.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Ingrid tosses another splinter.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Try to sleep.", "name": "INGRID", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "I'm too warm.", "name": "ALEX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "That's the point of the hut.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "He closes his eyes.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Opens one.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Do you ever get used to it?", "name": "ALEX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "To what?", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "The mountain. How it just... waits.", "name": "ALEX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Ingrid considers.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The wind outside drops a moment.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "No.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Me neither.", "name": "ALEX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "He lets his head sink into the pillow.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "The radio crackles.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Both of them look at it.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Hut two, hut two, this is Ranger Palomaki. Do you copy?", "name": "RANGER PALOMAKI", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Ingrid crosses and picks it up.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Palomaki, Ljungberg. Go ahead.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Ingrid. How many in the hut?", "name": "PALOMAKI", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Two. Me and the rookie.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Listen to me carefully. The slope above you let go twenty minutes ago.", "name": "PALOMAKI", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Ingrid does not move.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Alex sits up.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Say again.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "The slide stopped thirty feet short of the hut. Don't open the door.", "name": "PALOMAKI", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "A deep groan from above.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Dust sifts from the rafters.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "The stove flame leans, then stands upright again.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Alex's eyes find hers.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "She puts one finger to her lips.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}]}