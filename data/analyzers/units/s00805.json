{"scene_id": "s00805", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00805.fountain", "heading": "INT. NIGHT FERRY - CAR DECK - NIGHT", "cast": [{"id": 0, "name": "HOLLIS BRANDVOLD", "names": ["HOLLIS BRANDVOLD", "HOLLIS"], "gender": "m", "first": 4, "spoke": 19}, {"id": 1, "name": "ZORAIDA KEMP", "names": ["ZORAIDA KEMP", "ZORAIDA"], "gender": "f", "first": 8, "spoke": 18}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT FERRY - CAR DECK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Rows of parked cars lashed down with chains.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Engine hum through the steel floor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Fog presses against the open bow, and somewhere out in the dark a horn answers the ship's horn.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "HOLLIS BRANDVOLD, 40s, rumpled raincoat, a badge on his belt, walks the aisle.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He stops beside a white sedan with its windows fogged from inside.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "He taps the glass.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "The window lowers an inch.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "ZORAIDA KEMP, 30s, a scarf over her mouth, looks out with wide dark eyes.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Ma'am. This deck should be empty.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I'm waiting for my husband.", "name": "ZORAIDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "He's in the car?", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "He's on the upper deck.", "name": "ZORAIDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Then why are you down here?", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She doesn't answer.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Hollis steps back, hand drifting toward his coat.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She opens the door and slides out, slowly, palms where he can see them.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "The scarf drops from her face.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "You're the Kemp woman. From the bank.", "name": "HOLLIS", "speaker": 0, "ext": ["CONT'D"], "paren": ["realizing"], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Zoraida.", "name": "ZORAIDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "You were supposed to be in Rotterdam.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "I changed my mind.", "name": "ZORAIDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "That's not how it works.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "It's exactly how it works. That's why you're standing here.", "name": "ZORAIDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She nods at the trunk of the sedan.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "He follows her glance, then fixes on her again.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "What's in the trunk?", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "The reason you were sent.", "name": "ZORAIDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Open it.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Detective, with respect, it's not that kind of trunk.", "name": "ZORAIDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "He draws the pistol from his coat and aims it at her chest.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "She doesn't flinch.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Fog drifts between them.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Behind him, a chain rattles in a swell, and he doesn't look.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Open it.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "You first.", "name": "ZORAIDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Excuse me?", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "You've been following me since Copenhagen. You've had a dozen chances. You're not here to arrest me.", "name": "ZORAIDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "I'm here because I was told to be.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "By whom?", "name": "ZORAIDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "That's not your business.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "It's exactly my business. It's the only business.", "name": "ZORAIDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Zoraida.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Say it, Hollis. Who sent you?", "name": "ZORAIDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "His jaw works.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "The gun wavers a fraction.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Your husband.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "There it is.", "name": "ZORAIDA", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "He said you'd run.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "He said wrong.", "name": "ZORAIDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "She reaches into the sedan, pulls out a manila envelope, and tosses it at his feet.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "It lands with a slap.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "He stares at it.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "That's every account he's moved in six years. Every name. Every number.", "name": "ZORAIDA", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "Why give it to me?", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "Because you're the first one who didn't kill me when he had the chance.", "name": "ZORAIDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "Hollis bends, slowly, without taking the gun off her.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "Picks up the envelope.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "Weighs it.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "If I take this, I'm a dead man.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "If you don't, we both are.", "name": "ZORAIDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "A long moment.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "Then, overhead, a steward's footsteps on the grating.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "A cart rolls.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "A voice hums.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "Hollis lowers the pistol.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "Tucks the envelope in his coat.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 67, "kind": "action", "text": "Zoraida lets her breath out.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "Get in the car.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "It's my car.", "name": "ZORAIDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "I'm driving.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "The ship's horn blasts.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "The deck shivers.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "Hollis opens the driver's door and climbs in.", "para": 11, "sent": 2, "present": [0, 1]}]}