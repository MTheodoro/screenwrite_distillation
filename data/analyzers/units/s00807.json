{"scene_id": "s00807", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00807.fountain", "heading": "INT. AIR DUCT - ABOVE VAULT CORRIDOR - NIGHT", "cast": [{"id": 0, "name": "ANDREJ MOKOENA", "names": ["ANDREJ MOKOENA", "ANDREJ"], "gender": "m", "first": 5, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. AIR DUCT - ABOVE VAULT CORRIDOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cramped aluminum.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A pencil flashlight in his teeth.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dust motes.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The distant hum of a security camera swiveling below.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ANDREJ MOKOENA, 30s, crawls on his elbows with a coil of rope on his back and a small recorder strapped to his sleeve.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "He stops at a vent grate.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Looks down at a laser grid.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "He spits the flashlight into his hand.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Whispers.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "dialogue", "text": "Okay. Okay. Rehearsal one.", "name": "ANDREJ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 11, "kind": "action", "text": "He taps the recorder.", "para": 3, "sent": 0, "present": [0]}, {"u": 12, "kind": "action", "text": "Plays it.", "para": 3, "sent": 1, "present": [0]}, {"u": 13, "kind": "dialogue", "text": "Step one. Rope on the vent bolt. Step two. Lower down, slow, between beam three and beam four. Step three. Don't sneeze.", "name": "ANDREJ", "speaker": 0, "ext": ["V.O."], "paren": ["recorded, whisper"], "dual": false, "present": [0]}, {"u": 14, "kind": "action", "text": "He winces.", "para": 4, "sent": 0, "present": [0]}, {"u": 15, "kind": "dialogue", "text": "I'm going to sneeze.", "name": "ANDREJ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 16, "kind": "action", "text": "He pinches his nose.", "para": 5, "sent": 0, "present": [0]}, {"u": 17, "kind": "action", "text": "Waits.", "para": 5, "sent": 1, "present": [0]}, {"u": 18, "kind": "action", "text": "It passes.", "para": 5, "sent": 2, "present": [0]}, {"u": 19, "kind": "action", "text": "He taps the recorder again.", "para": 5, "sent": 3, "present": [0]}, {"u": 20, "kind": "dialogue", "text": "Step four. The safe's a Hargrove. Combination is the date of the Armistice, flipped. Eleven eleven, nineteen eighteen, so one-one, one-one, one-eight, one-nine.", "name": "ANDREJ", "speaker": 0, "ext": ["V.O."], "paren": ["recorded"], "dual": false, "present": [0]}, {"u": 21, "kind": "dialogue", "text": "That's seven numbers. Hargrove's six.", "name": "ANDREJ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 22, "kind": "action", "text": "He frowns.", "para": 6, "sent": 0, "present": [0]}, {"u": 23, "kind": "action", "text": "Rewinds.", "para": 6, "sent": 1, "present": [0]}, {"u": 24, "kind": "dialogue", "text": "...one-one, one-one, one-eight, one-nine...", "name": "ANDREJ", "speaker": 0, "ext": ["V.O."], "paren": ["recorded"], "dual": false, "present": [0]}, {"u": 25, "kind": "dialogue", "text": "Drop the last nine. One-one, one-one, one-eight.", "name": "ANDREJ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 26, "kind": "action", "text": "He whispers it three times, like a spell, then taps the recorder to start a new take.", "para": 7, "sent": 0, "present": [0]}, {"u": 27, "kind": "dialogue", "text": "Rehearsal two. If I die in this duct, tell my mother I was a pastry chef.", "name": "ANDREJ", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 28, "kind": "action", "text": "A click below.", "para": 8, "sent": 0, "present": [0]}, {"u": 29, "kind": "action", "text": "A faint red light sweeps across the vent.", "para": 8, "sent": 1, "present": [0]}, {"u": 30, "kind": "action", "text": "He freezes.", "para": 8, "sent": 2, "present": [0]}, {"u": 31, "kind": "action", "text": "The light passes.", "para": 8, "sent": 3, "present": [0]}, {"u": 32, "kind": "dialogue", "text": "Step one.", "name": "ANDREJ", "speaker": 0, "ext": ["CONT'D"], "paren": ["barely audible"], "dual": false, "present": [0]}, {"u": 33, "kind": "action", "text": "He slides the first bolt loose.", "para": 9, "sent": 0, "present": [0]}]}