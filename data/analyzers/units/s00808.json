{"scene_id": "s00808", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00808.fountain", "heading": "INT. SPEEDWAY GO-KART TRACK - PIT LANE - AFTERNOON", "cast": [{"id": 0, "name": "MILO GALLAGHER-SINGH", "names": ["MILO GALLAGHER-SINGH", "MILO"], "gender": "m", "first": 6, "spoke": 10}, {"id": 1, "name": "DOMINIC TREJO", "names": ["DOMINIC TREJO", "DOMINIC"], "gender": "?", "first": 7, "spoke": 10}, {"id": 2, "name": "PINKY", "names": ["PINKY"], "gender": "?", "first": 8, "spoke": 9}, {"id": 3, "name": "DESAI", "names": ["DESAI"], "gender": "?", "first": 8, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. SPEEDWAY GO-KART TRACK - PIT LANE - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Tires stacked like donuts.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The smell of two-stroke.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A hand-lettered sign: \"NO RUNNING.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "NO CRYING.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "NO REFUNDS.\"", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "MILO GALLAGHER-SINGH, 15, cracked helmet, oil on his cheek, kneels by a small yellow kart.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "DOMINIC TREJO, 15, in a stained racing suit two sizes big, leans on the fence and chews a straw.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "PRIYANKA \"PINKY\" DESAI, 14, clipboard, stopwatch around her neck, stands between them.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Four minutes to the heat.", "name": "PINKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "It's the carburetor.", "name": "MILO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "It's the driver.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "It is not the driver.", "name": "MILO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Dom, he's got a point.", "name": "PINKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "He always has a point, Pinky. That's his whole problem.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "I can fix it.", "name": "MILO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "You said that at Nationals.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "That was the tire!", "name": "MILO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "It was the tire.", "name": "PINKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Whose tire?", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Yours!", "name": "MILO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Three minutes.", "name": "PINKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Milo slams the wrench down.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Dominic pushes off the fence.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "They square up, nose to nose, helmet to helmet.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Say it again.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Say what?", "name": "MILO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "That it's me.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "It's the carburetor.", "name": "MILO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Boys. Boys.", "name": "PINKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Pinky, stay out of it.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "I'm the pit boss.", "name": "PINKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "She's the pit boss.", "name": "MILO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "She's fourteen!", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "I'm fourteen and a half, and I'm timing you.", "name": "PINKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "A horn blares from the track.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Everyone flinches.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Milo grabs the wrench.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Dominic grabs the steering wheel.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "They both pull the kart in opposite directions.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "That's it. I'm calling my brother.", "name": "PINKY", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "She raises the stopwatch.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Presses it.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "The chaos holds.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "The engine coughs, sputters, and catches.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Oh.", "name": "MILO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Oh.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "They stare at the roaring kart.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Dominic slides in.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Milo hands him a glove.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Thanks.", "name": "DOMINIC", "speaker": 1, "ext": ["CONT'D"], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Don't mention it.", "name": "MILO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Go!", "name": "PINKY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}