{"scene_id": "s00809", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00809.fountain", "heading": "INT. NIGHT BUS 47 - MOVING - NIGHT", "cast": [{"id": 0, "name": "ELDON MCPHAIL", "names": ["ELDON MCPHAIL", "ELDON"], "gender": "m", "first": 5, "spoke": 13}, {"id": 1, "name": "SORAYA KHALILI", "names": ["SORAYA KHALILI", "SORAYA"], "gender": "f", "first": 7, "spoke": 10}, {"id": 2, "name": "BENNETT OLUMIDE", "names": ["BENNETT OLUMIDE", "BENNETT"], "gender": "m", "first": 8, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT BUS 47 - MOVING - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Near-empty.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Overhead lights hum.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain drags sideways across the windows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Wipers tick.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ELDON MCPHAIL, 50s, driver, hat low, one hand on the wheel and the other around a cold thermos.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "In the mirror: two passengers.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "SORAYA KHALILI, 30s, backpack on her lap, sits halfway back, glued to her phone.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Behind her, BENNETT OLUMIDE, 40s, in a damp raincoat, stares out at the passing dark.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Eldon clears his throat.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Next stop, Harbor and Fifth. Mind the gap.", "name": "ELDON", "speaker": 0, "ext": [], "paren": ["to the bus"], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Nobody reacts.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Nobody ever minds the gap.", "name": "ELDON", "speaker": 0, "ext": ["CONT'D"], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Soraya looks up.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Is this the 47?", "name": "SORAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "It's the 47.", "name": "ELDON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "It's not going to Eastgate?", "name": "SORAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Not tonight.", "name": "ELDON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Since when?", "name": "SORAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Since the flood.", "name": "ELDON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Soraya sighs.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Pockets her phone.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Bennett turns his head, slowly.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "You're the third bus tonight.", "name": "BENNETT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Third what?", "name": "ELDON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Third driver who didn't say where we're going.", "name": "BENNETT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "I said Harbor and Fifth.", "name": "ELDON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "And after that?", "name": "BENNETT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "After that, nothing. Last stop.", "name": "ELDON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Bennett nods, slowly, as though it explains something he's been wondering about.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Can you let me off before Harbor?", "name": "SORAYA", "speaker": 1, "ext": [], "paren": ["to Eldon"], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Not an official stop.", "name": "ELDON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "I'll pay extra.", "name": "SORAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "It's not about the fare, miss.", "name": "ELDON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Then what is it about?", "name": "SORAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Rules.", "name": "ELDON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Great.", "name": "SORAYA", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "The bus slows.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Brakes sigh.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "The doors fold open to rain.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Harbor and Fifth.", "name": "ELDON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Soraya stands.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Bennett doesn't.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Are you coming?", "name": "SORAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "No.", "name": "BENNETT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "This is your stop.", "name": "SORAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "It's his stop.", "name": "BENNETT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "He nods at Eldon.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Everybody out, please.", "name": "ELDON", "speaker": 0, "ext": [], "paren": ["to the empty bus"], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Soraya freezes.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Looks at Bennett.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "At Eldon.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "At the empty seats behind them.", "para": 11, "sent": 3, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Who is he talking to?", "name": "SORAYA", "speaker": 1, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "The ones who stayed.", "name": "BENNETT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Eldon closes the doors.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "The wipers resume.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "The bus pulls out, carrying all three of them into the dark.", "para": 12, "sent": 2, "present": [0, 1, 2]}]}