{"scene_id": "s00810", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00810.fountain", "heading": "INT. DRAGON DENTIST'S CAVERN - DAY", "cast": [{"id": 0, "name": "HOLLYHOCK THISTLEWICK", "names": ["HOLLYHOCK THISTLEWICK", "HOLLYHOCK"], "gender": "f", "first": 5, "spoke": 10}, {"id": 1, "name": "DRAGON", "names": ["DRAGON"], "gender": "?", "first": 6, "spoke": 2}, {"id": 2, "name": "PIP", "names": ["PIP"], "gender": "?", "first": 7, "spoke": 1}, {"id": 3, "name": "GRUB", "names": ["GRUB"], "gender": "?", "first": 8, "spoke": 3}, {"id": 4, "name": "SIR ALARIC FENWICK-DALE", "names": ["SIR ALARIC FENWICK-DALE", "SIR ALARIC"], "gender": "m", "first": 9, "spoke": 3}, {"id": 5, "name": "VESKARATH", "names": ["VESKARATH"], "gender": "?", "first": 25, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRAGON DENTIST'S CAVERN - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A great cavern hung with brass lamps.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A chair carved from a single glacial boulder.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Around it, racks of tongs and chisels the size of oars.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A bubbling cauldron of mouthwash.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. HOLLYHOCK THISTLEWICK, 200 and spry, tiny, a mirror-headed lamp strapped to her brow, stands on a ladder, peering into a mouth the size of a barn door.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A DRAGON lies in the chair, jaws wide, one golden eye rolling.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "PIP, a pixie nurse no bigger than a thimble, buzzes at the dentist's ear with a tray of silver picks.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "GRUB, a goblin receptionist, leans in the doorway chewing a pencil.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "SIR ALARIC FENWICK-DALE, a very old knight, sits in the waiting alcove with his helmet in his lap.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Wider, please.", "name": "HOLLYHOCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Wider than this?", "name": "DRAGON", "speaker": 1, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "I'm afraid so.", "name": "HOLLYHOCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "You said that last time.", "name": "DRAGON", "speaker": 1, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "And the time before. Wider.", "name": "HOLLYHOCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "He strains.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "The cavern shudders.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "A stalactite falls and bounces off Sir Alaric's helmet.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Ow.", "name": "SIR ALARIC", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Sorry, Sir Alaric. Occupational hazard.", "name": "GRUB", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Pip, the number seven pick.", "name": "HOLLYHOCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Coming, Doctor.", "name": "PIP", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Hollyhock probes.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "The dragon's tail thumps once.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Dust rains from the ceiling.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Your gum is inflamed, Veskarath.", "name": "HOLLYHOCK", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "It's been like that for three centuries.", "name": "VESKARATH", "speaker": 5, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "It's gingivitis.", "name": "HOLLYHOCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "It's a lifestyle.", "name": "VESKARATH", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "You've eaten a lot of knights.", "name": "HOLLYHOCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Only the crunchy ones.", "name": "VESKARATH", "speaker": 5, "ext": [], "paren": ["muffled, a little ashamed"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Sir Alaric clears his throat.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Rises from the alcove, helmet under one arm.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "I was told this would be a quick consultation.", "name": "SIR ALARIC", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "It always is, Sir Alaric.", "name": "HOLLYHOCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "It's been four hours.", "name": "SIR ALARIC", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Time moves differently in a cave.", "name": "GRUB", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Is that supposed to be a joke?", "name": "VESKARATH", "speaker": 5, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "It's a policy.", "name": "GRUB", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Hollyhock sighs.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Climbs down the ladder, pats the dragon's lip, and picks up a small mirror.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Rinse and spit. Then floss.", "name": "HOLLYHOCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Floss what?", "name": "VESKARATH", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "You'll do.", "name": "HOLLYHOCK", "speaker": 0, "ext": [], "paren": ["to Sir Alaric, deadpan"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}