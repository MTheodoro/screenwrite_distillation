{"scene_id": "s00811", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00811.fountain", "heading": "INT. DRIVE-THRU WEDDING CHAPEL - BOOTH - NIGHT", "cast": [{"id": 0, "name": "VOWS", "names": ["VOWS"], "gender": "?", "first": 3, "spoke": 0}, {"id": 1, "name": "FLOWERS", "names": ["FLOWERS"], "gender": "?", "first": 3, "spoke": 0}, {"id": 2, "name": "PATSY LEUNG-ARCHER", "names": ["PATSY LEUNG-ARCHER", "PATSY"], "gender": "?", "first": 4, "spoke": 8}, {"id": 3, "name": "WENDELL ASHFORD-LOPEZ", "names": ["WENDELL ASHFORD-LOPEZ", "WENDELL"], "gender": "m", "first": 19, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRIVE-THRU WEDDING CHAPEL - BOOTH - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A glass booth the size of a phone box.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Plastic flowers.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A speaker, a menu board with \"VOWS - $29\" and \"FLOWERS - $9,\" and a tiny neon cross.", "para": 0, "sent": 2, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "PATSY LEUNG-ARCHER, 20s, sequined vest and veil, sits on a stool.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 5, "kind": "action", "text": "She wipes down the counter in slow circles.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "The only sound is the neon's buzz.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Headlights sweep across her face.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "A car idles outside.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "A window rolls down.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "She slides the glass open and leans out.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Welcome to Holy Smokes Chapel. Would you like to marry someone tonight?", "name": "PATSY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Nobody answers.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Just the engine.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Sir? Ma'am?", "name": "PATSY", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "A hand appears.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "In it, a gun.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Patsy freezes.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Her lips move without sound.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "WENDELL ASHFORD-LOPEZ, 40s, pulls his head out of the car and steps up to the booth.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Leather jacket, bloodshot eyes.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "The gun stays on her.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Open the register.", "name": "WENDELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "We don't have a register. We have a tip jar.", "name": "PATSY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Then open the tip jar.", "name": "WENDELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "It's a mason jar.", "name": "PATSY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Open it!", "name": "WENDELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "She does, hands shaking.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "A few crumpled bills.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "A rubber band.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "A condolence card.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "That's all?", "name": "WENDELL", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "People mostly pay with cards.", "name": "PATSY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "He stares into the jar.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "The gun lowers.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "He laughs, ragged.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "I've been planning this for a month.", "name": "WENDELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "I can marry you. Twenty-nine dollars.", "name": "PATSY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "To who?", "name": "WENDELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Anyone you like. I'm very flexible.", "name": "PATSY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "He pockets the gun.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Takes out a crumpled twenty and a ten.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Pushes them through.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Keep the dollar.", "name": "WENDELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Congratulations.", "name": "PATSY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "She adjusts her veil and begins the vows.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}]}