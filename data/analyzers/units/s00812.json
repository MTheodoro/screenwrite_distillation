{"scene_id": "s00812", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00812.fountain", "heading": "INT. VICTORIAN BATHHOUSE - STEAM ROOM - AFTERNOON, 1887", "cast": [{"id": 0, "name": "LADY PHILIPPA ACKROYD-VANE", "names": ["LADY PHILIPPA ACKROYD-VANE", "PHILIPPA"], "gender": "?", "first": 4, "spoke": 10}, {"id": 1, "name": "MARGUERITE TOBIN", "names": ["MARGUERITE TOBIN", "MARGUERITE"], "gender": "?", "first": 5, "spoke": 1}, {"id": 2, "name": "EZEKIEL FARNSWORTH", "names": ["EZEKIEL FARNSWORTH", "FARNSWORTH"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "OLIVE PETTIGREW", "names": ["OLIVE PETTIGREW", "OLIVE"], "gender": "?", "first": 6, "spoke": 3}, {"id": 4, "name": "ARTHUR BELLWETHER", "names": ["ARTHUR BELLWETHER", "ARTHUR"], "gender": "?", "first": 7, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. VICTORIAN BATHHOUSE - STEAM ROOM - AFTERNOON, 1887", "present": []}, {"u": 1, "kind": "action", "text": "Marble benches slick with condensation.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Pipes knock somewhere in the walls.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Gas lamps burn in fogged globes.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LADY PHILIPPA ACKROYD-VANE, 50s, wrapped in white linen, reclines on a bench with her eyes shut.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "At her side sits her maid, MARGUERITE TOBIN, 20s, folding towels in her lap.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Across the room DR. EZEKIEL FARNSWORTH, 60s, in a towel and a monocle, mops his brow with a handkerchief, and beside him MRS. OLIVE PETTIGREW, 40s, the bathhouse matron, polishes a brass tap.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "In the doorway stands ARTHUR BELLWETHER, 30s, a young reporter in a damp suit, notebook already out.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "She opens one eye.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "He steps forward.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "She raises a hand and he stops.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Mr. Bellwether. You may not write in here.", "name": "PHILIPPA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Lady Ackroyd-Vane, the public wishes to know.", "name": "ARTHUR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "The public wishes to know a great many things.", "name": "PHILIPPA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Is it true you sold the estate?", "name": "ARTHUR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "That is a rumor.", "name": "PHILIPPA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Is it a true rumor?", "name": "ARTHUR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Dr. Farnsworth, how many rumors are true?", "name": "PHILIPPA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Statistically, madam, one in nine.", "name": "FARNSWORTH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "There. One in nine.", "name": "PHILIPPA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "That is not an answer.", "name": "ARTHUR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "It is a tolerable approximation.", "name": "PHILIPPA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "The pipes knock.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Marguerite folds another towel.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Olive polishes the tap, hard.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Beg pardon, Lady Philippa, but the gentleman's dripping on my marble.", "name": "OLIVE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "I'm terribly sorry, madam.", "name": "ARTHUR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Then take your notebook outside.", "name": "OLIVE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Only if Lady Philippa grants an interview.", "name": "ARTHUR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Marguerite, what do you think?", "name": "PHILIPPA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "I think the steam is good for the lungs, my lady.", "name": "MARGUERITE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "A sensible girl.", "name": "PHILIPPA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "She's not wrong. Though I'd add that excessive steam is dangerous to ink.", "name": "FARNSWORTH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "I shall be careful.", "name": "ARTHUR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "You'll be dry, or you'll be gone.", "name": "OLIVE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Very well.", "name": "ARTHUR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "He tucks the notebook inside his jacket.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Philippa studies him through the steam for a long moment.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "The estate is sold. The buyer is a railway man.", "name": "PHILIPPA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "May I print that?", "name": "ARTHUR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "You may print that I am in excellent health.", "name": "PHILIPPA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "He bows.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Olive points at the door.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "He goes.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "The steam closes in again.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Marguerite, quietly, begins to hum.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4]}]}