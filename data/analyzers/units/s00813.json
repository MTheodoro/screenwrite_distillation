{"scene_id": "s00813", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00813.fountain", "heading": "INT. FAMILY LIVING ROOM - UPRIGHT PIANO - EVENING", "cast": [{"id": 0, "name": "ARNOLD TEMPLETON-WU", "names": ["ARNOLD TEMPLETON-WU", "ARNOLD"], "gender": "?", "first": 4, "spoke": 20}, {"id": 1, "name": "JOSEFINA", "names": ["JOSEFINA"], "gender": "f", "first": 5, "spoke": 22}], "units": [{"u": 0, "kind": "heading", "text": "INT. FAMILY LIVING ROOM - UPRIGHT PIANO - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "A dim room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A lamp with a yellowed shade.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A walnut upright against the wall, its front panel off, hammers exposed like a ribcage.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ARNOLD TEMPLETON-WU, 60s, piano tuner, kneels beside it with a tuning lever.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "His daughter JOSEFINA, 30s, leans in the doorway, coat still on.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "She doesn't come in.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He strikes a key.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Listens.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Adjusts a pin.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Strikes again.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "You didn't call.", "name": "JOSEFINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I wrote.", "name": "ARNOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "A postcard isn't a call.", "name": "JOSEFINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "It's quicker.", "name": "ARNOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "It took six weeks.", "name": "JOSEFINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He strikes a key.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Doesn't answer.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Mom's piano.", "name": "JOSEFINA", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "She'd want it tuned.", "name": "ARNOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "She'd want a lot of things.", "name": "JOSEFINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "He pauses.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Rests the lever on the strings.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Do you want to sit?", "name": "ARNOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "I'm fine.", "name": "JOSEFINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "There's tea.", "name": "ARNOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "I'm fine.", "name": "JOSEFINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "He nods.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Resumes.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "A key.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "A pin.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "A key.", "para": 6, "sent": 4, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "She finally crosses the room.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Drops her bag.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Perches on the arm of the sofa.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "How long have you been working on it?", "name": "JOSEFINA", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Three days.", "name": "ARNOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "That's a lot for a tuning.", "name": "JOSEFINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "It's an old instrument.", "name": "ARNOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Dad.", "name": "JOSEFINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Hm.", "name": "ARNOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "You don't have to be here alone.", "name": "JOSEFINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "I'm not alone. I've got the piano.", "name": "ARNOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "That's the saddest thing you've said all year.", "name": "JOSEFINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "He strikes a key.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "A beat.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Another.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "This one's flat.", "name": "ARNOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "They all are.", "name": "JOSEFINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "No. Just this one. Listen.", "name": "ARNOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "He plays an A. Then the A above it.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "They clash faintly.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "Josefina tilts her head.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "I can hear it.", "name": "JOSEFINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "That's your mother's ear.", "name": "ARNOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "She told me once she could hear when a room was out of tune.", "name": "JOSEFINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "She could.", "name": "ARNOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "What did the room sound like when she left?", "name": "JOSEFINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "He stops.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "His hand hangs above the keys.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "Like this.", "name": "ARNOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "He plays the flat A. It hangs between them, wavering.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "Can you fix it?", "name": "JOSEFINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "I've tried.", "name": "ARNOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "Let me.", "name": "JOSEFINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "You've never tuned.", "name": "ARNOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "I've listened my whole life.", "name": "JOSEFINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "action", "text": "He studies her.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "Hands her the lever.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "She kneels beside him.", "para": 12, "sent": 2, "present": [0, 1]}, {"u": 70, "kind": "action", "text": "Presses the key.", "para": 12, "sent": 3, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "Turns the pin a hair, then another, her head cocked, her eyes closed.", "para": 12, "sent": 4, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "The A rises.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "Settles.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 74, "kind": "action", "text": "Becomes true.", "para": 13, "sent": 2, "present": [0, 1]}, {"u": 75, "kind": "action", "text": "She opens her eyes.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 76, "kind": "action", "text": "He is watching her, not the piano.", "para": 14, "sent": 1, "present": [0, 1]}, {"u": 77, "kind": "dialogue", "text": "That's it.", "name": "ARNOLD", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 78, "kind": "dialogue", "text": "That's it?", "name": "JOSEFINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 79, "kind": "dialogue", "text": "That's the note.", "name": "ARNOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 80, "kind": "action", "text": "She plays it again.", "para": 15, "sent": 0, "present": [0, 1]}, {"u": 81, "kind": "action", "text": "A clean, level tone.", "para": 15, "sent": 1, "present": [0, 1]}, {"u": 82, "kind": "action", "text": "The room seems to lean toward it.", "para": 15, "sent": 2, "present": [0, 1]}, {"u": 83, "kind": "dialogue", "text": "I should have come sooner.", "name": "JOSEFINA", "speaker": 1, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1]}, {"u": 84, "kind": "dialogue", "text": "You came.", "name": "ARNOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 85, "kind": "action", "text": "She sets down the lever.", "para": 16, "sent": 0, "present": [0, 1]}, {"u": 86, "kind": "action", "text": "He puts a hand on the piano's side, the way you might touch a shoulder.", "para": 16, "sent": 1, "present": [0, 1]}, {"u": 87, "kind": "dialogue", "text": "Want tea now?", "name": "ARNOLD", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 88, "kind": "dialogue", "text": "Yes.", "name": "JOSEFINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 89, "kind": "action", "text": "He rises, knees cracking.", "para": 17, "sent": 0, "present": [0, 1]}, {"u": 90, "kind": "action", "text": "Goes to the kitchen.", "para": 17, "sent": 1, "present": [0, 1]}, {"u": 91, "kind": "action", "text": "She stays at the piano and plays, one finger at a time, the first line of a lullaby.", "para": 17, "sent": 2, "present": [0, 1]}]}