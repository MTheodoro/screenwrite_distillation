{"scene_id": "s00815", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00815.fountain", "heading": "INT. SALT MINE TUNNEL - FORWARD LISTENING POST - NIGHT, 1916", "cast": [{"id": 0, "name": "HIRAM STALLWORTH", "names": ["HIRAM STALLWORTH", "HIRAM"], "gender": "m", "first": 5, "spoke": 8}, {"id": 1, "name": "OTTILIE BRANDT", "names": ["OTTILIE BRANDT", "OTTILIE"], "gender": "f", "first": 7, "spoke": 7}, {"id": 2, "name": "EMEKA OGBONNA", "names": ["EMEKA OGBONNA", "EMEKA"], "gender": "?", "first": 9, "spoke": 7}, {"id": 3, "name": "SOOT", "names": ["SOOT"], "gender": "?", "first": 11, "spoke": 6}, {"id": 4, "name": "BEAUMONT", "names": ["BEAUMONT"], "gender": "?", "first": 11, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. SALT MINE TUNNEL - FORWARD LISTENING POST - NIGHT, 1916", "present": []}, {"u": 1, "kind": "action", "text": "White walls glitter under oil lamps.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The passage narrows to a crawl at one end, where a pickaxe lies abandoned.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Everything tastes of brine and iron.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A telephone hangs on a nail, its wire running up into the dark.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SGT. HIRAM STALLWORTH, 40s, stands against the wall, thumb moving over a rosary he doesn't believe in.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "CPL.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "OTTILIE BRANDT, 30s, medic, kneels over a canvas bag, counting bandages.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "PVT.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "EMEKA OGBONNA, 19, crouches at the narrowing, head cocked, listening.", "para": 1, "sent": 4, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "PVT.", "para": 1, "sent": 5, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "SAMUEL \"SOOT\" BEAUMONT, 22, sits on an ammunition crate sharpening a bayonet.", "para": 1, "sent": 6, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Silence.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "A drip from the roof.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Then, from far above, a faint rhythm of thumps.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "They're digging again.", "name": "EMEKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "How close?", "name": "HIRAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Same as an hour ago.", "name": "EMEKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "That's not close or far. That's just there.", "name": "SOOT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Soot, hold still. Your hands are shaking.", "name": "OTTILIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "They are not.", "name": "SOOT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Then it's the crate.", "name": "OTTILIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Brandt, enough.", "name": "HIRAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Sergeant.", "name": "OTTILIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "The thumps stop.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "All four look up.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "A dry rain of salt falls from the ceiling and tings on the helmet at Emeka's feet.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Did you hear that?", "name": "EMEKA", "speaker": 2, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Hear what?", "name": "SOOT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Nothing. That's what I'm saying.", "name": "EMEKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Stand to.", "name": "HIRAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "They move.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Ottilie closes her bag.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Soot slides the bayonet home.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Emeka backs from the narrowing, rifle level.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Hiram unhooks the telephone and puts it to his ear.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Nothing.", "para": 4, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "He taps the cradle.", "para": 4, "sent": 6, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Nothing.", "para": 4, "sent": 7, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Line's dead.", "name": "HIRAM", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Course it is.", "name": "SOOT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Don't.", "name": "OTTILIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "I'm only saying.", "name": "SOOT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Don't.", "name": "OTTILIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "A single drop of water hits the floor.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Another.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "They all watch it.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "The echo seems to travel for a long time.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "I used to hear my mother singing in the pit at home.", "name": "EMEKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Did you?", "name": "HIRAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Same note. Over and over.", "name": "EMEKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "What was the note?", "name": "OTTILIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "I don't know. I never had a name for it.", "name": "EMEKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Soot laughs, not unkindly.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "Hiram almost smiles.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "The thumps resume overhead, three, then four, then a pause.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "We hold.", "name": "HIRAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "Till when?", "name": "SOOT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "Till we're told.", "name": "HIRAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "Told by who?", "name": "OTTILIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "That's not for us to ask.", "name": "HIRAM", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "He hangs up the phone.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "Folds his arms.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "The four of them settle in the white tunnel, listening to the mountain breathe.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}]}