{"scene_id": "s00816", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00816.fountain", "heading": "INT. CHURCH BELFRY - SNIPER NEST - DAWN", "cast": [{"id": 0, "name": "VASILY PETRENKO", "names": ["VASILY PETRENKO", "VASILY"], "gender": "?", "first": 4, "spoke": 2}, {"id": 1, "name": "TANISHA GREER", "names": ["TANISHA GREER", "TANISHA"], "gender": "?", "first": 6, "spoke": 3}, {"id": 2, "name": "LEO FONTAINE", "names": ["LEO FONTAINE", "LEO"], "gender": "?", "first": 8, "spoke": 2}, {"id": 3, "name": "HANNELORE WEISS", "names": ["HANNELORE WEISS", "HANNELORE"], "gender": "?", "first": 10, "spoke": 2}, {"id": 4, "name": "OBINNA ADEKUNLE-REID", "names": ["OBINNA ADEKUNLE-REID", "OBINNA"], "gender": "?", "first": 11, "spoke": 2}, {"id": 5, "name": "JUNE KOWALCZYK", "names": ["JUNE KOWALCZYK", "JUNE"], "gender": "?", "first": 13, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. CHURCH BELFRY - SNIPER NEST - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Stone arches.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A cracked bell hangs silent.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Through the slit, a ruined square below.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LT. VASILY PETRENKO whispers into a field phone.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "SPC.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "TANISHA GREER braces a rifle on a sandbag.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "PVT.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "LEO FONTAINE feeds a belt into a machine gun.", "para": 1, "sent": 4, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "CPL.", "para": 1, "sent": 5, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "HANNELORE WEISS hauls up an ammo crate.", "para": 1, "sent": 6, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "SGT. OBINNA ADEKUNLE-REID wedges the door with a pew.", "para": 1, "sent": 7, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "PVT.", "para": 1, "sent": 8, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "JUNE KOWALCZYK clutches a radio.", "para": 1, "sent": 9, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "A shell whistles overhead.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "The tower shakes.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Contact left!", "name": "TANISHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Where?", "name": "LEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Left! Your other left!", "name": "TANISHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Sergeant, the door!", "name": "VASILY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "I'm holding it!", "name": "OBINNA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "They're in the nave!", "name": "HANNELORE", "speaker": 3, "ext": [], "paren": ["dropping the crate"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Lieutenant, radio says pull back!", "name": "JUNE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "To where?", "name": "VASILY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "It doesn't say!", "name": "JUNE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "A boot hits the door.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Wood splinters.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Obinna braces both shoulders against it.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Anyone?", "name": "OBINNA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Firing!", "name": "LEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "The machine gun roars.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Dust and cordite fill the belfry.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Tanisha squeezes the trigger once, twice.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "A body falls in the square.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Down!", "name": "TANISHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Then bells.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "The cracked bell, ringing on its own in the blast's echo.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "They all stop.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Look up.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "It still rings.", "name": "HANNELORE", "speaker": 3, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}