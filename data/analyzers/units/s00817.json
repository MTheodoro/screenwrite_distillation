{"scene_id": "s00817", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00817.fountain", "heading": "INT. CRUISE SHIP \"SERENISSIMA\" - CASINO CASHIER CAGE - NIGHT", "cast": [{"id": 0, "name": "HENRY GAUTHIER", "names": ["HENRY GAUTHIER", "HENRY"], "gender": "m", "first": 3, "spoke": 6}, {"id": 1, "name": "WOMAN IN FEATHERED MASK", "names": ["WOMAN", "WOMAN IN FEATHERED MASK"], "gender": "?", "first": 4, "spoke": 2}, {"id": 2, "name": "FEATHERED MASK", "names": ["FEATHERED MASK"], "gender": "?", "first": 4, "spoke": 0}, {"id": 3, "name": "FINNEGAN MBATHA", "names": ["FINNEGAN MBATHA", "FINNEGAN"], "gender": "?", "first": 17, "spoke": 4}, {"id": 4, "name": "ZINNIA", "names": ["ZINNIA"], "gender": "f", "first": 18, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. CRUISE SHIP \"SERENISSIMA\" - CASINO CASHIER CAGE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A brass cage with a tiny window, stacks of chips behind it, a rotating security camera.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Beyond, the casino floor chimes and flashes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "HENRY GAUTHIER, 50s, cashier in a burgundy vest, counts chips with a practiced thumb.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "Behind the glass, a WOMAN IN A FEATHERED MASK, 30s, waits in a silver gown, an ornate clutch pressed to her ribs.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 5, "kind": "action", "text": "She taps the counter twice.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Cash me out, please.", "name": "WOMAN IN FEATHERED MASK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Of course, madam. How much?", "name": "HENRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "She slides a rack of plaques through the window.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "He counts.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "His eyebrows go up.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "That is... a great deal, madam.", "name": "HENRY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "It was a lucky night.", "name": "WOMAN IN FEATHERED MASK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Very lucky. Name for the receipt?", "name": "HENRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "She hesitates.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Her clutch shifts.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "A muffled cough comes from the hallway behind her.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "A man in a waiter's jacket is leaning there, FINNEGAN MBATHA, 30s, one hand inside his tray cloth.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Zinnia Delacroix-Obi.", "name": "ZINNIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Delacroix. Spelled the usual way?", "name": "HENRY", "speaker": 0, "ext": [], "paren": ["writing"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "The only way.", "name": "ZINNIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "He slides a form through.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "She signs.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Behind her, Finnegan nudges a service cart, rolling it quietly against the cage door, while Henry stacks bills into an envelope and licks the flap.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "She slips her mask up an inch, scanning the camera in the ceiling, and he steps from the doorway with the tray, the cloth peeling back from a small black pistol.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Mr. Gauthier. Don't.", "name": "FINNEGAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Henry freezes mid-lick.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "The envelope droops.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "I see.", "name": "HENRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "He's very polite, isn't he?", "name": "ZINNIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "I try.", "name": "FINNEGAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Madam, I have a family.", "name": "HENRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "So did the last man.", "name": "ZINNIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Henry's hands go up.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Finnegan steps in, kicks the cart wide.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Zinnia reaches through the window and takes the envelope, then the plaques, then a second tray of cash from under the counter.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "The camera swivels toward them.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Camera.", "name": "FINNEGAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Zinnia tosses her clutch.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "It strikes the lens and a puff of grey fills the lens.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "The red light dies.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Two minutes.", "name": "ZINNIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Quiet, now.", "name": "FINNEGAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "They slip out.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Henry sits, slowly, on his stool.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Pulls a handkerchief from his vest.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Dabs his brow.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Then, from beneath the register, he lifts a very small silver bell and rings it twice.", "para": 8, "sent": 4, "present": [0, 1, 2, 3, 4]}]}