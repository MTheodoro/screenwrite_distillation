{"scene_id": "s00818", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00818.fountain", "heading": "INT. FOREVER FRIENDS PET MEMORIAL PARLOR - VIEWING ROOM - DAY", "cast": [{"id": 0, "name": "GWENDOLYN POPPLEWELL", "names": ["GWENDOLYN POPPLEWELL", "GWENDOLYN"], "gender": "f", "first": 5, "spoke": 10}, {"id": 1, "name": "RAYMOND TSOSIE-KANE", "names": ["RAYMOND TSOSIE-KANE", "RAYMOND"], "gender": "m", "first": 6, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. FOREVER FRIENDS PET MEMORIAL PARLOR - VIEWING ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Soft lilac walls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A small satin-lined coffin on a stand.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Lilies.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A framed photo of a hamster named Pickle.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "GWENDOLYN POPPLEWELL, 40s, black veil and a pinched face, dabs a handkerchief at dry eyes.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "RAYMOND TSOSIE-KANE, 30s, in a tie too tight for him, adjusts a floral arrangement without being asked.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Friends. Family. We gather today to honor Pickle.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": ["to the empty chairs"], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Raymond. Nobody's here.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Practice, Mrs. Popplewell.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": ["to her"], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I'm Gwendolyn.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Gwendolyn. Forgive me.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She sniffs.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "The room is calm.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "A bell chimes from the hall.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "He was a good hamster.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "The very best.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Did you know him?", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Only from the photograph.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Seven hundred dollars for a hamster.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Mm?", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Nothing.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Raymond lifts the coffin lid to adjust the satin.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "He stops.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Peers in.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Gently lowers the lid and clears his throat.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Mrs. Popplewell. Gwendolyn. How much did you say Pickle weighed?", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Two ounces.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Right.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Why?", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Raymond turns the little coffin around.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Opens it again.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Inside, on the satin, lies a perfectly preserved dinner roll.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Folks, I think we have a clerical error.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Gwendolyn lowers her handkerchief.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Stares at the roll.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Oh, thank God.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Pardon?", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Pickle's in the car.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": ["brightly"], "dual": false, "present": [0, 1]}]}