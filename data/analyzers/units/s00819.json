{"scene_id": "s00819", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00819.fountain", "heading": "INT. BARBERSHOP - GHOST TOWN OF DRY CREEK - NOON", "cast": [{"id": 0, "name": "HAIRCUT", "names": ["HAIRCUT"], "gender": "?", "first": 3, "spoke": 0}, {"id": 1, "name": "NATHANIEL CROWFOOT", "names": ["NATHANIEL CROWFOOT", "NATHANIEL"], "gender": "m", "first": 4, "spoke": 8}, {"id": 2, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 5, "spoke": 3}, {"id": 3, "name": "TOMMY LIGHTFOOT", "names": ["TOMMY LIGHTFOOT"], "gender": "m", "first": 6, "spoke": 0}, {"id": 4, "name": "JEDEDIAH", "names": ["JEDEDIAH"], "gender": "m", "first": 14, "spoke": 3}, {"id": 5, "name": "SHERIFF AMOS WHITCOMBE", "names": ["SHERIFF AMOS WHITCOMBE", "SHERIFF"], "gender": "m", "first": 22, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. BARBERSHOP - GHOST TOWN OF DRY CREEK - NOON", "present": []}, {"u": 1, "kind": "action", "text": "Dust on every surface.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "One chair, one mirror.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A hand-painted sign in the window reads \"SHAVE AND A HAIRCUT, TWO BITS.\"", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "NATHANIEL CROWFOOT, 50s, barber, apron over his vest, strops a razor on a leather belt.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "A STRANGER, 40s, black hat tipped low, sits in the chair under a white sheet.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "A young boy, TOMMY LIGHTFOOT, 12, sweeps the floor with a broom taller than he is.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Close shave?", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Close.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "You passing through?", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Looking for a man.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Nathaniel lathers his brush.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "The boy stops sweeping.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Name?", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Jedediah Kane.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "The brush stops mid-air.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Tommy looks at Nathaniel.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Nathaniel looks at the mirror, at the stranger's eyes.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Never heard of him.", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "That's funny. Folks say he gets his hair cut here.", "name": "JEDEDIAH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Folks say a lot of things.", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "The bell on the door jingles.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "SHERIFF AMOS WHITCOMBE, 60s, steps in, hand on his holster.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Nathaniel. Boy. Everyone breathing?", "name": "SHERIFF", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Barely.", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "That's an interesting hat.", "name": "SHERIFF", "speaker": 5, "ext": [], "paren": ["to Jedediah"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "It keeps the sun off.", "name": "JEDEDIAH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "There's no sun in here.", "name": "SHERIFF", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "It keeps my thoughts in.", "name": "JEDEDIAH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "The sheriff draws.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Jedediah flings the sheet and rises from the chair, razor in his hand.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Nathaniel catches his wrist.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "They tangle.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "The gun fires into the ceiling.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Plaster rains.", "para": 5, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Tommy dives behind the broom.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Nathaniel wrenches the razor free and presses it to Jedediah's throat.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "The sheriff levels his pistol at both.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Nathaniel, let him go.", "name": "SHERIFF", "speaker": 5, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Which one?", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Either.", "name": "SHERIFF", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Beat.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Nathaniel lowers the razor.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Wipes it on his apron.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Shave's on the house.", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}