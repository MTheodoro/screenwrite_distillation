{"scene_id": "s00830", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00830.fountain", "heading": "EXT. DRY CREEK BED - NOON", "cast": [{"id": 0, "name": "JEB HARLAN", "names": ["JEB HARLAN", "JEB"], "gender": "?", "first": 4, "spoke": 3}, {"id": 1, "name": "CYRUS DOYLE", "names": ["CYRUS DOYLE", "CYRUS"], "gender": "?", "first": 5, "spoke": 3}, {"id": 2, "name": "RUTHIE", "names": ["RUTHIE"], "gender": "?", "first": 8, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DRY CREEK BED - NOON", "present": []}, {"u": 1, "kind": "action", "text": "Heat.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cicadas.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A dead mule.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "JEB HARLAN, 40s, crouches behind it, rifle up.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across the gully, CYRUS DOYLE, 40s, flat on his belly in the sage.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Both unshaven.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Both in gray hats.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Boys! Y'all dead yet?", "name": "RUTHIE", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Jeb flinches.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Cyrus doesn't.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Ruthie, stay in the wagon!", "name": "JEB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Wagon's on fire!", "name": "RUTHIE", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Smoke rolls over the ridge.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "He stands, then drops.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "A shot kicks dust off the mule.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "He fires back.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Nothing moves in the sage.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "You hit?", "name": "CYRUS", "speaker": 1, "ext": [], "paren": ["hoarse"], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "No. You?", "name": "JEB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Hell if I know.", "name": "CYRUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "He crawls to the lip of the bank.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "He sees the other one's hat.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "He grins, ugly.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "That's my hat.", "name": "JEB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "It was on the ground.", "name": "CYRUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Another shot.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Both duck.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "The mule groans, then settles.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Cyrus! He's lying. Jeb never fired a round!", "name": "RUTHIE", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "He turns his rifle toward Ruthie's voice.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The other one's barrel follows his.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "They hold like that, sweat running, the smoke thickening.", "para": 7, "sent": 2, "present": [0, 1, 2]}]}