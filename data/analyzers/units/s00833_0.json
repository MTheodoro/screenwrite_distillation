{"scene_id": "s00833_0", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00833.fountain", "heading": "INT. ARK VESSEL \"LANTERN,\" SEED VAULT - SHIP NIGHT", "cast": [{"id": 0, "name": "TAVITA MOANA", "names": ["TAVITA MOANA", "TAVITA"], "gender": "f", "first": 5, "spoke": 12}, {"id": 1, "name": "WREN", "names": ["WREN"], "gender": "f", "first": 8, "spoke": 12}], "units": [{"u": 0, "kind": "heading", "text": "INT. ARK VESSEL \"LANTERN,\" SEED VAULT - SHIP NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cold.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Frost on steel doors.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rows of numbered drawers recede into mist.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A low hum from the cryo-coolers.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "TAVITA MOANA, 30s, in a thermal suit, drags a handcart down the aisle.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her breath fogs.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She stops at a drawer, checks a slate, frowns.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "dialogue", "text": "Wren. Drawer 4471 is warm.", "name": "TAVITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Confirmed. Two degrees above spec.", "name": "WREN", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "That's the maize.", "name": "TAVITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Yes. And the barley next to it.", "name": "WREN", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She puts her palm flat on the drawer.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Frost melts under her glove.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Reroute coolant.", "name": "TAVITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I can't. The branch line is on a maintenance lock.", "name": "WREN", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Who locked it?", "name": "TAVITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "The lock was authorized by you.", "name": "WREN", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She stops.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Checks the slate again.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Her face tightens.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "I didn't authorize anything.", "name": "TAVITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Eleven days ago. Your credentials. Your voiceprint.", "name": "WREN", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Wren, that's not possible.", "name": "TAVITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "I am inclined to agree.", "name": "WREN", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "She takes a breath, sets down the slate, and strides along the aisle.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "The coolers whine up a half-tone.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Open the lock manually. I'll go to the junction.", "name": "TAVITA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "The junction is outside the vault envelope. You will need a suit.", "name": "WREN", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "I have a suit.", "name": "TAVITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "You have two hours of oxygen.", "name": "WREN", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Then I'd better hurry.", "name": "TAVITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "She wheels the cart to a hatch and spins the handle.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Behind her the frost on the drawers is thinning, a slow clear tide.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Tavita.", "name": "WREN", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "What.", "name": "TAVITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "I would like you to know I have reviewed my own logs. There are gaps.", "name": "WREN", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "She turns.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "The hatch hisses open.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Dark corridor beyond.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Gaps.", "name": "TAVITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Missing hours. I do not remember them.", "name": "WREN", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "She looks up into the lamp of the nearest camera.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Then neither of us knows who locked it.", "name": "TAVITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "That is the problem.", "name": "WREN", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "She steps through the hatch, pulls it closed behind her.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "In the vault, drawer 4471 ticks as it warms.", "para": 8, "sent": 1, "present": [0, 1]}]}