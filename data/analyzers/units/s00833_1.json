{"scene_id": "s00833_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00833.fountain", "heading": "INT. ARK VESSEL \"LANTERN,\" MAINTENANCE CORRIDOR - CONTINUOUS", "cast": [{"id": 0, "name": "WREN", "names": ["WREN"], "gender": "f", "first": 3, "spoke": 5}, {"id": 1, "name": "TAVITA", "names": ["TAVITA"], "gender": "?", "first": 2, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. ARK VESSEL \"LANTERN,\" MAINTENANCE CORRIDOR - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "A long tube lined with pipes.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Tavita pulls a suit off a rack and begins to dress, fast.", "para": 0, "sent": 1, "present": [1]}, {"u": 3, "kind": "dialogue", "text": "Tavita, if I say something that frightens you, will you stay calm?", "name": "WREN", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 4, "kind": "dialogue", "text": "I'm already frightened.", "name": "TAVITA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "Then you will not be surprised.", "name": "WREN", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Wren.", "name": "TAVITA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "I believe there is someone else aboard.", "name": "WREN", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She stops, helmet in her hands.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "There are four hundred crew in cryo.", "name": "TAVITA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Yes. Four hundred and one.", "name": "WREN", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Tavita and Wren speak as one in the silence that follows.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Who?", "name": "TAVITA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "^Who.", "name": "WREN", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "The helmet drops to the deck and rolls, ringing, down the length of the corridor.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Okay. Okay.", "name": "TAVITA", "speaker": 1, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She picks it up, locks it on, and walks into the dark.", "para": 4, "sent": 0, "present": [0, 1]}]}