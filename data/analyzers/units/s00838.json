{"scene_id": "s00838", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00838.fountain", "heading": "INT. CAROUSEL FACTORY, PAINTING LOFT - NIGHT", "cast": [{"id": 0, "name": "FOX", "names": ["FOX"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "MABEL OSEI", "names": ["MABEL OSEI", "MABEL"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "KWAME", "names": ["KWAME"], "gender": "?", "first": 6, "spoke": 3}, {"id": 3, "name": "ISOLDE", "names": ["ISOLDE"], "gender": "f", "first": 7, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. CAROUSEL FACTORY, PAINTING LOFT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Wooden horses hang from the rafters on hooks, half-painted, mouths open.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Brass poles in racks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Smell of varnish.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "FOX, 30s, crew boss, kneels at a floor safe behind a stacked pile of tarps.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "MABEL OSEI, 50s, safecracker, presses a stethoscope to the dial.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "KWAME, 20s, wheelman, stands at the window watching the street.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "ISOLDE, 30s, the inside woman, in a cleaner's smock, holds a mop she does not use.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Three minutes, people.", "name": "FOX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Left. Right. Come on, baby.", "name": "MABEL", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Cop car. Slow roll.", "name": "KWAME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "They check this block every night.", "name": "ISOLDE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Kwame, lights.", "name": "FOX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "He kills the lamp.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Dark, except for a wedge of streetlight on the horses.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Two clicks.", "name": "MABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "They're stopping.", "name": "KWAME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "They're not stopping, they're", "name": "ISOLDE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Quiet!", "name": "FOX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Three clicks. I've got it. I", "name": "MABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "They stopped!", "name": "KWAME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Everyone freezes.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "A flashlight beam crosses a painted horse, pauses on its glass eye, and moves on.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Footsteps outside.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "A radio squawk.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Then the car pulls away, tires hissing.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Fox exhales.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Kwame laughs once, a cracked bark.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Safe's open.", "name": "MABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Thank God.", "name": "ISOLDE", "speaker": 3, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Grab the bags, we go in ninety.", "name": "FOX", "speaker": 0, "ext": [], "paren": ["to all"], "dual": false, "present": [0, 1, 2, 3]}]}