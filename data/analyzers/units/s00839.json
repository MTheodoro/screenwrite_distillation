{"scene_id": "s00839", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00839.fountain", "heading": "INT. NIGHT TRAIN \"TRAMONTANA,\" SLEEPER CORRIDOR - NIGHT", "cast": [{"id": 0, "name": "STRANGER", "names": ["STRANGER"], "gender": "m", "first": 4, "spoke": 4}, {"id": 1, "name": "NOOR HADDAD", "names": ["NOOR HADDAD", "NOOR"], "gender": "f", "first": 5, "spoke": 9}, {"id": 2, "name": "LUZIA", "names": ["LUZIA"], "gender": "?", "first": 10, "spoke": 5}, {"id": 3, "name": "EMILIO", "names": ["EMILIO"], "gender": "?", "first": 23, "spoke": 2}, {"id": 4, "name": "BARNABY", "names": ["BARNABY"], "gender": "m", "first": 34, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT TRAIN \"TRAMONTANA,\" SLEEPER CORRIDOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Brass fixtures, a narrow carpet, the rattle of rails.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Lamplight swings.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Every door is closed except one.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A STRANGER, thirties, in a gray travel coat, stands outside compartment 7 with his forehead against the glass, watching the dark countryside slide by.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "NOOR HADDAD, thirties, comes out of compartment 8 holding a phone to her ear and a paper cup in the other hand.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "She nearly collides with him.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Sorry!", "name": "NOOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "My fault.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "She grins, waves him off, and lifts the phone again.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Noor? Are you eating?", "name": "LUZIA", "speaker": 2, "ext": ["V.O."], "paren": ["tinny, through phone"], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "M\u00e3e, I am eating.", "name": "NOOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "What are you eating?", "name": "LUZIA", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Noor looks at her cup.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "It holds three olives.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Lunch.", "name": "NOOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "It's midnight.", "name": "LUZIA", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "She covers the phone.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "The stranger is still there, listening, trying not to smile.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Is that your mother?", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Everyone's mother.", "name": "NOOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Mine calls me twice a day. It's a record.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "What's your name, or should I keep calling you \"the man who watches trains\"?", "name": "NOOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Emilio.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Noor.", "name": "NOOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "They shake hands, awkward with the cup, and a tiny olive rolls out onto the carpet.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Both bend to pick it up and knock heads.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Ow.", "name": "EMILIO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Ow!", "name": "NOOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Noor! What was that noise?", "name": "LUZIA", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Nothing, M\u00e3e, a man.", "name": "NOOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Is he handsome?", "name": "LUZIA", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Noor puts the phone against her chest and Emilio pretends to read the evacuation sign.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "The train lurches.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "The door of compartment 7 slides open and BARNABY, sixty, in a conductor's cap, steps out with a clipboard.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Tickets, please. Both of you. Wait. Both of you are in the wrong car.", "name": "BARNABY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Noor and Emilio look at each other, then at the tickets they are holding, then at the long corridor.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "So we're lost.", "name": "EMILIO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Together.", "name": "NOOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Barnaby clears his throat and stamps both tickets with a firm thump, and neither of them argues.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}]}