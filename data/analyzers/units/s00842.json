{"scene_id": "s00842", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00842.fountain", "heading": "INT. GRAND MERIDIAN HOTEL - SUBLEVEL LAUNDRY - NIGHT", "cast": [{"id": 0, "name": "CALLOWAY", "names": ["CALLOWAY"], "gender": "m", "first": 4, "spoke": 7}, {"id": 1, "name": "SECURITY", "names": ["SECURITY"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "SABINE DUMAS", "names": ["SABINE DUMAS", "SABINE"], "gender": "f", "first": 5, "spoke": 6}, {"id": 3, "name": "REUBEN OKAFOR", "names": ["REUBEN OKAFOR", "REUBEN"], "gender": "m", "first": 6, "spoke": 4}, {"id": 4, "name": "TANSY BRIGHT", "names": ["TANSY BRIGHT", "TANSY"], "gender": "f", "first": 7, "spoke": 11}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRAND MERIDIAN HOTEL - SUBLEVEL LAUNDRY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Industrial washers thunder in rows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Steam curls along pipes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Carts of white linen stand in the aisles like silent ghosts.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CALLOWAY, fifties, a quiet man in a charcoal suit with a hotel badge that says SECURITY, leans on a dryer reading a folded newspaper.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "SABINE DUMAS, thirties, in a laundry uniform, loads sheets into a washer, never faster than necessary.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "REUBEN OKAFOR, twenties, a bellhop, sits on a laundry cart eating a sandwich.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "TANSY BRIGHT, forties, in a conference lanyard, hovers near the stairs.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "He turns a page.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "She slams a washer door.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Reuben chews.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Excuse me. I think I took a wrong turn.", "name": "TANSY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Guests aren't allowed down here.", "name": "SABINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "I know. I'm sorry. I was looking for the ice machine.", "name": "TANSY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Third floor.", "name": "CALLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "I'm on the third floor.", "name": "TANSY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Calloway folds his newspaper.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Sabine finishes loading and stands straight.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Reuben sets down his sandwich.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Sabine, the thing from the Hartley party.", "name": "REUBEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Not now.", "name": "SABINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "He'll want to know where", "name": "REUBEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Reuben, not now.", "name": "SABINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "He swings off the cart.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Calloway takes a step toward Tansy, hands open, friendly.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Ma'am, I can walk you up.", "name": "CALLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "That's not necessary.", "name": "TANSY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "I insist.", "name": "CALLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Tansy turns toward the stairs.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Sabine moves to block her.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "The washers pound on.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Please move.", "name": "TANSY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "^Please wait.", "name": "SABINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Two voices, one beat.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Calloway sighs and slides the newspaper into his jacket.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Tansy Bright. Conference B. You gave a talk on supply chain integrity this afternoon.", "name": "CALLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "How did you", "name": "TANSY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "We read the program.", "name": "CALLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "She glances from him to Sabine to Reuben.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Her hand finds the stair rail.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "I'd like to leave now.", "name": "TANSY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Sure. We just want to ask one thing.", "name": "REUBEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "What did you see in the east elevator this afternoon?", "name": "SABINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Nothing.", "name": "TANSY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "That's a very fast answer.", "name": "CALLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "It's the true one.", "name": "TANSY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Ms. Bright, we're not the police.", "name": "REUBEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "That's what worries me.", "name": "TANSY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Calloway nods slowly.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "He crosses to a washer and pulls the handle.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "The door swings open, and steam rolls out.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Inside, among the sheets, a conference lanyard hangs from a hook.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "Is that yours?", "name": "SABINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Tansy looks at her own lanyard.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "Then at the one in the machine.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "The numbers match.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "I don't understand.", "name": "TANSY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "Neither did the last one.", "name": "CALLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "He closes the door.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "The washers keep running.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "Nobody moves.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}]}