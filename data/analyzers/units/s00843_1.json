{"scene_id": "s00843_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00843.fountain", "heading": "INT. SCHOOL BUS - CONTINUOUS", "cast": [{"id": 0, "name": "MARGIT", "names": ["MARGIT"], "gender": "m", "first": 2, "spoke": 4}, {"id": 1, "name": "DEX", "names": ["DEX"], "gender": "m", "first": 3, "spoke": 4}, {"id": 2, "name": "LOLA", "names": ["LOLA"], "gender": "f", "first": 4, "spoke": 2}, {"id": 3, "name": "PELL", "names": ["PELL", "MR. PELL"], "gender": "m", "first": 28, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. SCHOOL BUS - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Seats torn, windows fogged.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "MARGIT, 17, in a track jacket, crouches in the aisle with a flashlight.", "para": 0, "sent": 1, "present": [0]}, {"u": 3, "kind": "action", "text": "DEX, 18, driver's license barely dry, grips the wheel.", "para": 0, "sent": 2, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "LOLA, 12, his sister, sits in the first seat, knees to chest.", "para": 0, "sent": 3, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "Engine's dead.", "name": "DEX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Try again.", "name": "MARGIT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "He turns the key.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Click.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Click.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Dex. I don't like this.", "name": "LOLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Lola, it's a bus. We're fine.", "name": "DEX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Dex. Look.", "name": "MARGIT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Out the windshield, shapes in the fog.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Tall.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Still.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "A row of figures standing on the lakebed, facing the bus.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Scarecrows.", "name": "DEX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Not scarecrows.", "name": "MARGIT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "They're closer.", "name": "LOLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Dex slaps the wheel.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "He locks the door and cranks the key.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Click.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Click.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Margit kills the flashlight.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "The figures do not move.", "para": 3, "sent": 5, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The fog thickens.", "para": 3, "sent": 6, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "A tap on the glass.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "MR. PELL, sixty, their old bus driver, in his gray uniform, stands at the door with a lantern.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "His lips are blue.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Kids. Open up.", "name": "MR. PELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Mr. Pell? You retired.", "name": "DEX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "I did.", "name": "MR. PELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Margit looks at his boots.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "They are covered in dry mud, but his footprints end at the bus step.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "No prints behind him.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Dex. Don't.", "name": "MARGIT", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Lola grabs her sleeve.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Dex's hand hovers over the door lever.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "It's cold, Dex. Open up.", "name": "MR. PELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}