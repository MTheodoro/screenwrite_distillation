{"scene_id": "s00848", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00848.fountain", "heading": "INT. DESALINATION PLATFORM \"KESTREL REEF,\" DORMITORY GALLEY - NIGHT", "cast": [{"id": 0, "name": "PERPETUA LOWE", "names": ["PERPETUA LOWE", "PERPETUA"], "gender": "f", "first": 5, "spoke": 12}, {"id": 1, "name": "YOSHIRO ABE", "names": ["YOSHIRO ABE", "YOSHIRO"], "gender": "m", "first": 6, "spoke": 8}, {"id": 2, "name": "THE STRANGER", "names": ["STRANGER", "THE STRANGER"], "gender": "f", "first": 7, "spoke": 1}, {"id": 3, "name": "ADEBOLA", "names": ["ADEBOLA"], "gender": "?", "first": 24, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. DESALINATION PLATFORM \"KESTREL REEF,\" DORMITORY GALLEY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A steel room bolted to the open sea.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Portholes show black water and the white scrawl of waves.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A table, three stools, a kettle that screams on a hotplate.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Everything slightly damp.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "PERPETUA LOWE, fifties, platform superintendent, scrapes burnt toast over the sink.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "YOSHIRO ABE, thirties, the pump engineer, sits slumped at the table with his boots off.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Across from him sits a young woman in a borrowed hoodie, her hair wet, a blanket around her shoulders: THE STRANGER, early twenties.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "She holds a mug with both hands and has not spoken since the supply boat left her here.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Tea or something stronger?", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "The stranger shakes her head.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "She hasn't said a word.", "name": "YOSHIRO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "She doesn't have to. She's drinking our tea.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "The kettle shrieks.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Perpetua lifts it off the plate.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "The platform groans against a swell, and the tea in the mug trembles in rings.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Supply boat's not back till Thursday.", "name": "YOSHIRO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Then she's our guest till Thursday.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Perp, we don't have a bunk.", "name": "YOSHIRO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Take mine.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I can't take", "name": "YOSHIRO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Yoshiro.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "He raises both hands in surrender.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "The stranger sets down her mug and, for the first time, looks up at them.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Adebola.", "name": "THE STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Perpetua and Yoshiro turn.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "The word hangs in the steam.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Pardon?", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "My name. Adebola Nwosu.", "name": "ADEBOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Nice to meet you, Adebola.", "name": "YOSHIRO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "I should say I did not fall off the boat.", "name": "ADEBOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Did anyone say you did?", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "I think you wondered.", "name": "ADEBOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Perpetua sets down the toast and wipes her hands on her trousers, slowly, one finger at a time.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "We wondered.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "I walked off it.", "name": "ADEBOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Walked off a moving boat.", "name": "YOSHIRO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Into the sea, and then I swam here. It took a long time.", "name": "ADEBOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "The room is very quiet.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "A pipe knocks in the wall.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Yoshiro opens his mouth, closes it again.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Why?", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Adebola turns the mug a quarter-turn on the table.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "I wanted to see if the platform was real. If anyone really lived out here.", "name": "ADEBOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "And?", "name": "YOSHIRO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Someone made me tea.", "name": "ADEBOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Perpetua laughs, a startled bark.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Then she pulls up a stool and sits.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Yoshiro, pour her another cup.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "He fills it.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Steam rises.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "The kettle ticks as it cools.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Outside, the sea keeps its slow business.", "para": 10, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Adebola, you're going to want to eat something.", "name": "PERPETUA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "I would like that.", "name": "ADEBOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "We have toast.", "name": "YOSHIRO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "It's burnt.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "I will eat it burnt.", "name": "ADEBOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}