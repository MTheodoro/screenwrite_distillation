{"scene_id": "s00849", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00849.fountain", "heading": "INT. CENTRAL TELEPHONE EXCHANGE, SWITCHBOARD ROOM - 1912 - NIGHT", "cast": [{"id": 0, "name": "CLEMENTINE VOSS", "names": ["CLEMENTINE VOSS", "CLEMENTINE"], "gender": "?", "first": 4, "spoke": 7}, {"id": 1, "name": "ASHWORTH", "names": ["ASHWORTH"], "gender": "?", "first": 16, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. CENTRAL TELEPHONE EXCHANGE, SWITCHBOARD ROOM - 1912 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Rows of brass jacks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cords dangle like vines.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A gas lamp hisses.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CLEMENTINE VOSS, twenty, headset clamped over a bun, plugs a cord into a jack.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Pulls another.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Hands blur.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "dialogue", "text": "Number, please.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 8, "kind": "action", "text": "She listens.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Smiles, small.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "Connects the call.", "para": 2, "sent": 2, "present": [0]}, {"u": 11, "kind": "dialogue", "text": "Go ahead, caller.", "name": "CLEMENTINE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 12, "kind": "action", "text": "A light flares on the board.", "para": 3, "sent": 0, "present": [0]}, {"u": 13, "kind": "action", "text": "Another.", "para": 3, "sent": 1, "present": [0]}, {"u": 14, "kind": "action", "text": "She works faster.", "para": 3, "sent": 2, "present": [0]}, {"u": 15, "kind": "action", "text": "The door opens.", "para": 4, "sent": 0, "present": [0]}, {"u": 16, "kind": "action", "text": "MR. ASHWORTH, fifties, supervisor, in a stiff collar and pince-nez, steps in with a folded paper.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He doesn't greet her.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Miss Voss.", "name": "ASHWORTH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Number, please. Yes, sir?", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "You were seen leaving the building with a gentleman on Tuesday.", "name": "ASHWORTH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She plugs a cord, fingers steady, eyes on the board.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "My brother, sir.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "You have no brother on the register.", "name": "ASHWORTH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Then the register is wrong.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "He sets the paper on her desk.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "She does not look at it.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Another light flares.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "She answers it.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Number, please.", "name": "CLEMENTINE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Miss Voss. I am speaking to you.", "name": "ASHWORTH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "And I am speaking to Mrs. Delaney, sir. Her husband is in hospital.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "He takes a breath.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Straightens his pince-nez.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Then he reaches past her, takes the cord, and gently pulls it out of the jack.", "para": 7, "sent": 2, "present": [0, 1]}]}