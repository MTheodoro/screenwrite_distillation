{"scene_id": "s00850", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00850.fountain", "heading": "INT. ICE FISHING HUT ON FROZEN LAKE - DAY", "cast": [{"id": 0, "name": "WENDELL", "names": ["WENDELL"], "gender": "?", "first": 5, "spoke": 11}, {"id": 1, "name": "BRODSKY", "names": ["BRODSKY"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "TOBY", "names": ["TOBY"], "gender": "m", "first": 6, "spoke": 7}, {"id": 3, "name": "RAY", "names": ["RAY"], "gender": "f", "first": 7, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. ICE FISHING HUT ON FROZEN LAKE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A shack the size of a closet.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Bare wood benches.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A hole in the floor with black water and a bobbing line.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A propane heater ticks.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "WENDELL \"PA\" BRODSKY, sixties, in a quilted vest, sits hunched over the hole with a short rod.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "His grandson TOBY, ten, in a puffy snowsuit, kneels across from him holding a thermos he can barely lift.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "RAYLENE \"RAY\" BRODSKY, sixteen, plugs one ear with an earbud and sulks on the far bench.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Pa, is it a bite?", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Not yet, bud.", "name": "WENDELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "How do you know?", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "The line would twitch.", "name": "WENDELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Toby stares at the line.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "It floats.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "He unscrews the thermos, pours cocoa onto his mitten, and licks it.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Ray rolls her eyes and turns up her music.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "This is so boring.", "name": "RAY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "It's supposed to be.", "name": "WENDELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Then why do it?", "name": "RAY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Because it's quiet.", "name": "WENDELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "It's not quiet. Toby's slurping.", "name": "RAY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "I'm not slurping.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "You are slurping.", "name": "RAY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Wendell lays a hand on the rod.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "He does not look at either of them.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Toby slides closer and pushes the thermos into his grandfather's lap.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Pa, have some.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Thank you, bud.", "name": "WENDELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "He sips.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Wipes his mustache with the back of his glove.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "The heater ticks.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "A breath of wind pushes at the door, and the hut shivers.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Pa, how long did Grandma fish with you?", "name": "RAY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Forty years.", "name": "WENDELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Did she think it was boring?", "name": "RAY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Every winter.", "name": "WENDELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Then why'd she come?", "name": "RAY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Because I did.", "name": "WENDELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Ray lowers the earbud.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "She looks at the hole in the floor, the black circle, and the line sitting in the middle of it like a thin white thread.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Pa. Pa! It twitched.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Hold on, bud.", "name": "WENDELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "It did! I saw!", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Ray slides off her bench onto her knees beside him and Toby, and the three of them lean over the hole, nearly touching heads.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "The line dips once.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Then goes still.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "False alarm.", "name": "RAY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "It twitched.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "It's thinking about it.", "name": "WENDELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "They wait.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "The heater ticks.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Toby's head sinks onto Wendell's shoulder.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Ray lets the earbud dangle.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Pa?", "name": "RAY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Mm.", "name": "WENDELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "This isn't that boring.", "name": "RAY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "He doesn't answer.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "He just watches the line, and the corner of his mustache moves.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}]}