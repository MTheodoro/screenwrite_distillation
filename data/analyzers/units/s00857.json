{"scene_id": "s00857", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00857.fountain", "heading": "INT. ASHER GOLDBERG'S APARTMENT, KITCHEN - NIGHT", "cast": [{"id": 0, "name": "LEONIE GOLDBERG", "names": ["LEONIE GOLDBERG", "LEONIE"], "gender": "f", "first": 3, "spoke": 8}, {"id": 1, "name": "ASHER", "names": ["ASHER"], "gender": "?", "first": 7, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. ASHER GOLDBERG'S APARTMENT, KITCHEN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A narrow galley kitchen with stacked dishes, peeling wallpaper, a calendar from a plumbing company dated three years ago.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rain on the window.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "LEONIE GOLDBERG, thirties, in her work blazer and a coat still buttoned, stands at the counter unpacking a paper bag of groceries.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "She sets down a loaf, a carton of milk, a box of pills, reads the label, and shelves it with the others in a row she has clearly arranged many times before.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "action", "text": "From the bedroom down the hall comes a cough, deep and rough.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Then a man's voice.", "para": 2, "sent": 1, "present": [0]}, {"u": 7, "kind": "dialogue", "text": "Leonie?", "name": "ASHER", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "I'm here, Papa.", "name": "LEONIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Did you bring the soup?", "name": "ASHER", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I brought the other soup.", "name": "LEONIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Not the tomato.", "name": "ASHER", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Mushroom.", "name": "LEONIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Bah.", "name": "ASHER", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She turns on the stove, fills a pot, and breaks the can open with a bright little clack.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She stirs.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Steam rises.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "The cough comes again from the bedroom and this time lasts, and she stops stirring and stands with the spoon above the pot, listening to every second of it.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Papa, are you all right?", "name": "LEONIE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Fine. I'm fine. Where's your brother?", "name": "ASHER", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She sets the spoon on the rest, wipes her hands on a dish towel, folds it in half, and folds it again.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Danny's in Phoenix. He said he'd call.", "name": "LEONIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "He says a lot of things.", "name": "ASHER", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "I know.", "name": "LEONIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She walks down the hallway, past a wall of framed photographs, past the bathroom with its door open, past a pair of slippers on the carpet.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "She stops at the bedroom door.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "The light inside is dim.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "She raises her hand to knock, then lowers it, and instead rests her palm flat against the wood.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Leonie, are you standing there?", "name": "ASHER", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "No.", "name": "LEONIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "I can see your shadow under the door.", "name": "ASHER", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "She laughs, brief and wet, and pushes the door open.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Mushroom or nothing, Papa.", "name": "LEONIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Mushroom.", "name": "ASHER", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}]}