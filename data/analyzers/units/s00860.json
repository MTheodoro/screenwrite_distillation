{"scene_id": "s00860", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00860.fountain", "heading": "INT. COMMUNITY POTTERY STUDIO, KILN SHED - DUSK", "cast": [{"id": 0, "name": "GIDEON ROSS", "names": ["GIDEON ROSS", "GIDEON"], "gender": "?", "first": 5, "spoke": 10}, {"id": 1, "name": "MARTA ROSS", "names": ["MARTA ROSS", "MARTA"], "gender": "f", "first": 5, "spoke": 11}], "units": [{"u": 0, "kind": "heading", "text": "INT. COMMUNITY POTTERY STUDIO, KILN SHED - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "A low brick room with a roaring gas kiln at one end.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The air shimmers.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Shelves of unfired mugs line the walls.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Bags of clay are stacked like sandbags.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "GIDEON ROSS, fifties, in a stained apron, kneels by the kiln peeking through a spy hole.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "MARTA ROSS, fifties, his ex-wife, stands by the door holding a cardboard box.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "I brought your things.", "name": "MARTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Leave them by the door.", "name": "GIDEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I'd rather hand them to you.", "name": "MARTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I'm firing.", "name": "GIDEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I can see that.", "name": "MARTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He doesn't turn.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She sets the box on a stool and takes out a framed photograph, a coat, a paperback with a cracked spine.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She places each item on the table, one by one, with the care of someone laying out a corpse.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "What's the coat for?", "name": "GIDEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "It's your coat.", "name": "MARTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "It's July.", "name": "GIDEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "It'll be winter eventually.", "name": "MARTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He closes the spy hole, stands, wipes his hands on his apron.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Neither looks at the other.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "The kiln roars on.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "A mug cracks inside with a faint, sharp tick.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "That's one gone.", "name": "GIDEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Only one?", "name": "MARTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "So far.", "name": "GIDEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "She laughs without humor, then stops.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "He walks to the table and picks up the photograph.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "In it, two young people squint into the sun on a beach.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "I couldn't throw it out.", "name": "MARTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "^I couldn't keep it.", "name": "GIDEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "They say it at once.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Both freeze.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "The kiln's glow washes the room orange.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Marta takes a step back, sits on the stool, and puts her hands over her face.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Marta.", "name": "GIDEON", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Don't. Please. Just let me have a minute.", "name": "MARTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "He puts the photograph down gently, face up, between the coat and the book.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "He goes back to the kiln and kneels.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "He waits.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "The fire waits with him.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "How long till it's done?", "name": "MARTA", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Eleven hours.", "name": "GIDEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "That's a long time.", "name": "MARTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "It is.", "name": "GIDEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "She lowers her hands.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "She stands, takes the stool he's been using as a seat, and moves it beside him.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "I can stay till the first one cracks.", "name": "MARTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}