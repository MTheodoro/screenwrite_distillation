{"scene_id": "s00861", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00861.fountain", "heading": "INT. LAKESIDE CABIN, LIVING ROOM - EVENING", "cast": [{"id": 0, "name": "EVANDER", "names": ["EVANDER"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "CLARISSA", "names": ["CLARISSA"], "gender": "f", "first": 5, "spoke": 5}, {"id": 2, "name": "BEATRIX", "names": ["BEATRIX"], "gender": "?", "first": 5, "spoke": 7}, {"id": 3, "name": "HAMID", "names": ["HAMID"], "gender": "?", "first": 6, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAKESIDE CABIN, LIVING ROOM - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "A woodstove glows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Mismatched armchairs, a bookshelf of paperbacks, a window that frames the dark lake.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A board game sits half-played on the coffee table.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "EVANDER, sixties, the host, in a fisherman's sweater, pours wine from a dusty bottle.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "CLARISSA, forties, his daughter, sits beside her sister BEATRIX, forties, who holds a game piece between two fingers.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "HAMID, thirties, Clarissa's quiet husband, reads the rules aloud.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Everyone's glass full?", "name": "EVANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Yes, Papa.", "name": "CLARISSA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Mine's not.", "name": "BEATRIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Because you don't drink.", "name": "EVANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I can still hold it.", "name": "BEATRIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "He tops hers off.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "She sets it on the table and doesn't touch it.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Clarissa watches her, then looks away.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Hamid rolls the dice, slow, careful.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Six.", "name": "HAMID", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Seven! You moved seven.", "name": "CLARISSA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "I moved six.", "name": "HAMID", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "He moved six, Clarissa.", "name": "BEATRIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "She always sides with him.", "name": "CLARISSA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Girls, please.", "name": "EVANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Papa, I need to tell you something.", "name": "BEATRIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Not now, Bea.", "name": "CLARISSA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "What is it?", "name": "EVANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "I", "name": "BEATRIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "She's not feeling well.", "name": "CLARISSA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "I'm perfectly well, Clarissa, I'm trying to", "name": "BEATRIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Maybe we let her speak.", "name": "HAMID", "speaker": 3, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Everyone stops.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "The woodstove ticks.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Evander puts down the bottle and the cork rolls off the table.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Beatrix.", "name": "EVANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "She pushes her glass an inch away.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "She meets her father's eyes for the first time that night.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "I sold the cabin.", "name": "BEATRIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Clarissa lets out a sound that is half laugh, half breath.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Evander does not move at all.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}]}