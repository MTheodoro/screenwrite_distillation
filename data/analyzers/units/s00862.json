{"scene_id": "s00862", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00862.fountain", "heading": "INT. DEFUNCT ICE RINK, \"SYNERGY KICKOFF\" - DAY", "cast": [{"id": 0, "name": "COLM", "names": ["COLM"], "gender": "?", "first": 7, "spoke": 25}, {"id": 1, "name": "ANNELIESE", "names": ["ANNELIESE"], "gender": "?", "first": 8, "spoke": 8}, {"id": 2, "name": "DORCAS", "names": ["DORCAS"], "gender": "?", "first": 11, "spoke": 8}, {"id": 3, "name": "VIKRAM", "names": ["VIKRAM"], "gender": "?", "first": 13, "spoke": 7}, {"id": 4, "name": "PENROSE", "names": ["PENROSE"], "gender": "?", "first": 16, "spoke": 9}, {"id": 5, "name": "YUSRA", "names": ["YUSRA"], "gender": "?", "first": 20, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. DEFUNCT ICE RINK, \"SYNERGY KICKOFF\" - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A chilly arena with dead floodlights and a Zamboni parked in the corner like a retired elephant.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Folding chairs in a semicircle.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A banner: \"WE ARE ONE TEAM.\"", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A podium with a microphone that squeals.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Six people sit with lukewarm coffee and laminated agendas.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "On the ice-less floor, where the center circle once glowed, a flip chart waits on a tripod.", "para": 1, "sent": 1, "present": []}, {"u": 7, "kind": "dialogue", "text": "Okay, welcome everybody. Can everyone hear me?", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 8, "kind": "dialogue", "text": "Yes.", "name": "ANNELIESE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Great. Anneliese, you can hear me?", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I said yes.", "name": "ANNELIESE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "We could hear you in the car park.", "name": "DORCAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Wonderful. So today's theme is...", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Alignment.", "name": "VIKRAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Alignment, exactly, Vikram, thank you for that.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "It's on the banner. Well, \"one team\" is. Alignment is on the agenda.", "name": "VIKRAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "I thought today's theme was resilience.", "name": "PENROSE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "It's both.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "They're different words.", "name": "PENROSE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "They're complementary words.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Can I ask something?", "name": "YUSRA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Of course, Yusra, we love questions.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Why are we here? In the rink?", "name": "YUSRA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "It's a neutral space.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "It's a cold space.", "name": "DORCAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "It builds character.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "My feet have no character left.", "name": "ANNELIESE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "I read the invitation twice. It said \"off-site.\"", "name": "PENROSE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "It is off-site.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "From what?", "name": "VIKRAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "From our usual site.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Which is across the street.", "name": "YUSRA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Which is a bit literal, Yusra.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "I'm literal on Mondays.", "name": "YUSRA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "It's Friday.", "name": "DORCAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "I'm literal in general.", "name": "YUSRA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Okay, let's move to the first exercise.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Is there a second exercise?", "name": "ANNELIESE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "There are four.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "I have a flight.", "name": "PENROSE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Penrose, your flight is at eight.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "This morning.", "name": "PENROSE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "No, tonight.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "It says eight a.m. on the ticket.", "name": "PENROSE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "I'm sure you misread it.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "I'm sure I didn't.", "name": "PENROSE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Could we maybe start with a break?", "name": "VIKRAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "We've only just started.", "name": "DORCAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "That's why we need a break.", "name": "VIKRAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "Let's table that.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "Where? There's no table.", "name": "ANNELIESE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "Colm, I think the Zamboni is leaking.", "name": "YUSRA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "It's a feature.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "It's a hazard.", "name": "PENROSE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "Everything's a hazard if you look at it right.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "Then maybe don't make us look.", "name": "DORCAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "Dorcas.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "I'm only saying.", "name": "DORCAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "dialogue", "text": "Colm, can we have a vote?", "name": "ANNELIESE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "On what?", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "On whether to leave.", "name": "ANNELIESE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "dialogue", "text": "That's not on the agenda.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "dialogue", "text": "Neither is the cold.", "name": "VIKRAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "dialogue", "text": "I vote leave.", "name": "YUSRA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "dialogue", "text": "Leave.", "name": "PENROSE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "dialogue", "text": "Leave.", "name": "DORCAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "dialogue", "text": "Leave.", "name": "VIKRAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "dialogue", "text": "Leave, obviously.", "name": "ANNELIESE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "dialogue", "text": "Okay. Okay. Show of hands for staying?", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "dialogue", "text": "Just me, then.", "name": "COLM", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "dialogue", "text": "We'll tell them you were wonderful.", "name": "DORCAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}