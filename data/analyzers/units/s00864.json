{"scene_id": "s00864", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00864.fountain", "heading": "INT. HESTER'S KITCHEN, FARMHOUSE - EARLY EVENING", "cast": [{"id": 0, "name": "HESTER VANDERBILT", "names": ["HESTER VANDERBILT", "HESTER"], "gender": "f", "first": 4, "spoke": 6}, {"id": 1, "name": "BAXTER", "names": ["BAXTER"], "gender": "m", "first": 5, "spoke": 2}, {"id": 2, "name": "IMOGEN", "names": ["IMOGEN"], "gender": "?", "first": 5, "spoke": 3}, {"id": 3, "name": "KENJI", "names": ["KENJI"], "gender": "m", "first": 5, "spoke": 1}, {"id": 4, "name": "ROSALBA", "names": ["ROSALBA"], "gender": "f", "first": 6, "spoke": 2}, {"id": 5, "name": "TAVISH", "names": ["TAVISH"], "gender": "?", "first": 6, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. HESTER'S KITCHEN, FARMHOUSE - EARLY EVENING", "present": []}, {"u": 1, "kind": "action", "text": "A low-beamed room, copper pots on hooks, a scrubbed pine table crowded with mismatched plates.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Steam fogs the window.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cat sleeps on the radiator.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "HESTER VANDERBILT, eighties, hunched in a flowered apron, stirs a pot with a wooden spoon.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "At the table sit her grandchildren: BAXTER, forty, in a rumpled suit; IMOGEN, thirty-five, with a toddler's drawing pinned to her cardigan; KENJI, thirty, fresh off a plane, backpack still on.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "action", "text": "Her great-grandchildren ROSALBA, eight, and TAVISH, five, kneel on their chairs, arranging peas into a pattern.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 7, "kind": "dialogue", "text": "Everyone sit properly.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "dialogue", "text": "We are, Granny Hess.", "name": "ROSALBA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "I'm sitting with my knees.", "name": "TAVISH", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Tavish, honey, on your bottom.", "name": "IMOGEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "He turns around, grinning, and sits on his bottom.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "Rosalba rolls her eyes and slides a pea toward him.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "Baxter looks at his phone.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "Kenji glances at Baxter, then at the phone, then at his plate.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Hester sets down the pot with a thump.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Baxter. The phone.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Granny, it's work.", "name": "BAXTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "It's Sunday.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "It's always work.", "name": "BAXTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Bax, give it to me.", "name": "KENJI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "He holds out his hand.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Baxter hesitates, then drops the phone in it.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Kenji slips it into his backpack and zips it closed.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Nobody says anything.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Imogen reaches for the potatoes.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "I'll serve.", "name": "IMOGEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Imogen, sit. I'll serve.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Granny", "name": "IMOGEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Sit.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "She sits.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Hester ladles stew into bowls, one by one, her hands shaking slightly.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Tavish watches, wide-eyed.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Rosalba stands and takes the ladle gently from her great-grandmother's hands and finishes the serving herself, with the solemn care of a priest.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Granny Hess, you sit too.", "name": "ROSALBA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Hester lowers herself into the chair at the head of the table.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "The family looks at her, then at one another, and no one reaches for a spoon.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Are we saying thank you?", "name": "TAVISH", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "We are.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "She folds her hands.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Around the table, the others do the same, even Kenji, even Baxter, and the cat on the radiator opens one eye.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}