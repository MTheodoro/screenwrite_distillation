{"scene_id": "s00865", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00865.fountain", "heading": "INT. SUBURBAN KITCHEN - MORNING", "cast": [{"id": 0, "name": "MINA", "names": ["MINA"], "gender": "?", "first": 3, "spoke": 5}, {"id": 1, "name": "GUS", "names": ["GUS"], "gender": "?", "first": 4, "spoke": 3}, {"id": 2, "name": "ROWAN", "names": ["ROWAN"], "gender": "?", "first": 5, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. SUBURBAN KITCHEN - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Cereal boxes, a half-eaten banana, a school permission slip stuck under a magnet.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The radio plays traffic.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "MINA, forties, tosses a lunch bag onto the counter.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "GUS, her father, seventies, stands at the sink drying a mug.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "ROWAN, eleven, her son, sits on a stool with a backpack on his lap, hands tight on the straps.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "She checks her watch.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "He sets down the mug.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "The boy stares at the table.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Rowan, shoes.", "name": "MINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "They're on.", "name": "ROWAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Other shoes.", "name": "MINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "He does not move.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She walks around the counter and crouches in front of him.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "She puts a hand on his knee.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "He pulls it away.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Mina. Let him.", "name": "GUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Dad, we're late.", "name": "MINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "He's not ready.", "name": "GUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "She looks up at her father, then at her son, then at the clock.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "She opens her mouth, closes it, and takes a breath.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Rowan, is it the test?", "name": "MINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "He shakes his head.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "She waits.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The radio moves on to the weather.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Gus takes the backpack from the boy's lap, sets it on the floor, and sits beside him.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "I'll walk you in.", "name": "GUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Rowan nods once.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Mina stands, picks up the lunch bag, and holds it out.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "He takes it.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "I'll pick you up.", "name": "MINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Okay.", "name": "ROWAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "She leans in to kiss his hair, and for the first time he lets her.", "para": 7, "sent": 0, "present": [0, 1, 2]}]}