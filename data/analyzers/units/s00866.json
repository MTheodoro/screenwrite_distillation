{"scene_id": "s00866", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00866.fountain", "heading": "INT. PRESTON & VALE ENTERPRISES, OPEN OFFICE - DAY", "cast": [{"id": 0, "name": "TEAM PLAYER", "names": ["TEAM PLAYER"], "gender": "?", "first": 4, "spoke": 0}, {"id": 1, "name": "LYLE FENWICK", "names": ["LYLE FENWICK", "LYLE"], "gender": "m", "first": 6, "spoke": 11}, {"id": 2, "name": "NGOZI ADEYEMI", "names": ["NGOZI ADEYEMI", "NGOZI"], "gender": "f", "first": 7, "spoke": 20}, {"id": 3, "name": "PRESTON VALE", "names": ["PRESTON VALE", "PRESTON"], "gender": "?", "first": 8, "spoke": 14}], "units": [{"u": 0, "kind": "heading", "text": "INT. PRESTON & VALE ENTERPRISES, OPEN OFFICE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Two hundred identical desks stretch toward a wall of frosted glass.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fluorescent lights hum a note somewhere between boredom and dread.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Beige carpet.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A potted fern with a sign: \"THIS PLANT IS A TEAM PLAYER.\"", "para": 0, "sent": 3, "present": [0]}, {"u": 5, "kind": "action", "text": "In the corner, a lone water cooler.", "para": 0, "sent": 4, "present": [0]}, {"u": 6, "kind": "action", "text": "LYLE FENWICK, fifties, pot-bellied, in short sleeves and a clip-on tie, stands at the head of a cluster of desks with a binder.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "NGOZI ADEYEMI, thirties, sharp and unsmiling, sits at her workstation, arms crossed.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "PRESTON VALE, sixties, the CEO, tanned and silver-haired, enters from the glass wall and stands behind Lyle, hands in pockets.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "So, Ngozi, as I was saying, we're just looking at some streamlining.", "name": "LYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "You said that last quarter.", "name": "NGOZI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "And it's still true.", "name": "LYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Last quarter you streamlined Marcia.", "name": "NGOZI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Marcia chose to leave.", "name": "LYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Marcia was escorted out by security with a box of her plants.", "name": "NGOZI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "There was a transition.", "name": "LYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Lyle, let me.", "name": "PRESTON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Of course, sir.", "name": "LYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Ngozi. May I call you Ngozi?", "name": "PRESTON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "It's what's on my badge.", "name": "NGOZI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Good. Good. I'd like to speak candidly. We're a family here.", "name": "PRESTON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Families don't have headcounts.", "name": "NGOZI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Some do.", "name": "PRESTON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Not the good ones.", "name": "NGOZI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Ngozi.", "name": "LYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "It's fine, Lyle. I appreciate directness.", "name": "PRESTON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Then I'll be direct. Is my job gone?", "name": "NGOZI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Your role is being reimagined.", "name": "PRESTON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "By whom?", "name": "NGOZI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "By leadership.", "name": "PRESTON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Which of you?", "name": "NGOZI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Both of us.", "name": "PRESTON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Well", "name": "LYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Both of us, Lyle.", "name": "PRESTON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "So I'll be reimagined into the parking lot.", "name": "NGOZI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "That's not how I'd put it.", "name": "PRESTON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "How would you put it?", "name": "NGOZI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "As an opportunity.", "name": "PRESTON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "For whom?", "name": "NGOZI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "For growth.", "name": "PRESTON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Mine, or yours?", "name": "NGOZI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Preston does not answer.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Lyle clears his throat.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "The fern's sign flutters in the air conditioning.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Say it plainly.", "name": "NGOZI", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Effective Friday.", "name": "PRESTON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Thank you.", "name": "NGOZI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Ngozi, there's a severance package", "name": "LYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "How generous.", "name": "NGOZI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Two weeks.", "name": "LYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "For eleven years.", "name": "NGOZI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "It's competitive.", "name": "PRESTON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "With what? A coupon?", "name": "NGOZI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Please keep your voice", "name": "LYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Down? Why?", "name": "NGOZI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "People are watching.", "name": "LYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Good.", "name": "NGOZI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "She stands.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "The desks around them have gone silent.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "Dozens of heads have turned.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "She looks at her colleagues, then at Preston, then at Lyle, and picks up the fern.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}]}