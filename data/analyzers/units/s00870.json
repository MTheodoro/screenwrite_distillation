{"scene_id": "s00870", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00870.fountain", "heading": "INT. PARKING GARAGE LEVEL P4 - \"SYNERGY SOCIAL\" TENT - DAY", "cast": [{"id": 0, "name": "DESMOND PRUITT", "names": ["DESMOND PRUITT", "DESMOND"], "gender": "?", "first": 5, "spoke": 6}, {"id": 1, "name": "ANOUK VAN DER BERG", "names": ["ANOUK VAN DER BERG", "ANOUK"], "gender": "?", "first": 8, "spoke": 4}, {"id": 2, "name": "TAKESHI ONO", "names": ["TAKESHI ONO", "TAKESHI"], "gender": "?", "first": 11, "spoke": 2}, {"id": 3, "name": "LOLA FERREIRA", "names": ["LOLA FERREIRA", "LOLA"], "gender": "?", "first": 14, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. PARKING GARAGE LEVEL P4 - \"SYNERGY SOCIAL\" TENT - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A pop-up gazebo between two oil stains.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Banner: MANDATORY FUN.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Folding table.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Sheet cake, sweating.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DESMOND PRUITT, 50s, lanyard heavy as a medal.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Clipboard.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Smiles at nobody.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "ANOUK VAN DER BERG, 30s, auditor.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Stabs cake with a plastic knife.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Doesn't look up.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "TAKESHI ONO, 20s, intern.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Hoodie.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Holding a balloon he was told to hold.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "LOLA FERREIRA, 40s, HR.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Headset.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Always mid-sentence.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Welcome, team. Who's having fun?", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "A car alarm chirps two floors up.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Let's circle back on that.", "name": "DESMOND", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Is this billable?", "name": "ANOUK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "No, I'm listening, I'm just also here.", "name": "LOLA", "speaker": 3, "ext": [], "paren": ["into headset"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Takeshi's balloon drifts toward a sprinkler.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "He catches it.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Desmond and Takeshi both freeze.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "That's a safety balloon.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "It's a regular balloon.", "name": "TAKESHI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Compliance says safety.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Anouk slides a slice of cake onto a paper plate.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Lola and Desmond reach for it at once.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "They fight over the plate.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Frosting on a lanyard.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Wellness incident. I'm logging it.", "name": "LOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "You're the logger.", "name": "ANOUK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "I'm logging that I logged.", "name": "LOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "A forklift beeps in reverse.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Everyone looks.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "It goes nowhere.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Do we get to leave?", "name": "TAKESHI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Leave is a strong word.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Ten minutes of fun, then my report.", "name": "ANOUK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "What's in the report?", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Cake. Mostly cake.", "name": "ANOUK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "The group scatters toward their cars, then stops.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Nobody has the right keys.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "They drift back to the table.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Same time next quarter.", "name": "LOLA", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Desmond raises the clipboard like a toast.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Nobody joins him.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}]}