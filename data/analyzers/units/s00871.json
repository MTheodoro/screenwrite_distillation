{"scene_id": "s00871", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00871.fountain", "heading": "INT. NIGHT FERRY - CAR DECK - NIGHT", "cast": [{"id": 0, "name": "INES VARELA", "names": ["INES VARELA", "INES"], "gender": "?", "first": 3, "spoke": 3}, {"id": 1, "name": "SEUN ADEYEMI", "names": ["SEUN ADEYEMI", "SEUN"], "gender": "?", "first": 3, "spoke": 2}, {"id": 2, "name": "HARLAN COOPER-REID", "names": ["HARLAN COOPER-REID", "HARLAN"], "gender": "?", "first": 3, "spoke": 2}, {"id": 3, "name": "PRIYA NAIR", "names": ["PRIYA NAIR", "PRIYA"], "gender": "?", "first": 3, "spoke": 1}, {"id": 4, "name": "DMITRI SOKOLOV", "names": ["DMITRI SOKOLOV", "DMITRI"], "gender": "?", "first": 3, "spoke": 2}, {"id": 5, "name": "GRANDMA ZOFIA", "names": ["GRANDMA ZOFIA", "ZOFIA"], "gender": "?", "first": 3, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT FERRY - CAR DECK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Engines thrum.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Six figures around a rusted minivan.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "INES VARELA, 40s, SEUN ADEYEMI, 30s, HARLAN COOPER-REID, 60s, PRIYA NAIR, 20s, DMITRI SOKOLOV, 50s, and GRANDMA ZOFIA, 80s, in a folding chair.", "para": 0, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 4, "kind": "action", "text": "She clutches an urn.", "para": 1, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 5, "kind": "action", "text": "He pretends not to see.", "para": 1, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 6, "kind": "action", "text": "They all stare at the lid.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 7, "kind": "dialogue", "text": "We scatter it at the island, like she said.", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "dialogue", "text": "She said the harbor.", "name": "HARLAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "She said both. She said a lot of things.", "name": "SEUN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "Zofia laughs at nothing.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "Priya takes the urn from Ines, gently, and Ines lets go too fast.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Okay. Okay.", "name": "PRIYA", "speaker": 3, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Someone opened this.", "name": "DMITRI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "He holds up the lid, tape peeled.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Harlan studies the floor.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Ines reaches for the urn again.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Who opened it?", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "She asked me to look.", "name": "HARLAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "You looked? You LOOKED?", "name": "SEUN", "speaker": 1, "ext": [], "paren": ["over Harlan"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Seun, quiet.", "name": "DMITRI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "There's nothing in it, is there.", "name": "INES", "speaker": 0, "ext": [], "paren": ["over both"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Priya tips the urn.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Ash, grey, real.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Everyone exhales.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Zofia stops laughing.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "That is not Marta.", "name": "ZOFIA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "They turn as one.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}