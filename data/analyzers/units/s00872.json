{"scene_id": "s00872", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00872.fountain", "heading": "EXT. FLOODED RICE PADDY - PUMP HOUSE ROOF - DUSK", "cast": [{"id": 0, "name": "KOSTAS VLAHOS", "names": ["KOSTAS VLAHOS", "VLAHOS"], "gender": "?", "first": 6, "spoke": 5}, {"id": 1, "name": "ELIAS TREMBLAY", "names": ["ELIAS TREMBLAY", "TREMBLAY"], "gender": "m", "first": 10, "spoke": 3}, {"id": 2, "name": "HANA YOSHIDA", "names": ["HANA YOSHIDA", "YOSHIDA"], "gender": "?", "first": 14, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FLOODED RICE PADDY - PUMP HOUSE ROOF - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "Sky bruised orange.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Frogs.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Somewhere, far off, the thump of mortars.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Not close.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Not yet.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "SGT. KOSTAS VLAHOS, 40s, lies prone behind a sandbag.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Rifle across his forearms.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "He hasn't blinked in a minute.", "para": 1, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "PVT.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "ELIAS TREMBLAY, 19, crouches beside him.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Boots soaked.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He chews a strip of dry rice cake.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "CPL.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "HANA YOSHIDA, 30s, the radio operator, sits cross-legged under a tarp.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Headset on one ear.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "How long do we sit here?", "name": "TREMBLAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Till he says.", "name": "VLAHOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Tremblay glances at the radio.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "She shakes her head.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "He sinks back.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Static. Nothing but static.", "name": "YOSHIDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Frogs go quiet.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "All three freeze.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "He lifts a hand.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "She stops breathing.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The boy stops chewing.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "A beat.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "The frogs start again.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Was that us?", "name": "TREMBLAY", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Wind.", "name": "VLAHOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "He doesn't believe it.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Neither do they.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "She slides the headset off, lays it on her knee.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "They moved the line.", "name": "YOSHIDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "How far?", "name": "VLAHOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Behind us.", "name": "YOSHIDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Silence.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "The mortars are louder now.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Tremblay reaches for his rifle, fumbles it.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "It clatters on tin.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "They duck.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "All three.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Eyes up.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Across the paddy, a flashlight blinks once.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Twice.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Get down.", "name": "VLAHOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Sarge--", "name": "TREMBLAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "DOWN.", "name": "VLAHOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "The water around the pump house shivers.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Then the roof lifts.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "A white flash swallows everything.", "para": 12, "sent": 0, "present": [0, 1, 2]}]}