{"scene_id": "s00873", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00873.fountain", "heading": "INT. TAXIDERMY SHOP - BACK ROOM - NIGHT", "cast": [{"id": 0, "name": "MAG SOLBERG", "names": ["MAG SOLBERG", "MAG"], "gender": "f", "first": 4, "spoke": 5}, {"id": 1, "name": "ISAIAH TWOBEARS", "names": ["ISAIAH TWOBEARS", "ISAIAH"], "gender": "m", "first": 6, "spoke": 1}, {"id": 2, "name": "NADIA KHALIL", "names": ["NADIA KHALIL", "KHALIL"], "gender": "m", "first": 9, "spoke": 6}, {"id": 3, "name": "GUS", "names": ["GUS"], "gender": "?", "first": 28, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. TAXIDERMY SHOP - BACK ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Glass eyes in a coffee tin.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A badger mid-snarl.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A half-stuffed owl on the workbench, wings pinned.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MAG SOLBERG, 60s, rubber gloves, stitches the owl without looking at her visitors.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "A landline phone sits next to her, cord stretched.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "ISAIAH TWOBEARS, 30s, leather jacket, stands too near the door.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "His hands are in his pockets.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He hasn't taken off his gloves either.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "DET. NADIA KHALIL, 40s, drifts along a shelf of foxes.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Touches nothing.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Nice work.", "name": "KHALIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Thanks.", "name": "MAG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "You do the owl for the bar on Delancey?", "name": "KHALIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Does it look like I do bars?", "name": "MAG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Khalil lifts a fox.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Puts it back facing the wall.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "We should go.", "name": "ISAIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "We just got here.", "name": "KHALIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "The phone RINGS.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Mag lets it.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Three rings.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Four.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Isaiah shifts his weight.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Get that.", "name": "KHALIL", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Mag peels off one glove.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Answers.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Solberg's.", "name": "MAG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Mags. They find the thing yet?", "name": "GUS", "speaker": 3, "ext": ["V.O."], "paren": ["through the receiver"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Mag looks at Khalil.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Khalil smiles.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Mag looks at the owl.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Wrong number.", "name": "MAG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Mags--", "name": "GUS", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "She hangs up.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Picks up the needle again.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "The thread trembles, once.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Who was that?", "name": "KHALIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Somebody's husband.", "name": "MAG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Isaiah steps out through the back door.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Cold air rushes in.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Khalil watches him go and does nothing.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Finish the owl, Mag.", "name": "KHALIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Mag pulls the thread tight.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}]}