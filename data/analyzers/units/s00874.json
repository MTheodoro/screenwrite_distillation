{"scene_id": "s00874", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00874.fountain", "heading": "INT. PLANETARIUM - DOME HALL - NIGHT", "cast": [{"id": 0, "name": "WINIFRED PARRISH", "names": ["WINIFRED PARRISH", "WINIFRED"], "gender": "f", "first": 4, "spoke": 5}, {"id": 1, "name": "STRANGER", "names": ["STRANGER"], "gender": "f", "first": 5, "spoke": 4}, {"id": 2, "name": "ABERNATHY", "names": ["ABERNATHY", "MR. ABERNATHY"], "gender": "?", "first": 15, "spoke": 3}, {"id": 3, "name": "JULIAN", "names": ["JULIAN"], "gender": "?", "first": 21, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. PLANETARIUM - DOME HALL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "The star projector hums, throwing a slow ocean of light across a curved ceiling.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The seats recline.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Most are empty.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "WINIFRED PARRISH, 30s, a sensible coat and a sensible umbrella, sits alone in row F. She watches Orion rise.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "A STRANGER, 30s, in a rumpled raincoat, slides into the seat beside her.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "He carries a paper cup of coffee and an apologetic smile.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Is this seat taken?", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "There are two hundred seats.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I like this one.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She considers him, then looks back at the stars.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He sips his coffee.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Neither speaks for a while.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Betelgeuse is late tonight.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "It's always late. It's a very old star.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "MR. ABERNATHY, 70s, the caretaker in a navy cardigan, shuffles down the aisle with a flashlight.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "He pauses at row F.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Last show's over, folks. Ten minutes.", "name": "MR. ABERNATHY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Thank you, Mr. Abernathy.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Who's your friend?", "name": "MR. ABERNATHY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Yes. Who are you?", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": ["to the Stranger"], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Julian. Julian Hale.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Mr. Abernathy nods, satisfied, and shuffles on.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "You come here often?", "name": "JULIAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Every Thursday.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Then I'll see you Thursday.", "name": "JULIAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "She smiles at the ceiling, not at him.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Overhead, a comet drifts across the dome.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Lights in five!", "name": "MR. ABERNATHY", "speaker": 2, "ext": [], "paren": ["calling, to the empty hall"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Stay for the comet.", "name": "JULIAN", "speaker": 3, "ext": [], "paren": ["softly, to Winifred"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "She does.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}]}