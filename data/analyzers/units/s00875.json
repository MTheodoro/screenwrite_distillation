{"scene_id": "s00875", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00875.fountain", "heading": "INT. CATHEDRAL CRYPT - FIELD KITCHEN - NIGHT", "cast": [{"id": 0, "name": "SERGEANT AUGUSTIN BELLAMY", "names": ["SERGEANT AUGUSTIN BELLAMY", "BELLAMY"], "gender": "?", "first": 6, "spoke": 24}, {"id": 1, "name": "LIEUTENANT PERPETUA NWOSU", "names": ["LIEUTENANT PERPETUA NWOSU", "NWOSU"], "gender": "f", "first": 10, "spoke": 22}], "units": [{"u": 0, "kind": "heading", "text": "INT. CATHEDRAL CRYPT - FIELD KITCHEN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Low vaulted stone, whitewashed long ago and soot-dark now.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of carved tombs line the walls, each with a name worn smooth.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Iron cauldrons hang over a cooking fire dug into the old flagstones.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Smoke finds its way up through a narrow stair.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A single lantern hangs from a hook meant for something holier.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "SERGEANT AUGUSTIN BELLAMY, 50s, the company cook, stands at the largest cauldron with a wooden paddle.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Broad, slow, a face like folded bread dough.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "A flour-stained apron over his uniform.", "para": 1, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "He hums something that might be a hymn.", "para": 1, "sent": 3, "present": [0]}, {"u": 10, "kind": "action", "text": "LIEUTENANT PERPETUA NWOSU, 20s, enters down the stair with a map case under her arm.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Tall, tired, helmet in her hand.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Her boots leave wet prints on the stone.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Evening, Sergeant.", "name": "NWOSU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Lieutenant. You're early for stew.", "name": "BELLAMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I'm early for everything. It's a character flaw.", "name": "NWOSU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Sit. Rest your feet. The dead won't mind.", "name": "BELLAMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She sets the map case on a tomb lid.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Hesitates.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Sits on the next one down.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Whose is this?", "name": "NWOSU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Bishop somebody. Fourteenth century. I asked him if I could use his lid for chopping. He said nothing.", "name": "BELLAMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Polite of him.", "name": "NWOSU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "They always are.", "name": "BELLAMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "He tastes the stew from the paddle.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Frowns.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Reaches for a tin of salt.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "What's in it tonight?", "name": "NWOSU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Barley. Onion. Something that was a rabbit when I met it.", "name": "BELLAMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Where'd you meet it?", "name": "NWOSU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Behind the bell tower. Poor thing ran into my boot.", "name": "BELLAMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "She laughs, once, surprised at herself.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "He smiles into the pot.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "It's quiet down here.", "name": "NWOSU", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "It's a crypt, Lieutenant.", "name": "BELLAMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "I mean the guns.", "name": "NWOSU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Ah.", "name": "BELLAMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "He listens.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Far above, through yards of stone, the faint thud of artillery.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Distant.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Regular as a clock.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "That's the new quiet. You get used to it.", "name": "BELLAMY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Do you?", "name": "NWOSU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "No. But you get good at pretending.", "name": "BELLAMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "He ladles stew into a tin bowl and hands it to her.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "She wraps both hands around it.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Thank you.", "name": "NWOSU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "Eat before it gets cold. Or before it gets interesting.", "name": "BELLAMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "She tries it.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "Chews.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "Considers.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "It tastes like rabbit.", "name": "NWOSU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Told you.", "name": "BELLAMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "It's good, Sergeant.", "name": "NWOSU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "It's hot. That's the whole recipe.", "name": "BELLAMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "She eats.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "He stirs.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "The fire pops.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "A drip of water falls from the vault into a puddle, patient and slow.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "Do you write home?", "name": "NWOSU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "My wife. Every Sunday.", "name": "BELLAMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "What do you tell her?", "name": "NWOSU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "That the food is terrible and the company is worse.", "name": "BELLAMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "Is that true?", "name": "NWOSU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "The food, yes.", "name": "BELLAMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "A small smile from her.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "She sets down the bowl and draws a letter from her breast pocket.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 67, "kind": "action", "text": "Folds and unfolds it.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "I have one I can't finish.", "name": "NWOSU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "To whom?", "name": "BELLAMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "My brother.", "name": "NWOSU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "dialogue", "text": "What won't it say?", "name": "BELLAMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 72, "kind": "dialogue", "text": "That I'm scared.", "name": "NWOSU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 73, "kind": "dialogue", "text": "Of what?", "name": "BELLAMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 74, "kind": "dialogue", "text": "Of being good at this.", "name": "NWOSU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 75, "kind": "action", "text": "He sets down the paddle.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 76, "kind": "action", "text": "Wipes his hands on the apron.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 77, "kind": "action", "text": "Takes a long, careful look at her in the lantern light.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 78, "kind": "dialogue", "text": "Then write that.", "name": "BELLAMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 79, "kind": "dialogue", "text": "He'd worry.", "name": "NWOSU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 80, "kind": "dialogue", "text": "He's your brother. He's already worried.", "name": "BELLAMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 81, "kind": "action", "text": "She smooths the letter against her knee.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 82, "kind": "action", "text": "Takes a pencil stub from her pocket.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 83, "kind": "action", "text": "Writes a line.", "para": 12, "sent": 2, "present": [0, 1]}, {"u": 84, "kind": "action", "text": "Stops.", "para": 12, "sent": 3, "present": [0, 1]}, {"u": 85, "kind": "action", "text": "Writes another.", "para": 12, "sent": 4, "present": [0, 1]}, {"u": 86, "kind": "dialogue", "text": "Good. Now more.", "name": "BELLAMY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 87, "kind": "action", "text": "She keeps writing.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 88, "kind": "action", "text": "He returns to the pot.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 89, "kind": "action", "text": "The fire murmurs.", "para": 13, "sent": 2, "present": [0, 1]}, {"u": 90, "kind": "action", "text": "Above them, the guns go on, and below them, in their stone beds, the old bishops keep their counsel.", "para": 13, "sent": 3, "present": [0, 1]}, {"u": 91, "kind": "dialogue", "text": "Sergeant.", "name": "NWOSU", "speaker": 1, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1]}, {"u": 92, "kind": "dialogue", "text": "Lieutenant.", "name": "BELLAMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 93, "kind": "dialogue", "text": "Thank you for the rabbit.", "name": "NWOSU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 94, "kind": "dialogue", "text": "Thank the boot.", "name": "BELLAMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 95, "kind": "action", "text": "She laughs again, quietly, pencil still moving.", "para": 14, "sent": 0, "present": [0, 1]}]}