{"scene_id": "s00876", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00876.fountain", "heading": "EXT. ABANDONED SALT WORKS - EVAPORATION FLATS - LATE AFTERNOON", "cast": [{"id": 0, "name": "TOBIAS WREN", "names": ["TOBIAS WREN", "TOBIAS"], "gender": "?", "first": 5, "spoke": 8}, {"id": 1, "name": "ESPERANZA QUINTERO", "names": ["ESPERANZA QUINTERO", "ESPERANZA"], "gender": "f", "first": 10, "spoke": 8}, {"id": 2, "name": "LUKA", "names": ["LUKA"], "gender": "?", "first": 28, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ABANDONED SALT WORKS - EVAPORATION FLATS - LATE AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "A white country, flat to the edge of the sky.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Shallow ponds, each a different shade of rose and bone, are cut by crumbling wooden sluice gates.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The wind carries a taste of brine.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "At the far end, a long shed with a sagging tin roof, its door hanging off one hinge.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "TOBIAS WREN, 60s, kneels at a pond's edge, scooping salt crystals into a sack.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Weathered as a fence post, his hat brim stiff with old sweat, his beard a pale yellow like old piano keys.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "His hands are cracked from decades of brine.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "He works without hurry.", "para": 1, "sent": 3, "present": [0]}, {"u": 9, "kind": "action", "text": "A figure approaches along the causeway.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "ESPERANZA QUINTERO, 30s, rides a grey mule, a rifle slung across her back and a canvas satchel on her hip.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Dust-coloured coat.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Black braid.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She stops the mule a polite distance away.", "para": 2, "sent": 4, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "You Wren?", "name": "ESPERANZA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Depends who's asking.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Esperanza Quintero. I bought the claim at the other end of the flats.", "name": "ESPERANZA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "That's a lot of nothing to buy.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "It's cheap nothing.", "name": "ESPERANZA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He almost smiles.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Drops another handful of salt into the sack.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Water's bad on your side.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "I figured.", "name": "ESPERANZA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Good on mine. If you ask nicely.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She slides down from the mule.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Boots crunch on the crust.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "She looks across the flats, then at him.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "I'm asking.", "name": "ESPERANZA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "A boy emerges from the shed, barefoot, nine or ten, LUKA, thin as a rope and just as strong.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "He carries a bucket almost as big as his torso.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Grandpa, the pump's stuck again.", "name": "LUKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Then unstick it.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "I tried.", "name": "LUKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Try harder.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Luka notices Esperanza.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Stares at the rifle.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Stares at the mule.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Is that a real gun?", "name": "LUKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "It's a real mule.", "name": "ESPERANZA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Can I touch him?", "name": "LUKA", "speaker": 2, "ext": [], "paren": ["grinning"], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Her. Be gentle.", "name": "ESPERANZA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "He sets down the bucket and approaches the mule with both palms out, whispering.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "The mule allows it.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Tobias watches the boy, then the woman, then the horizon.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Sit. There's coffee. It's terrible.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "I've had worse.", "name": "ESPERANZA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Not out here.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "She smiles, ties the mule to a post, and follows him toward the shed.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Behind them the salt shines like a field of broken glass under the long low sun.", "para": 8, "sent": 1, "present": [0, 1, 2]}]}