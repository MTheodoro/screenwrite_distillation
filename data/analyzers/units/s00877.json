{"scene_id": "s00877", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00877.fountain", "heading": "INT. STADIUM CONCOURSE - IMPROVISED TRIAGE - NIGHT", "cast": [{"id": 0, "name": "SAOIRSE KELLEHER", "names": ["SAOIRSE KELLEHER", "SAOIRSE"], "gender": "f", "first": 5, "spoke": 7}, {"id": 1, "name": "BARTOSZ NOWAK", "names": ["BARTOSZ NOWAK", "BARTOSZ"], "gender": "?", "first": 8, "spoke": 4}, {"id": 2, "name": "LIN WEI", "names": ["LIN WEI"], "gender": "f", "first": 9, "spoke": 4}, {"id": 3, "name": "ODALYS MERCEDES", "names": ["ODALYS MERCEDES", "ODALYS"], "gender": "f", "first": 10, "spoke": 2}, {"id": 4, "name": "FINN ASHFORD", "names": ["FINN ASHFORD", "FINN"], "gender": "m", "first": 12, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. STADIUM CONCOURSE - IMPROVISED TRIAGE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A concrete ring under flickering sodium lights.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Hot-dog stands turned into supply desks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Cots in rows where the beer lines used to be.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The air smells of antiseptic and popcorn.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. SAOIRSE KELLEHER, 40s, scrubs smeared with someone else's blood, kneels at a cot.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Red hair under a surgical cap.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Her eyes never stop moving.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "BARTOSZ NOWAK, 50s, a stocky nurse with a grey ponytail, wrestles an IV pole across the cracked floor.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "LIN WEI, 20s, paramedic in a drenched jacket, runs a gurney in, rain streaming off her shoulders.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "On the gurney: ODALYS MERCEDES, 60s, grey-faced, one hand clamped on her chest.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Her lips are blue.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "FINN ASHFORD, 20s, a first-year resident with a nervous goatee, trails behind, clutching a chart he can't read.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Sixty-two female, chest pain, pulse thready, pressure seventy over forty!", "name": "LIN WEI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Put her here. Bart, line.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Working on it.", "name": "BARTOSZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Should I call cardiology? Is cardiology even here?", "name": "FINN", "speaker": 4, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Finn, no. Get the crash cart.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "I'm fine. I'm fine, I just need to sit.", "name": "ODALYS", "speaker": 3, "ext": [], "paren": ["weak"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Mrs. Mercedes, you are sitting. Stay with me.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "She's been like this since the underpass!", "name": "LIN WEI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Line's in. Pushing fluids.", "name": "BARTOSZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Crash cart's in the lobby, I'll--", "name": "FINN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Run.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "He runs.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Odalys's eyes roll back.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "The monitor squeals into a flatline.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Doctor!", "name": "LIN WEI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Compressions. Bart, count!", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "One, two, three--", "name": "BARTOSZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Saoirse locks her hands over the old woman's chest and pushes.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Ribs crack.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Nobody blinks.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Cart!", "name": "FINN", "speaker": 4, "ext": [], "paren": ["returning, out of breath"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Charge to two hundred.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Clear!", "name": "LIN WEI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "The body jumps.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "The monitor stays flat.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Again.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "A long beat.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "A blip.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Another.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "A rhythm stumbles back to life.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Sinus. We have sinus.", "name": "BARTOSZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Saoirse sits back on her heels.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Lin Wei laughs, a wet, startled sound.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Finn lowers the paddles, shaking.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "Told you. Fine.", "name": "ODALYS", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}]}