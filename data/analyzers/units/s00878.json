{"scene_id": "s00878", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00878.fountain", "heading": "INT. CURLING RINK - ICE LEVEL - NIGHT", "cast": [{"id": 0, "name": "COACH GRETA LINDQVIST", "names": ["COACH GRETA LINDQVIST", "GRETA"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "DOC HOLLIS", "names": ["DOC HOLLIS"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "JUNIOR ABIODUN", "names": ["JUNIOR ABIODUN", "JUNIOR"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "MATEO CRUZ", "names": ["MATEO CRUZ", "MATEO"], "gender": "m", "first": 7, "spoke": 2}, {"id": 4, "name": "SIGRID", "names": ["SIGRID"], "gender": "?", "first": 7, "spoke": 3}, {"id": 5, "name": "DOC", "names": ["DOC"], "gender": "?", "first": 10, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. CURLING RINK - ICE LEVEL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cold hush.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Brooms squeak.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Scoreboard: 7-7, last end.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "COACH GRETA LINDQVIST, 50s, in a parka, paces behind the hog line.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "DOC HOLLIS, 60s, the team physio, hovers with a thermos.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "JUNIOR ABIODUN, 19, kneels in the hack, stone in hand.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "MATEO CRUZ, 30s, sweeper, and SIGRID, 20s, sweeper, hold their brooms like rifles.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "Breathe. Everybody breathe.", "name": "GRETA", "speaker": 0, "ext": [], "paren": ["to the team"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Don't blow it. Don't blow it.", "name": "JUNIOR", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "You've got it, kid.", "name": "DOC", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Line's perfect.", "name": "MATEO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Line's slow.", "name": "SIGRID", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Sigrid, call it.", "name": "GRETA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Hard! Hard! Hard!", "name": "SIGRID", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Junior releases.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "The stone glides.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Mateo and Sigrid sweep, brooms a blur.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Off! Off! Off!", "name": "MATEO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "No, leave it!", "name": "SIGRID", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Leave it, leave it, leave it!", "name": "GRETA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Doc turns away, can't watch.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "The stone creeps toward the button.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Stops.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "A hair short of the rival stone.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Then the horn.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "It's good.", "name": "DOC", "speaker": 5, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Is it good?", "name": "JUNIOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "The rink erupts.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Mateo hurls his broom.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Sigrid sobs into Greta's parka.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Thank God.", "name": "GRETA", "speaker": 0, "ext": [], "paren": ["muttering, to herself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}