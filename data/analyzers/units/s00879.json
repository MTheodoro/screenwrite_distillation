{"scene_id": "s00879", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00879.fountain", "heading": "INT. GRAIN ELEVATOR - TOP FLOOR - NIGHT", "cast": [{"id": 0, "name": "BEATRIX ALLCOTT", "names": ["BEATRIX ALLCOTT", "BEATRIX"], "gender": "f", "first": 4, "spoke": 4}, {"id": 1, "name": "REUBEN STOLTZFUS", "names": ["REUBEN STOLTZFUS", "REUBEN"], "gender": "?", "first": 5, "spoke": 3}, {"id": 2, "name": "PAULINA ARRIAGA", "names": ["PAULINA ARRIAGA", "PAULINA"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "SOUND", "names": ["SOUND"], "gender": "?", "first": 11, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRAIN ELEVATOR - TOP FLOOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dust.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Moonlight through slatted boards.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A rusted conveyor hums, empty.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "BEATRIX ALLCOTT, 30s, flashlight in her teeth, crawls along a catwalk.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "REUBEN STOLTZFUS, 50s, follows, clutching a pitchfork like a prayer.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "PAULINA ARRIAGA, 20s, brings up the rear with a camera.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Her hands shake.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Stay close. Nobody splits up.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": ["to the group"], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Wasn't planning on it.", "name": "REUBEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "This is a bad idea. This is a very bad idea.", "name": "PAULINA", "speaker": 2, "ext": [], "paren": ["muttering to herself"], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "A SOUND below.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Wet.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Dragging.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "They freeze.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Beatrix swings the flashlight down into the dark hopper, where something pale uncoils from the corn, Reuben jabs the pitchfork toward it, Paulina stumbles back and the camera flashes white, and the thing lunges for her ankle before Beatrix hauls her up by the collar and all three scramble toward the ladder.", "para": 2, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "You said it was empty!", "name": "REUBEN", "speaker": 1, "ext": [], "paren": ["to Beatrix"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "I said I THOUGHT.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "It's slower. It's slower now.", "name": "PAULINA", "speaker": 2, "ext": [], "paren": ["to no one"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "They reach the ladder.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Reuben climbs first.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Beatrix pushes Paulina after him, then turns to look back.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Nothing in the hopper.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Just a ripple in the grain, settling.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "It's gone.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Beatrix. Come on.", "name": "REUBEN", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "She climbs.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Stops halfway.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Looks down once more.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "The grain is perfectly flat.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Goodnight.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}]}