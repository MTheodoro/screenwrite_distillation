{"scene_id": "s00880", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00880.fountain", "heading": "INT. BOWLING ALLEY PAWN SHOP - NIGHT", "cast": [{"id": 0, "name": "VINNIE CASSANO", "names": ["VINNIE CASSANO", "VINNIE"], "gender": "?", "first": 3, "spoke": 3}, {"id": 1, "name": "ODETTA BRIGHTWATER", "names": ["ODETTA BRIGHTWATER", "ODETTA"], "gender": "f", "first": 4, "spoke": 4}, {"id": 2, "name": "KEMAL DURAN", "names": ["KEMAL DURAN", "KEMAL"], "gender": "?", "first": 5, "spoke": 3}, {"id": 3, "name": "TRISH MALONEY", "names": ["TRISH MALONEY", "TRISH"], "gender": "?", "first": 6, "spoke": 1}, {"id": 4, "name": "LEVI SZABO", "names": ["LEVI SZABO", "LEVI"], "gender": "?", "first": 7, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. BOWLING ALLEY PAWN SHOP - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Behind the shoe counter, a cage of guitars and cameras.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Lanes rumble beyond the wall.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "VINNIE CASSANO, 50s, sweating through a bowling shirt.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "ODETTA BRIGHTWATER, 40s, in a trench coat, a revolver low at her hip.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "KEMAL DURAN, 30s, hands up, backed against the glass.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "TRISH MALONEY, 20s, behind the counter, phone in hand.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "LEVI SZABO, 60s, an old man in the shoe line, frozen with a pair of size nines.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "Everybody stay calm.", "name": "ODETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "I'm calm. I'm very calm.", "name": "VINNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "It's not what it looks like.", "name": "KEMAL", "speaker": 2, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Should I call somebody?", "name": "TRISH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Put the phone down.", "name": "ODETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "I only wanted bowling.", "name": "LEVI", "speaker": 4, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Kemal drops a bag.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Cash spills.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Odetta nods at it.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "You were going to run.", "name": "ODETTA", "speaker": 1, "ext": [], "paren": ["to Kemal"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "I was going to tell you.", "name": "KEMAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Tell her what?", "name": "VINNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "That it's his.", "name": "KEMAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "All eyes swing to Vinnie.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Don't look at me.", "name": "VINNIE", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Odetta lowers the gun.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "A long breath.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "A pin falls somewhere down the lane.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Strike.", "name": "ODETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}