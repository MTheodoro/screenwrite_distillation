{"scene_id": "s00881", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00881.fountain", "heading": "EXT. RIVER CROSSING - FERRY LANDING - DAY", "cast": [{"id": 0, "name": "AMOS PIKE", "names": ["AMOS PIKE", "AMOS"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "CORA LEIGHTON", "names": ["CORA LEIGHTON", "CORA"], "gender": "?", "first": 6, "spoke": 6}, {"id": 2, "name": "SHERIFF WALT DRUMMOND", "names": ["SHERIFF WALT DRUMMOND", "DRUMMOND"], "gender": "?", "first": 14, "spoke": 7}, {"id": 3, "name": "MIGUEL ARROYO", "names": ["MIGUEL ARROYO"], "gender": "m", "first": 14, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. RIVER CROSSING - FERRY LANDING - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A cable-drawn raft waits on a brown river.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A shack.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A hitching rail.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "AMOS PIKE, 40s, ferryman, coils rope on the dock.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He keeps one eye on the road.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "CORA LEIGHTON, 30s, a schoolteacher in a travelling coat, arrives with a trunk and sets it down hard.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "She watches him work.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "How much for the crossing?", "name": "CORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Two bits.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She pays.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He pockets it without looking.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Dust rises on the road.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Two riders.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "SHERIFF WALT DRUMMOND, 50s, and MIGUEL ARROYO, 20s, in handcuffs, slumped over his saddle.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Morning, Sheriff.", "name": "AMOS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Amos.", "name": "DRUMMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "He dismounts.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Pulls the prisoner down.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Miguel's lip is split.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "He keeps his eyes on the water.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Is he hurt?", "name": "CORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Not badly.", "name": "DRUMMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "He looks hurt.", "name": "CORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Ma'am, it ain't your business.", "name": "DRUMMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "She turns to Amos.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Is it?", "name": "CORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Amos looks at the river.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "At the raft.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "He chews a long moment.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Raft only holds four. And a horse.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Then we'll make two trips.", "name": "DRUMMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Then you wait.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Drummond's jaw tightens.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Miguel lifts his head and meets Cora's eyes.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "He mouths something.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "She nods, barely.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Something to say, boy?", "name": "DRUMMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Miguel shakes his head.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Cora steps between them, calm as a church.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Sheriff, I'll ride with the prisoner. The ferryman will take the horses first.", "name": "CORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "That wasn't the plan.", "name": "DRUMMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "It is now.", "name": "CORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Amos grins at the rope.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Drummond glares.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Then, slowly, he unbuckles his gun belt and hangs it from his saddle horn.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Lead on.", "name": "DRUMMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}