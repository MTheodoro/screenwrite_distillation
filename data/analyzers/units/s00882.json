{"scene_id": "s00882", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00882.fountain", "heading": "INT. ROLLER RINK - AFTER HOURS - NIGHT", "cast": [{"id": 0, "name": "INGRID BOSTROM", "names": ["INGRID BOSTROM", "BOSTROM"], "gender": "f", "first": 5, "spoke": 9}, {"id": 1, "name": "SKATER", "names": ["SKATER"], "gender": "f", "first": 8, "spoke": 4}, {"id": 2, "name": "NIKO PAPADAKIS", "names": ["NIKO PAPADAKIS", "NIKO"], "gender": "?", "first": 24, "spoke": 4}, {"id": 3, "name": "CLEO", "names": ["CLEO"], "gender": "f", "first": 31, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROLLER RINK - AFTER HOURS - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Disco ball turning slowly, scattering dull stars across a vast wooden floor.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Neon trim hums.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rental skates in cubbies, laces tangled.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The air smells of nacho cheese and old sweat.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DET. INGRID BOSTROM, 40s, trench coat, sensible shoes, stands at the rail.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her notebook is closed.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She watches a lone skater glide in wide, lazy circles.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "THE SKATER, 30s, a woman in a sequined jacket, moves like she's ice rather than wheels.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Hair pinned up.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "A split lip she's trying not to touch.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "You skate well.", "name": "BOSTROM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Thanks.", "name": "SKATER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Better than my partner.", "name": "BOSTROM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "He fell?", "name": "SKATER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "He died.", "name": "BOSTROM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "The Skater keeps gliding.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Her left wheel clicks once on a board seam.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She doesn't look at Bostrom.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Where were you Thursday night?", "name": "BOSTROM", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Here. I'm always here.", "name": "SKATER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Someone said that.", "name": "BOSTROM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Someone's right.", "name": "SKATER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "A door bangs at the far end.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "NIKO PAPADAKIS, 17, skinny, in a rental-desk polo, drags in a mop and bucket.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "He freezes at the sight of the detective.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Sorry. I didn't know anyone--", "name": "NIKO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "It's fine. What's your name?", "name": "BOSTROM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Niko.", "name": "NIKO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Niko, do you know this woman?", "name": "BOSTROM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "He glances at the Skater, then at the floor.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "That's Cleo. She teaches Tuesday nights.", "name": "NIKO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Niko, go home.", "name": "CLEO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Cleo, I--", "name": "NIKO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Go home.", "name": "CLEO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "He goes.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "The door swings shut.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "The disco ball keeps turning.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Bostrom opens her notebook.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Cleo what?", "name": "BOSTROM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Mbeki.", "name": "CLEO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Bostrom writes it down.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Cleo glides to the rail, takes hold of it, and for the first time looks her in the eye.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "He was going to tell you.", "name": "CLEO", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Who was?", "name": "BOSTROM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "The boy.", "name": "CLEO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Bostrom closes the notebook.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}]}