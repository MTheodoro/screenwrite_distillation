{"scene_id": "s00883", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00883.fountain", "heading": "INT. LOST PROPERTY OFFICE - NIGHT", "cast": [{"id": 0, "name": "INSPECTOR TOMAS ECHEVERRIA", "names": ["INSPECTOR TOMAS ECHEVERRIA"], "gender": "?", "first": 3, "spoke": 38}, {"id": 1, "name": "MIRIAM VOLKOV", "names": ["MIRIAM VOLKOV"], "gender": "?", "first": 4, "spoke": 38}], "units": [{"u": 0, "kind": "heading", "text": "INT. LOST PROPERTY OFFICE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Shelves of umbrellas.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single desk lamp.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "dialogue", "text": "You've kept everything.", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 4, "kind": "dialogue", "text": "Everything that's ever been left.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "Even this?", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Especially that. It's a green glove.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "It's a woman's green glove. Left hand.", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Left on the 9:14 from Aldgate. March, I think.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "The day Lady Harcourt vanished.", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I don't read the papers.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "You wrote the date on the tag.", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I write the date on every tag.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "The ink is fresh.", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "It's a fresh tag.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "You rewrote it.", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Tags fade, Inspector.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Not in a drawer.", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "It wasn't in a drawer.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Where was it?", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "In my coat pocket.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "For how long?", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Since the morning after.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Why?", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "I wanted to give it back.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "To whom?", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "To her.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Lady Harcourt was on that train.", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "I know.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "You saw her.", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "I was on that train.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "You never said.", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Nobody asked.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "I'm asking now.", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "She sat opposite me. Green gloves. She was crying.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Why was she crying?", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "She didn't say.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Did she say anything?", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "She asked me what the time was.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "What time was it?", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "9:31.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "And then?", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "She got off at Whitechapel.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Alone?", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "A man held the door for her.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Describe him.", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Tall. Grey coat. A scar on his chin.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "You remember a scar.", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "I remember everything left behind.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Did he leave anything?", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "A newspaper. A hat.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Where are they?", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Shelf C. Second row.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "You've had them all this time.", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "They were never claimed.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "Miss Volkov. Why come forward now?", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "Because you finally asked the right question.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "Which was?", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "What was left behind.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "And what was?", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "Her.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "I don't follow.", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "She never reached the platform. She's in the lost property.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "Miss Volkov--", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "Locker nine. Behind the umbrellas. Key's on the hook.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "You're confessing.", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "I'm returning.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "Sit down.", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "I'd rather stand. It's my office.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "Not for much longer.", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "No. That's the sad part.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "dialogue", "text": "Why did you do it?", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 72, "kind": "dialogue", "text": "She asked what the time was. I told her it was too late.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 73, "kind": "dialogue", "text": "That's not a reason.", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 74, "kind": "dialogue", "text": "It's the only one I have.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 75, "kind": "dialogue", "text": "Take the key down.", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 76, "kind": "dialogue", "text": "Gladly.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 77, "kind": "dialogue", "text": "Slowly.", "name": "INSPECTOR TOMAS ECHEVERRIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 78, "kind": "dialogue", "text": "I have always been slow, Inspector. It's why I never lose anything.", "name": "MIRIAM VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}