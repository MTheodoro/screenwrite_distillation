{"scene_id": "s00886", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00886.fountain", "heading": "INT. CLIFFSIDE BARBERSHOP - DAY", "cast": [{"id": 0, "name": "JEDEDIAH CROWE", "names": ["JEDEDIAH CROWE", "JEDEDIAH"], "gender": "?", "first": 6, "spoke": 10}, {"id": 1, "name": "COLTON MAYHEW", "names": ["COLTON MAYHEW", "COLTON"], "gender": "m", "first": 10, "spoke": 7}, {"id": 2, "name": "AGNES BELLWETHER", "names": ["AGNES BELLWETHER", "AGNES"], "gender": "f", "first": 13, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. CLIFFSIDE BARBERSHOP - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A single chair bolted to a plank floor, facing a wide window that opens onto a canyon.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The wind whistles through a crack in the frame.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A mirror.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A strop.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A pot of lather.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "JEDEDIAH CROWE, 60s, the barber, stands behind the chair in a clean white apron.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Gentle hands.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "Soft voice.", "para": 1, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "He hums as he whisks the lather.", "para": 1, "sent": 3, "present": [0]}, {"u": 10, "kind": "action", "text": "COLTON MAYHEW, 30s, lies back in the chair with a towel across his throat.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Dusty hat on his knee.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Revolver on his hip, strap loose.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "AGNES BELLWETHER, 50s, a widow in black, sits on a bench by the door with a sewing basket and does not look at either man.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "A little off the sides?", "name": "JEDEDIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Just the beard.", "name": "COLTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Quiet morning.", "name": "JEDEDIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Suits me.", "name": "COLTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Rode far?", "name": "JEDEDIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Far enough.", "name": "COLTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Jedediah strops the razor.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "The leather slaps.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Agnes pricks her finger with the needle and doesn't flinch.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Miss Agnes, you want coffee?", "name": "JEDEDIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "No, thank you, Jed.", "name": "AGNES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Mr. Mayhew?", "name": "JEDEDIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Not before I'm shaved.", "name": "COLTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Jedediah smiles, spreads the lather, and begins to draw the razor along Colton's jaw.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Slow.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Deliberate.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "The canyon wind rises.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "You know my name.", "name": "COLTON", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Everybody does, since Tuesday.", "name": "JEDEDIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Colton's eyes open.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "JEDEDIAH What did you hear? Not much. Just that you killed my son.", "name": "COLTON", "speaker": 1, "ext": [], "paren": ["speaking at once", "speaking at once"], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "The razor rests at Colton's throat.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Agnes sets down her sewing.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Jed.", "name": "AGNES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "It's all right, Agnes.", "name": "JEDEDIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "I never--", "name": "COLTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "You never were sorry. I know. I read the report.", "name": "JEDEDIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "A very long moment.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "The wind drops.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "The only sound is Colton's heartbeat, loud in his throat.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "But I'm a patient man, Mr. Mayhew. And Miss Agnes has a pie in the oven.", "name": "JEDEDIAH", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "He lifts the razor away.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Wipes it on the towel.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Folds it shut.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "The sheriff's on his way. He'll be here before the lather dries.", "name": "JEDEDIAH", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Colton lies perfectly still, as if one breath might cost him everything.", "para": 10, "sent": 0, "present": [0, 1, 2]}]}