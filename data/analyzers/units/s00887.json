{"scene_id": "s00887", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00887.fountain", "heading": "INT. MAYFAIR CORSETRY SHOP - FITTING ROOM - DAY", "cast": [{"id": 0, "name": "LADY EUGENIA THORNCROFT", "names": ["LADY EUGENIA THORNCROFT", "EUGENIA"], "gender": "f", "first": 6, "spoke": 8}, {"id": 1, "name": "BRIDGET MULVANEY", "names": ["BRIDGET MULVANEY", "BRIDGET"], "gender": "f", "first": 8, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. MAYFAIR CORSETRY SHOP - FITTING ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "1911.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Mirrors in gilt frames.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A velvet curtain.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Fashion plates pinned to the walls.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The air is thick with lavender and the smell of hot irons.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "LADY EUGENIA THORNCROFT, 40s, imperious, stands on a small platform in her underthings, arms raised, jaw set.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Her hair is a monument of pins.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "BRIDGET MULVANEY, 20s, the seamstress, kneels at her feet with a mouthful of pins and a tape measure around her neck.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Her sleeves are rolled.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Her knuckles are raw.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "If you'd just breathe in, my lady.", "name": "BRIDGET", "speaker": 1, "ext": [], "paren": ["through pins"], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I am breathing in.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Further.", "name": "BRIDGET", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "There is no further.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Bridget pulls the laces tight.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Eugenia gasps.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "They freeze, eye to eye in the mirror, each daring the other to speak first.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Is no one else on duty in this establishment?", "name": "EUGENIA", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the room"], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "No answer.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "The gas lamp hisses.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Bridget plucks a pin from her mouth.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "It's only me today, my lady. The others went to the suffrage march.", "name": "BRIDGET", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Good heavens.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She turns her head.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "She tries to look at her back in the mirror, wobbling on the platform.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Bridget catches her arm.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Steady.", "name": "BRIDGET", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Do not touch me.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "You were falling.", "name": "BRIDGET", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "I was NOT.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "She steps down, stiff as a flagpole, and sweeps toward the curtain.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Bridget stands.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "She grabs her scissors.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "She grips them hard.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "You're not finished, my lady.", "name": "BRIDGET", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "I am entirely finished.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Then you'll leave with the hem undone.", "name": "BRIDGET", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Eugenia stops.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "She says nothing for a long moment.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Then she turns around and, with great dignity, climbs back onto the platform and raises her arms.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Proceed.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Bridget kneels.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "She spits a pin into her palm.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "She does not smile.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "She very nearly does.", "para": 8, "sent": 3, "present": [0, 1]}]}