{"scene_id": "s00889", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00889.fountain", "heading": "INT. BOOKBINDER'S WORKSHOP - LISBON - EVENING", "cast": [{"id": 0, "name": "SOLEDAD IBARRA", "names": ["SOLEDAD IBARRA", "SOLEDAD"], "gender": "f", "first": 5, "spoke": 21}, {"id": 1, "name": "ARCHIE MENDELSOHN", "names": ["ARCHIE MENDELSOHN", "ARCHIE"], "gender": "m", "first": 8, "spoke": 22}, {"id": 2, "name": "AUNT VELMA", "names": ["AUNT VELMA"], "gender": "?", "first": 47, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. BOOKBINDER'S WORKSHOP - LISBON - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "A narrow stone room under a vaulted ceiling.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Presses, bone folders, spools of waxed linen.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Every surface is stacked with half-finished volumes, their spines bare as ribs.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single window frames the red roofs of the Alfama and a tram rattling past.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SOLEDAD IBARRA, 30s, in a leather apron, sits at the sewing frame with a needle in her hand, a loose braid down her back.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Ink stains her fingertips.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She is stitching a signature with practiced ease.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "ARCHIE MENDELSOHN, 30s, a tall American in a rain-spotted jacket, stands in the doorway holding a battered book against his chest like a rescued animal.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "You're late.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I got lost.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "You always get lost.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "It's a very confusing city.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "It's a city with seven hills and one river. Even the pigeons find their way.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "The pigeons live here.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "So do I. And I'm never late.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "You're never anywhere else.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She smiles despite herself, not looking up.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He crosses to the workbench and sets the book down in front of her.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Gently, as if it might bruise.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "That's the one.", "name": "ARCHIE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Oh, Archie. What did you do to it?", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": ["inspecting"], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "I dropped it in a canal.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "In Venice.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "In Venice.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "On purpose?", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "It jumped. I'm telling you, it jumped.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Books don't jump.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "This one has a lot of feelings.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "She opens the cover.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "The pages are warped and rippled, the ink bled into soft blue clouds.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "She runs a thumb along the gutter and lets out a slow breath.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Whose is it?", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "My grandfather's. His diary.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Then why are you giving it to me?", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Because you're the best in Europe.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Flattery.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Fact.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "It will take weeks.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "I have weeks.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "You have a plane ticket.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "I could lose the ticket.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "You could.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "I could lose the whole plane.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Archie.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": ["smiling"], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Soledad.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "The workshop door bangs open.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "AUNT VELMA, 70s, a small woman in a patterned housecoat and bright orange slippers, sweeps in with a covered dish and a gust of cold air.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Soledad! You haven't eaten. I brought cod.", "name": "AUNT VELMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Tia, I'm working.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "And who is this?", "name": "AUNT VELMA", "speaker": 2, "ext": [], "paren": ["to Archie"], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Archie Mendelsohn, ma'am. I'm a client.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "A client who brings flowers?", "name": "AUNT VELMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "He looks down.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "He is, in fact, holding a very small bunch of wilted daisies in his left hand, crushed against the book.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "He lifts them with a helpless shrug.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "They were fresh this morning.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "He is a client who brings flowers.", "name": "AUNT VELMA", "speaker": 2, "ext": [], "paren": ["to Soledad, delighted"], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "Tia.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "I will leave the cod.", "name": "AUNT VELMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "She sets the dish on the nearest stack of paper, pats Archie's cheek once, and sweeps out.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "The door slams.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "The tram rattles by.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "Soledad and Archie look at each other across the ruined book.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "She likes me.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "She likes everybody. She feeds the pigeons.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "Do you?", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "dialogue", "text": "Do I what?", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 68, "kind": "dialogue", "text": "Like me.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "She picks up the daisies.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "Smooths one battered petal between thumb and finger.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 71, "kind": "dialogue", "text": "Come back on Tuesday. I will tell you what the book needs.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 72, "kind": "dialogue", "text": "And the other thing?", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 73, "kind": "dialogue", "text": "The other thing takes longer.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2]}]}