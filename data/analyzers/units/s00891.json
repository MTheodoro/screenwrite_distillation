{"scene_id": "s00891", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00891.fountain", "heading": "INT. BELL TOWER - SNIPER NEST - DAWN", "cast": [{"id": 0, "name": "MOSES TEMBO", "names": ["MOSES TEMBO", "TEMBO"], "gender": "?", "first": 5, "spoke": 6}, {"id": 1, "name": "FERGAL ROURKE", "names": ["FERGAL ROURKE", "ROURKE"], "gender": "m", "first": 9, "spoke": 5}, {"id": 2, "name": "ANTON VASQUEZ", "names": ["ANTON VASQUEZ", "VASQUEZ"], "gender": "m", "first": 10, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. BELL TOWER - SNIPER NEST - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A stone shaft, open to the weather.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cracked bell hangs silent overhead, green with age.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Pigeon droppings crust the floor.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Through the louvres, a ruined village burns in slow grey ribbons.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SGT. MOSES TEMBO, 40s, huge, patient, lies flat behind a rifle.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Scar across his eyebrow.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Every breath measured.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "PVT.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "FERGAL ROURKE, 19, freckled, trembling, crouches at the rim of the stairwell with a field phone.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "CAPT. ANTON VASQUEZ, 30s, in a dented helmet, studies a map pinned to the wall with a bayonet.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Nothing on the line.", "name": "ROURKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Keep trying.", "name": "TEMBO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "They've cut it.", "name": "VASQUEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Then who do I call?", "name": "ROURKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Nobody.", "name": "VASQUEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "We're stuck up here!", "name": "ROURKE", "speaker": 1, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Shut your mouth, boy.", "name": "TEMBO", "speaker": 0, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Quiet. Both of you.", "name": "VASQUEZ", "speaker": 2, "ext": [], "paren": ["overlapping, to both"], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Pigeons shift on the beams.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Tembo's eye stays glued to the scope.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Movement. Left of the well.", "name": "TEMBO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Vasquez drops beside him.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "He raises binoculars.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "He holds them very still.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "How many?", "name": "VASQUEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Three. Maybe four.", "name": "TEMBO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Rourke drops the phone.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "It clatters.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "All three freeze.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Sorry.", "name": "ROURKE", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Pick it up. Slowly.", "name": "VASQUEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "He does.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Below, a boot scrapes stone.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Closer than any of them wants.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "They're in the church.", "name": "TEMBO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Then they're under us.", "name": "VASQUEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Tembo shifts the rifle.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "He exhales.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "The great bell shivers, ever so slightly, as if remembering.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Sarge--", "name": "ROURKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Not now.", "name": "TEMBO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Wood creaks on the stair.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Rourke raises his rifle with both hands.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "The barrel wavers.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Vasquez rests a hand on his shoulder.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Easy, son.", "name": "VASQUEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Light from the stairwell.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Then a shape in the light.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Tembo fires.", "para": 11, "sent": 0, "present": [0, 1, 2]}]}