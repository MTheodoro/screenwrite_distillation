{"scene_id": "s00892", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00892.fountain", "heading": "INT. ROADSIDE MOTEL - ICE MACHINE ALCOVE - NIGHT", "cast": [{"id": 0, "name": "LORRAINE PETTIGREW", "names": ["LORRAINE PETTIGREW", "LORRAINE"], "gender": "?", "first": 5, "spoke": 7}, {"id": 1, "name": "DOT HOLLANDER", "names": ["DOT HOLLANDER", "DOT"], "gender": "?", "first": 7, "spoke": 7}, {"id": 2, "name": "GIDEON MARSH", "names": ["GIDEON MARSH", "GIDEON"], "gender": "m", "first": 9, "spoke": 6}, {"id": 3, "name": "HIRAM BECK", "names": ["HIRAM BECK", "HIRAM"], "gender": "m", "first": 11, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROADSIDE MOTEL - ICE MACHINE ALCOVE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A concrete nook behind the lobby.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A humming ice machine, a flickering vending machine, a bulb in a wire cage.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain hammers the tin roof.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The ice machine shudders as if something moves inside.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LORRAINE PETTIGREW, 50s, in a bathrobe and mismatched slippers, clutches an empty plastic bucket.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her eyes keep drifting to the machine.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "DOT HOLLANDER, 60s, in a nightgown and a hairnet, leans against the vending machine with a bag of pretzels.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She doesn't open it.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "GIDEON MARSH, 30s, the night clerk, stands with his arms folded and a ring of keys on his belt.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "He chews gum, too fast.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "HIRAM BECK, 40s, a trucker in a green flannel, enters from the rain, shaking out his hood.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Whole parking lot's flooded. What's going on?", "name": "HIRAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Nothing. Go back to your room, sir.", "name": "GIDEON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "It's the machine.", "name": "LORRAINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "What about it?", "name": "HIRAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "It's been making that sound for an hour.", "name": "DOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Machines hum. That's what they do.", "name": "HIRAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "It isn't humming. Listen.", "name": "LORRAINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "They listen.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Under the rain, under the thrum of the motor, a slow, wet knocking from inside the steel.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Pipes.", "name": "HIRAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "It's pipes. Old pipes.", "name": "GIDEON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Then why did Mr. Alvarez in 12 say he heard his name?", "name": "DOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Mr. Alvarez is eighty-nine.", "name": "GIDEON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "And Mrs. Pruitt in 4 heard hers.", "name": "DOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "She's a drinker.", "name": "GIDEON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "I heard mine.", "name": "LORRAINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "The bulb flickers.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "The machine knocks again, three slow beats.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "What did it say?", "name": "HIRAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "It said \"Lorraine.\"", "name": "LORRAINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "That's not unusual. It's your name.", "name": "DOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "It said it in my mother's voice.", "name": "LORRAINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Ma'am--", "name": "HIRAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "She's been dead for nine years.", "name": "LORRAINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "The machine knocks again, closer to the door.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Gideon spits his gum into his palm.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "He pulls the keys off his belt and holds them in a white-knuckled fist.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "I'm going to open it.", "name": "GIDEON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Don't.", "name": "DOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "It's a machine, Dot.", "name": "GIDEON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Don't.", "name": "DOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Let him.", "name": "HIRAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Hiram, no.", "name": "DOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "He steps forward.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Fits a key.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "The lock turns with a click like a gunshot.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "For a moment nothing happens.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Then the door swings open on a bin of clear, perfect ice, and in the ice, packed tight and glistening, are the eyes of a woman, open and unblinking, staring up at the cage light.", "para": 8, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Mama?", "name": "LORRAINE", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "The eyes blink.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}]}