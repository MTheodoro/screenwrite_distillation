{"scene_id": "s00893", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00893.fountain", "heading": "INT. VFW HALL KITCHEN - NIGHT", "cast": [{"id": 0, "name": "ARLO PENDERGAST", "names": ["ARLO PENDERGAST", "ARLO"], "gender": "?", "first": 3, "spoke": 17}, {"id": 1, "name": "BILLIE STOKES", "names": ["BILLIE STOKES", "BILLIE"], "gender": "?", "first": 5, "spoke": 14}, {"id": 2, "name": "CEDRIC NAKAMURA", "names": ["CEDRIC NAKAMURA", "CEDRIC"], "gender": "?", "first": 7, "spoke": 9}, {"id": 3, "name": "FATHER ANSELM", "names": ["FATHER ANSELM"], "gender": "m", "first": 33, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. VFW HALL KITCHEN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A wake in the next room: muffled laughter, clinking glasses.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Here, under buzzing fluorescents, a steel counter holds trays of cold cuts, a coffee urn, and a single untouched casserole with a foil lid.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "ARLO PENDERGAST, 60s, in a dark suit gone shiny at the elbows, stands at the sink scrubbing a pot far past clean.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "His son's funeral program is folded in his breast pocket.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "action", "text": "BILLIE STOKES, 50s, his sister, in a black dress and sneakers, leans against the fridge with a plastic cup of wine.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Her eyes are swollen but dry.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "CEDRIC NAKAMURA, 30s, Arlo's nephew, comes through the swinging door with a tray of empties.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Loosened tie.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Fresh shaving cut.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "They're asking for a speech.", "name": "CEDRIC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Who is?", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Everybody.", "name": "CEDRIC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Tell them he's busy.", "name": "BILLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Doing what? Dishes?", "name": "CEDRIC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Don't.", "name": "BILLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Somebody has to do them.", "name": "ARLO", "speaker": 0, "ext": [], "paren": ["without turning"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Uncle Arlo, it's Danny's wake.", "name": "CEDRIC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "I know whose wake it is.", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Then come out. Please.", "name": "CEDRIC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "After the pot.", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "It's been clean for ten minutes.", "name": "BILLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "It's not clean.", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Arlo.", "name": "BILLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "It is not clean.", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "He scrubs harder.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The sponge squeals.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Cedric sets the tray on the counter and glances at Billie, who gives a tiny shake of her head.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "He's been like this since the service.", "name": "CEDRIC", "speaker": 2, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "He's been like this since March.", "name": "BILLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "I can hear you.", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Good.", "name": "BILLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The swinging door opens.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "FATHER ANSELM, 70s, enters in his black clerical collar, a dinner roll in one hand and a napkin in the other.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Round-faced, kind, tired.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "There you are, Arlo. I wondered where you'd gone.", "name": "FATHER ANSELM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Washing.", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "So I see.", "name": "FATHER ANSELM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Father, he doesn't want to talk.", "name": "BILLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "That's quite all right. I'll talk. Cedric, would you fetch more ice?", "name": "FATHER ANSELM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Sure.", "name": "CEDRIC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "He goes.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "The door flaps shut.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Anselm eases onto a stool, sets the roll on the counter, and folds his hands.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Danny was a good boy.", "name": "FATHER ANSELM", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Was he?", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Arlo.", "name": "FATHER ANSELM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "He was a good boy until he wasn't.", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Don't do this here.", "name": "BILLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Where, then? In front of the whole town?", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Not now.", "name": "BILLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "He called me from the highway. Did you know that?", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "No.", "name": "BILLIE", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "He called me from the highway at two in the morning and said \"Dad, I'm sorry.\" And I said, \"For what?\" And he said \"For all of it.\" And I said \"Go home and sleep.\"", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "You couldn't have known.", "name": "FATHER ANSELM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "That's what you all keep saying.", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Because it's true.", "name": "BILLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "It's not true. I knew. I knew and I said go home and sleep.", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "The pot clatters into the sink.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "Billie crosses the kitchen, takes his wet hands in hers, and holds them against her black dress.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "Arlo. Look at me.", "name": "BILLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "I can't.", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "Look at me.", "name": "BILLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "He does.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "His face crumples like paper in a fist.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "He doesn't make a sound.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "Anselm lowers his gaze to the roll.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "The wake rumbles on through the wall, a hundred voices pretending.", "para": 8, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "The kitchen door swings open again.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "Cedric stands with an ice bucket in both hands, pale.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "dialogue", "text": "Uncle Arlo. There's someone here.", "name": "CEDRIC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "dialogue", "text": "Who?", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "A kid. About Danny's age. He says he was with him. That night.", "name": "CEDRIC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "action", "text": "Everyone goes still.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "The coffee urn ticks.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "dialogue", "text": "Let him in.", "name": "BILLIE", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3]}]}