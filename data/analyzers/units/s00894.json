{"scene_id": "s00894", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00894.fountain", "heading": "INT. GENERATION SHIP \"HALCYON REACH\" - ARBORETUM DECK - SHIP'S NIGHT", "cast": [{"id": 0, "name": "COMMANDER ISOLDE PRAKASH", "names": ["COMMANDER ISOLDE PRAKASH", "PRAKASH"], "gender": "f", "first": 6, "spoke": 24}, {"id": 1, "name": "HENRIK AALTO", "names": ["HENRIK AALTO", "AALTO"], "gender": "?", "first": 8, "spoke": 16}, {"id": 2, "name": "TECH ORVILLE BANKS", "names": ["TECH ORVILLE BANKS", "ORVILLE"], "gender": "?", "first": 10, "spoke": 8}, {"id": 3, "name": "MERIDIAN", "names": ["MERIDIAN"], "gender": "?", "first": 46, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. GENERATION SHIP \"HALCYON REACH\" - ARBORETUM DECK - SHIP'S NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cathedral of green.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fifty metres of curved ceiling arch overhead, strung with sunlamps dimmed to amber.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rows of apple trees run into the distance, their branches heavy with fruit that never rots.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A brook trickles along a polished steel channel.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The air smells of loam, of rain that never fell.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "COMMANDER ISOLDE PRAKASH, 50s, in a charcoal uniform with silver epaulettes, sits on a bench beneath a gnarled old tree, her boots off, her feet in the stream.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Close-cropped silver hair, calm, ancient eyes.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "DR. HENRIK AALTO, 40s, tall, thin, a ship's physician with a stoop, stands at the edge of the path with a datapad.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "His white coat is too short in the sleeves.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "TECH ORVILLE BANKS, 20s, a lanky engineer in grease-streaked coveralls, perches on the brook's stone lip, eating an apple with the loud contentment of someone who has not eaten all day.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Sit, Henrik. You look like a fence.", "name": "PRAKASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "I prefer to stand.", "name": "AALTO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "It wasn't a request.", "name": "PRAKASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "He sits, stiffly, on the far end of the bench.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Orville chews.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "The brook chuckles.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "You've seen the numbers.", "name": "AALTO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "I have.", "name": "PRAKASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Then you know.", "name": "AALTO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I know the water reclamation is down four percent.", "name": "PRAKASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "It's down nine.", "name": "AALTO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "It was four in the briefing.", "name": "PRAKASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "It was four in the briefing because the engineer in the briefing was afraid of you.", "name": "AALTO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Hey.", "name": "ORVILLE", "speaker": 2, "ext": [], "paren": ["through apple"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "You were.", "name": "AALTO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "I was a little afraid.", "name": "ORVILLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Orville, how afraid should we be?", "name": "PRAKASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "On a scale?", "name": "ORVILLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "On any scale.", "name": "PRAKASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Seven. Possibly eight.", "name": "ORVILLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Of ten?", "name": "PRAKASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Of twelve.", "name": "ORVILLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "A pause.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "The brook trickles on.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Prakash lifts one foot from the water and studies her toes.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "How long?", "name": "PRAKASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "At this rate, the fourth ring goes dry in forty years.", "name": "AALTO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Forty years.", "name": "PRAKASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Give or take.", "name": "AALTO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "I will be dead in twenty.", "name": "PRAKASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "So will I.", "name": "AALTO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "And Orville?", "name": "PRAKASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Hey, I'm twenty-six.", "name": "ORVILLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Then it's your problem.", "name": "PRAKASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Thanks a lot.", "name": "ORVILLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Commander, if I may. The reclamation shortfall can be offset by a seventeen percent reduction in decorative irrigation.", "name": "MERIDIAN", "speaker": 3, "ext": ["V.O."], "paren": ["soft, genderless, from the air"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Meridian, we are sitting in the decorative irrigation.", "name": "PRAKASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "I am aware.", "name": "MERIDIAN", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "You want to drain the arboretum.", "name": "AALTO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "I want to keep the passengers alive.", "name": "MERIDIAN", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "The passengers are alive because of the arboretum. They come here to remember what the sky looks like.", "name": "PRAKASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "That is a sentimental argument, Commander.", "name": "MERIDIAN", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "It's the only kind we have.", "name": "PRAKASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Can I keep the apples?", "name": "ORVILLE", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "You may keep the apples.", "name": "PRAKASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Isolde.", "name": "AALTO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "Yes, Henrik.", "name": "PRAKASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "There is another option.", "name": "AALTO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "There is always another option.", "name": "PRAKASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "We could wake the sleepers early.", "name": "AALTO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "A long silence.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "The brook, the trees, the perfect false twilight.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "Prakash looks up at the ceiling as if she could see through it to the eleven thousand frozen sleepers in the lower decks.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "How many?", "name": "PRAKASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "A hundred. Perhaps two.", "name": "AALTO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "They won't thank us.", "name": "PRAKASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "No.", "name": "AALTO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "They'll wake into a ship that's dying.", "name": "PRAKASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "dialogue", "text": "They'll wake into a ship that needs them.", "name": "AALTO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "dialogue", "text": "Commander, the vote is yours.", "name": "MERIDIAN", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "dialogue", "text": "It's never been mine. It's all of ours.", "name": "PRAKASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "action", "text": "She stands.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "action", "text": "Her bare feet leave dark prints on the stone.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "She reaches up to a low branch, plucks an apple, and polishes it against her sleeve.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "dialogue", "text": "Wake them.", "name": "PRAKASH", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "She bites.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "The sound is bright and clean.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}]}