{"scene_id": "s00895", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00895.fountain", "heading": "INT. HOSPITAL ROOM 412 - NIGHT", "cast": [{"id": 0, "name": "YASMIN HADDAD", "names": ["YASMIN HADDAD", "YASMIN"], "gender": "?", "first": 3, "spoke": 7}, {"id": 1, "name": "NURSE FLORENCE OYELARAN", "names": ["NURSE FLORENCE OYELARAN", "FLORENCE"], "gender": "?", "first": 4, "spoke": 5}, {"id": 2, "name": "CONSTANCE ABERCROMBIE", "names": ["CONSTANCE ABERCROMBIE", "CONSTANCE"], "gender": "?", "first": 5, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOSPITAL ROOM 412 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Monitors blink.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A drip counts the seconds.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "DR. YASMIN HADDAD, 40s, stands by the bed with a chart.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "NURSE FLORENCE OYELARAN, 50s, adjusts a pillow.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "In the bed lies MRS. CONSTANCE ABERCROMBIE, 80s, awake, small as a bird.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Is it bad?", "name": "CONSTANCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "We're still running tests.", "name": "YASMIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "She means it's not good.", "name": "FLORENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Florence.", "name": "YASMIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "She asked.", "name": "FLORENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I did ask.", "name": "CONSTANCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Mrs. Abercrombie--", "name": "YASMIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Call me Connie. Everyone does.", "name": "CONSTANCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Connie, the scan shows a mass.", "name": "YASMIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "We'll know more tomorrow.", "name": "FLORENCE", "speaker": 1, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "How big?", "name": "CONSTANCE", "speaker": 2, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Four centimetres.", "name": "YASMIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "That's the size of a plum.", "name": "CONSTANCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "A small plum.", "name": "FLORENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I like plums.", "name": "CONSTANCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Yasmin lowers the chart.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "She sits on the edge of the bed.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "She takes the old woman's hand.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "We'll do everything we can.", "name": "YASMIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "You're a kind girl.", "name": "CONSTANCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "I'm trying to be.", "name": "YASMIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "She is.", "name": "FLORENCE", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Now. Would one of you please find me a plum?", "name": "CONSTANCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}