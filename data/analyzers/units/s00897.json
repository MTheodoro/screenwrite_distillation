{"scene_id": "s00897", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00897.fountain", "heading": "INT. ICU CUBICLE - NIGHT", "cast": [{"id": 0, "name": "AUGUSTINE BAPTISTE", "names": ["AUGUSTINE BAPTISTE", "BAPTISTE"], "gender": "?", "first": 3, "spoke": 5}, {"id": 1, "name": "NURSE JOSEFINA RIOS", "names": ["NURSE JOSEFINA RIOS", "JOSEFINA"], "gender": "?", "first": 5, "spoke": 3}, {"id": 2, "name": "DELPHINE ACHTERBERG", "names": ["DELPHINE ACHTERBERG", "DELPHINE"], "gender": "f", "first": 6, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. ICU CUBICLE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A ventilator sighs.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A woman lies motionless, wires everywhere.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "DR. AUGUSTINE BAPTISTE, 50s, reads a monitor.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "He frowns.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "action", "text": "NURSE JOSEFINA RIOS, 30s, checks a line and glances at the door.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "MRS. DELPHINE ACHTERBERG, 70s, the patient's mother, sits in the corner chair gripping her purse.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Pressure's dropping.", "name": "BAPTISTE", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Since eleven.", "name": "JOSEFINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "She adjusts the drip.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "He leans in.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "She steps back.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "He taps the glass.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She holds her breath.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Come on, come on.", "name": "BAPTISTE", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Is she in pain?", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "No, ma'am.", "name": "BAPTISTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Then why does she look like that?", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "It's the machine.", "name": "JOSEFINA", "speaker": 1, "ext": [], "paren": ["gently"], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Josefina, call the family.", "name": "BAPTISTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Which family?", "name": "JOSEFINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "All of it.", "name": "BAPTISTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Delphine rises.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Her purse slides to the floor.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "She stands by the bed and covers her daughter's hand with her own, and the monitor, very softly, begins to slow.", "para": 3, "sent": 2, "present": [0, 1, 2]}]}