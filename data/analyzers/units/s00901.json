{"scene_id": "s00901", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00901.fountain", "heading": "INT. CALL CENTER - BREAK ROOM - DAY", "cast": [{"id": 0, "name": "CHEF", "names": ["CHEF"], "gender": "?", "first": 2, "spoke": 0}, {"id": 1, "name": "HUGH BANTING", "names": ["HUGH BANTING", "HUGH"], "gender": "?", "first": 5, "spoke": 10}, {"id": 2, "name": "YOLANDA PEREIRA", "names": ["YOLANDA PEREIRA", "YOLANDA"], "gender": "f", "first": 6, "spoke": 6}, {"id": 3, "name": "GARRETT NG", "names": ["GARRETT NG", "GARRETT"], "gender": "m", "first": 7, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. CALL CENTER - BREAK ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Beige walls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A microwave with a sticky note: YOU ARE NOT A CHEF.", "para": 0, "sent": 1, "present": [0]}, {"u": 3, "kind": "action", "text": "A motivational poster of a rowing team.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "A vending machine blinking \"EXACT CHANGE.\"", "para": 0, "sent": 3, "present": [0]}, {"u": 5, "kind": "action", "text": "HUGH BANTING, 40s, team lead, polo tucked into khakis, stands at the whiteboard with a marker.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "YOLANDA PEREIRA, 30s, top agent, headset around her neck, eats yogurt in the corner.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "GARRETT NG, 20s, the newest, sits at the table with his laptop closed and his hands folded.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Team, quick huddle. Great numbers this week.", "name": "HUGH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Thanks, Hugh.", "name": "YOLANDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Garrett, I'm proud of you.", "name": "HUGH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Thanks. Hugh.", "name": "GARRETT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Yolanda, you're a rock star.", "name": "HUGH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "I'm eating.", "name": "YOLANDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Hugh caps the marker, uncaps it, and writes SYNERGY on the board, underlines it twice, and steps back like a man admiring a mural.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Yolanda scrapes the yogurt cup and drops it in the bin, Garrett checks his phone under the table, and Hugh turns and claps his hands together once, loud as a starter pistol.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Next quarter, we are going bigger.", "name": "HUGH", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "How much bigger?", "name": "YOLANDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Much.", "name": "HUGH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Does that include raises?", "name": "GARRETT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "It includes vision.", "name": "HUGH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Hugh, honestly, what's the news?", "name": "YOLANDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Hugh looks at the whiteboard.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "At his own handwriting.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "He sighs, and for the first time the cheerful voice drops out of him.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "They're closing the floor.", "name": "HUGH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "The vending machine blinks.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Closing it how?", "name": "GARRETT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Outsourcing. Thirty days.", "name": "HUGH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Thirty days?", "name": "YOLANDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "I was told not to say.", "name": "HUGH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "You just said.", "name": "YOLANDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "I know.", "name": "HUGH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "He wipes the whiteboard with his sleeve, the word SYNERGY smearing to a grey cloud.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Yolanda sets her headset on the table.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Garrett closes his phone.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Well. Great numbers this week.", "name": "GARRETT", "speaker": 3, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3]}]}