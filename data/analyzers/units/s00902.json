{"scene_id": "s00902", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00902.fountain", "heading": "EXT. SCHOOL ROOFTOP - SUNSET", "cast": [{"id": 0, "name": "JAMAL OKONKWO", "names": ["JAMAL OKONKWO", "JAMAL"], "gender": "m", "first": 3, "spoke": 4}, {"id": 1, "name": "SUNNY PARK", "names": ["SUNNY PARK", "SUNNY"], "gender": "?", "first": 4, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SCHOOL ROOFTOP - SUNSET", "present": []}, {"u": 1, "kind": "action", "text": "Gravel, a rusted vent, a chain-link railing.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The football field glows green below.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "JAMAL OKONKWO, 16, in a band jacket, sits cross-legged by the edge, a trombone case across his knees.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "SUNNY PARK, 16, arrives through the stairwell door, drops her backpack, kicks a pebble off the roof, and steps up beside him as the two of them watch it drop, Jamal tapping the case, Sunny pulling her hair into a bun, the pair silent while the marching band warms up below.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "Hey, losers!", "name": "SUNNY", "speaker": 1, "ext": [], "paren": ["to the field"], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "No one hears.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Jamal smiles.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You're not going to practice?", "name": "SUNNY", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Later.", "name": "JAMAL", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "That's what you said Tuesday.", "name": "SUNNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Tuesday was a mess.", "name": "JAMAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She sits.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Her shoulder bumps his.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He doesn't move away.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Mr. Dalrymple asked about you.", "name": "SUNNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "What did you say?", "name": "JAMAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "That you're sick.", "name": "SUNNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Am I?", "name": "JAMAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "You look sick.", "name": "SUNNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "He grins.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She takes a gum wrapper from her pocket and folds it into a tiny swan.", "para": 4, "sent": 1, "present": [0, 1]}]}