, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Drop in!", "name": "BUDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "BUDDY Don't! Watch this!", "name": "LENA", "speaker": 1, "ext": [], "paren": ["speaking at once", "speaking at once"], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "He drops.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "The wheels roar down the curve.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "He rides the wall, flicks the tail, and lands clean.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Samir whoops.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Lena claps once and returns to her sketchbook.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Did you get it, Buddy?", "name": "SAMIR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Did YOU get it?", "name": "BUDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "I think so.", "name": "SAMIR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Let me see.", "name": "LENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Samir hands her the phone.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "She watches.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "She smiles at the screen.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "She hands it back.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "You got it.", "name": "LENA", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Buddy lifts the board over his head like a trophy and screams at the sky.", "para": 4, "sent": 0, "present": [0, 1, 2]}]}