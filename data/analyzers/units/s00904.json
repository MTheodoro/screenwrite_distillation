{"scene_id": "s00904", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00904.fountain", "heading": "INT. FARMHOUSE - SPARE BEDROOM - NIGHT", "cast": [{"id": 0, "name": "ESTHER VANCE", "names": ["ESTHER VANCE", "ESTHER"], "gender": "f", "first": 5, "spoke": 8}, {"id": 1, "name": "LODGER", "names": ["LODGER"], "gender": "?", "first": 6, "spoke": 4}, {"id": 2, "name": "CALLOWAY", "names": ["CALLOWAY"], "gender": "?", "first": 20, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. FARMHOUSE - SPARE BEDROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A single bed.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "An oil lamp.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Cold wind knocks at the window.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A wardrobe stands half-open.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ESTHER VANCE, 60s, a widow in a quilted robe, perches on a hard chair with her hands knotted.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across the room, THE LODGER, 30s, sits on the edge of the bed, pale, shoes still on, his coat soaked.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Thank you for the room.", "name": "LODGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Rent is due Friday.", "name": "ESTHER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I'll pay.", "name": "LODGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I'm sure.", "name": "ESTHER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "A floorboard creaks in the hall.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Neither looks.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "I don't recall your name.", "name": "ESTHER", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "It doesn't matter.", "name": "LODGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "It matters to me.", "name": "ESTHER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "The wind rattles the glass.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "The lamp gutters.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He lifts his head.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "His eyes catch the flame in two small points.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Calloway.", "name": "LODGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Mr. Calloway.", "name": "ESTHER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "I didn't think I'd be asked.", "name": "CALLOWAY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Most guests give it freely.", "name": "ESTHER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "I'm not most guests.", "name": "CALLOWAY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "CALLOWAY No. I see that. You see more than you should.", "name": "ESTHER", "speaker": 0, "ext": [], "paren": ["speaking at once", "speaking at once"], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "She rises.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "The chair scrapes.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "She crosses to the wardrobe and closes it, softly, with a click.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Good night, Mr. Calloway.", "name": "ESTHER", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Good night.", "name": "CALLOWAY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "She leaves.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The door shuts.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "He sits a while in the lamplight.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Then he rises, goes to the wardrobe, and opens it again.", "para": 5, "sent": 3, "present": [0, 1, 2]}]}