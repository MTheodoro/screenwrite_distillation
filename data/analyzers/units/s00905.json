{"scene_id": "s00905", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00905.fountain", "heading": "INT. VICTORIAN CONSERVATORY - TEA TABLE - AFTERNOON", "cast": [{"id": 0, "name": "AUGUSTUS FINCH", "names": ["AUGUSTUS FINCH", "AUGUSTUS"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "LAVINIA CROSSLEY", "names": ["LAVINIA CROSSLEY", "LAVINIA"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "BARNABY HOOLE", "names": ["BARNABY HOOLE", "BARNABY"], "gender": "?", "first": 6, "spoke": 3}, {"id": 3, "name": "PRUDENCE LOVELACE", "names": ["PRUDENCE LOVELACE", "PRUDENCE"], "gender": "?", "first": 7, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. VICTORIAN CONSERVATORY - TEA TABLE - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "1887.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Glass walls, steaming ferns, a wicker table set with a silver service.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain streaks the panes.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "AUGUSTUS FINCH, 50s, whiskers like frost, holds a teacup in a hand that does not shake.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "LAVINIA CROSSLEY, 40s, in grey silk, pours.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "BARNABY HOOLE, 30s, a young curate, perches on the edge of a chair.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "PRUDENCE LOVELACE, 20s, a governess, stands by the ferns with a book.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Sugar, Mr. Finch?", "name": "LAVINIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "One lump.", "name": "AUGUSTUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Barnaby?", "name": "LAVINIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Two, please.", "name": "BARNABY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Three, if I were permitted.", "name": "PRUDENCE", "speaker": 3, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "I beg your pardon?", "name": "LAVINIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Nothing, ma'am.", "name": "PRUDENCE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "The teaspoon clinks.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Augustus sips.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "He sets down the cup, and the saucer rattles.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "He studies Barnaby.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "He studies Prudence.", "para": 2, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "She meets his eyes and does not look away.", "para": 2, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Miss Lovelace. You are acquainted with the curate.", "name": "AUGUSTUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "I am.", "name": "PRUDENCE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "We met at the vicarage.", "name": "BARNABY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "And did you leave it together?", "name": "AUGUSTUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "The rain intensifies.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Barnaby shifts in his chair, Lavinia lifts the teapot, and Prudence closes her book, all three moving at once, like a stage pantomime, while Augustus smiles and spreads butter on a scone.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Shall we have the lemon cake?", "name": "LAVINIA", "speaker": 1, "ext": [], "paren": ["to the table"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "By all means.", "name": "AUGUSTUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "I should be going.", "name": "BARNABY", "speaker": 2, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Sit.", "name": "AUGUSTUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "He sits.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Prudence steps to the table.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "She picks up the knife and cuts the cake into perfect, even slices.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "It would be a pity to waste it.", "name": "PRUDENCE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Augustus chuckles.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Lavinia relaxes by a hair.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}]}