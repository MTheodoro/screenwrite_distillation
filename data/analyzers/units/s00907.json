{"scene_id": "s00907", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00907.fountain", "heading": "INT. ICE HOCKEY LOCKER ROOM - BASEMENT ARENA - NIGHT", "cast": [{"id": 0, "name": "BOILERMAKERS", "names": ["BOILERMAKERS"], "gender": "?", "first": 4, "spoke": 0}, {"id": 1, "name": "COACH DIEGO ARMENTEROS", "names": ["COACH DIEGO ARMENTEROS"], "gender": "m", "first": 8, "spoke": 0}, {"id": 2, "name": "CAPTAIN BIRGIT HALVORSEN", "names": ["CAPTAIN BIRGIT HALVORSEN", "BIRGIT"], "gender": "f", "first": 9, "spoke": 7}, {"id": 3, "name": "SPUD", "names": ["SPUD"], "gender": "?", "first": 10, "spoke": 4}, {"id": 4, "name": "MURPHY", "names": ["MURPHY"], "gender": "?", "first": 10, "spoke": 0}, {"id": 5, "name": "TANYA OSEI", "names": ["TANYA OSEI", "TANYA"], "gender": "f", "first": 11, "spoke": 4}, {"id": 6, "name": "RAJ KUMARAN", "names": ["RAJ KUMARAN", "RAJ"], "gender": "?", "first": 12, "spoke": 3}, {"id": 7, "name": "ELLIOT CHU", "names": ["ELLIOT CHU", "ELLIOT"], "gender": "?", "first": 13, "spoke": 3}, {"id": 8, "name": "COACH", "names": ["COACH"], "gender": "?", "first": 17, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. ICE HOCKEY LOCKER ROOM - BASEMENT ARENA - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Steam.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Tape.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Sweat.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A banner: THE BOILERMAKERS, 1983.", "para": 0, "sent": 3, "present": [0]}, {"u": 5, "kind": "action", "text": "A dented bucket of sticks.", "para": 0, "sent": 4, "present": [0]}, {"u": 6, "kind": "action", "text": "Players in half-uniform sit hunched on benches.", "para": 0, "sent": 5, "present": [0]}, {"u": 7, "kind": "action", "text": "A faded whiteboard, its play diagrams ghosted over a dozen times.", "para": 0, "sent": 6, "present": [0]}, {"u": 8, "kind": "action", "text": "COACH DIEGO ARMENTEROS, 60s, ball cap pulled low, paces with a clipboard against his chest.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "CAPTAIN BIRGIT HALVORSEN, 30s, sits stiff, helmet in her lap, a bruise bright at her cheekbone.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "\"SPUD\" MURPHY, 20s, goalie, stares at the floor.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "TANYA OSEI, 20s, winger, retapes her stick.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "RAJ KUMARAN, 30s, defenseman, chews a mouthguard.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "action", "text": "ELLIOT CHU, 19, rookie, hands clasped like a boy in church.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 14, "kind": "action", "text": "Calm.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 15, "kind": "action", "text": "Too calm.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 16, "kind": "action", "text": "The roar of the arena rumbles faintly through the walls.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 17, "kind": "dialogue", "text": "Good first period.", "name": "COACH", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 18, "kind": "dialogue", "text": "We were down four-nil.", "name": "SPUD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 19, "kind": "dialogue", "text": "Good first period.", "name": "COACH", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 20, "kind": "action", "text": "Tanya and Birgit trade a glance.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 21, "kind": "action", "text": "Raj spits into a towel.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 22, "kind": "dialogue", "text": "Coach, you okay?", "name": "TANYA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 23, "kind": "dialogue", "text": "I'm great. Why?", "name": "COACH", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 24, "kind": "dialogue", "text": "You're being nice.", "name": "TANYA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 25, "kind": "dialogue", "text": "I'm always nice.", "name": "COACH", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 26, "kind": "dialogue", "text": "No you're not.", "name": "BIRGIT", "speaker": 2, "ext": [], "paren": ["dry"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 27, "kind": "dialogue", "text": "Captain, a word.", "name": "COACH", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 28, "kind": "action", "text": "Birgit rises.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 29, "kind": "action", "text": "They step to the far corner.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 30, "kind": "action", "text": "The team pretends not to watch.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 31, "kind": "action", "text": "Elliot lets out a breath that is almost a whistle.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 32, "kind": "dialogue", "text": "Is he mad?", "name": "ELLIOT", "speaker": 7, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 33, "kind": "dialogue", "text": "He's not mad.", "name": "RAJ", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 34, "kind": "dialogue", "text": "Then what?", "name": "ELLIOT", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 35, "kind": "dialogue", "text": "He's calm.", "name": "RAJ", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 36, "kind": "dialogue", "text": "Is that worse?", "name": "ELLIOT", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 37, "kind": "dialogue", "text": "That's how you know it's worse.", "name": "RAJ", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 38, "kind": "action", "text": "In the corner, the coach murmurs.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 39, "kind": "action", "text": "Birgit nods.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 40, "kind": "action", "text": "She nods again.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 41, "kind": "action", "text": "Then she turns, takes the whiteboard marker from its tray, and wipes the entire board with her sleeve.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 42, "kind": "dialogue", "text": "Listen up.", "name": "BIRGIT", "speaker": 2, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 43, "kind": "action", "text": "Everyone goes still.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 44, "kind": "dialogue", "text": "We are not down four-nil.", "name": "BIRGIT", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 45, "kind": "dialogue", "text": "Birgit, the scoreboard--", "name": "SPUD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 46, "kind": "dialogue", "text": "The scoreboard is wrong.", "name": "BIRGIT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 47, "kind": "dialogue", "text": "It's electronic. It can't be wrong.", "name": "TANYA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 48, "kind": "dialogue", "text": "It's wrong because Coach has been sitting on something since the second intermission.", "name": "BIRGIT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 49, "kind": "action", "text": "All eyes swing to the coach.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 50, "kind": "action", "text": "He studies his clipboard.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 51, "kind": "action", "text": "He sighs, hangs his head, and finally turns it around.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 52, "kind": "action", "text": "On the paper: not plays.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 53, "kind": "action", "text": "A list of names.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 54, "kind": "action", "text": "The opposing team's lineup, with a red line through nine of them.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 55, "kind": "dialogue", "text": "They're short. Nine of their guys were declared ineligible. Paperwork. League found out at the buzzer.", "name": "COACH", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 56, "kind": "dialogue", "text": "So?", "name": "SPUD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 57, "kind": "dialogue", "text": "So by the rules, we win. By forfeit. The game doesn't matter.", "name": "COACH", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 58, "kind": "action", "text": "A stunned pause.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 59, "kind": "action", "text": "Then, slowly, Tanya laughs.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 60, "kind": "action", "text": "Raj laughs.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 61, "kind": "action", "text": "Elliot looks from face to face, uncertain, until Spud lets out a whoop that shakes the lockers.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 62, "kind": "dialogue", "text": "You let us play a whole period for NOTHING?", "name": "TANYA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 63, "kind": "dialogue", "text": "I wanted to see what you'd do.", "name": "COACH", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 64, "kind": "dialogue", "text": "And?", "name": "BIRGIT", "speaker": 2, "ext": [], "paren": ["smiling"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 65, "kind": "dialogue", "text": "You were magnificent.", "name": "COACH", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 66, "kind": "dialogue", "text": "We were down FOUR.", "name": "SPUD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 67, "kind": "dialogue", "text": "Magnificent.", "name": "COACH", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 68, "kind": "action", "text": "Birgit tucks the clipboard under her arm.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 69, "kind": "action", "text": "She puts on her helmet and raps it twice with her glove.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 70, "kind": "dialogue", "text": "Come on. Let's go finish it anyway.", "name": "BIRGIT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 71, "kind": "action", "text": "They rise in a clatter of skates and sticks and pour out through the tunnel, and the arena noise swells to meet them.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}]}