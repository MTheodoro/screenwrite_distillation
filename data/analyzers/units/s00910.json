{"scene_id": "s00910", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00910.fountain", "heading": "EXT. WINDMILL RANCH - WATER TROUGH - DUSK", "cast": [{"id": 0, "name": "SHERIFF BARNABAS TUCK", "names": ["SHERIFF BARNABAS TUCK", "TUCK"], "gender": "m", "first": 3, "spoke": 11}, {"id": 1, "name": "OLIVE STARKEY", "names": ["OLIVE STARKEY", "OLIVE"], "gender": "?", "first": 11, "spoke": 11}], "units": [{"u": 0, "kind": "heading", "text": "EXT. WINDMILL RANCH - WATER TROUGH - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "A tall iron windmill creaks in the failing light.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A trough of dark water, a hitching post, a scatter of sleeping cattle on the hill.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "SHERIFF BARNABAS TUCK, 60s, stands with his hat in his hand, watering his horse.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "His badge is dull, his boots caked.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "action", "text": "He looks across the pasture.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Far down the road, a lantern bobs.", "para": 2, "sent": 1, "present": [0]}, {"u": 7, "kind": "dialogue", "text": "Visitors.", "name": "TUCK", "speaker": 0, "ext": [], "paren": ["to the horse"], "dual": false, "present": [0]}, {"u": 8, "kind": "action", "text": "The horse nickers.", "para": 3, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Tuck settles his hat and draws the rifle from its scabbard.", "para": 3, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "The lantern grows.", "para": 3, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "A buckboard emerges from the dusk, driven by OLIVE STARKEY, 40s, in a man's duster and a flat brim, a shotgun across her lap.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She reins up twenty feet away.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Evening, Sheriff.", "name": "OLIVE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Olive.", "name": "TUCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "You're off your range.", "name": "OLIVE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "So are you.", "name": "TUCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Not by my reckoning. This is my husband's ground.", "name": "OLIVE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Your husband's dead.", "name": "TUCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Then it's mine.", "name": "OLIVE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Wind in the iron blades.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "The cattle shift.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Tuck lowers the rifle a few inches.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "I'm too old for this.", "name": "TUCK", "speaker": 0, "ext": [], "paren": ["to the hills, tired"], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "You were too old ten years ago.", "name": "OLIVE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Is that why you came? To tell me so?", "name": "TUCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "I came to ask you to leave.", "name": "OLIVE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "I'll leave when I'm done.", "name": "TUCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Done with what?", "name": "OLIVE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Looking at the water.", "name": "TUCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "She studies him a long moment.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Then, slowly, she lays the shotgun in the bed of the buckboard and climbs down.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "She walks to the trough, kneels, and drinks from her cupped hands.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "It's good water.", "name": "OLIVE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "It's the best in the county.", "name": "TUCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "He dug that well himself.", "name": "OLIVE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "I know.", "name": "TUCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "She stands, wiping her palms on her duster.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Tuck holsters the rifle.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Stay for supper.", "name": "OLIVE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Is that an order?", "name": "TUCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "It's an apology.", "name": "OLIVE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "He smiles for the first time.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "The windmill turns, steady and patient, in the gathering dark.", "para": 8, "sent": 1, "present": [0, 1]}]}