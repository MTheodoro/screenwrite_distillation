{"scene_id": "s00911", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00911.fountain", "heading": "INT. CARGO CRANE CAB - SHIPPING PORT - NIGHT", "cast": [{"id": 0, "name": "AGENT RENATA VOSS", "names": ["AGENT RENATA VOSS", "RENATA"], "gender": "f", "first": 5, "spoke": 5}, {"id": 1, "name": "KARIM SALEH", "names": ["KARIM SALEH", "KARIM"], "gender": "?", "first": 6, "spoke": 3}, {"id": 2, "name": "LEO FONTANA", "names": ["LEO FONTANA", "LEO"], "gender": "m", "first": 7, "spoke": 3}, {"id": 3, "name": "OLGA DRAGOMIR", "names": ["OLGA DRAGOMIR", "OLGA"], "gender": "?", "first": 8, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. CARGO CRANE CAB - SHIPPING PORT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A glass cockpit forty metres above a sea of stacked containers.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sodium lamps glow below.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wind shakes the window.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A thermos, a radio, a paper bag of cold fries.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "AGENT RENATA VOSS, 40s, crouches below the control panel, gun drawn, her breath fogging the glass.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "KARIM SALEH, 30s, the crane operator, sits frozen at the joystick, hands raised.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "LEO FONTANA, 50s, a dockworker with a limp, clutches a canvas satchel against his chest.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "OLGA DRAGOMIR, 40s, a customs officer, stands at the rear door with a flashlight, mouth tight.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Nobody move.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "I'm not moving.", "name": "KARIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Neither am I.", "name": "LEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "This isn't what we agreed.", "name": "OLGA", "speaker": 3, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Ma'am, put the light down.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Olga lowers it.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "The beam wobbles across the floor.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Leo takes one step back.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Karim lowers one hand to the joystick.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Renata and Olga fire a look at each other.", "para": 2, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "The wind gusts.", "para": 2, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "The cab sways.", "para": 2, "sent": 6, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Mr. Fontana, the satchel.", "name": "RENATA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "It's mine.", "name": "LEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "It's evidence.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "It's my pension.", "name": "LEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Leo, shut up.", "name": "OLGA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "They all freeze again, Renata with her gun on Leo, Leo with his satchel, Olga with her hand drifting inside her coat, Karim with his fingers inches from the lever.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "A truck horn blares on the dock far below.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Everyone flinches.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "I could drop them. One pull. The whole container.", "name": "KARIM", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Don't.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "I'm saying I could.", "name": "KARIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Karim.", "name": "OLGA", "speaker": 3, "ext": [], "paren": ["sharp"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Olga draws a pistol.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Renata swings her aim.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Leo dives.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Karim yanks the lever.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "The crane lurches.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Containers shriek in their chains.", "para": 4, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "The floor tilts and everyone slides, gun, satchel, flashlight tumbling into the corner, and the whole cab begins to swing out over the black water.", "para": 4, "sent": 6, "present": [0, 1, 2, 3]}]}