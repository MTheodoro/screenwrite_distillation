{"scene_id": "s00912", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00912.fountain", "heading": "INT. DERELICT FREIGHTER - AIRLOCK CORRIDOR - NIGHT", "cast": [{"id": 0, "name": "ROLAND SZYMANSKI", "names": ["ROLAND SZYMANSKI", "SZYMANSKI"], "gender": "m", "first": 4, "spoke": 7}, {"id": 1, "name": "ENGINEER VIKTOR NILSSON", "names": ["ENGINEER VIKTOR NILSSON", "NILSSON"], "gender": "m", "first": 5, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. DERELICT FREIGHTER - AIRLOCK CORRIDOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Emergency strips pulse red.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Frost on the bulkheads.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A faint, steady hiss of failing air.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CAPT. ROLAND SZYMANSKI, 50s, slumps against a wall, his suit torn at the shoulder, helmet cradled in his lap.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "ENGINEER VIKTOR NILSSON, 40s, kneels beside him with a pry bar and a flickering handlamp.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "He grips his arm.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He grips the pry bar.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He stares at the hatch.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He's counting.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He's losing.", "para": 2, "sent": 4, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "How much oxygen?", "name": "NILSSON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Eight minutes.", "name": "SZYMANSKI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Not enough.", "name": "NILSSON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "It's what we've got.", "name": "SZYMANSKI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "He pushes off the wall.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Staggers.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Nilsson catches him.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He shrugs free.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Then he does it again.", "para": 3, "sent": 4, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Roland, stop.", "name": "NILSSON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "We both stop, we both die.", "name": "SZYMANSKI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "We both go on, we both die faster.", "name": "NILSSON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "He laughs.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "It becomes a cough.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "He wipes his mouth on a glove and stares at the red smear.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Open the hatch.", "name": "SZYMANSKI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "It's jammed.", "name": "NILSSON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Then unjam it.", "name": "SZYMANSKI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "I'm trying.", "name": "NILSSON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "He sets the bar against the seam and leans.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Metal groans.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Frost cracks off in sheets.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "He throws his weight into it a second time.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "A third.", "para": 5, "sent": 4, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "The hatch gives half an inch.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Cold, clean air whistles through.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "There.", "name": "NILSSON", "speaker": 1, "ext": ["CONT'D"], "paren": ["gasping"], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Go.", "name": "SZYMANSKI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "You first.", "name": "NILSSON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "That's an order.", "name": "SZYMANSKI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Then I'm disobeying.", "name": "NILSSON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "He grips the wounded arm and hauls it over his shoulder.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Together they wedge through the gap, a tangle of limbs and tubing, and tumble into the dark beyond.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "The hatch swings shut behind them with a single, final clang.", "para": 7, "sent": 2, "present": [0, 1]}]}