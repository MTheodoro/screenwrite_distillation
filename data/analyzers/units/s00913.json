{"scene_id": "s00913", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00913.fountain", "heading": "INT. STAGECOACH - MOVING - DAY", "cast": [{"id": 0, "name": "BOONE MCCREADY", "names": ["BOONE MCCREADY", "BOONE"], "gender": "m", "first": 1, "spoke": 19}, {"id": 1, "name": "JOSIAH PRICE", "names": ["JOSIAH PRICE", "JOSIAH"], "gender": "m", "first": 2, "spoke": 18}, {"id": 2, "name": "LILA STONE", "names": ["LILA STONE", "LILA"], "gender": "f", "first": 3, "spoke": 13}], "units": [{"u": 0, "kind": "heading", "text": "INT. STAGECOACH - MOVING - DAY", "present": []}, {"u": 1, "kind": "action", "text": "BOONE MCCREADY, 40s, a bounty hunter, sits wedged against the window with a battered rifle across his lap.", "para": 0, "sent": 0, "present": [0]}, {"u": 2, "kind": "action", "text": "JOSIAH PRICE, 60s, a whiskey drummer in a checked suit, fans himself with a hat.", "para": 0, "sent": 1, "present": [0, 1]}, {"u": 3, "kind": "action", "text": "LILA STONE, 20s, in a grey travelling dress, holds a hatbox on her knees.", "para": 0, "sent": 2, "present": [0, 1, 2]}, {"u": 4, "kind": "dialogue", "text": "How far to Prosper Creek?", "name": "BOONE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "Another six hours. If the axle holds.", "name": "JOSIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "It won't.", "name": "LILA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Young lady, you can't know that.", "name": "JOSIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "I heard it crack at the last stop.", "name": "LILA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "She's right.", "name": "BOONE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "You heard it too?", "name": "JOSIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I heard the driver pray.", "name": "BOONE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Drivers always pray.", "name": "JOSIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Not that loud.", "name": "BOONE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "What happens if it breaks?", "name": "LILA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "We walk.", "name": "BOONE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "In this heat?", "name": "JOSIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "In any heat.", "name": "BOONE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "I can walk.", "name": "LILA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Can you walk in those shoes?", "name": "BOONE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I walked here in them.", "name": "LILA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "From where?", "name": "JOSIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "From Ohio.", "name": "LILA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Ohio's two thousand miles.", "name": "JOSIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Then I've had practice.", "name": "LILA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "She'll do.", "name": "BOONE", "speaker": 0, "ext": [], "paren": ["a dry chuckle"], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "What's in the hatbox, miss?", "name": "JOSIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "A hat.", "name": "LILA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Just a hat?", "name": "JOSIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Mostly.", "name": "LILA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Don't ask, Josiah.", "name": "BOONE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "I'm only curious.", "name": "JOSIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Curious gets you buried at Prosper Creek.", "name": "BOONE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Is that so.", "name": "JOSIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "I've dug the graves.", "name": "BOONE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "You dig graves?", "name": "LILA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "I dig what pays.", "name": "BOONE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "And what pays today?", "name": "LILA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Ask your friend.", "name": "BOONE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "I beg your pardon?", "name": "JOSIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Mr. Price. Open your coat.", "name": "BOONE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "I will do no such thing.", "name": "JOSIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Open it.", "name": "BOONE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "This is outrageous.", "name": "JOSIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "He has a gun, Mr. McCready.", "name": "LILA", "speaker": 2, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "I know. I saw it at the depot.", "name": "BOONE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Madam, you are mistaken.", "name": "JOSIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Sir, I'm not.", "name": "LILA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Well. That changes the arithmetic.", "name": "JOSIAH", "speaker": 1, "ext": [], "paren": ["after a long breath"], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "It does.", "name": "BOONE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Who is the bounty on?", "name": "JOSIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Not you, Josiah.", "name": "BOONE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Then who?", "name": "JOSIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Her.", "name": "BOONE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Lila's hands tighten on the hatbox.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "The coach lurches.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Something cracks beneath them.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Far off, the driver begins to pray very, very loudly.", "para": 1, "sent": 3, "present": [0, 1, 2]}]}