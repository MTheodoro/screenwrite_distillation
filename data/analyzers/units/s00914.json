{"scene_id": "s00914", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00914.fountain", "heading": "EXT. THE MOSSBACK FERRY - ENCHANTED MARSH - TWILIGHT", "cast": [{"id": 0, "name": "ORLAITH", "names": ["ORLAITH"], "gender": "f", "first": 5, "spoke": 5}, {"id": 1, "name": "THORNE", "names": ["THORNE"], "gender": "m", "first": 9, "spoke": 4}, {"id": 2, "name": "BRACKEN", "names": ["BRACKEN"], "gender": "?", "first": 13, "spoke": 7}, {"id": 3, "name": "MISTRESS YARROW", "names": ["MISTRESS YARROW", "YARROW"], "gender": "m", "first": 16, "spoke": 3}, {"id": 4, "name": "PIPKIN LESS", "names": ["PIPKIN LESS", "PIPKIN"], "gender": "m", "first": 18, "spoke": 5}, {"id": 5, "name": "LANTERN", "names": ["LANTERN"], "gender": "?", "first": 30, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. THE MOSSBACK FERRY - ENCHANTED MARSH - TWILIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A flat-bottomed barge poled across a lake of black glass.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Willow roots hang down like grey hair.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Lanterns made of glass beetles bob at the corners of the deck.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Frogs sing in a low, ancient chord.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ORLAITH, 20s, a young ranger in moss-green leathers, leans on the rail with a longbow slung behind her shoulder.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Freckles.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Sharp grin.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "She watches the water for movement.", "para": 1, "sent": 3, "present": [0]}, {"u": 9, "kind": "action", "text": "THORNE, 40s, her older brother, stands at the prow, hand on his sword hilt, jaw set against a wind that isn't there.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Broad.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Scarred.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Silent as a post.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "BRACKEN, 60s, the ferryman, poles the barge with slow, patient strokes.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "A bent old man in a coat sewn from bark and feathers.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "One eye milky white.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "MISTRESS YARROW, 50s, a herbalist in a patched purple cloak, kneels on the deck sorting dried flowers into a wooden case.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "She hums.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "PIPKIN THE LESS, 12, a boy no taller than a barrel, hides behind a stack of crates and clutches a talking lantern, which whispers to him.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "How long till the far bank, Bracken?", "name": "ORLAITH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Long as it takes.", "name": "BRACKEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "That's not an answer.", "name": "ORLAITH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "It's the only one.", "name": "BRACKEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "She rolls her eyes, but her grin deepens.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Thorne glances back at his sister, then forward again.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Yarrow lifts a flower to the light.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Moonthistle. Almost gone from the marsh.", "name": "YARROW", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "You've got a whole case.", "name": "ORLAITH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "That's why it's almost gone.", "name": "YARROW", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "She's stealing it.", "name": "PIPKIN", "speaker": 4, "ext": [], "paren": ["whispering to the lantern"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Not stealing. Gathering.", "name": "LANTERN", "speaker": 5, "ext": [], "paren": ["a tiny voice"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Same thing.", "name": "PIPKIN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Pipkin.", "name": "THORNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Yes, Thorne?", "name": "PIPKIN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Stop talking to the lantern.", "name": "THORNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "He talks first.", "name": "PIPKIN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Then stop answering.", "name": "THORNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Pipkin sulks.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "The ferry glides through a curtain of willow, and the light changes to a deep underwater green.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Everyone falls quiet.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Even the frogs.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Hush now.", "name": "BRACKEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "What is it?", "name": "ORLAITH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "Something old.", "name": "BRACKEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Thorne draws his sword an inch.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Orlaith slips an arrow from her quiver without taking her eyes off the water.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Yarrow closes the case with a quiet click.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "Pipkin ducks lower, and the lantern's glow dims to the colour of a candle in a drawer.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "The water bulges, slow and enormous, then settles again, leaving nothing but a ring of ripples spreading toward the banks.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "Gone.", "name": "BRACKEN", "speaker": 2, "ext": ["CONT'D"], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "What was that?", "name": "THORNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "The marsh saying hello.", "name": "BRACKEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "Friendly.", "name": "ORLAITH", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "It means we're welcome.", "name": "YARROW", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "Can I come out now?", "name": "PIPKIN", "speaker": 4, "ext": [], "paren": ["peeping out"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "Aye, boy.", "name": "BRACKEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "Pipkin scrambles out from behind the crates.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "He sits beside Yarrow, who gives him a sprig of moonthistle without a word.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "He tucks it behind his ear, grinning.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "The ferry drifts into the open water once more, and up ahead, through the gathering dusk, the far bank shimmers like a lit window.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}