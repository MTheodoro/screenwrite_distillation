{"scene_id": "s00915", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00915.fountain", "heading": "INT. TOLLIVER HOUSE - KITCHEN - MORNING", "cast": [{"id": 0, "name": "GLORIA MENDEZ-HART", "names": ["GLORIA MENDEZ-HART", "GLORIA"], "gender": "f", "first": 4, "spoke": 19}, {"id": 1, "name": "RAYMOND TOLLIVER", "names": ["RAYMOND TOLLIVER", "RAYMOND"], "gender": "m", "first": 5, "spoke": 13}, {"id": 2, "name": "CLAIRE TOLLIVER", "names": ["CLAIRE TOLLIVER", "CLAIRE"], "gender": "f", "first": 5, "spoke": 24}], "units": [{"u": 0, "kind": "heading", "text": "INT. TOLLIVER HOUSE - KITCHEN - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Sunlight on yellow linoleum.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A clock shaped like a rooster.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A pot of coffee on the stove, a stack of unopened mail.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "GLORIA MENDEZ-HART, 60s, in a floral housecoat, cracks eggs into a bowl with practiced flicks.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "RAYMOND TOLLIVER, 60s, her husband, reads the newspaper at the table, spectacles low.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "CLAIRE TOLLIVER, 30s, their daughter, stands in the doorway with a suitcase in one hand and her car keys in the other.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "You're up early.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "I couldn't sleep.", "name": "CLAIRE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Sit. I'll make you eggs.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I'm not hungry, Mama.", "name": "CLAIRE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Nonsense. You're a Tolliver. You're always hungry.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "She's got a point.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": ["from behind the paper"], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Daddy.", "name": "CLAIRE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I'm just agreeing with your mother. It's rare, so savour it.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Claire sets the suitcase down by the door.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "She hesitates.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Then she sits at the table across from him, still holding her keys.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Toast?", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Sure.", "name": "CLAIRE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Butter or jam?", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Both.", "name": "CLAIRE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "That's my girl.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "She drops two slices into the toaster.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Hums.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Raymond turns a page.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The clock ticks.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "A fly buzzes against the window.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "It is, in every way, an ordinary morning.", "para": 3, "sent": 5, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "How's the drive?", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Six hours.", "name": "CLAIRE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Take the highway. The back road's a mess.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "I know.", "name": "CLAIRE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Stop for gas in Salina.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Daddy, I know.", "name": "CLAIRE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "I'm only saying.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "He's only saying.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Mama.", "name": "CLAIRE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "What?", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Nothing.", "name": "CLAIRE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "The toast pops.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Gloria sets a plate in front of her daughter, jam spread thick, butter melting.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Claire stares at it.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "I need to tell you something.", "name": "CLAIRE", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "You always say that before you tell us something awful.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "It isn't awful.", "name": "CLAIRE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Then say it.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": ["lowering the paper"], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "I'm not going to Chicago.", "name": "CLAIRE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "The rooster clock ticks.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Of course you are. You've got the apartment.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "I gave it up.", "name": "CLAIRE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "When?", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Two weeks ago.", "name": "CLAIRE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "Two weeks.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "I didn't know how to tell you.", "name": "CLAIRE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "What about the job?", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "I quit.", "name": "CLAIRE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "You QUIT?", "name": "GLORIA", "speaker": 0, "ext": [], "paren": ["sharply"], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "Mama, please.", "name": "CLAIRE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "You studied for six years.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "I know.", "name": "CLAIRE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "We paid for--", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "Gloria.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "What? I'm asking.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "Let her talk.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "Claire. Talk.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "Claire folds her hands on the table.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "She looks first at her father, then at her mother, then at the plate of toast.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "Her voice, when it comes, is small and steady.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 70, "kind": "dialogue", "text": "I'm sick.", "name": "CLAIRE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 71, "kind": "action", "text": "Gloria's whisk stops.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 72, "kind": "action", "text": "Raymond's spectacles slide down his nose.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 73, "kind": "dialogue", "text": "I didn't want to say it until I was sure. Now I'm sure. I'm sorry.", "name": "CLAIRE", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 74, "kind": "dialogue", "text": "Claire.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": ["barely audible"], "dual": false, "present": [0, 1, 2]}, {"u": 75, "kind": "dialogue", "text": "That's why I came home. To tell you in the kitchen. I thought... I don't know. I thought the kitchen would be easier.", "name": "CLAIRE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 76, "kind": "dialogue", "text": "Is it the kind they fix?", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": ["a long moment"], "dual": false, "present": [0, 1, 2]}, {"u": 77, "kind": "dialogue", "text": "They think so.", "name": "CLAIRE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 78, "kind": "dialogue", "text": "Then that's what we'll do.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 79, "kind": "dialogue", "text": "We will.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": ["setting down the whisk"], "dual": false, "present": [0, 1, 2]}, {"u": 80, "kind": "dialogue", "text": "Mama--", "name": "CLAIRE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 81, "kind": "dialogue", "text": "We will.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 82, "kind": "action", "text": "She crosses the room, and takes her daughter's face in both her hands.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 83, "kind": "action", "text": "The coffee boils over behind her.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 84, "kind": "action", "text": "Nobody moves to stop it.", "para": 8, "sent": 2, "present": [0, 1, 2]}]}