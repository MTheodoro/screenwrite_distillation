{"scene_id": "s00916", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00916.fountain", "heading": "INT. COUNTRY MANOR - LIBRARY - DAWN", "cast": [{"id": 0, "name": "INSPECTOR HAMISH LOGAN", "names": ["INSPECTOR HAMISH LOGAN", "LOGAN"], "gender": "f", "first": 5, "spoke": 5}, {"id": 1, "name": "CONSTABLE RHIANNON DAVIES", "names": ["CONSTABLE RHIANNON DAVIES", "DAVIES"], "gender": "?", "first": 6, "spoke": 3}, {"id": 2, "name": "ODILE FAURE", "names": ["ODILE FAURE", "ODILE"], "gender": "?", "first": 7, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. COUNTRY MANOR - LIBRARY - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Grey light through lead windows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A body-shaped hush over the room.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A fallen chair.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A wine glass shattered on the hearth.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "INSPECTOR HAMISH LOGAN, 50s, tweed and a tired moustache, stoops over a rug stained dark.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "CONSTABLE RHIANNON DAVIES, 20s, hovers with a notebook, pencil pressed so hard the lead snaps.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "MS. ODILE FAURE, 40s, the housekeeper, stands in the doorway with a lantern, upright as a candle.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Who found him?", "name": "LOGAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "I did.", "name": "ODILE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "She says she heard a crash.", "name": "DAVIES", "speaker": 1, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "At three. I came down in my robe.", "name": "ODILE", "speaker": 2, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "And the door?", "name": "LOGAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Locked from inside.", "name": "ODILE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Locked from inside, sir. We had to break it.", "name": "DAVIES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Who has the key?", "name": "LOGAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Sir Percival.", "name": "ODILE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Where's the key now?", "name": "LOGAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Odile says nothing.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Logan straightens, looks at the constable, who looks at the hearth.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Odile steps into the room, sets down her lantern on the mantel, Davies wipes her pencil on her sleeve, Logan crouches again beside the rug, and the three of them move in slow, careful circles around the same dead space, until Davies suddenly freezes and points at the shattered glass.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Sir. There's a key.", "name": "DAVIES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Logan follows her finger.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "In the splintered crystal, glinting in the grey light, lies a small brass key.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Well, well.", "name": "LOGAN", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "He looks at Odile.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "She does not blink.", "para": 4, "sent": 1, "present": [0, 1, 2]}]}