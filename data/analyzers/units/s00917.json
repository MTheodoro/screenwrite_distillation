{"scene_id": "s00917", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00917.fountain", "heading": "INT. BLUMENTHAL FARMHOUSE - SUNPORCH - LATE AFTERNOON", "cast": [{"id": 0, "name": "EZRA BLUMENTHAL", "names": ["EZRA BLUMENTHAL", "EZRA"], "gender": "?", "first": 5, "spoke": 9}, {"id": 1, "name": "NELL BLUMENTHAL", "names": ["NELL BLUMENTHAL", "NELL"], "gender": "?", "first": 5, "spoke": 5}, {"id": 2, "name": "KIP", "names": ["KIP"], "gender": "m", "first": 9, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. BLUMENTHAL FARMHOUSE - SUNPORCH - LATE AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "A glassed-in porch, ferns in coffee cans, a worn wicker couch.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dust motes spin in a long slant of gold.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A crocheted blanket drapes the arm of the couch.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The sound of crickets rises from the lawn.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "EZRA BLUMENTHAL, 80s, sits in a rocker with a tartan shawl across his knees.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "His hands are spotted and still.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "His eyes are the pale blue of old china.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "NELL BLUMENTHAL, 50s, his daughter, perches on the couch with a basket of mending, needle flashing.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "KIP, 9, her son, lies on the floor with a model airplane, flying it in circles above his head.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Grandpa, did you really build a plane?", "name": "KIP", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I built a glider.", "name": "EZRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Dad, don't.", "name": "NELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "He asked.", "name": "EZRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "How high did it go?", "name": "KIP", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Higher than the barn.", "name": "EZRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "It crashed into the barn.", "name": "NELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "It crashed after the barn.", "name": "EZRA", "speaker": 0, "ext": [], "paren": ["a soft laugh"], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Did you get hurt?", "name": "KIP", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Only my pride.", "name": "EZRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "And your leg.", "name": "NELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "And the leg. Fine.", "name": "EZRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Can we build one?", "name": "KIP", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Kip--", "name": "NELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Of course. We'll start Saturday.", "name": "EZRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Dad.", "name": "NELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Saturday.", "name": "EZRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "The room goes quiet.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Kip looks at his mother, then at his grandfather, then back at the plane in his hands.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "The crickets keep singing.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Ezra gazes through the glass at the long grass, bending and straightening in the evening wind.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Saturday.", "name": "EZRA", "speaker": 0, "ext": ["CONT'D"], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Nell stitches.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "She pulls the thread tight and bites it off.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Her eyes are bright, and she does not look up.", "para": 4, "sent": 2, "present": [0, 1, 2]}]}