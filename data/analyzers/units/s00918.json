{"scene_id": "s00918", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00918.fountain", "heading": "INT. COURTHOUSE - BASEMENT HOLDING OFFICE - DAY", "cast": [{"id": 0, "name": "CORNELIA BASSETT", "names": ["CORNELIA BASSETT", "CORNELIA"], "gender": "?", "first": 4, "spoke": 10}, {"id": 1, "name": "HAROLD VANTERPOOL", "names": ["HAROLD", "HAROLD VANTERPOOL"], "gender": "m", "first": 8, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. COURTHOUSE - BASEMENT HOLDING OFFICE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Cinder-block walls, a steel table, a ringing phone.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A water-stained ceiling.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "One window, barred, at ankle level.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CORNELIA BASSETT, 40s, a defense attorney in a charcoal suit, paces with a stack of folders under one arm and a cold coffee in the other hand.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She checks her watch.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Again.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "The intercom on the wall crackles.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "dialogue", "text": "Ms. Bassett? Ms. Bassett, are you there?", "name": "HAROLD", "speaker": 1, "ext": ["V.O."], "paren": ["through the speaker"], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I'm here, Harold.", "name": "CORNELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "They moved the hearing up.", "name": "HAROLD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "To when?", "name": "CORNELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Ten minutes.", "name": "HAROLD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She sets down the coffee.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "It sloshes over the lip.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She looks at the folders, at the door, at the clock.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Where's my client?", "name": "CORNELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Still upstairs. Processing.", "name": "HAROLD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Tell them to hurry.", "name": "CORNELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "I did.", "name": "HAROLD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Tell them again.", "name": "CORNELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "I'm coming down.", "name": "HAROLD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "The intercom clicks off.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She dumps the folders onto the table and tears through them, sheets flying.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "A door bangs somewhere above.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Footsteps hammer the stairwell, and HAROLD VANTERPOOL, 60s, a sweating court clerk with a ring of keys and a bow tie askew, bursts in, holding a paper above his head like a prize.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "He wheezes and she whirls to meet him, snatching the paper, and he doubles over, hands on his knees, while she scans the page and slowly, grimly, begins to smile.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "This is the affidavit.", "name": "CORNELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Found it in Judge Mercer's chambers.", "name": "HAROLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "You stole it.", "name": "CORNELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "I borrowed it. Without asking.", "name": "HAROLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Harold, you beautiful man.", "name": "CORNELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Ten minutes, Counselor.", "name": "HAROLD", "speaker": 1, "ext": [], "paren": ["catching his breath"], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Eight, now.", "name": "CORNELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "She grabs her folders, squares her shoulders, and strides to the door.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Harold straightens his bow tie.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Good luck.", "name": "HAROLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Luck is for the prosecution.", "name": "CORNELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}