{"scene_id": "s00919", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00919.fountain", "heading": "INT. OPERA HOUSE - FLY GALLERY - NIGHT", "cast": [{"id": 0, "name": "SABINE ORTEGA", "names": ["SABINE ORTEGA", "SABINE"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "CALLUM REID", "names": ["CALLUM REID", "CALLUM"], "gender": "m", "first": 5, "spoke": 3}, {"id": 2, "name": "WANJIRU KARIUKI", "names": ["WANJIRU KARIUKI", "WANJIRU"], "gender": "f", "first": 6, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. OPERA HOUSE - FLY GALLERY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A narrow catwalk above the stage.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Ropes and sandbags, counterweights, a chandelier cable thick as an arm.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Below, a performance of \"La Traviata\" swells through the dark.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SABINE ORTEGA, 40s, in black, crouches at a winch with a glass cutter.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "CALLUM REID, 30s, hangs from a harness, a duffel at his hip.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "WANJIRU KARIUKI, 20s, the new hire, grips the rail, eyes huge.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Quiet. Quiet.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "I am quiet.", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Is it supposed to be this loud down there?", "name": "WANJIRU", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "That's the opera.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "It's very opera.", "name": "WANJIRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Cut the cable on my signal.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She raises one gloved hand.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Below, the soprano reaches a trembling high note.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "The audience gasps.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Now.", "name": "SABINE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Wait, wait, wait.", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Wait?", "name": "WANJIRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "SABINE There's a guard. There's no guard.", "name": "CALLUM", "speaker": 1, "ext": [], "paren": ["speaking at once", "speaking at once"], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "They freeze.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Far below, a flashlight beam slides across the stage and up through the rigging.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "It stops on the chandelier.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "It stops on them.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "She slides the cutter into her belt.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "He shifts his weight in the harness, the whole rig swaying.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "She looks at Callum.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "She looks at Wanjiru.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Then she looks at the cable.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Cut it anyway.", "name": "SABINE", "speaker": 0, "ext": ["CONT'D"], "paren": ["a breath"], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "But--", "name": "WANJIRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Do it.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Wanjiru closes her eyes, takes the cutter, and severs the cable.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "The chandelier drops.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "The audience screams.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Everything goes dark.", "para": 6, "sent": 0, "present": [0, 1, 2]}]}