{"scene_id": "s00926", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00926.fountain", "heading": "INT. SIGNAL BUNKER, MOUNTAIN PASS - NIGHT", "cast": [{"id": 0, "name": "CAPTAIN ISADORA REYES-WINTHROP", "names": ["CAPTAIN ISADORA REYES-WINTHROP", "ISADORA"], "gender": "f", "first": 5, "spoke": 3}, {"id": 1, "name": "LIEUTENANT KOFI ASANTE-BRIGGS", "names": ["LIEUTENANT KOFI ASANTE-BRIGGS", "KOFI"], "gender": "m", "first": 6, "spoke": 2}, {"id": 2, "name": "COMMAND", "names": ["COMMAND"], "gender": "?", "first": 9, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. SIGNAL BUNKER, MOUNTAIN PASS - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A concrete cell the size of a freight elevator.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "One bare bulb.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A field radio on a shelf, its dial glowing amber.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Frost feathers the inside of a rifle slit.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CAPTAIN ISADORA REYES-WINTHROP (30s, grey streak in black hair, eyes like cold coins) sits on an ammo box with her boots off, rubbing her feet.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Opposite her, LIEUTENANT KOFI ASANTE-BRIGGS (20s, still wearing his helmet, as if afraid to take it off) stares at the radio.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "It hisses.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "A voice breaks through.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "All stations, cease fire. Repeat, cease fire. It's over.", "name": "COMMAND", "speaker": 2, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Neither moves.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Captain?", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "I heard.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Is it a trick?", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Probably not.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "She pulls her socks back on, slowly.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "He finally removes his helmet.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "His hair is wet with sweat.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Acknowledge, bunker seven.", "name": "COMMAND", "speaker": 2, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Isadora lifts the handset, lets her thumb hover, and sets it down again.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Give me a minute.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}