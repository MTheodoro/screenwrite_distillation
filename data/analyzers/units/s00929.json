{"scene_id": "s00929", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00929.fountain", "heading": "INT. FROZEN FOOD WAREHOUSE, WALK-IN FREEZER - NIGHT", "cast": [{"id": 0, "name": "DELPHINE KOWALCZYK-ABARA", "names": ["DELPHINE KOWALCZYK-ABARA", "DELPHINE"], "gender": "?", "first": 4, "spoke": 9}, {"id": 1, "name": "TOBY", "names": ["TOBY"], "gender": "?", "first": 13, "spoke": 7}, {"id": 2, "name": "FENWICK", "names": ["FENWICK"], "gender": "?", "first": 13, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. FROZEN FOOD WAREHOUSE, WALK-IN FREEZER - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Minus twenty.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Breath clouds.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Pallets of frozen pierogi stacked to the rafters.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DELPHINE KOWALCZYK-ABARA (30s, parka, safecracker's fingertips) kneels at a steel floor safe.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Stethoscope on the dial.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Click.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Click.", "para": 2, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "Click.", "para": 2, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "She stops.", "para": 3, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "Listens.", "para": 3, "sent": 1, "present": [0]}, {"u": 11, "kind": "action", "text": "Click.", "para": 3, "sent": 2, "present": [0]}, {"u": 12, "kind": "action", "text": "The heavy door groans.", "para": 4, "sent": 0, "present": [0]}, {"u": 13, "kind": "action", "text": "TOBIAS \"TOBY\" FENWICK (20s, lookout, ski mask rolled up) slips in, hopping from foot to foot.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "My toes are gone.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "You've got more.", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "How long?", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Quiet.", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Click.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "This is going well.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "It's going fine.", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Too well. Nobody's here.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Nobody's here because it's a freezer.", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "She turns the dial.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The safe door swings open.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Inside, empty.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Just a single index card.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "\"Sorry. -- Management.\"", "name": "DELPHINE", "speaker": 0, "ext": ["CONT'D"], "paren": ["reading"], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "They knew!", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "They knew.", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "The freezer lights snap off.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Dark.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Then back on, bright.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "The heavy door is closed.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Outside, a latch clicks.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "A padlock.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Delphine?", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Don't.", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "We're locked in.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "I said don't.", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "She pockets the card.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Pulls her hood tight.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Looks up at the pierogi.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "At least we won't starve.", "name": "DELPHINE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}]}