{"scene_id": "s00931", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00931.fountain", "heading": "INT. PARKING STRUCTURE, LEVEL P4 - NIGHT", "cast": [{"id": 0, "name": "KAZ", "names": ["KAZ"], "gender": "?", "first": 5, "spoke": 5}, {"id": 1, "name": "DRAGOMIR", "names": ["DRAGOMIR"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "LEO", "names": ["LEO"], "gender": "?", "first": 6, "spoke": 4}, {"id": 3, "name": "MARCHETTI", "names": ["MARCHETTI"], "gender": "?", "first": 6, "spoke": 0}, {"id": 4, "name": "AGENT CALLUM BRIGHTWATER", "names": ["AGENT CALLUM BRIGHTWATER", "CALLUM"], "gender": "m", "first": 10, "spoke": 6}, {"id": 5, "name": "AGENT PRIYA RAMAKRISHNAN", "names": ["AGENT PRIYA RAMAKRISHNAN", "PRIYA"], "gender": "m", "first": 10, "spoke": 5}, {"id": 6, "name": "CONSULTANT", "names": ["CONSULTANT"], "gender": "?", "first": 10, "spoke": 0}, {"id": 7, "name": "OSWALD PELL", "names": ["OSWALD PELL", "OSWALD"], "gender": "m", "first": 10, "spoke": 5}, {"id": 8, "name": "BULLHORN", "names": ["BULLHORN"], "gender": "?", "first": 37, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. PARKING STRUCTURE, LEVEL P4 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Concrete ramps spiral up into the dark.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sodium lights hum.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain falls through the open side of the structure and pools in the drains.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A black sedan idles at the far end, headlights off.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "KAZIMIERZ \"KAZ\" DRAGOMIR (40s, black overcoat, a briefcase handcuffed to his wrist) stands beside it, checking his watch.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "A step behind him, his driver, LEOPOLDINA \"LEO\" MARCHETTI (30s, earpiece, one hand inside her jacket).", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "A second car rolls up the ramp.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Stops.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Its doors open.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "AGENT CALLUM BRIGHTWATER (30s, FBI windbreaker under a coat) climbs out, followed by AGENT PRIYA RAMAKRISHNAN (30s, a notebook she isn't writing in) and a third man, a CONSULTANT named OSWALD PELL (60s, cardigan, cane).", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 11, "kind": "dialogue", "text": "You're early, Agent Brightwater.", "name": "KAZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 12, "kind": "dialogue", "text": "You're late, Mr. Dragomir.", "name": "CALLUM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 13, "kind": "dialogue", "text": "Kaz, we should go.", "name": "LEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 14, "kind": "dialogue", "text": "We're fine, Leo.", "name": "KAZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 15, "kind": "dialogue", "text": "Cal, where's the exchange?", "name": "PRIYA", "speaker": 5, "ext": [], "paren": ["low, to Callum"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 16, "kind": "dialogue", "text": "Be patient, Pri.", "name": "CALLUM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 17, "kind": "dialogue", "text": "There is no exchange.", "name": "OSWALD", "speaker": 7, "ext": [], "paren": ["under his breath"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 18, "kind": "action", "text": "Priya turns to stare at him.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 19, "kind": "action", "text": "Callum's hand closes slowly on the grip of his sidearm.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 20, "kind": "dialogue", "text": "Say that again.", "name": "PRIYA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 21, "kind": "dialogue", "text": "The briefcase is empty, my dear. It's always been empty.", "name": "OSWALD", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 22, "kind": "dialogue", "text": "That's a lie --", "name": "KAZ", "speaker": 0, "ext": [], "paren": ["over him"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 23, "kind": "dialogue", "text": "Kaz, he's --", "name": "LEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 24, "kind": "dialogue", "text": "Everybody, hands where I can see them!", "name": "CALLUM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 25, "kind": "dialogue", "text": "Leo, don't!", "name": "KAZ", "speaker": 0, "ext": [], "paren": ["shouting"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 26, "kind": "dialogue", "text": "Drop it, Brightwater!", "name": "LEO", "speaker": 2, "ext": [], "paren": ["shouting"], "dual": true, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 27, "kind": "dialogue", "text": "Priya, back off!", "name": "CALLUM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 28, "kind": "dialogue", "text": "Cal, I'm not --", "name": "PRIYA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 29, "kind": "action", "text": "A dozen heartbeats.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "action", "text": "Rain drums.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "action", "text": "Then Oswald taps his cane twice on the concrete, almost courteously.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "dialogue", "text": "Thirty seconds.", "name": "OSWALD", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "action", "text": "Above them, engines start.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "action", "text": "Headlights flare on every level, blinding, a cathedral of white.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "action", "text": "Dozens of silhouettes line the railings.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "action", "text": "A bullhorn crackles.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "dialogue", "text": "Federal agents. Drop your weapons.", "name": "BULLHORN", "speaker": 8, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 38, "kind": "dialogue", "text": "Cal, those aren't ours.", "name": "PRIYA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 39, "kind": "dialogue", "text": "Whose are they?", "name": "CALLUM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 40, "kind": "dialogue", "text": "Mine.", "name": "OSWALD", "speaker": 7, "ext": [], "paren": ["smiling"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 41, "kind": "action", "text": "Kaz laughs.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 42, "kind": "action", "text": "It is a short, cracked laugh.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 43, "kind": "action", "text": "He unlocks the handcuff, opens the briefcase, and tilts it toward them.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 44, "kind": "action", "text": "Inside: a single brass key.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 45, "kind": "dialogue", "text": "Gentlemen, ladies. Last chance to leave.", "name": "KAZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 46, "kind": "action", "text": "Nobody moves.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 47, "kind": "action", "text": "Leo steps toward Priya.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 48, "kind": "action", "text": "Callum keeps his gun on Oswald.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 49, "kind": "dialogue", "text": "Who do you work for?", "name": "PRIYA", "speaker": 5, "ext": [], "paren": ["to Leo"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 50, "kind": "dialogue", "text": "Whoever pays.", "name": "LEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 51, "kind": "dialogue", "text": "And you?", "name": "CALLUM", "speaker": 4, "ext": [], "paren": ["to Oswald"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 52, "kind": "dialogue", "text": "Whoever pays more.", "name": "OSWALD", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 53, "kind": "action", "text": "The headlights go dark all at once.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 54, "kind": "action", "text": "Gunfire.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}]}