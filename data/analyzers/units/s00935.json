{"scene_id": "s00935", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00935.fountain", "heading": "INT. MENDOZA-FAIRCLOUGH FAMILY KITCHEN - DUSK", "cast": [{"id": 0, "name": "GRANDMOTHER EULALIA MENDOZA", "names": ["GRANDMOTHER EULALIA MENDOZA", "EULALIA"], "gender": "?", "first": 4, "spoke": 1}, {"id": 1, "name": "HECTOR FAIRCLOUGH-MENDOZA", "names": ["HECTOR FAIRCLOUGH-MENDOZA", "HECTOR"], "gender": "?", "first": 6, "spoke": 3}, {"id": 2, "name": "NOEMI", "names": ["NOEMI"], "gender": "f", "first": 7, "spoke": 5}, {"id": 3, "name": "TEODORO", "names": ["TEODORO"], "gender": "?", "first": 8, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. MENDOZA-FAIRCLOUGH FAMILY KITCHEN - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "A narrow galley kitchen in a house built for a bigger family.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Yellowed curtains, a fridge covered in magnets from places no one has visited in years.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "On the counter, a cake with one candle already melted.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "GRANDMOTHER EULALIA MENDOZA (70s, cardigan buttoned wrong) arranges forks into a fan.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She stops, straightens them, arranges them again.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Her son, HECTOR FAIRCLOUGH-MENDOZA (40s, shirt sleeves rolled, a ring of sweat at the collar) stands at the stove, stirring a pot that has long since stopped needing it.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "His daughter, NOEMI (16, headphones round her neck, thumbnail polish chipped to nubs), sits at the table peeling a label off a jar in one long unbroken strip.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "At the end of the table, TEODORO (9, in a school tie knotted too tight) draws a small, careful circle on a napkin, and then another, and then another.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Dinner in five.", "name": "HECTOR", "speaker": 1, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "No one answers.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Eulalia moves a fork a quarter-inch.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Is Dad coming?", "name": "NOEMI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "He said he'd try.", "name": "HECTOR", "speaker": 1, "ext": [], "paren": ["to the pot"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "He always says that.", "name": "EULALIA", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Teodoro finishes a circle.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "He draws a line connecting it to the others.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Teo, what is that?", "name": "NOEMI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "It's the table.", "name": "TEODORO", "speaker": 3, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "We're five. There's four chairs.", "name": "NOEMI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "I know.", "name": "TEODORO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "The label tears.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Noemi drops it and leaves the jar on the table.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Hector turns off the burner and the pot ticks as it cools.", "para": 5, "sent": 2, "present": [0, 1, 3]}, {"u": 24, "kind": "action", "text": "Eulalia sets down the last fork, and all of them, one by one, look at the empty chair.", "para": 5, "sent": 3, "present": [0, 1, 3]}, {"u": 25, "kind": "dialogue", "text": "Can we please just eat.", "name": "NOEMI", "speaker": 2, "ext": ["CONT'D"], "paren": ["to everyone, tight"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Noemi --", "name": "HECTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "I said, can we please just eat!", "name": "NOEMI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "She shoves her chair back.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "It scrapes.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Eulalia flinches.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Teodoro does not.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}]}