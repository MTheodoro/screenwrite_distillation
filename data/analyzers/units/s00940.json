{"scene_id": "s00940", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00940.fountain", "heading": "EXT. RAILWAY CUTTING, FLOODED TRENCH LINE - PRE-DAWN", "cast": [{"id": 0, "name": "SERGEANT BORIS KALININ-ADEYEMI", "names": ["SERGEANT BORIS KALININ-ADEYEMI", "BORIS"], "gender": "m", "first": 5, "spoke": 9}, {"id": 1, "name": "PRIVATE LUCIEN MAROIS", "names": ["PRIVATE LUCIEN MAROIS", "LUCIEN"], "gender": "m", "first": 9, "spoke": 4}, {"id": 2, "name": "CORPORAL TAMSIN BRENNAN-OKORO", "names": ["CORPORAL TAMSIN BRENNAN-OKORO", "TAMSIN"], "gender": "f", "first": 12, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. RAILWAY CUTTING, FLOODED TRENCH LINE - PRE-DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Mud.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Barbed wire.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A rusted boxcar tipped on its side, half sunk.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Thin mist over the standing water.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SERGEANT BORIS KALININ-ADEYEMI crouches in the doorway of the boxcar.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Tall.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Gray at the temples.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "A cigarette he does not light.", "para": 1, "sent": 3, "present": [0]}, {"u": 9, "kind": "action", "text": "Behind him, PRIVATE LUCIEN MAROIS (19) sits against the wall with his knees to his chest.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "His rifle lies across his lap.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He stares at the floor.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Further down the car, CORPORAL TAMSIN BRENNAN-OKORO crouches over a field kit.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She counts bullets into her palm.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Counts again.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Water drips.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Marois.", "name": "BORIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Lucien does not look up.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Marois.", "name": "BORIS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Lucien lifts his head.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "His eyes are very bright.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Sergeant.", "name": "LUCIEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Eat something.", "name": "BORIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Not hungry.", "name": "LUCIEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Boris tosses a tin of biscuits across the car.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Lucien catches it against his chest without opening it.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "He'll eat when he's ready.", "name": "TAMSIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "He'll eat now.", "name": "BORIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Tamsin glances at the boy, then at Boris.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "She says nothing.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Lucien cracks the tin, takes one biscuit, and holds it without biting.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Far off, a shell lands.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "The boxcar shivers.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "A fine rain of rust falls from the roof.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "No one flinches.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Tamsin finishes counting.", "para": 9, "sent": 4, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Boris lights the cigarette at last, takes one drag, then pinches it out and returns it to his pocket.", "para": 9, "sent": 5, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Eleven rounds each.", "name": "TAMSIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "That's enough.", "name": "BORIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "It's not enough, Boris.", "name": "TAMSIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "It is for what we've got.", "name": "BORIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "A second shell.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Closer.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Lucien bites the biscuit.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Chews.", "para": 10, "sent": 3, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Swallows.", "para": 10, "sent": 4, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Sergeant?", "name": "LUCIEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Yes.", "name": "BORIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Is my brother's company still on the ridge?", "name": "LUCIEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Boris looks at Tamsin.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Tamsin looks at her hands.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "It is the only answer, and everyone in the boxcar understands it.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Eat the other half.", "name": "BORIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Lucien does.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "He keeps his eyes on his sergeant the whole time.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "A third shell, much farther away.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "The mist begins to thin.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Pale light slides along the water.", "para": 13, "sent": 2, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "When it's quiet, we move.", "name": "BORIS", "speaker": 0, "ext": ["CONT'D"], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "When it's quiet, we move.", "name": "TAMSIN", "speaker": 2, "ext": [], "paren": ["quietly"], "dual": true, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "Boris almost smiles.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "He gathers his rifle.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "Tamsin shoulders her kit.", "para": 14, "sent": 2, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "Lucien stands, unsteady, and the three of them wait in the doorway of the tipped boxcar for the guns to stop.", "para": 14, "sent": 3, "present": [0, 1, 2]}]}