{"scene_id": "s00942", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00942.fountain", "heading": "INT. 24-HOUR LAUNDROMAT, SUNSET STRIP PLAZA - 3 A.M.", "cast": [{"id": 0, "name": "GWEN", "names": ["GWEN"], "gender": "?", "first": 5, "spoke": 21}, {"id": 1, "name": "ABERNATHY-TSUJI", "names": ["ABERNATHY-TSUJI"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "KWABENA", "names": ["KWABENA"], "gender": "?", "first": 14, "spoke": 20}], "units": [{"u": 0, "kind": "heading", "text": "INT. 24-HOUR LAUNDROMAT, SUNSET STRIP PLAZA - 3 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent hum.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of dryers tumbling, each a small bright porthole.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Plastic chairs bolted to the floor.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A vending machine glows red beside a bulletin board layered with years of flyers.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "GWENDOLYN \"GWEN\" ABERNATHY-TSUJI (50s, orthopedic shoes, a nurse's lanyard still around her neck) sits alone in the middle of the row, folding towels.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "She has folded the same towel three times.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Her cell phone lies face-up on the seat beside her, silent.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She stacks the towel on a pile.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Reaches for another.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "The phone buzzes.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She does not look at it for four full buzzes.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Then she picks it up.", "para": 2, "sent": 4, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Hello?", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Mom. It's me.", "name": "KWABENA", "speaker": 2, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "I know who it is, baby.", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Did I wake you?", "name": "KWABENA", "speaker": 2, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I don't sleep, Kobe. You know that.", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Still on nights?", "name": "KWABENA", "speaker": 2, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Still on nights.", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "A dryer buzzes.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "She stands, opens it, pulls out a handful of warm laundry, and holds it to her face, just for a moment.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Then she carries it to the folding table.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "How's the knee?", "name": "KWABENA", "speaker": 2, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Fine.", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Mom.", "name": "KWABENA", "speaker": 2, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "It's a knee, Kobe. It's seen worse.", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "She snaps a pillowcase flat.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Folds it in thirds.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "I'm not calling about the knee.", "name": "KWABENA", "speaker": 2, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "I know.", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "You do?", "name": "KWABENA", "speaker": 2, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "You called at three in the morning. You're a good boy. You don't do that for nothing.", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Silence on the line.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "She waits.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Outside, a bus idles at the stop, its brake lights painting the window red.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Mom. I got the letter.", "name": "KWABENA", "speaker": 2, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Her hands stop.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Which letter?", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "The one from Dad's lawyer.", "name": "KWABENA", "speaker": 2, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Gwen sets down the pillowcase.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "She walks to the window and stands with her back to the room, one hand pressed flat to the cold glass.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "What did it say?", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "That he left something. For both of us.", "name": "KWABENA", "speaker": 2, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "He left us nothing.", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Mom, I'm looking at a deed.", "name": "KWABENA", "speaker": 2, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "I don't want it.", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "It's the house in Accra. The one he said he sold.", "name": "KWABENA", "speaker": 2, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "He sold it. I watched him sign.", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Mom --", "name": "KWABENA", "speaker": 2, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "He sold it, Kwabena!", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Her voice cracks and fills the whole room.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "The dryers tumble on, indifferent.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "A long breath over the line.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "I'm sorry. I didn't mean to shout.", "name": "GWEN", "speaker": 0, "ext": ["CONT'D"], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "It's okay.", "name": "KWABENA", "speaker": 2, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "It isn't. I just -- I carried that man for thirty years.", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "I know.", "name": "KWABENA", "speaker": 2, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "I'm not carrying him anymore.", "name": "GWEN", "speaker": 0, "ext": [], "paren": ["together"], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "You don't have to carry him anymore.", "name": "KWABENA", "speaker": 2, "ext": ["V.O."], "paren": ["together, over phone"], "dual": true, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "They both go still.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "The line holds open between them, hissing softly.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "Say that again.", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "You don't have to, Mom. I'll go. I'll sort it out. You can stay right where you are.", "name": "KWABENA", "speaker": 2, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "She sinks into a plastic chair.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "The bus pulls away from the stop, and its light slides off her face.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "When are you flying?", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "dialogue", "text": "Thursday.", "name": "KWABENA", "speaker": 2, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2]}, {"u": 68, "kind": "dialogue", "text": "I'll make the jollof.", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 69, "kind": "dialogue", "text": "Mom, I'm not staying for dinner.", "name": "KWABENA", "speaker": 2, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2]}, {"u": 70, "kind": "dialogue", "text": "You are staying for dinner.", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 71, "kind": "dialogue", "text": "Yes, Mom.", "name": "KWABENA", "speaker": 2, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2]}, {"u": 72, "kind": "action", "text": "She laughs, a real laugh, wet at the edges.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 73, "kind": "action", "text": "She presses the heel of her hand to her eye.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 74, "kind": "action", "text": "Behind her, the last dryer buzzes and falls silent.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 75, "kind": "action", "text": "In the sudden quiet, she is very small, and very still, and finally not alone.", "para": 11, "sent": 3, "present": [0, 1, 2]}]}