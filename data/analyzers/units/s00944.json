{"scene_id": "s00944", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00944.fountain", "heading": "INT. HARBORVIEW ROWING CLUB, BOATHOUSE - PRE-DAWN", "cast": [{"id": 0, "name": "COACH HAROLDINE BEAUMONT-ADEKUNLE", "names": ["COACH HAROLDINE BEAUMONT-ADEKUNLE", "HAROLDINE"], "gender": "f", "first": 4, "spoke": 2}, {"id": 1, "name": "DARIUS KOWALA-NAKAMURA", "names": ["DARIUS KOWALA-NAKAMURA"], "gender": "m", "first": 6, "spoke": 0}, {"id": 2, "name": "LORCAN FITZGIBBON-ADE", "names": ["LORCAN FITZGIBBON-ADE"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "ELOWEN MARCH-SANTOS", "names": ["ELOWEN MARCH-SANTOS"], "gender": "m", "first": 8, "spoke": 0}, {"id": 4, "name": "PADDY TREMBLAY-ONYEKA", "names": ["PADDY TREMBLAY-ONYEKA"], "gender": "m", "first": 9, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. HARBORVIEW ROWING CLUB, BOATHOUSE - PRE-DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Racks of eight-man shells hang from the rafters like pale fish.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The river outside is black and still.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Condensation beads on the windows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "COACH HAROLDINE BEAUMONT-ADEKUNLE (60s, wool cap, a stopwatch on a faded lanyard) stands at the water door with her back to the room.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Behind her, four rowers sit on the bench, lacing shoes.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "DARIUS KOWALA-NAKAMURA (20s, shoulders like doors) has ripped his tape twice.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "LORCAN FITZGIBBON-ADE (20s, hands bandaged) peels the gauze off one palm, studies the raw skin, and presses the gauze back on.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "ELOWEN MARCH-SANTOS (20s, her ponytail tight enough to hurt) stares at the same spot on the floor.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "PADDY TREMBLAY-ONYEKA (19, the youngest, a borrowed hoodie) keeps rubbing his thumbs against his knees.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Nobody speaks.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "The only sound is the creak of the racks and the slap of water against the dock.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Haroldine shifts her weight.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "She does not turn.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Boats in.", "name": "HAROLDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "They stand.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "All together, with the ease of long practice, they lift the shell from its rack and walk it toward the water.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Darius takes the bow.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Lorcan, the stern.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Elowen and Paddy each take a side.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Haroldine holds the door.", "para": 5, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "The shell touches the river.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Paddy steps in first.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "His foot slips.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Elowen's hand is on his elbow before he knows he's falling.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "He says nothing.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "She says nothing.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "She lets go.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Go.", "name": "HAROLDINE", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the shell, quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Oars dip.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "The boat moves out into the fog, and the four of them breathe as one, a single lung.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "On the dock, the Coach clicks her stopwatch, looks at it, and clicks it again.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}]}