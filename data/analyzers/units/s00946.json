{"scene_id": "s00946", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00946.fountain", "heading": "INT. FUNICULAR CAR, MID-ASCENT - NIGHT", "cast": [{"id": 0, "name": "ODALYS FERREIRA-MBEKI", "names": ["ODALYS FERREIRA-MBEKI", "ODALYS"], "gender": "?", "first": 6, "spoke": 6}, {"id": 1, "name": "MARCELLUS HOLLINGWORTH-NAKAMURA", "names": ["MARCELLUS HOLLINGWORTH-NAKAMURA", "MARCELLUS"], "gender": "?", "first": 8, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. FUNICULAR CAR, MID-ASCENT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A tiny wooden cabin, varnished the color of old violins, climbing a steep rail through black pine forest.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Brass lamps sway on their hooks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain hammers the glass.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Below, the lights of a mountain town shrink to a handful of sparks.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A woman sits upright on the forward bench, her coat buttoned to the throat.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "ODALYS FERREIRA-MBEKI is forty, with a face carved from patience and a leather satchel clutched in both hands.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She watches the man across from her, and she never blinks.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "He is MARCELLUS HOLLINGWORTH-NAKAMURA, sixty, silver at the temples, gloves of fine kid.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "A cane lies across his lap.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He smiles with his mouth only.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "You're late.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "The weather.", "name": "MARCELLUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "It's always the weather with you.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He taps the cane once against the floor.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She flinches, barely.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He notices.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "You have it?", "name": "MARCELLUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She does not answer.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She lifts the satchel an inch, lets it fall back.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Show me.", "name": "MARCELLUS", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Not until the top.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "We are not going to the top.", "name": "MARCELLUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "The car shudders.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Something groans beneath the floor, steel on steel, and the lamps swing hard.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Odalys grips the bench.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "He doesn't move at all.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "What did you do?", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Nothing yet.", "name": "MARCELLUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "The cabin stops.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Dead in the middle of the slope.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Rain on the glass.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Wind in the cables.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "He leans forward, resting both hands on the cane.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Now. Show me.", "name": "MARCELLUS", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Her hand slides inside the satchel.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "It comes out holding a small brass revolver, aimed at his chest.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "He looks at it, and for the first time, his smile changes.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Ah. There she is.", "name": "MARCELLUS", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Cut the cable, Marcellus.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "That isn't how it works.", "name": "MARCELLUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Cut it.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "He lifts the cane.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Twists the silver handle.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "A thin blade slides out, gleaming.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "He turns it in the lamplight, almost fondly.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "It's a long way down, Odalys.", "name": "MARCELLUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "She cocks the hammer.", "para": 10, "sent": 0, "present": [0, 1]}]}