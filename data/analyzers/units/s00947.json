{"scene_id": "s00947", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00947.fountain", "heading": "INT. RADIOLOGY READING ROOM - NIGHT", "cast": [{"id": 0, "name": "ADEBAYO KOWALSKI-NNAMDI", "names": ["ADEBAYO KOWALSKI-NNAMDI", "ADEBAYO"], "gender": "?", "first": 4, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. RADIOLOGY READING ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dark.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Banks of monitors glow blue-white.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single chair, a headset, a cold coffee gone to skin.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. ADEBAYO KOWALSKI-NNAMDI (40s) sits hunched at the center workstation, scrolling through a stack of chest films.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He rubs his eyes.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "He scrolls.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "He stops.", "para": 1, "sent": 3, "present": [0]}, {"u": 8, "kind": "action", "text": "He leans in.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Zooms.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "Zooms again.", "para": 2, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "He taps a key.", "para": 3, "sent": 0, "present": [0]}, {"u": 12, "kind": "action", "text": "The dictation system plays back his earlier note through the speakers.", "para": 3, "sent": 1, "present": [0]}, {"u": 13, "kind": "dialogue", "text": "Chest, two views. Lungs clear. No acute findings.", "name": "ADEBAYO", "speaker": 0, "ext": ["V.O."], "paren": ["recorded"], "dual": false, "present": [0]}, {"u": 14, "kind": "action", "text": "He frowns.", "para": 4, "sent": 0, "present": [0]}, {"u": 15, "kind": "action", "text": "Pans the image.", "para": 4, "sent": 1, "present": [0]}, {"u": 16, "kind": "action", "text": "A small shadow, high in the left lung, edges crisp.", "para": 4, "sent": 2, "present": [0]}, {"u": 17, "kind": "action", "text": "He measures it.", "para": 4, "sent": 3, "present": [0]}, {"u": 18, "kind": "action", "text": "Measures it again.", "para": 4, "sent": 4, "present": [0]}, {"u": 19, "kind": "action", "text": "He leans back and exhales slowly.", "para": 4, "sent": 5, "present": [0]}, {"u": 20, "kind": "dialogue", "text": "Not clear.", "name": "ADEBAYO", "speaker": 0, "ext": [], "paren": ["to himself"], "dual": false, "present": [0]}, {"u": 21, "kind": "action", "text": "He deletes the recording.", "para": 5, "sent": 0, "present": [0]}, {"u": 22, "kind": "action", "text": "The speakers click.", "para": 5, "sent": 1, "present": [0]}, {"u": 23, "kind": "action", "text": "He picks up the mic and begins to speak, steady and low.", "para": 5, "sent": 2, "present": [0]}, {"u": 24, "kind": "dialogue", "text": "Chest, two views. Small nodule, left upper lobe, six millimeters. Recommend follow-up CT.", "name": "ADEBAYO", "speaker": 0, "ext": ["CONT'D"], "paren": ["dictating"], "dual": false, "present": [0]}, {"u": 25, "kind": "action", "text": "He sets the mic down and rolls his shoulders.", "para": 6, "sent": 0, "present": [0]}, {"u": 26, "kind": "action", "text": "On the screen, the shadow waits.", "para": 6, "sent": 1, "present": [0]}]}