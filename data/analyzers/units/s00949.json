{"scene_id": "s00949", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00949.fountain", "heading": "INT. DEEP-SEA HABITAT, COMMON ROOM - SHIFT CHANGE", "cast": [{"id": 0, "name": "COMMANDER ASTRID LINDQVIST-OKOYE", "names": ["COMMANDER ASTRID LINDQVIST-OKOYE", "ASTRID"], "gender": "?", "first": 6, "spoke": 5}, {"id": 1, "name": "TECHNICIAN BENEDICT ARCHAMBAULT-LI", "names": ["TECHNICIAN BENEDICT ARCHAMBAULT-LI", "BENEDICT"], "gender": "m", "first": 7, "spoke": 4}, {"id": 2, "name": "SOLEDAD VARGAS-EZEKIEL", "names": ["SOLEDAD VARGAS-EZEKIEL", "SOLEDAD"], "gender": "f", "first": 8, "spoke": 4}, {"id": 3, "name": "MONA", "names": ["MONA"], "gender": "?", "first": 9, "spoke": 3}, {"id": 4, "name": "ABARCA-NIELSEN", "names": ["ABARCA-NIELSEN"], "gender": "?", "first": 9, "spoke": 0}, {"id": 5, "name": "ENGINEER THADDEUS MWANGI-PELLETIER", "names": ["ENGINEER THADDEUS MWANGI-PELLETIER", "THADDEUS"], "gender": "?", "first": 10, "spoke": 3}, {"id": 6, "name": "SPECIALIST KAMALA DEVI-BRANDT", "names": ["SPECIALIST KAMALA DEVI-BRANDT", "KAMALA"], "gender": "?", "first": 11, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. DEEP-SEA HABITAT, COMMON ROOM - SHIFT CHANGE", "present": []}, {"u": 1, "kind": "action", "text": "A cramped steel cylinder with a single porthole of black water.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Bunks fold from the walls.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A coffee machine gurgles.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Condensation drips from the pipes in a slow, steady count.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Six crew members cluster around a fold-out table playing a card game no one is winning.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "COMMANDER ASTRID LINDQVIST-OKOYE (50s) deals.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "TECHNICIAN BENEDICT ARCHAMBAULT-LI (30s) fans his cards.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "DR. SOLEDAD VARGAS-EZEKIEL (40s) frowns at her hand.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "COOK RAMONA \"MONA\" ABARCA-NIELSEN (30s) pours coffee.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "ENGINEER THADDEUS MWANGI-PELLETIER (60s) hums off-key.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "And the youngest, SPECIALIST KAMALA DEVI-BRANDT (20s), stares at the porthole.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "Antes in.", "name": "ASTRID", "speaker": 0, "ext": [], "paren": ["to the table"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "I fold.", "name": "BENEDICT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "You haven't seen the cards.", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "I've seen your face.", "name": "BENEDICT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "Coffee's up, who wants some?", "name": "MONA", "speaker": 3, "ext": [], "paren": ["over them"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "Me.", "name": "THADDEUS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "Not me.", "name": "KAMALA", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "Mona, put two sugars in mine, would you, and Benedict --", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "Don't tell me what to do with my own hand --", "name": "BENEDICT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "Everyone, quiet.", "name": "ASTRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "action", "text": "They stop.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "The pipes drip.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "Kamala is still looking at the porthole.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "What is it?", "name": "ASTRID", "speaker": 0, "ext": ["CONT'D"], "paren": ["to Kamala"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "Nothing.", "name": "KAMALA", "speaker": 6, "ext": [], "paren": ["without turning"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "There's always something.", "name": "THADDEUS", "speaker": 5, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "Don't start, Thad.", "name": "MONA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "I'm just saying --", "name": "THADDEUS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "He's right, though. The pressure gauge ticked.", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": ["over him"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "It ticks all the time.", "name": "BENEDICT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "Not like that.", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "Like what?", "name": "MONA", "speaker": 3, "ext": [], "paren": ["setting down the pot"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "Like a heartbeat.", "name": "ASTRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "Everyone looks at her.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "She lays down her cards, face up.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "I knew I'd heard it before.", "name": "ASTRID", "speaker": 0, "ext": ["CONT'D"], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "A long, low note rolls through the hull.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "The coffee ripples in the cups.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "Nobody moves.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "Nobody speaks.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "Then Kamala turns from the porthole and smiles.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "dialogue", "text": "It's only the whales.", "name": "KAMALA", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}