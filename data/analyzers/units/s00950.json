{"scene_id": "s00950", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00950.fountain", "heading": "INT. NIGHT FERRY, OBSERVATION DECK - NIGHT", "cast": [{"id": 0, "name": "DETECTIVE RUSSELL TEMPLETON-OYELARAN", "names": ["DETECTIVE RUSSELL TEMPLETON-OYELARAN", "RUSSELL"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "TONI", "names": ["TONI"], "gender": "?", "first": 5, "spoke": 5}, {"id": 2, "name": "BERGSTROM-ABIODUN", "names": ["BERGSTROM-ABIODUN"], "gender": "?", "first": 5, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT FERRY, OBSERVATION DECK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Wind.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Salt spray.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Empty benches bolted to the deck.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DETECTIVE RUSSELL TEMPLETON-OYELARAN (50s) grips the rail.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside him, a small woman in a yellow slicker, ANTONIA \"TONI\" BERGSTROM-ABIODUN (30s), watches the wake.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "You said you'd tell me.", "name": "RUSSELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "I did.", "name": "TONI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Then tell me.", "name": "RUSSELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Not here.", "name": "TONI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Here.", "name": "RUSSELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "He's on this boat.", "name": "TONI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Who?", "name": "RUSSELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "The man in the grey cap.", "name": "TONI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I didn't see --", "name": "RUSSELL", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Don't turn around.", "name": "TONI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Russell turns.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "A gull cries.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "The deck is empty.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Toni is gone.", "para": 2, "sent": 3, "present": [0, 1, 2]}]}