{"scene_id": "s00951", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00951.fountain", "heading": "INT. THE VASQUEZ-LINDEN KITCHEN - SUNDAY NOON", "cast": [{"id": 0, "name": "ROSALIND VASQUEZ-LINDEN", "names": ["ROSALIND VASQUEZ-LINDEN", "ROSALIND"], "gender": "?", "first": 4, "spoke": 3}, {"id": 1, "name": "GREGORIUS LINDEN", "names": ["GREGORIUS LINDEN", "GREGORIUS"], "gender": "?", "first": 4, "spoke": 3}, {"id": 2, "name": "SELMA", "names": ["SELMA"], "gender": "?", "first": 6, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. THE VASQUEZ-LINDEN KITCHEN - SUNDAY NOON", "present": []}, {"u": 1, "kind": "action", "text": "A bright, crowded kitchen.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Pots on every burner.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A radio plays something with trumpets.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ROSALIND VASQUEZ-LINDEN (50s) chops onions with violent speed.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Her husband, GREGORIUS LINDEN (50s), hunts through a drawer for a corkscrew.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Their daughter, SELMA (20s), stands in the doorway with a suitcase.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "You're late.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": ["without turning"], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "The train --", "name": "SELMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Where is that blasted thing?", "name": "GREGORIUS", "speaker": 1, "ext": [], "paren": ["to the drawer"], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Gregorius, it's in your hand.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "So it is.", "name": "GREGORIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "I have news.", "name": "SELMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Dinner first.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": ["over her"], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Dinner first!", "name": "GREGORIUS", "speaker": 1, "ext": [], "paren": ["to everyone"], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "I'm moving to Lisbon.", "name": "SELMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "The knife stops.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Gregorius closes the drawer.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "The trumpet on the radio hits a long, high note, and no one moves.", "para": 2, "sent": 2, "present": [0, 1, 2]}]}