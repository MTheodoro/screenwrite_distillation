{"scene_id": "s00952", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00952.fountain", "heading": "INT. ASSEMBLY ROOM, BATH - 1790s - NIGHT", "cast": [{"id": 0, "name": "LADY CONSTANCE ASHWORTH-BELLAMY", "names": ["LADY CONSTANCE ASHWORTH-BELLAMY", "CONSTANCE"], "gender": "?", "first": 5, "spoke": 3}, {"id": 1, "name": "MISS GEORGIANA TREVELYAN-SOLOMON", "names": ["MISS GEORGIANA TREVELYAN-SOLOMON", "GEORGIANA"], "gender": "?", "first": 5, "spoke": 3}, {"id": 2, "name": "DUCHESS ELEANOR MARCHMONT-IDOWU", "names": ["DUCHESS ELEANOR MARCHMONT-IDOWU", "DUCHESS"], "gender": "f", "first": 6, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. ASSEMBLY ROOM, BATH - 1790s - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Candles.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A string quartet.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Powdered wigs.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Silk and sweat.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LADY CONSTANCE ASHWORTH-BELLAMY (30s) and MISS GEORGIANA TREVELYAN-SOLOMON (20s) stand at the edge of the dance floor, fans snapping.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "A third woman, DUCHESS ELEANOR MARCHMONT-IDOWU (60s), leans heavily on her cane between them.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "She's staring again.", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Who?", "name": "GEORGIANA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "The Duchess. She thinks we cannot see her.", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I can hear you perfectly well.", "name": "DUCHESS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Your Grace --", "name": "GEORGIANA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Do not \"Your Grace\" me. You were both whispering.", "name": "DUCHESS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "We were admiring your pearls.", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "You were admiring my debts.", "name": "DUCHESS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Never!", "name": "GEORGIANA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Then you are fools. Everyone else is.", "name": "DUCHESS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "The quartet begins a minuet.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "The Duchess lifts her cane and points it at the floor.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Dance, both of you. And smile.", "name": "DUCHESS", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}]}