{"scene_id": "s00953", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00953.fountain", "heading": "EXT. SCHOOL ROOF, STARGAZING NIGHT - NIGHT", "cast": [{"id": 0, "name": "TILDA", "names": ["TILDA"], "gender": "f", "first": 3, "spoke": 8}, {"id": 1, "name": "DELACROIX-OKAFOR", "names": ["DELACROIX-OKAFOR"], "gender": "?", "first": 3, "spoke": 0}, {"id": 2, "name": "ANJALI", "names": ["ANJALI"], "gender": "?", "first": 6, "spoke": 8}, {"id": 3, "name": "BANERJEE-LUND", "names": ["BANERJEE-LUND"], "gender": "?", "first": 6, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SCHOOL ROOF, STARGAZING NIGHT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A flat tar roof under a smear of stars.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A borrowed telescope on a tripod.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "MATILDA \"TILDA\" DELACROIX-OKAFOR (16) lies on her back, eating cereal from the box.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "She squints at the sky.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "The roof door bangs.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "ANJALI \"JALI\" BANERJEE-LUND (16, hoodie, backpack heavy with something clinking) bursts out, wheezing.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "You said eleven.", "name": "ANJALI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "It's eleven.", "name": "TILDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "It's eleven-fifteen.", "name": "ANJALI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Time is a construct.", "name": "TILDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "She squats at the telescope and squints through it.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Tilda crunches cereal.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Anjali stands up, triumphant.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "I see Saturn.", "name": "ANJALI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "That's the streetlight.", "name": "TILDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "It's Saturn.", "name": "ANJALI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "It has no rings.", "name": "TILDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "It's shy.", "name": "ANJALI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "She laughs.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Tilda laughs back.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Then the laugh dies.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Anjali has gone very quiet.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "She lifts something from her backpack: a crumpled acceptance letter, the paper soft from handling.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "They said yes.", "name": "ANJALI", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Who?", "name": "TILDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Boston.", "name": "ANJALI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Tilda's cereal box slides out of her hand.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Cereal spills across the tar.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "She does not pick it up.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "That's far.", "name": "TILDA", "speaker": 0, "ext": [], "paren": ["flat"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "It's a train.", "name": "ANJALI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "It's a long train.", "name": "TILDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "She stands, brushes her knees, and walks to the telescope.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "She looks through it for a long time.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Then, very quietly:", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "It really is Saturn.", "name": "TILDA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}