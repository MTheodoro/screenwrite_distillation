{"scene_id": "s00954", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00954.fountain", "heading": "EXT. SALOON ROOFTOP, DEAD MAN'S CROSSING - SUNSET", "cast": [{"id": 0, "name": "SHERIFF OBADIAH TRELAWNEY-KANE", "names": ["SHERIFF OBADIAH TRELAWNEY-KANE", "OBADIAH"], "gender": "m", "first": 5, "spoke": 6}, {"id": 1, "name": "JED", "names": ["JED"], "gender": "?", "first": 6, "spoke": 6}, {"id": 2, "name": "RUSSO-ABIOLA", "names": ["RUSSO-ABIOLA"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "MAGDALENA SOLIS-FAIRWEATHER", "names": ["MAGDALENA SOLIS-FAIRWEATHER", "MAGDALENA"], "gender": "?", "first": 7, "spoke": 4}, {"id": 4, "name": "FINN", "names": ["FINN"], "gender": "?", "first": 8, "spoke": 5}, {"id": 5, "name": "O'HALLORAN-DIOP", "names": ["O'HALLORAN-DIOP"], "gender": "?", "first": 8, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SALOON ROOFTOP, DEAD MAN'S CROSSING - SUNSET", "present": []}, {"u": 1, "kind": "action", "text": "A flat saloon roof with a rickety rain barrel at one corner.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A church bell hangs from a crooked post nearby.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The street below is still.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Warm light on dust.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SHERIFF OBADIAH TRELAWNEY-KANE (50s, white mustache, a star pinned to a faded vest) sits on the barrel playing a harmonica.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across from him, DEPUTY JEDEDIAH \"JED\" RUSSO-ABIOLA (20s, hat tilted) eats beans from a tin.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "A woman in a gingham dress, MAGDALENA SOLIS-FAIRWEATHER (30s, a basket on her arm), hangs laundry on a line between two chimneys.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Near the edge, FINNEGAN \"FINN\" O'HALLORAN-DIOP (40s, drover's hat pulled low) leans against the bell post, whittling.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "Quiet day.", "name": "OBADIAH", "speaker": 0, "ext": [], "paren": ["to Jed"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Too quiet.", "name": "JED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Anyone want pie?", "name": "MAGDALENA", "speaker": 3, "ext": [], "paren": ["to all of them"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Pie, she says.", "name": "FINN", "speaker": 4, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "I'll take pie, Maggie.", "name": "OBADIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "I'll take two.", "name": "JED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Then you can come get it.", "name": "MAGDALENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Come get it, Jed.", "name": "OBADIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Why me?", "name": "JED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Because you're the youngest, son.", "name": "FINN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "I'm not --", "name": "JED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Quiet.", "name": "OBADIAH", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Hear that?", "name": "FINN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "All four go still.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Far off, hoofbeats.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "A hundred horses.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Then a thousand.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "The church bell hums on its post.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Obadiah?", "name": "MAGDALENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Everyone down.", "name": "OBADIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "But sir --", "name": "JED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Down!", "name": "FINN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "They drop behind the parapet.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "From the end of the street, a dark mass rolls in: a cattle drive, massive and wild, tearing down Main Street toward them.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "It's only cattle.", "name": "JED", "speaker": 1, "ext": [], "paren": ["laughing, relieved"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Look at the riders.", "name": "OBADIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Behind the stampede, a line of masked men with torches lopes into town.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Lord help us.", "name": "MAGDALENA", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Not today.", "name": "FINN", "speaker": 4, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Obadiah rises, tucks the harmonica into his vest, and draws his revolver.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}