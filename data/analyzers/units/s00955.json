{"scene_id": "s00955", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00955.fountain", "heading": "INT. ROADSIDE DINER, ROUTE 9 - NIGHT", "cast": [{"id": 0, "name": "LORETTA PENDERGAST-NWACHUKWU", "names": ["LORETTA PENDERGAST-NWACHUKWU", "LORETTA"], "gender": "f", "first": 5, "spoke": 8}, {"id": 1, "name": "ARTEMUS WILKES-DUBOIS", "names": ["ARTEMUS WILKES-DUBOIS", "ARTEMUS"], "gender": "m", "first": 6, "spoke": 5}, {"id": 2, "name": "CASPIAN LEFEVRE-OYELARAN", "names": ["CASPIAN LEFEVRE-OYELARAN", "CASPIAN"], "gender": "?", "first": 7, "spoke": 8}, {"id": 3, "name": "JO", "names": ["JO"], "gender": "?", "first": 21, "spoke": 11}, {"id": 4, "name": "MAKINDE-HARTWELL", "names": ["MAKINDE-HARTWELL"], "gender": "?", "first": 21, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROADSIDE DINER, ROUTE 9 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A chrome-edged diner with a flickering OPEN sign.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rain on the windows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Red vinyl booths.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A jukebox that has not played since 1994.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LORETTA PENDERGAST-NWACHUKWU (50s, apron, a pencil tucked into her gray bun) wipes the counter.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "At a booth by the window sits ARTEMUS WILKES-DUBOIS (60s, trucker's cap, a thermos) with a crossword.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "In the corner booth, a young man hunches over a laptop: CASPIAN LEFEVRE-OYELARAN (20s, hoodie, headphones around his neck).", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Last call for pie, folks.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Seven letters. \"Unwelcome guest.\"", "name": "ARTEMUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Intruder.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Eight.", "name": "ARTEMUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Trespasser.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "That fits. Thanks, Loretta.", "name": "ARTEMUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "She tops off his coffee.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Caspian, in the corner, types faster.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "His knee bounces.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Boy's been here since noon.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": ["low, to Artemus"], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Not my business.", "name": "ARTEMUS", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "The bell above the door jingles.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "A woman enters, soaked, a duffel over one shoulder.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "JOSEPHINE \"JO\" MAKINDE-HARTWELL (30s, buzz cut, a tattoo of a swallow on her neck) stops just inside the door, scanning every face.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Sit anywhere, hon.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Jo does not sit.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "She looks at Caspian.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Cass.", "name": "JO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Caspian freezes.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "He doesn't turn around.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Jo.", "name": "CASPIAN", "speaker": 2, "ext": [], "paren": ["to the screen"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "You didn't call.", "name": "JO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "I was going to.", "name": "CASPIAN", "speaker": 2, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "That's not a customer.", "name": "ARTEMUS", "speaker": 1, "ext": [], "paren": ["to Loretta, whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "No kidding.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": ["whispering back"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Jo crosses the room and stands at Caspian's booth, dripping on the linoleum.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "I drove four hundred miles.", "name": "JO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "I know.", "name": "CASPIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "You left a note on the fridge.", "name": "JO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "I know.", "name": "CASPIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "It said \"back soon.\"", "name": "JO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "It's been eight months.", "name": "CASPIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Yeah, Cass. It has.", "name": "JO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Loretta clears her throat, loud enough that everyone looks.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Pie, anyone? On the house?", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Sorry for the noise.", "name": "JO", "speaker": 3, "ext": [], "paren": ["turning, to the room"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Honey, this is the most interesting night I've had all year.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Artemus chuckles into his thermos.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Jo slides into the booth across from Caspian.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "She takes a fork from the napkin dispenser and eats a bite of his untouched pie.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Good pie.", "name": "JO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "You hate pie.", "name": "CASPIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "I hate being lied to.", "name": "JO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Caspian shuts the laptop.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "Then I'll tell you the truth.", "name": "CASPIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "It better be long.", "name": "JO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "It's very long.", "name": "CASPIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Loretta fills two more cups.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Artemus gives up on the crossword.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "The rain keeps coming, and the OPEN sign keeps blinking, and in the corner booth the two of them lean toward each other across the table.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "Start from the beginning.", "name": "JO", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}