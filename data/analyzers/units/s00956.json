{"scene_id": "s00956", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00956.fountain", "heading": "INT. FIELD TENT, FORWARD AID STATION - NIGHT", "cast": [{"id": 0, "name": "MEDIC VICTORINE OKONJO-HALVORSEN", "names": ["MEDIC VICTORINE OKONJO-HALVORSEN", "VICTORINE"], "gender": "f", "first": 5, "spoke": 3}, {"id": 1, "name": "BRANDVOLD", "names": ["BRANDVOLD"], "gender": "?", "first": 9, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. FIELD TENT, FORWARD AID STATION - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Canvas walls snap in the wind.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single hurricane lamp swings on a hook.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Two empty cots.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A field radio crackles beside a stack of ration tins.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MEDIC VICTORINE OKONJO-HALVORSEN (30s) sits alone on the nearer cot with her sleeves rolled above the elbows.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her hands are steady.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She winds a roll of gauze and does not look at the radio.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "It coughs.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "dialogue", "text": "Aid station four, this is Control. Report.", "name": "BRANDVOLD", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She stares at it.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She lets it ask twice.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Victorine. Pick up.", "name": "BRANDVOLD", "speaker": 1, "ext": ["V.O.", "CONT'D"], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She lifts the handset.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Control, aid station four. No wounded.", "name": "VICTORINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "None?", "name": "BRANDVOLD", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "None left.", "name": "VICTORINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "A pause on the line.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "The wind pushes the canvas in and out like breathing.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Evacuation at oh-four-hundred. Pack what you can carry.", "name": "BRANDVOLD", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She sets down the gauze.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She does not move to pack.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Sergeant. Was it Anselmo?", "name": "VICTORINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Yes.", "name": "BRANDVOLD", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She nods, to no one.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "She folds the blanket from the second cot into a tight square and holds it in her lap.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Control, out.", "name": "BRANDVOLD", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "The radio goes to static.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "She switches it off and sits in the lamplight, listening to the wind.", "para": 8, "sent": 1, "present": [0, 1]}]}