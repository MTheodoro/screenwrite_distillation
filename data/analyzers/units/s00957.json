{"scene_id": "s00957", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00957.fountain", "heading": "EXT. MESA OVERLOOK, HIGH DESERT - DAWN", "cast": [{"id": 0, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "CAPTAIN LEONIDAS HARGROVE-ABASI", "names": ["CAPTAIN LEONIDAS HARGROVE-ABASI", "LEONIDAS"], "gender": "?", "first": 5, "spoke": 2}, {"id": 2, "name": "SALLY QUILLFEATHER-DIAZ", "names": ["SALLY QUILLFEATHER-DIAZ", "SALLY"], "gender": "m", "first": 5, "spoke": 4}, {"id": 3, "name": "OWEN TIBBS-OKORO", "names": ["OWEN TIBBS-OKORO", "OWEN"], "gender": "m", "first": 5, "spoke": 1}, {"id": 4, "name": "EPHRAIM", "names": ["EPHRAIM"], "gender": "?", "first": 15, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. MESA OVERLOOK, HIGH DESERT - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Red rock.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A sky going gold.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Four riders reining in on the edge of a drop that falls a thousand feet to the canyon floor.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A man in a black duster, a STRANGER, holds his horse apart, a rifle across the saddle.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "The three behind him wait: CAPTAIN LEONIDAS HARGROVE-ABASI (50s, cavalry hat), a gunslinger called SALLY QUILLFEATHER-DIAZ (30s, two revolvers, one scarred cheek), and a boy bugler, OWEN TIBBS-OKORO (15).", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "dialogue", "text": "Your name, friend.", "name": "LEONIDAS", "speaker": 1, "ext": [], "paren": ["to the Stranger"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Don't have one.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Everyone has one.", "name": "SALLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Maybe he's a ghost!", "name": "OWEN", "speaker": 3, "ext": [], "paren": ["excited"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Maybe.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": ["dryly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "He lowers the rifle.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "He looks at Sally for a long moment, and something passes behind his eyes.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Sally Quillfeather. Last time I saw you, you were nine.", "name": "STRANGER", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Who the hell --", "name": "SALLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Ephraim. Ephraim Quillfeather.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "My brother's dead.", "name": "SALLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "So they told you.", "name": "EPHRAIM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Stand down, Sally!", "name": "LEONIDAS", "speaker": 1, "ext": [], "paren": ["over him"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Don't you dare, Ephraim!", "name": "SALLY", "speaker": 2, "ext": [], "paren": ["over him"], "dual": true, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "The echo rolls off the mesa and into the canyon.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Owen lifts his bugle halfway to his mouth, then lowers it.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Nobody moves.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}]}