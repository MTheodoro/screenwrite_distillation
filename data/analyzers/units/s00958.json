{"scene_id": "s00958", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00958.fountain", "heading": "INT. CHINESE RESTAURANT BACK ROOM, MAH-JONG TABLE - NIGHT", "cast": [{"id": 0, "name": "MADAME LOTUS FONG-ADEWALE", "names": ["MADAME LOTUS FONG-ADEWALE", "MADAME LOTUS"], "gender": "?", "first": 4, "spoke": 2}, {"id": 1, "name": "VINNIE", "names": ["VINNIE"], "gender": "?", "first": 5, "spoke": 1}, {"id": 2, "name": "CARUSO-OBI", "names": ["CARUSO-OBI"], "gender": "?", "first": 5, "spoke": 0}, {"id": 3, "name": "DOLLY ZHAO-HARTLEY", "names": ["DOLLY ZHAO-HARTLEY"], "gender": "?", "first": 6, "spoke": 0}, {"id": 4, "name": "BIG MOSES TEMPLETON-AGYEMAN", "names": ["BIG MOSES TEMPLETON-AGYEMAN"], "gender": "?", "first": 7, "spoke": 0}, {"id": 5, "name": "QUINCY PARK-DELGADO", "names": ["QUINCY PARK-DELGADO"], "gender": "m", "first": 8, "spoke": 0}, {"id": 6, "name": "FATHER PASCAL EZEKWESILI-MORROW", "names": ["FATHER PASCAL EZEKWESILI-MORROW"], "gender": "m", "first": 9, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. CHINESE RESTAURANT BACK ROOM, MAH-JONG TABLE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cigarette haze.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A round table.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Six men and women, tiles clacking.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MADAME LOTUS FONG-ADEWALE (60s) sits at the head, perfectly still.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "To her left, VINNIE \"THE CLERK\" CARUSO-OBI (50s) shuffles.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "Beside him, DOLLY ZHAO-HARTLEY (40s) files her nails.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "Across, BIG MOSES TEMPLETON-AGYEMAN (50s), enormous, sweating.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "Next to him, QUINCY PARK-DELGADO (30s), tapping a tile.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "action", "text": "And the last, FATHER PASCAL EZEKWESILI-MORROW (60s, collar loose), stares at his hand.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "action", "text": "The tiles click.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "action", "text": "Click.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "action", "text": "Click.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "Someone here has been talking.", "name": "MADAME LOTUS", "speaker": 0, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "action", "text": "Nobody moves.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "action", "text": "Dolly's nail file stops.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "action", "text": "Moses lifts a tile, sets it down.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "action", "text": "Quincy's hand slides from the table to his lap.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "Madame --", "name": "VINNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "Vincent. Not you.", "name": "MADAME LOTUS", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "action", "text": "She picks up a tile, turns it over, and sets it face-up on the felt.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "action", "text": "It's blank.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "action", "text": "She waits.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "Father Pascal reaches into his coat.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "Every head swivels.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "action", "text": "He draws out a rosary and kisses it.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "action", "text": "The tiles click again.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}]}