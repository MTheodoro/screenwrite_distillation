{"scene_id": "s00963", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00963.fountain", "heading": "EXT. TREETOP MARKET, CANOPY OF THE WHISPERING WOOD - NOON", "cast": [{"id": 0, "name": "QUILLON FERNWHISTLE", "names": ["QUILLON FERNWHISTLE", "QUILLON"], "gender": "?", "first": 5, "spoke": 5}, {"id": 1, "name": "BRAMBLE OAKENSHIELD-DIOP", "names": ["BRAMBLE OAKENSHIELD-DIOP", "BRAMBLE"], "gender": "f", "first": 7, "spoke": 8}, {"id": 2, "name": "TILLY WREN-ABAYOMI", "names": ["TILLY WREN-ABAYOMI", "TILLY"], "gender": "f", "first": 8, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. TREETOP MARKET, CANOPY OF THE WHISPERING WOOD - NOON", "present": []}, {"u": 1, "kind": "action", "text": "Rope bridges.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Hanging stalls.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Lanterns strung between giant branches.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The market floats above the forest floor in green light.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "QUILLON FERNWHISTLE (any age, mossy beard, one ear pointed) hawks charms from a swaying stall.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "dialogue", "text": "Lucky bones! Lucky bones!", "name": "QUILLON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 7, "kind": "action", "text": "BRAMBLE OAKENSHIELD-DIOP (30s, scarred forearm, an enormous axe on her back) pushes through the crowd, scanning every stall.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "TILLY WREN-ABAYOMI (10, bare feet, a satchel too big for her) hops beside her, eating a honeyed fig.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Stay close, Tilly.", "name": "BRAMBLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I am close.", "name": "TILLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Closer.", "name": "BRAMBLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Warrior-lady! Lucky bones for the child?", "name": "QUILLON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "No.", "name": "BRAMBLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Protection charms, then. Very cheap.", "name": "QUILLON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "I said no.", "name": "BRAMBLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Tilly tugs Bramble's sleeve.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "She points.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "At the far end of the bridge, a tall figure in a hooded cloak has stopped dead among the shoppers, looking directly at them.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Bramble.", "name": "TILLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I see him.", "name": "BRAMBLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "You'll want those bones after all.", "name": "QUILLON", "speaker": 0, "ext": [], "paren": ["suddenly pale"], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "The figure raises his head.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Beneath the hood, no face: only a smooth plane of dark bark.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Run.", "name": "BRAMBLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "They bolt.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The crowd parts.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Behind them the hooded figure walks, calmly, as the ropes of the bridge begin to creak, then snap, one by one.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Bramble, he's chasing us!", "name": "TILLY", "speaker": 2, "ext": [], "paren": ["laughing, terrified"], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "I noticed!", "name": "BRAMBLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Quillon grabs a lantern, a bundle of bones, and scrambles up the nearest branch.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The bridge drops.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Bramble leaps, catches a rope, hauls Tilly up beside her, and swings them both onto a platform of woven vines.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "They land in a heap, gasping, safe.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Below, the hooded figure stands at the broken end of the bridge, looking up.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Then it turns and walks away through empty air, and the forest swallows it.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Do you think he'll come back?", "name": "TILLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Everything comes back.", "name": "BRAMBLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Lucky bones, anyone?", "name": "QUILLON", "speaker": 0, "ext": [], "paren": ["from above"], "dual": false, "present": [0, 1, 2]}]}