{"scene_id": "s00964", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00964.fountain", "heading": "INT. CAFE ON A BRIDGE, PARIS - RAINY AFTERNOON", "cast": [{"id": 0, "name": "CELINE ARCHAMBEAU-DIALLO", "names": ["CELINE ARCHAMBEAU-DIALLO", "CELINE"], "gender": "f", "first": 5, "spoke": 4}, {"id": 1, "name": "MONSIEUR FERNAND LAGRANGE-OBI", "names": ["MONSIEUR FERNAND LAGRANGE-OBI", "FERNAND"], "gender": "?", "first": 7, "spoke": 2}, {"id": 2, "name": "ISAAC BERGMAN-NWANKWO", "names": ["ISAAC BERGMAN-NWANKWO", "ISAAC"], "gender": "m", "first": 9, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. CAFE ON A BRIDGE, PARIS - RAINY AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "A narrow glass cafe built into the span of a stone bridge.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Steamed windows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The river slides past below, brown and slow.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Six small tables, a zinc counter, a cracked espresso machine.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CELINE ARCHAMBEAU-DIALLO (30s, red scarf, damp hair) sits at the corner table with a book she is not reading.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her coffee has gone cold.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "At the counter, the owner, MONSIEUR FERNAND LAGRANGE-OBI (60s, white apron, forearms like cables), wipes the same glass for the fifth time.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "The bell above the door chimes.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "In steps ISAAC BERGMAN-NWANKWO (30s, battered trench coat, a violin case in one hand, rain running off the brim of his hat).", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Celine looks up.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Looks down.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Turns a page.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Isaac stops.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Takes off his hat.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Holds it in both hands.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Monsieur?", "name": "FERNAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Just a coffee.", "name": "ISAAC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Sit anywhere.", "name": "FERNAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Isaac looks at the corner table.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "The one empty chair across from Celine.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "He sits at the next table over instead.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Sets the violin case on his lap.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "The silence has weight.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Fernand brings the coffee.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "He sets it down, pauses, glances at Celine, then at Isaac, and retreats behind the counter with the expression of a man who has seen this before.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Celine turns another page without reading it.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Isaac stirs his coffee for a very long time.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Neither of them has added sugar.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "You cut your hair.", "name": "ISAAC", "speaker": 2, "ext": ["CONT'D"], "paren": ["not looking"], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "You grew a beard.", "name": "CELINE", "speaker": 0, "ext": [], "paren": ["not looking"], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "It's raining.", "name": "ISAAC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "I noticed.", "name": "CELINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "His hand rests on the violin case.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Her thumb traces the edge of a page.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Fernand polishes the glass again.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Is it still in tune?", "name": "CELINE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Why?", "name": "ISAAC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Just asking.", "name": "CELINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "He opens the case.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Lifts the violin.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Tucks it under his chin.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Draws the bow across a single string, long and low, and the sound fills the narrow cafe, and Celine closes her book.", "para": 10, "sent": 3, "present": [0, 1, 2]}]}