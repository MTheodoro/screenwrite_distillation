{"scene_id": "s00965", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00965.fountain", "heading": "INT. PAWNSHOP BACK OFFICE - NIGHT", "cast": [{"id": 0, "name": "BUNNY", "names": ["BUNNY"], "gender": "?", "first": 5, "spoke": 6}, {"id": 1, "name": "OKAFOR-STANWYCK", "names": ["OKAFOR-STANWYCK"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "DELIA VOSS-MBEKI", "names": ["DELIA VOSS-MBEKI", "DELIA"], "gender": "?", "first": 6, "spoke": 6}, {"id": 3, "name": "GUS", "names": ["GUS"], "gender": "?", "first": 7, "spoke": 6}, {"id": 4, "name": "PELLEGRINI-ADE", "names": ["PELLEGRINI-ADE"], "gender": "?", "first": 7, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. PAWNSHOP BACK OFFICE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent tube.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A steel desk.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Shelves of watches, guitars, wedding rings in velvet trays.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A safe the size of a refrigerator, door ajar.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "BERNICE \"BUNNY\" OKAFOR-STANWYCK (50s) counts cash into stacks, reading glasses on her nose.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Her partner, DELIA VOSS-MBEKI (40s), leans on the desk eating an orange.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "A boy of twenty, AUGUSTUS \"GUS\" PELLEGRINI-ADE, sits on a stool by the door, one knee bouncing.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "Fifteen thousand. All there.", "name": "BUNNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Told you.", "name": "DELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Can I go now?", "name": "GUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "You're not going anywhere.", "name": "BUNNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "You said, once the count --", "name": "GUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Gus, honey. Sit.", "name": "DELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "He sits.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "He was sitting.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "He sits harder.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Sixteen. Seventeen.", "name": "BUNNY", "speaker": 0, "ext": [], "paren": ["counting"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "You nervous, Gus?", "name": "DELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "No.", "name": "GUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "You look nervous.", "name": "DELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "It's a pawnshop. I'm fine.", "name": "GUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "She smiles at him.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Peels the orange, a long unbroken spiral.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Hands him a segment.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "He takes it and does not eat it.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Eighteen. Nineteen.", "name": "BUNNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "The shop bell rings out front.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "All three freeze.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "We're closed.", "name": "DELIA", "speaker": 2, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Through the wall, a truck door slams.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Gus goes white.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "That's my dad's truck.", "name": "GUS", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "You told us he was in Phoenix.", "name": "BUNNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "He was!", "name": "GUS", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": true, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Bunny.", "name": "DELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "I know.", "name": "BUNNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Bunny rises and, slowly, takes a small revolver from the drawer.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Delia sets the orange peel on the desk.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "The shop bell rings again.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}]}