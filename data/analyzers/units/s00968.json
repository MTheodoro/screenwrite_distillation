{"scene_id": "s00968", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00968.fountain", "heading": "INT. LOCKER ROOM, COMMUNITY COLLEGE GYM - 5:40 A.M.", "cast": [{"id": 0, "name": "DESHAWN PRITCHARD-AMADI", "names": ["DESHAWN PRITCHARD-AMADI", "DESHAWN"], "gender": "m", "first": 5, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. LOCKER ROOM, COMMUNITY COLLEGE GYM - 5:40 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "Gray light through frosted windows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of dented lockers.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A bench bolted to the floor.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A shower drips somewhere, patient as a metronome.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DESHAWN PRITCHARD-AMADI (20s, lean, wrapped in a towel, hands taped to the wrist) sits on the bench, staring at his own feet.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A gym bag rests between his ankles.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "A cheap phone sits on his knee.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "He picks it up.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Puts it down.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "The PA system clicks overhead.", "para": 3, "sent": 0, "present": [0]}, {"u": 11, "kind": "dialogue", "text": "All fighters report to the ring in fifteen minutes. All fighters, fifteen minutes.", "name": "DESHAWN", "speaker": 0, "ext": ["V.O."], "paren": ["recorded, over PA"], "dual": false, "present": [0]}, {"u": 12, "kind": "action", "text": "He winces.", "para": 4, "sent": 0, "present": [0]}, {"u": 13, "kind": "action", "text": "Stops.", "para": 4, "sent": 1, "present": [0]}, {"u": 14, "kind": "action", "text": "Realizes his own recorded voice is the one on the PA, the one he left for the gym's morning announcements.", "para": 4, "sent": 2, "present": [0]}, {"u": 15, "kind": "action", "text": "He lets out a short laugh.", "para": 4, "sent": 3, "present": [0]}, {"u": 16, "kind": "dialogue", "text": "Fifteen minutes.", "name": "DESHAWN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 17, "kind": "action", "text": "He flexes his fingers inside the tape.", "para": 5, "sent": 0, "present": [0]}, {"u": 18, "kind": "action", "text": "Stands.", "para": 5, "sent": 1, "present": [0]}, {"u": 19, "kind": "action", "text": "Rolls his neck until it pops.", "para": 5, "sent": 2, "present": [0]}, {"u": 20, "kind": "dialogue", "text": "Not scared. Not scared.", "name": "DESHAWN", "speaker": 0, "ext": ["CONT'D"], "paren": ["to himself"], "dual": false, "present": [0]}, {"u": 21, "kind": "action", "text": "He opens the locker, takes out a pair of worn red gloves, and holds them up to the light as if they might tell him something.", "para": 6, "sent": 0, "present": [0]}, {"u": 22, "kind": "action", "text": "They don't.", "para": 6, "sent": 1, "present": [0]}, {"u": 23, "kind": "action", "text": "The shower drips.", "para": 7, "sent": 0, "present": [0]}, {"u": 24, "kind": "action", "text": "He slides the gloves on.", "para": 7, "sent": 1, "present": [0]}, {"u": 25, "kind": "action", "text": "Taps them together once, twice.", "para": 7, "sent": 2, "present": [0]}, {"u": 26, "kind": "dialogue", "text": "Okay. Okay.", "name": "DESHAWN", "speaker": 0, "ext": ["CONT'D"], "paren": ["louder"], "dual": false, "present": [0]}, {"u": 27, "kind": "action", "text": "He walks to the mirror, looks himself in the eye, and does not look away.", "para": 8, "sent": 0, "present": [0]}, {"u": 28, "kind": "dialogue", "text": "Let's go.", "name": "DESHAWN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 