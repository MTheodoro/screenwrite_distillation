{"scene_id": "s00969", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00969.fountain", "heading": "INT. SCHOOL BUS DEPOT, MAINTENANCE PIT - LATE AFTERNOON", "cast": [{"id": 0, "name": "CLAY", "names": ["CLAY"], "gender": "m", "first": 4, "spoke": 11}, {"id": 1, "name": "WREN ABERNETHY-OKORO", "names": ["ABERNETHY-OKORO", "WREN ABERNETHY-OKORO", "WREN"], "gender": "f", "first": 4, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. SCHOOL BUS DEPOT, MAINTENANCE PIT - LATE AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Oil, rust, the bones of old buses.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fluorescent bars hum overhead.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Work lights hang from a rolling cart.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CLARENCE \"CLAY\" ABERNETHY-OKORO (50s, coveralls, a pencil behind each ear) lies on a creeper beneath a bus, wrenching at something unseen.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "A radio on the floor plays low country.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Footsteps on concrete.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Sneakers.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "A teenage girl hovers at the edge of the pit, backpack on one shoulder, staring down.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Is that you, Wren?", "name": "CLAY", "speaker": 0, "ext": [], "paren": ["from under the bus"], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "The girl is WREN ABERNETHY-OKORO (16, hair in a messy braid, headphones around her neck).", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She sits at the edge of the pit, feet dangling.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Hi, Dad.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "You're early.", "name": "CLAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "I walked.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "It's four miles.", "name": "CLAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "I know how far it is.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "A wrench clanks.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Clay rolls out on the creeper, wiping his hands on a rag, and looks up at his daughter.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "His face softens, then tightens as he sees hers.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "What happened?", "name": "CLAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Nothing.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Wren.", "name": "CLAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "I quit the team.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "He sits up slowly.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "The radio sings about a dog and a truck.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Okay.", "name": "CLAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Aren't you going to yell?", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Do you want me to?", "name": "CLAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Kind of.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Then I will. (beat) Wren Abernethy!", "name": "CLAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "That's not yelling.", "name": "WREN", "speaker": 1, "ext": [], "paren": ["smiling despite herself"], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "I'm out of practice.", "name": "CLAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "She slides down into the pit and sits on the creeper next to him.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "He hands her a wrench.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "She turns it over in her hands.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Dad? I'm okay, you know.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "I know, kiddo.", "name": "CLAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Can I help?", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Hold the light.", "name": "CLAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}