{"scene_id": "s00970", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00970.fountain", "heading": "INT. DROWNED CATHEDRAL BELFRY - TIDE HOUR", "cast": [{"id": 0, "name": "ORSOLYA", "names": ["ORSOLYA"], "gender": "f", "first": 4, "spoke": 7}, {"id": 1, "name": "KEZIAH", "names": ["KEZIAH"], "gender": "m", "first": 7, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. DROWNED CATHEDRAL BELFRY - TIDE HOUR", "present": []}, {"u": 1, "kind": "action", "text": "Green water laps the third stair.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Moonlight through broken tracery.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "One huge bell, furred with barnacles.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ORSOLYA (30s, salt-white braid, bone-needle at her belt) crouches on a beam.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Soaked.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Grinning.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "KEZIAH (20s, half-fox ears, patched coat) hauls himself through the window.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Drips everywhere.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "You're late, Kez.", "name": "ORSOLYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "The tide was early.", "name": "KEZIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "The tide is never early. You were.", "name": "ORSOLYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He lifts a lantern.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Inside, a trapped blue flame.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Got it. Moon-ember. Off the sleeping tax-collector himself.", "name": "KEZIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She snatches it.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Laughs.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Kisses his forehead.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Kezi. You beautiful thief.", "name": "ORSOLYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "The bell hums.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Low.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Wrong.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Orsolya. That's not us.", "name": "KEZIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She freezes.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "So does he.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Water rises.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Fast.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Knee-deep.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Waist.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Take the rope.", "name": "ORSOLYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Not without you!", "name": "KEZIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "She shoves him.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Hard.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "He grabs the bell-rope, swings, slams against stone.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Hisses.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Ring it!", "name": "ORSOLYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "It'll wake the whole drowned choir!", "name": "KEZIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Better them than the tide!", "name": "ORSOLYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "He hesitates.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Then pulls.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "DONG.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "The sound rolls out like thunder under glass.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "The water stops.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Shivers.", "para": 10, "sent": 3, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "Retreats.", "para": 10, "sent": 4, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "Silence.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "They stare at each other.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Then both burst out laughing.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Never again.", "name": "KEZIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Liar.", "name": "ORSOLYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "Somewhere below, a choir begins to sing.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "Off-key.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "Furious.", "para": 12, "sent": 2, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "She grabs his hand.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "They run.", "para": 13, "sent": 1, "present": [0, 1]}]}