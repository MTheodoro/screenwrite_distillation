{"scene_id": "s00972", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00972.fountain", "heading": "INT. FERRY CAFETERIA - NIGHT CROSSING", "cast": [{"id": 0, "name": "DOLORES", "names": ["DOLORES"], "gender": "f", "first": 5, "spoke": 5}, {"id": 1, "name": "PAZ", "names": ["PAZ"], "gender": "?", "first": 6, "spoke": 3}, {"id": 2, "name": "HENRIK", "names": ["HENRIK"], "gender": "m", "first": 7, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. FERRY CAFETERIA - NIGHT CROSSING", "present": []}, {"u": 1, "kind": "action", "text": "Orange plastic booths.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A coffee urn rattles with the engine.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain on the windows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Nobody else aboard.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DOLORES (60s, black cardigan, rosary wound around her wrist) sits stiff.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across from her, PAZ (40s, leather jacket, same jaw) peels a label off a water bottle.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "HENRIK (50s, rumpled suit, folder under his arm) arrives with two paper cups.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Sets one down.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Hesitates.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Sets the other down too.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "She doesn't touch hers.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "She watches her sister.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Your mother's will is short.", "name": "HENRIK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Mine, she says. My mother. Not yours.", "name": "DOLORES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Paz stops peeling.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "She looks up.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Our mother.", "name": "PAZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "She slides the label across the table.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "A small, damp scrap.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "It leaves the house to one of you.", "name": "HENRIK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "She laughs.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Short.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Ugly.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The other stays silent.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Which one.", "name": "DOLORES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "The one who stayed.", "name": "HENRIK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Paz stands.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Sits again.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Her knee bounces under the table.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Twenty years she called me every Sunday.", "name": "PAZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "And I washed her every morning.", "name": "DOLORES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "She slams a palm on the Formica.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "The urn rattles louder.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Henrik flinches, opens the folder, closes it.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "There's a letter. She asked me to read it only if you both were present.", "name": "HENRIK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Read it, then.", "name": "DOLORES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "He unfolds the page.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Clears his throat.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Her eyes are already wet.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "The other's are not.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "\"Neither of you gets the house.\"", "name": "HENRIK", "speaker": 2, "ext": [], "paren": ["reading"], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Silence.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "The ferry horn sounds, long and low.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "She reaches for the cup.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Her hands shake.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Paz takes the other cup, drinks, and nods once at the window.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "She never could make a decision.", "name": "PAZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "She made this one.", "name": "DOLORES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}