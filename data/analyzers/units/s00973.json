{"scene_id": "s00973", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00973.fountain", "heading": "INT. GLASS-FOREST APIARY TOWER - DUSK", "cast": [{"id": 0, "name": "WYNFRED", "names": ["WYNFRED"], "gender": "?", "first": 2, "spoke": 9}, {"id": 1, "name": "SABLE", "names": ["SABLE"], "gender": "?", "first": 3, "spoke": 8}, {"id": 2, "name": "LUCAN", "names": ["LUCAN"], "gender": "?", "first": 4, "spoke": 13}], "units": [{"u": 0, "kind": "heading", "text": "INT. GLASS-FOREST APIARY TOWER - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "Hexagonal windows hum with ten thousand bees.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "WYNFRED, an old beekeeper in a veil of moth silk, pours smoke into a brass censer.", "para": 0, "sent": 1, "present": [0]}, {"u": 3, "kind": "action", "text": "SABLE, a young storm-witch with wet hair, sits on the hive-table.", "para": 0, "sent": 2, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "LUCAN, a knight with a cracked pauldron, stands by the stairs.", "para": 0, "sent": 3, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "You came a long way for honey.", "name": "WYNFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "I came for the queen.", "name": "LUCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "He means the hive's queen. Not the crown.", "name": "SABLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Does he?", "name": "WYNFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "I mean what I said.", "name": "LUCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "You mean what you were told to say.", "name": "SABLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "The king is dying.", "name": "LUCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Kings do.", "name": "WYNFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "His physician says only royal jelly can hold the fever.", "name": "LUCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "And the physician is lying.", "name": "SABLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "You don't know that.", "name": "LUCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "I know the smell of a man who wants a hive burned.", "name": "SABLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Quiet, child. Let him say it.", "name": "WYNFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "I was told to take the queen. Alive if she'd come. Dead if not.", "name": "LUCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "And you believed it.", "name": "WYNFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I believed the king.", "name": "LUCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "The king hasn't spoken in a month.", "name": "SABLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Then who sent me?", "name": "LUCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Ask the hive.", "name": "WYNFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The humming deepens.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Wynfred sets down the censer.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "I won't kill a queen of bees.", "name": "LUCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Then what will you do?", "name": "SABLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "I'll warn the king.", "name": "LUCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "He can't hear you.", "name": "WYNFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Then I'll make the palace hear!", "name": "LUCAN", "speaker": 2, "ext": [], "paren": ["shouting"], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Then I will!", "name": "SABLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Then I will!", "name": "LUCAN", "speaker": 2, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Both of you, stop.", "name": "WYNFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "He is my king.", "name": "LUCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "And this is my home.", "name": "SABLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Then go together. Fire answers fire. Bees answer storm.", "name": "WYNFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}