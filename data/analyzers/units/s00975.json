{"scene_id": "s00975", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00975.fountain", "heading": "INT. ROLLER RINK - AFTER CLOSING", "cast": [{"id": 0, "name": "DEZ", "names": ["DEZ"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "MARISOL", "names": ["MARISOL"], "gender": "?", "first": 6, "spoke": 6}, {"id": 2, "name": "TOBY", "names": ["TOBY"], "gender": "?", "first": 7, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROLLER RINK - AFTER CLOSING", "present": []}, {"u": 1, "kind": "action", "text": "Disco ball still turning.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Chairs up on tables.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Carpet-covered walls.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DEZ (16) sits on the skate counter in one rental skate.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He holds the other.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "MARISOL (16) leans on the rail, arms crossed.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "TOBY (15) lies flat on the floor, staring at the ceiling.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "So that's it. Last night.", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Dez, the rink is closing. Not you.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "It's basically you. You were born here.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Rink rat. That's what Mr. Pruitt called me.", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "He called me that too.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "He called everyone that.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "My first kiss was by the snack bar.", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "It was me.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "It was a hot dog. I was kissing a hot dog.", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I was there. It was sad.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "We'll find somewhere else.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "There isn't anywhere else.", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "There's the parking lot.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "The parking lot has no music.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "I'll bring a speaker.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "He sits up.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Grins.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "She lets her arms drop.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Fine. Parking lot. Saturdays.", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Saturdays.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Dez slides the second skate on.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Stands.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Wobbles.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Rolls one slow lap, alone, while the ball keeps turning.", "para": 3, "sent": 3, "present": [0, 1, 2]}]}