{"scene_id": "s00976", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00976.fountain", "heading": "INT. SYNERGY DEPARTMENT - FORMER FUNERAL HOME - MORNING", "cast": [{"id": 0, "name": "PELLINGHAM", "names": ["PELLINGHAM", "MR. PELLINGHAM"], "gender": "?", "first": 5, "spoke": 8}, {"id": 1, "name": "GLORIA", "names": ["GLORIA"], "gender": "?", "first": 6, "spoke": 5}, {"id": 2, "name": "SPUD", "names": ["SPUD"], "gender": "?", "first": 7, "spoke": 5}, {"id": 3, "name": "ADAEZE", "names": ["ADAEZE"], "gender": "?", "first": 8, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. SYNERGY DEPARTMENT - FORMER FUNERAL HOME - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Cubicles line the old viewing room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A faux-brass chandelier.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A banner reads \"WE'RE ALL FAMILY HERE.\"", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Coffins serve as supply cabinets.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MR. PELLINGHAM (50s, bow tie, sweating) stands on a velvet kneeler holding a clipboard.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "GLORIA (40s, reading glasses on a chain) sorts paperclips.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "SPUD (30s, hoodie) eats cereal from a casket lid.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "ADAEZE (20s, headset, razor eyes) types without looking.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "People! People! Today we pivot.", "name": "MR. PELLINGHAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "We pivoted yesterday, Mr. Pellingham.", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Twice. Before lunch.", "name": "SPUD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Spud, today we pivot to a pivot.", "name": "MR. PELLINGHAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Is that a metric?", "name": "ADAEZE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Adaeze, it's a mindset.", "name": "MR. PELLINGHAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "What happened to the mindset?", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "It got laid off.", "name": "SPUD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Nobody got laid off. We are right-sizing the horizon.", "name": "MR. PELLINGHAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Gloria, did he say horizon?", "name": "ADAEZE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "He said horizon.", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "I am going to need everyone's quarterly aspirations by noon.", "name": "MR. PELLINGHAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Mr. Pellingham, I only have a quarterly nap.", "name": "SPUD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Spud!", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Put it in the shared folder.", "name": "ADAEZE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Thank you, Adaeze.", "name": "MR. PELLINGHAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "He thanked her. Mark the calendar.", "name": "SPUD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Mark it. Under \"Funeral\".", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Mr. Pellingham looks at the banner.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Climbs down.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Sighs.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Friends, let's just have cake.", "name": "MR. PELLINGHAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Is it from the last funeral?", "name": "SPUD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "It's... lemon.", "name": "MR. PELLINGHAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}