{"scene_id": "s00978", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00978.fountain", "heading": "EXT. LEVIATHAN BACK MARKET - DAWN", "cast": [{"id": 0, "name": "YARROW", "names": ["YARROW"], "gender": "?", "first": 5, "spoke": 5}, {"id": 1, "name": "CINDERMAE", "names": ["CINDERMAE"], "gender": "?", "first": 6, "spoke": 3}, {"id": 2, "name": "BRISK", "names": ["BRISK"], "gender": "m", "first": 7, "spoke": 4}, {"id": 3, "name": "SEUN", "names": ["SEUN"], "gender": "?", "first": 9, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. LEVIATHAN BACK MARKET - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A sleeping sea-beast the size of an island.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Stalls on its spine.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rigging lashed to ribs.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The skin breathes slowly.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "YARROW (20s, sea-glass eyes, ragged oilskin) crouches by a stall of bottled winds.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "CINDERMAE (70s, silver teeth, coal-black shawl) presides behind the counter.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "BRISK (teen, gull on his shoulder) scrambles up a rope ladder.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Out of breath.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "SEUN (40s, copper armor, spear of whalebone) lurks at the edge, watching.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Yarrow! They're coming!", "name": "BRISK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Who?", "name": "YARROW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "The tide-wardens!", "name": "BRISK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Quiet, boy. You'll wake the beast.", "name": "CINDERMAE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "The leviathan's skin ripples.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Stalls shudder.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Bottles clink.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "How many?", "name": "YARROW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Six. Maybe seven.", "name": "BRISK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Eight.", "name": "SEUN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "They turn.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Seun steps forward, spear lowered.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "And I am the first.", "name": "SEUN", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Seun. You were a friend of this market.", "name": "CINDERMAE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "I was a friend of the market. The sea-king is the market's master.", "name": "SEUN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "You swore an oath to the wind.", "name": "YARROW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "She swore an oath to the wind.", "name": "CINDERMAE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "She swore an oath to the wind.", "name": "YARROW", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Oaths bend.", "name": "SEUN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "The gull says run.", "name": "BRISK", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Seun hurls the spear.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "It bursts a jar of tempest.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Wind howls out.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "The leviathan groans awake.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "The whole market tilts.", "para": 7, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Hold on!", "name": "YARROW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Everyone grabs rope.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}]}