{"scene_id": "s00980", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00980.fountain", "heading": "EXT. SALT FLAT STAGE STATION - NOON", "cast": [{"id": 0, "name": "SILAS MORROW", "names": ["SILAS MORROW", "SILAS"], "gender": "m", "first": 5, "spoke": 8}, {"id": 1, "name": "CATALINA VEGA", "names": ["CATALINA VEGA", "CATALINA"], "gender": "?", "first": 6, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SALT FLAT STAGE STATION - NOON", "present": []}, {"u": 1, "kind": "action", "text": "White ground, white sky.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A lone shack.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A dead well.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Heat shimmer.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SILAS MORROW (50s, dusty duster, gray stubble) sits on a bench with a rifle across his knees.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "CATALINA VEGA (30s, wide hat, twin pistols) stands in the road ten paces away.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "You're a long way from Tucson, Silas.", "name": "CATALINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "I was told you'd be here.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "By who?", "name": "CATALINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "By a man who owed me.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "He owed you what?", "name": "CATALINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "A reason.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She smiles.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Steps forward.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "He doesn't move.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "You killed my brother.", "name": "CATALINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "I did.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Why?", "name": "CATALINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "He drew first.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "He was nineteen.", "name": "CATALINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "So was I, once.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "The wind stops.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Both of them listen.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Stand up.", "name": "CATALINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "My knees won't allow it.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "She draws one pistol.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "He lifts the rifle.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "They both freeze, muzzles level.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Last words?", "name": "CATALINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Tell the boy's mother I'm sorry.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "A gunshot.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Both flinch.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Both dive for cover.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "On the ridge, a distant rider tumbles from a horse.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "The two lie in the salt, breathing.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "They look at each other.", "para": 6, "sent": 2, "present": [0, 1]}]}