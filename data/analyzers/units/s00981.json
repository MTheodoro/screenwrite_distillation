{"scene_id": "s00981", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00981.fountain", "heading": "INT. DRIVE-IN PROJECTION BOOTH - NIGHT", "cast": [{"id": 0, "name": "RAFAELA", "names": ["RAFAELA"], "gender": "f", "first": 5, "spoke": 4}, {"id": 1, "name": "JUNE", "names": ["JUNE"], "gender": "?", "first": 6, "spoke": 5}, {"id": 2, "name": "KOWALCZYK", "names": ["KOWALCZYK", "MR. KOWALCZYK"], "gender": "?", "first": 25, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRIVE-IN PROJECTION BOOTH - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped brick box.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "An old carbon-arc projector clatters.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Film cans stacked like pizza boxes.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Through the slit window, a giant screen glows over an empty lot.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "RAFAELA (17, denim jacket, a lighter in her fist) sits on the stool.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "JUNE (17, cardigan, hair pinned back) stands at the door.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Both are tense.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You told me it was just a smoke.", "name": "JUNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "It is just a smoke.", "name": "RAFAELA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She flicks the lighter.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "A small flame.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She stares at it, then at the stacked cans.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "That's nitrate film, Rafaela.", "name": "JUNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "I know.", "name": "RAFAELA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "It burns like gasoline.", "name": "JUNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She clicks the lighter shut.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Too late.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "A can on the shelf flares with a quiet whump.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Oh my God.", "name": "JUNE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Smoke blooms.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She grabs a blanket and smothers it.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Rafaela stamps.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "They cough, eyes wide, bodies bent.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "The door swings open.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "MR. KOWALCZYK (60s, suspenders, a flashlight) stands there.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Smoke curls around his head.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Which one of you is on fire?", "name": "MR. KOWALCZYK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Nobody. It's the projector.", "name": "RAFAELA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "The projector is not made of smoke.", "name": "MR. KOWALCZYK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "It was an accident, sir.", "name": "JUNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "He sniffs.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Looks at the blackened can.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Then at the two of them.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "For a long moment, he says nothing.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "That was the last reel of \"The Birds.\"", "name": "MR. KOWALCZYK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "We're so sorry.", "name": "RAFAELA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "It was a bad print anyway.", "name": "MR. KOWALCZYK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "He tosses the flashlight to June.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "She catches it.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Open a window. And never bring fire in here again.", "name": "MR. KOWALCZYK", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "He leaves.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "They stare at each other.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Then they laugh, shaky and helpless, as the screen outside goes dark.", "para": 8, "sent": 2, "present": [0, 1, 2]}]}