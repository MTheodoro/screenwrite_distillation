{"scene_id": "s00982_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00982.fountain", "heading": "INT. CABLE CAR - CONTINUOUS", "cast": [{"id": 0, "name": "ABEBE", "names": ["ABEBE"], "gender": "m", "first": 5, "spoke": 8}, {"id": 1, "name": "SOLVEIG", "names": ["SOLVEIG"], "gender": "f", "first": 6, "spoke": 8}, {"id": 2, "name": "BIG MO", "names": ["BIG MO"], "gender": "?", "first": 7, "spoke": 9}, {"id": 3, "name": "TERESA", "names": ["TERESA"], "gender": "f", "first": 8, "spoke": 6}, {"id": 4, "name": "BILLIE", "names": ["BILLIE"], "gender": "f", "first": 32, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. CABLE CAR - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Cramped.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fogged glass.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Cold.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Four people in parkas.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ABEBE (50s, guide's badge, steady) sits with a radio on his knee.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "SOLVEIG (30s, mountaineering gear) checks the roof hatch.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "BIG MO (40s, shaved head, shaking hands) clutches the safety bar.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "TERESA (20s, camera round her neck) films the glass.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Two hours since the stall.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Rescue knows we're here.", "name": "ABEBE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Then why isn't anyone coming?", "name": "BIG MO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Because the wind is bad.", "name": "ABEBE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Day one. We are still alive.", "name": "TERESA", "speaker": 3, "ext": [], "paren": ["to the camera"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Turn that off.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "It's evidence.", "name": "TERESA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Of what?", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Of how scared we are.", "name": "TERESA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "I'm not scared.", "name": "BIG MO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "He grips the bar tighter.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "The car sways.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "He swallows.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Everyone sit down. Slowly. Weight low.", "name": "ABEBE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "They obey.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "The car steadies.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Don't look at the river. Don't look at the river.", "name": "BIG MO", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Mo, you're doing fine.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "I'm not.", "name": "BIG MO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Radio's picking up something.", "name": "ABEBE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "He turns the dial.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Static.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "A voice, thin and far away.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "...hold on... coming up the line...", "name": "BILLIE", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Did you hear that?", "name": "TERESA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Quiet.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "The car shudders.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "A thump on the roof.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Another.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Dust sifts from the hatch.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Stay away from the door.", "name": "ABEBE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "The hatch opens.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "A rope drops.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Then boots.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "BILLIE (30s, orange rescue suit, harness clanking) swings in feet first, grinning.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Evening, folks. Everybody breathing?", "name": "BILLIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "You're real.", "name": "BIG MO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Last time I checked.", "name": "BILLIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "How many of us can you take?", "name": "TERESA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Well, that's the thing.", "name": "BILLIE", "speaker": 4, "ext": [], "paren": ["brightly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "She unclips.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Looks at the four of them.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Her smile fades.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "The line's frayed, and it's holding my weight just fine. It won't hold yours.", "name": "BILLIE", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "What does that mean?", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "It means I came to tell you the other cars are gone. This one's next.", "name": "BILLIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Silence.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "The cable groans.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "How long?", "name": "ABEBE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "Until the wind turns? Maybe an hour.", "name": "BILLIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "Then why come?", "name": "BIG MO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "Because someone should be here.", "name": "BILLIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "Day one.", "name": "TERESA", "speaker": 3, "ext": [], "paren": ["to the camera, very quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "Solveig takes the camera.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "Turns it off.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "She puts an arm around Teresa.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "Okay. Then we use the hour.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "dialogue", "text": "Everyone give me your coats. We make a sling.", "name": "ABEBE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "dialogue", "text": "For who?", "name": "BIG MO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "dialogue", "text": "For whoever goes first.", "name": "ABEBE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "Billie hands her radio to Abebe.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "action", "text": "He takes it and nods.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "dialogue", "text": "I'll go last.", "name": "BIG MO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "dialogue", "text": "Mo...", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "dialogue", "text": "I'm done being scared of the river.", "name": "BIG MO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "action", "text": "The car sways.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "action", "text": "They hold on.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}]}