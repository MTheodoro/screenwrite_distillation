{"scene_id": "s00983", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00983.fountain", "heading": "INT. LOCK-KEEPER'S COTTAGE - NIGHT", "cast": [{"id": 0, "name": "AUGUSTINE BELLWEATHER", "names": ["AUGUSTINE BELLWEATHER", "AUGUSTINE"], "gender": "?", "first": 6, "spoke": 9}, {"id": 1, "name": "PRU", "names": ["PRU"], "gender": "f", "first": 7, "spoke": 4}, {"id": 2, "name": "HALVORSEN", "names": ["HALVORSEN"], "gender": "?", "first": 17, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. LOCK-KEEPER'S COTTAGE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A low stone room above a canal lock.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wet rope on hooks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A brass wall telephone.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A kettle on a coal stove.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Water thuds against the lock gate outside.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "AUGUSTINE BELLWEATHER (60s, tall, rain-soaked inspector's coat, magnifier on a cord) stands over a desk covered with tide charts.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "PRU (20s, lock-keeper's apprentice, mud on her boots) sits on the stool, hugging a lantern.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Say it again, from the top.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I heard a splash around midnight. I went down. The gate was open and the barge was gone.", "name": "PRU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "And the body?", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "There was no body.", "name": "PRU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Then why does the captain say there was one?", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "The phone rings.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Both startle.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Augustine lifts the receiver.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Bellweather.", "name": "AUGUSTINE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Inspector. It's Halvorsen at the harbor. We've found the barge.", "name": "HALVORSEN", "speaker": 2, "ext": ["V.O."], "paren": ["filtered, tense"], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Where?", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Two locks downstream. Empty. Except for a woman's boot.", "name": "HALVORSEN", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Pru goes pale.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "She drops the lantern.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "It rolls, flickers, and stays alight.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Whose boot?", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Size six. Leather. Mud on the heel.", "name": "HALVORSEN", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Augustine lowers the phone.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Looks at the girl.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "At her feet.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Miss Pru. Please take off your boots.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Sir, I can explain.", "name": "PRU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "I don't doubt it.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "She bends.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Unlaces one boot.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Her hands tremble.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Then she laughs, suddenly, and pulls out a second pair from under the stool.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "I swapped them. They're my mother's. I wanted to see how it felt to wear them.", "name": "PRU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Augustine stares.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "The kettle whistles.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Inspector? Are you there?", "name": "HALVORSEN", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Yes. I think we've been chasing a cobbler's mistake.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": ["into phone"], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "He hangs up.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Pours the tea.", "para": 8, "sent": 1, "present": [0, 1, 2]}]}