{"scene_id": "s00984", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00984.fountain", "heading": "INT. MATTRESS SHOWROOM - MIDNIGHT", "cast": [{"id": 0, "name": "WANDA", "names": ["WANDA"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "GUS", "names": ["GUS"], "gender": "?", "first": 5, "spoke": 6}, {"id": 2, "name": "KIT", "names": ["KIT"], "gender": "?", "first": 6, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. MATTRESS SHOWROOM - MIDNIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Rows of beds under spotlights.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A banner: \"24-HOUR SLEEP-OFF!\"", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single clock ticks.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "WANDA (50s, silk robe, sleep mask pushed up) lies stiffly on a king-size, hands folded like a corpse.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "GUS (60s, store manager, tie loosened) hovers with a clipboard.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "KIT (20s, intern, pajama pants) kneels at the bedside holding a tiny stopwatch.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Wanda, you've been lying there for nineteen hours.", "name": "GUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Eighteen hours, forty minutes, Gus.", "name": "WANDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "She's right. I've been counting.", "name": "KIT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Kit, you shouldn't be encouraging her.", "name": "GUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "She's very peaceful, Mr. Gus.", "name": "KIT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "The prize is a lifetime supply of pillows.", "name": "WANDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "It's one pillow. You'd get one pillow.", "name": "GUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "A good pillow.", "name": "WANDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Gus sighs.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Sits on the next mattress.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Yawns.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Kit yawns.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Wanda smiles, eyes closed.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Gus, dear. Don't lie down.", "name": "WANDA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "I'm just resting my back.", "name": "GUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Mr. Gus, you're horizontal.", "name": "KIT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "I'm... diagonal.", "name": "GUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Wanda sits up with a crisp snap.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Pulls a gleaming trophy from under the sheets.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Three days ago I faked that bed rule. The contest only requires you to stay in the store.", "name": "WANDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "You were never asleep?", "name": "GUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Not for a second.", "name": "WANDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Kit slumps to the floor, snoring.", "para": 4, "sent": 0, "present": [0, 1, 2]}]}