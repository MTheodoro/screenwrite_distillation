{"scene_id": "s00985", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00985.fountain", "heading": "INT. PICKLE CELLAR - GRANDMOTHER'S FARMHOUSE - LATE AFTERNOON", "cast": [{"id": 0, "name": "NONNA FLORENTINA", "names": ["NONNA FLORENTINA"], "gender": "?", "first": 5, "spoke": 13}, {"id": 1, "name": "EMEKA", "names": ["EMEKA"], "gender": "m", "first": 6, "spoke": 6}, {"id": 2, "name": "TAMSIN", "names": ["TAMSIN"], "gender": "?", "first": 7, "spoke": 6}, {"id": 3, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 40, "spoke": 3}, {"id": 4, "name": "BARTOSZ", "names": ["BARTOSZ"], "gender": "?", "first": 49, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. PICKLE CELLAR - GRANDMOTHER'S FARMHOUSE - LATE AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "A low, cool stone room lined with shelves of jars.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dill, vinegar, garlic.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single bulb on a cord.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Dust turns in the light.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "NONNA FLORENTINA (80s, small, apron, forearms like rope) sorts jars by hand.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her grandson EMEKA (10, school uniform, backpack) sits on an upturned crate, swinging his legs.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "His mother TAMSIN (40s, scrubs, car keys in hand) stands on the bottom step.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "She watches the old woman.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "She doesn't speak.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Nonna, why do you turn the jars?", "name": "EMEKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "So the brine moves. Stale brine makes soft pickles.", "name": "NONNA FLORENTINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "How do you know which ones are soft?", "name": "EMEKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "You listen. A good jar clicks.", "name": "NONNA FLORENTINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "She taps one with a fingernail.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Holds it to his ear.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "He listens, frowns, nods.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Mama, I have to get back to the hospital.", "name": "TAMSIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Then go.", "name": "NONNA FLORENTINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I told the school I'd pick him up at four.", "name": "TAMSIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "And you did.", "name": "NONNA FLORENTINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "She doesn't turn around.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Tamsin shifts on the step.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Checks her watch.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Puts it away.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Mum, can I stay for dinner?", "name": "EMEKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "You have homework.", "name": "TAMSIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "I can do it down here.", "name": "EMEKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "There is no light down here.", "name": "NONNA FLORENTINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "There's the bulb.", "name": "EMEKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "She smiles at that.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "She wipes her hands on her apron.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Upstairs, the screen door bangs.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Footsteps cross the floor above.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Dust drifts down from the beams.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "All three look up.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Who's that?", "name": "TAMSIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Probably the man about the gutters.", "name": "NONNA FLORENTINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Heavy boots on the cellar stairs.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "A shadow fills the doorway.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "A STRANGER (50s, work jacket, cap in hands, polite) ducks under the frame.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Sorry to bother you. Door was open.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Can we help you?", "name": "TAMSIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "I'm looking for Florentina Marchetti.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "You found her.", "name": "NONNA FLORENTINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "He steps into the light.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "He looks at the jars.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "At the boy.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "At her.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "My name's Bartosz. You knew my father. Janek.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "She sets down the jar slowly.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Her face does not change.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Her hands do.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "Janek the tinsmith.", "name": "NONNA FLORENTINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "That's the one.", "name": "BARTOSZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "Mama?", "name": "TAMSIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "It's all right, Tamsin.", "name": "NONNA FLORENTINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "She wipes her hands again.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Longer this time.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "He used to come down here in August. Said my brine was the only thing in the county worth a hungry man's trouble.", "name": "NONNA FLORENTINA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "He said that about you, too.", "name": "BARTOSZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "Who is he?", "name": "EMEKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "dialogue", "text": "Someone's son.", "name": "NONNA FLORENTINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "She lifts a jar from the shelf, wipes the lid, and holds it out to Bartosz.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "dialogue", "text": "Listen.", "name": "NONNA FLORENTINA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "He takes it.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "Holds it to his ear.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "action", "text": "The cellar is very quiet.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "dialogue", "text": "It clicks.", "name": "BARTOSZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "dialogue", "text": "Good. It's yours.", "name": "NONNA FLORENTINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "action", "text": "Tamsin steps down at last.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "action", "text": "Sits beside her son on the crate.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "action", "text": "Neither of them says anything.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "action", "text": "The bulb sways a little, then settles.", "para": 13, "sent": 3, "present": [0, 1, 2, 3, 4]}]}