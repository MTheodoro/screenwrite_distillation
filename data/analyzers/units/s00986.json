{"scene_id": "s00986", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00986.fountain", "heading": "EXT. MANGROVE RIVER - RAFT - DUSK", "cast": [{"id": 0, "name": "KOFI", "names": ["KOFI"], "gender": "m", "first": 4, "spoke": 0}, {"id": 1, "name": "NAOMI", "names": ["NAOMI"], "gender": "f", "first": 5, "spoke": 0}, {"id": 2, "name": "HAKON", "names": ["HAKON"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "RUSLAN", "names": ["RUSLAN"], "gender": "?", "first": 7, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. MANGROVE RIVER - RAFT - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "The river is brown glass between walls of knotted roots.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Mosquitoes hang in the amber light.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A flat raft of lashed bamboo drifts without a pole, carried by a current too slow to feel.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "KOFI (30s, bare-chested, sunburnt) lies on his back with a torn shirt over his face.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "NAOMI (30s, cropped hair, cracked lips) kneels at the edge, trailing a hand in the water.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "HAKON (70s, white beard, wool cap, still in a ruined parka) sits cross-legged, tying and untying the same knot.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "RUSLAN (8, too-big life vest) watches a heron on a root.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Nobody speaks.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Somewhere a frog begins and stops.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Kofi lifts the shirt.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Squints at the sky.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Lets it fall.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Naomi draws her hand from the water and looks at her fingers, wrinkled and white.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "She wipes them on her thigh.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Hakon pulls the knot tight.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Studies it.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Loosens it.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Ruslan holds out a cupped palm toward the heron.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "The bird lifts, unhurried, and flaps over the trees.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "He and Naomi both follow it with their eyes.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Kofi and Hakon do not.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "The raft turns a bend.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Ahead, the mangroves part on a long gray mud flat.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Far off, a roofline.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Maybe a boat shed.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Maybe a mirage.", "para": 7, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "All four see it.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "All four go still.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Nobody says a word, in case the word makes it vanish.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}]}