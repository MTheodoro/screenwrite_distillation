{"scene_id": "s00987", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00987.fountain", "heading": "INT. DIVING BELL - CHANNEL FLOOR, 1861", "cast": [{"id": 0, "name": "ARCHIBALD PENHALLOW", "names": ["ARCHIBALD PENHALLOW", "ARCHIBALD"], "gender": "?", "first": 6, "spoke": 15}, {"id": 1, "name": "TOBIAS FENWICK", "names": ["TOBIAS FENWICK", "TOBIAS"], "gender": "?", "first": 7, "spoke": 7}, {"id": 2, "name": "CORNELIUS VANE", "names": ["CORNELIUS VANE", "CORNELIUS"], "gender": "?", "first": 8, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. DIVING BELL - CHANNEL FLOOR, 1861", "present": []}, {"u": 1, "kind": "action", "text": "A riveted iron bell, six feet across.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Two brass portholes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A hissing air hose.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Green water presses against the glass.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A candle burns in a sealed lantern.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "ARCHIBALD PENHALLOW (50s, engineer, mutton-chop whiskers) crouches at the air valve.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "DR. TOBIAS FENWICK (40s, naturalist, spectacles fogged) clutches a specimen jar.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "CORNELIUS VANE (30s, company agent, pinstripe suit ruined by damp) sits rigid on the bench.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Forty feet. Pressure steady.", "name": "ARCHIBALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Marvelous. Marvelous. Look at the light.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I am looking at the water, Doctor. It is looking back.", "name": "CORNELIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Keep your voice down. Sound travels.", "name": "ARCHIBALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Where would it travel to?", "name": "CORNELIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "The surface. Where the men on the pump are listening for trouble.", "name": "ARCHIBALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "A tap on the glass.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "All three look.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "A pale fish, huge and slow, drifts past.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Lophius. Oh, Cornelius, you must see this.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I have no wish to see it.", "name": "CORNELIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "It's a monkfish. A giant.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "He holds up the jar.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Fogs the porthole with his breath.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Wipes it.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "He leans so close his nose touches the glass.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Get back from the window.", "name": "ARCHIBALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "It's only a fish.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "It's the pressure on the glass I'm worried about.", "name": "ARCHIBALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "You said it was safe.", "name": "CORNELIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "I said it was safe if we keep still.", "name": "ARCHIBALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "The bell shudders.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "A low groan from the iron seams.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The candle gutters.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "What was that?", "name": "CORNELIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "The sea settling.", "name": "ARCHIBALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Is it settling, or moving?", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Be quiet. Both of you.", "name": "ARCHIBALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "He unhooks a speaking tube and listens.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Nothing.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "He taps it.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Nothing.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "The line's dead.", "name": "ARCHIBALD", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Then we're lost.", "name": "CORNELIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "We are not lost. The pump men have a signal. Three tugs on the cord.", "name": "ARCHIBALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "He seizes the cord.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Pulls three times.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Waits.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Pulls again.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Tobias lowers the jar.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "His hand trembles.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "He sets it on the floor.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "I have always wanted to die in the name of science. I merely hadn't pictured it so damp.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Doctor, please.", "name": "CORNELIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "Nobody is dying. Cornelius, hand me that wrench.", "name": "ARCHIBALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "This one?", "name": "CORNELIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "The long one.", "name": "ARCHIBALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Cornelius passes it.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Archibald hammers the iron wall.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Once.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "Twice.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "Three times.", "para": 8, "sent": 4, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "A pause.", "para": 8, "sent": 5, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "Three muffled knocks answer from above.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "All three exhale at once.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "They heard.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "They always hear.", "name": "ARCHIBALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "The bell lurches.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "Rises.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "Slowly.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "The water in the porthole begins to lighten from green to gray.", "para": 10, "sent": 3, "present": [0, 1, 2]}, {"u": 71, "kind": "dialogue", "text": "Archibald?", "name": "CORNELIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 72, "kind": "dialogue", "text": "Yes?", "name": "ARCHIBALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 73, "kind": "dialogue", "text": "When we are up, I intend to be sick.", "name": "CORNELIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 74, "kind": "dialogue", "text": "Hold on to the bench.", "name": "ARCHIBALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}