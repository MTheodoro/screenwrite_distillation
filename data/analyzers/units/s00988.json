{"scene_id": "s00988", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00988.fountain", "heading": "INT. PICKLE FACTORY ELEVATOR - DAY", "cast": [{"id": 0, "name": "HARVEY", "names": ["HARVEY"], "gender": "?", "first": 5, "spoke": 9}, {"id": 1, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 6, "spoke": 8}, {"id": 2, "name": "ALBERTO", "names": ["ALBERTO"], "gender": "?", "first": 32, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. PICKLE FACTORY ELEVATOR - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A steel freight lift.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Slimy floor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single flickering bulb.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The smell of brine is overwhelming.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "HARVEY (40s, hairnet, clipboard) leans on one wall, scowling at the buttons.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A STRANGER (40s, windbreaker, visitor badge, big grin) stands on the other, holding a jar.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Great plant you've got here.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "It's a factory.", "name": "HARVEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Great factory.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "The elevator groans.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Stops.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Lights dim.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Oh, no.", "name": "HARVEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Is that normal?", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "It's never happened. Ever.", "name": "HARVEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Ever?", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Except Tuesday.", "name": "HARVEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He jabs a button.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Nothing.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "He tries again.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Nothing.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "The man unscrews the jar and sniffs.", "para": 3, "sent": 4, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "You mind if I eat one?", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Those are the quality-control samples.", "name": "HARVEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I'm quality control.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "I'm quality control.", "name": "HARVEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "I mean, I'm also quality control. We're all quality.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "He pops a pickle in his mouth.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Crunches loudly.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Harvey stares.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Who are you?", "name": "HARVEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Alberto Mendes. Your new regional auditor.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Oh, no.", "name": "HARVEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Don't worry, Harvey. Your pickles are fine.", "name": "ALBERTO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "How do you know my name?", "name": "HARVEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "It's on your hairnet.", "name": "ALBERTO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "The elevator lurches, then plunges a foot.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Both yelp.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Both grab the same railing.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Both look at the jar.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Alberto offers it.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Harvey takes one.", "para": 5, "sent": 5, "present": [0, 1, 2]}]}