{"scene_id": "s00990", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00990.fountain", "heading": "INT. SNOW-BOUND ONSEN BATHHOUSE - NIGHT", "cast": [{"id": 0, "name": "KENJI", "names": ["KENJI"], "gender": "m", "first": 5, "spoke": 4}, {"id": 1, "name": "LUCIA", "names": ["LUCIA"], "gender": "m", "first": 6, "spoke": 4}, {"id": 2, "name": "TANABE", "names": ["TANABE", "MRS. TANABE"], "gender": "?", "first": 7, "spoke": 4}, {"id": 3, "name": "DESMOND", "names": ["DESMOND"], "gender": "?", "first": 8, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. SNOW-BOUND ONSEN BATHHOUSE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Steam rolls off a cedar-lined pool.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Paper lanterns.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Snow falls past open shutters.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The air smells of sulfur and pine.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "KENJI (30s, lean, towel around his neck, glasses fogged) perches on the pool's edge.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "LUCIA (30s, copper hair pinned up, wrapped in a thin yukata) wades toward him, waist-deep.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "MRS. TANABE (70s, bent, white apron) shuffles past with a tray of sake.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "DESMOND (40s, loud tourist, Hawaiian shirt under a parka) hovers at the door with a camera.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "You came all the way from Lisbon for a bath?", "name": "KENJI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "For you.", "name": "LUCIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "That's the worst line I've ever heard.", "name": "KENJI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "It's the truest.", "name": "LUCIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "She reaches him.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "He wipes his glasses.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "She takes them.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Holds them up to the lantern.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "He squints at her.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Sake?", "name": "MRS. TANABE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Yes, please.", "name": "KENJI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Obrigada.", "name": "LUCIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "He talks about you in his sleep.", "name": "MRS. TANABE", "speaker": 2, "ext": [], "paren": ["sets the tray down"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Mrs. Tanabe!", "name": "KENJI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "In which language?", "name": "LUCIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Bad Portuguese.", "name": "MRS. TANABE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Lucia and Kenji laugh together.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Their shoulders touch.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Neither moves away.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Say cheese!", "name": "DESMOND", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "He lifts the camera.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "The flash pops.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Lucia yelps.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Kenji flinches.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Both slip and splash into the pool.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Mrs. Tanabe sighs and takes the camera from Desmond.", "para": 5, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Sorry! Sorry!", "name": "DESMOND", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Out. Now.", "name": "MRS. TANABE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "He leaves, bowing.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Steam closes behind him.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Kenji surfaces, spluttering.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Lucia surfaces beside him, hair loose, laughing.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "They look at each other for a long moment.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Mrs. Tanabe turns and shuffles out, tray in hand, smiling at the floor.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}]}