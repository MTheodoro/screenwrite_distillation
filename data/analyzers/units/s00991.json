"kind": "dialogue", "text": "Please.", "name": "LEONARD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She slams the phone down.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "The bell over the door jingles.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "JUDE (20s, gaunt, duffel bag, hoodie) steps in, shivering.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Mom.", "name": "JUDE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Jude.", "name": "VIVIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "She doesn't move.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "He drops the bag.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I need a place to stay.", "name": "JUDE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "You told me you didn't.", "name": "VIVIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "I know what I said.", "name": "JUDE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "The phone rings again.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Both of them look at it.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Viv? Are you there?", "name": "LEONARD", "speaker": 1, "ext": ["V.O."], "paren": ["muffled, from the receiver on the hook"], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Not now, Leonard.", "name": "VIVIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Is that Dad?", "name": "JUDE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "He's been calling for a week.", "name": "VIVIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Mom, I didn't come here to fight.", "name": "JUDE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "I didn't ask you to.", "name": "VIVIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "I'm just...", "name": "JUDE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "You're just what?", "name": "VIVIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Cold.", "name": "JUDE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "She stares at him.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Then she lifts the counter flap.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Holds it open.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "He crosses to her.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "She wipes his face with her sleeve.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "The phone keeps ringing.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "She lets it.", "para": 6, "sent": 1, "present": [0, 1, 2]}]}