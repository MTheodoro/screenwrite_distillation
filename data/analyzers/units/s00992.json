{"scene_id": "s00992", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00992.fountain", "heading": "EXT. ROOFTOP PIGEON COOP - TENEMENT - EARLY EVENING", "cast": [{"id": 0, "name": "TEODORO", "names": ["TEODORO"], "gender": "m", "first": 5, "spoke": 7}, {"id": 1, "name": "ALMA", "names": ["ALMA"], "gender": "?", "first": 6, "spoke": 5}, {"id": 2, "name": "DARIUS", "names": ["DARIUS"], "gender": "m", "first": 7, "spoke": 7}, {"id": 3, "name": "PIA", "names": ["PIA"], "gender": "?", "first": 8, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ROOFTOP PIGEON COOP - TENEMENT - EARLY EVENING", "present": []}, {"u": 1, "kind": "action", "text": "A tar-paper roof above a ribbon of city streets.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A wire-and-plywood coop leans against a chimney.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The light is slow and orange.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Birds mutter inside.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "TEODORO (70s, flat cap, cardigan, cane) feeds seed through the wire.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "His daughter ALMA (40s, hospital lanyard) leans on the parapet, scrolling her phone.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "His son DARIUS (40s, expensive coat, shoes too clean) stands near the stairwell door, keys in hand.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "His granddaughter PIA (12, puffer jacket) kneels by the coop, tapping the wire.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "No one speaks for a while.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Grandpa, this one is limping.", "name": "PIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "She'll be fine.", "name": "TEODORO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Her foot is bent.", "name": "PIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "It's a bad winter for feet.", "name": "TEODORO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Darius clears his throat.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Dad, the realtor is coming at six.", "name": "DARIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "It's still five-thirty.", "name": "TEODORO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "I'm just saying.", "name": "DARIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "You're always just saying.", "name": "ALMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Alma.", "name": "DARIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Don't.", "name": "ALMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Hush, hush. Both of you.", "name": "TEODORO", "speaker": 0, "ext": [], "paren": ["to the birds"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "He lets the seed fall.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Pia scoops a pigeon into her hands and offers it to him.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Can I take this one home?", "name": "PIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "No.", "name": "DARIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Yes.", "name": "ALMA", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "They look at each other.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Let her.", "name": "TEODORO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Dad, it's a rooftop pigeon. It has diseases.", "name": "DARIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "It has a name. Her name is Rosario.", "name": "TEODORO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Mama named her.", "name": "ALMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Teodoro turns away.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Fusses with the latch.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "His shoulders shake once.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Darius takes off his coat.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Drapes it on the old man.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Teodoro does not thank him.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "He pulls the collar tight and keeps his back turned.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "I'll tell the realtor tomorrow.", "name": "DARIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Thank you.", "name": "ALMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Don't thank me. I haven't decided.", "name": "DARIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Pia opens the coop door.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "A dozen birds burst out and wheel into the sunset.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Teodoro watches them go, mouth working silently.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Alma moves to his side.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Darius steps in on the other.", "para": 8, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "The three of them watch the sky.", "para": 8, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Grandpa, which one is Rosario?", "name": "PIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "The one coming back.", "name": "TEODORO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "A gray bird banks, folds her wings, and lands on his shoulder.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}]}