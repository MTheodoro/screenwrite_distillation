para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "The pistol fires into the ceiling.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Sparks rain.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Maren and Jin dive behind the belt.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Karlos tackles Dubois.", "para": 4, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "They crash onto the conveyor, rolling together toward a chute.", "para": 4, "sent": 6, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Tibbs hits the emergency stop.", "para": 4, "sent": 7, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Everything goes silent.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "The gun skids across the floor.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "All five look at it.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}]}