{"scene_id": "s00993", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00993.fountain", "heading": "INT. MAIL SORTING DEPOT - 3 A.M.", "cast": [{"id": 0, "name": "KARLOS", "names": ["KARLOS"], "gender": "?", "first": 5, "spoke": 3}, {"id": 1, "name": "JIN", "names": ["JIN"], "gender": "?", "first": 6, "spoke": 1}, {"id": 2, "name": "MAREN", "names": ["MAREN"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "DUBOIS", "names": ["DUBOIS"], "gender": "?", "first": 8, "spoke": 4}, {"id": 4, "name": "OLD TIBBS", "names": ["OLD TIBBS"], "gender": "?", "first": 9, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. MAIL SORTING DEPOT - 3 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "Conveyor belts hum.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Parcels tumble down chutes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Fluorescent light.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "No windows.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "KARLOS (40s, supervisor, name tag) stands at a console.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "JIN (20s, forklift jacket) waits by a crate.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "MAREN (30s, uniform, ID lanyard) scans labels.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "DUBOIS (50s, suit, no tie) paces along the belt.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "OLD TIBBS (70s, janitor, mop bucket) wrings a rag.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Parcel 0447. It's due out at dawn.", "name": "KARLOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Open it.", "name": "DUBOIS", "