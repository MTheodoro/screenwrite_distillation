{"scene_id": "s00994", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00994.fountain", "heading": "INT. PARIS CATACOMBS - OSSUARY CHAMBER, 1793", "cast": [{"id": 0, "name": "CITIZEN AUGUSTIN", "names": ["CITIZEN AUGUSTIN", "AUGUSTIN"], "gender": "?", "first": 4, "spoke": 14}, {"id": 1, "name": "CELESTINE", "names": ["CELESTINE"], "gender": "f", "first": 11, "spoke": 13}], "units": [{"u": 0, "kind": "heading", "text": "INT. PARIS CATACOMBS - OSSUARY CHAMBER, 1793", "present": []}, {"u": 1, "kind": "action", "text": "Walls of stacked skulls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single torch.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Water drips from the vaulted ceiling.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CITIZEN AUGUSTIN (40s, revolutionary sash, unpowdered hair, stiff with fear) stands alone at a stone table, copying names into a ledger.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He mutters as he writes.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "dialogue", "text": "Lef\u00e8vre. Marchand. Girard.", "name": "AUGUSTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 7, "kind": "action", "text": "A footstep echoes.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "He freezes.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "Slowly closes the ledger.", "para": 2, "sent": 2, "present": [0]}, {"u": 10, "kind": "dialogue", "text": "Who goes there?", "name": "AUGUSTIN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 11, "kind": "action", "text": "CELESTINE (30s, cloaked, hood up, a lantern shielded under her arm) steps out from behind a pillar of bones.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "A friend of the dead.", "name": "CELESTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "There are no friends in the Republic.", "name": "AUGUSTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Then I am no friend. Only a sister.", "name": "CELESTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Whose sister?", "name": "AUGUSTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "The one you have on that list.", "name": "CELESTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He glances at the ledger.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She comes closer.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "The light catches her face.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "You should not be down here.", "name": "AUGUSTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Neither should you.", "name": "CELESTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "I am an officer of the Committee.", "name": "AUGUSTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "You are a clerk with a candle.", "name": "CELESTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Madame...", "name": "AUGUSTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Citizen. Celestine Duval.", "name": "CELESTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Citizen Duval, I could have you arrested.", "name": "AUGUSTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Then do it. Call the guards. They are above, drinking wine from your cellar.", "name": "CELESTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "He says nothing.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Wipes his palms on his coat.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "My brother's name is on that page. Pierre Duval.", "name": "CELESTINE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "I do not control the lists.", "name": "AUGUSTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "You hold the pen.", "name": "CELESTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "The pen obeys.", "name": "AUGUSTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "So does the guillotine. Until someone stops it.", "name": "CELESTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Water drips.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "He opens the ledger.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Finds the page.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Looks at her.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Looks at the page.", "para": 6, "sent": 4, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Pierre Duval. Printer.", "name": "AUGUSTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Yes.", "name": "CELESTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Condemned for a pamphlet.", "name": "AUGUSTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "For an opinion.", "name": "CELESTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "He tears the page out.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "Folds it.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Hands it to her.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "There is a carriage at the Barri\u00e8re d'Enfer at midnight.", "name": "AUGUSTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Why?", "name": "CELESTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Because I am tired of counting skulls.", "name": "AUGUSTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}