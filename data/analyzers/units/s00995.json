{"scene_id": "s00995", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00995.fountain", "heading": "INT. STRIKE-N-SPARE BOWLING ALLEY - THANKSGIVING EVE", "cast": [{"id": 0, "name": "GRANDPA WALTER", "names": ["GRANDPA WALTER"], "gender": "?", "first": 6, "spoke": 5}, {"id": 1, "name": "DOROTHEA", "names": ["DOROTHEA"], "gender": "?", "first": 7, "spoke": 11}, {"id": 2, "name": "HAL", "names": ["HAL"], "gender": "?", "first": 8, "spoke": 6}, {"id": 3, "name": "LINUS", "names": ["LINUS"], "gender": "m", "first": 9, "spoke": 3}, {"id": 4, "name": "SUNNY", "names": ["SUNNY"], "gender": "?", "first": 10, "spoke": 2}, {"id": 5, "name": "IMOGEN", "names": ["IMOGEN"], "gender": "f", "first": 11, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. STRIKE-N-SPARE BOWLING ALLEY - THANKSGIVING EVE", "present": []}, {"u": 1, "kind": "action", "text": "Lane 7 has been turned into a dinner table.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Paper turkeys.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Folding chairs.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Ball returns hold gravy boats.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A neon pin flashes overhead.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "GRANDPA WALTER (80s, bowling shirt, thick glasses) sits at the head, carving.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "DOROTHEA (50s, pearls, tight smile) sets plates.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "HAL (50s, gravy-stained tie) fiddles with a ball polisher.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "LINUS (teen, headphones) slouches.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "SUNNY (8, pigtails, tiny bowling shoes) crawls under the table.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "IMOGEN (30s, tote bag, tired eyes) arrives late, pulling off a scarf.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Imogen, you said six.", "name": "DOROTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "It's six-oh-four.", "name": "IMOGEN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Grandpa has been carving for forty minutes.", "name": "DOROTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "I like carving.", "name": "GRANDPA WALTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "That's not what you said about the turkey last year.", "name": "HAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Last year the turkey was dry.", "name": "GRANDPA WALTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "It was not dry.", "name": "DOROTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "It was a little dry, Dot.", "name": "HAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Hal!", "name": "DOROTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Can I eat in the car?", "name": "LINUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "No.", "name": "DOROTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Can I eat on the lane?", "name": "LINUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "It's literally on the lane, Linus.", "name": "HAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Aunt Imogen, you have a hole in your sock.", "name": "SUNNY", "speaker": 4, "ext": [], "paren": ["from under the table"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Thank you, Sunny.", "name": "IMOGEN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Can we all sit, please?", "name": "DOROTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Sit. Eat. Say grace.", "name": "GRANDPA WALTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Who's saying grace?", "name": "HAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Imogen, you say it.", "name": "DOROTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Me?", "name": "IMOGEN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "You're the one who left.", "name": "DOROTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Silence.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "The pin on the ceiling flashes.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Linus pulls off his headphones.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "That was unkind, Dorothea.", "name": "IMOGEN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "It was accurate.", "name": "DOROTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Dot, let's not.", "name": "HAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Nobody asked you, Harold.", "name": "DOROTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Girls, girls.", "name": "GRANDPA WALTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "We're not girls, Grandpa.", "name": "IMOGEN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Speak for yourself.", "name": "DOROTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "Can I have pie?", "name": "SUNNY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Nobody has pie, Sunny. We're in a war.", "name": "LINUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Dorothea slams the gravy boat on the table.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Gravy leaps.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "It lands on Hal's tie.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "He stares at it.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "Well, that's the last straw.", "name": "HAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "He stands.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Flings a ball from the return.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "It rolls down Lane 7, scattering the cranberry and three chairs.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "Strike.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "Everyone stares at the pins.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "Then at Grandpa Walter.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "He sets down the knife.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "Nice.", "name": "GRANDPA WALTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "Linus snickers.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "Sunny giggles.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "action", "text": "Imogen covers her mouth.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "Dorothea tries to stay stern and fails.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "Hal bows.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}]}