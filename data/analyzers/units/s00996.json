{"scene_id": "s00996", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00996.fountain", "heading": "INT. BONE-WHITE SALOON - WHALE RIB BUILDING - NOON", "cast": [{"id": 0, "name": "MARSHAL TEAGUE", "names": ["MARSHAL TEAGUE", "TEAGUE"], "gender": "m", "first": 5, "spoke": 6}, {"id": 1, "name": "OTTILIE", "names": ["OTTILIE"], "gender": "f", "first": 6, "spoke": 3}, {"id": 2, "name": "LEFTY", "names": ["LEFTY"], "gender": "?", "first": 7, "spoke": 5}, {"id": 3, "name": "DEPUTY NASH", "names": ["DEPUTY NASH", "NASH"], "gender": "?", "first": 8, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. BONE-WHITE SALOON - WHALE RIB BUILDING - NOON", "present": []}, {"u": 1, "kind": "action", "text": "A saloon framed by the ribs of an enormous skeleton.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sunlight through bone.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Sawdust.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A faded mural of a harpooner.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MARSHAL TEAGUE (50s, tin star, sun-cracked skin) stands at the bar.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "OTTILIE (40s, apron, flour on her sleeves) pours coffee.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "LEFTY (30s, left hand missing, grin) sits at a corner table.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "DEPUTY NASH (20s, pressed shirt, jittery) watches the door.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Ottilie, who's the stranger who came in at dawn?", "name": "TEAGUE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Said his name was Smith.", "name": "OTTILIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Everybody's name is Smith.", "name": "TEAGUE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Not mine.", "name": "LEFTY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Yours is trouble, Lefty.", "name": "TEAGUE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "That's my middle name.", "name": "LEFTY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Marshal, he's across the street.", "name": "NASH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Then let him stay there.", "name": "TEAGUE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "He's got a rifle.", "name": "NASH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "They all have rifles.", "name": "OTTILIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Don't look so scared, Deputy. He's more scared than you.", "name": "LEFTY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "How do you know?", "name": "NASH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "He's still sitting.", "name": "LEFTY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Teague sets his cup down.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "He draws his pistol, checks the chamber, holsters it.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Nash swallows.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Ottilie wipes her hands.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Everyone down.", "name": "TEAGUE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "They duck behind the bar.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "A shot cracks through the window and kills the mirror.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Glass rains.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Lefty whoops.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Teague rises, fires once out the window.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "A body drops outside.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Did you...", "name": "NASH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Wasn't him. That was his horse.", "name": "TEAGUE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Oh, Lord.", "name": "OTTILIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "That's gonna be a long walk home.", "name": "LEFTY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}