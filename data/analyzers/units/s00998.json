{"scene_id": "s00998", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00998.fountain", "heading": "INT. ICE-FISHING HUT - NIGHT", "cast": [{"id": 0, "name": "GRETA", "names": ["GRETA"], "gender": "f", "first": 8, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. ICE-FISHING HUT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Plywood walls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A hole in the floor, black water, the surface skinned with ice.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A propane lantern hisses.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A tape recorder sits on a stool.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The wind outside sounds like a throat.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "The door shudders, bangs, opens.", "para": 1, "sent": 0, "present": []}, {"u": 7, "kind": "action", "text": "Snow swirls in.", "para": 1, "sent": 1, "present": []}, {"u": 8, "kind": "action", "text": "GRETA (30s, parka caked white, ski mask pushed up, red-rimmed eyes) staggers inside, drags the door shut, and slides the bolt.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "She drops her pack.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "Rips off her gloves.", "para": 2, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "The lantern flickers as if breathing in her fear.", "para": 2, "sent": 3, "present": [0]}, {"u": 12, "kind": "action", "text": "She flips the tape recorder.", "para": 3, "sent": 0, "present": [0]}, {"u": 13, "kind": "action", "text": "The reel turns.", "para": 3, "sent": 1, "present": [0]}, {"u": 14, "kind": "action", "text": "A voice crackles.", "para": 3, "sent": 2, "present": [0]}, {"u": 15, "kind": "dialogue", "text": "Day three. Hut one. Everything is fine. I'm fine.", "name": "GRETA", "speaker": 0, "ext": ["V.O."], "paren": ["recorded, bright"], "dual": false, "present": [0]}, {"u": 16, "kind": "action", "text": "She slams the stop button.", "para": 4, "sent": 0, "present": [0]}, {"u": 17, "kind": "action", "text": "Presses her back against the wall.", "para": 4, "sent": 1, "present": [0]}, {"u": 18, "kind": "action", "text": "Listens.", "para": 4, "sent": 2, "present": [0]}, {"u": 19, "kind": "action", "text": "Wind rattles the tin chimney.", "para": 4, "sent": 3, "present": [0]}, {"u": 20, "kind": "action", "text": "Something scrapes across the roof, slow as a fingernail.", "para": 4, "sent": 4, "present": [0]}, {"u": 21, "kind": "action", "text": "Greta slides her knife from her boot and holds it level.", "para": 4, "sent": 5, "present": [0]}, {"u": 22, "kind": "action", "text": "The scraping moves down the wall, around the corner, to the door.", "para": 4, "sent": 6, "present": [0]}, {"u": 23, "kind": "action", "text": "The bolt trembles in its bracket.", "para": 4, "sent": 7, "present": [0]}, {"u": 24, "kind": "action", "text": "The lantern gutters low.", "para": 4, "sent": 8, "present": [0]}, {"u": 25, "kind": "action", "text": "She lifts the knife.", "para": 4, "sent": 9, "present": [0]}, {"u": 26, "kind": "action", "text": "The hole in the floor bubbles, a single fat bubble, and bursts.", "para": 4, "sent": 10, "present": [0]}, {"u": 27, "kind": "dialogue", "text": "I'm fine.", "name": "GRETA", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0]}, {"u": 28, "kind": "action", "text": "The door handle turns.", "para": 5, "sent": 0, "present": [0]}, {"u": 29, "kind": "action", "text": "Slowly.", "para": 5, "sent": 1, "present": [0]}, {"u": 30, "kind": "action", "text": "Once.", "para": 5, "sent": 2, "present": [0]}, {"u": 31, "kind": "action", "text": "Twice.", "para": 5, "sent": 3, "present": [0]}, {"u": 32, "kind": "action", "text": "Then the whole hut lurches as if shouldered, and the lantern swings, throwing a long shadow across the ceiling.", "para": 5, "sent": 4, "present": [0]}, {"u": 33, "kind": "action", "text": "The knife trembles in her fist.", "para": 5, "sent": 5, "present": [0]}, {"u": 34, "kind": "action", "text": "She cuts the lantern's gas with her other hand, and darkness takes the room.", "para": 5, "sent": 6, "present": [0]}, {"u": 35, "kind": "action", "text": "In the dark, the tape recorder clicks on by itself.", "para": 6, "sent": 0, "present": [0]}, {"u": 36, "kind": "dialogue", "text": "Don't open the door.", "name": "GRETA", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": ["recorded, calm"], "dual": false, "present": [0]}, {"u": 37, "kind": "dialogue", "text": "I didn't!", "name": "GRETA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 38, "kind": "action", "text": "The bolt slides back on its own.", "para": 7, "sent": 0, "present": [0]}]}