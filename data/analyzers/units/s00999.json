{"scene_id": "s00999", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s00999.fountain", "heading": "INT. TRAIN CAR FIELD HOSPITAL - NIGHT", "cast": [{"id": 0, "name": "IYER", "names": ["IYER"], "gender": "f", "first": 7, "spoke": 19}, {"id": 1, "name": "LUDMILLA", "names": ["LUDMILLA"], "gender": "f", "first": 8, "spoke": 17}], "units": [{"u": 0, "kind": "heading", "text": "INT. TRAIN CAR FIELD HOSPITAL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A converted freight car rolling through mountains.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cots bolted to the walls.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Lanterns on hooks.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A surgical table at the center, bolted to the floor.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Rain hammers the roof.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "Every few seconds the wheels shriek over a joint.", "para": 0, "sent": 5, "present": []}, {"u": 7, "kind": "action", "text": "DR. IYER (40s, surgeon, cap, apron already stained) stands at the table, sleeves rolled.", "para": 1, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "LUDMILLA (30s, a patient strapped to the table, face gray with pain, a bloody dressing across her abdomen) stares at the ceiling.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Ludmilla, I need you to stay with me.", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I am here.", "name": "LUDMILLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Count backwards from ten.", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Ten. Nine.", "name": "LUDMILLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Good.", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He lays out instruments on a tray.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "A forceps clatters to the floor.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He picks it up, wipes it with a rag, and sets it back.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "His hands shake only slightly.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Doctor. Your hands.", "name": "LUDMILLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "They always do before.", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Do they stop?", "name": "LUDMILLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "When the knife starts.", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "She smiles weakly.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "The train lurches.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "The tray slides.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Iyer catches it with one hand and steadies her shoulder with the other.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Eight?", "name": "IYER", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Eight.", "name": "LUDMILLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "He pours antiseptic over the wound.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "She hisses through her teeth, her fingers digging into the table's edge.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "He talks fast and low, never looking up, laying gauze, clamping a bleeder, pressing a pad flat with the heel of his palm while she shudders and clenches her jaw and the lantern swings over both of them.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Seven.", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Seven. Seven.", "name": "LUDMILLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Stay with me.", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Doctor, there is something you must know.", "name": "LUDMILLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Later.", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "I am not what I told you.", "name": "LUDMILLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Ludmilla.", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "The papers in my coat. They are false.", "name": "LUDMILLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "He doesn't answer.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Cuts.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "She gasps.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Blood pools.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "He suctions it with a rubber bulb, swabs, clamps again.", "para": 5, "sent": 4, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Six.", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "I am a courier. For the partisans.", "name": "LUDMILLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Five. Keep counting.", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "There is a name in the lining. Memorize it.", "name": "LUDMILLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "I am busy.", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Please.", "name": "LUDMILLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "He glances at her coat, hanging on the wall hook.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "Then back at her.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "She is crying now, silently, tears running into her ears.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "What is the name?", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "Commander Alder. Station nine.", "name": "LUDMILLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "Alder. Station nine.", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "Say it again.", "name": "LUDMILLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "Alder. Station nine. Four.", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "Four.", "name": "LUDMILLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "The wheels shriek.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "A flash of lightning lights the car white.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "For a moment the lantern, the table, the two of them are frozen like a photograph.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "Three.", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "Three... two...", "name": "LUDMILLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "Her voice fades.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "Her eyes flutter.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "He pushes a final suture through, ties it, and cuts the thread.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "One.", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "She doesn't answer.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "He presses two fingers to her neck.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 70, "kind": "action", "text": "Waits.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "Her chest rises.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "Falls.", "para": 9, "sent": 4, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "Rises.", "para": 9, "sent": 5, "present": [0, 1]}, {"u": 74, "kind": "action", "text": "He sags against the table.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 75, "kind": "action", "text": "Tears off his gloves.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 76, "kind": "action", "text": "Looks at her coat on the hook.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 77, "kind": "action", "text": "Then, with the care of a man who has decided something, he crosses the car, lifts the hem, and finds the lining.", "para": 10, "sent": 3, "present": [0, 1]}, {"u": 78, "kind": "action", "text": "Behind him, Ludmilla opens one eye.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 79, "kind": "dialogue", "text": "You were supposed to forget.", "name": "LUDMILLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 80, "kind": "dialogue", "text": "I never forget a name.", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}