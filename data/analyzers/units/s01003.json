{"scene_id": "s01003", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01003.fountain", "heading": "INT. FLOODED CHAPEL CRYPT - NIGHT", "cast": [{"id": 0, "name": "HARLAN", "names": ["HARLAN"], "gender": "?", "first": 6, "spoke": 8}, {"id": 1, "name": "PENNY", "names": ["PENNY"], "gender": "m", "first": 7, "spoke": 7}, {"id": 2, "name": "NOLA", "names": ["NOLA"], "gender": "?", "first": 8, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. FLOODED CHAPEL CRYPT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Ankle-deep black water.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Stone arches.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Lanterns on ropes.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Names of the dead carved on every column.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Something drips, then something larger drips.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "HARLAN (50s, woolen coat, reading glasses) steadies a lantern.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "PENNY (30s, hiking boots, camera bag) wades behind him.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "NOLA (20s, white nightgown under a borrowed jacket, bare feet) clings to the pillar.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Everyone stay together.", "name": "HARLAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Harlan, we are together. There are three of us.", "name": "PENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Four.", "name": "NOLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "What?", "name": "HARLAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "There were four when we came down.", "name": "NOLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Nola, honey, count again.", "name": "PENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "One, two, three...", "name": "NOLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Don't.", "name": "HARLAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Let her.", "name": "PENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Four.", "name": "NOLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Harlan raises the lantern.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "The crypt stretches out, silent.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Shadows lengthen between the columns.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Just the damp. Just the damp.", "name": "HARLAN", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Who are you talking to?", "name": "PENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Myself.", "name": "HARLAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "He's talking to it.", "name": "NOLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Nola!", "name": "PENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "It's listening.", "name": "NOLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "The water ripples.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Not from their legs.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "From the far end of the crypt, a slow wake spreads toward them.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Everyone back to the stairs. Now.", "name": "HARLAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Which way is that?", "name": "PENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Behind you.", "name": "NOLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Penny turns.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "The stairs are gone.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Only wall, and in the wall a carved name that was not there a minute ago.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Oh my God. That's my name.", "name": "PENNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "That's impossible.", "name": "HARLAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "It's the fourth.", "name": "NOLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Count the lanterns. Count the lanterns.", "name": "HARLAN", "speaker": 0, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "The lanterns, one by one, go out.", "para": 5, "sent": 0, "present": [0, 1, 2]}]}