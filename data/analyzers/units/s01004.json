{"scene_id": "s01004", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01004.fountain", "heading": "INT. PUBLIC LIBRARY - BOOK RETURNS ROOM - NIGHT", "cast": [{"id": 0, "name": "LEOPOLD", "names": ["LEOPOLD"], "gender": "m", "first": 6, "spoke": 11}, {"id": 1, "name": "WINIFRED", "names": ["WINIFRED"], "gender": "f", "first": 7, "spoke": 13}, {"id": 2, "name": "STRANGER", "names": ["STRANGER"], "gender": "m", "first": 28, "spoke": 4}, {"id": 3, "name": "CASPIAN", "names": ["CASPIAN"], "gender": "?", "first": 37, "spoke": 4}, {"id": 4, "name": "AGNES", "names": ["AGNES"], "gender": "?", "first": 47, "spoke": 5}, {"id": 5, "name": "MURIEL", "names": ["MURIEL"], "gender": "?", "first": 62, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. PUBLIC LIBRARY - BOOK RETURNS ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A back room behind the circulation desk.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Steel carts piled with returned books.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A conveyor belt chugs.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A radiator ticks.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The overhead light has a moth in it.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "LEOPOLD (60s, cardigan, lanyard) shelves a cart, humming a waltz.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "WINIFRED (60s, volunteer vest, library-card earrings) peels stickers from paperbacks at a table.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Neither looks up when the book-drop chute rattles and a thick novel thumps into the bin.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "That's the Dostoevsky again.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Fourth time this month.", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Somebody's reading it very slowly.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Somebody's very patient.", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Or in love.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "With a Russian?", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Leopold, it happens.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He laughs, shakes his head.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "The chute rattles again.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "A paperback with a cracked spine tumbles out.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Winifred flips it open.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Something slides from the pages: a folded note.", "para": 2, "sent": 4, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Oh.", "name": "WINIFRED", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "What?", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "\"Same time next Tuesday?\"", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Is it signed?", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "It says \"C.\"", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Well, C will have to wait.", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "The back door squeaks.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "A STRANGER (30s, long coat, scarf wound to his chin, rain on his hair) leans in, hesitating.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Pardon me. I'm sorry. Is this where you leave things?", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "The main desk closed at nine.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "I wasn't looking for the desk.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Are you looking for a book, young man?", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "I'm looking for a note.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Winifred clutches the paper to her chest.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Leopold tucks his hands behind his back.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "The stranger smiles, and it changes his whole face.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "My name is Caspian. I leave one in this one every Tuesday.", "name": "STRANGER", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "For whom?", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "For whoever finds it.", "name": "CASPIAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "That seems unwise.", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "It's led to some very good conversations.", "name": "CASPIAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Leopold, he's the C.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "I gathered.", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "The chute rattles one more time.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "A woman's voice floats down the shaft, laughing: \"Caspian?", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Are you down there?\"", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "A pair of shoes appears at the lip of the opening, then a pair of legs, and AGNES (30s, red umbrella, wet laughing eyes) squeezes through and drops to the floor with a grunt.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "I told you the chute was big enough.", "name": "AGNES", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "It's a book drop, Agnes.", "name": "CASPIAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "It was a very comfortable book drop.", "name": "AGNES", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "She notices the two older people.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Straightens her coat.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Holds out a hand.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "Good evening. I'm so sorry about the intrusion.", "name": "AGNES", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "Not at all.", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "It's been a slow night.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "We'll just collect his note and be going.", "name": "AGNES", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "Of course.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "She hands over the paper.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "Caspian takes it, unfolds it, reads it, and offers it to Agnes.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "She laughs, kisses his cheek, and tucks it into her pocket.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "A third figure appears at the door, MURIEL (70s, librarian's brooch, stern as a verdict).", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "The two lovers freeze.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "Leopold and Winifred straighten up.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "dialogue", "text": "It is eleven o'clock. This room is closed.", "name": "MURIEL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "dialogue", "text": "We were just leaving.", "name": "CASPIAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "dialogue", "text": "By the door. Not the chute.", "name": "MURIEL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "dialogue", "text": "Yes, ma'am.", "name": "AGNES", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "action", "text": "They file out.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "action", "text": "Muriel watches them go.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "action", "text": "When they are gone, she looks at the note-less table, at Winifred's guilty face, at Leopold's studied innocence.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "dialogue", "text": "Which of you encouraged them?", "name": "MURIEL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "dialogue", "text": "I shelve. I don't encourage.", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "dialogue", "text": "Neither do I.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 75, "kind": "action", "text": "Muriel nods.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 76, "kind": "action", "text": "Picks up the Dostoevsky.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 77, "kind": "action", "text": "Opens it.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 78, "kind": "action", "text": "Takes out a second note.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 79, "kind": "action", "text": "Reads it.", "para": 10, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 80, "kind": "action", "text": "Her lips twitch.", "para": 10, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 81, "kind": "dialogue", "text": "Next Tuesday, then.", "name": "MURIEL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}