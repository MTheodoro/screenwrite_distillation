{"scene_id": "s01005", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01005.fountain", "heading": "INT. VICTORIAN CONSERVATORY - NIGHT", "cast": [{"id": 0, "name": "CRABTREE", "names": ["CRABTREE", "MRS. CRABTREE"], "gender": "f", "first": 4, "spoke": 9}, {"id": 1, "name": "THADDEUS", "names": ["THADDEUS"], "gender": "?", "first": 5, "spoke": 3}, {"id": 2, "name": "PHOEBE", "names": ["PHOEBE"], "gender": "f", "first": 6, "spoke": 4}, {"id": 3, "name": "CAPTAIN LOWRY", "names": ["CAPTAIN LOWRY"], "gender": "m", "first": 7, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. VICTORIAN CONSERVATORY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A glass hothouse thick with tropical ferns, weeping under a gaslit chandelier.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "In its center, a round table draped in black velvet and ringed with four chairs.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The air tastes of orchids and old rain.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MRS. CRABTREE (60s, widow's weeds, a face like a locked door) presides at the head of the table.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "THADDEUS (30s, frock coat, spectacles, a pamphlet on spiritualism rolled in his fist) sits at her right.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "PHOEBE (20s, white lace, pale as milk, hands folded) sits at her left.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "CAPTAIN LOWRY (50s, red-faced, medals on his tunic, arms folded in contempt) sits opposite.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Join hands. And do try to behave, Captain.", "name": "MRS. CRABTREE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "I am the soul of decorum, madam.", "name": "CAPTAIN LOWRY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Is it true they come when called?", "name": "PHOEBE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Only if they have unfinished business.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Then they'll be here by the dozen. The dead always have unfinished business.", "name": "CAPTAIN LOWRY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Silence.", "name": "MRS. CRABTREE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "They clasp hands.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "The chandelier dims.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "The ferns sway though no wind moves.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Somewhere in the glass, a pane creaks.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Spirits of this house, we call upon you. If you are present, give us a sign.", "name": "MRS. CRABTREE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "A silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "A drip.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Another.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Nothing.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Of course nothing.", "name": "CAPTAIN LOWRY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Hush. Listen.", "name": "PHOEBE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "We call upon Edmund Crabtree, my beloved husband.", "name": "MRS. CRABTREE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Your late husband was a bore, madam, and I say that as one who attended his funeral.", "name": "CAPTAIN LOWRY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Captain, I will have you removed.", "name": "MRS. CRABTREE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "By whom?", "name": "CAPTAIN LOWRY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "A tap on the table.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "A second.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "A third.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "The four of them freeze.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "The candle flames bend flat.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "The temperature drops; their breath fogs.", "para": 4, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Who is it?", "name": "PHOEBE", "speaker": 2, "ext": [], "paren": ["barely audible"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "The table lifts an inch.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Settles.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Lifts again.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Thaddeus lets go of the hands to steady it, and Mrs. Crabtree slaps him across the knuckles.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Do not break the circle!", "name": "MRS. CRABTREE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "It's moving!", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "It's a trick, madam. It's always a trick.", "name": "CAPTAIN LOWRY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "A voice, wheezing, not any of theirs, slithers from beneath the velvet.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Hortensia...", "name": "CAPTAIN LOWRY", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Edmund?", "name": "MRS. CRABTREE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Phoebe screams.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Thaddeus leaps back.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Mrs. Crabtree sits perfectly rigid, her face as pale as the lace on Phoebe's collar.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Then the velvet lifts, and the Captain, still seated, lets the cloth fall from his lap.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "His boot withdraws from the table's leg.", "para": 7, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "He coughs into his fist, and the wheeze is plainly his own.", "para": 7, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "That was you!", "name": "PHOEBE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "A bit of fun, miss.", "name": "CAPTAIN LOWRY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Mrs. Crabtree rises to her full height.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Captain Lowry. You are no longer welcome in my home.", "name": "MRS. CRABTREE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "It was only a joke.", "name": "CAPTAIN LOWRY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "So was Edmund.", "name": "MRS. CRABTREE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}