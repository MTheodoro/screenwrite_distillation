{"scene_id": "s01007", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01007.fountain", "heading": "INT. ABANDONED PLANETARIUM - NIGHT", "cast": [{"id": 0, "name": "ALOYSIUS", "names": ["ALOYSIUS"], "gender": "m", "first": 5, "spoke": 5}, {"id": 1, "name": "BRYONY", "names": ["BRYONY"], "gender": "?", "first": 6, "spoke": 2}, {"id": 2, "name": "CASSIUS", "names": ["CASSIUS"], "gender": "?", "first": 7, "spoke": 1}, {"id": 3, "name": "DELPHINE", "names": ["DELPHINE"], "gender": "f", "first": 8, "spoke": 2}, {"id": 4, "name": "EZRA", "names": ["EZRA"], "gender": "m", "first": 9, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED PLANETARIUM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A domed theater gone to ruin.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of broken chairs fan toward a hulking star projector.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Moonlight slips through a crack in the dome.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Dust drifts like constellations.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ALOYSIUS (60s, caretaker's coat, keys on his belt) leads the way with a flashlight.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "BRYONY (30s, journalist, notebook) follows.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "CASSIUS (20s, her photographer, three cameras round his neck) hangs back.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "DELPHINE (40s, astronomer, a thick scarf) runs a hand along the projector.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "EZRA (teen, hoodie, headphones, the caretaker's grandson) sits in the front row with his feet on the seat in front.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "The last show was in eighty-nine. They forgot to turn the stars off.", "name": "ALOYSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Forgot?", "name": "BRYONY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Or didn't want to.", "name": "ALOYSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "I can't see anything.", "name": "CASSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "That's the point.", "name": "DELPHINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "She flips a switch on the projector.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Nothing.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Another.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "A hum builds.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "The dome shudders.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "A smear of light climbs the plaster.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "It's just the old bulb.", "name": "EZRA", "speaker": 4, "ext": [], "paren": ["without looking up"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "It's the stars.", "name": "ALOYSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "The light resolves into a tangle of pinpoints, swirling in the wrong places.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Delphine tilts her head, frowning.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "The constellations are wrong.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Orion is facing the wrong way, and a seventh star burns where there should be six.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Is that supposed to happen?", "name": "BRYONY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "No.", "name": "DELPHINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "The seventh star pulses.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Cassius lifts a camera and the flash blinds them.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "When their eyes recover, Ezra is standing in the aisle, staring up, headphones around his neck, mouth slightly open.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Ezra.", "name": "ALOYSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "It knows my name.", "name": "EZRA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "What did you say?", "name": "ALOYSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "It's whispering.", "name": "EZRA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Delphine rushes to the projector and kills the power.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "The dome goes black.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "A single hiss ripples through the room, and then nothing.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "In the dark, Cassius's camera clicks once on its own.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}]}