{"scene_id": "s01009", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01009.fountain", "heading": "INT. HIGH SCHOOL ROOFTOP GREENHOUSE - DAWN", "cast": [{"id": 0, "name": "TESSA", "names": ["TESSA"], "gender": "?", "first": 8, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. HIGH SCHOOL ROOFTOP GREENHOUSE - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A glass lean-to bolted to the school's flat roof.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Trays of tomato seedlings under grow-lights.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Condensation beads the panes.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A broken radio sits unplugged on a workbench.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Nobody is here yet.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "A key rattles in the lock.", "para": 1, "sent": 0, "present": []}, {"u": 7, "kind": "action", "text": "The door swings open.", "para": 1, "sent": 1, "present": []}, {"u": 8, "kind": "action", "text": "TESSA (17, thrift-store coat, messy braid, a backpack heavy with textbooks) steps in, shoulders hunched, and shuts out the wind.", "para": 1, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "She drops her bag.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "Cups her hands and breathes into them.", "para": 2, "sent": 1, "present": [0]}, {"u": 11, "kind": "action", "text": "Crosses to the seedlings and touches one leaf, gently, like a held breath.", "para": 2, "sent": 2, "present": [0]}, {"u": 12, "kind": "action", "text": "She pulls out her phone.", "para": 3, "sent": 0, "present": [0]}, {"u": 13, "kind": "action", "text": "Dials.", "para": 3, "sent": 1, "present": [0]}, {"u": 14, "kind": "action", "text": "Puts it to her ear.", "para": 3, "sent": 2, "present": [0]}, {"u": 15, "kind": "action", "text": "It rings once, twice, three times.", "para": 3, "sent": 3, "present": [0]}, {"u": 16, "kind": "action", "text": "Click.", "para": 3, "sent": 4, "present": [0]}, {"u": 17, "kind": "dialogue", "text": "Hi, you've reached Tessa. I'm probably playing outside. Leave a message and I'll call you back!", "name": "TESSA", "speaker": 0, "ext": ["V.O."], "paren": ["recorded, cheerful, younger"], "dual": false, "present": [0]}, {"u": 18, "kind": "action", "text": "She closes her eyes.", "para": 4, "sent": 0, "present": [0]}, {"u": 19, "kind": "action", "text": "Holds the phone away.", "para": 4, "sent": 1, "present": [0]}, {"u": 20, "kind": "action", "text": "Listens to her own voice, tinny and small.", "para": 4, "sent": 2, "present": [0]}, {"u": 21, "kind": "action", "text": "She smiles, then stops smiling.", "para": 4, "sent": 3, "present": [0]}, {"u": 22, "kind": "dialogue", "text": "Four years ago. I was eleven. I thought I'd be famous.", "name": "TESSA", "speaker": 0, "ext": [], "paren": ["to the plants"], "dual": false, "present": [0]}, {"u": 23, "kind": "action", "text": "She hangs up.", "para": 5, "sent": 0, "present": [0]}, {"u": 24, "kind": "action", "text": "Dials again.", "para": 5, "sent": 1, "present": [0]}, {"u": 25, "kind": "action", "text": "The recording plays again.", "para": 5, "sent": 2, "present": [0]}, {"u": 26, "kind": "action", "text": "She doesn't smile this time.", "para": 5, "sent": 3, "present": [0]}, {"u": 27, "kind": "action", "text": "When it ends, she listens to the beep, mouth open, as if there might be something to say, and says nothing.", "para": 5, "sent": 4, "present": [0]}, {"u": 28, "kind": "action", "text": "A sparrow lands on the glass above her.", "para": 6, "sent": 0, "present": [0]}, {"u": 29, "kind": "action", "text": "She looks up.", "para": 6, "sent": 1, "present": [0]}, {"u": 30, "kind": "action", "text": "It sits there, puffed against the cold, watching.", "para": 6, "sent": 2, "present": [0]}, {"u": 31, "kind": "action", "text": "She sets the phone on the bench.", "para": 7, "sent": 0, "present": [0]}, {"u": 32, "kind": "action", "text": "Picks up a watering can.", "para": 7, "sent": 1, "present": [0]}, {"u": 33, "kind": "action", "text": "Fills it at the spigot.", "para": 7, "sent": 2, "present": [0]}, {"u": 34, "kind": "action", "text": "Tilts it over the seedlings.", "para": 7, "sent": 3, "present": [0]}, {"u": 35, "kind": "action", "text": "Water patters in the quiet.", "para": 7, "sent": 4, "present": [0]}, {"u": 36, "kind": "action", "text": "Outside, the first bus shudders into the lot below, and the world beyond the glass begins its ordinary morning.", "para": 7, "sent": 5, "present": [0]}, {"u": 37, "kind": "dialogue", "text": "Okay. Okay. Let's go.", "name": "TESSA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}]}