{"scene_id": "s01010", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01010.fountain", "heading": "INT. GLASSBLOWING STUDIO - LATE AFTERNOON", "cast": [{"id": 0, "name": "ANSELM", "names": ["ANSELM"], "gender": "?", "first": 5, "spoke": 9}, {"id": 1, "name": "MIRABEL", "names": ["MIRABEL"], "gender": "?", "first": 6, "spoke": 7}, {"id": 2, "name": "JOSUE", "names": ["JOSUE"], "gender": "m", "first": 7, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. GLASSBLOWING STUDIO - LATE AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "A long brick workshop.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Three furnaces glow like open mouths.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rods and pipes hang from racks.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Molten orange light plays over the walls and the faces of the three people inside.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ANSELM (50s, leather apron, forearms scarred by a thousand tiny burns) turns a gather of glass at the end of a pipe, patient as a priest.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "MIRABEL (30s, linen shirt rolled to the elbows, hair tied in a green scarf) watches him from the workbench, a sketchbook open on her knee.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "JOSUE (30s, tall, a delivery clipboard, the faint dust of the road on his boots) lingers by the door, hat in hand.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "The trick is not to hurry it.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Everything is a trick with you, Anselm.", "name": "MIRABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Everything is.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Excuse me. I have a delivery for Miss Mirabel Quint.", "name": "JOSUE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "That's me.", "name": "MIRABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She takes the clipboard.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Signs.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Their fingers touch.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Neither pulls away.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Thank you.", "name": "MIRABEL", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "It's from a client in Lisbon. Fragile.", "name": "JOSUE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "They're all fragile.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "This one is a vase.", "name": "JOSUE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "I make vases.", "name": "MIRABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Not like this one, I'm told.", "name": "JOSUE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "She opens the crate.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Lifts out a tall green vase swirled with silver, and holds it to the furnace light.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "A hush falls.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Where did you get that?", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "I didn't. A woman in Lisbon sent it.", "name": "JOSUE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "That's my mother's work.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Your mother?", "name": "MIRABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "She taught me. Before she left.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "You never said she left.", "name": "MIRABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "You never asked.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Josue shifts, uncomfortable.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "He reaches for the door.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "I should go.", "name": "JOSUE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Don't.", "name": "MIRABEL", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Stay. Please. You've brought us a ghost.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "He sets the pipe down.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Mirabel sets the vase on the bench.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "For a long moment the three of them stand in the furnace glow, nobody speaking, and the air itself seems to wait.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Is it a bad ghost?", "name": "JOSUE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "It's a very old one.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Mirabel puts her hand on his arm.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "The vase catches the light, and for an instant it looks like water.", "para": 6, "sent": 1, "present": [0, 1, 2]}]}