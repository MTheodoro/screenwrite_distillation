{"scene_id": "s01011", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01011.fountain", "heading": "INT. ROADSIDE MOTEL LAUNDRY ROOM - NIGHT", "cast": [{"id": 0, "name": "CLERK", "names": ["CLERK"], "gender": "m", "first": 5, "spoke": 6}, {"id": 1, "name": "RHONDA", "names": ["RHONDA"], "gender": "f", "first": 6, "spoke": 3}, {"id": 2, "name": "TRUDY", "names": ["TRUDY"], "gender": "?", "first": 7, "spoke": 4}, {"id": 3, "name": "LAMAR", "names": ["LAMAR"], "gender": "m", "first": 8, "spoke": 3}, {"id": 4, "name": "DALE", "names": ["DALE"], "gender": "?", "first": 35, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROADSIDE MOTEL LAUNDRY ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cinderblock room with six humming dryers and a vending machine that sells nothing.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single bulb, bare, buzzes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A mop bucket stands in a pool of gray water.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The door to the lot is propped open with a brick.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A CLERK (30s, name tag crooked, plastic key ring on his wrist) folds towels at a steel table.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "RHONDA (40s, bathrobe over street clothes, a baby monitor in her hand) sits on a plastic chair watching a dryer spin.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "TRUDY (60s, hair curlers, cardigan buttoned wrong) stares into a washer as it fills.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "LAMAR (20s, hoodie, headphones, a garbage bag of clothes at his feet) leans against the wall.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "The clerk looks up when a dryer buzzes.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Looks at the others.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Looks back at the towels.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "You're not going to fold mine, are you?", "name": "RHONDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "No, ma'am.", "name": "CLERK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Good.", "name": "RHONDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "There's a stain on my sleeve that won't come out.", "name": "TRUDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Which one?", "name": "CLERK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "The red one.", "name": "TRUDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "I don't think that's coming out.", "name": "CLERK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "That's what everyone says.", "name": "TRUDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Lamar pulls off his headphones.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Everyone is looking at the washer.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "The water inside has turned pink.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Is that normal?", "name": "LAMAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "It happens.", "name": "CLERK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "What happens?", "name": "LAMAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Colors bleed.", "name": "CLERK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Rhonda holds the baby monitor to her ear.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "A faint hiss of static.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "She turns the knob.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "The hiss grows, and under it, a slow wet breathing.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Trudy, did you bring a baby?", "name": "RHONDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Of course not.", "name": "TRUDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "The Clerk sets down the towel.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "His eyes drift to the open door, the dark lot, the single car with its engine ticking.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Dale. My name is Dale.", "name": "CLERK", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "What?", "name": "LAMAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "You asked me my name, earlier. I wasn't ready to say.", "name": "DALE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "The overhead bulb flickers.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Rhonda lowers the monitor slowly.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "The breathing now comes from the dryer, the one still turning, the one with the small round window.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Nobody open that.", "name": "DALE", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Trudy opens it.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}]}