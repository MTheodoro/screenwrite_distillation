{"scene_id": "s01013", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01013.fountain", "heading": "INT. WINE CELLAR BUNKER - FRENCH CHATEAU - NIGHT", "cast": [{"id": 0, "name": "BARAKA", "names": ["BARAKA", "SGT. BARAKA"], "gender": "m", "first": 6, "spoke": 5}, {"id": 1, "name": "HOLLOWAY", "names": ["HOLLOWAY", "LT. HOLLOWAY"], "gender": "?", "first": 7, "spoke": 5}, {"id": 2, "name": "CPL. FINNEGAN", "names": ["FINNEGAN", "CPL. FINNEGAN"], "gender": "m", "first": 8, "spoke": 4}, {"id": 3, "name": "PVT. ORLANDO", "names": ["ORLANDO", "PVT. ORLANDO"], "gender": "m", "first": 10, "spoke": 2}, {"id": 4, "name": "PVT. DAGNY", "names": ["PVT", "PVT. DAGNY"], "gender": "?", "first": 10, "spoke": 3}, {"id": 5, "name": "DAGNY", "names": ["DAGNY"], "gender": "?", "first": 12, "spoke": 0}, {"id": 6, "name": "MAJOR TREVELYAN", "names": ["MAJOR TREVELYAN"], "gender": "?", "first": 29, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. WINE CELLAR BUNKER - FRENCH CHATEAU - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Barrel vaults.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cobwebbed racks of dusty bottles.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single carbide lamp.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The ground trembles faintly; every so often a spill of dust sifts from the stones overhead.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Shells are falling somewhere above.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "SGT. BARAKA (40s, broad, helmet on his knee, cigarette cupped in his fist) sits on a barrel.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "LT. HOLLOWAY (20s, pistol, pressed tunic, a cut over one eye) studies a hand-drawn map.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "CPL.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "FINNEGAN (30s, freckled, rifle across his thighs) cleans his boots.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "PVT.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "ORLANDO (teen, helmet too big) shares a canteen with PVT.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "DAGNY (20s, red-cross armband, bandage roll in her teeth).", "para": 1, "sent": 6, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "Nobody talks.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "Another tremor.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Dust sifts.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "A bottle clinks in the rack.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Dagny glances up, lips tight around the bandage.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "They're walking it down the hill.", "name": "SGT. BARAKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Sergeant, we'll hold until dawn.", "name": "LT. HOLLOWAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Sir, we'll hold until the roof does.", "name": "SGT. BARAKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "How many bottles you reckon are down here?", "name": "CPL. FINNEGAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Hundreds.", "name": "PVT. ORLANDO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Could drink the war away.", "name": "CPL. FINNEGAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Could drown in it, more like.", "name": "PVT. DAGNY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "I want the radio checked.", "name": "LT. HOLLOWAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "I've checked it twice.", "name": "SGT. BARAKA", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "The radio's fine, sir.", "name": "CPL. FINNEGAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "The field radio on the barrel beside Holloway hisses.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Holloway. Report.", "name": "MAJOR TREVELYAN", "speaker": 6, "ext": ["V.O."], "paren": ["distorted"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "Wine Cellar here, sir. All present. All quiet.", "name": "LT. HOLLOWAY", "speaker": 1, "ext": [], "paren": ["into the handset"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "That is correct. The shelling will cease at oh-four-hundred. Stay under.", "name": "MAJOR TREVELYAN", "speaker": 6, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "Understood, sir.", "name": "LT. HOLLOWAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "He sets the handset down.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "Nobody breathes.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "Why would they stop?", "name": "PVT. ORLANDO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "They don't stop.", "name": "PVT. DAGNY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "That's the point.", "name": "SGT. BARAKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "Orlando tilts his head.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "Frowns.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "The tremors have stopped.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "The dust no longer sifts.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "Nothing in the whole vault moves.", "para": 5, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "dialogue", "text": "Four o'clock?", "name": "CPL. FINNEGAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "Not yet.", "name": "LT. HOLLOWAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "dialogue", "text": "Then why is it quiet?", "name": "PVT. DAGNY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "Baraka crushes his cigarette.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "Holloway folds the map.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "action", "text": "From above, faint but clear, comes the clank of a tank tread on gravel, slow, deliberate, unhurried.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "dialogue", "text": "Because they're finished shelling.", "name": "SGT. BARAKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}