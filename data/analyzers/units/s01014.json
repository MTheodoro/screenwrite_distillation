{"scene_id": "s01014", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01014.fountain", "heading": "EXT. SKATEPARK POOL - DAWN", "cast": [{"id": 0, "name": "MIKA", "names": ["MIKA"], "gender": "f", "first": 5, "spoke": 9}, {"id": 1, "name": "DOM", "names": ["DOM"], "gender": "?", "first": 6, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SKATEPARK POOL - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A drained kidney-shaped pool, cracked at the lip.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Spray paint flares across the walls.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Grey light, wet concrete.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A beat-up board lies on its side.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MIKA (16, bruised elbow, helmet strap hanging) sits on the deck above the deep end, phone pressed to her ear, a tangle of nerves.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "dialogue", "text": "Dom? You there?", "name": "MIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "It's five in the morning.", "name": "DOM", "speaker": 1, "ext": ["V.O."], "paren": ["over phone, groggy"], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "I know.", "name": "MIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "What's wrong?", "name": "DOM", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Nothing. I'm at the pool.", "name": "MIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Mika. You said you wouldn't.", "name": "DOM", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I said I wouldn't drop in without you.", "name": "MIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "That's the same thing.", "name": "DOM", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "It's not.", "name": "MIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She peers over the lip.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "The bowl yawns below her, thirteen feet at the deepest.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She sets the phone on speaker and lays it beside her.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Wait for me. I'm getting my shoes.", "name": "DOM", "speaker": 1, "ext": ["V.O."], "paren": ["faint"], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "I'm just looking.", "name": "MIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Liar.", "name": "DOM", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She laughs, short.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Pulls on the helmet.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Buckles it.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Picks up the board and places it on the lip, tail on the coping.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Okay. Okay. Okay.", "name": "MIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Mika! Don't!", "name": "DOM", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "She steps on.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "The board tips.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "She shrieks, drops in, rockets down the wall, shoots across the flat bottom, climbs the far wall.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "She flies.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "She whoops.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "She slams down on her hip and skids on her back to the middle, laughing and swearing.", "para": 4, "sent": 5, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "The phone crackles on the deck.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Mika? Mika! Are you alive?", "name": "DOM", "speaker": 1, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "She stares at the sky.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Raises her phone arm, a thumb up toward no one.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Alive!", "name": "MIKA", "speaker": 0, "ext": [], "paren": ["shouting"], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Don't ever do that again.", "name": "DOM", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Again.", "name": "MIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}