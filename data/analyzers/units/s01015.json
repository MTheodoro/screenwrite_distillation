{"scene_id": "s01015", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01015.fountain", "heading": "INT. HAUNTED HOUSE HOTLINE CALL CENTER - OPEN OFFICE - DAY", "cast": [{"id": 0, "name": "VERNON", "names": ["VERNON"], "gender": "m", "first": 5, "spoke": 18}, {"id": 1, "name": "PRIYA", "names": ["PRIYA"], "gender": "?", "first": 6, "spoke": 7}, {"id": 2, "name": "CHAD", "names": ["CHAD"], "gender": "?", "first": 7, "spoke": 7}, {"id": 3, "name": "LINDQVIST", "names": ["LINDQVIST", "MS. LINDQVIST"], "gender": "f", "first": 8, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. HAUNTED HOUSE HOTLINE CALL CENTER - OPEN OFFICE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Cubicles under wire-hung plastic bats.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A cardboard skeleton waves from the reception desk.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Motivational posters read \"ENGAGE YOUR SPIRIT.\"", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A whiteboard counts dead calls.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "VERNON (50s, regional manager, a lanyard bigger than his head) wanders the aisle with a clipboard.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "PRIYA (30s, headset, fluorescent highlighter) types fast.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "CHAD (20s, sweatpants, energy-drink can) slumps.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "MS. LINDQVIST (60s, perfectly pressed blouse, glasses on a chain) sits at the corner desk, immaculate.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Team! Quick huddle.", "name": "VERNON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "We're on calls, Vernon.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "It'll just take a minute.", "name": "VERNON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "That's what you said about the pizza party.", "name": "CHAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Which was a success.", "name": "VERNON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "It was a Tuesday, Vernon. Nobody came.", "name": "MS. LINDQVIST", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Because they were busy, Ms. Lindqvist.", "name": "VERNON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "With what?", "name": "MS. LINDQVIST", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Hauntings.", "name": "VERNON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "We got four calls yesterday. Three were wrong numbers.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "And the fourth?", "name": "VERNON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "A man wanted to know if we do exorcisms.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Do we?", "name": "VERNON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "We do a free consultation.", "name": "CHAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Excellent. That's growth.", "name": "VERNON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "It's one consultation.", "name": "MS. LINDQVIST", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "It's the beginning of a pipeline.", "name": "VERNON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Is the pipeline cursed?", "name": "CHAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Chad.", "name": "VERNON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "I'm just asking.", "name": "CHAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Vernon, with respect, why does the quarterly deck have a slide titled \"Ghost Equity\"?", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "It's a value proposition.", "name": "VERNON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "It's a pun.", "name": "MS. LINDQVIST", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "It's both.", "name": "VERNON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "The phones ring, all four at once.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "They stare.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Nobody picks up.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Vernon clears his throat.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Straightens his tie.", "para": 2, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Smiles with all his teeth.", "para": 2, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Okay! Let's get those calls.", "name": "VERNON", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "They're ringing, Vernon.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "I can hear that.", "name": "VERNON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Who's answering?", "name": "CHAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Not me.", "name": "MS. LINDQVIST", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "They keep ringing.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "The lights flicker.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "The cardboard skeleton at reception topples over.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Okay. That one's us.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": ["very quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Let's hold on.", "name": "VERNON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Hold on to what?", "name": "CHAD", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "The scripts.", "name": "VERNON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "He picks up a laminated page.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Reads.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "His voice cracks.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "\"Thank you for calling Spirit Assist. Your call is important to us.\"", "name": "VERNON", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Don't say that to them.", "name": "MS. LINDQVIST", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "It's the script!", "name": "VERNON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "They're not callers, Vernon.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "The phones stop.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "Silence.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "Then, from every headset on every desk, a whisper, in unison.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "Nope.", "name": "CHAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "He stands.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "Takes his coat.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "Walks out.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "Priya looks at Ms. Lindqvist.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "Ms. Lindqvist takes off her glasses, folds them, and sets them on the desk.", "para": 6, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "I'll start with the ones in the supply closet.", "name": "MS. LINDQVIST", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}