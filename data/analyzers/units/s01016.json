{"scene_id": "s01016", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01016.fountain", "heading": "EXT. CORN MAZE - NIGHT", "cast": [{"id": 0, "name": "WYATT", "names": ["WYATT"], "gender": "?", "first": 5, "spoke": 1}, {"id": 1, "name": "JOLENE", "names": ["JOLENE"], "gender": "m", "first": 6, "spoke": 1}, {"id": 2, "name": "BUBBA", "names": ["BUBBA"], "gender": "f", "first": 7, "spoke": 1}, {"id": 3, "name": "TINA", "names": ["TINA"], "gender": "?", "first": 8, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. CORN MAZE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Walls of dry stalks twice head-height.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Moon behind thin cloud.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The paths twist like intestines.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Wind rustles the husks.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "WYATT (20s, letterman jacket, flashlight) leads, sweeping the beam.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "JOLENE (20s, hoodie, nervous giggle) clutches his sleeve.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "BUBBA (30s, big man, camo cap, a bag of beef jerky) bumps behind them.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "TINA (teen, braces, a phone held up like a candle) trails at the rear.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "They stop at a fork.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Wyatt aims the beam left, then right.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Corn stalks lean in on both sides like crowding spectators.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Which way?", "name": "WYATT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "I'm out of battery.", "name": "TINA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "We came in from the left.", "name": "JOLENE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "We came in from the right.", "name": "BUBBA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "They freeze.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "The wind stops.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Somewhere in the rows, a stalk snaps.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Another.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "A third, closer.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Wyatt kills the light.", "para": 3, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "A shape rises from the left path.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Tall.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Thin.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Wearing a feed-sack head.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "It tilts.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Stares.", "para": 4, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Jolene screams.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Bubba drops the jerky.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Wyatt grabs both girls and wheels right.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "They sprint, crashing through stalks, but the shape follows without hurrying, gliding between the rows like a fish.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Tina trips.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Bubba hauls her up by the hood, and the four of them burst into a small clearing at the center of the maze.", "para": 5, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "A wooden scarecrow, upright on a pole, waits there.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Its sack head turns to face them.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "They scatter.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}]}