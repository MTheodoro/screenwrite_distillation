{"scene_id": "s01017", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01017.fountain", "heading": "EXT. SLED-DOG CHECKPOINT - ARCTIC DUSK", "cast": [{"id": 0, "name": "INGRID", "names": ["INGRID"], "gender": "f", "first": 6, "spoke": 9}, {"id": 1, "name": "BAPTISTE", "names": ["BAPTISTE"], "gender": "f", "first": 7, "spoke": 5}, {"id": 2, "name": "MARSHAL VOGEL", "names": ["MARSHAL VOGEL"], "gender": "?", "first": 9, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SLED-DOG CHECKPOINT - ARCTIC DUSK", "present": []}, {"u": 1, "kind": "action", "text": "A canvas tent in a field of blue snow.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A propane heater.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A rack of frozen dogs' booties.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Wind flaps the tent walls.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Overhead, the aurora begins to spill green.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "INGRID (30s, parka, frost in her eyelashes) kneels beside a team of eight huskies, rubbing a dog's paw.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "BAPTISTE (40s, race vet, orange snowsuit, stethoscope) checks another dog's heartbeat.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "A handheld radio crackles on a crate between them.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Checkpoint Four, this is Race Control. Status on team nineteen.", "name": "MARSHAL VOGEL", "speaker": 2, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Race Control, team nineteen is at Checkpoint Four. Two hours rest. Then out.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Negative. Storm front closing. You have twenty minutes.", "name": "MARSHAL VOGEL", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Twenty minutes?", "name": "INGRID", "speaker": 0, "ext": [], "paren": ["to Baptiste"], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "She can't run eight dogs in twenty.", "name": "BAPTISTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "They can.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Not that one.", "name": "BAPTISTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "He points.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "A big gray husky named Ash lies on his side, tongue lolling, ribs fluttering.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Ingrid's face drops.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "She crawls to him.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Ash. Hey. Hey, big man.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "He's dehydrated. I'm pulling him from the team.", "name": "BAPTISTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "No.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Ingrid.", "name": "BAPTISTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "He's my lead.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "He's a dog.", "name": "BAPTISTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "He's my lead dog.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "The radio crackles again.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Team nineteen, you have fifteen.", "name": "MARSHAL VOGEL", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Ingrid grabs the radio.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Race Control, scratch team nineteen.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Say again?", "name": "MARSHAL VOGEL", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "I'm scratching. I'm staying with my dog.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "A beat of static.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Baptiste smiles, and brings her a cup of water for Ash.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Above them the aurora breaks wide and green across the dark.", "para": 5, "sent": 2, "present": [0, 1, 2]}]}