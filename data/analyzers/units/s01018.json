{"scene_id": "s01018", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01018.fountain", "heading": "INT. DEEP-SEA MINING SUBMERSIBLE - COCKPIT - SIX KILOMETERS DOWN", "cast": [{"id": 0, "name": "CAPTAIN ZHAO", "names": ["CAPTAIN ZHAO", "ZHAO"], "gender": "?", "first": 6, "spoke": 7}, {"id": 1, "name": "ALVARO", "names": ["ALVARO"], "gender": "?", "first": 7, "spoke": 8}, {"id": 2, "name": "LENA", "names": ["LENA"], "gender": "f", "first": 8, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. DEEP-SEA MINING SUBMERSIBLE - COCKPIT - SIX KILOMETERS DOWN", "present": []}, {"u": 1, "kind": "action", "text": "A pressurized sphere barely wider than a bathtub.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Banks of dials and gauges.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Three seats facing a viewport thick as a dinner plate.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Beyond it, nothing.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Black water, falling snow of dead plankton.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "CAPTAIN ZHAO (50s, headset, steady voice) grips the yoke.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "ALVARO (30s, sweat-soaked polo, geologist) pores over a sonar screen.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "LENA (20s, rookie, braids tucked under a company cap) monitors the oxygen scrubbers.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Depth six-oh-two-one. Holding.", "name": "ZHAO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Sonar's picking up something big.", "name": "ALVARO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "How big?", "name": "LENA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Bigger than the sub. Bigger than the seabed shelf.", "name": "ALVARO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Is it moving?", "name": "ZHAO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "It's breathing.", "name": "ALVARO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Captain, oxygen is dipping.", "name": "LENA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Dipping how?", "name": "ZHAO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Four percent in two minutes.", "name": "LENA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Cap, the contact is closing.", "name": "ALVARO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Lena, shut down the non-essentials.", "name": "ZHAO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Shutting down.", "name": "LENA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "It's right under us.", "name": "ALVARO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Alvaro, give me a heading.", "name": "ZHAO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Up. Any direction up.", "name": "ALVARO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The sub shudders.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "A groan rolls through the hull.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Lena grips her seat.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "The viewport floods with a slow pale glow, climbing from below.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Oh my God.", "name": "LENA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Blow ballast.", "name": "ZHAO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Blowing.", "name": "ALVARO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "It's not working.", "name": "LENA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Blow it again!", "name": "ZHAO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "The valves are frozen.", "name": "ALVARO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "The glow swells.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Something vast turns beneath them, an eye as wide as a cathedral, and the viewport fills with its slow, gold, curious gaze.", "para": 3, "sent": 1, "present": [0, 1, 2]}]}