{"scene_id": "s01021", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01021.fountain", "heading": "INT. LIGHTHOUSE LAMP ROOM - DAWN", "cast": [{"id": 0, "name": "IGNACIO", "names": ["IGNACIO"], "gender": "?", "first": 5, "spoke": 20}, {"id": 1, "name": "WREN", "names": ["WREN"], "gender": "f", "first": 18, "spoke": 21}], "units": [{"u": 0, "kind": "heading", "text": "INT. LIGHTHOUSE LAMP ROOM - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Salt-streaked glass.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A Fresnel lens the size of a bus shelter, still turning.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Slow.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Heavy.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "IGNACIO, 30s, keeper's wool sweater, kneels at the brass base with an oilcan.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Hands black with grease.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "He hums.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Off-key.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "Pleased with himself.", "para": 2, "sent": 2, "present": [0]}, {"u": 10, "kind": "action", "text": "The hatch bangs.", "para": 3, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "He freezes.", "para": 4, "sent": 0, "present": [0]}, {"u": 12, "kind": "action", "text": "Listens.", "para": 4, "sent": 1, "present": [0]}, {"u": 13, "kind": "action", "text": "Boots on iron stairs.", "para": 5, "sent": 0, "present": [0]}, {"u": 14, "kind": "action", "text": "Coming up.", "para": 5, "sent": 1, "present": [0]}, {"u": 15, "kind": "dialogue", "text": "Supply boat's not till Friday.", "name": "IGNACIO", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0]}, {"u": 16, "kind": "action", "text": "The hatch lifts.", "para": 6, "sent": 0, "present": [0]}, {"u": 17, "kind": "action", "text": "A suitcase thumps onto the floor.", "para": 6, "sent": 1, "present": [0]}, {"u": 18, "kind": "action", "text": "WREN, 30s, soaked to the bone, red scarf plastered to her neck, hauls herself up.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Breathing hard.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Grinning hard.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "He stands.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Oilcan still in hand.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "No.", "name": "IGNACIO", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Hello to you too.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "You can't be here.", "name": "IGNACIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "I rowed.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "You rowed. Eleven miles.", "name": "IGNACIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Nine. I cut the corner.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "He sets the can down.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Carefully.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Like it might go off.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "She drops her bag.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Wrings out the scarf.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Water pools on the floor.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "You wrote that you were done.", "name": "IGNACIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "I wrote a lot of things.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "You wrote one letter. Four lines.", "name": "IGNACIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "It was a good four lines.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "He turns away.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Faces the lens.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "It sweeps past, throwing fractured light across his face.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "She watches.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Doesn't close the gap.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "You kept the light on.", "name": "WREN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "It's a lighthouse.", "name": "IGNACIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "You kept it polished.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "It's my job.", "name": "IGNACIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Ignacio.", "name": "WREN", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "He doesn't answer.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "His shoulders drop an inch.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "She crosses to the rail.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "Rain ticks against the glass.", "para": 14, "sent": 1, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "Far below, the sea is a gray animal, restless.", "para": 14, "sent": 2, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "I almost didn't make it. The boat took water by the rocks.", "name": "WREN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "You could have drowned.", "name": "IGNACIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "I know.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "You could have drowned, and I'd have been up here. Oiling a gear.", "name": "IGNACIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "She turns.", "para": 15, "sent": 0, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "Their eyes meet.", "para": 15, "sent": 1, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "Held.", "para": 15, "sent": 2, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "Say it, then.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "Say what?", "name": "IGNACIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "Whatever you've been rehearsing.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "A beat.", "para": 16, "sent": 0, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "He shakes his head.", "para": 16, "sent": 1, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "A small, defeated laugh.", "para": 16, "sent": 2, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "It was better yesterday.", "name": "IGNACIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "Try me.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "I missed you.", "name": "IGNACIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "I missed you.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "They say it on top of each other.", "para": 17, "sent": 0, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "Neither stops.", "para": 17, "sent": 1, "present": [0, 1]}, {"u": 73, "kind": "dialogue", "text": "I was angry. I'm still angry.", "name": "IGNACIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 74, "kind": "dialogue", "text": "I was scared. I'm still scared.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 75, "kind": "action", "text": "They stop.", "para": 18, "sent": 0, "present": [0, 1]}, {"u": 76, "kind": "action", "text": "Both laugh.", "para": 18, "sent": 1, "present": [0, 1]}, {"u": 77, "kind": "action", "text": "Short.", "para": 18, "sent": 2, "present": [0, 1]}, {"u": 78, "kind": "action", "text": "Wet.", "para": 18, "sent": 3, "present": [0, 1]}, {"u": 79, "kind": "dialogue", "text": "You're dripping on my floor.", "name": "IGNACIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 80, "kind": "dialogue", "text": "You're welcome.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 81, "kind": "action", "text": "He picks up a towel from a hook.", "para": 19, "sent": 0, "present": [0, 1]}, {"u": 82, "kind": "action", "text": "Tosses it.", "para": 19, "sent": 1, "present": [0, 1]}, {"u": 83, "kind": "action", "text": "She catches it one-handed.", "para": 19, "sent": 2, "present": [0, 1]}, {"u": 84, "kind": "action", "text": "She dries her face.", "para": 20, "sent": 0, "present": [0, 1]}, {"u": 85, "kind": "action", "text": "Her hands.", "para": 20, "sent": 1, "present": [0, 1]}, {"u": 86, "kind": "action", "text": "She's slowing down.", "para": 20, "sent": 2, "present": [0, 1]}, {"u": 87, "kind": "dialogue", "text": "Is there tea?", "name": "WREN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 88, "kind": "dialogue", "text": "There's a kettle.", "name": "IGNACIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 89, "kind": "dialogue", "text": "That's not what I asked.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 90, "kind": "dialogue", "text": "There's a kettle and a tin that might be tea.", "name": "IGNACIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 91, "kind": "dialogue", "text": "Might be.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 92, "kind": "dialogue", "text": "It's been there since March.", "name": "IGNACIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 93, "kind": "dialogue", "text": "Brave.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 94, "kind": "action", "text": "He crosses to the hatch.", "para": 21, "sent": 0, "present": [0, 1]}, {"u": 95, "kind": "action", "text": "Stops.", "para": 21, "sent": 1, "present": [0, 1]}, {"u": 96, "kind": "action", "text": "Looks down the shaft.", "para": 21, "sent": 2, "present": [0, 1]}, {"u": 97, "kind": "dialogue", "text": "Stairs are slick. Come on.", "name": "IGNACIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 98, "kind": "dialogue", "text": "Is that an invitation?", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 99, "kind": "dialogue", "text": "It's a warning.", "name": "IGNACIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 100, "kind": "action", "text": "She smiles.", "para": 22, "sent": 0, "present": [0, 1]}, {"u": 101, "kind": "action", "text": "Picks up her suitcase.", "para": 22, "sent": 1, "present": [0, 1]}, {"u": 102, "kind": "action", "text": "He takes it from her before she can protest.", "para": 22, "sent": 2, "present": [0, 1]}, {"u": 103, "kind": "action", "text": "They descend.", "para": 23, "sent": 0, "present": [0, 1]}, {"u": 104, "kind": "action", "text": "His head vanishes first.", "para": 23, "sent": 1, "present": [0, 1]}, {"u": 105, "kind": "action", "text": "Then hers.", "para": 23, "sent": 2, "present": [0, 1]}, {"u": 106, "kind": "action", "text": "The lens keeps turning.", "para": 24, "sent": 0, "present": [0, 1]}, {"u": 107, "kind": "action", "text": "Light sweeps the empty room.", "para": 24, "sent": 1, "present": [0, 1]}]}