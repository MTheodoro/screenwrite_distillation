{"scene_id": "s01022", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01022.fountain", "heading": "INT. MILLBROOK TELEPHONE EXCHANGE - NIGHT (1924)", "cast": [{"id": 0, "name": "MABEL PRZYBYLSKI", "names": ["MABEL PRZYBYLSKI", "MABEL"], "gender": "?", "first": 4, "spoke": 11}, {"id": 1, "name": "STRANGER", "names": ["STRANGER"], "gender": "m", "first": 16, "spoke": 3}, {"id": 2, "name": "CROWE", "names": ["CROWE"], "gender": "?", "first": 26, "spoke": 4}, {"id": 3, "name": "ABERNATHY", "names": ["ABERNATHY"], "gender": "?", "first": 38, "spoke": 4}, {"id": 4, "name": "TOBY", "names": ["TOBY"], "gender": "?", "first": 55, "spoke": 3}, {"id": 5, "name": "SHERIFF DUNMORE", "names": ["SHERIFF DUNMORE"], "gender": "?", "first": 67, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. MILLBROOK TELEPHONE EXCHANGE - NIGHT (1924)", "present": []}, {"u": 1, "kind": "action", "text": "A small room above the feed store.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A cord switchboard with a hundred brass jacks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A kerosene lamp backs up a weak electric bulb.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MABEL PRZYBYLSKI, 20s, headset over pinned-up hair, plugs and unplugs cords with practiced speed.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She is alone and likes it that way.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "A buzz.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "A light on the board.", "para": 2, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "She plugs in.", "para": 2, "sent": 2, "present": [0]}, {"u": 9, "kind": "dialogue", "text": "Number, please.", "name": "MABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 10, "kind": "action", "text": "She listens.", "para": 3, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "Pulls the cord.", "para": 3, "sent": 1, "present": [0]}, {"u": 12, "kind": "action", "text": "Connects another.", "para": 3, "sent": 2, "present": [0]}, {"u": 13, "kind": "action", "text": "The room breathes.", "para": 3, "sent": 3, "present": [0]}, {"u": 14, "kind": "action", "text": "Boots on the stairs.", "para": 4, "sent": 0, "present": [0]}, {"u": 15, "kind": "action", "text": "The door opens without a knock.", "para": 4, "sent": 1, "present": [0]}, {"u": 16, "kind": "action", "text": "A STRANGER in a long coat, hat low, rain on his shoulders.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He carries a leather satchel.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "We're closed to the public, sir.", "name": "MABEL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "I need the line to Harrisburg.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "That's the long-distance trunk. Company use only.", "name": "MABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "It's urgent.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Everything is, at this hour.", "name": "MABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "A new buzz.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Another light.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "She ignores it.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "My name is Elias Crowe. I'm with the state railway board.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "You have a paper that says so?", "name": "MABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "He opens the satchel.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Pulls out an envelope.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "She takes it, reads it by the lamp.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Her face tightens.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "It is in order.", "name": "CROWE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "It's a telegram form. Anyone can fill one out.", "name": "MABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Then call the manager.", "name": "CROWE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "She hesitates.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Pulls a cord.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Cranks a handle.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Mr. Abernathy? Sorry to wake you. There's a gentleman here.", "name": "MABEL", "speaker": 0, "ext": [], "paren": ["into headset"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "The earpiece crackles.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "A thin, irritable voice leaks into the room.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "At this hour? Is the building on fire?", "name": "ABERNATHY", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "No, sir. A man from the railway board.", "name": "MABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Tell him to come in the morning.", "name": "ABERNATHY", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Tell him it concerns the six-ten freight.", "name": "CROWE", "speaker": 2, "ext": [], "paren": ["leaning toward her"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Mabel's eyes flick up.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "She repeats it.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "A long silence on the line.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Then Abernathy, quieter.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Put him through. And Mabel. Plug in the sheriff's line too.", "name": "ABERNATHY", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Sir?", "name": "MABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Do it.", "name": "ABERNATHY", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "She obeys.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Her hands are not quite steady now.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "The door opens again.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "TOBY, 12, the messenger boy, cap too big, bursts in dripping and out of breath.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Miss Mabel! Somebody cut the wire at the Calder bridge. Pa says the whole east line's dead.", "name": "TOBY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "Crowe straightens.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Mabel looks from the boy to the stranger.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "Mr. Crowe. How did you know about the freight?", "name": "MABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "I don't know anything about wires.", "name": "CROWE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "Then why's your satchel got a coil of copper in it?", "name": "TOBY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "Everyone looks.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "A bright loop of wire pokes out of the satchel.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "The board buzzes.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "Light after light.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "The sheriff's line clicks live.", "para": 16, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "dialogue", "text": "Millbrook exchange. Dunmore. Who's there with you, Miss Przybylski?", "name": "SHERIFF DUNMORE", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "action", "text": "Mabel's hand rests on the key.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "action", "text": "She looks at Crowe.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "action", "text": "Crowe looks at the door.", "para": 17, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "dialogue", "text": "Stay where you are, Mr. Crowe. Toby, lock that door.", "name": "MABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "dialogue", "text": "Yes, ma'am.", "name": "TOBY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "action", "text": "The bolt slides home.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "action", "text": "The lamp flickers.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 75, "kind": "action", "text": "The board keeps buzzing.", "para": 18, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}