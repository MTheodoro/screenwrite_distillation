{"scene_id": "s01023", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01023.fountain", "heading": "INT. CRAB CANNERY - NIGHT SHIFT - NIGHT", "cast": [{"id": 0, "name": "PAULINA RUSSO", "names": ["PAULINA RUSSO", "PAULINA"], "gender": "f", "first": 6, "spoke": 8}, {"id": 1, "name": "DESMOND WALCOTT", "names": ["DESMOND WALCOTT", "DESMOND"], "gender": "m", "first": 7, "spoke": 5}, {"id": 2, "name": "GUS", "names": ["GUS"], "gender": "m", "first": 8, "spoke": 6}, {"id": 3, "name": "HAND", "names": ["HAND"], "gender": "?", "first": 65, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. CRAB CANNERY - NIGHT SHIFT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Steel tables.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Hoses.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Steam rising from vats.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Fluorescents buzz.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Everything smells of brine and bleach.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "PAULINA RUSSO, 40s, shift lead, hairnet, white rubber boots, sprays down a conveyor belt.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "DESMOND WALCOTT, 20s, headphones around his neck, stacks crates.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "GUS, 60s, Paulina's oldest hand, wheels a pallet jack.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "The line is stopped.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "A quiet kind of peace.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Ten minutes, everybody. Breaker's being cranky.", "name": "PAULINA", "speaker": 0, "ext": [], "paren": ["to all"], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "It's always cranky.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Then it's consistent.", "name": "PAULINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Gus parks the jack.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Eases onto an upturned bucket.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Pulls a sandwich from his apron.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Thirty-one years. Never once got used to the cold.", "name": "GUS", "speaker": 2, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Desmond laughs.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Pulls a phone from his pocket.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Gus, you want to see my niece? She just learned to whistle.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Sure.", "name": "GUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Desmond shows him the screen.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Gus squints.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Smiles.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "The first real smile of the night.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Paulina checks her clipboard.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Hums.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "The steam curls around her.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Two cases short. Where did you go, little guys.", "name": "PAULINA", "speaker": 0, "ext": [], "paren": ["under her breath"], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "From the live tank behind the line, a soft tap.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Glass on glass.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Nobody notices.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "The humming continues.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "She's three. She calls everything \"doggy.\"", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Smart kid.", "name": "GUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Tap.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Tap.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Tap.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Slower.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Paulina looks up.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "The tank, a long glass rectangle of dark water, hides in the shadow beyond the last light.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Did you top up the tank?", "name": "PAULINA", "speaker": 0, "ext": [], "paren": ["to Desmond"], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Friday.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Then who's tapping?", "name": "PAULINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Pipes. They knock.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Gus has stopped chewing.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "He stares at the tank.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Paulina.", "name": "GUS", "speaker": 2, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "What?", "name": "PAULINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "There's no water moving.", "name": "GUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "She follows his gaze.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "The surface is perfectly flat.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Black.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Nothing disturbs it.", "para": 12, "sent": 3, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Tap.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "The sound comes from inside.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "Okay. Okay.", "name": "PAULINA", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "She walks toward the tank.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Boots squelching.", "para": 15, "sent": 1, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "Desmond rises.", "para": 15, "sent": 2, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "Gus doesn't.", "para": 15, "sent": 3, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "Both of you, stay there.", "name": "PAULINA", "speaker": 0, "ext": ["CONT'D"], "paren": ["over her shoulder"], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "She reaches the glass.", "para": 16, "sent": 0, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "Wipes the condensation with her sleeve.", "para": 16, "sent": 1, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "Pressed against the inside of the glass is a HAND.", "para": 17, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "A human hand.", "para": 17, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "Pale, wrinkled, fingers splayed.", "para": 17, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "Paulina stumbles back.", "para": 18, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "Her clipboard clatters.", "para": 18, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "Under the surface, a face drifts up.", "para": 19, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "Eyes open.", "para": 19, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "action", "text": "Wearing a hairnet.", "para": 19, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "action", "text": "It's Gus's face.", "para": 20, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "Paulina turns.", "para": 21, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "Gus is still on his bucket.", "para": 21, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "He lifts his sandwich.", "para": 21, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "Smiles.", "para": 21, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "action", "text": "Too wide.", "para": 21, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "dialogue", "text": "Ten minutes, you said.", "name": "GUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "action", "text": "Desmond's phone slips from his hand.", "para": 22, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "action", "text": "The screen lights the floor.", "para": 22, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "action", "text": "The breaker clunks.", "para": 22, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "action", "text": "All the fluorescents go out.", "para": 23, "sent": 0, "present": [0, 1, 2, 3]}]}