{"scene_id": "s01024", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01024.fountain", "heading": "INT. SMALL CLAIMS COURTROOM - FORMER SKATING RINK - DAY", "cast": [{"id": 0, "name": "JUDGE MARGUERITE VANCE", "names": ["JUDGE MARGUERITE VANCE", "VANCE"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "FELIX OYELARAN", "names": ["FELIX OYELARAN", "OYELARAN"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "SOLVEIG HARTMANN", "names": ["SOLVEIG HARTMANN", "HARTMANN"], "gender": "m", "first": 6, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. SMALL CLAIMS COURTROOM - FORMER SKATING RINK - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Bleachers for gallery.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Judge's bench on a rink-side Zamboni platform.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Painted lines still on the floor.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "JUDGE MARGUERITE VANCE, 60s, reading glasses, gavel in a fist.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "FELIX OYELARAN, 30s, sharp suit, stands at the plaintiff's mark.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "SOLVEIG HARTMANN, 40s, hands folded, at the defendant's.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Counselor, the exhibit.", "name": "VANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Your Honor, my client's contract clearly states--", "name": "OYELARAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Objection. Contract was never signed.", "name": "HARTMANN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Ms. Hartmann, let him finish.", "name": "VANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "He's misstating the--", "name": "HARTMANN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "I have it right here, page four--", "name": "OYELARAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Both of you.", "name": "VANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Oyelaran waves the paper.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Hartmann steps toward him.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Vance raises the gavel.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "It's a forgery, Judge. He knows it.", "name": "HARTMANN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "That is a slander, and you know it.", "name": "OYELARAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Order!", "name": "VANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Ask him who typed it!", "name": "HARTMANN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Ask her why she hid the original!", "name": "OYELARAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "The gavel cracks.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Once.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Twice.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "A third time, splintering the handle.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Sit. Down.", "name": "VANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "They sit.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Silence.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "A skate guard coughs in the bleachers.", "para": 4, "sent": 2, "present": [0, 1, 2]}]}