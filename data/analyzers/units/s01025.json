{"scene_id": "s01025", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01025.fountain", "heading": "INT. STEAMSHIP \"MARIGOLD\" - LOST AND FOUND OFFICE - DAY", "cast": [{"id": 0, "name": "FITCH", "names": ["FITCH"], "gender": "m", "first": 3, "spoke": 15}, {"id": 1, "name": "BARNABY PLUMLEY", "names": ["BARNABY PLUMLEY", "BARNABY"], "gender": "?", "first": 6, "spoke": 15}, {"id": 2, "name": "ALOYSIUS FENN", "names": ["ALOYSIUS FENN", "ALOYSIUS"], "gender": "?", "first": 7, "spoke": 13}, {"id": 3, "name": "HORTENSE VANDERWELL", "names": ["HORTENSE VANDERWELL", "HORTENSE"], "gender": "?", "first": 44, "spoke": 12}, {"id": 4, "name": "NELL", "names": ["NELL"], "gender": "?", "first": 44, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. STEAMSHIP \"MARIGOLD\" - LOST AND FOUND OFFICE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A narrow room below decks, shelves of forgotten hats, umbrellas, a single ukulele.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A porthole shows slow gray swells.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "MR. FITCH, 50s, round spectacles, ledger in hand, presides behind a brass-railed counter.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "He is pleased with the order of the universe.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "action", "text": "The door opens.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "BARNABY PLUMLEY, 40s, tweed, mustache like a pushbroom, enters with the confidence of a man who has never been refused.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Behind him, ALOYSIUS FENN, 40s, also in tweed, also mustached, but nervous.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Gentlemen. Something lost?", "name": "FITCH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "A trunk. Brown, brass corners, initialed B.P.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Or A.F. It's our trunk.", "name": "ALOYSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Two sets of initials?", "name": "FITCH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "We travel together.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Not that way.", "name": "ALOYSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I did not suggest a way.", "name": "FITCH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Fitch opens the ledger.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Runs a finger down the page.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Brown trunk, brass corners. Found on Deck C, yesterday.", "name": "FITCH", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "That's the one.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Did it contain anything unusual?", "name": "FITCH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Shirts.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "And the Mortimer papers.", "name": "ALOYSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Shirts.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": ["sharp"], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Papers, you said?", "name": "FITCH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Shirts and papers. Mostly shirts.", "name": "ALOYSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Fitch produces a trunk from beneath the counter.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Sets it down with ceremony.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Unlatches it.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Inside: shirts.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Neatly folded.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "One small leather folio.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Shirts. And a folio marked \"Mortimer.\"", "name": "FITCH", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Yes. Splendid. We'll take it.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "I'll need a signature.", "name": "FITCH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Of course.", "name": "ALOYSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Fitch slides a form across.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Barnaby reaches.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Aloysius reaches.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Their hands collide on the pen.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "After you.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "No, you.", "name": "ALOYSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "I insist.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Then I insist more.", "name": "ALOYSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "The door swings open again.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "HORTENSE VANDERWELL, 60s, fur stole in the tropics, enters with NELL, 9, in a sailor dress, clutching a stuffed walrus.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Mr. Fitch! My daughter lost Sir Reginald!", "name": "HORTENSE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "He's right here, Grandmother.", "name": "NELL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "Then what are we doing here?", "name": "HORTENSE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "You said we'd get ice cream.", "name": "NELL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Ah. So I did.", "name": "HORTENSE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Fitch clears his throat.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "Madam, as you can see, I am engaged with two gentlemen.", "name": "FITCH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "Two? I see one and a half.", "name": "HORTENSE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "I beg your pardon.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "Is the other one a ghost?", "name": "HORTENSE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "I am quite solid, madam.", "name": "ALOYSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "So was my late husband. Look where it got him.", "name": "HORTENSE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "Silence.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Fitch polishes his spectacles.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "Nell, was it? What lost thing do you seek?", "name": "FITCH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "Nothing. Grandmother told me to say we were looking for something so she could meet the two men with the matching mustaches.", "name": "NELL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "Nell!", "name": "HORTENSE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "dialogue", "text": "You did.", "name": "NELL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "dialogue", "text": "Children invent the most extraordinary things.", "name": "HORTENSE", "speaker": 3, "ext": [], "paren": ["to Barnaby"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "dialogue", "text": "Madam, we are not available for introductions.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "We are engaged.", "name": "ALOYSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "dialogue", "text": "To other people!", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "dialogue", "text": "Women!", "name": "ALOYSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "dialogue", "text": "How very modern.", "name": "HORTENSE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "dialogue", "text": "Might I suggest we resolve the trunk?", "name": "FITCH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "dialogue", "text": "Yes. The trunk.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "dialogue", "text": "Please.", "name": "ALOYSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "action", "text": "Fitch taps the folio.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "dialogue", "text": "There is a problem, gentlemen.", "name": "FITCH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "dialogue", "text": "Which is?", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "dialogue", "text": "This folio does not contain papers. It contains a deed.", "name": "FITCH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 76, "kind": "dialogue", "text": "Barnaby.", "name": "ALOYSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 77, "kind": "dialogue", "text": "Don't.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 78, "kind": "dialogue", "text": "To the Marigold.", "name": "FITCH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 79, "kind": "dialogue", "text": "The ship?", "name": "HORTENSE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 80, "kind": "dialogue", "text": "The ship. It appears that one of you, or perhaps both, has been selling it for some weeks, to various purchasers, on the open sea.", "name": "FITCH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 81, "kind": "dialogue", "text": "Can you sell a boat while you're on it?", "name": "NELL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 82, "kind": "dialogue", "text": "Apparently, dear. Apparently you can.", "name": "HORTENSE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 83, "kind": "action", "text": "Barnaby and Aloysius look at each other.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 84, "kind": "action", "text": "Then at the door.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 85, "kind": "dialogue", "text": "After you.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 86, "kind": "dialogue", "text": "No, you.", "name": "ALOYSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 87, "kind": "action", "text": "They bolt together, wedged in the doorway.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 88, "kind": "action", "text": "Fitch rings a brass bell.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 89, "kind": "action", "text": "Somewhere above, a whistle blows.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 90, "kind": "dialogue", "text": "Grandmother, can we still get ice cream?", "name": "NELL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 91, "kind": "dialogue", "text": "Child, we are going to buy the ship.", "name": "HORTENSE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}