{"scene_id": "s01026", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01026.fountain", "heading": "INT. GENERATION SHIP \"TERRAPIN\" - HYDROPONIC LAUNDRY - NIGHT CYCLE", "cast": [{"id": 0, "name": "CAPTAIN ISADORA VOSS", "names": ["CAPTAIN ISADORA VOSS", "VOSS"], "gender": "?", "first": 4, "spoke": 12}, {"id": 1, "name": "KOJI TANABE", "names": ["KOJI TANABE", "KOJI"], "gender": "m", "first": 5, "spoke": 7}, {"id": 2, "name": "AMARA OKELLO", "names": ["AMARA OKELLO", "AMARA"], "gender": "?", "first": 6, "spoke": 6}, {"id": 3, "name": "TERRAPIN", "names": ["TERRAPIN"], "gender": "?", "first": 24, "spoke": 7}, {"id": 4, "name": "PELL", "names": ["PELL"], "gender": "?", "first": 33, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. GENERATION SHIP \"TERRAPIN\" - HYDROPONIC LAUNDRY - NIGHT CYCLE", "present": []}, {"u": 1, "kind": "action", "text": "A warm, humid hold.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of lettuce racks climb the walls under violet grow-lamps.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "In the center, three washing drums turn, slow and patient.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CAPTAIN ISADORA VOSS, 50s, silver braid, sleeves rolled, folds a coverall with military precision.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across from her, KOJI TANABE, 30s, engineer, grease on his cuffs, sits on a drum and stares at a handheld.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "DR. AMARA OKELLO, 40s, ship's physician, enters with a cart of sheets.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Captain. The night cycle is half over. You should rest.", "name": "AMARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "I rest when the laundry is done.", "name": "VOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "It never is.", "name": "AMARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "That's the beauty of it.", "name": "VOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Koji glances up.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Back down.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Captain, I'm getting a drift on the aft coolant. Point two percent.", "name": "KOJI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Over what?", "name": "VOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Forty days.", "name": "KOJI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Fix it.", "name": "VOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I have. Three times.", "name": "KOJI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Voss sets the coverall down.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Looks at him properly.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Then it's not drift.", "name": "VOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "No, ma'am.", "name": "KOJI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "A soft chime.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "From the ceiling grille:", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Attention. Compartment seven pressure variance detected. Corrective action in progress.", "name": "TERRAPIN", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Terrapin, which compartment is seven?", "name": "VOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "The nursery.", "name": "TERRAPIN", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "A beat.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Amara's hand tightens on the cart.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "How much variance?", "name": "AMARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Point four kilopascals. Within tolerance.", "name": "TERRAPIN", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Tolerance is point five.", "name": "KOJI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Meaning we're one bad hour from not being within it.", "name": "VOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "PELL, 19, galley apprentice, barefoot, slides in clutching a mop like a rifle.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Captain! Somebody's in the cold lock. Banging on the inside.", "name": "PELL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Nobody's in the cold lock.", "name": "VOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "I heard it.", "name": "PELL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Cold lock occupancy: zero.", "name": "TERRAPIN", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Then why's it hitting back?", "name": "PELL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "The room goes still.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Even the drums seem to slow.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Then, faintly, from the far end of the hold: knock.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Knock.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Knock.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "A pause.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Knock.", "para": 9, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "That's the code.", "name": "AMARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "What code?", "name": "VOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "The medical one. Three, pause, one. Emergency.", "name": "AMARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Nobody's logged to the lock.", "name": "KOJI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Terrapin, open the cold lock.", "name": "VOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "Unable. Door sealed by order of Captain Voss.", "name": "TERRAPIN", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "I gave no such order.", "name": "VOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "Issued four hundred days ago.", "name": "TERRAPIN", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "Voss and Koji turn to look at each other.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "They speak at once.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Cancel the seal.", "name": "VOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "Cancel the seal!", "name": "KOJI", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "Cancel the seal now!", "name": "AMARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "I'm gonna throw up.", "name": "PELL", "speaker": 4, "ext": [], "paren": ["to nobody"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "Cancel denied. Reason: crew safety.", "name": "TERRAPIN", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "The knocking quickens.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "Frantic.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "The cold lock door begins to frost over from the outside.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "Voss grabs a wrench off Koji's belt.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "Runs.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "The others follow.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "action", "text": "The drums turn on, spinning white sheets in empty light.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4]}]}