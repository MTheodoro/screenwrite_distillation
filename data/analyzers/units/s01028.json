{"scene_id": "s01028", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01028.fountain", "heading": "INT. DERELICT ORBITAL STATION - OBSERVATION RING - CONTINUOUS", "cast": [{"id": 0, "name": "ORSOLYA", "names": ["ORSOLYA"], "gender": "f", "first": 4, "spoke": 11}, {"id": 1, "name": "TAVI", "names": ["TAVI"], "gender": "m", "first": 5, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. DERELICT ORBITAL STATION - OBSERVATION RING - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Frost on the viewport.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Beyond it, a gas giant fills the sky, banded and indifferent.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Emergency lights pulse amber.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ORSOLYA, 40s, scavenger's patched suit, helmet clipped to her hip, drifts along a handrail.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "TAVI, 20s, tool belt too big for him, follows with a lantern.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "She stops.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Taps the wall.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Listens.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Anyone aboard. We're salvage. We mean no harm.", "name": "ORSOLYA", "speaker": 0, "ext": [], "paren": ["to the empty ring"], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Frost ticks on the glass.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Maybe just--", "name": "TAVI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She raises a hand.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He stops.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Anyone aboard.", "name": "ORSOLYA", "speaker": 0, "ext": [], "paren": ["again, louder"], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "A pause.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Nothing.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She nods once, as if she expected nothing.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She opens a wall panel.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Wiring shredded.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Burned.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Not an accident.", "name": "ORSOLYA", "speaker": 0, "ext": ["CONT'D"], "paren": ["muttering"], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "What?", "name": "TAVI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Nothing. Hold the light.", "name": "ORSOLYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "He holds it.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "His hand trembles.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "The beam shakes across the wires.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "She notices.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Says nothing.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Takes the lantern from him.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Hands him a screwdriver instead.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Twelve screws. Take the plate off.", "name": "ORSOLYA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "He works.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Slowly.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "His eyes keep sliding to the viewport.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "A thud rolls through the ring.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Metal on metal, somewhere aft.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Both freeze.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "That was close.", "name": "TAVI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "That was far.", "name": "ORSOLYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "It sounded close.", "name": "TAVI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Far things sound close in a hull.", "name": "ORSOLYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "She doesn't sound sure.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "Her thumb strokes the edge of the lantern.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "The thud again.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Louder.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Then a long scrape.", "para": 13, "sent": 2, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Tavi drops the screwdriver.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "It floats, tumbling.", "para": 14, "sent": 1, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Everyone stay where you are. This is a recovery crew. We're leaving in five minutes.", "name": "ORSOLYA", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the ring, calm"], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "There's no one here.", "name": "TAVI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "I know.", "name": "ORSOLYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "She grabs his sleeve.", "para": 15, "sent": 0, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "Tows him toward the airlock.", "para": 15, "sent": 1, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "Her grip is gentle.", "para": 15, "sent": 2, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "Too gentle.", "para": 15, "sent": 3, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "They reach the hatch.", "para": 16, "sent": 0, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "She spins the wheel.", "para": 16, "sent": 1, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "It opens onto the cold, bright tunnel of their own ship.", "para": 16, "sent": 2, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "She pushes him through first.", "para": 17, "sent": 0, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "You okay?", "name": "TAVI", "speaker": 1, "ext": [], "paren": ["over his shoulder"], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "Fine.", "name": "ORSOLYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "She follows.", "para": 18, "sent": 0, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "Looks back once.", "para": 18, "sent": 1, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "The ring is quiet, amber, still.", "para": 18, "sent": 2, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "Then, from the dark, one more knock.", "para": 19, "sent": 0, "present": [0, 1]}, {"u": 67, "kind": "action", "text": "Small.", "para": 19, "sent": 1, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "Almost polite.", "para": 19, "sent": 2, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "She seals the hatch.", "para": 20, "sent": 0, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "Five minutes.", "name": "ORSOLYA", "speaker": 0, "ext": ["CONT'D"], "paren": ["to herself"], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "She doesn't move for a long time.", "para": 21, "sent": 0, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "Tavi picks up the lantern and sets it between them, lighting both their faces.", "para": 21, "sent": 1, "present": [0, 1]}]}