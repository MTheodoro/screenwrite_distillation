: [0]}, {"u": 15, "kind": "action", "text": "Clutches it to his chest.", "para": 4, "sent": 1, "present": [0]}, {"u": 16, "kind": "action", "text": "Smiling.", "para": 4, "sent": 2, "present": [0]}, {"u": 17, "kind": "dialogue", "text": "Quick wins. Low-hanging fruit. Circle back. Ping me.", "name": "DARRYL", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 18, "kind": "action", "text": "He drops the stapler.", "para": 5, "sent": 0, "present": [0]}, {"u": 19, "kind": "action", "text": "Picks up a mug: WORLD'S OKAYEST EMPLOYEE.", "para": 5, "sent": 1, "present": [0]}, {"u": 20, "kind": "dialogue", "text": "Great job, team!", "name": "DARRYL", "speaker": 0, "ext": [], "paren": ["to the room, bright"], "dual": false, "present": [0]}, {"u": 21, "kind": "action", "text": "No one answers.", "para": 6, "sent": 0, "present": [0]}, {"u": 22, "kind": "action", "text": "Forty monitors glow.", "para": 6, "sent": 1, "present": [0]}, {"u": 23, "kind": "dialogue", "text": "We are so aligned.", "name": "DARRYL", "speaker": 0, "ext": ["CONT'D"], "paren": ["muttering"], "dual": false, "present": [0]}, {"u": 24, "kind": "action", "text": "He sips from the empty mug.", "para": 7, "sent": 0, "present": [0]}, {"u": 25, "kind": "action", "text": "Sets it down.", "para": 7, "sent": 1, "present": [0]}, {"u": 26, "kind": "action", "text": "Smiles.", "para": 7, "sent": 2, "present": [0]}]}