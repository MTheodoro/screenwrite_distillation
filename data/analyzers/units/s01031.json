{"scene_id": "s01031", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01031.fountain", "heading": "EXT. SUNSET GARDENS RETIREMENT HOME - BOCCE COURT - DAY", "cast": [{"id": 0, "name": "BERTIE", "names": ["BERTIE"], "gender": "?", "first": 3, "spoke": 5}, {"id": 1, "name": "MOSCATO", "names": ["MOSCATO"], "gender": "?", "first": 3, "spoke": 0}, {"id": 2, "name": "LOU", "names": ["LOU"], "gender": "?", "first": 4, "spoke": 3}, {"id": 3, "name": "GENOVESE", "names": ["GENOVESE"], "gender": "?", "first": 4, "spoke": 0}, {"id": 4, "name": "HIRO NAKAMURA", "names": ["HIRO NAKAMURA", "HIRO"], "gender": "?", "first": 10, "spoke": 3}, {"id": 5, "name": "DORIS PELLEGRINO", "names": ["DORIS PELLEGRINO", "DORIS"], "gender": "?", "first": 14, "spoke": 2}, {"id": 6, "name": "SKIP", "names": ["SKIP"], "gender": "?", "first": 24, "spoke": 2}, {"id": 7, "name": "TATE", "names": ["TATE"], "gender": "?", "first": 24, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SUNSET GARDENS RETIREMENT HOME - BOCCE COURT - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Crushed oyster-shell lane, green benches, a hand-painted banner: LEAGUE FINALS.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Folding chairs full of cardigans.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "ALBERTINA \"BERTIE\" MOSCATO, 80, pearls, steel spine, rolls her wrist like a bishop blessing.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "LOU \"THE HAMMER\" GENOVESE, 82, undershirt, arms like cured hams, glares from the other end.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 5, "kind": "action", "text": "Bertie lets fly.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "action", "text": "The ball skims, kisses the pallino.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "Applause.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Beat that, Hammer!", "name": "BERTIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "I've beaten better, Bertie!", "name": "LOU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "HIRO NAKAMURA, 78, referee, pressed shirt, kneels with a tape measure.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "He measures.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Looks up.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Bertie leads by half an inch.", "name": "HIRO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "DORIS PELLEGRINO, 75, Lou's partner, sun visor, mutters.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Half an inch. I've had longer lunches.", "name": "DORIS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Lou steps to the line.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Spits on his palm.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Rolls.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "The ball veers left, strikes Bertie's ball, scatters it.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "The crowd gasps.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Ha!", "name": "LOU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Cheat!", "name": "BERTIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Legal. Lou leads.", "name": "HIRO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "ORVILLE \"SKIP\" TATE, 85, Bertie's partner, wheelchair, a blanket across his knees, rolls up.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 25, "kind": "dialogue", "text": "Bertie, you owe me three dollars if you lose.", "name": "SKIP", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 26, "kind": "dialogue", "text": "Skip, I never lose.", "name": "BERTIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 27, "kind": "dialogue", "text": "Ninety-one losses, Bertie. I counted.", "name": "SKIP", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 28, "kind": "dialogue", "text": "Quiet, you old goat.", "name": "BERTIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 29, "kind": "action", "text": "She picks up the last ball.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "action", "text": "Stares down the court.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "action", "text": "Quiet descends.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "action", "text": "A wind chime tinkles.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "action", "text": "She steps.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "action", "text": "Swings.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "action", "text": "Lets go.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "action", "text": "The ball curves, ticks the fence, rolls, and stops dead against the pallino.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "action", "text": "Silence.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "action", "text": "Then an uproar.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "dialogue", "text": "Hiro, it's wood. Look at the grain!", "name": "DORIS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "dialogue", "text": "Bertie wins.", "name": "HIRO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 41, "kind": "dialogue", "text": "Rematch.", "name": "LOU", "speaker": 2, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 42, "kind": "dialogue", "text": "Next Sunday, Hammer. Bring your checkbook.", "name": "BERTIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}