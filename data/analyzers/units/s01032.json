{"scene_id": "s01032", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01032.fountain", "heading": "INT. SUGAR MILL - BOILING FLOOR - NIGHT", "cast": [{"id": 0, "name": "JETHRO MALLORY", "names": ["JETHRO MALLORY", "JETHRO"], "gender": "m", "first": 6, "spoke": 12}, {"id": 1, "name": "PILAR ESCOBEDO", "names": ["PILAR ESCOBEDO", "PILAR"], "gender": "f", "first": 7, "spoke": 13}, {"id": 2, "name": "HENRIK SOLBERG", "names": ["HENRIK SOLBERG", "HENRIK"], "gender": "m", "first": 8, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. SUGAR MILL - BOILING FLOOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cavernous hall of copper vats, rafters lost in steam.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A table has been dragged to the center, a thick plank on two barrels.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Folding chairs ring it.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Crates of burlap sacks serve as bleachers.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Lanterns hang from hooks.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "JETHRO MALLORY, 40s, shirtless under a leather apron, shoulders like sacks of grain, sits at one side of the table.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Across from him, PILAR ESCOBEDO, 20s, rolled sleeves, braid down her back, calm as a tide pool.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Between them, HENRIK SOLBERG, 60s, referee, rubs his hands in chalk and sets them on top of theirs.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Elbows on the pads. Grips locked.", "name": "HENRIK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Jethro grips.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Pilar grips.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Their knuckles whiten.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Ready?", "name": "HENRIK", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Born ready.", "name": "JETHRO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Skip the speech.", "name": "PILAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Go!", "name": "HENRIK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Both tense.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "The table groans.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "A vein rises on Jethro's neck.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Pilar's jaw clenches.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Neither moves.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "The crowd begins a low chant: Jeth-ro.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Jeth-ro.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "You sweat a lot.", "name": "PILAR", "speaker": 1, "ext": [], "paren": ["through teeth"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "It's a sweaty room.", "name": "JETHRO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Your wife make that apron?", "name": "PILAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "My mother.", "name": "JETHRO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "She loves you.", "name": "PILAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Shut up.", "name": "JETHRO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Henrik crouches, eyes on the hands.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Sweat drips from Jethro's nose onto the plank.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Pilar shifts her weight.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Her free hand grips the table's edge.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Jethro's arm trembles, a small tremor.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Hers does too.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "They breathe together, in, out.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Hold your lines.", "name": "HENRIK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Jethro surges.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "His hand pushes hers an inch toward the pad.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "The crowd roars.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Not yet.", "name": "PILAR", "speaker": 1, "ext": [], "paren": ["gasping"], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "She drives back.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "His arm straightens.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Equal again.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Both freeze.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Both stare.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Neither blinks.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "You're good.", "name": "JETHRO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "My father taught me. At a mill like this.", "name": "PILAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Where?", "name": "JETHRO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Matanzas.", "name": "PILAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "I had a cousin in Matanzas.", "name": "JETHRO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Everyone does.", "name": "PILAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "They laugh, tight and brief.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "The effort cracks it.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Jethro lunges again.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "The table skids across the floor.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Henrik leaps clear.", "para": 13, "sent": 2, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Chairs topple.", "para": 13, "sent": 3, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "The crowd scatters back as the barrels shift.", "para": 13, "sent": 4, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "Pilar twists, wrenches her shoulder, slams the back of his hand toward the pad.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "It stops an inch from the wood.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "Both grunt.", "para": 14, "sent": 2, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "Hold! Hold! The table!", "name": "HENRIK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "They don't hold.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "They are locked.", "para": 15, "sent": 1, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "The table tilts.", "para": 15, "sent": 2, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "They tumble together onto the sacks, hands still clasped, wrestling.", "para": 15, "sent": 3, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "Henrik blows a whistle.", "para": 16, "sent": 0, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "No one hears.", "para": 16, "sent": 1, "present": [0, 1, 2]}, {"u": 71, "kind": "dialogue", "text": "Pad's behind you!", "name": "PILAR", "speaker": 1, "ext": [], "paren": ["rolling"], "dual": false, "present": [0, 1, 2]}, {"u": 72, "kind": "dialogue", "text": "Is not!", "name": "JETHRO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 73, "kind": "dialogue", "text": "It is! It's behind you both!", "name": "HENRIK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 74, "kind": "action", "text": "They tumble over the barrels, bounce against a vat, freeze.", "para": 17, "sent": 0, "present": [0, 1, 2]}, {"u": 75, "kind": "action", "text": "Steam hisses.", "para": 17, "sent": 1, "present": [0, 1, 2]}, {"u": 76, "kind": "action", "text": "Their joined hands hover above a sack of raw sugar.", "para": 17, "sent": 2, "present": [0, 1, 2]}, {"u": 77, "kind": "action", "text": "Neither willing to break.", "para": 17, "sent": 3, "present": [0, 1, 2]}, {"u": 78, "kind": "dialogue", "text": "Truce?", "name": "PILAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 79, "kind": "dialogue", "text": "Till dawn.", "name": "JETHRO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 80, "kind": "dialogue", "text": "Dawn's fine.", "name": "PILAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 81, "kind": "action", "text": "They let go together.", "para": 18, "sent": 0, "present": [0, 1, 2]}, {"u": 82, "kind": "action", "text": "Both slump on the sacks, panting.", "para": 18, "sent": 1, "present": [0, 1, 2]}, {"u": 83, "kind": "dialogue", "text": "Draw! The match is a draw!", "name": "HENRIK", "speaker": 2, "ext": [], "paren": ["to the crowd"], "dual": false, "present": [0, 1, 2]}, {"u": 84, "kind": "action", "text": "A cheer, ragged.", "para": 19, "sent": 0, "present": [0, 1, 2]}, {"u": 85, "kind": "action", "text": "Jethro and Pilar lie there staring at the rafters, arms spread, hands shaking.", "para": 19, "sent": 1, "present": [0, 1, 2]}, {"u": 86, "kind": "dialogue", "text": "Again?", "name": "JETHRO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 87, "kind": "dialogue", "text": "Tomorrow.", "name": "PILAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 88, "kind": "dialogue", "text": "Bring your father.", "name": "JETHRO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 89, "kind": "dialogue", "text": "He's dead.", "name": "PILAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 90, "kind": "dialogue", "text": "Then bring his arm.", "name": "JETHRO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 91, "kind": "action", "text": "Pilar smiles, for the first time.", "para": 20, "sent": 0, "present": [0, 1, 2]}, {"u": 92, "kind": "action", "text": "She sits up and reaches for the table.", "para": 20, "sent": 1, "present": [0, 1, 2]}, {"u": 93, "kind": "dialogue", "text": "You people are insane.", "name": "HENRIK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 94, "kind": "action", "text": "She slams her elbow on the plank.", "para": 21, "sent": 0, "present": [0, 1, 2]}, {"u": 95, "kind": "action", "text": "Jethro hauls himself up and does the same.", "para": 21, "sent": 1, "present": [0, 1, 2]}, {"u": 96, "kind": "action", "text": "The crowd goes silent.", "para": 21, "sent": 2, "present": [0, 1, 2]}, {"u": 97, "kind": "dialogue", "text": "Ready?", "name": "HENRIK", "speaker": 2, "ext": ["CONT'D"], "paren": ["sighing"], "dual": false, "present": [0, 1, 2]}]}