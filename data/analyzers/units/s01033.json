{"scene_id": "s01033", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01033.fountain", "heading": "INT. FUNICULAR CAR - MID-SLOPE - NIGHT", "cast": [{"id": 0, "name": "AUGUST MWANGI", "names": ["AUGUST MWANGI", "AUGUST"], "gender": "?", "first": 5, "spoke": 9}, {"id": 1, "name": "SILAS DRAKEFORD", "names": ["SILAS DRAKEFORD", "SILAS"], "gender": "m", "first": 7, "spoke": 7}, {"id": 2, "name": "ZOFIA BR", "names": ["ZOFIA BR", "ZOFIA"], "gender": "?", "first": 38, "spoke": 4}, {"id": 3, "name": "TEN", "names": ["TEN"], "gender": "?", "first": 38, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. FUNICULAR CAR - MID-SLOPE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Stalled.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wooden benches, brass rails.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Outside, black pines and a thousand feet of dark.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Wind rocks the car on its cable.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "AUGUST MWANGI, 40s, charcoal coat, gloved hands folded, sits very still.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Tall, calm, eyes of a chess player.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Across from him, SILAS DRAKEFORD, 40s, wet hair, a bruise ripening on his cheekbone, grips a leather briefcase to his chest.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You pulled the brake.", "name": "SILAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I pulled nothing.", "name": "AUGUST", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Then who did?", "name": "SILAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "The cable did what cables do.", "name": "AUGUST", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Silas shifts.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "His hand slides toward his pocket.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "August watches it.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Don't.", "name": "AUGUST", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "I wasn't.", "name": "SILAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Then he wouldn't have said I was.", "name": "AUGUST", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Who?", "name": "SILAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "You know who.", "name": "AUGUST", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Silas swallows.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "His eyes dart to the window.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Nothing but pine and fog.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "He told you I took it.", "name": "SILAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "He told me you were smart. And that smart men carry briefcases.", "name": "AUGUST", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Silas laughs, brittle.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "He sets the briefcase on his knees.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Clasps it shut.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "A scrape.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "On the roof.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Both men look up.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Deer.", "name": "AUGUST", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "On a funicular?", "name": "SILAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Another scrape, heavier.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "The car sways.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "The roof hatch slams open.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "A boot drops through.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Then a leg.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Then a woman, ZOFIA BR\u00c5TEN, 30s, climbing gear, ice axe, headlamp blazing.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "She lands in a crouch, axe leveled.", "para": 8, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Nobody move.", "name": "ZOFIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Both men raise their hands.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "She sweeps the light across them, lands on August.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "You. Open the briefcase.", "name": "ZOFIA", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "It's his.", "name": "AUGUST", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Then you.", "name": "ZOFIA", "speaker": 2, "ext": [], "paren": ["to Silas"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Silas hesitates.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "His hand shakes.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "He unlatches.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Flips the lid.", "para": 10, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Inside, nothing.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Foam padding, cut to hold something that's no longer there.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Where is it?", "name": "ZOFIA", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "I don't know.", "name": "SILAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "August smiles.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Slowly lowers his hands.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "He knows.", "name": "AUGUST", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "He nods at the window.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "On the glass, a small hand-shaped print.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "On the outside.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "The car lurches.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "Falls ten feet and catches.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "All three scream.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}]}