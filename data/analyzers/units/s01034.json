{"scene_id": "s01034", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01034.fountain", "heading": "INT. TAXIDERMY WORKSHOP - NIGHT", "cast": [{"id": 0, "name": "BEATRIX CALLOWAY", "names": ["BEATRIX CALLOWAY", "BEATRIX"], "gender": "?", "first": 3, "spoke": 2}, {"id": 1, "name": "NICO ABARA", "names": ["NICO ABARA", "NICO"], "gender": "?", "first": 3, "spoke": 2}, {"id": 2, "name": "FENWICK", "names": ["FENWICK"], "gender": "?", "first": 3, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. TAXIDERMY WORKSHOP - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Glass eyes glitter from every shelf.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A stuffed owl, a lynx mid-leap, a badger with a crooked grin.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "BEATRIX CALLOWAY, 50s, magnifier on her forehead, kneels by an open drawer while NICO ABARA, 20s, apprentice, holds the lantern and FENWICK, 70s, owner, stands rigid at the door, fingers twitching, and all three have noticed that the fox on the counter is missing its left eye.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 4, "kind": "dialogue", "text": "Fenwick, you said nobody came in.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "Nobody did, Beatrix.", "name": "FENWICK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "The fox, Mr. Fenwick. Look at the fox.", "name": "NICO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Beatrix lifts the animal, turns it, peers into the empty socket, pulls a folded note from inside, and Nico leans in, lantern shaking, while Fenwick edges toward the back door, one hand in his coat.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Stop there, Fenwick.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "It's a misunderstanding.", "name": "FENWICK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "It says \"the eye is in the owl.\"", "name": "NICO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "They all turn.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "The owl stares back.", "para": 3, "sent": 1, "present": [0, 1, 2]}]}