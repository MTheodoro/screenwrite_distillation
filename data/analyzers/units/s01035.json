{"scene_id": "s01035", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01035.fountain", "heading": "INT. QUARANTINED CRUISE SHIP - GIFT SHOP - NIGHT", "cast": [{"id": 0, "name": "RENATA KOVAC", "names": ["RENATA KOVAC", "RENATA"], "gender": "f", "first": 5, "spoke": 8}, {"id": 1, "name": "MILES TOBIN", "names": ["MILES TOBIN", "MILES"], "gender": "m", "first": 6, "spoke": 7}, {"id": 2, "name": "ADEBAYO ROSS", "names": ["ADEBAYO ROSS", "ADEBAYO"], "gender": "?", "first": 7, "spoke": 5}, {"id": 3, "name": "CAPTAIN HALE", "names": ["CAPTAIN HALE"], "gender": "?", "first": 9, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. QUARANTINED CRUISE SHIP - GIFT SHOP - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Shelves of magnets, snow globes, sunscreen.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The registers are dark.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Emergency strips light the floor.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Through the glass storefront, an empty promenade deck rocks gently at anchor.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "RENATA KOVAC, 40s, ship's purser, hair in a messy bun, uniform jacket unbuttoned, sits behind the counter with a radio on her knee.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "MILES TOBIN, 30s, ship's doctor, mask around his chin, leans on a shelf.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "ADEBAYO ROSS, 50s, passenger, bathrobe, paper slippers, pretends to read a paperback.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "The radio crackles.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Shop, this is the bridge. Status.", "name": "CAPTAIN HALE", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Three souls, sir. All calm.", "name": "RENATA", "speaker": 0, "ext": [], "paren": ["into radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Keep them there. We've got a boat coming at dawn.", "name": "CAPTAIN HALE", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Understood.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "She sets the radio down.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "The silence returns.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Two weeks on a boat, and the one thing they sell me is snow globes.", "name": "ADEBAYO", "speaker": 2, "ext": [], "paren": ["to no one"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "You can have mine.", "name": "MILES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Does it come with a cure?", "name": "ADEBAYO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "It comes with a mild placebo effect.", "name": "MILES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Adebayo laughs, then coughs.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Miles straightens, watches him.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Sir, how long has that been going?", "name": "MILES", "speaker": 1, "ext": ["CONT'D"], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "It's a tickle.", "name": "ADEBAYO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "How long?", "name": "MILES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Since Tuesday.", "name": "ADEBAYO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Renata stiffens.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "She slides her hand slowly toward the radio.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Everyone stay exactly where you are.", "name": "RENATA", "speaker": 0, "ext": [], "paren": ["to all"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Renata.", "name": "MILES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Don't.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "He's not necessarily--", "name": "MILES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "You said no one on this deck was symptomatic.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Miles opens his mouth.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Closes it.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "I should've stayed in the cabin.", "name": "ADEBAYO", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "The storefront lights flicker.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Outside, a searchlight sweeps the promenade.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Then a second.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Then a third, from a hull that isn't theirs.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "That's not the dawn boat.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "No.", "name": "MILES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "She lifts the radio.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Bridge, we have lights on the promenade.", "name": "RENATA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Static.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Nothing.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "She tries again.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Bridge?", "name": "RENATA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Don't open the door. They're not ours.", "name": "CAPTAIN HALE", "speaker": 3, "ext": ["V.O."], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}]}