{"scene_id": "s01036", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01036.fountain", "heading": "INT. THORNQUIST DRESSMAKER'S SHOP - LONDON - DAY (1893)", "cast": [{"id": 0, "name": "AGNES THORNQUIST", "names": ["AGNES THORNQUIST", "AGNES"], "gender": "f", "first": 3, "spoke": 6}, {"id": 1, "name": "DELPHINE ARCHAMBAULT", "names": ["DELPHINE ARCHAMBAULT", "DELPHINE"], "gender": "f", "first": 4, "spoke": 5}, {"id": 2, "name": "COLONEL ASHBY-GREY", "names": ["COLONEL ASHBY-GREY", "ASHBY-GREY"], "gender": "f", "first": 6, "spoke": 8}, {"id": 3, "name": "YUSUF HADDAD", "names": ["YUSUF HADDAD", "YUSUF"], "gender": "?", "first": 7, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. THORNQUIST DRESSMAKER'S SHOP - LONDON - DAY (1893)", "present": []}, {"u": 1, "kind": "action", "text": "Bolts of silk, a cutting table, a brass dummy in half-pinned lilac.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rain at the window.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "AGNES THORNQUIST, 40s, pins in her mouth, kneels to a hem.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "DELPHINE ARCHAMBAULT, 20s, in her slip, stands on a footstool, arms out.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Her eyes avoid the mirror.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "COLONEL ASHBY-GREY, 60s, enters in a damp greatcoat.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "YUSUF HADDAD, 30s, tailor's apprentice, follows with a tape over his shoulder.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Miss Archambault. Your father sends his regards.", "name": "ASHBY-GREY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "How kind.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "He sets his hat on the cutting table.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Agnes takes the pins from her mouth.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Colonel. We weren't expecting you.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "One doesn't schedule a wedding fitting.", "name": "ASHBY-GREY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "It's not yet a wedding.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "It will be Saturday.", "name": "ASHBY-GREY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Delphine's arm drops an inch.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Agnes taps it back up.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Steady, dear.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Yusuf unrolls the tape.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Measures the waist.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Says nothing.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "His fingers tremble.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Tighter at the bodice. The family insists.", "name": "ASHBY-GREY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "She'll not breathe.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "She'll not need to.", "name": "ASHBY-GREY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "A silence.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Rain hits the glass.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Delphine looks into the mirror for the first time.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "At herself.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "At Yusuf behind her.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Mr. Haddad. Is the silk imported?", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "From Damascus, miss.", "name": "YUSUF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "How far is that?", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Very far.", "name": "YUSUF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "How long would it take to go?", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Ashby-Grey turns.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "His eyes narrow.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Miss Archambault.", "name": "ASHBY-GREY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Merely curious.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Agnes rises, sets her pins down, and smooths the bodice.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Her thumb brushes Delphine's wrist.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "A pulse passes between them.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Quick, quiet.", "para": 9, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "I'll let out the seam tonight.", "name": "AGNES", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Pardon?", "name": "ASHBY-GREY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "I said I'll take in the seam tonight.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Ashby-Grey studies her.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Then Yusuf.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Then the door.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Saturday. Ten sharp.", "name": "ASHBY-GREY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "He takes his hat and leaves.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "The bell tinkles.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "The latch clicks.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Nobody moves.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Then Delphine steps down off the stool, slow, as if it were a scaffold.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}]}