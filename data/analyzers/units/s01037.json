{"scene_id": "s01037", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01037.fountain", "heading": "INT. ROTATING RESTAURANT - TOWER SUMMIT - NIGHT", "cast": [{"id": 0, "name": "ROZ KAPLAN", "names": ["ROZ KAPLAN", "ROZ"], "gender": "f", "first": 4, "spoke": 28}, {"id": 1, "name": "TREVOR DUNN", "names": ["TREVOR DUNN", "TREVOR"], "gender": "?", "first": 5, "spoke": 12}, {"id": 2, "name": "NEW GIRL", "names": ["NEW GIRL"], "gender": "?", "first": 6, "spoke": 3}, {"id": 3, "name": "SUNNY", "names": ["SUNNY"], "gender": "f", "first": 13, "spoke": 20}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROTATING RESTAURANT - TOWER SUMMIT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A circular room on a slow turn.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The city slides past the windows like a conveyor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "White tablecloths, empty chairs, a pianist's bench with no pianist.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ROZ KAPLAN, 50s, silver bob, red lipstick, sits at a corner table with a blueprint under her wine glass.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Opposite her, TREVOR DUNN, 30s, hotel uniform, nervous hands.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "A NEW GIRL, 20s, denim jacket, backpack, slides into the third chair without being invited.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Sorry I'm late. The elevator stopped at every floor.", "name": "NEW GIRL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "It's a tourist elevator.", "name": "ROZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "It was a hostage situation.", "name": "NEW GIRL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "You've got the codes?", "name": "ROZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I've got the codes.", "name": "NEW GIRL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Who is she?", "name": "TREVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Trevor, this is Sunny Lockwood. She's the one I told you about.", "name": "ROZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Nice to meet you. I'm the one with the thumbs.", "name": "SUNNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "The thumbs?", "name": "TREVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Locksmith's daughter. Four generations of thumbs.", "name": "SUNNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "She's good. She's very good. She's also nineteen.", "name": "ROZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Twenty-one.", "name": "TREVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Twenty. Don't lie for me.", "name": "SUNNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Let's start. The vault is on sixty-one, under the observation deck. Every ninety minutes the restaurant makes a full revolution. We have exactly four minutes where the north camera faces the wall.", "name": "ROZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Because of the rotation.", "name": "TREVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Because of the rotation. Sunny takes the first lock. I take the second. Trevor, you stay at the maitre d' stand and pour wine.", "name": "ROZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "I can pour wine.", "name": "TREVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "You can pour wine badly. That's all anyone expects.", "name": "ROZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "What's the haul?", "name": "SUNNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Eleven million. Bearer bonds. In a briefcase that looks like a briefcase.", "name": "ROZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Eleven's good. What's my cut?", "name": "SUNNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Two.", "name": "ROZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Three.", "name": "SUNNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Two and a half.", "name": "ROZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "She drives a hard bargain.", "name": "SUNNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "She who?", "name": "TREVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Roz. It's a figure of speech. I'm talking about Roz.", "name": "SUNNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "I know who you mean.", "name": "ROZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "She counts every penny.", "name": "SUNNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "She buys every drink. Shut up and listen.", "name": "ROZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Trevor pours wine for no one.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "The glass fills.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "He sets the bottle down too hard.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "After the second lock, there's a pneumatic tube. Documents only. We use it to send the bonds down to the kitchen.", "name": "ROZ", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "They go down by tube.", "name": "TREVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "They go down by tube. At the kitchen, Marguerite takes them in a casserole dish.", "name": "ROZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Who's Marguerite?", "name": "SUNNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "My sister.", "name": "ROZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "You have a sister?", "name": "SUNNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Everyone has a sister.", "name": "ROZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "I don't.", "name": "TREVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Then you're lucky.", "name": "ROZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "What about security?", "name": "SUNNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Two guards. One reads novels. The other sleeps. We tested them for six weeks.", "name": "ROZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Six weeks of watching a man read a novel.", "name": "SUNNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "It was a Dickens.", "name": "ROZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Which?", "name": "SUNNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Bleak House.", "name": "ROZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Oh, I like her.", "name": "SUNNY", "speaker": 3, "ext": [], "paren": ["laughing"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Who?", "name": "TREVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "Roz. You keep asking.", "name": "SUNNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "Pay attention. Revolution starts at eleven forty. We're in position by eleven thirty. Questions?", "name": "ROZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "What if the guard doesn't sleep?", "name": "TREVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "Then I buy him a drink.", "name": "ROZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "What if he doesn't drink?", "name": "SUNNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "Everyone drinks, sweetheart.", "name": "ROZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "What if the vault door is a different model?", "name": "SUNNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "It isn't.", "name": "ROZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "What if it is?", "name": "SUNNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "Then you'll earn your three.", "name": "ROZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "Three?", "name": "SUNNY", "speaker": 3, "ext": [], "paren": ["grinning"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "Two and a half. Don't push.", "name": "ROZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "The room turns.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "The city lights drift past, one landmark after another.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "dialogue", "text": "It's a little beautiful, actually.", "name": "TREVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "It's a job, Trevor.", "name": "ROZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "Can it be both?", "name": "TREVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "dialogue", "text": "No.", "name": "ROZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "Sunny lifts her glass.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "Roz clinks it.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "Trevor, last, doesn't quite reach.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}]}