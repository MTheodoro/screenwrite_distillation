{"scene_id": "s01038", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01038.fountain", "heading": "INT. FUNERAL HOME - VIEWING ROOM B - DAY", "cast": [{"id": 0, "name": "ELOISE FARNSWORTH", "names": ["ELOISE FARNSWORTH", "ELOISE"], "gender": "f", "first": 4, "spoke": 4}, {"id": 1, "name": "CAMILA BRANDAO", "names": ["CAMILA BRANDAO", "BRANDAO"], "gender": "?", "first": 5, "spoke": 2}, {"id": 2, "name": "DOROTHEA KWAN", "names": ["DOROTHEA KWAN", "KWAN"], "gender": "?", "first": 6, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. FUNERAL HOME - VIEWING ROOM B - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Velvet drapes.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A casket at the far end, closed, spray of lilies.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Folding chairs facing a mahogany table, court reporter's stenotype ticking beside it.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ELOISE FARNSWORTH, 70s, black gloves, rosary wrapped around one hand, sits very straight.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "On her left, CAMILA BRANDAO, 40s, her attorney, legal pad flat.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Across the table, DOROTHEA KWAN, 50s, opposing counsel, reading glasses on a chain.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Mrs. Farnsworth, when did you last see your husband alive?", "name": "KWAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Tuesday.", "name": "ELOISE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "And the will?", "name": "KWAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Eloise's rosary clicks once.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "What about it?", "name": "ELOISE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Did she witness it?", "name": "KWAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Objection. Who's \"she\"?", "name": "BRANDAO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "The nurse.", "name": "KWAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Mrs. Okafor.", "name": "ELOISE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "She told us she wasn't present.", "name": "KWAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Eloise stares at the casket.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Her fingers work the beads, one, two, three.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Let the record show my client has not been served that statement.", "name": "BRANDAO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "It's in your folder.", "name": "KWAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Brandao flips pages.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Stops.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Her thumb presses a corner of paper until it whitens.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "I'd like some water.", "name": "ELOISE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Kwan nods to the reporter.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "A pitcher is brought.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Eloise's glove shakes as she lifts the cup, then stills.", "para": 5, "sent": 2, "present": [0, 1, 2]}]}