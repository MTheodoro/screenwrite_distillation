{"scene_id": "s01039", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01039.fountain", "heading": "INT. SUDS-N-DUDS LAUNDROMAT - NIGHT", "cast": [{"id": 0, "name": "NADIA BELOV", "names": ["NADIA BELOV", "NADIA"], "gender": "?", "first": 3, "spoke": 8}, {"id": 1, "name": "TUCKER SHAW", "names": ["TUCKER SHAW", "TUCKER"], "gender": "m", "first": 5, "spoke": 7}, {"id": 2, "name": "MARISOL OYELOWO", "names": ["MARISOL OYELOWO", "MARISOL"], "gender": "?", "first": 6, "spoke": 5}, {"id": 3, "name": "WALTER DIBBLE", "names": ["WALTER DIBBLE", "WALTER"], "gender": "?", "first": 25, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. SUDS-N-DUDS LAUNDROMAT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Humming dryers, orange plastic chairs bolted to the floor, a vending machine selling single-serve detergent.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A TV on a bracket plays the weather, muted.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "NADIA BELOV, 40s, scrubs under a parka, feeds quarters into a washer.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "Her shoes are still wet.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "action", "text": "TUCKER SHAW, 20s, in a hockey jersey, sits on a folding table with a cardboard cup of coffee, scrolling his phone.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "MARISOL OYELOWO, 30s, in a hoodie, dumps a bag of towels into the next machine.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Is this one broken?", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "It eats quarters. But it works.", "name": "TUCKER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Great.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Try hitting the side.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Nadia hits the side.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "The washer coughs and starts.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Thanks.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Everybody does it.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Tucker sips.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Looks at the TV.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Snow, again.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "They said it'd stop by nine.", "name": "TUCKER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "They say a lot of things.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "It's ten thirty.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Then we're all in this together.", "name": "TUCKER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "A silence.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "The dryers hum on.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The door chimes.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "WALTER DIBBLE, 80s, in pajama bottoms and a trench coat, shuffles in dragging a laundry bag like a body.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "He looks at the three of them, then at the machines, then at the sign.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Is there a machine that takes dollars?", "name": "WALTER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Just the change machine, sir.", "name": "TUCKER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "It's out of order.", "name": "WALTER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "It's been out of order for a year.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "I have quarters.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "I'd pay you back.", "name": "WALTER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "It's fine.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "She counts out eight quarters and hands them over.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "He holds them like a collection plate.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Bless you.", "name": "WALTER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "You got somewhere to be?", "name": "TUCKER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Only here.", "name": "WALTER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "He loads a machine.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Closes the lid slowly, patiently, as if it were a casket.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Starts it.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "The drum begins to turn.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Is your wife--", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "She's passed. Last spring. I never learned how.", "name": "WALTER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "It's not hard.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "It's not hard.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "They say it together, same moment, same tone.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "They look at each other.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Smile.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Tucker slides off the table.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Hey, Walter. Come sit.", "name": "TUCKER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "I'm all right.", "name": "WALTER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Come sit anyway.", "name": "TUCKER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Walter hesitates.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Then he takes the plastic chair beside Marisol.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Nobody speaks.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "The machines turn.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "The snow keeps falling on the window.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "For a while, it's enough.", "para": 10, "sent": 3, "present": [0, 1, 2, 3]}]}