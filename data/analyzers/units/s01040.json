{"scene_id": "s01040", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01040.fountain", "heading": "INT. TERMINATOR GREENHOUSE - TIDALLY LOCKED WORLD - TWILIGHT", "cast": [{"id": 0, "name": "ILSA VANTONGEREN", "names": ["ILSA VANTONGEREN", "ILSA"], "gender": "?", "first": 5, "spoke": 10}, {"id": 1, "name": "BRAM", "names": ["BRAM"], "gender": "f", "first": 7, "spoke": 7}, {"id": 2, "name": "QUILLON", "names": ["QUILLON"], "gender": "m", "first": 21, "spoke": 8}, {"id": 3, "name": "SEPHORA", "names": ["SEPHORA"], "gender": "?", "first": 30, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. TERMINATOR GREENHOUSE - TIDALLY LOCKED WORLD - TWILIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A long glass nave on the border between day and night.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "To the east, a white-hot sun hangs unmoving.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "To the west, black sky and frozen plains.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Inside, tomato vines climb silver wires, heavy with fruit.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ILSA VANTONGEREN, 50s, botanist, hair wrapped in a faded scarf, kneels among the roots.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She hums as she works, one hand cupping a green fruit like a held breath.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "BRAM, 20s, her apprentice, stands behind her.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He holds a tablet and stares at it as if it had insulted him.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Ilsa. The heat sink is at ninety-four.", "name": "BRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Ninety-four of what?", "name": "ILSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Percent.", "name": "BRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She rises slowly.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Her knees crack.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She doesn't look at the tablet.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She looks at the glass.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "It was ninety-one an hour ago.", "name": "ILSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "I know.", "name": "BRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Then why are you telling me like it's news?", "name": "ILSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He swallows.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "He pockets the tablet.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "QUILLON, 30s, the colony's engineer, jogs down the nave, boots clanging on the grating.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "He is out of breath, face slick, goggles pushed up on his forehead.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Ilsa! Bram! The shade array's jammed.", "name": "QUILLON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Jammed how?", "name": "ILSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "It won't rotate. The motor's seized.", "name": "QUILLON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Because of the heat?", "name": "BRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Because of a bolt. Someone put a bolt in the gear.", "name": "QUILLON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Someone?", "name": "ILSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Or something.", "name": "QUILLON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Dr. Sephora Oyama's voice crackles from a speaker in the roof.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Greenhouse, this is Medical. We have a patient with heat stroke in the corridor. Is anyone free to--", "name": "SEPHORA", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "We're busy.", "name": "ILSA", "speaker": 0, "ext": [], "paren": ["cutting in"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Send Quillon!", "name": "BRAM", "speaker": 1, "ext": [], "paren": ["over her"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "I can't, I'm needed here!", "name": "QUILLON", "speaker": 2, "ext": [], "paren": ["over Bram"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Please. She's asking for you, Ilsa.", "name": "SEPHORA", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Ilsa stops.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Her hand falls from the tomato.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "The vines rustle, as if the plants were leaning to listen.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Who is?", "name": "ILSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Your daughter.", "name": "SEPHORA", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "She turns to the glass.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Stares at the white sun.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Her shoulders fall, then straighten.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Bram. Take the tomatoes. All of them. Into the cold room.", "name": "ILSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "All of them?", "name": "BRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "All. Quillon, fix the array. I don't care if you have to swing from it.", "name": "ILSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "And you?", "name": "QUILLON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "I'm going to my daughter.", "name": "ILSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "She is already running.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Her scarf comes loose and trails behind her like a flag.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Bram watches her go.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Quillon grabs his arm.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Come on. We've got maybe ten minutes.", "name": "QUILLON", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Before what?", "name": "BRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Before the glass starts cracking.", "name": "QUILLON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "He is already moving.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Bram scrambles after, arms full of fruit, tomatoes bouncing and rolling across the floor.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}]}