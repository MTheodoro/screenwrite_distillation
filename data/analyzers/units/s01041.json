{"scene_id": "s01041", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01041.fountain", "heading": "INT. ICE-FISHING SHANTY - LAKE SUPERIOR - NIGHT", "cast": [{"id": 0, "name": "HOLLIS MCINTYRE", "names": ["HOLLIS MCINTYRE", "HOLLIS"], "gender": "?", "first": 4, "spoke": 7}, {"id": 1, "name": "MARGOT LEBLANC", "names": ["MARGOT LEBLANC", "MARGOT"], "gender": "f", "first": 5, "spoke": 7}, {"id": 2, "name": "TEDDY ORLOV", "names": ["TEDDY ORLOV", "TEDDY"], "gender": "?", "first": 6, "spoke": 4}, {"id": 3, "name": "BRIGID FALLON", "names": ["BRIGID FALLON", "BRIGID"], "gender": "?", "first": 7, "spoke": 5}, {"id": 4, "name": "ANSEL", "names": ["ANSEL"], "gender": "?", "first": 8, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. ICE-FISHING SHANTY - LAKE SUPERIOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A plywood box on a frozen lake, six by eight, glowing orange from a propane heater.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Four holes drilled in the floor, four lines dropped into black water.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Thermoses, a deck of cards, a battered radio playing country music.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "HOLLIS MCINTYRE, 50s, flannel, beard iced at the tips, sits on an overturned bucket.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "MARGOT LEBLANC, 40s, wool cap, jigs her rod in slow circles.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "TEDDY ORLOV, 12, her nephew, in an oversized snowmobile suit, stares into his hole.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "BRIGID FALLON, 30s, newcomer, borrowed boots, holds a cup of cocoa with both hands.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "ANSEL, 70s, Hollis's father, dozes by the door.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Coldest night of the year, they said.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Warmest, if you're lucky.", "name": "MARGOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Do they bite when it's like this?", "name": "BRIGID", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "They bite when they feel like it.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "I got one!", "name": "TEDDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "All four turn.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Teddy's line goes taut.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "He heaves.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Easy, kiddo!", "name": "MARGOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Let him fight!", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "The rod bends nearly double.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Ice creaks.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Then the line goes slack.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Teddy tumbles back, laughing.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "It got away!", "name": "TEDDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "That's the best part.", "name": "BRIGID", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "She sips.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Settles.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "The heater hisses.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Ansel snores.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "I love this. The quiet.", "name": "MARGOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "It's not that quiet.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "It's quiet enough.", "name": "MARGOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "For a minute, no one speaks.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "The radio plays a slow song.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Snow ticks on the roof.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Does the lake ever talk?", "name": "BRIGID", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Talk?", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "The ice. It was making a noise earlier. Like a groan.", "name": "BRIGID", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "It does that. Expansion.", "name": "MARGOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "It's the cold working through it.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "The groan comes again.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Longer, lower.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Teddy leans closer to the hole.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "It sounds like a person.", "name": "TEDDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Teddy.", "name": "MARGOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Like someone humming.", "name": "TEDDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Don't be silly.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "Don't be silly.", "name": "MARGOT", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "They've said it at the same time, same flat tone.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "They look at each other and neither smiles.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "The humming continues.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Not the radio.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "From under the floor.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Ansel's eyes open.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "Nobody put your hand in the hole.", "name": "ANSEL", "speaker": 4, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "What?", "name": "BRIGID", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Don't. Please.", "name": "ANSEL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "Teddy's fingers are already at the edge of the water.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "From the black circle, a pale hand rises, slow, almost tender.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "It takes Teddy's mitten between two fingers, holds it, as if checking the size.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "The heater goes out.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}]}