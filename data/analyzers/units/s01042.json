{"scene_id": "s01042", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01042.fountain", "heading": "INT. COMMUNITY CENTER LOCKER ROOM - NIGHT", "cast": [{"id": 0, "name": "COACH RUTHANNE PIKE", "names": ["COACH RUTHANNE PIKE"], "gender": "f", "first": 3, "spoke": 0}, {"id": 1, "name": "ZEKE", "names": ["ZEKE"], "gender": "?", "first": 4, "spoke": 2}, {"id": 2, "name": "DOM", "names": ["DOM"], "gender": "?", "first": 5, "spoke": 3}, {"id": 3, "name": "MEI-LING", "names": ["MEI-LING"], "gender": "f", "first": 6, "spoke": 2}, {"id": 4, "name": "COACH", "names": ["COACH"], "gender": "?", "first": 7, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. COMMUNITY CENTER LOCKER ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dented lockers, wet benches, a whiteboard with a half-erased play.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The fluorescent tubes buzz.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "COACH RUTHANNE PIKE, 50s, whistle around her neck, paces the length of the room.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "ZEKE, 20s, taped wrists, sits head down.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "DOM, 30s, pulls on a jersey.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "MEI-LING, 20s, goalie, rocks on her toes.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Third period. We're down two.", "name": "COACH", "speaker": 4, "ext": [], "paren": ["to all"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "We're down three.", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Down two. The ref owes us one.", "name": "COACH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "He owes us two.", "name": "DOM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Ref owes us a kidney.", "name": "MEI-LING", "speaker": 3, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Zeke, look at me. Look up.", "name": "COACH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "He lifts his head.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "You're the fastest man on this ice.", "name": "COACH", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "My knee.", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Your knee's fine.", "name": "COACH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Coach, the knee isn't fine.", "name": "DOM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Dom, tie your skates.", "name": "COACH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "They're tied.", "name": "DOM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Tie them again.", "name": "COACH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Mei-Ling punches her pads, twice.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "The sound is a heartbeat.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Nobody gets past me. Not one.", "name": "MEI-LING", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "That's what I like to hear.", "name": "COACH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "The horn sounds down the hall.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "They rise as one.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Zeke limps, then doesn't.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}]}