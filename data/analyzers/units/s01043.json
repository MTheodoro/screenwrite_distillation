{"scene_id": "s01043", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01043.fountain", "heading": "INT. ASSAY OFFICE - GOLD RUSH TOWN - DAY (1851)", "cast": [{"id": 0, "name": "THADDEUS WHIT", "names": ["THADDEUS WHIT", "THADDEUS"], "gender": "?", "first": 3, "spoke": 23}, {"id": 1, "name": "CORNELIA BASS", "names": ["CORNELIA BASS", "CORNELIA"], "gender": "?", "first": 6, "spoke": 24}], "units": [{"u": 0, "kind": "heading", "text": "INT. ASSAY OFFICE - GOLD RUSH TOWN - DAY (1851)", "present": []}, {"u": 1, "kind": "action", "text": "A plank room, one window grimed with dust, a counter scarred by a thousand scales.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Weighing pans, crucibles, a brass balance under glass.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "THADDEUS WHIT, 50s, spectacles, black sleeve garters, presides behind the counter.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "His fingers are stained yellow from nitric acid.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "action", "text": "The door bangs.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "CORNELIA BASS, 30s, trousers and a man's hat, strides in.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Dust to her knees.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "A leather pouch swings from her belt.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "We close in ten minutes, madam.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Then I'll be quick.", "name": "CORNELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She drops the pouch on the counter.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "It thuds.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "What have you got?", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Color.", "name": "CORNELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "He unties the cord.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Pours.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Dull yellow dust pools on a sheet of paper.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He pinches some.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Rolls it between his fingers.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Holds it to the light.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Where was this panned?", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Dry Creek.", "name": "CORNELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Dry Creek has been dry for a year.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "That's why it's called Dry Creek.", "name": "CORNELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "He gives her a thin smile.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Reaches for a vial.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "A drop of acid. For the test.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Go on.", "name": "CORNELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "He doses the metal.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "It stays bright.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "He nods.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "It's good.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "I know.", "name": "CORNELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Twelve dollars an ounce.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Twenty.", "name": "CORNELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Fourteen.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Seventeen and the sack.", "name": "CORNELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Done.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "He weighs it.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Writes a slip.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Counts bills from a strongbox.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Slides them over.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "She doesn't count them.", "para": 8, "sent": 4, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "You'll be here tomorrow?", "name": "CORNELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Every day but Sunday.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Good. I'll bring more.", "name": "CORNELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "Madam, if I may. A woman alone in these hills--", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "I'm not alone.", "name": "CORNELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Your husband?", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "My claim. A hundred yards of dirt. And a rifle.", "name": "CORNELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Ah.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "She tips her hat.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "Heads for the door.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "Stops with her hand on the latch.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "Mr. Whit.", "name": "CORNELIA", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "Yes?", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "You tested my gold with acid.", "name": "CORNELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "Standard practice.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "And you held it to the light.", "name": "CORNELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "Also standard.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "But you never looked at the weight.", "name": "CORNELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "Thaddeus freezes.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "The pen drops from his fingers.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "That scale tilts two grains left. I've been watching it for three weeks.", "name": "CORNELIA", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "It's properly calibrated.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "It's not.", "name": "CORNELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "I'll ask you to leave.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "You'll ask me nothing.", "name": "CORNELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "She turns back.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 70, "kind": "action", "text": "Her hand slips beneath her coat.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 71, "kind": "dialogue", "text": "Madam.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 72, "kind": "dialogue", "text": "Open the strongbox.", "name": "CORNELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 73, "kind": "dialogue", "text": "This is robbery.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 74, "kind": "dialogue", "text": "It's restitution.", "name": "CORNELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 75, "kind": "action", "text": "He doesn't move.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 76, "kind": "action", "text": "The clock ticks.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 77, "kind": "action", "text": "Dust drifts through the light.", "para": 12, "sent": 2, "present": [0, 1]}, {"u": 78, "kind": "dialogue", "text": "There's four hundred dollars.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 79, "kind": "dialogue", "text": "There's four thousand. Under the false bottom.", "name": "CORNELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 80, "kind": "action", "text": "Thaddeus goes white.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 81, "kind": "action", "text": "He kneels, trembling, lifts the strongbox's lining.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 82, "kind": "dialogue", "text": "How?", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 83, "kind": "dialogue", "text": "I used to keep books in Sacramento.", "name": "CORNELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 84, "kind": "action", "text": "He lays a bundle on the counter.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 85, "kind": "action", "text": "Then another.", "para": 14, "sent": 1, "present": [0, 1]}, {"u": 86, "kind": "action", "text": "She slides them into her pouch.", "para": 14, "sent": 2, "present": [0, 1]}, {"u": 87, "kind": "dialogue", "text": "We never met.", "name": "CORNELIA", "speaker": 1, "ext": ["CONT'D"], "paren": ["over his words"], "dual": false, "present": [0, 1]}, {"u": 88, "kind": "dialogue", "text": "We never met.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1]}, {"u": 89, "kind": "action", "text": "They say it together.", "para": 15, "sent": 0, "present": [0, 1]}, {"u": 90, "kind": "action", "text": "She smiles.", "para": 15, "sent": 1, "present": [0, 1]}, {"u": 91, "kind": "action", "text": "He doesn't.", "para": 15, "sent": 2, "present": [0, 1]}, {"u": 92, "kind": "action", "text": "She leaves.", "para": 16, "sent": 0, "present": [0, 1]}, {"u": 93, "kind": "action", "text": "The door clacks shut.", "para": 16, "sent": 1, "present": [0, 1]}, {"u": 94, "kind": "action", "text": "The bell above it jingles for a long time.", "para": 16, "sent": 2, "present": [0, 1]}]}