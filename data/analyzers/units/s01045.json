{"scene_id": "s01045", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01045.fountain", "heading": "INT. GOAT YOGA STUDIO - MORNING", "cast": [{"id": 0, "name": "CLAUDETTE FONTENOT", "names": ["CLAUDETTE FONTENOT", "CLAUDETTE"], "gender": "f", "first": 4, "spoke": 11}, {"id": 1, "name": "LEONARD PRICE", "names": ["LEONARD PRICE", "LEONARD"], "gender": "f", "first": 5, "spoke": 6}, {"id": 2, "name": "MAMA ROSE", "names": ["MAMA ROSE"], "gender": "?", "first": 15, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. GOAT YOGA STUDIO - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "A converted barn.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Bamboo mats in neat rows, string lights, a chalkboard reading \"Namaste Baa-ck.\"", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Six goats wander the floor, bored, chewing yoga straps.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CLAUDETTE FONTENOT, 40s, instructor, flowing linen, sits cross-legged on a mat with a phone propped against her water bottle.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "LEONARD PRICE, 50s, her only student, a stockbroker in too-tight spandex, attempts a downward dog.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Claudette, one of them is eating my sock.", "name": "LEONARD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "That's Beyonce. She loves attention.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "It's attention with teeth.", "name": "LEONARD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Breathe, Leonard. In through the nose.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He breathes.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Beyonce chews.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He breathes again.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "The phone rings.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "A photo of an elderly woman in a floppy hat.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "MAMA ROSE.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Sorry. I have to take this.", "name": "CLAUDETTE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "She answers on speaker.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Claudette! Are you on the goat farm again?", "name": "MAMA ROSE", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "It's a studio, Mama.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Is it the goat that eats the shoes?", "name": "MAMA ROSE", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "That's the one.", "name": "LEONARD", "speaker": 1, "ext": [], "paren": ["under his breath"], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Who's that? A man? Are you seeing a man?", "name": "MAMA ROSE", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "It's a client, Mama.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "He sounds fat.", "name": "MAMA ROSE", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "I'm in a very difficult pose.", "name": "LEONARD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Claudette, I need you to come home. The faucet is leaking again.", "name": "MAMA ROSE", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "I'll call a plumber.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Plumbers are thieves.", "name": "MAMA ROSE", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Mama, I love you. I have to teach.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Is the goat singing? I hear a goat singing.", "name": "MAMA ROSE", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "On cue, Beyonce bleats, triumphant.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "She's proud of you.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": ["to Leonard"], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "I'll be sure to thank her.", "name": "LEONARD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Goodbye, Mama.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "She hangs up.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Smooths her linen.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Resettles.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Where were we?", "name": "CLAUDETTE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Paying for this.", "name": "LEONARD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Right. Warrior One.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}