{"scene_id": "s01046", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01046.fountain", "heading": "INT. VOSSBERG & CRANE - EXECUTIVE NAP POD ROOM - DAY", "cast": [{"id": 0, "name": "PRUDENCE ADEYEMI", "names": ["PRUDENCE ADEYEMI", "PRUDENCE"], "gender": "f", "first": 4, "spoke": 12}, {"id": 1, "name": "MALCOLM VOSSBERG", "names": ["MALCOLM VOSSBERG", "MALCOLM"], "gender": "m", "first": 7, "spoke": 13}], "units": [{"u": 0, "kind": "heading", "text": "INT. VOSSBERG & CRANE - EXECUTIVE NAP POD ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Six sleek pods, each shaped like a lacquered egg.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Soft ambient chimes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A sign on the wall: REST IS RESULTS.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "PRUDENCE ADEYEMI, 40s, in a pressed navy suit, stands outside pod three.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She has been standing there a long time.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Her phone is in her hand, screen dark.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "MALCOLM VOSSBERG, 50s, in shirtsleeves, tie loosened to a politician's disarray, emerges from pod four rubbing his eyes.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He sees her.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He smiles.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He is not surprised.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Prudence. I thought you'd gone home.", "name": "MALCOLM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I did.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Then you came back.", "name": "MALCOLM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "For my coat.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She doesn't move toward the coat rack.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He does.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He lifts her coat off a hook, holds it out.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She takes it.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Doesn't put it on.", "para": 3, "sent": 4, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Rough week.", "name": "MALCOLM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "It's Thursday.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Rough Thursday.", "name": "MALCOLM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "He adjusts a pod's dial.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "The chimes change key.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "The numbers will be fine. They always are.", "name": "MALCOLM", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Are they?", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "You doubt me?", "name": "MALCOLM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "I doubt the spreadsheet.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "It's your spreadsheet.", "name": "MALCOLM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "It's the one you rewrote.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "The chimes continue.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "A faint hiss of oxygen from the pods.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "I thought you'd appreciate the efficiency.", "name": "MALCOLM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Efficiency.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Streamlining.", "name": "MALCOLM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Prudence folds her coat over her arm.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Folds it a second time.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Smooths it flat with both hands, too carefully.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "I'll be in my office.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "You were just leaving.", "name": "MALCOLM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "I changed my mind.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "He nods.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "Looks at the pod.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "Looks at her.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Sleep on it. That's what these are for.", "name": "MALCOLM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "She turns, walks to the door.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Pauses with one hand on the frame.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Do you sleep in there?", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Every day.", "name": "MALCOLM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "And dream?", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Never.", "name": "MALCOLM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "That's what I thought.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "She leaves.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "He watches the door close, then climbs back into pod four and seals the lid.", "para": 9, "sent": 1, "present": [0, 1]}]}