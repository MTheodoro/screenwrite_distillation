{"scene_id": "s01047", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01047.fountain", "heading": "EXT. SALT FLAT - ABANDONED STAGECOACH - HIGH NOON", "cast": [{"id": 0, "name": "MARSHAL CULLEN BRODERICK", "names": ["MARSHAL CULLEN BRODERICK", "CULLEN"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "DUTCH", "names": ["DUTCH"], "gender": "?", "first": 4, "spoke": 2}, {"id": 2, "name": "LUPE VARGAS", "names": ["LUPE VARGAS", "LUPE"], "gender": "f", "first": 4, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SALT FLAT - ABANDONED STAGECOACH - HIGH NOON", "present": []}, {"u": 1, "kind": "action", "text": "White to the horizon.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Heat shimmer bends the sky.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A stagecoach tilts on a broken axle, one wheel cocked in the crust.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MARSHAL CULLEN BRODERICK, 50s, tin star, dust-gray duster, steps down from the coach, rifle across his arm, while behind him DUTCH, a lean outlaw in manacles, shuffles toward the shade, and LUPE VARGAS, 30s, the driver, slaps her hat against her knee, checks the horses, and mutters at the broken wheel, all three of them squinting at a dark speck on the horizon that keeps growing.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "Nobody run. There's nowhere to run to.", "name": "CULLEN", "speaker": 0, "ext": [], "paren": ["to the others"], "dual": false, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Marshal, take these off me. If that's riders, I can shoot.", "name": "DUTCH", "speaker": 1, "ext": [], "paren": ["low, to Cullen"], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "No.", "name": "CULLEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Three days. Three goddamn days of salt.", "name": "LUPE", "speaker": 2, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Lupe. Water.", "name": "CULLEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "She tosses him a canteen.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He drinks, passes it to Dutch.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Dutch drinks, passes it back.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "The speck becomes a rider.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "That's a lone horse.", "name": "DUTCH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Could be a lone man.", "name": "CULLEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Could be a mirage.", "name": "LUPE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "The rider slows.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Stops a hundred yards out.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Raises a white cloth.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Waves it.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Cullen lowers the rifle.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Dutch exhales.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Lupe pulls her hat down.", "para": 4, "sent": 2, "present": [0, 1, 2]}]}