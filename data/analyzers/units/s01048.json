{"scene_id": "s01048", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01048.fountain", "heading": "INT. KRVX 91.3 FM - RURAL RADIO STATION - NIGHT", "cast": [{"id": 0, "name": "DEE-DEE HARGROVE", "names": ["DEE-DEE HARGROVE", "DEE-DEE"], "gender": "f", "first": 4, "spoke": 8}, {"id": 1, "name": "ROLAND TIBBETTS", "names": ["ROLAND TIBBETTS", "ROLAND"], "gender": "?", "first": 10, "spoke": 2}, {"id": 2, "name": "CAL PINKERTON", "names": ["CAL PINKERTON", "CAL"], "gender": "?", "first": 19, "spoke": 2}, {"id": 3, "name": "CALLER", "names": ["CALLER"], "gender": "?", "first": 30, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. KRVX 91.3 FM - RURAL RADIO STATION - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cinderblock studio in a cornfield.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Foam-padded walls, a mixing board with taped-over knobs, a window onto the black field.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A red ON AIR light burns.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DEE-DEE HARGROVE, 40s, headphones, cardigan, a thermos of tea, sits at the console.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She speaks into the mic in the voice of a lifelong friend.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "dialogue", "text": "That was Patsy Cline, and you're listening to Night Owls on KRVX. Four a.m. in Calloway County. Roads are clear and the corn is quiet.", "name": "DEE-DEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 7, "kind": "action", "text": "She flicks a switch.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Music slides in.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "She leans back.", "para": 2, "sent": 2, "present": [0]}, {"u": 10, "kind": "action", "text": "ROLAND TIBBETTS, 60s, station engineer, in coveralls, enters with a toolbox and a flashlight.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He sets the box down next to a cabinet of cables.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Transmitter's running hot again.", "name": "ROLAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Is it going to melt?", "name": "DEE-DEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Not tonight.", "name": "ROLAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Then let it be.", "name": "DEE-DEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He snorts.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Sits on a stool.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Unwraps a sandwich.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "CAL PINKERTON, 20s, intern, lanky, sleepy, shuffles in with an armful of CDs and drops them on the console.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "He yawns.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Request line's been quiet. Except one.", "name": "CAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Who?", "name": "DEE-DEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Doesn't give a name.", "name": "CAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The studio phone blinks.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Dee-Dee pushes a button.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Her mic opens to the caller, softly.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "KRVX, you're on the air.", "name": "DEE-DEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "A pause.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Static, then a thin voice, dry as paper.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Hello. I'd like to hear \"Wild Horses.\"", "name": "CALLER", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Of course. Is it for someone?", "name": "DEE-DEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "For the three of you.", "name": "CALLER", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Dee-Dee looks up.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Roland stops chewing.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Cal looks at the window.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "That's very kind. May I ask your name?", "name": "DEE-DEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "You can see me.", "name": "CALLER", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Out in the black field, a single flashlight clicks on.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "It points toward the studio.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "It does not move.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Cal steps to the glass.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Roland stands, sandwich forgotten.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Dee-Dee keeps her voice steady.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Here's that request, folks.", "name": "DEE-DEE", "speaker": 0, "ext": ["CONT'D"], "paren": ["into mic"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "She slides the fader.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "The song begins.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "In the field, the flashlight goes out.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}]}