{"scene_id": "s01049", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01049.fountain", "heading": "INT. JURY ROOM - FLOODLIT TENT - NIGHT", "cast": [{"id": 0, "name": "GLORIA ACHTERBERG", "names": ["GLORIA ACHTERBERG", "GLORIA"], "gender": "f", "first": 5, "spoke": 10}, {"id": 1, "name": "DEEZ", "names": ["DEEZ"], "gender": "m", "first": 6, "spoke": 11}, {"id": 2, "name": "PRUITT", "names": ["PRUITT"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "MIN-JUN HAN", "names": ["MIN-JUN HAN", "MIN-JUN"], "gender": "f", "first": 7, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. JURY ROOM - FLOODLIT TENT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A federal courthouse flattened by a hurricane, so the court sits in a canvas tent on the parking lot.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Folding table, plastic chairs, a single fan.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Generator thrum outside.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain on the roof.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "GLORIA ACHTERBERG, 60s, foreperson, cardigan, a stack of index cards in front of her.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "DWAYNE \"DEEZ\" PRUITT, 30s, ball cap, sits arms crossed.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "MIN-JUN HAN, 40s, nurse, kneads her temples.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Let's take another vote. All in favor of conviction.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Deez doesn't raise his hand.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Min-Jun hesitates.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Gloria raises hers.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "One.", "name": "GLORIA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Gloria, I'm not sure--", "name": "MIN-JUN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "You said yesterday you were.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "I said I leaned.", "name": "MIN-JUN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "I never leaned.", "name": "DEEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Deez, with respect, you haven't opened your mouth in two days.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "I'm saving it.", "name": "DEEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "For what?", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "For when it matters.", "name": "DEEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "He stands.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "The chair scrapes.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "He crosses to a pitcher, pours water, drinks.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Then, without warning, he slams the cup down.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Twelve men on a bench and none of them looked at the kid.", "name": "DEEZ", "speaker": 1, "ext": ["CONT'D"], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Deez?", "name": "MIN-JUN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "You heard me.", "name": "DEEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "We are not here to rehash the trial.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Gloria, he's nineteen. He had a record of one parking ticket.", "name": "DEEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "He had a gun.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "He had a toy.", "name": "DEEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "The witness said it was real.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "The witness was a hundred yards away in the dark.", "name": "DEEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Min-Jun rises, steps between them, hands out.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Stop. Both of you.", "name": "MIN-JUN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "She keeps calling it a verdict. It's a guess.", "name": "DEEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "You think I haven't been losing sleep?", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "I think you made up your mind on day one.", "name": "DEEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Gloria slaps her cards down.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "They fan across the table.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Deez knocks them to the floor with the back of his hand.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Min-Jun snatches one before it's lost.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Enough! We have to be unanimous!", "name": "MIN-JUN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Then we're not leaving this tent.", "name": "DEEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Then we're not leaving.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": ["very quiet"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "The generator coughs.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "The lights flicker.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "All three look up.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "The fan slows to a stop.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "In the dark, no one moves.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}]}