{"scene_id": "s01050", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01050.fountain", "heading": "INT. CAR WASH TUNNEL - NIGHT", "cast": [{"id": 0, "name": "ODALYS FERRERA", "names": ["ODALYS FERRERA", "ODALYS"], "gender": "?", "first": 5, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. CAR WASH TUNNEL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dark.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Foam sluices over the windshield.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Spinning brushes.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Sodium light bleeds through soap in slow orange waves.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ODALYS FERRERA, 40s, sits behind the wheel of a dented sedan, both hands on ten and two.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Funeral dress.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Hair still pinned.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "dialogue", "text": "Forty-one years. He never once washed the car.", "name": "ODALYS", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0]}, {"u": 9, "kind": "action", "text": "The brushes slap the roof.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "She doesn't flinch.", "para": 2, "sent": 1, "present": [0]}, {"u": 11, "kind": "dialogue", "text": "Said it would just get dirty again.", "name": "ODALYS", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 12, "kind": "action", "text": "She switches off the radio.", "para": 3, "sent": 0, "present": [0]}, {"u": 13, "kind": "action", "text": "The tunnel roars.", "para": 3, "sent": 1, "present": [0]}, {"u": 14, "kind": "dialogue", "text": "So I let it.", "name": "ODALYS", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 15, "kind": "action", "text": "Rinse arches fire.", "para": 4, "sent": 0, "present": [0]}, {"u": 16, "kind": "action", "text": "Water drums the glass.", "para": 4, "sent": 1, "present": [0]}, {"u": 17, "kind": "action", "text": "She leans her forehead on the wheel.", "para": 4, "sent": 2, "present": [0]}, {"u": 18, "kind": "dialogue", "text": "Now I'm paying six dollars to sit in here.", "name": "ODALYS", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 19, "kind": "action", "text": "The dryer blasts.", "para": 5, "sent": 0, "present": [0]}, {"u": 20, "kind": "action", "text": "The car shudders.", "para": 5, "sent": 1, "present": [0]}, {"u": 21, "kind": "action", "text": "She starts laughing.", "para": 5, "sent": 2, "present": [0]}, {"u": 22, "kind": "action", "text": "Then she stops.", "para": 5, "sent": 3, "present": [0]}, {"u": 23, "kind": "action", "text": "She puts the car in drive.", "para": 6, "sent": 0, "present": [0]}, {"u": 24, "kind": "action", "text": "Rolls into the light.", "para": 6, "sent": 1, "present": [0]}]}