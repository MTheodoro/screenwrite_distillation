{"scene_id": "s01051", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01051.fountain", "heading": "INT. HOLLOWAY CIDER MILL - PRESS ROOM - NIGHT", "cast": [{"id": 0, "name": "JUNIPER HOLLOWAY", "names": ["JUNIPER HOLLOWAY", "JUNIPER"], "gender": "f", "first": 5, "spoke": 9}, {"id": 1, "name": "RHYS DOYLE", "names": ["RHYS DOYLE", "RHYS"], "gender": "?", "first": 7, "spoke": 2}, {"id": 2, "name": "BEATA NOWAK", "names": ["BEATA NOWAK", "BEATA"], "gender": "?", "first": 8, "spoke": 4}, {"id": 3, "name": "COLM", "names": ["COLM"], "gender": "m", "first": 9, "spoke": 3}, {"id": 4, "name": "OLUWASEUN ADEYEMI", "names": ["OLUWASEUN ADEYEMI", "OLUWASEUN"], "gender": "?", "first": 10, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOLLOWAY CIDER MILL - PRESS ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A long timber barn that smells of fermenting apples and wet wood.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wooden presses with iron screws, barrels stacked to the rafters.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A lantern on a hook sways in a draft nobody can find.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Bees drowse in the beams, drunk on sugar, their hum a low drone.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "JUNIPER HOLLOWAY, 50s, mill owner, apron stained russet to the elbows, ladles pulp into a cloth.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her braid is thick as a rope.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "RHYS DOYLE, 30s, hired hand, leans on a broom and doesn't sweep.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "BEATA NOWAK, 60s, Juniper's sister, sits on an upturned crate peeling an apple in one unbroken ribbon.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "COLM, 20s, the grandson, perches on a barrel with a harmonica he isn't playing.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "OLUWASEUN ADEYEMI, 40s, the buyer from the city, in a camel coat that doesn't belong here, taps a clipboard.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Last press of the season. Then we can all go home.", "name": "JUNIPER", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Or stay.", "name": "RHYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "No one's staying.", "name": "BEATA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "I do need a count by midnight.", "name": "OLUWASEUN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "You'll have it.", "name": "JUNIPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "She turns the screw.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Juice runs into a trough, amber and slow.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "The sound is oddly soft.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "It sounds like someone breathing.", "name": "COLM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "It's the cider, Colm.", "name": "BEATA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Not the cider. Under it.", "name": "COLM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "They go still.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "The juice drips.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "The bees hum.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "And beneath it all, a slow, wet inhale.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Then an exhale.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Pipes.", "name": "RHYS", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "There are no pipes in the press room.", "name": "JUNIPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Is there a basement?", "name": "OLUWASEUN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Juniper and Beata exchange a look so quick it's nearly nothing.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "No basement.", "name": "BEATA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "We don't dig here.", "name": "JUNIPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Why not?", "name": "OLUWASEUN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "The ground doesn't like it.", "name": "JUNIPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Oluwaseun smiles, thinks it a joke.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Nobody smiles back.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "The lantern swings.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Its light crosses Rhys's face, Beata's hands, Colm's eyes, Juniper's braid.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "The hum of bees thickens.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Juniper lifts a ladle to her lips.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Tastes.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Her face doesn't change.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Put your harmonica down, love.", "name": "JUNIPER", "speaker": 0, "ext": ["CONT'D"], "paren": ["to Colm"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "I wasn't--", "name": "COLM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Now.", "name": "JUNIPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "He sets it on the barrel.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "It rolls an inch.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Stops.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Beata stops peeling.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "The ribbon of apple skin hangs, quivering, in her fingers.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "It's early.", "name": "BEATA", "speaker": 2, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "It's early.", "name": "JUNIPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "What is?", "name": "OLUWASEUN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "The breathing quickens.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "The barrel under Colm shudders.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "The staves bulge, as if something inside is leaning out.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "All five freeze.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "The bees fall silent in the rafters.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "Then, in one motion, Rhys drops the broom, Beata drops the apple, Colm scrambles off the barrel, Oluwaseun stumbles backward over the trough, and Juniper turns calmly, takes a mallet from a hook, and faces the barrel as if she'd been expecting it since March.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "Out. Quiet. Don't run.", "name": "JUNIPER", "speaker": 0, "ext": ["CONT'D"], "paren": ["to all"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "They go.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "Slowly.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "Colm last, looking back.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "Juniper steps to the barrel.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "Raises the mallet.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "Waits.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "action", "text": "The staves creak.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "action", "text": "The breath hitches.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "Waits with her.", "para": 16, "sent": 2, "present": [0, 1, 2, 3, 4]}]}