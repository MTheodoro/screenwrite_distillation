{"scene_id": "s01053", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01053.fountain", "heading": "INT. AIR RAID WARDEN POST - SCHOOLYARD SHELTER - NIGHT (1941)", "cast": [{"id": 0, "name": "EDMUND HARTLEY", "names": ["EDMUND HARTLEY", "EDMUND"], "gender": "m", "first": 4, "spoke": 11}, {"id": 1, "name": "VERA PLUMMER", "names": ["VERA PLUMMER", "VERA"], "gender": "f", "first": 5, "spoke": 3}, {"id": 2, "name": "ALF DOBSON", "names": ["ALF DOBSON", "ALF"], "gender": "m", "first": 6, "spoke": 4}, {"id": 3, "name": "CONTROL", "names": ["CONTROL"], "gender": "?", "first": 15, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. AIR RAID WARDEN POST - SCHOOLYARD SHELTER - NIGHT (1941)", "present": []}, {"u": 1, "kind": "action", "text": "A concrete box dug under a playground.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A hurricane lamp, a field telephone, a rack of tin helmets, sandbags to the ceiling.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Muffled drone overhead.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "EDMUND HARTLEY, 50s, grocer by day, warden by night, white helmet, rests his hand on the phone.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "VERA PLUMMER, 20s, volunteer, clipboard and bicycle clips, sits on a crate with a mug of cocoa.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "ALF DOBSON, 60s, retired railwayman, hums a hymn to himself.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "The drone grows.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Edmund glances at the ceiling.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Mark it. Eleven forty.", "name": "EDMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Marked.", "name": "VERA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "That's no Spitfire.", "name": "ALF", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "The field telephone rings.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Edmund snatches it.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Post Seven.", "name": "EDMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Post Seven, this is Control. Report.", "name": "CONTROL", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Nothing yet. Heard them over the canal.", "name": "EDMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Hold position. Fire watch at the gasworks says they're dropping flares.", "name": "CONTROL", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Flares.", "name": "EDMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Prepare for incendiaries.", "name": "CONTROL", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "He hangs up.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Looks at Vera and Alf.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Right. Helmets on. Buckets by the door.", "name": "EDMUND", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Vera sets down her cocoa.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Alf rises, joints cracking.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Mr. Hartley, shouldn't we stay below?", "name": "VERA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Not for incendiaries.", "name": "EDMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "You'll want sand, not water.", "name": "ALF", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "I know my business, Alf.", "name": "EDMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Nobody said you didn't.", "name": "ALF", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "A distant thud.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Dust shivers from the ceiling.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "The phone rings again.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Edmund picks up.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Post Seven. Strike on the Albert Road. Third house from the corner.", "name": "CONTROL", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Edmund goes pale.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "That's my shop.", "name": "EDMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Say again?", "name": "CONTROL", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "That's my shop. That's my daughter's flat above it.", "name": "EDMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Warden Hartley, stay at your post.", "name": "CONTROL", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "He puts the phone down very carefully.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Takes off his helmet.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Puts it back on, tighter.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Mr. Hartley--", "name": "VERA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Vera. Take the register. Alf, you're with me.", "name": "EDMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Aye.", "name": "ALF", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "We're going up.", "name": "EDMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "He opens the door.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Night, red and roaring, floods in.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}]}