{"scene_id": "s01054", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01054.fountain", "heading": "INT. ROADSIDE MOTEL - ROOM 9 - NIGHT", "cast": [{"id": 0, "name": "WOMAN", "names": ["WOMAN"], "gender": "f", "first": 6, "spoke": 6}, {"id": 1, "name": "PROPERTY LENA MARSH", "names": ["PROPERTY LENA MARSH", "LENA"], "gender": "?", "first": 50, "spoke": 13}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROADSIDE MOTEL - ROOM 9 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Pink bedspread.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wood-paneled walls.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A TV bolted to the dresser, off.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A lamp with a torn shade.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Rain taps the window like fingertips.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "A WOMAN, 30s, wet raincoat, dark circles under her eyes, locks the door.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Slides the chain.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "Pulls the curtains shut.", "para": 1, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "She is alone, and she's checking the room the way a person checks who has already been surprised once.", "para": 1, "sent": 3, "present": [0]}, {"u": 10, "kind": "action", "text": "She opens the closet.", "para": 2, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "Empty hangers.", "para": 2, "sent": 1, "present": [0]}, {"u": 12, "kind": "action", "text": "The bathroom.", "para": 2, "sent": 2, "present": [0]}, {"u": 13, "kind": "action", "text": "Empty tub.", "para": 2, "sent": 3, "present": [0]}, {"u": 14, "kind": "action", "text": "Under the bed.", "para": 2, "sent": 4, "present": [0]}, {"u": 15, "kind": "action", "text": "Dust, a lost sock.", "para": 2, "sent": 5, "present": [0]}, {"u": 16, "kind": "action", "text": "She sits on the edge of the bed and takes a small tape recorder from her bag.", "para": 3, "sent": 0, "present": [0]}, {"u": 17, "kind": "action", "text": "She presses RECORD.", "para": 3, "sent": 1, "present": [0]}, {"u": 18, "kind": "dialogue", "text": "Test. Test.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": ["into recorder"], "dual": false, "present": [0]}, {"u": 19, "kind": "action", "text": "She stops.", "para": 4, "sent": 0, "present": [0]}, {"u": 20, "kind": "action", "text": "Plays it back.", "para": 4, "sent": 1, "present": [0]}, {"u": 21, "kind": "action", "text": "Her own voice, tinny.", "para": 4, "sent": 2, "present": [0]}, {"u": 22, "kind": "dialogue", "text": "Test. Test.", "name": "WOMAN", "speaker": 0, "ext": ["V.O."], "paren": ["tape"], "dual": false, "present": [0]}, {"u": 23, "kind": "action", "text": "She nods.", "para": 5, "sent": 0, "present": [0]}, {"u": 24, "kind": "action", "text": "Records again.", "para": 5, "sent": 1, "present": [0]}, {"u": 25, "kind": "dialogue", "text": "Day one. Motel off Route 9. Nobody followed me. I think.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 26, "kind": "action", "text": "She stops the tape.", "para": 6, "sent": 0, "present": [0]}, {"u": 27, "kind": "action", "text": "Looks at the phone on the nightstand.", "para": 6, "sent": 1, "present": [0]}, {"u": 28, "kind": "action", "text": "Beige, rotary, curly cord.", "para": 6, "sent": 2, "present": [0]}, {"u": 29, "kind": "action", "text": "She picks up the receiver.", "para": 6, "sent": 3, "present": [0]}, {"u": 30, "kind": "action", "text": "Dial tone.", "para": 6, "sent": 4, "present": [0]}, {"u": 31, "kind": "action", "text": "She sets it back.", "para": 6, "sent": 5, "present": [0]}, {"u": 32, "kind": "action", "text": "She rewinds.", "para": 7, "sent": 0, "present": [0]}, {"u": 33, "kind": "action", "text": "Hits PLAY.", "para": 7, "sent": 1, "present": [0]}, {"u": 34, "kind": "dialogue", "text": "Day one. Motel off Route 9. Nobody followed me. I think.", "name": "WOMAN", "speaker": 0, "ext": ["V.O."], "paren": ["tape"], "dual": false, "present": [0]}, {"u": 35, "kind": "action", "text": "Then, after her recorded voice, the same voice again, lower, almost tender, saying words she never spoke:", "para": 8, "sent": 0, "present": [0]}, {"u": 36, "kind": "dialogue", "text": "I'm in the room.", "name": "WOMAN", "speaker": 0, "ext": ["V.O."], "paren": ["tape, whispering"], "dual": false, "present": [0]}, {"u": 37, "kind": "action", "text": "She freezes.", "para": 9, "sent": 0, "present": [0]}, {"u": 38, "kind": "action", "text": "The tape continues to hiss.", "para": 9, "sent": 1, "present": [0]}, {"u": 39, "kind": "action", "text": "She hits STOP.", "para": 10, "sent": 0, "present": [0]}, {"u": 40, "kind": "action", "text": "Her thumb shakes.", "para": 10, "sent": 1, "present": [0]}, {"u": 41, "kind": "action", "text": "She rewinds again, plays it again.", "para": 10, "sent": 2, "present": [0]}, {"u": 42, "kind": "action", "text": "The extra line is gone.", "para": 10, "sent": 3, "present": [0]}, {"u": 43, "kind": "action", "text": "Only the first.", "para": 10, "sent": 4, "present": [0]}, {"u": 44, "kind": "dialogue", "text": "Okay.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0]}, {"u": 45, "kind": "action", "text": "She sets the recorder on the dresser.", "para": 11, "sent": 0, "present": [0]}, {"u": 46, "kind": "action", "text": "Takes off her coat.", "para": 11, "sent": 1, "present": [0]}, {"u": 47, "kind": "action", "text": "Hangs it on the doorknob.", "para": 11, "sent": 2, "present": [0]}, {"u": 48, "kind": "action", "text": "A key tag drops from the pocket and clatters to the floor.", "para": 11, "sent": 3, "present": [0]}, {"u": 49, "kind": "action", "text": "She picks it up.", "para": 11, "sent": 4, "present": [0]}, {"u": 50, "kind": "action", "text": "The tag is stamped in hand-scratched letters: PROPERTY OF LENA MARSH.", "para": 11, "sent": 5, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "She turns it over, turns it back.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Right. Right. I'm Lena.", "name": "LENA", "speaker": 1, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "She says it as if reminding herself.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "She says it again.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "Lena Marsh. Thirty-four. Dental hygienist. Born in Duluth.", "name": "LENA", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "She reaches for the lamp.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "Clicks it off.", "para": 14, "sent": 1, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "The room is almost black.", "para": 14, "sent": 2, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "A glow leaks around the curtain edge.", "para": 14, "sent": 3, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "On the dresser, the recorder clicks on by itself.", "para": 15, "sent": 0, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "The tape reels turn.", "para": 15, "sent": 1, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "No.", "name": "LENA", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "Lena.", "name": "LENA", "speaker": 1, "ext": ["V.O."], "paren": ["tape"], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "She backs against the wall.", "para": 16, "sent": 0, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "That's my voice.", "name": "LENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "You taped me yesterday. In the car.", "name": "LENA", "speaker": 1, "ext": ["V.O."], "paren": ["tape"], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "I wasn't in a car yesterday.", "name": "LENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "No. But you will be.", "name": "LENA", "speaker": 1, "ext": ["V.O."], "paren": ["tape"], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "She lunges.", "para": 17, "sent": 0, "present": [0, 1]}, {"u": 70, "kind": "action", "text": "Grabs the recorder.", "para": 17, "sent": 1, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "Rips the cassette out.", "para": 17, "sent": 2, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "Throws it across the room.", "para": 17, "sent": 3, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "It hits the TV and cracks.", "para": 17, "sent": 4, "present": [0, 1]}, {"u": 74, "kind": "action", "text": "Silence.", "para": 18, "sent": 0, "present": [0, 1]}, {"u": 75, "kind": "action", "text": "Rain.", "para": 18, "sent": 1, "present": [0, 1]}, {"u": 76, "kind": "action", "text": "Breath.", "para": 18, "sent": 2, "present": [0, 1]}, {"u": 77, "kind": "action", "text": "She slides down the wall until she's sitting on the floor.", "para": 19, "sent": 0, "present": [0, 1]}, {"u": 78, "kind": "action", "text": "She hugs her knees.", "para": 19, "sent": 1, "present": [0, 1]}, {"u": 79, "kind": "action", "text": "From the bathroom: a click.", "para": 20, "sent": 0, "present": [0, 1]}, {"u": 80, "kind": "action", "text": "A drip.", "para": 20, "sent": 1, "present": [0, 1]}, {"u": 81, "kind": "action", "text": "Another click.", "para": 20, "sent": 2, "present": [0, 1]}, {"u": 82, "kind": "dialogue", "text": "Please.", "name": "LENA", "speaker": 1, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1]}, {"u": 83, "kind": "action", "text": "The bathroom light snaps on by itself.", "para": 21, "sent": 0, "present": [0, 1]}, {"u": 84, "kind": "action", "text": "A thin line of yellow slides under the door.", "para": 21, "sent": 1, "present": [0, 1]}, {"u": 85, "kind": "dialogue", "text": "Please don't.", "name": "LENA", "speaker": 1, "ext": ["CONT'D"], "paren": ["barely audible"], "dual": false, "present": [0, 1]}, {"u": 86, "kind": "action", "text": "The doorknob turns on its own.", "para": 22, "sent": 0, "present": [0, 1]}, {"u": 87, "kind": "action", "text": "She crawls to the bed.", "para": 23, "sent": 0, "present": [0, 1]}, {"u": 88, "kind": "action", "text": "Under it.", "para": 23, "sent": 1, "present": [0, 1]}, {"u": 89, "kind": "action", "text": "Dust, the lost sock.", "para": 23, "sent": 2, "present": [0, 1]}, {"u": 90, "kind": "action", "text": "Her own hand finds the cracked cassette.", "para": 23, "sent": 3, "present": [0, 1]}, {"u": 91, "kind": "action", "text": "The bathroom door creaks.", "para": 24, "sent": 0, "present": [0, 1]}, {"u": 92, "kind": "dialogue", "text": "Day two.", "name": "LENA", "speaker": 1, "ext": ["V.O."], "paren": ["from the cracked cassette, gentle"], "dual": false, "present": [0, 1]}, {"u": 93, "kind": "action", "text": "She presses the cassette to her chest.", "para": 25, "sent": 0, "present": [0, 1]}, {"u": 94, "kind": "action", "text": "Doesn't breathe.", "para": 25, "sent": 1, "present": [0, 1]}, {"u": 95, "kind": "action", "text": "The bathroom light hums.", "para": 26, "sent": 0, "present": [0, 1]}, {"u": 96, "kind": "action", "text": "The cassette hisses against her chest.", "para": 26, "sent": 1, "present": [0, 1]}, {"u": 97, "kind": "dialogue", "text": "Nobody followed me.", "name": "LENA", "speaker": 1, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 98, "kind": "dialogue", "text": "I know.", "name": "LENA", "speaker": 1, "ext": [], "paren": ["a thread of voice"], "dual": false, "present": [0, 1]}, {"u": 99, "kind": "action", "text": "The lamp clicks on.", "para": 27, "sent": 0, "present": [0, 1]}]}