{"scene_id": "s01055", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01055.fountain", "heading": "INT. PHILOMENA'S KITCHEN - SUNDAY AFTERNOON", "cast": [{"id": 0, "name": "PHILOMENA ROSSETTI", "names": ["PHILOMENA ROSSETTI", "PHILOMENA"], "gender": "?", "first": 5, "spoke": 24}, {"id": 1, "name": "ARTUR ROSSETTI", "names": ["ARTUR ROSSETTI", "ARTUR"], "gender": "m", "first": 5, "spoke": 17}, {"id": 2, "name": "SOLEDAD", "names": ["SOLEDAD"], "gender": "f", "first": 8, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. PHILOMENA'S KITCHEN - SUNDAY AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "A kitchen from another decade.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Yellow linoleum, a table with a plastic cloth printed with lemons, a clock shaped like a rooster.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "On the stove, a pot of sauce simmers, spitting.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Steam beads the windowpanes.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "PHILOMENA ROSSETTI, 80, sleeves pushed to the elbows, hair in a hairnet, stirs.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Her hands are knotted like old rope.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "At the table, ARTUR ROSSETTI, 50s, her son, in a church shirt, slices bread with surgical care.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "His daughter SOLEDAD, 16, sits cross-legged on a chair, eyes on her phone, headphones around her neck.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "You never come on Sundays anymore.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I come on Sundays, Ma.", "name": "ARTUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "You come on the Sundays you remember.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "That's most of them.", "name": "ARTUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Most. Hmph.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "She tastes the sauce.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Adds salt.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Stirs.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "It smells good, Nonna.", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "It smells like your grandfather's lies.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "What?", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "He swore he could cook. He burned water.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Ma, not today.", "name": "ARTUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Why not today?", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Because.", "name": "ARTUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Because what?", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Because it's Sunday.", "name": "ARTUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "She snorts.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Taps the spoon on the pot.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "You think I don't know why you've brought the child.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Soledad's here because she wanted to see you.", "name": "ARTUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "I did.", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "You came to hold my hand while Arturo tells me something he has been practicing in the car.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Ma.", "name": "ARTUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Tell me.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Artur sets the knife down.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Wipes his fingers.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Looks at his daughter, who looks at her phone, pretending not to hear.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "The doctor called.", "name": "ARTUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Which doctor?", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "The one with the results. For the house.", "name": "ARTUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "The house is not sick.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "The house is not sick, Ma. You are.", "name": "ARTUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "The clock ticks.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "The sauce pops.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Philomena does not turn.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "I know that.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "You know?", "name": "ARTUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "I am eighty. I have buried a husband, two brothers, and a dog named Salvatore. I know what a cough means.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Nonna?", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Hush, cara.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "They want to put you somewhere. Just for a little while. Somewhere with nurses.", "name": "ARTUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Somewhere with nurses.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Not forever.", "name": "ARTUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "They never say forever. They say a little while.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "I didn't want to.", "name": "ARTUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "You didn't want to tell me, or you didn't want to put me in a place?", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "Both.", "name": "ARTUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "She turns now.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Her face is wet.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "It isn't steam.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "She wipes it on her sleeve.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Sit with me. Both of you.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "They sit.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "She lifts the pot, spoons a bowl, sets it before Soledad.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "Eat. It gets cold.", "name": "PHILOMENA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "I'm not hungry.", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "You'll be hungry in a month. When I'm not here to feed you.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "She says it lightly.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "A joke.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "Nobody laughs.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 70, "kind": "dialogue", "text": "Ma. Please.", "name": "ARTUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 71, "kind": "dialogue", "text": "Arturo. Your father's recipe. It's in the drawer, under the knives. Never in a book. I wrote it on the back of an electric bill.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 72, "kind": "dialogue", "text": "I know.", "name": "ARTUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 73, "kind": "dialogue", "text": "You do not know. You think there is a secret ingredient. There isn't. There is only a woman standing here at four o'clock every Sunday for fifty-eight years.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 74, "kind": "action", "text": "She sits.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 75, "kind": "action", "text": "Folds her hands.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 76, "kind": "dialogue", "text": "That's the ingredient. Now eat.", "name": "PHILOMENA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 77, "kind": "action", "text": "Soledad takes a spoonful.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 78, "kind": "action", "text": "Her face crumples.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 79, "kind": "action", "text": "She keeps eating.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 80, "kind": "action", "text": "Artur reaches across the lemons and takes his mother's hand.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 81, "kind": "action", "text": "It is small and knotted and warm.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 82, "kind": "action", "text": "The rooster clock ticks.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 83, "kind": "action", "text": "On the stove, the sauce goes on simmering.", "para": 12, "sent": 1, "present": [0, 1, 2]}]}