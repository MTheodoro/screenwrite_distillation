{"scene_id": "s01057", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01057.fountain", "heading": "INT. HOSPITAL BARGE \"MERCY ELEANOR\" - WARD DECK - NIGHT", "cast": [{"id": 0, "name": "ISMAIL KARIMI", "names": ["ISMAIL KARIMI", "ISMAIL"], "gender": "m", "first": 4, "spoke": 11}, {"id": 1, "name": "NURSE BRONWEN ACKERLEY", "names": ["NURSE BRONWEN ACKERLEY", "BRONWEN"], "gender": "f", "first": 5, "spoke": 6}, {"id": 2, "name": "ORDERLY TOBIAS FINCH", "names": ["ORDERLY TOBIAS FINCH", "TOBIAS"], "gender": "m", "first": 6, "spoke": 5}, {"id": 3, "name": "LINH THAI", "names": ["LINH THAI", "LINH"], "gender": "?", "first": 7, "spoke": 8}, {"id": 4, "name": "ODETTA WRAY", "names": ["ODETTA WRAY", "MRS. WRAY"], "gender": "f", "first": 8, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOSPITAL BARGE \"MERCY ELEANOR\" - WARD DECK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A converted river freighter.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Twelve cots on a steel deck, curtains on ceiling rails, an IV pole tied to a pillar with bungee cord.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Through round portholes, the lights of a riverbank town drift by.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. ISMAIL KARIMI, 50s, rumpled scrubs, reading glasses hanging from one ear, signs a chart at a card table nailed to the floor.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "NURSE BRONWEN ACKERLEY, 40s, tall, silver braid, checks an IV bag with a flashlight.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "ORDERLY TOBIAS FINCH, 20s, headphones around his neck, mops in lazy circles.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "DR. LINH THAI, 30s, resident, sits cross-legged on a cot, stethoscope draped, eating crackers from a sleeve.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "And at the end of the row, MRS. ODETTA WRAY, 70s, the only patient awake, sits up in a cot with a blanket over her knees.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Bed six, no change.", "name": "ISMAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Bed six, no change.", "name": "BRONWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Bed nine?", "name": "ISMAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Temp is ninety-nine point one.", "name": "LINH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Fine. Leave it.", "name": "ISMAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "I was going to.", "name": "LINH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Do we have more mop heads?", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Closet, port side.", "name": "BRONWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Port is?", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Left.", "name": "BRONWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Thanks.", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "The barge shifts.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "A low groan runs through the hull.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Nobody reacts.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "The IV pole sways against its bungee.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Doctor.", "name": "MRS. WRAY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Yes, Mrs. Wray.", "name": "ISMAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Is it always so slow at night?", "name": "MRS. WRAY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Usually it's slower.", "name": "ISMAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Then I'm in luck.", "name": "MRS. WRAY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Are you in pain?", "name": "ISMAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Only boredom.", "name": "MRS. WRAY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "I can read you something.", "name": "LINH", "speaker": 3, "ext": [], "paren": ["through crackers"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "What have you got?", "name": "MRS. WRAY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "The back of the cracker box.", "name": "LINH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Go ahead.", "name": "MRS. WRAY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "\"Made with whole grains. Best before March.\"", "name": "LINH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Beautiful.", "name": "MRS. WRAY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Bronwen stifles a laugh.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Ismail glances over his glasses, almost smiles.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Dr. Karimi, should I do the starboard side next?", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "If you like.", "name": "ISMAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "I do like.", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Then carry on.", "name": "ISMAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "The barge's horn sounds, low and soft, a note across water.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "That's Calder Landing.", "name": "BRONWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "We dock in an hour.", "name": "ISMAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Do we get shore leave?", "name": "LINH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "We get paperwork.", "name": "ISMAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Same thing.", "name": "LINH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Dr. Thai.", "name": "ISMAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Sorry.", "name": "LINH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Mrs. Wray settles into her pillow.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Her eyes close.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "A pulse monitor beeps in a slow, steady tick.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "Bronwen adjusts the blanket across her knees.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Tucks it neat.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Sleep well.", "name": "BRONWEN", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "Everything's fine?", "name": "MRS. WRAY", "speaker": 4, "ext": [], "paren": ["eyes closed"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "Everything's fine.", "name": "BRONWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "She turns off the flashlight.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "The ward falls into amber, quiet, familiar dark.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}]}