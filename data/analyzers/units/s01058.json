{"scene_id": "s01058", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01058.fountain", "heading": "INT. BARBERSHOP - SAGUARO FLATS - AFTERNOON", "cast": [{"id": 0, "name": "COLTER BANKS", "names": ["COLTER BANKS", "COLTER"], "gender": "f", "first": 4, "spoke": 18}, {"id": 1, "name": "MAGDALENA REYES", "names": ["MAGDALENA REYES", "MAGDALENA"], "gender": "f", "first": 5, "spoke": 19}], "units": [{"u": 0, "kind": "heading", "text": "INT. BARBERSHOP - SAGUARO FLATS - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "One chair, one mirror, one spittoon.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sun lances through the front window.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A fly drones against the glass.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "COLTER BANKS, 40s, barber, sleeves rolled, strops a razor.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "In the chair, MAGDALENA REYES, 30s, trail dust on her coat, a gun belt buckled low, lies back with a hot towel on her face.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Haircut or shave?", "name": "COLTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Shave.", "name": "MAGDALENA", "speaker": 1, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You've got no beard, ma'am.", "name": "COLTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Then it'll be quick.", "name": "MAGDALENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He chuckles.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Lifts the towel.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Her eyes are closed.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She doesn't smile.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Nice town, isn't it?", "name": "COLTER", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Quiet.", "name": "MAGDALENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Quiet's good for business.", "name": "COLTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Not for yours.", "name": "MAGDALENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "I don't need a crowd. Just a few regulars.", "name": "COLTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Like Sheriff Haynes.", "name": "MAGDALENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "His strop stops mid-stroke.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "You know the sheriff?", "name": "COLTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "I know his boots. They're on your wall. Left side, behind the broom.", "name": "MAGDALENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Colter's eyes flick to the corner.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "A pair of polished boots, neat, side by side, dusty at the toes.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Left them here weeks ago. Said he'd be back.", "name": "COLTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "He won't.", "name": "MAGDALENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Is that a fact.", "name": "COLTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "It's a fact, Colter.", "name": "MAGDALENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "He sets the razor on the counter.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Picks up a comb.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Combs her hair with sudden care.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "I never told you my name.", "name": "COLTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "It's on the window.", "name": "MAGDALENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Right.", "name": "COLTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "He combs.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "She waits.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "The fly buzzes.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Out in the street, a dog barks, stops.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Is there something I should know?", "name": "COLTER", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "I'm going to ask you a question, and I want you to answer it honestly.", "name": "MAGDALENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "All right.", "name": "COLTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Where's the sheriff?", "name": "MAGDALENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Out of town.", "name": "COLTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Where?", "name": "MAGDALENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Does it matter?", "name": "COLTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "It's my brother who sent him.", "name": "MAGDALENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Colter's hand stops on her scalp.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "The comb freezes.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Your brother?", "name": "COLTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Santiago Reyes. Brown horse. Left ear notched.", "name": "MAGDALENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "I don't--", "name": "COLTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Sheriff Haynes rode out of here with him and his saddlebags and came back with only the horse.", "name": "MAGDALENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "Colter steps away from the chair.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "She opens her eyes.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "Calm.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "Cold.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "Ma'am, I'm only a barber.", "name": "COLTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "You're a man with a bad shave and a good alibi.", "name": "MAGDALENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "I don't understand.", "name": "COLTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "Look in the mirror.", "name": "MAGDALENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "He does.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "Behind him, in the glass, the front door has quietly opened.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "A pair of boots on the threshold.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "The sheriff's, or the same cut.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "Close the door, Colter. Sit down.", "name": "MAGDALENA", "speaker": 1, "ext": ["CONT'D"], "paren": ["without turning"], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "He sits.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 67, "kind": "action", "text": "His hands are shaking.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "She rises, rolls her sleeves, and takes the razor from the counter.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "Tests the edge with her thumb.", "para": 10, "sent": 3, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "Now. Let's have that talk.", "name": "MAGDALENA", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}]}