{"scene_id": "s01059", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01059.fountain", "heading": "INT. LOGGING CAMP MESS HALL - ARBITRATION HEARING - DAY", "cast": [{"id": 0, "name": "PETRA ILLES", "names": ["PETRA ILLES", "PETRA"], "gender": "?", "first": 4, "spoke": 8}, {"id": 1, "name": "REGINALD TOLLIVER", "names": ["REGINALD TOLLIVER", "REGINALD"], "gender": "?", "first": 4, "spoke": 5}, {"id": 2, "name": "OTTOLINE FRYE", "names": ["OTTOLINE FRYE", "OTTOLINE"], "gender": "f", "first": 5, "spoke": 5}, {"id": 3, "name": "CLERK", "names": ["CLERK"], "gender": "m", "first": 20, "spoke": 0}, {"id": 4, "name": "ABIODUN SHOLA", "names": ["ABIODUN SHOLA", "ABIODUN"], "gender": "m", "first": 21, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. LOGGING CAMP MESS HALL - ARBITRATION HEARING - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Long pine tables pushed into a U. Axes on hooks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Snow outside the windows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A coffee urn steams in the corner.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "PETRA ILLES, 40s, plaid jacket over blazer, stands at the head of the U. REGINALD TOLLIVER, 50s, three-piece suit, sits opposite her with his hands steepled.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "OTTOLINE FRYE, 60s, the foreman, sits in the witness chair, a rifle-green parka zipped to her chin.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Ms. Frye. Who signed off on the timber survey?", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "I did.", "name": "OTTOLINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Did you walk the ridge?", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Not myself.", "name": "OTTOLINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Then how?", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Objection. Foundation.", "name": "REGINALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "She's the foreman.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "She's not a surveyor.", "name": "REGINALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I know a tree when I see one.", "name": "OTTOLINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Did you see this one?", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "I saw the stump.", "name": "OTTOLINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "And the stump said?", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Objection!", "name": "REGINALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "The door bangs.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "A CLERK, 20s, snow on his hat, hurries in with a folder, ducking as though the rafters were low.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "ABIODUN SHOLA, per the badge on his coat.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Everyone looks.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Sorry. Sorry. Urgent filing.", "name": "ABIODUN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Mr. Shola, we're in session.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "It's about the ridge.", "name": "ABIODUN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Whose side is this?", "name": "REGINALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Yours, I think. Or hers.", "name": "ABIODUN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "He slaps the folder on the table between them.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Petra and Reginald reach for it.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Give me that.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Give me that.", "name": "REGINALD", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "They stop.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Both draw back.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Ottoline takes the folder, opens it.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Reads.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "That ridge was never ours.", "name": "OTTOLINE", "speaker": 2, "ext": [], "paren": ["slowly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "The mess hall goes quiet.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Even the coffee urn seems to stop bubbling.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}]}