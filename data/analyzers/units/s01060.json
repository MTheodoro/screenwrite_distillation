{"scene_id": "s01060", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01060.fountain", "heading": "INT. LUNAR AGRICULTURAL DOME - CAFETERIA - DAY CYCLE", "cast": [{"id": 0, "name": "HALCYON PRYCE", "names": ["HALCYON PRYCE", "HALCYON"], "gender": "?", "first": 5, "spoke": 19}, {"id": 1, "name": "TEODORO FALCONE", "names": ["TEODORO FALCONE", "TEODORO"], "gender": "m", "first": 6, "spoke": 17}, {"id": 2, "name": "CHIOMA UDOH", "names": ["CHIOMA UDOH", "CHIOMA"], "gender": "?", "first": 7, "spoke": 9}, {"id": 3, "name": "NADEEM ROUSSEAU", "names": ["NADEEM ROUSSEAU", "NADEEM"], "gender": "m", "first": 34, "spoke": 14}, {"id": 4, "name": "COMMANDER BENEDIKT STONE", "names": ["COMMANDER BENEDIKT STONE", "BENEDIKT"], "gender": "?", "first": 71, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. LUNAR AGRICULTURAL DOME - CAFETERIA - DAY CYCLE", "present": []}, {"u": 1, "kind": "action", "text": "A circular canteen under a clear shell.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Earth hangs in the sky like a blue marble.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Long tables of recycled plastic, trays of steaming something.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A hum of pumps from beneath the floor.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. HALCYON PRYCE, 50s, lead agronomist, white coat over coveralls, sits at a central table stirring something green with a spork.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across from her, TEODORO FALCONE, 40s, mechanic, grease under his nails, eats a protein bar with no pleasure.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "CHIOMA UDOH, 30s, hydroponics tech, tablet propped against a water pouch, scrolls a spreadsheet.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Do you taste that?", "name": "HALCYON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "It's lunch.", "name": "TEODORO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "It's kale. Mostly.", "name": "HALCYON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "It's mostly lunch.", "name": "TEODORO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Cycle three yield is down four percent.", "name": "CHIOMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Down from what?", "name": "HALCYON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "From the last harvest.", "name": "CHIOMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "That's not a number. That's a mood.", "name": "HALCYON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Four percent is a number.", "name": "CHIOMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "It depends on who's counting.", "name": "HALCYON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "I'm counting calories. Mine are low.", "name": "TEODORO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Teodoro, you've been quiet this week.", "name": "HALCYON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I'm always quiet.", "name": "TEODORO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Quiet-quiet or worried-quiet?", "name": "HALCYON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Pump seven is making a sound.", "name": "TEODORO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "What kind of sound?", "name": "HALCYON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "A mean one.", "name": "TEODORO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Mean how?", "name": "CHIOMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Like a dog that hasn't decided yet.", "name": "TEODORO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Have you filed a ticket?", "name": "HALCYON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "I filed three. Maintenance said \"scheduled.\"", "name": "TEODORO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "When?", "name": "HALCYON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Spring.", "name": "TEODORO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "It's October.", "name": "HALCYON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "I'm aware.", "name": "TEODORO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "A figure appears at the cafeteria entrance.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "NADEEM ROUSSEAU, 20s, intern, lanky, glasses sliding down his nose, balances a tray with the posture of someone who has never carried a tray.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "He scans the room and heads toward them.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Is this seat taken?", "name": "NADEEM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Sit.", "name": "HALCYON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Thank you, Doctor.", "name": "NADEEM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Halcyon. Dr. is for formal complaints.", "name": "HALCYON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Halcyon. Okay.", "name": "NADEEM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "He sits.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Opens his mouth.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Closes it.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Opens it again.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Sorry. I'm new. Today's my second day.", "name": "NADEEM", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "You'll get used to the food.", "name": "TEODORO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Is it always this beige?", "name": "NADEEM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Only on days that end in Y.", "name": "CHIOMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "What do you do here?", "name": "NADEEM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "I keep the plants alive. Teodoro keeps the plants' water alive. Halcyon keeps all of us alive.", "name": "CHIOMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Aspirationally.", "name": "HALCYON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "That's a lot of alive.", "name": "NADEEM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "On a rock with no air, it's the only job.", "name": "HALCYON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "I read about the bio-loop in school. Water, nutrients, light. Every molecule counted.", "name": "NADEEM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "And?", "name": "HALCYON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "It's more beautiful in a textbook.", "name": "NADEEM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "It's less beautiful in a textbook. The textbook doesn't smell.", "name": "HALCYON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "Pump seven.", "name": "TEODORO", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "Sorry?", "name": "NADEEM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "Don't. He'll tell you for an hour.", "name": "CHIOMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "It's a good story.", "name": "TEODORO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "It's a pump.", "name": "CHIOMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "It's a pump with a personality.", "name": "TEODORO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "I like pumps.", "name": "NADEEM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "Kid, you're hired.", "name": "TEODORO", "speaker": 1, "ext": [], "paren": ["looking up"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "He's already hired.", "name": "HALCYON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "Then you're promoted.", "name": "TEODORO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "To what?", "name": "NADEEM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "dialogue", "text": "To the person who gets to listen.", "name": "TEODORO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "dialogue", "text": "Good luck.", "name": "CHIOMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "COMMANDER BENEDIKT STONE, 60s, dome administrator, cane tapping, pauses at the end of their table with a tray of nothing but coffee.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "dialogue", "text": "Dr. Pryce. Mr. Falcone. Is this the new hire?", "name": "BENEDIKT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "dialogue", "text": "Yes, sir.", "name": "NADEEM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "dialogue", "text": "Welcome to the Moon. Try not to break it.", "name": "BENEDIKT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "action", "text": "He moves on.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 76, "kind": "action", "text": "Nadeem laughs, uncertain.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 77, "kind": "action", "text": "He picks up his spork and tastes the green stuff.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 78, "kind": "action", "text": "His face does something complicated.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 79, "kind": "dialogue", "text": "That's really kale.", "name": "NADEEM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 80, "kind": "dialogue", "text": "Told you.", "name": "HALCYON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 81, "kind": "action", "text": "They eat.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 82, "kind": "action", "text": "Pumps hum below.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 83, "kind": "action", "text": "Overhead, Earth turns slowly, blue and white and very far away.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}]}