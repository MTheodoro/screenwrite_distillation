{"scene_id": "s01061", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01061.fountain", "heading": "INT. NORTHWIND LOGISTICS - ESCAPE ROOM \"THE VAULT OF SYNERGY\" - DAY", "cast": [{"id": 0, "name": "DIRECTOR GREGOR HALVORSEN", "names": ["DIRECTOR GREGOR HALVORSEN", "GREGOR"], "gender": "?", "first": 7, "spoke": 7}, {"id": 1, "name": "PRIYA NAIR", "names": ["PRIYA NAIR", "PRIYA"], "gender": "f", "first": 9, "spoke": 1}, {"id": 2, "name": "TODD BEXLEY", "names": ["TODD BEXLEY", "TODD"], "gender": "?", "first": 12, "spoke": 4}, {"id": 3, "name": "BEATRICE KOWALSKI", "names": ["BEATRICE KOWALSKI", "BEATRICE"], "gender": "?", "first": 15, "spoke": 2}, {"id": 4, "name": "HR", "names": ["HR"], "gender": "?", "first": 15, "spoke": 0}, {"id": 5, "name": "MARCUS ELLIOT", "names": ["MARCUS ELLIOT", "MARCUS"], "gender": "?", "first": 20, "spoke": 1}, {"id": 6, "name": "DELILAH OKONJO", "names": ["DELILAH OKONJO", "DELILAH"], "gender": "f", "first": 26, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. NORTHWIND LOGISTICS - ESCAPE ROOM \"THE VAULT OF SYNERGY\" - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A windowless basement fitted as a movie-set bank.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Brass safe doors, laser-beam strips of red tape, a ticking digital clock above the mantel: 59:12.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Six employees in matching fleece vests stand in a ring around a locked chest.", "para": 1, "sent": 0, "present": []}, {"u": 4, "kind": "action", "text": "Lanyards.", "para": 1, "sent": 1, "present": []}, {"u": 5, "kind": "action", "text": "Name tags.", "para": 1, "sent": 2, "present": []}, {"u": 6, "kind": "action", "text": "Forced smiles.", "para": 1, "sent": 3, "present": []}, {"u": 7, "kind": "action", "text": "DIRECTOR GREGOR HALVORSEN, 50s, bald, a vest zipped to the chin, claps once.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "dialogue", "text": "Team! Remember. There's no \"I\" in--", "name": "GREGOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 9, "kind": "action", "text": "PRIYA NAIR, 30s, accountant, glances at her watch.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "We've got fifty-eight minutes.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Alignment is a journey.", "name": "GREGOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "TODD BEXLEY, 40s, sales, taps the chest.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "It's a padlock. Four digits.", "name": "TODD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Who has the clue?", "name": "GREGOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "BEATRICE KOWALSKI, 60s, HR, lifts a laminated card with a trembling hand.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "\"The date of our greatest quarter.\"", "name": "BEATRICE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "That's every quarter.", "name": "TODD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Todd.", "name": "GREGOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "I'm saying, it's every quarter.", "name": "TODD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "MARCUS ELLIOT, 20s, junior analyst, stares at the clock.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Fifty-six minutes.", "name": "MARCUS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Marcus, please. We don't count down. We count up.", "name": "GREGOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Marcus nods.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Counts nothing.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "His left eye twitches.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "DELILAH OKONJO, 40s, procurement, stands with her arms crossed, in the corner.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "It's seventeen forty-two.", "name": "DELILAH", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "Is that a guess?", "name": "GREGOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "It's on the whiteboard behind you.", "name": "DELILAH", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "They all turn.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "A whiteboard reads: FOUNDED 1742.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "action", "text": "Gregor's smile fixes in place.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "Great catch, Delilah.", "name": "GREGOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "Priya enters the code.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "The padlock clicks.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "The chest opens.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "Inside, a single laminated card: CONGRATULATIONS.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "PLEASE COMPLETE THE SURVEY.", "para": 10, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "Nobody speaks.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "Todd picks up the card, turns it over.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "dialogue", "text": "There's a QR code.", "name": "TODD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "dialogue", "text": "Of course there is.", "name": "BEATRICE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "They stand there, six fleece vests in a basement, while the clock beeps.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "54:03.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "action", "text": "54:02.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}]}