{"scene_id": "s01062", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01062.fountain", "heading": "INT. STRANDED COACH BUS - 3 A.M.", "cast": [{"id": 0, "name": "NAOMI PRESCOTT", "names": ["NAOMI PRESCOTT", "NAOMI"], "gender": "f", "first": 5, "spoke": 15}, {"id": 1, "name": "EMERY LUND", "names": ["EMERY LUND", "EMERY"], "gender": "?", "first": 6, "spoke": 18}], "units": [{"u": 0, "kind": "heading", "text": "INT. STRANDED COACH BUS - 3 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "A long-distance bus at the roadside, hazard lights ticking amber against a field of black.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of reclining seats, empty.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A fine layer of frost on the inner windows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The driver's seat is vacant, door gaping open to the night.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "NAOMI PRESCOTT, 30s, parka and wool cap, sits in the third row from the back with a paperback she isn't reading.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across the aisle, EMERY LUND, 20s, headphones, hoodie, bounces one knee.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Neither has spoken for twenty minutes.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Hello? Anyone else on here?", "name": "EMERY", "speaker": 1, "ext": [], "paren": ["to the bus, loud"], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Hazards tick.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "There's nobody else.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Right.", "name": "EMERY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "The driver stepped out for the radio.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "That was an hour ago.", "name": "EMERY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Forty minutes.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Felt like an hour.", "name": "EMERY", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She pulls the headphones down around her neck.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Naomi turns a page.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Doesn't read it.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "The bus creaks, settling on its springs.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Did you hear that?", "name": "EMERY", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Hear what?", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Like tapping.", "name": "EMERY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "It's the cold.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "It's not the cold.", "name": "EMERY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "It's the cold.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Tap.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Tap.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Tap-tap.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Both sit very still.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "The sound comes from somewhere in the back of the bus.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Not the engine.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Not the heater.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Something closer, patient.", "para": 6, "sent": 4, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "It's in the luggage rack.", "name": "EMERY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Don't.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Someone left a bag.", "name": "EMERY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Emery.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "I'm going to look.", "name": "EMERY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "She stands.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Naomi stands too, in the same moment, then sits back down, and then stands again.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "They both end up in the aisle, and the bus sways, and neither wants to take the first step.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "You first.", "name": "EMERY", "speaker": 1, "ext": ["CONT'D"], "paren": ["to Naomi, whispering"], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Whoever's there, we know you're in there.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": ["to the bus"], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Whoever's there, we know you're in there.", "name": "EMERY", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "They say it at the same time.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "They look at each other.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Stop that.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "You stop.", "name": "EMERY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "The tapping stops.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "Instead, a soft, wet noise, like a hand pulled slowly out of mud.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "The overhead luggage rack shudders.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "A zipper rasps.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "A black duffel bag unzips by itself, one slow tooth at a time.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "Naomi clutches the seat.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "Emery clutches Naomi's arm.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "They back up the aisle together, step for step, until they hit the rear emergency door.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "Open it.", "name": "NAOMI", "speaker": 0, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "It's locked.", "name": "EMERY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "Open it!", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "It's a lever! It's on the floor!", "name": "EMERY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "She drops.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "Gropes under the seat.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "Naomi keeps her eyes on the duffel.", "para": 12, "sent": 2, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "The zipper rasps another inch.", "para": 12, "sent": 3, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "Come on. Come on.", "name": "EMERY", "speaker": 1, "ext": ["CONT'D"], "paren": ["to herself"], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "action", "text": "Something pale slides out of the bag.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "Fingers, knuckled and long.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "They curl around the edge of the rack.", "para": 13, "sent": 2, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "Emery. Pull it. Now.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": ["very low"], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "Emery pulls.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "The emergency door swings out with a clatter, and cold air slams into the bus.", "para": 14, "sent": 1, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "The hazards tick.", "para": 14, "sent": 2, "present": [0, 1]}, {"u": 74, "kind": "action", "text": "The fingers withdraw.", "para": 14, "sent": 3, "present": [0, 1]}, {"u": 75, "kind": "dialogue", "text": "Go! Go!", "name": "EMERY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 76, "kind": "action", "text": "Naomi shoves her out the door, tumbles after.", "para": 15, "sent": 0, "present": [0, 1]}, {"u": 77, "kind": "action", "text": "They land in the gravel on their hands and knees, gasping.", "para": 15, "sent": 1, "present": [0, 1]}, {"u": 78, "kind": "action", "text": "Behind them, the bus sits glowing amber, silent.", "para": 16, "sent": 0, "present": [0, 1]}, {"u": 79, "kind": "action", "text": "The duffel, lying on the aisle floor, is zipped shut again.", "para": 16, "sent": 1, "present": [0, 1]}, {"u": 80, "kind": "dialogue", "text": "Don't look back.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": ["panting"], "dual": false, "present": [0, 1]}, {"u": 81, "kind": "dialogue", "text": "I'm not.", "name": "EMERY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 82, "kind": "dialogue", "text": "Good.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 83, "kind": "action", "text": "They crawl away from the road.", "para": 17, "sent": 0, "present": [0, 1]}, {"u": 84, "kind": "action", "text": "Neither looks.", "para": 17, "sent": 1, "present": [0, 1]}, {"u": 85, "kind": "action", "text": "Both hear it: the soft tap of a hand on the glass.", "para": 17, "sent": 2, "present": [0, 1]}]}