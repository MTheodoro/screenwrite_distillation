{"scene_id": "s01064", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01064.fountain", "heading": "EXT. THE GLASS BRIDGE OF AETHERMERE - DAWN", "cast": [{"id": 0, "name": "QUEEN IDRISSA", "names": ["QUEEN IDRISSA", "IDRISSA"], "gender": "?", "first": 2, "spoke": 2}, {"id": 1, "name": "SIR BALTHAZAR", "names": ["SIR BALTHAZAR", "BALTHAZAR"], "gender": "?", "first": 3, "spoke": 3}, {"id": 2, "name": "FINNEGAN", "names": ["FINNEGAN"], "gender": "?", "first": 4, "spoke": 2}, {"id": 3, "name": "MORGANA", "names": ["MORGANA"], "gender": "?", "first": 11, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. THE GLASS BRIDGE OF AETHERMERE - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A span of living crystal between two floating islands, fog beneath it, bells ringing somewhere unseen.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "QUEEN IDRISSA, tall and crowned in silver thorns, stands at the middle of the bridge.", "para": 1, "sent": 0, "present": [0]}, {"u": 3, "kind": "action", "text": "Behind her, SIR BALTHAZAR, white-bearded, in bronze plate, grips a staff that hums with blue light.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "Before her, a ragged young WANDERER named FINNEGAN carries nothing but a cracked lute.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "You trespass, minstrel.", "name": "IDRISSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "I'm only crossing.", "name": "FINNEGAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Cross to what?", "name": "BALTHAZAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "To the far island. My brother's there.", "name": "FINNEGAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "There is no brother.", "name": "IDRISSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "There is no brother.", "name": "BALTHAZAR", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "A third figure strides out of the fog: MORGANA, a woman in green, hair full of leaves, a bow slung across her back.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "She holds up a hand.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Lower your staff, Balthazar. He speaks true.", "name": "MORGANA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "How would you know?", "name": "BALTHAZAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Because the brother is me.", "name": "MORGANA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Finnegan drops the lute.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "It rings on the crystal.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "The bridge begins to hum.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}]}