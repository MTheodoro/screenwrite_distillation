{"scene_id": "s01066", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01066.fountain", "heading": "EXT. ARCTIC ICE SHELF - LIFE RAFT CAMP - DAY", "cast": [{"id": 0, "name": "JOSEPHINE TALLCHIEF", "names": ["JOSEPHINE TALLCHIEF", "JOSEPHINE"], "gender": "?", "first": 4, "spoke": 2}, {"id": 1, "name": "DARIUS OKAFOR", "names": ["DARIUS OKAFOR", "DARIUS"], "gender": "?", "first": 5, "spoke": 2}, {"id": 2, "name": "BERNADETTE LACROIX", "names": ["BERNADETTE LACROIX", "BERNADETTE"], "gender": "?", "first": 6, "spoke": 4}, {"id": 3, "name": "RESCUE ONE", "names": ["RESCUE ONE"], "gender": "?", "first": 7, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ARCTIC ICE SHELF - LIFE RAFT CAMP - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A bright white world.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A yellow raft hauled up on a floe, a tarp strung from poles, a single seal-oil stove.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wind sighs.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "JOSEPHINE TALLCHIEF, 30s, parka hood trimmed with fur, kneels at the stove and stirs a pot.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "DARIUS OKAFOR, 40s, frostbitten cheeks, sits against the raft with a rifle.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "BERNADETTE LACROIX, 20s, in a red survival suit, stands at the edge of the floe with a radio.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Rescue One, this is the Meridian. Do you copy?", "name": "BERNADETTE", "speaker": 2, "ext": [], "paren": ["into radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "The radio hisses.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "...Meridian... position... say again...", "name": "RESCUE ONE", "speaker": 3, "ext": ["V.O."], "paren": ["garbled"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "We're at seventy-eight north.", "name": "BERNADETTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "...hold... coming...", "name": "RESCUE ONE", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "She grins.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Turns to the others.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "They're coming!", "name": "BERNADETTE", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "How long?", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Two hours!", "name": "BERNADETTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Two hours. We can make two hours.", "name": "DARIUS", "speaker": 1, "ext": [], "paren": ["rising"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "The floe groans.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "A crack zigzags across the ice between them.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Josephine and Darius lunge for the raft as the floe splits, and Bernadette leaps across the gap, landing hard in Josephine's arms.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "All three tumble into the raft as the ice shelf shifts and a second crack opens right where the stove had been.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Cut the line!", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Cut the line!", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Bernadette hacks the rope.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "The raft slides free.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "The three huddle.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "The stove sinks into black water.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Meridian, we have you. Stay put.", "name": "RESCUE ONE", "speaker": 3, "ext": ["V.O."], "paren": ["clear now"], "dual": false, "present": [0, 1, 2, 3]}]}