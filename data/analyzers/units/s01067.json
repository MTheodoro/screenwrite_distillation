{"scene_id": "s01067", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01067.fountain", "heading": "INT. VICTORIAN ICE HOUSE - ESTATE GROUNDS - EVENING (1887)", "cast": [{"id": 0, "name": "ABIGAIL FENWICK-HALE", "names": ["ABIGAIL FENWICK-HALE", "ABIGAIL"], "gender": "f", "first": 5, "spoke": 11}, {"id": 1, "name": "TOBIAS RUSK", "names": ["TOBIAS RUSK", "TOBIAS"], "gender": "?", "first": 6, "spoke": 6}, {"id": 2, "name": "STRANGER", "names": ["STRANGER"], "gender": "m", "first": 7, "spoke": 11}, {"id": 3, "name": "RUPERT", "names": ["RUPERT"], "gender": "?", "first": 37, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. VICTORIAN ICE HOUSE - ESTATE GROUNDS - EVENING (1887)", "present": []}, {"u": 1, "kind": "action", "text": "A brick dome half-sunk in the earth.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Blocks of ice stacked in straw, sawdust floor, a sharp cold that smells of wet stone.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A lantern hangs from a hook.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Breath clouds in the light.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ABIGAIL FENWICK-HALE, 30s, housekeeper, shawl over her shoulders, counts blocks with a slate.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "TOBIAS RUSK, 50s, groundskeeper, canvas coat, sits on a crate, whittling.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "A STRANGER, 40s, in a good coat and muddy boots, stands near the entrance holding a bowler hat.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Forty-two blocks. Enough for the garden party.", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": ["to both"], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Forty-two's plenty.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "You'll want to turn the straw before the guests arrive.", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I'll do it, Miss Abigail.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "The Stranger clears his throat.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Forgive me. I'm looking for the master of the house.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "He's up at the manor, sir.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "I tried the door. Nobody answered.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "The door is closed after four.", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "So I discovered.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "And you are?", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "A friend of the family.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Never seen him.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": ["under his breath"], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Which family?", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "The Ashworths.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Tobias stops whittling.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The shavings fall.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "The Ashworths left in March.", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Did they? I hadn't heard. I'm afraid I've been abroad.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Where abroad?", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Calcutta.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "That's a long way to come for an empty house.", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "I came for the cold.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Pardon?", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "The ice house. They kept something here, once. A sealed tin.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Nothing's here but ice, sir.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Of course. I only wished to be certain.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "He turns his hat in his hands.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Raises his eyes.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "My name is Rupert Ashworth. I was supposed to have inherited.", "name": "STRANGER", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Abigail's slate slips from her fingers and clatters on the floor.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Tobias rises, knife in hand.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Mr. Rupert died in the Punjab. We had the letter.", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Reports of my death were premature.", "name": "RUPERT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Miss, I'd stand behind me.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": ["to Abigail"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "She doesn't move.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "The lantern flickers.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "I only want the tin.", "name": "RUPERT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "God help us.", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": ["to the cold air"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "I'd settle for that, too.", "name": "RUPERT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "He smiles.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "A thin, apologetic, tired smile.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Behind him, the ice house door creaks in the wind, and all three turn to look at it.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}]}