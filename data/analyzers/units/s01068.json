{"scene_id": "s01068", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01068.fountain", "heading": "INT. DANCE MARATHON HALL - NIGHT (1932)", "cast": [{"id": 0, "name": "EVELYN PRATT", "names": ["EVELYN PRATT", "EVELYN"], "gender": "f", "first": 6, "spoke": 10}, {"id": 1, "name": "JACK HOLLISTER", "names": ["JACK HOLLISTER", "JACK"], "gender": "m", "first": 14, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. DANCE MARATHON HALL - NIGHT (1932)", "present": []}, {"u": 1, "kind": "action", "text": "A cavernous ballroom, plank floor, paper streamers gone limp.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Hour 487.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A banner reads LAST COUPLE STANDING WINS $1,000.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The couples have gone to their cots.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A gramophone scratches out one slow waltz to an empty floor.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "EVELYN PRATT, 20s, in a tattered satin dress, shoes in her hand, sways alone in the middle of the boards.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Eyes closed.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "dialogue", "text": "Anybody got a cigarette?", "name": "EVELYN", "speaker": 0, "ext": [], "paren": ["to the empty hall"], "dual": false, "present": [0]}, {"u": 9, "kind": "action", "text": "No answer.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "Gramophone crackle.", "para": 2, "sent": 1, "present": [0]}, {"u": 11, "kind": "dialogue", "text": "Four hundred eighty-seven hours. And the only thing that moves is the record.", "name": "EVELYN", "speaker": 0, "ext": ["CONT'D"], "paren": ["muttering"], "dual": false, "present": [0]}, {"u": 12, "kind": "action", "text": "A cot creaks in the shadows.", "para": 3, "sent": 0, "present": [0]}, {"u": 13, "kind": "action", "text": "A match flares.", "para": 3, "sent": 1, "present": [0]}, {"u": 14, "kind": "action", "text": "JACK HOLLISTER, 20s, in a wilted white shirt, pushes himself off a bench and shuffles into the light, a cigarette between his lips.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Here.", "name": "JACK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He offers it.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She takes a drag.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Gives it back.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Thanks. You were sleeping.", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "I was resting my eyes.", "name": "JACK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "In a dance marathon.", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "It's called pacing.", "name": "JACK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She laughs.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "It wakes him a little.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "He sets the cigarette on the edge of the gramophone and holds out one hand.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Fifteen minutes left on the clock.", "name": "JACK", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Then dance with me.", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "I thought you'd never ask.", "name": "JACK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "She drops her shoes.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Takes his hand.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "They begin to turn, slow, a little off the beat.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "If we win, what will you do with a thousand dollars?", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Buy a hat.", "name": "JACK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "That's all?", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "A nice hat.", "name": "JACK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "And me?", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "You'd get a better hat.", "name": "JACK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "They both begin to say the same line.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "I'd dance another four hundred hours for you.", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "I'd dance another four hundred hours for you.", "name": "JACK", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "They stop.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Both startled.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Then, softly, they laugh.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Don't promise. Just hold on.", "name": "EVELYN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "He holds her.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "The gramophone skips and keeps going.", "para": 9, "sent": 1, "present": [0, 1]}]}