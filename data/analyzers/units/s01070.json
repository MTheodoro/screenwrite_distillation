{"scene_id": "s01070", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01070.fountain", "heading": "INT. FLOODED RICE MILL - NIGHT", "cast": [{"id": 0, "name": "SERGEANT OKAFOR", "names": ["SERGEANT OKAFOR", "OKAFOR"], "gender": "?", "first": 3, "spoke": 2}, {"id": 1, "name": "CORPORAL HALVORSEN", "names": ["CORPORAL HALVORSEN", "HALVORSEN"], "gender": "?", "first": 4, "spoke": 1}, {"id": 2, "name": "PRIVATE LIN", "names": ["PRIVATE LIN", "LIN"], "gender": "f", "first": 5, "spoke": 1}, {"id": 3, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 8, "spoke": 2}, {"id": 4, "name": "TEODOR", "names": ["TEODOR"], "gender": "?", "first": 11, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. FLOODED RICE MILL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Knee-deep brown water.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sacks float like dead cattle.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "SERGEANT OKAFOR, 40s, scarred jaw, holds a lantern low.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "CORPORAL HALVORSEN, 20s, freckled, covers the door with a rifle.", "para": 0, "sent": 3, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "PRIVATE LIN, 19, thin, shivers beside a radio set.", "para": 0, "sent": 4, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "A man in a farmer's coat wades out of the dark.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Hands up.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "STRANGER, 50s, mud to the waist.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Don't shoot. I live here.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Nobody lives here. Name.", "name": "OKAFOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Teodor. Teodor Vasko. The mill is my brother's.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Halvorsen steps closer.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Lin keeps her eyes on the radio.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Sarge, he came from the north bank. That's their side.", "name": "HALVORSEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "The bridge is gone. I swam.", "name": "TEODOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Distant engines.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Okafor kills the lantern.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Dark.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Lin. Radio. Now.", "name": "OKAFOR", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Static, Sergeant. Only static.", "name": "LIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "The engines grow louder.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Halvorsen cocks the rifle.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}]}