{"scene_id": "s01071", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01071.fountain", "heading": "INT. LAMPLIGHTER'S WORKSHOP - DAWN", "cast": [{"id": 0, "name": "ADELAIDE PRYCE", "names": ["ADELAIDE PRYCE", "ADELAIDE"], "gender": "m", "first": 6, "spoke": 11}, {"id": 1, "name": "TOBIAS WREN", "names": ["TOBIAS WREN", "TOBIAS"], "gender": "?", "first": 9, "spoke": 9}, {"id": 2, "name": "BOY", "names": ["BOY"], "gender": "?", "first": 26, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAMPLIGHTER'S WORKSHOP - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "1887.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "London.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Brass tools.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Oil cans.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A cold stove.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "MRS. ADELAIDE PRYCE, 60s, black bombazine, stands in the doorway.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Does not sit.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "Gloves stay on.", "para": 1, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "Across the bench: TOBIAS WREN, 60s, lamplighter.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Wick scissors in hand.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He trims nothing.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "A kettle ticks as it cools.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "You kept the shop.", "name": "ADELAIDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Rent's paid.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She touches a lamp on the shelf.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Dusts her glove on it.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Studies the smear.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Not by much, I'd say.", "name": "ADELAIDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "He sets the scissors down.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Picks them up again.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "You came a long way.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "The cab was warm.", "name": "ADELAIDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "A bell clangs in the street.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "A boy's voice, muffled through the wall.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Lamps, Mr. Wren! Gas is on at Fenchurch!", "name": "BOY", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Tobias does not turn.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Adelaide watches him not turn.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Your boy?", "name": "ADELAIDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Hired.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "He shouts like his mother.", "name": "ADELAIDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Tobias's jaw works.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "He crosses to the stove.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Opens it.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Closes it.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Nothing inside.", "para": 8, "sent": 4, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Tea?", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "No.", "name": "ADELAIDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "She sits.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Finally.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "The chair creaks.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "He looks at the chair, then at her gloves.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Take those off. You'll boil.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "It's November.", "name": "ADELAIDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Still.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "A long beat.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "She pulls one finger loose.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Stops.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Pushes it back.", "para": 10, "sent": 3, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "I said what I came to say. In the letter.", "name": "ADELAIDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "I burned the letter.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Then you know.", "name": "ADELAIDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "I know.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "The boy shouts again, further off.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Fainter.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "Lamps!", "name": "BOY", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Adelaide rises.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Smooths her skirt twice.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Crosses to the door.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "Stops with her back to him.", "para": 12, "sent": 3, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Light one for me. On Fenchurch.", "name": "ADELAIDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "It's lit.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "Then light it again.", "name": "ADELAIDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "She leaves.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "The bell over the door swings.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "Tobias takes down the dusty lamp.", "para": 13, "sent": 2, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "Wipes the smear with his sleeve.", "para": 13, "sent": 3, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "Carefully.", "para": 13, "sent": 4, "present": [0, 1, 2]}]}