 "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Pours tea.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Auditors will be reviewing all workstations. Including unoccupied ones.", "name": "INTERCOM", "speaker": 1, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She stops chewing.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Employee Kowalczyk's desk has been unoccupied for eleven months. Please report to Facilities.", "name": "INTERCOM", "speaker": 1, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Renata sets down the sandwich.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Looks through the grate.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Her empty cubicle.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "A dead plant.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Her nameplate.", "para": 5, "sent": 4, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "A flashlight beam sweeps the crawlspace behind her.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Oh, no.", "name": "RENATA", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1]}]}