{"scene_id": "s01073", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01073.fountain", "heading": "INT. COUNTY COURTHOUSE - LOADING DOCK - DAY", "cast": [{"id": 0, "name": "ATTORNEY NADIA BRENNAN", "names": ["ATTORNEY NADIA BRENNAN", "NADIA"], "gender": "?", "first": 5, "spoke": 5}, {"id": 1, "name": "ATTORNEY ELI MORROW", "names": ["ATTORNEY ELI MORROW", "ELI"], "gender": "?", "first": 5, "spoke": 5}, {"id": 2, "name": "JUDGE OKONKWO-REYES", "names": ["JUDGE OKONKWO-REYES"], "gender": "?", "first": 18, "spoke": 4}, {"id": 3, "name": "DEPUTY HALE", "names": ["DEPUTY HALE"], "gender": "m", "first": 28, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. COUNTY COURTHOUSE - LOADING DOCK - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Concrete.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rolling carts.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Evidence boxes stacked to the ceiling.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A freight elevator groans.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ATTORNEY NADIA BRENNAN, 30s, sharp suit, sneakers, drags a box off a cart.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "ATTORNEY ELI MORROW, 50s, rumpled, waits with a clipboard.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Opposing counsel.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Neither smiles.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "You're late.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Your clerk lost the key.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "She never loses keys.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "She lost this one.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She pops the lid.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Inside: a ledger, water-stained.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Eli goes still.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "That's not on the inventory.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "It is now.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "JUDGE OKONKWO-REYES, 60s, robe over a windbreaker, appears at the elevator door.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Cigarette unlit between her fingers.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Nadia and Eli straighten.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Counselors. Tell me why a sealed ledger is sitting on a dock.", "name": "JUDGE OKONKWO-REYES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Your Honor, she tampered with a chain of custody.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "He moved it. I found it.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "She found it. He moved it. Wonderful.", "name": "JUDGE OKONKWO-REYES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Eli lunges for the ledger.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Nadia jerks it away.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Boxes topple.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "A bailiff, DEPUTY HALE, 20s, bursts in from the stairwell, hand on holster.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Freeze! Everybody!", "name": "DEPUTY HALE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "All three freeze.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Eli with one hand out.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Nadia clutching the ledger.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "The Judge, calm, lights her cigarette.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Deputy. Stand down. They're lawyers. They only bite on the record.", "name": "JUDGE OKONKWO-REYES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Hale lowers his hand.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Exhales.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Give me the ledger. Both of you. My chambers, ten minutes.", "name": "JUDGE OKONKWO-REYES", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Nadia hands it over.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Eli sags against a cart.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "She'll bury us.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Not her. She's deciding who gets to dig.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "The elevator doors close on the Judge.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Deputy Hale picks up a fallen box.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Sets it carefully back on the stack.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}]}