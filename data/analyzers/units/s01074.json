{"scene_id": "s01074", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01074.fountain", "heading": "INT. OFFICE SUPPLY CLOSET WITH A BIRTHDAY PARTY - DAY", "cast": [{"id": 0, "name": "GLORIA PETROSYAN", "names": ["GLORIA PETROSYAN", "GLORIA"], "gender": "m", "first": 6, "spoke": 14}, {"id": 1, "name": "DEZ", "names": ["DEZ"], "gender": "m", "first": 7, "spoke": 7}, {"id": 2, "name": "ADEYEMI", "names": ["ADEYEMI"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "PRIYA NAIR", "names": ["PRIYA NAIR", "PRIYA"], "gender": "f", "first": 8, "spoke": 6}, {"id": 4, "name": "TALL MAN", "names": ["TALL MAN"], "gender": "?", "first": 9, "spoke": 5}, {"id": 5, "name": "BERTRAM", "names": ["BERTRAM"], "gender": "m", "first": 38, "spoke": 10}, {"id": 6, "name": "MAILROOM KID", "names": ["MAILROOM KID"], "gender": "?", "first": 92, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. OFFICE SUPPLY CLOSET WITH A BIRTHDAY PARTY - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A closet turned party room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Paper streamers.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A sheet cake on a filing box.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Fluorescent hum.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A banner: HAPPY 5TH ANNIVERSARY OF THE REORG.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "GLORIA PETROSYAN, 50s, regional manager, lanyard heavy with badges, cuts cake into identical squares.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "DESMOND \"DEZ\" ADEYEMI, 30s, tie loosened, scrolls his phone.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "PRIYA NAIR, 20s, intern, holds a stack of paper plates like a shield.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "A TALL MAN in a gray suit leans in the doorway.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Clipboard.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "No smile.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Nobody knows him.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Cake?", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "I'm good.", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "I'll take his. If he's not.", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Take two.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Priya takes two.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Eats one standing.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Dez keeps scrolling.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Is this the Q3 alignment huddle?", "name": "TALL MAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "It's cake.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "But is it a huddle?", "name": "TALL MAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Everything's a huddle.", "name": "DEZ", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Is that bad?", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "It's Tuesday.", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "The Tall Man writes something.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Gloria slides a square toward him.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "He doesn't take it.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "You're with Compliance?", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Efficiency.", "name": "TALL MAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Same floor as Compliance.", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Different elevator.", "name": "TALL MAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Priya laughs.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Stops.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Looks at Gloria.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Gloria is not laughing.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Name?", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Hollis. Bertram Hollis.", "name": "TALL MAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Mr. Hollis. Cake?", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Fine. A small one.", "name": "BERTRAM", "speaker": 5, "ext": [], "paren": ["softening"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "She hands him a plate.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "He eats.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Chews slowly.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Dez finally pockets his phone.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "So what's being made efficient?", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Closets.", "name": "BERTRAM", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "This closet?", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "Any closet.", "name": "BERTRAM", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "Gloria and Dez trade a look.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "Priya stuffs the second square in her mouth whole.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "We use this one.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "For parties.", "name": "BERTRAM", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "For morale.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "Morale isn't a line item.", "name": "BERTRAM", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "Neither is you.", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "Silence.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "Priya swallows.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "Bertram caps his pen, uncaps it.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "I'll note the cake.", "name": "BERTRAM", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "Note the frosting. It's lemon.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "dialogue", "text": "Lemon.", "name": "BERTRAM", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "dialogue", "text": "Lemon's her mother's recipe.", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "dialogue", "text": "It's not.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "dialogue", "text": "Oh.", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "The door swings.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "action", "text": "A cart of toner cartridges rolls in, pushed by nobody visible.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "action", "text": "Everyone steps back.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "action", "text": "The cart bumps the cake box.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "action", "text": "Cake wobbles.", "para": 9, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "action", "text": "All four grab at the box.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "action", "text": "Dez catches the front corner.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "action", "text": "Priya the back.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "action", "text": "Gloria the cake.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "action", "text": "Bertram the banner.", "para": 10, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 75, "kind": "action", "text": "Everything holds.", "para": 10, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 76, "kind": "action", "text": "They stand like that.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 77, "kind": "action", "text": "Breathing.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 78, "kind": "dialogue", "text": "Nobody say anything.", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 79, "kind": "dialogue", "text": "I wasn't going to.", "name": "BERTRAM", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 80, "kind": "dialogue", "text": "Mr. Hollis, you're holding a banner.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 81, "kind": "dialogue", "text": "So I am.", "name": "BERTRAM", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 82, "kind": "action", "text": "He doesn't let go.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 83, "kind": "action", "text": "Neither does anyone else.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 84, "kind": "action", "text": "The fluorescent hum fills the closet.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 85, "kind": "dialogue", "text": "Is this the huddle?", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 86, "kind": "dialogue", "text": "Yes.", "name": "BERTRAM", "speaker": 5, "ext": [], "paren": ["dry"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 87, "kind": "dialogue", "text": "Then I'd say alignment is achieved.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 88, "kind": "action", "text": "Dez snorts.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 89, "kind": "action", "text": "Priya giggles.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 90, "kind": "action", "text": "Bertram, against his will, almost smiles.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 91, "kind": "action", "text": "The cart's wheel squeaks once, and a tiny voice calls from behind the toner.", "para": 13, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 92, "kind": "dialogue", "text": "Sorry! Sorry. Is that Gloria's closet?", "name": "MAILROOM KID", "speaker": 6, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 93, "kind": "dialogue", "text": "It's everyone's closet.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": ["calling"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 94, "kind": "dialogue", "text": "Cool. Also there's cake?", "name": "MAILROOM KID", "speaker": 6, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 95, "kind": "action", "text": "Gloria hands Priya the knife.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 96, "kind": "dialogue", "text": "Cut another.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}