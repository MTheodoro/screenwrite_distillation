{"scene_id": "s01076", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01076.fountain", "heading": "INT. HOTEL BALLROOM - STACKED CHAIRS AFTER A CONFERENCE - NIGHT", "cast": [{"id": 0, "name": "MARGUERITE DELACROIX-OYELARAN", "names": ["MARGUERITE DELACROIX-OYELARAN", "MARGUERITE"], "gender": "?", "first": 5, "spoke": 20}, {"id": 1, "name": "THADDEUS BECK", "names": ["THADDEUS BECK", "THADDEUS"], "gender": "?", "first": 7, "spoke": 20}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOTEL BALLROOM - STACKED CHAIRS AFTER A CONFERENCE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Chairs stacked in towers.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A banner reading SYNERGY SUMMIT sags from one corner.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Two coffee urns, empty.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "One man, one woman, one table.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MARGUERITE DELACROIX-OYELARAN, 50s, VP of Culture.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Reading glasses on a chain.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "THADDEUS BECK, 30s, regional trainer, name tag still on.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She sits.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He stands.", "para": 1, "sent": 4, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Sit, Thaddeus.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I'd rather stand.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "That's what people say before they're fired.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Am I being fired?", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "No. You're being promoted. Which is worse.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Okay.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "You'll lead the new Innovation Pod. Eight people. No budget.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "That's not a promotion.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "It has a title.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "What title?", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Chief Pod Officer.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "That's a joke.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "It's on the org chart. I printed it.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Marguerite.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "I know.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Last month you cut my team in half. You said \"lean.\"", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "It was lean.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "You said \"family.\"", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "We are a family.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Families don't send a calendar invite for a funeral.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Thaddeus.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "They sent me an invite. For my own mentor's funeral. Titled \"Farewell Sync.\"", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "That was an unfortunate template.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "It had a Zoom link.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Lower your voice.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "The room is empty!", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "The walls are not.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "I trained four hundred people today. About \"psychological safety.\" Four hundred. I held their hands.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "And they loved you.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "They're also being laid off.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "You knew that.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "I found out at lunch. From a vending machine receipt. Somebody's severance code was on it.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "That's an IT problem.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "No. That's a me problem. I smiled at them. I handed out lanyards. With their termination dates printed on the back.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Thaddeus.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "I'm done. Chief Pod Officer. I'm done.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "You can't quit. You haven't vested.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "Watch me.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "He rips off his name tag and slaps it on the table.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "She stares at it a long moment.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "That's a two-hundred-dollar badge.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Put it on the budget I don't have.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}