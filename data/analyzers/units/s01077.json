{"scene_id": "s01077", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01077.fountain", "heading": "EXT. SALT FLATS - ABANDONED RAILWAY SIDING - DAWN", "cast": [{"id": 0, "name": "MAJOR ALEKSANDRA VOSS", "names": ["MAJOR ALEKSANDRA VOSS", "VOSS"], "gender": "f", "first": 4, "spoke": 9}, {"id": 1, "name": "LIEUTENANT RAFAEL OROZCO", "names": ["LIEUTENANT RAFAEL OROZCO", "OROZCO"], "gender": "?", "first": 5, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SALT FLATS - ABANDONED RAILWAY SIDING - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Glare off the white crust.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A rusting locomotive sits on a rail that leads nowhere.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Smoke on the horizon.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MAJOR ALEKSANDRA VOSS, 40s, field coat, a bandage across her palm, crouches by the engine's wheel.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside her, LIEUTENANT RAFAEL OROZCO, 20s, pale and sunburned, scans the horizon with binoculars.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "She wipes grit from a map.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He lowers the glasses.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Dust on the east road, Major.", "name": "OROZCO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "How much?", "name": "VOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "A lot.", "name": "OROZCO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She stands.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Squints.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Unfolds the map across the locomotive's flank.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Armor, then. Or trucks. We'll know in a minute.", "name": "VOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "He doesn't move.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She looks at him.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He is gripping the binoculars hard.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Lieutenant.", "name": "VOSS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Ma'am.", "name": "OROZCO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Breathe.", "name": "VOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "He does.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "She takes the glasses from his hands, raises them.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Her jaw sets.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "It's trucks?", "name": "OROZCO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "It's both.", "name": "VOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "She hands the binoculars back.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "He looks again.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Lowers them slowly.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "We could hole up in the engine.", "name": "OROZCO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "It's a coffin with a smokestack.", "name": "VOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "He nods.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "He stares at the rails.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "She folds the map, tucks it into her coat, pulls out a small mirror.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "What's that for?", "name": "OROZCO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Signal. If anyone is still listening on that ridge.", "name": "VOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "He watches her angle the mirror to the sun.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "A flash.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Another.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Another.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "She waits.", "para": 8, "sent": 4, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "He waits.", "para": 8, "sent": 5, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Nothing answers.", "para": 8, "sent": 6, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Ma'am. If nobody is there?", "name": "OROZCO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Then we signal anyway.", "name": "VOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "She flashes again.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "The dust cloud swells on the road.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "He pulls his rifle from his shoulder.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "She puts her hand on the barrel.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "Gently.", "para": 9, "sent": 4, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "He looks at her.", "para": 9, "sent": 5, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Not yet.", "name": "VOSS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "He lowers it.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "The sun climbs higher.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "Far off, an engine note rises, like a long breath drawn.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "She keeps flashing the mirror.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "He starts to count under his breath.", "para": 11, "sent": 1, "present": [0, 1]}]}