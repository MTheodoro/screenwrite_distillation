{"scene_id": "s01078", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01078.fountain", "heading": "INT. SKATING RINK CONCESSION STAND - AFTERNOON", "cast": [{"id": 0, "name": "JUNE", "names": ["JUNE"], "gender": "f", "first": 6, "spoke": 16}, {"id": 1, "name": "ABARA", "names": ["ABARA"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "DANNY KOSTOPOULOS", "names": ["DANNY KOSTOPOULOS", "DANNY"], "gender": "f", "first": 10, "spoke": 15}, {"id": 3, "name": "MR. PRUITT", "names": ["MR. PRUITT"], "gender": "?", "first": 22, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. SKATING RINK CONCESSION STAND - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "1989.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Faded posters of rollerskates.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A disco ball turns slowly over empty hardwood.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The popcorn machine hums.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Behind the counter, a cluttered shelf of mismatched rental skates.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "JUNIPER \"JUNE\" ABARA, 16, braids and a Walkman, counts quarters into a cash drawer.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "She is the only one working.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Her mouth moves silently with whatever she hears.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "The front door chimes.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "DANNY KOSTOPOULOS, 17, enters.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Letterman jacket too big for him.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "He carries a gym bag.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Hey. Is the big room open?", "name": "DANNY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Not till four.", "name": "JUNE", "speaker": 0, "ext": [], "paren": ["pulling off a headphone"], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "I'll wait.", "name": "DANNY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Suit yourself.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "He sits on a stool.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Taps the counter.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Pretends not to look at her.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "She pretends not to notice.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Do you work here, like, always?", "name": "DANNY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Saturdays. And school nights. And whenever Mr. Pruitt forgets to pay somebody else.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "That sounds rough.", "name": "DANNY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "It's okay. I get free popcorn.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "She slides a small bag across the counter.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "He takes it.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Thanks.", "name": "DANNY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Don't tell Pruitt.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Wouldn't.", "name": "DANNY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "They sit in friendly quiet.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "The disco ball turns.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "A speaker crackles overhead.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "June, did you restock the nacho cheese?", "name": "MR. PRUITT", "speaker": 3, "ext": ["V.O."], "paren": ["over the PA"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Yes, Mr. Pruitt!", "name": "JUNE", "speaker": 0, "ext": [], "paren": ["calling up at the ceiling"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Good girl.", "name": "MR. PRUITT", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "June rolls her eyes.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Danny almost laughs.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "He pulls a folded paper from his jacket.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Can I ask you something? Not weird.", "name": "DANNY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "That's how weird questions start.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "It's about my sister.", "name": "DANNY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Okay.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "He unfolds the paper.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "A flyer.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "A missing-person flyer, photocopied crooked.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "A girl's face, braids like June's.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "She worked here. Last summer.", "name": "DANNY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "June stops counting quarters.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Rosalind.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "You knew her?", "name": "DANNY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "I took her shifts. When she left.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "She didn't leave. She --", "name": "DANNY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "He cuts himself off.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "June closes the cash drawer.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Very slowly.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Danny. Mr. Pruitt keeps a locked room. Behind the skate lockers.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "What's in it?", "name": "DANNY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "I don't know. But Rosalind's jacket is hanging on the door.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "Danny stares at her.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "The popcorn machine hums.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "The disco ball spins across his face.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "Show me.", "name": "DANNY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "Not now.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "Why not?", "name": "DANNY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "Folks, we're opening the big room early today. Skate on in!", "name": "MR. PRUITT", "speaker": 3, "ext": ["V.O."], "paren": ["over the PA, cheerful"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "The doors at the far end of the rink swing open.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "Light floods the floor.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "That's why.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "She reaches under the counter.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "Pulls out a ring of keys.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "Presses them into his palm.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "Four o'clock. When the music's loud. The brass one.", "name": "JUNE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "Thank you.", "name": "DANNY", "speaker": 2, "ext": [], "paren": ["barely a whisper"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "dialogue", "text": "Don't thank me yet.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "Danny pockets the keys.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "Picks up his gym bag.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "Skaters spill through the far doors.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "action", "text": "June puts on her Walkman and turns back to the register, calm as a clock.", "para": 13, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "action", "text": "The disco ball catches Danny's face one last time as he walks into the crowd.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}]}