{"scene_id": "s01079_0", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01079.fountain", "heading": "INT. LIGHTHOUSE KEEPER'S COTTAGE - KITCHEN - NIGHT", "cast": [{"id": 0, "name": "TAMSIN HOLLOWAY", "names": ["TAMSIN HOLLOWAY", "TAMSIN"], "gender": "f", "first": 5, "spoke": 3}, {"id": 1, "name": "RADIO", "names": ["RADIO"], "gender": "m", "first": 11, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. LIGHTHOUSE KEEPER'S COTTAGE - KITCHEN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A storm presses at the windows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single oil lamp.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cracked radio on the sill.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Bread dough rises under a damp cloth.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "TAMSIN HOLLOWAY, 15, wool sweater, sleeves pushed up, kneads at the table.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She is alone.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She talks to the dough.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "dialogue", "text": "You'll be fine. You're a good loaf. Don't listen to the wind.", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 9, "kind": "action", "text": "The radio hisses.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "She wipes her hands on her apron and turns the dial.", "para": 2, "sent": 1, "present": [0]}, {"u": 11, "kind": "dialogue", "text": "...coast guard advises all small craft... gale force... off Marrow Point...", "name": "RADIO", "speaker": 1, "ext": ["V.O."], "paren": ["crackling"], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She turns it up.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Frowns.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "That's us.", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She checks the clock.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "9:40.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Pulls on a coat.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Picks up the lamp.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Dad said stay inside. Dad also said the light never fails.", "name": "TAMSIN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She opens the back door.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Wind slams it wide.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "She shoves it closed, hard, then tries again, shoulder first.", "para": 5, "sent": 2, "present": [0, 1]}]}