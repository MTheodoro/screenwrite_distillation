{"scene_id": "s01079_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01079.fountain", "heading": "EXT. LIGHTHOUSE STAIRS - CONTINUOUS", "cast": [{"id": 0, "name": "TAMSIN", "names": ["TAMSIN"], "gender": "m", "first": 2, "spoke": 9}, {"id": 1, "name": "RADIO", "names": ["RADIO"], "gender": "m", "first": 7, "spoke": 3}, {"id": 2, "name": "ELIAS MARRIOT", "names": ["ELIAS MARRIOT", "ELIAS"], "gender": "m", "first": 15, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. LIGHTHOUSE STAIRS - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Narrow iron steps spiral up into the dark.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Tamsin climbs, lamp swinging.", "para": 0, "sent": 1, "present": [0]}, {"u": 3, "kind": "dialogue", "text": "Seventy-two steps. Seventy-two. Don't count the missing one.", "name": "TAMSIN", "speaker": 0, "ext": ["CONT'D"], "paren": ["to herself"], "dual": false, "present": [0]}, {"u": 4, "kind": "action", "text": "Halfway up, the radio in her coat pocket crackles.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She stops.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Pulls it out.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "dialogue", "text": "Keeper, come in. Keeper Holloway, do you read?", "name": "RADIO", "speaker": 1, "ext": ["V.O."], "paren": ["faint"], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "It's Tamsin. Dad's in town. The boat didn't come back.", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Understood. How is your light?", "name": "RADIO", "speaker": 1, "ext": ["V.O."], "paren": ["pause, static"], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Dark. I'm going up.", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "At the top, the lantern room.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "A hulking brass mechanism, silent.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Salt crusts the glass.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "And at the far side, crouched in the shadow:", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "An old man in an oilskin coat.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "ELIAS MARRIOT, 70s, beard like seaweed.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "His hands tremble over a half-broken gear.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Who are you?", "name": "TAMSIN", "speaker": 0, "ext": ["CONT'D"], "paren": ["freezing"], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Don't be frightened. I came to fix it.", "name": "ELIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Nobody fixes it but us.", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Your father asked me. Years ago. Said if the light ever failed.", "name": "ELIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "He never told me about you.", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "He wouldn't.", "name": "ELIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Elias lifts the gear in both hands.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "It gleams, wet with oil.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Tamsin sets the lamp down on the floor and kneels beside him.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Show me.", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Hold it steady.", "name": "ELIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "She does.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "He threads a bolt.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The mechanism groans.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Wind howls at the glass.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Keeper, I have a trawler off Marrow Point. They need your beam.", "name": "RADIO", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Ten minutes!", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": ["shouting at the radio"], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Elias turns the final bolt.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "The gear catches.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "A great shuddering sweep of light cuts out across the black water.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Tamsin laughs, breathless.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Elias smiles, slow and tired.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Seventy-two steps.", "name": "TAMSIN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Seventy-three. You forgot the one you made.", "name": "ELIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "She looks out at the beam, wide and white, finding the sea.", "para": 8, "sent": 0, "present": [0, 1, 2]}]}