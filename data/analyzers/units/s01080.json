{"scene_id": "s01080", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01080.fountain", "heading": "INT. MUNICIPAL ARBITRATION ROOM - DAY", "cast": [{"id": 0, "name": "ARBITRATOR SALAZAR-KIM", "names": ["ARBITRATOR SALAZAR-KIM", "SALAZAR-KIM"], "gender": "?", "first": 4, "spoke": 8}, {"id": 1, "name": "LAWYER DEWITT PIKE", "names": ["LAWYER DEWITT PIKE", "PIKE"], "gender": "?", "first": 5, "spoke": 5}, {"id": 2, "name": "YUSUPOVA", "names": ["YUSUPOVA", "MRS. YUSUPOVA"], "gender": "?", "first": 5, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. MUNICIPAL ARBITRATION ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Fake wood paneling.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A humming vending machine in the corner.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A conference table too big for the room.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ARBITRATOR SALAZAR-KIM, 50s, bifocals, reads a file.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across from her sit LAWYER DEWITT PIKE, 40s, tie clip shaped like a gavel, and CLIENT MRS. YUSUPOVA, 70s, handbag on her lap.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "Pike clicks a pen.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Mrs. Yusupova stares at the vending machine.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Salazar-Kim turns a page, Pike clicks again, and Mrs. Yusupova opens her handbag, closes it, opens it.", "para": 1, "sent": 4, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Mr. Pike, your client claims the landlord shut off her heat for three winters.", "name": "SALAZAR-KIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Correct.", "name": "PIKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Mrs. Yusupova, is that accurate?", "name": "SALAZAR-KIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Cold. Always cold. I wear coat in kitchen.", "name": "MRS. YUSUPOVA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "And the landlord, Mr. Brandt, says he was never notified.", "name": "SALAZAR-KIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "We have eleven letters.", "name": "PIKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Sent how?", "name": "SALAZAR-KIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Certified mail.", "name": "PIKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Also I knock his door. Many times.", "name": "MRS. YUSUPOVA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Did he answer?", "name": "SALAZAR-KIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Once. He gave me blanket.", "name": "MRS. YUSUPOVA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Your Honor, that's not relevant.", "name": "PIKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "I'm an arbitrator, Mr. Pike. Not a Your Honor. And I'd like to hear about the blanket.", "name": "SALAZAR-KIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Gray. Scratchy. Smell like dog.", "name": "MRS. YUSUPOVA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Gray, scratchy, smelled like dog.", "name": "SALAZAR-KIM", "speaker": 0, "ext": [], "paren": ["writing"], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "We'd ask for restitution of nine thousand dollars.", "name": "PIKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "And the blanket?", "name": "SALAZAR-KIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Keep. Is warm.", "name": "MRS. YUSUPOVA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}