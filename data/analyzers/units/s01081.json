{"scene_id": "s01081", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01081.fountain", "heading": "INT. BACK ROOM OF A TAXIDERMY SHOP - NIGHT", "cast": [{"id": 0, "name": "ROCCO", "names": ["ROCCO"], "gender": "?", "first": 5, "spoke": 11}, {"id": 1, "name": "VANTI", "names": ["VANTI"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "SAL MAROUNI", "names": ["SAL MAROUNI", "SAL"], "gender": "m", "first": 6, "spoke": 10}, {"id": 3, "name": "LENA FISHBACH", "names": ["LENA FISHBACH", "LENA"], "gender": "f", "first": 7, "spoke": 8}, {"id": 4, "name": "TIMOTHY BLACKWOOD-ADE", "names": ["TIMOTHY BLACKWOOD-ADE", "TIMOTHY"], "gender": "m", "first": 8, "spoke": 12}], "units": [{"u": 0, "kind": "heading", "text": "INT. BACK ROOM OF A TAXIDERMY SHOP - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Glass eyes.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Stuffed owls.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A badger mid-snarl.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A card table with four chairs and one bare bulb.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ROCCO \"THE BOOKKEEPER\" VANTI, 50s, rolled sleeves, counts cash into neat stacks.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "SAL MAROUNI, 30s, tracksuit, bounces a knee.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "LENA FISHBACH, 40s, wire glasses, watches the door.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "TIMOTHY BLACKWOOD-ADE, 20s, nervous, holds a duffel bag in his lap.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Eighty. Eighty-five. Ninety.", "name": "ROCCO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Where's the rest?", "name": "SAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Counting, Sal.", "name": "ROCCO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Timothy, put the bag on the table.", "name": "LENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "It's fine here.", "name": "TIMOTHY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Put it on the table.", "name": "SAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "I said it's fine.", "name": "TIMOTHY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Why are you sweating?", "name": "LENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "It's hot.", "name": "TIMOTHY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "It's a taxidermy shop in November.", "name": "SAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "The badger gives off heat.", "name": "TIMOTHY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Ninety-five. A hundred.", "name": "ROCCO", "speaker": 0, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Lena shifts her chair.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "A floorboard creaks somewhere above them.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Timothy flinches.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Who else is here?", "name": "SAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Nobody.", "name": "TIMOTHY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "There's a second floor?", "name": "LENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Storage.", "name": "ROCCO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Check it.", "name": "SAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "I'll check it.", "name": "LENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Sit down, Lena.", "name": "ROCCO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Rocco, there's something up there.", "name": "LENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "It's a possum. Frank keeps one on a branch.", "name": "ROCCO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Dead?", "name": "SAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Obviously dead.", "name": "ROCCO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "The ceiling creaks again.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "All four look up.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "The bulb sways.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "A shadow slides across the badger's snout.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "That didn't sound dead.", "name": "TIMOTHY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "That sounded like a person.", "name": "LENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Give me the bag.", "name": "SAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "No.", "name": "TIMOTHY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Give me the bag, Timothy.", "name": "SAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "I can't.", "name": "TIMOTHY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Why not?", "name": "ROCCO", "speaker": 0, "ext": [], "paren": ["slowly setting down the money"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Because it's not the money.", "name": "TIMOTHY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "The bulb swings.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Sal's hand drifts toward his jacket.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Lena eases her chair back.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "Then what is it?", "name": "LENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "I didn't have a choice. They said bring it or --", "name": "TIMOTHY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "Who said?", "name": "ROCCO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "The man upstairs.", "name": "TIMOTHY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "The ceiling groans.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Footsteps cross to the top of the stairs.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "A silhouette fills the doorway above.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Boots descend one step at a time.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "Rocco.", "name": "SAL", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "Everybody stay calm.", "name": "ROCCO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "I'm calm.", "name": "LENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "dialogue", "text": "I'm not calm.", "name": "SAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "dialogue", "text": "He said don't run.", "name": "TIMOTHY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "The boots reach the bottom stair.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "A hand reaches out and flicks off the bulb.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "Dark.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "action", "text": "Glass eyes gleam in the red glow of an exit sign.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "dialogue", "text": "Nobody move.", "name": "ROCCO", "speaker": 0, "ext": [], "paren": ["a hush"], "dual": false, "present": [0, 1, 2, 3, 4]}]}