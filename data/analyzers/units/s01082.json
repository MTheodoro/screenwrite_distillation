{"scene_id": "s01082", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01082.fountain", "heading": "INT. MINIATURE GOLF CLUBHOUSE - A PIRATE SHIP FOUNDERED IN PLASTER - DAY", "cast": [{"id": 0, "name": "BARNABY QUINCE", "names": ["BARNABY QUINCE", "BARNABY"], "gender": "?", "first": 6, "spoke": 12}, {"id": 1, "name": "ODALYS FERREIRA-LAWSON", "names": ["ODALYS FERREIRA-LAWSON", "ODALYS"], "gender": "?", "first": 7, "spoke": 10}, {"id": 2, "name": "PARROT", "names": ["PARROT"], "gender": "?", "first": 14, "spoke": 2}, {"id": 3, "name": "CHILD", "names": ["CHILD"], "gender": "?", "first": 31, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. MINIATURE GOLF CLUBHOUSE - A PIRATE SHIP FOUNDERED IN PLASTER - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A clubhouse built like a shipwreck.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fiberglass barnacles.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A parrot animatronic that squawks on a timer.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Scorecards pinned to a mast.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The windows overlook a windmill hole where nobody is playing.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "BARNABY QUINCE, 50s, tour-guide's moustache, pirate hat two sizes small, sits behind the counter practicing a speech to the empty room.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Beside the register, ODALYS FERREIRA-LAWSON, 20s, mini-golf league champion, rolls a putter along the floorboards, bored.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Ahoy, ye mighty putters! Today we face the Kraken's Revenge, hole eighteen, par three...", "name": "BARNABY", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Nobody is here, Barnaby.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Practice makes plunder.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": ["muttering to himself"], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "You say that to the parrot, too.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "The parrot's a good listener.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "The parrot squawks on cue.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Pieces of eight! Pieces of eight!", "name": "PARROT", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "See?", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "It's on a loop.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "She sinks a putt into a coffee cup.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Barnaby claps.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "She bows.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Ladies and gentlemen --", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "There's no ladies and gentlemen.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Ladies and gentleman.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Gentleperson.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Gentleperson! Excellent.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": ["delighted"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "The door chimes.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "A family of six enters in matching shirts.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "They fill the clubhouse with sunburn and noise.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Barnaby leaps up, hat tilting.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Welcome, brave souls! Who dares challenge the Kraken?", "name": "BARNABY", "speaker": 0, "ext": ["CONT'D"], "paren": ["grandly, to all"], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "A small child points at Odalys.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "She's got a golf stick!", "name": "CHILD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "It's a putter.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": ["to the child"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "It's a cutlass, my boy.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": ["to the child"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "They speak at once.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Eighteen holes of peril!", "name": "BARNABY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "^Eighteen holes of boredom.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Odalys.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": ["hissing"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "What? It's honest.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": ["whispering back"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "The family cheers anyway.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Barnaby sweeps the hat off, bows with a flourish.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "The hat tips off his head, rolls across the floor, and stops at the child's feet.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "The child puts it on.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Well, that's a first.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": ["quietly, to himself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Don't get used to it. You'll want it back.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": ["to him, under her breath"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Barnaby hands out putters.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Odalys slides the scorecards across the counter.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "The parrot squawks.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Pieces of eight!", "name": "PARROT", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "And a mutiny.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": ["deadpan"], "dual": false, "present": [0, 1, 2, 3]}]}