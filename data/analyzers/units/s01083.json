{"scene_id": "s01083", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01083.fountain", "heading": "INT. WIZARD'S LIBRARY - THE ROOM OF TURNING SHELVES - NIGHT", "cast": [{"id": 0, "name": "ARCHIVIST THESSALY MOORE", "names": ["ARCHIVIST THESSALY MOORE", "THESSALY"], "gender": "f", "first": 5, "spoke": 9}, {"id": 1, "name": "KESTREL DONOVAN-ABIOLA", "names": ["KESTREL DONOVAN-ABIOLA", "KESTREL"], "gender": "f", "first": 6, "spoke": 7}, {"id": 2, "name": "VOICE", "names": ["VOICE"], "gender": "?", "first": 8, "spoke": 4}, {"id": 3, "name": "RAVEN-HEADED STRANGER", "names": ["RAVEN-HEADED STRANGER"], "gender": "?", "first": 28, "spoke": 1}, {"id": 4, "name": "SCRIBE", "names": ["SCRIBE"], "gender": "?", "first": 30, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. WIZARD'S LIBRARY - THE ROOM OF TURNING SHELVES - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Shelves rotate on slow brass gears.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Books drift between them on their own.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A fire burns in a hearth with no chimney.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Candles hover.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ARCHIVIST THESSALY MOORE, 40s, ink-stained sleeves, spectacles on a cord, kneels at a lectern, copying a rune.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Beside her, apprentice KESTREL DONOVAN-ABIOLA, 16, holds a lantern.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Both ignore the voice murmuring through the walls.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Found you.", "name": "VOICE", "speaker": 2, "ext": ["V.O."], "paren": ["from the stone itself"], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Thessaly's quill stops.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Kestrel steps closer to her.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Was that the library?", "name": "KESTREL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "The library doesn't speak.", "name": "THESSALY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Oh, but I do. Thessaly Moore. You took something that is mine.", "name": "VOICE", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I borrowed a book.", "name": "THESSALY", "speaker": 0, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "A book. Yes. Open to the last page and read me what it says.", "name": "VOICE", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Kestrel pulls a leather volume from the shelf.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "It is warm in her hands.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "She flips to the last page.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "\"Whoever opens this book wakes the one who wrote it.\"", "name": "KESTREL", "speaker": 1, "ext": [], "paren": ["reading"], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Put it back. Slowly.", "name": "THESSALY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Kestrel reaches.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "The shelf rotates away from her.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "The book will not return to its slot.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Do not trouble yourself. I am already awake.", "name": "VOICE", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "The candles gutter.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "In the center of the room, the air thickens.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "A tall figure forms in a coat of gray feathers.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "A RAVEN-HEADED STRANGER, calm, hands clasped.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Its beak glints.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Good evening. I am the Scribe.", "name": "RAVEN-HEADED STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "I know who you are.", "name": "THESSALY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Then you know why I came.", "name": "SCRIBE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Kestrel edges behind the lectern.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Thessaly rises, quill still in hand.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "The pages were never yours. They belonged to the kingdom.", "name": "THESSALY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "I wrote the kingdom. Every war. Every winter. Every funeral. It is all mine.", "name": "SCRIBE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Thessaly, his shadow is moving wrong.", "name": "KESTREL", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "It is.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "The shadow on the floor writes in the air, slow letters curling in black smoke.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Don't read it.", "name": "THESSALY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "I can't help it.", "name": "KESTREL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "She reads.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Her eyes widen.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "It says my name.", "name": "KESTREL", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Kestrel Donovan-Abiola. Born in the ninth year of the drought. Died in the eleventh page of tonight.", "name": "SCRIBE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Then turn the page.", "name": "THESSALY", "speaker": 0, "ext": [], "paren": ["stepping between them"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "I would, if you could stop me.", "name": "SCRIBE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Thessaly raises the quill.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "The tip ignites white.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "She draws a line across the air.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "A bright barrier of light slices the room.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "The Scribe flinches.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Feathers scatter.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "That ink is older than I am.", "name": "SCRIBE", "speaker": 4, "ext": ["CONT'D"], "paren": ["a hiss"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "Good. It remembers you.", "name": "THESSALY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "The shelves spin faster.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "The book in Kestrel's hands flares gold.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "She slams it shut.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "The Scribe shrieks.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "Give it back!", "name": "SCRIBE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "No.", "name": "KESTREL", "speaker": 1, "ext": [], "paren": ["holding it close"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "The hearth fire roars.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "The room tilts.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "Candles fall like stars.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "Then I will wait. Stories do.", "name": "SCRIBE", "speaker": 4, "ext": ["V.O."], "paren": ["already fading"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "The figure dissolves into black ink that runs down the wall and soaks into the stone.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "action", "text": "The shelves slow.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "action", "text": "The candles steady.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "Silence.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "action", "text": "Thessaly lowers her quill, trembling.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "action", "text": "Kestrel lets out a breath.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "dialogue", "text": "Is it over?", "name": "KESTREL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "dialogue", "text": "Not while the book is open.", "name": "THESSALY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "action", "text": "Kestrel looks down.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "action", "text": "The cover is warm.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 76, "kind": "action", "text": "Something inside it beats.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4]}]}