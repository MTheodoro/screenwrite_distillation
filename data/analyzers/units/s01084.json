{"scene_id": "s01084", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01084.fountain", "heading": "INT. DRAINED SWIMMING POOL - COMMUNITY CENTER - DAWN", "cast": [{"id": 0, "name": "DETECTIVE CASSIUS RHEE", "names": ["DETECTIVE CASSIUS RHEE", "RHEE"], "gender": "?", "first": 5, "spoke": 11}, {"id": 1, "name": "FORENSIC TECH BELINDA OSEI", "names": ["FORENSIC TECH BELINDA OSEI", "OSEI"], "gender": "f", "first": 6, "spoke": 7}, {"id": 2, "name": "CAPTAIN VOSS", "names": ["CAPTAIN VOSS"], "gender": "?", "first": 22, "spoke": 2}, {"id": 3, "name": "DOLORES AMADI", "names": ["DOLORES AMADI", "DOLORES"], "gender": "f", "first": 28, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRAINED SWIMMING POOL - COMMUNITY CENTER - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Cracked blue tile.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A dry deep end littered with leaves.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Floodlights on stands.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Yellow tape across the diving board.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DETECTIVE CASSIUS RHEE, 40s, rain jacket, notebook, crouches at the bottom of the deep end beside a chalk outline.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "FORENSIC TECH BELINDA OSEI, 30s, white suit, kneels with a camera.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "A tarp covers something near the drain.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Time of death?", "name": "RHEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Medical examiner says midnight. Give or take.", "name": "OSEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Who drained the pool?", "name": "RHEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Nobody. It's been empty since August.", "name": "OSEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Then how did she end up down here?", "name": "RHEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "She fell. Or she was pushed.", "name": "OSEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He steps over the chalk.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Lifts the tarp with a pen.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Underneath, a single red high-heeled shoe.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Where's the other?", "name": "RHEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Haven't found it.", "name": "OSEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "A phone rings.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Rhee's.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "He answers.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Rhee. Anything?", "name": "CAPTAIN VOSS", "speaker": 2, "ext": ["V.O."], "paren": ["tinny, over the phone"], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "A shoe, Captain. Just a shoe.", "name": "RHEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "There's a witness on her way down. Janitor. Says she saw something.", "name": "CAPTAIN VOSS", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Copy.", "name": "RHEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "He hangs up.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Footsteps on the stairs.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "A figure descends: MS. DOLORES AMADI, 60s, janitor's apron, mop in hand like a staff.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "She stops at the pool edge.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Detective?", "name": "DOLORES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Ms. Amadi. Come down.", "name": "RHEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "She picks her way down the shallow-end steps, mop first.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "I saw a man. By the diving board. Very tall. Very quiet.", "name": "DOLORES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "What was he wearing?", "name": "OSEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Gray. A long coat. Like a priest.", "name": "DOLORES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Did he see you?", "name": "RHEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "No. But he left something.", "name": "DOLORES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "She reaches into her apron pocket.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Pulls out the second red shoe, wrapped in a plastic bag.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Rhee and Osei exchange a look.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "You touched it?", "name": "OSEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "I wore gloves.", "name": "DOLORES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Thank you.", "name": "RHEE", "speaker": 0, "ext": [], "paren": ["taking it"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "A clang from the diving board.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "All three whip around.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "The tape trembles.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "A silhouette stands at the top of the board, backlit by dawn.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Police! Stay where you are!", "name": "RHEE", "speaker": 0, "ext": ["CONT'D"], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "The silhouette leaps.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Rhee lunges.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Osei drops the camera.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Dolores raises the mop.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "They collide at the lip of the deep end in a tangle of arms, mop handle and raincoat.", "para": 8, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "A bright flash from Osei's camera bursts across the tile.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "The man scrambles up the stairs.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Rhee and Dolores sprawl together.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Osei pulls herself up.", "para": 9, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "He's gone!", "name": "OSEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "Not far.", "name": "RHEE", "speaker": 0, "ext": [], "paren": ["breathing hard"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "Dolores sits, hand on her chest, mop still clutched.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "Detective. I think I know that coat.", "name": "DOLORES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}