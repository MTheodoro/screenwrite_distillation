{"scene_id": "s01085", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01085.fountain", "heading": "INT. NIGHT LAUNDROMAT - 2 A.M.", "cast": [{"id": 0, "name": "IMOGEN LAU", "names": ["IMOGEN LAU", "IMOGEN"], "gender": "?", "first": 6, "spoke": 12}, {"id": 1, "name": "SULEIMAN BAH", "names": ["SULEIMAN BAH", "SULEIMAN"], "gender": "?", "first": 10, "spoke": 11}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT LAUNDROMAT - 2 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "Buzzing tubes.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Twelve machines, all but two idle.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A vending machine glows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain at the glass.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Lint in the corners like snow.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "IMOGEN LAU, 30s, scrubs under a trench coat, sits on a folding table.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Boots swinging.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "A paperback open and unread.", "para": 1, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "Her dryer turns a single blue sock.", "para": 1, "sent": 3, "present": [0]}, {"u": 10, "kind": "action", "text": "SULEIMAN BAH, 30s, tall, soft cardigan, loads a washer.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Careful with each shirt.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He folds one before he puts it in.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Her eyes flick to him.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "His hands pause on a collar.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Resume.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "You fold before you wash.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Habit.", "name": "SULEIMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Strange habit.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Strange hours.", "name": "SULEIMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She turns a page she hasn't read.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "He shuts the washer.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Coins.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Click.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Water starts.", "para": 5, "sent": 4, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "You come here often?", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Tuesdays.", "name": "SULEIMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "It's Thursday.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "He looks at the dryer.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "At the single blue sock.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Missed a Tuesday.", "name": "SULEIMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "She nods.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Watches the sock tumble.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "He leans against the washer.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Not too close.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Not far.", "para": 7, "sent": 4, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Night shift?", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Nurse. You?", "name": "SULEIMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Same.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Which floor?", "name": "SULEIMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Fourth.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Third.", "name": "SULEIMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "A beat.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "The washer sloshes.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "The vending machine hums.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "She taps her book.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "We've never met.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "We passed on the stairs. Once.", "name": "SULEIMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Did we?", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "You had a croissant.", "name": "SULEIMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "She almost smiles.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "Hides it with the book.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "He picks a coin from his palm and rolls it across his knuckles.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "That was a bad day.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "It was a good croissant.", "name": "SULEIMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "The dryer buzzes.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "She hops down.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "Opens it.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "Pulls out the sock.", "para": 10, "sent": 3, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "Looks at it.", "para": 10, "sent": 4, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "At him.", "para": 10, "sent": 5, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "Don't suppose you've lost one.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "He reaches into his cardigan pocket.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "Pulls out a blue sock.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "The match.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "They hold the two socks side by side.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 67, "kind": "action", "text": "Neither says anything.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "Tuesday?", "name": "IMOGEN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "Tuesday.", "name": "SULEIMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "action", "text": "She sets her sock in his palm.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "Their fingers do not touch.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "Almost.", "para": 13, "sent": 2, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "She picks up her book and walks out into the rain without her coat.", "para": 13, "sent": 3, "present": [0, 1]}]}