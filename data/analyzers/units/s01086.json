{"scene_id": "s01086", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01086.fountain", "heading": "INT. BOWLING ALLEY - LANE 12 - FINAL FRAME - NIGHT", "cast": [{"id": 0, "name": "DRY CREEK LANES", "names": ["DRY CREEK LANES"], "gender": "?", "first": 4, "spoke": 0}, {"id": 1, "name": "COACH MURIEL TAPIA", "names": ["COACH MURIEL TAPIA", "MURIEL"], "gender": "f", "first": 6, "spoke": 6}, {"id": 2, "name": "DESHAWN", "names": ["DESHAWN"], "gender": "?", "first": 7, "spoke": 3}, {"id": 3, "name": "PRITCHETT", "names": ["PRITCHETT"], "gender": "?", "first": 7, "spoke": 0}, {"id": 4, "name": "ANNIKA BERGSTROM-ODUYA", "names": ["ANNIKA BERGSTROM-ODUYA", "ANNIKA"], "gender": "f", "first": 8, "spoke": 5}, {"id": 5, "name": "HANK WILLOUGHBY", "names": ["HANK WILLOUGHBY", "HANK"], "gender": "m", "first": 9, "spoke": 4}, {"id": 6, "name": "PRESTON LI", "names": ["PRESTON LI", "PRESTON"], "gender": "m", "first": 10, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. BOWLING ALLEY - LANE 12 - FINAL FRAME - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Neon pins.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sticky carpet.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A trophy case.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The league championship banner: DRY CREEK LANES - TUESDAY NIGHT FINALS.", "para": 0, "sent": 3, "present": [0]}, {"u": 5, "kind": "action", "text": "A crowd packs the seats behind the rail, sweating, silent.", "para": 0, "sent": 4, "present": [0]}, {"u": 6, "kind": "action", "text": "COACH MURIEL TAPIA, 60s, windbreaker, clipboard, paces behind the scorers' table.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Next to her, DESHAWN \"THE HAMMER\" PRITCHETT, 30s, in a team polo, chalks his fingers, rolling his shoulders.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "At the lane, ANNIKA BERGSTROM-ODUYA, 20s, ponytail, holds her ball against her chest.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "Opposite them on the other bench, rival captain HANK WILLOUGHBY, 50s, red bowling shirt, smirks and cracks his knuckles.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "At the scoring console, young scorekeeper PRESTON LI, 17, headset on, watches the monitor.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "Ten pins. That's all she needs.", "name": "MURIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "She's got ice in her veins.", "name": "DESHAWN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "She's got a ball in her hands. Pray it's the right one.", "name": "MURIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "action", "text": "Annika steps up to the approach.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "action", "text": "Breathes.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "action", "text": "Stares at the head pin.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "action", "text": "The crowd hushes.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "action", "text": "Hank leans forward, grinning.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "action", "text": "Preston grips his headset.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "Spare. Just spare.", "name": "ANNIKA", "speaker": 4, "ext": [], "paren": ["under her breath"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "action", "text": "She takes four steps.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "action", "text": "Swings.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "Releases.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "The ball tears down the lane, hooks left, a streak of black.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "action", "text": "It slams the pocket.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "action", "text": "Pins scatter.", "para": 3, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "Nine fall.", "para": 3, "sent": 6, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "One wobbles.", "para": 3, "sent": 7, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "Stands.", "para": 3, "sent": 8, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "The crowd groans.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "Hank punches the air.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "Told you she'd choke!", "name": "HANK", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "Sit down, Hank.", "name": "DESHAWN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "Make me.", "name": "HANK", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "Muriel puts a hand on Deshawn's chest.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "He holds.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "Annika walks back, staring at the single pin.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "dialogue", "text": "Attention, bowlers. Lane twelve. Tenth frame. One ball remaining. Annika Bergstrom-Oduya needs the spare for the title.", "name": "PRESTON", "speaker": 6, "ext": ["V.O."], "paren": ["over the PA, shaky"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "Annie. Look at me.", "name": "MURIEL", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "I'm looking.", "name": "ANNIKA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "dialogue", "text": "That pin has been waiting thirty years for someone to knock it down.", "name": "MURIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "dialogue", "text": "It's been waiting for me.", "name": "ANNIKA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "dialogue", "text": "It's been waiting for all of us.", "name": "MURIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "Deshawn offers a towel.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "action", "text": "She wipes her hands.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "action", "text": "Hands it back.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "Steps up again.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "The crowd leans in.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "action", "text": "Hank folds his arms, jaw tight.", "para": 6, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "action", "text": "She sets her feet.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "action", "text": "Looks at the pin.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "action", "text": "Takes the four steps again.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "action", "text": "Releases.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "action", "text": "The ball rolls slower this time.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "action", "text": "Gentle.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "action", "text": "A curve so slight it barely bends.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "action", "text": "It kisses the last pin at the edge.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "action", "text": "The pin spins.", "para": 8, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 59, "kind": "action", "text": "Tilts.", "para": 8, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 60, "kind": "action", "text": "Falls.", "para": 8, "sent": 6, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 61, "kind": "action", "text": "For one second, nothing.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 62, "kind": "action", "text": "Then the whole alley erupts.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 63, "kind": "action", "text": "Muriel throws her clipboard in the air.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 64, "kind": "action", "text": "Deshawn lifts Annika off the floor.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 65, "kind": "action", "text": "Preston screams into his headset.", "para": 9, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 66, "kind": "action", "text": "Hank sits with his arms still folded.", "para": 9, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 67, "kind": "dialogue", "text": "That's a title!", "name": "MURIEL", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 68, "kind": "dialogue", "text": "That's a Tuesday!", "name": "DESHAWN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 69, "kind": "action", "text": "Annika laughs and cries at once, still held aloft.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 70, "kind": "action", "text": "Hank rises, walks over, offers a hand across the rail.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 71, "kind": "dialogue", "text": "Good game.", "name": "HANK", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 72, "kind": "dialogue", "text": "Thanks, Hank.", "name": "ANNIKA", "speaker": 4, "ext": [], "paren": ["shaking it"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 73, "kind": "dialogue", "text": "Next year, I'm bringing the red ball.", "name": "HANK", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 74, "kind": "dialogue", "text": "Bring two.", "name": "ANNIKA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}