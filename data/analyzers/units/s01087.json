{"scene_id": "s01087", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01087.fountain", "heading": "EXT. CANAL LOCK - LOWER BASIN - DUSK", "cast": [{"id": 0, "name": "LOCKKEEPER HOSEA DRUMMOND", "names": ["LOCKKEEPER HOSEA DRUMMOND", "HOSEA"], "gender": "?", "first": 6, "spoke": 6}, {"id": 1, "name": "CLEMENTINE DRUMMOND", "names": ["CLEMENTINE DRUMMOND", "CLEMENTINE"], "gender": "?", "first": 6, "spoke": 3}, {"id": 2, "name": "CAPTAIN EZEKIEL ARDEN", "names": ["CAPTAIN EZEKIEL ARDEN", "EZEKIEL"], "gender": "?", "first": 8, "spoke": 6}, {"id": 3, "name": "MADAME PERPETUA ARDEN", "names": ["MADAME PERPETUA ARDEN", "PERPETUA"], "gender": "f", "first": 8, "spoke": 1}, {"id": 4, "name": "OFFICER", "names": ["OFFICER"], "gender": "?", "first": 33, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. CANAL LOCK - LOWER BASIN - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "1824.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A narrow barge squeezed in a stone lock.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Water churns.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Lanterns swing on posts.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Ropes creak.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "LOCKKEEPER HOSEA DRUMMOND, 50s, broad, in a tarred coat, cranks the sluice.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "His daughter CLEMENTINE DRUMMOND, 12, perches on the gate beam with a coil of rope.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "At the stern of the barge, CAPTAIN EZEKIEL ARDEN, 40s, tall hat, cane, looks displeased.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "His wife, MADAME PERPETUA ARDEN, 40s, silk veil, grips the rail, glaring at the churning water and murmuring to the horses on the towpath.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Steady now. She'll rise.", "name": "HOSEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "You said twenty minutes.", "name": "EZEKIEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "I said it'd be about twenty.", "name": "HOSEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "It's been twenty-two, sir.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Impertinent child.", "name": "EZEKIEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Accurate child.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Perpetua lifts her veil.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Stares at Clementine.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "A flicker of amusement she smothers at once.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Ezekiel. Let the man work.", "name": "PERPETUA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "I have a train to meet.", "name": "EZEKIEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "No train this side of Wickham.", "name": "HOSEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "There is a train.", "name": "EZEKIEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "There's a promise of one.", "name": "HOSEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "The water surges.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "The barge shudders and lifts.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "A rope snaps.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "The barge yaws toward the wall.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Clementine scrambles along the beam, grabs the loose end, hauls with both hands.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Hosea spins the crank backward.", "para": 3, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Ezekiel stumbles, cane clattering.", "para": 3, "sent": 6, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Perpetua clutches the rail and shouts at the horses.", "para": 3, "sent": 7, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "They back and the barge straightens.", "para": 3, "sent": 8, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "You there! In the lock! Halt in the Crown's name!", "name": "OFFICER", "speaker": 4, "ext": ["V.O."], "paren": ["from the towpath, distant"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Everyone freezes.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Water keeps rising.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Hosea looks at the bank.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Four men in coats at the far lamp.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "A constable's whistle.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Hosea. Open the upper gate.", "name": "EZEKIEL", "speaker": 2, "ext": [], "paren": ["quietly, not at all arrogant now"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Sir?", "name": "HOSEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Open it. Now.", "name": "EZEKIEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Papa?", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Hosea looks at Ezekiel.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "At Perpetua, pale.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "At Clementine.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "He sets his jaw.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Cranks the upper sluice.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "The gate groans open.", "para": 5, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Hold on to something.", "name": "HOSEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "The water roars.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "The barge shoots forward into the dark channel, taking the lantern light with it, and the officers' shouts vanish behind.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}]}