{"scene_id": "s01088", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01088.fountain", "heading": "EXT. MANGROVE SWAMP - TIDAL FLAT - DAWN", "cast": [{"id": 0, "name": "BEE", "names": ["BEE"], "gender": "?", "first": 5, "spoke": 12}, {"id": 1, "name": "CALLOWAY", "names": ["CALLOWAY"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "BRAM OKONJO", "names": ["BRAM OKONJO", "BRAM"], "gender": "f", "first": 6, "spoke": 10}, {"id": 3, "name": "CAPTAIN HALVARD SKOGLUND", "names": ["CAPTAIN HALVARD SKOGLUND", "CAPTAIN HALVARD"], "gender": "?", "first": 7, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. MANGROVE SWAMP - TIDAL FLAT - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Roots like fingers.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Grey mud.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A capsized skiff on its side.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Mosquitos in clouds.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "BIANCA \"BEE\" CALLOWAY, 30s, torn shirt, drags a water jug through the mud.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "BRAM OKONJO, 40s, one boot missing, limps behind her.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Between them, a bundled shape on a stretcher of branches: CAPTAIN HALVARD SKOGLUND, 60s, eyes closed.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Bram. Pull.", "name": "BEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "I'm pulling.", "name": "BRAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "You're limping.", "name": "BEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I'm limping and pulling.", "name": "BRAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "She stops.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Wipes her face.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Squats by the captain.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Puts two fingers at his neck.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Cap. Cap, you in there?", "name": "BEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "He stirs.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Mumbles.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Doesn't wake.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Tide's turning.", "name": "BRAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "I can see.", "name": "BEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "We have maybe ten minutes before the flat goes under.", "name": "BRAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "She stands.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Looks at the skiff.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Looks at the horizon where a thin line of silver crawls toward them.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Leave the jug.", "name": "BEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "That's our water.", "name": "BRAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "And that's his life. Choose.", "name": "BEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Bram stares at her.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Drops the jug.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "It sinks into the mud with a slow burp.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "He grabs the stretcher.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "She grabs the other end.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "They lift.", "para": 5, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "They stumble.", "para": 5, "sent": 6, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "A root catches Bram's foot; he falls.", "para": 5, "sent": 7, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "The stretcher tilts.", "para": 5, "sent": 8, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "The captain groans.", "para": 5, "sent": 9, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Bram!", "name": "BEE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Go on without me.", "name": "BRAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Not a chance.", "name": "BEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "She sets the stretcher down.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Hauls him up by the belt.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "He leans on her.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Their breath rasps.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Bee. If I --", "name": "BRAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "You're not going to.", "name": "BEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "If I do.", "name": "BRAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Don't.", "name": "BEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "The silver line is closer.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "The mud begins to glisten.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "A bird shrieks from the roots.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Boys. Girls. Hold your horses.", "name": "CAPTAIN HALVARD", "speaker": 3, "ext": [], "paren": ["eyes still shut"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Cap!", "name": "BEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "I can walk.", "name": "CAPTAIN HALVARD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "You can't.", "name": "BRAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "I can crawl. Let me.", "name": "CAPTAIN HALVARD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "He pushes himself off the stretcher.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "Falls to hands and knees.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "Starts to crawl.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "Bee and Bram watch him go, mud to the elbows.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "Stubborn old man.", "name": "BEE", "speaker": 0, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "He taught us.", "name": "BRAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "They follow.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "The water laps their ankles.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "The roots rise ahead like a gate.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}]}