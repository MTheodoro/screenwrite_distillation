{"scene_id": "s01089", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01089.fountain", "heading": "INT. FIELD HOSPITAL - CONVERTED CHURCH - NIGHT", "cast": [{"id": 0, "name": "MAJOR SIOBHAN DELANEY-WRIGHT", "names": ["MAJOR SIOBHAN DELANEY-WRIGHT", "SIOBHAN"], "gender": "f", "first": 6, "spoke": 6}, {"id": 1, "name": "SERGEANT MIKHAIL TERZIC", "names": ["SERGEANT MIKHAIL TERZIC", "MIKHAIL"], "gender": "m", "first": 7, "spoke": 4}, {"id": 2, "name": "NURSE ROSALIND PARK-EZEIGWE", "names": ["NURSE ROSALIND PARK-EZEIGWE", "ROSALIND"], "gender": "?", "first": 8, "spoke": 4}, {"id": 3, "name": "PRIVATE OSWIN FALCONER", "names": ["PRIVATE OSWIN FALCONER"], "gender": "?", "first": 9, "spoke": 0}, {"id": 4, "name": "CORPORAL TEDDY AGUILAR", "names": ["CORPORAL TEDDY AGUILAR", "TEDDY"], "gender": "m", "first": 10, "spoke": 3}, {"id": 5, "name": "RADIO", "names": ["RADIO"], "gender": "?", "first": 16, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. FIELD HOSPITAL - CONVERTED CHURCH - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Pews pushed against the walls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cots in the nave.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "An altar draped with a bloody sheet.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A lone candle on the pulpit.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Distant artillery, fading.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "MAJOR SIOBHAN DELANEY-WRIGHT, 40s, surgeon, apron stiff with dried blood, writes in a ledger at a pew-desk.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "SERGEANT MIKHAIL TERZIC, 30s, bandaged arm, sits on a cot.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "NURSE ROSALIND PARK-EZEIGWE, 20s, hair pinned under a cap, adjusts an IV.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "PRIVATE OSWIN FALCONER, 18, sleeps in the next cot, face grey.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Nearby, a radio operator, CORPORAL TEDDY AGUILAR, 20s, headphones around his neck, fiddles with a set.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Corporal. Anything?", "name": "SIOBHAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Static, Major.", "name": "TEDDY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Try the other band.", "name": "SIOBHAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "He turns the dial.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "A voice comes through, clipped and tired.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "...say again, Dagger Six, this is Hammer. Enemy withdrawing along the river road. All units hold.", "name": "RADIO", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Siobhan looks up.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "So does Mikhail.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Rosalind stills with the IV bag in her hand.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "They're withdrawing?", "name": "MIKHAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "That's what it says.", "name": "TEDDY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Then it's over?", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "It's over tonight. Not tomorrow.", "name": "SIOBHAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "She closes the ledger.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Stands.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Wipes her palms on her apron.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Crosses to Oswin's cot, checks his pulse.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Nods.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Draws the blanket up.", "para": 4, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "He'll make it?", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "If he sleeps.", "name": "SIOBHAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Mikhail rolls his shoulder, winces, tests the bandage.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Rosalind sets down the IV and crosses to him, unwraps the dressing, checks the wound.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "He grimaces.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Teddy turns the volume up, trying for another voice.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "How is it?", "name": "MIKHAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Clean. You'll keep the arm.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "That is good. I like the arm.", "name": "MIKHAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "So does your wife, I imagine.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": ["dry"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "She likes the other one more.", "name": "MIKHAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "They laugh, quietly, careful of the sleepers.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "The laugh dies.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "The church holds its breath.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Siobhan walks down the aisle between the cots, letting her hand trail along the pews.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Dagger Six, copy that. Ceasefire at oh-six-hundred. Repeat, ceasefire at oh-six-hundred.", "name": "RADIO", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Ma'am. Ceasefire. Six a.m.", "name": "TEDDY", "speaker": 4, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "Thank you, Corporal.", "name": "SIOBHAN", "speaker": 0, "ext": [], "paren": ["not turning"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "Teddy pulls the headphones off.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "Rubs his face.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "Rosalind sits on the end of Mikhail's cot, suddenly unable to stand.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Mikhail pats her shoulder with his good hand.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "At the altar, Siobhan stops.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "Lifts the bloody sheet.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "Folds it, corner by corner.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "Lays it on the stone.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "Straightens it.", "para": 8, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "Steps back.", "para": 8, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "Behind her, Oswin stirs, murmurs, and falls still again.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "The candle gutters and holds.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "Everyone rest. I'll take first watch.", "name": "SIOBHAN", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "Rosalind and Mikhail nod.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "Teddy lies back on his cot, the radio on his chest, fading into static and sleep.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "Siobhan sits in the front pew, hands folded, eyes on the candle.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}