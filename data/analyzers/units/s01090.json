{"scene_id": "s01090", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01090.fountain", "heading": "EXT. ORCHARD BEHIND A CLOSED CANNERY - LATE SUMMER AFTERNOON", "cast": [{"id": 0, "name": "NELL", "names": ["NELL"], "gender": "f", "first": 4, "spoke": 4}, {"id": 1, "name": "THEO", "names": ["THEO"], "gender": "?", "first": 15, "spoke": 5}, {"id": 2, "name": "DUNNING", "names": ["DUNNING"], "gender": "?", "first": 58, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ORCHARD BEHIND A CLOSED CANNERY - LATE SUMMER AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Pears hang heavy on the branches.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wasps drone over fallen fruit.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Beyond the trees, a corrugated roof rusts under a pale sky.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "NELL, 15, sits with her back against a trunk, knees drawn up.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She has a transistor radio in her lap, tuned to nothing.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "A paper sack of pears lies beside her.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "Dust on her shoes.", "para": 1, "sent": 3, "present": [0]}, {"u": 8, "kind": "action", "text": "A bruise yellowing on one shin.", "para": 1, "sent": 4, "present": [0]}, {"u": 9, "kind": "action", "text": "She bites a pear.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "Chews.", "para": 2, "sent": 1, "present": [0]}, {"u": 11, "kind": "action", "text": "Does not taste it.", "para": 2, "sent": 2, "present": [0]}, {"u": 12, "kind": "action", "text": "A twig snaps.", "para": 3, "sent": 0, "present": [0]}, {"u": 13, "kind": "action", "text": "She looks up.", "para": 3, "sent": 1, "present": [0]}, {"u": 14, "kind": "action", "text": "A boy has stepped from between the trees, hands in his pockets.", "para": 3, "sent": 2, "present": [0]}, {"u": 15, "kind": "action", "text": "THEO, 16, tall and awkward, wearing his older brother's jacket.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He stops ten paces away.", "para": 3, "sent": 4, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He studies her.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She studies the pear.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "You're on the Dunnings' side.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Is there a side?", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "He shrugs.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Scuffs a pear into the grass with his toe.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She watches the movement and then the dirt.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "They said you left.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "They said a lot.", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "He nods slowly.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "She offers him a pear without looking up.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "He crosses, takes it, sits a careful distance away.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "They eat in silence.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "A wasp circles his hand.", "para": 6, "sent": 4, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "He lets it.", "para": 6, "sent": 5, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "My brother's gone. Since June.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "She says nothing.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Turns the dial on the radio.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Static swells, then a thin fragment of a song.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "She holds still, listening.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "He leans in a little.", "para": 7, "sent": 4, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "The song fades.", "para": 7, "sent": 5, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "That was a good one.", "name": "THEO", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "It always is. Then it goes.", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "He half-smiles.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "She turns the dial again.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Nothing.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "She sets the radio on the grass between them.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "A screen door bangs somewhere beyond the trees.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "A woman's voice calls a name that is not hers.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Nell's shoulders rise.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Theo watches them rise.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "That's for you?", "name": "THEO", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "That's for a girl I was.", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "He nods as if this makes sense.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "Stands.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "Offers his hand.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "She looks at it for a long moment.", "para": 10, "sent": 3, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "Then takes it.", "para": 10, "sent": 4, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "He pulls her up.", "para": 10, "sent": 5, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "They let go at the same time.", "para": 10, "sent": 6, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "At the edge of the orchard, an older figure steps out: MRS. DUNNING, 50s, apron, arms folded.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "She stops when she sees them both.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "Her face softens.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "Hardens.", "para": 11, "sent": 3, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "Softens again.", "para": 11, "sent": 4, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "Nell straightens.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "Theo steps half a pace in front of her.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "Mrs. Dunning looks at his jacket, at the radio on the grass, at the pear core in Nell's hand.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "She turns and walks back toward the house.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "Leaves the door open behind her.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "Nell picks up the radio.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "Theo picks up the sack of pears.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "They follow, ten paces apart, then five.", "para": 14, "sent": 2, "present": [0, 1, 2]}]}