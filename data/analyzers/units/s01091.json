{"scene_id": "s01091", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01091.fountain", "heading": "INT. PARKING GARAGE - LEVEL P4 - NIGHT", "cast": [{"id": 0, "name": "AGENT IRINA SOLOVYOV", "names": ["AGENT IRINA SOLOVYOV", "IRINA"], "gender": "m", "first": 5, "spoke": 6}, {"id": 1, "name": "AGENT KOFI MENSAH-BELL", "names": ["AGENT KOFI MENSAH-BELL", "KOFI"], "gender": "m", "first": 6, "spoke": 6}, {"id": 2, "name": "LEONARD HAYES-TAKAHASHI", "names": ["LEONARD HAYES-TAKAHASHI"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "COURIER", "names": ["COURIER"], "gender": "m", "first": 8, "spoke": 5}, {"id": 4, "name": "HAYES", "names": ["HAYES"], "gender": "m", "first": 7, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. PARKING GARAGE - LEVEL P4 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Concrete pillars.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Oil stains.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A flickering sodium light.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "One car left: a dented Volvo with its trunk open.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "AGENT IRINA SOLOVYOV, 30s, wet hair, tactical vest, crouches behind a pillar, gun drawn.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Beside her, AGENT KOFI MENSAH-BELL, 40s, headset, scans the ramp.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "On the far side of the Volvo, a hostage: DR. LEONARD HAYES-TAKAHASHI, 50s, hands zip-tied, mouth taped.", "para": 1, "sent": 2, "present": [0, 1, 2, 4]}, {"u": 8, "kind": "action", "text": "Behind him stands THE COURIER, 30s, black jacket, a gun pressed to Hayes's neck.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Eyes on the target?", "name": "IRINA", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Northeast pillar. He's moving.", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "That's far enough!", "name": "COURIER", "speaker": 3, "ext": [], "paren": ["calling out"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Irina and Kofi freeze.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Hayes squeezes his eyes shut.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Drop the weapons. Both of you.", "name": "COURIER", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "We can talk about this.", "name": "KOFI", "speaker": 1, "ext": [], "paren": ["raising his voice"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "We're talking now.", "name": "COURIER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Left. On three.", "name": "IRINA", "speaker": 0, "ext": [], "paren": ["whispering to Kofi"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "He's too close to Hayes.", "name": "KOFI", "speaker": 1, "ext": [], "paren": ["barely moving his lips"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Then we make him move.", "name": "IRINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "She rolls a coin across the concrete.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "It clinks against the Volvo's tire.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "The Courier whips his head toward it.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Kofi fires into the pillar behind him.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Concrete bursts.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Irina charges.", "para": 3, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "The Courier shoves Hayes forward.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "The three collide beside the car in a heap of limbs.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "A gun skitters.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Kofi dives for it.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "The Courier punches Irina, she slams him against the Volvo, Hayes scrambles under the bumper.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "You don't understand!", "name": "COURIER", "speaker": 3, "ext": ["CONT'D"], "paren": ["snarling"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Then explain it.", "name": "IRINA", "speaker": 0, "ext": [], "paren": ["pinning his arm"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "He heaves.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "She holds.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Kofi seizes the loose gun, trains it on the Courier.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Down. Now.", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "The Courier stills.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "His chest rises and falls.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "He lets his hand go slack.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Irina kneels on his back and cuffs him.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Hayes crawls out from under the bumper, tape half-peeled.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Kofi cuts his zip ties.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Hayes gasps.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "He said they were coming for me.", "name": "HAYES", "speaker": 4, "ext": [], "paren": ["coughing"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Who?", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "The Directorate. He wasn't one of them. He was warning me.", "name": "HAYES", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Irina looks at the Courier.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "His face is turned against the concrete, eyes wet.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Is that true?", "name": "IRINA", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "They'll be here in four minutes.", "name": "COURIER", "speaker": 3, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Kofi checks his watch.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Irina hauls the Courier up.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "Move.", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "They run for the stairwell, the Courier between them, Hayes limping behind.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Footsteps echo.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Somewhere above, tires screech down a ramp.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "Level two exit! Go!", "name": "IRINA", "speaker": 0, "ext": [], "paren": ["over her shoulder"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "They vanish through the steel door as headlights sweep across the pillars.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}]}