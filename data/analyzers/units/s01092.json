{"scene_id": "s01092", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01092.fountain", "heading": "INT. ROWING BOATHOUSE - EARLY MORNING", "cast": [{"id": 0, "name": "COACH HESTER LINDQVIST-AMOAH", "names": ["COACH HESTER LINDQVIST-AMOAH", "HESTER"], "gender": "?", "first": 5, "spoke": 13}, {"id": 1, "name": "PASCAL ODUYA-REYNAUD", "names": ["PASCAL ODUYA-REYNAUD", "PASCAL"], "gender": "?", "first": 6, "spoke": 11}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROWING BOATHOUSE - EARLY MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Long wooden shells hang from the rafters like the ribs of a whale.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Water slaps the dock outside.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Mist presses against the glass.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The smell of varnish and river mud.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "COACH HESTER LINDQVIST-AMOAH, 60s, thermos in one hand and a stopwatch in the other, sits on an upturned oar rack.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across the room, her only remaining athlete, PASCAL ODUYA-REYNAUD, 20s, wraps tape around a blistered palm.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "They do not look at each other.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "A kettle ticks on a hotplate.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Tide's slack at six-fifteen.", "name": "HESTER", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I know.", "name": "PASCAL", "speaker": 1, "ext": [], "paren": ["to his hand"], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Wind from the west. Light.", "name": "HESTER", "speaker": 0, "ext": [], "paren": ["to no one"], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I read the board.", "name": "PASCAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She sips from the thermos.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He bites the end of the tape.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "The kettle begins to whistle.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Neither moves.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Hester sighs and rises, pulls the kettle off the hotplate, pours two mugs.", "para": 2, "sent": 4, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She sets one on the bench beside him.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He doesn't take it.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She sits again.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Sixteen minutes on the water. Then back. Then breakfast.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Fine.", "name": "PASCAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Don't \"fine\" me.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Okay, then.", "name": "PASCAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Okay is worse.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "He smiles faintly.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Takes the mug.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Warms his hands on it.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Mist drifts in through a crack in the doorframe.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Anyone else coming?", "name": "HESTER", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the room again"], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "You know no one's coming.", "name": "PASCAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "I know.", "name": "HESTER", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Pascal sips.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Looks at the shells overhead.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "His eyes trace the hull of an eight, then of a single.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Remember when we filled this place?", "name": "PASCAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "We had fourteen on the squad. And a cox who ate her megaphone.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Camille.", "name": "PASCAL", "speaker": 1, "ext": [], "paren": ["smiling"], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Camille. Yes.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Quiet.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "The water slaps.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "A gull cries.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Coach.", "name": "PASCAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Hm?", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "If I miss the cut --", "name": "PASCAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "You won't.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "But if.", "name": "PASCAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "She turns the stopwatch over in her hand.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "Reads the back, where someone long ago scratched initials.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Then we row anyway.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "He nods.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "Finishes his tea.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "Sets the mug on the bench and stands.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "Pulls on his gloves.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "She stands too.", "para": 8, "sent": 4, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "Together they lift a single shell from its cradle.", "para": 8, "sent": 5, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "It swings, light as a leaf.", "para": 8, "sent": 6, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "Mind the door.", "name": "HESTER", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the room"], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "Easy.", "name": "PASCAL", "speaker": 1, "ext": [], "paren": ["to the boat"], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "They carry it out toward the dock, the mist closing behind.", "para": 9, "sent": 0, "present": [0, 1]}]}