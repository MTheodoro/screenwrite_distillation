{"scene_id": "s01093", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01093.fountain", "heading": "INT. DRIVE-IN PROJECTION BOOTH - TWILIGHT", "cast": [{"id": 0, "name": "PEGGY LOUISE WALDROP", "names": ["PEGGY LOUISE WALDROP", "PEGGY"], "gender": "?", "first": 5, "spoke": 8}, {"id": 1, "name": "TUCKER WALDROP", "names": ["TUCKER WALDROP", "TUCKER"], "gender": "f", "first": 5, "spoke": 7}, {"id": 2, "name": "ABERNATHY", "names": ["ABERNATHY", "MR. ABERNATHY"], "gender": "m", "first": 6, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRIVE-IN PROJECTION BOOTH - TWILIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped booth over an empty lot.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Film canisters.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A coffee can of cigarette butts.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Through the small window, rows of silent cars waiting in the dusk.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "PEGGY LOUISE WALDROP, 17, in a pressed uniform, threads a reel with practiced fingers while her younger brother TUCKER WALDROP, 12, sits on a stool kicking his heels, a comic book on his knee.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Between them, MR. ABERNATHY, 60s, the theater owner, in a short-sleeved shirt and bow tie, checks his pocket watch, taps the projector's housing, and sets a thermos by the door.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Seven forty. Start her at eight sharp.", "name": "MR. ABERNATHY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Yes, sir.", "name": "PEGGY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "And Peggy, no repeats of last week.", "name": "MR. ABERNATHY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "It wasn't my fault, sir. The reel was upside down.", "name": "PEGGY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Mm.", "name": "MR. ABERNATHY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "He nods, pats Tucker on the head, and leaves.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "His footsteps fade down the iron stairs.", "para": 2, "sent": 1, "present": [0, 2]}, {"u": 14, "kind": "action", "text": "Tucker turns a page.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Peggy finishes lacing the film and flips a switch.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "The lamp hums warm.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Is he gone?", "name": "TUCKER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "He's gone.", "name": "PEGGY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Good.", "name": "TUCKER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "He slides the comic book aside and pulls a rumpled envelope from his shirt.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Hands it up without looking at her.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Peggy takes it.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Turns it over.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Her name in his careful block capitals.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "What's this?", "name": "PEGGY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Open it.", "name": "TUCKER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "She does.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Inside, a ticket stub and a folded strip of paper.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "She unfolds it.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Her breath catches.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "They called the house. About the scholarship.", "name": "TUCKER", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Tucker.", "name": "PEGGY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "You got in.", "name": "TUCKER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "She sits down hard on the other stool.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Reads the strip again.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Her thumb pauses over the signature at the bottom.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Down in the lot, the cars dim their lights.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "A horn toots, impatient.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Tucker watches her face.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Don't tell Dad.", "name": "PEGGY", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "He already knows.", "name": "TUCKER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "What?", "name": "PEGGY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "He read it first. Then he put it back.", "name": "TUCKER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "She stares at him.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Then at the window, where the first car's headlights flick on and off in a signal.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "She wipes her eyes with the back of her wrist.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Stands.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Presses the switch.", "para": 7, "sent": 4, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "The projector clatters to life.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "A beam cuts across the lot and lands on the screen: a bright gold title card.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Hand me the next reel.", "name": "PEGGY", "speaker": 0, "ext": ["CONT'D"], "paren": ["not looking at him"], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Tucker slides it across.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "His fingers brush hers.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "She takes it, careful, and sets it beside the first.", "para": 9, "sent": 2, "present": [0, 1, 2]}]}