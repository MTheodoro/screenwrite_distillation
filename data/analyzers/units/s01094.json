{"scene_id": "s01094", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01094.fountain", "heading": "INT. ABANDONED OBSERVATORY - DOME ROOM - NIGHT", "cast": [{"id": 0, "name": "HELENA VASQUEZ-MURRAY", "names": ["HELENA VASQUEZ-MURRAY", "HELENA"], "gender": "f", "first": 5, "spoke": 12}, {"id": 1, "name": "DETECTIVE GRANT", "names": ["DETECTIVE GRANT"], "gender": "?", "first": 21, "spoke": 5}, {"id": 2, "name": "TALL MAN", "names": ["TALL MAN"], "gender": "?", "first": 40, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED OBSERVATORY - DOME ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A round chamber under a split copper dome.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A huge brass telescope aimed at a hole in the roof where stars blink through.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dust like snow.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Star charts curl on the walls.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. HELENA VASQUEZ-MURRAY, 50s, trench coat over pajamas, mud on her boots, kneels by the telescope's base with a flashlight clenched in her teeth.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She runs her fingers along the floor.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Pulls up a loose board.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "Beneath it, a leather journal wrapped in oilcloth.", "para": 1, "sent": 3, "present": [0]}, {"u": 9, "kind": "dialogue", "text": "There you are.", "name": "HELENA", "speaker": 0, "ext": [], "paren": ["muffled by the flashlight"], "dual": false, "present": [0]}, {"u": 10, "kind": "action", "text": "She takes the flashlight from her mouth.", "para": 2, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "Unwraps the journal.", "para": 2, "sent": 1, "present": [0]}, {"u": 12, "kind": "action", "text": "Opens it to the first page.", "para": 2, "sent": 2, "present": [0]}, {"u": 13, "kind": "action", "text": "Reads in a whisper.", "para": 2, "sent": 3, "present": [0]}, {"u": 14, "kind": "dialogue", "text": "\"If you are reading this, I have already gone to see what the telescope shows after midnight.\"", "name": "HELENA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 15, "kind": "action", "text": "She turns a page.", "para": 3, "sent": 0, "present": [0]}, {"u": 16, "kind": "action", "text": "A hand-drawn sketch of the sky.", "para": 3, "sent": 1, "present": [0]}, {"u": 17, "kind": "action", "text": "Beside one star, a small red circle and the word NO.", "para": 3, "sent": 2, "present": [0]}, {"u": 18, "kind": "dialogue", "text": "No what?", "name": "HELENA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 19, "kind": "action", "text": "Her phone buzzes in her pocket.", "para": 4, "sent": 0, "present": [0]}, {"u": 20, "kind": "action", "text": "She answers.", "para": 4, "sent": 1, "present": [0]}, {"u": 21, "kind": "dialogue", "text": "Helena, where are you?", "name": "DETECTIVE GRANT", "speaker": 1, "ext": ["V.O."], "paren": ["over the phone"], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Following the lead.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "At the observatory? I told you to wait for backup.", "name": "DETECTIVE GRANT", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Backup is slow. The journal is here.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Don't touch anything. We think Warrick didn't die alone.", "name": "DETECTIVE GRANT", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "I'm not alone either.", "name": "HELENA", "speaker": 0, "ext": [], "paren": ["shining the light across the floor"], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Footprints in the dust.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Not hers.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Wide, deliberate.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "They lead to the stairwell.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Helena, did you hear me?", "name": "DETECTIVE GRANT", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Stay on the line.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "She lays the phone on the telescope base.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Rises.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Follows the footprints with the light.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "They end at a door in the wall.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Half open.", "para": 6, "sent": 4, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "A sliver of darkness behind it.", "para": 6, "sent": 5, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "A shape fills the gap.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "A TALL MAN in a gray overcoat, face hidden by a brimmed hat, steps into the dome.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Slow.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Unhurried.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "In one gloved hand he holds a brass key.", "para": 7, "sent": 4, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "You found it before I did.", "name": "TALL MAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "You're Warrick's partner.", "name": "HELENA", "speaker": 0, "ext": [], "paren": ["steady"], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "I was his student.", "name": "TALL MAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Did you kill him?", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "I closed the shutter. He opened it.", "name": "TALL MAN", "speaker": 2, "ext": [], "paren": ["a pause"], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Helena raises the journal.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "The Tall Man's eyes follow it.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Then tell me what the star is.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "You already know.", "name": "TALL MAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Say it.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "Helena! Who are you talking to?", "name": "DETECTIVE GRANT", "speaker": 1, "ext": ["V.O."], "paren": ["tinny, from the telescope"], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "The Tall Man glances at the phone.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Then back at her.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "He lifts the key.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Behind him, the dome's great shutter groans and begins to close, cutting the stars off one slice at a time.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "Grant! Now!", "name": "HELENA", "speaker": 0, "ext": [], "paren": ["shouting"], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "She hurls the journal across the floor.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "The Tall Man lunges for it.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "The dome slams shut.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "Darkness.", "para": 10, "sent": 3, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "A single crack of flashlight on the floor.", "para": 10, "sent": 4, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "Sirens, very far away.", "para": 11, "sent": 0, "present": [0, 1, 2]}]}