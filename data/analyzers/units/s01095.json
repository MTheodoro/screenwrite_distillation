{"scene_id": "s01095", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01095.fountain", "heading": "EXT. DRY GOAT PEN BEHIND A FORSAKEN CHURCH - EVENING", "cast": [{"id": 0, "name": "SHERIFF AUGUSTINE TREVINO", "names": ["SHERIFF AUGUSTINE TREVINO", "AUGUSTINE"], "gender": "m", "first": 6, "spoke": 4}, {"id": 1, "name": "ABIGAIL FROST-MWANGI", "names": ["ABIGAIL FROST-MWANGI", "ABIGAIL"], "gender": "?", "first": 8, "spoke": 4}, {"id": 2, "name": "JEREMIAH FROST", "names": ["JEREMIAH FROST"], "gender": "m", "first": 8, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DRY GOAT PEN BEHIND A FORSAKEN CHURCH - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "1878.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dust.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A broken fence.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A leaning cross.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Three goats chew at nothing.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "SHERIFF AUGUSTINE TREVINO, 60s, tin star pinned crooked, stands over a shallow grave.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Hat in his hands.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "ABIGAIL FROST-MWANGI, 30s, widow's black, holds a rusted shovel.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Between them, a boy, JEREMIAH FROST, 10, squats by a goat and strokes its ear.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "The wind pushes a tumbleweed through the pen.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Nobody watches it go.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Ma'am.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Abigail doesn't turn.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "She sets the shovel against the fence.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Dusts her palms on her skirt.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "One at a time.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "He'd have wanted a preacher.", "name": "AUGUSTINE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "He'd have wanted his horse.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Augustine nods.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Looks at the cross.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Looks at the boy.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Jeremiah lifts a handful of dry grass for the goat.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "I'll see to the horse.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Don't trouble yourself.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "No trouble.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "She takes the hat from his hands and sets it on the cross.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "The brim catches the wind.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "She weights it with a stone.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "That's his now.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Augustine opens his mouth.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Closes it.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Pulls a folded paper from his vest and holds it out.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "She doesn't take it.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Read it to him.", "name": "ABIGAIL", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Augustine looks at the grave.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Clears his throat.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Doesn't read.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "He folds the paper smaller, crouches, and tucks it into the dirt beside the cross.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Jeremiah stands, brushes his knees.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Walks to his mother.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Takes her hand.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Together they look at the cross until the light turns orange.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "The goats wander off.", "para": 8, "sent": 4, "present": [0, 1, 2]}]}