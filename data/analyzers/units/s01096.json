{"scene_id": "s01096", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01096.fountain", "heading": "INT. GRAND OPERA HOUSE - CATWALK ABOVE THE STAGE - NIGHT", "cast": [{"id": 0, "name": "DETECTIVE INEZ CASTELLANO-WU", "names": ["DETECTIVE INEZ CASTELLANO-WU", "INEZ"], "gender": "f", "first": 4, "spoke": 11}, {"id": 1, "name": "OFFICER BARNABAS FINCH", "names": ["OFFICER BARNABAS FINCH", "OFFICER BARNABAS"], "gender": "m", "first": 5, "spoke": 2}, {"id": 2, "name": "STAGE MANAGER DOROTHEA LAMBERT", "names": ["STAGE MANAGER DOROTHEA LAMBERT", "DOROTHEA"], "gender": "f", "first": 5, "spoke": 4}, {"id": 3, "name": "TOMASZ KRAWCZYK", "names": ["TOMASZ KRAWCZYK", "TOMASZ"], "gender": "?", "first": 5, "spoke": 2}, {"id": 4, "name": "AUGUSTO ELEGBE", "names": ["AUGUSTO ELEGBE", "AUGUSTO"], "gender": "m", "first": 5, "spoke": 1}, {"id": 5, "name": "FIGURE", "names": ["FIGURE"], "gender": "?", "first": 19, "spoke": 3}, {"id": 6, "name": "VIOLETTA SANTORO-REYES", "names": ["VIOLETTA SANTORO-REYES", "VIOLETTA"], "gender": "f", "first": 36, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRAND OPERA HOUSE - CATWALK ABOVE THE STAGE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Ropes, sandbags, pulleys in the dark.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Below, a full orchestra tunes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A chandelier the size of a car hangs motionless beside the catwalk.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DETECTIVE INEZ CASTELLANO-WU, 40s, black blazer, radio clipped to her belt, creeps along the planks.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Behind her: OFFICER BARNABAS FINCH, 20s, sweating through his uniform; STAGE MANAGER DOROTHEA LAMBERT, 50s, headset, whispering into her collar; and a pair of maintenance men, TOMASZ KRAWCZYK, 40s, and AUGUSTO ELEGBE, 30s, hauling a toolbox between them.", "para": 1, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 6, "kind": "action", "text": "At the far end of the catwalk, half in shadow, crouches a figure with a briefcase.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "dialogue", "text": "Everybody quiet.", "name": "INEZ", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "She raises a fist.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "They halt.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Dorothea clamps a hand over her headset mic.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Tomasz and Augusto set the toolbox down so slowly it makes no sound.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Barnabas draws his sidearm and holds it at his chest.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Overture starts in four minutes.", "name": "DOROTHEA", "speaker": 2, "ext": [], "paren": ["to Inez"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Then we have four.", "name": "INEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "She steps forward.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "The planks creak.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "The figure at the end stiffens.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "A hush falls over the orchestra pit below.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "I wouldn't come closer.", "name": "FIGURE", "speaker": 5, "ext": [], "paren": ["without turning"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Put the case down.", "name": "INEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "It's not a case. It's a promise.", "name": "FIGURE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Barnabas swallows.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Augusto crosses himself.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Tomasz mutters something in Polish.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Boze, nie teraz.", "name": "TOMASZ", "speaker": 3, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Does anyone know where the cut-off is for the chandelier cable?", "name": "DOROTHEA", "speaker": 2, "ext": [], "paren": ["to the group"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Stage left. Behind the fly rail.", "name": "AUGUSTO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Go. Quietly.", "name": "DOROTHEA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Augusto slips away.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Inez keeps her eyes on the Figure.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "You don't have to do this.", "name": "INEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Everyone says that.", "name": "FIGURE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Because it's true.", "name": "INEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "The Figure turns.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "A woman, 50s, in evening dress and tennis shoes.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "VIOLETTA SANTORO-REYES, ex-soprano.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "Her face is wet.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "In her lap, the briefcase hums.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "They fired me in this house. I sang four hundred nights.", "name": "VIOLETTA", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "I know.", "name": "INEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "dialogue", "text": "Do you? Do you know what silence sounds like when you were the music?", "name": "VIOLETTA", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "dialogue", "text": "No.", "name": "INEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "Violetta nods.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "Her fingers drift to the clasp.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "action", "text": "Barnabas lifts his gun.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "dialogue", "text": "Ma'am, stay still.", "name": "OFFICER BARNABAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "dialogue", "text": "Lower it.", "name": "INEZ", "speaker": 0, "ext": [], "paren": ["to Barnabas"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "dialogue", "text": "Detective --", "name": "OFFICER BARNABAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "dialogue", "text": "Lower it, Barnabas.", "name": "INEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "action", "text": "He lowers it.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "action", "text": "Violetta lets out a laugh, brittle and soft.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "dialogue", "text": "Four minutes, you said.", "name": "VIOLETTA", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "dialogue", "text": "Three.", "name": "INEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "dialogue", "text": "Then let me sing it one last time.", "name": "VIOLETTA", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "dialogue", "text": "Hold the curtain. Hold it. Give me a spot on the catwalk.", "name": "DOROTHEA", "speaker": 2, "ext": [], "paren": ["into the headset, low"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "action", "text": "A spotlight swings up from below and finds Violetta.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "action", "text": "She blinks.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "action", "text": "Rises.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 59, "kind": "action", "text": "The briefcase slides from her lap.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 60, "kind": "action", "text": "It clatters empty to the planks, a few pieces of sheet music spilling out.", "para": 9, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 61, "kind": "action", "text": "Inez steps to it.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 62, "kind": "action", "text": "Picks one up.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 63, "kind": "action", "text": "It is an aria.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 64, "kind": "action", "text": "Blank staves.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 65, "kind": "dialogue", "text": "There's no bomb.", "name": "INEZ", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 66, "kind": "dialogue", "text": "There never was.", "name": "VIOLETTA", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 67, "kind": "action", "text": "Below, the orchestra falls silent.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 68, "kind": "action", "text": "Waiting.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 69, "kind": "action", "text": "Violetta takes a breath, lifts her chin, and sings one clear note into the dark.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 70, "kind": "action", "text": "It carries up into the rafters.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 71, "kind": "action", "text": "Nobody on the catwalk moves.", "para": 11, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 72, "kind": "dialogue", "text": "Matko Boska.", "name": "TOMASZ", "speaker": 3, "ext": [], "paren": ["whispering, awed"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 73, "kind": "action", "text": "Dorothea lowers her hand.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 74, "kind": "action", "text": "Barnabas holsters his gun.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 75, "kind": "action", "text": "Inez closes her eyes.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}]}