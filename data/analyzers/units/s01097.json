{"scene_id": "s01097", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01097.fountain", "heading": "INT. CURLING CLUB - BAR - NIGHT", "cast": [{"id": 0, "name": "RAGS", "names": ["RAGS"], "gender": "f", "first": 5, "spoke": 9}, {"id": 1, "name": "ENGSTROM", "names": ["ENGSTROM"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "TOBY", "names": ["TOBY"], "gender": "?", "first": 6, "spoke": 6}, {"id": 3, "name": "ADEKUNLE", "names": ["ADEKUNLE"], "gender": "?", "first": 6, "spoke": 0}, {"id": 4, "name": "LOLO", "names": ["LOLO"], "gender": "f", "first": 7, "spoke": 5}, {"id": 5, "name": "BEAUMONT", "names": ["BEAUMONT"], "gender": "?", "first": 7, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. CURLING CLUB - BAR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Wood paneling.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A dartboard.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Brooms hung on pegs.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Through the frosted glass, the ice gleams under floodlights.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SKIP RAGNHILD \"RAGS\" ENGSTROM, 40s, tweed vest, nurses a ginger ale.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Her third, TOBIAS \"TOBY\" ADEKUNLE, 30s, still in his team sweater, picks at a bowl of peanuts.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "Their lead, ELOISE \"LOLO\" BEAUMONT, 20s, shoes off, feet on a stool, scrolls her phone.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "dialogue", "text": "Lolo, put the phone down.", "name": "RAGS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "It's the final scores.", "name": "LOLO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "We lost.", "name": "RAGS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "By one stone.", "name": "LOLO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "By one stone, Rags. One.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Don't you start, Toby.", "name": "RAGS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "I'm just saying, if you'd called the hammer on the ninth end --", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "I called the hammer.", "name": "RAGS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "You called it late.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Rags slams her glass on the bar.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Lolo drops the phone.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Toby freezes mid-peanut.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "I called it when the ice told me to.", "name": "RAGS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Rags, the ice doesn't talk.", "name": "LOLO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "It does if you listen.", "name": "RAGS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "A silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Toby slowly crunches a peanut.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Lolo picks up her phone, slides it into her pocket.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Rags unclenches her fist.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "We did well, Lolo.", "name": "RAGS", "speaker": 0, "ext": ["CONT'D"], "paren": ["quieter"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "We did.", "name": "LOLO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "We did great, Rags.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Don't suck up, Toby.", "name": "RAGS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "I'm sucking up with respect.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Rags almost smiles.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Lifts her glass.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "To the ninth end.", "name": "RAGS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "To the ninth end.", "name": "LOLO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "To the hammer.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "They clink.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Beyond the glass, the Zamboni hums across the ice, erasing everything.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}