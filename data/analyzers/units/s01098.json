{"scene_id": "s01098", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01098.fountain", "heading": "INT. FUNERAL HOME - FAMILY ROOM - AFTERNOON", "cast": [{"id": 0, "name": "ROSEMARY PEMBERTON-DIALLO", "names": ["ROSEMARY PEMBERTON-DIALLO", "ROSEMARY"], "gender": "?", "first": 6, "spoke": 9}, {"id": 1, "name": "BENEDICT PEMBERTON", "names": ["BENEDICT PEMBERTON", "BENEDICT"], "gender": "f", "first": 6, "spoke": 7}, {"id": 2, "name": "DELPHINE ACHEBE-HART", "names": ["DELPHINE ACHEBE-HART", "DELPHINE"], "gender": "f", "first": 8, "spoke": 8}, {"id": 3, "name": "FUNERAL DIRECTOR OSWALD PRICE", "names": ["FUNERAL DIRECTOR OSWALD PRICE", "OSWALD"], "gender": "m", "first": 43, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. FUNERAL HOME - FAMILY ROOM - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Dim lamps.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A mahogany casket at the front.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Folding chairs in careful rows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A box of tissues on every seat.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The smell of lilies and carpet cleaner.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "ROSEMARY PEMBERTON-DIALLO, 60s, in black wool, sits ramrod straight in the front row.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Her son BENEDICT PEMBERTON, 40s, rumpled suit, fidgets beside her.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Their cousin, DELPHINE ACHEBE-HART, 50s, large sunglasses indoors, stands against the back wall clutching her purse.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Mother, I can handle it.", "name": "BENEDICT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "You can't handle a toaster.", "name": "ROSEMARY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "That was one time.", "name": "BENEDICT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "It was three times, Ben.", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": ["from the back"], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Stay out of it, Delphine.", "name": "BENEDICT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Don't tell me to stay out. I'm the one who found the will.", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "The will is none of your business.", "name": "ROSEMARY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "It's my business. I'm named in it.", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "You are not.", "name": "BENEDICT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Page four. Paragraph two.", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "That paragraph was struck.", "name": "ROSEMARY", "speaker": 0, "ext": [], "paren": ["rising"], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "By who?", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "By me.", "name": "ROSEMARY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Mother!", "name": "BENEDICT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Be quiet, Benedict.", "name": "ROSEMARY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "You can't just --", "name": "BENEDICT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "I can do what I please. I'm his widow.", "name": "ROSEMARY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "And I'm his sister's daughter. Which makes me blood.", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Blood is overrated.", "name": "ROSEMARY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Says the woman who married into it.", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Silence.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Rosemary stares at the casket.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Her shoulders sag.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Benedict puts a hand on her arm.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "She lets it stay.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "He would have hated this.", "name": "ROSEMARY", "speaker": 0, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "He would have loved it. The shouting.", "name": "BENEDICT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "He started half of it.", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": ["wiping her eyes behind the sunglasses"], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "A beat.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Rosemary lets out a short, surprised laugh.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Benedict follows.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Delphine, last, a sob that turns into a snort.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "They sit in the gentle ruin.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "The door opens.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "FUNERAL DIRECTOR OSWALD PRICE, 50s, black suit, clears his throat.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Ready, whenever you are.", "name": "OSWALD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Give us a moment, Mr. Price.", "name": "ROSEMARY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Of course.", "name": "OSWALD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "He retreats.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Delphine crosses the room and sits on Rosemary's other side.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Three of them in a row, looking at the casket.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}]}