{"scene_id": "s01099_0", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01099.fountain", "heading": "INT. APPELLATE COURTHOUSE - JUDGES' ROBING ROOM - MORNING", "cast": [{"id": 0, "name": "JUDGE PHILOMENA ARCHIBALD-NWOSU", "names": ["JUDGE PHILOMENA ARCHIBALD-NWOSU", "PHILOMENA"], "gender": "m", "first": 5, "spoke": 22}, {"id": 1, "name": "GIDEON", "names": ["GIDEON", "YOUNG MAN"], "gender": "m", "first": 6, "spoke": 18}], "units": [{"u": 0, "kind": "heading", "text": "INT. APPELLATE COURTHOUSE - JUDGES' ROBING ROOM - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Marble sinks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A rack of black robes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A stained-glass window throws red and gold on the floor.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The air smells of starch.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "JUDGE PHILOMENA ARCHIBALD-NWOSU, 60s, silver hair pinned under a cap, buttons her robe at the mirror.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A YOUNG MAN in a rumpled suit slips in through the side door, clutching a leather folio.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He freezes when he sees her.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Oh. Sorry. I thought this was the clerk's office.", "name": "YOUNG MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "It's the robing room. Third door down.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Right. Of course.", "name": "YOUNG MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He doesn't leave.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She meets his eyes in the mirror and turns slowly.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Are you lost, or are you someone I should know?", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "I'm counsel for the appellant. In Whitlock versus the State.", "name": "YOUNG MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Name?", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Gideon.", "name": "YOUNG MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Gideon what?", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Gideon Okafor-Lindgren.", "name": "GIDEON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "You'll want to hold that for the bench, Mr. Okafor-Lindgren. Not for a judge adjusting her collar.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Yes, ma'am. Your Honor. Sorry.", "name": "GIDEON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She turns back to the mirror.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Fastens the last button.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Her fingers pause.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Whitlock. The arson.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Yes.", "name": "GIDEON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "You argue today?", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Ten o'clock.", "name": "GIDEON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Your first appellate?", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "He hesitates.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Looks at his folio.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Is it that obvious?", "name": "GIDEON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "You walked into a judges' dressing room with your tie untucked.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "He glances at his tie.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Flips it back under his jacket.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "She watches him struggle with it and her expression softens.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Come here.", "name": "PHILOMENA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Your Honor?", "name": "GIDEON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Come here.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "He steps forward.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "She tucks the tie, smooths his lapel with both hands, adjusts his collar.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "The way a mother would.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "That's better. Now. Do not tell me your theory of the case.", "name": "PHILOMENA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "I wasn't going to.", "name": "GIDEON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "You were.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "...I was.", "name": "GIDEON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "She nods.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Steps back.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Her eyes flicker over his face.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Mr. Okafor-Lindgren. Who taught you to argue?", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Judge Waverly Bishop.", "name": "GIDEON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "Her hands go still.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Waverly Bishop.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "Yes, ma'am. Before she passed.", "name": "GIDEON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "I know. I sat beside her for eleven years.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "A beat.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "The light shifts through the glass.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "Gideon, uncertain, shifts his feet.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "Is something wrong?", "name": "GIDEON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "She wrote me a letter. Before she died. About a young man in her clinic. She said, \"He will lose his first appeal, and it will be the best thing for him.\"", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "She wrote you about me?", "name": "GIDEON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "She wrote me about justice. You were the example.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "Gideon sags against the sink.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "Philomena gathers her gloves.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "I won't tell you how to argue. But I will tell you this. I read your brief last night.", "name": "PHILOMENA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "And?", "name": "GIDEON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "It was good enough to be sad about.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "Thank you?", "name": "GIDEON", "speaker": 1, "ext": [], "paren": ["laughing, almost choking"], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "Don't. Not yet.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "She walks to the door.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 70, "kind": "action", "text": "Stops with her hand on the knob.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 71, "kind": "dialogue", "text": "Judge Philomena Archibald-Nwosu does not take shortcuts. If you come before me, you earn it.", "name": "PHILOMENA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "She exits.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "The door closes softly.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 74, "kind": "action", "text": "Gideon stands alone in the red light, tie perfectly knotted.", "para": 12, "sent": 2, "present": [0, 1]}]}