{"scene_id": "s01100", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01100.fountain", "heading": "INT. ORBITAL GREENHOUSE RING - OBSERVATION DECK - SHIFT CHANGE", "cast": [{"id": 0, "name": "YASMIN HOSSAIN-RYDER", "names": ["YASMIN HOSSAIN-RYDER", "YASMIN"], "gender": "f", "first": 5, "spoke": 7}, {"id": 1, "name": "TECHNICIAN WALDEMAR OKPARA", "names": ["TECHNICIAN WALDEMAR OKPARA", "WALDEMAR"], "gender": "f", "first": 7, "spoke": 4}, {"id": 2, "name": "HALCYON", "names": ["HALCYON"], "gender": "?", "first": 8, "spoke": 4}, {"id": 3, "name": "COMMANDER IRIS TANAKA-LUND", "names": ["COMMANDER IRIS TANAKA-LUND", "IRIS"], "gender": "?", "first": 9, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. ORBITAL GREENHOUSE RING - OBSERVATION DECK - SHIFT CHANGE", "present": []}, {"u": 1, "kind": "action", "text": "A curved corridor lined with hydroponic racks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Violet grow-light.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A viewport shows Earth turning slowly below.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The air smells of basil and recycled coolant.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. YASMIN HOSSAIN-RYDER, 40s, sits cross-legged on the floor, a tablet balanced on her knee.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She stirs a pouch of reconstituted tea.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Her colleague, TECHNICIAN WALDEMAR OKPARA, 30s, wipes down a nutrient valve.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Their station AI, a soft voice called HALCYON, murmurs from a speaker near the ceiling.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Beside the viewport, the commander, COMMANDER IRIS TANAKA-LUND, 50s, stands with her arms folded, gazing at the planet.", "para": 1, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Yasmin sips.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Waldemar wipes.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Iris does not move.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "She hums low, tuneless.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Humidity at sixty-two percent. Within tolerance.", "name": "HALCYON", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Thank you, Halcyon.", "name": "YASMIN", "speaker": 0, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "You are welcome. Would you like the evening readings?", "name": "HALCYON", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Later.", "name": "YASMIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "She taps the tablet.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Waldemar glances at her, then at the commander.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "He lowers his voice.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Is she okay?", "name": "WALDEMAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "She's thinking.", "name": "YASMIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "She's been thinking for an hour.", "name": "WALDEMAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "She's the commander. She thinks in hours.", "name": "YASMIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "He nods and returns to the valve.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "A drop of nutrient solution beads on the pipe.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "He catches it with his thumb.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Iris turns from the viewport.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Looks at them both with a mild, unreadable expression.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "We got the message from Mission Control.", "name": "IRIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "The extension?", "name": "YASMIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Six more months.", "name": "IRIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Waldemar's rag stops.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Yasmin sets down the tablet.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "For a moment the only sound is the hum of the racks.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Ma'am, the crew rotation --", "name": "WALDEMAR", "speaker": 1, "ext": [], "paren": ["carefully"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Is delayed. Yes.", "name": "IRIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "And the supply drop?", "name": "YASMIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Sufficient. They believe.", "name": "IRIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "She walks to the nearest rack, brushes the leaves of a tomato plant with two fingers, and inhales.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Tomatoes should be ready by the third week.", "name": "IRIS", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Yasmin and Waldemar exchange a look.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "He nods to her.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "She shrugs, resigned.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "He folds the rag and sets it by the valve.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Would anyone care for a cup of tea?", "name": "HALCYON", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Yes, Halcyon. Four.", "name": "IRIS", "speaker": 3, "ext": [], "paren": ["a small smile"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Four, Commander? There are three of you.", "name": "HALCYON", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Iris pauses.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "The smile fades.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "She turns to the speaker.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "...Three. Of course. Three.", "name": "IRIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "She walks away toward the corridor, one hand trailing along the rack.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Waldemar watches her go, then looks at Yasmin.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Who was the fourth?", "name": "WALDEMAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "I'll tell you later.", "name": "YASMIN", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3]}]}