{"scene_id": "s01101", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01101.fountain", "heading": "INT. DECOMMISSIONED SUBMARINE BAY - SPACE STATION - NIGHT CYCLE", "cast": [{"id": 0, "name": "CAPTAIN LUCIANA MBEKI-ROSSI", "names": ["CAPTAIN LUCIANA MBEKI-ROSSI", "LUCIANA"], "gender": "?", "first": 5, "spoke": 7}, {"id": 1, "name": "ENGINEER DORIAN WESTBROOK-ANAND", "names": ["ENGINEER DORIAN WESTBROOK-ANAND", "DORIAN"], "gender": "?", "first": 6, "spoke": 3}, {"id": 2, "name": "MEDIC IMANI SOLBERG", "names": ["MEDIC IMANI SOLBERG", "IMANI"], "gender": "f", "first": 7, "spoke": 2}, {"id": 3, "name": "SECURITY CHIEF PAVEL ORLOV-DIALLO", "names": ["SECURITY CHIEF PAVEL ORLOV-DIALLO", "PAVEL"], "gender": "?", "first": 8, "spoke": 2}, {"id": 4, "name": "LINGUIST ESPERANZA BALOGUN", "names": ["LINGUIST ESPERANZA BALOGUN", "ESPERANZA"], "gender": "?", "first": 9, "spoke": 3}, {"id": 5, "name": "TEO ABERNATHY-LIU", "names": ["TEO ABERNATHY-LIU", "TEO"], "gender": "?", "first": 9, "spoke": 1}, {"id": 6, "name": "COMMS", "names": ["COMMS"], "gender": "?", "first": 27, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. DECOMMISSIONED SUBMARINE BAY - SPACE STATION - NIGHT CYCLE", "present": []}, {"u": 1, "kind": "action", "text": "A long dim hangar.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Hull plates ticking as they cool.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A flickering amber strip light.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A rack of pressure suits like hanging skins.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CAPTAIN LUCIANA MBEKI-ROSSI, 50s, shaved head, grease-stained flight suit, kneels beside a dark console.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Next to her, ENGINEER DORIAN WESTBROOK-ANAND, 30s, arms crossed, watches a diagnostic wheel spin.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Further off, MEDIC IMANI SOLBERG, 20s, hugs a first-aid case, her hands trembling.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "At the hatch, SECURITY CHIEF PAVEL ORLOV-DIALLO, 40s, holds a pulse rifle, eyes on the ceiling.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Two more figures stand in shadow by the far bulkhead: LINGUIST ESPERANZA BALOGUN, 30s, in a pale coat, and a young cadet, TEO ABERNATHY-LIU, 19, clutching a datapad.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Status.", "name": "LUCIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Core's alive. Everything else is asleep.", "name": "DORIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Wake it.", "name": "LUCIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "I'm trying.", "name": "DORIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Captain?", "name": "IMANI", "speaker": 2, "ext": [], "paren": ["small"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Not now.", "name": "LUCIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "The hull is making a noise.", "name": "IMANI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Silence.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "The strip light flickers.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "A distant, rhythmic tapping rolls through the metal.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Pavel's rifle lifts.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "It's not the cooling.", "name": "PAVEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "It's a pattern.", "name": "ESPERANZA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "What kind of pattern?", "name": "LUCIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Three. Pause. Three.", "name": "ESPERANZA", "speaker": 4, "ext": [], "paren": ["listening"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Is that Morse?", "name": "TEO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "It's a countdown.", "name": "ESPERANZA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "...bay four... can anyone hear... bay four...", "name": "COMMS", "speaker": 6, "ext": ["V.O."], "paren": ["crackling, over the intercom"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "Luciana grabs the handset from the console.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "This is Mbeki-Rossi. Say again.", "name": "LUCIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "Captain? Thank god. We're locked in the sub bay. The door sealed itself.", "name": "COMMS", "speaker": 6, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "Who is this?", "name": "LUCIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "Station Operations. We've been tapping on the hull for an hour.", "name": "COMMS", "speaker": 6, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "Pavel lowers the rifle slowly.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "Dorian stands.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "Imani lets out a breath.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "The tapping continues, closer now.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "We're in bay four.", "name": "LUCIANA", "speaker": 0, "ext": [], "paren": ["into the handset"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "dialogue", "text": "No, ma'am. You're not.", "name": "COMMS", "speaker": 6, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "Luciana stares at the handset.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "At the others.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "At the ceiling, where something taps once, twice, thrice.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "dialogue", "text": "If they're locked in the sub bay...", "name": "DORIAN", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "dialogue", "text": "Then what is that?", "name": "PAVEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "The tapping stops.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "action", "text": "A long silence.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "action", "text": "The strip light dies.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "In the dark, a soft voice laughs, thin and delighted, from the vent above.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "Teo drops the datapad.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "action", "text": "It clatters.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "action", "text": "No one picks it up.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}]}