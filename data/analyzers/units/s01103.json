{"scene_id": "s01103", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01103.fountain", "heading": "INT. FLOODED CELLAR OF A VICTORIAN ASYLUM - NIGHT", "cast": [{"id": 0, "name": "CORDELIA MAXWELL-ODUYA", "names": ["CORDELIA MAXWELL-ODUYA", "CORDELIA"], "gender": "f", "first": 5, "spoke": 9}, {"id": 1, "name": "ARTEMUS PIKE", "names": ["ARTEMUS PIKE", "ARTEMUS"], "gender": "?", "first": 6, "spoke": 9}, {"id": 2, "name": "VOICE", "names": ["VOICE"], "gender": "?", "first": 34, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. FLOODED CELLAR OF A VICTORIAN ASYLUM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Ankle-deep black water.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rusted bed frames stacked against slick brick walls.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single lantern hangs from a chain, throwing a dim yellow circle.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Somewhere, dripping.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. CORDELIA MAXWELL-ODUYA, 40s, in a tailored coat and rubber boots, moves slowly through the water with a lamp raised high.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Behind her, her assistant, ARTEMUS PIKE, 20s, frightened and trying not to show it, clutches a camera.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Mind the step.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "There's a step?", "name": "ARTEMUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "There was. Somewhere.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Water ripples around her boots.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "A bed frame creaks against the wall.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Artemus lifts the camera, thumbs the shutter.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "The flash burns the room white for an instant: iron frames, wet bricks, and a figure standing against the far wall.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Cordelia freezes.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Artemus lowers the camera.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Darkness again, the lantern small.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Did you see --", "name": "ARTEMUS", "speaker": 1, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Yes.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "It looked like --", "name": "ARTEMUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "I said yes, Artemus.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Another creak.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "The lantern chain sways.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "The yellow circle swings across the wall and finds nothing but brick.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Doctor, I think we should go.", "name": "ARTEMUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "We came for a reason.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "I've forgotten the reason.", "name": "ARTEMUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Patient forty-one. Mary Hargreave. Locked here in eighteen-ninety.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "For what?", "name": "ARTEMUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "For hearing things.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "A soft sound rolls through the water.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "A woman's voice, thin as paper, humming a lullaby.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Artemus's hands tighten on the camera.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Cordelia's lamp trembles.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Hush, little one, the water's deep...", "name": "VOICE", "speaker": 2, "ext": ["O.S."], "paren": ["humming, then singing"], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Doctor.", "name": "ARTEMUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Don't answer her.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "I wasn't going to.", "name": "ARTEMUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "...hush, little one, I'll never sleep...", "name": "VOICE", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "The song comes closer.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Water stirs between them.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Something pale rises beneath the surface, a hand, then a wrist, then a face.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Do not look.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": ["whispering at the same moment as Artemus"], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "^Do not look.", "name": "ARTEMUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "They both turn their faces.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "The singing stops.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "The hand breaks the surface a foot from Cordelia's boot, fingers open, trembling.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "It closes around her ankle.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "She screams.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "The lantern chain snaps.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Darkness.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Artemus's camera flashes.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "In the white blink: Cordelia on her knees, and a woman in a rotting nightgown holding her ankle, mouth open in a soundless song.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Black.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "The water settles.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "The dripping resumes.", "para": 11, "sent": 1, "present": [0, 1, 2]}]}