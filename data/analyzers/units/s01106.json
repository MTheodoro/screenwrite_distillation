{"scene_id": "s01106", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01106.fountain", "heading": "INT. FERRY CAFE - RAINY DAY", "cast": [{"id": 0, "name": "HAZEL OKONKWO-LARSEN", "names": ["HAZEL OKONKWO-LARSEN", "HAZEL"], "gender": "?", "first": 5, "spoke": 8}, {"id": 1, "name": "JONAH PELLEGRINI", "names": ["JONAH PELLEGRINI", "JONAH"], "gender": "m", "first": 6, "spoke": 7}, {"id": 2, "name": "WENDELL ACHTERBERG", "names": ["WENDELL ACHTERBERG", "WENDELL"], "gender": "?", "first": 7, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. FERRY CAFE - RAINY DAY", "present": []}, {"u": 1, "kind": "action", "text": "Steam on the windows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A chalkboard menu.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wet umbrellas in a bucket.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The ferry's engine thrums through the floor.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "HAZEL OKONKWO-LARSEN, 30s, hair damp, sits at a corner table with a cup of tea.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across from her, JONAH PELLEGRINI, 30s, in a yellow raincoat, stirs sugar into coffee.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Next to them, a stranger, WENDELL ACHTERBERG, 60s, reads a newspaper pretending not to listen.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "You said you'd be on the nine o'clock.", "name": "HAZEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "I missed it.", "name": "JONAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "You always miss it.", "name": "HAZEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I got caught up.", "name": "JONAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "In what?", "name": "HAZEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Life.", "name": "JONAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "That's usually what it is.", "name": "WENDELL", "speaker": 2, "ext": [], "paren": ["from behind the paper"], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Excuse me?", "name": "HAZEL", "speaker": 0, "ext": [], "paren": ["turning"], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Nothing. Carry on.", "name": "WENDELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Sir, this is a private conversation.", "name": "JONAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "It's a ferry cafe. Nothing's private.", "name": "WENDELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "He has a point.", "name": "HAZEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Hazel.", "name": "JONAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "He does.", "name": "HAZEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "You're on his side now?", "name": "JONAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "I'm not on anyone's side. I'm reading about a cricket match.", "name": "WENDELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Who's winning?", "name": "HAZEL", "speaker": 0, "ext": [], "paren": ["to Wendell"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Nobody. It rained.", "name": "WENDELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Jonah laughs, despite himself.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Hazel's mouth twitches.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "The ferry horn blasts.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "All three look up.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Rain streams down the glass.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "I'm sorry.", "name": "JONAH", "speaker": 1, "ext": [], "paren": ["softly, to Hazel"], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "I know.", "name": "HAZEL", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "And that's that.", "name": "WENDELL", "speaker": 2, "ext": [], "paren": ["lowering the paper"], "dual": false, "present": [0, 1, 2]}]}