{"scene_id": "s01107", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01107.fountain", "heading": "EXT. ROOFTOP WATER TANK - SUBURBAN NIGHT", "cast": [{"id": 0, "name": "SADIE KOWALSKI-IBRAHIM", "names": ["SADIE KOWALSKI-IBRAHIM"], "gender": "f", "first": 4, "spoke": 0}, {"id": 1, "name": "MILO BERGSTROM", "names": ["MILO BERGSTROM"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "RADIO", "names": ["RADIO"], "gender": "?", "first": 13, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ROOFTOP WATER TANK - SUBURBAN NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A wooden tank on stilts above a flat tar roof.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cicadas.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A radio plays low from an open window below.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SADIE KOWALSKI-IBRAHIM, 16, sits on the ledge with her feet dangling.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her younger cousin MILO BERGSTROM, 13, climbs the last rung of the ladder, breathless.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "He freezes when he sees her.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "She doesn't turn.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He climbs onto the roof.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "She hears him.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Shifts a few inches to make room.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He sits.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "They stare at the neighbors' lit windows.", "para": 2, "sent": 4, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "...and now, the late-night countdown. Number three this week...", "name": "RADIO", "speaker": 2, "ext": ["V.O."], "paren": ["muffled, from below"], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "She hums along.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "He taps his heel against the brick.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "A long moment passes.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "He offers her a cracker from his pocket.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "She takes it.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "They chew in the dark.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "She shoves him gently.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "He shoves back.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "She nearly slides off the ledge; he grabs her sleeve.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "They both go still.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Then she laughs, and he lets go, and neither of them says what almost happened.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "...and the number one song in the country...", "name": "RADIO", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "She stands, brushes crumbs from her knees.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Holds out her hand.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "He takes it.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "They climb down together, the song swelling behind them.", "para": 6, "sent": 3, "present": [0, 1, 2]}]}