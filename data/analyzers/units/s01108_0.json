{"scene_id": "s01108_0", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01108.fountain", "heading": "INT. ABANDONED BOARDING SCHOOL - DORMITORY WING - NIGHT", "cast": [{"id": 0, "name": "PROFESSOR LORETTA ACHEBE-VANCE", "names": ["PROFESSOR LORETTA ACHEBE-VANCE", "LORETTA"], "gender": "f", "first": 6, "spoke": 8}, {"id": 1, "name": "THADDEUS NWOKE-BRIGGS", "names": ["THADDEUS NWOKE-BRIGGS", "THADDEUS"], "gender": "m", "first": 8, "spoke": 6}, {"id": 2, "name": "PRUDENCE OYELOWO", "names": ["PRUDENCE OYELOWO", "MRS. PRUDENCE"], "gender": "f", "first": 9, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED BOARDING SCHOOL - DORMITORY WING - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A long room of iron cots, each with a stained mattress.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Peeling wallpaper patterned with faded violets.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cracked mirror at the end of the room.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Moonlight through ragged curtains.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The air is thick with damp.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "PROFESSOR LORETTA ACHEBE-VANCE, 50s, tweed jacket, notebook, steps through the door with a lantern held high.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "She is a historian, and she is tired.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "Behind her, her graduate student THADDEUS NWOKE-BRIGGS, 20s, narrow shoulders, backpack too large.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "And behind him, a ghost-tour guide from the village, MRS. PRUDENCE OYELOWO, 60s, in a brown cardigan, clutching rosary beads.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Cots numbered, but not in order.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Fourteen. Nine. Twenty-two.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "And this one?", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She stops beside a cot.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Its pillow bears a deep hollow.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "A child's shape pressed in.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Don't touch that one.", "name": "MRS. PRUDENCE", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Why not?", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "That was Eleanor's.", "name": "MRS. PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Eleanor who?", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "The girl who stopped sleeping.", "name": "MRS. PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Thaddeus laughs, nervously, then stops.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Loretta sets the lantern on the cot's frame and kneels.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "The flame shivers.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "This mattress is warm.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "That's impossible.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Feel it.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "He hesitates.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Crosses.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Lays two fingers on the sheet.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Pulls them back.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "It is.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Out. All of you. Now.", "name": "MRS. PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Mrs. Oyelowo --", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "She doesn't like people who stay.", "name": "MRS. PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "At the far end of the dormitory, the cracked mirror gives a small, metallic tick.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "All three turn.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "In its dark glass, a faint figure stands at the end of a bed.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "A girl in a long nightgown, head tilted, hands folded.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Nobody move.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "That's not a reflection. There's nobody there.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Hail Mary, full of grace...", "name": "MRS. PRUDENCE", "speaker": 2, "ext": [], "paren": ["rosary clicking"], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "The girl in the mirror lifts her head.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Her face is blank, a pale oval without features.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "She raises a hand and points directly at Thaddeus.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Why me?", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Back away. Slowly.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "He backs.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "His heel catches on a cot leg.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "The iron frame scrapes the floor with a shriek.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "The mirror shatters, shards falling in a silver rain.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "The lantern gutters.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "The dormitory plunges into darkness.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Somewhere in the black, the creak of a hundred cots shifting under unseen weight.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "Run!", "name": "MRS. PRUDENCE", "speaker": 2, "ext": ["CONT'D"], "paren": ["screaming"], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "They do.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Boots clatter on the floorboards.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "The lantern rolls and goes out.", "para": 9, "sent": 2, "present": [0, 1, 2]}]}