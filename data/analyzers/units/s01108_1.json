{"scene_id": "s01108_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01108.fountain", "heading": "INT. DORMITORY CORRIDOR - CONTINUOUS", "cast": [{"id": 0, "name": "LORETTA", "names": ["LORETTA"], "gender": "f", "first": 2, "spoke": 3}, {"id": 1, "name": "THADDEUS", "names": ["THADDEUS"], "gender": "m", "first": 5, "spoke": 2}, {"id": 2, "name": "MRS. PRUDENCE", "names": ["MRS. PRUDENCE"], "gender": "f", "first": 6, "spoke": 1}, {"id": 3, "name": "ELEANOR", "names": ["ELEANOR"], "gender": "f", "first": 23, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. DORMITORY CORRIDOR - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "They tumble through the door and into the corridor, gasping.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Loretta slams it shut.", "para": 0, "sent": 1, "present": [0]}, {"u": 3, "kind": "action", "text": "A heavy thud answers from the other side.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "dialogue", "text": "Hold it!", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 5, "kind": "action", "text": "Thaddeus throws his shoulder against the door.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Mrs. Prudence presses her back against it.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "The thuds come faster.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Harder.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Something laughs, high and child-like.", "para": 1, "sent": 4, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "It's strong!", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "It's a child!", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "It's not a child anymore!", "name": "MRS. PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "The door bulges.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Loretta digs in her satchel, pulls out a brass key.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "There's a lock!", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Do it!", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "She rams the key in, turns.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "The bolt clunks home.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "The thudding stops.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "In the silence, they sink to the floor, panting.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "A tiny voice speaks from beneath the door.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Barely a whisper.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Don't leave me.", "name": "ELEANOR", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "None of them answer.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}]}