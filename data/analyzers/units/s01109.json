{"scene_id": "s01109", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01109.fountain", "heading": "INT. EMPTY GYM - SCOREBOARD CONTROL CLOSET - NIGHT", "cast": [{"id": 0, "name": "BILLIE", "names": ["BILLIE"], "gender": "?", "first": 5, "spoke": 6}, {"id": 1, "name": "ROSSITER-KAMARA", "names": ["ROSSITER-KAMARA"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "JANITOR", "names": ["JANITOR"], "gender": "?", "first": 14, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. EMPTY GYM - SCOREBOARD CONTROL CLOSET - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped closet with a hand-wired switchboard.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Taped wires.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A dusty window onto the dark court below.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A folding chair.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "WILHELMINA \"BILLIE\" ROSSITER-KAMARA, 50s, former point guard, in a faded jersey and sweatpants, sits at the board with a clipboard on her lap.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "She taps a button.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Below, the old scoreboard blinks: HOME 00 GUEST 00.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Check, check.", "name": "BILLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "She taps another button.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "A horn blares through the empty gym.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She winces, turns the volume down a notch.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Twenty-two years and I still hit the wrong one.", "name": "BILLIE", "speaker": 0, "ext": ["CONT'D"], "paren": ["to herself"], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "A crackle on the intercom.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Coach? You still in there?", "name": "JANITOR", "speaker": 2, "ext": ["V.O."], "paren": ["over the PA"], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Five more minutes, Eddie.", "name": "BILLIE", "speaker": 0, "ext": [], "paren": ["leaning to the mic"], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Lights go off at ten.", "name": "JANITOR", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I know.", "name": "BILLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "She hangs up the mic.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Looks down through the window.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "The court is blank hardwood, the lines worn pale.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "She flips a switch.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "A spotlight lands on center court.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "She sits for a while, watching the empty circle of light.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Tip off.", "name": "BILLIE", "speaker": 0, "ext": ["CONT'D"], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "She presses the home-score button.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "HOME climbs: 02.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "She presses it again: 04.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Then 06.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Then 08.", "para": 6, "sent": 4, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "She presses it until it reads 99.", "para": 6, "sent": 5, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "A small, crooked smile.", "para": 6, "sent": 6, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "She hits the horn one last time.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "It rolls across the gym, rattling the rafters.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Good game.", "name": "BILLIE", "speaker": 0, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "She clicks off the spotlight.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "The scoreboard goes dark.", "para": 8, "sent": 1, "present": [0, 1, 2]}]}