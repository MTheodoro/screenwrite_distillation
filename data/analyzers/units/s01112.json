{"scene_id": "s01112", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01112.fountain", "heading": "EXT. ICE-CAVE MOUTH - GLACIER - DAWN", "cast": [{"id": 0, "name": "NADIA", "names": ["NADIA"], "gender": "f", "first": 4, "spoke": 5}, {"id": 1, "name": "VOLKOV-ASANTE", "names": ["VOLKOV-ASANTE"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "NAT", "names": ["NAT"], "gender": "f", "first": 5, "spoke": 5}, {"id": 3, "name": "BELL-TAKAHASHI", "names": ["BELL-TAKAHASHI"], "gender": "?", "first": 5, "spoke": 0}, {"id": 4, "name": "DESMOND OKONKWO-PARR", "names": ["DESMOND OKONKWO-PARR", "DESMOND"], "gender": "m", "first": 6, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ICE-CAVE MOUTH - GLACIER - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A blue gash in a field of white.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wind scours the snow into long ripples.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Three tiny figures stand at the lip of a frozen lake, backs to the cave.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "NADEZHDA \"NADIA\" VOLKOV-ASANTE, 40s, orange parka, iced eyelashes, drags a sled carrying a sleeping bag.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Next to her, IGNATIUS \"NAT\" BELL-TAKAHASHI, 30s, hood drawn, gloves split at the fingertips, winds a rope around his waist.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "action", "text": "Dragging up the rear, DESMOND OKONKWO-PARR, 20s, lagging, hobbles on one swollen ankle.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "dialogue", "text": "Rest stop. Ten minutes.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "We don't have ten.", "name": "NAT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "We have what we have.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "She drops the sled's handle.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "He kneels, checking the knot on the sleeping bag, while Desmond lowers himself onto his pack.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Nat pulls out a thermos, takes a swallow, hands it to Desmond.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Desmond drinks, hands it to Nadia, who sips and stares across the frozen lake at a ridge of dark rock.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "That's the pass.", "name": "NADIA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "How far?", "name": "NAT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Six kilometers. Maybe seven.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "I can walk.", "name": "DESMOND", "speaker": 4, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "You can't.", "name": "NAT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "I can crawl.", "name": "DESMOND", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Nobody's crawling.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "She stands, tightens the sled's strap.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Nat rises, unwinds the rope, ties one end to the sled and the other to Desmond's pack.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Desmond opens his mouth to protest.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Nat holds up a hand.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "You're the anchor. Don't argue.", "name": "NAT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "That's backwards.", "name": "DESMOND", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Humor me.", "name": "NAT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Wind gusts, whipping powder across their faces.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Nadia pulls up her hood, turns toward the pass, and leans into the haul line.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "The sled lurches.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Nat falls in beside her.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Desmond, tethered, drags his foot.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "They walk.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "No one speaks.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Their shadows lengthen across the ice.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}]}