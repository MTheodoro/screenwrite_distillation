{"scene_id": "s01113", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01113.fountain", "heading": "INT. CRYO-VAULT - ORBITAL STATION - NIGHT CYCLE", "cast": [{"id": 0, "name": "COMMANDER ODALYS REEVES-AKINTOLA", "names": ["COMMANDER ODALYS REEVES-AKINTOLA", "ODALYS"], "gender": "f", "first": 5, "spoke": 4}, {"id": 1, "name": "TECH SANTIAGO OYELARAN-WOO", "names": ["TECH SANTIAGO OYELARAN-WOO", "SANTIAGO"], "gender": "f", "first": 6, "spoke": 2}, {"id": 2, "name": "DOCTOR MIRIAM BELLAMY", "names": ["DOCTOR MIRIAM BELLAMY", "MIRIAM"], "gender": "?", "first": 7, "spoke": 1}, {"id": 3, "name": "PIXIE", "names": ["PIXIE"], "gender": "?", "first": 7, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. CRYO-VAULT - ORBITAL STATION - NIGHT CYCLE", "present": []}, {"u": 1, "kind": "action", "text": "Frost on steel.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of dark capsules.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single red indicator blinks.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Breath hangs in the air.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "COMMANDER ODALYS REEVES-AKINTOLA, 40s, parka over her flight suit, kneels by capsule 17 and wipes frost from its window.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Behind her, TECH SANTIAGO OYELARAN-WOO, 30s, scans a diagnostic panel.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Over by the airlock, DOCTOR MIRIAM BELLAMY, 50s, lifts a medical scanner, and next to her a scruffy teenage stowaway, PIXIE, 15, shivers in a borrowed coat.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Pod 17 is cold.", "name": "SANTIAGO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Pod 17 is empty.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Then where is the occupant?", "name": "MIRIAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Maybe he got up and left.", "name": "PIXIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Nobody laughs.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Miriam lowers the scanner.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Odalys stands slowly.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Santiago taps the panel; the indicator blinks red.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Open it.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Ma'am --", "name": "SANTIAGO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Open it.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "He presses the release.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "The capsule hisses.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "The lid lifts.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Inside: a folded blanket, a child's drawing, a shut-off pulse monitor.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Odalys picks up the drawing.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Studies it.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Her thumb smooths the paper's edge.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Miriam steps closer, then stops.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Pixie reaches for the monitor.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Santiago catches her wrist, gently.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "She pulls away, embarrassed, and sits on the floor.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Seal it.", "name": "ODALYS", "speaker": 0, "ext": ["CONT'D"], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Santiago closes the lid.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "The hiss fades.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Miriam puts a hand on Odalys's shoulder.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Odalys folds the drawing in half, then in half again, and slides it into her pocket.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}]}