1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Deal me in.", "name": "WINNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "You don't know how to play.", "name": "KIERAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I know enough.", "name": "WINNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "She cheats.", "name": "AUGUSTINE", "speaker": 1, "ext": [], "paren": ["strumming"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "I do not!", "name": "WINNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "^She cheats.", "name": "AUGUSTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "You both said it at the same time.", "name": "KIERAN", "speaker": 2, "ext": [], "paren": ["laughing"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Winnie throws a card at Augustine.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "It flutters off the platform and spins to the ground.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Lotte leans down to follow its path, then straightens and offers the bag.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Licorice?", "name": "LOTTE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Yes. Black or red?", "name": "WINNIE", "speaker": 0, "ext": [], "paren": ["brightening"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Both.", "name": "LOTTE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Kieran sits up.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Winnie plucks a red strand.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Augustine, still strumming, leans across to take a black one.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Lotte smiles, relieved.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "You're the new one.", "name": "KIERAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Lotte.", "name": "LOTTE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Where'd you move from?", "name": "AUGUSTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Rotterdam.", "name": "LOTTE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Where's that?", "name": "WINNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Far.", "name": "LOTTE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Kieran shuffles the deck.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Winnie takes a card, glances at it, then slides it face down.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Augustine's chords slow into something sweeter.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Lotte tucks her knees up.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "A breeze lifts the sycamore leaves.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "The four of them sit in the green quiet.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "The ukulele hums.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "A card drifts down from somewhere above and lands in Lotte's lap.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "She looks at it, then at the others, and grins.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}]}