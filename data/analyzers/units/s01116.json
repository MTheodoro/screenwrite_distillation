{"scene_id": "s01116", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01116.fountain", "heading": "INT. VINEYARD CELLAR - BARREL ROOM - DUSK", "cast": [{"id": 0, "name": "IZABELLA ROMANO-OKAFOR", "names": ["IZABELLA ROMANO-OKAFOR", "IZABELLA"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "TEDDY", "names": ["TEDDY"], "gender": "m", "first": 5, "spoke": 6}, {"id": 2, "name": "GALLOWAY", "names": ["GALLOWAY"], "gender": "?", "first": 5, "spoke": 0}, {"id": 3, "name": "CAMILA ROMANO", "names": ["CAMILA ROMANO", "CAMILA"], "gender": "?", "first": 4, "spoke": 3}, {"id": 4, "name": "HENRIK ABASI-LUND", "names": ["HENRIK ABASI-LUND", "HENRIK"], "gender": "m", "first": 7, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. VINEYARD CELLAR - BARREL ROOM - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "Oak barrels in rows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Candlelight.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A tasting table with four glasses.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "IZABELLA ROMANO-OKAFOR, 30s, in a linen apron, pours.", "para": 1, "sent": 0, "present": [0, 3]}, {"u": 5, "kind": "action", "text": "Across from her, THEODORE \"TEDDY\" GALLOWAY, 30s, her ex, swirls and sniffs.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "action", "text": "At the end of the table, her sister CAMILA ROMANO, 30s, in a sundress, studies him.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "And beside Camila, a quiet man, HENRIK ABASI-LUND, 40s, who has said nothing all evening.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "Teddy sips.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "Izabella watches.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Camila watches Izabella.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Henrik watches the wine.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "It's good.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "It's better than good.", "name": "IZABELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "It's... complex.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "He means it's sour.", "name": "CAMILA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "I do not.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "You do. Your nose wrinkles.", "name": "CAMILA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Teddy touches his nose.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Izabella suppresses a smile.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Henrik takes a slow sip and sets down his glass.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "It's perfect.", "name": "HENRIK", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "All three turn.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "He shrugs, unbothered.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "I'm the one who sold her the grapes.", "name": "HENRIK", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "That's Henrik.", "name": "IZABELLA", "speaker": 0, "ext": [], "paren": ["to Teddy"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "I gathered.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "And that's my fiance.", "name": "IZABELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Teddy's glass stops halfway to his mouth.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Camila lowers her eyes.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Henrik, calmly, takes Izabella's hand.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "...Congratulations.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Thank you, Teddy.", "name": "IZABELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "He drains the glass.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Sets it down.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Smooths his jacket.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Camila slides the bottle toward him, tender.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Another?", "name": "CAMILA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Please.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": ["a breath"], "dual": false, "present": [0, 1, 2, 3, 4]}]}