{"scene_id": "s01117", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01117.fountain", "heading": "INT. FARMHOUSE KITCHEN - EARLY MORNING", "cast": [{"id": 0, "name": "BABCIA", "names": ["BABCIA"], "gender": "?", "first": 5, "spoke": 10}, {"id": 1, "name": "KOWALCZYK-EZE", "names": ["KOWALCZYK-EZE"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "FELIX DELACROIX-ADEYEMI", "names": ["FELIX DELACROIX-ADEYEMI", "FELIX"], "gender": "m", "first": 6, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. FARMHOUSE KITCHEN - EARLY MORNING", "present": []}, {"u": 1, "kind": "action", "text": "A big scarred table.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Copper pots on hooks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A wood stove ticking.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Through the window, mist lies low over a field of frosted stubble.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "GRANDMOTHER AGNIESZKA \"BABCIA\" KOWALCZYK-EZE, 70s, in a faded housedress, stands at the stove stirring a pot of porridge.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Her grandson FELIX DELACROIX-ADEYEMI, 11, sits at the table in pajamas, chin on his folded arms.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "He watches her back with the stubborn patience of a boy who has a question.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Babcia.", "name": "FELIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Hm.", "name": "BABCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Why did Mama leave?", "name": "FELIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Babcia's spoon stops.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Resumes.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She doesn't turn.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Steam curls around her shoulders.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "She adds a pinch of salt, tastes, adds another.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Eat first.", "name": "BABCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I'm not hungry.", "name": "FELIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "You will be.", "name": "BABCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "She ladles porridge into a chipped bowl.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Brings it to the table.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Sets it before him with a spoon.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Smooths his hair with one flour-dusted hand.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "He leans into it, then catches himself and pulls away.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "She sits across from him with a groan, folds her hands.", "para": 3, "sent": 5, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Your mother wanted a different life.", "name": "BABCIA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Different from what?", "name": "FELIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "From this.", "name": "BABCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "She gestures at the kitchen, the stove, the window.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Felix looks at each in turn.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "He picks up the spoon and stirs the porridge without eating.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Is it that bad?", "name": "FELIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Not to me.", "name": "BABCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Is it bad to you?", "name": "FELIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "No, Felix. It is not bad.", "name": "BABCIA", "speaker": 0, "ext": [], "paren": ["a long pause"], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "He eats a bite.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Then another.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "She watches.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "The stove ticks.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "A rooster crows somewhere in the mist.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Babcia?", "name": "FELIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Yes, my little bird?", "name": "BABCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Will she come back?", "name": "FELIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Babcia reaches across the table and covers his hand with her own.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Her knuckles are swollen, her skin like old paper.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "He turns his palm up and holds on.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Every spring the swallows go away, and every spring they return. Nobody tells them to. They only remember where the barn is.", "name": "BABCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "That's not an answer.", "name": "FELIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "No. It isn't.", "name": "BABCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "She smiles, tired and tender.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "He smiles back, small.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Outside, the mist begins to lift, and the first gold light touches the frost.", "para": 7, "sent": 2, "present": [0, 1, 2]}]}