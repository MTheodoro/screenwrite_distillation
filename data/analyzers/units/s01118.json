{"scene_id": "s01118", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01118.fountain", "heading": "INT. LIGHTHOUSE KEEPER'S LOG ROOM - NIGHT", "cast": [{"id": 0, "name": "INSPECTOR GWENDOLYN ADEBAYO-HARTWELL", "names": ["INSPECTOR GWENDOLYN ADEBAYO-HARTWELL", "GWENDOLYN"], "gender": "?", "first": 6, "spoke": 7}, {"id": 1, "name": "HARBORMASTER", "names": ["HARBORMASTER"], "gender": "?", "first": 23, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. LIGHTHOUSE KEEPER'S LOG ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cramped.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A circular desk.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Ship's barometer, brass lamp, rows of leather-bound logbooks.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Fog presses on the window.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The foghorn sounds every ninety seconds.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "INSPECTOR GWENDOLYN ADEBAYO-HARTWELL, 50s, oilskin coat dripping on the planks, sits at the desk with a lamp and a stack of logbooks.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "She flips pages with a gloved hand, jots notes in a pocket pad, taps a pen against her teeth.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "The foghorn sounds.", "para": 1, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "She does not flinch.", "para": 1, "sent": 3, "present": [0]}, {"u": 10, "kind": "dialogue", "text": "October ninth. \"Light functioning. Visibility poor.\" October tenth. \"Light functioning. Visibility poor.\" October eleventh.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0]}, {"u": 11, "kind": "action", "text": "She stops.", "para": 2, "sent": 0, "present": [0]}, {"u": 12, "kind": "action", "text": "Runs a finger over the ink.", "para": 2, "sent": 1, "present": [0]}, {"u": 13, "kind": "dialogue", "text": "\"Light functioning. Visibility poor. Mr. Pellew did not return.\"", "name": "GWENDOLYN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 14, "kind": "action", "text": "She flips back.", "para": 3, "sent": 0, "present": [0]}, {"u": 15, "kind": "action", "text": "Forward.", "para": 3, "sent": 1, "present": [0]}, {"u": 16, "kind": "action", "text": "Back again.", "para": 3, "sent": 2, "present": [0]}, {"u": 17, "kind": "dialogue", "text": "Three entries, same handwriting. Same ink. Same hour. But the first two were written by a man who is alive, and the third by a man who isn't.", "name": "GWENDOLYN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 18, "kind": "action", "text": "She lifts the lamp and holds the page to the flame.", "para": 4, "sent": 0, "present": [0]}, {"u": 19, "kind": "action", "text": "Behind the ink, faint, a second line shows through, written in a different hand and scratched out.", "para": 4, "sent": 1, "present": [0]}, {"u": 20, "kind": "dialogue", "text": "\"He did not fall.\"", "name": "GWENDOLYN", "speaker": 0, "ext": ["CONT'D"], "paren": ["reading, softly"], "dual": false, "present": [0]}, {"u": 21, "kind": "action", "text": "Her radio crackles on the desk.", "para": 5, "sent": 0, "present": [0]}, {"u": 22, "kind": "action", "text": "She snatches it up.", "para": 5, "sent": 1, "present": [0]}, {"u": 23, "kind": "dialogue", "text": "Inspector? You got anything yet?", "name": "HARBORMASTER", "speaker": 1, "ext": ["V.O."], "paren": ["over the radio"], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "I have a log that lies, Harbormaster. And a keeper who's missing.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Pellew's boat washed up on the rocks. Empty.", "name": "HARBORMASTER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Was the lamp lit?", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Aye. All night.", "name": "HARBORMASTER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Who lit it?", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "You tell me, Inspector. You're the one in the tower.", "name": "HARBORMASTER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "She sets the radio down.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "The foghorn sounds.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "A floorboard above her creaks.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "She looks at the ceiling, at the spiral stair, and then at the pen in her hand.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "She rises, slips the log into her coat, and climbs.", "para": 7, "sent": 0, "present": [0, 1]}]}