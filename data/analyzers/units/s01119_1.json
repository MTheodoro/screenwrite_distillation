{"scene_id": "s01119_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01119.fountain", "heading": "INT. CORSET MAKER'S SHOP - FRONT ROOM - CONTINUOUS", "cast": [{"id": 0, "name": "CLEMENTINE", "names": ["CLEMENTINE"], "gender": "f", "first": 4, "spoke": 11}, {"id": 1, "name": "AMBROSE", "names": ["AMBROSE", "FIGURE"], "gender": "m", "first": 1, "spoke": 11}], "units": [{"u": 0, "kind": "heading", "text": "INT. CORSET MAKER'S SHOP - FRONT ROOM - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "A FIGURE stands inside the door, hat low, collar up, rain pooling on the boards.", "para": 0, "sent": 0, "present": [1]}, {"u": 2, "kind": "action", "text": "They hold a parcel wrapped in oilcloth.", "para": 0, "sent": 1, "present": [1]}, {"u": 3, "kind": "dialogue", "text": "Madame Rousseau?", "name": "FIGURE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [1]}, {"u": 4, "kind": "dialogue", "text": "We are closed.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "I know. I knocked at the back.", "name": "FIGURE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Nobody knocks at the back.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "I did.", "name": "FIGURE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She studies the Figure.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "The stance is wary.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "The voice is low, uncertain of its register.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "What do you want?", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "A fitting.", "name": "FIGURE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "At this hour?", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "I could not come in daylight.", "name": "FIGURE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Clementine's brow furrows.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She looks at the parcel.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "The Figure steps forward, unwraps it, lifts out a gentleman's frock coat, torn at the seam.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "My brother's. He died on the fourteenth. I'd like it altered.", "name": "FIGURE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "For whom?", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "For me.", "name": "FIGURE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "A long silence.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "The gas lamp hisses.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Clementine takes a step closer.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Her expression softens.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "You will not need a corset, then.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "No. Only a good tailor.", "name": "FIGURE", "speaker": 1, "ext": [], "paren": ["a small, relieved breath"], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Then you came to the wrong shop.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Forgive me.", "name": "FIGURE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "No, no. You came to the right one. I am not a tailor. But I know three.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "She takes the coat gently.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Runs her thumb over the torn seam.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "What is your name?", "name": "CLEMENTINE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Ambrose.", "name": "FIGURE", "speaker": 1, "ext": [], "paren": ["after a beat"], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Ambrose what?", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Ambrose Whitlock. For now.", "name": "AMBROSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "For now is enough. Sit, Monsieur Whitlock. I will make some tea.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}