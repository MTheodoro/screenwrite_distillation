{"scene_id": "s01124", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01124.fountain", "heading": "INT. CHURCH BASEMENT - BINGO NIGHT - EVENING", "cast": [{"id": 0, "name": "WILHELMINA OKAFOR-DUNN", "names": ["WILHELMINA OKAFOR-DUNN", "WILHELMINA"], "gender": "f", "first": 5, "spoke": 11}, {"id": 1, "name": "DOV KESSLER", "names": ["DOV KESSLER", "DOV"], "gender": "m", "first": 6, "spoke": 10}, {"id": 2, "name": "ANSELM PRICE", "names": ["ANSELM PRICE", "ANSELM"], "gender": "m", "first": 4, "spoke": 10}, {"id": 3, "name": "CANDACE LOWE", "names": ["CANDACE LOWE", "CANDACE"], "gender": "f", "first": 8, "spoke": 6}, {"id": 4, "name": "RUTENDO MOYO", "names": ["RUTENDO MOYO", "RUTENDO"], "gender": "?", "first": 9, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. CHURCH BASEMENT - BINGO NIGHT - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "A low room of folding tables and fluorescent tubes.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cards, daubers, a coffee urn.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A raffle drum sits on a stage made of risers.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Above it hangs a banner: ST. ANSELM'S ROOF FUND.", "para": 0, "sent": 3, "present": [2]}, {"u": 5, "kind": "action", "text": "WILHELMINA OKAFOR-DUNN (70s, church-lady hat, a ring of keys) holds the microphone.", "para": 1, "sent": 0, "present": [0, 2]}, {"u": 6, "kind": "action", "text": "DOV KESSLER (60s, cardigan, the treasurer, anxious hands) counts bills at the cash table.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "ANSELM PRICE (40s, big man, usher's lanyard) stacks chairs by the wall.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "CANDACE LOWE (30s, nurse's scrubs under a coat, new in the parish) sits alone with a single card.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "RUTENDO MOYO (20s, sharp, laptop bag, a visitor from the diocese) stands at the stairs, watching them all.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Good evening, everyone. Welcome. We'll begin in two minutes.", "name": "WILHELMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Dov glances up at Rutendo, then down at his cash again.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Four hundred. Four hundred and ten.", "name": "DOV", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Mr. Kessler, I'd like to see the ledger before the draw.", "name": "RUTENDO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "It's bingo night. The books are in the office.", "name": "DOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Then let's go to the office.", "name": "RUTENDO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "After the game.", "name": "DOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Wilhelmina lowers the mic.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Dov, is there a problem?", "name": "WILHELMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "No problem, Willie.", "name": "DOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Folks, take your seats, please. We're starting soon.", "name": "ANSELM", "speaker": 2, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Candace moves to a different table, nearer the stairs.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Rutendo notices.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "You're new, aren't you?", "name": "RUTENDO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Three months.", "name": "CANDACE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Why bingo?", "name": "RUTENDO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "It's quiet. I work nights. Sometimes I need quiet.", "name": "CANDACE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Dov stuffs the cash into a metal box and locks it.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "His hands are shaking.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Mr. Kessler. The ledger.", "name": "RUTENDO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "I said after the game!", "name": "DOV", "speaker": 1, "ext": [], "paren": ["louder"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Heads turn.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "The urn hisses.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Wilhelmina steps off the riser, keys jingling.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Dov Kessler. Look at me.", "name": "WILHELMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Willie, don't.", "name": "DOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "I have known you thirty-one years. Look at me.", "name": "WILHELMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Dov looks.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "His face crumples.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "The roof isn't getting fixed.", "name": "DOV", "speaker": 1, "ext": [], "paren": ["barely audible"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "What did he say?", "name": "ANSELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Sit down.", "name": "WILHELMINA", "speaker": 0, "ext": [], "paren": ["to Anselm, flat"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Wilhelmina, what did he say?", "name": "ANSELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "He said the roof isn't getting fixed.", "name": "WILHELMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "A long silence.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Candace puts down her dauber.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "How much?", "name": "CANDACE", "speaker": 3, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "Eleven thousand. Over two years.", "name": "DOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Eleven thousand. Eleven thousand dollars.", "name": "ANSELM", "speaker": 2, "ext": [], "paren": ["to himself, muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Where did it go, Mr. Kessler?", "name": "RUTENDO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "My wife's treatments. The insurance wouldn't...", "name": "DOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "He can't finish.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Wilhelmina takes the metal box from the table and holds it against her chest.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "Nobody leaves. Nobody calls anyone. We are going to have this out like a family.", "name": "WILHELMINA", "speaker": 0, "ext": [], "paren": ["to everyone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "Family? He stole from us!", "name": "ANSELM", "speaker": 2, "ext": [], "paren": ["rising, loud"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "Anselm, sit.", "name": "CANDACE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Don't tell me what to do. You've been here ninety days.", "name": "ANSELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "I've been here long enough to know a man in trouble when I see one.", "name": "CANDACE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "He lied to every person in this room!", "name": "ANSELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "I know. I know I did.", "name": "DOV", "speaker": 1, "ext": [], "paren": ["weeping"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "Mrs. Okafor-Dunn, I have a report due to the bishop.", "name": "RUTENDO", "speaker": 4, "ext": [], "paren": ["to Wilhelmina"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "Then write that the church of St. Anselm found its own answer.", "name": "WILHELMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "dialogue", "text": "What answer?", "name": "RUTENDO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "Wilhelmina walks to the riser, sets the cash box on the raffle drum and opens it.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "She takes out the whole stack of bills and holds it up.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "Tonight's pot goes to Dov's wife. All of it.", "name": "WILHELMINA", "speaker": 0, "ext": [], "paren": ["to the crowd"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "dialogue", "text": "That's the roof money!", "name": "ANSELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "dialogue", "text": "The roof can leak another winter. Dov can't.", "name": "WILHELMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "action", "text": "Anselm opens his mouth.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "Closes it.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "action", "text": "He drags his hand down his face.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "dialogue", "text": "Lord, give me patience.", "name": "ANSELM", "speaker": 2, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "action", "text": "He walks to the cash table, pulls out his wallet, and drops two twenties on the pile.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "dialogue", "text": "That's mine.", "name": "ANSELM", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "dialogue", "text": "Mine too.", "name": "CANDACE", "speaker": 3, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "action", "text": "She adds a ten.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 76, "kind": "action", "text": "Rutendo stares at them.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 77, "kind": "action", "text": "Then, with a long breath, she closes her laptop bag.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 78, "kind": "dialogue", "text": "My report will say the ledger was in order.", "name": "RUTENDO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 79, "kind": "action", "text": "Dov covers his face.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 80, "kind": "action", "text": "Wilhelmina lifts the microphone.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 81, "kind": "dialogue", "text": "B-seven. B, seven.", "name": "WILHELMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 82, "kind": "action", "text": "The room breathes.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 83, "kind": "action", "text": "Daubers lift.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 84, "kind": "action", "text": "Dov sits, shoulders shaking, as the first ball rattles in the drum.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4]}]}