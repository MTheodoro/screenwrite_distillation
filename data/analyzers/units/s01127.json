{"scene_id": "s01127", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01127.fountain", "heading": "INT. PLANETARIUM - DOME - NIGHT", "cast": [{"id": 0, "name": "CHIEF SALMA RAHIMI", "names": ["CHIEF SALMA RAHIMI", "RAHIMI"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "DEPUTY TOBIAS FINCH", "names": ["DEPUTY TOBIAS FINCH", "FINCH"], "gender": "f", "first": 5, "spoke": 2}, {"id": 2, "name": "BRANDT", "names": ["BRANDT"], "gender": "?", "first": 6, "spoke": 1}, {"id": 3, "name": "OYELARAN", "names": ["OYELARAN"], "gender": "m", "first": 7, "spoke": 2}, {"id": 4, "name": "SUNNY", "names": ["SUNNY"], "gender": "f", "first": 8, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. PLANETARIUM - DOME - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A star field wheels overhead.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Under it, rows of reclining seats.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "In the center aisle, a body lies sprawled beneath a projector.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CHIEF SALMA RAHIMI (50s, rain jacket) crouches by the dead man.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "DEPUTY TOBIAS FINCH (20s, notebook) stands at her shoulder.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "DR. BRANDT (60s, the planetarium director, trembling) hugs a laser pointer.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "OYELARAN (40s, night janitor, mop bucket) hovers.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "SUNNY (30s, ticket clerk, headset around her neck) bites her thumbnail.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Nobody leaves the dome.", "name": "RAHIMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Chief, the exits are sealed.", "name": "FINCH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Then nobody breathes loudly.", "name": "RAHIMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Brandt lets out a nervous laugh.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Oyelaran shifts his mop.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "I mopped this floor at ten. There were no footprints.", "name": "OYELARAN", "speaker": 3, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Say that again.", "name": "RAHIMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "No footprints, ma'am. Ten o'clock.", "name": "OYELARAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Rahimi looks at the carpet.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Muddy prints, wet and fresh, lead from the body to Sunny's seat.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Sunny sees them.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Freezes.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Those aren't mine.", "name": "SUNNY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Miss, your boots.", "name": "FINCH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "They're not mine!", "name": "SUNNY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Everyone. Show me your shoes.", "name": "RAHIMI", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Nobody moves.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Above them, a comet slides across the dome.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Oh god. Oh god. Not the telescope.", "name": "BRANDT", "speaker": 2, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}]}