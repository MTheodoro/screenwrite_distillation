{"scene_id": "s01129", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01129.fountain", "heading": "INT. CAR WASH - TUNNEL - NIGHT", "cast": [{"id": 0, "name": "SAL MORETTI", "names": ["SAL MORETTI", "SAL"], "gender": "m", "first": 5, "spoke": 13}, {"id": 1, "name": "DANNY KAPLAN", "names": ["DANNY KAPLAN", "DANNY"], "gender": "m", "first": 8, "spoke": 8}, {"id": 2, "name": "LEO PASQUALE", "names": ["LEO PASQUALE", "LEO"], "gender": "m", "first": 10, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. CAR WASH - TUNNEL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Twenty-four hour.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Neon blue.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Brushes idle.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Water drips.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SAL MORETTI (60s, bomber jacket, thick fingers) leans on a vacuum stand.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Easy.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Humming.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "DANNY KAPLAN (30s, track jacket, nervous knee) sits on an upturned bucket.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Eating sunflower seeds.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "LEO PASQUALE (20s, hoodie, wire-thin) wipes a towel over a Cadillac.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Slow.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Careful.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Leo. You missed a spot.", "name": "SAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Where?", "name": "LEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Rear quarter. Left.", "name": "SAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Leo wipes.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Danny spits a shell.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Sal, we doing this or what?", "name": "DANNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "We're waiting.", "name": "SAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "For what?", "name": "DANNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "For the car to be clean, Danny. He's particular.", "name": "SAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Danny laughs.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Too loud.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "He stops.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Who's particular?", "name": "DANNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "The client. Come on. Eat your seeds.", "name": "SAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Leo sets down the towel.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Wipes his hands on his jeans.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Glances at the Cadillac's trunk.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "How long's he been in there, Sal?", "name": "LEO", "speaker": 2, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Who?", "name": "SAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Don't. Please.", "name": "LEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Sal's smile stays.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "His eyes don't.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Leo. I like you. You know that.", "name": "SAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "I know.", "name": "LEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Your cousin Marcus told me about you. Said you were solid.", "name": "SAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "I am solid.", "name": "LEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Danny stands.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Slowly.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "The bucket rolls.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Sal, what's he talking about?", "name": "DANNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Danny, sit down.", "name": "SAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Sal.", "name": "DANNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Sal pulls a revolver from his jacket.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Not pointing it.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Just holding.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Somebody in this tunnel's wearing a wire. He's been wearing it for three weeks.", "name": "SAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Leo's hand drifts to his hoodie pocket.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Stops.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Tell him it's not you.", "name": "DANNY", "speaker": 1, "ext": [], "paren": ["to Leo"], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "It's not.", "name": "LEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Danny. Open your jacket.", "name": "SAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "What?", "name": "DANNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "Open it. Slow.", "name": "SAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Danny opens his track jacket.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Under it, a small black box taped to his ribs.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Thin red light blinking.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Silence.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "The brushes begin to turn.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Sal. I can explain.", "name": "DANNY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "I know you can.", "name": "SAL", "speaker": 0, "ext": [], "paren": ["gently"], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "He raises the gun.", "para": 13, "sent": 0, "present": [0, 1, 2]}]}