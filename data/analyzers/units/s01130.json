{"scene_id": "s01130", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01130.fountain", "heading": "INT. BREWERY - COPPER VAT ROOM - NIGHT", "cast": [{"id": 0, "name": "WREN", "names": ["WREN"], "gender": "f", "first": 5, "spoke": 9}, {"id": 1, "name": "KOJO", "names": ["KOJO"], "gender": "?", "first": 8, "spoke": 5}, {"id": 2, "name": "MAEVE", "names": ["MAEVE"], "gender": "?", "first": 15, "spoke": 5}, {"id": 3, "name": "HOLT", "names": ["HOLT"], "gender": "m", "first": 34, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. BREWERY - COPPER VAT ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Gleaming copper.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Pipes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Steam.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A catwalk overhead.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "WREN (30s, black coveralls, hair under a cap) drops from a ceiling hatch.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Soft landing.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Duffel on her shoulder.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "KOJO (40s, heavy, brewery uniform stolen from a locker) holds the vault dolly.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Sweat down his neck.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Status.", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Vault's open. Bag's full. Too easy.", "name": "KOJO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Easy is the plan.", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "An earpiece crackles.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "A radio on Kojo's belt hisses.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Wren, Kojo. Guard's on his round. Four minutes to the east door.", "name": "MAEVE", "speaker": 2, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Copy, Maeve. Where's the van?", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Loading dock. Engine warm. Nobody within a block.", "name": "MAEVE", "speaker": 2, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Told you. Easy.", "name": "KOJO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Stop saying that.", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "They wheel the dolly toward the exit.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Cash bags stacked like grain sacks.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Behind them, a vat gurgles, lazy.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "We're done. Home by one.", "name": "KOJO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Quiet.", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "The east door rattles.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "A key in the lock.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Wren and Kojo freeze.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "The dolly stops mid-roll.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "He's early. Two minutes early. Wren, move.", "name": "MAEVE", "speaker": 2, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Where?", "name": "KOJO", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Behind the vat.", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "They duck behind the copper belly.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "The door swings open.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "HOLT (50s, security guard, flashlight, thermos) shuffles in, whistling.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "He sweeps the beam across the floor.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Stops on the dolly tracks in the dust.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Follows them.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Stops at the vat.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Evening, folks.", "name": "HOLT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Wren steps out, hands raised, slow.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Evening.", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "I've been working this shift eleven years. You're the first people to bother with the copper.", "name": "HOLT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Kojo steps out too.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Hands high.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "We can explain.", "name": "KOJO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "I'd hope not.", "name": "HOLT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "He sets the thermos down.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Sits on a crate.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Pours himself a cup.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "My pension got cut last spring. Did you know that?", "name": "HOLT", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "No.", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "They never tell a man until he's already counted on it.", "name": "HOLT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Wren? What's happening in there?", "name": "MAEVE", "speaker": 2, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Wren looks at Holt.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Holt sips his coffee.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Looks at the bags.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Looks at the open east door.", "para": 12, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "I'm going to finish this cup. Slowly. Then I'm going to walk the north corridor. It takes twelve minutes.", "name": "HOLT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "Wren lowers her hands.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "Thank you.", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "Go.", "name": "HOLT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "They grab the dolly and run.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "The east door clicks shut behind them.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "Holt drinks.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "Wren? Anyone?", "name": "MAEVE", "speaker": 2, "ext": ["V.O."], "paren": ["radio, faint"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "Holt picks up the dropped radio from the floor, thumbs the switch.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "They're on their way, miss. Drive carefully.", "name": "HOLT", "speaker": 3, "ext": [], "paren": ["into radio"], "dual": false, "present": [0, 1, 2, 3]}]}