{"scene_id": "s01132", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01132.fountain", "heading": "INT. VILLAGE SCHOOLHOUSE - COMMAND POST - NIGHT", "cast": [{"id": 0, "name": "CAPTAIN WALTER BRIGGS", "names": ["CAPTAIN WALTER BRIGGS", "BRIGGS"], "gender": "m", "first": 5, "spoke": 11}, {"id": 1, "name": "LIEUTENANT FENN", "names": ["LIEUTENANT FENN", "FENN"], "gender": "m", "first": 6, "spoke": 8}, {"id": 2, "name": "SERGEANT KOWALCZYK", "names": ["SERGEANT KOWALCZYK", "KOWALCZYK"], "gender": "m", "first": 7, "spoke": 5}, {"id": 3, "name": "PRIVATE MBEKI", "names": ["PRIVATE MBEKI", "MBEKI"], "gender": "m", "first": 8, "spoke": 2}, {"id": 4, "name": "NEDDY", "names": ["NEDDY"], "gender": "m", "first": 9, "spoke": 1}, {"id": 5, "name": "PRISONER", "names": ["PRISONER"], "gender": "m", "first": 10, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. VILLAGE SCHOOLHOUSE - COMMAND POST - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Desks pushed to the walls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A blackboard still bearing a child's arithmetic.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A lantern on the teacher's desk.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Thunder far off, steady as a drum.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CAPTAIN WALTER BRIGGS (40s, mud to the knee, a map pinned under his palm) studies the table.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "LIEUTENANT FENN (20s, youthful, shaking pencil) stands behind him.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "SERGEANT KOWALCZYK (50s, bull neck) leans in the doorway.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "PRIVATE MBEKI (20s, runner's frame, rifle slung) keeps his eyes on the floor.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "NEDDY (60s, cook, apron under his greatcoat) ladles stew from a bucket.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "In the corner, bound to a child's chair, a PRISONER (20s, enemy uniform, bare head) sits with his chin down.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "Briggs doesn't look up.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "He taps the map once.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Lieutenant. The bridge.", "name": "BRIGGS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Still standing, sir.", "name": "FENN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Then it's the only thing standing.", "name": "BRIGGS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "He straightens and finally looks at the room.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Neddy offers him a tin cup.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "He takes it.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "He doesn't drink it.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Captain, the men want to know about the order.", "name": "KOWALCZYK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "What order?", "name": "BRIGGS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "The one from Brigade. The one nobody's read aloud.", "name": "KOWALCZYK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Mbeki's eyes go to Fenn.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Fenn's pencil snaps.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "I read it, Sergeant.", "name": "FENN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "And?", "name": "KOWALCZYK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Fenn doesn't answer.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "He pulls a folded paper from his pocket, smooths it flat on the desk, then slides it toward Briggs.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Briggs does not touch it.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Read it.", "name": "BRIGGS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Sir, I...", "name": "FENN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Read it, Lieutenant.", "name": "BRIGGS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Fenn clears his throat.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "He reads, flat, as if reciting a recipe.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "\"Hold the village until relieved. No withdrawal. Prisoners to be processed at discretion.\"", "name": "FENN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "A long silence.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "The thunder rolls closer.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Neddy sets down his ladle.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Discretion.", "name": "NEDDY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "It's a word they use when they don't want their names on it.", "name": "KOWALCZYK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Briggs finally drinks.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "He sets the cup down with great care.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "He crosses to the Prisoner and crouches in front of him.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "The Prisoner lifts his head.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "They look at each other for a long moment.", "para": 8, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Does he speak English?", "name": "BRIGGS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "A little, sir.", "name": "MBEKI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "I speak. A little.", "name": "PRISONER", "speaker": 5, "ext": [], "paren": ["thick accent"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "How old are you?", "name": "BRIGGS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "Nineteen.", "name": "PRISONER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Briggs nods.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "He stands.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "His hand finds the holster at his hip, rests on the leather.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "Sir.", "name": "FENN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "Yes?", "name": "BRIGGS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "There's the bridge, sir. If we blow it...", "name": "FENN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "Then we've left the village.", "name": "BRIGGS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "dialogue", "text": "Yes, sir.", "name": "FENN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "Against orders.", "name": "BRIGGS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "Yes, sir.", "name": "FENN", "speaker": 1, "ext": [], "paren": ["barely"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "Kowalczyk steps out of the doorway.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "He crosses to the blackboard and, with his thumb, wipes a child's sum from the slate.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "dialogue", "text": "I've been waiting thirty years for an officer to say that out loud.", "name": "KOWALCZYK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "Briggs lifts his hand off the holster.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "He unbuckles the Prisoner's wrists.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "dialogue", "text": "Private Mbeki. Take him to the cellar. Give him my blanket.", "name": "BRIGGS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "dialogue", "text": "Yes, sir.", "name": "MBEKI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "action", "text": "He moves the Prisoner out.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "action", "text": "At the door, the Prisoner turns, mouths something.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "action", "text": "Briggs doesn't see.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "action", "text": "The first shell lands.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "action", "text": "The lantern leaps.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "action", "text": "The blackboard cracks across the middle.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "action", "text": "Dust sifts from the ceiling.", "para": 13, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 75, "kind": "action", "text": "Neddy covers the stew with his body.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 76, "kind": "action", "text": "Fenn drops under the desk.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 77, "kind": "action", "text": "Kowalczyk draws his pistol and faces the door.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 78, "kind": "action", "text": "Briggs doesn't move.", "para": 14, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 79, "kind": "action", "text": "He stands at the table with one hand flat on the map, and he starts to laugh, softly, because it is the only thing left.", "para": 14, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}]}