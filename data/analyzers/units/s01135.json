{"scene_id": "s01135", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01135.fountain", "heading": "INT. APARTMENT BUILDING - STAIRWELL - NIGHT", "cast": [{"id": 0, "name": "NADIA", "names": ["NADIA"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "ISAAC", "names": ["ISAAC"], "gender": "?", "first": 12, "spoke": 2}, {"id": 2, "name": "OKORO", "names": ["OKORO", "MR. OKORO"], "gender": "?", "first": 33, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. APARTMENT BUILDING - STAIRWELL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Concrete steps.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A buzzing bulb on a timer.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Graffiti on the rail.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "NADIA (30s, grocery bags, headphones) climbs, humming.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She pauses on the fourth-floor landing.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "The bulb clicks off.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "Dark.", "para": 1, "sent": 3, "present": [0]}, {"u": 8, "kind": "action", "text": "She fumbles for the switch.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Finds it.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "Click.", "para": 2, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "Light.", "para": 2, "sent": 3, "present": [0]}, {"u": 12, "kind": "action", "text": "Standing three steps above her: ISAAC (40s, her neighbor, bathrobe, bare feet).", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He is perfectly still.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He stares straight ahead.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Isaac? You scared me.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He says nothing.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She lowers her bags.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Isaac, are you okay?", "name": "NADIA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He turns his head.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Slowly.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "His eyes are blank, rolled back.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "She steps down.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "He steps down.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She backs against the rail.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "He keeps coming, his lips moving.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Don't turn the light off.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": ["a whisper"], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "What?", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "The bulb buzzes.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Clicks.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Dark.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "A wet breath in her ear.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "The light snaps on.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "MR. OKORO (70s, building super, toolbelt, flashlight) stands on the landing below, thumb on the switch.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Nadia! Why are you two standing in the dark?", "name": "MR. OKORO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Isaac blinks.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Sways.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Looks around, bewildered, as if waking.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Sleepwalking again. I'm sorry.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "He climbs back up the stairs, slow and sheepish.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Nadia exhales, shaking.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "You okay?", "name": "MR. OKORO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Fine.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "She grabs her bags and, without turning around, takes the stairs two at a time.", "para": 11, "sent": 0, "present": [0, 1, 2]}]}