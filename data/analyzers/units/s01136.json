{"scene_id": "s01136", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01136.fountain", "heading": "INT. GRAND HOTEL - BALLROOM KITCHEN - NIGHT", "cast": [{"id": 0, "name": "VERA LINDQUIST", "names": ["VERA LINDQUIST", "VERA"], "gender": "f", "first": 4, "spoke": 8}, {"id": 1, "name": "ISADORA FENWICK", "names": ["ISADORA FENWICK", "ISADORA"], "gender": "m", "first": 5, "spoke": 5}, {"id": 2, "name": "COLONEL HADDAD", "names": ["COLONEL HADDAD", "HADDAD"], "gender": "m", "first": 6, "spoke": 10}, {"id": 3, "name": "CATERER KIP", "names": ["CATERER KIP", "KIP"], "gender": "m", "first": 7, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRAND HOTEL - BALLROOM KITCHEN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Stainless steel, white tile, a long pass-through window to the ballroom.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Music and applause leak in.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rows of champagne flutes wait on silver trays.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "VERA LINDQUIST (40s, black evening gown, a hairpin in her chignon) leans on a counter, calm, arranging canap\u00e9s on a tray.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "ISADORA FENWICK (30s, catering uniform, name tag) wipes down the other side of the counter, humming.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "COLONEL HADDAD (60s, dress uniform, medals, a flushed face) stands in the doorway with a glass.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "CATERER KIP (20s, apron, clipboard) hovers by the walk-in cooler.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Ladies. I was told there'd be champagne.", "name": "HADDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "The champagne is in the ballroom, Colonel.", "name": "VERA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Yes, but this is where the interesting people are.", "name": "HADDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "That's very kind.", "name": "ISADORA", "speaker": 1, "ext": [], "paren": ["smiling"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Is it?", "name": "HADDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "He drifts closer.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Kip glances at his clipboard, then at the door.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Vera continues arranging canap\u00e9s, unhurried.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Isadora, would you hand me the tongs?", "name": "VERA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Of course, Vera.", "name": "ISADORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "She slides the tongs across.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Their fingers brush.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "A beat too long.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "You two know each other?", "name": "HADDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "We're colleagues.", "name": "VERA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "In catering?", "name": "HADDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "In logistics.", "name": "ISADORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Haddad laughs, tips back his glass.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Kip stiffens at the word.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Ms. Fenwick, the delivery is waiting at the dock.", "name": "KIP", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Thank you, Kip. Tell them five minutes.", "name": "ISADORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Kip nods and slips out.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "The swinging door sighs shut.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Haddad watches it close.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Strange boy.", "name": "HADDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "He's new.", "name": "VERA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Is the car ready?", "name": "HADDAD", "speaker": 2, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Yes.", "name": "VERA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Then I believe I'll take my champagne.", "name": "HADDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "He holds out his empty glass.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Isadora fills it from a bottle on the counter.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Haddad drinks, and smiles, and sways a little.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "That's... that's a strange taste.", "name": "HADDAD", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "It's a very old vintage.", "name": "VERA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Vera, I don't...", "name": "HADDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "His knees buckle.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Isadora catches his arm and guides him smoothly onto a flour sack.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Vera pulls the hairpin from her chignon, glances at the ballroom window, and slides it back in.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Four minutes before it takes him.", "name": "ISADORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Then we have three to be gone.", "name": "VERA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "The door swings open.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Kip reappears, white as paper.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Ms. Lindquist. The Colonel's driver is at the dock.", "name": "KIP", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Of course he is.", "name": "VERA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "She smooths her gown, takes Isadora's hand, and the two women walk out through the cold-room door as the applause swells.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}]}