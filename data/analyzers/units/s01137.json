{"scene_id": "s01137", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01137.fountain", "heading": "INT. BOTANICAL GARDEN - GREENHOUSE - DAY", "cast": [{"id": 0, "name": "SUKI", "names": ["SUKI"], "gender": "f", "first": 5, "spoke": 9}, {"id": 1, "name": "MOSES", "names": ["MOSES"], "gender": "?", "first": 6, "spoke": 9}, {"id": 2, "name": "GARDENER", "names": ["GARDENER"], "gender": "?", "first": 7, "spoke": 3}, {"id": 3, "name": "ULRICH", "names": ["ULRICH"], "gender": "?", "first": 27, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. BOTANICAL GARDEN - GREENHOUSE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Humid glass.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Orchids and palms.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Gravel paths.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Mist nozzles hiss.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SUKI (30s, tourist cardigan, a camera around her neck) pretends to photograph a fern.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "MOSES (50s, bucket hat, binoculars) pretends to read a plaque.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "A GARDENER (60s, canvas apron, pruners) clips a hedge nearby, whistling.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "He hasn't looked at us.", "name": "SUKI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "He's looked at us three times.", "name": "MOSES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Then he's bored.", "name": "SUKI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "He's a gardener. He's trained to be bored.", "name": "MOSES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Do you have the schedule?", "name": "SUKI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Guards change at two. They leave the east door unlocked for the delivery.", "name": "MOSES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "And the orchid?", "name": "SUKI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Third bench. Behind the staghorn. Blue pot.", "name": "MOSES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "How much?", "name": "SUKI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Four hundred thousand to the right collector.", "name": "MOSES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "For a flower.", "name": "SUKI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "For the last one.", "name": "MOSES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "The Gardener's whistle stops.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "He sets down his pruners.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "It's not the last one.", "name": "GARDENER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Suki and Moses turn, slowly.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Excuse me?", "name": "SUKI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "The blue Vanda coerulea. There are eleven in the cold house. You're welcome to look.", "name": "GARDENER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "We were just admiring...", "name": "MOSES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Admire all you like. My name is Ulrich. I've been the keeper here for thirty-six years, and I know what you're after.", "name": "GARDENER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Told you.", "name": "SUKI", "speaker": 0, "ext": [], "paren": ["to Moses"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Don't.", "name": "MOSES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "I'll make you a deal. You leave the blue pot. I'll let you take a cutting. A real one. Ready to root.", "name": "ULRICH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Why?", "name": "SUKI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Because the right collector is a man named Prosser who kills his plants, and I'd rather see one live.", "name": "ULRICH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Show us the cold house.", "name": "MOSES", "speaker": 1, "ext": [], "paren": ["slowly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Follow me. And put the camera away. It frightens the ferns.", "name": "ULRICH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}