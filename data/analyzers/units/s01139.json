{"scene_id": "s01139", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01139.fountain", "heading": "INT. WEDDING TENT - GENERATOR TRAILER - NIGHT", "cast": [{"id": 0, "name": "NAOMI", "names": ["NAOMI"], "gender": "f", "first": 5, "spoke": 11}, {"id": 1, "name": "HENRIK", "names": ["HENRIK"], "gender": "m", "first": 7, "spoke": 11}, {"id": 2, "name": "GRAN IMELDA", "names": ["GRAN IMELDA"], "gender": "?", "first": 55, "spoke": 3}, {"id": 3, "name": "BEST MAN DEWEY", "names": ["BEST MAN DEWEY", "DEWEY"], "gender": "?", "first": 55, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. WEDDING TENT - GENERATOR TRAILER - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped steel trailer behind the marquee.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cables, fuel cans, a dim bulb.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The generator thrums.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Through the thin wall, a band plays a slow song.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "NAOMI (late 20s, bridesmaid dress, boots) sits on a crate with a flask.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She's been crying, a little, and has wiped it off.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "HENRIK (30s, rolled shirtsleeves, tie loosened) slips in, shutting the door.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He doesn't see her.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He leans his forehead against the wall.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She coughs.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He spins.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Jesus.", "name": "HENRIK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Sorry. I was here first.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "You're a bridesmaid.", "name": "HENRIK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "You're the groom's brother.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He nods.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She holds out the flask.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He takes it.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Drinks.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Hands it back.", "para": 5, "sent": 4, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Why are you in the generator trailer?", "name": "HENRIK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "It's the only quiet place. You?", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Same.", "name": "HENRIK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "They sit in silence.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "The band shifts to a waltz.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "You gave a nice toast.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "It was a lie.", "name": "HENRIK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "All toasts are lies.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "He laughs.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "She laughs.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Then it fades.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Do you know the bride well?", "name": "HENRIK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Twelve years. Since college.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Then you know why she's marrying him.", "name": "HENRIK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "I know why she thinks she is.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": ["carefully"], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "He studies her.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "She holds the look.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Outside, a spotlight sweeps the tent wall.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "I should go back.", "name": "HENRIK", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "You should.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Neither moves.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "He sits on a fuel can across from her.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Closer than before.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "She offers the flask again.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "Their fingers touch.", "para": 9, "sent": 4, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "She doesn't pull away.", "para": 9, "sent": 5, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "Naomi.", "name": "HENRIK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "You remember my name.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "It's on the place cards.", "name": "HENRIK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Is that all it is?", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "He leans in.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "She leans in.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "A heartbeat from a kiss.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "The trailer door bangs open.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "GRAN IMELDA (80s, silk shawl, cane) fills the frame, with BEST MAN DEWEY (30s, drunk, tux jacket on backwards) on her arm.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Found them!", "name": "GRAN IMELDA", "speaker": 2, "ext": [], "paren": ["to the whole tent"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "The bride's been looking for you, Henrik. She says you're late for the photograph.", "name": "DEWEY", "speaker": 3, "ext": [], "paren": ["slurring"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "Naomi and Henrik spring apart.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "And you, dear. She's looking for you, too.", "name": "GRAN IMELDA", "speaker": 2, "ext": [], "paren": ["to Naomi, pointed"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "Naomi stands, smooths her dress.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "Henrik takes his tie in both hands.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "Don't let this be the end of it.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": ["low, to Henrik"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "It isn't.", "name": "HENRIK", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "They walk past Gran Imelda together into the lights.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "Imelda watches them go, then turns to Dewey.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "Young man. Never tell the groom's mother what you saw.", "name": "GRAN IMELDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "I didn't see anything.", "name": "DEWEY", "speaker": 3, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}]}