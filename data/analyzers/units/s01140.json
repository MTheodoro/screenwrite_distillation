{"scene_id": "s01140", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01140.fountain", "heading": "EXT. SALT FLAT - STAGE STATION - NOON", "cast": [{"id": 0, "name": "AMOS CALLOWAY", "names": ["AMOS CALLOWAY", "AMOS", "CALLOWAY"], "gender": "m", "first": 4, "spoke": 17}, {"id": 1, "name": "LORENA VEGA", "names": ["LORENA VEGA", "LORENA"], "gender": "?", "first": 5, "spoke": 16}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SALT FLAT - STAGE STATION - NOON", "present": []}, {"u": 1, "kind": "action", "text": "A single adobe hut on an endless white plain.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A water trough, a hitching rail, a tin sign: LAST WATER 40 MILES.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Heat shimmers off the ground.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "AMOS CALLOWAY (60s, weathered, a deputy's star pinned to a faded vest) sits on the porch whittling a stick.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "LORENA VEGA (30s, dusty traveling dress, a carpetbag) stands at the trough, pumping water into a tin cup.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Neither has spoken for some time.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "That water's brackish.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "I've had worse.", "name": "LORENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Not out here, you haven't.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She drinks anyway.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Makes a face.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Drinks again.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Is the stage late?", "name": "LORENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "It's always late.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "How late?", "name": "LORENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Ask me tomorrow.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She sets the cup on the rail and sits on the other end of the porch.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "A fly buzzes between them.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Amos blows shavings off his stick.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "You're a long way from anywhere, ma'am.", "name": "AMOS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "So are you.", "name": "LORENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "I'm paid to be.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "By whom?", "name": "LORENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "County of Pecos. Thirty dollars a month.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "That's not much for sitting in a salt pan.", "name": "LORENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "It's not much for anything.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "She almost smiles.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "He notices, looks away, and keeps whittling.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Mr. Calloway.", "name": "LORENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "You know my name.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "It's on the sign.", "name": "LORENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "He glances at the tin plate nailed beside the door: A. CALLOWAY, STATION AGENT.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "He chuckles.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "So it is.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "I'm looking for a man named Eduardo Vega.", "name": "LORENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Amos's whittling slows.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Is that so.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "My husband. He came through this station two years back.", "name": "LORENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Many men come through.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "He had a limp. A silver tooth. He sang when he was nervous.", "name": "LORENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Amos puts down the knife.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "He and Lorena look at each other across the porch.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Neither of them blinks.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "The wind lifts a veil of white dust off the flats and lets it fall.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "He sang \"La Golondrina.\"", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Yes.", "name": "LORENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "Badly.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Yes.", "name": "LORENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "He left here on the nineteenth of May, going west on a bay horse. I never saw him after.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Thank you.", "name": "LORENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "You don't want to know more?", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Not today.", "name": "LORENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "She stands, brushes her skirt, picks up the carpetbag.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "Amos rises, too, and offers his hand.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "She takes it.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "They both hold on a little longer than they need to.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "The stage will come. Tomorrow, or the day after.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "Then I'll wait.", "name": "LORENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "She sits again on the porch step.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "Amos picks up his stick.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "The shimmer on the flats goes on and on.", "para": 9, "sent": 2, "present": [0, 1]}]}