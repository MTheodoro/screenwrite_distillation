{"scene_id": "s01142", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01142.fountain", "heading": "EXT. CREVASSE LEDGE - GLACIER - DAY", "cast": [{"id": 0, "name": "MARTA VOLK", "names": ["MARTA VOLK", "MARTA"], "gender": "f", "first": 4, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "EXT. CREVASSE LEDGE - GLACIER - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Blue-white walls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A thin shelf of ice a hundred feet below the surface.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wind howls overhead like a train that never arrives.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MARTA VOLK (30s, orange jacket torn at the shoulder, goggles cracked) lies on the ledge, one leg twisted under her.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her pack is split open beside her.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "A handheld voice recorder dangles from a strap on her wrist, its red light on.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "She tries to sit.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Gasps.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "Falls back.", "para": 2, "sent": 2, "present": [0]}, {"u": 10, "kind": "dialogue", "text": "Okay. Okay okay okay.", "name": "MARTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 11, "kind": "action", "text": "She breathes into her glove.", "para": 3, "sent": 0, "present": [0]}, {"u": 12, "kind": "action", "text": "Steam curls.", "para": 3, "sent": 1, "present": [0]}, {"u": 13, "kind": "action", "text": "She reaches for the pack, grabs a thermos, shakes it.", "para": 3, "sent": 2, "present": [0]}, {"u": 14, "kind": "action", "text": "Empty.", "para": 3, "sent": 3, "present": [0]}, {"u": 15, "kind": "action", "text": "Tosses it down.", "para": 3, "sent": 4, "present": [0]}, {"u": 16, "kind": "action", "text": "It spins into the dark, clinks, falls silent for a very long time.", "para": 3, "sent": 5, "present": [0]}, {"u": 17, "kind": "action", "text": "She stares after it.", "para": 4, "sent": 0, "present": [0]}, {"u": 18, "kind": "dialogue", "text": "Don't look down.", "name": "MARTA", "speaker": 0, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0]}, {"u": 19, "kind": "action", "text": "She fumbles at the recorder, presses a button.", "para": 5, "sent": 0, "present": [0]}, {"u": 20, "kind": "action", "text": "A click, then her own voice, bright and young, plays back from earlier in the day.", "para": 5, "sent": 1, "present": [0]}, {"u": 21, "kind": "dialogue", "text": "Day four, summit approach. Weather's perfect. I'm going to make it to the col by noon and be back at base before the storm. Marta Volk, signing off.", "name": "MARTA", "speaker": 0, "ext": ["V.O."], "paren": ["recording"], "dual": false, "present": [0]}, {"u": 22, "kind": "action", "text": "The recording clicks off.", "para": 6, "sent": 0, "present": [0]}, {"u": 23, "kind": "action", "text": "Marta laughs, a ragged crack of a laugh.", "para": 6, "sent": 1, "present": [0]}, {"u": 24, "kind": "dialogue", "text": "You liar.", "name": "MARTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 25, "kind": "action", "text": "She turns the recorder over.", "para": 7, "sent": 0, "present": [0]}, {"u": 26, "kind": "action", "text": "Presses record.", "para": 7, "sent": 1, "present": [0]}, {"u": 27, "kind": "dialogue", "text": "Day four. Fell about ninety feet into a crevasse. Left leg broken. Maybe two ribs. Phone's dead. Rope's gone. It's three o'clock. I'm going to try to climb.", "name": "MARTA", "speaker": 0, "ext": ["CONT'D"], "paren": ["into recorder"], "dual": false, "present": [0]}, {"u": 28, "kind": "action", "text": "She stops the recording, studies the ice wall.", "para": 8, "sent": 0, "present": [0]}, {"u": 29, "kind": "action", "text": "Finds a handhold.", "para": 8, "sent": 1, "present": [0]}, {"u": 30, "kind": "action", "text": "Pulls herself up an inch, two, three inches.", "para": 8, "sent": 2, "present": [0]}, {"u": 31, "kind": "action", "text": "Screams.", "para": 8, "sent": 3, "present": [0]}, {"u": 32, "kind": "action", "text": "Slips back down.", "para": 8, "sent": 4, "present": [0]}, {"u": 33, "kind": "action", "text": "Lies there panting.", "para": 8, "sent": 5, "present": [0]}, {"u": 34, "kind": "action", "text": "Silence.", "para": 9, "sent": 0, "present": [0]}, {"u": 35, "kind": "action", "text": "Wind.", "para": 9, "sent": 1, "present": [0]}, {"u": 36, "kind": "action", "text": "A crack echoes through the ice.", "para": 9, "sent": 2, "present": [0]}, {"u": 37, "kind": "dialogue", "text": "No no no.", "name": "MARTA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 38, "kind": "action", "text": "A line of fracture races across the wall above her.", "para": 10, "sent": 0, "present": [0]}, {"u": 39, "kind": "action", "text": "Ice dust sifts.", "para": 10, "sent": 1, "present": [0]}, {"u": 40, "kind": "action", "text": "She rolls, covers her head.", "para": 10, "sent": 2, "present": [0]}, {"u": 41, "kind": "action", "text": "A slab of ice the size of a door crashes onto the ledge just beyond her feet and shatters, flinging shards across her jacket.", "para": 10, "sent": 3, "present": [0]}, {"u": 42, "kind": "action", "text": "She lies still.", "para": 11, "sent": 0, "present": [0]}, {"u": 43, "kind": "action", "text": "Waits.", "para": 11, "sent": 1, "present": [0]}, {"u": 44, "kind": "action", "text": "Nothing else falls.", "para": 11, "sent": 2, "present": [0]}, {"u": 45, "kind": "dialogue", "text": "Okay.", "name": "MARTA", "speaker": 0, "ext": ["CONT'D"], "paren": ["a breath"], "dual": false, "present": [0]}, {"u": 46, "kind": "action", "text": "Her hand gropes at her jacket and finds a small black pouch zipped into the lining.", "para": 12, "sent": 0, "present": [0]}, {"u": 47, "kind": "action", "text": "She pulls it out.", "para": 12, "sent": 1, "present": [0]}, {"u": 48, "kind": "action", "text": "Inside, a whistle and an emergency flare.", "para": 12, "sent": 2, "present": [0]}, {"u": 49, "kind": "action", "text": "She stares at them, laughing and crying.", "para": 12, "sent": 3, "present": [0]}, {"u": 50, "kind": "dialogue", "text": "You absolute idiot. It was in your pocket the whole time.", "name": "MARTA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 51, "kind": "action", "text": "She jams the whistle in her teeth and blows.", "para": 13, "sent": 0, "present": [0]}, {"u": 52, "kind": "action", "text": "A long, shrill note spears up through the crevasse.", "para": 13, "sent": 1, "present": [0]}, {"u": 53, "kind": "action", "text": "She pulls the cap off the flare and strikes it.", "para": 13, "sent": 2, "present": [0]}, {"u": 54, "kind": "action", "text": "It hisses.", "para": 13, "sent": 3, "present": [0]}, {"u": 55, "kind": "action", "text": "Red light floods the blue walls, turns the ice to fire.", "para": 13, "sent": 4, "present": [0]}, {"u": 56, "kind": "action", "text": "She raises the flare overhead and blows the whistle again, again.", "para": 14, "sent": 0, "present": [0]}, {"u": 57, "kind": "action", "text": "Far above, faint, very faint, the drone of a helicopter rotor answers.", "para": 15, "sent": 0, "present": [0]}, {"u": 58, "kind": "action", "text": "Marta drops her head to the ice.", "para": 16, "sent": 0, "present": [0]}, {"u": 59, "kind": "action", "text": "The flare sputters in her fist.", "para": 16, "sent": 1, "present": [0]}, {"u": 60, "kind": "action", "text": "She keeps blowing.", "para": 16, "sent": 2, "present": [0]}]}