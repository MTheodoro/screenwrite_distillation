{"scene_id": "s01143", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01143.fountain", "heading": "INT. CITY LIBRARY - CARD CATALOG ROOM - DAY", "cast": [{"id": 0, "name": "CLERK PHINEAS", "names": ["CLERK PHINEAS", "PHINEAS"], "gender": "m", "first": 3, "spoke": 5}, {"id": 1, "name": "SOLANGE", "names": ["SOLANGE"], "gender": "?", "first": 3, "spoke": 6}, {"id": 2, "name": "YUSUF", "names": ["YUSUF"], "gender": "?", "first": 3, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. CITY LIBRARY - CARD CATALOG ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Oak cabinets floor to ceiling, brass pulls, a ladder on rails.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dust and quiet.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "CLERK PHINEAS (60s, sleeve garters, wire spectacles) slides a drawer shut and opens another without looking, while DR. SOLANGE (40s, tweed, a notebook open on her forearm) climbs the ladder, taps a drawer, and mutters a number, and YUSUF (20s, backpack, earbuds hanging) crouches by a low cabinet, flipping cards with one finger and reading each aloud under his breath.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 4, "kind": "dialogue", "text": "It would be under P, Doctor. P for Pemberton.", "name": "PHINEAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "It was under W the last time.", "name": "SOLANGE", "speaker": 1, "ext": [], "paren": ["from the ladder"], "dual": false, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Wait, which one are we looking for?", "name": "YUSUF", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Pemberton's Almanac of Local Murders.", "name": "PHINEAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Whitcombe's Almanac, Phineas.", "name": "SOLANGE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Whitcombe wrote nothing of the sort.", "name": "PHINEAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "There's a Whitcombe here. Whitcombe, Edmund. \"Almanac of Unsolved Disappearances.\"", "name": "YUSUF", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "That's the one.", "name": "SOLANGE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "That is not Pemberton.", "name": "PHINEAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "I never said Pemberton.", "name": "SOLANGE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "You did. Twice.", "name": "YUSUF", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Yusuf, don't.", "name": "SOLANGE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "I'm just saying.", "name": "YUSUF", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Phineas closes his drawer, folds his hands, and studies the two of them.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Yusuf grins at the card.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Call number nine-four-one. Basement stacks.", "name": "YUSUF", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Of course it is.", "name": "PHINEAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Lead on.", "name": "SOLANGE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}