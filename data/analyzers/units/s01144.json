{"scene_id": "s01144", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01144.fountain", "heading": "INT. PHOTOGRAPHER'S STUDIO - DARKROOM - NIGHT - 1893", "cast": [{"id": 0, "name": "ELIZA PRYCE", "names": ["ELIZA PRYCE", "ELIZA"], "gender": "?", "first": 5, "spoke": 5}, {"id": 1, "name": "JASPER", "names": ["JASPER"], "gender": "?", "first": 6, "spoke": 3}, {"id": 2, "name": "WHITLOCK", "names": ["WHITLOCK", "MRS. WHITLOCK"], "gender": "?", "first": 7, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. PHOTOGRAPHER'S STUDIO - DARKROOM - NIGHT - 1893", "present": []}, {"u": 1, "kind": "action", "text": "Red lamp.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Trays of chemicals.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Glass plates drying on a rack.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The air smells of vinegar.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ELIZA PRYCE (30s, long sleeves rolled, stained gloves) lifts a plate from the developing bath with tongs.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "JASPER (12, apprentice, oversized apron) stands on a stool holding a lantern shaded in red tissue.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "MRS. WHITLOCK (50s, widow's black, a hat pinned too firmly) waits at the door, clutching a reticule.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Jasper, hold the light steadier.", "name": "ELIZA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Yes, Miss Pryce.", "name": "JASPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Mrs. Whitlock, you may come closer. But not past the line.", "name": "ELIZA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "What line?", "name": "MRS. WHITLOCK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "The chalk, ma'am.", "name": "JASPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Mrs. Whitlock steps up to the chalk mark.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "The plate drips.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "In the red light, a ghostly negative: a woman at a window, and over her shoulder a faint pale shape.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Is that...", "name": "MRS. WHITLOCK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Your husband, I believe.", "name": "ELIZA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "He's been dead eleven years.", "name": "MRS. WHITLOCK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Then he's very patient.", "name": "ELIZA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Miss Pryce, do you want it fixed?", "name": "JASPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Yes, Jasper. Fix it before the lady changes her mind.", "name": "ELIZA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Mrs. Whitlock watches the plate slide into the fixing bath.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "The shape stays.", "para": 3, "sent": 1, "present": [0, 1, 2]}]}