"paren": ["scanning"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "dialogue", "text": "Everybody smile! The auditor's coming at midnight!", "name": "ZEKE", "speaker": 2, "ext": [], "paren": ["from above"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "Tilda, is it the blue box?", "name": "MANNY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Wait for the nod.", "name": "TILDA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Poppy bends over the blue box, lifts a corner.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Inside, bricks of cash in plastic.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Her pulse jumps.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "She closes the lid.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Now.", "name": "POPPY", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "The belt jolts and stops.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Strobes die.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Total dark.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "A new voice, calm, from the stairs.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "OSWALD (60s, charcoal coat, a clip-on tie, a company badge) switches on a flashlight and sweeps it across them.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "The auditor is early, I'm afraid.", "name": "OSWALD", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Rhett's pallet crashes.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Poppy runs.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Manny runs.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Tilda drops her scanner.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Zeke whips around.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Oswald? Oswald, we can explain!", "name": "ZEKE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "I'm sure you can, Zeke.", "name": "OSWALD", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}