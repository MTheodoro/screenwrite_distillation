{"scene_id": "s01148", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01148.fountain", "heading": "INT. SCHOOL BUS DEPOT - DISPATCH OFFICE - MORNING", "cast": [{"id": 0, "name": "GLORIA PEPPER", "names": ["GLORIA PEPPER", "GLORIA"], "gender": "f", "first": 5, "spoke": 4}, {"id": 1, "name": "MURRAY", "names": ["MURRAY"], "gender": "?", "first": 6, "spoke": 4}, {"id": 2, "name": "PRESTON", "names": ["PRESTON"], "gender": "?", "first": 7, "spoke": 4}, {"id": 3, "name": "YASMIN", "names": ["YASMIN"], "gender": "f", "first": 8, "spoke": 3}, {"id": 4, "name": "MRS. FEATHERSTONE", "names": ["MRS. FEATHERSTONE"], "gender": "?", "first": 19, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. SCHOOL BUS DEPOT - DISPATCH OFFICE - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "A cluttered cinderblock office.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A cracked wall clock, a coffee machine, a wall of key hooks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A grimy window overlooks a lot of yellow buses lined up like loaves.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "On the desk, an old intercom box with a blinking red light.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "GLORIA PEPPER (50s, dispatcher, cat-eye glasses, a headset slung around her neck) sorts keys.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "MURRAY (60s, veteran driver, thermos the size of a fire extinguisher) reads the paper at the desk.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "PRESTON (20s, new driver, clip-on tie, too-clean uniform) hovers at the doorway, gripping a clipboard.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "YASMIN (30s, route supervisor, blazer, an energy drink) scrolls her tablet.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "All of them are slightly too loud.", "para": 1, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Preston, route twelve. Don't hit anything.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I haven't hit anything yet.", "name": "PRESTON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Give it time.", "name": "MURRAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Murray, be nice.", "name": "YASMIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "I am being nice. If I weren't nice, I'd tell him about the hill.", "name": "MURRAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "What hill?", "name": "PRESTON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "There's no hill.", "name": "YASMIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "There's a hill.", "name": "MURRAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "The intercom crackles.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Gloria? Gloria, honey? It's Mrs. Featherstone from Pinecrest Elementary.", "name": "MRS. FEATHERSTONE", "speaker": 4, "ext": ["V.O."], "paren": ["intercom, crackling"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Good morning, Mrs. Featherstone.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": ["pressing the button"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "The bus is here. But the children aren't on it.", "name": "MRS. FEATHERSTONE", "speaker": 4, "ext": ["V.O."], "paren": ["intercom"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "A beat.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Wait, what?", "name": "PRESTON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Mrs. Featherstone, what do you mean the children aren't on it?", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "The bus is full of goats.", "name": "MRS. FEATHERSTONE", "speaker": 4, "ext": ["V.O."], "paren": ["intercom"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Murray lowers the paper.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "The hill.", "name": "MURRAY", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Who was driving bus nine?", "name": "YASMIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "All heads turn to Preston.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "I swear I didn't do it.", "name": "PRESTON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Preston, get your keys.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}