{"scene_id": "s01149", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01149.fountain", "heading": "INT. COUNTY COURTROOM - DAY", "cast": [{"id": 0, "name": "JUDGE HARGROVE", "names": ["JUDGE HARGROVE", "HARGROVE"], "gender": "f", "first": 4, "spoke": 13}, {"id": 1, "name": "ADEYEMI", "names": ["ADEYEMI"], "gender": "m", "first": 5, "spoke": 9}, {"id": 2, "name": "LINDGREN", "names": ["LINDGREN"], "gender": "?", "first": 6, "spoke": 6}, {"id": 3, "name": "BAILIFF CROWE", "names": ["BAILIFF CROWE", "CROWE"], "gender": "f", "first": 7, "spoke": 2}, {"id": 4, "name": "JUROR 7", "names": ["JUROR", "JUROR 7"], "gender": "f", "first": 8, "spoke": 3}, {"id": 5, "name": "DELACROIX", "names": ["DELACROIX"], "gender": "?", "first": 46, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. COUNTY COURTROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Wood-paneled, high ceilings, a flag in the corner.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A jury box to one side, a witness stand, a gavel mark scarred on the bench.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The gallery behind the rail is empty but for a few reporters.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "JUDGE HARGROVE (60s, black robe, half-moon glasses, a tired sort of kindness) presides.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "ADEYEMI (40s, defense counsel, charcoal suit, calm voice) stands at the defense table beside an empty chair.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "LINDGREN (30s, prosecutor, sharp blazer, a stack of exhibits) sits across the aisle.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "BAILIFF CROWE (50s, tan uniform, mustache) guards the jury door.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "In the jury box, JUROR 7 (50s, plum cardigan, a clutch bag on her knee) sits very still.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "We'll be back on the record. Ms. Lindgren, your next witness.", "name": "HARGROVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "The State rests, Your Honor.", "name": "LINDGREN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Your Honor, the defense moves for a directed verdict.", "name": "ADEYEMI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Denied. Call your first witness, Mr. Adeyemi.", "name": "HARGROVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "The defense calls the defendant.", "name": "ADEYEMI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "A murmur in the gallery.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Hargrove frowns.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Counsel, your client isn't present.", "name": "HARGROVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "He is, Your Honor. He's in the empty chair.", "name": "ADEYEMI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Lindgren half-rises.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Objection. Theatrics.", "name": "LINDGREN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "The defendant is mute by medical order, Your Honor. I'm asking the court's indulgence.", "name": "ADEYEMI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Approach.", "name": "HARGROVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Both lawyers step to the bench.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Hargrove lowers her voice, but it carries.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Mr. Adeyemi, you will not use an empty chair as a witness.", "name": "HARGROVE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Your Honor, my client is dead.", "name": "ADEYEMI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "A beat.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Lindgren stares at him.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "What?", "name": "LINDGREN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "He died in his cell on Sunday. I received the notice this morning.", "name": "ADEYEMI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "And you chose not to inform the court.", "name": "HARGROVE", "speaker": 0, "ext": [], "paren": ["slowly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "I'm informing the court now.", "name": "ADEYEMI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Hargrove takes off her glasses.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Pinches the bridge of her nose.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Bailiff Crowe. Clear the jury.", "name": "HARGROVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Yes, Your Honor.", "name": "CROWE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "The jurors rise.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Juror 7 doesn't.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Crowe stops beside her.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Ma'am. Time to go.", "name": "CROWE", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "I'd like to speak.", "name": "JUROR 7", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Juror, you will not.", "name": "HARGROVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Your Honor, I think you want to hear this.", "name": "JUROR 7", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "She stands.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "She opens her clutch bag.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "From inside she draws a folded sheet of paper and a small silver badge.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "I'm Special Agent Delacroix, Your Honor. I've been in that box for nine days.", "name": "JUROR 7", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "The room goes dead quiet.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "Lindgren drops her pen.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "Adeyemi closes his eyes.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "The defendant didn't die of natural causes. The man he's accused of killing is alive. And somebody in this courtroom has been feeding him information since Monday.", "name": "DELACROIX", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "Agent Delacroix, you are in contempt.", "name": "HARGROVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "I know.", "name": "DELACROIX", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "Do you have proof?", "name": "HARGROVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "Yes, Your Honor.", "name": "DELACROIX", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "She hands the paper to Crowe, who carries it to the bench.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "Hargrove reads it.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "Her face changes.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "dialogue", "text": "Ms. Lindgren.", "name": "HARGROVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "Your Honor?", "name": "LINDGREN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "Your signature is on this.", "name": "HARGROVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "dialogue", "text": "I want a lawyer.", "name": "LINDGREN", "speaker": 2, "ext": [], "paren": ["very quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "dialogue", "text": "Funny. So did my client.", "name": "ADEYEMI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "Crowe moves toward Lindgren.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "Lindgren grabs her exhibits, shoves them at Adeyemi, and bolts for the side door.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "Delacroix is faster.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "action", "text": "She crosses the well in three strides and catches Lindgren's wrist at the door.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "dialogue", "text": "Counselor, don't make this harder.", "name": "DELACROIX", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "dialogue", "text": "Let me go!", "name": "LINDGREN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "action", "text": "Hargrove brings down the gavel.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "action", "text": "Once.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "action", "text": "Twice.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "action", "text": "Three times.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "dialogue", "text": "This court is adjourned.", "name": "HARGROVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "action", "text": "She sets the gavel down.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 75, "kind": "action", "text": "Her hand shakes.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 76, "kind": "action", "text": "In the sudden silence, a reporter's pencil snaps.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 77, "kind": "dialogue", "text": "Finally.", "name": "ADEYEMI", "speaker": 1, "ext": [], "paren": ["sotto, to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}