{"scene_id": "s01150", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01150.fountain", "heading": "INT. PAWNSHOP - BACK OFFICE - NIGHT", "cast": [{"id": 0, "name": "DETECTIVE MALLORY", "names": ["DETECTIVE MALLORY", "MALLORY"], "gender": "m", "first": 5, "spoke": 18}, {"id": 1, "name": "VITO", "names": ["VITO"], "gender": "m", "first": 6, "spoke": 13}, {"id": 2, "name": "CHLOE", "names": ["CHLOE"], "gender": "?", "first": 7, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. PAWNSHOP - BACK OFFICE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A windowless room behind the counter.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A steel desk.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A wall of guitars.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A space heater ticks under the table.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DETECTIVE MALLORY (50s, rumpled sport coat, tired eyes) sits in the visitor's chair with a paper cup of coffee.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "VITO (60s, pawnbroker, leather vest, rings on every finger) leans back behind the desk, hands folded on his stomach.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "CHLOE (20s, Vito's niece, apron over a band T-shirt) stands by the guitar wall, rearranging the necks of two acoustics, her back to the room.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Vito, I'm not here about the Fender.", "name": "MALLORY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Good. Because the Fender's clean.", "name": "VITO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I'm not here about the watches either.", "name": "MALLORY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "The watches are also clean.", "name": "VITO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "I'm here about Eddie Cruz.", "name": "MALLORY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Never heard of him.", "name": "VITO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "He came in on the eleventh. Pawned a ring. Never came back.", "name": "MALLORY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "People forget their rings.", "name": "VITO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Not Eddie. Eddie loved that ring. It was his late wife's.", "name": "MALLORY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Vito shrugs.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Chloe turns a guitar peg, plinking a note.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Chloe. Was it you on the counter that night?", "name": "MALLORY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I work most nights.", "name": "CHLOE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Then you saw him.", "name": "MALLORY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "I see a lot of people.", "name": "CHLOE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Detective, the girl is nervous around police.", "name": "VITO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "I've noticed.", "name": "MALLORY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "He drinks his coffee.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Sets it on the desk.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Stretches his legs, comfortable, in no rush.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "You know, Vito, my mother had a pawnshop. Little place in Queens. Sold my father's trombone to pay for my First Communion.", "name": "MALLORY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Sad story.", "name": "VITO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "It wasn't sad. He hated that trombone.", "name": "MALLORY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "I like your mother.", "name": "VITO", "speaker": 1, "ext": [], "paren": ["smiling"], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "She'd like you. She'd also count the change.", "name": "MALLORY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Vito laughs.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Chloe even smiles.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "The tension in the room loosens.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Mallory leans forward and picks up a pawn ticket from the desk, turns it over.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Here's what I think. I think Eddie came in, you gave him two hundred dollars, and he went home. I think a week later, a man came in and bought that ring for four times what you paid.", "name": "MALLORY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "That's business.", "name": "VITO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "I think the man who bought it was the one Eddie owed money to. I think that man followed Eddie home. And I think when Eddie's body turns up in the canal, the ring will be on the other man's finger, and the other man will say he bought it at a pawnshop on Delancey.", "name": "MALLORY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "That's a story.", "name": "VITO", "speaker": 1, "ext": [], "paren": ["still smiling"], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "It's a good story. It needs a witness. It needs somebody who saw the man at the counter.", "name": "MALLORY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Chloe stops plinking.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "She turns, slowly, and Mallory finally looks at her.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Uncle Vito...", "name": "CHLOE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Chloe.", "name": "VITO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "He's going to find out.", "name": "CHLOE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Chloe, go to the front.", "name": "VITO", "speaker": 1, "ext": [], "paren": ["sharp"], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "I don't want to.", "name": "CHLOE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Vito stands.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "The ring on his finger glints.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "He reaches into his desk drawer, and from it draws a small, plain revolver.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Mallory doesn't flinch.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Vito, put it down.", "name": "MALLORY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "Not until the girl keeps quiet.", "name": "VITO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "She's not the one you're afraid of.", "name": "MALLORY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "Then who?", "name": "VITO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "The man at the counter that night. The one who bought the ring. His name is Sergeant Dobbs. He's my partner. He's standing outside the back door, and he's very, very patient.", "name": "MALLORY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "The back door opens.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "A cold draft.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "Vito's hand drops.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "Chloe lets out a sob.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "Mallory finishes his coffee in one swallow and rises.", "para": 7, "sent": 4, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "I told you I wasn't here about the Fender.", "name": "MALLORY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}]}