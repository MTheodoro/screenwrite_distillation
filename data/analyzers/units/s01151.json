"present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "DR. PRAKASH (50s, consultant, tweed jacket, tablet) stands quietly by the conference room.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "Good morning, team! Beautiful day to be productive!", "name": "SCOTT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Morning, Scott.", "name": "KENDRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Morning.", "name": "BARRY", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Good morning, Mr. Scott!", "name": "LEILANI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Leilani, it's just Scott.", "name": "SCOTT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Sorry, Mr. Just Scott.", "name": "LEILANI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Kendra snorts coffee.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Barry stifles a laugh.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Alright, alright. Dr. Prakash is here to help us transition into the exciting new Q3 optimization.", "name": "SCOTT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Good morning.", "name": "PRAKASH", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Is it an audit?", "name": "KENDRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "It's a transition.", "name": "SCOTT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Is it layoffs?", "name": "BARRY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "It's an opportunity!", "name": "SCOTT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Oh, I love opportunities.", "name": "LEILANI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Perhaps we begin in the conference room.", "name": "PRAKASH", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Great idea, Dr. P.", "name": "SCOTT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Hey, Kendra.", "name": "BARRY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Yeah?", "name": "KENDRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Do you have the Henderson file?", "name": "BARRY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 7]}, {"u": 29, "kind": "dialogue", "text": "You asked me yesterday.", "name": "KENDRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 7]}, {"u": 30, "kind": "dialogue", "text": "Right. But do you have it?", "name": "BARRY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 7]}, {"u": 31, "kind": "dialogue", "text": "It's in the shared drive.", "name": "KENDRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 7]}, {"u": 32, "kind": "dialogue", "text": "I have a binder on Henderson!", "name": "LEILANI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 7]}, {"u": 33, "kind": "dialogue", "text": "We don't need the Henderson file today.", "name": "^SCOTT", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "dialogue", "text": "Henderson is already resolved.", "name": "PRAKASH", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "dialogue", "text": "Wait, what?", "name": "KENDRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "action", "text": "They all stop.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "action", "text": "Prakash taps his tablet.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "action", "text": "The conference screen flickers, flashing a list of names.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "action", "text": "Under HENDERSON, a line: TERMINATED.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "dialogue", "text": "Terminated? He's on vacation.", "name": "BARRY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 41, "kind": "dialogue", "text": "He was. Henderson, Pruitt, Salazar, and Okoye.", "name": "PRAKASH", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 42, "kind": "dialogue", "text": "Dr. Prakash, we agreed to sequence the announcement.", "name": "SCOTT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 43, "kind": "dialogue", "text": "I'm sequencing it now.", "name": "PRAKASH", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 44, "kind": "dialogue", "text": "Barry, check your email.", "name": "KENDRA", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 45, "kind": "action", "text": "Barry opens a window.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 46, "kind": "action", "text": "His eyes go wide.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 47, "kind": "action", "text": "Kendra grabs her phone.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 48, "kind": "action", "text": "Leilani drops two binders.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 49, "kind": "dialogue", "text": "Is it bad?", "name": "LEILANI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 50, "kind": "dialogue", "text": "It's an opportunity!", "name": "SCOTT", "speaker": 4, "ext": [], "paren": ["brightly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 51, "kind": "action", "text": "Everyone looks at him.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 52, "kind": "action", "text": "He laughs, weakly, and tugs the zipper of his quarter-zip all the way up.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 53, "kind": "dialogue", "text": "Scott. Your name is on the list.", "name": "KENDRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 54, "kind": "dialogue", "text": "Is it?", "name": "SCOTT", "speaker": 4, "ext": [], "paren": ["a long beat"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 55, "kind": "dialogue", "text": "Number one.", "name": "BARRY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 56, "kind": "action", "text": "Scott looks at the screen.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 57, "kind": "action", "text": "He doesn't breathe.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 58, "kind": "action", "text": "Then, very slowly, he reaches for Barry's thermos and takes a long drink.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 59, "kind": "dialogue", "text": "This coffee is terrible.", "name": "SCOTT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 60, "kind": "dialogue", "text": "It's tea.", "name": "BARRY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}