{"scene_id": "s01154", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01154.fountain", "heading": "EXT. MOSS HOLLOW - ANCIENT OAK GROVE - DUSK", "cast": [{"id": 0, "name": "THORNE", "names": ["THORNE"], "gender": "m", "first": 4, "spoke": 4}, {"id": 1, "name": "ALDYTH", "names": ["ALDYTH"], "gender": "f", "first": 6, "spoke": 8}, {"id": 2, "name": "BRIAR", "names": ["BRIAR"], "gender": "m", "first": 9, "spoke": 3}, {"id": 3, "name": "MOSS", "names": ["MOSS"], "gender": "m", "first": 11, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. MOSS HOLLOW - ANCIENT OAK GROVE - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "Giant trees, roots like cathedral arches.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Lanterns glow in the branches.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The air hums with a low, living note.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "THORNE (50s, long coat of woven bark, staff taller than a man) stands at the center of a ring of toadstools.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He doesn't speak.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "ALDYTH (30s, silver circlet, riding leathers) steps out of the trees.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "She studies the ring.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She does not enter it.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "BRIAR (teen, barefoot, cloak of leaves) watches from a low branch, swinging his legs.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "He chews a blade of grass.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "MOSS (ageless, small, hooded, knotted like a root) sits on a boulder near the ring, hands folded.", "para": 4, "sent": 0, "present": [0, 1, 3]}, {"u": 12, "kind": "action", "text": "A single acorn rests in his palm.", "para": 4, "sent": 1, "present": [0, 1, 3]}, {"u": 13, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 3]}, {"u": 14, "kind": "action", "text": "A leaf drifts down.", "para": 5, "sent": 1, "present": [0, 1, 3]}, {"u": 15, "kind": "action", "text": "Thorne's eyes follow it.", "para": 5, "sent": 2, "present": [0, 1, 3]}, {"u": 16, "kind": "dialogue", "text": "You called.", "name": "ALDYTH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 17, "kind": "dialogue", "text": "I did.", "name": "THORNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 18, "kind": "dialogue", "text": "And?", "name": "ALDYTH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 19, "kind": "action", "text": "He lifts his staff and points.", "para": 6, "sent": 0, "present": [0, 1, 3]}, {"u": 20, "kind": "action", "text": "Across the grove, a beam of last sun falls on a gap in the roots, where something small and green is pushing up from the soil.", "para": 6, "sent": 1, "present": [0, 1, 3]}, {"u": 21, "kind": "action", "text": "She looks.", "para": 7, "sent": 0, "present": [0, 1, 3]}, {"u": 22, "kind": "action", "text": "Her jaw clenches.", "para": 7, "sent": 1, "present": [0, 1, 3]}, {"u": 23, "kind": "action", "text": "She looks away.", "para": 7, "sent": 2, "present": [0, 1, 3]}, {"u": 24, "kind": "dialogue", "text": "Is it a sapling?", "name": "BRIAR", "speaker": 2, "ext": [], "paren": ["from the branch"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Hush, boy.", "name": "THORNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "It's a sapling.", "name": "BRIAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Moss turns the acorn over in his fingers.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Aldyth steps forward at last, one foot into the ring.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "The toadstools tremble.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "The hum deepens.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "It's not possible.", "name": "ALDYTH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "It happened.", "name": "MOSS", "speaker": 3, "ext": [], "paren": ["dry as bark"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "The grove was salted.", "name": "ALDYTH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Salt wears.", "name": "MOSS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "She kneels by the shoot.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Her gloved fingers hover.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "She does not touch it.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "He planted it?", "name": "ALDYTH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "She did.", "name": "THORNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "When?", "name": "ALDYTH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "The night before the burning.", "name": "THORNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Aldyth closes her hand into a fist.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Rises, stiff.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "The hum shivers.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Briar drops from the branch and lands lightly in the moss.", "para": 10, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Does that mean you're staying?", "name": "BRIAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "She turns to him.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "For an instant her face softens.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Then it hardens again.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "It means the oath is broken.", "name": "ALDYTH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Or kept.", "name": "MOSS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Not by me.", "name": "ALDYTH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "She spins and strides away through the trunks.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "The lanterns bow as she passes.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Thorne lowers his staff.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Moss opens his palm and lets the acorn roll down onto the soil.", "para": 12, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Briar crouches by the sapling and holds a cupped hand over it, as if shielding a candle.", "para": 12, "sent": 4, "present": [0, 1, 2, 3]}]}