aker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "It's a service, ma'am. Free, until the end of the month.", "name": "DELIVERY MAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Leave it by the door.", "name": "CORRIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "He parks the dolly.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Basil sips from his thermos.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Duke lifts a sack, grunts.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Heavy day.", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Always is.", "name": "DUKE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "The Delivery Man glances at the truck, then at the clock.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "6:58.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Two minutes.", "name": "WINSTON", "speaker": 4, "ext": [], "paren": ["softly, to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Pardon?", "name": "CORRIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "I said, two minutes until my shift ends.", "name": "WINSTON", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "He tugs the bottom jug.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "A hidden latch clicks.", "para": 5, 