{"scene_id": "s01158", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01158.fountain", "heading": "INT. FISH PROCESSING PLANT - OFFICE - NIGHT", "cast": [{"id": 0, "name": "DETECTIVE RAFFERTY", "names": ["DETECTIVE RAFFERTY", "RAFFERTY"], "gender": "?", "first": 6, "spoke": 13}, {"id": 1, "name": "TULLY", "names": ["TULLY"], "gender": "?", "first": 6, "spoke": 9}, {"id": 2, "name": "HALVORSEN", "names": ["HALVORSEN"], "gender": "m", "first": 14, "spoke": 6}, {"id": 3, "name": "WOMAN", "names": ["WOMAN"], "gender": "f", "first": 38, "spoke": 0}, {"id": 4, "name": "AGENT CORVO", "names": ["AGENT CORVO", "CORVO"], "gender": "?", "first": 43, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. FISH PROCESSING PLANT - OFFICE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A glassed-in office above the processing floor.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Below, conveyor belts, hoses, steel tables slick with scales.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The office smells of brine and cigarettes.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A desk lamp.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A ledger.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "DETECTIVE RAFFERTY (40s, gray overcoat, a face like a closed door) sits across from TULLY (50s, plant owner, rubber apron over a silk shirt, gold chain, hands thick as hams).", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "On the wall, a mounted marlin with a dust-covered eye.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Between them: a plastic bag holding a small silver watch.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "You recognize it?", "name": "RAFFERTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Never seen it.", "name": "TULLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "It's engraved. \"To D, with love, M.\"", "name": "RAFFERTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Lots of D's in the world.", "name": "TULLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Lots of M's.", "name": "RAFFERTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "HALVORSEN (30s, plant foreman, hairnet, boots, scales on his forearms) leans on the doorframe, arms crossed.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "He doesn't enter.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Boss, you want me to stay?", "name": "HALVORSEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Go back to the floor.", "name": "TULLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Yes, sir.", "name": "HALVORSEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "He doesn't move.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Rafferty notices.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Mr. Halvorsen. Stay. I have a question for you.", "name": "RAFFERTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Boss?", "name": "HALVORSEN", "speaker": 2, "ext": [], "paren": ["to Tully"], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Answer him.", "name": "TULLY", "speaker": 1, "ext": [], "paren": ["tight"], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "The night shift on the eleventh. You were on?", "name": "RAFFERTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "I'm always on.", "name": "HALVORSEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "And you saw nothing unusual.", "name": "RAFFERTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Fish.", "name": "HALVORSEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Fish.", "name": "RAFFERTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "He turns to Tully, still polite.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Mr. Tully, I'll be straight with you. I've got a body in the harbor. Male. Late thirties. No wallet, no ring. This was in his hand.", "name": "RAFFERTY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Terrible.", "name": "TULLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "He had your cigarette brand in his teeth. He had fish scales under his nails. He had a chemical burn on his wrist that I'd say comes from a brine pump.", "name": "RAFFERTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "You're making it fit.", "name": "TULLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "I'm just listing it.", "name": "RAFFERTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "From below, a hiss of steam and a sudden clang.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Tully stiffens.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Halvorsen glances at the window.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "A WOMAN (50s, in a trench coat and rain hat, a briefcase in her hand) is walking across the floor toward the stairs.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Who the hell is that?", "name": "TULLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "No idea.", "name": "HALVORSEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "The Woman climbs.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "The office door opens without a knock.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "She sets her briefcase on the desk, opens it, and takes out a badge: AGENT CORVO, FEDERAL BUREAU.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Mr. Tully. I'd like to talk about the shipment of eleven tons of cocaine hidden in your tuna.", "name": "CORVO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Tully stands slowly.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Rafferty doesn't.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "He picks up the watch bag, studies the engraving, and slides it across the desk to Corvo.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Agent. He's all yours.", "name": "RAFFERTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "You told me she was a cop.", "name": "TULLY", "speaker": 1, "ext": [], "paren": ["hoarse"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "I did.", "name": "RAFFERTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "You said she was local.", "name": "TULLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "She is. She just works for a bigger office.", "name": "RAFFERTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Tully turns to the foreman.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "Halvorsen backs out of the doorway and takes the stairs two at a time.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Down on the floor, the belts keep running.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}]}