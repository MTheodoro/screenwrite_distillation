{"scene_id": "s01159", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01159.fountain", "heading": "INT. DIAMOND MERCHANT'S BOARDROOM - NIGHT", "cast": [{"id": 0, "name": "JEWELER", "names": ["JEWELER"], "gender": "?", "first": 5, "spoke": 3}, {"id": 1, "name": "FLORENCE", "names": ["FLORENCE"], "gender": "?", "first": 6, "spoke": 16}, {"id": 2, "name": "NICO", "names": ["NICO"], "gender": "?", "first": 6, "spoke": 5}, {"id": 3, "name": "ABRAHAM", "names": ["ABRAHAM"], "gender": "?", "first": 13, "spoke": 16}], "units": [{"u": 0, "kind": "heading", "text": "INT. DIAMOND MERCHANT'S BOARDROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Walnut paneling, a table the length of a hearse, a single green-shaded lamp.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rain on tall windows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Under the lamp, a velvet cloth.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "On it, a diamond the size of a plum.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A JEWELER (70s, loupe on a ribbon, trembling hands, an immaculate black suit) stands behind the table, polishing the stone with a chamois.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across from him sit FLORENCE (40s, severe bob, gray gloves, black coat buttoned to the throat) and NICO (30s, hoodie under a blazer, a nervous habit of rolling a ring on his thumb).", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "The Jeweler lifts the stone.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Light cuts through it, throws a rainbow onto the wall, and for a moment the room is a cathedral.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Three hundred and eleven carats. Rough, it weighed six hundred.", "name": "JEWELER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "A good cut.", "name": "FLORENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "A good cut is the difference between a stone and a legend.", "name": "JEWELER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "It's beautiful, Mr. Silverman.", "name": "NICO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Abraham. Please. Nobody has called me Mr. Silverman since my wife died.", "name": "JEWELER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Abraham, then. Shall we discuss the price?", "name": "FLORENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Of course.", "name": "ABRAHAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "He sets the diamond back on its cloth.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "He sits.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "His hands, which had trembled, are now perfectly still.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "My understanding is that you represent a buyer in Antwerp.", "name": "ABRAHAM", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "We represent several.", "name": "FLORENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "But only one with the money.", "name": "ABRAHAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "The buyer will pay fifty million, in escrow, on delivery.", "name": "FLORENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Delivery where?", "name": "ABRAHAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Where you specify.", "name": "FLORENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Here.", "name": "ABRAHAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Here?", "name": "NICO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Here. This room. Tonight.", "name": "ABRAHAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Nico glances at Florence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Florence doesn't move.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "That wasn't the arrangement.", "name": "FLORENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "The arrangement has changed. I find, in my old age, that I enjoy having my business conducted in a room I trust.", "name": "ABRAHAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Mr. Silverman...", "name": "FLORENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Abraham.", "name": "ABRAHAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Abraham. We are trying to be reasonable.", "name": "FLORENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "So am I. I am sixty-nine years old. I have outlived two wives and three partners. I know what a man looks like when he is about to rob me.", "name": "ABRAHAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Nico stops rolling the ring.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Florence tilts her head, an inch, no more.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "And do I look like a man?", "name": "FLORENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "You look like someone who has read the floor plan.", "name": "ABRAHAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Florence.", "name": "NICO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Quiet.", "name": "FLORENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Please. I would hate to be rude. But you will notice that the lamp is the only light in the room.", "name": "ABRAHAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Florence looks up.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "The windows have gone dark.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "The curtains are drawn.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "At the door, a soft click: the deadbolt.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Nico, may I call you Nico?", "name": "ABRAHAM", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Yes.", "name": "NICO", "speaker": 2, "ext": [], "paren": ["thin"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "You have a very nice face. I would hate for it to be on the news.", "name": "ABRAHAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Nico stands.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "His chair scrapes.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Florence puts a hand on his arm, firm.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Sit.", "name": "FLORENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "He knows.", "name": "NICO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Of course he knows. He's known since Tuesday.", "name": "FLORENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "She turns to Abraham.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "For the first time, she smiles.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "So tell me, Abraham. What do you want?", "name": "FLORENCE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "Thirty percent.", "name": "ABRAHAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "Of what?", "name": "FLORENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "Of whatever you were going to take.", "name": "ABRAHAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "A long beat.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "Florence peels off one glove, finger by finger.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "Lays it on the velvet beside the diamond.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "Twenty.", "name": "FLORENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "Twenty-five, and I stay out of the photograph.", "name": "ABRAHAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "Done.", "name": "FLORENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "She extends her bare hand.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "Abraham takes it.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "The lamp flickers, and the stone throws its rainbow across all three of them.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}]}