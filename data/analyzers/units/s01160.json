{"scene_id": "s01160", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01160.fountain", "heading": "INT. OBSERVATORY - DOME ROOM - NIGHT", "cast": [{"id": 0, "name": "PROFESSOR ELLWOOD", "names": ["PROFESSOR ELLWOOD", "ELLWOOD"], "gender": "?", "first": 5, "spoke": 20}, {"id": 1, "name": "VELMA", "names": ["VELMA"], "gender": "?", "first": 14, "spoke": 16}], "units": [{"u": 0, "kind": "heading", "text": "INT. OBSERVATORY - DOME ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A round chamber of brass and iron.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A huge telescope tilts toward a slit in the dome.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Charts pinned to the walls.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A cold teapot on a drafting table.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "PROFESSOR ELLWOOD (60s, cardigan, ink-stained fingers) bends over a ledger, writing in small, careful figures.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "He hums.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "The floor creaks on the stair.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "He doesn't look up.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "dialogue", "text": "Third night running.", "name": "ELLWOOD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 10, "kind": "action", "text": "Nobody answers.", "para": 3, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "He turns a page.", "para": 3, "sent": 1, "present": [0]}, {"u": 12, "kind": "dialogue", "text": "You needn't hover. If you've come about the missing plates, they're in the cabinet.", "name": "ELLWOOD", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 13, "kind": "action", "text": "A hand appears on the railing.", "para": 4, "sent": 0, "present": [0]}, {"u": 14, "kind": "action", "text": "VELMA (30s, long coat, a thin leather satchel, hair damp from the rain) steps into the lamplight.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Professor Ellwood?", "name": "VELMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "That depends on who's asking.", "name": "ELLWOOD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Velma Tran. From the Royal Society.", "name": "VELMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Ah.", "name": "ELLWOOD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He caps his pen.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Rises.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Smooths his cardigan.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "You're early.", "name": "ELLWOOD", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "You were expecting me?", "name": "VELMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "I was expecting someone. They always send a young person to deliver bad news.", "name": "ELLWOOD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I'm not here to deliver bad news.", "name": "VELMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "No?", "name": "ELLWOOD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "I'm here about the comet.", "name": "VELMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Ellwood pauses.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "He crosses to the telescope and runs a hand along its brass flank.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Which comet?", "name": "ELLWOOD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "The one you didn't report.", "name": "VELMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "I report everything.", "name": "ELLWOOD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Not this one.", "name": "VELMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "She opens the satchel and lays three photographic plates on the drafting table beside the teapot.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Ellwood doesn't look at them.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Those plates were stolen.", "name": "ELLWOOD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "They were mailed to us anonymously.", "name": "VELMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "By whom?", "name": "ELLWOOD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "We were hoping you could tell us.", "name": "VELMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Ellwood chuckles softly and sits on the edge of the table.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Miss Tran, I have been observing this sky for forty years. I have discovered two comets, one nova, and a rather embarrassing asteroid that turned out to be a pigeon.", "name": "ELLWOOD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "That's a long career.", "name": "VELMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "It has been a quiet one.", "name": "ELLWOOD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Until August.", "name": "VELMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Until August.", "name": "ELLWOOD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "He picks up the nearest plate and holds it to the lamp.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "A tiny streak crosses the black field.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "It was moving the wrong way.", "name": "ELLWOOD", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Yes.", "name": "VELMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Against everything we know about orbits.", "name": "ELLWOOD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Yes.", "name": "VELMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "So I assumed my instruments were broken.", "name": "ELLWOOD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "Were they?", "name": "VELMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "No.", "name": "ELLWOOD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "He places the plate down.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "Looks at her for a long time.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "Would you like tea?", "name": "ELLWOOD", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "Is it hot?", "name": "VELMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "It is not. But it is traditional.", "name": "ELLWOOD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "Velma laughs, a short surprised sound.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "She takes off her damp coat and sets it on the chair.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "Yes, Professor. I would.", "name": "VELMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}