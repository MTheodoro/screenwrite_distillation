{"scene_id": "s01161", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01161.fountain", "heading": "INT. CANDLELIT SALON - NIGHT - 1789", "cast": [{"id": 0, "name": "CAPTAIN LUCIEN", "names": ["CAPTAIN LUCIEN", "LUCIEN"], "gender": "f", "first": 4, "spoke": 3}, {"id": 1, "name": "SERGEANT ROQUE", "names": ["SERGEANT ROQUE", "ROQUE"], "gender": "f", "first": 5, "spoke": 2}, {"id": 2, "name": "MADAME OUDIN", "names": ["MADAME OUDIN"], "gender": "?", "first": 6, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. CANDLELIT SALON - NIGHT - 1789", "present": []}, {"u": 1, "kind": "action", "text": "Red velvet, gilt mirrors, a card table scattered with coins.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A door ajar to a dark corridor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Outside, a mob's murmur rises like surf.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CAPTAIN LUCIEN (30s, powdered wig, frayed uniform) holds a rapier.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across the table stands SERGEANT ROQUE (40s, scarred cheek, soldier's pistol).", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Between them, trembling under a lace shawl, MADAME OUDIN (60s, rouged, jeweled fingers) clings to the back of a chair.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "They freeze.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "All three.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Candle flames waver.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Roque. Lower it.", "name": "LUCIEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Not till he drops the blade.", "name": "ROQUE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "He won't.", "name": "LUCIEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Then neither will I.", "name": "ROQUE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Madame Oudin lets out a thin whimper.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "The mob outside surges.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "A bottle shatters against the shutters.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Madame, behind me.", "name": "LUCIEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "She scrambles to him.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Roque tracks her with the pistol.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Lucien shifts the rapier a hair, covering her.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Roque advances one step.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Lucien retreats, shoving the table.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Coins ring on the floor.", "para": 4, "sent": 5, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "They lunge together.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Steel meets steel and clashes against the pistol barrel.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "A shot cracks.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "The mirror shatters.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "All three flinch.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Smoke drifts.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "No one has fallen.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Oh, my.", "name": "MADAME OUDIN", "speaker": 2, "ext": [], "paren": ["a whisper"], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "In the corridor, boots pound closer.", "para": 7, "sent": 0, "present": [0, 1, 2]}]}