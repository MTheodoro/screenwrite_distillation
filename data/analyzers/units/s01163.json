{"scene_id": "s01163", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01163.fountain", "heading": "INT. EMERGENCY ROOM - TRAUMA BAY ONE - NIGHT", "cast": [{"id": 0, "name": "AGNES FALK", "names": ["AGNES FALK", "FALK"], "gender": "f", "first": 4, "spoke": 7}, {"id": 1, "name": "NURSE DESHAWN", "names": ["NURSE DESHAWN", "DESHAWN"], "gender": "?", "first": 5, "spoke": 3}, {"id": 2, "name": "PARAMEDIC LU", "names": ["PARAMEDIC LU", "LU"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "RESIDENT OTTO", "names": ["RESIDENT OTTO", "OTTO"], "gender": "m", "first": 7, "spoke": 2}, {"id": 4, "name": "BELLWEATHER", "names": ["BELLWEATHER"], "gender": "?", "first": 8, "spoke": 1}, {"id": 5, "name": "ASHFORD", "names": ["ASHFORD"], "gender": "m", "first": 33, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. EMERGENCY ROOM - TRAUMA BAY ONE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Harsh light.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Beeping monitors.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A gurney in the center, a man under a blood-soaked sheet.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. AGNES FALK (40s, scrubs, loupes pushed up on her head) cuts away a sleeve.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "NURSE DESHAWN (30s, gloves to the elbow) hangs a bag of saline.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "PARAMEDIC LU (30s, vest, radio on shoulder) pumps the chest.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "RESIDENT OTTO (20s, pale, shaking) fumbles with a central line kit.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "The patient, MR. BELLWEATHER (70s, gray stubble, oxygen mask), gasps.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Pressure?", "name": "FALK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Seventy over forty.", "name": "DESHAWN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Otto, line.", "name": "FALK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Yes, Doctor. Trying.", "name": "OTTO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Try faster.", "name": "FALK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Sinus tach. He's crashing.", "name": "LU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Don't... let me...", "name": "BELLWEATHER", "speaker": 4, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Stay with us, Mr. Bellweather.", "name": "FALK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Alarm.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "The monitor flatlines.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Lu's hands lock on the chest.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Falk grabs the paddles.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Charge to two hundred. Clear.", "name": "FALK", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Everyone steps back.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "The body jolts.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "The line wobbles.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Wobbles.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Steadies.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "We have a rhythm.", "name": "DESHAWN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Oh, thank God.", "name": "OTTO", "speaker": 3, "ext": [], "paren": ["exhaling"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Doctor, he's coding again.", "name": "LU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Again.", "name": "FALK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Another jolt.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "The curtain parts.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "DR. ASHFORD (50s, silver hair, a surgeon's cap, calm as ice) steps in, tying a mask behind his head.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "I'll take over, Dr. Falk.", "name": "ASHFORD", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Dr. Ashford? He's mine.", "name": "FALK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Not anymore. Otto, step aside.", "name": "ASHFORD", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Otto drops the line kit and flattens himself against the wall.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Ashford takes the paddles from Falk with a gentle but absolute hand.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Charge three-sixty.", "name": "ASHFORD", "speaker": 5, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Charged.", "name": "DESHAWN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Clear.", "name": "ASHFORD", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "The body arches.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "The monitor sings.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Falk lets out a breath, and for the first time looks at her own trembling hands.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}