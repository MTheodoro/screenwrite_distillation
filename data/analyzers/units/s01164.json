{"scene_id": "s01164", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01164.fountain", "heading": "INT. CORPORATE EXECUTIVE SUITE - BOARDROOM - DAY", "cast": [{"id": 0, "name": "DIRECTOR PENROSE", "names": ["DIRECTOR PENROSE", "PENROSE"], "gender": "m", "first": 5, "spoke": 11}, {"id": 1, "name": "WALDO", "names": ["WALDO"], "gender": "m", "first": 6, "spoke": 6}, {"id": 2, "name": "SADIE", "names": ["SADIE"], "gender": "m", "first": 7, "spoke": 1}, {"id": 3, "name": "GREER", "names": ["GREER"], "gender": "f", "first": 8, "spoke": 3}, {"id": 4, "name": "CFO", "names": ["CFO"], "gender": "?", "first": 8, "spoke": 0}, {"id": 5, "name": "TAMARA", "names": ["TAMARA"], "gender": "?", "first": 11, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. CORPORATE EXECUTIVE SUITE - BOARDROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A polished glass table.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Leather chairs.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A panoramic window onto a gray skyline.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "In the corner, a speakerphone the size of a pie.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DIRECTOR PENROSE (60s, silver suit, rimless glasses) sits at the head of the table, hands steepled.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "WALDO (40s, VP of Synergy, pastel tie) shuffles papers to his right.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "SADIE (20s, intern, a cheap blazer) stands behind him holding a tray of lukewarm coffees.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "GREER (50s, CFO, pearl necklace) sits to Penrose's left, perfectly still.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "A sleek black speakerphone on the table glows green.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "A woman's voice, crisp and flat, emerges.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Mr. Penrose, I have the board on line two.", "name": "TAMARA", "speaker": 5, "ext": ["V.O."], "paren": ["speakerphone"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Hold them, Tamara.", "name": "PENROSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "They said it's urgent.", "name": "TAMARA", "speaker": 5, "ext": ["V.O."], "paren": ["speakerphone"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Everything is urgent. Hold them.", "name": "PENROSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Yes, sir.", "name": "TAMARA", "speaker": 5, "ext": ["V.O."], "paren": ["speakerphone"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Waldo smiles at Greer.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Greer does not smile back.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Sadie slides a coffee in front of Penrose.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "He doesn't touch it.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Director, I believe we're all aligned on the quarterly...", "name": "WALDO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Waldo.", "name": "PENROSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Yes?", "name": "WALDO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Are the numbers real?", "name": "PENROSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "They're, uh... aspirational.", "name": "WALDO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Greer?", "name": "PENROSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "They're numbers.", "name": "GREER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Penrose lifts the coffee.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Sniffs.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Sets it back down.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Sadie stands rigid.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Beads of sweat form at Waldo's hairline.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Mr. Penrose, line two is insisting.", "name": "TAMARA", "speaker": 5, "ext": ["V.O."], "paren": ["speakerphone"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Put them through.", "name": "PENROSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "A click.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "A burst of voices.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "The speakerphone lights red.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Greer closes her folder.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Waldo tugs at his pastel tie.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Good morning, gentlemen.", "name": "PENROSE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Penrose rises, walks to the window, hands behind his back.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "He stares out at the skyline.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Behind him, Waldo whispers something to Sadie.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Sadie nods too fast.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Get me a glass of water.", "name": "WALDO", "speaker": 1, "ext": [], "paren": ["low, to Sadie"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "There's coffee.", "name": "SADIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Water. Now.", "name": "WALDO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "She hurries out.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "The door closes.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "The speakerphone drones on, a muffled crowd of men reading numbers aloud.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "Director.", "name": "GREER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "Yes, Greer.", "name": "PENROSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "Whatever you intend to do, do it before the lunch hour.", "name": "GREER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "Penrose turns from the window.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "For the first time, he smiles.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "Waldo. Come here.", "name": "PENROSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "Waldo stands.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "His knees pop.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "He walks around the table, unsteady, to the window.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "Penrose puts a hand on his shoulder and points down at the street, thirty floors below.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "Look at them.", "name": "PENROSE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "dialogue", "text": "At... the pedestrians?", "name": "WALDO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "dialogue", "text": "That is what real numbers look like.", "name": "PENROSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "Waldo stares.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "Greer folds her hands.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "On the speakerphone, someone coughs, and the voices stop.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "action", "text": "The whole room hangs.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "action", "text": "Penrose lifts his hand from Waldo's shoulder, and presses a button on the wall.", "para": 10, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "action", "text": "The glass table slowly begins to tilt.", "para": 10, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}]}