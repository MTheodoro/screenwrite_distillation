{"scene_id": "s01165", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01165.fountain", "heading": "INT. INSURANCE CLAIMS DEPARTMENT - NIGHT", "cast": [{"id": 0, "name": "NEW HIRE", "names": ["NEW HIRE"], "gender": "m", "first": 5, "spoke": 6}, {"id": 1, "name": "BERNADETTE", "names": ["BERNADETTE"], "gender": "f", "first": 6, "spoke": 18}, {"id": 2, "name": "FELIX", "names": ["FELIX"], "gender": "m", "first": 24, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. INSURANCE CLAIMS DEPARTMENT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Rows of gray cubicles stretching into dimness.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single bank of fluorescents hums over the far corner.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The rest of the floor is dark, the monitors asleep.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain streaks the windows.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A NEW HIRE (20s, brand-new lanyard, stiff shirt, a cardboard box of personal items still taped shut) stands at a cubicle entrance, reading a laminated card.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "BERNADETTE (50s, cardigan, headset around her neck, the posture of someone who has sat in the same chair for twenty-five years) rolls out of the next cubicle on her wheeled chair, startling him.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "You're the new one.", "name": "BERNADETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Yes, ma'am. I start tomorrow. They said to come and see the desk.", "name": "NEW HIRE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "It's eleven o'clock at night.", "name": "BERNADETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I couldn't sleep.", "name": "NEW HIRE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Nobody does, the first week.", "name": "BERNADETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She turns on a small desk lamp.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "The pool of light shows a photograph of two children pinned to the cubicle wall, edges curled and sun-bleached.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "The New Hire sets his box on the desk.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Is this mine?", "name": "NEW HIRE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "It was Harold's.", "name": "BERNADETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "What happened to Harold?", "name": "NEW HIRE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "He retired.", "name": "BERNADETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "That's nice.", "name": "NEW HIRE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "He didn't mean to.", "name": "BERNADETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "The New Hire's smile falters.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Bernadette picks at the arm of her chair.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "What's your name, dear?", "name": "BERNADETTE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Felix.", "name": "NEW HIRE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Felix. That's a good name. Lucky.", "name": "BERNADETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "I've never felt lucky.", "name": "FELIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "That's how you know it's working.", "name": "BERNADETTE", "speaker": 1, "ext": [], "paren": ["a thin smile"], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "She rolls to the window.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Looks at the rain.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Behind her, Felix opens the box.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "He takes out a small cactus in a clay pot, sets it on the desk.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Then a framed diploma.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "He hangs it, crookedly, on the cubicle wall.", "para": 5, "sent": 5, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Do you know what we do here?", "name": "BERNADETTE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Claims. Processing claims.", "name": "FELIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "We say no, Felix. That's what we do. We find the reason, and we say no.", "name": "BERNADETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "They told me we help people.", "name": "FELIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "We help people feel they've been heard.", "name": "BERNADETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Felix straightens the diploma.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "It tilts again.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "He leaves it.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "He sits in the chair and gives it a small experimental spin.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Is it hard?", "name": "FELIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "The first year, yes. After that you get a callus.", "name": "BERNADETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "On what?", "name": "FELIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Wherever it hurts.", "name": "BERNADETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "A long pause.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "The rain eases.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Felix looks at the photograph of the two children.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Is that Harold's family?", "name": "FELIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "It's mine.", "name": "BERNADETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Oh. I'm sorry. I thought...", "name": "FELIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "It's all right. They're grown. They don't call.", "name": "BERNADETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "She wheels back toward her cubicle, stops at the entrance, and looks over her shoulder.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "Felix. If you decide to leave, don't wait twenty-five years. Leave in the first week.", "name": "BERNADETTE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "Is that advice?", "name": "FELIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "It's a courtesy.", "name": "BERNADETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "She goes.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Felix sits in the dim lamplight, the cactus at his elbow, the diploma crooked above him.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "In the next cubicle, a kettle clicks on.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "He doesn't move for a long time.", "para": 9, "sent": 3, "present": [0, 1, 2]}]}