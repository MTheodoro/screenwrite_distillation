{"scene_id": "s01166", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01166.fountain", "heading": "EXT. FROZEN LAKE - NIGHT", "cast": [{"id": 0, "name": "WOMAN", "names": ["WOMAN"], "gender": "f", "first": 4, "spoke": 12}, {"id": 1, "name": "CALEB", "names": ["CALEB"], "gender": "?", "first": 6, "spoke": 17}, {"id": 2, "name": "INES", "names": ["INES"], "gender": "m", "first": 59, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FROZEN LAKE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Starlight on black ice.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A hundred yards of nothing in every direction.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wind drags snow in low serpents across the surface.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A WOMAN (30s, hooded parka, ice axe in one fist, a rucksack on her back) crosses the lake, stepping with care, testing each footfall.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her breath fogs the air.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Fifty yards behind her, CALEB (30s, bare-headed, no gloves, a blue lip) staggers after, one arm hugging his chest.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Wait!", "name": "CALEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She stops.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Turns.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Doesn't answer.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Please. I can't feel my feet.", "name": "CALEB", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Then walk faster.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He stumbles closer.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She plants the ice axe and waits, wary.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "You're the first person I've seen in two days.", "name": "CALEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "You're lucky it was me.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Why?", "name": "CALEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "The last one I saw tried to take my pack.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Caleb stops six feet away.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "He raises both hands, palms open, shaking.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "I'm not going to rob you. I'm going to die if you don't help me.", "name": "CALEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "That's two different problems.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Do you have anything to drink?", "name": "CALEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She hesitates.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Then unslings her pack, pulls out a flask, and tosses it across the gap.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "He catches it, fumbles, drops it, and picks it up again in clumsy fingers.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "He drinks.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Coughs.", "para": 6, "sent": 4, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Drinks.", "para": 6, "sent": 5, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "God. What is that?", "name": "CALEB", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Schnapps.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "It's wonderful.", "name": "CALEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "It's terrible. But it's warm.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "He lowers the flask, wipes his mouth on his sleeve.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Hands it back.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "My name's Caleb. Caleb Hurley.", "name": "CALEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "I didn't ask.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "I'm telling you anyway. In case.", "name": "CALEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "In case of what?", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "In case somebody finds me.", "name": "CALEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "She studies him a moment.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "The wind bites.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Somewhere out on the ice, a deep crack booms, and both of them flinch.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "The surface shifts beneath their feet.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Don't move.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": ["sharp"], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "I'm not.", "name": "CALEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "Spread your weight. Lie flat.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "He drops to his belly, then spreads his arms.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "She does the same, ten feet away, sliding the axe out in front of her.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "The crack booms again, longer.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "Water seeps up along a seam between them.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Is it going?", "name": "CALEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "It might.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "Say something.", "name": "CALEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "What?", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "Anything. Your name.", "name": "CALEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "A pause.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "The ice groans.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "Ines.", "name": "INES", "speaker": 2, "ext": [], "paren": ["finally"], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "Ines. That's pretty.", "name": "CALEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Shut up and crawl.", "name": "INES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "They begin to inch toward the far shore, side by side, hauling themselves along on their elbows.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "The seam spreads behind them, black water racing across the white.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "Ines glances at it and doesn't stop.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "Caleb laughs, a cracked giggle born of terror.", "para": 11, "sent": 3, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "Ines! We're going to make it!", "name": "CALEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "dialogue", "text": "Don't say that.", "name": "INES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "They reach the shallows.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "The ice thickens.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "She hauls him up by the collar, and they stand, panting, on solid ground at the edge of a pine forest.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 71, "kind": "action", "text": "Behind them, with a sound like a slow gunshot, the whole sheet they crossed splits and sinks.", "para": 12, "sent": 3, "present": [0, 1, 2]}, {"u": 72, "kind": "action", "text": "Caleb stares.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 73, "kind": "action", "text": "Ines hands him the flask again.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 74, "kind": "action", "text": "He takes it, drinks, and passes it back.", "para": 13, "sent": 2, "present": [0, 1, 2]}, {"u": 75, "kind": "action", "text": "Neither speaks.", "para": 13, "sent": 3, "present": [0, 1, 2]}, {"u": 76, "kind": "action", "text": "They stand there, steaming, listening to the lake fall quiet.", "para": 13, "sent": 4, "present": [0, 1, 2]}]}