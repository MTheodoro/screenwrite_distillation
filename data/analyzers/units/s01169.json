{"scene_id": "s01169", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01169.fountain", "heading": "INT. ELEVATOR - NIGHT", "cast": [{"id": 0, "name": "HECTOR", "names": ["HECTOR"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "BEA", "names": ["BEA"], "gender": "f", "first": 5, "spoke": 3}, {"id": 2, "name": "^BEA", "names": ["^BEA"], "gender": "?", "first": 19, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. ELEVATOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped steel box.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Muzak.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Floor numbers blinking: 14, 13, 12.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "HECTOR (30s, wrinkled suit, a cake box balanced on one palm) leans in the corner, humming.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "BEA (30s, hospital badge, tote bag, a bouquet of sunflowers) stands near the doors, checking her phone.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Floor 11.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "The lights flicker.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "The elevator jerks to a halt.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Oh no.", "name": "HECTOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "No no no no.", "name": "BEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Both lunge for the panel.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Their hands collide on the emergency button.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "They