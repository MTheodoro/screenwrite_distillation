{"scene_id": "s01170", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01170.fountain", "heading": "INT. DEFUNCT PLANETARIUM - DOME CHAMBER - NIGHT", "cast": [{"id": 0, "name": "INES MARCHETTI", "names": ["INES MARCHETTI", "INES"], "gender": "f", "first": 3, "spoke": 5}, {"id": 1, "name": "TOBY WREN", "names": ["TOBY WREN", "TOBY"], "gender": "?", "first": 4, "spoke": 2}, {"id": 2, "name": "KOFI ADEYEMI-BELL", "names": ["KOFI ADEYEMI-BELL", "KOFI"], "gender": "?", "first": 5, "spoke": 2}, {"id": 3, "name": "RADIO", "names": ["RADIO"], "gender": "?", "first": 12, "spoke": 0}, {"id": 4, "name": "NIGHT GUARD", "names": ["NIGHT GUARD"], "gender": "?", "first": 13, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. DEFUNCT PLANETARIUM - DOME CHAMBER - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dust hangs in a single flashlight beam.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A cracked star projector squats at the center like a dead insect.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "INES MARCHETTI (30s, lean, gloved) kneels at the projector's base, a drill whining in her hands.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "TOBY WREN (20s, nervous, oversized hoodie) holds the light and keeps glancing at the exit.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "KOFI ADEYEMI-BELL (50s, broad, patient) feeds cable from a spool through a panel in the floor.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Hold it still.", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "I am holding it still.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "You're holding it like a wet cat.", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "The drill bites through.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "A brass plate drops and rings across the floor.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "All three freeze.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "A RADIO crackles on Kofi's belt.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Dome's quiet. Any of you hear that?", "name": "NIGHT GUARD", "speaker": 4, "ext": ["V.O."], "paren": ["over radio, bored"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Kofi thumbs the key slowly.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Pipes. Same as every night.", "name": "KOFI", "speaker": 2, "ext": [], "paren": ["into radio, flat"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Copy. Pipes.", "name": "NIGHT GUARD", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Kofi releases the key.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Toby exhales.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Ines does not look up.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Cable.", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Kofi passes the cable.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Ines threads it into the hole, seats the connector, and the projector's casing opens with a sigh.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Inside, wrapped in velvet, a silver sphere the size of a grapefruit.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "That's it?", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "That's it.", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Toby reaches.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Ines slaps his wrist.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Boots echo in the corridor outside.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "The three of them kill the light and drop flat behind the projector.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Kofi pulls the velvet over the sphere with one hand and presses Toby's head down with the other.", "para": 7, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Dome, this is Marsh. I'm at the door.", "name": "NIGHT GUARD", "speaker": 4, "ext": ["V.O."], "paren": ["over radio, closer"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "The door handle turns.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Ines slides a blade from her sleeve.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Toby grabs Kofi's sleeve.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Kofi quietly lifts a fire extinguisher off the floor, and the three of them hold their breath as the door swings inward half a foot, a wedge of hallway light cutting across the carpet and stopping inches from Ines's boot.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Pipes.", "name": "NIGHT GUARD", "speaker": 4, "ext": ["V.O."], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "The door closes.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Footsteps fade.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Ninety seconds. Then we move.", "name": "KOFI", "speaker": 2, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Sixty.", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "They scatter toward the loading dock, the sphere gone, the dome black.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}]}