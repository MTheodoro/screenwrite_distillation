{"scene_id": "s01173", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01173.fountain", "heading": "INT. SHUTTERED ROLLER RINK - NIGHT", "cast": [{"id": 0, "name": "ROSALIND ABARA", "names": ["ROSALIND ABARA", "ROSALIND"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "CASPIAN ABARA", "names": ["CASPIAN ABARA", "CASPIAN"], "gender": "?", "first": 4, "spoke": 3}, {"id": 2, "name": "PERPETUA", "names": ["PERPETUA"], "gender": "f", "first": 6, "spoke": 1}, {"id": 3, "name": "HAKON", "names": ["HAKON"], "gender": "?", "first": 7, "spoke": 1}, {"id": 4, "name": "JUNE", "names": ["JUNE"], "gender": "f", "first": 8, "spoke": 2}, {"id": 5, "name": "OLU", "names": ["OLU"], "gender": "?", "first": 9, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. SHUTTERED ROLLER RINK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Disco ball dark.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rental skates hang in rows on the wall.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A buffet of foil trays sits on the skate counter, untouched.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ROSALIND ABARA (40s, black dress, shoes in her hand) stands at the edge of the rink floor.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "CASPIAN ABARA (40s, rumpled suit) sits on the bench lacing a pair of rental skates.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "PERPETUA (70s, church hat) watches from a plastic chair.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "HAKON (30s, borrowed tie) stands very straight by the jukebox.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "JUNE (20s, ripped tights) leans on the counter, scrolling.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "OLU (10) crouches beside the skate rack, counting wheels.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "She sets the shoes down.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "He doesn't look up.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "You're not serious.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "He wanted music.", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "He wanted a hymn.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "He finishes the knot.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Stands.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Wobbles.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Nobody helps.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Let him.", "name": "PERPETUA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Hakon feeds a coin into the jukebox.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "It coughs.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "A faint organ riff leaks out.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "June looks up from her phone.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Olu stops counting.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "That's not a hymn.", "name": "JUNE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "It was on his list.", "name": "HAKON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "She crosses to the jukebox and reads the label.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Her jaw sets.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "She walks back and takes the phone from June's hand, locks it, and puts it in her own pocket.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Hey.", "name": "JUNE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Not tonight.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "He rolls out onto the floor, arms out, one wheel dragging.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "The sound fills the hall.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Olu hurries over and holds the rail.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Perpetua grips the arm of her chair.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Hakon turns the volume up.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Come on.", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": ["over the music"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "No.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Come on.", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "She stares at the floor, at the scuffed centre circle.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Then she steps onto it in stocking feet.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "He takes her hand.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "They go round once, awkward, slow.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Behind them Perpetua stands.", "para": 7, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "June finally laughs, one sharp note, and covers her mouth.", "para": 7, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}]}