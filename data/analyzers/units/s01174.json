{"scene_id": "s01174", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01174.fountain", "heading": "INT. FLOODED TERRACE BUNKER - NIGHT", "cast": [{"id": 0, "name": "TAMSIN BRIGG", "names": ["TAMSIN BRIGG", "BRIGG"], "gender": "?", "first": 4, "spoke": 3}, {"id": 1, "name": "IVO PETROV", "names": ["IVO PETROV", "PETROV"], "gender": "?", "first": 6, "spoke": 1}, {"id": 2, "name": "MOTH", "names": ["MOTH"], "gender": "m", "first": 8, "spoke": 1}, {"id": 3, "name": "DEMIR", "names": ["DEMIR"], "gender": "?", "first": 8, "spoke": 0}, {"id": 4, "name": "MEDIC ABENA NKRUMAH", "names": ["MEDIC ABENA NKRUMAH", "ABENA"], "gender": "?", "first": 20, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. FLOODED TERRACE BUNKER - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Knee-deep water.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single lantern swings from a hook.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Mortar fire thumps overhead; dust sifts down.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SGT. TAMSIN BRIGG (40s, mud to the eyebrows) checks a rifle bolt.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "CPL.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "IVO PETROV (30s) holds a radio that gives only static.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "PVT.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "LUKA \"MOTH\" DEMIR (19) crouches by the slit, shaking.", "para": 1, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Heads down, everybody. Quiet.", "name": "BRIGG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Another thump.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "They flatten against the wall.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Water slops.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Brigg and Petrov grab for the lantern at the same moment and both stop with their hands on the hook.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Radio's dead, Sergeant.", "name": "PETROV", "speaker": 1, "ext": [], "paren": ["to Brigg"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Then we're the radio.", "name": "BRIGG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Don't look. Don't look. Don't look.", "name": "MOTH", "speaker": 2, "ext": [], "paren": ["mutters, to himself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "The hatch above scrapes.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "All three raise their rifles.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "A boot, then a body drops into the water.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "MEDIC ABENA NKRUMAH (20s, red cross armband, medic bag held overhead) lands in a crouch.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Hold your fire. Who's bleeding?", "name": "ABENA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Nobody answers.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Moth slowly lowers his rifle and looks at his own hand, which is slick and dark.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Moth. Show me.", "name": "BRIGG", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}]}