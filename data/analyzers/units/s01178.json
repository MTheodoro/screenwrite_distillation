{"scene_id": "s01178", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01178.fountain", "heading": "EXT. SOAPBOX DERBY PIT LANE - DAY", "cast": [{"id": 0, "name": "COACH BRONWEN MAYHEW", "names": ["COACH BRONWEN MAYHEW", "BRONWEN"], "gender": "f", "first": 4, "spoke": 5}, {"id": 1, "name": "TEDDY", "names": ["TEDDY"], "gender": "m", "first": 5, "spoke": 4}, {"id": 2, "name": "LACROIX", "names": ["LACROIX"], "gender": "?", "first": 5, "spoke": 0}, {"id": 3, "name": "RACE CONTROL", "names": ["RACE CONTROL"], "gender": "?", "first": 7, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SOAPBOX DERBY PIT LANE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Hot asphalt and hay bales.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A hand-painted cart, number 7, rests on its wheels at the starting ramp.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Banners snap in the wind.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "COACH BRONWEN MAYHEW (50s, whistle, sun visor) crouches at the cart's front axle with a wrench, tightening a nut while shouting over her shoulder.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "TEODORO \"TEDDY\" LACROIX (12, helmet too large, goggles pushed up) kneels in the cockpit, adjusting the steering rope, then stops to wave at someone in the crowd, then goes back to the rope.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "A loudspeaker on a pole crackles above them.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Car seven to the line. Car seven, two minutes.", "name": "RACE CONTROL", "speaker": 3, "ext": ["V.O."], "paren": ["over loudspeaker"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "I heard.", "name": "BRONWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Did they say two minutes?", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "They said two minutes.", "name": "BRONWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Is it two or one-thirty?", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Car seven, you are blocking the ramp.", "name": "RACE CONTROL", "speaker": 3, "ext": ["V.O."], "paren": ["over loudspeaker"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "We're not blocking, we're tuning!", "name": "BRONWEN", "speaker": 0, "ext": [], "paren": ["to the sky"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Coach, the left wheel is wobbling.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "It's not wobbling, it's thinking.", "name": "BRONWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "One minute thirty.", "name": "RACE CONTROL", "speaker": 3, "ext": ["V.O."], "paren": ["over loudspeaker"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Bronwen drops the wrench, tugs Teddy's chin strap tight, slaps the helmet twice, and pushes the cart up the ramp with both hands.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Teddy drops his goggles and grips the rope.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Coach.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Don't speak. Steer.", "name": "BRONWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}