{"scene_id": "s01180", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01180.fountain", "heading": "INT. NIGHT-SHIFT CLEANING CLOSET - COUNTY BANK - NIGHT", "cast": [{"id": 0, "name": "WOMAN", "names": ["WOMAN"], "gender": "f", "first": 4, "spoke": 0}, {"id": 1, "name": "DOLORES", "names": ["DOLORES"], "gender": "?", "first": 17, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT-SHIFT CLEANING CLOSET - COUNTY BANK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Mop buckets.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Bleach.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A fluorescent tube ticking.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A WOMAN (50s, grey smock, hair in a net) hangs her coat on a hook.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Steady hands.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "She hums.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "She opens a locker.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Name tape inside the door: \"D. VASQUEZ-MOORE.\"", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "She lifts the false bottom.", "para": 3, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "A drill.", "para": 3, "sent": 1, "present": [0]}, {"u": 11, "kind": "action", "text": "A thermal lance.", "para": 3, "sent": 2, "present": [0]}, {"u": 12, "kind": "action", "text": "Gloves.", "para": 3, "sent": 3, "present": [0]}, {"u": 13, "kind": "action", "text": "Calm.", "para": 4, "sent": 0, "present": [0]}, {"u": 14, "kind": "action", "text": "Too calm.", "para": 4, "sent": 1, "present": [0]}, {"u": 15, "kind": "action", "text": "She checks her watch.", "para": 5, "sent": 0, "present": [0]}, {"u": 16, "kind": "action", "text": "Presses play on a cheap recorder.", "para": 5, "sent": 1, "present": [0]}, {"u": 17, "kind": "dialogue", "text": "If you're hearing this, the cameras loop at two. Do not rush. Mop first.", "name": "DOLORES", "speaker": 1, "ext": ["V.O."], "paren": ["recorded, her own voice"], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "DOLORES nods along.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Hums again.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She lifts the bucket.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Wheels it out.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Hallway.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Vault door at the end, gleaming.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She stops.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Sets the mop against the wall.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Evening, old friend.", "name": "DOLORES", "speaker": 1, "ext": ["CONT'D"], "paren": ["to the door, softly"], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "She pulls the lance from under the smock.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Snaps the valve.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "A hiss.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "A blue flame.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Thirty years I've cleaned around you.", "name": "DOLORES", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "She starts to cut.", "para": 12, "sent": 0, "present": [0, 1]}]}