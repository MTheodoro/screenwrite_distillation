{"scene_id": "s01182", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01182.fountain", "heading": "INT. STRANDED CABLE-CAR GONDOLA - DUSK", "cast": [{"id": 0, "name": "ELSPETH", "names": ["ELSPETH"], "gender": "m", "first": 5, "spoke": 2}, {"id": 1, "name": "TARIQ", "names": ["TARIQ"], "gender": "?", "first": 6, "spoke": 2}, {"id": 2, "name": "MIREILLE", "names": ["MIREILLE"], "gender": "f", "first": 7, "spoke": 1}, {"id": 3, "name": "GUS", "names": ["GUS"], "gender": "m", "first": 8, "spoke": 1}, {"id": 4, "name": "PAPADAKIS", "names": ["PAPADAKIS"], "gender": "?", "first": 8, "spoke": 0}, {"id": 5, "name": "BEATRIZ", "names": ["BEATRIZ"], "gender": "f", "first": 9, "spoke": 2}, {"id": 6, "name": "RESCUE DISPATCH", "names": ["RESCUE DISPATCH"], "gender": "?", "first": 10, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. STRANDED CABLE-CAR GONDOLA - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "Wind shrieks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The gondola sways on its cable a thousand feet above a white abyss.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Ice rimes the windows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single emergency bulb flickers.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ELSPETH (60s, mountaineering jacket, calm) braces against the door.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "TARIQ (30s, ski instructor's red parka) tries to pry open a roof hatch.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "MIREILLE (40s, silk scarf, bare hands) holds a toddler's mitten and no toddler.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "GUS \"TINY\" PAPADAKIS (50s, enormous, wearing a rented jacket two sizes small) sits on the floor with his head between his knees.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "BEATRIZ (20s, backpack on her lap, headphones around her neck) holds a radio handset.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Dispatch, are you there?", "name": "BEATRIZ", "speaker": 5, "ext": [], "paren": ["into handset"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "Gondola Four, we copy. Hold position. Repeat, hold position.", "name": "RESCUE DISPATCH", "speaker": 6, "ext": ["V.O."], "paren": ["over radio, crackling"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "Hold position? We are the position!", "name": "TARIQ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "action", "text": "Elspeth lays a hand on his arm.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "action", "text": "He shakes it off, then steps back, ashamed.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "Nobody panics. Not yet.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "I'm not panicking. I'm meditating.", "name": "GUS", "speaker": 3, "ext": [], "paren": ["muffled, to his knees"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "action", "text": "The gondola lurches.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "action", "text": "Everyone grabs a rail.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "action", "text": "The bulb dies.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "action", "text": "Beatriz clicks a flashlight on and turns the beam to the ceiling.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "Please. Please.", "name": "MIREILLE", "speaker": 2, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Okay. Listen to me. Everyone's watch, everyone's phone, everyone's jacket. We pool it. Now.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": ["to the group"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "They hesitate.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "Then Gus lifts his head, unzips the tiny jacket, and holds it out.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "action", "text": "Tariq follows.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "action", "text": "Mireille hands over her scarf with trembling fingers.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "Beatriz shares her headphones, her gloves, her granola bar.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "Gondola Four, storm front arrives in forty minutes. Do not exit the cabin.", "name": "RESCUE DISPATCH", "speaker": 6, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "Tariq looks at the hatch.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "He looks at the drop.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "He sits.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "Forty minutes. Forty minutes.", "name": "TARIQ", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "Elspeth wraps the scarf around Mireille's neck and presses the mitten into her palm.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "Mireille grips it.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "Wind rattles the glass.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "Dispatch, we'll hold. But please hurry.", "name": "BEATRIZ", "speaker": 5, "ext": [], "paren": ["into handset"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}