action", "text": "Behind him, BIG TOMMY SERRANO (50s, enormous, suspenders) rises from the truck bed.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Silent.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Holding a tire iron.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "You brought a friend.", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Insurance.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Sadie smiles.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "A click in the dark.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "From another car, a gun barrel.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "DETECTIVE LUCIA ORTEGA (40s, badge on a chain) steps into the screen's glow.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Hands up. All of you.", "name": "ORTEGA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Tommy swings.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Sadie ducks.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "The Stranger hurls popcorn.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Ortega fires into the sky.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Everyone dives.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "The film's monster roars on the screen.", "para": 5, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Sadie rolls under the pickup.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Tommy drops the iron.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Name.", "name": "ORTEGA", "speaker": 3, "ext": ["CONT'D"], "paren": ["to the Stranger"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Elias Brandt.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Elias. Thank you.", "name": "ORTEGA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Wait. Wrong answer.", "name": "ELIAS", "speaker": 4, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "He grins.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "The truck's engine roars to life.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}]}