{"scene_id": "s01186", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01186.fountain", "heading": "EXT. ROOFTOP APIARY - GOLDEN HOUR", "cast": [{"id": 0, "name": "ANNELIESE VOSS", "names": ["ANNELIESE VOSS", "ANNELIESE"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "JOSUE PEREIRA", "names": ["JOSUE PEREIRA", "JOSUE"], "gender": "m", "first": 5, "spoke": 5}, {"id": 2, "name": "GRANDMOTHER FLORENCE", "names": ["GRANDMOTHER FLORENCE", "FLORENCE"], "gender": "f", "first": 6, "spoke": 3}, {"id": 3, "name": "HIRO", "names": ["HIRO"], "gender": "m", "first": 7, "spoke": 2}, {"id": 4, "name": "PETRA", "names": ["PETRA"], "gender": "f", "first": 8, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ROOFTOP APIARY - GOLDEN HOUR", "present": []}, {"u": 1, "kind": "action", "text": "White hives in neat rows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A city skyline smolders behind them.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Folding tables, paper lanterns, a rehearsal-dinner mood.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ANNELIESE VOSS (30s, beekeeper's veil pushed up) pours mead into small cups.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "JOSUE PEREIRA (30s, shirt sleeves rolled, hands scarred from hive tools) carries a tray of honeycomb.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "GRANDMOTHER FLORENCE (80s, cane, dressed for a wedding) sits at the head table.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "HIRO (30s, the groom, nervous tie) practices a toast under his breath.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "PETRA (30s, the bride's sister, sunglasses) watches Anneliese and Josue.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Mead?", "name": "JOSUE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Honeycomb?", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "He sets the tray down.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "She hands him a cup.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Their fingers don't touch.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Everyone sit. It's rude to stand while the bees work.", "name": "FLORENCE", "speaker": 2, "ext": [], "paren": ["to the table"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "They sit.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Hiro stands anyway.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Thank you all for coming up here. To the bees.", "name": "HIRO", "speaker": 3, "ext": [], "paren": ["clearing throat"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "To the bees.", "name": "PETRA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "To the bees.", "name": "JOSUE", "speaker": 1, "ext": [], "paren": ["dry"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "They never leave.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": ["dry"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Josue lifts his cup.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Anneliese does not.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Petra's sunglasses angle toward her.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Anneliese, something wrong with the mead?", "name": "PETRA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "No. Everything's perfect.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "She sips.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Josue sets his cup down, harder than he means to.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Seven years. You'd think I'd stop being surprised by what you won't say.", "name": "JOSUE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "You'd think you'd stop assuming.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Children.", "name": "FLORENCE", "speaker": 2, "ext": [], "paren": ["sharp"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Oh no. Oh no, not the toast.", "name": "HIRO", "speaker": 3, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "I wrote you a letter. Josue. I wrote you a hundred letters and I burned every one on this roof.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Then you burned the wrong thing.", "name": "JOSUE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "A hive hums louder.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Petra takes off her sunglasses.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Florence drops her cane across the table with a clatter.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Out. All of you. Let them finish.", "name": "FLORENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Chairs scrape.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Hiro scurries away.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Petra hesitates, then follows.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Anneliese and Josue stand alone among the hives.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "You ruined my life.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "You ruined mine first.", "name": "JOSUE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "She steps close.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "He doesn't back away.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Behind them the sun slides below the skyline.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}]}