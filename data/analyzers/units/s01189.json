{"scene_id": "s01189", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01189.fountain", "heading": "INT. CONVERTED CINEMA FIELD HOSPITAL - NIGHT", "cast": [{"id": 0, "name": "PRIYA NAIR", "names": ["PRIYA NAIR", "PRIYA"], "gender": "f", "first": 7, "spoke": 10}, {"id": 1, "name": "NURSE", "names": ["NURSE"], "gender": "?", "first": 9, "spoke": 0}, {"id": 2, "name": "SEBASTIAN OYELOWO", "names": ["SEBASTIAN OYELOWO", "SEBASTIAN"], "gender": "f", "first": 9, "spoke": 4}, {"id": 3, "name": "MAN", "names": ["MAN"], "gender": "?", "first": 12, "spoke": 0}, {"id": 4, "name": "THEO ABBASI", "names": ["THEO ABBASI", "THEO"], "gender": "m", "first": 13, "spoke": 4}, {"id": 5, "name": "MS. HALLORAN", "names": ["MS. HALLORAN"], "gender": "?", "first": 65, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. CONVERTED CINEMA FIELD HOSPITAL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A former movie palace.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The velvet seats have been ripped out and replaced with rows of cots.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The screen at the front is a mural of water-stained gold curtains.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Plastic sheeting hangs from the balcony.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Generator hum.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "Coughing.", "para": 0, "sent": 5, "present": []}, {"u": 7, "kind": "action", "text": "DR. PRIYA NAIR (40s, scrubs two sizes large, hair under a surgical cap) crosses the aisle, clipboard pressed to her chest.", "para": 1, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "She is the only one moving fast.", "para": 1, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "A NURSE, SEBASTIAN OYELOWO (30s, soft-spoken, glasses taped at the hinge), trails her with a tray.", "para": 2, "sent": 0, "present": [0, 2]}, {"u": 10, "kind": "action", "text": "At the center of the stage, a boy lies on a cot, wrapped in a foil blanket.", "para": 3, "sent": 0, "present": [0, 2]}, {"u": 11, "kind": "action", "text": "The boy, ten, flushed and unconscious, does not stir.", "para": 3, "sent": 1, "present": [0, 2]}, {"u": 12, "kind": "action", "text": "Beside him, a MAN in a stained suit sits slumped on a folding chair.", "para": 4, "sent": 0, "present": [0, 2, 3]}, {"u": 13, "kind": "action", "text": "THEO ABBASI (50s, the boy's father, unshaven, wedding ring turning round his finger) grips the cot's rail.", "para": 4, "sent": 1, "present": [0, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "She reaches the cot.", "para": 5, "sent": 0, "present": [0, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Checks the chart.", "para": 5, "sent": 1, "present": [0, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "He watches her read.", "para": 5, "sent": 2, "present": [0, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "How long has the fever been over a hundred and three?", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Since the lights went out.", "name": "THEO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Four hours.", "name": "SEBASTIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "She lays a hand on the boy's forehead.", "para": 6, "sent": 0, "present": [0, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "He winces.", "para": 6, "sent": 1, "present": [0, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "She tilts his head, thumbs back an eyelid.", "para": 6, "sent": 2, "present": [0, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "He doesn't resist.", "para": 6, "sent": 3, "present": [0, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Start the line. Saline, then the second antibiotic.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": ["quietly, to Sebastian"], "dual": false, "present": [0, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "We're out of the second.", "name": "SEBASTIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "She does not turn.", "para": 7, "sent": 0, "present": [0, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Her shoulders stiffen.", "para": 7, "sent": 1, "present": [0, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "She breathes in once.", "para": 7, "sent": 2, "present": [0, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Then the first, double. And find me a pharmacist.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "There are no pharmacists.", "name": "SEBASTIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Then find me someone who used to be one.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "He nods and leaves.", "para": 8, "sent": 0, "present": [0, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "The generator stutters.", "para": 8, "sent": 1, "present": [0, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Lights dim, brighten.", "para": 8, "sent": 2, "present": [0, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Theo looks up.", "para": 8, "sent": 3, "present": [0, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Doctor.", "name": "THEO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Mr. Abbasi.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Is he going to make it?", "name": "THEO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "She looks at him.", "para": 9, "sent": 0, "present": [0, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Not at the chart, not at the boy.", "para": 9, "sent": 1, "present": [0, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "At him.", "para": 9, "sent": 2, "present": [0, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "I don't know yet.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "He nods.", "para": 10, "sent": 0, "present": [0, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "It is the answer he expected, but he needed to hear it said.", "para": 10, "sent": 1, "present": [0, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "He lowers his head onto the rail.", "para": 10, "sent": 2, "present": [0, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Priya straightens.", "para": 11, "sent": 0, "present": [0, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Across the hall, a second cot.", "para": 11, "sent": 1, "present": [0, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "A second father.", "para": 11, "sent": 2, "present": [0, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "A nurse waving frantically.", "para": 11, "sent": 3, "present": [0, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "She walks toward it.", "para": 12, "sent": 0, "present": [0, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Then stops.", "para": 12, "sent": 1, "present": [0, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Turns back.", "para": 12, "sent": 2, "present": [0, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Kneels beside the boy and tucks the foil blanket tighter, careful of his arm.", "para": 12, "sent": 3, "present": [0, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "Stay with us, little one.", "name": "PRIYA", "speaker": 0, "ext": ["CONT'D"], "paren": ["whisper"], "dual": false, "present": [0, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "He does not stir.", "para": 13, "sent": 0, "present": [0, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "She stands.", "para": 14, "sent": 0, "present": [0, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "The generator coughs again.", "para": 14, "sent": 1, "present": [0, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "This time the lights go out entirely.", "para": 14, "sent": 2, "present": [0, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "Darkness.", "para": 15, "sent": 0, "present": [0, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "Someone sobs.", "para": 15, "sent": 1, "present": [0, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "A match flares.", "para": 15, "sent": 2, "present": [0, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "Another.", "para": 15, "sent": 3, "present": [0, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "A third.", "para": 15, "sent": 4, "present": [0, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "Sebastian reappears, holding a candle, a woman beside him in a grey cardigan, shaking out her hands.", "para": 15, "sent": 5, "present": [0, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "Doctor, this is Ms. Halloran. She ran a pharmacy for thirty years.", "name": "SEBASTIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3, 4, 5]}, {"u": 66, "kind": "action", "text": "Priya takes in the cardigan, the shaking hands, the tired eyes.", "para": 16, "sent": 0, "present": [0, 2, 3, 4, 5]}, {"u": 67, "kind": "action", "text": "She puts out her own.", "para": 16, "sent": 1, "present": [0, 2, 3, 4, 5]}, {"u": 68, "kind": "dialogue", "text": "Do you remember how to mix a pediatric dose?", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3, 4, 5]}, {"u": 69, "kind": "action", "text": "The woman almost smiles.", "para": 17, "sent": 0, "present": [0, 2, 3, 4, 5]}, {"u": 70, "kind": "dialogue", "text": "Like my own name.", "name": "MS. HALLORAN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3, 4, 5]}, {"u": 71, "kind": "dialogue", "text": "Good. Because tonight, you're the only name I trust.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3, 4, 5]}, {"u": 72, "kind": "action", "text": "The woman nods, rolls up her sleeves, and follows Sebastian into the dark.", "para": 18, "sent": 0, "present": [0, 2, 3, 4, 5]}, {"u": 73, "kind": "action", "text": "Priya stands over the cot.", "para": 18, "sent": 1, "present": [0, 2, 3, 4, 5]}, {"u": 74, "kind": "action", "text": "The candle flames lean.", "para": 18, "sent": 2, "present": [0, 2, 3, 4, 5]}, {"u": 75, "kind": "dialogue", "text": "Thank you.", "name": "THEO", "speaker": 4, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 2, 3, 4, 5]}, {"u": 76, "kind": "dialogue", "text": "Don't. Not yet.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3, 4, 5]}, {"u": 77, "kind": "action", "text": "She stays beside the boy, one hand on the rail, her eyes on the rise and fall of the foil.", "para": 19, "sent": 0, "present": [0, 2, 3, 4, 5]}, {"u": 78, "kind": "action", "text": "The mural curtains hang above them, golden, ruined, waiting for a show that never begins.", "para": 19, "sent": 1, "present": [0, 2, 3, 4, 5]}]}