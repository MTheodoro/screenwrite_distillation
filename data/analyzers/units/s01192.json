{"scene_id": "s01192", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01192.fountain", "heading": "EXT. STAGE STATION WELL - HIGH DESERT - NOON", "cast": [{"id": 0, "name": "JEDEDIAH PRUITT", "names": ["JEDEDIAH PRUITT", "JEDEDIAH"], "gender": "m", "first": 5, "spoke": 5}, {"id": 1, "name": "ABBY", "names": ["ABBY"], "gender": "f", "first": 7, "spoke": 5}, {"id": 2, "name": "TORRANCE", "names": ["TORRANCE"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "LOCKHART", "names": ["LOCKHART"], "gender": "m", "first": 8, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. STAGE STATION WELL - HIGH DESERT - NOON", "present": []}, {"u": 1, "kind": "action", "text": "A parched yard.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A plank shed, a rusted pump, a stone well with a wooden lid.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Heat shimmers.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A water barrel is tipped on its side, bone dry.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "JEDEDIAH PRUITT (60s, hat brim curled, a sheriff's star pinned crooked) stands at the well with a rope around his waist.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "He peers over the edge.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "ABIGAIL \"ABBY\" TORRANCE (20s, dust-grey duster, rifle slung across her back) sits on the stone rim and drinks from a canteen.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "MR. LOCKHART (40s, striped vest, no gun) leans against the shed, watching the horizon.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Pump's dry.", "name": "JEDEDIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Well's not.", "name": "ABBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Well's got something in it.", "name": "JEDEDIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Something or someone?", "name": "ABBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Jedediah tests the rope.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "It holds.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Lockhart pushes off the shed, steps forward, and bumps the barrel with his boot.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "It rolls across the yard and clunks against the pump.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "I'm only passing through, Sheriff. I'd consider it a favor if you'd leave my business out of it.", "name": "LOCKHART", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Your business has been dropping bodies in my well for three weeks, Mr. Lockhart.", "name": "JEDEDIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "I wouldn't know about that.", "name": "LOCKHART", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "He wouldn't.", "name": "ABBY", "speaker": 1, "ext": [], "paren": ["dry"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Jedediah lowers himself over the rim, hand over hand.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Abby grips the rope and feeds it down.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Lockhart takes a step toward her.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "She half-draws the rifle without looking at him, and he stops, both hands open at his sides.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Miss, you really shouldn't.", "name": "LOCKHART", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "I really should.", "name": "ABBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "From below, a splash.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Then Jedediah's voice, hollow in the stone.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "It's him. It's Arliss.", "name": "JEDEDIAH", "speaker": 0, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Abby releases a breath.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Lockhart spits in the dust.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "The wind picks up, rattling the shed door.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Pull me up.", "name": "JEDEDIAH", "speaker": 0, "ext": ["O.S.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Abby and Lockhart both look at the rope.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Abby tightens her grip.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Lockhart folds his arms.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Neither of them moves.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Mr. Lockhart, I'd hate to need your help.", "name": "ABBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "I'd hate to give it.", "name": "LOCKHART", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "He takes hold of the rope anyway.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "They haul together, heaving, boots skidding in the dirt, until Jedediah's hat rises over the rim.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}]}