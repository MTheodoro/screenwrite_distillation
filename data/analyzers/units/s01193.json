ue", "text": "No.", "name": "DEXTER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "^No.", "name": "WANJIRU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "They glance at each other.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Neither smiles.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Marguerite's pencil stops.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "We could walk.", "name": "FIONN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "We could stay.", "name": "MARGUERITE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Nobody says what they mean.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Isolde turns her face away.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Headlights swing across the gravel.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "A battered pickup brakes.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "The door opens.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "MR. DELACROIX-HUANG (50s, their old music teacher, thermos in hand) climbs out and surveys the bus.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Anyone hurt?", "name": "MR. DELACROIX-HUANG", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Fionn stands.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Wanjiru stands.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "One by one, the others rise.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Isolde stays seated until Marguerite offers her a hand without looking at her.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "She takes it.", "para": 5, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}]}