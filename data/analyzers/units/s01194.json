{"scene_id": "s01194", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01194.fountain", "heading": "EXT. WHALE-RIB BRIDGE - DAWN", "cast": [{"id": 0, "name": "SERAPHINA OKONKWO-DREY", "names": ["SERAPHINA OKONKWO-DREY", "SERAPHINA"], "gender": "?", "first": 4, "spoke": 2}, {"id": 1, "name": "BRAM LAME", "names": ["BRAM LAME", "BRAM"], "gender": "f", "first": 5, "spoke": 1}, {"id": 2, "name": "TASHI", "names": ["TASHI"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "GREYMOOR", "names": ["GREYMOOR"], "gender": "?", "first": 7, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. WHALE-RIB BRIDGE - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A colossal skeleton arches over a fogbound chasm.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Ribs the width of oaks form a walkway.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Prayer flags snap from the vertebrae.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SERAPHINA OKONKWO-DREY (30s, hooded cloak, staff of white wood) steps onto the bridge.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "BRAM THE LAME (50s, iron crutch) shuffles behind her.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "TASHI (12, goat bell on a cord) skips ahead.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Last, GREYMOOR (ageless, antlered, silver eyes) waits on the far side.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Stay on the bones.", "name": "SERAPHINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Which bones?", "name": "TASHI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "All of them, you fool.", "name": "BRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "The bridge shudders.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "A rib cracks.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Seraphina grabs Tashi's collar, Bram lunges for the rail, and all three crash to their knees as a gap opens ahead.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "You are late.", "name": "GREYMOOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "The tide was early.", "name": "SERAPHINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "The tide was never yours.", "name": "GREYMOOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Greymoor raises one hand.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Mist rises, thick and white.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "The bridge heals itself with a groan.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Bram stands, stunned.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Tashi laughs, a bright note.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Again!", "name": "TASHI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Seraphina and Greymoor lock eyes.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Neither blinks.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}]}