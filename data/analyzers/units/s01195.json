{"scene_id": "s01195", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01195.fountain", "heading": "INT. ICE-FISHING HUT - NIGHT", "cast": [{"id": 0, "name": "GRETA KOWALCZYK", "names": ["GRETA KOWALCZYK", "GRETA"], "gender": "f", "first": 5, "spoke": 2}, {"id": 1, "name": "RUTH", "names": ["RUTH"], "gender": "?", "first": 10, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. ICE-FISHING HUT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A plywood box on a frozen lake.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A propane heater glows orange.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A hole in the floor shows black water.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A radio hangs on a nail.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "GRETA KOWALCZYK (40s, wool cap, thermos) sits on an upturned bucket, jigging a line.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She does not look at the radio.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Wind presses at the walls.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "The heater ticks.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "The radio crackles.", "para": 3, "sent": 0, "present": [0]}, {"u": 10, "kind": "dialogue", "text": "Shanty nine. Greta. Are you there?", "name": "RUTH", "speaker": 1, "ext": ["V.O."], "paren": ["over radio, faint"], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Greta's jigging hand stops.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She waits.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "The radio hisses.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "I know you can hear me. You always keep it on.", "name": "RUTH", "speaker": 1, "ext": ["V.O.", "CONT'D"], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Greta reels in.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Empty hook.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She baits it again, slowly.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Her thermos lid rattles against its cup.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "The ice is thinning by the east shore. Come in before dark.", "name": "RUTH", "speaker": 1, "ext": ["V.O.", "CONT'D"], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "It's dark.", "name": "GRETA", "speaker": 0, "ext": [], "paren": ["flat"], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Then come in now.", "name": "RUTH", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Greta takes the handset off its hook.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She does not press the key.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She holds it against her chest.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "A sound like a rifle shot rolls across the lake.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "The hut lurches a quarter inch.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Greta grips the bucket rim.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Greta. Listen to me. I'm not at the station.", "name": "RUTH", "speaker": 1, "ext": ["V.O.", "CONT'D"], "paren": ["over radio, closer"], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Greta lowers her eyes to the hole in the floor.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "The black water is still.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Something taps the ice beneath it.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Once.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Twice.", "para": 8, "sent": 4, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Where are you, then?", "name": "GRETA", "speaker": 0, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "The radio hisses.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "The tapping stops.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Then, from the hole, in a voice that is exactly the radio's:", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Here.", "name": "RUTH", "speaker": 1, "ext": ["V.O."], "paren": ["from the water"], "dual": false, "present": [0, 1]}]}