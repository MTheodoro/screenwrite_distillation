{"scene_id": "s01196", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01196.fountain", "heading": "INT. FLOODED SUPERMARKET - DAY", "cast": [{"id": 0, "name": "LORENZO", "names": ["LORENZO"], "gender": "m", "first": 5, "spoke": 3}, {"id": 1, "name": "ADEOLA", "names": ["ADEOLA"], "gender": "?", "first": 6, "spoke": 2}, {"id": 2, "name": "KIERAN", "names": ["KIERAN"], "gender": "m", "first": 7, "spoke": 1}, {"id": 3, "name": "OKAFOR-LINDQVIST", "names": ["OKAFOR-LINDQVIST", "MRS. OKAFOR-LINDQVIST"], "gender": "?", "first": 8, "spoke": 1}, {"id": 4, "name": "PEPPER", "names": ["PEPPER"], "gender": "?", "first": 9, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. FLOODED SUPERMARKET - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Brown water to the waist.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Shelves rise like cliffs, stocked with swollen cereal boxes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Sunlight slants through a shattered skylight.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A makeshift raft of shopping carts and pallets drifts down the cereal aisle.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LORENZO (40s, soaked, towel on his shoulders) poles the raft with a broom handle.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "ADEOLA (30s, backpack of canned goods) sits cross-legged, counting cans.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "KIERAN (15, hoodie, bruised knee) dangles a hand in the water.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "MRS. OKAFOR-LINDQVIST (70s, cardigan, plastic bonnet) perches on the cart front like a figurehead.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "PEPPER (12, goggles, plastic sword) stands on a pallet, scanning the shelves.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Left side.", "name": "LORENZO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Left side what?", "name": "ADEOLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Aisle's narrowing. Everybody lean.", "name": "LORENZO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Everyone leans.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "The raft slides past a display of cat food.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Kieran lifts his hand, and a drowned cardboard banner slaps against his arm.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Pepper swings the sword at it, and Mrs. Okafor-Lindqvist ducks, bonnet askew.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Adeola catches the can-bag as it tips, Lorenzo plants the pole on a shelf and heaves, and the raft eases into the bread aisle with a long creak.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Land ho!", "name": "PEPPER", "speaker": 4, "ext": [], "paren": ["to everyone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Dear, there's no land.", "name": "MRS. OKAFOR-LINDQVIST", "speaker": 3, "ext": [], "paren": ["to Pepper"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "There's a ceiling.", "name": "PEPPER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "We're going to run out of aisles.", "name": "KIERAN", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Then we'll invent new ones.", "name": "LORENZO", "speaker": 0, "ext": [], "paren": ["to Kieran"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Forty-one, forty-two...", "name": "ADEOLA", "speaker": 1, "ext": [], "paren": ["to herself, counting"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "The raft drifts.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Sunlight crawls across the water.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "For a moment nobody speaks.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}]}