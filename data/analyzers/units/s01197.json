{"scene_id": "s01197", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01197.fountain", "heading": "INT. FISH CANNERY - NIGHT SHIFT - NIGHT", "cast": [{"id": 0, "name": "NELL PARADIS", "names": ["NELL PARADIS", "NELL"], "gender": "f", "first": 4, "spoke": 8}, {"id": 1, "name": "SHAPE", "names": ["SHAPE"], "gender": "?", "first": 7, "spoke": 2}, {"id": 2, "name": "CELESTINE PARADIS", "names": ["CELESTINE PARADIS", "CELESTINE"], "gender": "?", "first": 4, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. FISH CANNERY - NIGHT SHIFT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A steel cavern of conveyors, hooks, and wet concrete.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fluorescents hum.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The belts are stopped, but the smell lingers: brine, blood, tin.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "NELL PARADIS (30s, hairnet, rubber apron) sweeps the floor between two conveyor lines.", "para": 1, "sent": 0, "present": [0, 2]}, {"u": 5, "kind": "action", "text": "She works with a metronome rhythm.", "para": 1, "sent": 1, "present": [0, 2]}, {"u": 6, "kind": "action", "text": "At the far end, a figure stands motionless in the shadow of a retort oven.", "para": 2, "sent": 0, "present": [0, 2]}, {"u": 7, "kind": "action", "text": "A SHAPE in a rubber coat, hood up, face hidden.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Hello? Shift's over. You can't be back here.", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "The shape doesn't move.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Nell stops sweeping.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "She lifts the broom like a staff.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Union rep? Inspector?", "name": "NELL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "The shape takes a step.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Water drips from its sleeves.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Nell backs up against a belt and her hand brushes a steel hook swinging on its chain.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Nell.", "name": "SHAPE", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "How do you know my name?", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "It's on your apron.", "name": "SHAPE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "She glances down.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Yes.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Embroidered across the chest.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "She relaxes a fraction, then stiffens again.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "That doesn't explain why you're standing in the dark.", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The shape moves into the fluorescent light.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "The hood falls back.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "A woman's face, pale, lined, eyes fixed.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Mama?", "name": "NELL", "speaker": 0, "ext": ["CONT'D"], "paren": ["whisper"], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Nell's mother, CELESTINE PARADIS (60s, drowned decades ago), stands in the aisle, water pooling at her boots.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Do you still sing while you work?", "name": "CELESTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Nell shakes her head.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Her hand slides along the belt.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "You used to.", "name": "CELESTINE", "speaker": 2, "ext": ["CONT'D"], "paren": ["a little sadly"], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "She holds out a hand.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Nell takes a step.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Then she freezes.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Behind the figure, a second shape detaches from the shadows.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "A man's.", "para": 9, "sent": 4, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Tall, dripping.", "para": 9, "sent": 5, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Same coat.", "para": 9, "sent": 6, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Who is that?", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Your father.", "name": "CELESTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Nell drops the broom.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "The belts begin to move on their own.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "The hooks swing.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "The lights flicker, then steady.", "para": 10, "sent": 3, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "You're both dead.", "name": "NELL", "speaker": 0, "ext": [], "paren": ["shaking"], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Yes. But it's still your shift.", "name": "CELESTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "The man steps forward and she sees his face.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "It is hers.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "The same eyes, the same jaw.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "She stumbles back.", "para": 11, "sent": 3, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "No.", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Nell. We were just waiting for you to come home.", "name": "CELESTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "The belts accelerate.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Nell turns and runs, boots slapping wet concrete.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "The hooks swing in her wake, clanging softly, and the whole cannery begins to hum with a lullaby neither of the dead is singing.", "para": 12, "sent": 2, "present": [0, 1, 2]}]}