{"scene_id": "s01198", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01198.fountain", "heading": "INT. DRY RIVERBED SALOON - LATE AFTERNOON", "cast": [{"id": 0, "name": "ZEKE", "names": ["ZEKE"], "gender": "?", "first": 5, "spoke": 9}, {"id": 1, "name": "HOLLOWAY", "names": ["HOLLOWAY"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "MADAME ODALYS RENFRO-TALL", "names": ["MADAME ODALYS RENFRO-TALL", "ODALYS"], "gender": "f", "first": 6, "spoke": 4}, {"id": 3, "name": "CASSIUS BLAINE", "names": ["CASSIUS BLAINE", "CASSIUS"], "gender": "m", "first": 7, "spoke": 8}, {"id": 4, "name": "LOOSE-JOINTED LEON", "names": ["LOOSE-JOINTED LEON", "LEON"], "gender": "m", "first": 7, "spoke": 2}, {"id": 5, "name": "BOY WILLIAMS", "names": ["BOY WILLIAMS"], "gender": "?", "first": 7, "spoke": 3}, {"id": 6, "name": "MARSHAL TREVELYAN", "names": ["MARSHAL TREVELYAN"], "gender": "?", "first": 25, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRY RIVERBED SALOON - LATE AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "A saloon built on stilts over a cracked, sun-bleached riverbed.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Heat bars the window slats.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A ceiling fan turns lazily.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The bar is a single long plank on barrels.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "EZEKIEL \"ZEKE\" HOLLOWAY (50s, bartender, apron stained to the color of old tea) polishes a glass that will never be clean.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "In the corner, MADAME ODALYS RENFRO-TALL (60s, black lace gloves, parasol closed on her lap) plays solitaire.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "At the far table, three MEN sit with their hats low: CASSIUS BLAINE (40s, scar through one eyebrow), LOOSE-JOINTED LEON (30s, rolling a cigarette that won't hold), and BOY WILLIAMS (18, still wearing a school tie under his duster).", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "action", "text": "A telegraph key chatters on the wall behind the bar.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "action", "text": "Zeke ignores it.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Gents. Madame. We close at five.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "It's four-fifteen.", "name": "CASSIUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "I like to be ahead.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Ahead of what?", "name": "LEON", "speaker": 4, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Cassius, is it true the river used to run right through here?", "name": "BOY WILLIAMS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Boy, that's what the old men said.", "name": "CASSIUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Why'd it stop?", "name": "BOY WILLIAMS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Because somebody asked it too many questions.", "name": "CASSIUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "The key chatters again.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Madame Renfro-Tall lifts her head.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Zeke, dear, that's the third time.", "name": "ODALYS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "I know.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Perhaps you should answer.", "name": "ODALYS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Zeke sets the glass down.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "He walks to the key, cocks his head, reads the dashes with his lips moving.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "\"Marshal... arriving... on... four... forty.\"", "name": "ZEKE", "speaker": 0, "ext": [], "paren": ["reading"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "action", "text": "He turns slowly.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "The three men at the table have gone very still.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "Leon's cigarette falls apart on the tabletop.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "Zeke.", "name": "CASSIUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "I didn't send for him.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "Somebody did.", "name": "CASSIUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "action", "text": "All eyes turn to Madame Renfro-Tall.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "She smooths a card, lays it down, and smiles with a calm that has seen five governors come and go.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "Well, someone had to.", "name": "ODALYS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "Leon shoves back his chair.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "Boy Williams rises half an inch and sits again, because Cassius has put a hand on his arm.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "Knew it. Knew it was the old lady.", "name": "LEON", "speaker": 4, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "dialogue", "text": "Dear Leon, you've never known anything, and it's what makes you restful.", "name": "ODALYS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "A long beat.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "The fan turns.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "Outside, far off, a horse whinnies.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "dialogue", "text": "Nobody draws until I say.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": ["to the room, quiet"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "dialogue", "text": "You say?", "name": "CASSIUS", "speaker": 3, "ext": [], "paren": ["to Zeke"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "dialogue", "text": "It's my bar.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "action", "text": "Boy Williams swallows.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "action", "text": "He looks at the door, at the window, at Cassius's hand.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "Dust motes drift down in the light.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "dialogue", "text": "Four-forty. Four-forty.", "name": "BOY WILLIAMS", "speaker": 5, "ext": [], "paren": ["whispering to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "action", "text": "Cassius takes his hand off the boy's arm.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "action", "text": "He lifts his glass, finds it empty, and sets it down gently.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "dialogue", "text": "Zeke, I'll have another.", "name": "CASSIUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "dialogue", "text": "You'll have water.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "dialogue", "text": "There isn't any water.", "name": "CASSIUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "dialogue", "text": "Then you'll have what we've got.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": ["a faint smile"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "action", "text": "He pours something amber into the glass.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "action", "text": "The telegraph key falls silent.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "action", "text": "Madame Renfro-Tall plays a red seven on a black eight.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "dialogue", "text": "Zeke Holloway! Step out onto the porch!", "name": "MARSHAL TREVELYAN", "speaker": 6, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 59, "kind": "action", "text": "Zeke lays down the bottle.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 60, "kind": "action", "text": "Nobody breathes.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}]}