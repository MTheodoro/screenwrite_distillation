{"scene_id": "s01200", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01200.fountain", "heading": "INT. RAILWAY LOST-PROPERTY OFFICE - NIGHT", "cast": [{"id": 0, "name": "INSPECTOR WILHELMINA TOLLIVER", "names": ["INSPECTOR WILHELMINA TOLLIVER", "TOLLIVER"], "gender": "f", "first": 4, "spoke": 16}, {"id": 1, "name": "PERCIVAL ODUYA", "names": ["PERCIVAL ODUYA", "PERCIVAL"], "gender": "?", "first": 5, "spoke": 16}], "units": [{"u": 0, "kind": "heading", "text": "INT. RAILWAY LOST-PROPERTY OFFICE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Shelves of umbrellas, odd gloves, trombone cases.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A brass bell sits on the counter.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "One desk lamp.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "INSPECTOR WILHELMINA TOLLIVER (50s, grey tweed) enters, shakes rain off her hat, and drops it on the counter.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "PERCIVAL ODUYA (60s, cardigan, sleeve garters) looks up from a ledger.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "She rings the bell.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He flinches.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Mr. Oduya.", "name": "TOLLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Inspector.", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Tell me about the green suitcase.", "name": "TOLLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Which green suitcase?", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "The one handed in on the fourteenth. Lock engraved with a swan.", "name": "TOLLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Ah. That one.", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "You remember it, then.", "name": "TOLLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I remember everything that's handed in. It's a vice.", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "And who handed it in?", "name": "TOLLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "A man in a brown coat. He said it was his sister's.", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "His sister's.", "name": "TOLLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "That's what he said.", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "And did you open it?", "name": "TOLLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Regulations forbid it.", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "That isn't what I asked.", "name": "TOLLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "No. It isn't.", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Mr. Oduya, a woman has been missing since the fourteenth. Her sister was seen at this station the same afternoon.", "name": "TOLLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Perhaps the same sister.", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Perhaps. Or perhaps the man in the brown coat was no brother at all.", "name": "TOLLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "You think I helped him.", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "I think you saw him.", "name": "TOLLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "I see everyone, Inspector. I see their umbrellas. I see their gloves. I don't see faces, only what they leave.", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Then tell me what he left.", "name": "TOLLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "The suitcase.", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Where is it?", "name": "TOLLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Collected.", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "By whom?", "name": "TOLLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "By you. Yesterday. You signed the ledger.", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "A long silence.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "The lamp hums.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "I did not.", "name": "TOLLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Then the ledger is mistaken.", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Show me.", "name": "TOLLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Gladly.", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "He turns the ledger toward her.", "para": 4, "sent": 0, "present": [0, 1]}]}