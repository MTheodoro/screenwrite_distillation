{"scene_id": "s01201", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01201.fountain", "heading": "INT. SLEEPER TRAIN - COMPARTMENT - NIGHT", "cast": [{"id": 0, "name": "IGNATIUS FELLOWES", "names": ["IGNATIUS FELLOWES", "IGNATIUS"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "PHIL", "names": ["PHIL"], "gender": "?", "first": 5, "spoke": 7}, {"id": 2, "name": "ACHTERBERG", "names": ["ACHTERBERG"], "gender": "?", "first": 5, "spoke": 0}, {"id": 3, "name": "MORDECAI VANTONGEREN", "names": ["MORDECAI VANTONGEREN", "MORDECAI"], "gender": "?", "first": 6, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. SLEEPER TRAIN - COMPARTMENT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Two bunks, a fold-down table, a window streaked with rain.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The train clatters through a tunnel.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A lamp swings.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "IGNATIUS FELLOWES (60s, silk dressing gown, nightcap) sits upright on the lower bunk with a book.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "PHILOMENA \"PHIL\" ACHTERBERG (30s, trench coat, boots still on) leans against the door.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "MORDECAI VANTONGEREN (40s, wire glasses, medical bag) stands by the window.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Phil, would you sit? You're making the lamp nervous.", "name": "IGNATIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Ignatius, I'm not leaving the door.", "name": "PHIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Phil, with respect, it's a train. The door isn't going anywhere.", "name": "MORDECAI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Neither are we.", "name": "PHIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "The lamp flickers.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Something knocks softly from the ceiling.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "All three look up.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Mordecai, did you hear that?", "name": "IGNATIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "I did. It's the luggage rack.", "name": "MORDECAI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "It's not the luggage rack.", "name": "PHIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Third time since Prague.", "name": "IGNATIUS", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Sir, you must rest.", "name": "MORDECAI", "speaker": 3, "ext": [], "paren": ["to Ignatius"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "I will rest when someone tells me what we shipped in the baggage car.", "name": "IGNATIUS", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Nobody shipped anything.", "name": "PHIL", "speaker": 1, "ext": [], "paren": ["over him"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "The manifest says medical supplies.", "name": "MORDECAI", "speaker": 3, "ext": [], "paren": ["over her"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Mordecai, you wrote the manifest!", "name": "IGNATIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Ignatius, I wrote what I was told.", "name": "MORDECAI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "By whom?", "name": "PHIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Three knocks, slow, from the ceiling.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "The train enters another tunnel.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "The lamp dies.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "In the dark, a fourth knock comes from inside the door, right beside Phil's ear.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Don't anybody move.", "name": "PHIL", "speaker": 1, "ext": ["CONT'D"], "paren": ["very quiet"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Mordecai. Say something.", "name": "IGNATIUS", "speaker": 0, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Phil, if you'd open the door...", "name": "MORDECAI", "speaker": 3, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Mordecai, no.", "name": "PHIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "The knocking stops.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "The train bursts into moonlight.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "In the sudden pale glow they see the door handle slowly turning down.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}]}