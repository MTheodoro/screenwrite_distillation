{"scene_id": "s01202", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01202.fountain", "heading": "INT. FLOODED CHAPEL - NIGHT", "cast": [{"id": 0, "name": "BROTHER ANSELM", "names": ["BROTHER ANSELM", "ANSELM"], "gender": "m", "first": 5, "spoke": 10}, {"id": 1, "name": "BROTHER THADDEUS", "names": ["BROTHER THADDEUS", "THADDEUS"], "gender": "?", "first": 5, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. FLOODED CHAPEL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Black water to the pews' seat-backs.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A shattered rose window lets moonlight lay a ragged pattern on the surface.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Candles in sconces burn, though nothing should light them.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The altar rises like an island.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "BROTHER ANSELM (50s, cassock hitched at the waist, a lantern in one hand) wades down the nave.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "BROTHER THADDEUS (50s, same cassock, same lantern) wades behind him.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Between them, floating, a coffin.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Slowly. Slowly.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I am going slowly.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "The coffin bumps a pew.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Water laps.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Anselm reaches for it.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Thaddeus catches the handle at the same moment.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "They steady it between them.", "para": 2, "sent": 4, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "He's heavier than he should be.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "He's wet.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "He was never wet. We kept him in the crypt.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Anselm pauses.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He turns his lantern on the coffin lid.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "A dark stain is seeping up through the wood.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "That's from the flood.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "That's from the inside.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "A low rhythmic knock begins within the coffin.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Not violent.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Patient.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Anselm lets go.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Thaddeus does not.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Brother. Release it.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "It's him.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "It isn't.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "It's the abbot. He's calling.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Thaddeus, the abbot was buried in the spring.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Then who's knocking?", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "The knocking stops.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "In the silence, water drips from the broken window.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Thaddeus lifts the lid half an inch.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Anselm lunges and slams it shut.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "The two struggle; the lantern tips from Anselm's hand and hisses out in the water.", "para": 5, "sent": 4, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Darkness.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Only the candles.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "The knocking begins again, fast now, frantic, from the altar behind them.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "That isn't the coffin.", "name": "ANSELM", "speaker": 0, "ext": ["CONT'D"], "paren": ["whisper"], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "They turn.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "On the altar, a figure kneels, face hidden, hands clasped, water running from its habit.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "It lifts its head.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Anselm and Thaddeus freeze.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "It has no face at all, only smooth pale skin.", "para": 7, "sent": 4, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Dear God.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "He answers.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": ["shaking"], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "The figure rises, dripping, and holds out a hand to each of them.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "Behind them, the coffin lid opens with a groan.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Brother. What do we do?", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "We kneel.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "They kneel, waist-deep in black water, as the candles flare high.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "The figure steps down from the altar and walks across the surface of the flood.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "Our Father, who art in heaven...", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": ["praying, trembling"], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "The figure stops before him and lays its hand on his head.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "Anselm squeezes his eyes shut.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "A long exhale, as of a very old furnace.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "Hallowed be thy name.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "The candles go out, one by one.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "Silence.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "Then the soft knocking begins again, and from every pew, a dozen more hands rise up through the water to answer.", "para": 12, "sent": 1, "present": [0, 1]}]}