{"scene_id": "s01203", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01203.fountain", "heading": "INT. PAWN SHOP - EVENING", "cast": [{"id": 0, "name": "ODETTE BRIDGEWATER-LANE", "names": ["ODETTE BRIDGEWATER-LANE", "ODETTE"], "gender": "f", "first": 3, "spoke": 5}, {"id": 1, "name": "MARCELINO FARRELL", "names": ["MARCELINO FARRELL", "MARCELINO"], "gender": "?", "first": 4, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. PAWN SHOP - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Glass cases of watches, guitars hung on the wall, a neon OPEN sign buzzing in the window.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The register drawer is half out.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "ODETTE BRIDGEWATER-LANE (60s, widow's black, handbag hugged to her ribs) stands at the counter.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "A wedding ring sits on a velvet pad between her and MARCELINO FARRELL (40s, shirtsleeves, loupe pushed up on his forehead), who turns it under a lamp.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "Thirty dollars.", "name": "MARCELINO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Eighty.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "It's a plain band, Mrs. Bridgewater-Lane.", "name": "MARCELINO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "It's forty-one years.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He sets the loupe down.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She does not blink.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He slides the ring an inch toward her, then an inch back, then taps the glass case and, with a sigh, opens the register, counts out bills, closes it, and counts them again.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Fifty. And I'm robbing myself.", "name": "MARCELINO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Everyone's been robbed by somebody.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She takes the money.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Slips it into the handbag.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Then, without a word, she lifts the ring from the pad and puts it back on her finger.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Ma'am.", "name": "MARCELINO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "I'm sorry. I changed my mind.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Keep the fifty.", "name": "MARCELINO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "No.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She lays the bills on the counter, squares them neatly, and walks out.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "The bell on the door rings once.", "para": 4, "sent": 1, "present": [0, 1]}]}