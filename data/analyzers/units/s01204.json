{"scene_id": "s01204", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01204.fountain", "heading": "INT. MARITIME ARCHIVE - TIDE-TABLE ROOM - DAY", "cast": [{"id": 0, "name": "DETECTIVE SOLEDAD MARQUEZ-OYELARAN", "names": ["DETECTIVE SOLEDAD MARQUEZ-OYELARAN", "SOLEDAD"], "gender": "f", "first": 5, "spoke": 10}, {"id": 1, "name": "ARCHIVIST", "names": ["ARCHIVIST"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "AUGUSTINE FEATHERSTONE", "names": ["AUGUSTINE FEATHERSTONE", "AUGUSTINE"], "gender": "?", "first": 6, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. MARITIME ARCHIVE - TIDE-TABLE ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Floor-to-ceiling shelves of cloth-bound almanacs.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A reading ladder on rails.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A long oak table under a green-shaded lamp.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain on skylights.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DETECTIVE SOLEDAD MARQUEZ-OYELARAN (40s, blazer, notebook) sits at the table with three almanacs open before her.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "At the far end, the ARCHIVIST, AUGUSTINE FEATHERSTONE (60s, bow tie, cotton gloves), shelves a volume on the ladder.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Mr. Featherstone, you said the logs for June are missing.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Not missing. Misfiled.", "name": "AUGUSTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Which is different how?", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Misfiled means they exist, but where they ought to be, they are not.", "name": "AUGUSTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "She lifts a volume.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Flips a page.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Puts it down.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Her eyes track a column of numbers.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "These tides don't match the harbor master's report.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "They wouldn't. Harbor masters report what they hope.", "name": "AUGUSTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "She laughs, once, short.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "He climbs down the ladder, one rung at a time.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "She stands.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "They both reach for the same almanac on the table; her hand covers his.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "They stop.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Sorry.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Quite all right.", "name": "AUGUSTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "They each pull back an inch.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "He dusts the cover with his glove.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "She turns the book to face him.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "June the ninth. High water at 3:12. Yet the dock log has her ship leaving at 2:50.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "She'd have grounded on the bar.", "name": "AUGUSTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Unless she didn't leave at 2:50.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Or the log is wrong.", "name": "AUGUSTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Or somebody wants it to be.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "A long pause.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Rain.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "He removes his gloves, folds them, lays them on the table.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "She watches his hands.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Detective, I've kept these tables for thirty-four years. Not once has a number been altered.", "name": "AUGUSTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Not by you.", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Not by me.", "name": "AUGUSTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Then by whom?", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "He crosses to a shelf and takes down a slim volume with a black spine.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "He carries it to her and lays it open to a page where one entry has been scraped away and rewritten in a different ink.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Her.", "name": "AUGUSTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Who?", "name": "SOLEDAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "The previous archivist. She left in July.", "name": "AUGUSTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Soledad reads the entry.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Then looks at him, and he at her, both of them leaning over the page, and neither of them moves for a long moment.", "para": 7, "sent": 1, "present": [0, 1, 2]}]}