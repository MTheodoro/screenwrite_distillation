{"scene_id": "s01206", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01206.fountain", "heading": "EXT. FERRIS WHEEL - TOP CABIN - NIGHT", "cast": [{"id": 0, "name": "FENELLA", "names": ["FENELLA"], "gender": "?", "first": 5, "spoke": 3}, {"id": 1, "name": "RAUL", "names": ["RAUL"], "gender": "?", "first": 6, "spoke": 3}, {"id": 2, "name": "ABIOLA", "names": ["ABIOLA"], "gender": "?", "first": 7, "spoke": 2}, {"id": 3, "name": "NOLAN", "names": ["NOLAN"], "gender": "m", "first": 8, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FERRIS WHEEL - TOP CABIN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "The wheel has stopped at its peak.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The city glitters below.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wind rocks the cabin.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A duffel bag lies open on the bench.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "FENELLA (30s, black turtleneck) is hunched over a thermal drill.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "RAUL (40s, sunglasses even now) peers out of the window, scanning the ground.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "ABIOLA (20s, headset) mutters coordinates into a radio.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "NOLAN (50s, ex-operator's jacket) sits slumped with his feet on the duffel.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "She jabs the drill at the floor.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "He jerks the curtain.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "She curses.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "He snaps his fingers.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Hold it still.", "name": "FENELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "I'm holding.", "name": "RAUL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Wind's rising. Four knots.", "name": "ABIOLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "We said sixty seconds.", "name": "NOLAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "We said sixty seconds yesterday.", "name": "FENELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "We said sixty seconds before you spilled the thermite.", "name": "RAUL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Everyone, quiet. Security's on the midway.", "name": "ABIOLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "They freeze.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Beneath them the wheel creaks.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "She taps her earpiece.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "He holds his breath.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "They all lean toward the window as a flashlight beam sweeps the base of the wheel.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Don't breathe.", "name": "NOLAN", "speaker": 3, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Then who's talking?", "name": "FENELLA", "speaker": 0, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "You are.", "name": "RAUL", "speaker": 1, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "The beam passes.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "The wheel jolts.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "The cabin begins, very slowly, to descend.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}]}