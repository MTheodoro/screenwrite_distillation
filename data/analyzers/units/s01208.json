{"scene_id": "s01208", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01208.fountain", "heading": "INT. TEA HOUSE - 1893 - AFTERNOON", "cast": [{"id": 0, "name": "LADY BEATRIX HALLORAN-SATO", "names": ["LADY BEATRIX HALLORAN-SATO", "LADY BEATRIX"], "gender": "f", "first": 3, "spoke": 2}, {"id": 1, "name": "MISS PHILIPPA ROOK", "names": ["MISS PHILIPPA ROOK", "MISS ROOK"], "gender": "?", "first": 4, "spoke": 1}, {"id": 2, "name": "EMERIC CAULFIELD", "names": ["EMERIC CAULFIELD", "DR. CAULFIELD"], "gender": "m", "first": 5, "spoke": 2}, {"id": 3, "name": "TAKEO", "names": ["TAKEO"], "gender": "?", "first": 6, "spoke": 0}, {"id": 4, "name": "OTOMO", "names": ["OTOMO"], "gender": "?", "first": 6, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. TEA HOUSE - 1893 - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Lacquered screens, a low table, steam curling from a cast-iron kettle.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rain taps the paper windows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "LADY BEATRIX HALLORAN-SATO (40s, silk kimono over a Western corset) pours tea with deliberate grace.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "Across from her, MISS PHILIPPA ROOK (30s, travelling suit, gloves in her lap) watches the cups.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Beside her, DR. EMERIC CAULFIELD (50s, wing collar) turns his spoon.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "Two servants kneel by the door: TAKEO (20s, precise) and OTOMO (20s, hands folded).", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "action", "text": "She pours Miss Rook's cup last.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "Miss Rook accepts it.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "Neither speaks.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "A fine blend.", "name": "DR. CAULFIELD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "My late husband's.", "name": "LADY BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Miss Rook lifts the cup.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Lady Beatrix watches her lips touch the rim.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Takeo's eyes dart to Otomo.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Otomo's hands tighten.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "It has a faint bitterness.", "name": "MISS ROOK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "So does his memory.", "name": "LADY BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Miss Rook sets the cup down.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "She smooths her gloves.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Dr. Caulfield sips and sets his cup to one side.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "I'm sure it is nothing.", "name": "DR. CAULFIELD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Miss Rook rises.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "She crosses to the window and slides it open an inch.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Rain mists her face.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Lady Beatrix does not turn, but her shoulders loosen by a fraction.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "The kettle sings.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Otomo bows low and does not rise.", "para": 5, "sent": 5, "present": [0, 1, 2, 3, 4]}]}