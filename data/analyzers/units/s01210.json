{"scene_id": "s01210", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01210.fountain", "heading": "INT. AFFINAGE CAVE - CHEESE VAULT - NIGHT", "cast": [{"id": 0, "name": "MARISKA DELACROIX-ODUYA", "names": ["MARISKA DELACROIX-ODUYA", "MARISKA"], "gender": "?", "first": 4, "spoke": 2}, {"id": 1, "name": "BEN", "names": ["BEN"], "gender": "?", "first": 5, "spoke": 3}, {"id": 2, "name": "ANGOLA", "names": ["ANGOLA"], "gender": "?", "first": 5, "spoke": 0}, {"id": 3, "name": "CASPER TREMAINE-LIU", "names": ["CASPER TREMAINE-LIU", "CASPER"], "gender": "m", "first": 6, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. AFFINAGE CAVE - CHEESE VAULT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A limestone tunnel lined with wooden racks of aging wheels, each stamped with a date.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cool mist hangs in the lamplight.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Water drips somewhere deep.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MARISKA DELACROIX-ODUYA (40s, white coat, hairnet) crouches at a rack with a cheese iron, extracting a core sample.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her partner, BENEDICT \"BEN\" ANGOLA (50s, tailored suit under a borrowed apron), holds a flashlight.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "A boy of twenty, CASPER TREMAINE-LIU (20s, security guard's cap), stands rooted at the tunnel mouth, jaw slack.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "She taps a wheel.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "He lifts the lamp.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "She pulls out a plug.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Inside, wrapped in wax paper, a slim steel tube.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "There it is.", "name": "MARISKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "There it is.", "name": "BEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Hey. Hey, that's not allowed.", "name": "CASPER", "speaker": 3, "ext": [], "paren": ["approaching"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Mariska pockets the tube.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Ben swings the lamp up.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Casper stops and raises both hands, and they stare at one another across eight feet of fog.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "I'm only the night guard.", "name": "CASPER", "speaker": 3, "ext": ["CONT'D"], "paren": ["a little desperate"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "We're only the night shift.", "name": "BEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Mariska takes a wheel off the rack, hefts it, and rolls it down the tunnel.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "It gathers speed, thunders off into the dark.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Casper turns to watch it go.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "That was a forty-year Gruyere.", "name": "CASPER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Ben, go.", "name": "MARISKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Mariska, go.", "name": "BEN", "speaker": 1, "ext": [], "paren": ["at the same time"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "They run.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Casper lowers his hands, looks at the empty rack, and then, very slowly, at his own radio.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}]}