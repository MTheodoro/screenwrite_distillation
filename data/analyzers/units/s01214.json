{"scene_id": "s01214", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01214.fountain", "heading": "INT. CALL CENTER IN A FORMER CHURCH - DAY", "cast": [{"id": 0, "name": "BLESSING", "names": ["BLESSING"], "gender": "?", "first": 5, "spoke": 0}, {"id": 1, "name": "DESMOND PEMBERTON-AGYEMAN", "names": ["DESMOND PEMBERTON-AGYEMAN", "DESMOND"], "gender": "?", "first": 6, "spoke": 14}, {"id": 2, "name": "LAVINIA OKORO-HALVERSEN", "names": ["LAVINIA OKORO-HALVERSEN", "LAVINIA"], "gender": "f", "first": 7, "spoke": 14}, {"id": 3, "name": "WORLD'S OKAYEST AGENT", "names": ["WORLD'S OKAYEST AGENT"], "gender": "?", "first": 36, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. CALL CENTER IN A FORMER CHURCH - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Cubicles fill the nave.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Gothic arches overhead, fluorescent panels bolted to the vaulted ceiling.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Where the altar stood, a standing desk with a headset-wearing mannequin.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Stained glass casts blue and amber light on rows of identical monitors.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A hand-lettered banner above the apse reads: \"YOUR CALL IS A BLESSING.\"", "para": 0, "sent": 4, "present": [0]}, {"u": 6, "kind": "action", "text": "At a long table once used for communion, DESMOND PEMBERTON-AGYEMAN (40s, gray suit, lanyard) stands holding a cardboard box of personal effects.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Across from him sits LAVINIA OKORO-HALVERSEN (50s, floral blouse, reading glasses pushed up on her head), the floor manager, a clipboard in her lap.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Desmond. Sit.", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "I'd rather stand, Lavinia.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "It's not a sermon.", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "It feels like one.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "She pats the pew-bench beside her.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "He doesn't move.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "A phone rings somewhere in the nave and is picked up on the second ring.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Fourteen years, Desmond.", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Fifteen in March.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Fifteen. Well, you've done admirable work.", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Is this the part where you tell me why I'm leaving?", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "It isn't a leaving. It's a reallocation.", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Of what?", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Of you.", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "To where?", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Upstairs.", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "We have an upstairs?", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "The bell tower.", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "He looks up.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Far overhead, a narrow staircase vanishes into the rafters.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Dust turns in a shaft of colored light.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "What's in the bell tower?", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "The new quality-assurance team.", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "How many on it?", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "One.", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Who?", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "You.", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Desmond sets the box on the table.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Rummages in it, finds a mug that reads \"WORLD'S OKAYEST AGENT,\" holds it for a long moment, and places it carefully on the desk.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Everyone. A moment, please.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": ["to the nave"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "The call center falls silent.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Forty heads in forty cubicles rise above forty partitions.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "I'm being promoted to the bell tower.", "name": "DESMOND", "speaker": 1, "ext": ["CONT'D"], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Somewhere, a headset clatters to the floor.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Somewhere in the back, someone begins to clap, stops, and thinks better of it.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Please don't make a scene.", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": ["low, to Desmond"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "I'm only making an announcement.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": ["low, to Lavinia"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "That's how scenes begin.", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "He lifts the box.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Turns toward the staircase.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Pauses at the foot of it, one hand on the rail.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Fifteen years. Finally, a view.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "He climbs.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "The stairs creak.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Lavinia lowers the clipboard onto the communion table and gazes up after him, her face unreadable in the colored light.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Do you know, I think he'll do very well up there.", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": ["quietly, to no one"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "A bell rings, once, from high above.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "All forty headsets chime at the same instant: \"Thank you for calling.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Your call is a blessing.\"", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}]}