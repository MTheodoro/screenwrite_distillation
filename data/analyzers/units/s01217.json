{"scene_id": "s01217", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01217.fountain", "heading": "INT. FLORIST'S COLD ROOM - NIGHT", "cast": [{"id": 0, "name": "DETECTIVE IMANI BRAITHWAITE-SOTO", "names": ["DETECTIVE IMANI BRAITHWAITE-SOTO", "IMANI"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "TOBY", "names": ["TOBY"], "gender": "f", "first": 5, "spoke": 3}, {"id": 2, "name": "ABERNETHY-KWON", "names": ["ABERNETHY-KWON"], "gender": "?", "first": 5, "spoke": 0}, {"id": 3, "name": "SERAFINA MOREAU-ODE", "names": ["SERAFINA MOREAU-ODE", "SERAFINA"], "gender": "?", "first": 6, "spoke": 2}, {"id": 4, "name": "CALLUM DRAYTON", "names": ["CALLUM DRAYTON", "CALLUM"], "gender": "m", "first": 7, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. FLORIST'S COLD ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Buckets of white lilies, rows of roses in plastic sleeves.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Breath fogs.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A compressor hums.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DETECTIVE IMANI BRAITHWAITE-SOTO (40s, long coat) stands at the doorway, gun lowered.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across the aisle, TOBIAS \"TOBY\" ABERNETHY-KWON (30s, florist's apron, shears in hand) stands motionless among the lilies.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "Behind him, half hidden by a rack, SERAFINA MOREAU-ODE (30s, wedding dress under a parka) crouches.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "And in the corner, CALLUM DRAYTON (50s, wet suit jacket), the groom, lies on the floor, hand pressed to his side.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "Put down the shears.", "name": "IMANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "I'm not holding them against anyone.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "He's telling the truth.", "name": "SERAFINA", "speaker": 3, "ext": [], "paren": ["from behind the rack"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Then who stabbed him?", "name": "IMANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "She did.", "name": "CALLUM", "speaker": 4, "ext": [], "paren": ["through his teeth"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Everyone looks at the rack.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Serafina rises slowly, empty-handed.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Toby steps in front of her.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "He came at her. She was defending herself.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Mr. Abernethy-Kwon, step aside.", "name": "IMANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "No.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Ms. Moreau-Ode, is that true?", "name": "IMANI", "speaker": 0, "ext": [], "paren": ["to Serafina"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Yes.", "name": "SERAFINA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "She's lying.", "name": "CALLUM", "speaker": 4, "ext": [], "paren": ["to Imani"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Mr. Drayton, don't move. Help is coming.", "name": "IMANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Callum lets his head fall back among the lilies.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Toby lowers the shears and lays them on a bucket.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "He takes Serafina's hand.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Imani holsters her gun and kneels beside Callum, pressing her palm over his hand to hold the wound.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Stay with me.", "name": "IMANI", "speaker": 0, "ext": ["CONT'D"], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Far off, a siren rises.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}]}