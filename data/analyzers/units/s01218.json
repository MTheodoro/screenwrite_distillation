{"scene_id": "s01218", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01218.fountain", "heading": "INT. ORBITAL LAUNDROMAT - ZERO-G - NIGHT CYCLE", "cast": [{"id": 0, "name": "DOROTHY OKONKWO-REYES", "names": ["DOROTHY OKONKWO-REYES", "DOROTHY"], "gender": "?", "first": 5, "spoke": 6}, {"id": 1, "name": "LUDWIG ABDELKADER", "names": ["LUDWIG ABDELKADER", "LUDWIG"], "gender": "?", "first": 6, "spoke": 6}, {"id": 2, "name": "KALINDA ROSENBAUM-PRICE", "names": ["KALINDA ROSENBAUM-PRICE", "KALINDA"], "gender": "?", "first": 7, "spoke": 6}, {"id": 3, "name": "THADDEUS MWANGI-COLE", "names": ["THADDEUS MWANGI-COLE", "THADDEUS"], "gender": "m", "first": 8, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. ORBITAL LAUNDROMAT - ZERO-G - NIGHT CYCLE", "present": []}, {"u": 1, "kind": "action", "text": "A ring-shaped station module lined with front-loading machines.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wet clothes drift in loose clouds.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Each dryer window glows green.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A hand-stamped sign reads: \"NO SOCKS IN THE VENT.\"", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DOROTHY OKONKWO-REYES (40s, mag-boots, plaid shirt tucked in) sits strapped to a bench.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "LUDWIG ABDELKADER (60s, quilted vest) floats upside down above the folding table.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "KALINDA ROSENBAUM-PRICE (20s, a cloud of dark hair held down by a net) clings to a handhold by the change machine.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "And a big, quiet man, THADDEUS MWANGI-COLE (50s, a toolbelt, a single sock stuck to his forehead), hovers by the airlock.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Who put the red one in with the whites?", "name": "DOROTHY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "It wasn't me.", "name": "LUDWIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "It wasn't me.", "name": "KALINDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Then who?", "name": "DOROTHY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Dorothy, we are four people on a ring in orbit. It was one of us.", "name": "LUDWIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Or the ring.", "name": "KALINDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "The ring doesn't do laundry.", "name": "DOROTHY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "It does everything else.", "name": "LUDWIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "It was me.", "name": "THADDEUS", "speaker": 3, "ext": [], "paren": ["peeling the sock from his forehead"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "All three turn.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Thaddeus holds up the red shirt.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Pink cloth drifts around it like a nebula.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Thaddeus.", "name": "DOROTHY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "I thought it would blend.", "name": "THADDEUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "It blended.", "name": "KALINDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Everything is now the color of a salmon.", "name": "LUDWIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Our uniforms were white!", "name": "DOROTHY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "They're coral now.", "name": "THADDEUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "It's not a bad look.", "name": "KALINDA", "speaker": 2, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Kalinda!", "name": "LUDWIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "What? It isn't.", "name": "KALINDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Dorothy unclips from the bench, kicks off, and sails across the module to the nearest dryer.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "She slaps it.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "The drum slows.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Pink socks and shirts tumble in the green glow.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Nobody mention this at the briefing.", "name": "DOROTHY", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Agreed.", "name": "LUDWIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Agreed.", "name": "KALINDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Agreed.", "name": "THADDEUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "The dryer chimes.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "A single white sock floats free.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}]}