{"scene_id": "s01219", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01219.fountain", "heading": "INT. SLEEP CLINIC - OBSERVATION ROOM - NIGHT", "cast": [{"id": 0, "name": "HORTENSE ADEWALE-SUMNER", "names": ["HORTENSE ADEWALE-SUMNER", "HORTENSE"], "gender": "f", "first": 4, "spoke": 7}, {"id": 1, "name": "TECHNICIAN BARNABAS QUILL-MENDOZA", "names": ["TECHNICIAN BARNABAS QUILL-MENDOZA", "BARNABAS"], "gender": "m", "first": 5, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. SLEEP CLINIC - OBSERVATION ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A dim control room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A bank of monitors shows a bedroom set on the other side of a glass wall: a narrow bed, a nightstand, a patient in sensor wires.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Green EEG traces scroll across the screens.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. HORTENSE ADEWALE-SUMNER (50s, cardigan, reading glasses) sits at the console with a pencil behind her ear.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside her, TECHNICIAN BARNABAS QUILL-MENDOZA (20s, scrubs, a tiny plant on his desk) watches the traces with his chin on his hand.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Delta waves are steady.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "He's gone deep.", "name": "BARNABAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Since eleven.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "She sips tea.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Sets the cup down.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Writes a note.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Barnabas shifts in his chair and swivels half-turn toward her.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Doctor, may I ask something?", "name": "BARNABAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "You may ask.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Does anyone ever really sleep in here?", "name": "BARNABAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Everyone sleeps. That's the problem.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "On the monitor, the sleeping patient rolls over.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "A wire tugs loose.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "The trace stutters, flattens, and spikes.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Hortense and Barnabas lean forward at the same moment, shoulders bumping.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Check the electrode.", "name": "HORTENSE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Left temple.", "name": "BARNABAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "He stands.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She stands.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "They both reach for the door at the same time, stop, and she gestures for him to go first.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "He does.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "She hesitates, watching the monitor, then follows.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Through the glass, Barnabas crosses the bedroom, adjusts the wire, and smooths the sleeper's hair.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Hortense stays in the doorway with her arms folded.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "The patient murmurs something.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "The two of them freeze, then look at each other.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "What did he say?", "name": "BARNABAS", "speaker": 1, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Something about a window.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "They wait.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "The sleeper's breathing lengthens.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Barnabas backs away on tiptoe, brushes the plant, and catches it before it falls.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Good catch.", "name": "HORTENSE", "speaker": 0, "ext": ["CONT'D"], "paren": ["whisper"], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Thanks.", "name": "BARNABAS", "speaker": 1, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "They return to the console.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "The traces settle into long green waves.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Hortense picks up the tea, finds it cold, and drinks it anyway.", "para": 7, "sent": 2, "present": [0, 1]}]}