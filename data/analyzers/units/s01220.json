{"scene_id": "s01220", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01220.fountain", "heading": "INT. GRAIN ELEVATOR CONTROL ROOM - NIGHT", "cast": [{"id": 0, "name": "TOMASZ KOWALCZYK", "names": ["TOMASZ KOWALCZYK", "TOMASZ"], "gender": "?", "first": 5, "spoke": 13}, {"id": 1, "name": "ODALYS REYES-MBEKI", "names": ["ODALYS REYES-MBEKI", "ODALYS"], "gender": "f", "first": 7, "spoke": 12}, {"id": 2, "name": "BRANKA ILI", "names": ["BRANKA ILI", "BRANKA"], "gender": "m", "first": 8, "spoke": 9}, {"id": 3, "name": "PETROS ANAGNOS", "names": ["PETROS ANAGNOS", "PETROS"], "gender": "m", "first": 9, "spoke": 7}, {"id": 4, "name": "WILLEM", "names": ["WILLEM"], "gender": "m", "first": 10, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRAIN ELEVATOR CONTROL ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A glass booth bolted to the side of a concrete silo.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dust on every surface.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Gauges tick.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A wall of dead monitors, one live.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "TOMASZ KOWALCZYK (50s, shift supervisor, cardigan over a hi-vis vest) pours coffee into four mugs.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Doesn't spill a drop.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "ODALYS REYES-MBEKI (30s, auditor, grey blazer, laptop bag still on her shoulder) watches the pour.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "BRANKA ILI\u0106 (40s, maintenance, oil-stained thumbs) sits on an overturned bucket, eating sunflower seeds.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "PETROS ANAGNOS (20s, scale operator, headphones around his neck) stares at the live monitor.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "WILLEM (teen, intern, too-big boots) stands by the door like he's waiting to be sent home.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Milk's off. Sorry.", "name": "TOMASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "I don't take milk.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "She doesn't take anything.", "name": "BRANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Everybody takes something.", "name": "TOMASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Odalys sets down her bag.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Sits.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Opens the laptop.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "The fan whirs loud in the quiet.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Truck four's late.", "name": "PETROS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Truck four's always late.", "name": "BRANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Truck four logged two loads Tuesday. The scale shows one.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Nobody moves.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Branka cracks a seed.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Spits the husk into her palm.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Scale drifts.", "name": "TOMASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "It doesn't drift. I calibrate it.", "name": "PETROS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Every Friday.", "name": "BRANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Every Friday.", "name": "PETROS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Then it's eleven tons of wheat that went somewhere.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Eleven. Is that the number?", "name": "TOMASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Eleven point four.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Tomasz slides a mug toward her.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "She doesn't touch it.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "He slides one toward Willem too.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Willem takes it with both hands.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Thanks, Mr. Kowalczyk.", "name": "WILLEM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Tomasz.", "name": "TOMASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Don't encourage him.", "name": "BRANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "You looked at the weighbridge camera?", "name": "PETROS", "speaker": 3, "ext": [], "paren": ["to Odalys"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "It's been offline since March.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Since February.", "name": "BRANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "March.", "name": "TOMASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "February. I filed the ticket.", "name": "BRANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "You filed it in March.", "name": "TOMASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Branka shrugs.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Another seed.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Petros pulls his headphones up over one ear, then lets them drop again.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Somebody wants to say something?", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Silence.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Outside, a conveyor belt shifts and groans.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "The mugs steam.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "Truck four's here.", "name": "WILLEM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Headlights sweep across the glass.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "Everyone turns.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Nobody stands.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Let him wait.", "name": "TOMASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "He'll honk.", "name": "PETROS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "He won't.", "name": "BRANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "A long beat.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "No honk.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "That's what I thought.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "She types something.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "Tomasz drinks his coffee.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "His hand is perfectly steady.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "You drove four hours for this?", "name": "TOMASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "dialogue", "text": "Five. Traffic.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "dialogue", "text": "Petros, show her the book.", "name": "BRANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "dialogue", "text": "What book?", "name": "PETROS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "dialogue", "text": "The paper book.", "name": "BRANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "dialogue", "text": "There isn't a book.", "name": "PETROS", "speaker": 3, "ext": [], "paren": ["too fast"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "action", "text": "Branka looks at him.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "action", "text": "Cracks a seed.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "action", "text": "Looks at Tomasz.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "dialogue", "text": "There's a book.", "name": "TOMASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "action", "text": "Petros opens a drawer.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 76, "kind": "action", "text": "Takes out a battered green ledger.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 77, "kind": "action", "text": "Doesn't hand it over.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 78, "kind": "action", "text": "Holds it flat on his knees.", "para": 15, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 79, "kind": "dialogue", "text": "I'll need that.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 80, "kind": "dialogue", "text": "In the morning.", "name": "TOMASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 81, "kind": "dialogue", "text": "Now.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 82, "kind": "dialogue", "text": "The morning, Ms. Reyes-Mbeki. Coffee first. Sleep. Then the book.", "name": "TOMASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 83, "kind": "action", "text": "Odalys closes the laptop halfway.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 84, "kind": "action", "text": "Studies each face in turn.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 85, "kind": "action", "text": "Willem looks at the floor.", "para": 16, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 86, "kind": "action", "text": "Branka looks at the ceiling.", "para": 16, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 87, "kind": "action", "text": "Petros looks at the ledger.", "para": 16, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 88, "kind": "action", "text": "Tomasz smiles, mild as milk that isn't off.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 89, "kind": "dialogue", "text": "Fine.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 90, "kind": "action", "text": "She picks up the mug.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 91, "kind": "action", "text": "Drinks.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 92, "kind": "action", "text": "Makes a small face.", "para": 18, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 93, "kind": "dialogue", "text": "It's cold.", "name": "ODALYS", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 94, "kind": "dialogue", "text": "It was hot when I poured it.", "name": "TOMASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 95, "kind": "action", "text": "Outside, the headlights go out.", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 96, "kind": "transition", "text": "FADE OUT.", "present": [0, 1, 2, 3, 4]}]}