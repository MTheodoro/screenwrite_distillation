{"scene_id": "s01221", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01221.fountain", "heading": "INT. LIGHTHOUSE KEEPER'S COTTAGE - KITCHEN - DUSK", "cast": [{"id": 0, "name": "HANNELORE VOSS", "names": ["HANNELORE VOSS", "HANNELORE"], "gender": "?", "first": 3, "spoke": 13}, {"id": 1, "name": "INGRID VOSS", "names": ["INGRID VOSS", "INGRID"], "gender": "?", "first": 3, "spoke": 7}, {"id": 2, "name": "DESMOND OKAFOR", "names": ["DESMOND OKAFOR", "DESMOND"], "gender": "?", "first": 5, "spoke": 6}, {"id": 3, "name": "RADIO", "names": ["RADIO"], "gender": "?", "first": 23, "spoke": 2}, {"id": 4, "name": "^INGRID", "names": ["^INGRID"], "gender": "?", "first": 41, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. LIGHTHOUSE KEEPER'S COTTAGE - KITCHEN - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "A stove, a table, a window full of grey sea.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A radio crackles on the shelf.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "HANNELORE VOSS (60s, retired keeper, sleeves rolled) peels potatoes.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "Her daughter INGRID VOSS (30s, city coat still on) hasn't sat down.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Across the table, DESMOND OKAFOR (40s, estate agent, folder in hand) waits with a patient smile.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Tea?", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "We're fine, thank you.", "name": "DESMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Ingrid?", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Mum, sit down.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Hannelore keeps peeling.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "The skin curls into the sink.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "The valuation is generous, Mrs. Voss. The Trust will keep the light running.", "name": "DESMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "It's been running since 1894.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "It's been failing since 2009.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "The structural report was quite specific.", "name": "DESMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Hannelore sets down the knife.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Wipes her hands, slowly, on a cloth.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "She read the report before I did. She always was quick.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Ingrid looks away.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Mum.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Your father painted that railing every spring. She remembers.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "The radio hisses.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Coastguard to Skerry Light. Weather warning. Gale force nine from the northwest by twenty hundred. Over.", "name": "RADIO", "speaker": 3, "ext": ["V.O."], "paren": ["crackling"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Nobody moves.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Hannelore doesn't reach for the handset.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Shouldn't someone answer that?", "name": "DESMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "It's a recording. They stopped sending real people years ago.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Sign it, Mum.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "She wants me gone before the storm.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "I want you warm.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "I was warm when she left for London.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Ingrid's jaw sets.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Desmond slides the folder an inch closer.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Don't push that at me.", "name": "HANNELORE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Mrs. Voss, I only--", "name": "DESMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Just let her breathe.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Stop talking for me!", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "It's a standard form!", "name": "DESMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Both speak at once.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "You sold the house in Kiel.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "You buried Dad here.", "name": "^INGRID", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Silence.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "The wind finds the window frame.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "He wanted the sea.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "He wanted you to leave. He told me. In the hospital.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Hannelore hurls the potato.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "It strikes the wall, bursts, slides down the paint.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Liar!", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Ingrid doesn't flinch.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Desmond stands.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Nobody sits again.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "Coastguard to Skerry Light. Do you copy? Over.", "name": "RADIO", "speaker": 3, "ext": ["V.O."], "paren": ["crackling"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Hannelore crosses to the shelf.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "Picks up the handset.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Looks at it.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Puts it down.", "para": 13, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "The pen lies on the folder.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "She takes it.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "transition", "text": "FADE OUT.", "present": [0, 1, 2, 3, 4]}]}