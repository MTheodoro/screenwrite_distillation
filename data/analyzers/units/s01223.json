{"scene_id": "s01223", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01223.fountain", "heading": "EXT. SALT FLAT - MIDDAY", "cast": [{"id": 0, "name": "BELLAMY", "names": ["BELLAMY"], "gender": "?", "first": 5, "spoke": 0}, {"id": 1, "name": "JUNIOR AKINTOLA", "names": ["JUNIOR AKINTOLA", "JUNIOR"], "gender": "m", "first": 7, "spoke": 6}, {"id": 2, "name": "OLD DASH", "names": ["OLD DASH", "DASH"], "gender": "f", "first": 8, "spoke": 7}, {"id": 3, "name": "CORAZ\u00d3N", "names": ["CORAZ\u00d3N"], "gender": "f", "first": 5, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SALT FLAT - MIDDAY", "present": []}, {"u": 1, "kind": "action", "text": "White to every horizon.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The heat doesn't shimmer so much as hum.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A pickup truck lies on its side, one wheel still turning, as if the world hadn't told it to stop.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Three figures sit in the narrow shadow of the chassis, barely a hand's width of shade.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "CORAZ\u00d3N BELLAMY (50s, geologist, wide hat, lips cracked white) holds a canteen to the light and shakes it.", "para": 2, "sent": 0, "present": [0, 3]}, {"u": 6, "kind": "action", "text": "Almost nothing sloshes.", "para": 2, "sent": 1, "present": [0, 3]}, {"u": 7, "kind": "action", "text": "JUNIOR AKINTOLA (20s, driver, one sleeve torn off and wrapped around a swollen wrist) rocks in place, breathing through his teeth.", "para": 3, "sent": 0, "present": [0, 1, 3]}, {"u": 8, "kind": "action", "text": "OLD DASH, a woman of seventy known to everyone as DASH (rancher's daughter, braided silver hair, eyes narrowed to cracks), cuts a strip from her shirt with a pocketknife and does not look up.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "It's six miles.", "name": "JUNIOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "It's nine.", "name": "DASH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "It's eleven if we drift north.", "name": "CORAZ\u00d3N", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "We can do eleven.", "name": "JUNIOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "You can't do three.", "name": "DASH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "He opens his mouth.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Closes it.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "The wrapped wrist twitches against his chest.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "We wait for dusk.", "name": "CORAZ\u00d3N", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Dusk, we're dead.", "name": "JUNIOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Dusk, we're alive and walking.", "name": "DASH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Dusk, nobody comes. Nobody even knows.", "name": "JUNIOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Somebody knows.", "name": "CORAZ\u00d3N", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "A silence in which the metal ticks.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Dash ties the strip around his wrist in a tight, practical knot.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "He yelps.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "She pats the knot twice, as if it were a dog.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "A sound.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "High, thin.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Not wind.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Not metal.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "All three go still.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "The sound again, rising.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "A pinprick of glare on the horizon, moving.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Is that...", "name": "JUNIOR", "speaker": 1, "ext": [], "paren": ["whispers"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Don't.", "name": "CORAZ\u00d3N", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Mirror. Coraz\u00f3n, your mirror.", "name": "DASH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Coraz\u00f3n scrabbles in her vest.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Pulls out a cracked compact.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Flips it open.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Catches the sun and throws a white coin of light across the flat.", "para": 9, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Left. Left, left!", "name": "JUNIOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "I know!", "name": "CORAZ\u00d3N", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Slow. Don't flash it. Hold it steady.", "name": "DASH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "The glare grows.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "A quad bike, kicking a plume of white.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "It slows.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Stops fifty yards off.", "para": 10, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "A hand rises from the rider.", "para": 10, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Junior breaks.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Laughs, a wet cracked sound.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Slides down against the wheel and lets his head fall back.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Coraz\u00f3n lowers the mirror.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Her hand is shaking now, finally.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Dash lays her palm over it, firm, and holds it there.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Good girl.", "name": "DASH", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Don't call me that.", "name": "CORAZ\u00d3N", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Drink.", "name": "DASH", "speaker": 2, "ext": [], "paren": ["almost a smile"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "She passes the canteen.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "Coraz\u00f3n drinks the last of it.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "Hands it to Junior first.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "transition", "text": "FADE OUT.", "present": [0, 1, 2, 3]}]}