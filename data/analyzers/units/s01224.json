{"scene_id": "s01224", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01224.fountain", "heading": "INT. ABANDONED CARNIVAL HOUSE OF MIRRORS - NIGHT", "cast": [{"id": 0, "name": "MARISOL QUINTANA", "names": ["MARISOL QUINTANA", "MARISOL"], "gender": "?", "first": 3, "spoke": 2}, {"id": 1, "name": "CATALINA QUINTANA", "names": ["CATALINA QUINTANA", "CATALINA"], "gender": "?", "first": 3, "spoke": 2}, {"id": 2, "name": "LIAM FAIRWEATHER", "names": ["LIAM FAIRWEATHER", "LIAM"], "gender": "m", "first": 5, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED CARNIVAL HOUSE OF MIRRORS - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cracked glass everywhere.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A flashlight beam jitters across a hundred reflections.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "MARISOL QUINTANA (20s, hoodie, camera on a strap) walks backward, panning.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "Her sister CATALINA QUINTANA (20s, same hoodie, different colour) holds the light.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Between them, LIAM FAIRWEATHER (20s, rental-car keys in a fist) steps on glass and swears under his breath.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Stay close.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "I am close.", "name": "CATALINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "She's closer than you.", "name": "LIAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Something thumps on the other side of the glass.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "All three freeze.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Catalina swings the light.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Nothing.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Only their own faces, split into pieces.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Count.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Three.", "name": "CATALINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Count the reflections.", "name": "LIAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "She does.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Her lips move.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "She gets to a number and stops.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "A breath, not theirs, fogs the mirror at the end of the corridor.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "A shape steps out of it that is not one of them.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Marisol lifts the camera.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Her hands don't shake.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "She presses record.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Liam drops the keys.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "They ring on the floor like a bell.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "The light dies.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "transition", "text": "CUT TO BLACK.", "present": [0, 1, 2]}]}