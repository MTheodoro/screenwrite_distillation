{"scene_id": "s01225", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01225.fountain", "heading": "INT. DRIVING SCHOOL CAR - PARKING LOT - DAY", "cast": [{"id": 0, "name": "GRETCHEN LUND", "names": ["GRETCHEN LUND", "GRETCHEN"], "gender": "f", "first": 3, "spoke": 5}, {"id": 1, "name": "GUSTAVO PEREIRA", "names": ["GUSTAVO PEREIRA", "GUSTAVO"], "gender": "?", "first": 4, "spoke": 1}, {"id": 2, "name": "GUSTAVO'S MOTHER", "names": ["GUSTAVO'S MOTHER"], "gender": "?", "first": 5, "spoke": 0}, {"id": 3, "name": "TIMA", "names": ["TIMA"], "gender": "?", "first": 5, "spoke": 0}, {"id": 4, "name": "F\u00c1TIMA", "names": ["F\u00c1TIMA"], "gender": "f", "first": 5, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRIVING SCHOOL CAR - PARKING LOT - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A dented Corolla with a roof sign and a dual brake pedal.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cones in a tight figure-eight.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "GRETCHEN LUND (60s, instructor, clipboard, whistle) rides shotgun.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "GUSTAVO PEREIRA (30s, nervous student) grips the wheel.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "In the back seat, GUSTAVO'S MOTHER, DONA F\u00c1TIMA (60s, handbag on her lap), watches both.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 6, "kind": "dialogue", "text": "Mirror, signal, ease off.", "name": "GRETCHEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "dialogue", "text": "Mirror, signal...", "name": "GUSTAVO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "Signal, filho.", "name": "F\u00c1TIMA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "He nudges the stalk.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Wipers start.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "He tries again.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Washer fluid sprays.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Other one.", "name": "GRETCHEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Your father also never knew his stalks.", "name": "F\u00c1TIMA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Ma'am, I'd ask you not to comment.", "name": "GRETCHEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "F\u00e1tima presses her lips together.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Gustavo finds the indicator.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "It ticks.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "He takes the first cone.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Clips it.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "It rolls under the bumper with a thunk.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "That's a fail. Reset.", "name": "GRETCHEN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "It was a very small cone.", "name": "F\u00c1TIMA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "It was a regulation cone!", "name": "GRETCHEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "She snaps the clipboard against her knee.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "He flinches.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "His foot slips off the clutch.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "The Corolla bucks, stalls.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "The indicator ticks.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "He leans his forehead against the wheel.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Maybe I should drive.", "name": "F\u00c1TIMA", "speaker": 4, "ext": [], "paren": ["sweetly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Both look at her.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "She smiles.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Gretchen slowly takes a whistle from her mouth.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "transition", "text": "FADE OUT.", "present": [0, 1, 2, 3, 4]}]}