{"scene_id": "s01228", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01228.fountain", "heading": "INT. REHEARSAL STUDIO - FORMER BELL FOUNDRY - AFTERNOON", "cast": [{"id": 0, "name": "OZZIE", "names": ["OZZIE"], "gender": "?", "first": 4, "spoke": 10}, {"id": 1, "name": "TREMBLAY", "names": ["TREMBLAY"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "DELPHINE MARCHAND", "names": ["DELPHINE MARCHAND", "DELPHINE"], "gender": "f", "first": 7, "spoke": 4}, {"id": 3, "name": "HIRO TANABE", "names": ["HIRO TANABE", "HIRO"], "gender": "m", "first": 8, "spoke": 4}, {"id": 4, "name": "MARGIT", "names": ["MARGIT"], "gender": "?", "first": 13, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. REHEARSAL STUDIO - FORMER BELL FOUNDRY - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "A long brick hall that smells of cold metal and dust.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sunlight slants through high windows onto a row of bronze bells hung on a rack like sleeping bats.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single upright piano, lid open.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "OSWALDO \"OZZIE\" TREMBLAY (60s, choirmaster, silk scarf, a frail dignity) stands at the piano, turning pages of a score that does not need turning.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Three chairs.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Only two are filled.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "DELPHINE MARCHAND (30s, soprano, beautiful in a distracted way) hums a scale under her breath.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "HIRO TANABE (30s, baritone, sleeves rolled, forearm tattoo of a tide chart) studies his phone.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "The third chair is empty.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Ozzie glances at it.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Glances away.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Shall we start from the Agnus Dei?", "name": "OZZIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Ozzie, Margit isn't here.", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "She's running late.", "name": "OZZIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "She's been running late for six weeks.", "name": "HIRO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Hiro.", "name": "OZZIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "I'm only saying.", "name": "HIRO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "She texted me. She said she'd be here.", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "There. You see?", "name": "OZZIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "He sets the score on the piano.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Presses a chord.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "It rings in the hall for a long moment and slowly dies against the bronze.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "It's nice. The light. It's nice in here today.", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "It is.", "name": "OZZIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "He smiles at her.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "It is a kind smile and it takes nearly everything he has.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "The telephone at the back of the hall rings.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "An old black rotary.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Everyone looks.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Nobody rises.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "It rings six times.", "para": 8, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Ozzie crosses at last and lifts the receiver.", "para": 8, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Foundry. Yes.", "name": "OZZIE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "He listens.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "His hand tightens on the cord.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Ozzie. It's me. I'm at the hospital.", "name": "MARGIT", "speaker": 4, "ext": ["V.O."], "paren": ["through the receiver, thin"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Where, Margit?", "name": "OZZIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "St. Anne's. They said it's... They said it's quiet. They said you'd want to know before the others.", "name": "MARGIT", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Thank you, my dear.", "name": "OZZIE", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "He hangs up.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "For a moment he doesn't turn.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Then he does, and the two of them look at his face, and they know.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Ozzie?", "name": "HIRO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Who was it?", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "The thing about a bell is that it doesn't ring because you strike it.", "name": "OZZIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Ozzie.", "name": "HIRO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "It rings because of what it's shaped like on the inside.", "name": "OZZIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "He takes a mallet from the rack.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Lifts it.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "The largest bell swings gently, and he strikes it once.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "The note fills the hall, enormous and golden, and the two singers stand slowly as it fades.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "transition", "text": "FADE OUT.", "present": [0, 1, 2, 3, 4]}]}