{"scene_id": "s01230", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01230.fountain", "heading": "INT. NATURAL HISTORY MUSEUM - TAXIDERMY COLD STORE - NIGHT", "cast": [{"id": 0, "name": "YEVGENY BRODSKY", "names": ["YEVGENY BRODSKY", "YEVGENY"], "gender": "m", "first": 4, "spoke": 11}, {"id": 1, "name": "BASIL ACHTERBERG", "names": ["BASIL ACHTERBERG", "BASIL"], "gender": "m", "first": 7, "spoke": 11}], "units": [{"u": 0, "kind": "heading", "text": "INT. NATURAL HISTORY MUSEUM - TAXIDERMY COLD STORE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A walk-in freezer the size of a school gym.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Steel racks of stuffed animals wrapped in clear plastic: a bear, a pair of okapi, a flock of sealed albatrosses.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The hum of the compressors is constant.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "YEVGENY BRODSKY (40s, quilted jacket, frost on his eyebrows) kneels at a floor safe.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "A stethoscope hangs around his neck.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "He turns the dial a quarter click at a time.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "BASIL ACHTERBERG (60s, museum night guard's uniform, crisp, keys at his belt) stands over him with a thermos.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He pours tea into the cap and offers it down.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I'm good.", "name": "YEVGENY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "It's minus eighteen. You're shivering.", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I'm concentrating.", "name": "YEVGENY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Yevgeny doesn't look up.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Basil sips the tea himself.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Looks at a polar bear in its plastic shroud, nods to it like an old neighbour.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "You like the quiet?", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "I like it when nobody talks.", "name": "YEVGENY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "He used to say that. Your father.", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Yevgeny's hand stops.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Just for a heartbeat.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "The dial doesn't move.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "You said you didn't know him.", "name": "YEVGENY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "I said I didn't know him well.", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "He screws the cap back on the thermos.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "His expression is mild, neighbourly.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Yevgeny resumes the dial.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Click.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Click.", "para": 5, "sent": 4, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Click.", "para": 5, "sent": 5, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "The safe clunks open.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Inside, a velvet bag.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Yevgeny lifts it, weighs it, loosens the drawstring.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "A heavy stone slides into his glove: a rough diamond the size of a plum.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "There you are.", "name": "YEVGENY", "speaker": 0, "ext": ["CONT'D"], "paren": ["low"], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "It's smaller than I thought.", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "It's always smaller.", "name": "YEVGENY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Put it back.", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Yevgeny looks up.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "The thermos is still in Basil's right hand.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "In his left, steady as a stone, is a small black pistol.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Basil.", "name": "YEVGENY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Put it back in the bag. Pull the string. Slide the bag back on the shelf. Close the door.", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "We said sixty-forty.", "name": "YEVGENY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "We did.", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "You said you were retiring.", "name": "YEVGENY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "I am. Tonight.", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Yevgeny draws the string slowly.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Laying the bag in the safe, his hand lingers.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Frost creeps up his sleeve.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "How long have you known?", "name": "YEVGENY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "He told me what you'd come for. Before he died. He asked me to stand here.", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "Yevgeny closes the safe door.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "The sound is small and final.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "He sits back on his heels, hands visible on his knees.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "He said that?", "name": "YEVGENY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "He said, my boy will want to be a thief. Be there when he does.", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "A long silence.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "The compressors hum.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "Basil lowers the pistol.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "Sets it on the nearest rack, next to the polar bear.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "Unscrews the thermos.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "Pours another cap of tea.", "para": 11, "sent": 3, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "He holds it out.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "This time Yevgeny takes it.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 64, "kind": "transition", "text": "FADE OUT.", "present": [0, 1]}]}