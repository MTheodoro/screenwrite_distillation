{"scene_id": "s01232", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01232.fountain", "heading": "INT. FERRY TERMINAL WAITING ROOM - IMPROVISED COURTROOM - DAY", "cast": [{"id": 0, "name": "JUDGE ZUZANNA PRZYBYLSKA", "names": ["JUDGE ZUZANNA PRZYBYLSKA", "JUDGE PRZYBYLSKA"], "gender": "?", "first": 5, "spoke": 12}, {"id": 1, "name": "ATTORNEY CASSIUS WREN", "names": ["ATTORNEY CASSIUS WREN", "WREN"], "gender": "?", "first": 7, "spoke": 8}, {"id": 2, "name": "CANCELLED", "names": ["CANCELLED"], "gender": "?", "first": 22, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. FERRY TERMINAL WAITING ROOM - IMPROVISED COURTROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Plastic chairs.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Vending machines unplugged.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A folding table with a flag taped to its front.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Ferry schedules still on the wall.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "JUDGE ZUZANNA PRZYBYLSKA (60s, robe over a parka) taps a gavel made from a ship's wrench.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Rain on the glass.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "ATTORNEY CASSIUS WREN (30s, wet suit jacket, bag of files) stands alone at the counter where tickets were once sold.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "All rise.", "name": "JUDGE PRZYBYLSKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Nobody else is present.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Wren stays standing.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "The judge sits, unbothered.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Be seated. Ferry's cancelled. Court is in session.", "name": "JUDGE PRZYBYLSKA", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the empty chairs"], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Wren sets down the files.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "They slide.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "He catches them with a forearm, a small rescue.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Your Honour. My client's absent.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Where?", "name": "JUDGE PRZYBYLSKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "The ferry.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Of course.", "name": "JUDGE PRZYBYLSKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She writes.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Wren shuffles a sheet.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Behind him the departures board flickers: CANCELLED, CANCELLED, CANCELLED.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Two hours of driving for this.", "name": "WREN", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Counsel?", "name": "JUDGE PRZYBYLSKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Nothing, Your Honour.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Proceed.", "name": "JUDGE PRZYBYLSKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "He clears his throat and addresses the empty rows as if a jury sat there.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Ladies and gentlemen, the question today is simple.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "There's no jury, Mr. Wren.", "name": "JUDGE PRZYBYLSKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Habit.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Break it.", "name": "JUDGE PRZYBYLSKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Wren nods.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "He takes a long breath.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "His shoulders drop.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "The fight leaves him like air from a tyre.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "The judge sets down her pen, takes off her glasses, and rubs the bridge of her nose.", "para": 7, "sent": 4, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Motion granted. Default stays. Go home, son.", "name": "JUDGE PRZYBYLSKA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "That's it?", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "That's it.", "name": "JUDGE PRZYBYLSKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "He gathers the files, drops one, picks it up, drops another.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "She waits until he is at the door.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Good lawyer. Terrible week.", "name": "JUDGE PRZYBYLSKA", "speaker": 0, "ext": ["CONT'D"], "paren": ["to herself, soft"], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "He pauses in the doorway.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Doesn't turn.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "I heard that.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "You were meant to.", "name": "JUDGE PRZYBYLSKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "He goes out into the rain.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "She turns the wrench-gavel over in her hands, then sets it carefully back on its cradle and stares at the board: CANCELLED.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "transition", "text": "FADE OUT.", "present": [0, 1, 2]}]}