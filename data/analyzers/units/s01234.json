{"scene_id": "s01234", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01234.fountain", "heading": "INT. ROOFTOP BOXING RING - BETWEEN ROUNDS - NIGHT", "cast": [{"id": 0, "name": "DELROY", "names": ["DELROY"], "gender": "?", "first": 4, "spoke": 2}, {"id": 1, "name": "STANTON", "names": ["STANTON"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "ISAURA CAMPOS", "names": ["ISAURA CAMPOS", "ISAURA"], "gender": "m", "first": 5, "spoke": 4}, {"id": 3, "name": "RN HALVORSEN", "names": ["RN HALVORSEN"], "gender": "?", "first": 6, "spoke": 0}, {"id": 4, "name": "BJ\u00d6RN", "names": ["BJ\u00d6RN"], "gender": "?", "first": 6, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROOFTOP BOXING RING - BETWEEN ROUNDS - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A ring bolted to a car-park roof.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "City glare behind the ropes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wind flaps a banner.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DELROY \"BLACKJACK\" STANTON (30s, boxer) slumps on the stool, chest heaving, one eye swollen.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "ISAURA CAMPOS (50s, trainer, towel over her shoulder) crouches in front of him.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "BJ\u00d6RN HALVORSEN (60s, cutman, glove-stained thumbs) works on the eye.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "dialogue", "text": "Look at me.", "name": "ISAURA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "Hold still.", "name": "BJ\u00d6RN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "I'm fine.", "name": "DELROY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "You're not fine. You're dropping the left.", "name": "ISAURA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Don't talk. I've got a hole here.", "name": "BJ\u00d6RN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "She keeps coming in under.", "name": "DELROY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Then step back and counter. Step back.", "name": "ISAURA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Chin up.", "name": "BJ\u00d6RN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "She slaps the water bottle into his hand.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "He rinses, spits into the bucket.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Bj\u00f6rn swabs.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "A bell rings.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Delroy rises.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Isaura pushes him into the ring.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Left hand, Jack!", "name": "ISAURA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Go, go, go!", "name": "BJ\u00d6RN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "transition", "text": "FADE OUT.", "present"