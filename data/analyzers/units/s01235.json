{"scene_id": "s01235", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01235.fountain", "heading": "INT. COIN LAUNDRY - NIGHT", "cast": [{"id": 0, "name": "FRANKIE DOLAN", "names": ["FRANKIE DOLAN", "FRANKIE"], "gender": "?", "first": 7, "spoke": 3}, {"id": 1, "name": "MEI-LING WONG", "names": ["MEI-LING WONG", "MEI-LING"], "gender": "?", "first": 8, "spoke": 2}, {"id": 2, "name": "OBI NWANKWO", "names": ["OBI NWANKWO", "OBI"], "gender": "m", "first": 9, "spoke": 2}, {"id": 3, "name": "SABINE ARCAND", "names": ["SABINE ARCAND", "SABINE"], "gender": "?", "first": 10, "spoke": 1}, {"id": 4, "name": "RUFUS BELL", "names": ["RUFUS BELL", "RUFUS"], "gender": "?", "first": 11, "spoke": 1}, {"id": 5, "name": "TAMSIN PRICE", "names": ["TAMSIN PRICE", "TAMSIN"], "gender": "?", "first": 12, "spoke": 2}, {"id": 6, "name": "^RUFUS", "names": ["^RUFUS"], "gender": "?", "first": 27, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. COIN LAUNDRY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dryers tumble.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Plastic chairs.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A vending machine hums.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Six regulars huddle around a folding table.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "They're holding a wake for the shop's owner.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "He's laid out in a framed photo between the detergent boxes.", "para": 1, "sent": 2, "present": []}, {"u": 7, "kind": "action", "text": "FRANKIE DOLAN lifts a paper cup.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "MEI-LING WONG nods.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "OBI NWANKWO wipes his eyes.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "SABINE ARCAND folds a towel without looking.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "RUFUS BELL stares at the floor.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "The youngest, TAMSIN PRICE, taps her phone.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "To Gus.", "name": "FRANKIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "To Gus.", "name": "MEI-LING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Sixty years of quarters.", "name": "OBI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "He never gave me change once.", "name": "RUFUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "He gave me change twice.", "name": "SABINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "He gave me a free sock.", "name": "TAMSIN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "They all look at her.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "A sock?", "name": "OBI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "One. He said the other would turn up.", "name": "TAMSIN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "It always does.", "name": "FRANKIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Never.", "name": "MEI-LING", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "They laugh, quietly, then stop.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "The dryers keep turning.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "I'll miss him.", "name": "FRANKIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "I'll miss him.", "name": "^RUFUS", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "They glance at one another, startled by the echo.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "She puts her phone away.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "He swallows.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "The vending machine thuds out a bag of chips.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "transition", "text": "FADE OUT.", "present": [0, 1, 2, 3, 4, 5, 6]}]}