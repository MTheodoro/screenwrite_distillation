{"scene_id": "s01236", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01236.fountain", "heading": "INT. AUCTION HOUSE - FREIGHT ELEVATOR - NIGHT", "cast": [{"id": 0, "name": "HOLLIS CARMICHAEL-REEVE", "names": ["HOLLIS CARMICHAEL-REEVE", "HOLLIS"], "gender": "?", "first": 6, "spoke": 13}, {"id": 1, "name": "TRINH VO", "names": ["TRINH VO", "TRINH"], "gender": "?", "first": 7, "spoke": 11}, {"id": 2, "name": "ALOUETTE PICARD", "names": ["ALOUETTE PICARD", "ALOUETTE"], "gender": "f", "first": 8, "spoke": 7}, {"id": 3, "name": "GUARD", "names": ["GUARD"], "gender": "?", "first": 58, "spoke": 9}, {"id": 4, "name": "^ALOUETTE", "names": ["^ALOUETTE"], "gender": "?", "first": 69, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. AUCTION HOUSE - FREIGHT ELEVATOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A caged industrial lift with a scarred wooden floor.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A control panel with a brass key switch.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The elevator descends slowly, cables creaking, between concrete shaft walls.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Three figures in grey janitorial coveralls stand in the car.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "A rolling mop bucket sits in the corner.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "HOLLIS CARMICHAEL-REEVE (50s, crew boss, bifocals on a cord) reads a clipboard like a recipe.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "TRINH VO (30s, wiry, hair under a cap) crouches by the bucket and checks the wringer for something that isn't water.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "ALOUETTE PICARD (40s, grim, gloves tight) presses her palm against the elevator wall and counts the seconds under her breath.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Sub-basement in forty.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Thirty-eight.", "name": "TRINH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Thirty-eight.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Camera's looping. Twenty minutes, maybe twenty-two.", "name": "ALOUETTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Maybe?", "name": "TRINH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Twenty.", "name": "ALOUETTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Say twenty.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "The cables squeal.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "The lift lurches and settles.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Somewhere above, a muffled bell rings the hour.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "When the doors open, we are cleaners. We move slow. We do not look at the vault.", "name": "HOLLIS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "We look at the floor.", "name": "TRINH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "We look at the floor.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "What if there's a guard?", "name": "ALOUETTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "There's a guard.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "What if he's awake?", "name": "ALOUETTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "He's awake. He's always awake. Four weeks, he's seen us.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "He likes us.", "name": "TRINH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "He likes your biscuits.", "name": "ALOUETTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "They're my mother's.", "name": "TRINH", "speaker": 1, "ext": [], "paren": ["blushing"], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "The elevator slows, and the cables go quiet.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "A soft ding.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The doors slide open on a concrete corridor lit in sickly green.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "At the far end, a lone guard's desk with a lamp, a thermos, and a newspaper.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "The chair is empty.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Nobody moves.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "That's not right.", "name": "TRINH", "speaker": 1, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Move.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "They shuffle out, bucket first.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "The wheels squeak on the concrete.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Halfway down the corridor, the lamp on the desk clicks off.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "The corridor goes darker.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Hollis.", "name": "ALOUETTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Keep moving.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Twenty minutes, he said. He doesn't go to the bathroom.", "name": "TRINH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "They stop.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "In the dark, a steel door at the corridor's end is open a hand's width.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "A strip of cold light falls on the floor.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Hollis lifts the clipboard.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Reads it again.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Lowers it.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Right. New plan.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "We have a plan?", "name": "TRINH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "We have a mop.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "He lifts the mop out of the bucket.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Taps the vault door open with its handle.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "It swings wide.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Inside, rows of locked cases line the walls under blue light.", "para": 12, "sent": 3, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "And in the middle, sitting cross-legged on a crate with a flask in one hand and his cap tilted back, is the GUARD (60s, leathery, content), eating one of Trinh's mother's biscuits.", "para": 12, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "Evening, team.", "name": "GUARD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "Nobody breathes.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "You're early. I wasn't expecting you till two.", "name": "GUARD", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "We had a cancellation.", "name": "TRINH", "speaker": 1, "ext": [], "paren": ["squeaking"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "Hm.", "name": "GUARD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "He chews.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "Swallows.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "Gestures with the biscuit toward the cases.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "Mind the lemon polish. The Tiffany lamp's sensitive.", "name": "GUARD", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "Of course.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "dialogue", "text": "Of course.", "name": "^ALOUETTE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "dialogue", "text": "Not a problem.", "name": "TRINH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "action", "text": "They file in.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "action", "text": "The guard watches them go by, one eyebrow raised.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "action", "text": "As Alouette passes, he catches her sleeve.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "dialogue", "text": "Whatever you've planned, do it tonight. I retire at dawn.", "name": "GUARD", "speaker": 3, "ext": ["CONT'D"], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "dialogue", "text": "Understood.", "name": "ALOUETTE", "speaker": 2, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 76, "kind": "action", "text": "She pulls her sleeve free.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 77, "kind": "action", "text": "Trinh begins to laugh, a high sound, and Hollis clamps a hand over his mouth.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 78, "kind": "action", "text": "The guard offers the biscuit tin.", "para": 16, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 79, "kind": "dialogue", "text": "Anyone?", "name": "GUARD", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 80, "kind": "action", "text": "The lights in the corridor behind them go out.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 81, "kind": "action", "text": "Then, one by one, the lights in the vault.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 82, "kind": "dialogue", "text": "Nobody panic.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 83, "kind": "dialogue", "text": "Oh, that's just me.", "name": "GUARD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 84, "kind": "dialogue", "text": "Mm?", "name": "TRINH", "speaker": 1, "ext": [], "paren": ["muffled, under the hand"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 85, "kind": "dialogue", "text": "The sale starts at nine. Lot forty-one's a Tiffany lamp.", "name": "GUARD", "speaker": 3, "ext": [], "paren": ["in the dark"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 86, "kind": "action", "text": "A match flares.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 87, "kind": "action", "text": "The guard lights a candle on the crate.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 88, "kind": "action", "text": "His grin glows orange.", "para": 18, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 89, "kind": "dialogue", "text": "Shall we?", "name": "GUARD", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 90, "kind": "transition", "text": "FADE OUT.", "present": [0, 1, 2, 3, 4]}]}