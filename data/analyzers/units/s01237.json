{"scene_id": "s01237", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01237.fountain", "heading": "EXT. DRIVE-IN THEATRE - SNACK BAR PATIO - DUSK", "cast": [{"id": 0, "name": "BITE", "names": ["BITE"], "gender": "?", "first": 3, "spoke": 0}, {"id": 1, "name": "BEEBE", "names": ["BEEBE"], "gender": "?", "first": 6, "spoke": 11}, {"id": 2, "name": "CARRUTHERS", "names": ["CARRUTHERS"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "LOUISE TOLLIVER", "names": ["LOUISE TOLLIVER", "LOUISE"], "gender": "?", "first": 6, "spoke": 11}, {"id": 4, "name": "SOUR-FACED BOY", "names": ["SOUR-FACED BOY", "BOY"], "gender": "?", "first": 8, "spoke": 4}, {"id": 5, "name": "MOTHER", "names": ["MOTHER"], "gender": "?", "first": 9, "spoke": 0}, {"id": 6, "name": "ORVILLE", "names": ["ORVILLE"], "gender": "?", "first": 31, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DRIVE-IN THEATRE - SNACK BAR PATIO - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "Summer evening, 1962.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The screen is a white rectangle against a pink sky.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A neon sign says GRAB A BITE.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "Cars idle in rows.", "para": 0, "sent": 3, "present": [0]}, {"u": 5, "kind": "action", "text": "Crickets.", "para": 0, "sent": 4, "present": [0]}, {"u": 6, "kind": "action", "text": "TWO TEENAGERS lean on the rail: BEATRICE \"BEEBE\" CARRUTHERS (16, ponytail, saddle shoes) and her best friend LOUISE TOLLIVER (16, sunglasses, her father's jacket).", "para": 1, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "Neither looks at the other.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Behind the counter, a SOUR-FACED BOY in a paper hat (17, freckles, glaring at a milkshake machine).", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "At the window of a nearby station wagon, a MOTHER (40s, curlers under a headscarf) smokes and watches them like a hawk.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "He's looking at you.", "name": "BEEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "He's looking at you.", "name": "LOUISE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "He's looking at her. She's the one with the jacket.", "name": "BEEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "He's looking at the jacket.", "name": "LOUISE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "The sour-faced boy slides two milkshakes across the counter without a word.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Four bits.", "name": "BOY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "That's a quarter more than last week.", "name": "BEEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Prices go up.", "name": "BOY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "So do tempers.", "name": "LOUISE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "He flicks his eyes at her, then away.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "His ears go red.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Ask his name.", "name": "BEEBE", "speaker": 1, "ext": [], "paren": ["to Louise, low"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "You ask his name.", "name": "LOUISE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "He'd answer you.", "name": "BEEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "He'd answer anyone.", "name": "LOUISE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "He wouldn't answer me.", "name": "BEEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Louise sighs.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Pushes her sunglasses up into her hair.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "What do they call you?", "name": "LOUISE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "They don't.", "name": "BOY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "We'll call you something.", "name": "LOUISE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Orville.", "name": "BOY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "Orville?", "name": "BEEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "It's a family name.", "name": "ORVILLE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "It's a terrible name.", "name": "LOUISE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "My grandfather flew a biplane in the first war.", "name": "ORVILLE", "speaker": 6, "ext": [], "paren": ["unsmiling"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "Oh!", "name": "BEEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "Oh.", "name": "LOUISE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "The two girls exchange a glance.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "Orville slides a napkin across the counter, then another.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "They're free.", "name": "ORVILLE", "speaker": 6, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "dialogue", "text": "Thanks, Orville.", "name": "BEEBE", "speaker": 1, "ext": [], "paren": ["taking hers"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "The screen flickers.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "A film leader counts down.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "The Mother's cigarette glows.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "action", "text": "She says nothing, but her gaze drifts to the Boy at the counter.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "action", "text": "Orville wipes the counter.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "His hand shakes slightly.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "dialogue", "text": "Saturday. If you're free.", "name": "ORVILLE", "speaker": 6, "ext": ["CONT'D"], "paren": ["low, to Beebe"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "dialogue", "text": "She's not free.", "name": "BEEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "dialogue", "text": "She's free.", "name": "LOUISE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "dialogue", "text": "Louise.", "name": "BEEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "dialogue", "text": "She'd love to.", "name": "LOUISE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "action", "text": "She nudges the other girl hard.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "action", "text": "The napkin flutters to the pavement.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "action", "text": "In the station wagon, the Mother turns away with a small, private smile and flicks ash out the window.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "action", "text": "The first scene of the movie begins on the screen, lighting their faces in silver.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "transition", "text": "FADE OUT.", "present": [0, 1, 2, 3, 4, 5, 6]}]}