{"scene_id": "s01238", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01238.fountain", "heading": "INT. SEAFOOD MARKET - BACK OFFICE - PRE-DAWN", "cast": [{"id": 0, "name": "VITO FERRANTINO", "names": ["VITO FERRANTINO", "VITO"], "gender": "?", "first": 4, "spoke": 15}, {"id": 1, "name": "DANTE FERRANTINO", "names": ["DANTE FERRANTINO", "DANTE"], "gender": "?", "first": 4, "spoke": 7}, {"id": 2, "name": "ODETTE LAROCHE", "names": ["ODETTE LAROCHE", "ODETTE"], "gender": "f", "first": 6, "spoke": 3}, {"id": 3, "name": "SUNDAR IYER", "names": ["SUNDAR IYER", "SUNDAR"], "gender": "?", "first": 7, "spoke": 3}, {"id": 4, "name": "^SUNDAR", "names": ["^SUNDAR"], "gender": "?", "first": 47, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. SEAFOOD MARKET - BACK OFFICE - PRE-DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A tiled room that smells of ice and brine.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A desk with a ledger and a crushed pack of cigarettes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Through a window, the market floor is dark, tubs of crab stacked like tombstones.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "VITO FERRANTINO (60s, apron over a good shirt) sits behind the desk with his hands folded.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Across from him, his nephew DANTE FERRANTINO (30s, leather coat, wet hair) shifts in a metal chair.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "By the door stands MRS. ODETTE LAROCHE (50s, orange rubber gloves to the elbow, fishmonger's cap), eating an apple.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "And in the corner, on an overturned crate, sits SUNDAR IYER (20s, soft-spoken, clean, holding a clipboard).", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Everybody comfortable?", "name": "VITO", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Nobody answers.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Odette bites the apple.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Dante's knee bounces.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "You want some coffee?", "name": "VITO", "speaker": 0, "ext": ["CONT'D"], "paren": ["to Dante"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "I'm good.", "name": "DANTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "It's early. You look tired.", "name": "VITO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "I'm not tired.", "name": "DANTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "He's not tired.", "name": "VITO", "speaker": 0, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "He opens the ledger.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Turns a page.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Runs a finger down a column.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Accountant. How's the arithmetic?", "name": "VITO", "speaker": 0, "ext": ["CONT'D"], "paren": ["to Sundar"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "It's close, Mr. Ferrantino.", "name": "SUNDAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Close to what?", "name": "VITO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "It's close to correct.", "name": "SUNDAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Close. Odette?", "name": "VITO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Close is a nice word.", "name": "ODETTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "It's a nice word until the fish go off.", "name": "VITO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Dante laughs once.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Short.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Dry.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Nobody joins.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "You think it's funny?", "name": "VITO", "speaker": 0, "ext": ["CONT'D"], "paren": ["to Dante"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "You said fish.", "name": "DANTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "I did say fish.", "name": "VITO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "He closes the ledger.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Slides it across the desk.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Dante glances at it.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Doesn't touch it.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Read it.", "name": "VITO", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Uncle Vito.", "name": "DANTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Read the third page.", "name": "VITO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "I know what's on the third page.", "name": "DANTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Then why are you sweating?", "name": "ODETTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Dante, I told you to take it back.", "name": "SUNDAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "You told me nothing!", "name": "DANTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Both speak at once, sharp and loud.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Hush.", "name": "ODETTE", "speaker": 2, "ext": [], "paren": ["to Sundar"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "I didn't say--", "name": "^SUNDAR", "speaker": 4, "ext": [], "paren": ["to Odette"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Enough.", "name": "VITO", "speaker": 0, "ext": [], "paren": ["to the room, calm"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Silence.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "The ice machine rumbles in the next room.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Vito lifts the lid of the ledger one more time and takes out a single photograph.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "He sets it face-up on the desk.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "It's Dante, in a car, handing an envelope to a stranger in a dark coat.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "The timestamp reads last Thursday.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "Where did you get that?", "name": "DANTE", "speaker": 1, "ext": [], "paren": ["barely"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "The man in the coat is mine. Has been for ten years. He told me you'd come.", "name": "VITO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "Dante looks at Odette.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "At Sundar.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "At the door.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "Odette drops the apple core into the bin and folds her gloved arms.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "Blood.", "name": "VITO", "speaker": 0, "ext": ["CONT'D"], "paren": ["quietly, to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "He lifts the phone on the desk and dials one digit.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "It rings once.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "transition", "text": "FADE OUT.", "present": [0, 1, 2, 3, 4]}]}