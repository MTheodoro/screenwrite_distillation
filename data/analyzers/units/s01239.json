{"scene_id": "s01239", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01239.fountain", "heading": "INT. SUBURBAN KITCHEN - MORNING", "cast": [{"id": 0, "name": "NINA ZELENKO", "names": ["NINA ZELENKO", "NINA"], "gender": "?", "first": 2, "spoke": 16}, {"id": 1, "name": "MAN", "names": ["MAN"], "gender": "?", "first": 3, "spoke": 8}, {"id": 2, "name": "TOMAS", "names": ["TOMAS"], "gender": "?", "first": 29, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. SUBURBAN KITCHEN - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Cereal boxes, a half-finished jigsaw on the counter, a calendar with every square filled.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "NINA ZELENKO (8, pyjamas, ponytail askew) kneels on a chair, building a tower out of sugar cubes.", "para": 1, "sent": 0, "present": [0]}, {"u": 3, "kind": "action", "text": "She doesn't look up when a MAN comes in through the back door.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "He is in his thirties, stubble, suitcase in his hand, a travel-worn grey sweater.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "He stops just inside the mat.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "He doesn't speak.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Mum's at work.", "name": "NINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "I know.", "name": "MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "You can't come in if she's not here.", "name": "NINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I'm already in.", "name": "MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She considers this.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Places another cube.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "The tower wobbles and holds.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Are you the plumber?", "name": "NINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "No.", "name": "MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "The man from the gas?", "name": "NINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "No.", "name": "MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "You look like a man from the gas.", "name": "NINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "The Man sets the suitcase on the floor.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Slowly.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Like putting down something that might go off.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Do you remember a photograph? On the fridge. A man with a boat.", "name": "MAN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "That's Daddy. He's in Australia.", "name": "NINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Do you know his name?", "name": "MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Daddy.", "name": "NINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "His other name.", "name": "MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Nina chews her lip.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "She sets down a cube, lining it up with great care.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Tomas.", "name": "NINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Tomas.", "name": "MAN", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Zelenko. Like me.", "name": "NINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The Man breathes out.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "He crosses to the table and pulls out the chair opposite her.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Sits.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "He is eye level with the tower.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "You have the same nose.", "name": "NINA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "I do.", "name": "TOMAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "You're not in Australia.", "name": "NINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Not today.", "name": "TOMAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Nina looks at him then, for the first time, properly.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Her eyes trace his jaw, his hands, his collar.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "She picks up a sugar cube and offers it across the table.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "You can add one. Carefully.", "name": "NINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "He takes it.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "His fingers tremble.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "He lowers it on to the very top of the tower.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "It holds.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Daddy.", "name": "NINA", "speaker": 0, "ext": ["CONT'D"], "paren": ["almost whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Nina.", "name": "TOMAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Mum says you're not coming back.", "name": "NINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Mum might be right.", "name": "TOMAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "But you're here.", "name": "NINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "I'm here this morning.", "name": "TOMAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "She nods.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Considers.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Reaches for another cube.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "Then let's build it taller.", "name": "NINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "transition", "text": "FADE OUT.", "present": [0, 1, 2]}]}