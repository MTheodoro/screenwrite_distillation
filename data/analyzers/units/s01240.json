{"scene_id": "s01240", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01240.fountain", "heading": "INT. FERRIS WHEEL GONDOLA - STOPPED AT THE TOP - NIGHT", "cast": [{"id": 0, "name": "LYSANDER POTTS", "names": ["LYSANDER POTTS", "LYSANDER"], "gender": "?", "first": 4, "spoke": 1}, {"id": 1, "name": "IMOGEN FAIRBANKS-DUBOIS", "names": ["IMOGEN FAIRBANKS-DUBOIS", "IMOGEN"], "gender": "?", "first": 14, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. FERRIS WHEEL GONDOLA - STOPPED AT THE TOP - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A wind-rocked cabin sixty metres over a closed fairground.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Painted bulbs flicker on the rim below.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A duffel sits on the bench.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LYSANDER POTTS (30s, tool belt over a ride-attendant's vest) kneels on the cabin floor with a drill, boring slowly through the planks.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He hums under his breath.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "The drill whines, chews, drops.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "A fist-sized hole opens, framing the dark ticket booth below and a faint silver glint inside it.", "para": 1, "sent": 3, "present": [0]}, {"u": 8, "kind": "action", "text": "He lowers a line through the hole, clips a harness to the rail, and tests the knot with a bounce.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "The gondola creaks.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "He pauses.", "para": 2, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "Something else is creaking.", "para": 2, "sent": 3, "present": [0]}, {"u": 12, "kind": "action", "text": "A gloved hand grips the outside of the cage.", "para": 3, "sent": 0, "present": [0]}, {"u": 13, "kind": "action", "text": "Then another.", "para": 3, "sent": 1, "present": [0]}, {"u": 14, "kind": "action", "text": "A woman hauls herself up the bars and hooks one elbow through the cabin door: IMOGEN FAIRBANKS-DUBOIS (30s, ski mask rolled up like a hat, grin like a crescent moon, breathing hard).", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Evening, Lysander.", "name": "IMOGEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Lysander lunges for the duffel.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Imogen swings in, kicks the drill across the floor, and catches him in a bear hug.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "They wrestle, the cabin rocking, bulbs flaring and dying as they slam against the cage.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "His elbow cracks into the bench.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Her boot catches the rail.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "The line goes taut and flaps across both of them.", "para": 4, "sent": 5, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Then both freeze.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Below, in the dark fairground, a torch beam swings across the ticket booth.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Is that yours?", "name": "LYSANDER", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I thought it was yours.", "name": "IMOGEN", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "The beam steadies on the hole in the floor.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Lysander slowly lets go.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Imogen unhooks her elbow.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Neither lifts their hands.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "transition", "text": "FADE OUT.", "present": [0, 1]}]}