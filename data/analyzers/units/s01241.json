{"scene_id": "s01241", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01241.fountain", "heading": "INT. CHURCH BELL TOWER - SNIPER NEST - DAY", "cast": [{"id": 0, "name": "SERGEANT AMADOU DIALLO", "names": ["SERGEANT AMADOU DIALLO", "DIALLO"], "gender": "m", "first": 6, "spoke": 8}, {"id": 1, "name": "KAZ", "names": ["KAZ"], "gender": "?", "first": 8, "spoke": 9}, {"id": 2, "name": "NOWAK", "names": ["NOWAK"], "gender": "?", "first": 8, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. CHURCH BELL TOWER - SNIPER NEST - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Broken stone.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Bells long gone.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A sandbag parapet at the slit window.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Dust hangs in the shafts of light.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Distant shelling.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "SERGEANT AMADOU DIALLO (40s, helmet, three days of beard) lies prone behind a rifle.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Eyes fixed on a far street.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "PRIVATE KAZIMIERZ \"KAZ\" NOWAK (19, spotter, binoculars, cracked lips) crouches beside him with a field radio.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Movement. Window, third floor.", "name": "KAZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Which building?", "name": "DIALLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Blue shutters.", "name": "KAZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Got it.", "name": "DIALLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "A mortar thuds close.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Grit rains from the vault.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Neither flinches.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Echo Two to Base. Contact.", "name": "KAZ", "speaker": 1, "ext": [], "paren": ["into radio"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Static.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Nothing.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "They can't hear you.", "name": "DIALLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Come on, come on.", "name": "KAZ", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Diallo shifts the rifle.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Exhales.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Waits.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Hold the door! Anyone comes up, you hold the door!", "name": "KAZ", "speaker": 1, "ext": ["CONT'D"], "paren": ["down the stairwell, shouting"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "A boot scuffs below.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Diallo glances back.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Kaz nods, shrugs.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Count.", "name": "DIALLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Four. Five. Six.", "name": "KAZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Shutters.", "name": "DIALLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Opening.", "name": "KAZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "A shape in the window.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Diallo's finger tenses on the trigger.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "A pause.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "A breath.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Not yet.", "name": "DIALLO", "speaker": 0, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Sarge.", "name": "KAZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Not yet.", "name": "DIALLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "The shape retreats.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "The shutters close.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Diallo lets his shoulders drop one inch.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "They're playing with us.", "name": "KAZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "We play back.", "name": "DIALLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "He resettles.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Kaz lifts the binoculars.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "The shelling picks up again.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 48, "kind": "transition", "text": "CUT TO BLACK.", "present": [0, 1, 2]}]}