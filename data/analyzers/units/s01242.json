{"scene_id": "s01242", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01242.fountain", "heading": "EXT. DRY SALT LAKE - HOMESTEAD PORCH - AFTERNOON", "cast": [{"id": 0, "name": "JEREMIAH PIKE", "names": ["JEREMIAH PIKE", "JEREMIAH"], "gender": "m", "first": 5, "spoke": 18}, {"id": 1, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 10, "spoke": 8}, {"id": 2, "name": "JEDEDIAH", "names": ["JEDEDIAH"], "gender": "m", "first": 40, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DRY SALT LAKE - HOMESTEAD PORCH - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "A white crust of land that runs to the mountains.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A weathered shack with a sagging porch roof.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A rain barrel, empty.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A windmill creaks, turning once in a while.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "An old rancher, JEREMIAH PIKE (70s, suspenders, a face like cracked leather), sits on a rocking chair whittling a stick.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A shotgun leans against the rail.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "He doesn't pick it up.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "A rider appears out of the shimmer, leading a skinny horse.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "The rider dismounts at the edge of the yard: a lean man in a long duster, hat pulled low.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "A STRANGER.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Afternoon.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Afternoon.", "name": "JEREMIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "I'm looking for water for the horse.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Barrel's dry.", "name": "JEREMIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "So I see.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Well's behind the house. Bucket's on the nail. Mind the rope.", "name": "JEREMIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "The Stranger nods.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Leads the horse around the side.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "A pump handle squeaks.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Water splashes.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Jeremiah whittles on.", "para": 3, "sent": 4, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Presently the Stranger returns, hat in hand.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "He is younger than he looked: forty, if that.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "A scar runs down one cheek.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "That's a good well.", "name": "STRANGER", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Dug it myself. Nineteen years ago.", "name": "JEREMIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Nineteen.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "You say that like it means something.", "name": "JEREMIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Might.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Sit if you like.", "name": "JEREMIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "The Stranger takes the other step of the porch.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Lowers himself.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Their eyes are on the horizon.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "You got a name?", "name": "JEREMIAH", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Used to.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Used to is a fine name for a man.", "name": "JEREMIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "The Stranger half smiles.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "The windmill turns.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "A hawk circles far off.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Jedediah.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Jedediah what?", "name": "JEREMIAH", "speaker": 0, "ext": [], "paren": ["still whittling"], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Pike.", "name": "JEDEDIAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "The knife stops.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Jeremiah stares at the stick in his hand as though it had just spoken.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Pike's my name.", "name": "JEREMIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "I know it.", "name": "JEDEDIAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "I had a boy named Jedediah.", "name": "JEREMIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "I know.", "name": "JEDEDIAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Neither looks at the other.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "The wind picks up a veil of white dust and lets it fall again.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "He ran off when he was twenty-one.", "name": "JEREMIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Twenty-one and two months.", "name": "JEDEDIAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Took a horse.", "name": "JEREMIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "This one's his granddaughter.", "name": "JEDEDIAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Jeremiah laughs, short, dry, a sound with no air in it.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "He lowers the stick.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Looks at it.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Places it carefully on the rail.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "You hungry?", "name": "JEREMIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "I could eat.", "name": "JEDEDIAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "I've beans.", "name": "JEREMIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "Beans are good.", "name": "JEDEDIAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "Beans are what there is.", "name": "JEREMIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "He rises with a groan.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "Stops with a hand on the door.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "Don't go getting any ideas about staying.", "name": "JEREMIAH", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "dialogue", "text": "No, sir.", "name": "JEDEDIAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 68, "kind": "dialogue", "text": "I snore.", "name": "JEREMIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 69, "kind": "dialogue", "text": "I remember.", "name": "JEDEDIAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "Jeremiah's back is turned.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 71, "kind": "action", "text": "His shoulders tremble once.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 72, "kind": "action", "text": "Then he goes inside.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 73, "kind": "action", "text": "Jedediah sits there a while longer, hat on his knee, looking at the white horizon.", "para": 11, "sent": 3, "present": [0, 1, 2]}, {"u": 74, "kind": "action", "text": "He picks up the stick Jeremiah left on the rail and, with the little knife from his belt, begins to finish the carving.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 75, "kind": "transition", "text": "FADE OUT.", "present": [0, 1, 2]}]}