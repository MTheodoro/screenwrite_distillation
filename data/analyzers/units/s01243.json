{"scene_id": "s01243", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01243.fountain", "heading": "EXT. FROZEN LAKE - ICE FISHING HUT - DAWN", "cast": [{"id": 0, "name": "ASTRID BJORKLUND", "names": ["ASTRID BJORKLUND", "ASTRID"], "gender": "?", "first": 6, "spoke": 5}, {"id": 1, "name": "KWAME ASANTE", "names": ["KWAME ASANTE", "KWAME"], "gender": "m", "first": 7, "spoke": 6}, {"id": 2, "name": "LEILA NOURI", "names": ["LEILA NOURI", "LEILA"], "gender": "?", "first": 8, "spoke": 3}, {"id": 3, "name": "OLD HARTWELL", "names": ["OLD HARTWELL", "HARTWELL"], "gender": "m", "first": 9, "spoke": 4}, {"id": 4, "name": "BENEDICT OYELARAN", "names": ["BENEDICT OYELARAN", "BENEDICT"], "gender": "?", "first": 32, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FROZEN LAKE - ICE FISHING HUT - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A tiny plywood shack on a plain of white.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A thin plume of smoke rises from its tin chimney.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The sun pushes up behind a dark treeline, spilling pink across the ice.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Inside, four people crowd shoulder to shoulder around a hole in the floor, lines hanging in the black water.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "A portable stove glows red.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "ASTRID BJORKLUND (60s, wool hat, thermos) tends a line with patient fingers.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "KWAME ASANTE (30s, ice-auger slung across his back, laughs easily) rubs his gloves over the stove.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "LEILA NOURI (20s, scientist, notebook, clipboard) jots numbers beside the hole.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "OLD HARTWELL (70s, one-eyed, cap with earflaps) dozes upright in a folding chair, a pipe unlit in his mouth.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Astrid, you've got a bite.", "name": "KWAME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I know.", "name": "ASTRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "You're not reeling.", "name": "KWAME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "I'm waiting.", "name": "ASTRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "What for?", "name": "LEILA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "For him to decide.", "name": "ASTRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "The line tugs.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Astrid lifts it a single inch.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "The tension goes slack.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "She sighs.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Eleven centimetres of ice at the edge. Nineteen here. It's thickening, Astrid.", "name": "LEILA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "It always thickens. Then it stops.", "name": "ASTRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Hartwell, wake up. We have fish.", "name": "KWAME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "We have no fish.", "name": "HARTWELL", "speaker": 3, "ext": [], "paren": ["eyes closed"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "We have a fish.", "name": "KWAME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "We have an optimist.", "name": "HARTWELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Kwame grins.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Leila writes it down without being asked, and Astrid's mouth twitches.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Outside, a snowmobile growls.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "The engine cuts.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Boots creak.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "The door swings open on a rush of white air.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "A man ducks in, stamping snow: BENEDICT OYELARAN (40s, ranger's parka, radio on his chest).", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "He closes the door and stands there, enjoying the heat.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Ranger Benedict. Come to arrest us?", "name": "KWAME", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Only if you've got more than the limit.", "name": "BENEDICT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "We have none.", "name": "LEILA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Then you're safe.", "name": "BENEDICT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Coffee?", "name": "ASTRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "God, yes.", "name": "BENEDICT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "She pours him a cup.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "He cradles it, steaming, and looks at the four of them: hats, noses, gloves, the black circle of water.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Anybody catch anything?", "name": "BENEDICT", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Not yet.", "name": "HARTWELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "But the day is young, Hartwell.", "name": "KWAME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "The day's old as the lake.", "name": "HARTWELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Kwame laughs.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Leila turns a page.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "The stove ticks.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Astrid's line twitches again, and nobody says a word.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "transition", "text": "FADE OUT.", "present": [0, 1, 2, 3, 4]}]}