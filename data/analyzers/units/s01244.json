{"scene_id": "s01244", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01244.fountain", "heading": "INT. PLEA ROOM - COURTHOUSE BASEMENT - DAY", "cast": [{"id": 0, "name": "PUBLIC DEFENDER ROSALIND KEMP", "names": ["PUBLIC DEFENDER ROSALIND KEMP", "ROSALIND"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "MARGUERITE DELACROIX-OBI", "names": ["MARGUERITE DELACROIX-OBI", "MARGUERITE"], "gender": "?", "first": 4, "spoke": 2}, {"id": 2, "name": "THELONIOUS GRAVES", "names": ["THELONIOUS GRAVES", "GRAVES"], "gender": "m", "first": 4, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. PLEA ROOM - COURTHOUSE BASEMENT - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A cinderblock cell with a steel table.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A buzzing light.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A small high window.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "PUBLIC DEFENDER ROSALIND KEMP (30s, tired blazer) sits across from her client, MARGUERITE DELACROIX-OBI (30s, orange jumpsuit, braids), and the prosecutor, ASSISTANT D.A. THELONIOUS GRAVES (50s, bow tie, folder).", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "She'll take the deal.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Will she?", "name": "GRAVES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "I'll hear it first.", "name": "MARGUERITE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Three years, suspended.", "name": "GRAVES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Time served.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Three, suspended.", "name": "GRAVES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Rosalind and Marguerite glance at each other.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Marguerite lays a palm flat on the table.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Graves taps his folder.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "And the record?", "name": "MARGUERITE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Sealed after five.", "name": "GRAVES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Four.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "They all lean in at once, three palms on the table.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Then all three freeze, because the light flickers and goes out.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "In the dark, nobody moves.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "The light buzzes back.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "They're in the same positions.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Graves' bow tie is crooked.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Five.", "name": "GRAVES", "speaker": 2, "ext": [], "paren": ["deadpan"], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Four and a half.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "He sighs.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Marguerite almost laughs.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Rosalind lifts a pen.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "transition", "text": "FADE OUT.", "present": [0, 1, 2]}]}