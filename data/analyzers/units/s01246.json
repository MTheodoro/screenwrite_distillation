{"scene_id": "s01246", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01246.fountain", "heading": "INT. FAMILY KITCHEN - MORNING", "cast": [{"id": 0, "name": "ROSEMARY ALDRIDGE", "names": ["ROSEMARY ALDRIDGE", "ROSEMARY"], "gender": "?", "first": 4, "spoke": 9}, {"id": 1, "name": "BARNABY ALDRIDGE", "names": ["BARNABY ALDRIDGE", "BARNABY"], "gender": "m", "first": 4, "spoke": 12}, {"id": 2, "name": "GRANDMA", "names": ["GRANDMA"], "gender": "?", "first": 16, "spoke": 11}], "units": [{"u": 0, "kind": "heading", "text": "INT. FAMILY KITCHEN - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Pancakes burn.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Smoke curls from the pan.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cat watches from the refrigerator top.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Mum, ROSEMARY ALDRIDGE (40s, bathrobe, phone against her shoulder), flips a pancake.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "It lands on the floor.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "She leaves it.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Her son, BARNABY ALDRIDGE (10, school jumper, one shoe), sits at the table, staring at his cereal.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "It's soggy.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Yes. I'm here. Hold on.", "name": "ROSEMARY", "speaker": 0, "ext": [], "paren": ["into phone"], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She covers the receiver.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Barnaby, shoes.", "name": "ROSEMARY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I'm not going.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Barnaby.", "name": "ROSEMARY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "I'm not going.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "No, not you. Go on.", "name": "ROSEMARY", "speaker": 0, "ext": [], "paren": ["into phone"], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Rosemary, put the boy on. Put him on.", "name": "GRANDMA", "speaker": 2, "ext": ["V.O."], "paren": ["tinny, through the phone"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Mum, he's eating.", "name": "ROSEMARY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "He's not eating. I can hear he's not eating.", "name": "GRANDMA", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Barnaby's spoon clinks against the bowl.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "He pushes cereal in a circle.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Barnaby. Grandma wants a word.", "name": "ROSEMARY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "He takes the phone.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Holds it away from his ear like a dead fish.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Hi.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Barnaby, my darling. Do you know what day it is?", "name": "GRANDMA", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Tuesday.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "It's your sports day, isn't it?", "name": "GRANDMA", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "His shoulders hunch.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "The spoon goes still.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "I'm not doing the race.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Why not?", "name": "GRANDMA", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Because I always lose.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Rosemary stops with the spatula in the air.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "She looks at him.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "He looks at the table.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Your grandfather lost every race he ever ran.", "name": "GRANDMA", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Really?", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Every one. He'd come in last and hold his arms up like he'd won. Everyone cheered. You know why?", "name": "GRANDMA", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Why?", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Because he was the only one who looked like he was enjoying it.", "name": "GRANDMA", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Barnaby lifts his head.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "A corner of his mouth moves.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Grandpa did that?", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Put your mother back on.", "name": "GRANDMA", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "He hands the phone to Rosemary.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "She takes it, breath held.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Mum?", "name": "ROSEMARY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Burn another pancake. He likes them burned.", "name": "GRANDMA", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Rosemary laughs, a wet cracked sound.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "She wipes her eyes with the back of her wrist.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "I love you.", "name": "ROSEMARY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Hush. Go and flip.", "name": "GRANDMA", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "The line clicks.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Rosemary puts the phone down on the counter.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "She picks up the burnt pancake from the pan, slides it onto a plate, and sets it in front of Barnaby.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "It's black.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "Eat.", "name": "ROSEMARY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "He takes a bite.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Chews.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "Nods.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "It's okay.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "He picks up his other shoe.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 63, "kind": "transition", "text": "FADE OUT.", "present": [0, 1, 2]}]}