{"scene_id": "s01247", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01247.fountain", "heading": "EXT. STAGECOACH STATION - HIGH NOON", "cast": [{"id": 0, "name": "SHERIFF LUCINDA HARGROVE", "names": ["SHERIFF LUCINDA HARGROVE", "LUCINDA"], "gender": "f", "first": 4, "spoke": 6}, {"id": 1, "name": "DEPUTY MARIGOLD TEASDALE", "names": ["DEPUTY MARIGOLD TEASDALE", "MARIGOLD"], "gender": "f", "first": 5, "spoke": 3}, {"id": 2, "name": "ABSALOM FINCH", "names": ["ABSALOM FINCH", "ABSALOM"], "gender": "?", "first": 6, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. STAGECOACH STATION - HIGH NOON", "present": []}, {"u": 1, "kind": "action", "text": "A single hitching post.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dust.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A water trough with a drowned sparrow in it.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SHERIFF LUCINDA HARGROVE (40s, star on her vest) stands with her arms folded.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside her, DEPUTY MARIGOLD TEASDALE (20s, new hat, too-big holster) fidgets.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Across the road, a rider on a grey mare: ABSALOM FINCH (30s, handlebar moustache, silver spurs).", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Let me do the talking.", "name": "LUCINDA", "speaker": 0, "ext": [], "paren": ["to Marigold, low"], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "I wasn't going to.", "name": "MARIGOLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Morning, Absalom.", "name": "LUCINDA", "speaker": 0, "ext": [], "paren": ["to the road, loud"], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Morning, Sheriff.", "name": "ABSALOM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "You're a long way from Tucson.", "name": "LUCINDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "It's a long way to anywhere.", "name": "ABSALOM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "He swings down.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Spurs ring.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "The mare shakes her mane.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Marigold's hand drifts toward her holster.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Hand off the gun.", "name": "LUCINDA", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "She said hand off.", "name": "MARIGOLD", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "She lets the hand fall.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Lucinda doesn't look at her.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Heard there was a hanging today.", "name": "ABSALOM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Heard wrong.", "name": "LUCINDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Heard right, then.", "name": "ABSALOM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "He tips his hat to the trough, to the sparrow, to the dust.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Mounts again, turns the mare, and trots out of town.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Lucinda watches him go.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Marigold releases her breath.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Who hangs on a Tuesday?", "name": "MARIGOLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Nobody, thank God.", "name": "LUCINDA", "speaker": 0, "ext": [], "paren": ["to the whole street"], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "transition", "text": "FADE OUT.", "present": [0, 1, 2]}]}