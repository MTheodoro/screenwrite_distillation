{"scene_id": "s01248", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01248.fountain", "heading": "INT. STAGE DOOR - GRAND MERIDIAN THEATRE - NIGHT", "cast": [{"id": 0, "name": "AUGUSTINE BLACKWOOD", "names": ["AUGUSTINE BLACKWOOD", "AUGUSTINE"], "gender": "?", "first": 7, "spoke": 4}, {"id": 1, "name": "MIRABELLE TRUJILLO", "names": ["MIRABELLE TRUJILLO", "MIRABELLE"], "gender": "f", "first": 8, "spoke": 4}, {"id": 2, "name": "THADDEUS GRANT", "names": ["THADDEUS GRANT", "THADDEUS"], "gender": "m", "first": 9, "spoke": 6}, {"id": 3, "name": "PRUDENCE WILKES-AMARI", "names": ["PRUDENCE WILKES-AMARI", "PRUDENCE"], "gender": "f", "first": 10, "spoke": 4}, {"id": 4, "name": "CORNELIUS FAIRCHILD", "names": ["CORNELIUS FAIRCHILD", "CORNELIUS"], "gender": "?", "first": 11, "spoke": 3}, {"id": 5, "name": "BARTY", "names": ["BARTY"], "gender": "?", "first": 12, "spoke": 4}, {"id": 6, "name": "NKEMELU", "names": ["NKEMELU"], "gender": "?", "first": 12, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. STAGE DOOR - GRAND MERIDIAN THEATRE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "The backstage corridor of an old playhouse.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Peeling posters, a cracked mirror, a radiator knocking like a dying heart.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single bulb in a wire cage swings gently.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "There is no draught.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The final performance has ended.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "Six members of the company stand in their street clothes, coats half-on, none of them going home.", "para": 1, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "AUGUSTINE BLACKWOOD (60s, director, silk scarf) stares at the stage door.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "MIRABELLE TRUJILLO (30s, lead actress, make-up still on one eye) grips her handbag.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "THADDEUS GRANT (40s, stage manager, headset around his neck) counts heads with his finger.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "PRUDENCE WILKES-AMARI (20s, understudy, bright red coat) bites her thumbnail.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "CORNELIUS FAIRCHILD (50s, prop master, apron) cradles a skull from the final scene.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "BARTHOLOMEW \"BARTY\" NKEMELU (teen, call-boy, cap) hovers at the back.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "Five. I count five.", "name": "THADDEUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "Six, Thaddeus.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "Five and Barty.", "name": "THADDEUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "Six, then.", "name": "MIRABELLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "Who's missing?", "name": "PRUDENCE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "Nobody's missing.", "name": "CORNELIUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "There was somebody in the wings. During the third act.", "name": "BARTY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "That was the ghost light.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "It moved.", "name": "BARTY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Lights don't move.", "name": "THADDEUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "It was a man.", "name": "PRUDENCE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "It was Cornelius, getting the skull.", "name": "MIRABELLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "I was at the prop table.", "name": "CORNELIUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "action", "text": "A beat.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "The bulb swings.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "The shadow of the cage drifts slowly across their faces.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "Nobody looks up.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "The radiator knocks twice.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "Then once.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "Whose coat is that?", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "On a hook by the stage door hangs a long black coat with a velvet collar.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "Nobody moves toward it.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "It wasn't there at the interval.", "name": "MIRABELLE", "speaker": 1, "ext": [], "paren": ["almost inaudible"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "It's cold.", "name": "PRUDENCE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "Everyone, out. Now. Barty, the keys.", "name": "THADDEUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "dialogue", "text": "I left them on the...", "name": "BARTY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "Barty.", "name": "THADDEUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "I left them in the prompt corner.", "name": "BARTY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "Silence.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "Thaddeus turns.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "Down the corridor, the stage door to the auditorium is open a hand's width.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "Inside, in the dark, the ghost light burns, and in front of it, small and still, stands a figure with its back to them, face to the empty seats.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "Don't look.", "name": "CORNELIUS", "speaker": 4, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "action", "text": "They all look.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "The skull in Cornelius's arms clacks its jaw, softly, once.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "He drops it.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "action", "text": "It rolls under the radiator.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "dialogue", "text": "Nobody run.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": ["barely a breath"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "dialogue", "text": "Nobody...", "name": "PRUDENCE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "dialogue", "text": "Yes.", "name": "MIRABELLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "dialogue", "text": "Run.", "name": "THADDEUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "action", "text": "They run.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "transition", "text": "FADE OUT.", "present": [0, 1, 2, 3, 4, 5, 6]}]}