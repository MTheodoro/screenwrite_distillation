{"scene_id": "s01249", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01249.fountain", "heading": "INT. PEDIATRIC CLINIC - EXAM ROOM - DAY", "cast": [{"id": 0, "name": "WOMAN", "names": ["WOMAN"], "gender": "?", "first": 5, "spoke": 0}, {"id": 1, "name": "SOLVEIG AASEN-BELLO", "names": ["SOLVEIG AASEN-BELLO", "SOLVEIG"], "gender": "?", "first": 5, "spoke": 15}, {"id": 2, "name": "KAMARIA JOSEPH-FERRIER", "names": ["KAMARIA JOSEPH-FERRIER", "KAMARIA"], "gender": "f", "first": 7, "spoke": 12}, {"id": 3, "name": "OSKAR", "names": ["OSKAR"], "gender": "?", "first": 8, "spoke": 0}, {"id": 4, "name": "FATHER", "names": ["FATHER"], "gender": "?", "first": 9, "spoke": 0}, {"id": 5, "name": "THE FATHER", "names": ["THE FATHER"], "gender": "?", "first": 8, "spoke": 4}, {"id": 6, "name": "DAVID", "names": ["DAVID"], "gender": "m", "first": 18, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. PEDIATRIC CLINIC - EXAM ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Bright walls, painted giraffes, a jungle-gym poster.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A small examination bed with white paper and a stuffed lion.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A scale.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Sunlight through a striped blind.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A WOMAN in a white coat, her name tag turned backward, sits on a rolling stool with a tablet: DR. SOLVEIG AASEN-BELLO (40s, kind, tired, mismatched earrings).", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "She keeps her voice level.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Her patient's mother, KAMARIA JOSEPH-FERRIER (30s, nurse's scrubs under her coat, tight shoulders), holds a toddler's hand.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "The toddler, OSKAR, is asleep on the bed.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 5]}, {"u": 9, "kind": "action", "text": "And in the corner, on a plastic chair, sits a man, introduced on the form only as THE FATHER (30s, hoodie, unshaven, knee bouncing).", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 5]}, {"u": 10, "kind": "dialogue", "text": "He's very warm.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5]}, {"u": 11, "kind": "dialogue", "text": "I know.", "name": "KAMARIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5]}, {"u": 12, "kind": "dialogue", "text": "Has he been drinking?", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5]}, {"u": 13, "kind": "dialogue", "text": "Barely.", "name": "KAMARIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5]}, {"u": 14, "kind": "dialogue", "text": "He had juice.", "name": "THE FATHER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5]}, {"u": 15, "kind": "dialogue", "text": "Half a cup.", "name": "KAMARIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5]}, {"u": 16, "kind": "dialogue", "text": "Any rash?", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5]}, {"u": 17, "kind": "dialogue", "text": "Not that I saw.", "name": "THE FATHER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5]}, {"u": 18, "kind": "dialogue", "text": "David, I checked. Twice.", "name": "KAMARIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "Fever since?", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": ["typing"], "dual": false, "present": [0, 1, 2, 3, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "Monday.", "name": "THE FATHER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "Sunday night.", "name": "KAMARIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5, 6]}, {"u": 22, "kind": "action", "text": "He looks at her.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 5, 6]}, {"u": 23, "kind": "action", "text": "She looks at the child.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 5, 6]}, {"u": 24, "kind": "action", "text": "The pen clicks.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "Okay. I'm going to listen to his chest.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5, 6]}, {"u": 26, "kind": "action", "text": "She lays the stethoscope on the small ribs.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 5, 6]}, {"u": 27, "kind": "action", "text": "Her eyes drift, then fix.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 5, 6]}, {"u": 28, "kind": "action", "text": "Her face doesn't change, but her hand does.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 5, 6]}, {"u": 29, "kind": "action", "text": "It moves up.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 5, 6]}, {"u": 30, "kind": "action", "text": "Back.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 5, 6]}, {"u": 31, "kind": "action", "text": "Down.", "para": 5, "sent": 5, "present": [0, 1, 2, 3, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "What is it?", "name": "KAMARIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "I'd like a quick bloods and a chest film.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "What is it?", "name": "THE FATHER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "I'm not sure yet.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "Don't do that to me. I'm a nurse.", "name": "KAMARIA", "speaker": 2, "ext": [], "paren": ["very quiet"], "dual": false, "present": [0, 1, 2, 3, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "I know.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5, 6]}, {"u": 38, "kind": "dialogue", "text": "What do you hear?", "name": "KAMARIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "A fluid sound. On the right.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5, 6]}, {"u": 40, "kind": "action", "text": "Kamaria closes her eyes.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 5, 6]}, {"u": 41, "kind": "action", "text": "The father's knee stops bouncing.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 5, 6]}, {"u": 42, "kind": "action", "text": "He half rises, sits again, and leans forward until his elbows rest on his thighs.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 5, 6]}, {"u": 43, "kind": "dialogue", "text": "I told you Monday.", "name": "DAVID", "speaker": 6, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 5, 6]}, {"u": 44, "kind": "dialogue", "text": "You told me nothing.", "name": "KAMARIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "I said we should come in Monday.", "name": "DAVID", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5, 6]}, {"u": 46, "kind": "dialogue", "text": "You said wait.", "name": "KAMARIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5, 6]}, {"u": 47, "kind": "dialogue", "text": "Please. Both of you.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5, 6]}, {"u": 48, "kind": "action", "text": "She wheels the stool back.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 5, 6]}, {"u": 49, "kind": "action", "text": "Rests the stethoscope across her knees.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 5, 6]}, {"u": 50, "kind": "dialogue", "text": "He's going to be admitted. Today. He's stable, he's breathing, and I'm going to have him upstairs in twenty minutes.", "name": "SOLVEIG", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5, 6]}, {"u": 51, "kind": "dialogue", "text": "Oxygen?", "name": "KAMARIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5, 6]}, {"u": 52, "kind": "dialogue", "text": "Yes.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5, 6]}, {"u": 53, "kind": "dialogue", "text": "Antibiotics?", "name": "KAMARIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5, 6]}, {"u": 54, "kind": "dialogue", "text": "IV. Straight away.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5, 6]}, {"u": 55, "kind": "action", "text": "Kamaria nods.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 5, 6]}, {"u": 56, "kind": "action", "text": "Opens her eyes.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 5, 6]}, {"u": 57, "kind": "action", "text": "Squeezes the small hand and doesn't let go.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 5, 6]}, {"u": 58, "kind": "action", "text": "David pulls a tissue from his hoodie pocket.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 5, 6]}, {"u": 59, "kind": "action", "text": "Finds there is nothing in it.", "para": 8, "sent": 4, "present": [0, 1, 2, 3, 5, 6]}, {"u": 60, "kind": "dialogue", "text": "He's going to be all right. It will be loud and frightening, but he's going to be all right.", "name": "SOLVEIG", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5, 6]}, {"u": 61, "kind": "dialogue", "text": "You promise?", "name": "DAVID", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5, 6]}, {"u": 62, "kind": "dialogue", "text": "I won't promise. I'll stay with him.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5, 6]}, {"u": 63, "kind": "action", "text": "On the bed, Oskar stirs, opens one eye, and sees the lion.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 5, 6]}, {"u": 64, "kind": "action", "text": "He reaches for it with the whole of his fist.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 5, 6]}, {"u": 65, "kind": "transition", "text": "FADE OUT.", "present": [0, 1, 2, 3, 5, 6]}]}