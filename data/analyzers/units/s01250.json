{"scene_id": "s01250", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01250.fountain", "heading": "INT. UNDERTAKER'S PARLOUR - BACK ROOM - NIGHT - 1927", "cast": [{"id": 0, "name": "MAUDE PELLETIER", "names": ["MAUDE PELLETIER", "MAUDE"], "gender": "m", "first": 6, "spoke": 11}, {"id": 1, "name": "CYRIL OSGOOD", "names": ["CYRIL OSGOOD", "CYRIL"], "gender": "m", "first": 7, "spoke": 4}, {"id": 2, "name": "OTTOLINE VANTERPOOL", "names": ["OTTOLINE VANTERPOOL", "OTTOLINE"], "gender": "?", "first": 8, "spoke": 5}, {"id": 3, "name": "BRAM HOLLIDAY", "names": ["BRAM HOLLIDAY", "BRAM"], "gender": "m", "first": 9, "spoke": 11}, {"id": 4, "name": "STRANGER", "names": ["STRANGER"], "gender": "m", "first": 12, "spoke": 6}, {"id": 5, "name": "NOLAN", "names": ["NOLAN"], "gender": "m", "first": 32, "spoke": 8}, {"id": 6, "name": "^NOLAN", "names": ["^NOLAN"], "gender": "?", "first": 61, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. UNDERTAKER'S PARLOUR - BACK ROOM - NIGHT - 1927", "present": []}, {"u": 1, "kind": "action", "text": "Behind a velvet curtain, a secret card game.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Six coffins stand in a row against the wall, lids propped open as stools.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A card table in the middle.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Smoke hangs under a green-shaded lamp.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A gramophone plays a tinny foxtrot.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "MAUDE PELLETIER (50s, owner, black bombazine, rings on every finger) deals cards with a flick of her wrist.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "CYRIL OSGOOD (30s, bookkeeper, spectacles, sweat on his lip) arranges his hand in a fan.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "OTTOLINE VANTERPOOL (20s, flapper, fur collar, cigarette holder) leans back in a coffin as if it were a chaise longue.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "BRAM HOLLIDAY (40s, bootlegger, pinstripes, a pistol bulge under his arm) drinks gin out of a tin funeral urn.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "The curtain parts.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "A man in a rain-soaked fedora steps through.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "A STRANGER (30s, slim, quiet, hands in his pockets).", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "We're closed, mister.", "name": "MAUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "The door said open.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "The door says a lot of things.", "name": "MAUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "I heard there was a game.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "You heard wrong.", "name": "BRAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Oh, let him sit, Bram. He's pretty.", "name": "OTTOLINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Is he police?", "name": "CYRIL", "speaker": 1, "ext": [], "paren": ["swallowing"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "No.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "You'd say that.", "name": "BRAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "I would.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "He takes a seat in the empty coffin, folding his coat over his knees.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Maude deals him in without waiting for permission.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "He turns up his cards, studies them, and sets them face-down.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "What's your name?", "name": "MAUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Does it matter?", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Everyone who sits here has one.", "name": "MAUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Ottoline blows smoke at the lamp.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Cyril clears his throat, drops a chip.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Bram watches the Stranger over the rim of the urn.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Nolan.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Just Nolan?", "name": "MAUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "It's what the boys at the dock call me.", "name": "NOLAN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Bram's urn stops halfway to his mouth.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Which dock?", "name": "BRAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Pier nine.", "name": "NOLAN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Pier nine's mine.", "name": "BRAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "I know.", "name": "NOLAN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "The gramophone needle hits the end of the record and ticks.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Nobody gets up to change it.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Cyril's hand goes to the little pearl-handled derringer in his boot.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "He thinks better of it.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Oh, I do love a scene.", "name": "OTTOLINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Shut it, Otty.", "name": "BRAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "You shut it. I'm having a lovely time.", "name": "OTTOLINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "Nobody has to get hurt.", "name": "NOLAN", "speaker": 5, "ext": [], "paren": ["to the table"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "Good. I've hurt enough people this week.", "name": "MAUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "You think you can walk in here and--", "name": "BRAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "I think we should all calm down--", "name": "CYRIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "I think he should deal--", "name": "OTTOLINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "Quiet!", "name": "MAUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "They stop.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "Maude lays down the deck.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "Slides one coffin lid shut with a bang that makes the lamp swing.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "Say your piece.", "name": "MAUDE", "speaker": 0, "ext": ["CONT'D"], "paren": ["to Nolan"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "Mr. Holliday's been shorting Pier nine for six months. The Chief says the count's off by forty crates.", "name": "NOLAN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "dialogue", "text": "Who's the Chief?", "name": "BRAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "The man whose pier it really is.", "name": "NOLAN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "That's a lie.", "name": "BRAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "dialogue", "text": "That's a receipt.", "name": "^NOLAN", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 62, "kind": "action", "text": "He lays a folded paper on the felt.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 63, "kind": "action", "text": "Maude picks it up, scans it, passes it to Cyril.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 64, "kind": "action", "text": "Cyril reads and goes grey.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 65, "kind": "dialogue", "text": "Bram. It's your signature.", "name": "CYRIL", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 66, "kind": "dialogue", "text": "It's forged.", "name": "BRAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 67, "kind": "dialogue", "text": "It's got the thumb.", "name": "CYRIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 68, "kind": "dialogue", "text": "Give me that!", "name": "BRAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 69, "kind": "action", "text": "He lunges.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 70, "kind": "action", "text": "Chips fly.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 71, "kind": "action", "text": "The urn clatters off.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 72, "kind": "action", "text": "Ottoline shrieks with laughter and scrambles backward.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 73, "kind": "action", "text": "Nolan doesn't move from his coffin.", "para": 12, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 74, "kind": "action", "text": "Bram's pistol is in his hand now, shaking, aimed at Nolan's chest.", "para": 12, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 75, "kind": "dialogue", "text": "Bram, put it down.", "name": "MAUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 76, "kind": "dialogue", "text": "He's not leaving.", "name": "BRAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 77, "kind": "dialogue", "text": "Not through the door, no.", "name": "NOLAN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 78, "kind": "action", "text": "Bram blinks.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 79, "kind": "action", "text": "The curtain behind him moves.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 80, "kind": "action", "text": "A shadow stretches along the wall.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 81, "kind": "action", "text": "Maude stands.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 82, "kind": "action", "text": "Her chair scrapes.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 83, "kind": "dialogue", "text": "Bram. Behind you.", "name": "MAUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 84, "kind": "action", "text": "He half turns.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 85, "kind": "action", "text": "Maude's ringed hand takes the pistol out of his grip, neat as a waiter lifting a plate.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 86, "kind": "action", "text": "She holds it by the barrel.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 87, "kind": "action", "text": "The gramophone needle skips.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 88, "kind": "action", "text": "Silence.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 89, "kind": "dialogue", "text": "Oh, Maude's the Chief!", "name": "OTTOLINE", "speaker": 2, "ext": [], "paren": ["delighted"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 90, "kind": "action", "text": "Nolan collects his cards.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 91, "kind": "action", "text": "Turns them over.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 92, "kind": "action", "text": "A full house.", "para": 17, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 93, "kind": "dialogue", "text": "Maude. Your deal.", "name": "NOLAN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 94, "kind": "dialogue", "text": "Of course it is.", "name": "MAUDE", "speaker": 0, "ext": [], "paren": ["dryly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 95, "kind": "transition", "text": "FADE OUT.", "present": [0, 1, 2, 3, 4, 5, 6]}]}