{"scene_id": "s01251", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01251.fountain", "heading": "INT. BOARDING HOUSE - KITCHEN - MORNING - 1911", "cast": [{"id": 0, "name": "ABIGAIL THORNBURY", "names": ["ABIGAIL THORNBURY", "ABIGAIL"], "gender": "f", "first": 6, "spoke": 21}, {"id": 1, "name": "ROSALIE THORNBURY-LAMB", "names": ["ROSALIE", "ROSALIE THORNBURY-LAMB"], "gender": "f", "first": 12, "spoke": 21}], "units": [{"u": 0, "kind": "heading", "text": "INT. BOARDING HOUSE - KITCHEN - MORNING - 1911", "present": []}, {"u": 1, "kind": "action", "text": "A long, low room with a range stove and a scrubbed deal table.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Copper pans hang from a rack.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain on the window.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A bowl of apples.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A kettle sings on the hob.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "ABIGAIL THORNBURY (50s, widow, apron over grey wool, hands red from lye) rolls pastry.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "She does it without thinking, as her mother did, and her mother's mother: out, turn, out, turn.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "Through the ceiling comes the sound of a bed creaking.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "A step.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "A pause.", "para": 2, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "A drawer slides shut.", "para": 2, "sent": 3, "present": [0]}, {"u": 12, "kind": "dialogue", "text": "Abigail? Are you there?", "name": "ROSALIE", "speaker": 1, "ext": ["O.S."], "paren": ["from upstairs, muffled"], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Where else would I be?", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": ["raising her voice slightly"], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "I can't find my blue hat.", "name": "ROSALIE", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "It's on the hook in the hall.", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "I looked there.", "name": "ROSALIE", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Look again.", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "A pause.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "A longer creak.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Then footsteps, light, down the back stairs.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "The kitchen door swings open and ROSALIE THORNBURY-LAMB (50s, younger sister, travelling coat, hat in hand) enters, pink in the cheeks.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "It was on the hook.", "name": "ROSALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "It's always on the hook.", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "I don't know how I missed it.", "name": "ROSALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "You were looking for a hat. You weren't looking for a hook.", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Rosalie sets the hat down on the table, beside the apples.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "She doesn't sit.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Abigail rolls and turns the pastry.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Is there tea?", "name": "ROSALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "The kettle's on.", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Rosalie takes two cups from the dresser.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Arranges them, saucers, spoons.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Pours when the kettle shrieks.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "She sets Abigail's cup on the table at her elbow and takes her own to the window.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "It's still raining.", "name": "ROSALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "It's been raining since Michaelmas.", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "She'd have hated that. Mother. Always said rain made the apples sour.", "name": "ROSALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "She said many things.", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "She said you'd stay.", "name": "ROSALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Abigail's hands pause on the pin.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Only for a second.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Then they roll.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "And she said you'd go. Both are true.", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Are they?", "name": "ROSALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Nobody's stopping you.", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "I thought you might.", "name": "ROSALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "I'd be a poor sister to bar a door.", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Rosalie sips her tea.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "Her face is turned to the window and the grey light; Abigail's is turned to the table.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "Neither sees the other's expression.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "The train is at noon.", "name": "ROSALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Then you'll want an early lunch.", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "I will.", "name": "ROSALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "I've an apple pie.", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "It's not baked.", "name": "ROSALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "It will be.", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "She lifts a flat circle of pastry and drapes it over a tin.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "Trims the edge with a knife in one smooth turn.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "Rosalie watches the knife.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "You've always been so good at that.", "name": "ROSALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "It's the only thing I'm good at.", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "That isn't true.", "name": "ROSALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "Tell me what else, then.", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": ["drily"], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "You were good at being left.", "name": "ROSALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "Abigail's knife stops.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "She doesn't look up.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "That's unkind.", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "It's the truth. I mean it kindly.", "name": "ROSALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "I know you do.", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "action", "text": "A long, quiet moment.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "The kettle ticks as it cools.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "Rosalie crosses, sets down her cup.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "Takes an apple from the bowl, then a second, and hands one to Abigail.", "para": 10, "sent": 3, "present": [0, 1]}, {"u": 74, "kind": "action", "text": "They peel in silence, side by side, the skins coming off in two unbroken spirals.", "para": 10, "sent": 4, "present": [0, 1]}, {"u": 75, "kind": "dialogue", "text": "Yours is longer.", "name": "ROSALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 76, "kind": "dialogue", "text": "It always is.", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 77, "kind": "action", "text": "She drops her spiral in the bin.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 78, "kind": "action", "text": "Rosalie keeps hers, curled in her palm like a small snake, a moment longer than she needs to.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 79, "kind": "dialogue", "text": "I'll write.", "name": "ROSALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 80, "kind": "dialogue", "text": "You won't.", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 81, "kind": "dialogue", "text": "I will.", "name": "ROSALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 82, "kind": "dialogue", "text": "Then I'll read it.", "name": "ABIGAIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 83, "kind": "action", "text": "Rosalie smiles.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 84, "kind": "action", "text": "She sets the peel on the table.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 85, "kind": "action", "text": "It uncurls slowly and lies there, pale, in the lamplight.", "para": 12, "sent": 2, "present": [0, 1]}, {"u": 86, "kind": "transition", "text": "FADE OUT.", "present": [0, 1]}]}