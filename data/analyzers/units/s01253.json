{"scene_id": "s01253", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01253.fountain", "heading": "INT. HOSPICE - FAMILY LOUNGE - AFTERNOON", "cast": [{"id": 0, "name": "MERCEDES ARANDA-LINDGREN", "names": ["MERCEDES ARANDA-LINDGREN", "MERCEDES"], "gender": "f", "first": 4, "spoke": 15}, {"id": 1, "name": "RAMIRO BELLWETHER", "names": ["RAMIRO BELLWETHER", "RAMIRO"], "gender": "m", "first": 7, "spoke": 8}, {"id": 2, "name": "CONSTANZA BELLWETHER-NAKAMURA", "names": ["CONSTANZA BELLWETHER-NAKAMURA", "CONSTANZA"], "gender": "f", "first": 7, "spoke": 5}, {"id": 3, "name": "FELIX BELLWETHER", "names": ["FELIX BELLWETHER", "FELIX"], "gender": "m", "first": 7, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOSPICE - FAMILY LOUNGE - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "A soft, sunny room: beige sofas, a fish tank, a jigsaw half-done on a coffee table.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A television plays a gardening programme with the sound off.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Somewhere down the hall, a trolley rattles.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. MERCEDES ARANDA-LINDGREN (50s, grey cardigan, low voice) pours four cups of tea from a pot she did not need to bring.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She sets the tray on the table with great care.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Her hands are very still.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "On the sofa sit three siblings: the eldest, RAMIRO BELLWETHER (50s, rumpled suit, wedding ring he keeps turning), the middle, CONSTANZA BELLWETHER-NAKAMURA (40s, ironed blouse, handbag clutched on her knees), and the youngest, FELIX BELLWETHER (30s, scruffy, headphones around his neck).", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "She's been better this week.", "name": "RAMIRO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "She asked for the radio.", "name": "FELIX", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "She asked for soup.", "name": "CONSTANZA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "She did.", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "She hands out cups.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Ramiro accepts his without looking.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Constanza sets hers on the table, untouched.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Felix cradles his between both palms as if it were a bird.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "She's been very bright these past days. It happens sometimes. A rally. We see it more than people expect.", "name": "MERCEDES", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "A rally.", "name": "RAMIRO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Yes.", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "So she's improving.", "name": "RAMIRO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "She's comfortable.", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "He nods, slowly.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Turns the ring.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "On the television, a woman in a straw hat bends to trim a rose, silent as a mime.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "When can she come home?", "name": "CONSTANZA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Mercedes lifts her own cup.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Sips.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Sets it down, rim to saucer, with no sound at all.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "That's a question I'd like to talk about.", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Not yet.", "name": "FELIX", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Felix.", "name": "RAMIRO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "I'm not ready.", "name": "FELIX", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Nobody's saying...", "name": "CONSTANZA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Felix.", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "He looks at her.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "She waits.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "The fish tank bubbles.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "A clownfish noses a plastic castle.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "When someone gets bright, like your mother, it often means they're gathering themselves. It can last a day. It can last a week. But it is, very often, the last good thing.", "name": "MERCEDES", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Constanza's hand finds her brother's arm.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Ramiro's ring stops turning.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Felix stares into the tea.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Is that what you meant by comfortable?", "name": "FELIX", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "It's what I meant.", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Silence.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "The trolley rattles down the corridor and fades.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Constanza opens her handbag, takes out a tissue, and folds it twice but does not use it.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "How long?", "name": "RAMIRO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Days.", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "How many?", "name": "RAMIRO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "I can't say exactly. I'd rather not guess in front of you.", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "He exhales.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Taps the sofa arm twice, hard, like a man hammering a nail.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Then stops.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "She wants to see the garden.", "name": "CONSTANZA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "She can see it. Today. We'll take the chair.", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "And the dog.", "name": "CONSTANZA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "Whatever she wants.", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "She wants the radio.", "name": "FELIX", "speaker": 3, "ext": [], "paren": ["looking up"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "Then bring the radio.", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "Felix nods.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "Stands, clumsy, spilling tea.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "He sets the cup on the tray and wipes his palms on his jeans.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "Constanza rises too.", "para": 10, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "Ramiro follows, last, placing his tea on the table with a precision that looks like violence.", "para": 10, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "At the door he stops.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "Doctor.", "name": "RAMIRO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "Yes?", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "Thank you for the tea.", "name": "RAMIRO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "dialogue", "text": "You're welcome.", "name": "MERCEDES", "speaker": 0, "ext": [], "paren": ["gently"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "The three siblings leave.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "Mercedes remains alone with the tray, the unfinished cups, the jigsaw.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "action", "text": "She picks up a puzzle piece from the table, turns it in her fingers, and sets it carefully in the sky of a sunny picture, where it fits exactly.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "transition", "text": "FADE OUT.", "present": [0, 1, 2, 3]}]}