{"scene_id": "s01254", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01254.fountain", "heading": "EXT. CANYON RIM - CAMP - DAWN", "cast": [{"id": 0, "name": "ELIJAH VANCE-HOLLOWAY", "names": ["ELIJAH VANCE-HOLLOWAY", "ELIJAH"], "gender": "m", "first": 6, "spoke": 21}, {"id": 1, "name": "PEPPER", "names": ["PEPPER"], "gender": "f", "first": 9, "spoke": 9}, {"id": 2, "name": "DUNLEAVY", "names": ["DUNLEAVY"], "gender": "?", "first": 9, "spoke": 0}, {"id": 3, "name": "TOBIAS MWANGI", "names": ["TOBIAS MWANGI", "TOBIAS"], "gender": "m", "first": 12, "spoke": 5}, {"id": 4, "name": "OLD AUGUSTUS FENWICK", "names": ["OLD AUGUSTUS FENWICK", "AUGUSTUS"], "gender": "m", "first": 14, "spoke": 8}, {"id": 5, "name": "^TOBIAS", "names": ["^TOBIAS"], "gender": "?", "first": 84, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. CANYON RIM - CAMP - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Red stone against a lemon sky.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A thin column of smoke.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Four bedrolls around a dead fire, a coffee pot on a flat rock.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Horses hobbled in a stand of juniper.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A tall man sits cross-legged on a saddle, rolling a cigarette.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "ELIJAH VANCE-HOLLOWAY (40s, black hat, a face like a closed door).", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "He licks the paper, tucks it behind his ear, and doesn't light it.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "Beside him a lean woman scrapes a skillet clean with a knife.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "PERPETUA \"PEPPER\" DUNLEAVY (30s, braided hair, two pistols).", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "She scrapes slowly, listening.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "The third bedroll is empty.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "The fourth holds a boy of fifteen, sleeping with his boots on: TOBIAS MWANGI (15, freckles, too-big shirt).", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "He snores.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "At the edge of camp, a stooped man in a long grey duster watches the horizon with a spyglass: OLD AUGUSTUS FENWICK (60s, spectacles pushed up on his forehead).", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Smoke.", "name": "AUGUSTUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Whose?", "name": "ELIJAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "South. Two miles.", "name": "AUGUSTUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Ours or theirs?", "name": "ELIJAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Don't know. Could be anybody's.", "name": "AUGUSTUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Pepper stops scraping.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "She sets the skillet down and wipes her knife on her trouser leg.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "She does not look at Elijah.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "He does not look at her.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "We should wake the boy.", "name": "PEPPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Let him sleep.", "name": "ELIJAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "He'll want to be awake for this.", "name": "PEPPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "No, he won't.", "name": "ELIJAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Augustus lowers the spyglass.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "He turns it over in his hands, studies the brass, then screws it shut.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Eleven riders.", "name": "AUGUSTUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "You said smoke.", "name": "ELIJAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "I said smoke. Then I counted.", "name": "AUGUSTUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Elijah draws the cigarette from behind his ear.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Strikes a match on his boot.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "The flame trembles.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "He holds it a long time before lighting, as if the match were something to pray to.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Eleven.", "name": "ELIJAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "We have four.", "name": "PEPPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Three, with a child.", "name": "ELIJAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Four.", "name": "AUGUSTUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Four.", "name": "ELIJAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "We could ride north.", "name": "PEPPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "They'd see the dust.", "name": "ELIJAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "We could ride now.", "name": "PEPPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "They'd see the dust.", "name": "ELIJAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "She nods, short, like a woman agreeing to be hanged.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "She stands, her two pistols clinking, and crosses to the juniper where the horses stand.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "She runs her hand along the nearest neck.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "At the bedroll, the boy turns over and opens one eye.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Is it morning?", "name": "TOBIAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "It's morning.", "name": "ELIJAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "Is there coffee?", "name": "TOBIAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "There will be.", "name": "ELIJAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "Tobias sits up.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Rubs his face.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Sees Pepper at the horses.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "Sees Augustus with the spyglass.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Sees the match burn down to Elijah's fingers.", "para": 10, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "Who's coming?", "name": "TOBIAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "Nobody answers.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "Elijah drops the match.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "It dies in the dust.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "dialogue", "text": "Pepper. Saddle the boy's horse.", "name": "ELIJAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "dialogue", "text": "I've done it.", "name": "PEPPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "Augustus. Water.", "name": "ELIJAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "dialogue", "text": "I filled it last night.", "name": "AUGUSTUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "dialogue", "text": "You always do.", "name": "ELIJAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "action", "text": "He stands.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "Dusts his knees.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "action", "text": "Hands the unlit cigarette to Tobias, who takes it, astonished.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "dialogue", "text": "What's this for?", "name": "TOBIAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "dialogue", "text": "For after.", "name": "ELIJAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "dialogue", "text": "You don't say that to a boy.", "name": "PEPPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "dialogue", "text": "I'm saying it.", "name": "ELIJAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "action", "text": "A distant sound: horses, many horses, a soft thunder rolling over the rim.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 76, "kind": "action", "text": "Augustus puts the spyglass in his pocket.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 77, "kind": "action", "text": "Pepper draws one pistol and spins it once on her finger.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 78, "kind": "action", "text": "Tobias gets his boots under him.", "para": 13, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 79, "kind": "dialogue", "text": "Can I have a gun?", "name": "TOBIAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 80, "kind": "dialogue", "text": "No.", "name": "ELIJAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 81, "kind": "dialogue", "text": "Give him mine.", "name": "PEPPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 82, "kind": "dialogue", "text": "Pepper.", "name": "ELIJAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 83, "kind": "dialogue", "text": "He's got a right.", "name": "PEPPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 84, "kind": "dialogue", "text": "I've got a right.", "name": "^TOBIAS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 85, "kind": "action", "text": "They speak together, her voice dry, his voice cracking.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 86, "kind": "action", "text": "Elijah looks from one to the other, then at the dust cloud boiling on the horizon, then at the coffee pot.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 87, "kind": "dialogue", "text": "Put on the coffee.", "name": "ELIJAH", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 88, "kind": "dialogue", "text": "Elijah...", "name": "AUGUSTUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 89, "kind": "dialogue", "text": "If we're going to die, we'll die warm.", "name": "ELIJAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 90, "kind": "action", "text": "Pepper sets the pot on the dead coals.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 91, "kind": "action", "text": "Tobias snaps twigs into a pile.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 92, "kind": "action", "text": "Augustus brings a match.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 93, "kind": "action", "text": "The thunder rolls closer.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 94, "kind": "action", "text": "The twigs catch.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 95, "kind": "transition", "text": "FADE OUT.", "present": [0, 1, 2, 3, 4, 5]}]}