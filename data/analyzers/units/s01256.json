{"scene_id": "s01256", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01256.fountain", "heading": "INT. UNIVERSITY BOATHOUSE - ERG ROOM - 5 A.M.", "cast": [{"id": 0, "name": "COACH NADEZHDA PROKOFIEVA", "names": ["COACH NADEZHDA PROKOFIEVA", "NADEZHDA"], "gender": "f", "first": 6, "spoke": 15}, {"id": 1, "name": "LEO", "names": ["LEO"], "gender": "m", "first": 7, "spoke": 18}, {"id": 2, "name": "ARMSTRONG-DIOP", "names": ["ARMSTRONG-DIOP"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "STRANGER", "names": ["STRANGER"], "gender": "m", "first": 9, "spoke": 3}, {"id": 4, "name": "SCARLET UNIFORM", "names": ["SCARLET UNIFORM"], "gender": "?", "first": 9, "spoke": 0}, {"id": 5, "name": "KOFI", "names": ["KOFI"], "gender": "?", "first": 31, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. UNIVERSITY BOATHOUSE - ERG ROOM - 5 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "A long low room of rowing machines in rows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Windows fogged.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A whiteboard with names and splits.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The air smells of rubber and sweat.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Two rowers sit at adjacent machines, cooling down.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "COACH NADEZHDA PROKOFIEVA (50s, tracksuit, thermos, calm as a stopwatch) stands at the whiteboard capping a marker.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "LEOPOLD \"LEO\" ARMSTRONG-DIOP (20s, stroke seat, shoulders like a door) wipes his face with a towel and doesn't speak.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "The other rower, a stranger to the room, rests his hands on his knees.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "A STRANGER IN A SCARLET UNIFORM (20s, rival college crest, lean and quiet).", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Leo. Splits.", "name": "NADEZHDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Two-oh-one.", "name": "LEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Pace?", "name": "NADEZHDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Thirty-two.", "name": "LEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Good.", "name": "NADEZHDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "She writes it.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Leo glances at the Stranger, who has not looked up since he sat down.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Coach, who's this?", "name": "LEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "A guest.", "name": "NADEZHDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Guest of who?", "name": "LEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Of me.", "name": "NADEZHDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Leo's eyes narrow.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "The Stranger lifts his head, finally.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "He has an easy, friendly face.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Morning.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "You're from Harlow.", "name": "LEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "I'm from a lot of places.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Your kit says Harlow.", "name": "LEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "It's a good kit.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Nadezhda caps the marker, sets it in the tray, and takes a sip from her thermos.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "She has the air of a woman watching two dogs decide whether to be friends.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Leo, this is Kofi. He rows for Harlow. He's transferring.", "name": "NADEZHDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Transferring where?", "name": "LEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Here.", "name": "NADEZHDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "A silence.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Leo lowers the towel slowly.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "He looks at the whiteboard, at the splits.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "His name is at the top.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Under it is another name, written in a different hand and wiped out.", "para": 7, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Don't worry. I'm not here for your seat.", "name": "KOFI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Then what are you here for?", "name": "LEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Seven seat. I row in the middle.", "name": "KOFI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "We have a seven seat.", "name": "LEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "You have a seven seat that can't hold a pace.", "name": "KOFI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "That's Marcus. He's my roommate.", "name": "LEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "I know. I'm sorry.", "name": "KOFI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Leo gets up.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "The erg handle slides back with a clack.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "He stands in front of the Stranger, jaw working.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "Kofi stays seated, hands still.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "Sit down, Leo.", "name": "NADEZHDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "I'm fine.", "name": "LEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "Sit down.", "name": "NADEZHDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "He sits.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "The machine sighs.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "Outside, geese take off from the river in a bark of wings.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "Does Marcus know?", "name": "LEO", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "Marcus knows.", "name": "NADEZHDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "dialogue", "text": "When did he find out?", "name": "LEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "Yesterday.", "name": "NADEZHDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "He didn't say.", "name": "LEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "dialogue", "text": "He asked me not to let you hear it from him.", "name": "NADEZHDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "Leo shuts his eyes.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "Draws a long breath through his nose.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "Wipes his face with the towel, then wipes it again, though there's nothing left to wipe.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "Kofi leans forward.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "dialogue", "text": "I'd rather have rowed beside him, honestly.", "name": "KOFI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "dialogue", "text": "Don't.", "name": "LEO", "speaker": 1, "ext": [], "paren": ["without opening his eyes"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "dialogue", "text": "I mean it.", "name": "KOFI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "dialogue", "text": "I said don't.", "name": "LEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "action", "text": "Nadezhda crosses to the nearest erg and takes a seat.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "action", "text": "She straps in her feet.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "action", "text": "She looks like she means to row.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "dialogue", "text": "Both of you. Twenty minutes. Steady state. Twenty-two.", "name": "NADEZHDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "dialogue", "text": "Coach...", "name": "LEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 75, "kind": "dialogue", "text": "That's not a request.", "name": "NADEZHDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 76, "kind": "action", "text": "Leo opens his eyes.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 77, "kind": "action", "text": "Looks at Kofi.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 78, "kind": "action", "text": "Kofi holds the look, and then, slowly, offers a hand.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 79, "kind": "action", "text": "Leo looks at the hand.", "para": 13, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 80, "kind": "action", "text": "Takes it.", "para": 13, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 81, "kind": "action", "text": "They shake once, stiff, like men sealing a bad bargain.", "para": 13, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 82, "kind": "dialogue", "text": "Twenty-two?", "name": "KOFI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 83, "kind": "dialogue", "text": "Twenty-two.", "name": "LEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 84, "kind": "action", "text": "They turn to their machines and begin to row.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 85, "kind": "action", "text": "The chains whir.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 86, "kind": "action", "text": "The fly wheels whisper.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 87, "kind": "action", "text": "Nadezhda pulls her first stroke, then settles into the rhythm.", "para": 14, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 88, "kind": "dialogue", "text": "Better.", "name": "NADEZHDA", "speaker": 0, "ext": [], "paren": ["softly, as if to herself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 89, "kind": "transition", "text": "FADE OUT.", "present": [0, 1, 2, 3, 4, 5]}]}