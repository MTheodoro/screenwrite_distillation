{"scene_id": "s01257", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01257.fountain", "heading": "EXT. VINEYARD TERRACE - EVENING", "cast": [{"id": 0, "name": "CAMILLE ROUSSEAU-ADEBAYO", "names": ["CAMILLE ROUSSEAU-ADEBAYO", "CAMILLE"], "gender": "?", "first": 4, "spoke": 3}, {"id": 1, "name": "JOSEPHINE LIND", "names": ["JOSEPHINE LIND", "JOSEPHINE"], "gender": "f", "first": 5, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. VINEYARD TERRACE - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Late sun slants across rows of vines.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cicadas.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A stone table under a pergola, two glasses of ros\u00e9 sweating on a linen cloth.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CAMILLE ROUSSEAU-ADEBAYO (30s, linen shirt, bare feet) sits sideways on a bench, one knee drawn up.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Opposite her, JOSEPHINE LIND (30s, wide straw hat, sunglasses pushed up into her hair) turns the stem of her glass between two fingers.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Neither has spoken for a long time.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "The light moves a finger's width across the cloth.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You're quiet.", "name": "CAMILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I'm looking.", "name": "JOSEPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "At what?", "name": "CAMILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "At her, the way she sits. I forgot she did that.", "name": "JOSEPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Did what?", "name": "CAMILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Josephine smiles at the vines, not at Camille.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "A breeze lifts the corner of the cloth and lets it fall.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Nothing.", "name": "JOSEPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Camille reaches out and straightens the cloth.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Her fingers brush Josephine's, and neither moves them away.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "transition", "text": "FADE OUT.", "present": [0, 1]}]}