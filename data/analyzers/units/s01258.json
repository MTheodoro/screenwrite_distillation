{"scene_id": "s01258", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01258.fountain", "heading": "INT. SAFE HOUSE - WAREHOUSE LOFT - NIGHT", "cast": [{"id": 0, "name": "DOMINIKA SZCZEPA", "names": ["DOMINIKA SZCZEPA", "DOMINIKA"], "gender": "f", "first": 8, "spoke": 21}, {"id": 1, "name": "SKA-REYES", "names": ["SKA-REYES"], "gender": "?", "first": 8, "spoke": 0}, {"id": 2, "name": "OTIS WHITLOW", "names": ["OTIS WHITLOW", "OTIS"], "gender": "?", "first": 9, "spoke": 10}, {"id": 3, "name": "KALINDA RAINEY", "names": ["KALINDA RAINEY", "KALINDA"], "gender": "f", "first": 10, "spoke": 7}, {"id": 4, "name": "TEODOR VASILESCU", "names": ["TEODOR VASILESCU", "TEODOR"], "gender": "m", "first": 11, "spoke": 9}, {"id": 5, "name": "MAXIMILLIAN HOLT", "names": ["MAXIMILLIAN HOLT", "MAXIMILLIAN"], "gender": "?", "first": 12, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. SAFE HOUSE - WAREHOUSE LOFT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A raw concrete loft above a shuttered print shop.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Plastic sheeting over broken windows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A table with a laptop, four phones, and an open pizza box.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single lamp.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Rain hammers the tin roof.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "FIVE PEOPLE sit around the table.", "para": 1, "sent": 0, "present": []}, {"u": 7, "kind": "action", "text": "The mood is brittle.", "para": 1, "sent": 1, "present": []}, {"u": 8, "kind": "action", "text": "DOMINIKA SZCZEPA\u0143SKA-REYES (40s, team leader, silver streak in black hair) paces the room with a phone against her chest.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "OTIS WHITLOW (50s, tech, cardigan over body armour) stares at the laptop screen.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "KALINDA RAINEY (30s, field agent, torn jacket, bandaged hand) sits on the table's edge, swinging a boot.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "TEODOR VASILESCU (30s, driver, nervous, cigarette cupped in his palm) keeps checking the window.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "And in the corner on a wooden chair, hands zip-tied behind him, sits MAXIMILLIAN HOLT (60s, tailored suit, torn at the knees).", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "His face is calm, as if he were waiting for a train.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Otis. How long?", "name": "DOMINIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Four minutes. Maybe five.", "name": "OTIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Maybe?", "name": "DOMINIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "The uplink's unstable.", "name": "OTIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "They'll be here before it finishes.", "name": "KALINDA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "They won't.", "name": "OTIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "They will.", "name": "KALINDA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Headlights. Two blocks.", "name": "TEODOR", "speaker": 4, "ext": [], "paren": ["from window"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Whose?", "name": "DOMINIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Don't know.", "name": "TEODOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Teodor, whose?", "name": "DOMINIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "I can't see! The rain!", "name": "TEODOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Dominika crosses to the window in three strides.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Teodor makes room.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "She presses her forehead to the glass.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "A pair of white lights crawls along the wet street.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Stops.", "para": 7, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Cuts out.", "para": 7, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Parked.", "name": "DOMINIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "They're early.", "name": "KALINDA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "They're patient.", "name": "DOMINIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "They're my friends.", "name": "MAXIMILLIAN", "speaker": 5, "ext": [], "paren": ["from corner, mild"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "All heads turn.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "He gives a small, pleasant smile.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "They've been very patient with me. Longer than you, Dominika.", "name": "MAXIMILLIAN", "speaker": 5, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Shut him up.", "name": "DOMINIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "With what?", "name": "KALINDA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Anything.", "name": "DOMINIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Kalinda rummages in her jacket.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Finds a roll of tape.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Strides across the loft, tears a strip, and presses it over his mouth.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "His smile continues beneath the tape, visible in the eyes.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Three minutes.", "name": "OTIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "Boss, what do we do if it's them?", "name": "TEODOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "We don't open.", "name": "DOMINIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "They'll break the door.", "name": "TEODOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "Then we are not here.", "name": "DOMINIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "We're very much here.", "name": "KALINDA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "We are leaving.", "name": "DOMINIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "I can't leave. The transfer.", "name": "OTIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "Then finish it. Kalinda, you're with Otis. Teodor, the van, engine on, lights off.", "name": "DOMINIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "And him?", "name": "TEODOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "He comes.", "name": "DOMINIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "Boss, he's a hostage. We take him out the back, they'll see.", "name": "TEODOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "dialogue", "text": "He's not a hostage, Teodor. He's insurance.", "name": "DOMINIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "On the chair, Maximilian's eyebrows lift.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "Don't look so pleased.", "name": "KALINDA", "speaker": 3, "ext": [], "paren": ["to Maximilian"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "dialogue", "text": "Two minutes. I'm at ninety percent.", "name": "OTIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "dialogue", "text": "Where's the flash drive?", "name": "DOMINIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "dialogue", "text": "In the pizza box.", "name": "OTIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "dialogue", "text": "You put it in the pizza box?", "name": "DOMINIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "dialogue", "text": "They never look in the pizza box.", "name": "OTIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "dialogue", "text": "Otis!", "name": "DOMINIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "dialogue", "text": "It's worked before!", "name": "OTIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "action", "text": "She snatches the box.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "action", "text": "Flips the lid.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "action", "text": "Under the congealed cheese lies a thumb drive in a sandwich bag.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "action", "text": "She holds it up.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "action", "text": "A flicker of grim approval crosses her face.", "para": 11, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "dialogue", "text": "Fine.", "name": "DOMINIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "action", "text": "A thump on the stairs.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 75, "kind": "action", "text": "Then another.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 76, "kind": "action", "text": "Everyone freezes.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 77, "kind": "action", "text": "Dominika puts her finger to her lips.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 78, "kind": "action", "text": "Footsteps climb, slow, unhurried.", "para": 12, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 79, "kind": "dialogue", "text": "That's them.", "name": "TEODOR", "speaker": 4, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 80, "kind": "dialogue", "text": "That's one of them.", "name": "KALINDA", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 81, "kind": "dialogue", "text": "Otis.", "name": "DOMINIKA", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 82, "kind": "dialogue", "text": "Ninety-eight.", "name": "OTIS", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 83, "kind": "action", "text": "The footsteps stop at the door.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 84, "kind": "action", "text": "A polite knock.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 85, "kind": "action", "text": "Three times.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 86, "kind": "action", "text": "Behind the tape, Maximilian closes his eyes, relieved.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 87, "kind": "action", "text": "Dominika raises her pistol and aims at the door.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 88, "kind": "dialogue", "text": "Teodor. Back stairs.", "name": "DOMINIKA", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 89, "kind": "dialogue", "text": "Boss...", "name": "TEODOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 90, "kind": "dialogue", "text": "Go.", "name": "DOMINIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 91, "kind": "transition", "text": "FADE OUT.", "present": [0, 1, 2, 3, 4, 5]}]}