{"scene_id": "s01259", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01259.fountain", "heading": "INT. VICTORIAN NURSERY - NIGHT", "cast": [{"id": 0, "name": "PENELOPE ASHWORTH", "names": ["PENELOPE ASHWORTH", "PENELOPE"], "gender": "f", "first": 6, "spoke": 5}, {"id": 1, "name": "BRIDGET OLDACRE", "names": ["BRIDGET OLDACRE", "BRIDGET"], "gender": "?", "first": 7, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. VICTORIAN NURSERY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A tall, narrow room at the top of a stair.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Gaslight burns low.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A rocking horse, a dollhouse, a cradle with its hood drawn forward.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The wallpaper is a pattern of faded roses.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A window rattles in its frame.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "MRS. PENELOPE ASHWORTH (40s, grey silk, a bunch of keys at her waist) stands in the doorway holding a candle.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Behind her, her stern-faced maid, BRIDGET OLDACRE (20s, white cap, apron), clutches a coal scuttle.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Bridget, did you wind the music box?", "name": "PENELOPE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "No, ma'am.", "name": "BRIDGET", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Then who did?", "name": "PENELOPE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "A tinkling melody drifts from the cradle.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "The hood is drawn forward.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Neither woman moves.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "It's the draught, ma'am.", "name": "BRIDGET", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "There is no draught, Bridget.", "name": "PENELOPE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "The tune slows.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Stumbles.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "A tiny creak as the cradle rocks once.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Ma'am, the baby's been in the churchyard since March.", "name": "BRIDGET", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "I know it.", "name": "PENELOPE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She steps forward.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "The candle gutters.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "The rocking stops.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Hush, my darling. Mother's here.", "name": "PENELOPE", "speaker": 0, "ext": ["CONT'D"], "paren": ["softly"], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "The hood of the cradle lifts, ever so slightly, from within.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "transition", "text": "CUT TO BLACK.", "present": [0, 1]}]}