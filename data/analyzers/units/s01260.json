{"scene_id": "s01260", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01260.fountain", "heading": "INT. INTERROGATION ROOM - NIGHT", "cast": [{"id": 0, "name": "LIEUTENANT ISIDORE MCALLISTER-KANE", "names": ["LIEUTENANT ISIDORE MCALLISTER-KANE"], "gender": "?", "first": 1, "spoke": 9}, {"id": 1, "name": "BENEDEK VARGA", "names": ["BENEDEK VARGA"], "gender": "?", "first": 1, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. INTERROGATION ROOM - NIGHT", "present": []}, {"u": 1, "kind": "dialogue", "text": "Your alibi has a hole in it, Mr. Varga.", "name": "LIEUTENANT ISIDORE MCALLISTER-KANE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 2, "kind": "dialogue", "text": "Everyone's alibi has a hole in it, Lieutenant.", "name": "BENEDEK VARGA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 3, "kind": "dialogue", "text": "Mine doesn't.", "name": "LIEUTENANT ISIDORE MCALLISTER-KANE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 4, "kind": "dialogue", "text": "You haven't been asked.", "name": "BENEDEK VARGA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "You say you were at the cinema.", "name": "LIEUTENANT ISIDORE MCALLISTER-KANE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "I was at the cinema.", "name": "BENEDEK VARGA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "The ticket stub is dated Tuesday.", "name": "LIEUTENANT ISIDORE MCALLISTER-KANE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Then I went on Tuesday.", "name": "BENEDEK VARGA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "The robbery was on Wednesday.", "name": "LIEUTENANT ISIDORE MCALLISTER-KANE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Then I was somewhere else on Wednesday.", "name": "BENEDEK VARGA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Where?", "name": "LIEUTENANT ISIDORE MCALLISTER-KANE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I'd have to think.", "name": "BENEDEK VARGA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Think out loud.", "name": "LIEUTENANT ISIDORE MCALLISTER-KANE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "My mother's. She makes goulash on Wednesdays.", "name": "BENEDEK VARGA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Your mother died in March.", "name": "LIEUTENANT ISIDORE MCALLISTER-KANE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "So she did.", "name": "BENEDEK VARGA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Mr. Varga.", "name": "LIEUTENANT ISIDORE MCALLISTER-KANE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Lieutenant.", "name": "BENEDEK VARGA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}