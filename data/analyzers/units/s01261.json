{"scene_id": "s01261", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01261.fountain", "heading": "INT. LAUNDROMAT PAYPHONE ALCOVE - NIGHT", "cast": [{"id": 0, "name": "KENDRA ABERNATHY-VOSS", "names": ["KENDRA ABERNATHY-VOSS", "KENDRA"], "gender": "f", "first": 4, "spoke": 14}, {"id": 1, "name": "FATHER", "names": ["FATHER"], "gender": "?", "first": 8, "spoke": 14}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAUNDROMAT PAYPHONE ALCOVE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Humming dryers.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A bank of washers behind a glass wall.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A payphone on a tile wall, its cord scarred by years of nervous fingers.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "KENDRA ABERNATHY-VOSS (30s, hospital badge on a lanyard, hair wet from the rain) feeds coins into the slot.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She dials with trembling care.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "The phone rings twice.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "A click.", "para": 2, "sent": 1, "present": [0]}, {"u": 8, "kind": "dialogue", "text": "Yeah.", "name": "FATHER", "speaker": 1, "ext": ["V.O."], "paren": ["through the receiver, gruff"], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Dad. It's me.", "name": "KENDRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Kendra. Thought you'd be asleep.", "name": "FATHER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I'm on nights this week.", "name": "KENDRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Right. Right, nights. They work you too hard.", "name": "FATHER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "It's fine.", "name": "KENDRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "You eating?", "name": "FATHER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Yes.", "name": "KENDRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Real food?", "name": "FATHER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Dad.", "name": "KENDRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Okay, okay.", "name": "FATHER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "On the line, a television murmurs in another room.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She winds the metal cord around her finger until the tip turns white.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "How's Mom?", "name": "KENDRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "She's good. Good. She's in bed.", "name": "FATHER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "She sleeping?", "name": "KENDRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "She's, uh. Yeah. She's sleeping.", "name": "FATHER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Dad.", "name": "KENDRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "What?", "name": "FATHER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "You're doing the voice.", "name": "KENDRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "What voice?", "name": "FATHER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "The one you used when Buster died.", "name": "KENDRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "A long pause on the line.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "The television fades out.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Then a breath, shaky.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Honey, I was going to call you.", "name": "FATHER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "When?", "name": "KENDRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "In the morning. After you slept.", "name": "FATHER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Kendra rests her forehead against the cold tile.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "A dryer buzzes behind her.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "She doesn't turn.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "What time?", "name": "KENDRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "About nine o'clock. Just after the nurses.", "name": "FATHER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "I'm coming.", "name": "KENDRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Honey, there's nothing to...", "name": "FATHER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "I'm coming, Dad.", "name": "KENDRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "She hangs the receiver on its hook, very gently, as though it were asleep.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Stands there a long moment.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Then she goes to the glass wall, opens a dryer, and starts folding warm towels one by one.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 48, "kind": "transition", "text": "FADE OUT.", "present": [0, 1]}]}