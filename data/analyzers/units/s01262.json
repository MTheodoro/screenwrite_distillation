{"scene_id": "s01262", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01262.fountain", "heading": "INT. PENGUIN HOUSE - ZOO - MORNING", "cast": [{"id": 0, "name": "TIMBO", "names": ["TIMBO"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "OKAFOR", "names": ["OKAFOR"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "PRUDHOMME LAVOIE", "names": ["PRUDHOMME LAVOIE", "PRUDHOMME"], "gender": "?", "first": 5, "spoke": 2}, {"id": 3, "name": "GRETA SOLBERG", "names": ["GRETA SOLBERG", "GRETA"], "gender": "?", "first": 6, "spoke": 2}, {"id": 4, "name": "ANAND BHATT", "names": ["ANAND BHATT", "ANAND"], "gender": "?", "first": 7, "spoke": 3}, {"id": 5, "name": "BEATA KWIATKOWSKA", "names": ["BEATA KWIATKOWSKA"], "gender": "?", "first": 8, "spoke": 0}, {"id": 6, "name": "WILFRED PARRY", "names": ["WILFRED PARRY", "WILFRED"], "gender": "?", "first": 9, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. PENGUIN HOUSE - ZOO - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "A glass-walled enclosure of artificial ice and real fish smell.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Six keepers in waders jostle around a bucket of herring.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The penguins watch from a rock like a jury.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "TIMOTHY \"TIMBO\" OKAFOR (40s, head keeper) hands out gloves.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "His assistant PRUDHOMME LAVOIE (30s, clipboard) counts birds.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "Trainee GRETA SOLBERG (20s, notebook) takes notes.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "Veterinarian DR. ANAND BHATT (50s, stethoscope) squints at a limping bird.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "Cleaner BEATA KWIATKOWSKA (60s, mop, headphones) hums.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "action", "text": "Intern WILFRED PARRY (19, enormous boots) holds the bucket upside down.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "dialogue", "text": "Wilfred, the bucket.", "name": "TIMBO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "Sorry, Timbo.", "name": "WILFRED", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "action", "text": "He rights it.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "action", "text": "Herring slides across the floor.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "action", "text": "Three penguins launch themselves after it.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "That's thirty-one.", "name": "PRUDHOMME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "Thirty-two.", "name": "GRETA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "Thirty-one.", "name": "PRUDHOMME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "Thirty, plus the one on Beata's boot.", "name": "ANAND", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "action", "text": "Beata looks down.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "action", "text": "A penguin stands on her boot, staring up.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "action", "text": "She lifts her headphones, nods to it, puts them back, and goes on mopping.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Dr. Bhatt, the limp?", "name": "TIMBO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "It's a sulk.", "name": "ANAND", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "A sulk?", "name": "TIMBO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "He wants the rock the other one has.", "name": "ANAND", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "Sulk. Rock. Other one.", "name": "GRETA", "speaker": 3, "ext": [], "paren": ["writing"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "They all look at the rock.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "A fat penguin sits on it, smug, wings folded behind it like an old man at a bus stop.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "I'll swap them.", "name": "WILFRED", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "No!", "name": "TIMBO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "Too late.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "action", "text": "Wilfred wades in.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "Penguins scatter.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "The sulker slips onto the rock.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "The fat one slides off and lands on Wilfred's boot.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "Everyone sighs.", "para": 5, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "transition", "text": "FADE OUT.", "present": [0, 1, 2, 3, 4, 5, 6]}]}