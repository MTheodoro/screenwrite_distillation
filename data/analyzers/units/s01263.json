{"scene_id": "s01263", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01263.fountain", "heading": "INT. PLANETARIUM - DOME THEATRE - NIGHT", "cast": [{"id": 0, "name": "LAVINIA MORROW-ESPOSITO", "names": ["LAVINIA MORROW-ESPOSITO", "LAVINIA"], "gender": "?", "first": 7, "spoke": 20}, {"id": 1, "name": "ELIAN TREMAINE", "names": ["ELIAN TREMAINE", "ELIAN"], "gender": "?", "first": 10, "spoke": 16}], "units": [{"u": 0, "kind": "heading", "text": "INT. PLANETARIUM - DOME THEATRE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A hushed circular hall.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of reclining seats fan out toward a central projector like a black beetle.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Overhead, a star field turns slowly on the white dome, thousands of points of light so soft they seem to breathe.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The air smells of carpet and warm dust.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Rows of empty seats.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "Not quite empty.", "para": 1, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "At the lectern at the front stands LAVINIA MORROW-ESPOSITO (30s, astronomer, wool cardigan, a laser pointer lit in her hand).", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "She is rehearsing.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "She has done this speech a hundred times and has never said it right.", "para": 2, "sent": 2, "present": [0]}, {"u": 10, "kind": "action", "text": "In the back row, half in shadow, sits ELIAN TREMAINE (30s, night guard, flashlight dark in his lap).", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He came in to check the doors and stayed.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Good evening, everyone. Welcome to the Southern Sky.", "name": "LAVINIA", "speaker": 0, "ext": [], "paren": ["to the empty seats"], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She sweeps the laser over the dome.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "A red dot dances among the stars.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "If you look up now, you'll see the constellation we call the Southern Cross.", "name": "LAVINIA", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the empty seats"], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She stops.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Lowers the pointer.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Mutters.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Too slow. They'll be asleep by the third star.", "name": "LAVINIA", "speaker": 0, "ext": ["CONT'D"], "paren": ["muttering"], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "I wasn't.", "name": "ELIAN", "speaker": 1, "ext": [], "paren": ["from the dark"], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She jumps.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "The laser skitters across the dome.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "He half stands, flashlight raised like a white flag.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Sorry. I didn't mean to scare you.", "name": "ELIAN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "How long have you been there?", "name": "LAVINIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Since Orion.", "name": "ELIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "That's the second slide.", "name": "LAVINIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Is it?", "name": "ELIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Then you've missed the introduction.", "name": "LAVINIA", "speaker": 0, "ext": [], "paren": ["drily"], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "I liked what I heard.", "name": "ELIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "She studies him: the grey uniform, the badge, the way he sits with his knees turned out, careful of the seat in front.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "He does not look like a man who has ever been in the way.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "I'm supposed to give this to a hundred schoolchildren tomorrow.", "name": "LAVINIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "You'd be good at that.", "name": "ELIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "You haven't heard me.", "name": "LAVINIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "I've heard enough.", "name": "ELIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "She almost smiles.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Taps the lectern with the pointer.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "The stars drift.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Would you stay?", "name": "LAVINIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "For the rehearsal?", "name": "ELIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "For the audience.", "name": "LAVINIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "He sits back.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "Lays the flashlight on the carpet.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Go ahead.", "name": "ELIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "She faces the dome.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Takes a long breath.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Her voice, when it comes, is lower, slower, as though she were speaking to a single person.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Good evening. Tonight we begin with a very old idea. That what you see up there is not above you but behind you.", "name": "LAVINIA", "speaker": 0, "ext": [], "paren": ["to the dome"], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Behind?", "name": "ELIAN", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "The light you're looking at left its star before you were born. Some of it before anyone was born.", "name": "LAVINIA", "speaker": 0, "ext": [], "paren": ["to Elian"], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "So it's gone.", "name": "ELIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "The star may be gone. The light isn't.", "name": "LAVINIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "A silence.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "The dome turns.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "A faint wash of blue drifts across their faces.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "Say it. Just say it.", "name": "LAVINIA", "speaker": 0, "ext": ["CONT'D"], "paren": ["to herself, barely"], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "What?", "name": "ELIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "Nothing.", "name": "LAVINIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "You were talking to yourself.", "name": "ELIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "It's a bad habit.", "name": "LAVINIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "It's a nice one.", "name": "ELIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "She steps out from behind the lectern.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "Walks up the aisle between the seats, the laser dark in her hand, until she is two rows from him.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "The dome throws pale constellations over her cardigan.", "para": 12, "sent": 2, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "Do you know what I do, in the daytime?", "name": "LAVINIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "I'm guessing you look at things.", "name": "ELIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "I look at light that's already too late.", "name": "LAVINIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "That sounds lonely.", "name": "ELIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "It's the best part of the job.", "name": "LAVINIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "He smiles, a little crooked.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "She sits down in the row in front of his.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "Not beside.", "para": 13, "sent": 2, "present": [0, 1]}, {"u": 74, "kind": "action", "text": "Not far.", "para": 13, "sent": 3, "present": [0, 1]}, {"u": 75, "kind": "dialogue", "text": "Good evening, and welcome.", "name": "LAVINIA", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the dome"], "dual": false, "present": [0, 1]}, {"u": 76, "kind": "action", "text": "Elian reclines.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 77, "kind": "action", "text": "Folds his hands over his stomach.", "para": 14, "sent": 1, "present": [0, 1]}, {"u": 78, "kind": "action", "text": "Looks up at the stars, and she looks up with him, and the two of them watch the sky wheel in the dark without saying anything.", "para": 14, "sent": 2, "present": [0, 1]}, {"u": 79, "kind": "transition", "text": "FADE OUT.", "present": [0, 1]}]}