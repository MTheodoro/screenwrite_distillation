{"scene_id": "s01264", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01264.fountain", "heading": "INT. CLOCKMAKER'S SHOP - NIGHT", "cast": [{"id": 0, "name": "INSPECTOR BARNABAS HOLLOWAY", "names": ["INSPECTOR BARNABAS HOLLOWAY", "HOLLOWAY"], "gender": "?", "first": 5, "spoke": 10}, {"id": 1, "name": "CLOCKMAKER", "names": ["CLOCKMAKER"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "ROSALIND PEEL", "names": ["ROSALIND PEEL", "ROSALIND"], "gender": "f", "first": 6, "spoke": 4}, {"id": 3, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 8, "spoke": 4}, {"id": 4, "name": "WINIFRED", "names": ["WINIFRED"], "gender": "?", "first": 14, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. CLOCKMAKER'S SHOP - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Ticking, everywhere.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cuckoos, grandfathers, carriage clocks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A workbench lit by a green lamp.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The window shows an empty street slick with rain.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "INSPECTOR BARNABAS HOLLOWAY (50s, trench coat) stands over a body: the CLOCKMAKER (70s, apron, eyes open) lying beside the bench.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "A young constable, ROSALIND PEEL (20s, notebook), hovers near the door.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "A woman in a pearl-grey raincoat steps in, shaking her umbrella.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "A STRANGER (30s, calm eyes).", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Inspector.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Who let you in?", "name": "HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "The door was open.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "It wasn't, sir.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Name.", "name": "HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Winifred.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Winifred what?", "name": "HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Winifred Arkwright. His niece.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "He had no niece.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "He had me.", "name": "WINIFRED", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Holloway crouches by the body.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "The clocks tick on.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Rosalind scribbles.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Time of death?", "name": "HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Eleven-twelve, sir. The big clock stopped.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Stopped?", "name": "HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Someone stopped it.", "name": "WINIFRED", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "You'd know, would you?", "name": "HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "I would.", "name": "WINIFRED", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Holloway looks up.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "The woman is smiling faintly.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Rosalind frowns, then stares at the grandfather clock.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Its hands read eleven-twelve.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Its pendulum swings.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Sir. It's running.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Then it was reset.", "name": "HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "By me.", "name": "WINIFRED", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "A silence.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Rosalind's hand drifts to her whistle.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Holloway rises slowly.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Miss Arkwright.", "name": "HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Inspector.", "name": "WINIFRED", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "You wouldn't be telling me you did this.", "name": "HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "No. I'm telling you what he told me.", "name": "WINIFRED", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Who?", "name": "HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "The clocks.", "name": "WINIFRED", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Every clock in the room chimes at once.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Rosalind jumps.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Holloway doesn't.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "transition", "text": "FADE OUT.", "present": [0, 1, 2, 3, 4]}]}