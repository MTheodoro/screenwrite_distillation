{"scene_id": "s01265", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01265.fountain", "heading": "INT. PAWNSHOP - NIGHT", "cast": [{"id": 0, "name": "DETECTIVE MARLOWE-DIAZ", "names": ["DETECTIVE MARLOWE-DIAZ", "DET. MARLOWE-DIAZ", "MARLOWE-DIAZ"], "gender": "?", "first": 5, "spoke": 4}, {"id": 1, "name": "SOLOMON ABRAMS", "names": ["SOLOMON ABRAMS", "SOLOMON"], "gender": "?", "first": 6, "spoke": 2}, {"id": 2, "name": "TIPPER JOHNSON", "names": ["TIPPER JOHNSON", "TIPPER"], "gender": "?", "first": 7, "spoke": 2}, {"id": 3, "name": "CLEO", "names": ["CLEO"], "gender": "?", "first": 8, "spoke": 1}, {"id": 4, "name": "DUBOIS", "names": ["DUBOIS"], "gender": "?", "first": 8, "spoke": 0}, {"id": 5, "name": "VICTOR STANHOPE", "names": ["VICTOR STANHOPE", "VICTOR"], "gender": "?", "first": 14, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. PAWNSHOP - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cluttered shelves.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Guitars hang from the ceiling.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A glass counter.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A cage separates the till.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DETECTIVE MARLOWE-DIAZ (40s, rumpled raincoat) leans on the counter.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Behind it, the owner, SOLOMON ABRAMS (60s, green eyeshade), polishes a watch.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "By the guitars stands TIPPER JOHNSON (20s, nervous, hands in his pockets).", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "In the corner, a woman in a red scarf, CLEOPATRA \"CLEO\" DUBOIS (30s, calm), examines a ring.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Evening, Solomon.", "name": "DET. MARLOWE-DIAZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Detective.", "name": "SOLOMON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Heard you got a delivery.", "name": "DET. MARLOWE-DIAZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "I get many.", "name": "SOLOMON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "The door chimes.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "A tall man in a trench coat enters, dripping: VICTOR STANHOPE (50s, silver hair, soft hat).", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "He tips the hat to nobody.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Gentlemen. Lady.", "name": "VICTOR", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Mr. Stanhope. Out late.", "name": "MARLOWE-DIAZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Always.", "name": "VICTOR", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "That's him.", "name": "TIPPER", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Cleo sets down the ring.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Solomon sets down the watch.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Nobody moves.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Tipper. Who?", "name": "MARLOWE-DIAZ", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Nobody.", "name": "TIPPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "You're early.", "name": "CLEO", "speaker": 3, "ext": [], "paren": ["to Victor"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "So are you.", "name": "VICTOR", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Marlowe-Diaz looks from one to the other, then at the safe behind the counter.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "The lock gleams.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "transition", "text": "FADE OUT.", "present": [0, 1, 2, 3, 4, 5]}]}