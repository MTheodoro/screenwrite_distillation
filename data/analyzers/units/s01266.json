{"scene_id": "s01266", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01266.fountain", "heading": "INT. OBSERVATORY LIBRARY - NIGHT", "cast": [{"id": 0, "name": "PROFESSOR ALISTAIR GREYSON-MBEKI", "names": ["PROFESSOR ALISTAIR GREYSON-MBEKI"], "gender": "?", "first": 5, "spoke": 0}, {"id": 1, "name": "INSPECTOR LENORE QUIGLEY-ABARA", "names": ["INSPECTOR LENORE QUIGLEY-ABARA", "QUIGLEY-ABARA"], "gender": "m", "first": 8, "spoke": 18}, {"id": 2, "name": "PRUNELLA DOUGHTY", "names": ["PRUNELLA DOUGHTY", "PRUNELLA"], "gender": "f", "first": 9, "spoke": 17}], "units": [{"u": 0, "kind": "heading", "text": "INT. OBSERVATORY LIBRARY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A circular room beneath a copper dome, shelves climbing in tiers around a wrought-iron gallery.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A rolling ladder on a brass track.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A reading table, a green banker's lamp, a half-drunk glass of sherry.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A body-sized shape of dust where a rug has been recently pulled aside.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "PROFESSOR ALISTAIR GREYSON-MBEKI (60s, tweed jacket, bow tie) lies on the floor, face turned toward the dome.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "His eyes are open.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "A small wooden stool tilts nearby, one leg snapped.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "INSPECTOR LENORE QUIGLEY-ABARA (40s, black wool coat, notebook) crouches at his shoulder, gloved fingers hovering over his collar.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Behind her, in the doorway, stands the housekeeper MRS. PRUNELLA DOUGHTY (60s, apron, white curls, hands clasped tight), who is trying not to look.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "When did you find him?", "name": "QUIGLEY-ABARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Half past nine, Inspector. I came in to turn down the lamp.", "name": "PRUNELLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "And the door?", "name": "QUIGLEY-ABARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Open. Always open. He hates a closed door.", "name": "PRUNELLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Quigley-Abara stands.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Walks the circumference of the room slowly, trailing a hand along the shelves.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "At the ladder she stops, tests the brass track with a thumbnail, and lifts a smear of something pale.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Chalk.", "name": "QUIGLEY-ABARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "For the blackboard.", "name": "PRUNELLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "There's no blackboard in this room.", "name": "QUIGLEY-ABARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "No. I suppose there isn't.", "name": "PRUNELLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "The Inspector turns.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Prunella has moved a little way into the room, and now stands with one hand on the reading table, steadying herself.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "The other hand has found the sherry glass and turned it a quarter turn to hide a lipstick mark on its rim.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Mrs. Doughty.", "name": "QUIGLEY-ABARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Yes, Inspector?", "name": "PRUNELLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Do you take sherry?", "name": "QUIGLEY-ABARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Never.", "name": "PRUNELLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "That's your shade of pink, though.", "name": "QUIGLEY-ABARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Prunella's mouth works.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Slowly she lifts her chin, as if resolving to be brave about something she hasn't yet been accused of.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "He asked me to sit with him.", "name": "PRUNELLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Did he?", "name": "QUIGLEY-ABARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Last night. It was his birthday. He had no one.", "name": "PRUNELLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "And you drank sherry together.", "name": "QUIGLEY-ABARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "One glass.", "name": "PRUNELLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "And then?", "name": "QUIGLEY-ABARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "And then I went to bed.", "name": "PRUNELLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "And he climbed the ladder, in the dark, at seventy-one, to reach the Almagest.", "name": "QUIGLEY-ABARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "He always did that.", "name": "PRUNELLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Not with a stool.", "name": "QUIGLEY-ABARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "She crosses to the broken stool and rights it.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Looks at the snapped leg: the wood is white and fresh, with a clean diagonal where a saw has been.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "That's not a fall.", "name": "QUIGLEY-ABARA", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "No.", "name": "PRUNELLA", "speaker": 2, "ext": [], "paren": ["very quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Who sawed it?", "name": "QUIGLEY-ABARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "I did.", "name": "PRUNELLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "The Inspector does not move.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "The lamp hums.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "In the high copper dome, the wind lifts a flap of loose metal and lets it fall with a soft clang.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "He was going to sell the telescope.", "name": "PRUNELLA", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "To whom?", "name": "QUIGLEY-ABARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "To a man who'd put it in a hotel lobby.", "name": "PRUNELLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "And that was cause enough.", "name": "QUIGLEY-ABARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "Forty years I've polished that brass.", "name": "PRUNELLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "She sits down on the reading chair.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Smooths her apron.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Folds her hands.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Quigley-Abara closes the notebook, comes round the table, and takes the sherry glass by its stem.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "She sets it in an evidence bag.", "para": 8, "sent": 4, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "The sound of the bag zip is very loud.", "para": 8, "sent": 5, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Thank you, Mrs. Doughty.", "name": "QUIGLEY-ABARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "Will there be tea?", "name": "PRUNELLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "There will be tea.", "name": "QUIGLEY-ABARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "transition", "text": "FADE OUT.", "present": [0, 1, 2]}]}