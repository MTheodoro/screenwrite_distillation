{"scene_id": "s01270", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01270.fountain", "heading": "INT. DRAINED PUBLIC SWIMMING POOL - NIGHT", "cast": [{"id": 0, "name": "DEZ OKAFOR", "names": ["DEZ OKAFOR", "DEZ"], "gender": "?", "first": 4, "spoke": 10}, {"id": 1, "name": "ROZ VANCE", "names": ["ROZ VANCE", "ROZ"], "gender": "?", "first": 6, "spoke": 12}, {"id": 2, "name": "TOBIAS KRELL", "names": ["TOBIAS KRELL", "TOBIAS"], "gender": "?", "first": 24, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRAINED PUBLIC SWIMMING POOL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Deep end.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cracked blue tile.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Moonlight leaks through a broken skylight.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DEZ OKAFOR, 40s, shaved head, sits on an upturned lifeguard chair.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Duffel bag between his boots.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "ROZ VANCE, 30s, leather jacket, thumb on a revolver hammer.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "She stands over the drain.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You're late.", "name": "ROZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Traffic.", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "At two in the morning.", "name": "ROZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "There was a parade.", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "For who?", "name": "ROZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Me. Confetti and everything. Count it.", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "You count it. I want to see your hands doing the counting.", "name": "ROZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "My hands are fine. My hands have never been the problem.", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Your mouth is the problem.", "name": "ROZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "My mouth got us this pool. Free rent, no neighbours, a diving board for a lookout.", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "It smells like a wet dog died in a bleach factory.", "name": "ROZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "That's the ambience. You pay extra for that.", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "I'm not paying extra for anything. I'm paying what we agreed.", "name": "ROZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Then count.", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Steel door CLANGS above.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Boots on the ladder.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "TOBIAS KRELL, 50s, soaked raincoat, grey stubble, drops to the tile.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Revolver out.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Shaking.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Nobody move.", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Tobias, put that down.", "name": "ROZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Who's Tobias?", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "My brother-in-law.", "name": "ROZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Ex.", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Ex-brother-in-law. He drove.", "name": "ROZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "You brought a driver to a deal?", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "I brought a gun to a deal!", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "You brought a gun that doesn't have bullets, Tobias.", "name": "ROZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "...How did you know that?", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "I took them out. Last Tuesday.", "name": "ROZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Tobias lowers the gun.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Laughs, thin and relieved.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Sits on the tile.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Thank God. I thought I'd have to use it.", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Count the money, Roz.", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}