{"scene_id": "s01271", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01271.fountain", "heading": "INT. BOMBED CATHEDRAL BELL TOWER - DAWN", "cast": [{"id": 0, "name": "IMRE HALASZ", "names": ["IMRE HALASZ", "HALASZ"], "gender": "m", "first": 5, "spoke": 16}, {"id": 1, "name": "TEODORO BASCO", "names": ["TEODORO BASCO", "BASCO"], "gender": "m", "first": 8, "spoke": 11}, {"id": 2, "name": "LI WEI", "names": ["LI WEI", "LI"], "gender": "m", "first": 11, "spoke": 11}, {"id": 3, "name": "AGNES FARQUHAR", "names": ["AGNES FARQUHAR", "FARQUHAR"], "gender": "?", "first": 14, "spoke": 14}, {"id": 4, "name": "RINGS", "names": ["RINGS"], "gender": "?", "first": 68, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. BOMBED CATHEDRAL BELL TOWER - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Stone stairs spiral up into smoke.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A great bronze bell hangs cracked.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Slit windows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Dust falls like snow.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SGT. IMRE HALASZ, 40s, grey in his beard, crouches at a slit window.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Rifle braced.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "CPL.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "TEODORO BASCO, 20s, wiry, kneels beside a field radio.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Headset crooked.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "PVT.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "LI WEI, 19, round glasses taped at the hinge, sits against the wall.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Hugging his helmet.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "He stares at nothing.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "LT. AGNES FARQUHAR, 30s, mud to the knees, climbs into the room.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Pistol out.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Breathing hard.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "She drops beside the sergeant.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Report.", "name": "FARQUHAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Two tanks at the bridge. Infantry behind them.", "name": "HALASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Command says hold.", "name": "BASCO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Hold what?", "name": "FARQUHAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "The tower, ma'am.", "name": "BASCO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "We're in the tower.", "name": "FARQUHAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "That's what I told them.", "name": "BASCO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "They've seen us. Light on the bell.", "name": "HALASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "He points.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "A glint on the bronze.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Cover it.", "name": "FARQUHAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "With what?", "name": "LI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Your jacket.", "name": "FARQUHAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "He doesn't move.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Li.", "name": "HALASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Yes, Sergeant.", "name": "LI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Jacket.", "name": "HALASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "He peels it off.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Climbs the bell frame.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Drapes it over the metal.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Hands shaking.", "para": 9, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "A distant WHUMP.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Incoming!", "name": "BASCO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "All four drop.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "The wall SHUDDERS.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Plaster rains.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Where?", "name": "FARQUHAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Short. Nave.", "name": "HALASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Sergeant, they're ranging us.", "name": "BASCO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "They're ranging us. They're ranging us.", "name": "LI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Private!", "name": "FARQUHAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "I'm fine.", "name": "LI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "He's not fine.", "name": "HALASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Nobody's fine. Basco, get me the battery.", "name": "FARQUHAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Radio's dead on the artillery net.", "name": "BASCO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Then use the infantry net.", "name": "FARQUHAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "They don't answer.", "name": "BASCO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Because they're running.", "name": "HALASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "He turns back to the slit.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "Infantry's on the bridge. Fifty metres.", "name": "HALASZ", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "Count?", "name": "FARQUHAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "Thirty. Forty.", "name": "HALASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "We have nine magazines.", "name": "LI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "Eight. I gave one to the medic.", "name": "BASCO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "The medic's dead.", "name": "LI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "Silence.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "Basco looks at him.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "Then away.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "Another WHUMP.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "Closer.", "para": 15, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "The bell RINGS, one flat note.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "Dust pours from the vault.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "dialogue", "text": "Down. Everyone down!", "name": "FARQUHAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "action", "text": "She grabs Li by the collar.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "action", "text": "Hauls him flat.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "action", "text": "He grips her sleeve.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "dialogue", "text": "Lieutenant, I can't.", "name": "LI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "dialogue", "text": "You can.", "name": "FARQUHAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 76, "kind": "dialogue", "text": "I can't.", "name": "LI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 77, "kind": "dialogue", "text": "Li. Look at me.", "name": "HALASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 78, "kind": "action", "text": "He does.", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 79, "kind": "dialogue", "text": "Forty men on that bridge. Four of us up here. You know what that makes us?", "name": "HALASZ", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 80, "kind": "dialogue", "text": "Dead.", "name": "LI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 81, "kind": "dialogue", "text": "Inconvenient.", "name": "HALASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 82, "kind": "action", "text": "A breath.", "para": 20, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 83, "kind": "action", "text": "Something almost like a laugh.", "para": 20, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 84, "kind": "action", "text": "Basco slams the radio.", "para": 21, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 85, "kind": "dialogue", "text": "Got them! Got somebody!", "name": "BASCO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 86, "kind": "dialogue", "text": "Who?", "name": "FARQUHAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 87, "kind": "dialogue", "text": "Don't know. Sounds like cavalry.", "name": "BASCO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 88, "kind": "dialogue", "text": "We don't have cavalry.", "name": "HALASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 89, "kind": "dialogue", "text": "Then it's somebody's cousin.", "name": "BASCO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 90, "kind": "action", "text": "The third shell lands.", "para": 22, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 91, "kind": "action", "text": "Direct hit on the stair below.", "para": 22, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 92, "kind": "action", "text": "The floor LURCHES.", "para": 22, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 93, "kind": "action", "text": "They scramble.", "para": 23, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 94, "kind": "action", "text": "Rifles up.", "para": 23, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 95, "kind": "action", "text": "Faces white with plaster.", "para": 23, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 96, "kind": "dialogue", "text": "Positions.", "name": "FARQUHAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 97, "kind": "action", "text": "He crawls to the slit.", "para": 24, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 98, "kind": "action", "text": "She takes the east window.", "para": 24, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 99, "kind": "action", "text": "Basco kneels, radio in one fist, rifle in the other.", "para": 24, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 100, "kind": "action", "text": "Li lifts his rifle.", "para": 25, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 101, "kind": "action", "text": "Steadies it on the sill.", "para": 25, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 102, "kind": "dialogue", "text": "Sergeant?", "name": "LI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 103, "kind": "dialogue", "text": "Yes?", "name": "HALASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 104, "kind": "dialogue", "text": "When it starts, don't let me stop.", "name": "LI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 105, "kind": "dialogue", "text": "I won't.", "name": "HALASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 106, "kind": "action", "text": "The bell hums.", "para": 26, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 107, "kind": "action", "text": "Beyond it, boots on the bridge.", "para": 26, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 108, "kind": "dialogue", "text": "Wait for it.", "name": "HALASZ", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}