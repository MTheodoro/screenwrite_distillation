{"scene_id": "s01272", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01272.fountain", "heading": "EXT. SCHOOL BUS GRAVEYARD - DUSK", "cast": [{"id": 0, "name": "PAKS", "names": ["PAKS"], "gender": "?", "first": 4, "spoke": 1}, {"id": 1, "name": "NAIR", "names": ["NAIR"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "WYATT BOONE", "names": ["WYATT BOONE", "WYATT"], "gender": "m", "first": 5, "spoke": 1}, {"id": 3, "name": "LUCIA ORTEGA", "names": ["LUCIA ORTEGA", "LUCIA"], "gender": "f", "first": 7, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SCHOOL BUS GRAVEYARD - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "Forty yellow buses rust nose to tail in a field of dead sunflowers.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Windows gone.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Seats full of weeds.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "PRAKASH \"PAKS\" NAIR, 16, lanky, glasses, stands on a bus roof with a stolen six-pack.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "WYATT BOONE, 17, buzzcut, football jacket, climbs up after him.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "He grins too hard.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Below, LUCIA ORTEGA, 16, braids, sketchbook under her arm, watches them both.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Thought you'd chicken out.", "name": "WYATT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "So did I.", "name": "PAKS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Wyatt snatches a can.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Paks grabs it back.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "They shove.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "The roof BOOMS under their boots.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Both freeze.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "A siren, far off.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Coming closer.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Cops!", "name": "LUCIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Wyatt and Paks scramble, tumble down the rear emergency door.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Lucia is already running.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Cans spill in the dust.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "They hit the sunflowers, all three, laughing like idiots.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}]}