{"scene_id": "s01273", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01273.fountain", "heading": "INT. FUNERAL HOME EMBALMING ROOM - NIGHT", "cast": [{"id": 0, "name": "HOLLIS PRUITT", "names": ["HOLLIS PRUITT", "HOLLIS"], "gender": "m", "first": 5, "spoke": 4}, {"id": 1, "name": "MARGUERITE DUBOIS", "names": ["MARGUERITE DUBOIS", "MARGUERITE"], "gender": "m", "first": 8, "spoke": 3}, {"id": 2, "name": "KENJI SAITO", "names": ["KENJI SAITO"], "gender": "?", "first": 10, "spoke": 0}, {"id": 3, "name": "ABIGAIL TRENT", "names": ["ABIGAIL TRENT", "ABIGAIL"], "gender": "?", "first": 12, "spoke": 4}, {"id": 4, "name": "SEUN", "names": ["SEUN"], "gender": "f", "first": 14, "spoke": 2}, {"id": 5, "name": "ADEBAYO", "names": ["ADEBAYO"], "gender": "?", "first": 14, "spoke": 0}, {"id": 6, "name": "REVEREND CALDER MOSS", "names": ["REVEREND CALDER MOSS"], "gender": "m", "first": 16, "spoke": 0}, {"id": 7, "name": "BODY", "names": ["BODY"], "gender": "?", "first": 54, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. FUNERAL HOME EMBALMING ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "White tile.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Steel table.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single fluorescent tube hums over a sheeted body.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The wall clock reads 3:12.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "HOLLIS PRUITT, 50s, the funeral director, stands at the table in a rubber apron.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "He is calm.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "He has done this thousands of times.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "MARGUERITE DUBOIS, 30s, his apprentice, holds a clipboard.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "She watches the sheet.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "KENJI SAITO, 40s, the night janitor, mops the corner.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He keeps his eyes on the floor.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "ABIGAIL TRENT, 60s, the widow, sits on a folding chair by the door.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "A black purse in her lap.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "OLUWASEUN \"SEUN\" ADEBAYO, 20s, her grandson, leans on the wall beside her.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Arms crossed.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "REVEREND CALDER MOSS, 70s, stands in the doorway, Bible pressed to his chest.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "Mrs. Trent, you really shouldn't be in here.", "name": "MARGUERITE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "I want to see him.", "name": "ABIGAIL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "He isn't ready, ma'am.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "I said I want to see him.", "name": "ABIGAIL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "action", "text": "Hollis glances at the Reverend.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "action", "text": "The Reverend nods.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "Hollis lifts the sheet to the chin.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "The face is grey.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "action", "text": "Peaceful.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "action", "text": "She leans in and touches his cheek.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "The finger comes away wet.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "He's warm.", "name": "ABIGAIL", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "That's the lights, Mrs. Trent.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "Grandma, come on.", "name": "SEUN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "She doesn't move.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "action", "text": "Kenji's mop stops.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "The body's chest rises.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "Marguerite drops the clipboard.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "It CLATTERS across the tile.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "Did you see that?", "name": "MARGUERITE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "Nobody breathe.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "They don't.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "The fluorescent tube FLICKERS.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "The chest rises again.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "Slowly.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "The sheet slides off the shoulder.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "The Reverend begins to pray, fast, under his breath.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "Seun backs into the wall.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "action", "text": "Kenji drops the mop and edges toward the door.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "action", "text": "Hollis presses two fingers to the neck.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "His face goes blank.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "He pulls back.", "para": 16, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "dialogue", "text": "No pulse.", "name": "HOLLIS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "dialogue", "text": "Then what's moving?", "name": "MARGUERITE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "action", "text": "The mouth opens.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "action", "text": "A long, wet exhale.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "action", "text": "Then a whisper, dry as paper.", "para": 17, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "dialogue", "text": "Abigail.", "name": "BODY", "speaker": 7, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 55, "kind": "action", "text": "She stands.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 56, "kind": "action", "text": "The purse falls.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 57, "kind": "action", "text": "She is smiling.", "para": 18, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 58, "kind": "dialogue", "text": "Walter.", "name": "ABIGAIL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 59, "kind": "dialogue", "text": "Grandma, don't.", "name": "SEUN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 60, "kind": "action", "text": "The lights die.", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 61, "kind": "action", "text": "Total dark.", "para": 19, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 62, "kind": "action", "text": "Footsteps.", "para": 19, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 63, "kind": "action", "text": "A scrape of metal.", "para": 19, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 64, "kind": "action", "text": "Light snaps back.", "para": 20, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 65, "kind": "action", "text": "The table is empty.", "para": 20, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 66, "kind": "action", "text": "The sheet lies folded at the foot.", "para": 20, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 67, "kind": "action", "text": "Kenji laughs, high and cracked.", "para": 21, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 68, "kind": "action", "text": "Hollis grabs him by the shoulder.", "para": 21, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 69, "kind": "action", "text": "He stops.", "para": 21, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 70, "kind": "action", "text": "The Reverend lowers his Bible.", "para": 22, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 71, "kind": "action", "text": "Marguerite is staring at the wet footprints that lead across the tile to the open back door.", "para": 22, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 72, "kind": "action", "text": "Abigail is gone.", "para": 23, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 73, "kind": "action", "text": "Seun runs after her into the night.", "para": 23, "sent": 1, "present": [0, 1, 2, 4, 5, 6, 7]}]}