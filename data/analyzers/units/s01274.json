{"scene_id": "s01274", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01274.fountain", "heading": "INT. ICE CAVE - DAY", "cast": [{"id": 0, "name": "HANNELORE KAST", "names": ["HANNELORE KAST", "HANNELORE"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "BJORN STAAL", "names": ["BJORN STAAL", "BJORN"], "gender": "f", "first": 6, "spoke": 4}, {"id": 2, "name": "OTIENO MWANGI", "names": ["OTIENO MWANGI"], "gender": "m", "first": 7, "spoke": 0}, {"id": 3, "name": "PRIYA RAMAKRISHNAN", "names": ["PRIYA RAMAKRISHNAN", "PRIYA"], "gender": "?", "first": 8, "spoke": 4}, {"id": 4, "name": "TOMASZ WIERZBA", "names": ["TOMASZ WIERZBA", "TOMASZ"], "gender": "?", "first": 10, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. ICE CAVE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Blue walls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A low ceiling of glacier.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Meltwater drips into a black pool.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "HANNELORE KAST, 50s, expedition leader, frostbitten nose, sits by a dying camp stove.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She wears three jackets.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "BJORN STAAL, 30s, burly, one arm in a makeshift sling, leans on the wall beside her.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "OTIENO MWANGI, 20s, climber, sleeps with his head on his pack.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "PRIYA RAMAKRISHNAN, 40s, doctor, kneels over a med kit.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "She counts bandages.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "TOMASZ WIERZBA, 60s, the oldest of them, grey beard crusted with ice, stares at the cave mouth.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Weather window?", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Closing. The wind has turned.", "name": "TOMASZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "How long?", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Two hours. Maybe three.", "name": "TOMASZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Enough to walk out?", "name": "BJORN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Enough to walk out if you are young and have two arms.", "name": "TOMASZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "I have one and a half.", "name": "BJORN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "You have one and a fracture. Stay put.", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "We stay together. We always said that.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "We said many things in the base camp.", "name": "TOMASZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Tomasz.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "I am old, Hanne. I have seen this mountain take better people than us. But it does not like to be stared at. If we leave now, it lets us go.", "name": "TOMASZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "And Otieno?", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "He can walk. Wake him gently.", "name": "TOMASZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "What about the sled?", "name": "BJORN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "I will pull the sled.", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "You're half my size.", "name": "BJORN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "I am twice your sense.", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Enough. Pack. Everything useful, nothing sentimental.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "A distant THRUM.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Rotors.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "They all look up.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}]}