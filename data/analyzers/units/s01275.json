{"scene_id": "s01275", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01275.fountain", "heading": "INT. BOWLING ALLEY - NIGHT", "cast": [{"id": 0, "name": "LEAGUE FINALS", "names": ["LEAGUE FINALS"], "gender": "?", "first": 2, "spoke": 0}, {"id": 1, "name": "COACH DELPHINE MARCHAND", "names": ["COACH DELPHINE MARCHAND", "DELPHINE"], "gender": "f", "first": 5, "spoke": 20}, {"id": 2, "name": "GRETA LINDQVIST", "names": ["GRETA LINDQVIST", "GRETA"], "gender": "f", "first": 6, "spoke": 19}, {"id": 3, "name": "RUBEN ACOSTA", "names": ["RUBEN ACOSTA", "RUBEN"], "gender": "m", "first": 8, "spoke": 14}], "units": [{"u": 0, "kind": "heading", "text": "INT. BOWLING ALLEY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Neon pins.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A banner: LEAGUE FINALS - SPARE ME LANES.", "para": 0, "sent": 1, "present": [0]}, {"u": 3, "kind": "action", "text": "Most of the crowd has gone home.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "Lane 12 is lit.", "para": 0, "sent": 3, "present": [0]}, {"u": 5, "kind": "action", "text": "COACH DELPHINE MARCHAND, 50s, silver bob, orange cardigan, sits with a clipboard on her knee.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "GRETA LINDQVIST, 30s, anchor bowler, towels her hands.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Her shoulders are rounded in defeat.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "RUBEN ACOSTA, 20s, rookie, sits on the ball return with his shoes untied.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Tenth frame. You left the seven-ten.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "I know what I left.", "name": "GRETA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "It was a hard split.", "name": "RUBEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "It was the hardest split.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "I shouldn't have gone for it.", "name": "GRETA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "You went for it because it was there.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "She was winning on pins, Coach.", "name": "RUBEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Don't defend me.", "name": "GRETA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Ruben, let her talk.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "I'm just saying.", "name": "RUBEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Eleven years I've been bowling with this team. Eleven.", "name": "GRETA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Twelve.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Twelve. And in twelve years we've never won the final. Not once. And I stood up there tonight and I thought, this is it, this is the one.", "name": "GRETA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "You were incredible in the eighth.", "name": "RUBEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "I was incredible in the eighth. I was terrible in the tenth. That's the whole story.", "name": "GRETA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "It isn't the whole story.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "It's the only part they'll remember.", "name": "GRETA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Greta.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Delphine, please. I need to say this without you being kind to me.", "name": "GRETA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "All right.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "I'm thirty-four. My wrist hurts when it rains. My daughter wants me to quit and take her to the lake.", "name": "GRETA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Don't quit.", "name": "RUBEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Ruben, you've been here six months.", "name": "GRETA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Don't quit.", "name": "RUBEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "He's right. Stay.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "You want me to stay because you have no one else.", "name": "GRETA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "I want you to stay because you are the best bowler I've ever coached, and I've coached some very good ones.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "She really is.", "name": "RUBEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Neither of you is helping.", "name": "GRETA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "We aren't trying to help. We're trying to tell you the truth.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "What's the truth?", "name": "RUBEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "The truth is that nobody wins the seven-ten.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Somebody has to.", "name": "GRETA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Somebody has, twice, in the history of the sport. And both of them cried afterward.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Why?", "name": "RUBEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Because it doesn't feel like winning. It feels like surviving.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Is that what this is? Surviving?", "name": "GRETA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Twelve years, Greta. You're still standing.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "I'll buy the nachos.", "name": "RUBEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "You don't have to buy the nachos.", "name": "GRETA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "I'm buying the nachos.", "name": "RUBEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Get extra cheese.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "And jalapenos.", "name": "GRETA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "That I can do.", "name": "RUBEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "And next season?", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Next season we try again.", "name": "GRETA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "That's all I wanted to hear.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Don't gloat.", "name": "GRETA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "I'm not gloating. I'm planning.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "Planning what?", "name": "RUBEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "Everything. Starting with how to teach a rookie to tie his shoes.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "I know how to tie my shoes!", "name": "RUBEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "Then do it.", "name": "GRETA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "He looks down.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "The laces are knotted together.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "He groans.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "They laugh.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "First time all night.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}]}