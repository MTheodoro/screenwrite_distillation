{"scene_id": "s01277", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01277.fountain", "heading": "INT. 24-HOUR LAUNDROMAT - NIGHT", "cast": [{"id": 0, "name": "ODALYS MENDEZ", "names": ["ODALYS MENDEZ", "ODALYS"], "gender": "?", "first": 4, "spoke": 39}, {"id": 1, "name": "KAI MENDEZ-HART", "names": ["KAI MENDEZ-HART", "KAI"], "gender": "m", "first": 6, "spoke": 39}], "units": [{"u": 0, "kind": "heading", "text": "INT. 24-HOUR LAUNDROMAT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "3 A.M. Fluorescent hum.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of dryers tumble sneakers and sheets.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A TV bolted to the wall plays a silent infomercial.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ODALYS MENDEZ, 60s, small, upright, folds towels with ruthless precision.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her cardigan is buttoned wrong.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "KAI MENDEZ-HART, 19, her grandson, slumps on a plastic chair, duffel bag at his feet.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Hood up.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You could help.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I'm tired, Abuela.", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "You are nineteen. Tired is for people with mortgages.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I drove six hours.", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I did not ask you to drive six hours.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "You called me.", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "I called you at noon. To say hello.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "You called at midnight. You said the dryer was making a noise.", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "It was making a noise.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Abuela, you don't have a dryer. You live in a retirement home.", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "The retirement home has a dryer. It makes a noise.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Then call maintenance.", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Maintenance does not come at midnight.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Neither do I.", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "And yet.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Kai pulls his hood back.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Rubs his face.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Okay. Okay. What's going on?", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Nothing is going on.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "You're folding other people's towels.", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Someone left them. It is a waste.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Abuela.", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "I could not sleep.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Why couldn't you sleep?", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Why do young people ask why? I could not sleep. That is a complete sentence.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Is it Mom?", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Odalys folds a towel.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Then another.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "She doesn't answer.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Did she call?", "name": "KAI", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "She called.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "And?", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "She says she is moving to Portland.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "She's been saying that for four years.", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "This time she has a lease.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Oh.", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Yes. Oh.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Did she say anything about me?", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "She said you are welcome.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "Welcome to what?", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "To come. To Portland. To live there. She says there is a room.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "There's always a room, Abuela. Then there isn't.", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "That is your mother.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "That is my mother.", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "A dryer BUZZES.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "Neither moves.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "Do you want to go?", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "To Portland?", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "To Portland.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "I don't know. I have school. I have a job.", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "You have a job at a pizza place.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "It's a good pizza place.", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "It is a very good pizza place. I have eaten the pizza.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "Then you know.", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "I know that you are afraid.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "I'm not afraid.", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "You are nineteen and your mother is leaving again. Of course you are afraid.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "You're not.", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "I am eighty years old. I have no time left to be afraid. It is a luxury.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "You're sixty-eight.", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "Eighty in my heart.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "That's not how that works.", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "In my house it is exactly how it works.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "dialogue", "text": "Your house is a retirement home.", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 72, "kind": "dialogue", "text": "In my heart it is a house.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "He laughs.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 74, "kind": "action", "text": "Wet, surprised.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 75, "kind": "action", "text": "She smiles, small, and doesn't look at him.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 76, "kind": "dialogue", "text": "Why are we here, Abuela?", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 77, "kind": "dialogue", "text": "Because the machines are warm.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 78, "kind": "dialogue", "text": "That's it?", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 79, "kind": "dialogue", "text": "That is it. It is three in the morning. Everywhere else is cold.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 80, "kind": "dialogue", "text": "Okay.", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 81, "kind": "dialogue", "text": "Okay.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 82, "kind": "dialogue", "text": "Can I help fold?", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 83, "kind": "dialogue", "text": "Finally.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 84, "kind": "dialogue", "text": "Show me.", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 85, "kind": "dialogue", "text": "Thirds. Then thirds again. You do not crush them. You are making a promise.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 86, "kind": "dialogue", "text": "A promise?", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 87, "kind": "dialogue", "text": "That someone will be warm tomorrow.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 88, "kind": "action", "text": "Kai picks up a towel.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 89, "kind": "action", "text": "She hands him another.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 90, "kind": "action", "text": "They fold in silence.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 91, "kind": "dialogue", "text": "Like this?", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 92, "kind": "dialogue", "text": "Closer.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 93, "kind": "dialogue", "text": "Like this?", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 94, "kind": "dialogue", "text": "Yes. Like that.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 95, "kind": "dialogue", "text": "You're gonna be okay, right?", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 96, "kind": "dialogue", "text": "Mijo. I have always been okay. It is the rest of you I worry about.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 97, "kind": "action", "text": "The dryer BUZZES again.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 98, "kind": "action", "text": "She nods at it.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 99, "kind": "dialogue", "text": "That one is done.", "name": "ODALYS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 100, "kind": "dialogue", "text": "I'll get it.", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 101, "kind": "action", "text": "He does.", "para": 9, "sent": 0, "present": [0, 1]}]}