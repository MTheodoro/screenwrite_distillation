{"scene_id": "s01278", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01278.fountain", "heading": "INT. FERRY TICKET BOOTH - NIGHT", "cast": [{"id": 0, "name": "ODETTE ARMSTRONG", "names": ["ODETTE ARMSTRONG", "ODETTE"], "gender": "?", "first": 5, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. FERRY TICKET BOOTH - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A glass box at the end of a pier.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single brass lamp.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain slides down the windows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Outside, the last ferry's lights shrink into fog.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ODETTE ARMSTRONG, 60s, uniform cap, spectacles on a chain, sits at a worn desk.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Before her: a cassette recorder, the kind with piano keys.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "A thermos.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "She presses PLAY.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "dialogue", "text": "Testing. Testing. This is Odette Armstrong, ticket agent, Pier Nine. If you're hearing this, I've either retired or I've lost my mind.", "name": "ODETTE", "speaker": 0, "ext": ["V.O."], "paren": ["recorded, younger, warm"], "dual": false, "present": [0]}, {"u": 10, "kind": "action", "text": "She smiles.", "para": 3, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "Stops the tape.", "para": 3, "sent": 1, "present": [0]}, {"u": 12, "kind": "action", "text": "Rewinds a little.", "para": 3, "sent": 2, "present": [0]}, {"u": 13, "kind": "action", "text": "Plays again.", "para": 3, "sent": 3, "present": [0]}, {"u": 14, "kind": "dialogue", "text": "Thirty years on this pier. I want to record what I remember. The first fare I ever sold was a dollar twenty.", "name": "ODETTE", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": ["recorded"], "dual": false, "present": [0]}, {"u": 15, "kind": "action", "text": "She pours tea.", "para": 4, "sent": 0, "present": [0]}, {"u": 16, "kind": "action", "text": "Her hand trembles slightly.", "para": 4, "sent": 1, "present": [0]}, {"u": 17, "kind": "dialogue", "text": "The worst winter was '88. The ice stopped everything. I slept in this booth for three nights. I was happier than I'd ever been.", "name": "ODETTE", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": ["recorded"], "dual": false, "present": [0]}, {"u": 18, "kind": "action", "text": "She stops the tape.", "para": 5, "sent": 0, "present": [0]}, {"u": 19, "kind": "dialogue", "text": "Happier.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0]}, {"u": 20, "kind": "action", "text": "She looks at the empty pier.", "para": 6, "sent": 0, "present": [0]}, {"u": 21, "kind": "action", "text": "At the dark water.", "para": 6, "sent": 1, "present": [0]}, {"u": 22, "kind": "action", "text": "She presses PLAY.", "para": 7, "sent": 0, "present": [0]}, {"u": 23, "kind": "dialogue", "text": "If I could tell the person listening one thing, it would be this. Don't wait for the boat. The boat always leaves.", "name": "ODETTE", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": ["recorded"], "dual": false, "present": [0]}, {"u": 24, "kind": "action", "text": "The thermos lid falls.", "para": 8, "sent": 0, "present": [0]}, {"u": 25, "kind": "action", "text": "Rolls across the floor.", "para": 8, "sent": 1, "present": [0]}, {"u": 26, "kind": "action", "text": "She doesn't pick it up.", "para": 8, "sent": 2, "present": [0]}, {"u": 27, "kind": "dialogue", "text": "Go to the pier before the boat. Go to the sea before the pier.", "name": "ODETTE", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": ["recorded"], "dual": false, "present": [0]}, {"u": 28, "kind": "action", "text": "Her jaw tightens.", "para": 9, "sent": 0, "present": [0]}, {"u": 29, "kind": "action", "text": "She stabs the STOP key.", "para": 9, "sent": 1, "present": [0]}, {"u": 30, "kind": "action", "text": "The click echoes.", "para": 9, "sent": 2, "present": [0]}, {"u": 31, "kind": "action", "text": "She stands.", "para": 10, "sent": 0, "present": [0]}, {"u": 32, "kind": "action", "text": "Pulls the uniform cap from her head.", "para": 10, "sent": 1, "present": [0]}, {"u": 33, "kind": "action", "text": "Looks at it.", "para": 10, "sent": 2, "present": [0]}, {"u": 34, "kind": "dialogue", "text": "Thirty years.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 35, "kind": "action", "text": "She hurls the cap against the glass.", "para": 11, "sent": 0, "present": [0]}, {"u": 36, "kind": "action", "text": "It bounces off.", "para": 11, "sent": 1, "present": [0]}, {"u": 37, "kind": "action", "text": "Falls.", "para": 11, "sent": 2, "present": [0]}, {"u": 38, "kind": "action", "text": "She tears the cassette from the machine, raises it to smash it, and stops.", "para": 12, "sent": 0, "present": [0]}, {"u": 39, "kind": "action", "text": "Her chest heaves.", "para": 12, "sent": 1, "present": [0]}, {"u": 40, "kind": "action", "text": "Slowly, she slides it into her breast pocket.", "para": 13, "sent": 0, "present": [0]}, {"u": 41, "kind": "action", "text": "Picks up the cap.", "para": 13, "sent": 1, "present": [0]}, {"u": 42, "kind": "action", "text": "Sets it on the desk.", "para": 13, "sent": 2, "present": [0]}, {"u": 43, "kind": "action", "text": "She switches off the lamp.", "para": 14, "sent": 0, "present": [0]}, {"u": 44, "kind": "action", "text": "Dark.", "para": 14, "sent": 1, "present": [0]}, {"u": 45, "kind": "action", "text": "Rain.", "para": 14, "sent": 2, "present": [0]}, {"u": 46, "kind": "dialogue", "text": "Go to the sea.", "name": "ODETTE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 47, "kind": "action", "text": "She pushes open the door.", "para": 15, "sent": 0, "present": [0]}, {"u": 48, "kind": "action", "text": "Fog pours in.", "para": 15, "sent": 1, "present": [0]}, {"u": 49, "kind": "action", "text": "She steps out onto the pier.", "para": 15, "sent": 2, "present": [0]}]}