{"scene_id": "s01279", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01279.fountain", "heading": "EXT. SALT FLAT - DAY", "cast": [{"id": 0, "name": "BEA", "names": ["BEA"], "gender": "?", "first": 3, "spoke": 7}, {"id": 1, "name": "LONGSTREET", "names": ["LONGSTREET"], "gender": "?", "first": 3, "spoke": 0}, {"id": 2, "name": "MANNY", "names": ["MANNY"], "gender": "m", "first": 4, "spoke": 6}, {"id": 3, "name": "CRUZ", "names": ["CRUZ"], "gender": "?", "first": 4, "spoke": 0}, {"id": 4, "name": "SIGRID OLSEN", "names": ["SIGRID OLSEN", "SIGRID"], "gender": "f", "first": 5, "spoke": 5}, {"id": 5, "name": "DARIUS KHAN", "names": ["DARIUS KHAN", "DARIUS"], "gender": "m", "first": 7, "spoke": 7}, {"id": 6, "name": "PERRY", "names": ["PERRY"], "gender": "?", "first": 8, "spoke": 8}, {"id": 7, "name": "NDLOVU", "names": ["NDLOVU"], "gender": "?", "first": 8, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SALT FLAT - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A white plain to the horizon, cracked in hexagons, shimmering with mirage.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "In the middle stands a dead jeep, hood up, its shadow a small black pool.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "BEATRIX \"BEA\" LONGSTREET, 40s, a geologist with a sunburnt nose and a scarf wound over her hair, stands on the jeep's bumper, scanning the horizon with binoculars.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "MANUEL \"MANNY\" CRUZ, 30s, the driver, sits in the shade of the open door, a dry canteen upturned in his hand.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 5, "kind": "action", "text": "SIGRID OLSEN, 20s, a graduate student, lies on the flat, hat over her face.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 6, "kind": "action", "text": "Her lips are cracked white.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "action", "text": "DARIUS KHAN, 50s, a photographer, trudges back from the dune with a camera bag over each shoulder, as though weight alone could anchor him.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "action", "text": "At the edge of the shade, PERPETUA \"PERRY\" NDLOVU, 70s, the guide, sits cross-legged on a folded blanket.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 9, "kind": "action", "text": "She hums.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 10, "kind": "dialogue", "text": "Nothing. Not a cloud, not a bird.", "name": "BEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 11, "kind": "dialogue", "text": "Told you, Bea. Radiator's cooked.", "name": "MANNY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 12, "kind": "dialogue", "text": "Manny, you said it was fine.", "name": "DARIUS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 13, "kind": "dialogue", "text": "I said it was probably fine.", "name": "MANNY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 14, "kind": "dialogue", "text": "Probably.", "name": "DARIUS", "speaker": 5, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 15, "kind": "action", "text": "Sigrid lifts the hat.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 16, "kind": "dialogue", "text": "How long since the last water?", "name": "SIGRID", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 17, "kind": "dialogue", "text": "Two hours.", "name": "BEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 18, "kind": "dialogue", "text": "How long can we last?", "name": "SIGRID", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 19, "kind": "dialogue", "text": "Three days, child. Maybe four if we stop quarrelling.", "name": "PERRY", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 20, "kind": "dialogue", "text": "Perry, with respect, we've been out here since dawn.", "name": "DARIUS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 21, "kind": "dialogue", "text": "And we shall be here until someone comes. Sit, Darius. You waste your sweat.", "name": "PERRY", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 22, "kind": "dialogue", "text": "He wastes my patience.", "name": "MANNY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 23, "kind": "dialogue", "text": "I waste nothing!", "name": "DARIUS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 24, "kind": "dialogue", "text": "Stop. Both of you.", "name": "BEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 25, "kind": "dialogue", "text": "I think I saw something.", "name": "SIGRID", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 26, "kind": "action", "text": "Everyone turns.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 27, "kind": "action", "text": "She points.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 28, "kind": "action", "text": "A glint, east, wavering.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 29, "kind": "dialogue", "text": "Where?", "name": "BEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "dialogue", "text": "There, Bea! Past the dunes!", "name": "SIGRID", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "dialogue", "text": "Mirage, Sigrid.", "name": "DARIUS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "dialogue", "text": "Mirage, child.", "name": "PERRY", "speaker": 6, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "dialogue", "text": "It moves.", "name": "MANNY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "dialogue", "text": "It's moving toward us.", "name": "BEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "action", "text": "Beat.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "action", "text": "A faint DRONE.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "action", "text": "Not an engine.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "action", "text": "Wind in the flats.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "dialogue", "text": "It's a truck. It has to be a truck.", "name": "SIGRID", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "dialogue", "text": "It's a mirage, Sigrid. It's heat on salt.", "name": "DARIUS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 41, "kind": "dialogue", "text": "Sigrid. Hand me the binoculars.", "name": "PERRY", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 42, "kind": "action", "text": "She does.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 43, "kind": "action", "text": "Perry lifts them, calm.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 44, "kind": "action", "text": "Everyone watches her face.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 45, "kind": "dialogue", "text": "It is a man on a camel.", "name": "PERRY", "speaker": 6, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 46, "kind": "dialogue", "text": "A camel?", "name": "MANNY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 47, "kind": "dialogue", "text": "He is very slow.", "name": "PERRY", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 48, "kind": "dialogue", "text": "Perry, how long?", "name": "BEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 49, "kind": "dialogue", "text": "Until he is here? Perhaps one hour. Perhaps never. The camel is thinking.", "name": "PERRY", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 50, "kind": "action", "text": "Laughter, cracked.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 51, "kind": "action", "text": "Darius sits.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 52, "kind": "action", "text": "Sigrid wipes her eyes.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 53, "kind": "action", "text": "Manny drops the canteen and covers his face.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 54, "kind": "dialogue", "text": "Okay. Okay. We wait.", "name": "BEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 55, "kind": "dialogue", "text": "We wait.", "name": "MANNY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 56, "kind": "dialogue", "text": "We wait.", "name": "DARIUS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 57, "kind": "dialogue", "text": "We wait.", "name": "PERRY", "speaker": 6, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 58, "kind": "action", "text": "The shape on the horizon grows.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 59, "kind": "action", "text": "Slowly.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 60, "kind": "action", "text": "A man.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 61, "kind": "action", "text": "An animal.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 62, "kind": "action", "text": "A long shadow across the white.", "para": 11, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}