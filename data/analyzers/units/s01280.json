{"scene_id": "s01280", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01280.fountain", "heading": "INT. SPIRAL STAIRWELL INSIDE A GIANT TORTOISE SHELL - NIGHT", "cast": [{"id": 0, "name": "ISOLDE VARN", "names": ["ISOLDE VARN", "ISOLDE"], "gender": "f", "first": 5, "spoke": 6}, {"id": 1, "name": "BRANWEN TOLL", "names": ["BRANWEN TOLL", "BRANWEN"], "gender": "f", "first": 8, "spoke": 4}, {"id": 2, "name": "CADOC", "names": ["CADOC"], "gender": "m", "first": 10, "spoke": 6}, {"id": 3, "name": "PIP MARROW", "names": ["PIP MARROW", "PIP"], "gender": "m", "first": 12, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. SPIRAL STAIRWELL INSIDE A GIANT TORTOISE SHELL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "The stairs wind through bone the colour of old ivory.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Lanterns of green fire hang from hooks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Somewhere above, a vast slow heartbeat.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Every third beat, the walls tremble.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ISOLDE VARN, 30s, in a ranger's grey cloak, climbs with one hand on the rail.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A silver knife at her belt.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She does not look back.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "BRANWEN TOLL, 60s, the lamp-keeper, follows, sleeves smelling of smoke.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "She carries the only key.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "CADOC, 20s, a boy with ink on his fingers and a satchel too big for him, stops to touch the wall.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "The bone warms under his palm.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "PIP MARROW, 40s, a tinker with a hundred small bells sewn into his coat, brings up the rear.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Each step jingles.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "He keeps trying to quiet them.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Pip. The bells.", "name": "BRANWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "I'm stuffing them, Mother Toll.", "name": "PIP", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Stuff them harder.", "name": "BRANWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "The heartbeat THUDS.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Dust sifts from the ceiling.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Everyone stops.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Isolde's hand drifts to her knife.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Isolde, it knows we're here.", "name": "CADOC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "It always knew.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "She climbs.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "After a moment the others follow.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "You said it was asleep.", "name": "CADOC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "I said it was old.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "She does not meet his eyes.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "She taps the rail twice, a habit, a prayer.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Steady, old girl. Steady.", "name": "BRANWEN", "speaker": 1, "ext": [], "paren": ["to the stair, under her breath"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Who's she talking to?", "name": "PIP", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "The shell.", "name": "CADOC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Does it answer?", "name": "PIP", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Sometimes.", "name": "CADOC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "They reach a landing.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "A door of black wood, banded in iron.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Isolde pauses.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "She holds out a hand without looking.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Branwen puts the key in it.", "para": 8, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "The key does not turn.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Cadoc.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Yes?", "name": "CADOC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Your hands.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "He steps up.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Presses his inky palm against the lock.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "The iron sighs.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Bolts slide.", "para": 10, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Everyone, stay behind the line.", "name": "BRANWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Pip shuffles back.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "A single bell chimes, high and clear.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "The heartbeat stops.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Nobody breathes.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "A long moment.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "The lanterns gutter.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Then, from beyond the door, a sound like a very large animal clearing its throat.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Gentle.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Almost polite.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "We've come to ask a favour.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": ["to the door"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "The door swings open on warm dark.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "The scent of rain and old coins pours out.", "para": 15, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "Isolde lowers her knife.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "Branwen lets out a breath she has held for forty years.", "para": 16, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "Isolde?", "name": "CADOC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "Go on.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "He goes first.", "para": 17, "sent": 0, "present": [0, 1, 2, 3]}]}