{"scene_id": "s01282", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01282.fountain", "heading": "INT. ORBITAL GREENHOUSE - ARTIFICIAL DAY", "cast": [{"id": 0, "name": "ANJALI VERMA", "names": ["ANJALI VERMA", "ANJALI"], "gender": "?", "first": 5, "spoke": 7}, {"id": 1, "name": "KOFI BAAH", "names": ["KOFI BAAH", "KOFI"], "gender": "?", "first": 7, "spoke": 3}, {"id": 2, "name": "LENKA HORVAT", "names": ["LENKA HORVAT", "LENKA"], "gender": "?", "first": 9, "spoke": 4}, {"id": 3, "name": "SOLOMON ECK", "names": ["SOLOMON ECK", "SOLOMON"], "gender": "m", "first": 11, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. ORBITAL GREENHOUSE - ARTIFICIAL DAY", "present": []}, {"u": 1, "kind": "action", "text": "A long curved hall of racks and tubes.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Green leaves in violet grow-light.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Condensation beads on every pipe.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Earth hangs in the viewport, small and blue.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ANJALI VERMA, 50s, the commander, silver-haired, stands at the central console.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her coveralls are stained with soil.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "KOFI BAAH, 30s, botanist, kneels at a rack of wilted tomato vines.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He holds a leaf up to the light.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "LENKA HORVAT, 40s, engineer, hangs upside-down from a ceiling rail.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "A toolkit floats beside her.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "SOLOMON ECK, 60s, the crew's cook, sits alone in the corner with a mug of tea, watching them.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "The ventilation fans RATTLE and slow.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Then they stop.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Status.", "name": "ANJALI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Fans three through seven are dead.", "name": "LENKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "That's the whole east wing.", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Can you fix it?", "name": "ANJALI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Maybe. I need twenty minutes.", "name": "LENKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "We don't have twenty minutes.", "name": "SOLOMON", "speaker": 3, "ext": [], "paren": ["to no one"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Solomon?", "name": "ANJALI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Oxygen scrubbers. Ask me how I know.", "name": "SOLOMON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "She does not.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "She taps the console.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Red text flickers.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Everyone, listen. We're going to move the plants to the west wing. One rack at a time. Kofi, you're lead.", "name": "ANJALI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Understood.", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "He rises.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "He pulls a rack toward the hatch.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "It sticks.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "He braces his boot and heaves.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "It slides.", "para": 7, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Lenka drops from the rail, grabs the opposite side.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Together they push.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Solomon puts down his mug.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "He joins them without a word.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Anjali watches them move.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "She exhales.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Thank God for stubborn people.", "name": "ANJALI", "speaker": 0, "ext": ["CONT'D"], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "What was that?", "name": "LENKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Nothing.", "name": "ANJALI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "The fans cough back to life.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "A low whir.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Fresh air stirs the leaves.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Lenka?", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "I didn't touch anything.", "name": "LENKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Maybe it likes us.", "name": "SOLOMON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "It's a greenhouse, Solomon.", "name": "ANJALI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "So it's alive.", "name": "SOLOMON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "She smiles.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "She shakes her head.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "The viewport blue glows over all four.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}]}