{"scene_id": "s01284", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01284.fountain", "heading": "INT. NATURAL HISTORY MUSEUM - TAXIDERMY HALL - NIGHT", "cast": [{"id": 0, "name": "NIGHT GUARD", "names": ["GUARD", "NIGHT GUARD"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "WOMAN", "names": ["WOMAN"], "gender": "?", "first": 10, "spoke": 8}, {"id": 2, "name": "BARNABY", "names": ["BARNABY"], "gender": "m", "first": 35, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. NATURAL HISTORY MUSEUM - TAXIDERMY HALL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Glass cases.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A stuffed polar bear rears in the centre.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Glass eyes catch the exit-sign glow.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A NIGHT GUARD, 60s, soft belly, thermos in hand, shuffles down the aisle.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He pauses at the bear.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Pats its paw.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "dialogue", "text": "Evening, Boris.", "name": "NIGHT GUARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 8, "kind": "action", "text": "A creak behind him.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "He turns.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "A WOMAN in a grey coat stands between two cases.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Calm.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Hands in pockets.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Ma'am. We're closed.", "name": "NIGHT GUARD", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "I know.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Then how did you...", "name": "NIGHT GUARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "You let me in. At six. When I said I'd left my glasses.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He frowns.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Looks at the bear.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Looks back.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Right. Right, I remember. Thought you'd gone.", "name": "NIGHT GUARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "I thought you'd gone.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "She smiles.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Steps closer.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "He sips from the thermos.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "His shoulders loosen.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Well. Take your time. Find 'em?", "name": "NIGHT GUARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Not yet.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "She walks past him, trailing a hand along the glass.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Stops at the bear.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Reaches into its open jaw.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Withdraws a small silver key.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Hey. What's that?", "name": "NIGHT GUARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "The Woman turns.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Her smile is gone.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Barnaby. Sit down.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "He sits, heavily, on the bench.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "How do you know my name?", "name": "BARNABY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "You told me at six.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "I didn't.", "name": "BARNABY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "You wouldn't remember. It was in the tea.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Who are you?", "name": "BARNABY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Nell.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Barnaby's thermos slides from his hand.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Hits the floor.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Nell steps over it.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "The bear's eyes gleam.", "para": 9, "sent": 3, "present": [0, 1, 2]}]}