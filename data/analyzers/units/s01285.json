{"scene_id": "s01285", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01285.fountain", "heading": "INT. SELF-SERVE CAR WASH BAY - DAWN", "cast": [{"id": 0, "name": "IGNATIUS PELL", "names": ["IGNATIUS PELL", "PELL"], "gender": "m", "first": 4, "spoke": 15}, {"id": 1, "name": "LO", "names": ["LO"], "gender": "?", "first": 6, "spoke": 15}, {"id": 2, "name": "BANKS", "names": ["BANKS"], "gender": "?", "first": 6, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. SELF-SERVE CAR WASH BAY - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Concrete.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Pressure hoses coiled on hooks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Cold sun leaks through the open bay door and lights the soap suds on the floor.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DET. IGNATIUS PELL, 50s, heavy coat, mustard stain on his tie, leans against a wet wall.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "A cardboard coffee in each hand.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "LORETTA \"LO\" BANKS, 30s, nurse's scrubs under a puffy jacket, hair in a hasty bun, stands by the quarter-slot machine.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Her hands are shoved deep in her pockets.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Thanks for coming.", "name": "PELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "You said it was about my brother.", "name": "LO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "It is.", "name": "PELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He holds out a coffee.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "She doesn't take it.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "He's in Ohio.", "name": "LO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "He was.", "name": "PELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "What does that mean?", "name": "LO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Lo.", "name": "PELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Don't \"Lo\" me.", "name": "LO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Pell sets the coffee on the machine.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Opens his coat.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Pulls out a thin folder.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Found a car three days ago. Under a bridge by Dunmore.", "name": "PELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "So?", "name": "LO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Plates were Ohio. Registered to Darnell Banks.", "name": "PELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Water drips.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "He sold that car.", "name": "LO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Not according to the DMV.", "name": "PELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Then someone stole it.", "name": "LO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Someone did. The keys were in the ignition.", "name": "PELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "She walks to the wall.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Presses her forehead against the cold tile.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Was he in it?", "name": "LO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "No.", "name": "PELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Then what do you want from me?", "name": "LO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "His phone pinged a tower four blocks from your apartment. Tuesday night.", "name": "PELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "She turns, slowly.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Her face has changed.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Tuesday.", "name": "LO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Tuesday. Around eleven.", "name": "PELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "I was on shift.", "name": "LO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Until?", "name": "PELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Seven.", "name": "LO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Then who let him in?", "name": "PELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Nobody let him in.", "name": "LO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Lo.", "name": "PELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "She snatches the coffee.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Hurls it at the wall.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "It EXPLODES brown against the tile, hot, steaming.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "He's my brother! He's the only family I have, and you come at dawn with a folder and a face like a funeral!", "name": "LO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "I'm trying to find him.", "name": "PELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "You're trying to find me.", "name": "LO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "He doesn't deny it.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "He just stands there, coffee dripping down the wall behind her.", "para": 9, "sent": 1, "present": [0, 1, 2]}]}