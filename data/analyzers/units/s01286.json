{"scene_id": "s01286", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01286.fountain", "heading": "EXT. SUNNYBROOK PETTING ZOO - DAY", "cast": [{"id": 0, "name": "BIRTHDAY CLOWN", "names": ["BIRTHDAY", "BIRTHDAY CLOWN", "CLOWN"], "gender": "?", "first": 3, "spoke": 4}, {"id": 1, "name": "TEDDY", "names": ["TEDDY"], "gender": "?", "first": 3, "spoke": 1}, {"id": 2, "name": "PRIYANKA DESHMUKH", "names": ["PRIYANKA DESHMUKH", "PRIYANKA"], "gender": "?", "first": 7, "spoke": 4}, {"id": 3, "name": "DOLORES SWAN", "names": ["DOLORES SWAN", "DOLORES"], "gender": "?", "first": 11, "spoke": 4}, {"id": 4, "name": "GERALD", "names": ["GERALD"], "gender": "m", "first": 20, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SUNNYBROOK PETTING ZOO - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Hay bales.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A painted red barn.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A banner reads HAPPY 7TH BIRTHDAY, TEDDY!", "para": 0, "sent": 2, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "Beneath it, a crowd of parents with phones.", "para": 0, "sent": 3, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "A BIRTHDAY CLOWN, 40s, in an orange wig and enormous shoes, wrestles a bundle of balloon animals.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "A goat watches him with great interest.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "MRS. PRIYANKA DESHMUKH, 40s, blazer, lanyard, a party planner with a tight smile, marches over with a clipboard.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "TEDDY, 7, birthday boy, paper crown crooked, stands at the pen.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "He holds a carrot out to the goat.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "He is very serious.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "DOLORES SWAN, 50s, the zookeeper, in rubber boots and a faded cap, leans on a rake and stares at the clown with wary eyes.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "You're ten minutes late.", "name": "PRIYANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Traffic. Also the goat ate my map.", "name": "CLOWN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "You're a clown. You don't need a map.", "name": "PRIYANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "I'm a fully qualified clown, ma'am. I have a certificate.", "name": "CLOWN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "He's got a certificate.", "name": "DOLORES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Do you have a name, certificate?", "name": "PRIYANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Giggles.", "name": "CLOWN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Your real name.", "name": "PRIYANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Gerald.", "name": "CLOWN", "speaker": 0, "ext": [], "paren": ["lowering his voice"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Gerald, that goat has been staring at you for five minutes. He doesn't like clowns.", "name": "DOLORES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Why not?", "name": "GERALD", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Last clown was a bad time.", "name": "DOLORES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "The goat lowers its head.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Gerald backs away.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "The goat steps forward.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Gerald trips over his shoe, grabs a balloon sword from his belt, thrusts it like a rapier.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "The sword POPS.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "The goat CHARGES.", "para": 5, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Gerald bolts across the yard, wig flying, shoes flapping.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Priyanka drops the clipboard.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Dolores drops the rake and sprints after the goat, shouting.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Teddy bursts into laughter and runs after all of them, crown bouncing.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "The parents' phones come up like a field of tiny cameras.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Is that a good goat?!", "name": "GERALD", "speaker": 4, "ext": ["CONT'D"], "paren": ["over his shoulder"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "That's a goat!", "name": "DOLORES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Gerald vaults a hay bale and lands face-first in the pen.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "The goat skids to a stop.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Sniffs his wig.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Eats it.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Silence.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Then applause.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Best birthday ever!", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Gerald lies in the straw, hairless, beaming.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}]}