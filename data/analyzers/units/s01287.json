{"scene_id": "s01287", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01287.fountain", "heading": "EXT. MANGROVE SWAMP - DUSK", "cast": [{"id": 0, "name": "ELSPETH GRAY", "names": ["ELSPETH GRAY", "ELSPETH"], "gender": "?", "first": 7, "spoke": 13}, {"id": 1, "name": "WANJIRU KARIUKI", "names": ["WANJIRU KARIUKI", "WANJIRU"], "gender": "f", "first": 10, "spoke": 9}, {"id": 2, "name": "HENRIK DAHL", "names": ["HENRIK DAHL", "HENRIK"], "gender": "?", "first": 13, "spoke": 5}, {"id": 3, "name": "YUSUF AL-RASHID", "names": ["YUSUF AL-RASHID", "YUSUF"], "gender": "m", "first": 15, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "EXT. MANGROVE SWAMP - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "Roots like knuckles.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Black water, glassy, ringed with mosquitoes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A heavy sky bruised orange and green.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The air tastes of rot and salt.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Four people wade single file, waist-deep.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "Packs held over their heads.", "para": 1, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "ELSPETH GRAY, 50s, in a drenched canvas hat, leads.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Her face is lined, sunburnt, patient.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "She tests each step with a bamboo pole.", "para": 2, "sent": 2, "present": [0]}, {"u": 10, "kind": "action", "text": "WANJIRU KARIUKI, 30s, close behind, wears a field vest with too many pockets.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Her braid is plastered to her neck.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She carries the sat-phone, dead for three days.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "HENRIK DAHL, 40s, tall and blond, grey with fever, stumbles through the rear.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "His glasses are cracked.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "YUSUF AL-RASHID, 20s, the youngest, carries Henrik's pack as well as his own.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "He grins when he thinks no one's watching.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Roots ahead. Step high.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "How far to the river?", "name": "WANJIRU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Two miles. Maybe three.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Maybe is an expensive word.", "name": "WANJIRU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "It's the only one I've got.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "She plants her pole.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Water ripples around her thighs.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "She stops.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Stay still.", "name": "ELSPETH", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "They do.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "A long beat.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Frogs fall silent.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Something large breaks the surface twenty feet away.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "A dark ridge, a pair of eyes.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "It glides toward the nearest root and slides beneath it.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Nobody breathes.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Is it a log?", "name": "YUSUF", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "It's not a log.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Is it going to eat us?", "name": "YUSUF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "It's been eating the whole way. We're just the dessert.", "name": "WANJIRU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Wanji.", "name": "HENRIK", "speaker": 2, "ext": [], "paren": ["hoarse"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Henrik. Don't talk.", "name": "WANJIRU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "I need to sit.", "name": "HENRIK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "You can't sit. It's a swamp.", "name": "WANJIRU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "I'm going to sit anyway.", "name": "HENRIK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "I've got him.", "name": "YUSUF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "He braces Henrik.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Elspeth glares at the root where the shape vanished.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "She waves a hand: forward.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "They move.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Slowly, silently, a procession of damp shadows across the dusk.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Single file. Keep to the left bank. The right is deeper.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "How do you know?", "name": "WANJIRU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "I came here thirty years ago. With my husband.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "What happened?", "name": "WANJIRU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "He went to the right bank.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Nobody asks more.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "They wade on.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Henrik coughs, a cracked wet sound.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Yusuf pats his back.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Wanjiru adjusts the sat-phone on her shoulder.", "para": 13, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "She tries the power switch.", "para": 13, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "Nothing.", "para": 13, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "Come on. Come on.", "name": "WANJIRU", "speaker": 1, "ext": ["CONT'D"], "paren": ["under her breath"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "The sky darkens a shade.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "Fireflies bloom in the branches overhead, hundreds, drifting down like green sparks.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "It's beautiful.", "name": "YUSUF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "It's malaria.", "name": "HENRIK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "Can't it be both?", "name": "YUSUF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "Possibly.", "name": "HENRIK", "speaker": 2, "ext": [], "paren": ["a faint smile"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "Quiet now. We cross the channel in front of us. Hold hands.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "They link: Elspeth, Wanjiru, Yusuf, Henrik.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "A chain across the black water.", "para": 15, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "dialogue", "text": "On three. One. Two.", "name": "ELSPETH", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "Something SPLASHES behind them.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "Go!", "name": "ELSPETH", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "action", "text": "They plunge forward.", "para": 17, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "Water surges to their chests.", "para": 17, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "Yusuf pulls Henrik, who is half-floating.", "para": 17, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "Wanjiru holds the phone high.", "para": 17, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "Elspeth thrashes ahead, bamboo pole cutting a path.", "para": 17, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "action", "text": "They reach the far bank.", "para": 18, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "action", "text": "Haul themselves up into mud and roots.", "para": 18, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "action", "text": "Collapse, gasping.", "para": 18, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "action", "text": "Behind them, a long ripple fades across the channel.", "para": 19, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "dialogue", "text": "We made it.", "name": "WANJIRU", "speaker": 1, "ext": [], "paren": ["laughing, crying"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "dialogue", "text": "We made the channel.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 84, "kind": "dialogue", "text": "There's more?", "name": "YUSUF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 85, "kind": "dialogue", "text": "Two miles.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 86, "kind": "action", "text": "He lies back.", "para": 20, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 87, "kind": "action", "text": "Stares at the sky.", "para": 20, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 88, "kind": "action", "text": "Fireflies drift across his face.", "para": 20, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 89, "kind": "dialogue", "text": "Okay.", "name": "YUSUF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}