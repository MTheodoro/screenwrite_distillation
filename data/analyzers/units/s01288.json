{"scene_id": "s01288", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01288.fountain", "heading": "INT. LOST UMBRELLA ARCHIVE - NIGHT", "cast": [{"id": 0, "name": "INSPECTOR FINBAR HOLT", "names": ["INSPECTOR FINBAR HOLT", "HOLT"], "gender": "m", "first": 5, "spoke": 14}, {"id": 1, "name": "CEDRIC LOWE", "names": ["CEDRIC LOWE", "LOWE"], "gender": "?", "first": 7, "spoke": 11}, {"id": 2, "name": "MAGDA PRZYBYLSKI", "names": ["MAGDA PRZYBYLSKI", "MAGDA"], "gender": "m", "first": 34, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. LOST UMBRELLA ARCHIVE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cavernous basement beneath a railway station.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wooden racks stretch into darkness, each hung with hundreds of umbrellas, tagged and dated.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single desk lamp burns green.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The air smells of damp wool and old rain.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "INSPECTOR FINBAR HOLT, 50s, tweed, wire-rimmed spectacles, stands at the desk holding a long black umbrella by its handle.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "He turns it slowly in the lamplight.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "CEDRIC LOWE, 60s, the archivist, thin, nervous, with cotton gloves, hovers by the register.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He keeps wiping his palms against his trousers.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Mr. Lowe. When was this deposited?", "name": "HOLT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I cannot say, Inspector. Our records--", "name": "LOWE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Please try.", "name": "HOLT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Tuesday, I think. Possibly Wednesday.", "name": "LOWE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "It is stained.", "name": "HOLT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Many of them are stained.", "name": "LOWE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Not with this.", "name": "HOLT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He tilts the umbrella.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Along the ferrule, a dark crust.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Lowe's gaze flicks to it and away.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "You found it on the tracks.", "name": "HOLT", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Platform four. After the last train.", "name": "LOWE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "And you did not think to call us.", "name": "HOLT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "It was an umbrella, Inspector. We receive eleven hundred a month.", "name": "LOWE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Do you read the papers?", "name": "HOLT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "I... prefer the crossword.", "name": "LOWE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "A man was found in the signal box on Tuesday morning. Head injury. No weapon.", "name": "HOLT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "How dreadful.", "name": "LOWE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "You seem calm.", "name": "HOLT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "I am a calm man.", "name": "LOWE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Mr. Lowe, I think you are afraid.", "name": "HOLT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Lowe says nothing.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Holt lays the umbrella on the desk like a body on a slab.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "A door CREAKS at the far end of the room.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Footsteps echo among the racks.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "MAGDA PRZYBYLSKI, 40s, wrapped in a wine-red coat, steps out of the dark.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "A leather satchel on her shoulder.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Her hair is wet.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "I believe that umbrella is mine.", "name": "MAGDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Is it, madam?", "name": "HOLT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "I left it on the platform. On Tuesday evening.", "name": "MAGDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Magda.", "name": "LOWE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "You know each other?", "name": "HOLT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "No.", "name": "LOWE", "speaker": 1, "ext": [], "paren": ["quickly"], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Yes.", "name": "MAGDA", "speaker": 2, "ext": [], "paren": ["simultaneously"], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Holt takes off his spectacles.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Cleans them on his cuff.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Then perhaps one of you will tell me whose name is on the ticket stub in the handle.", "name": "HOLT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Lowe's mouth opens.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Magda glances at him.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "A look passes between them that Holt does not miss.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "It's not mine.", "name": "LOWE", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "It's not mine.", "name": "MAGDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Then whose?", "name": "HOLT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "The desk lamp FLICKERS.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "In the dark, between the racks, an umbrella falls with a clatter.", "para": 9, "sent": 1, "present": [0, 1, 2]}]}