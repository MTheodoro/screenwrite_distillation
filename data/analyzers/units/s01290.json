{"scene_id": "s01290", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01290.fountain", "heading": "INT. DECOMMISSIONED PLANETARIUM - NIGHT", "cast": [{"id": 0, "name": "NOOR HAKIM", "names": ["NOOR HAKIM", "NOOR"], "gender": "f", "first": 5, "spoke": 7}, {"id": 1, "name": "DOC", "names": ["DOC"], "gender": "?", "first": 8, "spoke": 7}, {"id": 2, "name": "BRAGG", "names": ["BRAGG"], "gender": "?", "first": 8, "spoke": 0}, {"id": 3, "name": "RAFE TOLLIVER", "names": ["RAFE TOLLIVER", "RAFE"], "gender": "?", "first": 10, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. DECOMMISSIONED PLANETARIUM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A dome of peeling white plaster.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Stars projected from a rusted machine that still works.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Seats torn, upholstery leaking foam.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Pigeons roost in the rafters.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "NOOR HAKIM, 30s, field agent, black jacket, hair tied back, crouches behind a row of seats.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Pistol drawn.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She is bleeding from the shoulder.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "ELLISON \"DOC\" BRAGG, 50s, ex-surgeon turned smuggler, kneels beside the projector with a bag of surgical tools.", "para": 2, "sent": 0, "present": [0, 2]}, {"u": 9, "kind": "action", "text": "He is calm.", "para": 2, "sent": 1, "present": [0, 2]}, {"u": 10, "kind": "action", "text": "RAFE TOLLIVER, 30s, tall, in a stained suit, lies on the central floor, one hand pressed to his ribs.", "para": 3, "sent": 0, "present": [0, 2, 3]}, {"u": 11, "kind": "action", "text": "His gun is three feet from his fingers.", "para": 3, "sent": 1, "present": [0, 2, 3]}, {"u": 12, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 2, 3]}, {"u": 13, "kind": "action", "text": "Stars wheel overhead.", "para": 4, "sent": 1, "present": [0, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Doc, back off.", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Noor, I'm trying to help.", "name": "DOC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "By what? Selling him a bandage?", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Doc raises both hands.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Rafe groans.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Noor.", "name": "RAFE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Don't talk.", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Noor. Look at me.", "name": "RAFE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "She crosses to him.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Kicks the gun away.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "It spins under a seat.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "You shot me.", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "I shot at you. You moved.", "name": "RAFE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "That's not an excuse.", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Rafe, you've got a nicked lung. Breathe shallow.", "name": "DOC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Easy for you.", "name": "RAFE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Very easy. I'm not the one with a hole in him.", "name": "DOC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Noor lowers her pistol.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Doc steps forward.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Rafe lunges, grabs Noor's wrist, wrenches.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "The pistol clatters.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "They struggle, rolling across the floor, knocking over a rusted bucket.", "para": 7, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Doc shouts and dives in.", "para": 7, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "The three of them grapple in the dust beneath a thousand painted stars.", "para": 7, "sent": 6, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Stop! Both of you!", "name": "DOC", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Get off me!", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Let go!", "name": "RAFE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Doc seizes the pistol.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Points it at the ceiling.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "FIRES.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Plaster rains.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Pigeons erupt.", "para": 8, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "All three freeze.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Enough.", "name": "DOC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Nobody moves.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Rafe lets go of her wrist.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Noor wipes dust from her eyes.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Doc. That was the last bullet.", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "I know.", "name": "DOC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "He lowers the pistol.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Sets it on the floor.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Now let me look at both of you.", "name": "DOC", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Rafe drops back.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Noor sits beside him, breathing hard.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "Above, a comet crosses the dome.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}]}