{"scene_id": "s01291", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01291.fountain", "heading": "INT. ROSELLE'S WEDDING CAKE ATELIER - MORNING", "cast": [{"id": 0, "name": "BART", "names": ["BART"], "gender": "?", "first": 5, "spoke": 4}, {"id": 1, "name": "OYELARAN", "names": ["OYELARAN"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "CHLOE FENWICK-DASH", "names": ["CHLOE FENWICK-DASH", "CHLOE"], "gender": "f", "first": 7, "spoke": 5}, {"id": 3, "name": "LUDWIK", "names": ["LUDWIK"], "gender": "?", "first": 10, "spoke": 2}, {"id": 4, "name": "DONNA", "names": ["DONNA"], "gender": "?", "first": 11, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROSELLE'S WEDDING CAKE ATELIER - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "A pink-walled bakery in a state of panic.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Racks of sugar flowers, bowls of fondant, a six-tier cake on a marble counter.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A wall clock reads 8:47.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The ceremony begins at ten.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "BARTHOLOMEW \"BART\" OYELARAN, 30s, the groom, in a tuxedo shirt and no jacket, paces with a phone pinched between his chin and his shoulder.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "He has icing on his cuff.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "CHLOE FENWICK-DASH, 30s, the bride, in a hoodie over a half-pinned gown, stands rigid before the cake.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Her veil is askew.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "She stares at the third tier.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "LUDWIK, 50s, the pastry chef, a mountain of apron and moustache, wrings a dish towel and says nothing.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Bartholomew! Is that a sunflower on my daughter's cake?", "name": "DONNA", "speaker": 4, "ext": ["V.O."], "paren": ["from the phone, shrill"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Mrs. Fenwick-Dash, it's a daisy.", "name": "BART", "speaker": 0, "ext": [], "paren": ["into the phone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "It is a sunflower, Bartholomew. I specifically said no sunflowers.", "name": "DONNA", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Mom, it's not a sunflower!", "name": "CHLOE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Chloe, is that you? Why are you at the bakery? You're supposed to be at the salon!", "name": "DONNA", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "The salon burned down.", "name": "CHLOE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "It did not burn down.", "name": "BART", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "It's a metaphor.", "name": "CHLOE", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Madame, it is a daisy. Look. Five petals.", "name": "LUDWIK", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "I count nine!", "name": "DONNA", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Bart holds the phone out.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Counts the petals.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Brings it back.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Seven.", "name": "BART", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "That is not a daisy, Bartholomew. That is a sunflower in a daisy costume.", "name": "DONNA", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Ludwik snatches a pastry knife.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Slices the offending flower off the tier.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "It thumps to the counter.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "He hands the cake an apologetic pat.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Now it is nothing.", "name": "LUDWIK", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Better!", "name": "DONNA", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Chloe throws her bouquet at the wall.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Bart ends the call.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Silence, then, softly, from the counter:", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Bart.", "name": "CHLOE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Yeah?", "name": "BART", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Let's elope.", "name": "CHLOE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Ludwik hands them each a slice of the sunflower.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}]}