, "present": [0]}, {"u": 30, "kind": "dialogue", "text": "If anyone finds this tape, the Grand Meridian is not a hotel.", "name": "PHILOMENA", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": ["recorded, barely a whisper"], "dual": false, "present": [0]}, {"u": 31, "kind": "action", "text": "The latch turns.", "para": 12, "sent": 0, "present": [0]}, {"u": 32, "kind": "action", "text": "She hurls the recorder into the laundry chute.", "para": 13, "sent": 0, "present": [0]}, {"u": 33, "kind": "action", "text": "It clatters down into the dark.", "para": 13, "sent": 1, "present": [0]}, {"u": 34, "kind": "action", "text": "The panel swings inward.", "para": 14, "sent": 0, "present": [0]}]}