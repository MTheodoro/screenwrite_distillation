{"scene_id": "s01294", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01294.fountain", "heading": "EXT. DRIFTING ICE FLOE - DAY", "cast": [{"id": 0, "name": "LAWRENCE DEVEREUX", "names": ["LAWRENCE DEVEREUX", "LAWRENCE"], "gender": "m", "first": 4, "spoke": 12}, {"id": 1, "name": "ABEL TSEGAYE", "names": ["ABEL TSEGAYE", "ABEL"], "gender": "m", "first": 6, "spoke": 11}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DRIFTING ICE FLOE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A slab of white, a hundred feet across, adrift in a grey sea.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fog presses on every side.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The ice groans.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LAWRENCE DEVEREUX, 50s, polar surveyor, in a heavy wool coat caked with frost, kneels by a crate of instruments.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "His beard is white with rime.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "ABEL TSEGAYE, 30s, his assistant, stands at the edge of the floe, peering into the fog.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "A rope wound about his chest.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Abel, stay back from the edge.", "name": "LAWRENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "There is water on the east side.", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "There is water on every side.", "name": "LAWRENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "The ice is thinner there. I heard it crack.", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Then we stay on the west.", "name": "LAWRENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He rises, stiff-limbed.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He picks up a compass.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "The needle spins, useless.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "How long has the floe been drifting?", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Since Tuesday.", "name": "LAWRENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "We should signal.", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "With what? A flare?", "name": "LAWRENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "There are two flares.", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "There is one. The other went down with the sled.", "name": "LAWRENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Abel turns.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Fog swallows the sea.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "You didn't tell me.", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "You didn't ask.", "name": "LAWRENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "A deep CRACK runs through the ice.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Both men freeze.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "A fissure opens ten feet from Lawrence's boots, black water welling.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Lawrence!", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "He reaches him.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Hauls him back.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "The fissure widens to a yard.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Cut the rope.", "name": "LAWRENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "No.", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Abel, if it takes me, it takes you.", "name": "LAWRENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Then it takes us both. Pull!", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Lawrence scrambles up.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "They collapse on the solid ice.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "The gap stops, a few feet wide.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Water slaps the edges.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "One flare.", "name": "LAWRENCE", "speaker": 0, "ext": [], "paren": ["breathless"], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "One flare.", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Lawrence digs in his pack.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "Pulls out a dented red tube.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "His hand shakes.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "You do it.", "name": "LAWRENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "Why?", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Because he who lights it will be the one they find first.", "name": "LAWRENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "Abel takes the flare.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "Pulls the cap.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "A plume of crimson smoke bursts into the fog, bright as blood on snow.", "para": 9, "sent": 2, "present": [0, 1]}]}