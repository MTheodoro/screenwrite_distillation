14, "kind": "dialogue", "text": "Yes, ma'am. We see you.", "name": "CLERK", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I'm due in Courtroom 7 in four minutes.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "The judge has been informed.", "name": "CLERK", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She exhales.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Sets down her briefcase.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Rubs her temples.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Is he angry?", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Ma'am?", "name": "CLERK", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "The judge.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "He said, and I quote, \"Let her be late. She's earned it.\"", "name": "CLERK", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She blinks.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Then, for the first time all day, she laughs.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "I won, didn't I?", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "The jury came back ten minutes ago.", "name": "CLERK", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "She leans her head against the wall.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Closes her eyes.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Then take your time.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}