{"scene_id": "s01298", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01298.fountain", "heading": "INT. ROLLER DERBY LOCKER ROOM - NIGHT", "cast": [{"id": 0, "name": "BERNIE", "names": ["BERNIE"], "gender": "?", "first": 6, "spoke": 8}, {"id": 1, "name": "OYELOWO", "names": ["OYELOWO"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "SUNNIVA HOLM", "names": ["SUNNIVA HOLM", "SUNNIVA"], "gender": "f", "first": 8, "spoke": 2}, {"id": 3, "name": "TILLY BRANDT", "names": ["TILLY BRANDT", "TILLY"], "gender": "f", "first": 10, "spoke": 1}, {"id": 4, "name": "TANK", "names": ["TANK"], "gender": "?", "first": 11, "spoke": 2}, {"id": 5, "name": "DELACROIX", "names": ["DELACROIX"], "gender": "?", "first": 11, "spoke": 0}, {"id": 6, "name": "RAJANI PILLAI", "names": ["RAJANI PILLAI", "RAJANI"], "gender": "?", "first": 12, "spoke": 3}, {"id": 7, "name": "DIEDRE KOWALCZYK", "names": ["DIEDRE KOWALCZYK", "DIEDRE"], "gender": "f", "first": 13, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROLLER DERBY LOCKER ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Concrete floor.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Steel lockers, dented.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Fluorescent flicker.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A hundred pairs of skates on hooks.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The scoreboard through the wall reads 142-38.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "COACH BERNADETTE \"BERNIE\" OYELOWO, 50s, in a tracksuit and whistle, stands in the centre with a dry-erase marker.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Her jaw is clamped.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "SUNNIVA HOLM, 20s, jammer, the team's star, sits on a bench with her helmet in her lap.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Her lip is split.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "TILLY BRANDT, 20s, blocker, ponytail, holds an ice pack to her wrist.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "MARGOT \"TANK\" DELACROIX, 30s, enormous, sits on the floor tying a skate.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "RAJANI PILLAI, 20s, rookie, stands against the wall, wide-eyed.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "action", "text": "DIEDRE KOWALCZYK, 30s, captain, rubs her knuckles raw with a towel.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 14, "kind": "dialogue", "text": "Final period. One hundred and four points down.", "name": "BERNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 15, "kind": "dialogue", "text": "I know.", "name": "SUNNIVA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 16, "kind": "dialogue", "text": "I didn't ask if you knew.", "name": "BERNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 17, "kind": "dialogue", "text": "Coach, with respect, we're being killed.", "name": "TANK", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 18, "kind": "dialogue", "text": "Then die loud.", "name": "BERNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 19, "kind": "dialogue", "text": "We can't win.", "name": "DIEDRE", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 20, "kind": "dialogue", "text": "You can't win. You can lose with dignity.", "name": "BERNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 21, "kind": "dialogue", "text": "That doesn't sound like a pep talk.", "name": "TILLY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 22, "kind": "dialogue", "text": "It isn't. It's the truth.", "name": "BERNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 23, "kind": "dialogue", "text": "Can I say something?", "name": "RAJANI", "speaker": 6, "ext": [], "paren": ["small voice"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 24, "kind": "dialogue", "text": "Please.", "name": "BERNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 25, "kind": "dialogue", "text": "This is the best night of my life.", "name": "RAJANI", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 26, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 27, "kind": "action", "text": "The lockers hum.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 28, "kind": "dialogue", "text": "She's serious.", "name": "TANK", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 29, "kind": "dialogue", "text": "I've watched you play since I was twelve. Now I'm in the locker room. We're losing a hundred and four to thirty-eight, and I'm so happy I could throw up.", "name": "RAJANI", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "dialogue", "text": "Rookie.", "name": "SUNNIVA", "speaker": 2, "ext": [], "paren": ["laughing"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "dialogue", "text": "Welcome to the team.", "name": "DIEDRE", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "action", "text": "Tilly tosses her ice pack across the room.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "action", "text": "Tank catches it, flings it back.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "action", "text": "Sunniva swats it out of the air, knocks Rajani's helmet off her head.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "action", "text": "Rajani lunges for it; Diedre grabs the helmet, stuffs it on Tank's head.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "action", "text": "They collapse into a wrestling pile of limbs and laughter.", "para": 8, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "action", "text": "Bernie lets them for a full five seconds.", "para": 8, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "action", "text": "Then she blows her whistle.", "para": 8, "sent": 6, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "dialogue", "text": "Go skate.", "name": "BERNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "action", "text": "They file out.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 41, "kind": "action", "text": "Bernie caps the marker.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 42, "kind": "action", "text": "Waits until the room is empty.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 43, "kind": "dialogue", "text": "Dignity.", "name": "BERNIE", "speaker": 0, "ext": ["CONT'D"], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}