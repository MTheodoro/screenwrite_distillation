{"scene_id": "s01299", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01299.fountain", "heading": "EXT. WILLOWBEND LAWN BOWLS CLUB - AFTERNOON", "cast": [{"id": 0, "name": "HAROLD PENROSE-LANE", "names": ["HAROLD PENROSE-LANE", "HAROLD"], "gender": "m", "first": 6, "spoke": 9}, {"id": 1, "name": "DOROTHEA STUBBS", "names": ["DOROTHEA STUBBS", "DOROTHEA"], "gender": "f", "first": 9, "spoke": 7}, {"id": 2, "name": "BASIL", "names": ["BASIL"], "gender": "m", "first": 12, "spoke": 3}, {"id": 3, "name": "OSWIN TATE", "names": ["OSWIN TATE", "TATE"], "gender": "m", "first": 14, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. WILLOWBEND LAWN BOWLS CLUB - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "A perfect rectangle of green behind a low whitewashed pavilion.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A striped awning.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Teacups on a trestle.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Wood clacks on wood.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A hush that is almost religious.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "HAROLD PENROSE-LANE, 70s, in a panama hat and cream flannels, stands at the mat.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Silver moustache, rheumy eyes.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "He holds a polished wooden bowl in both hands as though it were an egg.", "para": 1, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "DOROTHEA STUBBS, 60s, in a pleated skirt and club blazer, sits on a folding chair at the edge of the rink.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She knits something grey and shapeless.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Her opponent for forty years.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "BASIL, 14, ball boy and club mascot, in a too-large white shirt, crouches by the jack with a measuring tape.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "He has never wanted to be anywhere else.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "MR. OSWIN TATE, 80, the umpire, sits motionless in the shade of the pavilion, clipboard on his knee, a lifetime of rules in his posture.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Last end, Dorothea.", "name": "HAROLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "So I am told.", "name": "DOROTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "If I put it close, I win.", "name": "HAROLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "If you put it close, I'll move it.", "name": "DOROTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "That is cheating.", "name": "HAROLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "That is bowls.", "name": "DOROTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Harold bends.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "His knees creak.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "He swings his arm and releases, and the bowl rolls across the grass in a long lazy arc.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Basil watches it with held breath.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Mr. Tate lifts his head one inch.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Dorothea sets down her knitting, rises, tugs her blazer straight, and picks up her own bowl, all in perfect silence, while the first bowl curves, slows, and stops two inches shy of the jack.", "para": 5, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Two inches!", "name": "BASIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Excellent.", "name": "HAROLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Don't be smug. You haven't won yet.", "name": "DOROTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "She steps to the mat.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Lines up her shot.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Swings.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "The bowl rolls true, trundles past Harold's, kisses the jack, and nudges it a quarter inch.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "She moved the jack.", "name": "BASIL", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Within the rules.", "name": "TATE", "speaker": 3, "ext": [], "paren": ["a creak, from the shade"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Oswin, it is not within the rules.", "name": "HAROLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "It is within the rules, Harold. I have read them. Page forty-one.", "name": "TATE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "I have read page forty-one.", "name": "HAROLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Then you have also read the part where the umpire is always correct.", "name": "TATE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Harold sighs.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Removes his panama.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Fans himself.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Dorothea sits back down and resumes her knitting.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Basil, measure it.", "name": "DOROTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Basil crawls on his knees across the green.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Stretches the tape from the jack to Harold's bowl.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Then to Dorothea's.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "He looks up.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "It's a tie.", "name": "BASIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "A long, still moment.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "A tie.", "name": "HAROLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Well.", "name": "DOROTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Then there shall be an extra end.", "name": "TATE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "At this hour?", "name": "HAROLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "At any hour.", "name": "TATE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Dorothea rises, gathers her bowls, and walks to the mat without a word.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Harold puts his hat back on.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "Basil scoops the jack and carries it to the far end with great ceremony.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "Tea first?", "name": "DOROTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "Tea first.", "name": "HAROLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "They walk together toward the pavilion.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "The green lies still in the afternoon sun.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}]}