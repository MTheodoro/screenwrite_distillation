{"scene_id": "s01301", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01301.fountain", "heading": "EXT. SKI JUMP TOWER - TOP PLATFORM - DAWN", "cast": [{"id": 0, "name": "COACH LARS EKBERG", "names": ["COACH LARS EKBERG", "LARS"], "gender": "m", "first": 3, "spoke": 6}, {"id": 1, "name": "MIKA SAARINEN", "names": ["MIKA SAARINEN", "MIKA"], "gender": "?", "first": 4, "spoke": 4}, {"id": 2, "name": "OFFICIAL YEVGENY MARKOV", "names": ["OFFICIAL YEVGENY MARKOV", "YEVGENY"], "gender": "?", "first": 6, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SKI JUMP TOWER - TOP PLATFORM - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Wind whips the flags.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Below, a white ramp falls away to a snowy outrun and a ribbon of crowd.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "COACH LARS EKBERG, 50s, fur-trimmed parka, stands behind the jumper with a radio in his fist.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "MIKA SAARINEN, 20s, in a skin-tight suit and goggles, sits on the starting bar.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Her knees tremble.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "OFFICIAL YEVGENY MARKOV, 40s, in an orange vest, hunches over a clipboard and a wind gauge.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Wind's shifting.", "name": "LARS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Is it going to be okay?", "name": "MIKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Eight metres a second. Gusting.", "name": "YEVGENY", "speaker": 2, "ext": [], "paren": ["to Lars, low"], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "It's fine. You've done worse.", "name": "LARS", "speaker": 0, "ext": [], "paren": ["to Mika"], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I haven't.", "name": "MIKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "You've jumped in a blizzard.", "name": "LARS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "I fell in a blizzard.", "name": "MIKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "You landed in a blizzard.", "name": "LARS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Gate open on my word.", "name": "YEVGENY", "speaker": 2, "ext": [], "paren": ["to the radio"], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Coach, I can't feel my hands.", "name": "MIKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Good. Then they can't shake.", "name": "LARS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Silence on the platform, please.", "name": "YEVGENY", "speaker": 2, "ext": [], "paren": ["to the whole tower"], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Everyone is still.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Wind.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "A raven calls.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Come on, girl. Come on.", "name": "LARS", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Go.", "name": "YEVGENY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Mika pushes off.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "The ramp swallows her.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "A hiss of ice.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "A scream from the crowd, then a roar.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Lars drops the radio.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Presses his gloved fists to his mouth.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "She landed. She stood it up.", "name": "YEVGENY", "speaker": 2, "ext": ["CONT'D"], "paren": ["into the radio, shaky"], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Lars laughs.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Tears freeze on his beard.", "para": 7, "sent": 1, "present": [0, 1, 2]}]}