{"scene_id": "s01302", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01302.fountain", "heading": "INT. FUNERAL PARLOUR - SIDE ROOM - DAY", "cast": [{"id": 0, "name": "DOROTHY WAKEFIELD", "names": ["DOROTHY WAKEFIELD", "DOROTHY"], "gender": "?", "first": 4, "spoke": 7}, {"id": 1, "name": "VICTOR WAKEFIELD", "names": ["VICTOR WAKEFIELD", "VICTOR"], "gender": "?", "first": 4, "spoke": 3}, {"id": 2, "name": "TABITHA CROWE", "names": ["TABITHA CROWE", "TABITHA"], "gender": "?", "first": 6, "spoke": 5}, {"id": 3, "name": "LEONTYNE BASS", "names": ["LEONTYNE BASS", "LEONTYNE"], "gender": "?", "first": 7, "spoke": 2}, {"id": 4, "name": "FATHER OSWALD QUINN", "names": ["FATHER OSWALD QUINN", "FATHER QUINN"], "gender": "?", "first": 8, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. FUNERAL PARLOUR - SIDE ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Tapestried chairs.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A sideboard of sherry glasses.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Five people stand in a half circle around a closed casket.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DOROTHY WAKEFIELD, 70s, the widow.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "VICTOR WAKEFIELD, 40s, her son.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "TABITHA CROWE, 30s, the nurse.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "LEONTYNE BASS, 50s, the lawyer.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "FATHER OSWALD QUINN, 60s, the priest.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "He didn't fall.", "name": "DOROTHY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Mother.", "name": "VICTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "He didn't fall, Victor. He was pushed.", "name": "DOROTHY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Mrs. Wakefield, the coroner said--", "name": "TABITHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "The coroner said what he was paid to say.", "name": "DOROTHY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Dorothy, I advise you not to make accusations in front of witnesses.", "name": "LEONTYNE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Witnesses to what? Five people, one dead man, and a staircase.", "name": "DOROTHY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Dorothy, grief makes a person see monsters.", "name": "FATHER QUINN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Father, forty years I have heard you talk of mercy. Tell me, where was mercy at two in the morning on Sunday?", "name": "DOROTHY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "I was home.", "name": "VICTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "I was on shift.", "name": "TABITHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "I was at my club.", "name": "LEONTYNE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "I was at prayers.", "name": "FATHER QUINN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "And I was asleep. So who was it?", "name": "DOROTHY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Silence.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "The clock ticks.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "A sherry glass trembles on the sideboard.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "He called me at one-forty. Said he'd heard someone in the house.", "name": "TABITHA", "speaker": 2, "ext": [], "paren": ["very quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "You never told us.", "name": "VICTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "I didn't think it mattered.", "name": "TABITHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Who did he say it was?", "name": "DOROTHY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "He said it was someone from this room.", "name": "TABITHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}