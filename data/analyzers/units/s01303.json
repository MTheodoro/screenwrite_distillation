{"scene_id": "s01303", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01303.fountain", "heading": "INT. FLORIST'S COLD ROOM - NIGHT", "cast": [{"id": 0, "name": "MARISOL FUENTES", "names": ["MARISOL FUENTES", "MARISOL"], "gender": "?", "first": 6, "spoke": 4}, {"id": 1, "name": "DES", "names": ["DES"], "gender": "?", "first": 9, "spoke": 3}, {"id": 2, "name": "ARCHER", "names": ["ARCHER"], "gender": "?", "first": 9, "spoke": 0}, {"id": 3, "name": "OTTILIE NASH", "names": ["OTTILIE NASH", "OTTILIE"], "gender": "?", "first": 10, "spoke": 1}, {"id": 4, "name": "WILHELM BRAND", "names": ["WILHELM BRAND", "WILHELM"], "gender": "?", "first": 12, "spoke": 1}, {"id": 5, "name": "RICARDO VEGA", "names": ["RICARDO VEGA", "RICARDO"], "gender": "?", "first": 27, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. FLORIST'S COLD ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A walk-in refrigerator, humming at four degrees.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Buckets of white roses and blood-red peonies crowd the shelves.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Breath hangs in the air.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Frost on every stem.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The floor is wet and smells of cut green.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "MARISOL FUENTES, 50s, the florist, in a wool cap and fingerless gloves, arranges lilies in a zinc bucket.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "She hums.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "Her hands are steady.", "para": 1, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "DESMOND \"DES\" ARCHER, 30s, in a delivery jacket, leans against the doorframe, a clipboard in his fist and a nervous smile on his lips.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "OTTILIE NASH, 20s, the apprentice, in a green apron, snips stems at the workbench.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "She is slightly too cheerful.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "WILHELM BRAND, 60s, the owner, in a camel coat, sits on an overturned crate eating an apple.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "He has been here for an hour and has not said a word.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Des, I told you. Fourteen arrangements by morning.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "I know. I'm counting.", "name": "DES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Count faster.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "I could help, Mr. Archer.", "name": "OTTILIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "I'd like that.", "name": "DES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "They move together.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Their hands brush over a bucket of peonies.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Ottilie flushes.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Wilhelm keeps eating.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "A door opens in the corridor outside.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Steps approach.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "The apple stops halfway to his mouth.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Through the frosted glass: a figure.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "RICARDO VEGA, 40s, in a dripping raincoat and a wide-brimmed hat, pushes into the cold room.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "He closes the door softly.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Marisol freezes.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Des drops the clipboard.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Evening, Wilhelm.", "name": "RICARDO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Wilhelm sets the apple on the crate.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Wipes his hands.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Stands.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "You're late.", "name": "WILHELM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "I brought what you asked.", "name": "RICARDO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "He lifts a leather satchel.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Opens it.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Inside, wrapped in a white lily: a gun.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Marisol turns to Des.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Her smile is gone.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Des. Fourteen arrangements.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "Marisol?", "name": "DES", "speaker": 1, "ext": [], "paren": ["pale"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Count the funerals.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}