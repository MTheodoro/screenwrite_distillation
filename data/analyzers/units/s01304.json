{"scene_id": "s01304", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01304.fountain", "heading": "INT. COUNTY FAIR - SOURDOUGH PAVILION - DAY", "cast": [{"id": 0, "name": "BEA", "names": ["BEA"], "gender": "?", "first": 5, "spoke": 4}, {"id": 1, "name": "HALLORAN", "names": ["HALLORAN"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "OKSANA PRYSTAI", "names": ["OKSANA PRYSTAI", "OKSANA"], "gender": "f", "first": 6, "spoke": 4}, {"id": 3, "name": "JUDGE ARMAND DELACOUR", "names": ["JUDGE ARMAND DELACOUR", "DELACOUR"], "gender": "m", "first": 8, "spoke": 9}, {"id": 4, "name": "LIAM", "names": ["LIAM"], "gender": "m", "first": 9, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. COUNTY FAIR - SOURDOUGH PAVILION - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A striped canvas tent crowded with trestle tables.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Loaves arranged under glass cloches like jewels.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A hand-lettered banner: GOLDEN CRUST CHAMPIONSHIP.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The air smells of yeast and burnt sugar.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "BEATRICE \"BEA\" HALLORAN, 60s, in a flour-dusted apron and her late husband's flat cap, guards a crusty round loaf with the tenderness of a mother with her firstborn.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "OKSANA PRYSTAI, 50s, her lifelong rival, in a ruffled blouse and bright red lipstick, tends a loaf of her own.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "She is the picture of calm, and she sweats.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "JUDGE ARMAND DELACOUR, 70s, in a straw boater and a white linen suit, strolls the tables with a tasting knife and the face of a man who has seen it all.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "His assistant, LIAM, 19, in an apron three sizes too big, trots after him with a notebook and a pencil he can't keep sharp.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Write this down. Table four. Crust, firm. Crumb, open. Aroma, hints of sour cherry.", "name": "DELACOUR", "speaker": 3, "ext": [], "paren": ["to Liam"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Sour cherry?", "name": "LIAM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "I find it on the nose.", "name": "DELACOUR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Beatrice lifts her cloche with a flourish.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Steam curls.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Delacour leans in.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Oksana, at the next table, cranes sideways.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Liam drops his pencil, retrieves it, drops it again.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Beatrice sets the loaf on its board, tears it with her bare hands, and holds out a steaming half.", "para": 5, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Delacour accepts it, chews, and closes his eyes.", "para": 5, "sent": 6, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Oksana dabs her upper lip with a handkerchief.", "para": 5, "sent": 7, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Liam writes something illegible.", "para": 5, "sent": 8, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Beatrice. This is magnificent.", "name": "DELACOUR", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Thank you, Armand.", "name": "BEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Is that rye?", "name": "DELACOUR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "A little.", "name": "BEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "It sings.", "name": "DELACOUR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "It screams.", "name": "OKSANA", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "I heard that, Oksana.", "name": "BEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "You were meant to.", "name": "OKSANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Delacour moves on to table five.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Oksana lifts her own cloche with an equally grand gesture.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "He tastes.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "He chews.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "He frowns.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Hm.", "name": "DELACOUR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Hm?", "name": "OKSANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "It is very... confident.", "name": "DELACOUR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Is that good?", "name": "LIAM", "speaker": 4, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "It is not bad.", "name": "DELACOUR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Oksana's smile cracks.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Beatrice turns away to hide a grin.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Delacour clears his throat and consults Liam's notes.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "The winner is table four.", "name": "DELACOUR", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Beatrice lets out a little shriek, grabs her flat cap, and flings it into the air.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "It lands on Liam's head.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Oksana stares at her loaf as though it has betrayed her.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "Next year.", "name": "OKSANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Next year.", "name": "BEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "They shake hands.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "It lasts a beat too long.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}]}