{"scene_id": "s01305", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01305.fountain", "heading": "INT. LUNAR ELEVATOR - CAR 4 - CONTINUOUS", "cast": [{"id": 0, "name": "CAPTAIN IRENE VOSS", "names": ["CAPTAIN IRENE VOSS", "IRENE"], "gender": "f", "first": 4, "spoke": 5}, {"id": 1, "name": "TAMSIN OKORO", "names": ["TAMSIN OKORO", "TAMSIN"], "gender": "f", "first": 5, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. LUNAR ELEVATOR - CAR 4 - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "A narrow steel cabin, ribbed with cable housing, one round window.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Earth hangs beyond it, impossibly bright.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Warning lights pulse amber.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CAPTAIN IRENE VOSS, 40s, in a pressure suit with the helmet clipped at her hip, braces against the wall with one hand, a tablet in the other.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her partner TAMSIN OKORO, 30s, in the same suit, hangs from the ceiling rail, trying to rewire a panel with a screwdriver in her teeth.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "A bolt snaps.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "The car lurches.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Tamsin swings out, catches Irene by the shoulder, and both women slam against the window.", "para": 1, "sent": 4, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "The tablet floats loose.", "para": 1, "sent": 5, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Irene grabs it.", "para": 1, "sent": 6, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Tamsin spits out the screwdriver and clamps it to her chest.", "para": 1, "sent": 7, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "The lights go red.", "para": 1, "sent": 8, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Status!", "name": "IRENE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Cable two's gone. We're on three and four.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Can they hold us?", "name": "IRENE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "For nine minutes.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Nine minutes.", "name": "IRENE", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Eight and a half.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Everyone in the cabin, seat belts!", "name": "IRENE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "There's only you and me.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "I know. It's a figure of speech.", "name": "IRENE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "A thunk.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "A groan from the housing.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Then a soft chime.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "The lights return to amber.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "The car steadies.", "para": 2, "sent": 4, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "They stare at each other.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Tamsin starts to laugh.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Irene joins her.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "They drift apart in the microgravity, still laughing, still holding hands.", "para": 3, "sent": 3, "present": [0, 1]}]}