{"scene_id": "s01306", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01306.fountain", "heading": "EXT. FIELD KITCHEN - ROADSIDE ORCHARD - DUSK", "cast": [{"id": 0, "name": "SERGEANT MAEVE O'DWYER", "names": ["SERGEANT MAEVE O'DWYER", "O'DWYER"], "gender": "f", "first": 7, "spoke": 4}, {"id": 1, "name": "CORPORAL TOBIAS FINCH", "names": ["CORPORAL TOBIAS FINCH", "FINCH"], "gender": "m", "first": 9, "spoke": 4}, {"id": 2, "name": "PRIVATE HANNAH BRISCOE", "names": ["PRIVATE HANNAH BRISCOE", "BRISCOE"], "gender": "f", "first": 11, "spoke": 2}, {"id": 3, "name": "LIEUTENANT RAFAEL CORTEZ", "names": ["LIEUTENANT RAFAEL CORTEZ", "CORTEZ"], "gender": "?", "first": 12, "spoke": 4}, {"id": 4, "name": "CAPTAIN ISABELLE DUVAL", "names": ["CAPTAIN ISABELLE DUVAL", "DUVAL"], "gender": "?", "first": 13, "spoke": 5}, {"id": 5, "name": "DISPATCH RIDER", "names": ["DISPATCH RIDER", "RIDER"], "gender": "?", "first": 41, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FIELD KITCHEN - ROADSIDE ORCHARD - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "1944.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Apple trees blown to splinters.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A canvas tent pitched against a stone wall.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Soup bubbles in a great steel cauldron.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Smoke drifts across a quiet road.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "Distant guns have gone silent.", "para": 0, "sent": 5, "present": []}, {"u": 7, "kind": "action", "text": "SERGEANT MAEVE O'DWYER, 40s, a stout cook in an apron over her tunic, ladles broth into tin cups.", "para": 1, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "She hums.", "para": 1, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "CORPORAL TOBIAS FINCH, 20s, a lanky private-turned-corporal, sits on a crate, unlacing a boot.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He wears three days of beard.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "PRIVATE HANNAH BRISCOE, 20s, a signaller, sits cross-legged in the grass with a field telephone in her lap, staring at it.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "LIEUTENANT RAFAEL CORTEZ, 30s, young and polished, stands at the tent flap, map in hand, for once without a plan.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "CAPTAIN ISABELLE DUVAL, 40s, the company commander, sits on an upturned bucket, quietly drinking.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Soup's ready, sir.", "name": "O'DWYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Thank you, Sergeant.", "name": "CORTEZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "It's mostly potato.", "name": "O'DWYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "It's perfect.", "name": "CORTEZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "He takes the cup.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Sips.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Closes his eyes.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Sir, line's dead.", "name": "BRISCOE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Of course it is.", "name": "CORTEZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Does that mean the war's over?", "name": "BRISCOE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "It means the line's dead, Private.", "name": "DUVAL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "A pause.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Captain, can I ask something?", "name": "FINCH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Ask.", "name": "DUVAL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Are we going home?", "name": "FINCH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Eventually.", "name": "DUVAL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "That's not an answer.", "name": "FINCH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "It's the only one I've got.", "name": "DUVAL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Finch holds out his cup.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Sergeant, is there more?", "name": "FINCH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "There's always more.", "name": "O'DWYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "She fills it.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "A small smile crosses his face.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Down the road, an engine.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "A lone jeep, headlights dimmed.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Everyone straightens.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Rifles lift.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "A DISPATCH RIDER, 20s, in a mud-caked coat, pulls up and cuts the engine.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "He stumbles off, hands raised.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "Don't shoot. Message from division.", "name": "RIDER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Read it.", "name": "CORTEZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "It's over, sir. Signed this morning.", "name": "RIDER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Nobody moves.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "A long breath goes round the company.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "Finch lowers his boot.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "Briscoe drops the telephone.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "Well.", "name": "DUVAL", "speaker": 4, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "Soup, sir?", "name": "O'DWYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "The Rider blinks.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "Yes, ma'am. Please.", "name": "RIDER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}