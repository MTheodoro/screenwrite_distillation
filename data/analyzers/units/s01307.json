{"scene_id": "s01307", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01307.fountain", "heading": "INT. HOSPITAL PARKING GARAGE - LEVEL 3 - NIGHT", "cast": [{"id": 0, "name": "WOMAN", "names": ["WOMAN"], "gender": "f", "first": 5, "spoke": 3}, {"id": 1, "name": "MAN", "names": ["MAN"], "gender": "?", "first": 6, "spoke": 2}, {"id": 2, "name": "PETER", "names": ["PETER"], "gender": "f", "first": 9, "spoke": 7}, {"id": 3, "name": "DR. LINDEN", "names": ["DR. LINDEN"], "gender": "?", "first": 7, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOSPITAL PARKING GARAGE - LEVEL 3 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Concrete.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Humming lights.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A lone sedan with its hazards blinking.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain beats on the ramp.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A WOMAN, 50s, in scrubs and a trench coat, sits on the bumper, face in her hands.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A MAN, 30s, in a hospital badge lanyard, approaches from the stairwell with two coffees.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Dr. Linden?", "name": "MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 8, "kind": "dialogue", "text": "Don't.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 9, "kind": "dialogue", "text": "I'm Peter. From the ER. You asked me to come.", "name": "MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "She lifts her head.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Her mascara has run.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "I didn't ask you anything.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "You did. Eight minutes ago. Text message.", "name": "PETER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "I don't remember.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "He sets a coffee on the hood.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "You lost the boy in bay six.", "name": "PETER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "I lost the boy in bay six.", "name": "DR. LINDEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "We all did.", "name": "PETER", "speaker": 2, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "She takes the coffee.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Holds it without drinking.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "He was nine.", "name": "DR. LINDEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "I know.", "name": "PETER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "He had a dog named Rocket.", "name": "DR. LINDEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Dr. Linden...", "name": "PETER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "He told me. While I was putting in the line.", "name": "DR. LINDEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Peter sits beside her.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Their shoulders touch.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Rain drums on the roof.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Come back inside. I'll cover your shift.", "name": "PETER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "I can't.", "name": "DR. LINDEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "You can.", "name": "PETER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "She nods.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Doesn't move.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}]}