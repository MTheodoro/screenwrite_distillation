{"scene_id": "s01308", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01308.fountain", "heading": "INT. BOOKBINDERY - EDWARDIAN LONDON - MORNING", "cast": [{"id": 0, "name": "EDWIN ASHCROFT", "names": ["EDWIN ASHCROFT", "ASHCROFT"], "gender": "m", "first": 6, "spoke": 19}, {"id": 1, "name": "MISS ADELAIDE FOX", "names": ["MISS ADELAIDE FOX", "ADELAIDE"], "gender": "m", "first": 9, "spoke": 14}], "units": [{"u": 0, "kind": "heading", "text": "INT. BOOKBINDERY - EDWARDIAN LONDON - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "A narrow workshop, three floors above a cobbled lane.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Presses of black iron and polished oak.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Racks of calf and morocco leather in every shade of brown.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Gold leaf trembles on its tissue by the window.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Sunlight falls on piles of unbound folios, tied with string.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "MR. EDWIN ASHCROFT, 60s, the master binder, stands at the bench in a leather apron, his spectacles pushed up on his forehead.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Grey whiskers, ink-stained thumbs.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "He cradles a half-bound volume with reverent hands.", "para": 1, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "MISS ADELAIDE FOX, 20s, his new apprentice, in a plain grey dress with the sleeves rolled back, stands rigid at the opposite end.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Her hair is pinned beneath a cap.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She has been up since four.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Miss Fox.", "name": "ASHCROFT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Yes, Mr. Ashcroft.", "name": "ADELAIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "You have been with me three weeks.", "name": "ASHCROFT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Yes, sir.", "name": "ADELAIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "In three weeks you have sewn twelve signatures, trimmed four boards, and burned the edge of a very costly sheepskin.", "name": "ASHCROFT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "I am sorry about the sheepskin.", "name": "ADELAIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "You should be.", "name": "ASHCROFT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He lays the volume on the bench.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Opens it.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Turns three pages.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Stops.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "This is yours.", "name": "ASHCROFT", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "My stitching?", "name": "ADELAIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Your stitching.", "name": "ASHCROFT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "She steps forward.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Her breath quickens.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "He taps the spine.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Uneven.", "name": "ASHCROFT", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "I know, sir.", "name": "ADELAIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Here. And here.", "name": "ASHCROFT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "I counted forty. I only had thirty-seven.", "name": "ADELAIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "You counted forty because you hurried.", "name": "ASHCROFT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Yes, sir.", "name": "ADELAIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Why?", "name": "ASHCROFT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Because I was afraid you'd send me away.", "name": "ADELAIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "He considers her.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Takes off his spectacles.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Folds them.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Slips them into his apron pocket.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Miss Fox, this volume is a Bible. It was commissioned by the Bishop of Winchester. It shall sit on an altar for two hundred years.", "name": "ASHCROFT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Then I must unpick it.", "name": "ADELAIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "You must unpick it.", "name": "ASHCROFT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Now?", "name": "ADELAIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Now.", "name": "ASHCROFT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "She takes a needle.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "A pair of fine shears.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "She bends over the volume.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "Her hands shake once and then do not.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Slower.", "name": "ASHCROFT", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Yes, sir.", "name": "ADELAIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Do not hurry what will outlive you.", "name": "ASHCROFT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "She snips a thread.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "Another.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "The room is silent save for the tick of a pocket-watch on the shelf.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "When you finish, you will sew it again.", "name": "ASHCROFT", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "Properly.", "name": "ADELAIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "Properly. And if it is not properly done you will unpick it again.", "name": "ASHCROFT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "How many times?", "name": "ADELAIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "As many as it takes.", "name": "ASHCROFT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "Adelaide looks up.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "For the first time, she sees something in his face she had not expected: a small, grim, unmistakable kindness.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "Thank you, sir.", "name": "ADELAIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "Do not thank me. Thread your needle.", "name": "ASHCROFT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}