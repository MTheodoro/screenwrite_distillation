{"scene_id": "s01309", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01309.fountain", "heading": "INT. PHONE REPAIR SHOP - NIGHT", "cast": [{"id": 0, "name": "NADINE PRICE", "names": ["NADINE PRICE", "NADINE"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "ELIJAH SOTO", "names": ["ELIJAH SOTO", "ELIJAH"], "gender": "?", "first": 5, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. PHONE REPAIR SHOP - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A narrow cramped counter lit by a flickering fluorescent.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Racks of cracked screens, cables hung like vines, a smell of solder and warm plastic.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain on the shutter.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "NADINE PRICE, 30s, in a hooded sweatshirt, hunches over a disassembled phone with a tiny screwdriver and a magnifying lamp.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across the counter, ELIJAH SOTO, 20s, the shop's owner, sits on a stool with a bag of chips.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "He scrolls on another phone, bored, feet up on a box.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Elijah, it's still ringing.", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "So pick it up.", "name": "ELIJAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "It has no battery. I took the battery out.", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Then it's not ringing.", "name": "ELIJAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "It's ringing.", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He lowers his phone.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "A tinny, impossible melody drifts from the gutted device.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "The lamp's bulb flickers.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Nadine lifts the case with two fingers.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Inside, where the board should be, is a hole.", "para": 2, "sent": 4, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "From the hole, the ringing grows louder, and a thin pale finger curls over the edge.", "para": 2, "sent": 5, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Elijah drops the chips.", "para": 2, "sent": 6, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Nadine hurls the phone across the shop.", "para": 2, "sent": 7, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "It SMASHES against the shutter.", "para": 2, "sent": 8, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "The ringing stops.", "para": 2, "sent": 9, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "The finger is gone.", "para": 2, "sent": 10, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "They stand frozen, staring at the broken pieces on the floor, the rain, the silence.", "para": 2, "sent": 11, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Do we answer it?", "name": "ELIJAH", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "It's off.", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Across the shop, from the pile of shattered plastic, a small LED blinks green.", "para": 3, "sent": 0, "present": [0, 1]}]}