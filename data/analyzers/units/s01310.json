{"scene_id": "s01310", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01310.fountain", "heading": "EXT. DRY RIVERBED - NOON", "cast": [{"id": 0, "name": "MARSHAL JEDEDIAH CROW", "names": ["MARSHAL JEDEDIAH CROW", "MARSHAL"], "gender": "?", "first": 5, "spoke": 3}, {"id": 1, "name": "DUTCH MALONE", "names": ["DUTCH MALONE", "DUTCH"], "gender": "m", "first": 8, "spoke": 3}, {"id": 2, "name": "LILA", "names": ["LILA"], "gender": "?", "first": 18, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DRY RIVERBED - NOON", "present": []}, {"u": 1, "kind": "action", "text": "Cracked mud.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single dead cottonwood.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Heat rises in sheets.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Two horses stand tied to a wagon wheel, flicking flies.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MARSHAL JEDEDIAH CROW, 50s, leathered, tin star dulled by dust, stands at the edge of the bank.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "He holds a Winchester loosely.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "He does not blink.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "Across forty feet of baked clay, DUTCH MALONE, 30s, in a black duster, crouches behind the wagon.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He holds a pistol in each hand.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Dutch.", "name": "MARSHAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Marshal.", "name": "DUTCH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Time to come out.", "name": "MARSHAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Time to come in, you mean.", "name": "DUTCH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "A long breath.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "The wind picks up.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "A tumbleweed rolls between them.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "A woman's voice from behind the cottonwood, off-screen.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Jed, don't.", "name": "LILA", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "He doesn't turn.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "His jaw tightens.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Lila, go home.", "name": "MARSHAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "He's my brother.", "name": "LILA", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Lila, stay out of this.", "name": "DUTCH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "I'm in it already.", "name": "LILA", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "The Marshal lowers the Winchester one inch.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Dutch rises, slow, arms wide.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "They stand in the sun, each waiting for the other.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Then both move.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "The Marshal swings the rifle up; Dutch drops to one knee and fires.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Two shots crack as one.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The horses bolt.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Dust blooms.", "para": 7, "sent": 4, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Dutch falls on his back.", "para": 7, "sent": 5, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "The Marshal staggers a step.", "para": 7, "sent": 6, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "He looks down at his vest, at the dark flower spreading there.", "para": 7, "sent": 7, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Then he sits, hard, against the bank.", "para": 7, "sent": 8, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Lila runs in.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "She falls to her knees between them, a hand on each man's chest.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Idiots.", "name": "LILA", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}]}