{"scene_id": "s01311", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01311.fountain", "heading": "INT. BOXING RING - CORNER - NIGHT", "cast": [{"id": 0, "name": "DOMMY", "names": ["DOMMY"], "gender": "?", "first": 4, "spoke": 15}, {"id": 1, "name": "ESPINOZA", "names": ["ESPINOZA"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "KWAME ASANTE", "names": ["KWAME ASANTE", "KWAME"], "gender": "?", "first": 8, "spoke": 12}], "units": [{"u": 0, "kind": "heading", "text": "INT. BOXING RING - CORNER - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Round nine bell.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Roaring crowd.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Under the hot lights the ring floor is slick with sweat.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "TRAINER DOMINIC \"DOMMY\" ESPINOZA, 60s, in a satin jacket with a towel around his neck, kneels at the stool.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "He sponges a fighter's face.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "In the opposite corner, a mirror image: another trainer, other fighter.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "They're not part of this scene.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "KWAME ASANTE, 30s, the fighter, in red trunks, sits on the stool.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "One eye swollen shut, mouthguard in his hand.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "He breathes like a bellows.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Listen to me.", "name": "DOMMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "I'm listening.", "name": "KWAME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "You're losing.", "name": "DOMMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I know.", "name": "KWAME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Three rounds to go. You are down by two on every card.", "name": "DOMMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "I know, Dommy.", "name": "KWAME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Give us room, please! Let him breathe!", "name": "DOMMY", "speaker": 0, "ext": [], "paren": ["to the crowd, over his shoulder"], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "They can't hear you.", "name": "KWAME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Of course they can't. Nobody listens to a cornerman.", "name": "DOMMY", "speaker": 0, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Dommy.", "name": "KWAME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "What?", "name": "DOMMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "I can't see out of the left.", "name": "KWAME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "That's fine. The left is lazy anyway.", "name": "DOMMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "You're not funny.", "name": "KWAME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "I'm trying to be.", "name": "DOMMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "He wipes blood from Kwame's brow.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Jams a cotton swab into the cut.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Kwame winces.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Here's what you do. He's dropping his right on the exit. Every time. You see it?", "name": "DOMMY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "I see it.", "name": "KWAME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "When he drops it, you go over the top. One shot.", "name": "DOMMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "One shot.", "name": "KWAME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "You've got one shot left in you, Kwame. Maybe two. I'll take the one.", "name": "DOMMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "What if I miss?", "name": "KWAME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Then we go home, and I buy you the biggest steak in the state.", "name": "DOMMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "And if I don't miss?", "name": "KWAME", "speaker": 2, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Then I buy you two.", "name": "DOMMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Kwame laughs.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Spits red into the bucket.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "This is my fighter!", "name": "DOMMY", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the whole arena, though no one hears"], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "The bell sounds.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Thanks, Dommy.", "name": "KWAME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Go.", "name": "DOMMY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Kwame stands.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Jams in the mouthguard.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Goes.", "para": 6, "sent": 2, "present": [0, 1, 2]}]}