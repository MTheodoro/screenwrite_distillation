{"scene_id": "s01312", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01312.fountain", "heading": "INT. SCHOOL BUS - NIGHT", "cast": [{"id": 0, "name": "YASMINE HADDAD", "names": ["YASMINE HADDAD", "YASMINE"], "gender": "?", "first": 5, "spoke": 12}, {"id": 1, "name": "MOM", "names": ["MOM"], "gender": "?", "first": 14, "spoke": 7}, {"id": 2, "name": "COACH TEO ABARA", "names": ["COACH TEO ABARA"], "gender": "m", "first": 25, "spoke": 0}, {"id": 3, "name": "COACH", "names": ["COACH"], "gender": "?", "first": 26, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. SCHOOL BUS - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Empty seats.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single dome light.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The bus idles at the curb of a dark football field.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain streaks the windows.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "YASMINE HADDAD, 17, graduation gown over a hoodie, sits alone in the back, knees up, a diploma cover clutched in both hands.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She isn't crying.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She just can't leave.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "At the front, the driver's seat is empty.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "A phone on the dashboard buzzes.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "She ignores it.", "para": 2, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "It buzzes again.", "para": 3, "sent": 0, "present": [0]}, {"u": 12, "kind": "action", "text": "She sighs, crawls up the aisle, and answers.", "para": 3, "sent": 1, "present": [0]}, {"u": 13, "kind": "dialogue", "text": "Hello?", "name": "YASMINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 14, "kind": "dialogue", "text": "Habibti, where are you? Everyone's at the restaurant.", "name": "MOM", "speaker": 1, "ext": ["V.O."], "paren": ["over the phone"], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I'm on the bus.", "name": "YASMINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "What bus?", "name": "MOM", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "The school bus. It's still here.", "name": "YASMINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Why?", "name": "MOM", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "I don't know. I didn't want to go home yet.", "name": "YASMINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Is something wrong?", "name": "MOM", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "No. Nothing.", "name": "YASMINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "She sets the phone against her cheek.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Footsteps outside.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "A shape under an umbrella.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "COACH TEO ABARA, 40s, the driver and gym teacher, climbs the steps, shakes out his umbrella, and freezes.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Yasmine?", "name": "COACH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Coach.", "name": "YASMINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "He sets down the umbrella.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Rubs his neck.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "I forgot my keys.", "name": "COACH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "They're on the dash.", "name": "YASMINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "He picks them up.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Doesn't leave.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Yasmine? Who is that?", "name": "MOM", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Coach Abara, Mama.", "name": "YASMINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Tell him thank you. Tell him he was very good to you.", "name": "MOM", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "She says thank you.", "name": "YASMINE", "speaker": 0, "ext": [], "paren": ["to him"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "She's welcome.", "name": "COACH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "He sits across the aisle.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "They listen to rain on the roof.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Come to the restaurant, habibti. We'll wait.", "name": "MOM", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Okay. Ten minutes.", "name": "YASMINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "She hangs up.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Puts the phone down.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Looks at the empty bus.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "It's smaller than I remembered.", "name": "YASMINE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Everything is.", "name": "COACH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "She almost smiles.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Stands.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Picks up her diploma cover.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Drive me?", "name": "YASMINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "He nods.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Takes the wheel.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "The bus rumbles to life and pulls away.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}]}