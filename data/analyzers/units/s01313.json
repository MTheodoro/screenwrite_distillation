{"scene_id": "s01313", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01313.fountain", "heading": "EXT. FROZEN MOUNTAIN LAKE - DAY", "cast": [{"id": 0, "name": "CAPTAIN ROSALIE KERR", "names": ["CAPTAIN ROSALIE KERR", "KERR"], "gender": "f", "first": 5, "spoke": 1}, {"id": 1, "name": "JIN-HO PARK", "names": ["JIN-HO PARK", "PARK"], "gender": "f", "first": 8, "spoke": 3}, {"id": 2, "name": "BEATRIZ SOLANO", "names": ["BEATRIZ SOLANO", "BEATRIZ"], "gender": "?", "first": 10, "spoke": 4}, {"id": 3, "name": "THADDEUS OKAFOR", "names": ["THADDEUS OKAFOR", "OKAFOR"], "gender": "m", "first": 12, "spoke": 2}, {"id": 4, "name": "LENNOX BELL", "names": ["LENNOX BELL", "LENNOX"], "gender": "m", "first": 13, "spoke": 2}, {"id": 5, "name": "PILAR MENDOZA-RUIZ", "names": ["PILAR MENDOZA-RUIZ", "PILAR"], "gender": "f", "first": 14, "spoke": 3}, {"id": 6, "name": "THRUM", "names": ["THRUM"], "gender": "?", "first": 31, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FROZEN MOUNTAIN LAKE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A vast white bowl ringed by black pines.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A bush plane lies on its belly in the middle of the ice, tail snapped, one wing crumpled.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Smoke curls from the engine.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Six survivors huddle around the wreck, their breath a ragged mist.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "CAPTAIN ROSALIE KERR, 50s, the pilot, in a bomber jacket gone to rags, sits against the fuselage.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A bloody bandage on her forearm.", "para": 2, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Her face is grey.", "para": 2, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "DR. JIN-HO PARK, 40s, in a stained parka, kneels beside her, checking her pulse.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "His fingers are blue.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "BEATRIZ SOLANO, 30s, in a fleece, strides the perimeter with a flare gun.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "She scans the sky.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "MR. THADDEUS OKAFOR, 60s, a retired judge in a three-piece suit and galoshes, stands rigid with his briefcase on his chest.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "LENNOX BELL, 20s, a bicycle courier, perches on the broken wing, headphones around his neck.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "PILAR MENDOZA-RUIZ, 30s, a student, crouches by the engine, feeding sticks into a sputtering fire.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "She's bleeding too much.", "name": "PARK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Then stop it.", "name": "BEATRIZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "I'm trying.", "name": "PARK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Gentlemen, ladies. Order, please.", "name": "OKAFOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Dude, there's no order. We're on a lake.", "name": "LENNOX", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Fire's dying.", "name": "PILAR", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Feed it.", "name": "BEATRIZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "With what?", "name": "PILAR", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Everything.", "name": "BEATRIZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Okafor sets down the briefcase.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Opens it.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Hundreds of pages of legal briefs.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "He tears them out in fistfuls, tosses them into the flames.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "They flare gold.", "para": 8, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Thirty years of my life.", "name": "OKAFOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Right on.", "name": "LENNOX", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "A distant THRUM.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "action", "text": "Everyone freezes.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "The sound grows.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "Beatriz raises the flare gun.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "Quiet.", "name": "BEATRIZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "She fires.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "A red star climbs into the sky, hangs, drifts.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "The THRUM stops.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "Then it starts again, closer.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "Louder.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "dialogue", "text": "They saw it.", "name": "PILAR", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "dialogue", "text": "Don't say that yet.", "name": "PARK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "A helicopter bursts over the treeline, blades flogging the pines.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "Lennox leaps from the wing, waving both arms.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "action", "text": "Okafor takes off his hat.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "action", "text": "Rosalie lifts her head and smiles.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "dialogue", "text": "About time.", "name": "KERR", "speaker": 0, "ext": [], "paren": ["barely"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "Beatriz drops the flare gun.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "action", "text": "Pilar sobs into her scarf.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "action", "text": "Park lets out a breath he has held since the crash and slumps against the fuselage.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}]}