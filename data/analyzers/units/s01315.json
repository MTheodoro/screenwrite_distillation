{"scene_id": "s01315", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01315.fountain", "heading": "INT. VENETIAN MASQUERADE BALL - GRAND SALON - NIGHT", "cast": [{"id": 0, "name": "CONTESSA ISABELLA ROSSELLINI", "names": ["CONTESSA ISABELLA ROSSELLINI", "ISABELLA"], "gender": "f", "first": 6, "spoke": 11}, {"id": 1, "name": "GIOVANNI CASSINI", "names": ["GIOVANNI CASSINI", "GIOVANNI"], "gender": "f", "first": 8, "spoke": 10}, {"id": 2, "name": "COUNT ALVISE ROSSELLINI", "names": ["COUNT ALVISE ROSSELLINI", "ALVISE"], "gender": "?", "first": 6, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. VENETIAN MASQUERADE BALL - GRAND SALON - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "1790s.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Chandeliers hang like frozen waterfalls.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Marble floors mirror the candlelight.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Gilded masks drift in the crowd, each hiding a face.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A string quartet plays a dance no one is dancing.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "CONTESSA ISABELLA ROSSELLINI, 40s, in a silver gown and a black velvet half-mask, stands against a pillar, a glass of wine untouched in her hand.", "para": 1, "sent": 0, "present": [0, 2]}, {"u": 7, "kind": "action", "text": "Her eyes follow every mask in the room.", "para": 1, "sent": 1, "present": [0, 2]}, {"u": 8, "kind": "action", "text": "GIOVANNI CASSINI, 30s, a young poet in a plum coat and a gold mask shaped like a sun, lingers at her elbow.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "He has the air of a man who has rehearsed a speech and forgotten it.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Contessa.", "name": "GIOVANNI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Signor Cassini.", "name": "ISABELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "I did not think you would come.", "name": "GIOVANNI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Nor did I.", "name": "ISABELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "And yet.", "name": "GIOVANNI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "And yet.", "name": "ISABELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "She turns her glass slowly in her hand.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "A servant passes with a tray.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Neither takes a thing.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Your husband is abroad?", "name": "GIOVANNI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "My husband is always abroad.", "name": "ISABELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "How fortunate.", "name": "GIOVANNI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Is it?", "name": "ISABELLA", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "She looks at him then, properly, for the first time.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "His fingers close and open at his side.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "I have written something.", "name": "GIOVANNI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "You are always writing something.", "name": "ISABELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "This is different.", "name": "GIOVANNI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "They are all different.", "name": "ISABELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "This one is about a woman at a ball who does not dance.", "name": "GIOVANNI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "How does it end?", "name": "ISABELLA", "speaker": 0, "ext": [], "paren": ["very quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "I have not decided.", "name": "GIOVANNI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The quartet strikes a new measure.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Across the room, a tall man in a raven mask parts the crowd with the ease of a prow.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "He moves toward them in a straight line.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Isabella's glass stops turning.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "COUNT ALVISE ROSSELLINI, 50s, in the raven mask and a coat of midnight blue, arrives before them and bows.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Beneath the beak, his mouth is a thin smile.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "My dear. I came home early.", "name": "ALVISE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "So I see.", "name": "ISABELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "And who is your friend?", "name": "ALVISE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Giovanni Cassini, Excellency. A humble poet.", "name": "GIOVANNI", "speaker": 1, "ext": [], "paren": ["bowing"], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Poets are never humble. That is why they are poets.", "name": "ALVISE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "He takes the glass from Isabella's hand.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Drinks it.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Returns it.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "I trust you were enjoying yourselves.", "name": "ALVISE", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "We were talking.", "name": "ISABELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "How charming.", "name": "ALVISE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "He turns to the room.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Raises his voice, light and carrying.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Ladies and gentlemen. A toast!", "name": "ALVISE", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "The quartet falters.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "The crowd turns.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Isabella sets her jaw.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Giovanni's mask suddenly looks absurd.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "To fidelity.", "name": "ALVISE", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Glasses rise.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Murmurs of agreement.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Isabella lifts hers last.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "To the masks.", "name": "ISABELLA", "speaker": 0, "ext": [], "paren": ["under her breath"], "dual": false, "present": [0, 1, 2]}]}