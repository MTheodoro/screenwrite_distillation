{"scene_id": "s01316", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01316.fountain", "heading": "INT. HALL OF THE MOSS KING - TWILIGHT", "cast": [{"id": 0, "name": "QUEEN ESMERELDA THORNE", "names": ["QUEEN ESMERELDA THORNE", "ESMERELDA"], "gender": "?", "first": 5, "spoke": 6}, {"id": 1, "name": "SIR BRAMBLE OAKENSHAW", "names": ["SIR BRAMBLE OAKENSHAW", "BRAMBLE"], "gender": "m", "first": 8, "spoke": 3}, {"id": 2, "name": "LADY FERNWEN MIST", "names": ["LADY FERNWEN MIST", "FERNWEN"], "gender": "?", "first": 10, "spoke": 2}, {"id": 3, "name": "PIPKIN BRIAR", "names": ["PIPKIN BRIAR", "PIPKIN"], "gender": "m", "first": 12, "spoke": 3}, {"id": 4, "name": "OLD HOLLOW", "names": ["OLD HOLLOW", "HOLLOW"], "gender": "m", "first": 13, "spoke": 4}, {"id": 5, "name": "BARNABUS ROOT", "names": ["BARNABUS ROOT", "BARNABUS"], "gender": "?", "first": 15, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. HALL OF THE MOSS KING - TWILIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cathedral of living wood.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Roots form vaulted arches.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Moss hangs in green curtains from the ceiling, and fireflies drift like drowsy stars.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A long table of polished heartwood runs down the middle, laid with acorn cups and dew.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "QUEEN ESMERELDA THORNE, 60s, in a gown of woven willow, sits at the head of the table.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A crown of antlers rests on her silver hair.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She is smiling and her smile does not reach her eyes.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "SIR BRAMBLE OAKENSHAW, 50s, a knight in bark armour, stands at her right hand, helmet beneath his arm.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Broad, scarred, quiet.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "LADY FERNWEN MIST, 30s, in a gown of spider-silk, stirs a thimble of honey wine with a single finger.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "She hums an old tune.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "PIPKIN BRIAR, 10, a page with leaves in his hair, sits cross-legged beneath the table, listening.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "OLD HOLLOW, 90s, the court's seer, in a hooded robe the colour of ash, leans on a staff of white birch.", "para": 5, "sent": 0, "present": [0, 1, 2, 4]}, {"u": 14, "kind": "action", "text": "His eyes are milk.", "para": 5, "sent": 1, "present": [0, 1, 2, 4]}, {"u": 15, "kind": "action", "text": "BARNABUS ROOT, 40s, a squat trader in a patchwork coat, perches at the far end, counting beetles in a purse.", "para": 6, "sent": 0, "present": [0, 1, 2, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Friends. We are gathered in peace.", "name": "ESMERELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "In peace, Majesty.", "name": "BRAMBLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "In peace, indeed.", "name": "FERNWEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "In peace and profit.", "name": "BARNABUS", "speaker": 5, "ext": [], "paren": ["still counting"], "dual": false, "present": [0, 1, 2, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "In peace and cake.", "name": "PIPKIN", "speaker": 3, "ext": [], "paren": ["from under the table"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Pipkin.", "name": "ESMERELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Sorry.", "name": "PIPKIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Majesty. There is something under the table.", "name": "HOLLOW", "speaker": 4, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Pipkin is under the table.", "name": "ESMERELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Not Pipkin.", "name": "HOLLOW", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "A thin silence.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "The fireflies dim.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "The roots overhead creak.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Majesty?", "name": "BRAMBLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Bramble, don't.", "name": "FERNWEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "What is it?", "name": "BARNABUS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Bramble drops his helmet.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Draws a sword of black glass.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "The queen does not stand.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Her smile hardens.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Sit, Sir Bramble.", "name": "ESMERELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Majesty, there is a root moving.", "name": "BRAMBLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Roots move. It is their nature.", "name": "ESMERELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Under the table something giggles.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "It is not Pipkin.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Pipkin scrambles out, eyes huge, and clings to Fernwen's skirt.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "It's got my ankle!", "name": "PIPKIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Out of the dark beneath the heartwood a long green hand rises and takes hold of the queen's goblet.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "The queen's face goes white.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "The hand lifts the cup.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "And from deep within the table, a voice like wind in the stems says:", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "The table itself, in a voice like wind in the stems, says:", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "I thank you for the wine.", "name": "HOLLOW", "speaker": 4, "ext": [], "paren": ["in the King's voice"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "Every guest rises at once, chairs falling, shouting over one another.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "Bramble's blade flashes.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Barnabus shrieks.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "Hollow thumps his staff and the chamber goes still.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "The old seer's eyes are green.", "para": 12, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "Hollow. How long?", "name": "ESMERELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "Majesty. He has been the table all along.", "name": "HOLLOW", "speaker": 4, "ext": [], "paren": ["his own voice, thin"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}