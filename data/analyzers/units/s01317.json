{"scene_id": "s01317", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01317.fountain", "heading": "INT. DEEP-SPACE SURVEY SHIP - BRIDGE - SHIP NIGHT", "cast": [{"id": 0, "name": "CAPTAIN MARGUERITE ADEOLA", "names": ["CAPTAIN MARGUERITE ADEOLA", "ADEOLA"], "gender": "f", "first": 4, "spoke": 4}, {"id": 1, "name": "COMMANDER SOREN VASQUEZ", "names": ["COMMANDER SOREN VASQUEZ", "VASQUEZ"], "gender": "?", "first": 6, "spoke": 2}, {"id": 2, "name": "LILIANA PETROV", "names": ["LILIANA PETROV", "PETROV"], "gender": "f", "first": 7, "spoke": 1}, {"id": 3, "name": "ENSIGN BASHIR KOROMA", "names": ["ENSIGN BASHIR KOROMA"], "gender": "m", "first": 9, "spoke": 0}, {"id": 4, "name": "TECHNICIAN ODALYS GRAU", "names": ["TECHNICIAN ODALYS GRAU", "GRAU"], "gender": "f", "first": 11, "spoke": 2}, {"id": 5, "name": "CHIEF IVO TEMBO", "names": ["CHIEF IVO TEMBO", "TEMBO"], "gender": "?", "first": 12, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. DEEP-SPACE SURVEY SHIP - BRIDGE - SHIP NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped circular chamber ringed by consoles.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A long viewport shows a field of unfamiliar stars.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Red alert lights wash the faces of six sleepless people.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CAPTAIN MARGUERITE ADEOLA, 50s, stands at the centre console, a coffee gone cold in her hand.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She keeps her eyes on the screen.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "COMMANDER SOREN VASQUEZ, 40s, at navigation, hunches over a plot, fingers drumming.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "DR. LILIANA PETROV, 30s, the ship's medic, at the aft hatch, a first-aid kit at her hip.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "She has not slept in two days.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "ENSIGN BASHIR KOROMA, 20s, at comms, fidgets with a headset.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "He is very pale.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "TECHNICIAN ODALYS GRAU, 30s, at engineering, wipes grease from her hands with a rag and says nothing.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "CHIEF IVO TEMBO, 60s, in the corner, arms crossed, scowls at everyone and everything.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "A bang from below.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "The deck shudders.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "She grips the rail.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "He staggers.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "They all look up.", "para": 7, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Report!", "name": "ADEOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Hull breach on deck four.", "name": "VASQUEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Is anyone down there?", "name": "PETROV", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Not anymore.", "name": "TEMBO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Petrov crosses herself.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Koroma stifles a whimper.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Reactor holding at sixty percent.", "name": "GRAU", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Can we make the jump?", "name": "ADEOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "In nine minutes. If nobody breathes on it.", "name": "GRAU", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Everyone, hold your breath.", "name": "ADEOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "A laugh, thin and nervous.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Koroma wipes his eyes.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "The deck shudders again, but gently this time, as if the ship were exhaling.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Captain. Coordinates locked.", "name": "VASQUEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Execute.", "name": "ADEOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "The stars in the viewport smear to white lines.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "The red alert dims to amber.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "She sets the coffee on the rail and rests her forehead against the cold glass.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}