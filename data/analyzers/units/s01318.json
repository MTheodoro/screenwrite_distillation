{"scene_id": "s01318", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01318.fountain", "heading": "INT. FARMHOUSE KITCHEN - MORNING", "cast": [{"id": 0, "name": "GRANDMA PEARL HOLLOWAY", "names": ["GRANDMA PEARL HOLLOWAY", "PEARL"], "gender": "?", "first": 5, "spoke": 3}, {"id": 1, "name": "WALT", "names": ["WALT"], "gender": "?", "first": 6, "spoke": 3}, {"id": 2, "name": "LORNA", "names": ["LORNA"], "gender": "f", "first": 7, "spoke": 2}, {"id": 3, "name": "DANNY", "names": ["DANNY"], "gender": "?", "first": 8, "spoke": 3}, {"id": 4, "name": "ROSIE", "names": ["ROSIE"], "gender": "f", "first": 9, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. FARMHOUSE KITCHEN - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "A cluttered, sunlit room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Pancakes on a griddle.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Crayons and bills on the table.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A dog's water bowl by the door.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "GRANDMA PEARL HOLLOWAY, 70s, in a floral apron, flips pancakes with the economy of long practice.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her husband WALT, 70s, in suspenders, reads the paper at the head of the table and does not look up.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Their daughter LORNA, 40s, in scrubs, pours coffee into a travel mug while she packs a lunch.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Her son DANNY, 12, shovels cereal.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "His younger sister ROSIE, 7, draws a horse on the back of a utility bill, tongue out.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Danny, chew.", "name": "PEARL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "I am chewing.", "name": "DANNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Danny, chew with your mouth closed.", "name": "LORNA", "speaker": 2, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "I am!", "name": "DANNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Rosie holds up her drawing.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Danny snatches it.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Lorna lunges across the table to catch the cereal bowl before it tips, and Walt, without lowering the paper, hooks the sugar bowl out of range with one finger.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Pearl slides a pancake onto Rosie's plate, flips another onto Danny's, and kisses Lorna's cheek on the way past.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "The dog barks once at the window.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Nobody looks.", "para": 3, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "It's a horse.", "name": "ROSIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "It's a potato with legs.", "name": "DANNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "It's a very good potato.", "name": "WALT", "speaker": 1, "ext": [], "paren": ["from behind the paper"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Grandpa!", "name": "ROSIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Walter, put the paper down.", "name": "PEARL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "In a minute.", "name": "WALT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Walter.", "name": "PEARL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "He folds the paper.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Looks at them over his glasses.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "They all stare.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "What?", "name": "WALT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Nothing, Dad.", "name": "LORNA", "speaker": 2, "ext": [], "paren": ["laughing"], "dual": false, "present": [0, 1, 2, 3, 4]}]}