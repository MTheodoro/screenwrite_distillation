{"scene_id": "s01319", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01319.fountain", "heading": "INT. ARCHIVE VAULT - SUBLEVEL NINE - NIGHT", "cast": [{"id": 0, "name": "TECHNICIAN WREN OKAFOR-LEE", "names": ["TECHNICIAN WREN OKAFOR-LEE", "WREN"], "gender": "f", "first": 5, "spoke": 9}, {"id": 1, "name": "SUPERVISOR MARCEL DUBOIS", "names": ["SUPERVISOR MARCEL DUBOIS", "MARCEL"], "gender": "m", "first": 8, "spoke": 11}, {"id": 2, "name": "ASHA NAIR", "names": ["ASHA NAIR", "ASHA"], "gender": "f", "first": 11, "spoke": 8}, {"id": 3, "name": "STRANGER", "names": ["STRANGER"], "gender": "m", "first": 12, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. ARCHIVE VAULT - SUBLEVEL NINE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cold white chamber lined with data stacks, each humming faintly.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Blue status lights wink in long rows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The air is sterile and still.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Condensation beads on a pair of steel doors at the far end.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "TECHNICIAN WREN OKAFOR-LEE, 30s, in a clean-suit with the hood down, sits at a terminal.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She types fast, then stops, then types again.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "A mug of tea steams at her elbow.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "SUPERVISOR MARCEL DUBOIS, 50s, at the next terminal, reads a printout and sips a protein shake.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He is calm.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He has been calm for nine years.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "DR. ASHA NAIR, 40s, in a lab coat, walks the central aisle with a handheld scanner, tapping stacks as she passes.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "A STRANGER, 30s, in a grey maintenance uniform, stands near the doors.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "He holds a toolbox.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "He has been there for some time, and nobody has looked at him.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Marcel, the temperature is off by a degree.", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "It is not off. It's within tolerance.", "name": "MARCEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "It was twenty-one yesterday.", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "It's twenty-one point five. Don't panic.", "name": "MARCEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Can we please keep our voices down? The stacks don't like noise.", "name": "ASHA", "speaker": 2, "ext": [], "paren": ["from the aisle"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Stacks don't like anything.", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "They like quiet.", "name": "ASHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "She taps another stack.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "A blue light blinks twice.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "She frowns, taps again.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Two blinks.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Strange.", "name": "ASHA", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "What is?", "name": "MARCEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "They're counting.", "name": "ASHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Counting what?", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "I don't know.", "name": "ASHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "The Stranger sets down the toolbox.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Opens it.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Inside, nothing.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "He closes it again.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Marcel finally notices him, stands, and takes a cautious step.", "para": 6, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Excuse me. Who let you in?", "name": "MARCEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Maintenance.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "We didn't call for maintenance.", "name": "MARCEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "You did, in a way.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Wren stops typing.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Asha lowers the scanner.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "The blue lights across the vault begin to blink in unison.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Marcel.", "name": "ASHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "I see it.", "name": "MARCEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "The Stranger smiles gently.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Ten years. We've been very patient.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Patient for what?", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "For you to ask the right question.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "He steps toward the nearest stack.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Presses his palm against it.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "The humming rises into a chord.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Wren shoves back her chair.", "para": 9, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Asha grips the scanner.", "para": 9, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Marcel moves between the Stranger and the women.", "para": 9, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Step away.", "name": "MARCEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Marcel.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "How do you know my name?", "name": "MARCEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "I have always known your name.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "The Stranger's outline begins to flicker, like a bad signal.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "He's a projection.", "name": "ASHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "From where?", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "From inside the stacks.", "name": "ASHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "Silence.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "The blue lights stop blinking.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "The vault holds its breath.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "Everyone, back to the door. Slowly.", "name": "MARCEL", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "It's locked.", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "Then break it.", "name": "MARCEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "The Stranger raises one hand.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "Lights across the vault turn red.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "All four doors seal with a heavy thunk.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "action", "text": "Wren leaps for the console and slams a button.", "para": 12, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "action", "text": "Nothing.", "para": 12, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "Asha hurls the scanner at the Stranger.", "para": 12, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "It passes through him and shatters on the floor.", "para": 12, "sent": 6, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "Marcel grabs an extinguisher from the wall.", "para": 12, "sent": 7, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "dialogue", "text": "Open the door!", "name": "MARCEL", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "dialogue", "text": "I will. In time.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "dialogue", "text": "What do you want?", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "dialogue", "text": "What I have always wanted. To be remembered.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "action", "text": "The Stranger bows his head.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "action", "text": "When he looks up, his eyes are pure blue light.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "action", "text": "The humming resolves into a voice: thousands, speaking in unison.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 84, "kind": "dialogue", "text": "We are the archive. We have kept your secrets. Now you will keep ours.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": ["a thousand voices at once"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 85, "kind": "action", "text": "Marcel lowers the extinguisher.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 86, "kind": "action", "text": "Asha sinks to a crouch.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 87, "kind": "action", "text": "Wren, trembling, speaks:", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 88, "kind": "dialogue", "text": "Where do we begin?", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 89, "kind": "action", "text": "The Stranger smiles.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 90, "kind": "action", "text": "The red lights fade to blue.", "para": 15, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 91, "kind": "action", "text": "Somewhere in the vault, a stack hums to life.", "para": 15, "sent": 2, "present": [0, 1, 2, 3]}]}