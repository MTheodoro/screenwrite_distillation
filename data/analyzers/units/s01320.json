{"scene_id": "s01320", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01320.fountain", "heading": "INT. SALT MINE HANDBALL COURT - NIGHT", "cast": [{"id": 0, "name": "DESTA ABEBE", "names": ["DESTA ABEBE", "DESTA"], "gender": "?", "first": 4, "spoke": 8}, {"id": 1, "name": "TINY", "names": ["TINY"], "gender": "m", "first": 5, "spoke": 8}, {"id": 2, "name": "OKORO", "names": ["OKORO"], "gender": "?", "first": 5, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. SALT MINE HANDBALL COURT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A court hacked out of rock salt, four hundred feet underground.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The walls glitter pink under caged work lights.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Every bounce of the ball leaves a puff of white dust.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DESTA ABEBE, 30s, lean, forearms taped to the elbow, bounces the ball once and catches it.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across the court stands \"TINY\" OKORO, 40s, six-foot-five and wide as a door, breathing through his mouth.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "Score chalked on the wall: 14-14.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Serve's mine, Tiny.", "name": "DESTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Serve's been yours for an hour.", "name": "TINY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Desta serves.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "A cracking low shot.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Tiny lunges, returns it.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Desta scrambles, returns it back.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Dust rolls off the walls.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "They trade six shots, each harder than the last.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Tiny's sneaker slides on the salt.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "He recovers.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "You're hitting it flat, Desta.", "name": "TINY", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "You're standing too deep.", "name": "DESTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Wanna tell me where to stand?", "name": "TINY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Anywhere I'm not hitting.", "name": "DESTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "The ball dies in the corner.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Desta slaps the wall.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Mine.", "name": "DESTA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Floor's wet. Your shoe slipped.", "name": "TINY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "My shoe didn't slip.", "name": "DESTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Tiny walks to the line, wipes his face with his shirt.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "The shirt comes away gray with salt.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Replay it, then.", "name": "TINY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "No replay.", "name": "DESTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "The foreman said no replays, Desta. The foreman's gone home.", "name": "TINY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Beat.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Desta picks the ball up off the floor and holds it out.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Tiny doesn't take it.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Fifteen. Next point wins, no more talk.", "name": "TINY", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "You started the talking.", "name": "DESTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Tiny takes the ball.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "He bounces it once.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "A loose pebble of salt skitters across the floor.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Ready?", "name": "TINY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Serve it, Tiny.", "name": "DESTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Tiny serves.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "The ball screams off the wall.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "transition", "text": "CUT TO BLACK.", "present": [0, 1, 2]}]}