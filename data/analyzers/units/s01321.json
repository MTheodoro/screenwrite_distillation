{"scene_id": "s01321", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01321.fountain", "heading": "INT. CAROUSEL WORKSHOP - DAY", "cast": [{"id": 0, "name": "LOU PELLEGRINO", "names": ["LOU PELLEGRINO", "LOU"], "gender": "?", "first": 3, "spoke": 4}, {"id": 1, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 4, "spoke": 4}, {"id": 2, "name": "HOLLIS", "names": ["HOLLIS"], "gender": "m", "first": 14, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. CAROUSEL WORKSHOP - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A barn of painted horses without riders.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dusty sunlight slants through high windows onto hooves, manes and half-stripped brass poles.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "LOU PELLEGRINO, 60s, apron over a wool vest, sands the flank of a wooden palomino.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "A STRANGER, 40s, trim gray overcoat, fedora in hand, waits at the door and does not come in.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "Mr. Pellegrino?", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Depends who's asking.", "name": "LOU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "A man who admires your horses.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Then he can buy one. Twelve dollars, the small ones.", "name": "LOU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "The Stranger crosses to a bench and picks up a carved ear, turns it over.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I was told you carve other things too. Things that hold paper.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Lou keeps sanding.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "A long, even stroke.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Who told you?", "name": "LOU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Hollis. Walter Hollis. That's my name, since you'll want it.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Well, Mr. Hollis. Sit down. The horse isn't going anywhere.", "name": "LOU", "speaker": 0, "ext": [], "paren": ["setting down the sandpaper"], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "HOLLIS lowers himself onto a stool beside the palomino.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Nobody's hurrying.", "name": "HOLLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}