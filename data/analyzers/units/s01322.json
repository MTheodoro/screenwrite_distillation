{"scene_id": "s01322", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01322.fountain", "heading": "INT. PARKING GARAGE, LEVEL 3 - EARLY MORNING", "cast": [{"id": 0, "name": "IRINA VASK", "names": ["IRINA VASK", "IRINA"], "gender": "f", "first": 5, "spoke": 3}, {"id": 1, "name": "COACH BOONE", "names": ["COACH BOONE", "BOONE"], "gender": "m", "first": 6, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. PARKING GARAGE, LEVEL 3 - EARLY MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Concrete.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Oil stains.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Orange cones set in a tight oval.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A roller derby track, taped on the floor.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "IRINA VASK, 20s, helmet under one arm, laces her skates on the hood of a dead Buick.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "COACH BOONE, 50s, whistle, bad knee, leans on a pillar with a clipboard and a paper cup of coffee.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Boone clicks his pen.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Irina stands, rolls a slow lap past him, scuffs a wheel on a crack in the slab, curses under her breath, circles back, and Boone sips the coffee, checks the clipboard, and nods at nothing as she drifts to a stop at the cones.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "You're early, Coach.", "name": "IRINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "You're earlier, Irina.", "name": "BOONE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Couldn't sleep.", "name": "IRINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Nobody sleeps before a bout.", "name": "BOONE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She pulls on the helmet.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He watches the ceiling.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "A pigeon shifts on a pipe.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Somewhere below, a car door slams, an engine starts, and Boone and Irina both pretend not to hear it echo before she kicks off the pillar and takes a second lap, easy, unhurried, while he flips a page.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Count my laps, Coach.", "name": "IRINA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Already counting, kid.", "name": "BOONE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}