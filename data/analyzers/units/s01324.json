{"scene_id": "s01324", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01324.fountain", "heading": "EXT. RIVER FERRY - MIDDAY", "cast": [{"id": 0, "name": "AMOS QUILL", "names": ["AMOS QUILL", "AMOS"], "gender": "?", "first": 5, "spoke": 8}, {"id": 1, "name": "DEL", "names": ["DEL"], "gender": "?", "first": 9, "spoke": 7}, {"id": 2, "name": "RAYE", "names": ["RAYE"], "gender": "?", "first": 9, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. RIVER FERRY - MIDDAY", "present": []}, {"u": 1, "kind": "action", "text": "A flat timber barge on a rope line, crossing slow brown water.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cottonwoods on both banks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "One mule, asleep on its feet.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Heat shimmer on the planks.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "AMOS QUILL, 50s, scarecrow-thin, sleeves rolled, hauls the guide rope hand over hand.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Gray stubble.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "A stove-in hat.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "A dead cigar he never lights.", "para": 1, "sent": 3, "present": [0]}, {"u": 9, "kind": "action", "text": "DELPHINE \"DEL\" RAYE, 30s, rides the rail with a saddlebag across her knees.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Red bandana.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Boots too fine for the river.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "A rifle wrapped in canvas by her hip.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Fare's a nickel.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Posted says two cents.", "name": "DEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Posted's old.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "She flips a nickel.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "He catches it without looking, drops it in his vest, keeps pulling.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Many cross today?", "name": "DEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Some.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Any stop and ask for a man?", "name": "DEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Some.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "The barge drifts a foot downstream.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "The rope groans.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Amos sets his feet, hauls, and Del gets up, takes the rope behind him, and the two of them pull together, hand over hand, until the barge steadies and the mule opens one eye and shuts it.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "That's a wide river.", "name": "DEL", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Gets wider after a rain.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Ever sunk one?", "name": "DEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Once.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Something thumps against the hull under the planks.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "A log, probably.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Amos and Del freeze, he with the rope in both fists, she with a hand on the canvas.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The thump rolls past.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "The barge lurches, and both lean the other way, stagger, catch the rail, and laugh without sound.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Log.", "name": "DEL", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Log.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "She hands the rope back.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "He takes it.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Bank shadows creep up the planks.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "I'll pay another nickel to get across faster.", "name": "DEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "River don't take bribes.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}