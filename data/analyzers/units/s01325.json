{"scene_id": "s01325", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01325.fountain", "heading": "INT. WRESTLING WEIGH-IN SAUNA - PRE-DAWN", "cast": [{"id": 0, "name": "KWAME ASANTE", "names": ["KWAME ASANTE", "KWAME"], "gender": "m", "first": 4, "spoke": 15}, {"id": 1, "name": "SOLVEIG HAUG", "names": ["SOLVEIG HAUG", "SOLVEIG"], "gender": "m", "first": 5, "spoke": 15}], "units": [{"u": 0, "kind": "heading", "text": "INT. WRESTLING WEIGH-IN SAUNA - PRE-DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Cedar benches.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single bulb.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Steam hangs thick enough to hold a handprint.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "KWAME ASANTE, 20s, towel over his head, sits hunched, elbows on knees.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "SOLVEIG HAUG, 40s, his cornerman, perches across from him with a digital scale in her lap.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Neither looks up.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "What's it say?", "name": "KWAME", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Hundred and fifty-four point eight.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Limit's one-fifty-four.", "name": "KWAME", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I can read, Kwame.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Then it's four-tenths of a pound.", "name": "KWAME", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "It's four-tenths of a pound.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Your mother's in the stands today.", "name": "KWAME", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Don't.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I'm only saying.", "name": "KWAME", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Sweat.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Four more minutes?", "name": "KWAME", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Six.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "You said four.", "name": "KWAME", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "I say what the scale says.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Last time, you said the scale lied.", "name": "KWAME", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Last time, you ate a banana.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "It was a small banana.", "name": "KWAME", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "It was a banana, Kwame.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Everybody's gonna look at me when I step up. All of them.", "name": "KWAME", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "They look at everybody.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "You're not scared?", "name": "KWAME", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "I'm warm.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "That's not an answer.", "name": "KWAME", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "It's the only one I've got at five a.m.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Give me the scale.", "name": "KWAME", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Not yet.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Solveig.", "name": "KWAME", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Four minutes. Then I give it to you.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "You said six.", "name": "KWAME", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Then six.", "name": "SOLVEIG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "He pulls the towel lower.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "She sets the scale on the bench between them and wipes her palm on her knee.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Steam rolls over them both.", "para": 2, "sent": 2, "present": [0, 1]}]}