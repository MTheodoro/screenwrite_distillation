{"scene_id": "s01328", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01328.fountain", "heading": "INT. VELODROME INFIELD - EVENING", "cast": [{"id": 0, "name": "MO", "names": ["MO"], "gender": "?", "first": 4, "spoke": 9}, {"id": 1, "name": "DALY", "names": ["DALY"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "TAMSIN ROYCE", "names": ["TAMSIN ROYCE", "TAMSIN"], "gender": "f", "first": 5, "spoke": 3}, {"id": 3, "name": "YUKI MORIMOTO", "names": ["YUKI MORIMOTO", "YUKI"], "gender": "f", "first": 6, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. VELODROME INFIELD - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "The wooden bowl rises steeply on every side.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A string of fluorescent tubes buzzes overhead.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "In the infield, three women huddle by a rack of carbon bikes.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MAUREEN \"MO\" DALY, 50s, stopwatch lanyard, windbreaker faded to pink, stands with a whistle between her teeth.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "TAMSIN ROYCE, 20s, long braid, helmet buckled tight, grips a bike by the saddle.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "YUKI MORIMOTO, 20s, shorter, quicker, shakes out her legs one at a time.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Listen up. Relay swap is at the red line. Not before it, not after. At the line.", "name": "MO", "speaker": 0, "ext": [], "paren": ["to everyone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Tamsin nods.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Yuki doesn't.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "You hear me, Morimoto?", "name": "MO", "speaker": 0, "ext": ["CONT'D"], "paren": ["to Yuki"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I hear you.", "name": "YUKI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Then say it.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Red line.", "name": "YUKI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Mo pulls the whistle out.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "She turns to the stopwatch and mutters at it.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Please, please just once, don't lie to me.", "name": "MO", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "The whistle blows.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Tamsin swings a leg over and pushes off, wheels humming on the boards.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Yuki clips in and rolls to the start of the swap zone.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Ready!", "name": "TAMSIN", "speaker": 2, "ext": [], "paren": ["shouting as she passes"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Go!", "name": "YUKI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Tamsin sprints a full lap, the bowl a blur behind her.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Yuki pedals up the banking, eyes on her partner's back wheel.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Mo clicks the watch, murmuring.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Come on, come on.", "name": "MO", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "The swap.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Tamsin's hand lands on Yuki's hip and shoves.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Yuki surges.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "For three pedal strokes everything is perfect.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Then Tamsin's rear wheel clips Yuki's front.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "A shriek of carbon.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "The bikes tangle and both riders go down, sliding along the boards in a spray of splinters.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Stop! Everybody stop!", "name": "MO", "speaker": 0, "ext": ["CONT'D"], "paren": ["to everyone, a roar"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Silence except for a wheel spinning.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Tamsin sits up first, rubbing her hip.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Yuki lifts her head, helmet scuffed.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "I swapped on the line.", "name": "YUKI", "speaker": 3, "ext": [], "paren": ["laughing"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "You swapped on my foot.", "name": "TAMSIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "You okay?", "name": "MO", "speaker": 0, "ext": [], "paren": ["to Yuki"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "She hit me.", "name": "YUKI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "You?", "name": "MO", "speaker": 0, "ext": [], "paren": ["to Tamsin"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Fine. Mostly.", "name": "TAMSIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Mo lets out a breath and sits on the boards.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "She stares at the stopwatch.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Best time of the season. Unbelievable.", "name": "MO", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3]}]}