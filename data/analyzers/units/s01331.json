{"scene_id": "s01331", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01331.fountain", "heading": "INT. HOUSEBOAT GALLEY - NIGHT", "cast": [{"id": 0, "name": "ISADORA", "names": ["ISADORA"], "gender": "?", "first": 5, "spoke": 6}, {"id": 1, "name": "CALLUM", "names": ["CALLUM"], "gender": "?", "first": 6, "spoke": 6}, {"id": 2, "name": "PRUDENCE", "names": ["PRUDENCE"], "gender": "?", "first": 7, "spoke": 6}, {"id": 3, "name": "WENDELL", "names": ["WENDELL"], "gender": "?", "first": 8, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOUSEBOAT GALLEY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cramped.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Warm.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A table set for four, lamp swaying on its chain.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain ticks on the portholes.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ISADORA, 30s, serves a stew.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her brother CALLUM, 30s, lopes in sock feet, loose and smiling.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Their mother PRUDENCE, 60s, sits ramrod straight at the head.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Her husband-in-law WENDELL, 60s, quiet, folds a napkin into thirds.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "They eat.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Spoons clink.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Prudence compliments the stew.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Callum compliments Prudence.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Wendell compliments the weather.", "para": 2, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Good rain.", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "It keeps the river honest.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Pass the bread, Callum.", "name": "WENDELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Callum passes it.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Isadora refills a glass.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Her hand is steady.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "She pours slow.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Mama, I've been meaning to ask.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Mm.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "How's the boat's engine, Wendell?", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Runs.", "name": "WENDELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Mama, about the deed.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Not at supper.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Dora, leave it.", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "She sold it, didn't she.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Isadora, sit down.", "name": "WENDELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "I am sitting.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "I sold the lot. Not the boat.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "You what?", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "It was mine to sell.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "It was Daddy's.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": ["over her"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "It was never Leland's.", "name": "WENDELL", "speaker": 3, "ext": [], "paren": ["over Isadora"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Wait. Wait. Who bought it?", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Wendell did.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "The lamp sways.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "He sets the napkin by his plate.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "He does not look at either of them.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "She picks up her glass and drinks the whole thing.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "He stands, goes to the porthole, and watches the rain.", "para": 4, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Say something, Callum.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "I'm having more stew.", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}