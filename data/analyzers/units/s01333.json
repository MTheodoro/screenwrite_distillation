{"scene_id": "s01333", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01333.fountain", "heading": "EXT. LIFEBOAT, OPEN SEA - DAWN", "cast": [{"id": 0, "name": "CAPTAIN HESS", "names": ["CAPTAIN HESS", "HESS"], "gender": "?", "first": 5, "spoke": 3}, {"id": 1, "name": "YOUNG PETER", "names": ["YOUNG PETER", "PETER"], "gender": "?", "first": 6, "spoke": 1}, {"id": 2, "name": "ADEBAYO", "names": ["ADEBAYO", "MRS. ADEBAYO"], "gender": "?", "first": 7, "spoke": 1}, {"id": 3, "name": "COOK", "names": ["COOK"], "gender": "?", "first": 8, "spoke": 0}, {"id": 4, "name": "DMITRI", "names": ["DMITRI"], "gender": "?", "first": 8, "spoke": 2}, {"id": 5, "name": "LENKA", "names": ["LENKA"], "gender": "?", "first": 9, "spoke": 2}, {"id": 6, "name": "TOBIAS", "names": ["TOBIAS"], "gender": "m", "first": 10, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. LIFEBOAT, OPEN SEA - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Six figures crowd a seven-man boat.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Grey swell.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "No land.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A water jug sits empty at the center thwart.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CAPTAIN HESS, 50s, scorched face, holds the tiller.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "YOUNG PETER, 15, bails with a tin cup.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "MRS. ADEBAYO, 60s, clutches a sodden prayer shawl.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "THE COOK, DMITRI, 40s, rows alone on the left oar.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "LENKA, 20s, lies curled in the bow with a bandaged leg.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "And TOBIAS, 30s, sits with his hands over his face.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "action", "text": "Dmitri pulls, the oar bows and cracks, and Hess grabs the tiller as Peter lunges for the cup, Mrs. Adebayo shifts to steady Lenka, and Tobias lifts his head.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "Easy, Dmitri. We lose that oar, we lose the day.", "name": "HESS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "We lost the day last night, Captain.", "name": "DMITRI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "Peter, give me the cup. You'll wear your arm off.", "name": "MRS. ADEBAYO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "I'm fine, Mrs. Adebayo.", "name": "PETER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "Is that smoke, Lenka? Do you see it?", "name": "TOBIAS", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "It's cloud.", "name": "LENKA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "It looks like smoke.", "name": "TOBIAS", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "Then I'm sorry, Tobias.", "name": "LENKA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "Nobody drinks seawater. Nobody.", "name": "HESS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "Captain, nobody did.", "name": "DMITRI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Then we're alive, aren't we?", "name": "HESS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "The swell lifts the boat and sets it down.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}]}