{"scene_id": "s01334", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01334.fountain", "heading": "INT. TELEGRAPH RELAY STATION, RICE-PADDY DIKE - NIGHT", "cast": [{"id": 0, "name": "LIEUTENANT KOJI NAKAGAWA", "names": ["LIEUTENANT KOJI NAKAGAWA", "KOJI"], "gender": "m", "first": 5, "spoke": 6}, {"id": 1, "name": "MWANGI", "names": ["MWANGI"], "gender": "f", "first": 6, "spoke": 4}, {"id": 2, "name": "LOCAL WOMAN", "names": ["LOCAL WOMAN"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "MAI LIEN", "names": ["MAI LIEN"], "gender": "?", "first": 7, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. TELEGRAPH RELAY STATION, RICE-PADDY DIKE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A mud-brick hut on stilts.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Lantern.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wires leading out the window into the dark.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Frogs outside.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LIEUTENANT KOJI NAKAGAWA, 30s, sits at the key with a headset and a pencil behind his ear.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Corporal Obuya MWANGI, 20s, squats by the door with a carbine.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "An old LOCAL WOMAN, MAI LIEN, 60s, sets down a pot of tea at the table and steps back into the shadows.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "He taps a message.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "The sounder clatters back.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "He writes it down.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Mwangi watches the woman.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "She watches the floor.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "The lieutenant tears the page off the pad and folds it into his breast pocket.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Corporal. Tea.", "name": "KOJI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Sir.", "name": "MWANGI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "He pours two cups.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "He sets one in front of the lieutenant and keeps the other, cold, in his hand.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "He does not drink.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "The woman looks at the cup, then at the door, then away.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Ask her how far the next village is.", "name": "KOJI", "speaker": 0, "ext": [], "paren": ["without turning"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "She doesn't speak English, sir.", "name": "MWANGI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Ask anyway.", "name": "KOJI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Mwangi turns, mouths a few halting words in her language.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "She answers with two fingers, then three, then folds her hands.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "He looks back at the lieutenant.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Two hours. Maybe three.", "name": "MWANGI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Thank you.", "name": "KOJI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "He taps again.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "The sounder answers.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "He writes.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Outside, the frogs stop all at once.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Mwangi's thumb finds the safety on the carbine.", "para": 6, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "The woman's fingers find the rim of the teapot and rest there, perfectly still.", "para": 6, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Corporal.", "name": "KOJI", "speaker": 0, "ext": ["CONT'D"], "paren": ["very quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "I hear it, sir.", "name": "MWANGI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Finish your tea.", "name": "KOJI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Mwangi lifts the cup and drinks it to the bottom.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Koji lays down the pencil.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "The lantern flame leans, leans, and steadies.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}]}