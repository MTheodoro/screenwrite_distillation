{"scene_id": "s01335", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01335.fountain", "heading": "EXT. ULTRAMARATHON AID STATION, MOUNTAIN PASS - NIGHT", "cast": [{"id": 0, "name": "BERNARD OYELARAN", "names": ["BERNARD OYELARAN", "BERNARD"], "gender": "m", "first": 5, "spoke": 10}, {"id": 1, "name": "SIPHO DLAMINI", "names": ["SIPHO DLAMINI", "SIPHO"], "gender": "m", "first": 7, "spoke": 8}, {"id": 2, "name": "DISPATCH", "names": ["DISPATCH"], "gender": "?", "first": 25, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ULTRAMARATHON AID STATION, MOUNTAIN PASS - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A folding table under a tarp.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Headlamps bob in the dark.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A thermos steams.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A radio sits on a camp chair, its antenna taped to a tent pole.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "BERNARD OYELARAN, 60s, volunteer, parka zipped to the chin, fills paper cups with broth.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "He hums.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "SIPHO DLAMINI, 30s, jogs into the circle of light in a reflective vest, number 112 pinned to his shirt.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He is breathing easily.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He stops at the table and takes a cup.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Evening, runner. How are the legs?", "name": "BERNARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Honestly? Perfect.", "name": "SIPHO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "That's the broth. The broth cures everything.", "name": "BERNARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "It's a good broth.", "name": "SIPHO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Name and bib?", "name": "BERNARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Sipho Dlamini, one-twelve.", "name": "SIPHO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Bernard checks his clipboard.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He frowns.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Then smiles, and ticks a box.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Got you. You're fourth.", "name": "BERNARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Fourth.", "name": "SIPHO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Eight minutes behind the leader.", "name": "BERNARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "I'll catch her.", "name": "SIPHO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "The radio crackles.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Both men glance at it.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Station Nine, this is Control. Come in, please.", "name": "DISPATCH", "speaker": 2, "ext": ["O.S."], "paren": ["a woman's voice, crisp"], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Bernard picks up the handset.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Control, Station Nine. Go ahead.", "name": "BERNARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Bernard, I'm showing runner one-twelve on the shuttle manifest at mile thirty-one. Do you have him?", "name": "DISPATCH", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Bernard looks at Sipho.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Sipho finishes his broth.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "He sets the cup down, gently, as if putting down a gift.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Control, say again?", "name": "BERNARD", "speaker": 0, "ext": [], "paren": ["into radio"], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "One-twelve took the shuttle from thirty-one to thirty-eight. He's flagged for disqualification. Do you copy?", "name": "DISPATCH", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Bernard lowers the handset.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "The wind pulls at the tarp.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "It was cold.", "name": "SIPHO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Son.", "name": "BERNARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "My knee went.", "name": "SIPHO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Your knee went in the car?", "name": "BERNARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Sipho laughs without humor.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "He unpins the number from his shirt and puts it on the table.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Then he reaches for a second cup of broth.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "May I?", "name": "SIPHO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Take it.", "name": "BERNARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}