{"scene_id": "s01336", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01336.fountain", "heading": "EXT. FROZEN WATERFALL BRIDGE - DAWN", "cast": [{"id": 0, "name": "SIR ALARIC VENN", "names": ["SIR ALARIC VENN", "ALARIC"], "gender": "m", "first": 4, "spoke": 10}, {"id": 1, "name": "BRYNJOLF", "names": ["BRYNJOLF"], "gender": "?", "first": 5, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FROZEN WATERFALL BRIDGE - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A bridge of ice spans a gorge where a waterfall hung and froze mid-fall.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Blue light from within the ice.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A thousand-foot drop on either side.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SIR ALARIC VENN, 40s, silver cuirass, cloak crusted with frost, edges out from the south bank.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "At the north end stands BRYNJOLF, 40s, bear-furred, axe on his shoulder, beard threaded with icicles.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "They meet in the middle.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Both stop.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Brynjolf.", "name": "ALARIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Alaric.", "name": "BRYNJOLF", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Cold morning for a duel.", "name": "ALARIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Cold men fight best.", "name": "BRYNJOLF", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "You came alone.", "name": "ALARIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "So did you.", "name": "BRYNJOLF", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "A silence.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Beneath them, the ice groans, a long deep song.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Neither flinches.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "I'd like to cross.", "name": "ALARIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "I'd like the same.", "name": "BRYNJOLF", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Then you step back.", "name": "ALARIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Then you step aside.", "name": "BRYNJOLF", "speaker": 1, "ext": [], "paren": ["at the same time"], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "They both stop.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Both smile, thinly.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Alaric tilts his head.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Brynjolf mirrors it.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "We might freeze here.", "name": "BRYNJOLF", "speaker": 1, "ext": ["CONT'D"], "paren": ["at the same time"], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "We might both freeze.", "name": "ALARIC", "speaker": 0, "ext": [], "paren": ["at the same time"], "dual": true, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Brynjolf laughs, short and sharp.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "He lowers the axe.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Alaric lowers his hand from the sword hilt.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "A crack travels beneath their feet.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "They freeze.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "The crack runs between them, glittering, and stops.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "They look down, then at each other.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "That was not me.", "name": "ALARIC", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "It was not me.", "name": "BRYNJOLF", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Then who?", "name": "ALARIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Above Alaric, a pillar of ice breaks loose from the cliff.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Brynjolf sees it first.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "He lunges.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "He pulls Alaric down.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "The pillar shatters on the bridge where Alaric stood.", "para": 7, "sent": 4, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "The two men roll across the planks, and when they stop, each has a hand on the other's throat.", "para": 7, "sent": 5, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "You pulled me down.", "name": "ALARIC", "speaker": 0, "ext": ["CONT'D"], "paren": ["strangled"], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "You were standing there.", "name": "BRYNJOLF", "speaker": 1, "ext": [], "paren": ["strangled"], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "They let go.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Both gasp in the thin air.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Wind whistles.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "The bridge is breaking.", "name": "BRYNJOLF", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Then we cross together.", "name": "ALARIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "They help each other up.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "The bridge sings.", "para": 9, "sent": 1, "present": [0, 1]}]}