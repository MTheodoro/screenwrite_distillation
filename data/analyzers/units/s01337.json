{"scene_id": "s01337", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01337.fountain", "heading": "INT. LIGHTHOUSE KEEPER'S PARLOR - NIGHT (1888)", "cast": [{"id": 0, "name": "MADAME CORDELIA OSTERHOUT", "names": ["MADAME CORDELIA OSTERHOUT", "MADAME OSTERHOUT"], "gender": "f", "first": 5, "spoke": 3}, {"id": 1, "name": "COMMODORE ARCHIBALD FENN", "names": ["COMMODORE ARCHIBALD FENN", "COMMODORE FENN"], "gender": "m", "first": 6, "spoke": 2}, {"id": 2, "name": "LADY MIRIAM FENN", "names": ["LADY MIRIAM FENN", "LADY MIRIAM"], "gender": "f", "first": 6, "spoke": 2}, {"id": 3, "name": "KEEPER ISAIAH TULL", "names": ["KEEPER ISAIAH TULL", "KEEPER TULL"], "gender": "m", "first": 8, "spoke": 1}, {"id": 4, "name": "MISS THEODORA CRANE", "names": ["MISS THEODORA CRANE"], "gender": "f", "first": 9, "spoke": 0}, {"id": 5, "name": "BARNABY", "names": ["BARNABY"], "gender": "?", "first": 10, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. LIGHTHOUSE KEEPER'S PARLOR - NIGHT (1888)", "present": []}, {"u": 1, "kind": "action", "text": "Oil lamps.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wind shaking the shutters.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A round table draped in black velvet with a candle at its heart.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Six chairs.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MADAME CORDELIA OSTERHOUT, 50s, medium, in a high-collared gown.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "COMMODORE ARCHIBALD FENN, 60s, whiskers, pocket watch.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "LADY MIRIAM FENN, 40s, his wife, gloved hands folded.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "KEEPER ISAIAH TULL, 50s, oilskin coat, scowling.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "A young MISS THEODORA CRANE, 20s, notebook in her lap.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "And BARNABY, 12, the keeper's boy, crouched on the stair.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "Madame Osterhout closes her eyes.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "The candle gutters.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "The table gives a small knock.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "The Commodore checks his watch.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "The knock repeats.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Is there a spirit in this room?", "name": "MADAME OSTERHOUT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Knock.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Is that you, Edmund?", "name": "COMMODORE FENN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Knock.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Archibald, stop.", "name": "LADY MIRIAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Edmund, if it is you, rap three times.", "name": "COMMODORE FENN", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "He is dead, Archibald. Let him be.", "name": "LADY MIRIAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Three knocks, steady.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Miriam's gloves tighten.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Theodora writes.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Tull stares at the floorboards.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Barnaby's face withdraws from the stair.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "That's the tide, sir. The tide moves the rock.", "name": "KEEPER TULL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "The tide is not what moves tonight.", "name": "MADAME OSTERHOUT", "speaker": 0, "ext": [], "paren": ["eyes closed"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "The candle flame lies flat.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "A gust blows through the room.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "The lamps dim.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Miriam stands, lifts her chin, and walks out onto the gallery.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "The door bangs after her.", "para": 6, "sent": 4, "present": [0, 1, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "The Commodore starts to rise.", "para": 7, "sent": 0, "present": [0, 1, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Tull's hand lands on his arm.", "para": 7, "sent": 1, "present": [0, 1, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Madame opens her eyes.", "para": 7, "sent": 2, "present": [0, 1, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "She looks at Theodora, who is not writing now.", "para": 7, "sent": 3, "present": [0, 1, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "You did not tell me she was your mother.", "name": "MADAME OSTERHOUT", "speaker": 0, "ext": ["CONT'D"], "paren": ["to Theodora, flat"], "dual": false, "present": [0, 1, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Theodora lowers her pen.", "para": 8, "sent": 0, "present": [0, 1, 3, 4, 5]}]}