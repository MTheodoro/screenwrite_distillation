{"scene_id": "s01339", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01339.fountain", "heading": "INT. FLORIST'S COLD ROOM - NIGHT", "cast": [{"id": 0, "name": "DETECTIVE HARLOW QUINN", "names": ["DETECTIVE HARLOW QUINN", "QUINN"], "gender": "f", "first": 4, "spoke": 7}, {"id": 1, "name": "CAPTAIN WREN", "names": ["CAPTAIN WREN"], "gender": "?", "first": 10, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. FLORIST'S COLD ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A walk-in refrigerator, ranks of white buckets, a hundred roses breathing out their sweetness.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Frost on the shelves.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single bulb in a wire cage, humming.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DETECTIVE HARLOW QUINN, 40s, kneels on the tile in a camel coat, breath fogging.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "A black glove is wrapped around one finger of a dead man's hand, which has been laid on a bucket of lilies like an offering.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "She sets a small pen torch between her teeth and parts the lilies.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "Her cell phone rings, shrill in the cold.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "She flinches, spits the torch into her palm, and answers.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "dialogue", "text": "Quinn.", "name": "QUINN", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0]}, {"u": 10, "kind": "dialogue", "text": "Where are you?", "name": "CAPTAIN WREN", "speaker": 1, "ext": ["V.O."], "paren": ["over the phone, brisk"], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Cold room, Marlow's Flowers.", "name": "QUINN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Alone?", "name": "CAPTAIN WREN", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Yes.", "name": "QUINN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Get out. Now. She's on her way.", "name": "CAPTAIN WREN", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Who's on her way?", "name": "QUINN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "The florist. She's got a key. She's been on the phone with me for a minute, she's furious, she wants you off her property.", "name": "CAPTAIN WREN", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Captain, the body's in her fridge.", "name": "QUINN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Then you've got two minutes, Harlow.", "name": "CAPTAIN WREN", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Quinn snaps the torch back into her teeth.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "A latch clicks somewhere beyond the door.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She goes still.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "The bulb hums.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "A shadow slides across the frosted glass.", "para": 3, "sent": 4, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "She's already here.", "name": "QUINN", "speaker": 0, "ext": [], "paren": ["muttering around the torch"], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "The handle turns.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "The door opens a crack.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Quinn doesn't move.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "A rose petal drifts down onto the dead man's hand.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Harlow? Talk to me.", "name": "CAPTAIN WREN", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "The door swings wide.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Light spills in.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Quinn lifts the phone to her ear and does not look up.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "She's here.", "name": "QUINN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}