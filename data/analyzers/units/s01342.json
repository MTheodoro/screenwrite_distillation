{"scene_id": "s01342", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01342.fountain", "heading": "INT. HYDROPONIC BAY, GENERATION SHIP HALCYON - SHIP'S NIGHT", "cast": [{"id": 0, "name": "OKONKWO", "names": ["OKONKWO"], "gender": "?", "first": 4, "spoke": 2}, {"id": 1, "name": "LIRA PETROVA", "names": ["LIRA PETROVA", "LIRA"], "gender": "?", "first": 5, "spoke": 2}, {"id": 2, "name": "HAMASAKI", "names": ["HAMASAKI", "DR. HAMASAKI"], "gender": "?", "first": 6, "spoke": 3}, {"id": 3, "name": "TEODORO", "names": ["TEODORO"], "gender": "?", "first": 7, "spoke": 3}, {"id": 4, "name": "GIRL", "names": ["GIRL"], "gender": "?", "first": 14, "spoke": 2}, {"id": 5, "name": "MBEKI", "names": ["MBEKI"], "gender": "?", "first": 20, "spoke": 1}, {"id": 6, "name": "NEWT", "names": ["NEWT"], "gender": "?", "first": 19, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. HYDROPONIC BAY, GENERATION SHIP HALCYON - SHIP'S NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Green racks, pink grow-lights, mist.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A long table of lettuces.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Four crew in coveralls prune and murmur.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "OKONKWO, 40s, ties off a vine.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "LIRA PETROVA, 20s, weighs a tomato.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "DR. HAMASAKI, 60s, taps a tablet.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "TEODORO, 30s, wipes a lens.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Nobody hurries.", "para": 1, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Third rack's leaning.", "name": "OKONKWO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "The blue lamp's out.", "name": "LIRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I'll fix it.", "name": "TEODORO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Don't fix it. Replace it.", "name": "DR. HAMASAKI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "A hatch hisses.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "A small GIRL, 12, ship-born, hair in two buns, steps in hugging a bucket.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "She sets the bucket down and every head turns.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "You're off-shift, little one.", "name": "OKONKWO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "I brought worms.", "name": "GIRL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "What's your name again?", "name": "TEODORO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Newt.", "name": "GIRL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 6]}, {"u": 20, "kind": "action", "text": "MBEKI, 50s, the bay chief, steps out from behind a rack with a pruning knife.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "Newt. Mind the mist.", "name": "MBEKI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Good worms.", "name": "LIRA", "speaker": 1, "ext": [], "paren": ["over Okonkwo"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "How many, Newt?", "name": "TEODORO", "speaker": 3, "ext": [], "paren": ["over Lira"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "Don't count them, Teodoro. Plant them.", "name": "DR. HAMASAKI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "They don't mind.", "name": "NEWT", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "I'm sure they don't, Newt.", "name": "DR. HAMASAKI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "Okonkwo smiles, ties another vine.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}]}