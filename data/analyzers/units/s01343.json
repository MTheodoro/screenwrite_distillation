{"scene_id": "s01343", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01343.fountain", "heading": "EXT. GLACIER CREVASSE - DAY", "cast": [{"id": 0, "name": "MARGUERITE VOSS", "names": ["MARGUERITE VOSS", "MARGUERITE"], "gender": "?", "first": 3, "spoke": 4}, {"id": 1, "name": "TOBY KANE", "names": ["TOBY KANE", "TOBY"], "gender": "?", "first": 4, "spoke": 4}, {"id": 2, "name": "IZZY", "names": ["IZZY"], "gender": "?", "first": 5, "spoke": 6}, {"id": 3, "name": "BRANDT", "names": ["BRANDT"], "gender": "?", "first": 5, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. GLACIER CREVASSE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A blue slot in the ice, forty feet down, sheer walls glowing like glass.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A rope runs up into white sky.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "MARGUERITE VOSS, 40s, dangles at the bottom, crampons biting.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "TOBY KANE, 30s, hangs three feet above her, rope bunched in his gloves.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "At the lip, IZABELLA \"IZZY\" BRANDT, 30s, belays, braced against an ice axe.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "dialogue", "text": "Talk to me!", "name": "IZZY", "speaker": 2, "ext": [], "paren": ["shouting down"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Her leg's pinned!", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "I'm fine!", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Which of you is talking?", "name": "IZZY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Me! She means me!", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "The ice groans.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "A shelf cracks above them.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Snow hisses down.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Toby swings, grabs at the wall, kicks a foothold.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Marguerite hugs the ice.", "para": 2, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Cut her loose!", "name": "TOBY", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Don't cut me loose!", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Stop moving! Both of you!", "name": "IZZY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "The groan fades.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Quiet.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Snow dribbles.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Marguerite's breath fogs.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Toby peers down at her, then up at Izzy.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "She's stuck. I can reach her.", "name": "TOBY", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "How stuck?", "name": "IZZY", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Stuck like a stuck thing.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Toby laughs once, shakily.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "He lowers himself another foot.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "His hand finds her harness.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "The ice gives a final crack and holds.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Pull!", "name": "IZZY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Toby pulls.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Marguerite's leg comes free with a spray of ice.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "She cries out, grabs his wrist, and they rise together, jerked up the wall in short grunting yanks.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "At the lip, she hauls herself over first, then him.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "They collapse on the glacier, flat on their backs, staring at the sky.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Never again.", "name": "IZZY", "speaker": 2, "ext": ["CONT'D"], "paren": ["panting"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "You say that every time.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": ["panting"], "dual": false, "present": [0, 1, 2, 3]}]}