{"scene_id": "s01344", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01344.fountain", "heading": "INT. MINIVAN AT A TOLL PLAZA - DAY", "cast": [{"id": 0, "name": "DOLORES", "names": ["DOLORES"], "gender": "?", "first": 3, "spoke": 4}, {"id": 1, "name": "MAN", "names": ["MAN"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "WILLIE", "names": ["WILLIE"], "gender": "?", "first": 5, "spoke": 2}, {"id": 3, "name": "MARISOL", "names": ["MARISOL"], "gender": "?", "first": 6, "spoke": 2}, {"id": 4, "name": "FRANK", "names": ["FRANK"], "gender": "?", "first": 20, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. MINIVAN AT A TOLL PLAZA - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Crumbs, juice boxes, a cracked sun visor.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The windshield framed by a long line of brake lights.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "DOLORES, 40s, drives with both hands.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "Beside her, a MAN in a ball cap fiddles with the map, face turned away.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Behind them, a boy, WILLIE, 8, kicks the seat.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "A girl, MARISOL, 12, plugs one earbud in.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "A stranger.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "She had never seen him before the gas station.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "She grips the wheel tighter.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "He keeps studying the map.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "In the mirror, Willie sticks out his tongue.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Marisol rolls her eyes and shushes him.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "They inch forward, one car length.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "The toll booth waits, a glass cage.", "para": 3, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "The stranger refolds the map.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "She watches his hands.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "He stuffs it in the glove box.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Mom, who is he?", "name": "WILLIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Don't talk, Willie.", "name": "DOLORES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Mom, he's Uncle Frank.", "name": "MARISOL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Uncle Frank has a mustache.", "name": "DOLORES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "He shaved.", "name": "MARISOL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "The man in the ball cap turns at last.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "A broad smile, mustache missing, a pale stripe on his lip.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "He tips the cap.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Surprise, kids.", "name": "FRANK", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Uncle Frank!", "name": "WILLIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Frank, you scared me half to death.", "name": "DOLORES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "I had a plan.", "name": "FRANK", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "It was a bad plan.", "name": "DOLORES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "She laughs, tapping the wheel.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "He laughs.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Marisol groans.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "The toll booth's arm lifts.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Dolores hands the attendant exact change, rolls through, and merges onto the highway with a long exhale, while the boy throws his arms around Frank's seat.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4]}]}