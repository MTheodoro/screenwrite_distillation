{"scene_id": "s01345", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01345.fountain", "heading": "INT. FLOODED CLINIC, SECOND-FLOOR WARD - NIGHT", "cast": [{"id": 0, "name": "CATALINA OROZCO", "names": ["CATALINA OROZCO", "DR. OROZCO"], "gender": "?", "first": 5, "spoke": 7}, {"id": 1, "name": "NURSE EZEKIEL BWALYA", "names": ["NURSE EZEKIEL BWALYA", "EZEKIEL"], "gender": "?", "first": 6, "spoke": 3}, {"id": 2, "name": "RAJ", "names": ["RAJ"], "gender": "?", "first": 7, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. FLOODED CLINIC, SECOND-FLOOR WARD - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Brown water laps at the stairwell below.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Generators mutter.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Camp beds line the corridor, each lit by a headlamp or a candle in a jar.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The air smells of bleach and river.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. CATALINA OROZCO, 50s, surgical cap, sleeves rolled, kneels at a bedside with a stethoscope.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "NURSE EZEKIEL BWALYA, 30s, long hands, steady, hangs a bag of saline from a coat hook.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "And RAJ, 20s, an orderly with a flashlight, stands at the head of the stairs, watching the water.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Everyone who can sit up, please sit up. We are moving to the roof at midnight.", "name": "DR. OROZCO", "speaker": 0, "ext": [], "paren": ["to the ward"], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "A murmur.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Blankets rustle.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Pulse is one-twenty. Pressure?", "name": "DR. OROZCO", "speaker": 0, "ext": ["CONT'D"], "paren": ["to Ezekiel"], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Eighty over fifty. Dropping.", "name": "EZEKIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Come on, little heart.", "name": "DR. OROZCO", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Doctor, it's at the fourth step.", "name": "RAJ", "speaker": 2, "ext": [], "paren": ["from the stairs"], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Thank you, Raj. Keep counting.", "name": "DR. OROZCO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Sir, I'm going to give you something for the pain. Squeeze my hand.", "name": "EZEKIEL", "speaker": 1, "ext": [], "paren": ["to the patient"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Double the dose.", "name": "DR. OROZCO", "speaker": 0, "ext": [], "paren": ["to Ezekiel"], "dual": true, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Double the dose?", "name": "EZEKIEL", "speaker": 1, "ext": [], "paren": ["over her"], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Yes. And his wife's too.", "name": "DR. OROZCO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Ezekiel draws up a syringe.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "His hands never tremble.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Orozco lays the stethoscope against the patient's chest and listens, eyes closed.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Fifth step!", "name": "RAJ", "speaker": 2, "ext": [], "paren": ["calling"], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "No one panics. Stay in your beds. We will carry you.", "name": "DR. OROZCO", "speaker": 0, "ext": [], "paren": ["to the ward"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "She opens her eyes.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The patient has stopped breathing.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Ezekiel is already in motion.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "The headlamps shiver.", "para": 4, "sent": 3, "present": [0, 1, 2]}]}