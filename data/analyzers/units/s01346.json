{"scene_id": "s01346", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01346.fountain", "heading": "INT. COMMUNITY HOSPITAL, TRAUMA BAY - NIGHT", "cast": [{"id": 0, "name": "SAMUEL ACHTERBERG", "names": ["SAMUEL ACHTERBERG", "DR. ACHTERBERG"], "gender": "m", "first": 5, "spoke": 5}, {"id": 1, "name": "NURSE LINH DAO", "names": ["NURSE LINH DAO", "NURSE DAO"], "gender": "?", "first": 6, "spoke": 4}, {"id": 2, "name": "TEAGUE", "names": ["TEAGUE"], "gender": "m", "first": 7, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. COMMUNITY HOSPITAL, TRAUMA BAY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "White light, steel.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A gurney.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Monitors beeping.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A fan of gauze packets on a tray.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. SAMUEL ACHTERBERG, 40s, scrubs, surgical mask pulled under his chin, wipes his hands.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "NURSE LINH DAO, 30s, adjusts a monitor.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "A bleeding man, MR. TEAGUE, 50s, in a mechanic's coveralls, sits on the gurney, one hand clamped on his forearm.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Teague tries to stand.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Achterberg and Dao push him back down together.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Teague shoves free, swings an elbow.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Dao ducks.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Achterberg grabs the arm.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "The three of them scuffle against the gurney, a monitor lead pops loose, and the machine screams.", "para": 2, "sent": 5, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "They freeze, panting.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Teague's arm drips onto the floor.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "A long beat.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Mr. Teague, you are bleeding.", "name": "DR. ACHTERBERG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "I know I'm bleeding.", "name": "TEAGUE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "You have a lacerated radial artery. If you stand up, you will pass out.", "name": "DR. ACHTERBERG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I don't have time to pass out.", "name": "TEAGUE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Mr. Teague, please sit down.", "name": "NURSE DAO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "My daughter's waiting in the parking lot. She's eleven. She doesn't have a coat. She thinks I'm getting a sandwich.", "name": "TEAGUE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "We can send someone to get her.", "name": "DR. ACHTERBERG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "She won't go with a stranger.", "name": "TEAGUE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "She'll go with me. Tell me what she looks like.", "name": "NURSE DAO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Blue backpack. Braids. Her name is Corinne.", "name": "TEAGUE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Corinne. Blue backpack. Braids.", "name": "NURSE DAO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "She hates broccoli.", "name": "TEAGUE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Noted.", "name": "NURSE DAO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Mr. Teague, I need your arm.", "name": "DR. ACHTERBERG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "You'll fix it?", "name": "TEAGUE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "I'll fix it.", "name": "DR. ACHTERBERG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Teague lies back.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Dao reconnects the monitor lead.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Achterberg unwraps a suture kit.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "The beep slows to a steady rhythm.", "para": 4, "sent": 3, "present": [0, 1, 2]}]}