{"scene_id": "s01347", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01347.fountain", "heading": "INT. MESS TENT, FORWARD CAMP - DAY", "cast": [{"id": 0, "name": "SERGEANT MORRIS HALE", "names": ["SERGEANT MORRIS HALE", "HALE"], "gender": "m", "first": 5, "spoke": 21}, {"id": 1, "name": "PRIVATE ELLIOT QUAYLE", "names": ["PRIVATE ELLIOT QUAYLE", "QUAYLE"], "gender": "m", "first": 12, "spoke": 20}], "units": [{"u": 0, "kind": "heading", "text": "INT. MESS TENT, FORWARD CAMP - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A canvas tent flapping in dry wind.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Trestle tables, tin plates, a single coffee urn.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The distant rumble of artillery has stopped.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Everything has stopped.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SERGEANT MORRIS HALE, 50s, grizzled, sits alone at the end of a bench, writing a letter in pencil.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A tin mug steams at his elbow.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "He writes.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "He stops.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "He crosses a line out.", "para": 2, "sent": 2, "present": [0]}, {"u": 10, "kind": "action", "text": "He writes again.", "para": 2, "sent": 3, "present": [0]}, {"u": 11, "kind": "action", "text": "The tent flap parts.", "para": 3, "sent": 0, "present": [0]}, {"u": 12, "kind": "action", "text": "PRIVATE ELLIOT QUAYLE, 19, enters, helmet off, cropped hair, a young face wrapped around old eyes.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He carries a rifle by the sling and a folded paper in his teeth.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He takes the paper out and stands at attention.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Sergeant Hale.", "name": "QUAYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "At ease, Private.", "name": "HALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Sir, I've been told to give you this.", "name": "QUAYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He holds out the paper.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Hale does not take it.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "He sets down the pencil.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Sit.", "name": "HALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Sergeant, I'm supposed to deliver it and come straight back.", "name": "QUAYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Then sit and come straight back after.", "name": "HALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Quayle sits.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Hale slides the mug across the table.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Quayle takes it.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "They both watch the tent flap moving.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Quiet out there.", "name": "HALE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Yes, Sergeant.", "name": "QUAYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "How long?", "name": "HALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Since noon.", "name": "QUAYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Is that long?", "name": "HALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Longest it's been since I got here.", "name": "QUAYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "How long have you been here?", "name": "HALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Six weeks.", "name": "QUAYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "That's not long.", "name": "HALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "No, Sergeant.", "name": "QUAYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Hale picks up the paper, unfolds it, reads, folds it again.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "He sets it on the table beside his letter.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Do you know what this says?", "name": "HALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "No, Sergeant.", "name": "QUAYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "It says the war is over.", "name": "HALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Sir?", "name": "QUAYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Armistice at noon. That's why it's quiet.", "name": "HALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "Quayle sits very still.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "He sets the mug down.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "His hands lie flat on the table.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Sergeant, nobody told us.", "name": "QUAYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "They're telling us now.", "name": "HALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Is it true?", "name": "QUAYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "It's signed.", "name": "HALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Then why do we still have to stand watch?", "name": "QUAYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "Because nobody told the other side.", "name": "HALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "Oh.", "name": "QUAYLE", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "Don't take your helmet off yet.", "name": "HALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "No, Sergeant.", "name": "QUAYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "You can take your boots off.", "name": "HALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "Sir?", "name": "QUAYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "I've never seen a man win a war with his boots on.", "name": "HALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "Quayle laughs, helpless, and puts his hands over his face.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "Hale lifts the pencil and finishes his sentence.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "The tent flap moves.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "The wind carries a distant bugle, very thin, very far.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "Sergeant. Is that ours?", "name": "QUAYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "It's somebody's.", "name": "HALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "What do we do now?", "name": "QUAYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "We eat, Private.", "name": "HALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "And after?", "name": "QUAYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "After, you write to your mother.", "name": "HALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "What do I tell her?", "name": "QUAYLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "dialogue", "text": "Tell her you were in the mess tent when it happened.", "name": "HALE", "speaker": 0, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1]}]}