{"scene_id": "s01349", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01349.fountain", "heading": "INT. ABANDONED ARCADE, BACK ROOM - NIGHT", "cast": [{"id": 0, "name": "MAGDA KOWALCZYK", "names": ["MAGDA KOWALCZYK", "MAGDA"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "TWYLA BANKS", "names": ["TWYLA BANKS", "TWYLA"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "PINCH", "names": ["PINCH"], "gender": "?", "first": 6, "spoke": 3}, {"id": 3, "name": "ARRIAGA", "names": ["ARRIAGA"], "gender": "?", "first": 6, "spoke": 0}, {"id": 4, "name": "DEVANTE ROOK", "names": ["DEVANTE ROOK", "DEVANTE"], "gender": "?", "first": 15, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED ARCADE, BACK ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dead pinball machines draped in sheets.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A card table.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Four chairs, one empty.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MAGDA KOWALCZYK, 50s, plans on a napkin.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "TWYLA BANKS, 30s, drums the table with a lighter.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "And JOS\u00c9 \"PINCH\" ARRIAGA, 40s, folds the map in precise squares.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Three minutes in, four out.", "name": "MAGDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Three in, three out.", "name": "TWYLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "She wants a margin.", "name": "MAGDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "She wants a lot of things.", "name": "TWYLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Who's the she?", "name": "PINCH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "The she who gets us paid.", "name": "TWYLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "The back door scrapes.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "A fourth figure ducks in, pulling a hood down from a bruised face.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "DEVANTE ROOK, 20s, the driver.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "He drops into the empty chair and doesn't speak.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "You're late.", "name": "MAGDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "The truck was followed.", "name": "DEVANTE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "By who?", "name": "PINCH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "A woman. Maybe two.", "name": "DEVANTE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Where did you lose her?", "name": "MAGDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "I didn't.", "name": "DEVANTE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "The pinball machines hum faintly under their sheets.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Twyla's lighter stops clicking.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Then she's outside.", "name": "TWYLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "She's outside.", "name": "DEVANTE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Then we're finished.", "name": "MAGDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "No. We are retired.", "name": "PINCH", "speaker": 2, "ext": [], "paren": ["folding the map"], "dual": false, "present": [0, 1, 2, 3, 4]}]}