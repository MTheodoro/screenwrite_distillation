{"scene_id": "s01351", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01351.fountain", "heading": "INT. OBSERVATORY ROOF DOME - NIGHT", "cast": [{"id": 0, "name": "CASSIAN LOWE", "names": ["CASSIAN LOWE", "CASSIAN"], "gender": "?", "first": 6, "spoke": 9}, {"id": 1, "name": "LYDIA ABERNATHY-OKAFOR", "names": ["LYDIA ABERNATHY-OKAFOR", "LYDIA"], "gender": "m", "first": 8, "spoke": 11}, {"id": 2, "name": "MABEL", "names": ["MABEL"], "gender": "?", "first": 10, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. OBSERVATORY ROOF DOME - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A hemisphere of dark wood and brass, the great shutter slid open on a spill of stars.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "In the center, a telescope the size of a cannon points at the sky.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The floor is a compass rose of inlaid ebony.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "It is cold.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Everyone's breath is visible.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "CASSIAN LOWE, 40s, wrapped in a moth-eaten scarf, adjusts the telescope eyepiece with long inky fingers.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "He is an astronomer who has been alone with his work for fifteen years, and it shows in the way he does not quite look at people.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "LYDIA ABERNATHY-OKAFOR, 30s, in a velvet coat, hair swept up and pinned with a single silver comb, stands at the foot of the iron stair, staring up at him.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "She has the stillness of someone who rehearsed a speech and forgot it on the climb.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "And between them, curled on a worn leather chair, is MABEL, 70s, Cassian's mother, a tiny woman in knitted mittens, dozing, a cup of cold tea on her knee.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "You didn't answer my letters.", "name": "LYDIA", "speaker": 1, "ext": [], "paren": ["to Cassian"], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Comets keep their own hours.", "name": "CASSIAN", "speaker": 0, "ext": [], "paren": ["not turning"], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "I'm not a comet.", "name": "LYDIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "No. A comet comes back.", "name": "CASSIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Lydia flinches.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "She climbs one step.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Seven years, and this is what it comes to. A man with his eye pressed to a hole.", "name": "LYDIA", "speaker": 1, "ext": [], "paren": ["to the dome"], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "That's a fine hole, dear.", "name": "MABEL", "speaker": 2, "ext": [], "paren": ["half asleep"], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Mother.", "name": "CASSIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Just saying.", "name": "MABEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Lydia takes another step.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Cassian's hand tightens on the brass.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "A star slides through the glass.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "I'm marrying Edgar in June.", "name": "LYDIA", "speaker": 1, "ext": [], "paren": ["to Cassian"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Congratulations.", "name": "CASSIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "That's all?", "name": "LYDIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "What would you like me to say?", "name": "CASSIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Something. Anything that isn't polite.", "name": "LYDIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Edgar is a fool.", "name": "CASSIAN", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "There it is.", "name": "LYDIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "He wears spats to the beach.", "name": "CASSIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "He is kind.", "name": "LYDIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "He is kind, and wears spats, and has never once looked up.", "name": "CASSIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Lydia reaches the platform.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "She faces him.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "He finally turns.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Their faces are a foot apart.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Cassian, look at me.", "name": "LYDIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "I am looking.", "name": "CASSIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Look at me, not past me.", "name": "LYDIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "He does.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "The eyes are wet.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Behind them, a meteor streaks across the open shutter.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Neither notices.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Did I miss something?", "name": "MABEL", "speaker": 2, "ext": [], "paren": ["waking, to the room"], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Everything, Mabel.", "name": "LYDIA", "speaker": 1, "ext": [], "paren": ["not moving"], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "I knew it. I always do.", "name": "MABEL", "speaker": 2, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2]}]}