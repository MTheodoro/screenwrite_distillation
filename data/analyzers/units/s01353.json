{"scene_id": "s01353", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01353.fountain", "heading": "EXT. WATER TOWER ON THE PLAINS - DAWN", "cast": [{"id": 0, "name": "GASPAR REYES", "names": ["GASPAR REYES"], "gender": "?", "first": 7, "spoke": 6}, {"id": 1, "name": "ELLIE VANCE", "names": ["ELLIE VANCE"], "gender": "?", "first": 8, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "EXT. WATER TOWER ON THE PLAINS - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A rusted tank on stilts against an empty sky.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A rope ladder swings.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "He climbs it, slow, rifle across his back.", "para": 1, "sent": 0, "present": []}, {"u": 4, "kind": "action", "text": "At the top he kneels, takes off his hat, and peers over the rim.", "para": 1, "sent": 1, "present": []}, {"u": 5, "kind": "action", "text": "She is already there, sitting cross-legged, sipping from a tin cup.", "para": 1, "sent": 2, "present": []}, {"u": 6, "kind": "action", "text": "She doesn't look at him.", "para": 2, "sent": 0, "present": []}, {"u": 7, "kind": "dialogue", "text": "Morning.", "name": "GASPAR REYES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 8, "kind": "dialogue", "text": "Morning.", "name": "ELLIE VANCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "You waiting on me?", "name": "GASPAR REYES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Waiting on weather.", "name": "ELLIE VANCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He settles beside her.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She offers the cup.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He drinks and hands it back.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "They say the bank's closed.", "name": "GASPAR REYES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "They say a lot.", "name": "ELLIE VANCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Is it?", "name": "GASPAR REYES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She shrugs.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Far below, a dust cloud rises on the road.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Both watch it come.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "That's a posse.", "name": "GASPAR REYES", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "That's a wagon.", "name": "ELLIE VANCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "You sure?", "name": "GASPAR REYES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "No.", "name": "ELLIE VANCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "He reaches for the rifle.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "She puts a hand on his wrist.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "The dust draws closer, a hundred yards, fifty.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "A mule brays.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "It's a wagon.", "name": "ELLIE VANCE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "He lets go of the rifle.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "She drinks the last of the tea.", "para": 6, "sent": 1, "present": [0, 1]}]}