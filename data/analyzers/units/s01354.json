{"scene_id": "s01354", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01354.fountain", "heading": "INT. CHILDREN'S PUPPET THEATER, BACKSTAGE - NIGHT", "cast": [{"id": 0, "name": "MARTA OSWIN", "names": ["MARTA OSWIN", "MARTA"], "gender": "?", "first": 6, "spoke": 8}, {"id": 1, "name": "THEO MERCER", "names": ["THEO MERCER", "THEO"], "gender": "?", "first": 7, "spoke": 8}, {"id": 2, "name": "VOICE", "names": ["VOICE"], "gender": "?", "first": 8, "spoke": 0}, {"id": 3, "name": "FIGURE", "names": ["FIGURE"], "gender": "?", "first": 9, "spoke": 1}, {"id": 4, "name": "INEZ", "names": ["INEZ"], "gender": "?", "first": 25, "spoke": 4}, {"id": 5, "name": "PLATE MAN", "names": ["PLATE MAN"], "gender": "?", "first": 41, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. CHILDREN'S PUPPET THEATER, BACKSTAGE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dust.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Velvet.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Strings hanging like vines.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Papier-m\u00e2ch\u00e9 heads on hooks.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "One working bulb.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "MARTA OSWIN, 30s, cleans a marionette with a rag.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "THEO MERCER, 20s, the stagehand, counts stage weights.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "A VOICE hums from the dark above the catwalk.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "A FIGURE in a cloak sits in the third row, outlined by the footlights, still as a coat.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Theo, who's in the house?", "name": "MARTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "No one. We locked up at nine.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Then who's that?", "name": "MARTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "That's the coat rack.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "The coat rack doesn't hum.", "name": "MARTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "The humming stops.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "The cloak turns.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "A long white face tilts into the footlights.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "It has no mouth.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Whose turn is it?", "name": "FIGURE", "speaker": 3, "ext": [], "paren": ["a dry whisper"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Marta.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Don't move.", "name": "MARTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "The marionette in her hands twitches.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Its strings tighten by themselves.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "The head turns toward her.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Theo. Call Inez.", "name": "MARTA", "speaker": 0, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Inez is at home.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Call her.", "name": "MARTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "He thumbs a phone.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "It rings, tinny.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Hello?", "name": "INEZ", "speaker": 4, "ext": ["V.O."], "paren": ["sleepy, over the phone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Inez, it's Theo. At the theater. Something's in the house.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "What kind of something?", "name": "INEZ", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "A man. A thing. It's got a face like a plate.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Theo. Get out of the theater.", "name": "INEZ", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "I can't. It's between me and the door.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "The figure rises from the seat.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "It steps up onto the stage, boot by boot.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "The bulb dims.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Marta lets go of the puppet.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "It dangles, spinning slowly.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "It's the Plate Man.", "name": "MARTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "The what?", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "My grandmother told me. He takes the last one out of the house.", "name": "MARTA", "speaker": 0, "ext": [], "paren": ["backing away"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Theo? Theo, are you there?", "name": "INEZ", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Yours.", "name": "PLATE MAN", "speaker": 5, "ext": [], "paren": ["a dry whisper"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "The Plate Man opens its cloak.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "Behind it, rows of small white faces.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "Theo screams.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}