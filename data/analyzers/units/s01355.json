{"scene_id": "s01355", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01355.fountain", "heading": "INT. SALOON DURING A THUNDERSTORM - NIGHT", "cast": [{"id": 0, "name": "BARN", "names": ["BARN"], "gender": "m", "first": 5, "spoke": 3}, {"id": 1, "name": "COLE", "names": ["COLE"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "SUNNY WELLS", "names": ["SUNNY WELLS"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "REVEREND THOMAS GRIGG", "names": ["REVEREND THOMAS GRIGG", "REVEREND GRIGG"], "gender": "m", "first": 7, "spoke": 3}, {"id": 4, "name": "MERCEDES SOTO", "names": ["MERCEDES SOTO", "MERCEDES"], "gender": "f", "first": 8, "spoke": 5}, {"id": 5, "name": "JED", "names": ["JED"], "gender": "m", "first": 9, "spoke": 5}, {"id": 6, "name": "PIKE", "names": ["PIKE"], "gender": "?", "first": 9, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. SALOON DURING A THUNDERSTORM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Lamplight.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rain drumming on the tin roof.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Poker chips.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A cracked mirror behind the bar.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "BARNABY \"BARN\" COLE, 40s, bartender, polishes a glass.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "SUNNY WELLS, 20s, deals cards in the corner.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "REVEREND THOMAS GRIGG, 60s, nurses a whiskey.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "MERCEDES SOTO, 30s, in a duster, sits alone, a rifle across her knees.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "Two cowhands, JED and PIKE, 20s, play with Sunny.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "dialogue", "text": "Barn, another round.", "name": "JED", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "Jed, you're drunk.", "name": "BARN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "I'm thirsty.", "name": "JED", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "Same thing, Jed.", "name": "PIKE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "Gentlemen, the Lord watches.", "name": "REVEREND GRIGG", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "The Lord can watch me pay.", "name": "JED", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "action", "text": "Mercedes lifts her head.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "action", "text": "She watches Jed's hand.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "action", "text": "Jed's hand moves to his gun.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "Jed Hawkins.", "name": "MERCEDES", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "Who's asking?", "name": "JED", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "Mercedes Soto. You killed my brother in Tucson.", "name": "MERCEDES", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "Lightning.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "Pike pushes back from the table.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "action", "text": "Sunny drops the deck.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "action", "text": "Barn slowly sets down the glass.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "Ma'am. Not in my bar.", "name": "BARN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "Barn, step aside.", "name": "MERCEDES", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "Jed draws.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "Mercedes fires first.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "Jed drops, clutching his arm.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "action", "text": "Pike dives behind the table.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "Sunny scrambles under it.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "The Reverend crosses himself and kneels.", "para": 4, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "Everybody stay down!", "name": "BARN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "Lord, forgive us!", "name": "REVEREND GRIGG", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "Mercedes stands over Jed, rifle on his chest.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "Thunder shakes the roof.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "He pulled first.", "name": "JED", "speaker": 5, "ext": [], "paren": ["through his teeth"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "My brother never pulled first in his life.", "name": "MERCEDES", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "Barn raises his hands.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "Pike peeks up.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "Sunny crawls out.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "The Reverend rises and walks to Jed's side, kneels.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "Miss Soto, let me tend him.", "name": "REVEREND GRIGG", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "dialogue", "text": "Reverend, he's yours.", "name": "MERCEDES", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "She lowers the rifle, turns, and walks out into the rain.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}]}