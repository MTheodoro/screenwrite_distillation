{"scene_id": "s01357", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01357.fountain", "heading": "INT. RESTAURANT KITCHEN, AFTER CLOSE - NIGHT", "cast": [{"id": 0, "name": "CHEF IMANI JOSEPH", "names": ["CHEF IMANI JOSEPH", "IMANI"], "gender": "f", "first": 4, "spoke": 2}, {"id": 1, "name": "SOUS-CHEF DARIUS PELL", "names": ["SOUS-CHEF DARIUS PELL", "DARIUS"], "gender": "?", "first": 5, "spoke": 2}, {"id": 2, "name": "DISHWASHER PEARL", "names": ["DISHWASHER PEARL", "PEARL"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "WAITER ANSELM", "names": ["WAITER ANSELM", "ANSELM"], "gender": "?", "first": 7, "spoke": 1}, {"id": 4, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 8, "spoke": 1}, {"id": 5, "name": "LEOPOLD", "names": ["LEOPOLD"], "gender": "?", "first": 20, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. RESTAURANT KITCHEN, AFTER CLOSE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Steel counters.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A hose coiled on the drain.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Five people sit on overturned crates sharing a bottle.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CHEF IMANI JOSEPH, 40s, still in whites.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "SOUS-CHEF DARIUS PELL, 30s.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "DISHWASHER PEARL, 50s.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "WAITER ANSELM, 20s.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "And a STRANGER in a gray coat, fifties, who wandered in through the alley door.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "Imani pours a round.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Darius passes the bread.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Pearl hums.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Anselm laughs.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "The Stranger accepts a glass and says nothing.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "So what do we call him?", "name": "IMANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "He's a health inspector.", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "He's not an inspector.", "name": "PEARL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "He's a ghost.", "name": "ANSELM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "He ate the last of the soup.", "name": "DARIUS", "speaker": 1, "ext": [], "paren": ["over Anselm"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Hush, let the man speak.", "name": "PEARL", "speaker": 2, "ext": [], "paren": ["over Darius"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Leopold.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Leopold what?", "name": "IMANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Just Leopold. I used to cook here.", "name": "LEOPOLD", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Imani lowers her glass.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "He lifts his, to her.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Good soup. Needs salt.", "name": "LEOPOLD", "speaker": 5, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Imani smiles.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "She stands, crosses to the stove, adds a pinch.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "He nods.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}