{"scene_id": "s01358", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01358.fountain", "heading": "INT. AUCTION HOUSE, FREIGHT ELEVATOR - NIGHT", "cast": [{"id": 0, "name": "ENZO", "names": ["ENZO"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "MARCHETTI", "names": ["MARCHETTI"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "NOOR HASHEMI", "names": ["NOOR HASHEMI", "NOOR"], "gender": "f", "first": 5, "spoke": 4}, {"id": 3, "name": "OZZIE", "names": ["OZZIE"], "gender": "m", "first": 6, "spoke": 4}, {"id": 4, "name": "LIN", "names": ["LIN"], "gender": "?", "first": 6, "spoke": 0}, {"id": 5, "name": "DARCY LUND", "names": ["DARCY LUND", "DARCY"], "gender": "?", "first": 7, "spoke": 9}, {"id": 6, "name": "BASE", "names": ["BASE"], "gender": "?", "first": 29, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. AUCTION HOUSE, FREIGHT ELEVATOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cage of scuffed steel, floor stenciled with weight limits.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The elevator hums, descending through darkness.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A crate the size of a coffin stands on a hand truck.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LORENZO \"ENZO\" MARCHETTI, 50s, tuxedo, bow tie crooked, holds the truck handles.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "NOOR HASHEMI, 30s, in a janitor's jumpsuit, mop bucket by her ankle.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "OSCAR \"OZZIE\" LIN, 20s, headphones around his neck, crouches by a panel with a screwdriver.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "action", "text": "At the back, DARCY LUND, 60s, an auction-house guard in uniform, hums a tune.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "action", "text": "He has not noticed anything.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "Floor three.", "name": "ENZO", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Keep humming, Darcy.", "name": "NOOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Always do.", "name": "DARCY", "speaker": 5, "ext": [], "paren": ["cheerfully"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "The elevator shudders.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "Noor grips the rail.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Ozzie, the camera.", "name": "NOOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Looped. Eight seconds.", "name": "OZZIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Eight seconds is nothing.", "name": "ENZO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "It's what the tape gives.", "name": "OZZIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Where's the other guard?", "name": "NOOR", "speaker": 2, "ext": [], "paren": ["over Ozzie"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Which one?", "name": "DARCY", "speaker": 5, "ext": [], "paren": ["over Noor"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Darcy, the other guard.", "name": "ENZO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Oh. Lunchtime.", "name": "DARCY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Everyone exhales.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "The elevator stops.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "The cage door slides open on a dim lobby with a marble floor and a vault door ten feet tall.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Showtime.", "name": "ENZO", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "They roll the crate out.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "The wheels squeak.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Darcy hums louder.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Base to Darcy. Base to Darcy. Status.", "name": "BASE", "speaker": 6, "ext": ["V.O."], "paren": ["a voice from Darcy's radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "Darcy lifts the radio.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "Base, Darcy. All clear. Just a delivery.", "name": "DARCY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "Delivery? At this hour?", "name": "BASE", "speaker": 6, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "Antique. Very heavy.", "name": "DARCY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "Copy. Stay put.", "name": "BASE", "speaker": 6, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "Enzo's eyes narrow at Darcy.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "Noor slides a hand to her pocket.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "dialogue", "text": "Eight seconds. Seven. Six.", "name": "OZZIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "Base, actually, there's a problem.", "name": "DARCY", "speaker": 5, "ext": [], "paren": ["into the radio, smiling"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "Everyone freezes.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "dialogue", "text": "What problem?", "name": "BASE", "speaker": 6, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "dialogue", "text": "My feet hurt.", "name": "DARCY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "A long beat.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "Then the radio laughs.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "Roger that. Sit down, Darcy.", "name": "BASE", "speaker": 6, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "action", "text": "Darcy sits on the crate and unlaces a shoe.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "Enzo and Noor stare.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "Ozzie laughs once, high, into his hand.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "dialogue", "text": "He's good.", "name": "NOOR", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "dialogue", "text": "He's the best liar I ever hired.", "name": "ENZO", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "dialogue", "text": "Three. Two.", "name": "OZZIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "action", "text": "The vault door swings open on its own, lit from within by a pale green glow.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "action", "text": "Enzo steps toward it.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "dialogue", "text": "Hello, beautiful.", "name": "ENZO", "speaker": 0, "ext": [], "paren": ["under his breath"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "dialogue", "text": "Mind the wheels, boss.", "name": "DARCY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "dialogue", "text": "Darcy, say again. Who are you talking to?", "name": "BASE", "speaker": 6, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "action", "text": "Darcy looks at the radio.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "action", "text": "Then at the three of them.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 59, "kind": "action", "text": "He sets it on the crate, very gently, and switches it off.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 60, "kind": "dialogue", "text": "Nobody.", "name": "DARCY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}