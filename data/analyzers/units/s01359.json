{"scene_id": "s01359", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01359.fountain", "heading": "INT. TELEGRAPH OFFICE, LONDON - NIGHT (1912)", "cast": [{"id": 0, "name": "PERCIVAL ASHDOWN", "names": ["PERCIVAL ASHDOWN", "ASHDOWN"], "gender": "m", "first": 7, "spoke": 5}, {"id": 1, "name": "MISS ROSALIND TREVETHAN", "names": ["MISS ROSALIND TREVETHAN", "ROSALIND"], "gender": "?", "first": 8, "spoke": 4}, {"id": 2, "name": "LORD ALISTAIR CROYDE", "names": ["LORD ALISTAIR CROYDE", "CROYDE"], "gender": "m", "first": 9, "spoke": 4}, {"id": 3, "name": "HARRIET LUCAS", "names": ["HARRIET LUCAS", "HARRIET"], "gender": "?", "first": 10, "spoke": 2}, {"id": 4, "name": "OPERATOR", "names": ["OPERATOR"], "gender": "?", "first": 30, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. TELEGRAPH OFFICE, LONDON - NIGHT (1912)", "present": []}, {"u": 1, "kind": "action", "text": "Brass keys.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Glass cases.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A gas lamp.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A wall of pigeonholes.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The tick of a dozen sounders.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "Rain on the glass.", "para": 0, "sent": 5, "present": []}, {"u": 7, "kind": "action", "text": "MR. PERCIVAL ASHDOWN, 50s, stiff collar, spectacles, sorts slips.", "para": 1, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "MISS ROSALIND TREVETHAN, 20s, clerk, hair pinned up under a cap, taps the key.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "LORD ALISTAIR CROYDE, 50s, in a fur-collared coat, waits at the counter, drumming gloved fingers.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "And a woman, HARRIET LUCAS, 30s, in a plain brown coat, stands at the far end of the counter holding an unopened envelope.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Ashdown clears his throat.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Ladies and gentlemen. We are experiencing delay. The Atlantic cable is busy.", "name": "ASHDOWN", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "How busy?", "name": "CROYDE", "speaker": 2, "ext": [], "paren": ["to Ashdown"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Very.", "name": "ASHDOWN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Is it the Titanic?", "name": "CROYDE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Rosalind's hand stills on the key.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "It is, my lord.", "name": "ASHDOWN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Harriet puts the envelope down.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "My brother was a stoker.", "name": "HARRIET", "speaker": 3, "ext": [], "paren": ["under her breath"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Miss, I am so sorry.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": ["to Harriet"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "The sounder clatters.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Rosalind leans in, writes, tears the slip.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Message. Carpathia has picked up survivors.", "name": "ROSALIND", "speaker": 1, "ext": ["CONT'D"], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "A breath goes through the office.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Croyde takes off his hat.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Ashdown snatches the slip and reads it.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Is there a list?", "name": "ASHDOWN", "speaker": 0, "ext": [], "paren": ["to Rosalind"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Not yet.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Names to follow. Standby, London.", "name": "OPERATOR", "speaker": 4, "ext": ["V.O."], "paren": ["over the sounder, faint, relayed"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Harriet takes a step forward, then stops.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Please, Tom. Please.", "name": "HARRIET", "speaker": 3, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Mr. Ashdown, send a message to my wife. Tell her I have an interest.", "name": "CROYDE", "speaker": 2, "ext": [], "paren": ["to Ashdown"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "My lord, there are priorities.", "name": "ASHDOWN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "I am aware of that, Ashdown.", "name": "CROYDE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Rosalind keys again.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "The sounder answers.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Names. First batch.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": ["reading"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "The whole room leans in.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Rosalind begins to read aloud, each name a stone dropped into a well.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}]}