{"scene_id": "s01361", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01361.fountain", "heading": "INT. TAXIDERMY SHOP, BACK ROOM - NIGHT", "cast": [{"id": 0, "name": "INSPECTOR CALEB ROURKE", "names": ["INSPECTOR CALEB ROURKE", "ROURKE"], "gender": "m", "first": 5, "spoke": 8}, {"id": 1, "name": "OTTOLINE PRATT", "names": ["OTTOLINE PRATT", "PRATT"], "gender": "?", "first": 6, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. TAXIDERMY SHOP, BACK ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Glass eyes in drawers.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A stuffed owl on a shelf.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A work lamp over a half-skinned fox on a steel table.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Sawdust drifts like slow snow.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "INSPECTOR CALEB ROURKE, 50s, tweed coat, notebook, turns a jar of amber eyeballs in his hands and sets it down.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across the table, MRS. OTTOLINE PRATT, 60s, gray bob, rubber apron, scrapes a pelt with a curved knife and does not look up.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Does anyone else work late here?", "name": "ROURKE", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Just me, Inspector.", "name": "PRATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Of course.", "name": "ROURKE", "speaker": 0, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He walks the length of the shelves, peering into glass.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "A badger snarls.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "A heron stares.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He stops at a stuffed spaniel and tilts his head.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "This is a fresh one.", "name": "ROURKE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "He belonged to the baker.", "name": "PRATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "The baker died in March.", "name": "ROURKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "He left instructions.", "name": "PRATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She lifts the pelt and shakes it.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Sawdust hangs in the air.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Rourke touches the spaniel's flank, then draws his fingers back and sniffs them.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Pratt scrapes harder, the knife rasping, the fox on the table seeming to listen, and Rourke crosses to her side, leans on the table, plucks a glass eye from the tray, and holds it to the lamp.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Mrs. Pratt, what is this?", "name": "ROURKE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "An eye.", "name": "PRATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "It's a human eye.", "name": "ROURKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "So it is.", "name": "PRATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "She lays down the knife.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "The owl on the shelf shifts on its perch, just slightly, as if the floor had breathed.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Everyone, stay where you are.", "name": "ROURKE", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "There's no everyone, Inspector.", "name": "PRATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "That's what worries me.", "name": "ROURKE", "speaker": 0, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1]}]}