{"scene_id": "s01362", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01362.fountain", "heading": "INT. LAUNDROMAT - NIGHT", "cast": [{"id": 0, "name": "YUSUF", "names": ["YUSUF"], "gender": "?", "first": 4, "spoke": 3}, {"id": 1, "name": "GRETA", "names": ["GRETA"], "gender": "f", "first": 5, "spoke": 3}, {"id": 2, "name": "LAMAR", "names": ["LAMAR"], "gender": "m", "first": 6, "spoke": 0}, {"id": 3, "name": "WANJIRU", "names": ["WANJIRU"], "gender": "?", "first": 7, "spoke": 2}, {"id": 4, "name": "BARTHOLOMEW", "names": ["BARTHOLOMEW"], "gender": "m", "first": 8, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAUNDROMAT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Humming dryers.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Yellow light.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A row of plastic chairs bolted to the floor.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "YUSUF, 50s, folds shirts.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "GRETA, 40s, stares at a spinning drum.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "LAMAR, 20s, sleeps with his head against a machine.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "WANJIRU, 30s, carries a basket and a toddler's sock, looking for the toddler.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "And BARTHOLOMEW, 70s, sits at the end of the row reading a seed catalogue he has read forty times.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "Yusuf squares a sleeve.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Greta stands, opens her dryer, pulls out a handful of warm towels, sniffs them, and stuffs them back.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Wanjiru lifts the toddler's sock to the light, sets it on a machine, and moves to the next row while Lamar shifts in his sleep and Bartholomew turns a page.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Greta, your towels are done.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "I know.", "name": "GRETA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "You're not taking them out.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Not yet.", "name": "GRETA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Has anyone seen a little boy? Blue shirt, no left shoe?", "name": "WANJIRU", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Sorry.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "No.", "name": "GRETA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Under the folding table.", "name": "BARTHOLOMEW", "speaker": 4, "ext": [], "paren": ["without looking up"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Wanjiru bends.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Under the table, a small boy lies on his stomach, asleep, one shoe off.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "She lifts him.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "He doesn't wake.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "She sets the sock on his foot, balances him on her hip, and carries the basket with her other hand.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Thank you.", "name": "WANJIRU", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Tomatoes this year.", "name": "BARTHOLOMEW", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Wanjiru nods at nothing and goes out.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "The door chimes.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "The dryers keep humming.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}]}