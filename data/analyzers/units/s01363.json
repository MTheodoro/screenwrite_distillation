{"scene_id": "s01363", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01363.fountain", "heading": "INT. BRIDGE OF THE SURVEY SHIP PERIHELION - SHIP'S DAY", "cast": [{"id": 0, "name": "COMMANDER AOIFE BRANNIGAN", "names": ["COMMANDER AOIFE BRANNIGAN", "BRANNIGAN"], "gender": "f", "first": 4, "spoke": 5}, {"id": 1, "name": "TENZIN LHAMO", "names": ["TENZIN LHAMO", "TENZIN"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "RUKMINI SETH", "names": ["RUKMINI SETH", "RUKMINI"], "gender": "?", "first": 6, "spoke": 3}, {"id": 3, "name": "JOSEF HALVORSEN", "names": ["JOSEF HALVORSEN", "JOSEF"], "gender": "?", "first": 7, "spoke": 4}, {"id": 4, "name": "XIMENA TORRES", "names": ["XIMENA TORRES", "XIMENA"], "gender": "f", "first": 8, "spoke": 3}, {"id": 5, "name": "ORACLE", "names": ["ORACLE"], "gender": "?", "first": 9, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. BRIDGE OF THE SURVEY SHIP PERIHELION - SHIP'S DAY", "present": []}, {"u": 1, "kind": "action", "text": "A circular room with a ceiling of living glass, its panes drifting from rose to amber as the star beyond brightens.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Consoles ripple like water.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Six stations, six people, one steady hum.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "COMMANDER AOIFE BRANNIGAN, 50s, white hair cropped close, stands at the central rail with her hands behind her back.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Dr. TENZIN LHAMO, 40s, sits at the spectrometer, scarf wrapped against the cold of the vacuum shield.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "RUKMINI SETH, 30s, pilot, long fingers on the helm sphere.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "JOSEF HALVORSEN, 60s, chief engineer, in a stained jumpsuit, taps a gauge.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "XIMENA TORRES, 20s, navigator, headset askew, twirls a pencil.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "And the sixth is a voice that has no body: the ship's ORACLE.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Perihelion in four minutes.", "name": "ORACLE", "speaker": 5, "ext": ["V.O."], "paren": ["calm, genderless"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Thank you, Oracle.", "name": "BRANNIGAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Spectral lines are doubling.", "name": "TENZIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Hull plating's holding.", "name": "JOSEF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Helm, I'm showing a ripple at point two.", "name": "XIMENA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "I feel it.", "name": "RUKMINI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Thermal shield at ninety-one percent.", "name": "ORACLE", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Josef?", "name": "BRANNIGAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Ninety-one is a good number.", "name": "JOSEF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Commander, there's a signal in the corona.", "name": "TENZIN", "speaker": 1, "ext": [], "paren": ["over Josef"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Pattern repeats every eleven seconds.", "name": "XIMENA", "speaker": 4, "ext": [], "paren": ["over Tenzin"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "It's not noise.", "name": "RUKMINI", "speaker": 2, "ext": [], "paren": ["over Ximena"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Slow down. One at a time. Tenzin.", "name": "BRANNIGAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Eleven pulses, a pause, eleven pulses. Structured.", "name": "TENZIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Stars don't count.", "name": "JOSEF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Oracle. Source?", "name": "BRANNIGAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Source is within the corona. Origin: unknown. Analysis: a message.", "name": "ORACLE", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "The glass overhead turns from amber to a pale, searching gold.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "What does it say?", "name": "XIMENA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Ximena Torres, it says your name.", "name": "ORACLE", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Ximena drops her pencil.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Brannigan does not move.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Hold course. Hold shield. Everyone breathe.", "name": "BRANNIGAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Holding.", "name": "RUKMINI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Holding.", "name": "JOSEF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Holding.", "name": "TENZIN", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "The signal pulses again.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Eleven.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "A pause.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Eleven.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}]}