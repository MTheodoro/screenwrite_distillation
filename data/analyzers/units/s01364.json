{"scene_id": "s01364", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01364.fountain", "heading": "INT. NEONATAL ICU - NIGHT", "cast": [{"id": 0, "name": "GUNNAR ASPLUND", "names": ["GUNNAR ASPLUND", "GUNNAR"], "gender": "m", "first": 4, "spoke": 4}, {"id": 1, "name": "FATIMA HADDAD", "names": ["FATIMA HADDAD", "FATIMA"], "gender": "?", "first": 5, "spoke": 3}, {"id": 2, "name": "SEUN", "names": ["SEUN"], "gender": "?", "first": 6, "spoke": 4}, {"id": 3, "name": "ADEBOYE", "names": ["ADEBOYE"], "gender": "?", "first": 6, "spoke": 0}, {"id": 4, "name": "MARIBEL SOTELO", "names": ["MARIBEL SOTELO", "MARIBEL"], "gender": "f", "first": 7, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. NEONATAL ICU - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Soft blue light.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Incubators like glass bread boxes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Every monitor beats in a different key.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "GUNNAR ASPLUND, 50s, charge nurse, moves between the cribs checking tubes.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "FATIMA HADDAD, 30s, neonatologist, writes on a chart with a stub of pencil.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "OLUWASEUN \"SEUN\" ADEBOYE, 20s, resident, sips from a paper cup.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "MARIBEL SOTELO, 40s, a mother in a hospital gown, sits motionless beside incubator six, her hand pressed flat to the glass.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "Gunnar adjusts a drip.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "Fatima checks a number, writes it, checks it again.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Seun yawns into the cup.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Maribel hums, tuneless.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Bed six, stable.", "name": "GUNNAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Bed six, thank you.", "name": "FATIMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Is she asleep?", "name": "SEUN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "She's looking.", "name": "GUNNAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "She's not allowed to look at the monitor.", "name": "SEUN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Let her.", "name": "FATIMA", "speaker": 1, "ext": [], "paren": ["over Seun"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "He moved his foot.", "name": "MARIBEL", "speaker": 4, "ext": [], "paren": ["over Fatima"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "He did.", "name": "GUNNAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "He did, Mrs. Sotelo. That's very good.", "name": "FATIMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Do I say it's good?", "name": "SEUN", "speaker": 2, "ext": [], "paren": ["to Gunnar"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "It's good.", "name": "GUNNAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "It's very good.", "name": "SEUN", "speaker": 2, "ext": [], "paren": ["to Maribel"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Maribel presses her forehead to the glass.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Her breath fogs it.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Gunnar reaches over and wipes the fog away with his sleeve.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "He crosses to bed four.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "She studies the chart again.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "He yawns again.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "The monitors continue their small, stubborn song.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Fatima glances up at the mother, then at the baby, then writes one more number in the corner of the chart and underlines it twice.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4]}]}