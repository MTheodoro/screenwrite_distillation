{"scene_id": "s01365", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01365.fountain", "heading": "INT. FERRY TERMINAL CAFETERIA - EVENING", "cast": [{"id": 0, "name": "JOSEPHINE ARDEN", "names": ["JOSEPHINE ARDEN", "JOSEPHINE"], "gender": "?", "first": 3, "spoke": 18}, {"id": 1, "name": "RAFAEL OLIVARES", "names": ["RAFAEL OLIVARES", "RAFAEL"], "gender": "m", "first": 5, "spoke": 16}, {"id": 2, "name": "LORRAINE", "names": ["LORRAINE"], "gender": "f", "first": 26, "spoke": 4}, {"id": 3, "name": "OSWIN PRICKETT", "names": ["OSWIN PRICKETT", "OSWIN"], "gender": "f", "first": 41, "spoke": 1}, {"id": 4, "name": "MINNOW", "names": ["MINNOW"], "gender": "?", "first": 42, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. FERRY TERMINAL CAFETERIA - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Formica tables, a steam counter, a window with a view of a gray harbor.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A chalkboard menu offers soup and sandwiches.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "JOSEPHINE ARDEN, 30s, in a camel coat, sits at a corner table with a thermos and a small suitcase.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "She watches the clock.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "action", "text": "RAFAEL OLIVARES, 30s, enters from the rain, shakes his umbrella, and freezes at the door.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "She sees him.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He sees her.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Neither moves.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He crosses the room, hangs his coat on the chair across from hers, and sits.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She pours tea into the thermos lid and slides it to him.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Josephine.", "name": "RAFAEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Rafa.", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "You look well.", "name": "RAFAEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "You look wet.", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "It's raining.", "name": "RAFAEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "I noticed.", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He drinks the tea.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She watches his throat.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She looks away at the harbor, where a ferry shoulders out into the chop.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Is that yours?", "name": "RAFAEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "That one's not.", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "When's yours?", "name": "RAFAEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Nine-forty.", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "That's two hours.", "name": "RAFAEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "It's a long ferry.", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "A waitress, LORRAINE, 50s, calls from the pass-through window, her voice distant, sleepy.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Last orders, folks. Kitchen closes at seven.", "name": "LORRAINE", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Two soups, please.", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": ["to the window"], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Tomato or pea?", "name": "LORRAINE", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "You hate pea.", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": ["to Rafael"], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Pea.", "name": "RAFAEL", "speaker": 1, "ext": [], "paren": ["to the window"], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Rafa.", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "I've changed.", "name": "RAFAEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Josephine's mouth twitches.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "She hides it behind her hand.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Their soups arrive on a tray carried by an unseen hand, set on the counter.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Rafael stands, collects them, sets them down.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "They eat.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Spoons clink on bowls.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "The ferry horn sounds, deep, far away.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "OSWIN PRICKETT, 60s, a porter in a peaked cap, stops at the table and nods at her suitcase.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "A small girl, MINNOW, 7, hides behind his leg.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Miss, the nine-forty's boarding early.", "name": "OSWIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Thank you, Mr. Prickett.", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Minnow stares at Rafael, then at Josephine, then at their joined shadows on the table.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Oswin steers her away.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "How is she?", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Who?", "name": "RAFAEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "The woman who lives in your apartment.", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "She moved out.", "name": "RAFAEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "I'm sorry.", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "Don't be. She took the couch.", "name": "RAFAEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "She always liked that couch.", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "Everyone did.", "name": "RAFAEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Silence.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "He stirs the soup.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "She pushes a crust around her plate.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "The rain intensifies on the window.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "Is it a good job?", "name": "RAFAEL", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "It's a long way off.", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "I'd like to see where.", "name": "RAFAEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "dialogue", "text": "You'd hate it.", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "dialogue", "text": "Probably.", "name": "RAFAEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "dialogue", "text": "Folks, we're closing.", "name": "LORRAINE", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "One more minute.", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": ["to the window"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "dialogue", "text": "One more minute.", "name": "LORRAINE", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "action", "text": "Rafael sets his spoon down and reaches across the table.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "action", "text": "His fingers rest on the edge of her thermos lid, not touching her hand.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "She doesn't move hers away.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "dialogue", "text": "Your tea's cold.", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "dialogue", "text": "I like it cold now.", "name": "RAFAEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "action", "text": "She almost laughs.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "action", "text": "She turns her hand over.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "action", "text": "He takes it.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "action", "text": "They sit like that, hands joined across the Formica, while the ferry lights drift out of view and the rain goes on.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4]}]}