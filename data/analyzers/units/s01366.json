{"scene_id": "s01366", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01366.fountain", "heading": "INT. HOTEL BALLROOM, EMPTY - DAWN", "cast": [{"id": 0, "name": "CLEMENTINE ASHFORD", "names": ["CLEMENTINE ASHFORD", "CLEMENTINE"], "gender": "f", "first": 5, "spoke": 14}, {"id": 1, "name": "HUGO BELMONT", "names": ["HUGO BELMONT", "HUGO"], "gender": "?", "first": 6, "spoke": 13}, {"id": 2, "name": "PROSPER", "names": ["PROSPER"], "gender": "?", "first": 28, "spoke": 1}, {"id": 3, "name": "VIVIAN BELMONT", "names": ["VIVIAN BELMONT", "VIVIAN"], "gender": "?", "first": 6, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOTEL BALLROOM, EMPTY - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A vast chandeliered room stripped after a wedding.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of gold chairs stacked in towers.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Streamers on the floor.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Pale light creeping through tall windows.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CLEMENTINE ASHFORD, 30s, in a rumpled bridesmaid's gown, kicks off her heels and sits on the edge of the stage with a bottle of champagne.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "HUGO BELMONT, 30s, in a tuxedo with the tie undone, leans on a stack of chairs.", "para": 1, "sent": 1, "present": [0, 1, 3]}, {"u": 7, "kind": "dialogue", "text": "You stayed.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 8, "kind": "dialogue", "text": "I thought someone ought to.", "name": "HUGO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 9, "kind": "dialogue", "text": "It's six in the morning.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 10, "kind": "dialogue", "text": "Is that what the light means?", "name": "HUGO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 11, "kind": "dialogue", "text": "It's a very honest light.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 12, "kind": "dialogue", "text": "Then I'll be honest too. I wasn't staying for the wedding.", "name": "HUGO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 13, "kind": "dialogue", "text": "No?", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 14, "kind": "dialogue", "text": "No.", "name": "HUGO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 15, "kind": "dialogue", "text": "Who were you staying for?", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 16, "kind": "dialogue", "text": "The woman who danced with the groom's grandfather for three songs.", "name": "HUGO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 17, "kind": "dialogue", "text": "He taught me the waltz.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 18, "kind": "dialogue", "text": "He taught you well.", "name": "HUGO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 19, "kind": "dialogue", "text": "He taught me everything but how to leave a party.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 20, "kind": "dialogue", "text": "You're doing fine.", "name": "HUGO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 21, "kind": "dialogue", "text": "Am I?", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 22, "kind": "dialogue", "text": "You're sitting in a ballroom with a stranger and a bottle.", "name": "HUGO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 23, "kind": "dialogue", "text": "I wouldn't call you a stranger anymore.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 24, "kind": "dialogue", "text": "What would you call me?", "name": "HUGO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 25, "kind": "dialogue", "text": "Hugo.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 26, "kind": "dialogue", "text": "That's all?", "name": "HUGO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 27, "kind": "dialogue", "text": "That's a great deal, Hugo.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 28, "kind": "action", "text": "A waiter, PROSPER, 20s, wheels in a bussing cart, whistling, and stops dead.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Ma'am, sir. We close the room at six.", "name": "PROSPER", "speaker": 2, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Then close it behind us.", "name": "HUGO", "speaker": 1, "ext": [], "paren": ["to Prosper"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "A door at the back opens.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "VIVIAN BELMONT, 60s, in a dressing gown and curlers, stands in the doorway with a mop.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Everyone out! The cleaners are coming!", "name": "VIVIAN", "speaker": 3, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Mother.", "name": "HUGO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Hugo, put on your tie.", "name": "VIVIAN", "speaker": 3, "ext": [], "paren": ["to Hugo"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Of course she's his mother.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "And you, my dear, are the girl who sang flat.", "name": "VIVIAN", "speaker": 3, "ext": [], "paren": ["to Clementine"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "I was sharp.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Beautifully sharp. Sit. I'll bring coffee.", "name": "VIVIAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "She goes.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Hugo and Clementine stare after her.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Clementine puts down the bottle.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "I think I'm in love with your mother.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Everyone is. It's tiresome.", "name": "HUGO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}