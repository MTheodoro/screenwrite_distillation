{"scene_id": "s01368", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01368.fountain", "heading": "INT. SURGICAL OBSERVATION GALLERY - DAY", "cast": [{"id": 0, "name": "ELEANOR WHITLOCK", "names": ["ELEANOR WHITLOCK", "WHITLOCK"], "gender": "f", "first": 5, "spoke": 6}, {"id": 1, "name": "VIKRAM RAO", "names": ["VIKRAM RAO", "RAO"], "gender": "m", "first": 6, "spoke": 6}, {"id": 2, "name": "NURSE SINEAD DUFFY", "names": ["NURSE SINEAD DUFFY", "SINEAD"], "gender": "?", "first": 7, "spoke": 5}, {"id": 3, "name": "RESIDENT TAKUMI IKEDA", "names": ["RESIDENT TAKUMI IKEDA", "TAKUMI"], "gender": "?", "first": 8, "spoke": 5}, {"id": 4, "name": "INTERN PALOMA RIVERA", "names": ["INTERN PALOMA RIVERA", "PALOMA"], "gender": "f", "first": 9, "spoke": 4}, {"id": 5, "name": "LESZEK BUKOWSKI", "names": ["LESZEK BUKOWSKI", "BUKOWSKI"], "gender": "m", "first": 10, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. SURGICAL OBSERVATION GALLERY - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A tiered room above an operating theater, glass wall onto green tiles and white light.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Folding chairs on a stepped floor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A pot of lukewarm coffee, untouched.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Beyond the glass, a quiet operation unfolds without a sound.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. ELEANOR WHITLOCK, 60s, chief of surgery, silver bob and half-moon glasses, sits front and center with a clipboard on her knee.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "DR. VIKRAM RAO, 40s, lean, in a charcoal sweater, stands with his arms folded at the glass.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "NURSE SINEAD DUFFY, 30s, freckled, ties off a supply bag.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "RESIDENT TAKUMI IKEDA, 20s, hollow-eyed, nods over a clipboard.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "INTERN PALOMA RIVERA, 20s, bright-eyed, takes notes with great seriousness.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "And Mr. LESZEK BUKOWSKI, 70s, an elderly volunteer observer in a corduroy jacket and a hospital visitor's badge, sits in the back row with a paper bag of lemon drops.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "Below, the surgeons work.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "Nothing seems to happen.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "A hand moves.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "A suture is pulled.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Dr. Rao, how long has the cardiac been under?", "name": "WHITLOCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Three hours and ten minutes.", "name": "RAO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Is that long?", "name": "WHITLOCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "For this one, it's average.", "name": "RAO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Three hours, ten minutes, average.", "name": "PALOMA", "speaker": 4, "ext": [], "paren": ["writing"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "It feels longer.", "name": "TAKUMI", "speaker": 3, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "It always does from up here.", "name": "SINEAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Bukowski unwraps a lemon drop and pops it in his mouth.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "The wrapper crackles.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Everyone turns.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "He holds up the bag.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Anyone?", "name": "BUKOWSKI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Mr. Bukowski, this is a sterile gallery.", "name": "WHITLOCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "It's a lemon drop.", "name": "BUKOWSKI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Let him have it, Eleanor.", "name": "RAO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "I will, Vikram. Provided he does not choke.", "name": "WHITLOCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "I'm seventy-three. I've outlived four cardiologists.", "name": "BUKOWSKI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "That's not the comfort you think it is, Mr. Bukowski.", "name": "SINEAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Paloma giggles, claps a hand over her mouth.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Takumi's head sinks lower.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Below, the surgeon gestures; a monitor beeps; a gloved hand lifts a clamp.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Is that the valve?", "name": "PALOMA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "That's the valve.", "name": "RAO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "It's beautiful.", "name": "PALOMA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "It's a pump with a door, Paloma.", "name": "RAO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "A beautiful pump with a door.", "name": "PALOMA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Intern, you're learning.", "name": "WHITLOCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Bukowski offers the bag to Takumi.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Takumi, half asleep, takes a lemon drop without looking.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Sinead catches Paloma's eye and rolls her own.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Rao paces to the end of the glass, turns, comes back.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Whitlock marks something on her sheet.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "Did I miss something?", "name": "TAKUMI", "speaker": 3, "ext": [], "paren": ["waking"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "Only the valve.", "name": "SINEAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "Damn.", "name": "TAKUMI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "Dr. Ikeda.", "name": "WHITLOCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "Sorry, Chief.", "name": "TAKUMI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "He'll watch the closing.", "name": "RAO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "I'll watch the closing.", "name": "TAKUMI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "What closes?", "name": "BUKOWSKI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "The chest.", "name": "SINEAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "How long does that take?", "name": "BUKOWSKI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "About as long as it takes you to finish that bag.", "name": "SINEAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "Bukowski regards the bag, shakes it, counts, and sighs.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "Then I'd better ration.", "name": "BUKOWSKI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "action", "text": "The monitor below settles into a long, even rhythm.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "In the gallery, five of them turn to watch the closing, and one, Bukowski, puts the bag away.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}