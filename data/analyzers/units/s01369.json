{"scene_id": "s01369", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01369.fountain", "heading": "INT. FAMILY KITCHEN - MORNING", "cast": [{"id": 0, "name": "GRANDPA FELIX", "names": ["GRANDPA FELIX", "FELIX"], "gender": "?", "first": 4, "spoke": 3}, {"id": 1, "name": "MOM RHONDA", "names": ["MOM RHONDA", "RHONDA"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "DAD CYRUS", "names": ["DAD CYRUS", "CYRUS"], "gender": "m", "first": 6, "spoke": 3}, {"id": 3, "name": "TILLY", "names": ["TILLY"], "gender": "f", "first": 7, "spoke": 2}, {"id": 4, "name": "JOJO", "names": ["JOJO"], "gender": "m", "first": 8, "spoke": 1}, {"id": 5, "name": "KIT", "names": ["KIT"], "gender": "?", "first": 9, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. FAMILY KITCHEN - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Cereal boxes.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A burning toaster.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Sunlight on yellow linoleum.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "GRANDPA FELIX, 70s, in a bathrobe, reads a newspaper upside-down.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "MOM RHONDA, 40s, shoves lunches into bags.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "DAD CYRUS, 40s, hunts for his keys.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "TILLY, 12, scowls over her phone.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "JOJO, 8, balances a spoon on his nose.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "And baby KIT, 2, bangs a pot lid on the high chair tray.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "Cyrus opens a drawer and slams it.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "Rhonda hands Tilly a lunch.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "Tilly drops it.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "Jojo's spoon falls into the cereal.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "Felix turns the paper right side up.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Who has the keys?", "name": "RHONDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Not me.", "name": "CYRUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Not me.", "name": "TILLY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Not me!", "name": "JOJO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Not at my age.", "name": "FELIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Kit?", "name": "RHONDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Bam!", "name": "KIT", "speaker": 5, "ext": [], "paren": ["banging"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "She's got them.", "name": "CYRUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Rhonda lifts Kit, who clutches the keys in a sticky fist.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "She pries them loose.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Kit wails.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Jojo dives to catch the falling spoon.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Tilly bursts out laughing.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Everybody, lunch, coats, now.", "name": "RHONDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "I'd like it noted I did nothing wrong.", "name": "FELIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Grandpa, you're reading it upside down.", "name": "TILLY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "It's better that way.", "name": "FELIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "They scatter.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Coats fly.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "The toaster smokes.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Cyrus yanks the plug.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Quiet falls like a dropped plate.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Same time tomorrow?", "name": "RHONDA", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Yes please.", "name": "CYRUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}