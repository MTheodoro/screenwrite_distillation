{"scene_id": "s01370", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01370.fountain", "heading": "INT. ICE HOUSE - BEHIND THE LIVERY - DAY", "cast": [{"id": 0, "name": "OTIS WREN", "names": ["OTIS WREN", "OTIS"], "gender": "?", "first": 4, "spoke": 15}, {"id": 1, "name": "IDA MARROW", "names": ["IDA MARROW", "IDA"], "gender": "?", "first": 9, "spoke": 20}, {"id": 2, "name": "WADE WREN", "names": ["WADE WREN", "WADE"], "gender": "?", "first": 4, "spoke": 13}, {"id": 3, "name": "SILAS PRUETT", "names": ["SILAS PRUETT", "SILAS"], "gender": "m", "first": 61, "spoke": 14}], "units": [{"u": 0, "kind": "heading", "text": "INT. ICE HOUSE - BEHIND THE LIVERY - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Sawdust floors.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Blocks of river ice stacked to the rafters, steaming in the heat.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Cold breath hangs in the air.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "OTIS WREN, 60s, leather apron, hands like split kindling, chips at a block with a pick.", "para": 1, "sent": 0, "present": [0, 2]}, {"u": 5, "kind": "action", "text": "Slow.", "para": 1, "sent": 1, "present": [0, 2]}, {"u": 6, "kind": "action", "text": "Methodical.", "para": 1, "sent": 2, "present": [0, 2]}, {"u": 7, "kind": "action", "text": "The door scrapes open.", "para": 2, "sent": 0, "present": [0, 2]}, {"u": 8, "kind": "action", "text": "Light cuts the dark.", "para": 2, "sent": 1, "present": [0, 2]}, {"u": 9, "kind": "action", "text": "IDA MARROW, 30s, dust-caked duster, rifle sling across her chest, steps in.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "She lets the door close behind her.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He doesn't look up.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Ice is two bits a pound.", "name": "OTIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "I'm not buying ice.", "name": "IDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "He keeps chipping.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "She walks the aisle between the stacks.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Runs a glove along the frost.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Then you're lost.", "name": "OTIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Your boy Wade. Where is he?", "name": "IDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "The pick stops.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "He sets it down.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Wipes his hands on the apron, one finger at a time.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Wade's in Cheyenne.", "name": "OTIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Wade was in Cheyenne in March.", "name": "IDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Behind a far stack, a boot scuffs.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "She hears it.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "He hears her hear it.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Rats.", "name": "OTIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Big ones.", "name": "IDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "She slides the rifle off her shoulder.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Doesn't raise it.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Lets it hang.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "WADE WREN, 20s, thin, sunburned, steps out from the ice with a pistol low against his thigh.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "His eyes are red-rimmed.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "He hasn't slept.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Pa, go back to work.", "name": "WADE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Son, hush.", "name": "OTIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "She's alone.", "name": "WADE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Am I?", "name": "IDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Wade glances at the door.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "At the dark gaps between the stacks.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "His grip tightens.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "You're bluffing.", "name": "WADE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Maybe.", "name": "IDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Silence.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Water drips from the rafters.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "It ticks on the sawdust.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "What'd he take from you?", "name": "OTIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "My brother's horse. And my brother's life, after.", "name": "IDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "He drew first.", "name": "WADE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "He was nineteen. He was holding a hat.", "name": "IDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Wade flinches.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Otis sees it.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Something in the old man's shoulders drops a half inch.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "Wade.", "name": "OTIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "He had his hand under his coat.", "name": "WADE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "For the hat.", "name": "IDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "Put the pistol down.", "name": "OTIS", "speaker": 0, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "No.", "name": "WADE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "A thin figure moves in the doorway, backlit.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "A shadow first, then a man.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "SILAS PRUETT, 50s, tin star on a faded vest, holds a shotgun with both hands.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "He walks in like a man paying a debt.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "Evening, all.", "name": "SILAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "It's noon.", "name": "IDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "Feels later.", "name": "SILAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "He stops by the ice block nearest Otis.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "Takes in the room.", "para": 15, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "Three people.", "para": 15, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "Two guns.", "para": 15, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "One question.", "para": 15, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "dialogue", "text": "Wade, you're under arrest.", "name": "SILAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "For what?", "name": "WADE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "Murder, son. I've got a warrant in my pocket I've been carrying three weeks.", "name": "SILAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "dialogue", "text": "Three weeks.", "name": "OTIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "dialogue", "text": "I'm slow.", "name": "SILAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "dialogue", "text": "You're late.", "name": "IDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "dialogue", "text": "Same thing.", "name": "SILAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "action", "text": "Wade's pistol swings between them.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "action", "text": "Silas.", "para": 16, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "action", "text": "Ida.", "para": 16, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "action", "text": "Silas.", "para": 16, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "action", "text": "His breath comes shallow and fast.", "para": 16, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "dialogue", "text": "I ain't going to hang.", "name": "WADE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 84, "kind": "dialogue", "text": "Nobody's hanging anybody today.", "name": "SILAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 85, "kind": "dialogue", "text": "I'd like to.", "name": "IDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 86, "kind": "dialogue", "text": "I know you would, ma'am.", "name": "SILAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 87, "kind": "action", "text": "Otis takes one step.", "para": 17, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 88, "kind": "action", "text": "Puts himself between his son and the rifle.", "para": 17, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 89, "kind": "action", "text": "Arms open, palms out.", "para": 17, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 90, "kind": "dialogue", "text": "Everybody breathe.", "name": "OTIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 91, "kind": "action", "text": "Nobody does.", "para": 18, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 92, "kind": "action", "text": "A block of ice shifts overhead.", "para": 19, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 93, "kind": "action", "text": "Groans.", "para": 19, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 94, "kind": "action", "text": "Cracks.", "para": 19, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 95, "kind": "action", "text": "They all look up.", "para": 20, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 96, "kind": "dialogue", "text": "That's the chain.", "name": "OTIS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 97, "kind": "dialogue", "text": "Move.", "name": "SILAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 98, "kind": "dialogue", "text": "Don't tell me--", "name": "WADE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 99, "kind": "dialogue", "text": "^ Move!", "name": "SILAS", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 100, "kind": "dialogue", "text": "^ Get out of there!", "name": "IDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 101, "kind": "action", "text": "The chain snaps.", "para": 21, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 102, "kind": "action", "text": "A block the size of a wagon bed drops, hits the floor, and bursts.", "para": 21, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 103, "kind": "action", "text": "Shards fly.", "para": 21, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 104, "kind": "action", "text": "Everyone dives.", "para": 21, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 105, "kind": "action", "text": "Silence.", "para": 22, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 106, "kind": "action", "text": "Then coughing.", "para": 22, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 107, "kind": "action", "text": "Ice dust drifts like smoke.", "para": 22, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 108, "kind": "action", "text": "Wade scrambles up first, pistol still in hand, ears ringing.", "para": 23, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 109, "kind": "action", "text": "He sees Ida on one knee, rifle raised, trained on his chest.", "para": 23, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 110, "kind": "action", "text": "He raises his own.", "para": 24, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 111, "kind": "action", "text": "Both freeze.", "para": 25, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 112, "kind": "dialogue", "text": "Drop it.", "name": "IDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 113, "kind": "dialogue", "text": "You drop it.", "name": "WADE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 114, "kind": "action", "text": "Silas drags himself upright behind the shattered block, shotgun levelled at them both.", "para": 26, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 115, "kind": "action", "text": "Blood on his forehead.", "para": 26, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 116, "kind": "action", "text": "His hands do not shake.", "para": 26, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 117, "kind": "dialogue", "text": "Nobody's dropping anything.", "name": "SILAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 118, "kind": "action", "text": "Otis is on the floor.", "para": 27, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 119, "kind": "action", "text": "A shard of ice has pinned his leg.", "para": 27, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 120, "kind": "action", "text": "He groans, grips the sawdust.", "para": 27, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 121, "kind": "dialogue", "text": "Wade.", "name": "OTIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 122, "kind": "action", "text": "Wade looks down.", "para": 28, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 123, "kind": "action", "text": "His father's face is gray.", "para": 28, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 124, "kind": "dialogue", "text": "Look at me. Not her.", "name": "OTIS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 125, "kind": "action", "text": "Wade looks.", "para": 29, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 126, "kind": "action", "text": "His pistol wavers.", "para": 29, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 127, "kind": "action", "text": "Ida's finger moves on the trigger.", "para": 30, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 128, "kind": "action", "text": "Silas sees it.", "para": 30, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 129, "kind": "dialogue", "text": "Ida Marrow. Don't.", "name": "SILAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 130, "kind": "dialogue", "text": "Why not?", "name": "IDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 131, "kind": "dialogue", "text": "Because I'm the one who's going to have to write it up.", "name": "SILAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 132, "kind": "action", "text": "A beat.", "para": 31, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 133, "kind": "action", "text": "Almost a laugh.", "para": 31, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 134, "kind": "action", "text": "It doesn't land.", "para": 31, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 135, "kind": "action", "text": "Wade takes a breath.", "para": 32, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 136, "kind": "action", "text": "Another.", "para": 32, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 137, "kind": "action", "text": "He lowers the pistol an inch.", "para": 32, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 138, "kind": "action", "text": "Two.", "para": 32, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 139, "kind": "action", "text": "Ida doesn't.", "para": 33, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 140, "kind": "dialogue", "text": "Say his name.", "name": "IDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 141, "kind": "dialogue", "text": "What?", "name": "WADE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 142, "kind": "dialogue", "text": "My brother. Say it.", "name": "IDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 143, "kind": "action", "text": "Wade's mouth works.", "para": 34, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 144, "kind": "action", "text": "Nothing comes.", "para": 34, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 145, "kind": "dialogue", "text": "Say it, boy.", "name": "OTIS", "speaker": 0, "ext": [], "paren": ["through his teeth"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 146, "kind": "dialogue", "text": "Tom.", "name": "WADE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 147, "kind": "dialogue", "text": "Tom what?", "name": "IDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 148, "kind": "dialogue", "text": "Tom Marrow.", "name": "WADE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 149, "kind": "action", "text": "She holds the rifle on him another long second.", "para": 35, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 150, "kind": "action", "text": "Then the barrel dips.", "para": 35, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 151, "kind": "action", "text": "Wade drops the pistol.", "para": 36, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 152, "kind": "action", "text": "It thuds into the sawdust.", "para": 36, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 153, "kind": "action", "text": "Silas moves in fast.", "para": 37, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 154, "kind": "action", "text": "Cuffs.", "para": 37, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 155, "kind": "action", "text": "Click, click.", "para": 37, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 156, "kind": "action", "text": "Wade doesn't resist.", "para": 37, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 157, "kind": "action", "text": "He's crying without a sound.", "para": 37, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 158, "kind": "action", "text": "Ida stands over Otis.", "para": 38, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 159, "kind": "action", "text": "Lifts the ice shard off his leg with one hard heave.", "para": 38, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 160, "kind": "action", "text": "Tosses it aside.", "para": 38, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 161, "kind": "dialogue", "text": "Why'd you do that?", "name": "OTIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 162, "kind": "dialogue", "text": "Somebody should leave this place standing.", "name": "IDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 163, "kind": "action", "text": "She shoulders the rifle.", "para": 39, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 164, "kind": "action", "text": "Walks to the door.", "para": 39, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 165, "kind": "action", "text": "Light pours around her.", "para": 39, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 166, "kind": "dialogue", "text": "Ma'am. You'll need to testify.", "name": "SILAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 167, "kind": "dialogue", "text": "I know.", "name": "IDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 168, "kind": "action", "text": "She goes.", "para": 40, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 169, "kind": "action", "text": "The door scrapes shut.", "para": 40, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 170, "kind": "action", "text": "Drip.", "para": 41, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 171, "kind": "action", "text": "Drip.", "para": 41, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 172, "kind": "action", "text": "The ice keeps melting.", "para": 41, "sent": 2, "present": [0, 1, 2, 3]}]}