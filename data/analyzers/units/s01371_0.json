{"scene_id": "s01371_0", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01371.fountain", "heading": "INT. LIGHTHOUSE KEEPER'S COTTAGE - KITCHEN - NIGHT", "cast": [{"id": 0, "name": "PENNY ALDERWICK", "names": ["PENNY ALDERWICK", "PENNY"], "gender": "f", "first": 4, "spoke": 4}, {"id": 1, "name": "RADIO", "names": ["RADIO"], "gender": "m", "first": 6, "spoke": 0}, {"id": 2, "name": "FATHER", "names": ["FATHER"], "gender": "m", "first": 8, "spoke": 4}, {"id": 3, "name": "SHUTTER BANGS", "names": ["SHUTTER BANGS"], "gender": "?", "first": 19, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. LIGHTHOUSE KEEPER'S COTTAGE - KITCHEN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A storm rattles the shutters.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A coal stove glows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "On the table, a half-built model ship, a jar of glue, and a pot of cocoa gone cold.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "PENNY ALDERWICK, 9, in her father's too-big wool sweater, kneels on a chair and fits a tiny mast into the deck.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her tongue sticks out in concentration.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "A RADIO crackles on the shelf.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "A hiss of static, then a man's warm voice.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Lighthouse base, this is the supply boat Gannet. Penny, you there?", "name": "FATHER", "speaker": 2, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "She lunges for the radio.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Presses the button.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I'm here, Papa! Over!", "name": "PENNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "How's the lamp?", "name": "FATHER", "speaker": 2, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Turning. I counted. Forty-one seconds each time, just like you said.", "name": "PENNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "That's my girl. Seas are rough. I'll be an hour late, maybe two. Keep the stove fed and stay put.", "name": "FATHER", "speaker": 2, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Can I stay up?", "name": "PENNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Until I'm home.", "name": "FATHER", "speaker": 2, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "She grins.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Sets the radio down gently, as if it might break.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "A SHUTTER BANGS somewhere upstairs.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Penny freezes.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Looks at the ceiling.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "It's just wind.", "name": "PENNY", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "She climbs down and lifts the oil lantern.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Creeps to the stairs.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "The light throws her shadow huge on the wall.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}]}