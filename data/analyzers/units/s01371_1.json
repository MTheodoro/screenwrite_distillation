{"scene_id": "s01371_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01371.fountain", "heading": "INT. LIGHTHOUSE COTTAGE - STAIRS - CONTINUOUS", "cast": [{"id": 0, "name": "SHADOW", "names": ["SHADOW"], "gender": "?", "first": 8, "spoke": 0}, {"id": 1, "name": "EZRA TULLY", "names": ["EZRA TULLY", "EZRA"], "gender": "m", "first": 13, "spoke": 6}, {"id": 2, "name": "PENNY", "names": ["PENNY"], "gender": "f", "first": 9, "spoke": 4}, {"id": 3, "name": "RADIO", "names": ["RADIO"], "gender": "m", "first": 32, "spoke": 0}, {"id": 4, "name": "FATHER", "names": ["FATHER"], "gender": "m", "first": 34, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. LIGHTHOUSE COTTAGE - STAIRS - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Each step creaks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "At the top, a window hangs open.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain whips in.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The curtain flaps like a ghost.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "She runs to it.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "Strains to pull the sash down.", "para": 1, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "It sticks.", "para": 1, "sent": 2, "present": []}, {"u": 8, "kind": "action", "text": "A SHADOW falls across the glass from outside.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Penny gasps.", "para": 3, "sent": 0, "present": [0, 2]}, {"u": 10, "kind": "action", "text": "Backs away.", "para": 3, "sent": 1, "present": [0, 2]}, {"u": 11, "kind": "action", "text": "A face presses to the window, pale and wet.", "para": 4, "sent": 0, "present": [0, 2]}, {"u": 12, "kind": "action", "text": "A knuckle raps the pane.", "para": 4, "sent": 1, "present": [0, 2]}, {"u": 13, "kind": "action", "text": "EZRA TULLY, 70s, drenched yellow oilskins, white beard dripping, gestures frantically at the latch.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "His boat lantern swings from one hand.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Let me in, child! I'm half drowned!", "name": "EZRA", "speaker": 1, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Penny stares.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Her lantern shakes.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Papa says not to open the door to strangers.", "name": "PENNY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I'm no stranger! I'm the lamp-man from Skerry Point! Your father's friend!", "name": "EZRA", "speaker": 1, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "What's his name, then?", "name": "PENNY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Harold! He drinks his tea with a pinch of salt!", "name": "EZRA", "speaker": 1, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Penny's eyes widen.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "That's right.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "She hesitates, then yanks the latch.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "The window swings wide.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Ezra tumbles over the sill in a heap of dripping canvas, laughing and wheezing.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Bless you. My engine died a mile out. I rowed the whole way.", "name": "EZRA", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "You'd better come down. There's cocoa.", "name": "PENNY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Cold?", "name": "EZRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Yes.", "name": "PENNY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Perfect. I'm too wet to be fussy.", "name": "EZRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The RADIO hisses downstairs.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Faint, urgent.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Penny? Penny, answer me!", "name": "FATHER", "speaker": 4, "ext": ["V.O."], "paren": ["over radio, distant"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "She sprints down the stairs.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Ezra follows, dripping, as fast as old knees allow.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}]}