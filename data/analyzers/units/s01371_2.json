{"scene_id": "s01371_2", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01371.fountain", "heading": "INT. LIGHTHOUSE COTTAGE - KITCHEN - CONTINUOUS", "cast": [{"id": 0, "name": "PENNY", "names": ["PENNY"], "gender": "f", "first": 1, "spoke": 4}, {"id": 1, "name": "FATHER", "names": ["FATHER"], "gender": "m", "first": 5, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. LIGHTHOUSE COTTAGE - KITCHEN - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Penny grabs the radio and presses the button.", "para": 0, "sent": 0, "present": [0]}, {"u": 2, "kind": "dialogue", "text": "Papa! I'm here! Somebody came! Mister Tully rowed over and he's all wet!", "name": "PENNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 3, "kind": "action", "text": "Static.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "Then the father's voice, tight.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "dialogue", "text": "Who?", "name": "FATHER", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Mister Tully. From Skerry Point. He knew about the salt.", "name": "PENNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "A long pause.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "The storm howls.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Penny. Ezra Tully died in March.", "name": "FATHER", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Penny turns, slowly.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Ezra stands in the doorway, smiling gently.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "The water dripping from his coat makes no sound on the floor.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "The lantern in her hand goes out.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Papa?", "name": "PENNY", "speaker": 0, "ext": [], "paren": ["barely a whisper"], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Stay where you are. Keep the lamp turning. I'm coming.", "name": "FATHER", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Above them, the great lamp swings its beam across the window.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "One flash.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Ezra is gone.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Only the wet footprints remain.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Penny holds the radio to her chest.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Starts counting.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "One. Two. Three...", "name": "PENNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}