{"scene_id": "s01372", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01372.fountain", "heading": "EXT. GLASS ORCHARD - DUSK", "cast": [{"id": 0, "name": "BRIAR", "names": ["BRIAR"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "TAMSIN", "names": ["TAMSIN"], "gender": "?", "first": 8, "spoke": 3}, {"id": 2, "name": "KESTREL VANE", "names": ["KESTREL VANE", "KESTREL"], "gender": "?", "first": 26, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. GLASS ORCHARD - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "Trees of blown glass.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fruit that hums.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wind makes them chime.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "BRIAR, 40s, a pruner in a moss-colored coat, works a ladder.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Snip.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Snip.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "She doesn't look down.", "para": 1, "sent": 3, "present": [0]}, {"u": 8, "kind": "action", "text": "At the base, TAMSIN, 20s, holds the ladder.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Her knuckles are white.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "You said you'd stop at dusk.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "It's not dusk.", "name": "BRIAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Tamsin looks west.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "The sun is a thumbnail above the hills.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "It's nearly.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Snip.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "A glass pear drops.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Tamsin catches it.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "It sings in her palm, one thin note.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Put it in the basket.", "name": "BRIAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She doesn't.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She holds it.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Closes her fingers around it.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "A shadow moves between the trees.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Slow.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Wrong-shaped.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "KESTREL VANE, 60s, a crown of brass antlers, steps into the lane.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Bare feet.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "No sound on the gravel.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Briar stops cutting.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "The chimes die.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Evening, sisters.", "name": "KESTREL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Not your orchard anymore.", "name": "BRIAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Not yours either.", "name": "KESTREL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Tamsin's fist tightens.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "The pear cracks.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "A hairline of light runs through it.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Briar.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Hold the ladder.", "name": "BRIAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "The pear shatters.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Every tree in the orchard rings at once, a scream of glass.", "para": 10, "sent": 1, "present": [0, 1, 2]}]}