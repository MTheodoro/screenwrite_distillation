{"scene_id": "s01374", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01374.fountain", "heading": "INT. MINIATURE GOLF COURSE - CLUBHOUSE - DAY", "cast": [{"id": 0, "name": "DENNIS OKAFOR", "names": ["DENNIS OKAFOR", "DENNIS"], "gender": "?", "first": 5, "spoke": 15}, {"id": 1, "name": "CAPTAIN HOOK", "names": ["CAPTAIN HOOK"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "MARISOL BELTRAN", "names": ["MARISOL BELTRAN", "MARISOL"], "gender": "f", "first": 7, "spoke": 15}, {"id": 3, "name": "BIG LOU PACHECO", "names": ["BIG LOU PACHECO", "BIG LOU"], "gender": "?", "first": 56, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. MINIATURE GOLF COURSE - CLUBHOUSE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A cramped clubhouse shaped like a pirate ship.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Plastic parrots on every shelf.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A faded scoreboard.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The air smells of nacho cheese and carpet glue.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DENNIS OKAFOR, 40s, in a sun-bleached polo that reads CAPTAIN HOOK'S, sits behind the counter counting quarters into paper rolls.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "He is the calmest man alive.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Across the counter, MARISOL BELTRAN, 30s, tidy blazer, clipboard, sharp ponytail, waits with a polite smile.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Thank you for seeing me, Mr. Okafor.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Call me Dennis. Everybody does.", "name": "DENNIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Dennis. I'm with the county inspector's office.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "That's nice. Quarter?", "name": "DENNIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "He offers her one.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She declines.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "This is a routine visit.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "I love routine.", "name": "DENNIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Your last inspection was fourteen months ago.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Time flies when you're having fun.", "name": "DENNIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "She flips a page.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Makes a mark.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "He keeps counting, perfectly relaxed.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "I'll need to see the electrical panel.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Back by the windmill. Hole nine.", "name": "DENNIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "And the fire exits.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Hole twelve has a very nice one. It's the volcano.", "name": "DENNIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "The volcano is the fire exit?", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "It's themed.", "name": "DENNIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "She almost smiles.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Catches herself.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Writes something.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "And your permit for the animal attractions.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "We don't have animals.", "name": "DENNIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "The sign out front says LIVE ALLIGATOR.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "That's a lie. I mean, a joke. A marketing joke.", "name": "DENNIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Is it?", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "It's fiberglass. His name is Kevin.", "name": "DENNIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "From the back of the clubhouse comes a low, wet THUMP.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Then a scrape of claws on linoleum.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Dennis keeps counting.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "A quarter rolls off the counter.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "What was that?", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Pipes.", "name": "DENNIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "That sounded like a--", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Old building. Very expressive pipes.", "name": "DENNIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "THUMP.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Something large and unseen slides into a stack of plastic buckets.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "They clatter.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Marisol sets down her clipboard.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Slowly.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Dennis.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Yes, ma'am.", "name": "DENNIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Open the back room.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Dennis sighs.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Finally sets down the quarters.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Shuffles to the door, unhooks a small brass latch.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Before he can turn the handle, it bursts open from inside.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "BIG LOU PACHECO, 50s, wet suit unzipped to the waist, bandaged forearm, and a cooler under one arm, stumbles out.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Behind him, in the dim storeroom, a four-foot alligator blinks at the light.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "Dennis, he ate the hush puppies.", "name": "BIG LOU", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "Silence.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "The alligator hisses.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "Marisol looks at Dennis.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "Dennis looks at the ceiling.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "That's Kevin.", "name": "DENNIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "That is not fiberglass.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "He's a different Kevin.", "name": "DENNIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}