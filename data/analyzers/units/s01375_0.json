{"scene_id": "s01375_0", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01375.fountain", "heading": "INT. LAMPLIGHTERS' GUILD - COPPER ROOM - NIGHT", "cast": [{"id": 0, "name": "CORNELIUS AGNEW", "names": ["CORNELIUS AGNEW", "CORNELIUS"], "gender": "m", "first": 5, "spoke": 24}, {"id": 1, "name": "TOBIAS HALE", "names": ["TOBIAS HALE", "TOBIAS"], "gender": "m", "first": 10, "spoke": 23}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAMPLIGHTERS' GUILD - COPPER ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "1887.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Gas London.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A narrow workshop lined with lamp-heads, brass keys, and tin oil cans.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single jet burns low over a scarred table.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CORNELIUS AGNEW, 70, stooped, spectacles on a cord, polishes a lamp-glass with a rag.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "He does it too slowly.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "He has all night.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "The door opens.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Cold fog drifts in.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "TOBIAS HALE, 28, wet through, bowler in hand, ink-stained cuffs, enters.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He looks around like a man who has been here before.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Mr. Agnew.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "You're late.", "name": "CORNELIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "The omnibus broke an axle.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I said ten o'clock.", "name": "CORNELIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "It is ten o'clock.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Cornelius lifts the glass to the jet.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Squints through it.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Quarter past, by my reckoning.", "name": "CORNELIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Tobias lets that sit.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Hangs his hat on a hook.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Doesn't sit.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "You asked me here.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "I did.", "name": "CORNELIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "You said it was about the Pettigrew matter.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "It is.", "name": "CORNELIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "He sets the glass down.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Lifts another.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Starts again.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "A long beat.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "A long, patient beat.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Mr. Agnew, I have an editor waiting on copy.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Let him wait.", "name": "CORNELIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "I can't.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "You can. It's an extraordinary thing, waiting. You'd be surprised what a man will say when you let him.", "name": "CORNELIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Is that what this is?", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "I'm an old man. I'm only polishing.", "name": "CORNELIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Tobias crosses to the table.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Looks at the lamp-glass.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "At the old man's hands, trembling slightly.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Eleven lamps went dark on Marlow Street the night Pettigrew died.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Eleven.", "name": "CORNELIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Someone put them out.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "The wind.", "name": "CORNELIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "There was no wind.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Cornelius puts down the rag.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Takes off his spectacles.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Folds them.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "You've done your homework.", "name": "CORNELIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "I've done nothing yet.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Then you'll want to sit.", "name": "CORNELIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "Tobias stays standing.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "Cornelius shrugs and lowers himself onto a stool, bones cracking.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "I was told to do it. By a man in a good coat. He paid me forty sovereigns.", "name": "CORNELIUS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "Who?", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "I don't know his name.", "name": "CORNELIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "Would you know his face?", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "I'd know his coat.", "name": "CORNELIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "Tobias takes out a notebook.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "Writes.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "The pencil scratches loud in the quiet.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "Why are you telling me?", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "Because I've lit those lamps for fifty-one years. And I put out eleven in one night so a man could be killed in the dark.", "name": "CORNELIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "He looks up.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "His eyes are wet and clear.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "That's a hard thing to polish off.", "name": "CORNELIUS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "action", "text": "Tobias stops writing.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "Looks at him a while.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "They'll hang you.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "Probably.", "name": "CORNELIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "dialogue", "text": "I should say I won't print it.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 72, "kind": "dialogue", "text": "But you will.", "name": "CORNELIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 73, "kind": "dialogue", "text": "I will.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 74, "kind": "dialogue", "text": "Good lad.", "name": "CORNELIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 75, "kind": "action", "text": "Somewhere in the fog outside, a church bell tolls the half hour.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 76, "kind": "dialogue", "text": "I'm sorry.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1]}, {"u": 77, "kind": "dialogue", "text": "Don't be.", "name": "CORNELIUS", "speaker": 0, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1]}, {"u": 78, "kind": "action", "text": "They speak at the same time.", "para": 15, "sent": 0, "present": [0, 1]}, {"u": 79, "kind": "dialogue", "text": "You could run.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 80, "kind": "dialogue", "text": "^ I'd like to finish my round.", "name": "CORNELIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 81, "kind": "action", "text": "They both stop.", "para": 16, "sent": 0, "present": [0, 1]}, {"u": 82, "kind": "action", "text": "The jet hisses.", "para": 16, "sent": 1, "present": [0, 1]}, {"u": 83, "kind": "action", "text": "Tobias lowers the pencil.", "para": 16, "sent": 2, "present": [0, 1]}, {"u": 84, "kind": "dialogue", "text": "Your round.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 85, "kind": "dialogue", "text": "Marlow Street. Eleven lamps. I put them out. I'd like to put them back.", "name": "CORNELIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 86, "kind": "action", "text": "Tobias puts the notebook in his pocket.", "para": 17, "sent": 0, "present": [0, 1]}, {"u": 87, "kind": "action", "text": "Takes his hat from the hook.", "para": 17, "sent": 1, "present": [0, 1]}, {"u": 88, "kind": "dialogue", "text": "I'll walk with you.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 89, "kind": "dialogue", "text": "You'll get wet.", "name": "CORNELIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 90, "kind": "dialogue", "text": "I'm already wet.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 91, "kind": "action", "text": "Cornelius almost smiles.", "para": 18, "sent": 0, "present": [0, 1]}, {"u": 92, "kind": "action", "text": "Rises with effort.", "para": 18, "sent": 1, "present": [0, 1]}, {"u": 93, "kind": "action", "text": "Collects a long brass pole from the corner, a hooked key hanging from its tip.", "para": 18, "sent": 2, "present": [0, 1]}, {"u": 94, "kind": "action", "text": "He blows out the jet on the way past.", "para": 19, "sent": 0, "present": [0, 1]}, {"u": 95, "kind": "action", "text": "They walk out together into the fog.", "para": 19, "sent": 1, "present": [0, 1]}]}