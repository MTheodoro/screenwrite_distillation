{"scene_id": "s01376", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01376.fountain", "heading": "INT. HOSPITAL - HYPERBARIC CHAMBER ANTEROOM - DAY", "cast": [{"id": 0, "name": "SUNITA RAGHAVAN", "names": ["SUNITA RAGHAVAN", "SUNITA"], "gender": "?", "first": 4, "spoke": 20}, {"id": 1, "name": "NURSE FELIX OYELARAN", "names": ["NURSE FELIX OYELARAN", "FELIX"], "gender": "?", "first": 7, "spoke": 13}, {"id": 2, "name": "IMOGEN VASCO", "names": ["IMOGEN VASCO", "IMOGEN"], "gender": "?", "first": 16, "spoke": 16}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOSPITAL - HYPERBARIC CHAMBER ANTEROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A small tiled room with a round porthole window into a steel pressure chamber.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Gauges tick.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A wall clock reads 2:15.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. SUNITA RAGHAVAN, 50s, scrubs and reading glasses, stands at the console reviewing a chart.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She is relaxed.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "She is eating almonds.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "NURSE FELIX OYELARAN, 30s, checks a valve with a gloved hand.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Whistles faintly.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Pressure steady?", "name": "SUNITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Two point four. Just like the textbook.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Patient comfortable?", "name": "SUNITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Mr. Arkwright's asleep. He said the hum reminded him of his mother's refrigerator.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "That's the nicest thing anyone's said about this machine.", "name": "SUNITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "They share a small laugh.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "The chamber hums.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "DR. IMOGEN VASCO, 40s, hospital administrator's badge, steps in with a tablet and a face without expression.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Dr. Raghavan. Nurse Oyelaran.", "name": "IMOGEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Imogen. Almond?", "name": "SUNITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "No, thank you.", "name": "IMOGEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Everything all right?", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "I need a word about Mr. Arkwright.", "name": "IMOGEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Of course. What about him?", "name": "SUNITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "His daughter called legal an hour ago.", "name": "IMOGEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "His daughter. Gwen. She's lovely. She sat with him all morning.", "name": "SUNITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "She says he was never told the full risk of the procedure.", "name": "IMOGEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "I went through the consent form with her line by line.", "name": "SUNITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "She says you did it while he was sedated.", "name": "IMOGEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "That's not what happened.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "I'm not saying it is.", "name": "IMOGEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Then what are you saying?", "name": "SUNITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "I'm saying there's a record that says otherwise.", "name": "IMOGEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "What record?", "name": "SUNITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "The sedation log. It has a time on it. 1:40.", "name": "IMOGEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "That's wrong.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "It's what the system shows.", "name": "IMOGEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Felix, you charted the sedation.", "name": "SUNITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "I did. At 2:00. After consent.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "The system says 1:40.", "name": "IMOGEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Then someone changed it.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Who could have?", "name": "IMOGEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Dr. Raghavan.", "name": "FELIX", "speaker": 1, "ext": [], "paren": ["slowly"], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "What?", "name": "SUNITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "You asked me for the keyboard at 1:50. To fix a typo.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "I fixed a typo.", "name": "SUNITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "You were on the sedation log.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Because I was checking the dose.", "name": "SUNITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Dr. Raghavan.", "name": "IMOGEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "This is ridiculous.", "name": "SUNITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "I have to ask you to step out of the chamber rotation while we review.", "name": "IMOGEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "You can't be serious.", "name": "SUNITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "It's procedure.", "name": "IMOGEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "I have forty years of procedure. I know exactly what it is.", "name": "SUNITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "I'm sorry. I didn't want to say it.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "Say what, Felix?", "name": "SUNITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "That I saw your hand move.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Sunita sets down the almonds.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Takes off her glasses.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Her voice is very quiet.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "Pressure is two point four. In eleven minutes we need to bring him up. Who is going to do that, Imogen?", "name": "SUNITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "Nurse Oyelaran is certified.", "name": "IMOGEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Then I suppose it will be Nurse Oyelaran.", "name": "SUNITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "Dr. Raghavan, I--", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "Go on, Felix. The gauge won't watch itself.", "name": "SUNITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}