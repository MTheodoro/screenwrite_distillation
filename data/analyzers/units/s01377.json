{"scene_id": "s01377", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01377.fountain", "heading": "INT. ST. CLEMENT'S HOSPITAL - LAUNDRY CHUTE LANDING - NIGHT", "cast": [{"id": 0, "name": "HELEN VOSS", "names": ["HELEN VOSS", "HELEN"], "gender": "f", "first": 5, "spoke": 7}, {"id": 1, "name": "NURSE AGNES BRANDT", "names": ["NURSE AGNES BRANDT", "AGNES"], "gender": "f", "first": 7, "spoke": 4}, {"id": 2, "name": "CECILIA MARCH", "names": ["CECILIA MARCH", "CECILIA"], "gender": "f", "first": 24, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. ST. CLEMENT'S HOSPITAL - LAUNDRY CHUTE LANDING - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped steel landing at the bottom of the laundry chute, lit by one humming tube.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Canvas bins.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Stacks of folded sheets.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A radiator ticks.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. HELEN VOSS, 40s, rumpled white coat, crouches beside a bin.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her fingers are on a patient's wrist.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "NURSE AGNES BRANDT, 50s, thick glasses, kneels across from her with a penlight.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Between them, on a pile of sheets, lies an unconscious elderly woman in a hospital gown.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Pulse is thready.", "name": "HELEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "She came down the chute?", "name": "AGNES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Three floors. Bin broke her fall.", "name": "HELEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She presses two fingers to the woman's neck.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Leans in close.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "How long has she been missing?", "name": "AGNES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Since the evening round.", "name": "HELEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Agnes lifts the old woman's eyelid.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Shines the light.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "The pupil shrinks.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "She's responding.", "name": "AGNES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Good.", "name": "HELEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She starts to rise.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "The old woman groans.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Helen drops back down.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "CECILIA MARCH, 80s, wild white hair, gown twisted around her, opens bleary eyes.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Her gaze goes from one face to the other.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Is it Tuesday?", "name": "CECILIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "It's Thursday, Mrs. March.", "name": "HELEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "I have to feed the hens.", "name": "CECILIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Agnes shoots Helen a worried glance.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Helen shakes her head, a small signal.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Wait.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "She takes the old woman's hand.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Squeezes.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Cecilia squeezes back, strong.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Too strong.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Her fingers lock.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "They'll peck each other if I don't.", "name": "CECILIA", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Helen tries to pull free.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Can't.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Agnes reaches to help.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Cecilia's other hand snaps out and catches her wrist.", "para": 10, "sent": 3, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Both women freeze.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Mrs. March, please let go.", "name": "AGNES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Where's my husband?", "name": "CECILIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "She sits up.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Fast.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "The sheets slide off.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Her eyes are suddenly very clear.", "para": 12, "sent": 3, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "He's not here.", "name": "HELEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "He promised he'd come.", "name": "CECILIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "She pushes herself to her feet.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Helen scrambles back.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Agnes grabs for the old woman's arm and gets a handful of gown.", "para": 13, "sent": 2, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "The radiator bangs.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Cecilia flinches.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Her grip loosens.", "para": 14, "sent": 2, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "She turns toward the sound.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Stares at it.", "para": 15, "sent": 1, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Her shoulders sag.", "para": 15, "sent": 2, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "He's been dead nine years, hasn't he.", "name": "CECILIA", "speaker": 2, "ext": ["CONT'D"], "paren": ["small"], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "The two women exchange a look.", "para": 16, "sent": 0, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "Neither answers.", "para": 16, "sent": 1, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "She sits down again, slowly, on the pile of sheets, and puts her hands in her lap.", "para": 17, "sent": 0, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "She seems to shrink.", "para": 17, "sent": 1, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "Agnes touches her shoulder, gently now.", "para": 18, "sent": 0, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "Helen exhales, long and shaky, and presses the call button on the wall.", "para": 18, "sent": 1, "present": [0, 1, 2]}, {"u": 67, "kind": "dialogue", "text": "Gurney to laundry level. Patient found. Stable.", "name": "HELEN", "speaker": 0, "ext": [], "paren": ["into the intercom"], "dual": false, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "She releases the button.", "para": 19, "sent": 0, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "Looks down at the old woman.", "para": 19, "sent": 1, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "Smiles, tired.", "para": 19, "sent": 2, "present": [0, 1, 2]}, {"u": 71, "kind": "action", "text": "Cecilia pats her hand.", "para": 20, "sent": 0, "present": [0, 1, 2]}, {"u": 72, "kind": "action", "text": "Almost motherly.", "para": 20, "sent": 1, "present": [0, 1, 2]}]}