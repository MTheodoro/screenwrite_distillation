{"scene_id": "s01378", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01378.fountain", "heading": "INT. SALT MINE ELEVATOR CAGE - DEEP SHAFT - NIGHT", "cast": [{"id": 0, "name": "MAURA KELLEHER", "names": ["MAURA KELLEHER", "MAURA"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "DEZ", "names": ["DEZ"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "OYELOWO", "names": ["OYELOWO"], "gender": "?", "first": 5, "spoke": 0}, {"id": 3, "name": "TRUDY NAKASHIMA", "names": ["TRUDY NAKASHIMA", "TRUDY"], "gender": "?", "first": 6, "spoke": 4}, {"id": 4, "name": "OLD HENRY BASKIN", "names": ["OLD HENRY BASKIN", "HENRY"], "gender": "?", "first": 7, "spoke": 2}, {"id": 5, "name": "JOEL", "names": ["JOEL"], "gender": "m", "first": 8, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. SALT MINE ELEVATOR CAGE - DEEP SHAFT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "The cage hangs motionless in blackness.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "White crystalline walls sweat.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single caged bulb flickers, turning five faces the color of old teeth.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MAURA KELLEHER, 50s, foreman's helmet, grips the lever.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "DESMOND \"DEZ\" OYELOWO, 20s, wide-eyed, presses his back to the bars.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "TRUDY NAKASHIMA, 30s, geologist, clutches a clipboard.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "OLD HENRY BASKIN, 70s, silent, stares upward.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "And little JOEL, 12, the foreman's nephew, crouches on the floor with his hands over his ears.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "action", "text": "Somewhere far below, something scrapes.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "Slow.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "Patient.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Everybody stay calm.", "name": "MAURA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Calm? The cable's stopped!", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "It didn't stop. It was cut.", "name": "TRUDY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Don't say that.", "name": "MAURA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "I'm just saying what I see.", "name": "TRUDY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Down there. Always down there.", "name": "HENRY", "speaker": 4, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "What's down there? Henry? What's he talking about?", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Leave him be.", "name": "MAURA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "It's coming up.", "name": "JOEL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Joel, honey--", "name": "TRUDY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "I can hear its feet.", "name": "JOEL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "The scraping grows louder.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Nearer.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "The bulb dims.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Okay okay okay okay.", "name": "DEZ", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Dez, shut the gate. Now.", "name": "MAURA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "It's shut!", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "It's not latched.", "name": "TRUDY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Latch it!", "name": "MAURA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Dez fumbles at the bolt.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "His hands shake.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Below, the scrape becomes a heavy wet drag, and the cage trembles on its cable.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "He said we'd never dig this deep.", "name": "HENRY", "speaker": 4, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "The bulb goes out.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Darkness.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Breathing.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Joel starts to whimper.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Something knocks, once, gently, on the underside of the floor.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}