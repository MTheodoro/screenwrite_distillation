{"scene_id": "s01379", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01379.fountain", "heading": "INT. BOWLING ALLEY - LANE 12 - NIGHT", "cast": [{"id": 0, "name": "COACH ARTIE KOWALCZYK", "names": ["COACH ARTIE KOWALCZYK", "ARTIE"], "gender": "?", "first": 5, "spoke": 2}, {"id": 1, "name": "RUBY DELGADO", "names": ["RUBY DELGADO", "RUBY"], "gender": "?", "first": 6, "spoke": 1}, {"id": 2, "name": "TEDDY BRIGHT", "names": ["TEDDY BRIGHT"], "gender": "m", "first": 7, "spoke": 0}, {"id": 3, "name": "DEVON WALLACE", "names": ["DEVON WALLACE", "DEVON"], "gender": "m", "first": 8, "spoke": 2}, {"id": 4, "name": "FUJIMOTO", "names": ["FUJIMOTO"], "gender": "?", "first": 9, "spoke": 0}, {"id": 5, "name": "GIL SANTORO", "names": ["GIL SANTORO"], "gender": "?", "first": 10, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. BOWLING ALLEY - LANE 12 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Championship night.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cigarette haze under the neon.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A scoreboard overhead: Ninth frame.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Tied, 218 to 218.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "COACH ARTIE KOWALCZYK, 60s, sweat-stained cardigan, stands behind the bench chewing a toothpick down to nothing.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "At the approach, RUBY DELGADO, 20s, steps up with a pink ball, wipes her palm on a towel, never meeting his eyes.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Behind her, TEDDY BRIGHT, 19, rubs his bad shoulder against the rail.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "DEVON WALLACE, 30s, the anchor, folds his arms and watches the pins.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Two rows back on the bench, the tiny MRS. FUJIMOTO, 70s, knits a scarf, needles clicking steadily.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "At the far lane, rival captain GIL SANTORO, 40s, grins and spins a ball on one finger.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Spare, Ruby. That's all we need.", "name": "ARTIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "Ruby nods.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "Takes her stance.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "Behind her, Teddy stops rubbing his shoulder.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Devon unfolds his arms.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Mrs. Fujimoto drops a stitch.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "She releases.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "The ball rolls down the oil, swerving left, then straight.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Pins explode.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Nine.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "One left.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "The ten pin wobbles.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Everybody holds their breath.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "It stands.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Ruby turns slowly.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Walks back to the bench.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Sits beside Mrs. Fujimoto.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Picks up her towel.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Folds it into a perfect square.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "That's okay.", "name": "ARTIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Devon takes the pink ball from the rack.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Weighs it.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Hands it back to her.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Again.", "name": "DEVON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "It's not my turn.", "name": "RUBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "I know.", "name": "DEVON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "He walks to the approach himself.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}