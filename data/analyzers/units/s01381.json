{"scene_id": "s01381", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01381.fountain", "heading": "INT. FERRY SNACK BAR - NIGHT", "cast": [{"id": 0, "name": "LEON PARRISH", "names": ["LEON PARRISH", "LEON"], "gender": "m", "first": 5, "spoke": 10}, {"id": 1, "name": "STRANGER", "names": ["STRANGER"], "gender": "m", "first": 7, "spoke": 9}, {"id": 2, "name": "WAITRESS", "names": ["WAITRESS"], "gender": "?", "first": 18, "spoke": 0}, {"id": 3, "name": "DOLORES KEANE", "names": ["DOLORES KEANE", "DOLORES"], "gender": "m", "first": 35, "spoke": 5}, {"id": 4, "name": "GIDEON", "names": ["GIDEON"], "gender": "m", "first": 44, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. FERRY SNACK BAR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A late crossing.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fluorescent lights buzz.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Vinyl booths, a chrome coffee urn, rain streaking the windows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The deck rolls gently.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LEON PARRISH, 50s, windbreaker, wedding ring worn thin, sits in a booth with a cold sandwich and a newspaper.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "He has the look of a man avoiding something at home.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "A STRANGER, 50s, gray raincoat, hat dripping, slides into the opposite seat without asking.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He sets down two cups of tea.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Pushes one across.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "You looked like you needed it.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I didn't ask for tea.", "name": "LEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "No. But you're the type who'd never ask.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Leon eyes the cup.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Eyes the man.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "The ferry horn sounds, long and low.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Do I know you?", "name": "LEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Not yet.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "A WAITRESS drifts past with a pot of coffee.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "The Stranger nods.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "She refills nothing.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Moves on.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "What do you want?", "name": "LEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Company. It's a long crossing.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Twenty minutes.", "name": "LEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Long enough.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Leon takes the tea.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Sips.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "It's good.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "He seems surprised by that.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Where are you headed?", "name": "STRANGER", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Home.", "name": "LEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "And where's that?", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Across the water.", "name": "LEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "That's where everyone's going.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": ["smiling"], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "DOLORES KEANE, 60s, in a yellow slicker, appears at the end of the booth with a lunch tray.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "She sets it down, hard.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Leon, I've been looking all over the boat.", "name": "DOLORES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Dolores. I told you I'd be back.", "name": "LEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "You said ten minutes. That was an hour ago.", "name": "DOLORES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Leon looks at the Stranger, then at her.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "The Stranger lifts his cup in a small toast.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Who's this?", "name": "DOLORES", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "No one. A man who bought me tea.", "name": "LEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Gideon Marsh.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "He holds out a hand.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Dolores doesn't take it.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "She stares at his face.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Gideon Marsh drowned in 1991.", "name": "DOLORES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Leon's cup stops halfway to his mouth.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Did I?", "name": "GIDEON", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "At Pelican Point. Off the ferry slip. I was there.", "name": "DOLORES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "Then you'll remember I wasn't alone.", "name": "GIDEON", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "The fluorescent light flickers once.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "Twice.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Leon puts down his cup and slides to the edge of the booth, his eyes on Dolores.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Dolores. What does he mean?", "name": "LEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "She doesn't answer.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Gideon turns his tea in slow circles.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "It's all right, Mrs. Parrish. I forgave you a long time ago.", "name": "GIDEON", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "Dolores sits down, very slowly, across from him.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "Mrs. Parrish?", "name": "LEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "The ferry horn sounds again.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "Land comes closer behind the rain.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}]}