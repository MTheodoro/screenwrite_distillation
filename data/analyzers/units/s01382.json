{"scene_id": "s01382", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01382.fountain", "heading": "INT. NIGHT-SHIFT PLANETARIUM - CONTROL BOOTH - NIGHT", "cast": [{"id": 0, "name": "ADA", "names": ["ADA"], "gender": "?", "first": 4, "spoke": 19}, {"id": 1, "name": "LINDQVIST", "names": ["LINDQVIST"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "RADIO ANNOUNCER", "names": ["RADIO ANNOUNCER"], "gender": "?", "first": 10, "spoke": 1}, {"id": 3, "name": "NOAH", "names": ["NOAH"], "gender": "?", "first": 16, "spoke": 21}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT-SHIFT PLANETARIUM - CONTROL BOOTH - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped booth above the dome.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dials, slide trays, a dusty reel-to-reel, and a view through a narrow window onto rows of empty reclining seats.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Overhead, painted stars crawl across the curved ceiling in slow rotation.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ADAEZE \"ADA\" LINDQVIST, 30s, planetarium technician, headphones around her neck and a thermos at her elbow, sits hunched at the console.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "She types a note.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Deletes it.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Types again.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "A phone sits beside the keyboard.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Its screen is lit, a call connected, the speaker on.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "...and that was Chet Baker, here on KLUN, three in the morning, and still nobody's asleep.", "name": "RADIO ANNOUNCER", "speaker": 2, "ext": ["V.O."], "paren": ["over speaker"], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Ada reaches over and kills the radio.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Silence settles on the booth.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She exhales.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Picks up the phone.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Looks at the call screen.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "It reads: NOAH, 02:51.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "She doesn't speak.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Neither does he.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Ada?", "name": "NOAH", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Hi.", "name": "ADA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "You're awake.", "name": "NOAH", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "I work nights.", "name": "ADA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "I know. I just thought...", "name": "NOAH", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "You thought what?", "name": "ADA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "I didn't know you'd pick up.", "name": "NOAH", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Neither did I.", "name": "ADA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "She laughs, small and wet, and wipes her eye with a knuckle.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "On the dome behind her, Orion rises and slides toward the horizon.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Are you somewhere quiet?", "name": "NOAH", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "I'm in a room with eleven thousand stars.", "name": "ADA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "That sounds nice.", "name": "NOAH", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "They're painted. It's a lie, really. I come in every night and turn the lie on.", "name": "ADA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "It's a beautiful lie.", "name": "NOAH", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Noah.", "name": "ADA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Yes.", "name": "NOAH", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Why are you calling me?", "name": "ADA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "A long silence.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "The reel-to-reel ticks.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Somewhere in the building, a pipe knocks twice.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Because I looked up tonight. First time in a year. And I thought of you.", "name": "NOAH", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "She presses her knuckles to her mouth.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Reaches for the dimmer, brings the dome lights down until the booth is nearly black and only the stars remain.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Where are you?", "name": "ADA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "On a roof. In Lisbon.", "name": "NOAH", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Why Lisbon?", "name": "ADA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "I got a job. I didn't tell you.", "name": "NOAH", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "You didn't.", "name": "ADA", "speaker": 0, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "I didn't know how to.", "name": "NOAH", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "You could have called.", "name": "ADA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "I did. Just now.", "name": "NOAH", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "She laughs again, and this time it breaks into something else.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "She turns her face to the window, away from the receiver.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "You can see the stars from there?", "name": "ADA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Barely. Too many lights.", "name": "NOAH", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Then you're missing them.", "name": "ADA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "I'm missing something.", "name": "NOAH", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Ada reaches out and flips a switch on the console.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "The dome shifts.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "The painted sky races backward through the hours, winding through the night like a film in reverse.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "Constellations spin and tumble.", "para": 10, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "What are you doing?", "name": "NOAH", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "Turning the sky.", "name": "ADA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "To where?", "name": "NOAH", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "To where you are. Look up.", "name": "ADA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "On the dome, a handful of stars pause.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "Hold.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "The booth is silent but for breath on the line.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "I'm looking.", "name": "NOAH", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "dialogue", "text": "Third from the left. Over the chimney.", "name": "ADA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "dialogue", "text": "That one?", "name": "NOAH", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "dialogue", "text": "That one's me.", "name": "ADA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "action", "text": "A long pause.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "action", "text": "His breath catches.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "dialogue", "text": "I see you.", "name": "NOAH", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "She closes her eyes.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "The dome's light pools across her face.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "For a moment she is utterly still.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "dialogue", "text": "Stay on the line.", "name": "ADA", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "dialogue", "text": "All night.", "name": "NOAH", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "action", "text": "She leans back in the chair, phone against her ear.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "action", "text": "Above her, the lie keeps turning, softly, toward morning.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}]}