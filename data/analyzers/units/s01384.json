{"scene_id": "s01384", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01384.fountain", "heading": "INT. SCRAPYARD OFFICE - NIGHT", "cast": [{"id": 0, "name": "ROLAND FAYE", "names": ["ROLAND FAYE", "ROLAND"], "gender": "m", "first": 4, "spoke": 6}, {"id": 1, "name": "NINA SZABO", "names": ["NINA SZABO", "NINA"], "gender": "f", "first": 5, "spoke": 6}, {"id": 2, "name": "DUKE HARTWELL", "names": ["DUKE HARTWELL", "DUKE"], "gender": "m", "first": 17, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. SCRAPYARD OFFICE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A trailer on cinder blocks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single bulb.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A safe with its door hanging open and empty.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ROLAND FAYE, 50s, scrapyard owner, sits behind the desk with his hands flat on the blotter.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across from him, NINA SZABO, 30s, leather jacket, a revolver on her knee, sits very straight.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "You were my best driver.", "name": "ROLAND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "That's why you sent a stranger to my house?", "name": "NINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "I didn't send anyone.", "name": "ROLAND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "He knew my dog's name.", "name": "NINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Everybody knows your dog's name.", "name": "ROLAND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "You sold me out for sixty thousand.", "name": "NINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I sold you out for a roof.", "name": "ROLAND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Same thing, Roland.", "name": "NINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "You never had to build a business from a hole in the ground.", "name": "ROLAND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I've been in the hole. I know what it costs.", "name": "NINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "The trailer door opens behind her.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "DUKE HARTWELL, 40s, fedora, wet shoulders, one hand in his coat, leans in the frame.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "He does not smile.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Evening.", "name": "DUKE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Nina doesn't turn.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Her thumb finds the hammer.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "You're late.", "name": "NINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Traffic.", "name": "DUKE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Duke, don't.", "name": "ROLAND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Sorry, Roland. The bill's come due.", "name": "DUKE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}