{"scene_id": "s01385", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01385.fountain", "heading": "EXT. RIVERBANK - ABANDONED MILL - DAWN", "cast": [{"id": 0, "name": "SERGEANT MIREILLE DUVAL", "names": ["SERGEANT MIREILLE DUVAL", "MIREILLE", "SGT. DUVAL"], "gender": "f", "first": 7, "spoke": 19}, {"id": 1, "name": "PRIVATE OSKAR LINDGREN", "names": ["PRIVATE OSKAR LINDGREN", "OSKAR"], "gender": "?", "first": 8, "spoke": 14}, {"id": 2, "name": "WOUNDED SOLDIER", "names": ["WOUNDED SOLDIER"], "gender": "?", "first": 12, "spoke": 4}, {"id": 3, "name": "MORTAR", "names": ["MORTAR"], "gender": "?", "first": 70, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. RIVERBANK - ABANDONED MILL - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Mist.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A rusted waterwheel stands half-sunk in the current.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Birdsong where there should be none.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Three soldiers crouch behind a broken wall.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "Mud to the knees.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "Eyes red.", "para": 1, "sent": 2, "present": []}, {"u": 7, "kind": "action", "text": "SERGEANT MIREILLE DUVAL, 30s, holds a rifle across her knees and watches the far bank.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "PRIVATE OSKAR LINDGREN, 19, wrings out a sock.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Ruined boots beside him.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "A third figure lies on his back under a tarp, only a hand showing.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Breath fogs.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He is the WOUNDED SOLDIER, 20s, pale, one sleeve soaked dark.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Quiet out there.", "name": "OSKAR", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Too quiet.", "name": "MIREILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "That's what I said.", "name": "OSKAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "You said \"quiet.\"", "name": "MIREILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Same thing.", "name": "OSKAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "She doesn't smile.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Leans out an inch, scans, retreats.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Mill's empty. I checked.", "name": "MIREILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Checked what?", "name": "OSKAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Everything.", "name": "MIREILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Oskar tugs the dry sock on.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Eases a boot over it.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Winces.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The wounded man stirs.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Mutters.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "His good hand claws at the tarp.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Mama... the stove's still on...", "name": "WOUNDED SOLDIER", "speaker": 2, "ext": [], "paren": ["delirious"], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "He's talking.", "name": "OSKAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Let him.", "name": "MIREILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Should we give him water?", "name": "OSKAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Save it.", "name": "MIREILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "She taps a canteen.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Hollow.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Oskar nods grimly.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Three days. Three days since a hot meal.", "name": "OSKAR", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Four.", "name": "MIREILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Thank you, Sergeant.", "name": "OSKAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "She almost laughs.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Watches the far bank again.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "A heron lifts from the reeds and flaps downriver, low over the water.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Nothing follows it.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "We cross at dark. Single file. No talking.", "name": "MIREILLE", "speaker": 0, "ext": [], "paren": ["to both"], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "And him?", "name": "OSKAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "We carry him.", "name": "MIREILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "He's dead weight.", "name": "OSKAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "He's a man.", "name": "MIREILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "The wounded soldier opens his eyes.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Clear for the first time.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "He looks at Mireille.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Sergeant.", "name": "WOUNDED SOLDIER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Easy.", "name": "MIREILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "Leave me.", "name": "WOUNDED SOLDIER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "No.", "name": "MIREILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "I'll slow you.", "name": "WOUNDED SOLDIER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "You'll shut up.", "name": "MIREILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Oskar crawls to the wounded man's side.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Presses his palm on the dressing.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "It's wet.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "His face changes.", "para": 11, "sent": 3, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "Sergeant.", "name": "OSKAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "What?", "name": "MIREILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "He's bleeding out.", "name": "OSKAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "She looks.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "Her jaw sets.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "She turns away.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "Fingers dig into the stock of the rifle.", "para": 12, "sent": 3, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "The far bank erupts.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "A MORTAR round shrieks over the water and lands in the mill yard behind them.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "Brick, mud, black smoke.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "action", "text": "Mireille and Oskar throw themselves flat.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "action", "text": "The wounded man gasps.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "His hand goes limp.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "Another round.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "Closer.", "para": 15, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "The wall they hide behind splits down the middle.", "para": 15, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "dialogue", "text": "Move! Move!", "name": "MIREILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "dialogue", "text": "He's gone!", "name": "OSKAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "dialogue", "text": "Take his tags!", "name": "MIREILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "action", "text": "Oskar tears the chain from the dead soldier's neck.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "action", "text": "Stuffs it in his jacket.", "para": 16, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "action", "text": "The two of them scramble, bent double, down the bank toward the waterwheel.", "para": 16, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 84, "kind": "dialogue", "text": "Merde, merde, merde.", "name": "MIREILLE", "speaker": 0, "ext": [], "paren": ["muttering, rifle up"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 85, "kind": "action", "text": "They splash into the shallows as machine-gun fire stitches the water behind them.", "para": 17, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 86, "kind": "dialogue", "text": "Stay low! Follow me!", "name": "SGT. DUVAL", "speaker": 0, "ext": [], "paren": ["shouting over the noise"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 87, "kind": "dialogue", "text": "Where?", "name": "OSKAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 88, "kind": "dialogue", "text": "Anywhere that isn't here!", "name": "SGT. DUVAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 89, "kind": "action", "text": "She plunges into the current.", "para": 18, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 90, "kind": "action", "text": "He follows, holding his rifle overhead.", "para": 18, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 91, "kind": "action", "text": "Under the waterwheel they vanish into the mist.", "para": 18, "sent": 2, "present": [0, 1, 2, 3]}]}