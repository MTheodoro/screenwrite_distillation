{"scene_id": "s01386", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01386.fountain", "heading": "INT. GLOBEX PACKAGING - OPEN-PLAN OFFICE - DAY", "cast": [{"id": 0, "name": "REGIONAL VP BARRETT HOLLOWAY", "names": ["REGIONAL VP BARRETT HOLLOWAY", "BARRETT"], "gender": "m", "first": 4, "spoke": 10}, {"id": 1, "name": "PRIYA NANDAKUMAR", "names": ["PRIYA NANDAKUMAR", "PRIYA"], "gender": "?", "first": 5, "spoke": 3}, {"id": 2, "name": "TOBY ABERNATHY-LIU", "names": ["TOBY ABERNATHY-LIU", "TOBY"], "gender": "?", "first": 5, "spoke": 4}, {"id": 3, "name": "CAROL ENGSTROM", "names": ["CAROL ENGSTROM", "CAROL"], "gender": "?", "first": 5, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. GLOBEX PACKAGING - OPEN-PLAN OFFICE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Beige cubicles.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A ficus dying with dignity.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A banner reading SYNERGY STARTS WITH YOU.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "REGIONAL VP BARRETT HOLLOWAY, 50s, stands at a whiteboard with a marker he is holding wrong.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Around him: PRIYA NANDAKUMAR, 30s, analyst, spiral notebook; TOBY ABERNATHY-LIU, 20s, intern, tie knotted like a shoelace; and CAROL ENGSTROM, 60s, receptionist, knitting at her desk without looking up.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "dialogue", "text": "Team. Quick huddle. Big news.", "name": "BARRETT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Is it layoffs?", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "It is not layoffs.", "name": "BARRETT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Is it a reorg?", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "It's a realignment.", "name": "BARRETT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "That's a reorg.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "It's a reorg with vision.", "name": "BARRETT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Does vision come with a raise?", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Toby, we've talked about the word \"raise.\"", "name": "BARRETT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "You said I could ask.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "I said you could think it. Quietly.", "name": "BARRETT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Barrett, line two.", "name": "CAROL", "speaker": 3, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Not now, Carol.", "name": "BARRETT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "It's corporate.", "name": "CAROL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Tell them I'm in a huddle.", "name": "BARRETT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "He's not in a huddle.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "^ Please don't say I'm in a huddle.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Barrett glares at both of them.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "The phone rings again.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Carol finally puts down the knitting, answers with a sweet smile, listens, nods, and hangs up.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "They said the realignment has been realigned.", "name": "CAROL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Meaning?", "name": "BARRETT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "You're the one being laid off.", "name": "CAROL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "The ficus drops a leaf.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Well. That's fantastic news for the team.", "name": "BARRETT", "speaker": 0, "ext": [], "paren": ["very calm"], "dual": false, "present": [0, 1, 2, 3]}]}