{"scene_id": "s01388", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01388.fountain", "heading": "INT. TELEGRAPH OFFICE - NIGHT", "cast": [{"id": 0, "name": "YOUNG OPERATOR", "names": ["YOUNG OPERATOR", "OPERATOR"], "gender": "?", "first": 5, "spoke": 5}, {"id": 1, "name": "SOUNDER", "names": ["SOUNDER"], "gender": "?", "first": 8, "spoke": 0}, {"id": 2, "name": "COLONEL", "names": ["COLONEL"], "gender": "?", "first": 25, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. TELEGRAPH OFFICE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "1862.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A lamp burns low.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wires hum along the ceiling.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A key clatters on the desk.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A YOUNG OPERATOR, 20s, in sleeve garters and a green eyeshade, hunches over the key.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "He is the only one in the room.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "He taps back an answer, grinning at whatever comes in.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "A SOUNDER chatters.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He copies fast.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Reads aloud.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "\"Mother recovering. Come home Sunday.\" Well, that's a relief.", "name": "OPERATOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He taps a reply.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Paper curls beneath his fingers.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Then the sounder changes tempo.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Slow.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Cold.", "para": 3, "sent": 4, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He freezes and copies each letter as it comes.", "para": 3, "sent": 5, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "\"Enemy cavalry crossing at Harper's Ford. Hold for orders.\"", "name": "OPERATOR", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He pulls the paper loose.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Stands.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Sits again.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "He reads it over, mouthing the words.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "The line crackles.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "A new voice, ghostly, through the speaker of an experimental telephone beside the key.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Operator! Report!", "name": "COLONEL", "speaker": 2, "ext": ["V.O."], "paren": ["over line"], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "He lunges for the receiver, nearly knocking the lamp.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Sir! Message from Harper's Ford! They've crossed!", "name": "OPERATOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "How many?", "name": "COLONEL", "speaker": 2, "ext": ["V.O."], "paren": ["over line"], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "It doesn't say, sir!", "name": "OPERATOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Then find out, son!", "name": "COLONEL", "speaker": 2, "ext": ["V.O."], "paren": ["over line"], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Shaking, he taps.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Waits.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "The sounder is silent.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "He taps again.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Silent.", "para": 7, "sent": 4, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "The lamp gutters.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "He sets down the receiver, very gently, and sits with his hands flat on the desk.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "After a long moment he speaks without turning.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Whoever you are on the other end... I hope you ran.", "name": "OPERATOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "The wire hums on, empty.", "para": 10, "sent": 0, "present": [0, 1, 2]}]}