{"scene_id": "s01389", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01389.fountain", "heading": "EXT. LAKESIDE DOCK - LATE SUMMER DUSK", "cast": [{"id": 0, "name": "JUNE", "names": ["JUNE"], "gender": "?", "first": 4, "spoke": 8}, {"id": 1, "name": "BAPTISTE", "names": ["BAPTISTE"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "MALCOLM OKONKWO-REYES", "names": ["MALCOLM OKONKWO-REYES", "MALCOLM"], "gender": "?", "first": 6, "spoke": 4}, {"id": 3, "name": "NADIA FARHAT", "names": ["NADIA FARHAT", "NADIA"], "gender": "?", "first": 7, "spoke": 5}, {"id": 4, "name": "SPUD", "names": ["SPUD"], "gender": "?", "first": 8, "spoke": 5}, {"id": 5, "name": "KOWALSKI", "names": ["KOWALSKI"], "gender": "?", "first": 8, "spoke": 0}, {"id": 6, "name": "ROSALIND", "names": ["ROSALIND"], "gender": "?", "first": 9, "spoke": 3}, {"id": 7, "name": "ROMILLY PETERS", "names": ["ROMILLY PETERS", "ROMILLY"], "gender": "?", "first": 9, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. LAKESIDE DOCK - LATE SUMMER DUSK", "present": []}, {"u": 1, "kind": "action", "text": "A weathered dock stretches into a still lake.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Mosquitoes hang in gold light.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "At the shore end, a bonfire has burned down to red embers, and six teenagers sit in a ragged arc around it, the last evening of the last summer before everything changes.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "JUNIPER \"JUNE\" BAPTISTE, 17, sits at the dock's far end with her feet in the water, a paperback face-down beside her.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "She watches the horizon as though waiting for it to say something.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "At the fire, MALCOLM OKONKWO-REYES, 18, strums a guitar missing a string.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "NADIA FARHAT, 17, sprawls on a cooler, eating marshmallows straight from the bag.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "BEN \"SPUD\" KOWALSKI, 16, builds a precarious tower of empty cans.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "action", "text": "The twins, ROSALIND and ROMILLY PETERS, 16, share a blanket, whispering, identical down to the chipped nail polish.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 10, "kind": "action", "text": "No one has said what they are all thinking.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 11, "kind": "action", "text": "Every few minutes, someone almost does, and the moment passes.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 12, "kind": "dialogue", "text": "We should do something.", "name": "NADIA", "speaker": 3, "ext": [], "paren": ["through marshmallow"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 13, "kind": "dialogue", "text": "We are doing something.", "name": "MALCOLM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 14, "kind": "dialogue", "text": "Sitting is not doing.", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 15, "kind": "dialogue", "text": "I'm doing architecture.", "name": "SPUD", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 16, "kind": "dialogue", "text": "It's a can tower.", "name": "ROSALIND", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 17, "kind": "dialogue", "text": "It's a monument.", "name": "SPUD", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 18, "kind": "dialogue", "text": "To what?", "name": "ROMILLY", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 19, "kind": "dialogue", "text": "To us.", "name": "SPUD", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 20, "kind": "action", "text": "Quiet.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 21, "kind": "action", "text": "The guitar strums a flat chord.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 22, "kind": "action", "text": "Somebody laughs, a short and exhausted laugh, and then the embers pop.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 23, "kind": "action", "text": "June stands.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 24, "kind": "action", "text": "She pads along the dock toward them, wet footprints darkening the boards.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 25, "kind": "action", "text": "She stops at the edge of the firelight.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 26, "kind": "dialogue", "text": "I leave Thursday.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 27, "kind": "action", "text": "Nobody speaks.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 28, "kind": "action", "text": "The tower of cans collapses with a clatter.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 29, "kind": "action", "text": "Spud doesn't flinch.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "dialogue", "text": "Thursday?", "name": "MALCOLM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "dialogue", "text": "My mom moved it up.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "dialogue", "text": "You said Saturday.", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "dialogue", "text": "I know what I said.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "action", "text": "She sits on the cooler's edge.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "action", "text": "Takes a marshmallow from Nadia's bag, rolls it in her fingers, doesn't eat it.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "dialogue", "text": "Where is it again?", "name": "ROMILLY", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "dialogue", "text": "Portland.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "dialogue", "text": "That's not so far.", "name": "ROSALIND", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "dialogue", "text": "It's three states.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "dialogue", "text": "That's not so far.", "name": "ROSALIND", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 41, "kind": "action", "text": "Malcolm sets the guitar aside.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 42, "kind": "action", "text": "He looks at the ground.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 43, "kind": "action", "text": "His hands are trembling a little, and he buries them between his knees.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 44, "kind": "dialogue", "text": "We could drive up. Visit.", "name": "MALCOLM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 45, "kind": "dialogue", "text": "You don't have a car.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 46, "kind": "dialogue", "text": "Spud has a car.", "name": "MALCOLM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 47, "kind": "dialogue", "text": "I have a bicycle.", "name": "SPUD", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 48, "kind": "dialogue", "text": "You have a lawn mower you ride.", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 49, "kind": "dialogue", "text": "It's a very good lawn mower.", "name": "SPUD", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 50, "kind": "action", "text": "They laugh.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 51, "kind": "action", "text": "It dies quickly.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 52, "kind": "action", "text": "June squeezes the marshmallow into a pale pellet and lets it fall.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 53, "kind": "dialogue", "text": "I'm not good at this.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 54, "kind": "dialogue", "text": "Nobody is.", "name": "ROMILLY", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 55, "kind": "dialogue", "text": "I thought I'd have something to say.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 56, "kind": "dialogue", "text": "You don't have to.", "name": "NADIA", "speaker": 3, "ext": [], "paren": ["gently"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 57, "kind": "action", "text": "June nods.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 58, "kind": "action", "text": "She wipes her face with the heel of her hand.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 59, "kind": "action", "text": "Rosalind and Romilly lift the blanket and open it.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 60, "kind": "action", "text": "June crawls in between them and they close it again, a single bundle of knees and tangled hair.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 61, "kind": "action", "text": "Malcolm picks up the guitar.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 62, "kind": "action", "text": "Finds the one chord he knows.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 63, "kind": "action", "text": "Plays it, over and over, not well.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 64, "kind": "action", "text": "The fire sinks lower.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 65, "kind": "action", "text": "Across the lake, the last light bleeds out of the sky and a single loon calls once.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 66, "kind": "action", "text": "Nobody answers it.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}