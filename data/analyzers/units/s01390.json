{"scene_id": "s01390", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01390.fountain", "heading": "INT. ARBITRATION HALL - ANTEROOM - MORNING", "cast": [{"id": 0, "name": "PATRICIA OYELARAN-WEISS", "names": ["PATRICIA OYELARAN-WEISS", "PATRICIA"], "gender": "?", "first": 4, "spoke": 2}, {"id": 1, "name": "DESHAWN MCALLISTER", "names": ["DESHAWN MCALLISTER", "DESHAWN"], "gender": "?", "first": 5, "spoke": 1}, {"id": 2, "name": "ARTHUR KESSLER-BOYD", "names": ["ARTHUR KESSLER-BOYD"], "gender": "m", "first": 9, "spoke": 0}, {"id": 3, "name": "LOUISE FAIRCHILD", "names": ["LOUISE FAIRCHILD", "LOUISE"], "gender": "?", "first": 10, "spoke": 1}, {"id": 4, "name": "BAILIFF", "names": ["BAILIFF"], "gender": "?", "first": 13, "spoke": 0}, {"id": 5, "name": "MARGUERITE DELACROIX", "names": ["MARGUERITE DELACROIX", "MARGUERITE"], "gender": "m", "first": 14, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. ARBITRATION HALL - ANTEROOM - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "A cramped waiting room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Five plastic chairs.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A water cooler gurgling.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "PATRICIA OYELARAN-WEISS, 40s, litigator, rehearses an opening to the wall.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside her, her junior, DESHAWN MCALLISTER, 20s, sorts exhibits with shaking hands.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Breathe.", "name": "PATRICIA", "speaker": 0, "ext": [], "paren": ["to Deshawn"], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "I am.", "name": "DESHAWN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Out. Not in.", "name": "PATRICIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Across the room, ARTHUR KESSLER-BOYD, 60s, opposing counsel, doesn't look up from his phone.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "His client, LOUISE FAIRCHILD, 50s, grips her purse.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "It'll be fine, it'll be fine.", "name": "LOUISE", "speaker": 3, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "The door swings open.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "A BAILIFF enters.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "MARGUERITE DELACROIX, 70s, silver bob, black robe, strides in behind him, and everybody stands.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Sit. All of you.", "name": "MARGUERITE", "speaker": 5, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "They sit.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "She remains standing.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Opens a file.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Counsel. Before we begin, someone has been shredding documents.", "name": "MARGUERITE", "speaker": 5, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Arthur's phone slips.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Louise stops breathing.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}