{"scene_id": "s01391", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01391.fountain", "heading": "INT. FARMHOUSE KITCHEN - MORNING", "cast": [{"id": 0, "name": "MAMA ROSALIE", "names": ["MAMA ROSALIE"], "gender": "f", "first": 3, "spoke": 3}, {"id": 1, "name": "TUCKER", "names": ["TUCKER"], "gender": "m", "first": 8, "spoke": 2}, {"id": 2, "name": "BEN", "names": ["BEN"], "gender": "m", "first": 8, "spoke": 2}, {"id": 3, "name": "KNOCK", "names": ["KNOCK"], "gender": "?", "first": 15, "spoke": 0}, {"id": 4, "name": "MAN", "names": ["MAN"], "gender": "m", "first": 17, "spoke": 1}, {"id": 5, "name": "AMOS", "names": ["AMOS"], "gender": "?", "first": 21, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. FARMHOUSE KITCHEN - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Pancakes burn.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Smoke curls from the pan.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "MAMA ROSALIE, 40s, dishtowel on her shoulder, flips the pan.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "Too late.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "action", "text": "Black.", "para": 1, "sent": 2, "present": [0]}, {"u": 6, "kind": "dialogue", "text": "Boys! Breakfast!", "name": "MAMA ROSALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 7, "kind": "action", "text": "Thundering feet.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "TUCKER, 10, and BEN, 8, skid in, socks sliding.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "It's on fire!", "name": "TUCKER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "It's not on fire. It's crispy.", "name": "BEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Sit.", "name": "MAMA ROSALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "They sit.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Tucker pokes a pancake with a fork.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "It crunches.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "A KNOCK at the screen door.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Everyone stops.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "A MAN in a rumpled suit stands on the porch, hat in hand, a battered suitcase at his feet.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Forty-ish, kind eyes, sunburned nose.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Morning, folks.", "name": "MAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Mama Rosalie's face goes slack.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Amos?", "name": "MAMA ROSALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Who's that?", "name": "TUCKER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "The man steps inside.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Sets down the suitcase.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Hello, Tuck.", "name": "AMOS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Tucker slides off his chair.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Edges behind his mother.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Is that Daddy?", "name": "BEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Amos kneels, arms open.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Ben looks at his mother.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "She nods, barely.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "He runs.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}]}