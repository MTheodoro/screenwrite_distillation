{"scene_id": "s01393", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01393.fountain", "heading": "INT. SAFE HOUSE - BASEMENT - NIGHT", "cast": [{"id": 0, "name": "AGENT NADEZHDA KOVACS", "names": ["AGENT NADEZHDA KOVACS", "NADEZHDA"], "gender": "?", "first": 4, "spoke": 7}, {"id": 1, "name": "LUCIEN BRASSARD", "names": ["LUCIEN BRASSARD", "LUCIEN"], "gender": "f", "first": 5, "spoke": 3}, {"id": 2, "name": "TAVITA SEFO", "names": ["TAVITA SEFO", "TAVITA"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "MARGOT FENWICK", "names": ["MARGOT FENWICK", "MARGOT"], "gender": "?", "first": 6, "spoke": 3}, {"id": 4, "name": "UNKNOWN MALE", "names": ["UNKNOWN MALE"], "gender": "?", "first": 6, "spoke": 10}, {"id": 5, "name": "HANDLER", "names": ["HANDLER"], "gender": "?", "first": 7, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. SAFE HOUSE - BASEMENT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A bare concrete room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A table, six folding chairs, a bank of dead monitors.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A phone sits in the center on speaker.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "AGENT NADEZHDA KOVACS, 40s, at the head.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "LUCIEN BRASSARD, 50s, beside her.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Across, three more: TAVITA SEFO, 30s; MARGOT FENWICK, 60s; and a nervous young man in a stolen hoodie, UNKNOWN MALE, 20s, who has not given a name.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "dialogue", "text": "Status.", "name": "HANDLER", "speaker": 5, "ext": ["V.O."], "paren": ["over speaker"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "dialogue", "text": "All present. The package is secure.", "name": "NADEZHDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "Is he talking?", "name": "HANDLER", "speaker": 5, "ext": ["V.O."], "paren": ["over speaker"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Not yet.", "name": "NADEZHDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Make him.", "name": "HANDLER", "speaker": 5, "ext": ["V.O."], "paren": ["over speaker"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "She mutes the line.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "Turns to the young man.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "They won't wait much longer. You understand that.", "name": "NADEZHDA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "I understand I didn't do anything.", "name": "UNKNOWN MALE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Everyone in this room did something.", "name": "LUCIEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "I drove a car.", "name": "UNKNOWN MALE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "To where?", "name": "MARGOT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "A warehouse. Pier nine. I didn't ask what was inside.", "name": "UNKNOWN MALE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Who told you to drive?", "name": "TAVITA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "A guy. Short. Gold tooth.", "name": "UNKNOWN MALE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "His name?", "name": "NADEZHDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Dmitri. Everybody called him Dmitri.", "name": "UNKNOWN MALE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Dmitri Volkov.", "name": "LUCIEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "That's him.", "name": "UNKNOWN MALE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Lucien and Nadezhda exchange a look.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Margot rises and pours water into a paper cup, sets it in front of the boy.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Drink.", "name": "MARGOT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Tell us about the pier.", "name": "TAVITA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "There were crates. Eight. Stenciled with a bird.", "name": "UNKNOWN MALE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "What kind of bird?", "name": "NADEZHDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "A heron. No. A crane.", "name": "UNKNOWN MALE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Crane.", "name": "LUCIEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "And there was a woman.", "name": "UNKNOWN MALE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Describe her.", "name": "NADEZHDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Red coat. She never spoke. Dmitri was scared of her.", "name": "UNKNOWN MALE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "The phone crackles.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Nadezhda unmutes.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Kovacs. We have a name.", "name": "HANDLER", "speaker": 5, "ext": ["V.O."], "paren": ["over speaker"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Go ahead.", "name": "NADEZHDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "The woman in the red coat. Margot Fenwick.", "name": "HANDLER", "speaker": 5, "ext": ["V.O."], "paren": ["over speaker"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Everyone turns.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Margot sets down the pitcher.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Folds her hands.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Smiles, almost tenderly.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "Oh, dear.", "name": "MARGOT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}