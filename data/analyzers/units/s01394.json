{"scene_id": "s01394", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01394.fountain", "heading": "INT. HOSPITAL - NEONATAL ICU - NIGHT", "cast": [{"id": 0, "name": "AMARA ESEOGHENE", "names": ["AMARA ESEOGHENE", "AMARA"], "gender": "?", "first": 4, "spoke": 12}, {"id": 1, "name": "CHARGE NURSE LEOPOLDO FIGUEROA", "names": ["CHARGE NURSE LEOPOLDO FIGUEROA", "LEOPOLDO"], "gender": "?", "first": 6, "spoke": 12}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOSPITAL - NEONATAL ICU - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dim amber light.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Incubators in a long row, each one a small glowing aquarium.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Monitors beep in soft, uneven rhythm.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. AMARA ESEOGHENE, 30s, in scrubs and clogs, charts at the central station.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She has been awake for twenty hours and carries it well.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "CHARGE NURSE LEOPOLDO FIGUEROA, 50s, silver at the temples, wheels a cart down the aisle.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Bed six is fussing.", "name": "LEOPOLDO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Her sats?", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Ninety-one. Dropping a little.", "name": "LEOPOLDO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Bring me the suction.", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He wheels it over.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She leans into the incubator, gentle hands, and clears the tiny airway.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "The monitor steadies.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "There. Good girl.", "name": "AMARA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Dr. Eseoghene.", "name": "LEOPOLDO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Mm.", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Bed three.", "name": "LEOPOLDO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She glances across.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Bed three's alarm has started a quiet chirp.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "The numbers there are climbing.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Not the right way.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Heart rate?", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "One-eighty.", "name": "LEOPOLDO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Temperature?", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Thirty-eight point four.", "name": "LEOPOLDO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "She is already moving.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Pulls the stethoscope from her neck, bends over the incubator.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "He's septic. Cultures now, and start the antibiotics.", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Which?", "name": "LEOPOLDO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Ampicillin and gentamicin. Standard.", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Dosing?", "name": "LEOPOLDO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Weight-based. Check the chart.", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Leopoldo hesitates.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "His voice is very quiet.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Doctor. The mother is on the phone.", "name": "LEOPOLDO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Tell her we're doing everything.", "name": "AMARA", "speaker": 0, "ext": [], "paren": ["not turning"], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "She's asking for a priest.", "name": "LEOPOLDO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Amara stops.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Slowly straightens.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "The monitor beeps.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Call chaplaincy.", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Already did.", "name": "LEOPOLDO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "They both speak at once.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Get the dose.", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "^ Prepare the line.", "name": "LEOPOLDO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "They look at one another.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Amara nods, and together they bend over the tiny crib.", "para": 9, "sent": 1, "present": [0, 1]}]}