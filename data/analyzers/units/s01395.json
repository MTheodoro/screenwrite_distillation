{"scene_id": "s01395", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01395.fountain", "heading": "INT. CLOCKTOWER - MECHANISM ROOM - NIGHT", "cast": [{"id": 0, "name": "TOMASZ REDDING", "names": ["TOMASZ REDDING", "TOMASZ"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "DISPATCHER", "names": ["DISPATCHER"], "gender": "?", "first": 8, "spoke": 4}, {"id": 2, "name": "LEONIDAS PARK", "names": ["LEONIDAS PARK", "LEONIDAS"], "gender": "m", "first": 26, "spoke": 3}, {"id": 3, "name": "MIRA VASQUEZ-TANAKA", "names": ["MIRA VASQUEZ-TANAKA", "MIRA"], "gender": "?", "first": 32, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. CLOCKTOWER - MECHANISM ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Brass gears the size of cartwheels grind overhead.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Pendulum weights swing in the dark.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single caged lamp throws shadows across oak beams.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "TOMASZ REDDING, 40s, ex-cop, rain-soaked, hunches over a battered radio on a workbench.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He twists the dial.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Static.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "A woman's voice breaks through, thin and urgent.", "para": 1, "sent": 3, "present": [0]}, {"u": 8, "kind": "dialogue", "text": "Redding, are you in position?", "name": "DISPATCHER", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Three flights up. It's colder than a morgue.", "name": "TOMASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Is the package there?", "name": "DISPATCHER", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He scans the room.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "A steel case sits in the shadow beneath the great gear.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He crosses and lifts it.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Heavier than it looks.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Got it.", "name": "TOMASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Don't open it.", "name": "DISPATCHER", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Wasn't going to.", "name": "TOMASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Redding. Someone knows you're there.", "name": "DISPATCHER", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Tomasz freezes.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Slowly sets the case down.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Draws a pistol from his coat, thumbs the safety.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "The trapdoor in the floor creaks.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "A hand appears on the rim, then a head.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "He aims.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Does not fire.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "LEONIDAS PARK, 30s, climbs up out of the stairwell in a delivery uniform, breathing hard, both hands raised.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "He is soaked to the skin.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Don't shoot. I work here.", "name": "LEONIDAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "At midnight?", "name": "TOMASZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Maintenance. Somebody has to oil the gears.", "name": "LEONIDAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "From the dark beyond the pendulum, a woman's laugh.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "MIRA VASQUEZ-TANAKA, 30s, in a black raincoat, steps from behind a beam.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "She holds a small silver gun, steady as a surgeon.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "She is smiling.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "That's very good, Leo.", "name": "MIRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Leonidas lowers his hands.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Smiles back.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "He turns to Tomasz.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Sorry, friend.", "name": "LEONIDAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Dispatcher. You hearing this?", "name": "TOMASZ", "speaker": 0, "ext": [], "paren": ["to the radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Static.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Nothing.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "The radio has been switched off, and somewhere in the shadows, Mira's thumb rests on a small black remote.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "The great gear above them shifts and drops one tooth.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "The whole tower shudders.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}]}