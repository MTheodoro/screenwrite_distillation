{"scene_id": "s01396", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01396.fountain", "heading": "INT. FAMILY MINIVAN - PARKED OUTSIDE AN AMUSEMENT PARK - DAY", "cast": [{"id": 0, "name": "LORENZO CASTELLANOS", "names": ["LORENZO CASTELLANOS", "LORENZO"], "gender": "f", "first": 5, "spoke": 20}, {"id": 1, "name": "ABIGAIL", "names": ["ABIGAIL"], "gender": "?", "first": 6, "spoke": 11}, {"id": 2, "name": "PEPPER", "names": ["PEPPER"], "gender": "?", "first": 7, "spoke": 19}], "units": [{"u": 0, "kind": "heading", "text": "INT. FAMILY MINIVAN - PARKED OUTSIDE AN AMUSEMENT PARK - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Hot sun on the windshield.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A cooler on the back seat.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A crumpled map with a coffee ring.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The air conditioner wheezes.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LORENZO CASTELLANOS, 40s, in the driver's seat, grips the wheel and stares ahead.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "His wife, ABIGAIL, 40s, sits beside him with a crossword she is not doing.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "In the back, their daughter, PEPPER, 11, kicks the seat in front of her in steady, bored rhythm.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Are we going in?", "name": "PEPPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "In a minute.", "name": "LORENZO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "You said that ten minutes ago.", "name": "PEPPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "And I meant it ten minutes ago.", "name": "LORENZO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Abigail glances at him.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Says nothing.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "She taps her pencil on the page.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Mom, are we going in?", "name": "PEPPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Your father is thinking.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "About what?", "name": "PEPPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "About whether we can afford it.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "That's not what I said.", "name": "LORENZO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "It's what you meant.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "I meant I'd like a minute.", "name": "LORENZO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "You've had eleven.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "He releases the wheel.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "She sets down the crossword.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Pepper stops kicking.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Is something wrong?", "name": "PEPPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "No.", "name": "LORENZO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Yes.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Lorenzo shoots her a look.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "She holds it.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "She's old enough.", "name": "ABIGAIL", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "She's eleven.", "name": "LORENZO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "She's eleven and she has eyes.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "What's going on?", "name": "PEPPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Nothing's going on. Daddy just lost his job on Tuesday.", "name": "LORENZO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "The air conditioner wheezes.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Pepper's face goes very still.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Oh.", "name": "PEPPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "It's going to be fine.", "name": "LORENZO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Did you do something?", "name": "PEPPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "No. They closed the whole plant.", "name": "LORENZO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Everyone?", "name": "PEPPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Everyone.", "name": "LORENZO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "So it wasn't you.", "name": "PEPPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "It wasn't me.", "name": "LORENZO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Pepper nods.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Studies her hands.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "After a beat she unbuckles, climbs between the front seats, and wedges herself into the gap, pressing her head against his shoulder.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Can we still go in?", "name": "PEPPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "We have the tickets.", "name": "LORENZO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "We paid for them in March.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Then it's free.", "name": "PEPPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "That's not how that works.", "name": "LORENZO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "It's how it works for me.", "name": "PEPPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "He starts to laugh.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "It's cracked, half a sob, and Abigail puts a hand on his arm.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Pepper looks between them.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "Dad, are you crying?", "name": "PEPPER", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "No. I'm sweating. It's hot.", "name": "LORENZO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "You're crying.", "name": "PEPPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "A little.", "name": "LORENZO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "She wipes his cheek with her sleeve.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "He lets her.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "Abigail drops her head back against the seat and laughs, wet and helpless.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "All right. Everyone out.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "dialogue", "text": "What about the cooler?", "name": "LORENZO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 68, "kind": "dialogue", "text": "Leave it.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 69, "kind": "dialogue", "text": "Can I ride the big one?", "name": "PEPPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 70, "kind": "dialogue", "text": "The big one?", "name": "LORENZO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 71, "kind": "dialogue", "text": "The one with the loop.", "name": "PEPPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 72, "kind": "dialogue", "text": "You're not tall enough.", "name": "LORENZO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 73, "kind": "dialogue", "text": "I'll stand on my toes.", "name": "PEPPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 74, "kind": "dialogue", "text": "They measure at the ankle.", "name": "LORENZO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 75, "kind": "dialogue", "text": "Then I'll cheat.", "name": "PEPPER", "speaker": 2, "ext": [], "paren": ["grinning"], "dual": false, "present": [0, 1, 2]}, {"u": 76, "kind": "action", "text": "The three of them clamber out.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 77, "kind": "action", "text": "The doors slam.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 78, "kind": "action", "text": "Pepper takes off across the lot at a dead run.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 79, "kind": "action", "text": "Lorenzo and Abigail follow, side by side, his hand reaching for hers.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 80, "kind": "action", "text": "Halfway there, Abigail stops dead.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 81, "kind": "action", "text": "Turns.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 82, "kind": "dialogue", "text": "Did you lock the van?", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 83, "kind": "action", "text": "Lorenzo looks at the keys.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 84, "kind": "action", "text": "At the van.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 85, "kind": "action", "text": "Back at her.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 86, "kind": "dialogue", "text": "Does it matter?", "name": "LORENZO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 87, "kind": "action", "text": "She thinks about it.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 88, "kind": "action", "text": "Starts to laugh again, and they run after their daughter, leaving the minivan wide open under the sun.", "para": 12, "sent": 1, "present": [0, 1, 2]}]}