{"scene_id": "s01397", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01397.fountain", "heading": "INT. GRANDMOTHER'S ATTIC - EVENING", "cast": [{"id": 0, "name": "HAZEL", "names": ["HAZEL"], "gender": "?", "first": 3, "spoke": 7}, {"id": 1, "name": "GUS", "names": ["GUS"], "gender": "m", "first": 4, "spoke": 2}, {"id": 2, "name": "RAFAELA", "names": ["RAFAELA"], "gender": "?", "first": 5, "spoke": 5}, {"id": 3, "name": "GRANDMA", "names": ["GRANDMA"], "gender": "?", "first": 11, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRANDMOTHER'S ATTIC - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Dust motes in slanted light.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Steamer trunks, a dress form, a rocking horse missing one ear.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "HAZEL, 12, rummages through a trunk with fierce concentration.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "Behind her, her little brother GUS, 6, hides under a sheet draped over a chair.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "A third figure, their cousin RAFAELA, 14, leans in the doorway with her arms folded.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "It has to be here.", "name": "HAZEL", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "She pulls out a lace shawl.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Tosses it.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "A feather boa.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "A sock.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Grandma said not to touch anything.", "name": "RAFAELA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "She said not to break anything.", "name": "HAZEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Same thing.", "name": "RAFAELA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "It really isn't.", "name": "HAZEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "The sheet rustles.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Gus peeks out.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "I'm a ghost.", "name": "GUS", "speaker": 1, "ext": [], "paren": ["to all of them"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "You're a pest.", "name": "HAZEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Boo.", "name": "GUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Gus, come out of there.", "name": "RAFAELA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "He doesn't.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "She steps over.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Lifts a corner of the sheet.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "He squeals and swats her hand away.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Hazel finds it.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "A small tin box, rusted at the hinge.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "She holds it up to the light, breathing hard.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Got it.", "name": "HAZEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Don't open it.", "name": "RAFAELA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Why not?", "name": "HAZEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Because she'll know.", "name": "RAFAELA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "She already knows everything.", "name": "HAZEL", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Hazel pries it open.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Inside, folded neatly, a stack of old letters tied with a faded ribbon.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "She lifts the top one.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Reads the first line.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Her eyes widen.", "para": 6, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "She looks up.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Gus is silent under his sheet.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Rafaela has stopped moving.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "From downstairs, a voice calls up, warm and unhurried.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Children? Dinner!", "name": "GRANDMA", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "All three freeze.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Hazel snaps the tin shut.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}]}