{"scene_id": "s01398", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01398.fountain", "heading": "EXT. RAILWAY CUTTING - NIGHT", "cast": [{"id": 0, "name": "CAPTAIN HALVARD STRAND", "names": ["CAPTAIN HALVARD STRAND", "HALVARD"], "gender": "?", "first": 5, "spoke": 7}, {"id": 1, "name": "CORPORAL IBRAHIM DAOUD", "names": ["CORPORAL IBRAHIM DAOUD", "IBRAHIM"], "gender": "?", "first": 6, "spoke": 2}, {"id": 2, "name": "PRIVATE LENKA VESELY", "names": ["PRIVATE LENKA VESELY", "LENKA"], "gender": "f", "first": 7, "spoke": 1}, {"id": 3, "name": "FRITZ", "names": ["FRITZ"], "gender": "?", "first": 8, "spoke": 1}, {"id": 4, "name": "ACKERMANN", "names": ["ACKERMANN"], "gender": "?", "first": 8, "spoke": 0}, {"id": 5, "name": "PRISONER", "names": ["PRISONER"], "gender": "?", "first": 8, "spoke": 3}, {"id": 6, "name": "SERGEANT MAEVE O'DONNELL", "names": ["SERGEANT MAEVE O'DONNELL", "MAEVE"], "gender": "f", "first": 9, "spoke": 3}, {"id": 7, "name": "ANSELM", "names": ["ANSELM"], "gender": "?", "first": 25, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. RAILWAY CUTTING - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Frost on the ballast.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A burned-out locomotive lies on its side across the tracks, still ticking as the metal cools.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Moonlight on the rails.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A squad of six crouches in the lee of the wreck.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "CAPTAIN HALVARD STRAND, 40s, kneels with a map held under a red-filtered torch.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "CORPORAL IBRAHIM DAOUD, 30s, scans the embankment through a rifle scope.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "PRIVATE LENKA VESELY, 20s, holds a radio handset to her ear and mouths silent words.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "FRIEDRICH \"FRITZ\" ACKERMANN, 20s, a stretcher-bearer, wraps a bandage around the thigh of a gaunt figure who has not spoken since they found him in the mud: a PRISONER in a torn gray coat.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "action", "text": "SERGEANT MAEVE O'DONNELL, 50s, the oldest of them, rolls a cigarette she will not light and watches the prisoner's hands.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "dialogue", "text": "Three kilometers to the bridge.", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "They'll have it covered.", "name": "IBRAHIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "They'll have everything covered.", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "action", "text": "Lenka lowers the handset.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "action", "text": "Shakes her head.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "action", "text": "No signal.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "Of course there isn't.", "name": "MAEVE", "speaker": 6, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "action", "text": "The prisoner lifts his head.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "action", "text": "Looks at Maeve for the first time.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "action", "text": "His eyes are pale and amused.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "You will not make the bridge.", "name": "PRISONER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "He talks.", "name": "FRITZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Quiet.", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "I can lead you. A shorter way.", "name": "PRISONER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "Why would you?", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "My name is Anselm. I was a railwayman. This line was mine.", "name": "PRISONER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 26, "kind": "action", "text": "Halvard folds the map.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 27, "kind": "action", "text": "Studies the man.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 28, "kind": "action", "text": "Looks to Maeve, who gives the smallest shrug.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 29, "kind": "dialogue", "text": "There is a service tunnel. Under the cutting. It comes out two hundred meters from the bridge.", "name": "ANSELM", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "dialogue", "text": "It's a trap.", "name": "IBRAHIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "dialogue", "text": "It is a tunnel.", "name": "ANSELM", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "dialogue", "text": "Captain, I'd rather trust him than the road.", "name": "LENKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "dialogue", "text": "You'd rather trust a man in a German coat.", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "dialogue", "text": "It is not a German coat.", "name": "ANSELM", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "dialogue", "text": "Then whose is it?", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "dialogue", "text": "Mine.", "name": "ANSELM", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "action", "text": "Maeve lights the cigarette after all.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "action", "text": "Draws on it once, hands cupped around the ember.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "action", "text": "Exhales slowly.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "dialogue", "text": "Let him lead.", "name": "MAEVE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 41, "kind": "dialogue", "text": "Sergeant.", "name": "HALVARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 42, "kind": "dialogue", "text": "If he walks us into a gun, I shoot him first.", "name": "MAEVE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 43, "kind": "dialogue", "text": "That is fair.", "name": "ANSELM", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 44, "kind": "action", "text": "Halvard folds the torch away.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 45, "kind": "action", "text": "Rises.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 46, "kind": "action", "text": "The squad rises with him, silent, shouldering packs and weapons.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 47, "kind": "action", "text": "Fritz hauls Anselm to his feet, and the prisoner, limping, leads the line down the embankment toward a small round hole in the rock.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 48, "kind": "action", "text": "At its mouth, he turns back to the group and, for the first time, smiles.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}