{"scene_id": "s01399", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01399.fountain", "heading": "INT. SNOW CAVE - NIGHT", "cast": [{"id": 0, "name": "CALLUM TREMBLAY", "names": ["CALLUM TREMBLAY", "CALLUM"], "gender": "m", "first": 6, "spoke": 15}, {"id": 1, "name": "INGRID VOSSBERG", "names": ["INGRID VOSSBERG", "INGRID"], "gender": "f", "first": 8, "spoke": 8}, {"id": 2, "name": "SEUN", "names": ["SEUN"], "gender": "?", "first": 9, "spoke": 8}, {"id": 3, "name": "ADEYEMI", "names": ["ADEYEMI"], "gender": "?", "first": 9, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. SNOW CAVE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A hollow dug into a drift, barely large enough for three.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The roof glows faintly blue from a single stub of candle.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Condensation drips from an icicle fringe.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Packs, ropes, a dented stove.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "The wind sounds like a distant crowd.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "CALLUM TREMBLAY, 40s, expedition leader, frost in his beard, lies propped against the wall with his leg stretched awkwardly before him, wrapped in a sleeping bag.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "He has the calm of a man who has already made peace with something.", "para": 2, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "INGRID VOSSBERG, 30s, climber, her jacket half open and her face raw from wind, sits cross-legged, melting snow in a tin cup over the flame.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "OLUWASEUN \"SEUN\" ADEYEMI, 20s, the youngest, hugs his knees in the corner, eyes huge, a ski mask pulled up over his forehead.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "How long was I out?", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Four hours.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Feels like four minutes.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "That's the cold. It lies.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Seun. You all right?", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "I'm fine.", "name": "SEUN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "You're a terrible liar.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "I'm cold.", "name": "SEUN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Everybody's cold.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Drink this.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "She hands Callum the tin cup.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "He sips.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Passes it to Seun, who drinks and coughs.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "We had a good summit.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "We did.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "The light at the top.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "I saw it.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "I didn't. I had my eyes closed.", "name": "SEUN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "For the whole thing?", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "For most of it.", "name": "SEUN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Callum laughs, and it turns into a cough.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Ingrid waits it out.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "The candle flickers.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Listen. If the weather holds, you two go down at first light.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "We all go down.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "I'm slowing you.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "You're our leader.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Which is why I'm telling you.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "No.", "name": "SEUN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Seun--", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "I'm not leaving you.", "name": "SEUN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "That's not a decision you get to make.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Watch me.", "name": "SEUN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "A beat.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Callum studies him with something like pride.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Where did you find this one, Ingrid?", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "A bus station in Nairobi.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Good bus station.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "It was a good bus.", "name": "SEUN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "The candle gutters.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Ingrid shields it with her palm.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "The three of them watch the little flame in silence, and outside the wind drops, for the first time in hours, to almost nothing.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}]}