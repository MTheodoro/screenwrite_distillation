{"scene_id": "s01401", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01401.fountain", "heading": "EXT. MOUNTAIN PASS - GUN POSITION - DAWN", "cast": [{"id": 0, "name": "CAPTAIN YEVGENY ROSTOV", "names": ["CAPTAIN YEVGENY ROSTOV", "YEVGENY"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "LIEUTENANT BEATRIZ SALAZAR", "names": ["LIEUTENANT BEATRIZ SALAZAR", "BEATRIZ"], "gender": "?", "first": 5, "spoke": 2}, {"id": 2, "name": "SERGEANT KOFI MENSAH", "names": ["SERGEANT KOFI MENSAH", "KOFI"], "gender": "?", "first": 6, "spoke": 4}, {"id": 3, "name": "CORPORAL DALTON PIKE", "names": ["CORPORAL DALTON PIKE", "DALTON"], "gender": "m", "first": 7, "spoke": 1}, {"id": 4, "name": "PRIVATE ANNELIESE VOGT", "names": ["PRIVATE ANNELIESE VOGT", "ANNELIESE"], "gender": "f", "first": 8, "spoke": 1}, {"id": 5, "name": "TOMAS", "names": ["TOMAS"], "gender": "?", "first": 9, "spoke": 2}, {"id": 6, "name": "SHELL", "names": ["SHELL"], "gender": "?", "first": 34, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. MOUNTAIN PASS - GUN POSITION - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Snow.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rock.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A barricade of sandbags.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CAPTAIN YEVGENY ROSTOV, 40s, fur collar, studies the valley through binoculars.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside him, LIEUTENANT BEATRIZ SALAZAR, 30s, cleans a sidearm.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "SERGEANT KOFI MENSAH, 40s, shoulders a crate.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "CORPORAL DALTON PIKE, 20s, shivers.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "PRIVATE ANNELIESE VOGT, 19, chews her lip.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "And a boy soldier, TOMAS, 16, grips a radio.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Quiet.", "name": "YEVGENY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "Wind.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "A distant engine.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "They're early.", "name": "BEATRIZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "They always are.", "name": "YEVGENY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Kofi sets down the crate.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Pries it open.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Grenades.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Dawn special.", "name": "KOFI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Can't feel my fingers.", "name": "DALTON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Then you'll feel nothing when they hit.", "name": "KOFI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "That's not funny.", "name": "ANNELIESE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "It's not meant to be.", "name": "KOFI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Tomas holds up the radio.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "His voice cracks.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Captain! Sir! They say two columns!", "name": "TOMAS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Which flank?", "name": "YEVGENY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Both!", "name": "TOMAS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Yevgeny lowers the binoculars.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "The engine grows.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "We hold.", "name": "BEATRIZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "^ We hold.", "name": "KOFI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Both look at each other.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "A grim, small smile.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "A SHELL screams in.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "White geyser.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "The barricade rattles.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "Snow rains down on all of them.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "Dalton throws himself flat.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "Anneliese screams.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "Tomas drops the radio.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "Yevgeny stands, completely still, watching the ridge.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "dialogue", "text": "Positions!", "name": "YEVGENY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "They scramble.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}]}