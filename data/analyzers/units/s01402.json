{"scene_id": "s01402", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01402.fountain", "heading": "INT. FEDERAL COURTHOUSE - JURY DELIBERATION ROOM - DAY", "cast": [{"id": 0, "name": "GUS", "names": ["GUS"], "gender": "?", "first": 7, "spoke": 12}, {"id": 1, "name": "PELLETIER", "names": ["PELLETIER"], "gender": "?", "first": 7, "spoke": 0}, {"id": 2, "name": "DELPHINE OKAFOR-ROSS", "names": ["DELPHINE OKAFOR-ROSS", "DELPHINE"], "gender": "f", "first": 8, "spoke": 6}, {"id": 3, "name": "BUZZ", "names": ["BUZZ"], "gender": "m", "first": 9, "spoke": 12}, {"id": 4, "name": "TEMPLETON", "names": ["TEMPLETON"], "gender": "?", "first": 9, "spoke": 0}, {"id": 5, "name": "ISADORA FLINT", "names": ["ISADORA FLINT", "ISADORA"], "gender": "f", "first": 10, "spoke": 8}, {"id": 6, "name": "BAILIFF", "names": ["BAILIFF"], "gender": "?", "first": 63, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. FEDERAL COURTHOUSE - JURY DELIBERATION ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A long oak table.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Water pitcher.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A window with the blinds half drawn.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Legal pads scattered like leaves.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Four jurors remain: a retired schoolteacher, a night-shift nurse, a mechanic, and a young law student.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "They have been here since nine.", "para": 1, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "AUGUSTINE \"GUS\" PELLETIER, 60s, retired teacher, sits at the head with his reading glasses in his lap.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "DELPHINE OKAFOR-ROSS, 40s, nurse, rubs her temples.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "MARCUS \"BUZZ\" TEMPLETON, 50s, mechanic, leans back until his chair creaks.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "And ISADORA FLINT, 20s, law student, sits ramrod straight, pen poised.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "We've been going in circles.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "We've been going in squares.", "name": "BUZZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Buzz, please.", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "I'm just saying. Different shape.", "name": "BUZZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Gus, can I propose something?", "name": "ISADORA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Of course, Isadora.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "We take a fresh vote. Anonymous. Written.", "name": "ISADORA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "We did that.", "name": "BUZZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "We did a show of hands.", "name": "ISADORA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Same thing.", "name": "BUZZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "It really isn't.", "name": "ISADORA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Delphine tears four slips from a legal pad.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Passes them around.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Pens scratch.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Slips are folded and slid across the table.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Gus gathers them.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Unfolds one.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Another.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Reads.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "His eyebrows lift.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Three guilty. One not.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Who's the holdout?", "name": "BUZZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "It's anonymous, Buzz.", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "I can count. It's you, Delphine.", "name": "BUZZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "It is not.", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Then it's you, Isadora.", "name": "BUZZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "I voted guilty.", "name": "ISADORA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "So did I. So that leaves...", "name": "BUZZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "All three turn slowly to look at Gus.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "He sets down the slips.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Yes.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "You?", "name": "BUZZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "Me.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Gus, the evidence--", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Was very good. I know.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Then why--", "name": "ISADORA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "Because I taught that boy. Fifteen years ago.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "The window blinds tick against the sill.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "You never said.", "name": "BUZZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "I wasn't asked.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "That's grounds for a mistrial.", "name": "ISADORA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "Possibly.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "You should tell the judge.", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "I will.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "Well, hell.", "name": "BUZZ", "speaker": 3, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "Gus stands.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "His chair scrapes.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "He takes his glasses from his lap and walks to the door, one hand on the frame.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "Delphine, Buzz, Isadora. You have been fair. Thank you.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "He knocks twice on the door.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "The lock clicks.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "A BAILIFF opens it.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 64, "kind": "dialogue", "text": "Bailiff. Please tell Judge Hanratty I need a word.", "name": "GUS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 65, "kind": "action", "text": "The door closes behind him.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 66, "kind": "action", "text": "The three jurors sit in silence.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 67, "kind": "dialogue", "text": "Well.", "name": "ISADORA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 68, "kind": "dialogue", "text": "Well.", "name": "DELPHINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 69, "kind": "dialogue", "text": "Anyone want a sandwich?", "name": "BUZZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 70, "kind": "action", "text": "Delphine laughs, once, surprised.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 71, "kind": "action", "text": "Isadora, despite herself, smiles.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 72, "kind": "action", "text": "Buzz pushes back his chair, stretches, and the three of them let out a breath they have been holding all day.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}]}