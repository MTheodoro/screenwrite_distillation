{"scene_id": "s01403", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01403.fountain", "heading": "INT. CATERING TRUCK - PARKED BEHIND A WEDDING TENT - DAY", "cast": [{"id": 0, "name": "CHEF BARNABUS TSUKAMOTO", "names": ["CHEF BARNABUS TSUKAMOTO", "BARNABUS"], "gender": "m", "first": 4, "spoke": 8}, {"id": 1, "name": "PETRONELLA VOSKUIJLEN", "names": ["PETRONELLA VOSKUIJLEN", "PETRONELLA"], "gender": "?", "first": 7, "spoke": 2}, {"id": 2, "name": "DEXTER IYAMU", "names": ["DEXTER IYAMU", "DEXTER"], "gender": "?", "first": 8, "spoke": 4}, {"id": 3, "name": "LAVINIA CROFT", "names": ["LAVINIA CROFT", "LAVINIA"], "gender": "?", "first": 9, "spoke": 4}, {"id": 4, "name": "REGGIE", "names": ["REGGIE"], "gender": "?", "first": 46, "spoke": 3}, {"id": 5, "name": "PRIMROSE", "names": ["PRIMROSE"], "gender": "?", "first": 46, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. CATERING TRUCK - PARKED BEHIND A WEDDING TENT - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Steel counters.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Trays of canap\u00e9s.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cake in four tiers lashed to the floor with bungee cords.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CHEF BARNABUS TSUKAMOTO, 50s, tall white hat, stands at the center of it all.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Sweat drips off his nose into a bowl of crab dip.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Nobody mentions it.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "He pushes the bowl across the counter to his sous-chef, PETRONELLA VOSKUIJLEN, 30s, who takes it with a face like stone.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Behind them, bartender DEXTER IYAMU, 20s, shakes a shaker with the dead-eyed rhythm of a metronome.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "And at the door, the wedding planner, MS. LAVINIA CROFT, 40s, taps her earpiece, eyes darting.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Is the cake ready?", "name": "LAVINIA", "speaker": 3, "ext": [], "paren": ["tight smile"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "It's ready.", "name": "BARNABUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Is it level?", "name": "LAVINIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Barnabus looks at the cake.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "The cake leans, slightly, toward the door.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Dexter stops shaking.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Level enough.", "name": "BARNABUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Petronella sets the dip down and, without a word, slides a wooden spoon under the bottom tier.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Barnabus clears his throat.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "I'm hearing ten minutes.", "name": "LAVINIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "We'll be there in nine.", "name": "BARNABUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Ten.", "name": "LAVINIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Nine and a half.", "name": "BARNABUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Lavinia nods.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Taps her earpiece.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Her eyes flick to the cake again, and then to Barnabus, and she goes out.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "The door swings shut.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Then Dexter exhales.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "She knows.", "name": "DEXTER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "She doesn't know.", "name": "PETRONELLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "She knows.", "name": "DEXTER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "She suspects.", "name": "BARNABUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Petronella jams another spoon under the tier.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "The cake groans.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "A sugar rose slides off the top and drops onto the floor.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Everyone stares at it.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Dexter picks it up.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Eats it.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Dexter.", "name": "BARNABUS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Evidence.", "name": "DEXTER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Barnabus closes his eyes.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Pinches the bridge of his nose.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "His hat has slumped sideways.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "A KNOCK.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "The door cracks open and a head pops in.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "THEODORE \"REGGIE\" PRIMROSE, 30s, the groom, white tuxedo, a flushed and dazzled grin.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "Hey! Just wondering how's it going?", "name": "REGGIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "Fine.", "name": "PETRONELLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "Wonderful.", "name": "DEXTER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "Magnificent.", "name": "BARNABUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Reggie beams.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "Looks at the cake.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "His smile slowly falters.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "Is it... meant to lean?", "name": "REGGIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "Nobody breathes.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "The cake sags another inch.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "It's a Pisan reference.", "name": "BARNABUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "Reggie considers this.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "Then nods, slowly, delighted.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "Oh. Oh, that's brilliant.", "name": "REGGIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "He gives them two thumbs up and withdraws.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "The door closes.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "They stare at each other.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "Dexter reaches for a bottle.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "Petronella reaches for a spoon.", "para": 16, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "action", "text": "And together, they lift the cake.", "para": 16, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}]}