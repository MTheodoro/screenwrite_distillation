{"scene_id": "s01404", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01404.fountain", "heading": "INT. PAWNSHOP - BACK ROOM - NIGHT", "cast": [{"id": 0, "name": "MOE", "names": ["MOE"], "gender": "?", "first": 3, "spoke": 7}, {"id": 1, "name": "LASALLE", "names": ["LASALLE"], "gender": "?", "first": 3, "spoke": 0}, {"id": 2, "name": "ZOFIA KRAWCZYK", "names": ["ZOFIA KRAWCZYK", "ZOFIA"], "gender": "?", "first": 4, "spoke": 4}, {"id": 3, "name": "RECORDING", "names": ["RECORDING"], "gender": "?", "first": 23, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. PAWNSHOP - BACK ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Shelves of guitars, watches, and wedding rings under a single hanging bulb.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A poker table with a half-played hand still on it.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "MORDECAI \"MOE\" LASALLE, 50s, pawnbroker, shuffles a deck, humming.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "Across from him, a young woman, ZOFIA KRAWCZYK, 20s, drums her fingers.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "Zofia. Sweetheart. You came alone.", "name": "MOE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Like you said.", "name": "ZOFIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Good girl.", "name": "MOE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "I'm not your girl, Moe.", "name": "ZOFIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Everyone's somebody's girl.", "name": "MOE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "He deals.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "She doesn't touch her cards.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Anyone else want in?", "name": "MOE", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the empty room"], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "She smiles, thin.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "You think I'm stupid.", "name": "ZOFIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "I think you're tired.", "name": "MOE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I'm tired of you, Moe.", "name": "ZOFIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "She reaches under the table.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Moe's shuffling stops.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Oh, don't.", "name": "MOE", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Zofia lays a small recorder on the felt.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Presses play.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "...and I told him, if the Kessler job goes wrong, it's on Zofia.", "name": "RECORDING", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Moe stares at the recorder.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Then, very slowly, he laughs.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Smart girl.", "name": "MOE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}