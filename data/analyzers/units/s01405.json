{"scene_id": "s01405", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01405.fountain", "heading": "INT. VINEYARD TASTING ROOM - AFTERNOON", "cast": [{"id": 0, "name": "CLAUDETTE ARMSTRONG-BEAUMONT", "names": ["CLAUDETTE ARMSTRONG-BEAUMONT", "CLAUDETTE"], "gender": "?", "first": 4, "spoke": 25}, {"id": 1, "name": "GREGOR VANDERWAAL", "names": ["GREGOR VANDERWAAL", "GREGOR"], "gender": "m", "first": 8, "spoke": 24}], "units": [{"u": 0, "kind": "heading", "text": "INT. VINEYARD TASTING ROOM - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Golden light through tall windows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of oak barrels line the back wall.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A long bar of reclaimed wood, a few empty glasses, a bucket of ice.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CLAUDETTE ARMSTRONG-BEAUMONT, 30s, in a linen shirt, wipes down the bar.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She hums.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "She's happy to be alone.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "The door chimes.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "In steps GREGOR VANDERWAAL, 30s, sunglasses on his head, a messenger bag across his chest.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He pauses on the threshold, as if he has forgotten what he came for.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "We're closed.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I know.", "name": "GREGOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "The sign says closed.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "I read the sign.", "name": "GREGOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "And?", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I wanted to say something to you.", "name": "GREGOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She keeps wiping.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Slower now.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Her back stiffens, and her eyes find his reflection in the glass behind the bar.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Then say it.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Can I sit?", "name": "GREGOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Suit yourself.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "He sits on a stool two down from where she works.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Sets down his bag.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Straightens it.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Straightens it again.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "I've rehearsed this for eleven months.", "name": "GREGOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Then it should be perfect.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "It isn't.", "name": "GREGOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Go on.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "When you left, I told everyone it was mutual.", "name": "GREGOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "It was.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "It wasn't.", "name": "GREGOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "I said it was.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "You said it because I couldn't.", "name": "GREGOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "She folds the rag.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Lays it flat.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Stares at it.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "I got a job in Napa. I took it.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "I know.", "name": "GREGOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "You could have asked me to stay.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "I was afraid you'd say yes.", "name": "GREGOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "That's absurd.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "I know.", "name": "GREGOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "What were you afraid of?", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "That you'd stay and resent me.", "name": "GREGOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "I wouldn't have.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "You would have, a little.", "name": "GREGOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "She almost smiles.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "Catches it.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "Turns to the barrels, hands flat on the counter, her back to him.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "It's a good vintage this year.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "I'm sure it is.", "name": "GREGOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "I made the blend myself.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "Of course you did.", "name": "GREGOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "Do you want to taste it?", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "A long beat.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "He doesn't answer.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "She turns.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "Takes down a glass, pours a splash of dark red, and slides it across the bar.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "He lifts it.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "Smells.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "Tastes.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "His eyes close.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "Plums.", "name": "GREGOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "And?", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "Something smoky.", "name": "GREGOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "Cedar. From the barrel.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "It's wonderful.", "name": "GREGOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "It's slightly overworked.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "Don't undersell it.", "name": "GREGOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "dialogue", "text": "Don't flatter me.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 72, "kind": "dialogue", "text": "Claude.", "name": "GREGOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 73, "kind": "dialogue", "text": "Don't call me that.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 74, "kind": "dialogue", "text": "Claudette.", "name": "GREGOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 75, "kind": "dialogue", "text": "Yes.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 76, "kind": "dialogue", "text": "Did you see my letters?", "name": "GREGOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 77, "kind": "dialogue", "text": "I saw them.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 78, "kind": "dialogue", "text": "Did you read them?", "name": "GREGOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 79, "kind": "action", "text": "She turns away again.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 80, "kind": "action", "text": "Reaches under the bar.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 81, "kind": "action", "text": "Brings out a shoebox, wrapped in twine, its lid curled from handling.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 82, "kind": "action", "text": "She sets it between them.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 83, "kind": "action", "text": "He stares at it.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 84, "kind": "action", "text": "She stares at him.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 85, "kind": "action", "text": "Neither moves.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 86, "kind": "dialogue", "text": "All of them.", "name": "CLAUDETTE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 87, "kind": "action", "text": "His hand reaches out.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 88, "kind": "action", "text": "Covers hers.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 89, "kind": "action", "text": "The box sits beneath their joined fingers.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 90, "kind": "action", "text": "The door chimes again behind them.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 91, "kind": "action", "text": "A delivery man in a brown uniform sticks his head in, sees the pair of them frozen, and quietly withdraws.", "para": 12, "sent": 1, "present": [0, 1]}]}