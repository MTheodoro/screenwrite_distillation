{"scene_id": "s01406", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01406.fountain", "heading": "INT. APARTMENT - KITCHEN - DAWN", "cast": [{"id": 0, "name": "BERNADETTE OYELARAN-STACK", "names": ["BERNADETTE OYELARAN-STACK", "BERNADETTE"], "gender": "f", "first": 6, "spoke": 6}, {"id": 1, "name": "NURSE", "names": ["NURSE"], "gender": "?", "first": 16, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. APARTMENT - KITCHEN - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A small kitchen.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Linoleum.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A kettle on the stove, steam rising.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Two mugs on the counter, one chipped.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A coat hangs on the back of the door, a man's coat, gray wool.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "BERNADETTE OYELARAN-STACK, 60s, in a bathrobe, stands at the sink with her hands under the tap.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "The water runs a long time.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "She doesn't wash anything.", "para": 1, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "The phone on the wall rings.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "Once.", "para": 2, "sent": 1, "present": [0]}, {"u": 11, "kind": "action", "text": "Twice.", "para": 2, "sent": 2, "present": [0]}, {"u": 12, "kind": "action", "text": "Three times.", "para": 2, "sent": 3, "present": [0]}, {"u": 13, "kind": "action", "text": "She lets it.", "para": 2, "sent": 4, "present": [0]}, {"u": 14, "kind": "action", "text": "Finally she dries her hands on the robe, reaches over, and picks it up.", "para": 2, "sent": 5, "present": [0]}, {"u": 15, "kind": "dialogue", "text": "Hello.", "name": "BERNADETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 16, "kind": "dialogue", "text": "Mrs. Stack? This is Carol, from the hospice.", "name": "NURSE", "speaker": 1, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Yes.", "name": "BERNADETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "I'm so sorry to call so early.", "name": "NURSE", "speaker": 1, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "That's all right.", "name": "BERNADETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "He passed about an hour ago. Very peacefully.", "name": "NURSE", "speaker": 1, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Bernadette nods.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Looks at the coat on the door.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Looks at the two mugs.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Thank you for telling me.", "name": "BERNADETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Would you like us to send someone?", "name": "NURSE", "speaker": 1, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "No. Not yet.", "name": "BERNADETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Is there anyone with you?", "name": "NURSE", "speaker": 1, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "I'm fine.", "name": "BERNADETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "She hangs up.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Stands very still.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "The kettle begins to whistle, thin and rising.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "She turns off the burner.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Takes the chipped mug from the counter.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Pours.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "The tea steams.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "She sets it in front of the empty chair at the table and sits across from it.", "para": 5, "sent": 4, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "The whistle fades.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "She wraps both hands around the other mug and holds it close.", "para": 6, "sent": 1, "present": [0, 1]}]}