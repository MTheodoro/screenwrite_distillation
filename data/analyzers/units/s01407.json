{"scene_id": "s01407", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01407.fountain", "heading": "INT. VICTORIAN SEANCE PARLOR - NIGHT", "cast": [{"id": 0, "name": "MADAME ODILE FONTAINE-VANCE", "names": ["MADAME ODILE FONTAINE-VANCE", "ODILE"], "gender": "f", "first": 4, "spoke": 3}, {"id": 1, "name": "ALISTAIR DRAKE", "names": ["ALISTAIR DRAKE", "ALISTAIR"], "gender": "?", "first": 5, "spoke": 3}, {"id": 2, "name": "PRUDENCE MILLWARD", "names": ["PRUDENCE MILLWARD"], "gender": "f", "first": 6, "spoke": 0}, {"id": 3, "name": "VOICE", "names": ["VOICE"], "gender": "?", "first": 15, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. VICTORIAN SEANCE PARLOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Velvet drapes, a round table, a crystal ball veiled in black gauze.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single candle gutters.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain taps the windows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MADAME ODILE FONTAINE-VANCE, 50s, turban and shawl, sits with her palms flat on the table, eyes closed.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across from her, ALISTAIR DRAKE, 40s, widower, grips the edge of his chair.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "And in the corner, her assistant, a nervous girl of twenty, PRUDENCE MILLWARD, tends a hidden gramophone.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Spirits of the beyond. We call upon you.", "name": "ODILE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "The candle flickers.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "A low moan sounds from beyond the drapes.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Is it her?", "name": "ALISTAIR", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Hush.", "name": "ODILE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "The moan rises.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "The table shudders.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Alistair's knuckles whiten.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Alistair...", "name": "VOICE", "speaker": 3, "ext": ["V.O."], "paren": ["hollow, distant"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "He gasps.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Half rises.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Margaret?", "name": "ALISTAIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "I am here, my love.", "name": "VOICE", "speaker": 3, "ext": ["V.O."], "paren": ["hollow, distant"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Prudence, in the corner, goes pale.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "She mouths at Odile, shaking her head.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Not me.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Odile's eyes snap open.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "She stares at the gramophone, which is silent.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "The voice comes again, deeper, nearer.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Tell the fraud to stop.", "name": "VOICE", "speaker": 3, "ext": ["V.O."], "paren": ["hollow, distant"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Odile's hands fly from the table.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Prudence knocks over her stool.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "That's not funny, Madame.", "name": "ALISTAIR", "speaker": 1, "ext": [], "paren": ["slowly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "It is not me.", "name": "ODILE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "The candle blows out.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Darkness.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Somewhere a window bangs open, and the drapes snap like sails.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}]}