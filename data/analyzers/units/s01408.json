{"scene_id": "s01408", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01408.fountain", "heading": "INT. STATE SUPREME COURT - APPELLATE CHAMBER - DAY", "cast": [{"id": 0, "name": "CHIEF JUSTICE OKSANA PETRENKO", "names": ["CHIEF JUSTICE OKSANA PETRENKO", "OKSANA"], "gender": "f", "first": 4, "spoke": 21}, {"id": 1, "name": "DESMOND CARUTHERS", "names": ["DESMOND CARUTHERS", "DESMOND"], "gender": "m", "first": 5, "spoke": 14}, {"id": 2, "name": "NADINE ASHWORTH-KIM", "names": ["NADINE ASHWORTH-KIM", "NADINE"], "gender": "f", "first": 6, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. STATE SUPREME COURT - APPELLATE CHAMBER - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Marble, mahogany, a high bench.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cameras off.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single pitcher of water sweats at the lectern.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CHIEF JUSTICE OKSANA PETRENKO, 60s, white hair pinned tight, sits alone on the bench with a pen balanced between two fingers.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "At the lectern, DESMOND CARUTHERS, 50s, rumpled suit, sweats through his notes.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "At the state's table, NADINE ASHWORTH-KIM, 40s, charcoal suit, a thick binder squared before her.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Your Honor, the statute is plain.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Plain to whom, Mr. Caruthers?", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "To any reasonable reader.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Are you reasonable?", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I try to be.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "That's not an answer.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "It's the only honest one I have.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "She almost smiles.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Taps the pen on the bench.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Take me through section four.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Section four governs notice.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "And your client?", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Received none.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Not even a letter?", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "A letter was mailed. It was never delivered.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Mailed to where?", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "An address where my client hadn't lived in six years.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Whose fault was that?", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "The county's. They had the forwarding card.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Nadine's pen stops moving.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Oksana sees it.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Ms. Ashworth-Kim. You have something to say?", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Not yet.", "name": "NADINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Then Mr. Caruthers continues.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Thank you. Your Honor, if the court allows this, thousands of cases reopen.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "I'm aware of that.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "And I'd ask the court to consider whether thousands of cases were ever properly closed.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "A silence.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Oksana sets down her pen.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "That's a bold sentence.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "It's a true one.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Sit down, Mr. Caruthers.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "He gathers his papers and retreats.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Nadine rises, walks to the lectern, and opens her binder.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "She does not look at it.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "May it please the court.", "name": "NADINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "It might. Go ahead.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "The forwarding card was misfiled.", "name": "NADINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "By whom?", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "By a clerk who no longer works for the county.", "name": "NADINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "That's not an excuse.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "It's not meant as one. It's an explanation.", "name": "NADINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "They sound similar from up here.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "They feel different from down here.", "name": "NADINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Oksana's eyebrow lifts.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Desmond, at his table, almost laughs and then stops himself.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "The state asks the court to apply the harmless error doctrine.", "name": "NADINE", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "^ It was not harmless!", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "^ It was administrative!", "name": "NADINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "Both of you.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "They stop.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "The room is very quiet.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "Mr. Caruthers, your client lost his house.", "name": "OKSANA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "Yes.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Ms. Ashworth-Kim. He lost his house.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "Nadine's hand tightens on the lectern.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "For a moment her composure slips.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "Yes. He did.", "name": "NADINE", "speaker": 2, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "Oksana lowers her glasses.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "Looks at one, then the other.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 67, "kind": "dialogue", "text": "We'll take it under advisement.", "name": "OKSANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "She raps once with her pen and rises.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "The two lawyers rise with her, and for a moment, across the length of the room, they look at each other like the last two people in a lifeboat.", "para": 10, "sent": 1, "present": [0, 1, 2]}]}