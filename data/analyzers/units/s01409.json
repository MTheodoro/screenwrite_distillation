{"scene_id": "s01409", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01409.fountain", "heading": "INT. BOXING GYM - LOCKER ROOM - NIGHT", "cast": [{"id": 0, "name": "MANUEL", "names": ["MANUEL"], "gender": "m", "first": 5, "spoke": 1}, {"id": 1, "name": "SERRANO", "names": ["SERRANO"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "IGNATIUS OBI-MARTINEZ", "names": ["IGNATIUS OBI-MARTINEZ", "IGNATIUS"], "gender": "m", "first": 6, "spoke": 6}, {"id": 3, "name": "TALL MAN", "names": ["TALL MAN"], "gender": "m", "first": 7, "spoke": 2}, {"id": 4, "name": "AMBROSE", "names": ["AMBROSE"], "gender": "?", "first": 20, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. BOXING GYM - LOCKER ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Steam.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rusted lockers.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A bare bulb swings from a chain.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The smell of liniment and old leather.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MANUEL \"THE ANVIL\" SERRANO, 30s, sits on a bench with gloved hands in his lap, staring at the floor.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "His trainer, IGNATIUS OBI-MARTINEZ, 60s, kneels in front of him, taping a wrist with absent care.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "A TALL MAN in a camel coat leans in the doorway.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "No one introduced him.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "He has been watching for a while.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Stay loose.", "name": "IGNATIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Manuel nods.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "His eyes do not leave the floor.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Breathe through the nose.", "name": "IGNATIUS", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Manuel breathes.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Ignatius tears the tape with his teeth.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "The Tall Man clears his throat.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Mr. Serrano.", "name": "TALL MAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Manuel doesn't look up.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Ignatius's hands stop.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "My name is Ambrose Vance. I represent the promoter.", "name": "TALL MAN", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "He's got a fight.", "name": "IGNATIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "I'm aware.", "name": "AMBROSE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "So you can wait outside.", "name": "IGNATIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "I can't.", "name": "AMBROSE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "The bulb swings.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Manuel's shadow slides across the lockers.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Ignatius rises, one knee cracking, and plants himself between them.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Say what you came to say.", "name": "IGNATIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "It's about the third round.", "name": "AMBROSE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Ignatius and Manuel both go still.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "The steam hisses from a pipe.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Mr. Serrano goes down in the third. The money is already placed.", "name": "AMBROSE", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "^ Get out.", "name": "IGNATIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "^ Get out.", "name": "MANUEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "They say it at the same time, quiet and level.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Ambrose lifts both hands, palms out, and steps back through the doorway into the corridor.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Ignatius shuts the door.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Leans against it with his eyes closed.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Manuel finally lifts his head.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "His gloved hands, slowly, curl into fists.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4]}]}