{"scene_id": "s01410", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01410.fountain", "heading": "INT. CORPORATE PARKING GARAGE - LEVEL P4 - NIGHT", "cast": [{"id": 0, "name": "SOLVEIG HARTMANN-OKORO", "names": ["SOLVEIG HARTMANN-OKORO", "SOLVEIG"], "gender": "f", "first": 5, "spoke": 5}, {"id": 1, "name": "VOICE", "names": ["VOICE"], "gender": "?", "first": 10, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. CORPORATE PARKING GARAGE - LEVEL P4 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Concrete pillars striped in yellow.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fluorescent tubes flicker above rows of empty parking bays.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A distant elevator dings.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Somewhere, a drip.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SOLVEIG HARTMANN-OKORO, 40s, in a camel coat with a laptop bag over one shoulder, walks fast between the pillars, keys splayed between her knuckles.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She looks like someone who has done this walk a hundred times and never liked it.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Her phone buzzes.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "She answers on the second ring, putting it to her ear.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "dialogue", "text": "Yes.", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 10, "kind": "dialogue", "text": "Are you at your car?", "name": "VOICE", "speaker": 1, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Nearly. Who is this?", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "A friend. Do you see the gray sedan?", "name": "VOICE", "speaker": 1, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She stops.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Scans the garage.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "A gray sedan sits two rows ahead, engine off.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "I see it.", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Don't go near it.", "name": "VOICE", "speaker": 1, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Why not?", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Because there's a man in the back seat.", "name": "VOICE", "speaker": 1, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Her breath catches.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She does not move.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Under the flicker of the lights she sees, very faintly, a shape in the window of the sedan.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "How do you know?", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Because I'm standing behind you.", "name": "VOICE", "speaker": 1, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "She spins.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Nothing.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Just a pillar and a puddle of oil, shining.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "The phone drops from her ear.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Behind her, the sedan's door clicks open.", "para": 6, "sent": 1, "present": [0, 1]}]}