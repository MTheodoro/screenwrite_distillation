{"scene_id": "s01411", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01411.fountain", "heading": "INT. REGIONAL AIRPORT - GATE B - NIGHT", "cast": [{"id": 0, "name": "FINN LARKSPUR-MBEKI", "names": ["FINN LARKSPUR-MBEKI", "FINN"], "gender": "f", "first": 4, "spoke": 14}, {"id": 1, "name": "MINA", "names": ["MINA"], "gender": "f", "first": 5, "spoke": 15}, {"id": 2, "name": "OSTROWSKI", "names": ["OSTROWSKI"], "gender": "?", "first": 5, "spoke": 0}, {"id": 3, "name": "GRANDPA TOBIAS", "names": ["GRANDPA TOBIAS", "TOBIAS"], "gender": "?", "first": 6, "spoke": 3}, {"id": 4, "name": "GRANDMA ESME ADEBAYO", "names": ["GRANDMA ESME ADEBAYO", "ESME"], "gender": "?", "first": 6, "spoke": 4}, {"id": 5, "name": "TANNOY", "names": ["TANNOY"], "gender": "?", "first": 7, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. REGIONAL AIRPORT - GATE B - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Empty chairs, a dim terminal.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A departure board flickers: ALL FLIGHTS DELAYED.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain streaks the windows onto a runway of dark glass.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "FINN LARKSPUR-MBEKI, 30s, rumpled, sits with a coffee and a boarding pass, scribbling in a notebook.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across the aisle, WILHELMINA \"MINA\" OSTROWSKI, 30s, clutches a small suitcase and stares at the floor, thumb worrying a loose ring on her finger.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "Two seats down, an old couple, GRANDPA TOBIAS and GRANDMA ESME ADEBAYO, 70s, share a thermos, bickering softly.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "dialogue", "text": "Attention passengers. Flight 418 to Denver is delayed until further notice.", "name": "TANNOY", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "action", "text": "A collective groan.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "action", "text": "Finn caps his pen.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Of course it is.", "name": "FINN", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "Mina looks up.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "Their eyes meet.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "She glances away first.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Long night.", "name": "FINN", "speaker": 0, "ext": ["CONT'D"], "paren": ["to Mina"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Seems so.", "name": "MINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "You headed to Denver?", "name": "FINN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Eventually.", "name": "MINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Me too. Business. You?", "name": "FINN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "A wedding.", "name": "MINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Whose?", "name": "FINN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Mine.", "name": "MINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Finn blinks.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Nods slowly.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Looks at the ring on her finger.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Congratulations?", "name": "FINN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Ask me in Denver.", "name": "MINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "He smiles.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "She almost does too.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "The old couple, across the aisle, are unabashedly listening.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "I told you she was nervous.", "name": "ESME", "speaker": 4, "ext": [], "paren": ["to Tobias"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "She's not nervous, she's sulking.", "name": "TOBIAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Nervous.", "name": "ESME", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "^ Sulking.", "name": "TOBIAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "They glare at each other.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Mina and Finn share a quiet look, and for the first time, both of them laugh.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "What's his name?", "name": "FINN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Gordon.", "name": "MINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Gordon.", "name": "FINN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "He's very kind.", "name": "MINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "That's a good thing.", "name": "FINN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "It is.", "name": "MINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "But?", "name": "FINN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "But nothing. He's kind.", "name": "MINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "She stands.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Walks to the window, her reflection lost against the rain.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Finn watches her back.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "He tears a page from his notebook, folds it, hesitates, then puts it in his pocket.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "Attention. Flight 418 will board in fifteen minutes.", "name": "TANNOY", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "Silence.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "Everyone looks up at the speaker.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "Fifteen minutes.", "name": "MINA", "speaker": 1, "ext": [], "paren": ["to the window"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "Enough time for a coffee.", "name": "FINN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "Enough time for anything.", "name": "MINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "She turns.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "Their eyes meet again.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "She crosses back and sits beside him, not across from him.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "Tell me something true.", "name": "MINA", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "dialogue", "text": "I don't like Denver.", "name": "FINN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "That's not it.", "name": "MINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "I'm going because I'm afraid to stay.", "name": "FINN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "dialogue", "text": "Of what?", "name": "MINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "dialogue", "text": "Of the place I'm supposed to be.", "name": "FINN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "She breathes out.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "Her hand finds his on the armrest.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "For a moment neither moves.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "dialogue", "text": "Final boarding call for Flight 418.", "name": "TANNOY", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "action", "text": "The old couple stand, collecting thermos and coats.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "action", "text": "Esme pauses at the end of the aisle, looks down at the pair of them.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "dialogue", "text": "Go on, dears. Or don't. But decide.", "name": "ESME", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "dialogue", "text": "Esme.", "name": "TOBIAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "dialogue", "text": "^ What? I'm eighty. I get to say.", "name": "ESME", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "action", "text": "She takes his arm and leads him toward the jetway.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "action", "text": "Finn and Mina watch them go.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "action", "text": "Then Mina slides the ring off her finger, slowly, and holds it in her open palm between them.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 75, "kind": "dialogue", "text": "Well. Here we are.", "name": "MINA", "speaker": 1, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 76, "kind": "action", "text": "Finn closes her fingers around the ring.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 77, "kind": "action", "text": "The board above them flickers once more and goes dark.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}