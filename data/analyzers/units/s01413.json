{"scene_id": "s01413", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01413.fountain", "heading": "INT. LAUNDROMAT - NIGHT", "cast": [{"id": 0, "name": "NORMAN BELLWETHER", "names": ["NORMAN BELLWETHER", "NORMAN"], "gender": "?", "first": 4, "spoke": 15}, {"id": 1, "name": "LEOCADIA", "names": ["LEOCADIA"], "gender": "?", "first": 5, "spoke": 13}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAUNDROMAT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Rows of washers churning.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A flickering sign in the window.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The smell of detergent and hot lint.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "NORMAN BELLWETHER, 50s, in pajama pants and a trench coat, folds a towel with military precision.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Two machines over, his daughter, LEOCADIA, 20s, stares at a spinning drum with a duffel bag at her feet.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Corners to corners.", "name": "NORMAN", "speaker": 0, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Dad.", "name": "LEOCADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Mm.", "name": "NORMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Why are you here?", "name": "LEOCADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Your mother said you were.", "name": "NORMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "That's not why.", "name": "LEOCADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "My machine broke.", "name": "NORMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "It's two in the morning.", "name": "LEOCADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "I couldn't sleep.", "name": "NORMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She watches the drum.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He folds the towel again, makes a perfect square, sets it on top of a stack.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "You don't have to follow me around.", "name": "LEOCADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "I wasn't.", "name": "NORMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "You were in the car outside my apartment last night.", "name": "LEOCADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "He stops folding.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Looks at the towel as though it might help him.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "It was on my way.", "name": "NORMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "To what?", "name": "LEOCADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Nowhere. Everywhere.", "name": "NORMAN", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "The machine beeps.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Spin cycle ending.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Leocadia opens the door, pulls out a damp bundle, and begins to load a dryer.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Norman moves to help.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "She stops him with a look.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "I'm leaving Friday.", "name": "LEOCADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "I know.", "name": "NORMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Mom told you?", "name": "LEOCADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "She didn't have to.", "name": "NORMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "He takes a sock off the pile, turns it right side out, hands it to her.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "She takes it, and he lets his fingers rest against hers a moment too long.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Dad.", "name": "LEOCADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "I'm fine.", "name": "NORMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "You're crying.", "name": "LEOCADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "It's the lint.", "name": "NORMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "She laughs through her nose.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "He turns away, pulls a handkerchief from the trench coat, and blows it with great dignity.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Damn lint.", "name": "NORMAN", "speaker": 0, "ext": ["CONT'D"], "paren": ["muttering"], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "She loads the rest of the clothes, closes the dryer door, and feeds in quarters one at a time.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "The drum begins to turn.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Sit with me.", "name": "LEOCADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "They sit on the long bench in front of the dryer.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "The clothes tumble in warm circles.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Do you have enough socks?", "name": "NORMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Dad.", "name": "LEOCADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "I'm only asking.", "name": "NORMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "Her head tips onto his shoulder.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "He freezes, then slowly lets his cheek rest against her hair.", "para": 9, "sent": 1, "present": [0, 1]}]}