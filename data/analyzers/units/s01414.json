{"scene_id": "s01414", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01414.fountain", "heading": "EXT. DRY CREEKBED - HIGH NOON", "cast": [{"id": 0, "name": "SHERIFF ABNER TOLLIVER", "names": ["SHERIFF ABNER TOLLIVER", "ABNER"], "gender": "m", "first": 5, "spoke": 15}, {"id": 1, "name": "PERCY", "names": ["PERCY"], "gender": "?", "first": 7, "spoke": 7}, {"id": 2, "name": "DUNMORE", "names": ["DUNMORE"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "ESPERANZA QUILLAN", "names": ["ESPERANZA QUILLAN", "ESPERANZA"], "gender": "f", "first": 9, "spoke": 7}, {"id": 4, "name": "SILAS DEARBORN-FLYNT", "names": ["SILAS DEARBORN-FLYNT", "SILAS"], "gender": "m", "first": 40, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DRY CREEKBED - HIGH NOON", "present": []}, {"u": 1, "kind": "action", "text": "Cracked mud.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A burnt wagon tilts on its axle.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Buzzards circle high above.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single dead cottonwood throws a thin ribbon of shade.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SHERIFF ABNER TOLLIVER, 50s, gray mustache, sits on a flat rock and cleans his revolver with a bandanna.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "He is in no hurry.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Nearby, his deputy, PERCIVAL \"PERCY\" DUNMORE, 20s, paces with a rifle across his shoulder, sweating through his shirt.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Across the dry creek, a woman crouches by the wagon, sifting ash through her fingers.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "ESPERANZA QUILLAN, 30s, in a man's hat and a dusty duster, doesn't look up.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Sheriff, we've been here an hour.", "name": "PERCY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Two.", "name": "ABNER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "She hasn't moved.", "name": "PERCY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Neither have I.", "name": "ABNER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "She's looking for something.", "name": "PERCY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Everyone is.", "name": "ABNER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Percy shifts the rifle to the other shoulder.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Esperanza stands, brushes her hands, and crosses the creekbed to them with an unhurried step.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Afternoon.", "name": "ESPERANZA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Ma'am.", "name": "ABNER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "This your wagon?", "name": "ESPERANZA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Used to be.", "name": "ABNER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "It's a shame.", "name": "ESPERANZA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "It's the cost of doing business.", "name": "ABNER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Whose business?", "name": "ESPERANZA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Mine, until Tuesday.", "name": "ABNER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "She nods slowly.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Pulls a folded paper from her pocket, hands it to him.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "He reads it, his mustache twitching.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Then he laughs, once, without joy.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Well, I'll be.", "name": "ABNER", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "What is it?", "name": "PERCY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Deed to the whole valley.", "name": "ABNER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Whose name's on it?", "name": "PERCY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Hers.", "name": "ABNER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "A new sound.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Hooves in the distance.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "All three turn.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "A rider emerges from the heat shimmer, big black horse lathered white, a rifle across his saddle.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "He reins in at the edge of the creekbed.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "SILAS DEARBORN-FLYNT, 60s, face like a hatchet, tips his hat.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Sheriff.", "name": "SILAS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Silas.", "name": "ABNER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "You've got my property.", "name": "SILAS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Do I?", "name": "ABNER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Her.", "name": "SILAS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Esperanza steps forward, one boot at a time.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "She meets his eyes without flinching.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "I'm not property.", "name": "ESPERANZA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "That paper says different.", "name": "SILAS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "That paper says I own what you thought you did.", "name": "ESPERANZA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Silas looks at the sheriff.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "The sheriff looks at the sky.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "A buzzard cries.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "Percy.", "name": "ABNER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "Sir?", "name": "PERCY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Go home.", "name": "ABNER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "But, Sheriff--", "name": "PERCY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "Go home, son.", "name": "ABNER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "Percy lowers the rifle.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "Backs up three steps.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "Then turns and walks off down the creekbed, boots kicking up dust.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "Silas turns the horse in a slow half circle.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "Spits.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "dialogue", "text": "This isn't over.", "name": "SILAS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "It is for today.", "name": "ESPERANZA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "He spurs the horse away.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "action", "text": "Dust follows him.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "action", "text": "Abner folds the deed along its old creases and hands it back, tipping his hat.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}]}