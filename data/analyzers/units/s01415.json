{"scene_id": "s01415", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01415.fountain", "heading": "EXT. FROZEN WATERFALL - GORGE - DAY", "cast": [{"id": 0, "name": "AUGIE", "names": ["AUGIE"], "gender": "m", "first": 6, "spoke": 2}, {"id": 1, "name": "DELACROIX-OWUSU", "names": ["DELACROIX-OWUSU"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "THALIA RENFREW", "names": ["THALIA RENFREW", "THALIA"], "gender": "f", "first": 7, "spoke": 2}, {"id": 3, "name": "ZEPH", "names": ["ZEPH"], "gender": "?", "first": 8, "spoke": 2}, {"id": 4, "name": "OKONJO", "names": ["OKONJO"], "gender": "?", "first": 8, "spoke": 0}, {"id": 5, "name": "QUINLAN BRADSHAW-LEE", "names": ["QUINLAN BRADSHAW-LEE", "QUINLAN"], "gender": "m", "first": 9, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FROZEN WATERFALL - GORGE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A canyon of blue ice, walls streaked with silver where the water froze mid-fall.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The sky is a slice of white between cliffs.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wind whistles through the cracks.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Four climbers cling to the face.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "Ropes run taut between them.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "AUGUSTINE \"AUGIE\" DELACROIX-OWUSU, 30s, leads, swinging an ice axe in short, practiced arcs.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Below him, THALIA RENFREW, 20s, belays on a narrow ledge, her hands sheathed in battered mittens.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Further down, ZEPHANIAH \"ZEPH\" OKONJO, 40s, the guide, hangs from a screw with one arm.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "At the bottom, the youngest, QUINLAN BRADSHAW-LEE, 17, stands on the snow, waiting his turn.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Ice is good!", "name": "AUGIE", "speaker": 0, "ext": [], "paren": ["calling down"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Copy!", "name": "THALIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "She feeds him rope.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "Zeph watches the line shiver.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "Quinlan stamps his feet.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Augie pulls over a lip and anchors himself.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Looks down the face, grins.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Zeph! Your turn!", "name": "AUGIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Zeph begins to climb.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "He moves with the slow confidence of a man who has done this ten thousand times.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Axe, kick, axe, kick.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Halfway up, a CRACK splits the air.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "All four freeze.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "A fissure races across the ice, a bright zigzag of white, and a slab the size of a door calves off the wall above Zeph and falls.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Zeph!", "name": "THALIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "He flings himself sideways.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "The slab clips his pack and spins him.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "His axe slips.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "He swings, catches, hangs.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Augie hauls the rope in, arm over arm.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Thalia braces.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Quinlan scrambles up the snow slope toward the base of the wall, shouting.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Hold on! I'm coming!", "name": "QUINLAN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Stay down, boy!", "name": "ZEPH", "speaker": 3, "ext": [], "paren": ["through his teeth"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Another crack.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "A second slab shakes loose, then a third.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "The whole sheet of ice shudders, groans, and begins to peel from the cliff like old paint.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Augie and Thalia lock eyes.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Wordlessly, together, they haul with everything they have.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Zeph kicks into the wall.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "His crampons bite.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "He lunges up and over the ledge as the ice behind him thunders into the gorge.", "para": 12, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "They collapse in a heap, all three tangled in rope, breathing fast.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Quinlan, at the bottom, stands in the settling snow with his hands on his head, laughing and gasping.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "That was incredible.", "name": "QUINLAN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "It was not.", "name": "ZEPH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}