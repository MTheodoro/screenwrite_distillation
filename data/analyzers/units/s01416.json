{"scene_id": "s01416", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01416.fountain", "heading": "INT. FAMILY COURT - CORRIDOR - DAY", "cast": [{"id": 0, "name": "FERN", "names": ["FERN"], "gender": "?", "first": 4, "spoke": 7}, {"id": 1, "name": "ALCANTARA", "names": ["ALCANTARA"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "CORDELIA WASHINGTON-PRICE", "names": ["CORDELIA WASHINGTON-PRICE", "CORDELIA"], "gender": "?", "first": 4, "spoke": 5}, {"id": 3, "name": "BRONWEN ALCANTARA-HUGHES", "names": ["BRONWEN ALCANTARA-HUGHES", "BRONWEN"], "gender": "f", "first": 5, "spoke": 4}, {"id": 4, "name": "ISAAC FELDSTEIN", "names": ["ISAAC FELDSTEIN", "ISAAC"], "gender": "m", "first": 5, "spoke": 2}, {"id": 5, "name": "MARISELA TRUJILLO", "names": ["MARISELA TRUJILLO", "MARISELA"], "gender": "?", "first": 5, "spoke": 2}, {"id": 6, "name": "BAILIFF", "names": ["BAILIFF"], "gender": "?", "first": 38, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. FAMILY COURT - CORRIDOR - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A scuffed hallway with benches along both walls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A vending machine hums.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Fluorescent light flattens every face.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "On one bench: FERNANDO \"FERN\" ALCANTARA, 40s, in his only suit, and his lawyer, CORDELIA WASHINGTON-PRICE, 50s, flipping a file.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 5, "kind": "action", "text": "On the opposite bench: BRONWEN ALCANTARA-HUGHES, 40s, his ex-wife, rigid, flanked by her attorney, ISAAC FELDSTEIN, 30s, and her sister, MARISELA TRUJILLO, 40s, who glares across the aisle.", "para": 1, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 6, "kind": "dialogue", "text": "Fern. Look at me.", "name": "CORDELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 7, "kind": "dialogue", "text": "I'm looking.", "name": "FERN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "dialogue", "text": "You say nothing in there. Understood?", "name": "CORDELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "Understood.", "name": "FERN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Even if she provokes you.", "name": "CORDELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "She always provokes me.", "name": "FERN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Then you say nothing twice.", "name": "CORDELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "Across the aisle, Marisela leans to whisper in Bronwen's ear.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "Bronwen shakes her head.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "He's a liar, Bron.", "name": "MARISELA", "speaker": 5, "ext": [], "paren": ["loud"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Marisela.", "name": "ISAAC", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "He is.", "name": "MARISELA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Please.", "name": "ISAAC", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Fern stands, fists clenched.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Cordelia seizes his sleeve.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Marisela stands too.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Isaac steps between them, hands out, and Bronwen rises last, pale, her palms pressed flat against her skirt.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "She said that in front of my kids?", "name": "FERN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Fern, sit down.", "name": "BRONWEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Don't tell me what to do, Bronwen.", "name": "FERN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "I'm asking.", "name": "BRONWEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "You've never asked me anything in your life.", "name": "FERN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "I'm asking now.", "name": "BRONWEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "He stops.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Searches her face.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "The vending machine hums.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Fern.", "name": "CORDELIA", "speaker": 2, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "He sits.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Slowly.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Marisela sits too, sulking.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Isaac exhales and returns to his folder.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "The courtroom door opens.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "A BAILIFF leans out.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "Alcantara versus Alcantara-Hughes.", "name": "BAILIFF", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "All five of them stand.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "They file toward the door, and in the narrow frame Fern and Bronwen end up shoulder to shoulder, neither willing to go first.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "dialogue", "text": "After you.", "name": "BRONWEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "dialogue", "text": "No. After you.", "name": "FERN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "Cordelia, behind them, rolls her eyes and shoves them both through the door.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}]}