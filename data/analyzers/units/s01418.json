{"scene_id": "s01418", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01418.fountain", "heading": "INT. ROOFTOP GREENHOUSE - OVER A CHINATOWN BANK - NIGHT", "cast": [{"id": 0, "name": "MADAME LILIANE CHEN-ABERNATHY", "names": ["MADAME LILIANE CHEN-ABERNATHY", "LILIANE"], "gender": "f", "first": 5, "spoke": 13}, {"id": 1, "name": "VIKTOR NAKAMURA-ELLIS", "names": ["VIKTOR NAKAMURA-ELLIS", "VIKTOR"], "gender": "?", "first": 7, "spoke": 5}, {"id": 2, "name": "DETECTIVE ROSALIND OKPARA-DANE", "names": ["DETECTIVE ROSALIND OKPARA-DANE", "ROSALIND"], "gender": "?", "first": 9, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROOFTOP GREENHOUSE - OVER A CHINATOWN BANK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A glass shed crowded with tomato vines and orchids, lit by violet grow lamps.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rain hammers the panes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "In the center, a card table, three chairs, and a tray of unwashed teacups.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The air is warm, wet, and sweet with rot.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MADAME LILIANE CHEN-ABERNATHY, 70s, hair in a silver twist, sits at the head of the table in a brocade jacket.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She sips tea without hurry, her fingers heavy with jade rings.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "To her right, her nephew, VIKTOR NAKAMURA-ELLIS, 30s, in a leather coat, picks at a dead leaf.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He has not made eye contact since he arrived.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "To her left, a stranger in a dripping raincoat, DETECTIVE ROSALIND OKPARA-DANE, 40s, has been invited to sit and has not yet taken off her hat.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Detective. You will have tea.", "name": "LILIANE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "No, thank you.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "It is not an offer.", "name": "LILIANE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Rosalind studies the cup, then lifts it.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Sniffs.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Sets it down untouched.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "I'm here about the vault.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "There is no vault.", "name": "LILIANE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Beneath the bank. Third sub-level.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "You are mistaken.", "name": "LILIANE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Three nights ago, someone emptied it.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Viktor's hand goes still on the leaf.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Liliane doesn't blink.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Viktor. Did you hear?", "name": "LILIANE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "I heard.", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Do you know anything about this?", "name": "LILIANE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "No, Auntie.", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "No.", "name": "LILIANE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "She turns back to Rosalind with a serene smile.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "The rain on the glass swells louder for a moment, then fades.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Madame Chen. Your nephew was seen entering the sub-level at eleven.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "By whom?", "name": "LILIANE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "By a night guard. Who has since vanished.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "That's a lie.", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Which part?", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "All of it.", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "I haven't told you the guard's name.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Viktor's mouth closes.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Liliane sets down her cup, very softly.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "It clicks against the saucer.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Viktor, go downstairs.", "name": "LILIANE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Auntie--", "name": "VIKTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Go.", "name": "LILIANE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "He rises.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Looks at Rosalind, then at the old woman, and walks out between the tomato vines.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "The door slides shut behind him.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Liliane and Rosalind sit alone with the orchids and the rain.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "He is a foolish boy.", "name": "LILIANE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "He's a thief.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "He is family.", "name": "LILIANE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "That's not a defense.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "No. But it is a reason.", "name": "LILIANE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "She pours a second cup of tea, and for the first time Rosalind accepts it.", "para": 10, "sent": 0, "present": [0, 1, 2]}]}