{"scene_id": "s01419", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01419.fountain", "heading": "EXT. LIFE RAFT - OPEN OCEAN - DAWN", "cast": [{"id": 0, "name": "CAPTAIN AUGUSTINE FEARON", "names": ["CAPTAIN AUGUSTINE FEARON", "AUGUSTINE"], "gender": "?", "first": 5, "spoke": 8}, {"id": 1, "name": "IMELDA NAKAGAWA-ROSS", "names": ["IMELDA NAKAGAWA-ROSS", "IMELDA"], "gender": "f", "first": 5, "spoke": 6}, {"id": 2, "name": "DECKHAND BASIL OYEDEPO", "names": ["DECKHAND BASIL OYEDEPO", "BASIL"], "gender": "?", "first": 5, "spoke": 11}, {"id": 3, "name": "MABEL STURGESS-KAUR", "names": ["MABEL STURGESS-KAUR", "MABEL"], "gender": "?", "first": 5, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "EXT. LIFE RAFT - OPEN OCEAN - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Gray sea.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Gray sky.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A canvas raft rises and falls on a slow swell.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Gulls are nowhere.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Four survivors crowd the raft: CAPTAIN AUGUSTINE FEARON, 50s, lashed to the tiller by a rope; DR. IMELDA NAKAGAWA-ROSS, 40s, clutching a medical kit; DECKHAND BASIL OYEDEPO, 20s, bailing with a hat; and the cook, MABEL STURGESS-KAUR, 60s, hugging a cooler.", "para": 1, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "dialogue", "text": "There!", "name": "BASIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Where?", "name": "IMELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "A light! Starboard!", "name": "BASIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "That's the sun.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "It's not the sun!", "name": "BASIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "It's the sun, dear.", "name": "MABEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "It's a ship!", "name": "BASIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Basil, sit down.", "name": "IMELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "It's a ship! I'm telling you!", "name": "BASIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Sit down, son.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "You'll tip us.", "name": "MABEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Then someone look!", "name": "BASIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Imelda stands, shading her eyes.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "The raft pitches.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "She grips Augustine's shoulder to steady herself.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "I don't see anything.", "name": "IMELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Water, water, everywhere.", "name": "MABEL", "speaker": 3, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Mabel.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "I'm only saying.", "name": "MABEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Basil, how much water is left?", "name": "IMELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Half a liter.", "name": "BASIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "For four.", "name": "IMELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "For four.", "name": "BASIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "We ration it. A capful each, at dusk.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "And if we haven't been rescued by dusk?", "name": "MABEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Then another capful.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "And then?", "name": "BASIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "We'll see.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "A gull cries somewhere overhead.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "All four look up at once.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Just a speck, circling high above the swell.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Is that...", "name": "MABEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "A gull.", "name": "IMELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Land's close!", "name": "BASIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Don't hope, son.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Why not?", "name": "BASIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Hope drinks water too.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "The raft rides the swell.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Mabel gives a short, dry laugh and opens the cooler, taking out four crackers, one each.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Breakfast.", "name": "MABEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "They eat.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}]}