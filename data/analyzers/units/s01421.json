{"scene_id": "s01421", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01421.fountain", "heading": "EXT. SALT FLATS WAY STATION - DAY", "cast": [{"id": 0, "name": "TUCKER HALE", "names": ["TUCKER HALE", "TUCKER"], "gender": "m", "first": 5, "spoke": 13}, {"id": 1, "name": "ISAAC BROOKS", "names": ["ISAAC BROOKS", "ISAAC"], "gender": "?", "first": 9, "spoke": 8}, {"id": 2, "name": "BILLIE", "names": ["BILLIE"], "gender": "f", "first": 27, "spoke": 12}, {"id": 3, "name": "STRAND", "names": ["STRAND"], "gender": "?", "first": 27, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SALT FLATS WAY STATION - DAY", "present": []}, {"u": 1, "kind": "action", "text": "White ground.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "White sky with a seam of heat across it.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "One adobe hut, roof half gone.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A windmill with no blades, only the hub, rusted and ticking.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "TUCKER HALE (40s, lean, sun-cracked lips, a hat stained black at the band) sits on an upturned barrel.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Rifle across his knees.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Not aiming it.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "Not putting it down.", "para": 1, "sent": 3, "present": [0]}, {"u": 9, "kind": "action", "text": "ISAAC BROOKS (50s, heavy, one eye clouded) crouches by a dead fire, poking ash with a stick.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He wears a preacher's coat, two sizes small, buttons mismatched.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Between them, a mule.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Grey.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Chewing nothing.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Water.", "name": "TUCKER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Barrel's dry.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "I didn't ask the barrel.", "name": "TUCKER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Isaac lifts a canteen.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Shakes it.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "A small sound.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "He tosses it.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Tucker catches it without looking.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Half.", "name": "TUCKER", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Drink your half.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Tucker drinks.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Caps it.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Sets it on the sand between them.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "WILHELMINA \"BILLIE\" STRAND (30s, wiry, a rope-burn scar across one cheek, dust to the knees) steps out of the hut doorway.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "She carries a tin plate with three strips of jerky.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Her boots are two sizes too big.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Men's boots.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Supper.", "name": "BILLIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "It's noon.", "name": "TUCKER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Supper's when you eat it.", "name": "BILLIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "She puts the plate down on the barrel top.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Takes one strip.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Chews.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Looks at the horizon.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "He's late.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "He's always late.", "name": "TUCKER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Who's late?", "name": "BILLIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "The man with the wagon.", "name": "TUCKER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "I thought it was a train.", "name": "BILLIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "No train. Ground's too soft for rail.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Everything's too soft for something.", "name": "BILLIE", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Isaac stands.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Knees pop.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "He walks to the windmill, puts a palm on the post, closes his good eye.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Lord, I will not ask for rain. Lord, I will ask for shade.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Tucker watches him.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Says nothing.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Billie sits on the hut step, pulls her too-big boots off, empties them.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Salt crystals pour out like sugar.", "para": 9, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Everybody listen. If we're still here at dark, we sleep in shifts.", "name": "BILLIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "We won't be here at dark.", "name": "TUCKER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Then it costs nothing to agree.", "name": "BILLIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "I'll take first.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "You'll take middle. You snore on first.", "name": "BILLIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "I do not.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "You do.", "name": "TUCKER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "Isaac looks at Tucker.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "Tucker shrugs.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "A mile out, a smudge of dust rises.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "Not a wagon.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "Wind, maybe.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "All three watch it anyway.", "para": 11, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "You still got the paper?", "name": "TUCKER", "speaker": 0, "ext": ["CONT'D"], "paren": ["low, to Isaac"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "Inside my coat.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "Keep it there.", "name": "TUCKER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "dialogue", "text": "I can hear you.", "name": "BILLIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "dialogue", "text": "Then hear this. Nobody does anything till I say.", "name": "TUCKER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "dialogue", "text": "Yes, sir, Marshal.", "name": "BILLIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "I'm not a marshal.", "name": "TUCKER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "That's why it's funny.", "name": "BILLIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "The dust smudge thins and dies.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "Nothing behind it.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "The mule shifts its weight, sighs through its nose.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "Isaac settles back by the dead fire.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "action", "text": "Pokes.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "action", "text": "Tucker leans the rifle against the barrel.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "action", "text": "Billie lies back on the step, hat over her face.", "para": 13, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "dialogue", "text": "Wake me when it's supper.", "name": "BILLIE", "speaker": 2, "ext": ["CONT'D"], "paren": ["from under the hat"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "dialogue", "text": "She's right, you know.", "name": "TUCKER", "speaker": 0, "ext": [], "paren": ["to the mule"], "dual": false, "present": [0, 1, 2, 3]}]}