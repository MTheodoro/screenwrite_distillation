{"scene_id": "s01422", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01422.fountain", "heading": "INT. COURTHOUSE PARKING GARAGE - LEVEL P3 - DAWN", "cast": [{"id": 0, "name": "LENORE VASQUITH", "names": ["LENORE VASQUITH", "LENORE"], "gender": "f", "first": 4, "spoke": 6}, {"id": 1, "name": "RUFUS AMOAH", "names": ["RUFUS AMOAH", "RUFUS"], "gender": "?", "first": 5, "spoke": 3}, {"id": 2, "name": "CLERK", "names": ["CLERK"], "gender": "?", "first": 6, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. COURTHOUSE PARKING GARAGE - LEVEL P3 - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Concrete.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sodium light.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "One sedan, engine ticking.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LENORE VASQUITH (40s, charcoal suit, burner-thin patience) leans on the driver's door, phone pressed to her ear.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "In the passenger seat, RUFUS AMOAH (30s, borrowed tie, hands gripping his knees) stares at the dashboard.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Judge Barrow moved you to eight-fifteen.", "name": "CLERK", "speaker": 2, "ext": ["V.O."], "paren": ["phone, tinny"], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Moved me from nine?", "name": "LENORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Prosecution's witness flew in early.", "name": "CLERK", "speaker": 2, "ext": ["V.O."], "paren": ["phone"], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Then I want the exhibit list stipulated before we go on the record.", "name": "LENORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Take it up with the judge.", "name": "CLERK", "speaker": 2, "ext": ["V.O."], "paren": ["phone"], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Lenore ends the call.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Knocks on the glass.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Rufus lowers the window two inches.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "That the clerk?", "name": "RUFUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "We go early. You say nothing. Not \"good morning,\" not \"thank you.\" Nothing.", "name": "LENORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "What if the judge asks me something?", "name": "RUFUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Then I object.", "name": "LENORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "And if you can't?", "name": "RUFUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Rufus. Look at me.", "name": "LENORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "He does.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "She does not blink.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "I can.", "name": "LENORE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}]}