{"scene_id": "s01425", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01425.fountain", "heading": "INT. CONVERTED CATHEDRAL CURLING HALL - NIGHT", "cast": [{"id": 0, "name": "BERNIE", "names": ["BERNIE"], "gender": "f", "first": 7, "spoke": 10}, {"id": 1, "name": "OYELARAN", "names": ["OYELARAN"], "gender": "?", "first": 7, "spoke": 0}, {"id": 2, "name": "MAEVE KOWALCZYK", "names": ["MAEVE KOWALCZYK", "MAEVE"], "gender": "f", "first": 8, "spoke": 8}, {"id": 3, "name": "DESMOND TAI", "names": ["DESMOND TAI", "DESMOND"], "gender": "m", "first": 9, "spoke": 4}, {"id": 4, "name": "RAFFI HOVSEPIAN", "names": ["RAFFI HOVSEPIAN", "RAFFI"], "gender": "m", "first": 10, "spoke": 3}, {"id": 5, "name": "JUNE PELLETIER-ODUYA", "names": ["JUNE PELLETIER-ODUYA", "JUNE"], "gender": "f", "first": 11, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. CONVERTED CATHEDRAL CURLING HALL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A deconsecrated church, nave stripped, pews gone, a pebbled sheet of ice running where the altar once stood.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Stained glass throws blue and amber across the frost.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Stone saints watch from niches.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Condensation drips from the vaulted ceiling.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Scoreboard: LIONS 6, FERRYMEN 6.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "Eighth end.", "para": 1, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "BERNADETTE \"BERNIE\" OYELARAN (50s, coach's jacket, whistle she never uses) stands behind the hog line with a clipboard she hasn't looked at in an hour.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "MAEVE KOWALCZYK (20s, skip, braid tucked into her collar) crouches at the house, broom flat across her knees.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "DESMOND TAI (30s, lead, calves like fence posts) waits at the far hack, stone handle in a white-knuckled grip.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "RAFFI HOVSEPIAN (20s, second, perpetual grin gone tight) sweeps nothing, just to have something to do with his arms.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "JUNE PELLETIER-ODUYA (40s, vice, wedding ring on a chain around her neck) stands at the boards, arms folded, chewing a toothpick down to splinters.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Last stone. Hammer's ours.", "name": "BERNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "I know.", "name": "MAEVE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Draw to the button.", "name": "BERNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "I know.", "name": "MAEVE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Then why are you looking at the saint?", "name": "BERNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Maeve glances at a stone St. Sebastian in the wall, pierced with nine marble arrows.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "He's got a better angle than I do.", "name": "MAEVE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Ready!", "name": "DESMOND", "speaker": 3, "ext": [], "paren": ["calling down the sheet"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Ice is pulling left, maybe two inches.", "name": "JUNE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Three. It's three.", "name": "RAFFI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Two and a half.", "name": "JUNE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Fine. Two and a half.", "name": "RAFFI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Desmond pushes out of the hack, glides low and long, releases the stone with a soft rotation.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "It slides, humming on the pebble.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Hard! Hard!", "name": "MAEVE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Raffi and June sweep, brooms drumming the ice, snow-frost jumping off the bristles.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "The stone arcs past the guard.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Off!", "name": "JUNE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "They lift.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "The stone curls, slows, rests an inch from the back of the four-foot ring.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "That's yours, Desmond.", "name": "BERNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "I know.", "name": "DESMOND", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Everyone says \"I know\" tonight. I'd like one \"I'm scared.\"", "name": "BERNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "A beat.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Raffi laughs.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "June spits her toothpick onto the ice.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Maeve rises, rolling her shoulders.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "I'm scared.", "name": "MAEVE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Good. Go.", "name": "BERNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Maeve settles into the hack.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Looks down the sheet.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Breathes.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Desmond, where do you want it?", "name": "MAEVE", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Weight of a feather. Land on the button like a kiss.", "name": "DESMOND", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Don't kiss anything, I'm married.", "name": "MAEVE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "So am I.", "name": "JUNE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "Everybody's married. Throw the rock.", "name": "RAFFI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "Maeve pushes.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "The stone leaves her hand in a perfect curve.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Desmond and Raffi pick up the sweep, then drop it.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "June holds up a flat palm.", "para": 13, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "Leave it. Leave it.", "name": "JUNE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "The stone drifts, rotating, down the pebbled ice, under a rose window that paints it red for one second, then amber, then blue.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "Come on, come on.", "name": "BERNIE", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "It stops.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "A hair's width from Desmond's stone, a hair's width from the pin.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "Silence under the vault.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "Raffi drops his broom.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "action", "text": "Desmond puts both hands on his head.", "para": 16, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "June exhales through her teeth.", "para": 16, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "dialogue", "text": "We measure.", "name": "JUNE", "speaker": 5, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "Bernie gets down on her knees on the ice, pulls a measuring stick from her jacket, and lays it across the gap between the two stones.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "She reads it.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "Looks up.", "para": 17, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "dialogue", "text": "Ferrymen's. By a quarter inch.", "name": "BERNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "action", "text": "Nobody speaks.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "action", "text": "Maeve takes off her glove, looks at her bare hand.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "action", "text": "Her fingers don't tremble.", "para": 18, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "dialogue", "text": "Good end.", "name": "MAEVE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "dialogue", "text": "That's the end. Not the match. We play the extra end in five.", "name": "BERNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "dialogue", "text": "There's an extra end?", "name": "DESMOND", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "dialogue", "text": "There's always an extra end. Sit down. Drink water. Look at a saint.", "name": "BERNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}