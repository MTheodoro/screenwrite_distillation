{"scene_id": "s01426", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01426.fountain", "heading": "INT. HOUSEBOAT GALLEY - MORNING", "cast": [{"id": 0, "name": "ZOFIA NOWAK", "names": ["ZOFIA NOWAK", "ZOFIA"], "gender": "?", "first": 4, "spoke": 8}, {"id": 1, "name": "WALEED", "names": ["WALEED"], "gender": "m", "first": 5, "spoke": 8}, {"id": 2, "name": "PRIYA", "names": ["PRIYA"], "gender": "f", "first": 6, "spoke": 6}, {"id": 3, "name": "KOFI", "names": ["KOFI"], "gender": "m", "first": 7, "spoke": 0}, {"id": 4, "name": "MARGUERITE", "names": ["MARGUERITE"], "gender": "?", "first": 17, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOUSEBOAT GALLEY - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "A narrow kitchen on a canal boat.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Copper pans swing gently with the water.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain taps the porthole.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ZOFIA NOWAK (70s, tiny, apron over a quilted vest) rolls dough on a board nailed to the counter.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her son WALEED (40s, tired eyes, a dress shirt with one sleeve rolled) stands at the stove, stirring a pot he is not hungry for.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "At the table, PRIYA (16, headphones around her neck) peels an orange in one unbroken spiral.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Beside her, KOFI (8, pajamas, a plastic dinosaur in each fist) crashes them together.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "A landline phone hangs on the bulkhead.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "It rings.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Don't.", "name": "WALEED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I wasn't.", "name": "ZOFIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "It rings again.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Priya peels.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Kofi roars his dinosaurs into the sugar bowl.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Somebody should.", "name": "ZOFIA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "It's the lawyer. Or the marina.", "name": "WALEED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Or it's Marguerite.", "name": "ZOFIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Waleed stops stirring.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "The phone rings a fourth time.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Priya sets down the orange.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Priya, would you --", "name": "WALEED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Why me?", "name": "PRIYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Because you're closest.", "name": "WALEED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "I'm not closest. Gran is closest.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "My hands are in flour.", "name": "ZOFIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Priya gets up, lifts the receiver.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Holds it a few inches from her ear.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Hello?", "name": "PRIYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Is your father there?", "name": "MARGUERITE", "speaker": 4, "ext": ["V.O."], "paren": ["phone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "He's... stirring.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Tell him I'm at the lock. I'll be there in twenty minutes.", "name": "MARGUERITE", "speaker": 4, "ext": ["V.O."], "paren": ["phone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Priya looks at her father.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "He looks at the soup.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Zofia presses the dough flat with both thumbs, harder than the recipe needs.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "She says twenty minutes.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Tell her we're out.", "name": "WALEED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Tell her we have enough bread.", "name": "ZOFIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Mama.", "name": "WALEED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Waleed.", "name": "ZOFIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Don't --", "name": "WALEED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Don't what?", "name": "ZOFIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Don't start.", "name": "WALEED", "speaker": 1, "ext": [], "paren": ["together"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "I'm not starting.", "name": "ZOFIA", "speaker": 0, "ext": [], "paren": ["together"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Come. It's... fine.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": ["into the phone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "She hangs up.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Silence.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Kofi's dinosaurs go quiet.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "The boat rocks.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "A drop falls from the porthole frame onto the sill.", "para": 8, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Zofia takes down a fourth bowl from the shelf.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Then a fifth.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Sets them on the table without comment.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Waleed puts the spoon down.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "Rolls the other sleeve to match the first.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Kofi slides a dinosaur across the table until it stops beside the fifth bowl.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}]}