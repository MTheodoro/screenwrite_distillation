{"scene_id": "s01429", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01429.fountain", "heading": "INT. FEED STORE BACK ROOM - NIGHT", "cast": [{"id": 0, "name": "SHERIFF CASIMIR DUVALL", "names": ["SHERIFF CASIMIR DUVALL", "DUVALL"], "gender": "m", "first": 4, "spoke": 9}, {"id": 1, "name": "TOBY", "names": ["TOBY"], "gender": "?", "first": 5, "spoke": 10}, {"id": 2, "name": "RAINEY", "names": ["RAINEY"], "gender": "?", "first": 5, "spoke": 0}, {"id": 3, "name": "MABEL KINGSLEY", "names": ["MABEL KINGSLEY", "MABEL"], "gender": "?", "first": 7, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. FEED STORE BACK ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Grain sacks stacked to the rafters.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single oil lamp.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Barn-cat eyes in the dark, gone when you look.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SHERIFF CASIMIR DUVALL (50s, silver mustache, a limp from an old stirrup) sits at a plank table, chair tilted back.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Opposite him, TOBIAS \"TOBY\" RAINEY (20s, barely a beard, hands cuffed in front, a bruise blooming on his jaw).", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "In the corner, behind the sacks, a woman stands motionless.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "MABEL KINGSLEY (40s, widow's black, a shotgun held low like a broom).", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "You know whose barn that was.", "name": "DUVALL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "I know.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "You know whose horse.", "name": "DUVALL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I know that too.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "You know the penalty.", "name": "DUVALL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Sheriff, I'll hang if that's what it is. I'm not asking you to like me.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "I don't.", "name": "DUVALL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Then we agree.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Ask him where the boy is.", "name": "MABEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Mabel.", "name": "DUVALL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Ask him.", "name": "MABEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Where's the boy, Toby?", "name": "DUVALL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "I left him at the creek. He's fine. He's twelve and he's fine.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Alone.", "name": "MABEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "With a canteen and a blanket, ma'am. Which is more than I got at twelve.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Why the creek?", "name": "DUVALL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Because the barn was on fire, and I'd have had to carry him.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "You set the fire.", "name": "MABEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "I did not.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Then who?", "name": "DUVALL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Ask the man who held the lamp. Ask the one who paid the stable hand two dollars to go quiet.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Duvall lets his chair drop forward.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "The legs hit the floor.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Name him.", "name": "DUVALL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Toby looks at Mabel.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "At the shotgun.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "At Duvall.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "You'll want to sit down, ma'am.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}