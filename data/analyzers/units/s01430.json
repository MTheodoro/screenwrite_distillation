{"scene_id": "s01430", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01430.fountain", "heading": "INT. VERIDIAN SYSTEMS - OPEN-PLAN OFFICE - FIRE DRILL - DAY", "cast": [{"id": 0, "name": "VERB", "names": ["VERB"], "gender": "?", "first": 2, "spoke": 0}, {"id": 1, "name": "PERPETUA NWOSU", "names": ["PERPETUA NWOSU", "PERPETUA"], "gender": "f", "first": 4, "spoke": 8}, {"id": 2, "name": "ALISTAIR BOONSRI", "names": ["ALISTAIR BOONSRI", "ALISTAIR"], "gender": "?", "first": 5, "spoke": 6}, {"id": 3, "name": "LOLA FIGUEROA-WREN", "names": ["LOLA FIGUEROA-WREN", "LOLA"], "gender": "?", "first": 6, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. VERIDIAN SYSTEMS - OPEN-PLAN OFFICE - FIRE DRILL - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Rows of grey cubicles.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A laminated sign reads \"SYNERGY IS A VERB.\"", "para": 0, "sent": 1, "present": [0]}, {"u": 3, "kind": "action", "text": "Alarm bell clangs on a loop.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "PERPETUA NWOSU (40s, headset, high-vis vest over a blazer) strides between desks with a clipboard.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "ALISTAIR BOONSRI (30s, sleeves rolled, mug in hand) does not stand.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "LOLA FIGUEROA-WREN (20s, intern, lanyard tangled) stares at a vending machine.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Everyone! Exit through the east stairwell! Walk, do not run!", "name": "PERPETUA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Nobody else is there.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "The desks are empty.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "She says it anyway.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Perpetua, we're the only two on this floor.", "name": "ALISTAIR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Three.", "name": "PERPETUA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Fine, three.", "name": "ALISTAIR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Lola still has not moved.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Lola. Stairwell.", "name": "PERPETUA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "I'm waiting for my pretzels.", "name": "LOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "There is a fire.", "name": "PERPETUA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Then I'll be quick.", "name": "LOLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Alistair finally stands, mug still steaming.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Every quarter, a fire. Never an actual fire.", "name": "ALISTAIR", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "I heard that.", "name": "PERPETUA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "It was for you to hear.", "name": "ALISTAIR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "The alarm stops.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Silence rings.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Perpetua's headset crackles; she tilts her head, listens, goes still.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Oh no.", "name": "PERPETUA", "speaker": 1, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "What?", "name": "ALISTAIR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "It was a real fire. Floor four. They forgot to tell the drill coordinator.", "name": "PERPETUA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Everyone! Exit through the east stairwell!", "name": "LOLA", "speaker": 3, "ext": [], "paren": ["calling, bright"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Her pretzels thump into the tray.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "She grabs them and sprints.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Perpetua and Alistair follow, mug abandoned, spilling steam onto carpet.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "At the stairwell door, Perpetua stops, hand on the push bar.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "False alarm. Floor four just burned a casserole.", "name": "PERPETUA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "I hate this company.", "name": "ALISTAIR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Pretzel?", "name": "LOLA", "speaker": 3, "ext": [], "paren": ["mouth full"], "dual": false, "present": [0, 1, 2, 3]}]}