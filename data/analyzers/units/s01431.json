{"scene_id": "s01431", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01431.fountain", "heading": "INT. ABANDONED GRAIN ELEVATOR - GROUND FLOOR - NIGHT", "cast": [{"id": 0, "name": "ELSPETH MARROW", "names": ["ELSPETH MARROW", "ELSPETH"], "gender": "f", "first": 5, "spoke": 17}, {"id": 1, "name": "DOMINIC ARRUDA", "names": ["DOMINIC ARRUDA", "DOMINIC"], "gender": "f", "first": 6, "spoke": 16}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED GRAIN ELEVATOR - GROUND FLOOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A concrete cathedral of silos.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rusted augers hang like dead snakes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The floor is a scatter of husks and pigeon bones.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A flashlight beam wobbles across a wall stenciled \"FILL LINE 40 FT.\"", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ELSPETH MARROW (40s, county surveyor, canvas jacket, hard hat, a clipboard clutched to her chest) steps over a fallen ladder.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Behind her comes DOMINIC ARRUDA (30s, her assistant, rain slicker, young face, a camera on a strap).", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Mind the grating.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "It's all grating.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "The loose grating.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He steps carefully.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "The beam sweeps a rusted sign: DANGER - CONFINED SPACE.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Is it true what they say about this place?", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "What do they say?", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "That a man drowned in wheat.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Engulfment. It happens. Grain flows like water. You stand in a bin, it pulls you under.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "In ten seconds.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "In four.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Somewhere above, grain shifts, a faint hiss like rain on a roof.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Is it supposed to do that?", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Settling.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "It's been empty since 1991.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Then it's settling slowly.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She crouches at a floor hatch, rusted shut.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Taps it with her pen.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "A hollow note.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Bin eight. Hold the light.", "name": "ELSPETH", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Dominic holds it.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "The beam shakes, just enough to notice.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Elspeth, my father worked at one of these.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Did he?", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "He never talked about it. Only that the dust got in your teeth and you tasted it for days.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Mm.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Do you taste something?", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "She stops.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Sniffs.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "A faint sweetness, like bread left in a warm oven.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Mold.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "That's not mold.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "The hiss above grows.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "A thin stream of golden kernels runs from a seam in the ceiling, pattering onto the floor between them.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Neither looks away.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "It's been empty since --", "name": "DOMINIC", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "I know.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "She stands.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "The stream thickens.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Behind them, in the dark, the heavy door they came through swings shut with a soft, deliberate click.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "No wind.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Did you close that?", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "No.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Did I?", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "No.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "The kernels keep falling.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "They form a little cone on the concrete.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "Then, silently, the cone slides sideways, as if tipped by an invisible hand, and a second stream starts from another seam.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "We should go.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "Take the readings first.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "Elspeth.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "Take the readings.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "She walks to the hatch.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "Grips the wheel.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "It turns easily, without a squeal.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "Oiled.", "para": 10, "sent": 3, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "Dominic, who's been here?", "name": "ELSPETH", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "He doesn't answer.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "He is backing toward the door, camera forgotten at his hip, the flashlight beam pointing straight up the silo's throat.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 67, "kind": "action", "text": "Above them, a tide of grain begins to pour.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "RUN.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "He grabs her sleeve.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 70, "kind": "action", "text": "The hatch swings open on its own.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "A warm breath exhales from below, smelling of bread and rot, and the floor beneath their boots goes soft.", "para": 13, "sent": 2, "present": [0, 1]}]}