{"scene_id": "s01432", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01432.fountain", "heading": "INT. REGIONAL AIRPORT - BAGGAGE CLAIM - NIGHT", "cast": [{"id": 0, "name": "SAOIRSE LINDQVIST", "names": ["SAOIRSE LINDQVIST", "SAOIRSE"], "gender": "f", "first": 5, "spoke": 9}, {"id": 1, "name": "YUSUF BELLAMY", "names": ["YUSUF BELLAMY", "YUSUF"], "gender": "m", "first": 6, "spoke": 11}], "units": [{"u": 0, "kind": "heading", "text": "INT. REGIONAL AIRPORT - BAGGAGE CLAIM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A single carousel grinds in an empty hall.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Chairs bolted in rows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A vending machine hums.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The arrivals board flickers \"DELAYED.\"", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SAOIRSE LINDQVIST (40s, wool coat, a funeral program folded small in one hand) waits with her arms crossed.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Beside her stands YUSUF BELLAMY (40s, her brother, rumpled, carry-on at his feet, a plastic bag of airport pretzels untouched).", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Neither looks at the other.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "They watch the rubber flaps at the end of the belt.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Thought it'd be busier.", "name": "YUSUF", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Last flight in.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Right.", "name": "YUSUF", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "A bag slides out.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Black, medium.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Saoirse leans forward.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Yusuf leans forward.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "It isn't theirs.", "para": 3, "sent": 4, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "It circles past them, and they both watch it, and neither says what both of them are thinking.", "para": 3, "sent": 5, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Anyone? No? Okay.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": ["to the carousel, brightly"], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Who are you talking to?", "name": "YUSUF", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Habit.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Another bag.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "A child's suitcase decorated with stickers of a cartoon fox.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Saoirse turns away.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Yusuf stares at it as it passes, then looks at his own shoes, then at the plastic bag of pretzels.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "He opens it, takes one, snaps it in half, offers her half without looking.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "She takes it.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Eats it.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "They stand shoulder to shoulder, chewing, watching a dull steel belt roll and roll.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Did you call Mum?", "name": "YUSUF", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Tuesday.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "What did she say?", "name": "YUSUF", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "That the weather's turned.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "That's it?", "name": "YUSUF", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "That's the whole call.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Ten years.", "name": "YUSUF", "speaker": 1, "ext": [], "paren": ["under his breath"], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "What was that?", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Nothing.", "name": "YUSUF", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "The belt shudders.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "A last bag drops from the chute, a cracked brown leather case with a torn tag, and rolls toward them alone.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Saoirse's face does not change.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Yusuf's does, finally, a slow collapse, brow, mouth, chin.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "He steps toward it and lifts it with both hands as though it might spill.", "para": 6, "sent": 4, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "She lowers her gaze, takes the funeral program out of her palm, and tucks it into her coat where nobody can see.", "para": 6, "sent": 5, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "He sets the case on the floor between them and kneels, thumbs resting on the latches, and she crouches across from him, one hand finding the handle and the other, without asking, closing over his.", "para": 6, "sent": 6, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "You knew about the house.", "name": "YUSUF", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Yes.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "You knew and you let me fly all the way here.", "name": "YUSUF", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "I thought you should see it.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "He lets go of the latch.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "She does not let go of his hand.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "It was never about Mum.", "name": "YUSUF", "speaker": 1, "ext": [], "paren": ["very quietly"], "dual": false, "present": [0, 1]}]}