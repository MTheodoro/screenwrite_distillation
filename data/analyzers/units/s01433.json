{"scene_id": "s01433", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01433.fountain", "heading": "INT. MARINE AQUARIUM - SHARK TUNNEL - NIGHT", "cast": [{"id": 0, "name": "VESPER LOWRY", "names": ["VESPER LOWRY", "VESPER"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "MUNGO TAKAHASHI", "names": ["MUNGO TAKAHASHI", "MUNGO"], "gender": "?", "first": 5, "spoke": 1}, {"id": 2, "name": "PIPS", "names": ["PIPS"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "ADEBAYO", "names": ["ADEBAYO"], "gender": "?", "first": 6, "spoke": 0}, {"id": 4, "name": "ROSALIND CHEN-MARCH", "names": ["ROSALIND CHEN-MARCH", "ROSALIND"], "gender": "?", "first": 7, "spoke": 1}, {"id": 5, "name": "DUKE ZELENSKY", "names": ["DUKE ZELENSKY", "DUKE"], "gender": "m", "first": 8, "spoke": 2}, {"id": 6, "name": "ILSE VANTERPOOL", "names": ["ILSE VANTERPOOL", "ILSE"], "gender": "f", "first": 21, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. MARINE AQUARIUM - SHARK TUNNEL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Blue gloom.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Silhouettes of rays drift overhead.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Reflected ripples slide across black-clad figures crouched along the tunnel wall.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "VESPER LOWRY (30s, crew boss, earpiece) taps a panel.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "MUNGO TAKAHASHI (40s, safe man, fingers like a surgeon's) kneels at a locked case.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "\"PIPS\" ADEBAYO (20s, tech, tablet glowing on her forearm).", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "ROSALIND CHEN-MARCH (50s, driver, quiet), watches the corridor.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "DUKE ZELENSKY (30s, muscle, nervous) checks his watch.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "Eyes up. Ninety seconds on the loop.", "name": "VESPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Cameras show tank two. No movement.", "name": "PIPS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Tank two. Sure. Tank two.", "name": "DUKE", "speaker": 5, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Quiet. I'm in.", "name": "MUNGO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "A latch clicks.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "He lifts out a velvet tray.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Pearls the size of marbles, gleaming.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Rosalind, status.", "name": "VESPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Clear.", "name": "ROSALIND", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Footsteps echo.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Everyone freezes.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "A shadow lengthens along the curved glass.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "ILSE VANTERPOOL (60s, security guard, cardigan under her uniform, thermos in hand) rounds the corner.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "action", "text": "She sees the crew.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "Sees the pearls.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "Sips her tea.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "I don't get paid enough for this.", "name": "ILSE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "Nobody does. Everybody, stay calm.", "name": "VESPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "Is there a plan for me?", "name": "ILSE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "She's not on the schedule.", "name": "PIPS", "speaker": 2, "ext": [], "paren": ["to Vesper, low"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "There's a plan. You sit. We leave. You call it in in five minutes, with a good story.", "name": "VESPER", "speaker": 0, "ext": [], "paren": ["to Ilse"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "I have a bad knee.", "name": "ILSE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "Just sit!", "name": "DUKE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "action", "text": "She sits.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "On the floor.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "Shark shadows pass over her face.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}]}