{"scene_id": "s01434", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01434.fountain", "heading": "INT. NIGHT FERRY - PASSENGER CABIN - NIGHT", "cast": [{"id": 0, "name": "CORA WHITLOCK", "names": ["CORA WHITLOCK", "CORA"], "gender": "m", "first": 5, "spoke": 5}, {"id": 1, "name": "LEO BASSETT", "names": ["LEO BASSETT", "LEO"], "gender": "?", "first": 6, "spoke": 2}, {"id": 2, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 15, "spoke": 6}, {"id": 3, "name": "OSWIN", "names": ["OSWIN"], "gender": "?", "first": 42, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT FERRY - PASSENGER CABIN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Fog at the portholes.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A sodium lamp swings on its chain.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Plastic seats bolted in rows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The engine thrums.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CORA WHITLOCK (30s) sits clutching a paper cup.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across from her, LEO BASSETT (30s) tries to sleep with his coat over his face.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "A figure in the far aisle.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Tall.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Wet.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Unmoving.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Cora notices him.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Lowers her cup.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He steps closer.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Water drips from his sleeves onto the deck.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "This seat taken?", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Plenty of seats.", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I like this one.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "He sits.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Right beside her.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Too close.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "She shifts away.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "He watches her do it.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Leo lifts the coat.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Squints at him.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Sinks back down.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Is he your husband?", "name": "STRANGER", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Brother.", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Pity.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "She stands.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "He grabs her wrist.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Cold.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Wet.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "She yanks free.", "para": 7, "sent": 4, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Leo!", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Leo bolts upright.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "The coat falls.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "The stranger smiles at him.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Easy, friend.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Leo steps between them.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Shoves him back.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "The man laughs, a bright, delighted bark, and raises both hands.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Oswin. My name is Oswin.", "name": "STRANGER", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "I don't care.", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "You will.", "name": "OSWIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "He reaches into his coat.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Leo tenses.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Oswin pulls out a ticket stub, damp, torn.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Holds it up in the lamplight.", "para": 10, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Last ferry to Harrow Point. Nineteen fifty-one.", "name": "OSWIN", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Leo takes it.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Reads it.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "His face loses color.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "That's a prop.", "name": "LEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Is it?", "name": "OSWIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Cora backs away.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Her heel hits the bulkhead.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Oswin rises slowly.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "Water pools around his shoes.", "para": 12, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "He steps toward her.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "She screams.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "The lamp swings.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "In the swing, he is gone.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "The seat is empty and wet.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "Leo drops the ticket.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "It lands in a puddle and darkens.", "para": 15, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "Where did he --", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "Shh.", "name": "LEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "Slowly, he points.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "Down the aisle.", "para": 16, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "At the far door, a hand rests on the glass, dripping, fingers spread, waiting.", "para": 16, "sent": 2, "present": [0, 1, 2, 3]}]}