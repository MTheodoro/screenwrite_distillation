{"scene_id": "s01435", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01435.fountain", "heading": "INT. ABANDONED SALOON - DUSK", "cast": [{"id": 0, "name": "HOLLIS GREER", "names": ["HOLLIS GREER", "HOLLIS"], "gender": "?", "first": 4, "spoke": 10}, {"id": 1, "name": "DORA", "names": ["DORA"], "gender": "?", "first": 18, "spoke": 8}, {"id": 2, "name": "SIX-CROWS", "names": ["SIX-CROWS"], "gender": "?", "first": 34, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED SALOON - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "Dust blankets the long bar.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A chandelier hangs by one chain, glass prisms scattered across the floorboards like frozen rain.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Through shattered windows the sky bleeds orange into violet.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "HOLLIS GREER (50s, lean as a fence post, long coat gone grey from travel) stands at the bar with a tin cup.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He wipes a stool with his sleeve.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Sits.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "Pours water from a canteen and does not drink it.", "para": 1, "sent": 3, "present": [0]}, {"u": 8, "kind": "dialogue", "text": "Evening, folks.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": ["to the empty room"], "dual": false, "present": [0]}, {"u": 9, "kind": "action", "text": "Nothing.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "A loose shutter bangs.", "para": 2, "sent": 1, "present": [0]}, {"u": 11, "kind": "dialogue", "text": "Place looks like it's seen better days. Same as me.", "name": "HOLLIS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 12, "kind": "action", "text": "He sets the cup down.", "para": 3, "sent": 0, "present": [0]}, {"u": 13, "kind": "action", "text": "Looks at the mirror behind the bar.", "para": 3, "sent": 1, "present": [0]}, {"u": 14, "kind": "action", "text": "A crack runs through it like a river on a map.", "para": 3, "sent": 2, "present": [0]}, {"u": 15, "kind": "action", "text": "His own reflection splits in two.", "para": 3, "sent": 3, "present": [0]}, {"u": 16, "kind": "dialogue", "text": "Don't you start.", "name": "HOLLIS", "speaker": 0, "ext": ["CONT'D"], "paren": ["muttering"], "dual": false, "present": [0]}, {"u": 17, "kind": "action", "text": "A voice rings from outside, clear in the thin air.", "para": 4, "sent": 0, "present": [0]}, {"u": 18, "kind": "dialogue", "text": "Hollis Greer!", "name": "DORA", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He doesn't flinch.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "He sets down the cup, slow.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "I hear you.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Thought you might. Come out.", "name": "DORA", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "I'm tired, Dora.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "So am I. I rode three hundred miles. Come out or I come in.", "name": "DORA", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "He rubs his face.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Stands.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Settles his coat.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Moves to the doorway but does not cross it.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Everybody who's listening, I'd like it noted I asked nicely.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Nobody's listening.", "name": "DORA", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "The horses are.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "The batwing doors creak.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Spurs ring.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "THEODORA \"DORA\" SIX-CROWS (40s, braided hair silver at the roots, a Winchester slung across her back, face weathered like bark) pushes through.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Her eyes take in the wreck of the saloon, the chandelier, the cracked mirror, the man.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "You look old.", "name": "DORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "You look exactly the same.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "That's not a compliment.", "name": "DORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "It wasn't meant as one.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "She walks to the bar.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Takes his cup.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Drinks.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Sets it back.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "You still owe me a horse.", "name": "DORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "I owe you more than a horse.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Start with the horse.", "name": "DORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}