{"scene_id": "s01436", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01436.fountain", "heading": "INT. 24-HOUR LAUNDROMAT - 3 A.M.", "cast": [{"id": 0, "name": "AMARA OSEI", "names": ["AMARA OSEI", "AMARA"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "JOSEPHINE LAMB", "names": ["JOSEPHINE LAMB", "JOSEPHINE"], "gender": "?", "first": 5, "spoke": 2}, {"id": 2, "name": "TARIQ HASSAN", "names": ["TARIQ HASSAN", "TARIQ"], "gender": "?", "first": 6, "spoke": 4}, {"id": 3, "name": "BENEDETTA ROSSI", "names": ["BENEDETTA ROSSI", "BENEDETTA"], "gender": "?", "first": 7, "spoke": 4}, {"id": 4, "name": "LUCA FERRIER", "names": ["LUCA FERRIER", "LUCA"], "gender": "?", "first": 8, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. 24-HOUR LAUNDROMAT - 3 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent hum.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dryers turn like slow planets.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Five people, five machines, one wall of washers.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "AMARA OSEI (20s) folds a sheet.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "JOSEPHINE LAMB (60s) reads a paperback.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "TARIQ HASSAN (30s) stares into dryer four.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "BENEDETTA ROSSI (50s) feeds quarters into a slot.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "LUCA FERRIER (20s) is asleep on a plastic chair.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "You're reading that upside down.", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "I'm reading it the way the author intended.", "name": "JOSEPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Excuse me, do any of you know if wool shrinks at low?", "name": "TARIQ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "It shrinks at everything.", "name": "BENEDETTA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Even love?", "name": "TARIQ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "That was smooth.", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "That was an accident.", "name": "TARIQ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "They're the best kind.", "name": "JOSEPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Is it morning?", "name": "LUCA", "speaker": 4, "ext": [], "paren": ["waking"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "No, caro. It's 3 a.m. and you owe me a quarter.", "name": "BENEDETTA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "I do?", "name": "LUCA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "From last Tuesday.", "name": "BENEDETTA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "You two know each other?", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Everyone knows everyone here. It's a laundromat.", "name": "BENEDETTA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Then why have I never seen you before?", "name": "TARIQ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Maybe you weren't looking.", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "A dryer buzzes.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Nobody moves.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}]}