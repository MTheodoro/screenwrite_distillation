{"scene_id": "s01439", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01439.fountain", "heading": "INT. BOOKBINDERY - SUNDAY AFTERNOON", "cast": [{"id": 0, "name": "LIORA MENDELSOHN", "names": ["LIORA MENDELSOHN", "LIORA"], "gender": "?", "first": 5, "spoke": 7}, {"id": 1, "name": "MATEUS FARIA", "names": ["MATEUS FARIA", "MATEUS"], "gender": "f", "first": 6, "spoke": 5}, {"id": 2, "name": "SEVERINE ACHARD", "names": ["SEVERINE ACHARD", "SEVERINE"], "gender": "?", "first": 7, "spoke": 6}, {"id": 3, "name": "ODELL BRIGHT", "names": ["ODELL BRIGHT", "ODELL"], "gender": "m", "first": 8, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. BOOKBINDERY - SUNDAY AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Quiet.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Presses stand like iron monks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Spools of linen thread, bone folders, glue pots.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Sun slants through dusty skylights.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LIORA MENDELSOHN (30s) trims a spine with a knife.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "MATEUS FARIA (30s) presses a stack of pages under a brass weight.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "SEVERINE ACHARD (50s), the owner, sorts paper by tone.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "ODELL BRIGHT (20s) sweeps.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Mateus, hand me the paste.", "name": "LIORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Which paste?", "name": "MATEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "The wheat.", "name": "LIORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "There are two wheats.", "name": "MATEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "The older one, dear. It's more patient.", "name": "SEVERINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Mateus passes her a pot.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Their fingers touch.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Both glance away.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Should I do the back room?", "name": "ODELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "You did it Friday.", "name": "SEVERINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "It got dusty.", "name": "ODELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "It's a bookbindery.", "name": "SEVERINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Odell, come hold this.", "name": "LIORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Odell, come hold this.", "name": "MATEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "^I asked first.", "name": "LIORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "^I only asked second because you were slow.", "name": "MATEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Odell, caught between them, stands with his broom like a flagpole.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "I'll hold his.", "name": "ODELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Traitor.", "name": "LIORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Children. The glue is setting.", "name": "SEVERINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "All four go quiet and return to their benches.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Scissors snip.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Paper whispers.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Outside a church bell rings four.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Dinner?", "name": "MATEUS", "speaker": 1, "ext": [], "paren": ["low, to Liora"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Maybe.", "name": "LIORA", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "I heard that.", "name": "SEVERINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "You weren't meant to.", "name": "LIORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Everything in this room was meant to be heard. It's a very small room.", "name": "SEVERINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}