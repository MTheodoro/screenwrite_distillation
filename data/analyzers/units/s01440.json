{"scene_id": "s01440", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01440.fountain", "heading": "INT. HOSPITAL - CARDIAC CATH LAB - DAY", "cast": [{"id": 0, "name": "IMOGEN ACHEBE-LARSEN", "names": ["IMOGEN ACHEBE-LARSEN", "IMOGEN"], "gender": "?", "first": 4, "spoke": 11}, {"id": 1, "name": "NURSE FELIX OYAMA", "names": ["NURSE FELIX OYAMA", "FELIX"], "gender": "m", "first": 5, "spoke": 11}, {"id": 2, "name": "HARLAN VOSKUIJLEN", "names": ["HARLAN VOSKUIJLEN", "HARLAN"], "gender": "?", "first": 6, "spoke": 11}, {"id": 3, "name": "NADIA KARIMOVA", "names": ["NADIA KARIMOVA"], "gender": "?", "first": 7, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOSPITAL - CARDIAC CATH LAB - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Bright, cold, sterile.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Monitors blink green and amber.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A fluoroscope arm hangs over a table like a heron.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. IMOGEN ACHEBE-LARSEN (40s, surgical cap, calm like a held breath) scrubs at the sink, eyes on a screen.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "NURSE FELIX OYAMA (30s, steady hands, mask pushed up on his forehead) lays out instruments in perfect rows.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "On the table lies HARLAN VOSKUIJLEN (60s, gown, wrist bands, a farmer's tan line at the collar), awake, sedated, hands folded.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "In the viewing window, behind glass: NADIA KARIMOVA (50s, his wife, handbag on her lap, knitting needles motionless).", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Mr. Voskuijlen, how are we doing?", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Tell me it's a plumbing job.", "name": "HARLAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "It's a plumbing job.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Good. I fixed a tractor once.", "name": "HARLAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Little pinch, sir.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Felix slides in the needle.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Harlan doesn't wince.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "He looks at the ceiling, at the light, at a smear of dried tape on a tile.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "You ever notice that tile has a stain?", "name": "HARLAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Every day.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Shaped like Ohio.", "name": "HARLAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Nobody's ever said Ohio.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Nobody asks.", "name": "HARLAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Imogen watches the screen.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "The catheter threads upward, a gray worm through a black river.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "She tilts her head, bites her lip behind the mask.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Left anterior descending. Ninety percent.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Stent?", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Stent.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "She takes a gleaming device from the tray.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Felix hands over the next one without being asked.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "They work in silence.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "In the window, Nadia's needles begin to click.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Quick.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Quicker.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "The knitting is a scarf.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "It has no shape.", "para": 7, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Is she knitting?", "name": "HARLAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "She is.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "She always knits when it's bad.", "name": "HARLAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "It's not bad.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Then why's she on row four hundred?", "name": "HARLAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "A monitor chirps.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Not loud.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "A shift in rhythm, a stutter.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Felix steps closer.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Pressure's dropping.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "I see it.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Dr. Achebe.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "I see it.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "The beeping quickens.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "The green line jitters into a spike.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Felix grabs the paddles and rolls the cart forward; Imogen presses a hand flat on Harlan's chest.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Mr. Voskuijlen. Harlan. Stay with me.", "name": "IMOGEN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Tell her to finish the scarf.", "name": "HARLAN", "speaker": 2, "ext": [], "paren": ["eyes closing"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Clear!", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "The body jerks.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "The line flatlines for one second, two, and then, jagged, a heartbeat resumes.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Then another.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Then a rhythm.", "para": 10, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "Imogen exhales, long.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "Her shoulders drop an inch.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "Felix lowers the paddles, blinking.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "He's back.", "name": "FELIX", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "He never left.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "You said that very calmly.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "I'm calm when I'm terrified. It's a flaw.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "Behind the glass, Nadia has stopped knitting.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "Her hand is flat on the window, fingers spread.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "Imogen looks up.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "Meets her eyes.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "Nods once.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "Nadia sits back down.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "Picks up the needles.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "action", "text": "Starts a new row.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "Ohio.", "name": "HARLAN", "speaker": 2, "ext": [], "paren": ["groggy"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "dialogue", "text": "Rest, sir.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "dialogue", "text": "It's Ohio. Tell them.", "name": "HARLAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "dialogue", "text": "I'll tell them.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}