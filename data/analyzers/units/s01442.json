{"scene_id": "s01442", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01442.fountain", "heading": "INT. RUINED CHURCH BELL TOWER - DAWN", "cast": [{"id": 0, "name": "SERGEANT REYNALDO CASTELLANOS-DUBE", "names": ["SERGEANT REYNALDO CASTELLANOS-DUBE", "CASTELLANOS-DUBE"], "gender": "m", "first": 4, "spoke": 2}, {"id": 1, "name": "PRIVATE OSKAR LINDGREN-PARK", "names": ["PRIVATE OSKAR LINDGREN-PARK", "LINDGREN-PARK"], "gender": "?", "first": 5, "spoke": 3}, {"id": 2, "name": "CORPORAL ABIOLA FAGBENLE", "names": ["CORPORAL ABIOLA FAGBENLE", "FAGBENLE"], "gender": "f", "first": 6, "spoke": 2}, {"id": 3, "name": "PRIVATE TEMUJIN BATBAYAR", "names": ["PRIVATE TEMUJIN BATBAYAR", "BATBAYAR"], "gender": "?", "first": 5, "spoke": 1}, {"id": 4, "name": "LIEUTENANT HONORIA WEXCOMBE", "names": ["LIEUTENANT HONORIA WEXCOMBE", "WEXCOMBE"], "gender": "f", "first": 8, "spoke": 5}, {"id": 5, "name": "STERNBERG", "names": ["STERNBERG"], "gender": "?", "first": 17, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. RUINED CHURCH BELL TOWER - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Stone stairs wind up into broken light.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The bell lies cracked on its side, green with age.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Through a hole in the wall, smoke rises from a distant town.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SERGEANT REYNALDO CASTELLANOS-DUBE (40s, scarf over his mouth, rifle across his shoulders) crouches at the arched window.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "PRIVATE OSKAR LINDGREN-PARK (19, glasses taped at the bridge) hugs the radio set.", "para": 1, "sent": 1, "present": [0, 1, 3]}, {"u": 6, "kind": "action", "text": "CORPORAL ABIOLA FAGBENLE (30s, sniper's cheekrest slung on her back) scans the tree line with binoculars.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "PRIVATE TEMUJIN BATBAYAR (20s, silent, chewing on a stalk of grass) stacks sandbags.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "LIEUTENANT HONORIA WEXCOMBE (30s, mud to her thighs, helmet cocked back) looks over a map weighted with a rock.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Report.", "name": "WEXCOMBE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Two vehicles, north road. Neither moving.", "name": "FAGBENLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Waiting for us to blink.", "name": "CASTELLANOS-DUBE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Then we don't blink. Lindgren-Park, raise HQ.", "name": "WEXCOMBE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Yes, ma'am.", "name": "LINDGREN-PARK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "He turns the dial.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Static washes.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "A voice rises out of it, distorted.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Echo Three, this is Command. Say your status.", "name": "STERNBERG", "speaker": 5, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Command, Echo Three. Tower held. Two hostile vehicles on the north road.", "name": "WEXCOMBE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Copy. Armor is thirty minutes out. Hold position.", "name": "STERNBERG", "speaker": 5, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Thirty minutes is a long time.", "name": "WEXCOMBE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "It's what we have.", "name": "STERNBERG", "speaker": 5, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Batbayar stops stacking.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Cocks his head.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Engines.", "name": "BATBAYAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Everyone listens.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Faint, then louder.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "A low mechanical growl rolls up the valley.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "They're moving. Both.", "name": "FAGBENLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Positions.", "name": "CASTELLANOS-DUBE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "The team scatters.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Fagbenle drops prone behind the window, rifle out.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Batbayar drags sandbags to the stairwell mouth.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Castellanos-Dube takes the opposite window.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Lindgren-Park curls around the radio, mouth against the handset.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Command, Command, contact imminent.", "name": "LINDGREN-PARK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "...say again...", "name": "STERNBERG", "speaker": 5, "ext": ["V.O."], "paren": ["radio, breaking up"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Make it brief.", "name": "WEXCOMBE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Contact.", "name": "LINDGREN-PARK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "The first shell whistles.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "The tower shudders.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Dust pours from the ceiling.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "The cracked bell rings once, a bruised, enormous note.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}]}