{"scene_id": "s01443", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01443.fountain", "heading": "EXT. MOSSY STONE BRIDGE OVER A FOGGY GORGE - DAY", "cast": [{"id": 0, "name": "GRUMBLEWICK", "names": ["GRUMBLEWICK"], "gender": "m", "first": 3, "spoke": 4}, {"id": 1, "name": "ELOWEN THISTLEDOWN", "names": ["ELOWEN THISTLEDOWN", "ELOWEN"], "gender": "?", "first": 4, "spoke": 3}, {"id": 2, "name": "BRAMBLEKIN", "names": ["BRAMBLEKIN"], "gender": "?", "first": 4, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. MOSSY STONE BRIDGE OVER A FOGGY GORGE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A humpbacked bridge, green with moss, sits across a ravine of mist.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "At its center, a stool carved from a single mushroom cap.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "On the stool sits GRUMBLEWICK (ancient troll, belly like a boulder, a tiny abacus in his lap).", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "Before him stand two travelers: ELOWEN THISTLEDOWN (young, herbalist's satchel) and a hooded PEDDLER named BRAMBLEKIN (stooped, bells on his cloak).", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "Toll's three coppers.", "name": "GRUMBLEWICK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Three?", "name": "ELOWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Three?", "name": "BRAMBLEKIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "^It was two last spring.", "name": "ELOWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "^It was two last spring.", "name": "BRAMBLEKIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Grumblewick flicks a bead on his abacus.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Inflation.", "name": "GRUMBLEWICK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "We can pay.", "name": "ELOWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Then do.", "name": "GRUMBLEWICK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Elowen counts out coins.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Bramblekin watches the fog.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Ever think about crossing yourself?", "name": "BRAMBLEKIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Every day.", "name": "GRUMBLEWICK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "He pockets the coppers, hums a flat tune, and waves them on.", "para": 4, "sent": 0, "present": [0, 1, 2]}]}