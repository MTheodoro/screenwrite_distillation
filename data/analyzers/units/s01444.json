{"scene_id": "s01444", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01444.fountain", "heading": "INT. MARCHETTI PAWN & LOAN - AFTER CLOSING - NIGHT", "cast": [{"id": 0, "name": "DEACON", "names": ["DEACON"], "gender": "?", "first": 4, "spoke": 21}, {"id": 1, "name": "MARCHETTI", "names": ["MARCHETTI"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "SPARROW", "names": ["SPARROW"], "gender": "?", "first": 7, "spoke": 19}, {"id": 3, "name": "TANAKA-BELL", "names": ["TANAKA-BELL"], "gender": "?", "first": 7, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. MARCHETTI PAWN & LOAN - AFTER CLOSING - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Glass cases stuffed with watches, guitars, wedding rings.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Neon OPEN sign buzzing in reverse through the window.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A steel gate half-lowered over the door.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ENZO \"DEACON\" MARCHETTI (60s, shopkeeper, cardigan, thick glasses) sits behind the counter counting a bank envelope's worth of twenties.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "The counting is slow, careful, and he whispers numbers under his breath.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "The door chimes.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Through the gap beneath the gate slides a woman, IRIS \"SPARROW\" TANAKA-BELL (30s, black raincoat, hair damp, a duffel bag slung over one shoulder).", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "We're closed.", "name": "DEACON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "I know, Deacon.", "name": "SPARROW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "He looks up.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Recognition takes a long beat.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Sparrow.", "name": "DEACON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Been a while.", "name": "SPARROW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Nine years.", "name": "DEACON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Ten in March.", "name": "SPARROW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "She sets the duffel on the glass.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "It clinks.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Deacon doesn't touch it.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "What's in the bag?", "name": "DEACON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "What you asked for.", "name": "SPARROW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "I asked for nothing.", "name": "DEACON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Your brother did.", "name": "SPARROW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Deacon puts down the money.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "His face doesn't change, but his hand slides under the counter.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Don't.", "name": "SPARROW", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Don't what?", "name": "DEACON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Don't reach for what I think you're reaching for.", "name": "SPARROW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "He stops.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Brings the hand up empty, palm out, slow.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Habit.", "name": "DEACON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Mine too.", "name": "SPARROW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "She lifts the duffel's zipper two inches.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Gold glints.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Deacon exhales.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "That's Sal's work.", "name": "DEACON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "That's what's left of it.", "name": "SPARROW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Where's Sal?", "name": "DEACON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Where do you think?", "name": "SPARROW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "A pause.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "The neon buzzes.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "A car passes outside, headlights sweeping the ceiling.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "He was supposed to be careful.", "name": "DEACON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "He was.", "name": "SPARROW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Then what happened?", "name": "DEACON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "The thing that always happens, Deacon. Somebody got greedy.", "name": "SPARROW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Who?", "name": "DEACON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Sparrow doesn't answer.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "She zips the bag shut, pushes it across the counter.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "He does not take it.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "You want a cut.", "name": "DEACON", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "I want an apology.", "name": "SPARROW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "From me?", "name": "DEACON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "From whoever's left.", "name": "SPARROW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "He considers.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Takes off his glasses.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Rubs the bridge of his nose.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Puts them back on.", "para": 10, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "I'm sorry, Sparrow.", "name": "DEACON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "For what?", "name": "SPARROW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "Everything. Sal. The nine years. The ten in March.", "name": "DEACON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "She nods.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "Looks at the ring cases.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "You still keep the cheap ones in front?", "name": "SPARROW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "Habit.", "name": "DEACON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "She laughs, a short exhale.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "He laughs back, wearier.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "They both stop at the same moment, and both look at the door.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "Outside, tires on wet street.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "A shadow crosses the gate.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "Deacon ducks behind the counter; Sparrow drops, rolling toward the guitar rack, dragging the duffel with her.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "The doorbell chimes once, uselessly, as someone shakes the gate.", "para": 13, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "action", "text": "Then silence.", "para": 13, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "action", "text": "Then footsteps, retreating.", "para": 13, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "dialogue", "text": "Sparrow?", "name": "DEACON", "speaker": 0, "ext": ["CONT'D"], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "dialogue", "text": "Still here.", "name": "SPARROW", "speaker": 2, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "dialogue", "text": "Always was.", "name": "DEACON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "She peeks over the top of the guitar rack.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "action", "text": "He rises over the counter.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "action", "text": "They look at each other like two animals at the edge of a field, wondering who will cross first.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "dialogue", "text": "I'm leaving the bag.", "name": "SPARROW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "dialogue", "text": "Take half.", "name": "DEACON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "dialogue", "text": "Keep it. Put it in a safe and forget my name.", "name": "SPARROW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "dialogue", "text": "Never.", "name": "DEACON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 84, "kind": "action", "text": "She slips through the gate without a sound.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 85, "kind": "action", "text": "The OPEN sign flickers, once, and goes out.", "para": 15, "sent": 1, "present": [0, 1, 2, 3]}]}