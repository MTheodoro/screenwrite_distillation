{"scene_id": "s01445", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01445.fountain", "heading": "INT. THE UNSHELVED ARCHIVE - NIGHT", "cast": [{"id": 0, "name": "YSOLDE VANTH", "names": ["YSOLDE VANTH", "YSOLDE"], "gender": "f", "first": 4, "spoke": 9}, {"id": 1, "name": "KIT HOLLOWAY", "names": ["KIT HOLLOWAY", "KIT"], "gender": "m", "first": 5, "spoke": 3}, {"id": 2, "name": "THE INDEX", "names": ["THE INDEX"], "gender": "m", "first": 10, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. THE UNSHELVED ARCHIVE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A hall without a floor.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Books drift through the dark like slow fish, spines shimmering, pages fluttering as if in a current.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Ladders lean on nothing.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "YSOLDE VANTH (50s, archivist, robes of ink-stained wool, a candle in a jar on a pole) walks a path of stepping stones through the air.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Behind her trails KIT HOLLOWAY (16, apprentice, bare feet, nervous), carrying an armful of loose pages.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Keep your eyes on the stone, not the drop.", "name": "YSOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "There is no drop.", "name": "KIT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Then you have nothing to fear.", "name": "YSOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Kit steps.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "The stone sinks a hair under his weight and holds.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He doesn't breathe.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "A book glides past, the size of a door.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Its cover opens a crack, like an eye.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Query logged. Subject: Kit Holloway. Status: unregistered.", "name": "THE INDEX", "speaker": 2, "ext": ["V.O."], "paren": ["resonant, everywhere"], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Kit stops dead.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Ysolde doesn't.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Ignore it.", "name": "YSOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "It said my name.", "name": "KIT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "It says everyone's name. Keep walking.", "name": "YSOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Reason for presence?", "name": "THE INDEX", "speaker": 2, "ext": ["V.O."], "paren": ["resonant"], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Ysolde turns, one slow pivot of the heel.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "She raises the candle until it lights her chin.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Apprentice. Provisional. Filed under mine.", "name": "YSOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Provisional entries must be stamped by the thirteenth bell.", "name": "THE INDEX", "speaker": 2, "ext": ["V.O."], "paren": ["resonant"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "I know the rule.", "name": "YSOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "It is the twelfth bell.", "name": "THE INDEX", "speaker": 2, "ext": ["V.O."], "paren": ["resonant"], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Kit swallows.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Ysolde's grip on the pole tightens, white at the knuckles, but her voice remains flat as a table.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Then we shall be prompt.", "name": "YSOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "She continues.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Kit follows, steps quicker now, pages clutched to his chest.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "A feather of paper breaks loose; he doesn't chase it.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "At the end of the path stands a lectern shaped like a tree stump.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "A stamp rests on it, brass, heavy.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "A tiny bell begins to toll, softly, from nowhere.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Hand.", "name": "YSOLDE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Kit presents his palm.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "She lifts the stamp.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Holds it above his skin.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Will it hurt?", "name": "KIT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Only afterwards.", "name": "YSOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "The bell tolls again.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "The books around them slow, tilt, turn their covers toward the lectern like a crowd.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "The thirteenth bell approaches.", "name": "THE INDEX", "speaker": 2, "ext": ["V.O."], "paren": ["resonant"], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Ysolde brings the stamp down.", "para": 11, "sent": 0, "present": [0, 1, 2]}]}