{"scene_id": "s01446", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01446.fountain", "heading": "INT. CENTRAL TELEPHONE EXCHANGE - SWITCHBOARD ROOM - NIGHT, 1924", "cast": [{"id": 0, "name": "EUNICE PRUITT", "names": ["EUNICE PRUITT", "EUNICE"], "gender": "f", "first": 4, "spoke": 7}, {"id": 1, "name": "MISS LAVINIA CROFT", "names": ["MISS LAVINIA CROFT", "MISS CROFT"], "gender": "f", "first": 5, "spoke": 4}, {"id": 2, "name": "HARCOURT", "names": ["HARCOURT"], "gender": "?", "first": 7, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. CENTRAL TELEPHONE EXCHANGE - SWITCHBOARD ROOM - NIGHT, 1924", "present": []}, {"u": 1, "kind": "action", "text": "Rows of operators in shirtwaists sit at a wall of brass jacks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cords hang like ivy.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A wall clock ticks.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "EUNICE PRUITT (20s, headset, pencil in her hair) works her board with quick wrists.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Behind her, MISS LAVINIA CROFT (50s, supervisor, high collar, spectacles on a ribbon) watches over her shoulder.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Number, please.", "name": "EUNICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Operator, I want Elmwood two-two-one.", "name": "HARCOURT", "speaker": 2, "ext": ["V.O."], "paren": ["phone, crackling"], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "One moment, sir.", "name": "EUNICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Plug it in.", "name": "MISS CROFT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I am.", "name": "EUNICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Hello? Hello?", "name": "HARCOURT", "speaker": 2, "ext": ["V.O."], "paren": ["phone"], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Pinch it, Miss Pruitt, don't push.", "name": "MISS CROFT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "I am pinching it.", "name": "EUNICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I have been waiting two minutes!", "name": "HARCOURT", "speaker": 2, "ext": ["V.O."], "paren": ["phone"], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Sir, I assure you, it's two seconds.", "name": "EUNICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Do not argue with a customer.", "name": "MISS CROFT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "He is not a customer, Miss Croft, he is a bellow.", "name": "EUNICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "What did you say?", "name": "HARCOURT", "speaker": 2, "ext": ["V.O."], "paren": ["phone"], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Elmwood two-two-one, sir. Connecting now.", "name": "EUNICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "She jabs the cord home.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "A lamp flickers green.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Miss Croft nods, a barely perceptible quiver of approval.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Better.", "name": "MISS CROFT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}