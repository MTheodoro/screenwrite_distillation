{"scene_id": "s01447", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01447.fountain", "heading": "INT. DIALYSIS UNIT - EVENING", "cast": [{"id": 0, "name": "ABEL STONEHOUSE", "names": ["ABEL STONEHOUSE", "ABEL"], "gender": "m", "first": 3, "spoke": 14}, {"id": 1, "name": "GWEN", "names": ["GWEN"], "gender": "f", "first": 4, "spoke": 12}, {"id": 2, "name": "TRAN", "names": ["TRAN"], "gender": "?", "first": 4, "spoke": 0}, {"id": 3, "name": "SAMIR HADDAD-VOLKOV", "names": ["SAMIR HADDAD-VOLKOV", "SAMIR"], "gender": "m", "first": 5, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. DIALYSIS UNIT - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Rows of recliners, each with a machine beside it, each machine with its slow red heartbeat of tubing.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Late sun through blinds.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "ABEL STONEHOUSE (70s, retired carpenter, flat cap in his lap) sits tethered to a machine, a crossword in his free hand.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "Beside him, NURSE GWENDOLYN \"GWEN\" TRAN (40s, scrubs patterned with cartoon owls) adjusts a line.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 5, "kind": "action", "text": "Across the room, DR. SAMIR HADDAD-VOLKOV (50s, tie loosened, tablet clutched to his chest) reads a chart, then reads it again.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "dialogue", "text": "Five letters, \"to compress.\"", "name": "GWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Squeeze.", "name": "ABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "That's six.", "name": "GWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Press.", "name": "ABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "There it is.", "name": "GWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I have been doing this since before you were born, Gwen.", "name": "ABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "I was born in 1983.", "name": "GWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Then since you were in diapers.", "name": "ABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "She laughs.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "He fills in the squares.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Down the room, Samir hasn't moved.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "His thumb slides up and down the edge of the tablet.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "You're ahead of schedule today.", "name": "GWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "I'm always ahead of schedule.", "name": "ABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "You've been here three hours and not once complained about the chair.", "name": "GWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "The chair's fine.", "name": "ABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "That's what concerns me.", "name": "GWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Samir crosses to them.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "His smile is the kind worn for photographs.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Abel. How are the numbers feeling?", "name": "SAMIR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "I don't feel numbers, Doctor. I feel Tuesdays.", "name": "ABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Fair. Gwen, a word?", "name": "SAMIR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Of course.", "name": "GWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "She follows him to the hallway.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Abel pretends to resume his crossword but his eyes track them.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Samir speaks low.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Gwen's hand goes to her mouth.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "She says something; Samir shakes his head.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "She says it again.", "para": 4, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Abel puts down his pen.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Gwen returns first, composed, face a mask of cheer.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "That was a long word.", "name": "ABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "It was a short word. The doctor just says it slowly.", "name": "GWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Gwen.", "name": "ABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Yes, Abel?", "name": "GWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Seven letters. \"To spare someone the truth.\"", "name": "ABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "I'm not good at crosswords.", "name": "GWEN", "speaker": 1, "ext": [], "paren": ["after a beat"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Samir comes up behind her, sets the tablet in Abel's lap, turns the screen.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "A graph, a line, a downward slope.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Abel looks at it as he might at a bad joist.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "That's not a Tuesday.", "name": "ABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "No.", "name": "SAMIR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "How long?", "name": "ABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Abel --", "name": "SAMIR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "I'm a carpenter, Samir. Measure twice.", "name": "ABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Months. Perhaps less.", "name": "SAMIR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Abel nods once.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Picks up the pen.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Fills one more square, slowly, in capital letters.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "What did you write?", "name": "GWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Seven letters. Protect.", "name": "ABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "He folds the crossword, tucks it into his cap, and lowers the cap onto his head.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}]}