{"scene_id": "s01448", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01448.fountain", "heading": "EXT. FLOODED RICE TERRACE - DAWN", "cast": [{"id": 0, "name": "MIRO KOVACEVIC", "names": ["MIRO KOVACEVIC", "MIRO"], "gender": "m", "first": 5, "spoke": 8}, {"id": 1, "name": "ELIAS NORDQUIST", "names": ["ELIAS NORDQUIST", "ELIAS"], "gender": "m", "first": 6, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FLOODED RICE TERRACE - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Mist hangs over stepped paddies like breath on glass.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Water mirrors a pink sky.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dragonflies skim the surface.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Two soldiers wade along a bund, rifles held high, boots sucking in mud.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "MIRO KOVACEVIC (30s, stubble, helmet strapped crooked) leads.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "ELIAS NORDQUIST (20s, round-faced, a rosary wound around his wrist) follows two steps behind.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Silence.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Frogs.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "A distant temple bell.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He gestures.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "They stop.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He listens.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "The frogs go quiet at once, all together, in a sudden, hollow hush.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Did you hear that?", "name": "ELIAS", "speaker": 1, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Hear what?", "name": "MIRO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Nothing. That's what I mean.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Miro nods, lowers himself to one knee, sets his rifle across it.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Elias does the same, a beat late, splashing.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "They both flinch.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "He scans the far terrace.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Smoke from a thatched hut, thin and lazy.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "A water buffalo standing in the mud with its head down.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Nothing wrong.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Nothing in the world wrong.", "para": 5, "sent": 4, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Wait here.", "name": "MIRO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Where are you going?", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "To look at the buffalo.", "name": "MIRO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "It's just a buffalo.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Then it won't mind.", "name": "MIRO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "He wades forward.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Elias's eyes dart left, right, back to the hut.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "A wooden door creaks open on its own, and a tin bucket tips off the step; water flows across the planks.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Both soldiers freeze.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Then the buffalo lifts its head, and behind it, in the mud, rise rifle barrels, one after another, like stalks of rice in the dawn.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Miro lunges back and grabs Elias by the collar, dragging him down behind the bund as the first shot cracks.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Mud sprays.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Elias fires blindly; Miro slaps the muzzle skyward, shouting, and they roll together along the slope, each pulling the other, each pushing, until they slam against a stone marker half-buried in the dyke and lie there panting, rifles tangled between them.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "You said it was clear!", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "I said it looked clear.", "name": "MIRO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "That's not the same!", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "That's what I'm saying.", "name": "MIRO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Another volley whines overhead.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Elias presses his face into the mud.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "Miro, breathing hard, reaches over and squeezes his shoulder.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Count with me.", "name": "MIRO", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "To what?", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "To three.", "name": "MIRO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "They count, silently, lips moving, then rise as one.", "para": 10, "sent": 0, "present": [0, 1]}]}