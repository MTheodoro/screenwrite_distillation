{"scene_id": "s01451", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01451.fountain", "heading": "INT. TRANSCONTINENTAL EXPRESS - DINING CAR - NIGHT", "cast": [{"id": 0, "name": "HELENA MARCHBANKS", "names": ["HELENA MARCHBANKS", "HELENA"], "gender": "f", "first": 5, "spoke": 17}, {"id": 1, "name": "CONRAD ELLIS-WHYTE", "names": ["CONRAD ELLIS-WHYTE", "CONRAD"], "gender": "?", "first": 7, "spoke": 17}, {"id": 2, "name": "OLUWASEUN", "names": ["OLUWASEUN"], "gender": "?", "first": 11, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. TRANSCONTINENTAL EXPRESS - DINING CAR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "White tablecloths.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Silver on linen.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Brass lamps with fringed shades sway to the rhythm of the rails.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Outside, black prairie slips by.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "HELENA MARCHBANKS (40s, evening gown, diamonds at the throat, gloves she has not removed) sits alone at a table set for two.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A glass of champagne sweats before her.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "CONRAD ELLIS-WHYTE (50s, tuxedo, white carnation, a face of polished walnut) enters from the vestibule.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He pauses.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Tugs his cuffs.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Crosses.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "FITZGERALD \"FITZ\" OLUWASEUN (20s, porter's uniform, tray balanced on one palm) sets down a plate of oysters, glances at both of them, and withdraws toward the pantry door, listening.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "You're early.", "name": "CONRAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "You're late.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I was detained.", "name": "CONRAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "By whom?", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "He takes the chair across from her.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Smooths the napkin over his knee.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "By nobody. By the bar. By myself.", "name": "CONRAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "That's three.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "That's honest.", "name": "CONRAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "She lifts her glass.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Does not drink.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Sets it down.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "I got your telegram.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Ah.", "name": "CONRAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "It said \"Meet me in the dining car, we need to talk.\"", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "It did.", "name": "CONRAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "It did not say about what.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "I thought you'd know.", "name": "CONRAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "I suspected.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Fitz shifts by the pantry door.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "A tray rattles.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Both look at him.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "He smiles brightly, bows, vanishes.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Is that boy listening?", "name": "CONRAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Everyone listens on a train. It's a very small town.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Conrad leans in.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Lowers his voice.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "The Havilland papers. You gave them to the Senator.", "name": "CONRAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "I did.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Without telling me.", "name": "CONRAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "I told you in the telegram I sent first. You never answered.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "I assumed it was a joke.", "name": "CONRAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "I assumed you read your mail.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "He slaps the table.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Silverware leaps.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "The oysters shiver in their ice.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Helena doesn't blink.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Do you realize what you have done?", "name": "CONRAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "I have kept a promise, Conrad. It's unfamiliar to you.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Forty years. Forty years of this firm, and you hand it to a politician over a cup of coffee.", "name": "CONRAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Over a lunch.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Oh, a lunch! That makes it civil.", "name": "CONRAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "It was a good lunch.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "He rises.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "She does not.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "The car lurches around a curve; a glass slides, drops, shatters.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Fitz appears with a brush and a dustpan, sweeps without a word, and retreats.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Conrad sits down again, heavily.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "Reaches for her hand.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "She lets him.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "You were always the smarter one.", "name": "CONRAD", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "I know.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "I resent it.", "name": "CONRAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "I know that too.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "What now?", "name": "CONRAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "dialogue", "text": "Eat your oysters. They're getting warm.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "He laughs, once, a surprised bark.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "Picks up a fork.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "The train howls into the dark.", "para": 11, "sent": 2, "present": [0, 1, 2]}]}