{"scene_id": "s01452", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01452.fountain", "heading": "INT. GRANDFATHER'S GARAGE - AFTERNOON", "cast": [{"id": 0, "name": "LEOPOLD VASQUEZ-MBEKI", "names": ["LEOPOLD VASQUEZ-MBEKI", "LEOPOLD"], "gender": "?", "first": 4, "spoke": 8}, {"id": 1, "name": "SUNNIVA", "names": ["SUNNIVA"], "gender": "?", "first": 5, "spoke": 6}, {"id": 2, "name": "MURRAY", "names": ["MURRAY"], "gender": "?", "first": 27, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRANDFATHER'S GARAGE - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Pegboard walls, every wrench outlined in marker.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A 1971 pickup under a canvas sheet.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A radio on a shelf plays low static.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LEOPOLD VASQUEZ-MBEKI (70s, coveralls, a pencil behind each ear) sits on an upturned bucket, sanding a chair leg.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "His granddaughter SUNNIVA (9, pigtails, oversized work gloves) holds the leg steady, tongue between her teeth.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "On a workbench, a cell phone vibrates against a coffee can.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He glances at it.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She glances at him.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Neither moves.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Is that Dad?", "name": "SUNNIVA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Probably.", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Shouldn't you answer?", "name": "SUNNIVA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Probably.", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He finishes the stroke.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Blows dust off the wood.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Hands her the leg.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She runs her thumb along the grain, nods, and sets it on the bench.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "The phone goes still.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "A moment later, it buzzes again.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "He's persistent.", "name": "LEOPOLD", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Like you.", "name": "SUNNIVA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Like your grandmother.", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "He wipes his hands on a rag.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Reaches for the phone.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Taps the screen.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Sets it on the bench, on speaker.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Pop? You there?", "name": "MURRAY", "speaker": 2, "ext": ["V.O."], "paren": ["phone"], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "I'm here.", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Is Sunni with you?", "name": "MURRAY", "speaker": 2, "ext": ["V.O."], "paren": ["phone"], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "She is. She's sanding.", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "I'm not sanding. He's sanding. I'm holding.", "name": "SUNNIVA", "speaker": 1, "ext": [], "paren": ["to the phone"], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Okay. Holding. Can you hold till six? I'm stuck at the office.", "name": "MURRAY", "speaker": 2, "ext": ["V.O."], "paren": ["phone"], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "She can hold till Christmas.", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "I can.", "name": "SUNNIVA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Thanks, Pop. Love you both.", "name": "MURRAY", "speaker": 2, "ext": ["V.O."], "paren": ["phone"], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "He hangs up before Leopold can reply.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Leopold stares at the dead phone.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Sunniva picks up the chair leg again and holds it out to him.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "He didn't say bye.", "name": "SUNNIVA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "He never does.", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "He takes the leg.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Resumes sanding.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "She sits on the floor, cross-legged, watching his hands.", "para": 8, "sent": 2, "present": [0, 1, 2]}]}