{"scene_id": "s01453", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01453.fountain", "heading": "INT. ARLO'S APARTMENT - ENTRY HALL - NIGHT", "cast": [{"id": 0, "name": "ARLO PENDERGAST", "names": ["ARLO PENDERGAST", "ARLO"], "gender": "m", "first": 4, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. ARLO'S APARTMENT - ENTRY HALL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dark.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A key rattles in the lock.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The door swings inward, bumping a stack of unopened mail.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ARLO PENDERGAST (40s, rain-soaked suit, a cake box under one arm, a party hat still on his head from a party that ended badly) steps inside.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He closes the door with his heel.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Flips the switch.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "Nothing.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "dialogue", "text": "Of course.", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 9, "kind": "action", "text": "He fumbles in the dark.", "para": 3, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "Finds the wall.", "para": 3, "sent": 1, "present": [0]}, {"u": 11, "kind": "action", "text": "Finds a plant.", "para": 3, "sent": 2, "present": [0]}, {"u": 12, "kind": "action", "text": "Apologizes to the plant.", "para": 3, "sent": 3, "present": [0]}, {"u": 13, "kind": "dialogue", "text": "Sorry.", "name": "ARLO", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 14, "kind": "action", "text": "The red light of an answering machine blinks on a side table.", "para": 4, "sent": 0, "present": [0]}, {"u": 15, "kind": "action", "text": "He stares at it.", "para": 4, "sent": 1, "present": [0]}, {"u": 16, "kind": "action", "text": "He presses PLAY.", "para": 4, "sent": 2, "present": [0]}, {"u": 17, "kind": "dialogue", "text": "Hi! You've reached Arlo. I'm either out having an amazing time or I'm in the bath. Leave a message!", "name": "ARLO", "speaker": 0, "ext": ["V.O."], "paren": ["answering machine, cheerful"], "dual": false, "present": [0]}, {"u": 18, "kind": "action", "text": "A long beep.", "para": 5, "sent": 0, "present": [0]}, {"u": 19, "kind": "action", "text": "Silence.", "para": 5, "sent": 1, "present": [0]}, {"u": 20, "kind": "action", "text": "Arlo (the real one) exhales through his nose.", "para": 5, "sent": 2, "present": [0]}, {"u": 21, "kind": "action", "text": "He sets the cake box on the table.", "para": 6, "sent": 0, "present": [0]}, {"u": 22, "kind": "action", "text": "Opens it.", "para": 6, "sent": 1, "present": [0]}, {"u": 23, "kind": "action", "text": "Inside, a small cake, the frosting smeared, a single candle bent sideways.", "para": 6, "sent": 2, "present": [0]}, {"u": 24, "kind": "action", "text": "The words \"HAPPY 40TH\" have slid into \"HAPPY 4 TH.\"", "para": 6, "sent": 3, "present": [0]}, {"u": 25, "kind": "dialogue", "text": "Happy 4th.", "name": "ARLO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 26, "kind": "action", "text": "He picks up the candle.", "para": 7, "sent": 0, "present": [0]}, {"u": 27, "kind": "action", "text": "Lights it with a match from his pocket.", "para": 7, "sent": 1, "present": [0]}, {"u": 28, "kind": "action", "text": "The flame illuminates his face from below, hollow-eyed, absurd under the paper hat.", "para": 7, "sent": 2, "present": [0]}, {"u": 29, "kind": "action", "text": "He sits on the floor.", "para": 8, "sent": 0, "present": [0]}, {"u": 30, "kind": "action", "text": "Tilts the cake toward himself.", "para": 8, "sent": 1, "present": [0]}, {"u": 31, "kind": "action", "text": "Takes a breath to blow it out.", "para": 8, "sent": 2, "present": [0]}, {"u": 32, "kind": "action", "text": "The answering machine clicks.", "para": 9, "sent": 0, "present": [0]}, {"u": 33, "kind": "action", "text": "Another message.", "para": 9, "sent": 1, "present": [0]}, {"u": 34, "kind": "dialogue", "text": "Hey, it's me. Future me. Just wanted to say, whatever you wished for, you're welcome.", "name": "ARLO", "speaker": 0, "ext": ["V.O."], "paren": ["answering machine, slightly drunk"], "dual": false, "present": [0]}, {"u": 35, "kind": "action", "text": "Arlo sits perfectly still.", "para": 10, "sent": 0, "present": [0]}, {"u": 36, "kind": "action", "text": "The candle burns down.", "para": 10, "sent": 1, "present": [0]}, {"u": 37, "kind": "action", "text": "He laughs.", "para": 11, "sent": 0, "present": [0]}, {"u": 38, "kind": "action", "text": "First small, then helpless, then in great wheezing gasps, tears running into the party hat's elastic.", "para": 11, "sent": 1, "present": [0]}, {"u": 39, "kind": "action", "text": "He blows out the candle, sits in the smoke, and eats the cake with his fingers.", "para": 11, "sent": 2, "present": [0]}]}