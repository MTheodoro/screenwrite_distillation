{"scene_id": "s01454", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01454.fountain", "heading": "INT. WEDDING CAKE BAKERY - DAY", "cast": [{"id": 0, "name": "GERTRUDE POSLUNS", "names": ["GERTRUDE POSLUNS", "GERTRUDE"], "gender": "?", "first": 3, "spoke": 11}, {"id": 1, "name": "BARNEY ODUYA", "names": ["BARNEY ODUYA", "BARNEY"], "gender": "?", "first": 6, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. WEDDING CAKE BAKERY - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A tiny shop, glass cases, tiers of fondant in a pastel parade.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The air smells of butter and bad decisions.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "GERTRUDE POSLUNS (50s, flour to the elbows, apron stained rainbow) frosts a three-tier cake with a palette knife as if defusing a bomb.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "The door's bell jangles.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "dialogue", "text": "We're closed.", "name": "GERTRUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 6, "kind": "action", "text": "BARNEY ODUYA (30s, groom, tuxedo jacket, one shoe untied) bursts in, breathless.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Please. Please. I need a cake.", "name": "BARNEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You have a cake. You ordered it in March.", "name": "GERTRUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I ordered a cake in March. My fianc\u00e9e ordered another cake in April.", "name": "BARNEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I know. I made both.", "name": "GERTRUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "They're in the same venue. At the same hour.", "name": "BARNEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Then you'll have double the dessert.", "name": "GERTRUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "I'll have double the divorce.", "name": "BARNEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He puts both hands on her glass case.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She doesn't look up from the frosting.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Which one is yours?", "name": "GERTRUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "The coconut.", "name": "BARNEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Hers?", "name": "GERTRUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Also coconut.", "name": "BARNEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "^Then they're the same.", "name": "GERTRUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "^Then they're the same.", "name": "BARNEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "He stops.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "They look at each other.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "The bell above the door settles.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "So it's not a crisis.", "name": "GERTRUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "It's a crisis of principle.", "name": "BARNEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "I deal in crises of sugar.", "name": "GERTRUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "She hands him a bag.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Inside, two sprigs of mint.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Put one on each. They won't notice a difference.", "name": "GERTRUDE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Thank you.", "name": "BARNEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Go get married.", "name": "GERTRUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "He bolts.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "The bell jangles.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "She resumes frosting.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Outside, a car horn.", "para": 6, "sent": 3, "present": [0, 1]}]}