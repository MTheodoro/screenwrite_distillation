{"scene_id": "s01455", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01455.fountain", "heading": "INT. VELODROME - TRACKSIDE INFIELD - EVENING", "cast": [{"id": 0, "name": "MARISOL VENTURA-KHAN", "names": ["MARISOL VENTURA-KHAN", "MARISOL"], "gender": "f", "first": 5, "spoke": 9}, {"id": 1, "name": "AUGUSTO NKEMELU", "names": ["AUGUSTO NKEMELU", "AUGUSTO"], "gender": "f", "first": 6, "spoke": 11}, {"id": 2, "name": "ANNOUNCER", "names": ["ANNOUNCER"], "gender": "?", "first": 14, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. VELODROME - TRACKSIDE INFIELD - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Steep banking of blond wood.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Overhead lights hum.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "An empty stand rises in tiers.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The track gleams like a polished spine.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MARISOL VENTURA-KHAN (20s, skinsuit, helmet strapped under her chin) sits on a folding stool, bare feet in cleated shoes, staring at nothing.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "AUGUSTO NKEMELU (50s, coach, tracksuit, stopwatch on a lanyard) crouches in front of her, adjusting her cleat.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "She breathes.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "In.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Out.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "A slow metronome.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He clicks the watch.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Doesn't look at it.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "A speaker crackles overhead.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Riders to the line for the individual pursuit, final.", "name": "ANNOUNCER", "speaker": 2, "ext": ["V.O."], "paren": ["PA, echoing"], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "She stands.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "He stands with her.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "She rolls her neck.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "He rubs her shoulder once, hard, the way you'd warm up an engine.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Four minutes. Four-oh-seven. Same as practice.", "name": "AUGUSTO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I know.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "You've done it a hundred times.", "name": "AUGUSTO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "I know.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Then why is your hand shaking?", "name": "AUGUSTO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "She looks at it.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "It is.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "She flexes it.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Stops.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "It's the cold.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "It's seventy degrees.", "name": "AUGUSTO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Then it's the lights.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "He lets it go.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Leads her to the bike.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "She mounts, clips in, and rolls up the banking to the starting gate, where a mechanic holds her saddle.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Augusto stands at the rail, arms crossed.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Five seconds.", "name": "ANNOUNCER", "speaker": 2, "ext": ["V.O."], "paren": ["PA"], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Her face is still.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Her breath doesn't change.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "He stares at her, and for one second she looks up, directly at him, with an expression he cannot read.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Go.", "name": "ANNOUNCER", "speaker": 2, "ext": ["V.O."], "paren": ["PA"], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "She explodes off the line.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "The bike hums on the boards.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "She comes round the first bend, the second, her cadence steady, her back flat.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "He clicks the watch.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Good. Good.", "name": "AUGUSTO", "speaker": 1, "ext": [], "paren": ["under his breath"], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Lap three.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Lap four.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "She holds the line.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "He relaxes, a small exhale.", "para": 10, "sent": 3, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Lap seven.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Her cadence stutters.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "He leans over the rail.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Marisol!", "name": "AUGUSTO", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "She doesn't hear.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Or she does, and ignores it.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Her wheel drifts a hand's width up the banking.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "Marisol, down! Hold your line!", "name": "AUGUSTO", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "She comes off the banking too early, wobbles, corrects.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "The stands are empty but he shouts as if they were full.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "Lap eleven.", "name": "ANNOUNCER", "speaker": 2, "ext": ["V.O."], "paren": ["PA"], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "She is a half-second off pace.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "He sees it.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "He sees it again at the next split.", "para": 14, "sent": 2, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "The stopwatch trembles in his hand.", "para": 14, "sent": 3, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "Then she does something unexpected.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "She sits up.", "para": 15, "sent": 1, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "Coasts.", "para": 15, "sent": 2, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "Rolls to a stop on the apron, unclips, and stands with her bike against her hip.", "para": 15, "sent": 3, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "He vaults the rail, runs.", "para": 16, "sent": 0, "present": [0, 1, 2]}, {"u": 69, "kind": "dialogue", "text": "What are you doing?", "name": "AUGUSTO", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 70, "kind": "dialogue", "text": "I'm done.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": ["calm"], "dual": false, "present": [0, 1, 2]}, {"u": 71, "kind": "dialogue", "text": "You were on pace.", "name": "AUGUSTO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 72, "kind": "dialogue", "text": "I was on your pace.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 73, "kind": "action", "text": "He stares.", "para": 17, "sent": 0, "present": [0, 1, 2]}, {"u": 74, "kind": "action", "text": "She takes off her helmet.", "para": 17, "sent": 1, "present": [0, 1, 2]}, {"u": 75, "kind": "action", "text": "Her hair is plastered to her forehead.", "para": 17, "sent": 2, "present": [0, 1, 2]}, {"u": 76, "kind": "action", "text": "She hands him the helmet like a gift.", "para": 17, "sent": 3, "present": [0, 1, 2]}, {"u": 77, "kind": "dialogue", "text": "Tell them I withdrew.", "name": "MARISOL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 78, "kind": "dialogue", "text": "Why?", "name": "AUGUSTO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 79, "kind": "dialogue", "text": "Because I wanted to see if you'd run.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 80, "kind": "action", "text": "He looks down at his own feet.", "para": 18, "sent": 0, "present": [0, 1, 2]}, {"u": 81, "kind": "action", "text": "Then up, at her, and somewhere between rage and relief, his face crumples.", "para": 18, "sent": 1, "present": [0, 1, 2]}, {"u": 82, "kind": "dialogue", "text": "That's a terrible reason.", "name": "AUGUSTO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 83, "kind": "dialogue", "text": "It's the only one I had.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}