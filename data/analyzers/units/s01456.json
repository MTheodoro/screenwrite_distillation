{"scene_id": "s01456", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01456.fountain", "heading": "EXT. OPEN OCEAN - LIFEBOAT - DAY", "cast": [{"id": 0, "name": "PETRA ISAKSSON", "names": ["PETRA ISAKSSON", "PETRA"], "gender": "?", "first": 3, "spoke": 3}, {"id": 1, "name": "WILFRED OKONJO-HART", "names": ["WILFRED OKONJO-HART", "WILFRED"], "gender": "?", "first": 4, "spoke": 5}, {"id": 2, "name": "NOOR SAFFARINI", "names": ["NOOR SAFFARINI", "NOOR"], "gender": "?", "first": 5, "spoke": 3}, {"id": 3, "name": "SWIMMER", "names": ["SWIMMER"], "gender": "?", "first": 15, "spoke": 3}, {"id": 4, "name": "RAMON", "names": ["RAMON"], "gender": "?", "first": 26, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. OPEN OCEAN - LIFEBOAT - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A cracked orange lifeboat drifts on a flat grey sea.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "No land.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "PETRA ISAKSSON (30s, sunburned, hair matted) bails with a cut-off bottle.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "WILFRED OKONJO-HART (50s, one arm in a sling) watches the horizon.", "para": 0, "sent": 3, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "NOOR SAFFARINI (20s, lips split) lies across the thwart, eyes shut.", "para": 0, "sent": 4, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Water's rising.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Keep bailing.", "name": "WILFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Someone's out there.", "name": "NOOR", "speaker": 2, "ext": [], "paren": ["without opening her eyes"], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "You're dreaming.", "name": "WILFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I'm not.", "name": "NOOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "A splash.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Petra freezes.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Wilfred squints.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "A man's head breaks the surface twenty feet off.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "A SWIMMER (30s, shaved head, black wetsuit, mouth ringed in salt) stroking toward them with long, tired, unhurried pulls.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Oh my God.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Pull him in.", "name": "WILFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "They grab his wrists.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "He thumps over the gunwale and lies there gasping.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Petra offers the bottle.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "He drinks, coughs, drinks again.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Thank you.", "name": "SWIMMER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Where did you come from?", "name": "WILFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "The cargo ship. It sank four days ago.", "name": "SWIMMER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Four days?", "name": "NOOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Four days. I'm Ramon.", "name": "SWIMMER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Ramon. Petra. This is Wilfred. That's Noor.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "How many are you?", "name": "RAMON", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Three.", "name": "WILFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Four, now.", "name": "RAMON", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "He smiles.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Noor opens one eye, and does not smile back.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}]}