{"scene_id": "s01457", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01457.fountain", "heading": "INT. SUDS & SHINE CAR WASH - TUNNEL - DAY", "cast": [{"id": 0, "name": "DETECTIVE WALTER BRZEZINSKI", "names": ["DETECTIVE WALTER BRZEZINSKI", "WALTER"], "gender": "?", "first": 4, "spoke": 9}, {"id": 1, "name": "LULU", "names": ["LULU"], "gender": "?", "first": 5, "spoke": 8}, {"id": 2, "name": "FAIRWEATHER", "names": ["FAIRWEATHER"], "gender": "?", "first": 5, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. SUDS & SHINE CAR WASH - TUNNEL - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A tunnel of whirring brushes, foam, and blue neon.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Water thrums on the roof.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rollers drag a battered Buick through a bath of pink soap.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DETECTIVE WALTER BRZEZINSKI (50s, trench coat, fedora brim dripping) leans against the tunnel wall, arms folded, ignoring the spray.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across from him, in a plastic chair beside the dryer vents, sits LUCIANA \"LULU\" FAIRWEATHER (30s, red leather jacket, acrylic nails, a trembling cigarette).", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "You said you'd tell me.", "name": "WALTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "I said I'd think about it.", "name": "LULU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "You've thought for two weeks.", "name": "WALTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "It's a big thought.", "name": "LULU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "The Buick passes.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "A brush slaps its windshield with a heavy, rhythmic thud.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Foam smears the glass.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Who ordered the hit?", "name": "WALTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Walter.", "name": "LULU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Lulu.", "name": "WALTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "If I say it, I'm dead.", "name": "LULU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "If you don't, so is the next kid.", "name": "WALTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "She looks at the cigarette.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Looks at the dryers.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Stubs the cigarette against the chair.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "It was the guy who runs this place.", "name": "LULU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Walter doesn't move.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "The tunnel roars.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Slowly, he turns his head toward the glass booth by the exit, its light on, its door ajar.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Don't look.", "name": "WALTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "I'm not.", "name": "LULU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Stay seated.", "name": "WALTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "I'm seated.", "name": "LULU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "He walks.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Not quickly.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Not slowly.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Past the dryers, past the wax station.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "His hand slips inside his coat.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "A rubber flap swings.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "A roar of water.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "The Buick, wet, shining, rolls between him and the booth like a curtain, and by the time it clears, he is at the door with his gun lowered.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "The booth is empty.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "A coffee cup steams on the counter beside a phone off its hook.", "para": 6, "sent": 4, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Gus is gone.", "name": "WALTER", "speaker": 0, "ext": ["CONT'D"], "paren": ["calm"], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Is it over?", "name": "LULU", "speaker": 1, "ext": [], "paren": ["from the chair, almost a whisper"], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "It's over.", "name": "WALTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "She picks up another cigarette.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Her hand is perfectly steady now.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "She lights it, and the foam settles in the tunnel's blue glow.", "para": 7, "sent": 2, "present": [0, 1, 2]}]}