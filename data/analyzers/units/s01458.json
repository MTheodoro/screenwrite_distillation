{"scene_id": "s01458", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01458.fountain", "heading": "INT. ICE-FISHING SHACK - NIGHT", "cast": [{"id": 0, "name": "GIDEON PARR", "names": ["GIDEON PARR", "GIDEON"], "gender": "m", "first": 6, "spoke": 11}, {"id": 1, "name": "HUGO LEDBETTER", "names": ["HUGO LEDBETTER", "HUGO"], "gender": "m", "first": 7, "spoke": 9}, {"id": 2, "name": "WOMAN", "names": ["WOMAN"], "gender": "?", "first": 38, "spoke": 2}, {"id": 3, "name": "AUDREY", "names": ["AUDREY"], "gender": "?", "first": 46, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. ICE-FISHING SHACK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A plywood box on a frozen lake.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A propane heater glows orange in the corner.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Two holes cut in the floor, black water showing through, lines dangling.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A thermometer reads minus nineteen.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Windows frosted white.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "GIDEON PARR (50s, parka, wool cap, a face weathered by wind) sits on an overturned bucket, jigging a line with two fingers.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "HUGO LEDBETTER (50s, same parka but green, a thermos in his lap, mustache stiff with frost) sits across from him, doing nothing.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Nothing.", "name": "GIDEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Nothing.", "name": "HUGO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Nothing for three hours.", "name": "GIDEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "That's why they call it fishing.", "name": "HUGO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "They call it that because of the fish.", "name": "GIDEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Hugo pours coffee.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "It steams.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "He passes the cup.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Gideon takes it, warms his hands, and sips.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Heard something.", "name": "GIDEON", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Wind.", "name": "HUGO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Wasn't wind.", "name": "GIDEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Ice shifting. It does that.", "name": "HUGO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "They listen.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Faint, a soft scratch, rhythmic, like fingernails dragging over the lake's underside.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "That's not ice.", "name": "GIDEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Gideon.", "name": "HUGO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Hugo.", "name": "GIDEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "The scratch circles the shack.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Passes the window.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "The frost on the glass takes the shape of a palm, then gently fades.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Both men stand.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Hugo reaches for the door latch.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Gideon grips his arm.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Don't.", "name": "GIDEON", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "If it's a person, they'll freeze.", "name": "HUGO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "It's minus nineteen. No person is out there.", "name": "GIDEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Knock.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Three, soft.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "A voice outside, thin, pleading.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Please. I'm cold.", "name": "WOMAN", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "They stare at each other.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Hugo lifts the latch an inch.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "The wind pours in, and with it a smell of lake mud and violets.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Gideon hauls him back and slams the latch shut, and the knocking resumes, faster, three, three, three, as the heater gutters and Hugo, whose hands are shaking, shoves Gideon aside, flings the door open, and stands blinking at a figure on the ice.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "A WOMAN (30s, nightgown, barefoot, hair frozen in rope-like strands) looks up at them.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Her lips are blue.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Her eyes are perfectly dry.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "I'm Audrey. I fell through in March.", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Hugo takes a step back.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Gideon grabs the rifle from the corner and aims, hands shaking.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Stay back.", "name": "GIDEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "I just want to come in.", "name": "AUDREY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Nobody invited you.", "name": "HUGO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "You did. You cut the hole.", "name": "AUDREY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "She points to the floor.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Through the black water in the fishing hole, a pale hand is rising, fingers spread, reaching up toward the lamp.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Gideon fires.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "The shot booms.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Ice cracks in a long white line across the lake, and the wind dies.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "When the echo fades, Audrey is gone.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "The hole in the floor is just a hole, black and still.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "Hugo lowers himself onto the bucket.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "Gideon sets down the rifle.", "para": 12, "sent": 3, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "Pour me a coffee.", "name": "HUGO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "Thermos is empty.", "name": "GIDEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "Then we wait.", "name": "HUGO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "They sit in the dim orange glow, listening to the lake settle.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "Neither touches his line.", "para": 13, "sent": 1, "present": [0, 1, 2]}]}