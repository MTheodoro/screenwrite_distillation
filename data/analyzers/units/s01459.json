{"scene_id": "s01459", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01459.fountain", "heading": "INT. MUSEUM OF MINIATURE HOUSES - NIGHT", "cast": [{"id": 0, "name": "PRUDENCE KELLAWAY", "names": ["PRUDENCE KELLAWAY", "PRUDENCE"], "gender": "f", "first": 4, "spoke": 8}, {"id": 1, "name": "ZINNIA BELLWETHER", "names": ["ZINNIA BELLWETHER", "ZINNIA"], "gender": "f", "first": 5, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. MUSEUM OF MINIATURE HOUSES - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A hush of glass cases.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dollhouses on pedestals: Victorian mansions, adobe cottages, a tiny lighthouse.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Each lit from within by pin-sized lamps.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "PRUDENCE KELLAWAY (40s, curator's blazer, flashlight clipped to her belt) makes her rounds, brushing dust from a case with a feather duster.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Behind her, trailing a step too close, comes ZINNIA BELLWETHER (20s, intern, overlarge cardigan, tote bag of cleaning supplies).", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Mind the north wing. The Whitcombe house is on a loose pedestal.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Which one is Whitcombe?", "name": "ZINNIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "The one with the attic.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Zinnia peers at a case.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "A Georgian townhouse, its windows aglow.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "In the tiny attic window, a doll sits in a rocking chair, facing the glass.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "She's looking at me.", "name": "ZINNIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "They're all looking at someone.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She keeps walking.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Zinnia lingers.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She bends close.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Her breath fogs the glass.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Was she facing the wall earlier?", "name": "ZINNIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Who?", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "The doll. This afternoon. She was facing the wall.", "name": "ZINNIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Dolls don't move.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "I know.", "name": "ZINNIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Prudence turns, annoyed, to check.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She stops.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Her face goes still.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "She crouches beside Zinnia, both women at the level of the miniature window.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "In the attic, the little rocking chair is rocking.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Slowly.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Back, forth.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "The doll's head has turned toward them.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Prudence grips Zinnia's arm.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Zinnia grips back.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Neither speaks.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "The tiny lamps in the Georgian house flicker out, one floor at a time, until only the attic glows.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Back away.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": ["barely a whisper"], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "I can't.", "name": "ZINNIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Why not?", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "She's holding my hand.", "name": "ZINNIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Prudence looks down.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Zinnia's fingers, still wrapped around her sleeve, are pale.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "A thread of white yarn runs from Zinnia's cuff, taut, across the floor, and into a hairline gap beneath the case.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Prudence snaps the thread with a tug.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "The doll in the attic tips from her chair and tumbles out of sight.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "The lamp dies.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "The whole museum goes dark except for the flashlight at Prudence's belt, trembling with her breath.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "We're leaving.", "name": "PRUDENCE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "Yes.", "name": "ZINNIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "They run.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "Behind them, in a hundred miniature houses, a hundred tiny lights wink on.", "para": 10, "sent": 1, "present": [0, 1]}]}