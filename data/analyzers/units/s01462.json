{"scene_id": "s01462", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01462.fountain", "heading": "EXT. CANYON FLOOR - WRECKED HOT AIR BALLOON - DAY", "cast": [{"id": 0, "name": "WOMAN", "names": ["WOMAN"], "gender": "f", "first": 4, "spoke": 3}, {"id": 1, "name": "MARGOT BRANDT-KIM", "names": ["MARGOT BRANDT-KIM", "MARGOT"], "gender": "f", "first": 5, "spoke": 14}, {"id": 2, "name": "SOLEDAD", "names": ["SOLEDAD"], "gender": "f", "first": 14, "spoke": 12}], "units": [{"u": 0, "kind": "heading", "text": "EXT. CANYON FLOOR - WRECKED HOT AIR BALLOON - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Red rock walls rise a thousand feet.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The balloon's envelope lies draped across boulders like a collapsed circus tent, stripes of orange and white fluttering.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The basket is on its side, wicker split.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A WOMAN (40s, flight suit, blood on her temple, one boot missing) crawls from the wreckage, dragging a first-aid kit.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "MARGOT BRANDT-KIM (30s, pilot's vest, sun-hat torn, ropeburn on both palms) sits on a boulder, drinking from a canteen.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Don't stand.", "name": "MARGOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "I'm fine.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You're not fine. You're bleeding.", "name": "MARGOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "So are you.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Margot looks at her hands.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Shrugs.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Passes the canteen across.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "I'm Margot.", "name": "MARGOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Soledad.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Soledad. Nice to meet you. Sorry about the crash.", "name": "MARGOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "It wasn't your fault.", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I'm the pilot. It's always my fault.", "name": "MARGOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Soledad drinks.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Wipes her mouth.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Gives the canteen back.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "They sit, shoulder to shoulder, small figures at the bottom of a very large place.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "How far to the road?", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Twelve miles. Maybe fifteen.", "name": "MARGOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "We have two liters.", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "We have one and a half.", "name": "MARGOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "She gestures at the canteen.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "A thin trickle leaks from the base.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Soledad closes her eyes.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "So we leave now.", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "We leave at dusk. She's too hot.", "name": "MARGOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Who?", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "The sun.", "name": "MARGOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Soledad laughs, briefly, then winces.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Her hand goes to her ribs.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Margot, you should know something.", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Okay.", "name": "MARGOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "I didn't buy a ticket. I stowed away.", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Margot looks at her.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Slowly puts down the canteen.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Why?", "name": "MARGOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Because she told me you'd stop if I asked.", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Who told you?", "name": "MARGOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Your sister.", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Margot doesn't move.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "A hawk circles overhead, a dark scribble on the pale sky.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "My sister is dead.", "name": "MARGOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Yes. She was very clear about that.", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Margot stands.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Soledad lifts a hand, palm out.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Sit. Please. We have twelve miles to talk.", "name": "SOLEDAD", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "I'm going to kill you.", "name": "MARGOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Not before dusk.", "name": "SOLEDAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}