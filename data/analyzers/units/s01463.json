{"scene_id": "s01463", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01463.fountain", "heading": "INT. GREYHOUND DEPOT - WAITING ROOM - 2 A.M.", "cast": [{"id": 0, "name": "CORMAC BEAUFORT", "names": ["CORMAC BEAUFORT", "CORMAC"], "gender": "m", "first": 5, "spoke": 12}, {"id": 1, "name": "ODALIE MWANGI-REID", "names": ["ODALIE MWANGI-REID", "ODALIE"], "gender": "f", "first": 6, "spoke": 13}, {"id": 2, "name": "VINCENZO PALLADINO", "names": ["VINCENZO PALLADINO", "VINCENZO"], "gender": "m", "first": 7, "spoke": 9}, {"id": 3, "name": "TALLULAH BRIGHT", "names": ["TALLULAH BRIGHT", "TALLULAH"], "gender": "f", "first": 8, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. GREYHOUND DEPOT - WAITING ROOM - 2 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "Molded plastic seats.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A flickering departures board.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A janitor's cart abandoned beside a drinking fountain.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Four people share one row, each at a careful distance.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CORMAC BEAUFORT (40s, trench coat, newspaper folded to the crossword) taps a pen against his knee.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "ODALIE MWANGI-REID (30s, parka, a duffel between her feet) watches the doors.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "VINCENZO PALLADINO (50s, windbreaker, fingers laced over a paunch) stares at the ceiling.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "TALLULAH BRIGHT (20s, headphones, backpack on her lap) bites her thumbnail.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Nine letters. \"Careless about the future.\"", "name": "CORMAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Improvident.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "That's ten.", "name": "CORMAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Then I don't know.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Reckless.", "name": "VINCENZO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Eight.", "name": "CORMAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Then it's something else.", "name": "VINCENZO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Everything's something else.", "name": "TALLULAH", "speaker": 3, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Pardon?", "name": "CORMAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Nothing. Talking to myself.", "name": "TALLULAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Who's your bus?", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Three-forty to Toledo.", "name": "TALLULAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Same.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Really?", "name": "TALLULAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Don't sound so thrilled.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "That makes three of us.", "name": "CORMAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Four.", "name": "VINCENZO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Of course.", "name": "CORMAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Funny. Four strangers, same bus, same hour, none of us sleeping.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "People don't sleep before a journey.", "name": "VINCENZO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Or after a crime.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Silence.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "The board flickers.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "A vending machine hums.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "That's dark.", "name": "TALLULAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "That's the news.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "I read that a jewelry store on Fifth was hit last night. Eleven grand in diamonds.", "name": "CORMAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Eleven? I read forty.", "name": "VINCENZO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Papers exaggerate.", "name": "CORMAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Or they underplay.", "name": "VINCENZO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Which paper?", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "The Courier.", "name": "CORMAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "The Courier says seventeen.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "You read it?", "name": "CORMAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "I read everything. It's a habit.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Can I ask something?", "name": "TALLULAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Go on.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Why does everyone here have a bag bigger than they need?", "name": "TALLULAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Nobody answers.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Cormac refolds his paper.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Odalie nudges her duffel with her toe.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Vincenzo unlaces his fingers and rests his hands, palms up, on his knees.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Because travel is unpredictable.", "name": "VINCENZO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "And your bag is clanking.", "name": "TALLULAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Cutlery.", "name": "VINCENZO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Sure.", "name": "TALLULAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Five minutes to boarding. Let's all be sensible.", "name": "CORMAC", "speaker": 0, "ext": [], "paren": ["to the room, quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Sensible is my middle name.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "Mine's Marguerite.", "name": "TALLULAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "Mine's Giuseppe.", "name": "VINCENZO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "Mine's classified.", "name": "CORMAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "They look at one another and, one by one, begin to laugh, an exhausted, hollow, shared laugh that rolls down the row.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}]}