{"scene_id": "s01464", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01464.fountain", "heading": "INT. SUNKEN CATHEDRAL OF THE DRAGON-KINGS - NIGHT", "cast": [{"id": 0, "name": "TAMSIN BRIGHTWELL", "names": ["TAMSIN BRIGHTWELL", "TAMSIN"], "gender": "f", "first": 4, "spoke": 15}, {"id": 1, "name": "UDO HARTSHORN", "names": ["UDO HARTSHORN", "UDO"], "gender": "m", "first": 5, "spoke": 10}, {"id": 2, "name": "WARDEN", "names": ["WARDEN"], "gender": "?", "first": 25, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. SUNKEN CATHEDRAL OF THE DRAGON-KINGS - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A vaulted nave drowned to the knees in black water.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Columns of fossil bone rise into shadow.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Crystal lanterns drift in the air, spilling cold green light on scales as large as shields, set into the floor like tiles of an immense mosaic.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "TAMSIN BRIGHTWELL (30s, mercenary, chainmail and a ragged scarlet cloak, a notched longsword on her back) wades along the central aisle, torch sputtering.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Behind her, UDO HARTSHORN (60s, a priest's grey robe hitched to his thighs, a holy book wrapped in oilcloth) clutches the hem of his habit above the waterline.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Stay close.", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "I could hardly stray.", "name": "UDO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "The last priest strayed.", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "And?", "name": "UDO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "We didn't find him.", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Udo stops.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Looks down.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "A scale shifts under the water, patient as a sleeping thing turning over.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Lord, steady these old knees.", "name": "UDO", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Tamsin lifts the torch.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "At the aisle's end stands an altar, black basalt, its top a shallow bowl.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "In the bowl floats a single burning flame, small as a candle, steady in the still, cold air.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "That's the Ember.", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "It's smaller than the legends.", "name": "UDO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Everything is.", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She advances.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Udo follows.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "The water ripples.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Not from them.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Who comes to the Hall of Ash?", "name": "WARDEN", "speaker": 2, "ext": ["V.O."], "paren": ["a voice like gravel in a bell"], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Tamsin stops.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Draws her sword in one smooth rasp.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Udo clutches his book.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "We seek the Ember.", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": ["to the nave"], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Many have sought it.", "name": "WARDEN", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Do not provoke it.", "name": "UDO", "speaker": 1, "ext": [], "paren": ["low, to Tamsin"], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "I'm not provoking.", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "You carry iron. You carry prayer. Which will you offer?", "name": "WARDEN", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Neither.", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Tamsin.", "name": "UDO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "I offer a trade.", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "The lanterns stop drifting.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Speak.", "name": "WARDEN", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "My name for your fire. A true one. The first thing I was ever called.", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Udo gasps.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "She doesn't look at him.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Child, no. A name is a life.", "name": "UDO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "It's a word.", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Words are life.", "name": "WARDEN", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "The water stills completely.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "A great shape moves under the floor of scales, a ripple traveling the length of the nave, until the whole cathedral seems to breathe in.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Accepted.", "name": "WARDEN", "speaker": 2, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Tamsin lets her sword drop to her side.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Opens her mouth.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Whispers a single syllable that neither the audience nor Udo can hear.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "The flame leaps from the bowl, a tongue of white fire twisting through the air, and settles in her open palm.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "It does not burn.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "It purrs.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Udo falls to his knees in the water, tears in his eyes.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Tamsin stares at the flame, then at him.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "Say it back to me.", "name": "TAMSIN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "I cannot.", "name": "UDO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "Say what you heard.", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "I heard nothing.", "name": "UDO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Good.", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "The Warden's laughter rolls across the vault, and the water rises.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "Run!", "name": "UDO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "They run.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "Behind them the scales rise from the floor one by one, glittering, and the nave ceiling cracks.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "I'll miss it!", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": ["shouting over the thunder, to no one"], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "dialogue", "text": "You will not even remember.", "name": "WARDEN", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "The doors slam shut behind them.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "Silence.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "The torch hisses out, and in the new dark, a very faint voice, half sob, half laugh, whispers from the stairwell, \"What was my name?\"", "para": 14, "sent": 2, "present": [0, 1, 2]}]}