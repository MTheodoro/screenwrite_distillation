{"scene_id": "s01466", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01466.fountain", "heading": "INT. OFFICE TOWER ELEVATOR - NIGHT", "cast": [{"id": 0, "name": "JOCELYN MARBURY", "names": ["JOCELYN MARBURY", "JOCELYN"], "gender": "f", "first": 5, "spoke": 5}, {"id": 1, "name": "NADINE FOSSE", "names": ["NADINE FOSSE", "NADINE"], "gender": "?", "first": 6, "spoke": 4}, {"id": 2, "name": "TEODORO LAVIGNE", "names": ["TEODORO LAVIGNE", "TEODORO"], "gender": "m", "first": 7, "spoke": 3}, {"id": 3, "name": "VICTOR SANTAMARIA", "names": ["VICTOR SANTAMARIA", "VICTOR"], "gender": "m", "first": 8, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. OFFICE TOWER ELEVATOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Brushed steel.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A cracked mirror.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Floor numbers glow red.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Four people ride in uneasy silence.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "JOCELYN MARBURY (40s, trench coat, briefcase) stands near the panel.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "NADINE FOSSE (30s, scrubs under a puffer jacket) leans on the back rail.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "TEODORO LAVIGNE (50s, suit rumpled, tie pulled loose) stares at his shoes.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "VICTOR SANTAMARIA (20s, delivery uniform, a pizza box on his palm) taps the wall in time to a song only he hears.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "The elevator stops between floors 22 and 23.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Lights flicker.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Uh.", "name": "VICTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Don't.", "name": "JOCELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "I didn't press anything.", "name": "VICTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Nobody did.", "name": "NADINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Teodoro looks up.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Sweat beads at his temple.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "He loosens his tie further.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Somebody call security.", "name": "TEODORO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "No signal.", "name": "JOCELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "I have bars.", "name": "NADINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Then she's lying.", "name": "JOCELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Excuse me?", "name": "NADINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Easy.", "name": "TEODORO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Nadine holds up her phone.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Three bars.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "She dials.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Jocelyn lunges and swats it out of her hand; it skitters across the floor.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Victor steps on it.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Nobody breathes.", "para": 4, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "What is wrong with you?", "name": "NADINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "The fewer calls, the better.", "name": "JOCELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "For who?", "name": "VICTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Jocelyn doesn't answer.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Teodoro slumps against the wall, a hand to his chest.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "The lights die.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "In the dark, the sound of a zipper.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "A click.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "The lights return.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Jocelyn holds a small black pistol.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "It points at Teodoro.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Twenty-second floor, Mr. Lavigne. You were supposed to get off.", "name": "JOCELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "I was --", "name": "TEODORO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "The elevator lurches, drops six inches, and catches.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Victor yelps, the pizza box flipping into the air.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Nadine grabs his sleeve.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Jocelyn staggers, and Teodoro lunges, wrestling her wrist as the gun fires into the ceiling.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Plaster rains down.", "para": 7, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "The doors judder, grind, and slide open on a blank concrete wall, the shaft's inner face.", "para": 7, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Everyone freezes.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "A pigeon feather drifts through the gap.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}]}