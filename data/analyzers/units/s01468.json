{"scene_id": "s01468", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01468.fountain", "heading": "INT. MERIDIAN LOGISTICS - BREAK ROOM - DAY", "cast": [{"id": 0, "name": "BARTHOLOMEW GRIGG", "names": ["BARTHOLOMEW GRIGG", "BARTHOLOMEW"], "gender": "?", "first": 3, "spoke": 5}, {"id": 1, "name": "FARHAD ELYASI", "names": ["FARHAD ELYASI", "FARHAD"], "gender": "?", "first": 4, "spoke": 4}, {"id": 2, "name": "LEOPOLDO VANTERPOOL", "names": ["LEOPOLDO VANTERPOOL", "LEOPOLDO"], "gender": "m", "first": 5, "spoke": 5}, {"id": 3, "name": "ADEWALE BROOKMAN", "names": ["ADEWALE BROOKMAN", "ADEWALE"], "gender": "?", "first": 6, "spoke": 3}, {"id": 4, "name": "IT", "names": ["IT"], "gender": "?", "first": 6, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. MERIDIAN LOGISTICS - BREAK ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A kitchenette with a laminate table and a crooked sign: \"YOUR MOTHER DOESN'T WORK HERE.\"", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A sheet cake sits on the table, half-eaten, the words \"CONGRATULATIONS\" down to \"CONGRATU.\"", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "BARTHOLOMEW GRIGG (50s, middle manager, tie knotted too tight) hovers near the cake.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "FARHAD ELYASI (30s, sales, phone in hand) scrolls.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "LEOPOLDO VANTERPOOL (40s, accounts, cardigan) refills his mug.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "ADEWALE BROOKMAN (30s, IT, lanyard heavy with badges) leans on the fridge.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "dialogue", "text": "So the cake is for Farhad.", "name": "BARTHOLOMEW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "It's for the quarter.", "name": "FARHAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "It's for the department.", "name": "LEOPOLDO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "It's for whoever's still here.", "name": "ADEWALE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "He gets the first slice.", "name": "BARTHOLOMEW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Who?", "name": "LEOPOLDO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "He does.", "name": "BARTHOLOMEW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "I already had one.", "name": "FARHAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Who's \"he\"?", "name": "LEOPOLDO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "He is Farhad. Obviously.", "name": "ADEWALE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Not \"he,\" Farhad. I meant Leopoldo.", "name": "BARTHOLOMEW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "I don't want cake.", "name": "LEOPOLDO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Then why is he holding a fork?", "name": "FARHAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Who?", "name": "LEOPOLDO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Please stop saying \"he.\"", "name": "ADEWALE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "I'll cut it myself.", "name": "BARTHOLOMEW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "He grabs the knife.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "It slips.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "The cake splits down the middle.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "\"CONGRATU\" becomes \"CON\" and \"GRATU.\"", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Perfect.", "name": "FARHAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}