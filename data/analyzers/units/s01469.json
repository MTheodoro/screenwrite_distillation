{"scene_id": "s01469", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01469.fountain", "heading": "EXT. SKI GONDOLA CABIN - DUSK", "cast": [{"id": 0, "name": "CALLUM DRAKE", "names": ["CALLUM DRAKE", "CALLUM"], "gender": "?", "first": 5, "spoke": 14}, {"id": 1, "name": "BRIGID HENNESSY-ABE", "names": ["BRIGID HENNESSY-ABE", "BRIGID"], "gender": "?", "first": 6, "spoke": 10}, {"id": 2, "name": "SANTIAGO OYELOWO", "names": ["SANTIAGO OYELOWO", "SANTIAGO"], "gender": "?", "first": 7, "spoke": 6}, {"id": 3, "name": "MAGDALENA VOSS", "names": ["MAGDALENA VOSS", "MAGDALENA"], "gender": "f", "first": 8, "spoke": 8}, {"id": 4, "name": "EMERSON LAROCHE", "names": ["EMERSON LAROCHE", "EMERSON"], "gender": "m", "first": 9, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SKI GONDOLA CABIN - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "A steel and glass cabin hangs motionless over a snowy chasm, tilting slightly in the wind.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Pines far below.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cable creaks.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Five people crowd the benches, breath fogging the windows.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CALLUM DRAKE (50s, patrol jacket) stands by the door.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "BRIGID HENNESSY-ABE (30s, snowboarder, goggles on forehead) kneels on the floor.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "SANTIAGO OYELOWO (40s, hotelier, fur-lined coat) sits, hands folded.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "MAGDALENA VOSS (60s, hiker, thermos on her knee) sips tea.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "EMERSON LAROCHE (20s, student, backpack on his lap) stares at the dark.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Rescue knows we're here. They said three hours.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "It's been four.", "name": "BRIGID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "They said three to start.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "And when do they finish?", "name": "SANTIAGO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "When they finish.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Tea?", "name": "MAGDALENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Please.", "name": "EMERSON", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "One cup. We share.", "name": "MAGDALENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "I'm not drinking from a stranger's thermos.", "name": "BRIGID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "I'm Magdalena. Now I'm not a stranger.", "name": "MAGDALENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Brigid.", "name": "BRIGID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Brigid. Drink.", "name": "MAGDALENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "The wind is picking up.", "name": "SANTIAGO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "It does that.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "It rocks the cabin.", "name": "SANTIAGO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "It's rated for ninety miles an hour.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "What's the wind now?", "name": "EMERSON", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Thirty.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "And the temperature?", "name": "BRIGID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Minus eight.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Minus eight with wind chill is minus fifteen, dear.", "name": "MAGDALENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Fine.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "How long before cold becomes dangerous?", "name": "SANTIAGO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "For five people in a closed cabin? Hours.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "How many hours?", "name": "EMERSON", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "More than we need.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "You're lying.", "name": "BRIGID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "I'm managing expectations.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "He's doing what he can.", "name": "MAGDALENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Who?", "name": "BRIGID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "The patrolman.", "name": "MAGDALENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "She meant Callum. Say Callum.", "name": "BRIGID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "I said \"he.\"", "name": "MAGDALENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "I know. It's unclear. He, he, he.", "name": "BRIGID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Can we not?", "name": "EMERSON", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "She's right though. We have two men, two women, and a kid.", "name": "SANTIAGO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "I'm twenty-two.", "name": "EMERSON", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "And a very tall kid.", "name": "SANTIAGO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Everyone, listen. We stay calm, we stay warm, we stay together.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "And if the cable snaps?", "name": "BRIGID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "It won't.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "If it does?", "name": "BRIGID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "Then we hold hands.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Nobody laughs.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "Nobody speaks.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "The cabin sways, creaks, settles.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "A snowflake lands on the glass and melts into a perfect bead.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}]}