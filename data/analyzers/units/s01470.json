{"scene_id": "s01470", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01470.fountain", "heading": "INT. MONASTERY BAKERY - DAWN", "cast": [{"id": 0, "name": "SERGEANT OKAFOR", "names": ["SERGEANT OKAFOR", "OKAFOR"], "gender": "?", "first": 2, "spoke": 1}, {"id": 1, "name": "CORPORAL LINDQVIST", "names": ["CORPORAL LINDQVIST", "LINDQVIST"], "gender": "?", "first": 3, "spoke": 1}, {"id": 2, "name": "PRIVATE BRANDT", "names": ["PRIVATE BRANDT", "BRANDT"], "gender": "?", "first": 4, "spoke": 1}, {"id": 3, "name": "FRATE ANSELMO", "names": ["FRATE ANSELMO", "ANSELMO"], "gender": "m", "first": 4, "spoke": 2}, {"id": 4, "name": "PRIVATE TAKAHASHI", "names": ["PRIVATE TAKAHASHI", "TAKAHASHI"], "gender": "?", "first": 4, "spoke": 1}, {"id": 5, "name": "^OKAFOR", "names": ["^OKAFOR"], "gender": "?", "first": 16, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. MONASTERY BAKERY - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Flour hangs in the air like smoke.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "SERGEANT OKAFOR (40s, broad, mud to the knees) leans on a brick oven, eating warm bread.", "para": 0, "sent": 1, "present": [0]}, {"u": 3, "kind": "action", "text": "CORPORAL LINDQVIST (20s, freckled, rifle slung) sniffs a loaf as if it might be a trick.", "para": 0, "sent": 2, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "PRIVATE BRANDT (19, all elbows) kneads dough badly beside FRATE ANSELMO (70s, floury monk with a patient face).", "para": 0, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 5, "kind": "action", "text": "PRIVATE TAKAHASHI (30s, wire glasses, radio on his back) sits on a flour sack, eyes closed.", "para": 0, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 6, "kind": "dialogue", "text": "Best thing I've eaten since Naples.", "name": "OKAFOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "dialogue", "text": "Don't get used to it, Sarge.", "name": "LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "Like this? Is this right?", "name": "BRANDT", "speaker": 2, "ext": [], "paren": ["to Anselmo"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Gently. Bread is not a enemy.", "name": "ANSELMO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Anselmo lifts his head.", "para": 1, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "The bells in the tower above have stopped swinging, yet something still hums in the beams.", "para": 1, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Okafor stops chewing, Lindqvist drops the loaf, and Brandt's hands freeze in the dough while Takahashi's eyes snap open and he tears the headset to his ear.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Dust sifts from the ceiling onto the oven and the bread and all five of them.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Tanks.", "name": "TAKAHASHI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Tanks.", "name": "ANSELMO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Down!", "name": "^OKAFOR", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "The wall bursts inward.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Okafor tackles Brandt behind the oven, Lindqvist hurls herself over the kneading table and drags Anselmo under it, and Takahashi rolls off the sack clutching the radio as loaves scatter across the stone floor like startled birds.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}