{"scene_id": "s01471", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01471.fountain", "heading": "INT. LIGHTHOUSE KEEPER'S KITCHEN - NIGHT", "cast": [{"id": 0, "name": "PEPPER", "names": ["PEPPER"], "gender": "?", "first": 5, "spoke": 19}, {"id": 1, "name": "ADEYEMI-HALL", "names": ["ADEYEMI-HALL"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "DEZ", "names": ["DEZ"], "gender": "m", "first": 10, "spoke": 15}, {"id": 3, "name": "CARVALHO", "names": ["CARVALHO"], "gender": "?", "first": 10, "spoke": 0}, {"id": 4, "name": "CAPTAIN OLUWASEUN BRANNIGAN", "names": ["BRANNIGAN", "CAPTAIN OLUWASEUN BRANNIGAN"], "gender": "m", "first": 46, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. LIGHTHOUSE KEEPER'S KITCHEN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A round room wrapped around a spiral stair.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A kettle sits on a coal stove.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A wall phone with a cord like a pigtail hangs by the door.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain hammers the little windows.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "PERPETUA \"PEPPER\" ADEYEMI-HALL (50s, oilskin coat, tired humor) is wrestling a very large frozen turkey into a very small oven.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "In you go. Nobody's judging.", "name": "PEPPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "The turkey does not go in.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She tries it sideways.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Wide-body. Fine. Everybody's built different.", "name": "PEPPER", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "DESMOND \"DEZ\" CARVALHO (30s, a nervous inspector in a suit that has never seen weather) stands dripping on the mat, holding a clipboard like a shield.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Ms. Adeyemi-Hall, I'm required to note that the lamp is, technically, off.", "name": "DEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "The lamp is resting.", "name": "PEPPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Ships rely on that lamp.", "name": "DEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Ships rely on a lot of things. They also rely on a roast.", "name": "PEPPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "There is a ship out there right now.", "name": "DEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "There's always a ship out there. Sit. Sit! You're making the room look nervous.", "name": "PEPPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Dez sits on a stool.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "It wobbles.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "He grips the table.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "I was told the Board of Maritime Safety had been in touch.", "name": "DEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "The Board of Maritime Safety sent me a calendar. January's a puffin.", "name": "PEPPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "She finally jams the turkey in and slams the oven door.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Victory.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "She dusts her hands.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Dez writes something down.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "What did you just write?", "name": "PEPPER", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "\"Turkey.\"", "name": "DEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Good. Underline it.", "name": "PEPPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "The wall phone RINGS.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Both of them look at it.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "It RINGS again.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Pepper does not move.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Aren't you going to...?", "name": "DEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "It's the same man every Thursday. He wants to know about the weather.", "name": "PEPPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "It's Thursday?", "name": "DEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "It's always Thursday somewhere. Answer it, if you're so keen.", "name": "PEPPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Dez picks up the receiver.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Holds it at arm's length.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "X", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Dez goes white.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "He holds the receiver out to Pepper.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "She doesn't take it.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "A ferry. There's a ferry.", "name": "DEZ", "speaker": 2, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Tell him the lamp is resting.", "name": "PEPPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "I will not tell him the lamp is resting!", "name": "DEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Hello? Is someone there? Is that the keeper?", "name": "BRANNIGAN", "speaker": 4, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Dez clamps the phone to his chest, panting.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Pepper sighs, as if he's asked her to move a sofa.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "She heaves herself up, sets the kettle aside, and takes the receiver.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Marguerite. Pepper. I'll have her lit in four minutes. Stand off to starboard and sing something.", "name": "PEPPER", "speaker": 0, "ext": [], "paren": ["into phone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "Four minutes? It's a thirty-minute climb.", "name": "BRANNIGAN", "speaker": 4, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "Not if you know the stairs.", "name": "PEPPER", "speaker": 0, "ext": [], "paren": ["into phone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "She hangs up.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "Walks to the spiral stair.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Dez follows, clipboard abandoned.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "You can't climb it in four minutes.", "name": "DEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "No.", "name": "PEPPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "She opens a panel beside the stair.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "Inside: a small brass lever and a rope.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "She hauls the lever.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "Far above, something grinds, then flares.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "A white sweep of light crosses the window and the kitchen goes bright, then dark, then bright.", "para": 12, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "Dez stares.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "dialogue", "text": "It was always automatic?", "name": "DEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "Since nineteen-eighty. I just like to see who turns up.", "name": "PEPPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "dialogue", "text": "Then why was it off?", "name": "DEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "dialogue", "text": "I switched it off at six. To see who'd notice.", "name": "PEPPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "action", "text": "She picks up the kettle again.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "Dez opens his mouth, closes it, and picks up his clipboard.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "action", "text": "The kitchen door BANGS open.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "action", "text": "A wet, enormous man in a ferry captain's cap fills the frame: CAPTAIN OLUWASEUN BRANNIGAN (60s, a tide-beaten face, furious), a handheld radio still crackling at his belt.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "action", "text": "Behind him, the storm.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "dialogue", "text": "Which of you turned my lighthouse off?", "name": "BRANNIGAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "action", "text": "Pepper points at Dez without looking.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "dialogue", "text": "Me?!", "name": "DEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 76, "kind": "dialogue", "text": "You? You're the one?", "name": "BRANNIGAN", "speaker": 4, "ext": [], "paren": ["to Dez, advancing"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 77, "kind": "dialogue", "text": "No! I'm the inspector!", "name": "DEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 78, "kind": "dialogue", "text": "Inspector of what?", "name": "BRANNIGAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 79, "kind": "dialogue", "text": "Turkey.", "name": "PEPPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 80, "kind": "action", "text": "Brannigan stops.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 81, "kind": "action", "text": "Smells the air.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 82, "kind": "action", "text": "Sniffs again.", "para": 17, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 83, "kind": "action", "text": "His face softens by degrees.", "para": 17, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 84, "kind": "dialogue", "text": "Is that sage?", "name": "BRANNIGAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 85, "kind": "dialogue", "text": "Take your coat off, Seun. The phone can have your voice. There's enough for everyone.", "name": "PEPPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 86, "kind": "dialogue", "text": "How much enough?", "name": "BRANNIGAN", "speaker": 4, "ext": [], "paren": ["still suspicious"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 87, "kind": "dialogue", "text": "Wide-body enough.", "name": "PEPPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 88, "kind": "action", "text": "Brannigan peels off his dripping coat.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 89, "kind": "action", "text": "Dez, bewildered, makes room on the stool.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 90, "kind": "action", "text": "It wobbles.", "para": 18, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 91, "kind": "action", "text": "All three men and the turkey settle in as the lighthouse beam wheels slowly past the window, over and over.", "para": 18, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 92, "kind": "dialogue", "text": "Underline \"turkey.\"", "name": "DEZ", "speaker": 2, "ext": [], "paren": ["quietly, to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 93, "kind": "action", "text": "He does.", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4]}]}