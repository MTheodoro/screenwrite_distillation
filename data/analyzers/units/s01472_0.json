{"scene_id": "s01472_0", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01472.fountain", "heading": "INT. SALT MINE - ELEVATOR CAGE - NIGHT", "cast": [{"id": 0, "name": "KITE", "names": ["KITE"], "gender": "?", "first": 19, "spoke": 2}, {"id": 1, "name": "TOBIAS", "names": ["TOBIAS"], "gender": "m", "first": 15, "spoke": 2}, {"id": 2, "name": "RAFF", "names": ["RAFF"], "gender": "m", "first": 7, "spoke": 5}, {"id": 3, "name": "MOUSE", "names": ["MOUSE"], "gender": "f", "first": 11, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. SALT MINE - ELEVATOR CAGE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Two hundred meters down.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "White walls.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dripping brine.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Four figures in grey coveralls crowd the cage.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "Hard hats.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "Headlamps.", "para": 1, "sent": 2, "present": []}, {"u": 7, "kind": "action", "text": "RAFFERTY \"RAFF\" OYELARAN-STEIN.", "para": 2, "sent": 0, "present": [2]}, {"u": 8, "kind": "action", "text": "Late 40s.", "para": 2, "sent": 1, "present": [2]}, {"u": 9, "kind": "action", "text": "Planner.", "para": 2, "sent": 2, "present": [2]}, {"u": 10, "kind": "action", "text": "Calm hands.", "para": 2, "sent": 3, "present": [2]}, {"u": 11, "kind": "action", "text": "MIRELA \"MOUSE\" DRAGOMIR.", "para": 3, "sent": 0, "present": [2, 3]}, {"u": 12, "kind": "action", "text": "20s.", "para": 3, "sent": 1, "present": [2, 3]}, {"u": 13, "kind": "action", "text": "Safecracker.", "para": 3, "sent": 2, "present": [2, 3]}, {"u": 14, "kind": "action", "text": "Chews her lip.", "para": 3, "sent": 3, "present": [2, 3]}, {"u": 15, "kind": "action", "text": "TOBIAS VANTERPOOL.", "para": 4, "sent": 0, "present": [1, 2, 3]}, {"u": 16, "kind": "action", "text": "60s.", "para": 4, "sent": 1, "present": [1, 2, 3]}, {"u": 17, "kind": "action", "text": "Retired mine foreman.", "para": 4, "sent": 2, "present": [1, 2, 3]}, {"u": 18, "kind": "action", "text": "Knows every shaft.", "para": 4, "sent": 3, "present": [1, 2, 3]}, {"u": 19, "kind": "action", "text": "KENJI \"KITE\" NAKAGAWA-REYES.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "30s.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Driver.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Jittery.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "The cage shudders.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Stops.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "We stopped.", "name": "KITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "We're there.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Lamps off. On my count.", "name": "RAFF", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "They click off.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Black.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "A drip.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "A breath.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Mouse. Where's the vault?", "name": "RAFF", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Four hundred meters east. Behind a wall of rock salt.", "name": "MOUSE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Tobias?", "name": "RAFF", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Old drift. Sealed in sixty-four. I know the way, Raff.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Kite, you stay with the cage.", "name": "RAFF", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Why do I always stay with the cage?", "name": "KITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Because the cage is how we leave.", "name": "RAFF", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Lamps on.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "They step out.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Salt crunches underfoot.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}]}