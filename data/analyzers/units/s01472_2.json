{"scene_id": "s01472_2", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01472.fountain", "heading": "INT. SALT MINE - SEALED DRIFT - LATER", "cast": [{"id": 0, "name": "TOBIAS", "names": ["TOBIAS"], "gender": "m", "first": 3, "spoke": 3}, {"id": 1, "name": "MOUSE", "names": ["MOUSE"], "gender": "f", "first": 6, "spoke": 4}, {"id": 2, "name": "RAFF", "names": ["RAFF"], "gender": "m", "first": 6, "spoke": 8}, {"id": 3, "name": "KITE", "names": ["KITE"], "gender": "?", "first": 15, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. SALT MINE - SEALED DRIFT - LATER", "present": []}, {"u": 1, "kind": "action", "text": "A wall of grey-white salt.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A rusted door half buried in it.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Tobias taps the wall.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "Listens.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "dialogue", "text": "Here.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 6, "kind": "dialogue", "text": "Raff, I need ten minutes.", "name": "MOUSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "You have six.", "name": "RAFF", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Raff.", "name": "MOUSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Mouse. Six.", "name": "RAFF", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "She kneels.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Unrolls a canvas kit.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Brushes, a stethoscope, a tiny hammer.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Tobias takes a position at the corner.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Raff paces.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Kite. Status.", "name": "RAFF", "speaker": 2, "ext": ["CONT'D"], "paren": ["into radio, low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Cage is fine. I'm fine. Everyone's fine. Why do you ask?", "name": "KITE", "speaker": 3, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Stay on the line.", "name": "RAFF", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Raff, there's a light coming down the main shaft.", "name": "KITE", "speaker": 3, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Raff stops pacing.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Tobias turns.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "How far?", "name": "RAFF", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Forty meters, maybe. The second cage is dropping.", "name": "KITE", "speaker": 3, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Haul run. It's early.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Mouse!", "name": "RAFF", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Four minutes!", "name": "MOUSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "You have two!", "name": "RAFF", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Mouse bites down on the stethoscope.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Turns a dial by feel.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Click.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Click.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Click-CLUNK.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "The door sags inward.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Behind it: a steel cabinet, a stack of velvet cases.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Open!", "name": "MOUSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Tobias and Raff haul the door wide.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Mouse scoops cases into a duffel.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Tobias checks the corridor.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Raff! Alarm!", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "An alarm BLARES down the drift.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Strobes pulse white on the salt.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Run!", "name": "RAFF", "speaker": 2, "ext": [], "paren": ["grabbing the duffel"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "They scatter down the drift, lamps swinging wildly, salt dust boiling up behind them.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}]}