{"scene_id": "s01474", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01474.fountain", "heading": "INT. NIGHT-SHIFT CAR WASH - 3 A.M.", "cast": [{"id": 0, "name": "NADIA SZABO", "names": ["NADIA SZABO", "NADIA"], "gender": "?", "first": 7, "spoke": 6}, {"id": 1, "name": "DOM", "names": ["DOM"], "gender": "?", "first": 8, "spoke": 5}, {"id": 2, "name": "ACHEBE", "names": ["ACHEBE"], "gender": "?", "first": 8, "spoke": 0}, {"id": 3, "name": "OLD HARLAN PRICE", "names": ["OLD HARLAN PRICE", "HARLAN"], "gender": "?", "first": 9, "spoke": 5}, {"id": 4, "name": "LUIS FERRO", "names": ["LUIS FERRO", "LUIS"], "gender": "m", "first": 10, "spoke": 6}, {"id": 5, "name": "VANCE", "names": ["VANCE"], "gender": "?", "first": 37, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT-SHIFT CAR WASH - 3 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent lights.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wet concrete.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A conveyor hums, empty.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Four people around a break-room table inside a glass booth.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "Vending coffee.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "Donuts.", "para": 1, "sent": 2, "present": []}, {"u": 7, "kind": "action", "text": "NADIA SZABO (30s, manager) counts the till.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "DOMINIC \"DOM\" ACHEBE (20s) eats.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "OLD HARLAN PRICE (70s) does a crossword.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "LUIS FERRO (50s) stirs his coffee for too long.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Seven letters, \"cheerful and quiet.\"", "name": "DOM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Serene.", "name": "HARLAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "That's six.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Nobody's cheerful at three in the morning.", "name": "LUIS", "speaker": 4, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "I'm cheerful.", "name": "DOM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "You're asleep.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Placid. Seven.", "name": "HARLAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "He's eating.", "name": "DOM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Both.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Quiet.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "The conveyor hums.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Headlights sweep the glass.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "A black sedan rolls to the entrance and stops.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Nobody gets out.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Closed sign's on.", "name": "NADIA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Sign's always on.", "name": "HARLAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Nobody go out.", "name": "LUIS", "speaker": 4, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Why not?", "name": "DOM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "That's the third night. Same car. Same plate. Look at the plate.", "name": "LUIS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "They look.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Dom stops chewing.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Who parks and waits at a car wash?", "name": "HARLAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "A man who's already clean.", "name": "LUIS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Luis...", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "The sedan's door opens.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "A polished shoe touches wet concrete.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "MR. VANCE (50s, camel coat, pleasant face) steps out and walks toward the booth, hands visible, smiling.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "He asked me last night where the cameras are.", "name": "LUIS", "speaker": 4, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "And you said?", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Nothing.", "name": "LUIS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Good.", "name": "HARLAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Then why's he coming to ask again?", "name": "DOM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Nadia's hand slides under the counter and closes on something cold.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}