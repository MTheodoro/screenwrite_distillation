{"scene_id": "s01477", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01477.fountain", "heading": "EXT. SALT FLAT - HIGH NOON", "cast": [{"id": 0, "name": "LUCKY", "names": ["LUCKY"], "gender": "?", "first": 6, "spoke": 8}, {"id": 1, "name": "TREVINO-ASH", "names": ["TREVINO-ASH"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "BARNABY CROW", "names": ["BARNABY CROW", "BARNABY"], "gender": "?", "first": 8, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SALT FLAT - HIGH NOON", "present": []}, {"u": 1, "kind": "action", "text": "White.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Flat.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Shimmering to the horizon.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A dead windmill.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A single iron water trough, bone dry.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "LUCINDA \"LUCKY\" TREVINO-ASH (30s, sun-cracked lips, black duster, a rifle across her saddle) sits a paint mare in the glare.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Across the flat, a man on foot.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "BARNABY CROW (60s, one blind eye, a gold tooth, no horse).", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "He drags a coffin lid behind him on a rope.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Lucky waits.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He keeps coming.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "That's far enough.", "name": "LUCKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Is it?", "name": "BARNABY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "He keeps coming.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Barnaby.", "name": "LUCKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Lucky.", "name": "BARNABY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Where's your horse?", "name": "LUCKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Ate it.", "name": "BARNABY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "You didn't.", "name": "LUCKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Wanted to.", "name": "BARNABY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "He stops ten paces off.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Sits on the coffin lid.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Wipes his face.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Got any water?", "name": "BARNABY", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "She tosses him a canteen.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "He drinks.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Pours some on his head.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Hands it back, empty.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "That was my last.", "name": "LUCKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "I know.", "name": "BARNABY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Her rifle comes up.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "He doesn't flinch.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Before you shoot me. Look in the lid.", "name": "BARNABY", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Why?", "name": "LUCKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Humor an old man.", "name": "BARNABY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "She keeps the rifle on him.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Leans out of the saddle and flips the lid with her boot.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Underneath: a bundle of bank notes, wet and rotting, tied with twine.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "That the Dunmore money?", "name": "LUCKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "What's left. The salt got in.", "name": "BARNABY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Lucky laughs.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "A short, cracked bark.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Barnaby laughs, too.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "They are both still laughing when the rifle goes off.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "The shot echoes.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Barnaby looks down.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Nothing.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "The bullet has kicked up salt a foot from his boot.", "para": 10, "sent": 3, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "That's for the horse.", "name": "LUCKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Fair.", "name": "BARNABY", "speaker": 2, "ext": [], "paren": ["wheezing"], "dual": false, "present": [0, 1, 2]}]}