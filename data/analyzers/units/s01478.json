{"scene_id": "s01478", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01478.fountain", "heading": "INT. DEEP-SEA SURVEY HABITAT \"KELP-9\" - COMMON ROOM - NIGHT", "cast": [{"id": 0, "name": "CAPTAIN HENRIETTA VOSS-LIANG", "names": ["CAPTAIN HENRIETTA VOSS-LIANG", "VOSS-LIANG"], "gender": "?", "first": 8, "spoke": 6}, {"id": 1, "name": "TAMSIN ODUYA", "names": ["TAMSIN ODUYA", "TAMSIN"], "gender": "f", "first": 9, "spoke": 7}, {"id": 2, "name": "ENGINEER PIOTR NAKAMURA-BELL", "names": ["ENGINEER PIOTR NAKAMURA-BELL", "PIOTR"], "gender": "m", "first": 10, "spoke": 5}, {"id": 3, "name": "TOPSIDE", "names": ["TOPSIDE"], "gender": "?", "first": 23, "spoke": 2}, {"id": 4, "name": "GROAN", "names": ["GROAN"], "gender": "?", "first": 17, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. DEEP-SEA SURVEY HABITAT \"KELP-9\" - COMMON ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped steel room with a single round viewport.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Beyond it, blackness and drifting silt.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Bunks along one wall.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A galley table bolted to the floor.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A wall speaker with a dented grille.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "Three crew members sit at the table playing cards.", "para": 1, "sent": 0, "present": []}, {"u": 7, "kind": "action", "text": "A fourth voice lives in the speaker.", "para": 1, "sent": 1, "present": []}, {"u": 8, "kind": "action", "text": "CAPTAIN HENRIETTA VOSS-LIANG (50s, gray braid, reading glasses on a cord) deals.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "DR. TAMSIN ODUYA (30s, tall, a bandaged hand) arranges her cards slowly.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "ENGINEER PIOTR NAKAMURA-BELL (40s, heavy, oil under his nails) eats from a foil pouch with a plastic spoon.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Your bid, Doctor.", "name": "VOSS-LIANG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Pass.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "She always passes.", "name": "PIOTR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I always win.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "When?", "name": "PIOTR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Eventually.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "A low, slow GROAN passes through the hull.", "para": 3, "sent": 0, "present": [0, 1, 2, 4]}, {"u": 18, "kind": "action", "text": "Nobody looks up.", "para": 3, "sent": 1, "present": [0, 1, 2, 4]}, {"u": 19, "kind": "dialogue", "text": "That's the third time today.", "name": "VOSS-LIANG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 20, "kind": "dialogue", "text": "It's the sediment settling. Pressure shifts. It's nothing.", "name": "PIOTR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 21, "kind": "dialogue", "text": "Nothing makes a very specific sound.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 22, "kind": "action", "text": "The speaker crackles.", "para": 4, "sent": 0, "present": [0, 1, 2, 4]}, {"u": 23, "kind": "dialogue", "text": "Kelp-9, Topside. Weather's picking up. We'll hold the surface buoy another twelve hours, then we're sending the lift. Over.", "name": "TOPSIDE", "speaker": 3, "ext": ["V.O."], "paren": ["over speaker"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Copy, Topside. All quiet down here. Out.", "name": "VOSS-LIANG", "speaker": 0, "ext": [], "paren": ["toward speaker"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "She sets her cards face-down.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "That's the longest any of us has gone without an alarm.", "name": "VOSS-LIANG", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Don't say that.", "name": "PIOTR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Why not?", "name": "VOSS-LIANG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Because the habitat listens.", "name": "PIOTR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "It does not listen. It's a tin can with a sandwich in it.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "The GROAN comes again, closer.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "A pipe overhead ticks.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "The silt outside the viewport swirls, as if something huge has moved behind it.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Tamsin stands slowly.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Walks to the viewport.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Presses her bandaged hand to the glass.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Captain.", "name": "TAMSIN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Doctor?", "name": "VOSS-LIANG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "The silt isn't settling.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Piotr drops his spoon.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "He goes to the viewport.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Voss-Liang is already there.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "All three stare out at a patch of black that is slightly blacker than the rest, and that is rising.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Kelp-9, Topside, we're showing a seismic spike. Repeat, seismic spike. Get out of there. Get out of there now.", "name": "TOPSIDE", "speaker": 3, "ext": ["V.O."], "paren": ["over speaker, distorted"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "The lights flicker.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "The hull begins to SHRIEK.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}]}