{"scene_id": "s01479", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01479.fountain", "heading": "INT. ROLLER DERBY RINK - BASEMENT OF A BOWLING ALLEY - NIGHT", "cast": [{"id": 0, "name": "PRISS", "names": ["PRISS"], "gender": "?", "first": 5, "spoke": 8}, {"id": 1, "name": "MONTEIRO", "names": ["MONTEIRO"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "COACH ARLETTE BEAUMONT-WEI", "names": ["COACH ARLETTE BEAUMONT-WEI", "ARLETTE"], "gender": "f", "first": 6, "spoke": 13}, {"id": 3, "name": "RESERVE SKATER", "names": ["RESERVE SKATER"], "gender": "f", "first": 26, "spoke": 5}, {"id": 4, "name": "ODALYS", "names": ["ODALYS"], "gender": "f", "first": 37, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROLLER DERBY RINK - BASEMENT OF A BOWLING ALLEY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cracked maple floor.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Bleachers made of old pews.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A hand-painted banner reads: THE DOCKSIDE DAMES.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Two skaters sit on a bench, lacing up.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "The younger, PRISCILLA \"PRISS\" MONTEIRO (20s, shaved head, neon wrist guards), bounces a knee.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "The older, COACH ARLETTE BEAUMONT-WEI (50s, clipboard, whistle, a voice like gravel), stands over her.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Eyes up. Head up. Heart up.", "name": "ARLETTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Which one first?", "name": "PRISS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "All of them.", "name": "ARLETTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "She blows the whistle.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "It echoes off the pews.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Okay. Okay. Okay.", "name": "PRISS", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Anybody else? Anybody?", "name": "ARLETTE", "speaker": 2, "ext": [], "paren": ["to the empty room"], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "A single pew creaks.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Where's the rest of the team?", "name": "ARLETTE", "speaker": 2, "ext": ["CONT'D"], "paren": ["louder, to Priss"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Flu. Four of them. And Dana's cousin's wedding.", "name": "PRISS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "We have a bout in twenty minutes.", "name": "ARLETTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I know.", "name": "PRISS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "With three skaters.", "name": "ARLETTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Two. You don't skate.", "name": "PRISS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Arlette glares.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Priss shrinks.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The basement door bangs.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "A stranger descends the steps: a woman in a long coat and rental skates, rolling unsteadily down the aisle.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "RESERVE SKATER (30s, athletic, bleached ponytail, a duffel on her shoulder).", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "She stops at the rail.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Is this the Dockside Dames?", "name": "RESERVE SKATER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Who's asking?", "name": "ARLETTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Somebody who played four years for the Harbor Hellcats.", "name": "RESERVE SKATER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "She's a Hellcat.", "name": "PRISS", "speaker": 0, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "I can hear.", "name": "ARLETTE", "speaker": 2, "ext": [], "paren": ["to Priss"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "I got cut. Long story. I need a team.", "name": "RESERVE SKATER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "We need a body.", "name": "ARLETTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "I'm more than a body.", "name": "RESERVE SKATER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "What's your name?", "name": "ARLETTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Odalys. Odalys Ferreira.", "name": "RESERVE SKATER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Welcome, Odalys.", "name": "ARLETTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Odalys drops her duffel and sits.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Priss scoots over.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "You're really a Hellcat?", "name": "PRISS", "speaker": 0, "ext": [], "paren": ["to Odalys"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Was.", "name": "ODALYS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Three skaters. Nobody's tired. Nobody's hurt. Nobody's quitting.", "name": "ARLETTE", "speaker": 2, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Nobody's even stretched.", "name": "PRISS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Stretch on the track.", "name": "ARLETTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "She blows the whistle.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "The three of them stand, wobble, roll toward the rink.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Odalys glances back at the empty pews and mutters.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Please let somebody come.", "name": "ODALYS", "speaker": 4, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3, 4]}]}