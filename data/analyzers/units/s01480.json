{"scene_id": "s01480", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01480.fountain", "heading": "INT. HOT-AIR BALLOON BASKET - DAWN", "cast": [{"id": 0, "name": "SOLOMON ABARA-KITT", "names": ["SOLOMON ABARA-KITT", "SOLOMON"], "gender": "m", "first": 3, "spoke": 7}, {"id": 1, "name": "ROZ", "names": ["ROZ"], "gender": "f", "first": 4, "spoke": 7}, {"id": 2, "name": "PETROV", "names": ["PETROV"], "gender": "?", "first": 4, "spoke": 0}, {"id": 3, "name": "PILOT", "names": ["PILOT"], "gender": "?", "first": 22, "spoke": 1}, {"id": 4, "name": "GUNNAR ECKHARDT", "names": ["GUNNAR ECKHARDT", "GUNNAR"], "gender": "?", "first": 25, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOT-AIR BALLOON BASKET - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A wicker basket rising slowly over a patchwork of fog and green hills.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A propane burner roars, then hushes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "SOLOMON ABARA-KITT (30s, sunburned, nervous hands) holds a small velvet box behind his back.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "ROSALIND \"ROZ\" PETROV (30s, wind-whipped hair, an easy grin) leans over the edge, taking photos with her phone.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "Look at that. You can see the whole valley.", "name": "ROZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "I can see it.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "You're not looking.", "name": "ROZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "I'm looking at you.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "She turns.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Sees his face.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Sees the way his hand is behind him.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Sol. What's in your hand?", "name": "ROZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Nothing.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Sol.", "name": "ROZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "It's a, um. It's a sandwich.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "It is not a sandwich.", "name": "ROZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "He brings out the box.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Opens it.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "A ring catches the first sun.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Roz. Will you...", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "A voice from above them, cheerful, heavily accented.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Good morning, lovebirds!", "name": "PILOT", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Solomon freezes.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Roz looks up.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "At the top of the basket's rigging, clinging to a rope with one hand and holding a thermos with the other, hangs the PILOT, GUNNAR ECKHARDT (60s, wild white beard, goggles pushed up on a leather cap).", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Do not mind me. I am only checking the knots.", "name": "GUNNAR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Gunnar. Please.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": ["through his teeth"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Yes, yes, I am very quiet.", "name": "GUNNAR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "He climbs down out of sight.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Roz laughs until she cries.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Solomon, mortified, looks at the ring.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Ask me again.", "name": "ROZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Roz Petrov. Will you marry me?", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Yes.", "name": "ROZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "From somewhere above, faintly:", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Congratulations!", "name": "GUNNAR", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}