{"scene_id": "s01482_0", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01482.fountain", "heading": "EXT. SNOWFIELD BELOW A CRASHED CARGO PLANE - DAY", "cast": [{"id": 0, "name": "MARISOL ARROYO-LINDGREN", "names": ["MARISOL ARROYO-LINDGREN", "MARISOL"], "gender": "f", "first": 4, "spoke": 10}, {"id": 1, "name": "ANTON BELLWEATHER-ODUYA", "names": ["ANTON BELLWEATHER-ODUYA", "ANTON"], "gender": "m", "first": 5, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SNOWFIELD BELOW A CRASHED CARGO PLANE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A white slope.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A twisted tail section jutting from the drift.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wind drags snow in long ropes.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MARISOL ARROYO-LINDGREN (40s, parka, bleeding scalp under a knit cap) kneels beside the wreck, digging with a tin plate.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "ANTON BELLWEATHER-ODUYA (50s, lanky, one arm tucked inside his jacket) stands over her, stamping his feet.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "She digs.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He watches.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Anything?", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Not yet.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He paces.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She keeps digging.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "The plate scrapes on metal.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She stops.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "There's a hatch.", "name": "MARISOL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Open it.", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She grips the edge.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Pulls.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "It doesn't give.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He kneels beside her with his good hand.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "They pull together.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "It gives a quarter inch and stops.", "para": 4, "sent": 5, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "It's frozen.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Of course it's frozen. Everything's frozen.", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She sits back on her heels.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "He stares at the hatch.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Wind howls.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Don't panic. Don't panic. Don't panic.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "I'm not panicking.", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "I wasn't talking to you.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "He looks at her.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "She keeps her eyes on the hatch.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "He takes off his glove with his teeth.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Puts a bare palm on the metal.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Holds it there.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Winces.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Pulls away.", "para": 7, "sent": 4, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "It's warm underneath.", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "What?", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Something's warm. Something's running in there.", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "She puts her hand on it.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Holds it.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Her eyes widen.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "A generator.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Or an engine.", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "She slams the plate against the hatch handle.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Once.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Twice.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "A crack of ice.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "On the third blow the handle snaps loose and the hatch swings up on a gust of warm, oily air.", "para": 9, "sent": 4, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "They both recoil.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "Then they lean in together and stare down a ladder into a hold lit by a single red emergency lamp.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Thank God.", "name": "ANTON", "speaker": 1, "ext": ["CONT'D"], "paren": ["to himself"], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "Don't thank anyone yet.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": ["to Anton"], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "She swings her legs over the edge.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "He grabs her sleeve.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "Wait. We should tie off.", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "With what?", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "He looks around at the white.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "Nothing.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "She pulls free.", "para": 12, "sent": 2, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "We're going down!", "name": "MARISOL", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the whole slope, as if calling the wind to witness"], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "She goes.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "He hesitates.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "Then follows, sliding the hatch shut over his head.", "para": 13, "sent": 2, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "The snow closes in behind them.", "para": 13, "sent": 3, "present": [0, 1]}]}