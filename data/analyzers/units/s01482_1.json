{"scene_id": "s01482_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01482.fountain", "heading": "INT. CARGO HOLD - CONTINUOUS", "cast": [{"id": 0, "name": "ANTON", "names": ["ANTON"], "gender": "m", "first": 9, "spoke": 7}, {"id": 1, "name": "MARISOL", "names": ["MARISOL"], "gender": "f", "first": 10, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. CARGO HOLD - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Crates strapped to the floor.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A red lamp swinging gently.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The hold smells of diesel and spilled coffee.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "She reaches the bottom first.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "He lands heavily, groans, and clutches his arm.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "She hands him a flashlight from her belt.", "para": 2, "sent": 0, "present": []}, {"u": 7, "kind": "action", "text": "He plays the beam across the crates.", "para": 2, "sent": 1, "present": []}, {"u": 8, "kind": "action", "text": "Stenciled words: MEDICAL SUPPLIES.", "para": 2, "sent": 2, "present": []}, {"u": 9, "kind": "dialogue", "text": "Medical.", "name": "ANTON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 10, "kind": "dialogue", "text": "That's useful.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Is it?", "name": "ANTON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Bandages. Antibiotics. Whatever's in there for your arm.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He looks at his arm.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He's been avoiding it.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "He pulls out the sleeve and sees the dark soak in the fabric.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "It's worse than I said.", "name": "ANTON", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "I know.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "You knew?", "name": "ANTON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "You've been holding it like a baby bird for three hours.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "He laughs, once, and sits down on a crate.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She pries the lid off the next one with the tin plate.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "It's full of foil blankets.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She wraps one around his shoulders.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Sits beside him with another.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "They don't speak.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "The red lamp swings.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Marisol.", "name": "ANTON", "speaker": 0, "ext": [], "paren": ["finally"], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Mm.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "If it comes to it. If one of us has to walk out.", "name": "ANTON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Don't.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "If it comes to it, it should be you.", "name": "ANTON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "She doesn't answer.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "He turns his head, looking for her face in the red light.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "She is staring at the hatch, jaw set, hands wrapped tight in the blanket.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "It won't come to it.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": ["low, to the hatch"], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "The wind outside rises, a long hollow note against the hull.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "She does not look away from the ladder.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "He tucks the blanket tighter and does the same.", "para": 8, "sent": 2, "present": [0, 1]}]}