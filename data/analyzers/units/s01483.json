{"scene_id": "s01483", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01483.fountain", "heading": "EXT. MANGROVE SWAMP - HIDDEN OXBOW LAGOON - DAWN", "cast": [{"id": 0, "name": "DESTA ALEMAYEHU-VOSS", "names": ["DESTA ALEMAYEHU-VOSS", "DESTA"], "gender": "?", "first": 5, "spoke": 8}, {"id": 1, "name": "KIPP LOUGHRAN", "names": ["KIPP LOUGHRAN", "KIPP"], "gender": "?", "first": 6, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "EXT. MANGROVE SWAMP - HIDDEN OXBOW LAGOON - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Mist on black water.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Tangled roots like the knuckles of drowned giants.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A kingfisher stitches blue over the surface.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A dugout canoe drifts to the bank.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "DESTA ALEMAYEHU-VOSS (40s, cracked sunglasses, rope-burned palms, a satchel of dried fish) steps ashore.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Behind her, curled in the bow, KIPP LOUGHRAN (teen, thin, a bandaged ankle) hugs his knees.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Camp's through here.", "name": "DESTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You said that yesterday.", "name": "KIPP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Yesterday I was lying.", "name": "DESTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She hauls the canoe up the bank.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Kipp limps after, peering around.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "An ironwood tree.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "A hammock.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "A fire pit with warm ash.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "A stack of dry kindling.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "A rusted pot, upturned, drying in the sun.", "para": 3, "sent": 4, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Somebody lives here.", "name": "KIPP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Somebody did.", "name": "DESTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Who?", "name": "KIPP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She sets down the satchel.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Takes out the fish and starts to lay them on a flat stone.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Let's eat.", "name": "DESTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Kipp stays by the tree.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "He runs a finger along the bark.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Fresh cuts.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "A tally: dozens of notches, in columns of five.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "These are new.", "name": "KIPP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Don't touch things.", "name": "DESTA", "speaker": 0, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "How long since the last notch?", "name": "KIPP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Eat.", "name": "DESTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "He turns.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Looks at her.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "She keeps her eyes on the fish.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "The kingfisher flies off.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "You've been here before.", "name": "KIPP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Once.", "name": "DESTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "When?", "name": "KIPP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "She lifts her head.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Her eyes go past him to the upturned pot, where a small boot, child-sized and rotted, sticks out from under the rim.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Kipp. Don't turn around.", "name": "DESTA", "speaker": 0, "ext": ["CONT'D"], "paren": ["very softly"], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "He turns around.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "He sees the boot.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "He sees the tally.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "He counts the columns, lips moving, and stops at the last notch, which is shallow and fresh.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "There's one for me.", "name": "KIPP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Desta says nothing.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "The mist closes over the water.", "para": 9, "sent": 1, "present": [0, 1]}]}