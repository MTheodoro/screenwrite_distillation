{"scene_id": "s01485", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01485.fountain", "heading": "INT. DEFUNCT CLOCK TOWER - GEAR ROOM - NIGHT", "cast": [{"id": 0, "name": "TOBIAS FENWICK-ADEYEMI", "names": ["TOBIAS FENWICK-ADEYEMI", "TOBIAS"], "gender": "m", "first": 4, "spoke": 8}, {"id": 1, "name": "MATT", "names": ["MATT"], "gender": "m", "first": 5, "spoke": 8}, {"id": 2, "name": "ROSALES-HEIDT", "names": ["ROSALES-HEIDT"], "gender": "?", "first": 5, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. DEFUNCT CLOCK TOWER - GEAR ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cathedral of brass wheels and iron pendulums, stilled for thirty years.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Moonlight comes through the huge translucent dial and paints the room the color of old ivory.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Two men in dark clothes work their way along a catwalk above the great gear train.", "para": 1, "sent": 0, "present": []}, {"u": 4, "kind": "action", "text": "TOBIAS FENWICK-ADEYEMI (50s, gray stubble, a coil of rope on his shoulder) goes first.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "action", "text": "MATTHEW \"MATT\" ROSALES-HEIDT (30s, gloves, a backpack heavy with tools) follows.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "They stop at a small iron door set into the wall behind the largest wheel.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "That's the vault.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "It's a clock.", "name": "MATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "The clockmaker's safe. Eighteen-ninety-two. Built into the movement itself.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "How do you know?", "name": "MATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Because I read the blueprints, Matt. All eleven hundred pages.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Matt swings his pack off.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Kneels in front of the door.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Tobias holds a flashlight over his shoulder.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Hold it steady.", "name": "MATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "I am holding it steady.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "You're breathing on it.", "name": "MATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "You're bending the beam.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Matt looks up.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Tobias lowers the light.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "A small, wary silence.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Then Matt starts work, the picks clicking softly in the lock.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Tobias, if he sees him standing in the light like that...", "name": "MATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Who?", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Him. The one you hired to watch the street.", "name": "MATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "I hired nobody.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Then who's in the street?", "name": "MATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Tobias goes still.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Matt goes still.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Each waits for the other to say it.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The lock gives.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The door swings open on a velvet-lined compartment.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Inside, a single pocket watch on a gold chain, ticking.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "It's running.", "name": "MATT", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "It shouldn't be.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Far below, with a groan like a waking giant, the great gear train begins to turn.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "He grabs the rail.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "He grabs the rope.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Neither of them can tell which of them is shouting.", "para": 7, "sent": 3, "present": [0, 1, 2]}]}