{"scene_id": "s01487", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01487.fountain", "heading": "INT. CHURCH-TURNED-SALOON, DRY CREEK - NIGHT", "cast": [{"id": 0, "name": "STRANGER", "names": ["STRANGER"], "gender": "m", "first": 7, "spoke": 5}, {"id": 1, "name": "SHERIFF DELPHINE ACHEBE-MARSH", "names": ["SHERIFF DELPHINE ACHEBE-MARSH", "DELPHINE"], "gender": "f", "first": 9, "spoke": 3}, {"id": 2, "name": "BIG JASPER TUCKERMAN", "names": ["BIG JASPER TUCKERMAN", "JASPER"], "gender": "m", "first": 9, "spoke": 2}, {"id": 3, "name": "DOC PRUDENCE OYELARAN", "names": ["DOC PRUDENCE OYELARAN"], "gender": "?", "first": 9, "spoke": 0}, {"id": 4, "name": "OZZIE", "names": ["OZZIE"], "gender": "?", "first": 9, "spoke": 1}, {"id": 5, "name": "BRIGHT-RAMIREZ", "names": ["BRIGHT-RAMIREZ"], "gender": "?", "first": 9, "spoke": 0}, {"id": 6, "name": "TOMASZ KOWALCZYK-LEE", "names": ["TOMASZ KOWALCZYK-LEE", "TOMASZ"], "gender": "m", "first": 10, "spoke": 3}, {"id": 7, "name": "DOC", "names": ["DOC"], "gender": "?", "first": 13, "spoke": 1}, {"id": 8, "name": "ORCUTT", "names": ["ORCUTT"], "gender": "?", "first": 35, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. CHURCH-TURNED-SALOON, DRY CREEK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A former chapel with its pews dragged into a poker circle.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A cracked stained-glass saint looks down on the cards with a beatific squint.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Lantern light.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Cigar haze.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Wind scouring the shutters.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "At the long communion table, five players sit hunched over a pot of coins, watches, and one wedding band.", "para": 1, "sent": 0, "present": []}, {"u": 7, "kind": "action", "text": "A STRANGER in a gray duster slouches in the darkest corner, hat low, a glass of milk untouched in front of him.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Nobody has looked directly at him in an hour.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "At the table: SHERIFF DELPHINE ACHEBE-MARSH (40s, weary, star pinned crooked), BIG JASPER TUCKERMAN (50s, a belly like a barrel, a laugh like a rockslide), DOC PRUDENCE OYELARAN (60s, spectacles, neat fingers), and the barkeep OSWALDO \"OZZIE\" BRIGHT-RAMIREZ (30s, apron, a shotgun under the bar), who deals.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "Last, young TOMASZ KOWALCZYK-LEE (19, new boots, trembling hat), sweating over his hand.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "Call.", "name": "JASPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "Raise.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "Fold.", "name": "DOC", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 14, "kind": "dialogue", "text": "Fold.", "name": "OZZIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 15, "kind": "dialogue", "text": "All in.", "name": "TOMASZ", "speaker": 6, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 16, "kind": "action", "text": "The room goes quiet.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 17, "kind": "action", "text": "Jasper looks at the boy.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 18, "kind": "action", "text": "Delphine looks at the boy.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 19, "kind": "action", "text": "Doc, with great delicacy, lifts her spectacles.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 20, "kind": "action", "text": "The Stranger stirs in his corner.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 21, "kind": "action", "text": "Rises.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 22, "kind": "action", "text": "Crosses the room.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 23, "kind": "action", "text": "The planks complain under his boots.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 24, "kind": "dialogue", "text": "Might I see his cards?", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 25, "kind": "dialogue", "text": "It's not a game for spectators.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 26, "kind": "dialogue", "text": "It isn't a game at all.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 27, "kind": "action", "text": "He stops beside Tomasz.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 28, "kind": "action", "text": "Lays a gloved hand on the boy's shoulder.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 29, "kind": "action", "text": "The boy flinches.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "action", "text": "The Stranger tilts his head and studies the saint in the window.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "dialogue", "text": "Son, what's your name?", "name": "STRANGER", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "dialogue", "text": "Tomasz.", "name": "TOMASZ", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "dialogue", "text": "Not Tom.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "dialogue", "text": "Not Tom.", "name": "TOMASZ", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "dialogue", "text": "Then Tomasz, I'll tell you mine. They call me Reverend Silas Orcutt.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 36, "kind": "action", "text": "A slow ripple passes over the table.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 37, "kind": "action", "text": "Jasper's laugh dies.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 38, "kind": "action", "text": "Doc's hand finds the edge of her bag.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 39, "kind": "action", "text": "Ozzie reaches under the bar.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 40, "kind": "action", "text": "Delphine, without lifting her eyes, thumbs the hammer of her pistol.", "para": 7, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 41, "kind": "dialogue", "text": "This was my church.", "name": "ORCUTT", "speaker": 8, "ext": [], "paren": ["smiling"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 42, "kind": "dialogue", "text": "It was a ruin.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 43, "kind": "dialogue", "text": "It was a ruin because of men at this table.", "name": "ORCUTT", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 44, "kind": "action", "text": "Tomasz slides his chair back.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 45, "kind": "action", "text": "Orcutt's grip tightens.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 46, "kind": "dialogue", "text": "Stay seated, son. I'm only here for the ones who burned it.", "name": "ORCUTT", "speaker": 8, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 47, "kind": "dialogue", "text": "Now, Reverend...", "name": "JASPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 48, "kind": "dialogue", "text": "Jasper Tuckerman. You carried the lamp oil.", "name": "ORCUTT", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 49, "kind": "action", "text": "Jasper surges from his chair.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 50, "kind": "action", "text": "Delphine fires.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 51, "kind": "action", "text": "Ozzie brings the shotgun up.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 52, "kind": "action", "text": "Doc dives behind a pew.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 53, "kind": "action", "text": "Tomasz, white as chalk, flattens himself under the table, the cards scattering around him like snow.", "para": 9, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 54, "kind": "action", "text": "The saint in the window, struck by a bullet, loses its head in a shower of colored glass.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}]}