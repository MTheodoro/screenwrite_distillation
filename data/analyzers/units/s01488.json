{"scene_id": "s01488", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01488.fountain", "heading": "INT. FUNERAL HOME KITCHEN - AFTERNOON", "cast": [{"id": 0, "name": "THEO", "names": ["THEO"], "gender": "m", "first": 24, "spoke": 4}, {"id": 1, "name": "AUNT BERNADETTE", "names": ["AUNT BERNADETTE"], "gender": "?", "first": 13, "spoke": 5}, {"id": 2, "name": "REUBEN", "names": ["REUBEN"], "gender": "m", "first": 9, "spoke": 6}, {"id": 3, "name": "HECTOR", "names": ["HECTOR"], "gender": "?", "first": 16, "spoke": 4}, {"id": 4, "name": "GRACIE", "names": ["GRACIE"], "gender": "f", "first": 5, "spoke": 13}, {"id": 5, "name": "LILIANA", "names": ["LILIANA"], "gender": "m", "first": 20, "spoke": 7}, {"id": 6, "name": "^REUBEN", "names": ["^REUBEN"], "gender": "?", "first": 68, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. FUNERAL HOME KITCHEN - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Linoleum.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A casserole dish in every available space.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A wall clock stopped at ten past four.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Six people share a room built for three.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "GRACELAND \"GRACIE\" OSEI-LINDQVIST.", "para": 2, "sent": 0, "present": [4]}, {"u": 6, "kind": "action", "text": "40s.", "para": 2, "sent": 1, "present": [4]}, {"u": 7, "kind": "action", "text": "Eldest daughter.", "para": 2, "sent": 2, "present": [4]}, {"u": 8, "kind": "action", "text": "Hands in the sink.", "para": 2, "sent": 3, "present": [4]}, {"u": 9, "kind": "action", "text": "REUBEN OSEI-LINDQVIST.", "para": 3, "sent": 0, "present": [2, 4]}, {"u": 10, "kind": "action", "text": "40s.", "para": 3, "sent": 1, "present": [2, 4]}, {"u": 11, "kind": "action", "text": "Her brother.", "para": 3, "sent": 2, "present": [2, 4]}, {"u": 12, "kind": "action", "text": "Leaning on the fridge.", "para": 3, "sent": 3, "present": [2, 4]}, {"u": 13, "kind": "action", "text": "AUNT BERNADETTE VASQUEZ.", "para": 4, "sent": 0, "present": [1, 2, 4]}, {"u": 14, "kind": "action", "text": "70s.", "para": 4, "sent": 1, "present": [1, 2, 4]}, {"u": 15, "kind": "action", "text": "Carries a tin of shortbread like a weapon.", "para": 4, "sent": 2, "present": [1, 2, 4]}, {"u": 16, "kind": "action", "text": "HECTOR PRZYBYLSKI.", "para": 5, "sent": 0, "present": [1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "30s.", "para": 5, "sent": 1, "present": [1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Gracie's husband.", "para": 5, "sent": 2, "present": [1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Holds a dish towel he never uses.", "para": 5, "sent": 3, "present": [1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "LILIANA OSEI.", "para": 6, "sent": 0, "present": [1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "16.", "para": 6, "sent": 1, "present": [1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Gracie's daughter.", "para": 6, "sent": 2, "present": [1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Hood up.", "para": 6, "sent": 3, "present": [1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "THEO FINCH.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "50s.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Funeral director.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Waiting.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Gracie scrubs a dish that is already clean.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Everything's arranged for three o'clock tomorrow.", "name": "THEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Nobody answers.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "If the family would like a few more minutes...", "name": "THEO", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "We've had four days.", "name": "AUNT BERNADETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "She sets the tin on the table.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Opens it.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Offers it to no one.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Is there coffee?", "name": "REUBEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "I'll make coffee.", "name": "HECTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "He puts down the towel.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Picks it up again.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Opens a cupboard.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Closes it.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Third shelf.", "name": "GRACIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "Right.", "name": "HECTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "He finds the can.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Fills the pot.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Liliana watches him.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "He's doing it wrong.", "name": "LILIANA", "speaker": 5, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "What?", "name": "HECTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "Nothing.", "name": "LILIANA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "Does anyone know where Dad kept the good suit?", "name": "REUBEN", "speaker": 2, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Silence.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "Bernadette studies the shortbread.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "Hector studies the coffee can.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "Gracie turns off the tap.", "para": 13, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "Reuben.", "name": "GRACIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "It's a simple question.", "name": "REUBEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "It's in the hall closet.", "name": "GRACIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "dialogue", "text": "Thank you.", "name": "REUBEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "Navy. Pressed. I did it Tuesday.", "name": "GRACIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "You didn't have to.", "name": "REUBEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "dialogue", "text": "Someone did.", "name": "GRACIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "dialogue", "text": "I would've.", "name": "REUBEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "dialogue", "text": "Would you?", "name": "GRACIE", "speaker": 4, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "The kettle ticks on the stove.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "Theo clears his throat, but does not speak.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "dialogue", "text": "Children.", "name": "AUNT BERNADETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "dialogue", "text": "I'm not fighting.", "name": "GRACIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "dialogue", "text": "I'm not fighting.", "name": "^REUBEN", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 69, "kind": "action", "text": "Hector pours coffee into six mugs.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 70, "kind": "action", "text": "Passes them around.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 71, "kind": "action", "text": "Everyone takes one.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 72, "kind": "action", "text": "No one drinks.", "para": 15, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 73, "kind": "dialogue", "text": "Mom. Can I go?", "name": "LILIANA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 74, "kind": "dialogue", "text": "Where?", "name": "GRACIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 75, "kind": "dialogue", "text": "Out.", "name": "LILIANA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 76, "kind": "dialogue", "text": "It's dark.", "name": "GRACIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 77, "kind": "dialogue", "text": "It's four-ten.", "name": "LILIANA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 78, "kind": "dialogue", "text": "The clock is wrong.", "name": "GRACIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 79, "kind": "dialogue", "text": "Everything in here is wrong.", "name": "LILIANA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 80, "kind": "action", "text": "She stands.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 81, "kind": "action", "text": "Hector reaches for her sleeve.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 82, "kind": "action", "text": "She shrugs him off.", "para": 16, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 83, "kind": "dialogue", "text": "Lil.", "name": "HECTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 84, "kind": "dialogue", "text": "Don't.", "name": "LILIANA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 85, "kind": "action", "text": "She goes.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 86, "kind": "action", "text": "The back door bangs.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 87, "kind": "action", "text": "Gracie wipes her hands on her apron very slowly, one finger at a time.", "para": 17, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 88, "kind": "dialogue", "text": "Mrs. Przybylski...", "name": "THEO", "speaker": 0, "ext": [], "paren": ["gently"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 89, "kind": "dialogue", "text": "It's Osei-Lindqvist. Still.", "name": "GRACIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 90, "kind": "dialogue", "text": "Of course. Forgive me.", "name": "THEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 91, "kind": "dialogue", "text": "Does anyone want to see him?", "name": "GRACIE", "speaker": 4, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 92, "kind": "action", "text": "The question lands like a dropped plate.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 93, "kind": "action", "text": "Reuben stares into his coffee.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 94, "kind": "action", "text": "Bernadette lowers the tin lid.", "para": 18, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 95, "kind": "action", "text": "Hector sets his mug down.", "para": 18, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 96, "kind": "dialogue", "text": "I do.", "name": "AUNT BERNADETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 97, "kind": "dialogue", "text": "Auntie.", "name": "GRACIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 98, "kind": "dialogue", "text": "I've seen him in every state a man can be in. I'll see this one, too.", "name": "AUNT BERNADETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 99, "kind": "action", "text": "She stands.", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 100, "kind": "action", "text": "Straightens her cardigan.", "para": 19, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 101, "kind": "dialogue", "text": "Who is coming with me?", "name": "AUNT BERNADETTE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 102, "kind": "action", "text": "Nobody moves.", "para": 20, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 103, "kind": "action", "text": "Then Reuben puts down his mug.", "para": 20, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 104, "kind": "action", "text": "Then Gracie.", "para": 20, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 105, "kind": "action", "text": "Then, last, Hector.", "para": 20, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 106, "kind": "action", "text": "Theo opens the kitchen door and stands aside.", "para": 20, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 107, "kind": "action", "text": "They file out into the hall.", "para": 21, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 108, "kind": "action", "text": "The coffee cools.", "para": 21, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 109, "kind": "action", "text": "The clock stays where it is, ten past four.", "para": 21, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}]}