{"scene_id": "s01489", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01489.fountain", "heading": "INT. FIELD HOSPITAL TENT - FLOOD RELIEF CAMP - NIGHT", "cast": [{"id": 0, "name": "PATIENT", "names": ["PATIENT"], "gender": "m", "first": 6, "spoke": 0}, {"id": 1, "name": "ADAEZE OKONKWO-REYES", "names": ["ADAEZE OKONKWO-REYES", "ADAEZE"], "gender": "f", "first": 8, "spoke": 11}, {"id": 2, "name": "NURSE PETRA LINDBERG-AZIZ", "names": ["NURSE PETRA LINDBERG-AZIZ", "PETRA"], "gender": "f", "first": 9, "spoke": 2}, {"id": 3, "name": "MEDIC SAMUEL TORRES-WU", "names": ["MEDIC SAMUEL TORRES-WU", "SAMUEL"], "gender": "f", "first": 10, "spoke": 2}, {"id": 4, "name": "HENRI DUBOIS-KAMARA", "names": ["HENRI DUBOIS-KAMARA", "HENRI"], "gender": "m", "first": 11, "spoke": 5}, {"id": 5, "name": "DAUGHTER", "names": ["DAUGHTER"], "gender": "?", "first": 12, "spoke": 0}, {"id": 6, "name": "JOY BANERJEE-HALL", "names": ["JOY BANERJEE-HALL", "JOY"], "gender": "m", "first": 12, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. FIELD HOSPITAL TENT - FLOOD RELIEF CAMP - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Canvas walls breathing in the wind.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cots in rows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Hanging bulbs on extension cords.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The smell of bleach and wet earth.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Five people around a single cot.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "On it, the PATIENT, a man in his 60s, gray-faced, breathing shallowly.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Nobody says his name.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "DR. ADAEZE OKONKWO-REYES (40s, scrubs, sleeves rolled, sweat at her temples) checks a monitor that blinks erratically.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "NURSE PETRA LINDBERG-AZIZ (30s, steady, a pen behind each ear) squeezes a bag valve.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "MEDIC SAMUEL TORRES-WU (20s, wet boots) holds a flashlight.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "DR. HENRI DUBOIS-KAMARA (50s, retired surgeon, borrowed lab coat) stands at the foot with his arms folded.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "The man's DAUGHTER, JOY BANERJEE-HALL (30s, a muddy raincoat), grips the cot rail.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "Okay. Everyone. Pressure's dropping. Petra, push the fluids. Samuel, hold the light steady. Henri...", "name": "ADAEZE", "speaker": 1, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "I'm observing.", "name": "HENRI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "I know. Observe harder.", "name": "ADAEZE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "action", "text": "Petra changes the bag.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "action", "text": "Samuel moves the light.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "action", "text": "The man's chest rises and falls.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "Is he going to be all right?", "name": "JOY", "speaker": 6, "ext": [], "paren": ["to Adaeze"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "We're doing everything we can.", "name": "ADAEZE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "That's not what I asked.", "name": "JOY", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "I know.", "name": "ADAEZE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "She turns back to the monitor.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "A beep.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "action", "text": "Another.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "action", "text": "A flat trailing note.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "Doctor.", "name": "PETRA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "I see it.", "name": "ADAEZE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "Come on, come on, come on.", "name": "SAMUEL", "speaker": 3, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "Samuel angles the light, then glances at Joy and looks away.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "Adaeze. The line is infiltrated.", "name": "HENRI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "What?", "name": "ADAEZE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "The IV. It's swelling at the wrist.", "name": "HENRI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "She looks.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "He's right.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "Her jaw tightens.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "She pulls the line herself, fast, and the man gasps.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "dialogue", "text": "What are you doing?", "name": "JOY", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "Resetting it.", "name": "ADAEZE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "You're hurting him.", "name": "JOY", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "dialogue", "text": "Then let me work.", "name": "ADAEZE", "speaker": 1, "ext": [], "paren": ["sharp"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "Joy flinches.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "Adaeze catches herself.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "She closes her eyes for a half second, then opens them.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "Petra. Another line. The other arm.", "name": "ADAEZE", "speaker": 1, "ext": ["CONT'D"], "paren": ["softer"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "dialogue", "text": "Already done.", "name": "PETRA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "Petra holds out the needle, a bead of blood on her thumb.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "Adaeze takes it.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "action", "text": "Her hands, steady a moment ago, tremble now.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "action", "text": "She sets the needle.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "action", "text": "Draws breath.", "para": 8, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "action", "text": "Pushes.", "para": 8, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "action", "text": "The monitor catches.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "action", "text": "Beeps.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "action", "text": "A ragged line climbs.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "dialogue", "text": "We've got him.", "name": "SAMUEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "dialogue", "text": "We have a rhythm. Not a pulse.", "name": "HENRI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "dialogue", "text": "Come here.", "name": "ADAEZE", "speaker": 1, "ext": [], "paren": ["to Henri"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 59, "kind": "action", "text": "He comes.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 60, "kind": "action", "text": "She hands him the bag valve without a word.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 61, "kind": "action", "text": "He takes it, stunned.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 62, "kind": "action", "text": "Then he squeezes, once, twice, and glances across the cot at her.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 63, "kind": "dialogue", "text": "I forgot how this feels.", "name": "HENRI", "speaker": 4, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 64, "kind": "dialogue", "text": "Don't remember now. Squeeze.", "name": "ADAEZE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 65, "kind": "action", "text": "Joy's knuckles are white on the rail.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 66, "kind": "action", "text": "Samuel puts a hand on her shoulder.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 67, "kind": "action", "text": "Joy does not shake it off.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 68, "kind": "action", "text": "The man's eyelids flutter.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 69, "kind": "action", "text": "His mouth moves.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 70, "kind": "action", "text": "Joy leans in, hair dripping onto his cheek.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 71, "kind": "dialogue", "text": "Dad? Dad, it's me.", "name": "JOY", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 72, "kind": "action", "text": "Nothing.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 73, "kind": "action", "text": "Then a breath, deeper than the others, a long ragged pull.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 74, "kind": "action", "text": "Everyone stops moving.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 75, "kind": "action", "text": "Outside, the wind drops.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 76, "kind": "action", "text": "For the first time in hours, the tent hangs still.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}]}