{"scene_id": "s01490", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01490.fountain", "heading": "INT. ROOFTOP GREENHOUSE, APARTMENT BLOCK - DAWN", "cast": [{"id": 0, "name": "PHILOMENA ADEBAYO-STRAND", "names": ["PHILOMENA ADEBAYO-STRAND", "PHILOMENA"], "gender": "?", "first": 3, "spoke": 6}, {"id": 1, "name": "NIKOLAI", "names": ["NIKOLAI"], "gender": "?", "first": 4, "spoke": 7}, {"id": 2, "name": "^PHILOMENA", "names": ["^PHILOMENA"], "gender": "?", "first": 27, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROOFTOP GREENHOUSE, APARTMENT BLOCK - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Tomato cages, herb pots, a rusted bistro table.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The city wakes in haze below.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "PHILOMENA ADEBAYO-STRAND (60s, cardigan, trowel) waters basil.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "Across from her, her son NIKOLAI (30s, borrowed suit, unslept) cradles a mug.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "She waters.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "He sips.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Neither looks.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You came early.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Train was on time.", "name": "NIKOLAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "First time in years.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He nods.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She moves to the tomatoes.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He follows with his eyes.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "It looks good up here.", "name": "NIKOLAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Your father built the cages.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "I remember.", "name": "NIKOLAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "He'd have hated the basil.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "He hated everything green.", "name": "NIKOLAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "They share a quiet smile.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "It lingers.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Nik.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Mm.", "name": "NIKOLAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "He sets down the mug.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She sets down the can.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "They look at each other for the first time.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "I'm sorry I wasn't here.", "name": "NIKOLAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "I sold the house.", "name": "^PHILOMENA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "A pause.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Neither moves.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "The basil drips.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "You what?", "name": "NIKOLAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "It's done. Papers signed Friday.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Nikolai picks up the mug.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Sets it down.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Picks it up again.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "She watches his hands.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Behind them, the sun clears the rooftops.", "para": 7, "sent": 4, "present": [0, 1, 2]}]}