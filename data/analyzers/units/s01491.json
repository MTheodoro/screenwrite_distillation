{"scene_id": "s01491", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01491.fountain", "heading": "EXT. FROZEN QUARRY LAKE - DUSK", "cast": [{"id": 0, "name": "WYN", "names": ["WYN"], "gender": "?", "first": 5, "spoke": 7}, {"id": 1, "name": "ASANTE-KOWALSKI", "names": ["ASANTE-KOWALSKI"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "ROSALIE PEARSON-NGUYEN", "names": ["ROSALIE PEARSON-NGUYEN", "ROSALIE"], "gender": "f", "first": 6, "spoke": 4}, {"id": 3, "name": "BARNABAS OYELARAN", "names": ["BARNABAS OYELARAN", "BARNABAS"], "gender": "m", "first": 7, "spoke": 2}, {"id": 4, "name": "TEODORA VRANCEA-BELL", "names": ["TEODORA VRANCEA-BELL", "TEODORA"], "gender": "?", "first": 7, "spoke": 2}, {"id": 5, "name": "PETRUS HOLLAND-ABARA", "names": ["PETRUS HOLLAND-ABARA", "PETRUS"], "gender": "?", "first": 7, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FROZEN QUARRY LAKE - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "A flat gray disc ringed by black cliffs.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dirty snow.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A thin skin of ice that talks in the cold.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Five hikers stand at the shore, packs heavy.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "GWENDOLYN \"WYN\" ASANTE-KOWALSKI (40s, ruddy, a rope over her shoulder) tests the ice with a pole.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "ROSALIE PEARSON-NGUYEN (30s, a swollen ankle bound in a scarf) leans on a ski pole.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Behind them: BARNABAS OYELARAN (50s, bald, a thermos), TEODORA VRANCEA-BELL (20s, braids, camera strap), and old PETRUS HOLLAND-ABARA (70s, a hat with ear flaps).", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "dialogue", "text": "It'll hold.", "name": "WYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "It'll talk, but it'll hold.", "name": "ROSALIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "How far across?", "name": "BARNABAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Four hundred meters. Camp's on the far bank.", "name": "WYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "And around?", "name": "TEODORA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Eight kilometers. Through the cliffs.", "name": "WYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "In the dark.", "name": "PETRUS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "In the dark.", "name": "WYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Rosalie shifts her weight.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Winces.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Wyn sees it and says nothing.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "She'll want to go across.", "name": "ROSALIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "She'll want to? Or you?", "name": "WYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Her. She's never liked the cliffs.", "name": "ROSALIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Teodora glances between them.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "The ice groans.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Whose \"she\"?", "name": "TEODORA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Rosalie and Wyn both look at her.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Nobody answers.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Barnabas clears his throat and steps forward.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "We go across. Single file. Fifteen meters apart. Wyn first.", "name": "BARNABAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Rosalie second.", "name": "WYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "I can walk.", "name": "ROSALIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "You can limp.", "name": "WYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "She lowers the rope off her shoulder, ties it around Rosalie's waist, and then around her own.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "They step out.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "The ice cracks softly under them, a long fine sound like a hair being drawn from silk.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}