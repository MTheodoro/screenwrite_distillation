{"scene_id": "s01493", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01493.fountain", "heading": "INT. COMMUNITY-GARDEN TOOL SHED - NIGHT", "cast": [{"id": 0, "name": "NELLIE", "names": ["NELLIE"], "gender": "f", "first": 6, "spoke": 11}, {"id": 1, "name": "OKOYE-PRESCOTT", "names": ["OKOYE-PRESCOTT"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "MARCUS TRAN-ABERNATHY", "names": ["MARCUS TRAN-ABERNATHY", "MARCUS"], "gender": "m", "first": 7, "spoke": 9}, {"id": 3, "name": "BRIDGET KILLIAN-ADEYEMI", "names": ["BRIDGET KILLIAN-ADEYEMI", "BRIDGET"], "gender": "f", "first": 7, "spoke": 10}, {"id": 4, "name": "OLD FELIX BRANDT-NJOKU", "names": ["OLD FELIX BRANDT-NJOKU", "FELIX"], "gender": "m", "first": 7, "spoke": 4}, {"id": 5, "name": "AISHA MORENO-VANCE", "names": ["AISHA MORENO-VANCE", "AISHA"], "gender": "f", "first": 7, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. COMMUNITY-GARDEN TOOL SHED - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped plank shed that smells of manure and linseed oil.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single bulb on a string.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rakes in racks.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A calendar from 1998.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Five neighbors sit on buckets and overturned crates, an emergency meeting in a space not built for five.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "CORNELIA \"NELLIE\" OKOYE-PRESCOTT (60s, gardening gloves, a loud cardigan) presides on a stool.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Next to her: MARCUS TRAN-ABERNATHY (30s, a clipboard), BRIDGET KILLIAN-ADEYEMI (40s, bags under her eyes), OLD FELIX BRANDT-NJOKU (70s, a pipe unlit in his teeth), and young AISHA MORENO-VANCE (20s, still in her work apron).", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "dialogue", "text": "The developers close the lot Friday.", "name": "NELLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "They can't. We have the lease.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "We had the lease.", "name": "NELLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Until when?", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Until the thirtieth. Yesterday.", "name": "NELLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Nobody told us.", "name": "BRIDGET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "The letter was in the mailbox of the man who died in March.", "name": "NELLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "That's Hendricks.", "name": "FELIX", "speaker": 4, "ext": [], "paren": ["around his pipe"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Hendricks is dead, Felix.", "name": "BRIDGET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "That's why the letter's late.", "name": "FELIX", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "The bulb swings a quarter inch.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "We can petition.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "We have forty-two signatures.", "name": "NELLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Forty-two is a lot.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "It's not enough.", "name": "NELLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "How many do we need?", "name": "AISHA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Two hundred.", "name": "NELLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "By Friday?", "name": "AISHA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "By Friday.", "name": "NELLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Then we pick up the pace. Door to door tomorrow.", "name": "BRIDGET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "I have a meeting.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Cancel it.", "name": "BRIDGET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "I can't.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Then you're out.", "name": "BRIDGET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Out of what?", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "The garden.", "name": "BRIDGET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "A pause so cold the bulb seems to dim.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Marcus half rises.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Felix sets his pipe on his knee.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Aisha puts a hand on Marcus's sleeve.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Bridget crosses her arms.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Nellie lifts a rake from the rack and sets it on her lap.", "para": 4, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Sit, Marcus.", "name": "NELLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "He sits.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "Bridget, apologize.", "name": "NELLIE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "I will not.", "name": "BRIDGET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Then explain.", "name": "NELLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Hendricks's tomatoes are still in the south bed. He planted them. I water them.", "name": "BRIDGET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "Every day.", "name": "FELIX", "speaker": 4, "ext": [], "paren": ["gentle"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "Every day. Because somebody has to. And if they bulldoze it Friday...", "name": "BRIDGET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "She doesn't finish.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "Marcus lowers his clipboard.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Aisha stares at her hands.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "Felix lights his pipe, finally, with a slow match, and the shed fills with sweet smoke.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "I'll cancel the meeting.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "Thank you.", "name": "BRIDGET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "Don't thank me. I'm taking the south side.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "Of course you are.", "name": "FELIX", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}