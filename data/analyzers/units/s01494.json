{"scene_id": "s01494", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01494.fountain", "heading": "INT. GRAIN SILO, HEAVY BOMBER BASE - NIGHT", "cast": [{"id": 0, "name": "LIEUTENANT CASIMIR WOJCIK-ASANTE", "names": ["LIEUTENANT CASIMIR WOJCIK-ASANTE", "CASIMIR"], "gender": "m", "first": 5, "spoke": 12}, {"id": 1, "name": "SERGEANT TIBERIUS HALLORAN-OKORO", "names": ["SERGEANT TIBERIUS HALLORAN-OKORO", "TIBERIUS"], "gender": "?", "first": 6, "spoke": 7}, {"id": 2, "name": "YOUNG PRIVATE JONAH ABERNATHY-LIU", "names": ["YOUNG PRIVATE JONAH ABERNATHY-LIU", "JONAH"], "gender": "m", "first": 7, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRAIN SILO, HEAVY BOMBER BASE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A hollow concrete cylinder smelling of dust and old wheat.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A rope ladder dangles from a hatch.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Moonlight falls through the hatch in a pale coin on the floor.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Three men huddle around a hurricane lamp.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "LIEUTENANT CASIMIR WOJCIK-ASANTE (30s, flight jacket, no cap) sits on an overturned drum.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "SERGEANT TIBERIUS HALLORAN-OKORO (40s, a bandaged hand) cleans a pistol.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "YOUNG PRIVATE JONAH ABERNATHY-LIU (19, a radio on his lap) fiddles with its dials.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "How long since the last patrol?", "name": "CASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Two hours.", "name": "TIBERIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Nothing on the radio?", "name": "CASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Static, sir. Just static.", "name": "JONAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Try the emergency band.", "name": "CASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "I've tried it.", "name": "JONAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Try it again.", "name": "CASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Jonah turns the dial.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Static rises, falls.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "A fragment of music, dance-band, swells and fades.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "That's Berlin.", "name": "TIBERIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "That's Brussels.", "name": "CASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "It's Berlin.", "name": "TIBERIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Sergeant, I have flown over both.", "name": "CASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Sir, I have been bombed by both.", "name": "TIBERIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Then we are experts.", "name": "CASIMIR", "speaker": 0, "ext": [], "paren": ["a dry smile"], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Sir, may I ask something?", "name": "JONAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "You may.", "name": "CASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Are we going to be all right?", "name": "JONAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Tiberius stops cleaning the pistol.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Casimir leans back until his drum creaks.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Private, the war ends. Whether we end with it is a matter of arithmetic.", "name": "CASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Arithmetic?", "name": "JONAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "He means luck.", "name": "TIBERIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "I mean luck with decimals.", "name": "CASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Jonah laughs, small and surprised.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Tiberius cracks a smile.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "For a moment all three men are grinning in the lamplight like boys in a treehouse.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Then the grin falters.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Overhead, very faint, a droning begins.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "It swells.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "The lamp flame trembles.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Tiberius lowers the pistol, Casimir springs to his feet, and Jonah clutches the radio to his chest, all three staring up at the coin of moonlight as the hatch rattles on its hinges.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Ours.", "name": "TIBERIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "You're sure?", "name": "CASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Listen to the engines.", "name": "TIBERIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "They listen.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "The drone passes directly overhead.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "It's steady.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Unhurried.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "It fades toward the east.", "para": 6, "sent": 4, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Ours.", "name": "JONAH", "speaker": 2, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Ours.", "name": "CASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "They sit down again, slowly.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "No one speaks.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Tiberius resumes cleaning the pistol.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Jonah turns the dial back to the dance band, very low.", "para": 7, "sent": 3, "present": [0, 1, 2]}]}