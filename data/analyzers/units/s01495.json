{"scene_id": "s01495", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01495.fountain", "heading": "INT. CLOSED FISH MARKET - PRE-DAWN", "cast": [{"id": 0, "name": "DETECTIVE IGNATIUS OYELARAN-BRENNAN", "names": ["DETECTIVE IGNATIUS OYELARAN-BRENNAN", "IGNATIUS"], "gender": "?", "first": 5, "spoke": 10}, {"id": 1, "name": "DETECTIVE YASMINE ACHEBE-KOWALCZYK", "names": ["DETECTIVE YASMINE ACHEBE-KOWALCZYK", "YASMINE"], "gender": "?", "first": 6, "spoke": 7}, {"id": 2, "name": "UNIFORMED OFFICER", "names": ["UNIFORMED OFFICER"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "TREVOR MBEKI-LLOYD", "names": ["TREVOR MBEKI-LLOYD", "TREVOR"], "gender": "?", "first": 7, "spoke": 1}, {"id": 4, "name": "BARTHOLOMEW SANTIAGO-NGUYEN", "names": ["BARTHOLOMEW SANTIAGO-NGUYEN", "BARTHOLOMEW"], "gender": "m", "first": 8, "spoke": 11}, {"id": 5, "name": "PERPETUA OKORO-VANCE", "names": ["PERPETUA OKORO-VANCE", "PERPETUA"], "gender": "f", "first": 9, "spoke": 6}, {"id": 6, "name": "DIEGO FERREIRA-AKINS", "names": ["DIEGO FERREIRA-AKINS", "DIEGO"], "gender": "m", "first": 10, "spoke": 7}, {"id": 7, "name": "OFFICER", "names": ["OFFICER"], "gender": "?", "first": 28, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. CLOSED FISH MARKET - PRE-DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Concrete slabs, hoses, drains.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Ice melting in bins.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A tarp-draped shape in the center of the floor.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Six people stand around it in a loose horseshoe.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "DETECTIVE IGNATIUS OYELARAN-BRENNAN (50s, rumpled suit) holds a notebook.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "His partner DETECTIVE YASMINE ACHEBE-KOWALCZYK (30s, blazer, tired eyes) kneels beside the tarp.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "A UNIFORMED OFFICER, TREVOR MBEKI-LLOYD (20s), stands guard at the door.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "The market owner, MR. BARTHOLOMEW SANTIAGO-NGUYEN (60s, rubber apron), twists a towel.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "His night cleaner, PERPETUA OKORO-VANCE (40s, a mop in her hands), stares at the wall.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "In the corner, a fishmonger's boy, DIEGO FERREIRA-AKINS (16, still in waders), chews his thumbnail.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "Who found him?", "name": "IGNATIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "She did.", "name": "BARTHOLOMEW", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "I opened at four. He was there.", "name": "PERPETUA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "Did you touch him?", "name": "YASMINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "No.", "name": "PERPETUA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "You're sure.", "name": "IGNATIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "I swear.", "name": "PERPETUA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "She screamed so loud I came running.", "name": "DIEGO", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "You weren't supposed to be here yet.", "name": "BARTHOLOMEW", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "I'm always here early.", "name": "DIEGO", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "No one asked you.", "name": "BARTHOLOMEW", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Let him speak, Mr. Santiago-Nguyen.", "name": "IGNATIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "Santiago.", "name": "BARTHOLOMEW", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "Santiago. Did you know this man?", "name": "IGNATIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "Never seen him.", "name": "BARTHOLOMEW", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "He's wearing your market's apron.", "name": "YASMINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "Everyone's wearing the apron. I give out aprons.", "name": "BARTHOLOMEW", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "Detective, the van's here.", "name": "OFFICER", "speaker": 7, "ext": [], "paren": ["from the door"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 29, "kind": "dialogue", "text": "Hold it, Officer.", "name": "IGNATIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "dialogue", "text": "Yes, sir.", "name": "OFFICER", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "dialogue", "text": "Diego. How long have you worked here?", "name": "YASMINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "dialogue", "text": "Two summers.", "name": "DIEGO", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "dialogue", "text": "You know the regulars.", "name": "YASMINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "dialogue", "text": "Some.", "name": "DIEGO", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "dialogue", "text": "Look at his face.", "name": "YASMINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "action", "text": "Diego hesitates.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "action", "text": "Yasmine lifts the corner of the tarp.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "action", "text": "Perpetua turns away.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "action", "text": "Bartholomew drops his towel.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "action", "text": "Diego steps closer, peers down, and his shoulders sag.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 41, "kind": "dialogue", "text": "That's Mr. Koval. He buys the eels. Every Tuesday.", "name": "DIEGO", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 42, "kind": "dialogue", "text": "Mr. Koval.", "name": "IGNATIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 43, "kind": "dialogue", "text": "He always paid in cash.", "name": "DIEGO", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 44, "kind": "dialogue", "text": "Diego, shut up.", "name": "BARTHOLOMEW", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 45, "kind": "dialogue", "text": "No. Go on, son.", "name": "IGNATIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 46, "kind": "dialogue", "text": "He's been coming in Tuesdays since I started. He and Mr. Santiago talk. In the back.", "name": "DIEGO", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 47, "kind": "dialogue", "text": "About eels!", "name": "BARTHOLOMEW", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 48, "kind": "dialogue", "text": "About money.", "name": "PERPETUA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 49, "kind": "dialogue", "text": "Perpetua!", "name": "BARTHOLOMEW", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 50, "kind": "dialogue", "text": "I clean the back, Bartholomew. I hear everything.", "name": "PERPETUA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 51, "kind": "dialogue", "text": "Mr. Santiago, I think we should continue this at the station.", "name": "IGNATIUS", "speaker": 0, "ext": [], "paren": ["to Bartholomew"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 52, "kind": "dialogue", "text": "I want a lawyer.", "name": "BARTHOLOMEW", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 53, "kind": "dialogue", "text": "You'll have one.", "name": "YASMINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 54, "kind": "dialogue", "text": "I want one now.", "name": "BARTHOLOMEW", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 55, "kind": "dialogue", "text": "Officer Mbeki-Lloyd?", "name": "IGNATIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 56, "kind": "dialogue", "text": "Sir.", "name": "TREVOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 57, "kind": "dialogue", "text": "Escort Mr. Santiago to the car.", "name": "IGNATIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 58, "kind": "action", "text": "Trevor crosses the floor.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 59, "kind": "action", "text": "Bartholomew, for a moment, looks ready to bolt.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 60, "kind": "action", "text": "Then his shoulders slump and he lets himself be led.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 61, "kind": "action", "text": "The door closes.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 62, "kind": "action", "text": "Dawn bleeds in at the edges of the loading bay.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 63, "kind": "action", "text": "Perpetua leans on her mop.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 64, "kind": "action", "text": "Diego slumps onto an ice bin.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 65, "kind": "dialogue", "text": "You two did the right thing.", "name": "YASMINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 66, "kind": "dialogue", "text": "I just wanted to mop.", "name": "PERPETUA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}