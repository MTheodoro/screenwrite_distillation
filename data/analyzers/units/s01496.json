{"scene_id": "s01496", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01496.fountain", "heading": "INT. STRANDED GONDOLA CAR, ALPINE CABLEWAY - NIGHT", "cast": [{"id": 0, "name": "WOMAN", "names": ["WOMAN", "YOUNG WOMAN"], "gender": "f", "first": 8, "spoke": 3}, {"id": 1, "name": "ELDERLY MAN", "names": ["MAN", "ELDERLY MAN"], "gender": "m", "first": 9, "spoke": 3}, {"id": 2, "name": "TEENAGE GIRL", "names": ["TEENAGE GIRL"], "gender": "f", "first": 10, "spoke": 0}, {"id": 3, "name": "OPERATOR", "names": ["OPERATOR"], "gender": "?", "first": 16, "spoke": 4}, {"id": 4, "name": "PATROL", "names": ["PATROL"], "gender": "?", "first": 18, "spoke": 2}, {"id": 5, "name": "TEENAGER", "names": ["TEENAGER"], "gender": "?", "first": 25, "spoke": 1}, {"id": 6, "name": "INES", "names": ["INES"], "gender": "?", "first": 25, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. STRANDED GONDOLA CAR, ALPINE CABLEWAY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A glass box swaying slightly in the dark, forty meters above a gorge.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Frost on the windows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single battery lamp.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The far lights of a village glitter like spilled sugar.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Five people are packed inside, and a voice on a radio makes six.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "Skis, packs, a child's sled strapped to the wall.", "para": 1, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "Their breath fogs the glass.", "para": 1, "sent": 2, "present": []}, {"u": 8, "kind": "action", "text": "A WOMAN in her fifties sits upright, coat buttoned to the chin, a folded map in her lap.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "A MAN in his thirties crouches by the door with a phone held high.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "A TEENAGE GIRL hugs her knees on the bench.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "An ELDERLY MAN with a cane and a flat cap sits staring at the ceiling.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "A YOUNG WOMAN in ski patrol red leans against the control panel.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "The man's phone shows no signal.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "He lowers it.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "The radio on the control panel crackles.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Gondola Nine, Base. Do you read?", "name": "OPERATOR", "speaker": 3, "ext": ["V.O."], "paren": ["radio, faint"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "The patrol woman grabs the handset.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Base, Gondola Nine. We read. Six aboard, all stable.", "name": "PATROL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Copy six. Power's out on the whole line. Rescue crew's three hours out.", "name": "OPERATOR", "speaker": 3, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "The elderly man grunts.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "The woman refolds her map, creasing it in half, then in quarters.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Three hours. Everyone stay put. Please.", "name": "PATROL", "speaker": 4, "ext": [], "paren": ["to the car"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "She sets the handset down.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "The teenager shifts.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "I'm cold. Ines, what do we do?", "name": "TEENAGER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "We sort it.", "name": "INES", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "The man in the door unzips his jacket.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "He crosses to the bench and spreads it over the teenager.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "He sits back on his heels.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "The old man watches him.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "You know her?", "name": "ELDERLY MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "No.", "name": "MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "Hm.", "name": "ELDERLY MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "The man looks at the teenager.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "She shakes her head, once.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "He turns away.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "The gondola lurches.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "A creak travels the cable from far above.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "Everyone freezes.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "The lamp flickers.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "The glass trembles in its frame.", "para": 10, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "dialogue", "text": "It's the wind. Just the wind.", "name": "INES", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "dialogue", "text": "It's not the wind.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "dialogue", "text": "Ma'am...", "name": "INES", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "It's the cable. Listen.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "action", "text": "They listen.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "A thin, rhythmic singing runs along the steel, rising in pitch.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "dialogue", "text": "Base, Base. We have cable noise. Repeat, cable noise.", "name": "INES", "speaker": 6, "ext": [], "paren": ["into radio, sharp"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "dialogue", "text": "Say again, Nine?", "name": "OPERATOR", "speaker": 3, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "dialogue", "text": "Cable noise! Singing, pitching up!", "name": "INES", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "dialogue", "text": "Hold on. Hold on, Nine.", "name": "OPERATOR", "speaker": 3, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "action", "text": "The old man lifts his cane and lays it across his knees like a rifle.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "action", "text": "The teenager pulls the jacket closer.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "action", "text": "The man by the door stands, swaying, and puts a hand on the glass.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "action", "text": "Far below, the gorge exhales cold air.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "action", "text": "The singing stops.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "action", "text": "A long, absolute silence.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "action", "text": "Then the car drops six inches, stops, and swings.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 59, "kind": "action", "text": "Nobody screams.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 60, "kind": "action", "text": "The young woman in red just closes her eyes.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 61, "kind": "dialogue", "text": "All right. All right.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": ["very quiet"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 62, "kind": "action", "text": "She takes the teenager's hand.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 63, "kind": "action", "text": "The teenager takes the old man's.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 64, "kind": "action", "text": "He takes the man's.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 65, "kind": "action", "text": "A chain.", "para": 15, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 66, "kind": "action", "text": "A shaky one.", "para": 15, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 67, "kind": "dialogue", "text": "Come on, rescue. Come on.", "name": "INES", "speaker": 6, "ext": [], "paren": ["whispering to herself"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 68, "kind": "action", "text": "The radio hisses.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 69, "kind": "action", "text": "No voice.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 70, "kind": "action", "text": "The lamp holds, steady and small, as the car sways out over nothing.", "para": 16, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}]}