{"scene_id": "s01497", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01497.fountain", "heading": "EXT. SINKING FISHING TRAWLER, BERING SEA - NIGHT", "cast": [{"id": 0, "name": "CAPTAIN WINIFRED OYELOWO-STRAND", "names": ["CAPTAIN WINIFRED OYELOWO-STRAND", "WINIFRED"], "gender": "?", "first": 4, "spoke": 9}, {"id": 1, "name": "DECKHAND AMADEO TRUJILLO-BELL", "names": ["DECKHAND AMADEO TRUJILLO-BELL", "AMADEO"], "gender": "?", "first": 4, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SINKING FISHING TRAWLER, BERING SEA - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Black swells.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A bow rising and falling, deck awash.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Two survivors cling to the wheelhouse roof.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CAPTAIN WINIFRED OYELOWO-STRAND (50s, orange survival suit, a split lip) and DECKHAND AMADEO TRUJILLO-BELL (20s, no gloves, teeth chattering).", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "Captain, the lifeboat's gone!", "name": "AMADEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "I know!", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "We'll freeze!", "name": "AMADEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "We won't freeze. We'll drown first. It's quicker.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "That's not funny!", "name": "AMADEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I wasn't joking.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I'm twenty-two.", "name": "AMADEO", "speaker": 1, "ext": [], "paren": ["laughs, then sobs"], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I'm fifty-four. I've done this three times.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Done what?", "name": "AMADEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Sunk.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "How do you...", "name": "AMADEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "You hold on. That's the whole trick. Hold on till the boat stops being your problem.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "What if it never does?", "name": "AMADEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Then you hold on to me.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "A swell slams the hull.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Spray.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "They scream.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "The boat tilts, groans, and settles.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Captain!", "name": "AMADEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Still here!", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Still here!", "name": "AMADEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Then the rest is arithmetic.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}