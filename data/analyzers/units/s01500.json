{"scene_id": "s01500", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01500.fountain", "heading": "INT. COUNTY COURTHOUSE - SUPPLY CLOSET TURNED INTERVIEW ROOM - DAY", "cast": [{"id": 0, "name": "PUBLIC DEFENDER NOREEN ASANTE-WHITFIELD", "names": ["PUBLIC DEFENDER NOREEN ASANTE-WHITFIELD", "NOREEN"], "gender": "?", "first": 5, "spoke": 8}, {"id": 1, "name": "ELLIS PORTILLO-ADEBAYO", "names": ["ELLIS PORTILLO-ADEBAYO", "ELLIS"], "gender": "?", "first": 6, "spoke": 8}, {"id": 2, "name": "DESMOND KORKMAZ-LIU", "names": ["DESMOND KORKMAZ-LIU", "DESMOND"], "gender": "m", "first": 7, "spoke": 4}, {"id": 3, "name": "^NOREEN", "names": ["^NOREEN"], "gender": "?", "first": 25, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. COUNTY COURTHOUSE - SUPPLY CLOSET TURNED INTERVIEW ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A narrow room, mop buckets pushed to one side.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A card table.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Three folding chairs.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single window painted shut.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "PUBLIC DEFENDER NOREEN ASANTE-WHITFIELD (40s) sits with a file open.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across from her, the prosecutor ELLIS PORTILLO-ADEBAYO (40s) pushes a paper across the table.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Between them, in the third chair, their juror-turned-witness DESMOND KORKMAZ-LIU (30s) grips the seat edge.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Noreen slides the paper back.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "No.", "name": "NOREEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "You haven't read it.", "name": "ELLIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I've read it.", "name": "NOREEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "It's a good offer.", "name": "ELLIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "It's a bad one.", "name": "NOREEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Ellis taps the paper.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "She pushes back.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "He lets her.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Mr. Korkmaz-Liu, you understand why we're here?", "name": "ELLIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "I was juror number six.", "name": "DESMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "You were.", "name": "NOREEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "You spoke to the defendant's sister during recess.", "name": "ELLIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "She spoke to me.", "name": "DESMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "What did she say?", "name": "NOREEN", "speaker": 0, "ext": [], "paren": ["to Desmond"], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "She said her brother didn't do it.", "name": "DESMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "That's inadmissible.", "name": "ELLIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "That's inadmissible.", "name": "^NOREEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "They glare at each other.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Desmond looks from one to the other.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "I didn't mean...", "name": "ELLIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Neither did I.", "name": "NOREEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "They both lean back.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "The folding chairs creak.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Noreen closes the file.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Ellis straightens the offer.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Desmond lets go of his seat.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "The three of them sit in silence, waiting for someone to move first.", "para": 5, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Mr. Korkmaz-Liu, thank you for your honesty. You may go.", "name": "ELLIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "That's it?", "name": "DESMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "That's it.", "name": "NOREEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Desmond stands, bumps a mop bucket, and flees.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Ellis and Noreen watch the door swing shut.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Offer stands till five.", "name": "ELLIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "I'll see you in court.", "name": "NOREEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}