{"scene_id": "s01501", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01501.fountain", "heading": "INT. REGIONAL AIRPORT BAGGAGE CLAIM - NIGHT", "cast": [{"id": 0, "name": "THADDEUS BRANSON-OYELARAN", "names": ["THADDEUS BRANSON-OYELARAN", "THADDEUS"], "gender": "?", "first": 6, "spoke": 24}, {"id": 1, "name": "GIGI", "names": ["GIGI"], "gender": "?", "first": 9, "spoke": 25}, {"id": 2, "name": "PETRAKIS-NWOSU", "names": ["PETRAKIS-NWOSU"], "gender": "?", "first": 9, "spoke": 0}, {"id": 3, "name": "^GIGI", "names": ["^GIGI"], "gender": "?", "first": 74, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. REGIONAL AIRPORT BAGGAGE CLAIM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A dead carousel.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "One flickering fluorescent tube.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A vending machine humming a note a half-step flat.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain thrashes the empty glass hall.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The last flight in was four hours ago.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "THADDEUS BRANSON-OYELARAN (50s, an immaculate overcoat, the posture of a man who has complained to managers before) stands with arms crossed beside a single battered suitcase.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "It is not his.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "He has decided it is his.", "para": 1, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "GREGORIA \"GIGI\" PETRAKIS-NWOSU (50s, a blazer the color of canned peaches, a rolling cart of lost luggage) pushes through a swing door, whistling, and stops.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "She sees him.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He sees her.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Sir, the airport is closed.", "name": "GIGI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "I'm aware.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Then why are you in it?", "name": "GIGI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Because my bag is in it.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "This is a lost-and-found area. Your bag is lost.", "name": "GIGI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "My bag is right here.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "That's not your bag.", "name": "GIGI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "It's the bag I was given.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "By whom?", "name": "GIGI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "By the carousel.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Gigi studies the dead carousel.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "It doesn't move.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "She studies the suitcase.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "It's the color of mud, with a duct-taped corner.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Sir, that bag has been here since Tuesday.", "name": "GIGI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Then it's been waiting for me.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "It's tagged to a Mr. Hassan Abdi-Lindgren, Gate Nine.", "name": "GIGI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "I'm a Hassan in spirit.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Are you?", "name": "GIGI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "No.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": ["a long pause"], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "She crosses her arms.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "He does not uncross his.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "They stand in a faint electrical hum, two statues who each know the other won't blink.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Lord, give me strength.", "name": "GIGI", "speaker": 1, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Lord, give me my bag.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Gigi pulls a clipboard from the cart.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Writes.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Rips off a form.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Holds it out.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Fill out Form 31-B.", "name": "GIGI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Of what?", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Of your grievance.", "name": "GIGI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "He takes the form.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Reads it.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Looks up.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "It's in triplicate.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "We're a serious airport.", "name": "GIGI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "You have one gate.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "It's a serious gate.", "name": "GIGI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "She snaps her fingers.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "A pen sails out of her pocket and lands in his hand.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "He stares at it.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "It's a ballpoint chained to a small rubber frog.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "What is this?", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "Our pen.", "name": "GIGI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "It's a frog.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "It's a frog pen. It's how we know you're honest.", "name": "GIGI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Thaddeus clicks it.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "Starts writing.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "The frog dangles.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "Gigi leans over, reading upside down.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "That's not a grievance. That's a poem.", "name": "GIGI", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "It's a long grievance.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "\"Oh, suitcase, thou art mud.\"", "name": "GIGI", "speaker": 1, "ext": [], "paren": ["reading"], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "Stop reading.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "dialogue", "text": "\"Oh, suitcase, thou art lost, yet found, yet mine.\"", "name": "GIGI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 68, "kind": "dialogue", "text": "It's not for you!", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 69, "kind": "dialogue", "text": "It's on my form!", "name": "GIGI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "Thaddeus tears the form in half.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 71, "kind": "action", "text": "Gigi gasps.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 72, "kind": "action", "text": "She snatches the halves and tries to fit them together.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 73, "kind": "dialogue", "text": "GIGI You can't do that!", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 74, "kind": "dialogue", "text": "You can't do that!", "name": "^GIGI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "They stop.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "A beat.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "The vending machine hums.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "dialogue", "text": "Is there anyone else?", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": ["to the empty hall"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "dialogue", "text": "No.", "name": "GIGI", "speaker": 1, "ext": [], "paren": ["to the empty hall"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "dialogue", "text": "Why are you here?", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": ["to Gigi"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "dialogue", "text": "Because someone has to be.", "name": "GIGI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "dialogue", "text": "For a suitcase?", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "dialogue", "text": "For anyone's suitcase.", "name": "GIGI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 84, "kind": "action", "text": "A long silence.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 85, "kind": "action", "text": "He looks at the bag.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 86, "kind": "action", "text": "She looks at the torn form.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 87, "kind": "action", "text": "The fluorescent tube buzzes, dims, and recovers.", "para": 11, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 88, "kind": "dialogue", "text": "It isn't mine.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 89, "kind": "dialogue", "text": "I know.", "name": "GIGI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 90, "kind": "dialogue", "text": "Mine had a yellow ribbon.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 91, "kind": "dialogue", "text": "I know. It's in the back. It came in Tuesday. I was just waiting to see who would show up for the wrong one first.", "name": "GIGI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 92, "kind": "dialogue", "text": "That's cruel.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 93, "kind": "dialogue", "text": "That's customer service.", "name": "GIGI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 94, "kind": "action", "text": "She rolls her cart to the swing door.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 95, "kind": "action", "text": "Holds it open with her hip.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 96, "kind": "action", "text": "He stands for a moment.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 97, "kind": "action", "text": "Then he picks up the muddy suitcase, hugs it once, sets it down gently, and follows her out.", "para": 12, "sent": 3, "present": [0, 1, 2, 3]}]}