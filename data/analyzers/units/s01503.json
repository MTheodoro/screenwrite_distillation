{"scene_id": "s01503", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01503.fountain", "heading": "INT. HOSPITAL ELEVATOR - NIGHT", "cast": [{"id": 0, "name": "NURSE PRISCILLA ADEBAYO-KANE", "names": ["NURSE PRISCILLA ADEBAYO-KANE", "PRISCILLA"], "gender": "?", "first": 4, "spoke": 2}, {"id": 1, "name": "ORDERLY HIRAM OKORO-STRAND", "names": ["ORDERLY HIRAM OKORO-STRAND", "HIRAM"], "gender": "?", "first": 5, "spoke": 3}, {"id": 2, "name": "DOCTOR", "names": ["DOCTOR"], "gender": "m", "first": 6, "spoke": 4}, {"id": 3, "name": "CAPTAIN LUCIANA MOREAU-BANERJEE", "names": ["CAPTAIN LUCIANA MOREAU-BANERJEE", "LUCIANA"], "gender": "f", "first": 23, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOSPITAL ELEVATOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A steel box rising slowly.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A gurney crowds the car.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Under the sheet lies a patient, pale, an oxygen mask over his mouth.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "NURSE PRISCILLA ADEBAYO-KANE (30s, scrubs, hair in a bun) squeezes a bag valve.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "ORDERLY HIRAM OKORO-STRAND (50s, thick arms) steadies the gurney rail.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "A DOCTOR (40s, tired, a stethoscope around his neck) watches the monitor.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Eight more floors.", "name": "DOCTOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "He's holding.", "name": "PRISCILLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Come on, come on.", "name": "HIRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "The elevator stops.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "The doors don't open.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "The lights flicker.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "No.", "name": "DOCTOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "It's the generator.", "name": "HIRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "How long?", "name": "PRISCILLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Ten minutes, maybe.", "name": "HIRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "He doesn't have ten minutes.", "name": "DOCTOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "The doors part a crack.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "A hand wedges into the gap.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "A fire axe handle.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "The doors grind apart.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "In the opening, a figure in a yellow turnout coat.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "CAPTAIN LUCIANA MOREAU-BANERJEE (40s, helmet, soot on her cheek).", "para": 3, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Fire department. Everybody out the top hatch or I cut you out.", "name": "LUCIANA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "We have a patient.", "name": "DOCTOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Then he goes first.", "name": "LUCIANA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "She turns to Hiram.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "You. On three. One. Two.", "name": "LUCIANA", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Hiram braces the gurney.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Priscilla keeps squeezing the bag.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "The captain's helmet lamp hits the patient's face and, quietly, she nods.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}]}