{"scene_id": "s01505_2", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01505.fountain", "heading": "INT. HOTEL - ROOM 312 - CONTINUOUS", "cast": [{"id": 0, "name": "SAMUEL", "names": ["SAMUEL"], "gender": "m", "first": 2, "spoke": 2}, {"id": 1, "name": "RAYMOND", "names": ["RAYMOND"], "gender": "m", "first": 4, "spoke": 6}, {"id": 2, "name": "CALLISTA", "names": ["CALLISTA"], "gender": "f", "first": 6, "spoke": 3}, {"id": 3, "name": "EUDORA", "names": ["EUDORA"], "gender": "?", "first": 11, "spoke": 5}, {"id": 4, "name": "ISIDORE", "names": ["ISIDORE"], "gender": "m", "first": 11, "spoke": 2}, {"id": 5, "name": "ELMER", "names": ["ELMER"], "gender": "m", "first": 11, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOTEL - ROOM 312 - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "A man lies face-down on the floor, a candlestick beside him.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Samuel kneels and checks his neck.", "para": 0, "sent": 1, "present": [0]}, {"u": 3, "kind": "dialogue", "text": "Dead.", "name": "SAMUEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 4, "kind": "dialogue", "text": "How long?", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "Minutes.", "name": "SAMUEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Oh, God.", "name": "CALLISTA", "speaker": 2, "ext": [], "paren": ["at the door"], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Miss Devereaux, stay back.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "He was my husband.", "name": "CALLISTA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Samuel looks up sharply.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Raymond turns.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "In the doorway, behind Callista, the others have gathered: Eudora leaning on her cane, Isidore polishing his spectacles, Elmer trembling.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Everyone in the room. Nobody leaves.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "It was always going to be me or the Professor.", "name": "EUDORA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Lady Pemberton!", "name": "ISIDORE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Oh, don't be coy, Isidore. We both had reasons.", "name": "EUDORA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "What reasons?", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "He owed us money.", "name": "EUDORA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "A great deal of it.", "name": "ISIDORE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "He owed me, too.", "name": "ELMER", "speaker": 5, "ext": [], "paren": ["small voice"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Raymond looks at each in turn.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Samuel rises and wipes his hands.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Callista is staring at the floor.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "He owed all of us.", "name": "CALLISTA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Then it's a long list.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "The lights go out.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "A candle flame gutters.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "In the dark, a single gunshot cracks.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "A woman gasps.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Everyone scatters.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Raymond throws himself at the doorway, Samuel dives behind the bed, Eudora swings her cane in a wide arc, Isidore ducks under the desk, Elmer bolts for the window, and Callista grabs for the candlestick.", "para": 3, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "A match flares.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Raymond stands over the figure on the floor, the smoking pistol in Eudora's hand.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Lady Pemberton. Put it down.", "name": "RAYMOND", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "I only shot the lamp, Detective.", "name": "EUDORA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "She sets the pistol on the dresser and sits on the bed, composed, hands folded.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "I wanted you to see his face when the light came back.", "name": "EUDORA", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "The match gutters out.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}