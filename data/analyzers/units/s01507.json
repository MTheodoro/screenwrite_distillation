{"scene_id": "s01507", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01507.fountain", "heading": "INT. CORPORATE TEAM-BUILDING ESCAPE ROOM - DAY", "cast": [{"id": 0, "name": "ARNOLD KOWALCZYK-ABARA", "names": ["ARNOLD KOWALCZYK-ABARA", "ARNOLD"], "gender": "?", "first": 7, "spoke": 2}, {"id": 1, "name": "DESMOND PETROVA-OKAFOR", "names": ["DESMOND PETROVA-OKAFOR", "DESMOND"], "gender": "?", "first": 8, "spoke": 2}, {"id": 2, "name": "PRUDENCE LINDQVIST-ADEYEMI", "names": ["PRUDENCE LINDQVIST-ADEYEMI", "PRUDENCE"], "gender": "f", "first": 9, "spoke": 2}, {"id": 3, "name": "NORMAN HOLLOWAY-LEE", "names": ["NORMAN HOLLOWAY-LEE", "NORMAN"], "gender": "?", "first": 10, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. CORPORATE TEAM-BUILDING ESCAPE ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A fake dungeon with plywood walls painted to look like stone.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A locked chest.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A plastic skull on a pedestal.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A digital clock on the wall counts down from 60:00.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "It reads 03:12.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "Four coworkers are trapped in the room, every one of them wearing a lanyard.", "para": 1, "sent": 0, "present": []}, {"u": 7, "kind": "action", "text": "ARNOLD KOWALCZYK-ABARA (40s, rumpled shirt) kicks the chest.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "DESMOND PETROVA-OKAFOR (30s, red-faced, sweating) dumps a bag of plastic coins on the floor.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "PRUDENCE LINDQVIST-ADEYEMI (50s, reading glasses, a pen behind her ear) paces.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "NORMAN HOLLOWAY-LEE (30s, the intern) stares at the skull, hopeful.", "para": 1, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "He kicks the chest again.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "He shouts.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "He sits on it.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "He gets up and checks the other side, while he stares at the coins, then at him, and then at the clock.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "We're going to be late for the all-hands.", "name": "ARNOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "We're going to be dead, Arnold.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "We're going to be fired.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Is it possible the skull is the key?", "name": "NORMAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "It's plastic.", "name": "ARNOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "But keys can be plastic.", "name": "NORMAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "That's a skull, Norman!", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Norman picks up the skull.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Turns it over.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Inside, taped to the cranium, a key.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "He holds it out.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "For a moment nobody breathes.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Well. Don't just stand there.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "He fits it in the chest.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "The lid creaks open.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Inside lies a laminated card: \"CONGRATULATIONS!", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "YOU HAVE ESCAPED.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "PLEASE RETURN YOUR LANYARDS.\"", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "The clock stops at 02:05.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}]}