{"scene_id": "s01509", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01509.fountain", "heading": "INT. REQUISITIONED RAILWAY SIGNAL BOX - NIGHT", "cast": [{"id": 0, "name": "OBERLEUTNANT KASPAR WEIDENFELD-ABARA", "names": ["OBERLEUTNANT KASPAR WEIDENFELD-ABARA", "KASPAR"], "gender": "m", "first": 5, "spoke": 18}, {"id": 1, "name": "PRIVATE DESMOND OKORO-HALVERSEN", "names": ["PRIVATE DESMOND OKORO-HALVERSEN", "DESMOND"], "gender": "m", "first": 6, "spoke": 16}, {"id": 2, "name": "^KASPAR", "names": ["^KASPAR"], "gender": "?", "first": 49, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. REQUISITIONED RAILWAY SIGNAL BOX - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A narrow room of levers and dials, one dim lamp.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rain on the glass.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Down the line, a ruined station smolders.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A telegraph key sits silent on a shelf.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "OBERLEUTNANT KASPAR WEIDENFELD-ABARA (50s, frostbitten ear, an officer's greatcoat open) sits at a small table, writing a letter.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across the room, a captured soldier, PRIVATE DESMOND OKORO-HALVERSEN (20s, hands tied loose, a bandaged shoulder), watches.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Kaspar writes.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Desmond watches.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "A clock ticks.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "You may speak.", "name": "KASPAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I've nothing to say.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Then you may be quiet.", "name": "KASPAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Kaspar continues writing.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "The pen scratches.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Desmond looks at the lever frame.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Are you writing home?", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "I am.", "name": "KASPAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Does she know where you are?", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "She knows I am cold.", "name": "KASPAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Desmond almost smiles.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "He catches himself.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "My mother would ask if I was eating.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Are you?", "name": "KASPAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Not for two days.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Kaspar sets down the pen.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Reaches into his coat.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Brings out a heel of black bread.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Breaks it in half.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Holds out one half.", "para": 5, "sent": 4, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Desmond doesn't move.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "It is not poisoned.", "name": "KASPAR", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "I know.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Then eat.", "name": "KASPAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Desmond leans forward.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Takes it.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Chews.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Neither speaks.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "The rain softens.", "para": 7, "sent": 4, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Thank you.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "It is only bread.", "name": "KASPAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "It's not.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Kaspar nods, once.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "He returns to his letter.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "After a moment he stops.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "What is your mother's name?", "name": "KASPAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Why?", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "So I know who to write to.", "name": "KASPAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Don't write to her.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Don't write to her.", "name": "^KASPAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Both men stop.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "A long beat.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Desmond drops his gaze.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Kaspar folds the letter and puts it in his coat.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "It was Ruth.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "Ruth.", "name": "KASPAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "Ruth Okoro.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Kaspar says the name again, softly, to himself, and then gets up, crosses to the window, and watches the smoke on the horizon curl and fade.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "It is a good name.", "name": "KASPAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "It was.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "Kaspar does not turn around.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "The clock ticks.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "The telegraph key, for the first time all night, begins to chatter.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "They both look at it.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "Neither moves.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "That will be the order.", "name": "KASPAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "What order?", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "dialogue", "text": "The one that decides which of us goes home.", "name": "KASPAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "The key chatters on.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "Kaspar picks up the receiver.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "Listens.", "para": 13, "sent": 2, "present": [0, 1, 2]}, {"u": 71, "kind": "action", "text": "His face is a closed door.", "para": 13, "sent": 3, "present": [0, 1, 2]}, {"u": 72, "kind": "action", "text": "He puts it down.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 73, "kind": "dialogue", "text": "It is over.", "name": "KASPAR", "speaker": 0, "ext": ["CONT'D"], "paren": ["very quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 74, "kind": "dialogue", "text": "What is?", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 75, "kind": "dialogue", "text": "All of it.", "name": "KASPAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 76, "kind": "action", "text": "Desmond stares at him.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 77, "kind": "action", "text": "Rain on the glass.", "para": 15, "sent": 1, "present": [0, 1, 2]}, {"u": 78, "kind": "action", "text": "Kaspar crosses the room and kneels in front of the young man.", "para": 15, "sent": 2, "present": [0, 1, 2]}, {"u": 79, "kind": "action", "text": "He takes a knife from his belt.", "para": 15, "sent": 3, "present": [0, 1, 2]}, {"u": 80, "kind": "action", "text": "Desmond flinches.", "para": 15, "sent": 4, "present": [0, 1, 2]}, {"u": 81, "kind": "action", "text": "Kaspar cuts the rope at his wrists.", "para": 15, "sent": 5, "present": [0, 1, 2]}, {"u": 82, "kind": "dialogue", "text": "Go and tell your mother.", "name": "KASPAR", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 83, "kind": "action", "text": "Desmond rubs his wrists.", "para": 16, "sent": 0, "present": [0, 1, 2]}, {"u": 84, "kind": "action", "text": "He doesn't move.", "para": 16, "sent": 1, "present": [0, 1, 2]}, {"u": 85, "kind": "dialogue", "text": "And you?", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 86, "kind": "dialogue", "text": "I will finish my letter.", "name": "KASPAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}