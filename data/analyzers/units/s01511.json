"u": 9, "kind": "action", "text": "EMMANUEL \"MANNY\" TORRES-NGUYEN (20s, hoodie, one earbud in) stares at nothing.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Team! Good morning, team!", "name": "KEN", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "No one answers.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Ken reaches for the sign and smacks it against the whiteboard.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Ok. Quiet room.", "name": "KEN", "speaker": 0, "ext": ["CONT'D"], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "We're two people, Ken.", "name": "BEATRIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Two is a team.", "name": "KEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Two is a couple.", "name": "MANNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Manny!", "name": "KEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Sorry.", "name": "MANNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "We have a very exciting update from corporate.", "name": "KEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "We're being acquired.", "name": "BEATRIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "We're being closed.", "name": "BEATRIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "We're being closed.", "name": "^MANNY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Ken's smile locks into place.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "He lifts the sign.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "We are being realigned.", "name": "KEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Into what?", "name": "BEATRIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "A hybrid model.", "name": "KEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "What's hybrid?", "name": "MANNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Some of you will be here, and some of you will be... not.", "name": "KEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Which some?", "name": "BEATRIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Don't say it, Ken. Don't say it.", "name": "KEN", "speaker": 0, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "He fumbles with the sign.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Drops it.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Bends to pick it up at the same moment that Beatrix leans down to help, and their foreheads collide.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Manny rises to catch Ken's elbow and trips on the ficus.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "All three tumble to the carpet in a heap of sign, lanyard, and leaves.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "The printer groans.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Does this count as team-building?", "name": "MANNY", "speaker": 3, "ext": [], "paren": ["from the floor"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "It's a start.", "name": "KEN", "speaker": 0, "ext": [], "paren": ["also from the floor"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}