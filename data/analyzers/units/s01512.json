{"scene_id": "s01512", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01512.fountain", "heading": "INT. LEGAL AID OFFICE, FORMER DENTIST'S SUITE - EVENING", "cast": [{"id": 0, "name": "ATTORNEY OLIVIA OYELARAN-BRENNAN", "names": ["ATTORNEY OLIVIA OYELARAN-BRENNAN", "OLIVIA"], "gender": "f", "first": 6, "spoke": 14}, {"id": 1, "name": "PARALEGAL MARCO TRAN-ASHWORTH", "names": ["PARALEGAL MARCO TRAN-ASHWORTH", "MARCO"], "gender": "?", "first": 7, "spoke": 4}, {"id": 2, "name": "CLIENT HAROLD BEAUMONT-ADEYEMI", "names": ["CLIENT HAROLD BEAUMONT-ADEYEMI", "HAROLD"], "gender": "?", "first": 8, "spoke": 17}, {"id": 3, "name": "INTERPRETER LUCIA FERREIRA-DAS", "names": ["INTERPRETER LUCIA FERREIRA-DAS", "LUCIA"], "gender": "?", "first": 9, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. LEGAL AID OFFICE, FORMER DENTIST'S SUITE - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "A reception desk with a dental chair behind it, used as a client seat.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Beige carpet.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A dusty fish tank.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Diplomas of a man who is no longer here.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Four people around a conference table made of two card tables pushed together.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "ATTORNEY OLIVIA OYELARAN-BRENNAN (40s, cardigan, reading glasses on her head).", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "PARALEGAL MARCO TRAN-ASHWORTH (20s, laptop).", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "CLIENT HAROLD BEAUMONT-ADEYEMI (60s, an old coat, scarred hands).", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "INTERPRETER LUCIA FERREIRA-DAS (50s, a notebook).", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Mr. Beaumont-Adeyemi, I'd like to go through the eviction notice again.", "name": "OLIVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I've read it.", "name": "HAROLD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "I know. But I'd like to hear what you think it says.", "name": "OLIVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "It says I owe four months.", "name": "HAROLD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Do you?", "name": "OLIVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "I paid in cash.", "name": "HAROLD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Do you have receipts?", "name": "MARCO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "She wrote them by hand.", "name": "HAROLD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Who is \"she\"?", "name": "OLIVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Mrs. Okonkwo. The landlady.", "name": "HAROLD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "La casera. Okonkwo.", "name": "LUCIA", "speaker": 3, "ext": [], "paren": ["translating"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Do you have copies?", "name": "OLIVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "She keeps the originals. I keep the carbon.", "name": "HAROLD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Carbon copies?", "name": "MARCO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "I'm sixty-three, young man.", "name": "HAROLD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "I'm sorry.", "name": "MARCO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Don't be. They were the best thing she ever did for me.", "name": "HAROLD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Where are the carbons?", "name": "OLIVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "In the freezer.", "name": "HAROLD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "The freezer?", "name": "OLIVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "That's where I keep the important things.", "name": "HAROLD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "He means it.", "name": "LUCIA", "speaker": 3, "ext": [], "paren": ["to Olivia, aside"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Can you bring them tomorrow?", "name": "OLIVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Bring them? I'd have to defrost them.", "name": "HAROLD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "That's allowed.", "name": "MARCO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Is it?", "name": "HAROLD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Mr. Beaumont-Adeyemi, you are going to win this case.", "name": "OLIVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "You haven't seen the carbons.", "name": "HAROLD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "I don't need to.", "name": "OLIVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Why not?", "name": "HAROLD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Because the notice names the wrong tenant.", "name": "OLIVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Harold blinks.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Marco looks up.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Lucia stops writing.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "What?", "name": "HAROLD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "It says \"Beaumont-Adeyemi, Harold J.\" Your middle initial is R.", "name": "OLIVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "That's my brother's.", "name": "HAROLD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Then they're evicting your brother.", "name": "OLIVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "He's been dead since 'ninety-four.", "name": "HAROLD", "speaker": 2, "ext": [], "paren": ["slowly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Then they're evicting a ghost.", "name": "OLIVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}