4]}, {"u": 9, "kind": "action", "text": "His SON, young JEDEDIAH PRESCOTT-NGUYEN, thin, a pistol he doesn't know how to hold.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "And the preacher TOBIAS ADEYEMI-HOLM, a Bible in one hand and a sagging hat in the other.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "Marshal Ezra takes one step forward.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "Barnaby takes one step back.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "Hepzibah plants the washboard in the dirt like a flag.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "Jedediah's gun hand trembles, and the preacher raises his Bible as if to stop a bullet with it, while a sheet billows between them and the sun.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "No one speaks.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "A rooster crows.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "A bucket tips.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Water spreads across the dust.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "The sheet drops.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Behind it, the four stand exactly where they were.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Only Hepzibah has moved: the washboard is now a few inches higher, and she has not blinked.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Barnaby's eyes flick to Jedediah.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "The boy's gun slowly lowers.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "The Marshal lets out a very small breath.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "The preacher puts his hat back on.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}]}