{"scene_id": "s01514", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01514.fountain", "heading": "INT. NEONATAL ICU - NIGHT", "cast": [{"id": 0, "name": "THEODORA ASHWORTH-OKORO", "names": ["THEODORA ASHWORTH-OKORO", "THEODORA"], "gender": "?", "first": 5, "spoke": 11}, {"id": 1, "name": "NURSE BEATRICE LINDQVIST-ADEYEMI", "names": ["NURSE BEATRICE LINDQVIST-ADEYEMI", "BEATRICE"], "gender": "f", "first": 6, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. NEONATAL ICU - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dim blue light.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Monitors pulse.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Incubators glow like small aquariums.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A mobile of paper cranes turns slowly.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. THEODORA ASHWORTH-OKORO (40s, scrubs, hair pinned with a pencil) stands at an incubator, scribbling on a chart.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "NURSE BEATRICE LINDQVIST-ADEYEMI (50s, soft shoes, a pen behind her ear) squats beside her, adjusting a monitor lead.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "His oxygen's dropping.", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "I see it.", "name": "BEATRICE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Turn the flow up.", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Beatrice reaches for the dial.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Turns it.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Nothing changes.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She turns it again.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "It's stuck.", "name": "BEATRICE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Move.", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She crouches, pushes the dial, finds the line kinked beneath the incubator.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Straightens it.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "The monitor beeps higher.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "There.", "name": "THEODORA", "speaker": 0, "ext": ["CONT'D"], "paren": ["exhaling"], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "You were fast.", "name": "BEATRICE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "You were faster. If you hadn't called it...", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Don't say it.", "name": "BEATRICE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "I'm not going to.", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "They stand over the incubator, watching the tiny chest rise.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "She was a month early.", "name": "BEATRICE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "She's strong.", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "She is.", "name": "BEATRICE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Beatrice's hand drifts to the incubator's edge.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "She rests a finger on the clear plastic.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "My daughter was this size once.", "name": "BEATRICE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "How is she now?", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Thirty. Never calls.", "name": "BEATRICE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "She will.", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Will she?", "name": "BEATRICE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "When she has a baby of her own.", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Beatrice laughs, softly, then wipes her eyes.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "She straightens up.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "She picks up the chart and hands it to Theodora.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Doctor. You forgot to sign.", "name": "BEATRICE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "I know.", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "She takes the pen from behind Beatrice's ear, signs, and tucks it back.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Behind them, the mobile of cranes turns slowly in the blue light.", "para": 7, "sent": 1, "present": [0, 1]}]}