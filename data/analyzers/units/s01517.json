{"scene_id": "s01517", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01517.fountain", "heading": "INT. VILLAGE SCHOOLHOUSE - AFTER HOURS - DUSK", "cast": [{"id": 0, "name": "HEADMISTRESS GWENDOLEN BEAUMONT-OKORO", "names": ["HEADMISTRESS GWENDOLEN BEAUMONT-OKORO", "GWENDOLEN"], "gender": "f", "first": 6, "spoke": 12}, {"id": 1, "name": "ABEBE LINDQVIST-NWOSU", "names": ["ABEBE LINDQVIST-NWOSU", "ABEBE"], "gender": "?", "first": 7, "spoke": 5}, {"id": 2, "name": "FATIMA KOWALSKI-ASANTE", "names": ["FATIMA KOWALSKI-ASANTE", "FATIMA"], "gender": "f", "first": 8, "spoke": 6}, {"id": 3, "name": "BOY", "names": ["BOY"], "gender": "?", "first": 34, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. VILLAGE SCHOOLHOUSE - AFTER HOURS - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "Rows of small desks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A globe with a dent in Africa.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Chalk dust drifting through low gold light.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A map of a country that no longer exists.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Three adults sit at children's desks, knees too high, teacups on the writing slopes.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "HEADMISTRESS GWENDOLEN BEAUMONT-OKORO (60s, spectacles on a chain, a voice like a closing door) sits at the front.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "MR. ABEBE LINDQVIST-NWOSU (40s, the caretaker, a ring of keys), crammed behind a desk, drinks from a chipped mug.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "MRS. FATIMA KOWALSKI-ASANTE (30s, the only teacher left) rubs her temples.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "The inspector arrives Monday.", "name": "GWENDOLEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "We know.", "name": "FATIMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "He will want to see the registers.", "name": "GWENDOLEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "They're in the cellar.", "name": "ABEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Why?", "name": "GWENDOLEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Because of the flood.", "name": "ABEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Mr. Lindqvist-Nwosu, the flood was in April.", "name": "GWENDOLEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "They're still drying.", "name": "ABEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "They're mold, Abebe.", "name": "FATIMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Mold is a kind of record.", "name": "ABEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Mrs. Kowalski-Asante, what is the attendance?", "name": "GWENDOLEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Eleven.", "name": "FATIMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Out of?", "name": "GWENDOLEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Sixty.", "name": "FATIMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "And the rest?", "name": "GWENDOLEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Gone to the city.", "name": "FATIMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "All forty-nine?", "name": "GWENDOLEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "All of them. With their parents.", "name": "FATIMA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Then we have a school with eleven pupils, a caretaker, a teacher, and a headmistress.", "name": "GWENDOLEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "And a globe.", "name": "ABEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "And a globe.", "name": "GWENDOLEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "A knock at the door.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "They freeze.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Another knock, small and polite.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "The door opens.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "A BOY of nine, in oversized shoes, stands on the threshold with a lunch pail.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Is this where school is?", "name": "BOY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Gwendolen rises, slowly, and smooths her skirt.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "It is.", "name": "GWENDOLEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Am I late?", "name": "BOY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "No. You are the twelfth.", "name": "GWENDOLEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}