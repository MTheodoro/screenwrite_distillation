{"scene_id": "s01518", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01518.fountain", "heading": "INT. REGENCY MUSIC ROOM, HARTLEIGH PARK - AFTERNOON", "cast": [{"id": 0, "name": "LADY ARABELLA FOTHERINGHAY-ADEYEMI", "names": ["LADY ARABELLA FOTHERINGHAY-ADEYEMI", "ARABELLA"], "gender": "?", "first": 5, "spoke": 1}, {"id": 1, "name": "DOWAGER LADY HESTER FOTHERINGHAY-OKORO", "names": ["DOWAGER LADY HESTER FOTHERINGHAY-OKORO", "DOWAGER"], "gender": "?", "first": 6, "spoke": 2}, {"id": 2, "name": "ELIAS THISTLEWOOD-BELL", "names": ["ELIAS THISTLEWOOD-BELL"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "MISS PHILOMENA CARRADINE-LUU", "names": ["MISS PHILOMENA CARRADINE-LUU"], "gender": "?", "first": 8, "spoke": 0}, {"id": 4, "name": "OSWIN PRATT-NWOSU", "names": ["OSWIN PRATT-NWOSU"], "gender": "?", "first": 9, "spoke": 0}, {"id": 5, "name": "CALLER", "names": ["CALLER"], "gender": "?", "first": 18, "spoke": 3}, {"id": 6, "name": "HARCOURT", "names": ["HARCOURT"], "gender": "?", "first": 26, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. REGENCY MUSIC ROOM, HARTLEIGH PARK - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "A long room with a gleaming pianoforte, gilt chairs, and French windows open to a garden of clipped yews.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sunlight lays long stripes across the parquet.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A clock chimes four.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Lavender and beeswax.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Six people form a tableau: LADY ARABELLA FOTHERINGHAY-ADEYEMI, thirty, in primrose muslin, seated at the instrument.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her mother, DOWAGER LADY HESTER FOTHERINGHAY-OKORO, sixty, rigid in a high-backed chair with a lorgnette.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "The curate MR. ELIAS THISTLEWOOD-BELL, twenty-five, turning pages.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "The cousin MISS PHILOMENA CARRADINE-LUU, nineteen, embroidering by the window.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "The butler MR. OSWIN PRATT-NWOSU, fifty, carrying a tray of tea.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "And a gentleman caller, standing in the doorway with his hat in his hands.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Arabella plays a gentle air.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "The Dowager nods in time.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Elias turns a page.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Philomena stitches.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Oswin sets down the tray.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "The caller clears his throat.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Everyone turns.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Forgive the intrusion. I come with a letter for Lady Arabella.", "name": "CALLER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "From whom, sir?", "name": "DOWAGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "From a man who was thought drowned.", "name": "CALLER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Arabella's hands stop.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "The instrument falls silent.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "The clock ticks.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Oswin's cup rattles in its saucer.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "His name, sir.", "name": "ARABELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Captain Edmund Harcourt-Reyes.", "name": "CALLER", "speaker": 5, "ext": [], "paren": ["smiling"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "He bows.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "The Dowager's lorgnette clatters to the floor.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "Edmund?", "name": "DOWAGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "Alive, madam. And entirely at your service.", "name": "HARCOURT", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "Arabella rises.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "action", "text": "The garden breeze lifts the curtains.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "For a moment no one in the room breathes.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}]}