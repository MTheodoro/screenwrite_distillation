{"scene_id": "s01519", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01519.fountain", "heading": "INT. LIGHTHOUSE-TURNED-WEDDING-VENUE, SEASIDE TERRACE - EVENING", "cast": [{"id": 0, "name": "ROSS", "names": ["ROSS"], "gender": "m", "first": 11, "spoke": 9}, {"id": 1, "name": "CLEM", "names": ["CLEM"], "gender": "f", "first": 7, "spoke": 9}, {"id": 2, "name": "AUNT ZENOBIA", "names": ["AUNT ZENOBIA"], "gender": "?", "first": 15, "spoke": 2}, {"id": 3, "name": "^ROSS", "names": ["^ROSS"], "gender": "?", "first": 44, "spoke": 1}, {"id": 4, "name": "YUSUF", "names": ["YUSUF"], "gender": "?", "first": 19, "spoke": 3}, {"id": 5, "name": "LENA", "names": ["LENA"], "gender": "?", "first": 23, "spoke": 2}, {"id": 6, "name": "OLD MR. TIBERIUS", "names": ["OLD MR. TIBERIUS"], "gender": "?", "first": 26, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. LIGHTHOUSE-TURNED-WEDDING-VENUE, SEASIDE TERRACE - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "A white tower on a cliff above a violet sea.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A terrace strung with lights.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A small dance floor.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Folding chairs, half of them empty.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A cake on a card table.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "Six wedding guests drift in the golden hour.", "para": 1, "sent": 0, "present": []}, {"u": 7, "kind": "action", "text": "CLEMENTINE \"CLEM\" OKONKWO-ASHBY.", "para": 2, "sent": 0, "present": [1]}, {"u": 8, "kind": "action", "text": "30s.", "para": 2, "sent": 1, "present": [1]}, {"u": 9, "kind": "action", "text": "Maid of honor.", "para": 2, "sent": 2, "present": [1]}, {"u": 10, "kind": "action", "text": "Hair coming loose.", "para": 2, "sent": 3, "present": [1]}, {"u": 11, "kind": "action", "text": "ROSS MAKINDE-LINDQVIST.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "30s.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "The best man.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "A slightly crooked tie.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "AUNT ZENOBIA ADEYEMI-HART.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "60s.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Sequins.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Fierce.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "YUSUF ABARA-KOWALSKI.", "para": 5, "sent": 0, "present": [0, 1, 2, 4]}, {"u": 20, "kind": "action", "text": "40s.", "para": 5, "sent": 1, "present": [0, 1, 2, 4]}, {"u": 21, "kind": "action", "text": "Photographer.", "para": 5, "sent": 2, "present": [0, 1, 2, 4]}, {"u": 22, "kind": "action", "text": "A heavy camera.", "para": 5, "sent": 3, "present": [0, 1, 2, 4]}, {"u": 23, "kind": "action", "text": "LENA PETRAKIS-NGUYEN.", "para": 6, "sent": 0, "present": [0, 1, 2, 4, 5]}, {"u": 24, "kind": "action", "text": "20s.", "para": 6, "sent": 1, "present": [0, 1, 2, 4, 5]}, {"u": 25, "kind": "action", "text": "A catering waitress with a tray of champagne.", "para": 6, "sent": 2, "present": [0, 1, 2, 4, 5]}, {"u": 26, "kind": "action", "text": "OLD MR. TIBERIUS BRANDT-OSEI.", "para": 7, "sent": 0, "present": [0, 1, 2, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "80s.", "para": 7, "sent": 1, "present": [0, 1, 2, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "The groom's grandfather.", "para": 7, "sent": 2, "present": [0, 1, 2, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "A cane.", "para": 7, "sent": 3, "present": [0, 1, 2, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "Clem watches the sea.", "para": 8, "sent": 0, "present": [0, 1, 2, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "Ross watches Clem.", "para": 8, "sent": 1, "present": [0, 1, 2, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "You've been standing there for twenty minutes.", "name": "ROSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "I'm thinking.", "name": "CLEM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "About what?", "name": "ROSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "About the speech.", "name": "CLEM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "You wrote it.", "name": "ROSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "That's the problem.", "name": "CLEM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "She turns.", "para": 9, "sent": 0, "present": [0, 1, 2, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "He smiles.", "para": 9, "sent": 1, "present": [0, 1, 2, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "She does not.", "para": 9, "sent": 2, "present": [0, 1, 2, 4, 5, 6]}, {"u": 41, "kind": "dialogue", "text": "Children, the cake!", "name": "AUNT ZENOBIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "Clem and Ross speak at the same time.", "para": 10, "sent": 0, "present": [0, 1, 2, 4, 5, 6]}, {"u": 43, "kind": "dialogue", "text": "Not yet.", "name": "CLEM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4, 5, 6]}, {"u": 44, "kind": "dialogue", "text": "Not yet.", "name": "^ROSS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "action", "text": "They look at each other.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "action", "text": "A small, startled grin passes between them.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "dialogue", "text": "Smile for me, you two.", "name": "YUSUF", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "They don't.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "action", "text": "Yusuf lowers the camera.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "dialogue", "text": "Ah. That's the better shot.", "name": "YUSUF", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "dialogue", "text": "Don't you dare print that.", "name": "CLEM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "dialogue", "text": "I wouldn't dream of it.", "name": "YUSUF", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "action", "text": "Lena glides past with her tray.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "action", "text": "She offers a flute to Clem.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "action", "text": "Clem takes one.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "action", "text": "She offers one to Ross.", "para": 13, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "action", "text": "Ross takes it, and with it, brushes Clem's fingers.", "para": 13, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "dialogue", "text": "Careful. People are watching.", "name": "LENA", "speaker": 5, "ext": [], "paren": ["murmuring"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 59, "kind": "action", "text": "Clem looks across the terrace, past the cake, to the sea.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 60, "kind": "action", "text": "Ross lowers his eyes.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 61, "kind": "dialogue", "text": "Is it time?", "name": "OLD MR. TIBERIUS", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 62, "kind": "dialogue", "text": "It's time, Tiberius.", "name": "AUNT ZENOBIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 63, "kind": "action", "text": "He taps his cane.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 64, "kind": "action", "text": "A gong sounds from within the tower.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 65, "kind": "action", "text": "Guests turn toward the stairs.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 66, "kind": "dialogue", "text": "We should go in.", "name": "ROSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 67, "kind": "dialogue", "text": "We should.", "name": "CLEM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 68, "kind": "action", "text": "Neither moves.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 69, "kind": "action", "text": "Ross sets down his flute.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 70, "kind": "action", "text": "Clem sets down hers.", "para": 16, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 71, "kind": "action", "text": "The gong sounds again.", "para": 16, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 72, "kind": "dialogue", "text": "Clem.", "name": "ROSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 73, "kind": "dialogue", "text": "Don't.", "name": "CLEM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 74, "kind": "dialogue", "text": "I haven't said anything.", "name": "ROSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 75, "kind": "dialogue", "text": "You were going to.", "name": "CLEM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 76, "kind": "dialogue", "text": "I was going to say your speech was good.", "name": "ROSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 77, "kind": "dialogue", "text": "You haven't heard it.", "name": "CLEM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 78, "kind": "dialogue", "text": "I know you.", "name": "ROSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 79, "kind": "action", "text": "She laughs.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 80, "kind": "action", "text": "It is half a sob.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 81, "kind": "action", "text": "He reaches for her hand.", "para": 17, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 82, "kind": "action", "text": "She lets him take it for exactly one heartbeat, then pulls free and walks toward the tower.", "para": 17, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 83, "kind": "action", "text": "He stays behind, alone at the rail, watching the violet sea.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 84, "kind": "action", "text": "Lena returns and takes his empty flute.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 85, "kind": "dialogue", "text": "She'll come around.", "name": "LENA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 86, "kind": "dialogue", "text": "She already did.", "name": "ROSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}