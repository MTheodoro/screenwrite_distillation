{"scene_id": "s01520", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01520.fountain", "heading": "INT. SALT WAREHOUSE - DAWN", "cast": [{"id": 0, "name": "SERGEANT ODALYS BRANTZ", "names": ["SERGEANT ODALYS BRANTZ", "BRANTZ"], "gender": "?", "first": 4, "spoke": 10}, {"id": 1, "name": "VASKO", "names": ["VASKO"], "gender": "m", "first": 6, "spoke": 6}, {"id": 2, "name": "CORPORAL HIROSHI MAEDA", "names": ["CORPORAL HIROSHI MAEDA", "MAEDA"], "gender": "m", "first": 7, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. SALT WAREHOUSE - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Mountains of grey salt.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rafters.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dust in slanted light.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SERGEANT ODALYS BRANTZ, 40s, cracked lips, rifle slung low, drags a wounded boy through the doorway.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "PVT.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "TEODOR \"TEDDY\" VASKO, 19, bleeding thigh, grips her collar.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "CORPORAL HIROSHI MAEDA, 30s, wire-thin, covers the door.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Counts rounds.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Counts again.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Down. Behind the big pile.", "name": "BRANTZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I can walk.", "name": "VASKO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "You can't.", "name": "BRANTZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Eleven. Eleven. Eleven.", "name": "MAEDA", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Boots outside.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Gravel.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Stop.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Brantz and Maeda freeze.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Vasko stops breathing.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Window.", "name": "BRANTZ", "speaker": 0, "ext": [], "paren": ["whisper, to Maeda"], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Boarded.", "name": "MAEDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Sarge, I hear--", "name": "VASKO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Quiet.", "name": "BRANTZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Sarge, they're at the--", "name": "MAEDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "They're at the back too.", "name": "VASKO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Everyone shut up.", "name": "BRANTZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "A shadow crosses the slats.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Gone.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Breathe. Count. Breathe.", "name": "MAEDA", "speaker": 2, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Brantz slides a canteen to Vasko.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "He fumbles it.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "It clangs.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "All three flinch.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "A shout outside.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Another.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Running feet.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Positions. Now.", "name": "BRANTZ", "speaker": 0, "ext": [], "paren": ["to all"], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Vasko drags himself behind a salt drift.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Maeda drops to one knee.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Brantz climbs a crate.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "How many?", "name": "MAEDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Enough.", "name": "BRANTZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Sarge, I can't feel my leg.", "name": "VASKO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Then you can't feel it hurt. Good.", "name": "BRANTZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "The door shudders.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "A rifle butt splinters the wood.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Maeda fires.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Brantz fires.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Salt sprays like snow.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "I got one! I got--", "name": "VASKO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Down, Teddy!", "name": "MAEDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Maeda, left!", "name": "BRANTZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "The door bursts.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "A grenade skitters across the floor.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "All three scatter.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Brantz dives for Vasko.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Maeda hurls himself at the grenade, kicks it back out the door.", "para": 14, "sent": 2, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "BOOM.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Salt rains from the rafters.", "para": 15, "sent": 1, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Silence.", "para": 16, "sent": 0, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "Ringing ears.", "para": 16, "sent": 1, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Eleven. Ten.", "name": "MAEDA", "speaker": 2, "ext": [], "paren": ["coughing"], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "Brantz hauls Vasko up.", "para": 17, "sent": 0, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "Vasko grins, white with salt.", "para": 17, "sent": 1, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "Still here.", "name": "VASKO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "Move.", "name": "BRANTZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}