{"scene_id": "s01522", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01522.fountain", "heading": "INT. CORPORATE WELLNESS NAP POD ROOM - DAY", "cast": [{"id": 0, "name": "PRIYA DESHMUKH-LOWE", "names": ["PRIYA DESHMUKH-LOWE", "PRIYA"], "gender": "f", "first": 4, "spoke": 3}, {"id": 1, "name": "WALLY", "names": ["WALLY"], "gender": "?", "first": 7, "spoke": 4}, {"id": 2, "name": "PRZYBYSZ", "names": ["PRZYBYSZ"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "VP", "names": ["VP"], "gender": "?", "first": 7, "spoke": 0}, {"id": 4, "name": "SUNNIVA ABARA", "names": ["SUNNIVA ABARA", "SUNNIVA"], "gender": "f", "first": 16, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. CORPORATE WELLNESS NAP POD ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Six sleep pods.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "One occupied.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Whale sounds on a loop.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "PRIYA DESHMUKH-LOWE, 30s, lanyard, laptop balanced on her knees inside the pod.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Typing in the dark.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "The hatch hisses open.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "WALTER \"WALLY\" PRZYBYSZ, 50s, regional VP, leans in with a clipboard.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Priya. Nap quota's twenty minutes.", "name": "WALLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "This is a nap.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "You're answering email.", "name": "WALLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Napping with intent.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Wally ticks a box.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Writes.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Frowns.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Behind him, the door swings.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "DR. SUNNIVA ABARA, 40s, Chief Wellbeing Officer, crisp blazer, tablet like a shield.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Walter. Is she charging overage?", "name": "SUNNIVA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "She's... overachieving.", "name": "WALLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "I need you rested for the layoff announcement.", "name": "SUNNIVA", "speaker": 4, "ext": [], "paren": ["to Priya"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Priya's typing stops.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Wally's pen stops.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "The whales go on.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "When?", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "After your nap.", "name": "SUNNIVA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Priya closes the laptop.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Smiles.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Lies back, hands folded like a corpse.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "She knows.", "name": "WALLY", "speaker": 1, "ext": [], "paren": ["whisper to Sunniva"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "She knows nothing.", "name": "SUNNIVA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Priya snores.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Loudly.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Fakely.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Wally sweats.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Sunniva checks her watch.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "The whales sing.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}]}