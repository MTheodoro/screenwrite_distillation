{"scene_id": "s01523", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01523.fountain", "heading": "INT. DRAINED PUBLIC SWIMMING POOL - NIGHT", "cast": [{"id": 0, "name": "CAZ", "names": ["CAZ"], "gender": "?", "first": 5, "spoke": 9}, {"id": 1, "name": "REYES-MORROW", "names": ["REYES-MORROW"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "LUDDY", "names": ["LUDDY"], "gender": "f", "first": 9, "spoke": 11}, {"id": 3, "name": "KOVAC", "names": ["KOVAC"], "gender": "?", "first": 9, "spoke": 0}, {"id": 4, "name": "TOMAS", "names": ["TOMAS"], "gender": "?", "first": 17, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRAINED PUBLIC SWIMMING POOL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Empty deep end.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cracked blue tiles.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single work light on a stand.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain taps the skylights.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CASPIAN \"CAZ\" REYES-MORROW, 40s, rumpled suit, sits on the pool ladder, briefcase on his lap.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Waiting.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Footsteps echo above.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "A woman descends the shallow-end stairs, hands visible.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "LUDMILA \"LUDDY\" KOVAC, 30s, leather jacket, calm to the point of insult.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Caz.", "name": "LUDDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Luddy. You're early.", "name": "CAZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "You're sweating.", "name": "LUDDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "It's a pool. Humidity.", "name": "CAZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "It's empty.", "name": "LUDDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "She tilts her head at the briefcase.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "He tightens his grip.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Where's Tomas?", "name": "LUDDY", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Parking.", "name": "CAZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Tomas doesn't drive.", "name": "LUDDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "A beat.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "The rain gets louder.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Somewhere a pipe knocks.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "He learned.", "name": "CAZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Caz.", "name": "LUDDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Luddy, don't.", "name": "CAZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "She walks the slope of the pool floor, slow, boots squeaking on old algae.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Caz stands, the ladder clanking, and sets the briefcase between them on the tile.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "He steps back.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "She does not step forward.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Above, a shadow slides across the skylight and is gone, and Caz looks up while Luddy looks at him.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "That's not Tomas.", "name": "LUDDY", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "It's the wind.", "name": "CAZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "It's Dutch Maren. I can smell the cigarettes.", "name": "LUDDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Luddy, I had no choice.", "name": "CAZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Everyone says that at the end.", "name": "LUDDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "A metal door bangs open above.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Heavy steps.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "A voice, thick and amused, rolls down the tiles.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Caz, my friend. You were supposed to be quiet.", "name": "TOMAS", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Caz drops.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Luddy draws a pistol from her jacket, spins, fires at the light stand.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Glass bursts.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Darkness, except the faint blue of the skylights.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Caz crawls behind the ladder, hugging the briefcase, while Luddy slides down the wall of the deep end and Tomas' boots clatter on the steps, unhurried, a man descending to a party.", "para": 8, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Luddy. You always did love a dramatic entrance.", "name": "TOMAS", "speaker": 4, "ext": ["O.S.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Caz, open the case.", "name": "LUDDY", "speaker": 2, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "There's nothing in it.", "name": "CAZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "What?", "name": "LUDDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "There was never anything in it!", "name": "CAZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Tomas laughs in the dark.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "A lighter flicks.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "A small flame shows his face at the lip of the pool, smiling.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}]}