{"scene_id": "s01524", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01524.fountain", "heading": "INT. TAXIDERMY SHOP - DAY", "cast": [{"id": 0, "name": "BARNEY", "names": ["BARNEY"], "gender": "?", "first": 4, "spoke": 14}, {"id": 1, "name": "QUIGLEY", "names": ["QUIGLEY"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "NADIA FONTAINE-OKAFOR", "names": ["NADIA FONTAINE-OKAFOR", "NADIA"], "gender": "?", "first": 6, "spoke": 14}], "units": [{"u": 0, "kind": "heading", "text": "INT. TAXIDERMY SHOP - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Glass eyes everywhere.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A badger in a tutu.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A moose wearing sunglasses.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "BARNABY \"BARNEY\" QUIGLEY, 40s, apron, tweezers, is mid-surgery on a pheasant.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "The bell jingles.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "In steps NADIA FONTAINE-OKAFOR, 30s, in a black dress and veil, holding a shoebox.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Barney.", "name": "NADIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Nadia. Hey. Sorry. Don't touch the badger.", "name": "BARNEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "I need Mr. Biscuit preserved.", "name": "NADIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Mr. Biscuit.", "name": "BARNEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "My hamster.", "name": "NADIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Oh. Oh no.", "name": "BARNEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Don't \"oh no\" me. I paid eleven dollars to a priest.", "name": "NADIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Hamsters are tiny. The skin's like tissue. It's basically origami.", "name": "BARNEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Then fold him.", "name": "NADIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "She puts the shoebox on the counter.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Opens it.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "They both lean in.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "He looks peaceful.", "name": "BARNEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "He looks stuffed already.", "name": "NADIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "That's rigor, Nadia.", "name": "BARNEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Don't say rigor in front of him.", "name": "NADIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Okay. Okay. Pose?", "name": "BARNEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Running on the wheel.", "name": "NADIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "I don't have a wheel.", "name": "BARNEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "You have a moose in sunglasses, Barney. Find a wheel.", "name": "NADIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "That moose is a commissioned work.", "name": "BARNEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "By whom?", "name": "NADIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "A very rich man named Gus.", "name": "BARNEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Is Gus alive?", "name": "NADIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Barely. Moose, though. Moose is forever.", "name": "BARNEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Nadia picks up the tweezers.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Aims them at Barney like a tiny sword.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Wheel. Hamster. Today.", "name": "NADIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Nadia, it's a three-week turnaround.", "name": "BARNEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Barney, he's thawing.", "name": "NADIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Right. Wheel. Found one.", "name": "BARNEY", "speaker": 0, "ext": [], "paren": ["grabbing the box"], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "He sprints to the back.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Crash.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Squeak.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "A rubber duck rolls out.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "That's a duck!", "name": "NADIA", "speaker": 2, "ext": [], "paren": ["calling"], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "It's a start!", "name": "BARNEY", "speaker": 0, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}]}