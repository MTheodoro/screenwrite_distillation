{"scene_id": "s01525", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01525.fountain", "heading": "INT. NIGHT FERRY CAR DECK - NIGHT", "cast": [{"id": 0, "name": "MAN", "names": ["MAN"], "gender": "m", "first": 5, "spoke": 11}, {"id": 1, "name": "LINDQVIST", "names": ["LINDQVIST"], "gender": "?", "first": 11, "spoke": 17}, {"id": 2, "name": "DECKHAND KOFI ASANTE", "names": ["DECKHAND KOFI ASANTE", "KOFI"], "gender": "m", "first": 27, "spoke": 8}, {"id": 3, "name": "HENRIK", "names": ["HENRIK"], "gender": "f", "first": 65, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT FERRY CAR DECK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cars parked in rows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Engine drone.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Fluorescent tubes flicker.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Salt wind slaps through the half-open bow.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A MAN in a grey raincoat sits alone in a dented Volvo, engine off.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Hands on the wheel.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Watching the mirror.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "A woman walks the aisle between cars.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Torch in hand.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "Ferry uniform.", "para": 2, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "Her badge reads P. LINDQVIST.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She raps the glass.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "The Man lowers the window two inches.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Sir. Passengers must leave the deck during crossing.", "name": "LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I'm fine here.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "It's a rule.", "name": "LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "I'm unwell. I'd rather not climb the stairs.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She studies him.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Torch beam on his hands.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "On the wet hem of the coat.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "You're soaked, sir.", "name": "LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Seasick.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "We haven't left the pier.", "name": "LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "The Man says nothing.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "A third figure steps from behind a pickup, thirty feet back.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "A young deckhand, cap pulled low.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "DECKHAND KOFI ASANTE, 20s, sees them.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Stops.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Pia? Everything okay?", "name": "KOFI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Kofi. Stay there.", "name": "LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Who's he?", "name": "KOFI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "I'm finding out.", "name": "LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "The Man opens his door slowly.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Steps out.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Rain on the deck.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "He holds his palms up.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "I'm not armed.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Nobody said you were.", "name": "LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Nobody had to.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Kofi edges closer, hand on a pry bar at his belt.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Pia, his boot. There's blood.", "name": "KOFI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Lindqvist looks down.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "A dark smear at the heel.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Sir. Whose is that?", "name": "LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Mine.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Show me where you're hurt.", "name": "LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "I'm not.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Then it's not yours.", "name": "KOFI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "A long pause.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "The Man exhales.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Shoulders drop.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Her name was Annelie.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Annelie who?", "name": "LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "My sister.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "Where is she?", "name": "KOFI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "At the terminal. In the lockers.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Lindqvist's torch wavers.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Kofi swears under his breath.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "Bridge, this is Lindqvist. Hold the ramp. Call the harbour police.", "name": "LINDQVIST", "speaker": 1, "ext": [], "paren": ["into her radio"], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "The radio hisses.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "Lindqvist presses the key again.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "Hold the ramp. Now.", "name": "LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "The Man sits down on the wet deck beside his car.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "Folds his hands in his lap.", "para": 15, "sent": 1, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "I'm Henrik. Henrik Bjornsson. You'll want that for your report.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "Stay where you are, Mr. Bjornsson.", "name": "LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "I'm not going anywhere. I couldn't if I tried.", "name": "HENRIK", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "Kofi lowers the pry bar.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "Lindqvist keeps the torch on Henrik's face, steady.", "para": 16, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "dialogue", "text": "Kofi. Blanket from the lifeboat store.", "name": "LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "dialogue", "text": "Pia, he--", "name": "KOFI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "He's cold, Kofi. Get the blanket.", "name": "LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "action", "text": "Kofi runs.", "para": 17, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "His steps ring down the deck.", "para": 17, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "dialogue", "text": "She'd have liked the crossing.", "name": "HENRIK", "speaker": 3, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "Lindqvist says nothing.", "para": 18, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "The engines catch, a long low shudder through the steel.", "para": 18, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "action", "text": "The ramp groans, halts, and holds.", "para": 18, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "dialogue", "text": "Is it always this loud?", "name": "HENRIK", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "dialogue", "text": "You get used to it.", "name": "LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "dialogue", "text": "I don't think I will.", "name": "HENRIK", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "action", "text": "Blue lights bloom against the bow doors.", "para": 19, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "action", "text": "Rain slants through them.", "para": 19, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 84, "kind": "action", "text": "Lindqvist crouches, torch lowered.", "para": 20, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 85, "kind": "action", "text": "Henrik looks up at her, face wet and open, nothing left in it to hide.", "para": 20, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 86, "kind": "dialogue", "text": "I've got it! I've got the blanket!", "name": "KOFI", "speaker": 2, "ext": ["O.S."], "paren": ["running back"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 87, "kind": "action", "text": "He skids in, drapes it around Henrik's shoulders.", "para": 21, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 88, "kind": "action", "text": "Henrik pulls it tight.", "para": 21, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 89, "kind": "dialogue", "text": "Thank you.", "name": "HENRIK", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 90, "kind": "dialogue", "text": "Yeah.", "name": "KOFI", "speaker": 2, "ext": [], "paren": ["stiff"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 91, "kind": "action", "text": "Footsteps on the ramp.", "para": 22, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 92, "kind": "action", "text": "Many.", "para": 22, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 93, "kind": "action", "text": "Lindqvist stands.", "para": 22, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 94, "kind": "dialogue", "text": "Here we go.", "name": "LINDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 95, "kind": "action", "text": "She steps aside.", "para": 23, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 96, "kind": "action", "text": "The police come into the light.", "para": 23, "sent": 1, "present": [0, 1, 2, 3]}]}