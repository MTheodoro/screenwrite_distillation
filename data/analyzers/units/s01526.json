{"scene_id": "s01526", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01526.fountain", "heading": "INT. COMMUNITY LAUNDROMAT-TURNED-CO-WORKING SPACE - DAY", "cast": [{"id": 0, "name": "GREG", "names": ["GREG"], "gender": "?", "first": 5, "spoke": 12}, {"id": 1, "name": "ABERNATHY-LIU", "names": ["ABERNATHY-LIU"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "TAMSIN HOLLOWAY", "names": ["TAMSIN HOLLOWAY", "TAMSIN"], "gender": "?", "first": 7, "spoke": 4}, {"id": 3, "name": "OSWALDO PINTO", "names": ["OSWALDO PINTO", "OSWALDO"], "gender": "?", "first": 8, "spoke": 7}, {"id": 4, "name": "FATIMA AL-RASHID", "names": ["FATIMA AL-RASHID", "FATIMA"], "gender": "?", "first": 9, "spoke": 4}, {"id": 5, "name": "KEN", "names": ["KEN"], "gender": "?", "first": 10, "spoke": 5}, {"id": 6, "name": "BOATENG", "names": ["BOATENG"], "gender": "?", "first": 10, "spoke": 0}, {"id": 7, "name": "ROSALIND MCCREADY", "names": ["ROSALIND MCCREADY", "ROSALIND"], "gender": "f", "first": 11, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. COMMUNITY LAUNDROMAT-TURNED-CO-WORKING SPACE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Washers and dryers still line the walls, now labeled \"Focus Pods.\"", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Beanbags sit on folding tables.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A neon sign reads: SYNERGY SPIN.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "At a long table, a quarterly planning meeting is underway.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "GREGORY \"GREG\" ABERNATHY-LIU, 40s, founder, pacing in a gilet.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "He holds a clicker connected to nothing.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "TAMSIN HOLLOWAY, 30s, head of People, takes minutes on a laptop with a sticker reading \"Be Kind.\"", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "OSWALDO PINTO, 50s, finance, eats an apple methodically and watches the spreadsheet on the wall.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "FATIMA AL-RASHID, 20s, junior designer, sits very still on a beanbag, holding a mug in both hands.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "KENNETH \"KEN\" BOATENG, 30s, engineer, has headphones around his neck and a drying rack sock stuck to his sleeve.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "action", "text": "At the end of the table, ROSALIND MCCREADY, 60s, investor, in a trench coat, listens without taking it off.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 12, "kind": "dialogue", "text": "So, Q3. Big wins. Big, big wins.", "name": "GREG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 13, "kind": "dialogue", "text": "We lost forty thousand dollars.", "name": "OSWALDO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 14, "kind": "dialogue", "text": "In a growth mindset, that's investment.", "name": "GREG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 15, "kind": "dialogue", "text": "In a finance mindset, that's forty thousand dollars.", "name": "OSWALDO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 16, "kind": "dialogue", "text": "Let's hold space for both framings.", "name": "TAMSIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 17, "kind": "dialogue", "text": "Can we hold space for the dryer? It's been beeping for ten minutes.", "name": "KEN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 18, "kind": "dialogue", "text": "It's mine. It has my lunch in it.", "name": "FATIMA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 19, "kind": "dialogue", "text": "Why is your lunch in a dryer?", "name": "KEN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 20, "kind": "dialogue", "text": "It's the only thing that gets warm.", "name": "FATIMA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 21, "kind": "action", "text": "Rosalind sets down her pen.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 22, "kind": "dialogue", "text": "Greg, what is the burn rate?", "name": "ROSALIND", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 23, "kind": "dialogue", "text": "Healthy.", "name": "GREG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 24, "kind": "dialogue", "text": "Fourteen thousand a month.", "name": "OSWALDO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 25, "kind": "dialogue", "text": "And revenue?", "name": "ROSALIND", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 26, "kind": "dialogue", "text": "We're pre-revenue.", "name": "GREG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 27, "kind": "dialogue", "text": "We're pre-everything.", "name": "OSWALDO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 28, "kind": "dialogue", "text": "Oswaldo, let's try to stay solutions-oriented.", "name": "TAMSIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 29, "kind": "dialogue", "text": "The solution is a loan officer.", "name": "OSWALDO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "action", "text": "Greg clicks the clicker.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "action", "text": "Nothing happens.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "action", "text": "He clicks harder.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "dialogue", "text": "This is our roadmap.", "name": "GREG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "action", "text": "The wall flashes.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "action", "text": "A slide: a drawing of a washing machine with a rocket strapped to it.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "dialogue", "text": "I drew that at two a.m.", "name": "FATIMA", "speaker": 4, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "dialogue", "text": "It is... bold.", "name": "ROSALIND", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "dialogue", "text": "Thank you, Rosalind.", "name": "GREG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "dialogue", "text": "That was not praise.", "name": "ROSALIND", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "dialogue", "text": "Does the rocket actually work?", "name": "KEN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 41, "kind": "dialogue", "text": "It's a metaphor.", "name": "GREG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 42, "kind": "dialogue", "text": "For what?", "name": "KEN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 43, "kind": "dialogue", "text": "For ascent.", "name": "GREG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 44, "kind": "dialogue", "text": "Of the debt.", "name": "OSWALDO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 45, "kind": "action", "text": "Tamsin types it down.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 46, "kind": "action", "text": "Deletes it.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 47, "kind": "action", "text": "Types it again.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 48, "kind": "dialogue", "text": "I'm recording \"alignment challenges.\"", "name": "TAMSIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 49, "kind": "dialogue", "text": "Record that I'm leaving in five minutes.", "name": "ROSALIND", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 50, "kind": "dialogue", "text": "We haven't done the offsite.", "name": "GREG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 51, "kind": "dialogue", "text": "Where is the offsite?", "name": "ROSALIND", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 52, "kind": "dialogue", "text": "Also here. Tomorrow. With cake.", "name": "GREG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 53, "kind": "dialogue", "text": "Is the cake in the dryer?", "name": "FATIMA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 54, "kind": "action", "text": "Ken laughs.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 55, "kind": "action", "text": "Stops.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 56, "kind": "action", "text": "Looks at Greg, who is not laughing.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 57, "kind": "dialogue", "text": "Sorry.", "name": "KEN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 58, "kind": "dialogue", "text": "We don't apologise for joy at Synergy Spin.", "name": "GREG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 59, "kind": "dialogue", "text": "We apologise for invoices.", "name": "OSWALDO", "speaker": 3, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 60, "kind": "action", "text": "The dryer buzzes for the last time.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 61, "kind": "action", "text": "Fatima rises, opens its round door, and pulls out a steaming paper bag.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 62, "kind": "action", "text": "She sets it on the table and unfolds it carefully.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 63, "kind": "action", "text": "A sandwich.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 64, "kind": "action", "text": "Slightly flattened.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 65, "kind": "action", "text": "Warm.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 66, "kind": "action", "text": "She offers half to Rosalind.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 67, "kind": "action", "text": "Rosalind studies it.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 68, "kind": "action", "text": "Takes it.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 69, "kind": "dialogue", "text": "This is the best thing I have seen all quarter.", "name": "ROSALIND", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 70, "kind": "dialogue", "text": "We have a roadmap.", "name": "GREG", "speaker": 0, "ext": [], "paren": ["stricken"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 71, "kind": "dialogue", "text": "You have a sandwich.", "name": "ROSALIND", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 72, "kind": "action", "text": "She bites into it.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 73, "kind": "action", "text": "Greg turns back to the wall, clicker raised, and the rocket flashes on, and on.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 74, "kind": "dialogue", "text": "Moving to Q4.", "name": "TAMSIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}