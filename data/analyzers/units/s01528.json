{"scene_id": "s01528", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01528.fountain", "heading": "INT. LIGHTHOUSE KEEPER'S KITCHEN - NIGHT", "cast": [{"id": 0, "name": "POLLY", "names": ["POLLY"], "gender": "?", "first": 3, "spoke": 4}, {"id": 1, "name": "ADEYEMI-CROSS", "names": ["ADEYEMI-CROSS"], "gender": "?", "first": 3, "spoke": 0}, {"id": 2, "name": "JUNIOR", "names": ["JUNIOR"], "gender": "m", "first": 5, "spoke": 4}, {"id": 3, "name": "RADIO", "names": ["RADIO"], "gender": "?", "first": 7, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. LIGHTHOUSE KEEPER'S KITCHEN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A storm shakes the shutters.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A radio crackles on the table beside a cold stew.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "LEOPOLDINA \"POLLY\" ADEYEMI-CROSS, 60s, grips the edge of the sink.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "She is looking at nothing.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Her son JUNIOR, 30s, stands in the doorway with a duffel bag, rain on his shoulders.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "He doesn't take another step.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Coast guard to Beacon Nine. Polly, do you copy? Over.", "name": "RADIO", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "She doesn't answer.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "He crosses to the table and lifts the handset.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "It's Junior. She's here.", "name": "JUNIOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Junior. The Marguerite went down off the point. Your father's boat. We have two survivors. Not him yet. Over.", "name": "RADIO", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "He puts it down.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Doesn't release it.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "She turns.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Say it.", "name": "POLLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Mama.", "name": "JUNIOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Say what they said.", "name": "POLLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Not him yet.", "name": "JUNIOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "She hurls the stew bowl at the wall.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "It shatters.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "He flinches but does not move.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "She slumps into a chair, breathing hard.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "He kneels before her.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Takes her hands.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Don't you dare.", "name": "POLLY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Mama, I'm here.", "name": "JUNIOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Light the lamp.", "name": "POLLY", "speaker": 0, "ext": [], "paren": ["small"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "He nods.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Rises, crosses to the stairs.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "She watches him go up into the dark.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}]}