{"scene_id": "s01529", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01529.fountain", "heading": "INT. BOWLING ALLEY LEAGUE NIGHT - NIGHT", "cast": [{"id": 0, "name": "RUSSELL KOWALCZYK", "names": ["RUSSELL KOWALCZYK", "RUSSELL"], "gender": "m", "first": 6, "spoke": 6}, {"id": 1, "name": "DARLENE OSEI-WRIGHT", "names": ["DARLENE OSEI-WRIGHT", "DARLENE"], "gender": "?", "first": 9, "spoke": 3}, {"id": 2, "name": "MARIANNE TOUSSAINT", "names": ["MARIANNE TOUSSAINT", "TOUSSAINT", "MARIANNE"], "gender": "?", "first": 11, "spoke": 3}, {"id": 3, "name": "BO", "names": ["BO"], "gender": "m", "first": 13, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. BOWLING ALLEY LEAGUE NIGHT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Lane 7.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Scoreboard flickering.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Beer pitchers sweating.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Pins crash somewhere behind.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Four people at a table bolted to the floor: two couples who used to be friends.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "RUSSELL KOWALCZYK, 40s, wears a team shirt that reads \"Pin Pals.\"", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "He keeps score by hand.", "para": 2, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "Pencil only.", "para": 2, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "DARLENE OSEI-WRIGHT, 40s, his wife, nurses a ginger ale.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She hasn't looked at the scoreboard.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "MARIANNE TOUSSAINT, 40s, sits very straight, purse in lap.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "She is waiting for something.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "BEAUFORT \"BO\" TOUSSAINT, 40s, her husband, lifts the ball from the return and weighs it.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Your frame, Russ.", "name": "BO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Yep.", "name": "RUSSELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "He doesn't rise.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Marianne glances at Darlene.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Darlene studies the carpet.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Russ?", "name": "BO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "I'm thinking.", "name": "RUSSELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "He's always thinking when he's winning.", "name": "DARLENE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "He's not winning.", "name": "RUSSELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Who isn't?", "name": "MARIANNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Nobody. Forget it.", "name": "RUSSELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "The ball clacks back down the return.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Bo catches it.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "He holds it like a small planet.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Eleven pins left standing from the last. Somebody's got to knock them down.", "name": "BO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Marianne stands.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Smooths her skirt.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "I need air.", "name": "MARIANNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "I'll come.", "name": "DARLENE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "No.", "name": "MARIANNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Darlene sits.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Russell's pencil taps the table.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Tap.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Tap.", "para": 9, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Tap.", "para": 9, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "That's a lot of noise for a quiet man.", "name": "BO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "That's a lot of talk for a man who never says anything.", "name": "RUSSELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Say what you mean.", "name": "BO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "I'll say it on the lane.", "name": "RUSSELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "He rises, takes the ball from Bo, and walks to the line.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Bo follows two steps behind.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Darlene half-stands.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Russell throws.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Pins explode.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Strike.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "He turns.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Bo's hand is already on his collar.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Russell shoves him.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Bo shoves back.", "para": 13, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "The table rattles.", "para": 13, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Pitchers slide.", "para": 13, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Darlene grabs a glass and ends up with it in her fist, shaking.", "para": 13, "sent": 6, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Stop it. Stop it!", "name": "DARLENE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "The two men freeze, chest to chest.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "Marianne appears in the doorway, coat on, keys in hand.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "She looks at all three.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "Nobody speaks.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "Beyond them, the pinsetter lowers its rack, and the ten pins stand back up.", "para": 15, "sent": 1, "present": [0, 1, 2, 3]}]}