{"scene_id": "s01530_0", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01530.fountain", "heading": "INT. UNDERGROUND PARKING LEVEL P4 - NIGHT", "cast": [{"id": 0, "name": "NADEZHDA VOLKOVA-REYNOLDS", "names": ["NADEZHDA VOLKOVA-REYNOLDS", "NADEZHDA"], "gender": "f", "first": 4, "spoke": 15}], "units": [{"u": 0, "kind": "heading", "text": "INT. UNDERGROUND PARKING LEVEL P4 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Concrete pillars.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Humming strip lights.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "One car left: a silver sedan with its trunk open.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "NADEZHDA VOLKOVA-REYNOLDS, 30s, trench coat, crouches by the rear wheel.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "A phone in her hand, held flat like a tray.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Her breath fogs.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "She thumbs the screen.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "A voice memo plays.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "Her own voice, recorded earlier, calm and clipped.", "para": 2, "sent": 2, "present": [0]}, {"u": 10, "kind": "dialogue", "text": "If you are hearing this, level four is clear. Listen carefully. Do not skip.", "name": "NADEZHDA", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0]}, {"u": 11, "kind": "dialogue", "text": "I'm not skipping.", "name": "NADEZHDA", "speaker": 0, "ext": [], "paren": ["to the phone"], "dual": false, "present": [0]}, {"u": 12, "kind": "dialogue", "text": "Check the trunk.", "name": "NADEZHDA", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0]}, {"u": 13, "kind": "action", "text": "She stands.", "para": 3, "sent": 0, "present": [0]}, {"u": 14, "kind": "action", "text": "Scans the pillars.", "para": 3, "sent": 1, "present": [0]}, {"u": 15, "kind": "action", "text": "Slowly.", "para": 3, "sent": 2, "present": [0]}, {"u": 16, "kind": "action", "text": "Crosses to the sedan and looks in.", "para": 3, "sent": 3, "present": [0]}, {"u": 17, "kind": "action", "text": "Her face tightens.", "para": 3, "sent": 4, "present": [0]}, {"u": 18, "kind": "dialogue", "text": "Empty.", "name": "NADEZHDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 19, "kind": "dialogue", "text": "Check again.", "name": "NADEZHDA", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0]}, {"u": 20, "kind": "action", "text": "She lifts the felt lining.", "para": 4, "sent": 0, "present": [0]}, {"u": 21, "kind": "action", "text": "Under it, a small black flash drive taped to the floor.", "para": 4, "sent": 1, "present": [0]}, {"u": 22, "kind": "action", "text": "She peels it free.", "para": 4, "sent": 2, "present": [0]}, {"u": 23, "kind": "dialogue", "text": "Got it.", "name": "NADEZHDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 24, "kind": "dialogue", "text": "Good. Now walk to the stairwell. Do not use the elevator.", "name": "NADEZHDA", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0]}, {"u": 25, "kind": "action", "text": "She stops.", "para": 5, "sent": 0, "present": [0]}, {"u": 26, "kind": "action", "text": "Looks at the elevator.", "para": 5, "sent": 1, "present": [0]}, {"u": 27, "kind": "action", "text": "Its numbers are climbing: 1.", "para": 5, "sent": 2, "present": [0]}, {"u": 28, "kind": "action", "text": "2.", "para": 5, "sent": 3, "present": [0]}, {"u": 29, "kind": "action", "text": "3.", "para": 5, "sent": 4, "present": [0]}, {"u": 30, "kind": "dialogue", "text": "Why not the elevator?", "name": "NADEZHDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 31, "kind": "dialogue", "text": "Because I know what I know, and you do not.", "name": "NADEZHDA", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0]}, {"u": 32, "kind": "dialogue", "text": "That's not an answer.", "name": "NADEZHDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 33, "kind": "dialogue", "text": "It is the only one I left you.", "name": "NADEZHDA", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0]}, {"u": 34, "kind": "action", "text": "The numbers climb.", "para": 6, "sent": 0, "present": [0]}, {"u": 35, "kind": "action", "text": "4.", "para": 6, "sent": 1, "present": [0]}, {"u": 36, "kind": "action", "text": "A ping.", "para": 6, "sent": 2, "present": [0]}, {"u": 37, "kind": "action", "text": "The doors slide open on an empty car.", "para": 6, "sent": 3, "present": [0]}, {"u": 38, "kind": "action", "text": "She backs away, heels clicking on concrete.", "para": 7, "sent": 0, "present": [0]}, {"u": 39, "kind": "action", "text": "Footsteps start somewhere behind the pillars.", "para": 7, "sent": 1, "present": [0]}, {"u": 40, "kind": "action", "text": "More than one pair.", "para": 7, "sent": 2, "present": [0]}, {"u": 41, "kind": "action", "text": "Unhurried.", "para": 7, "sent": 3, "present": [0]}, {"u": 42, "kind": "dialogue", "text": "They're here.", "name": "NADEZHDA", "speaker": 0, "ext": [], "paren": ["whisper"], "dual": false, "present": [0]}, {"u": 43, "kind": "dialogue", "text": "Do not turn around.", "name": "NADEZHDA", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0]}, {"u": 44, "kind": "action", "text": "She freezes.", "para": 8, "sent": 0, "present": [0]}, {"u": 45, "kind": "action", "text": "A ceiling camera swivels, tracking her.", "para": 8, "sent": 1, "present": [0]}, {"u": 46, "kind": "dialogue", "text": "I recorded this at two a.m. I was drunk.", "name": "NADEZHDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 47, "kind": "dialogue", "text": "You were sober. You were terrified. Walk.", "name": "NADEZHDA", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0]}, {"u": 48, "kind": "action", "text": "She drops the phone.", "para": 9, "sent": 0, "present": [0]}, {"u": 49, "kind": "action", "text": "Stamps it into splinters.", "para": 9, "sent": 1, "present": [0]}, {"u": 50, "kind": "action", "text": "Sprints for the stairwell, shoulders the steel door, and it slams behind her.", "para": 9, "sent": 2, "present": [0]}]}