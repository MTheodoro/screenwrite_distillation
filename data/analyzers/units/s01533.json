{"scene_id": "s01533", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01533.fountain", "heading": "INT. HOSPITAL ROOFTOP HELIPAD - NIGHT", "cast": [{"id": 0, "name": "EMEKA BALOGUN-HARTE", "names": ["EMEKA BALOGUN-HARTE", "EMEKA"], "gender": "?", "first": 4, "spoke": 14}, {"id": 1, "name": "NURSE ILSE VANDERMEER", "names": ["NURSE ILSE VANDERMEER", "ILSE"], "gender": "?", "first": 9, "spoke": 16}, {"id": 2, "name": "ORDERLY DESHAWN PALMQUIST", "names": ["ORDERLY DESHAWN PALMQUIST", "DESHAWN"], "gender": "?", "first": 27, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOSPITAL ROOFTOP HELIPAD - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Wind.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "City lights below.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A windsock snaps.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. EMEKA BALOGUN-HARTE, 50s, scrubs under a parka, sits on a bench with a paper cup.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Alone.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Steam rises from the coffee.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "The stairwell door clangs.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "A young woman steps out, hood up.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "NURSE ILSE VANDERMEER, 20s, badge swinging.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She sits beside him without asking.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Quiet night.", "name": "ILSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Don't say that.", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Sorry.", "name": "ILSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She pulls her hands into her sleeves.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "They watch the city.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Mrs. Okoro's husband brought her flowers.", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Bed twelve.", "name": "ILSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Yes.", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "They're pretty.", "name": "ILSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Tulips.", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Her favourite, he said.", "name": "ILSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "He nods.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Sips.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Sets the cup down on the bench.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Turns it a quarter turn.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "The stairwell door bangs.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "ORDERLY DESHAWN PALMQUIST, 20s, scrubs, out of breath, leans out.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Doctor, they're asking for you on twelve.", "name": "DESHAWN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "A pager chirps.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Neither Emeka nor Ilse moves.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "That's yours.", "name": "ILSE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "I know.", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Aren't you going to--", "name": "ILSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "In a minute.", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "The pager chirps again.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Louder.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "He silences it.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Folds his hands.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Doctor?", "name": "ILSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Twenty-two years. I still can't tell them on a bad night. I wait for a good one.", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Tell them what?", "name": "ILSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "He doesn't answer.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Looks at her.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Then at the stairwell door.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Doctor Balogun-Harte. What did the scan show?", "name": "ILSE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Not on the rooftop.", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Is it her?", "name": "ILSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Ilse.", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Is it Mrs. Okoro?", "name": "ILSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "He stands.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Picks up the cup.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Drops it into the bin without drinking.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "The coffee splashes the rim.", "para": 10, "sent": 3, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "She asked me this afternoon whether she could go home Friday.", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "And you said?", "name": "ILSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "I said we would see.", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "You said \"we would see.\"", "name": "ILSE", "speaker": 1, "ext": [], "paren": ["a beat"], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "I said it very kindly.", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Ilse stands too.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "Her hands emerge from her sleeves, one tucking a lock of hair behind her ear, the other gripping the bench rail.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Does the husband know?", "name": "ILSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "Not yet.", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "Those tulips.", "name": "ILSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "I know.", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "The windsock snaps.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "The wind rises.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "Down in the city a siren begins and fades.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "He opens the stairwell door and holds it for her.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "She walks through without a word.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "He follows.", "para": 13, "sent": 2, "present": [0, 1, 2]}, {"u": 71, "kind": "action", "text": "The door closes on the rooftop, the bench, the bin with the spilled coffee.", "para": 13, "sent": 3, "present": [0, 1, 2]}]}