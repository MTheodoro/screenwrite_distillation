{"scene_id": "s01535", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01535.fountain", "heading": "INT. FARMHOUSE KITCHEN - EARLY MORNING", "cast": [{"id": 0, "name": "ANNELIESE FOSSEGARD-MBEKI", "names": ["ANNELIESE FOSSEGARD-MBEKI", "ANNELIESE"], "gender": "?", "first": 5, "spoke": 19}, {"id": 1, "name": "ANDREAS FOSSEGARD", "names": ["ANDREAS FOSSEGARD", "ANDREAS"], "gender": "m", "first": 5, "spoke": 19}], "units": [{"u": 0, "kind": "heading", "text": "INT. FARMHOUSE KITCHEN - EARLY MORNING", "present": []}, {"u": 1, "kind": "action", "text": "A low-beamed room that smells of woodsmoke and old bread.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Frost climbs the window glass.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The range ticks as it warms.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A pot of porridge sits uncovered at the back of the stove, a skin forming.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "At the table, ANNELIESE FOSSEGARD-MBEKI, 17, in a school coat buttoned to the chin, sits upright with her satchel on her knees.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Her boots are already laced.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "A rucksack waits by the door.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Her father, ANDREAS FOSSEGARD, 50s, thick-fingered, in his barn jacket, stands at the stove and stirs the porridge with a wooden spoon, round and round, long past the point of need.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "There's honey.", "name": "ANDREAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I'm fine.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "You'll want something in you for the bus.", "name": "ANDREAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I had toast.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Toast isn't food.", "name": "ANDREAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "It's what Mum used to say.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "The spoon stops.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Starts again.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He lifts the pot and tips porridge into a bowl, sets it before her, and sits across, facing the door instead of her.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Eat, Annie.", "name": "ANDREAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She lifts the spoon.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Lowers it.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "A clock above the dresser ticks, loud as a hammer.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "The coach leaves at seven.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "I know when it leaves.", "name": "ANDREAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "It's twenty past six.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I can tell time.", "name": "ANDREAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Could have fooled me.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": ["muttering, to the porridge"], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "He doesn't ask her to repeat it.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "His jaw works.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Outside, a cow lows, and a gate bangs in the wind.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Calves'll want feeding.", "name": "ANDREAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Jonas will do it.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Jonas is eleven.", "name": "ANDREAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "He's good with them.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "He's eleven, Annie.", "name": "ANDREAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "I was eleven.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "And look what it got you.", "name": "ANDREAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "She stands.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "The chair scrapes.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "She slings the satchel over her shoulder, crosses to the door, and picks up the rucksack.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Her hand on the latch.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Be ready, Annie.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": ["to the empty hall, quietly"], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "What did you say?", "name": "ANDREAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Nothing. I said I'll write.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "You won't.", "name": "ANDREAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "I will.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Your mother said she'd write.", "name": "ANDREAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "The word lands.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Anneliese stands very still with her back to him.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "The range ticks.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "The porridge sits, untouched.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "She did write, Dad.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Three letters in nine years.", "name": "ANDREAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "You burned two.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "I did not.", "name": "ANDREAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "I found the ash.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "He is on his feet.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "The spoon clatters to the floor.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "Neither of them moves to pick it up.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "You've got your mother's mouth.", "name": "ANDREAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "You've got her coat.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "His eyes drop.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "He is wearing, under the barn jacket, a grey cardigan with a darned elbow.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "Her cardigan.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "Get out.", "name": "ANDREAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "I'm going.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "Then go.", "name": "ANDREAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "Dad.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": ["opening the door"], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "Go, Annie. Go on.", "name": "ANDREAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "She stands in the doorway, the white morning on her face.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 70, "kind": "action", "text": "Doesn't turn.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 71, "kind": "dialogue", "text": "Eat the porridge.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "She steps out.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "The door swings shut.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 74, "kind": "action", "text": "He stands in the silence, then lowers himself into her chair, takes up her spoon, and eats.", "para": 11, "sent": 2, "present": [0, 1]}]}