{"scene_id": "s01536", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01536.fountain", "heading": "INT. OFFSHORE OIL RIG CONTROL ROOM - NIGHT", "cast": [{"id": 0, "name": "TOBIAS HALVORSEN-ABIOLA", "names": ["TOBIAS HALVORSEN-ABIOLA", "TOBIAS"], "gender": "?", "first": 5, "spoke": 20}, {"id": 1, "name": "ROSIE", "names": ["ROSIE"], "gender": "?", "first": 8, "spoke": 15}, {"id": 2, "name": "ENGSTROM", "names": ["ENGSTROM"], "gender": "?", "first": 8, "spoke": 0}, {"id": 3, "name": "COMMS", "names": ["COMMS"], "gender": "?", "first": 28, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. OFFSHORE OIL RIG CONTROL ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A bank of dim monitors.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rain hammers the porthole.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A kettle on a hotplate.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The structure creaks.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "TOBIAS HALVORSEN-ABIOLA, 40s, rig supervisor, in a grease-stained coverall, reads a gauge.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "His thumbnail taps the glass.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "The needle isn't moving.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "At the next console, ROSALIE \"ROSIE\" ENGSTROM, 20s, hard hat on the back of her head, logs numbers on a clipboard.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "She hums under her breath.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Rosie. Pressure on well three.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Steady at four-ten.", "name": "ROSIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "It was four-twenty an hour ago.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Sensor drift. It does that.", "name": "ROSIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Does it?", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Sometimes.", "name": "ROSIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "He crosses to her console.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Looks over her shoulder.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "She tilts the clipboard toward him.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Your numbers say four-ten for six hours.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Because it's been four-ten for six hours.", "name": "ROSIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "And the live gauge?", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "She looks at the screen.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Her humming stops.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Four-oh-five.", "name": "ROSIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Four-oh-five.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "It's within tolerance.", "name": "ROSIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Is it?", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Control, this is Deck Two. We have a smell down here. Over.", "name": "COMMS", "speaker": 3, "ext": ["V.O."], "paren": ["crackling"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Tobias lifts the handset from its cradle.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "What kind of smell, Deck Two?", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Like eggs, Toby. Like rotten eggs. Over.", "name": "COMMS", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Tobias freezes.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Rosie sets the clipboard down very slowly.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Hydrogen sulphide.", "name": "ROSIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Don't say it.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Toby, that's--", "name": "ROSIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "I know what it is. Don't say it out loud.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "He thumbs the handset.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Deck Two, evacuate your station. Use the breathing apparatus. Do not run.", "name": "TOBIAS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Copy. Evacuating. Over.", "name": "COMMS", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "He hangs up.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Turns.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Rosie is already at the alarm panel, hand over the glass.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Do I pull it?", "name": "ROSIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Not yet.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Toby!", "name": "ROSIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "If we pull it, a hundred and twenty men run for the lifeboats, and the lifeboats take sixty.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Then we do it in order.", "name": "ROSIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "In order.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "He steps to the wall mic.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Takes a breath that shakes only a little.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "All hands, this is Halvorsen. We have a gas alert on Deck Two. Muster at stations. Walk, do not run. Repeat, walk.", "name": "TOBIAS", "speaker": 0, "ext": ["CONT'D"], "paren": ["into the mic"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "A distant clang.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Boots on steel.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Voices rising.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "You said \"walk.\"", "name": "ROSIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "They'll walk fast.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "Toby, the gauge.", "name": "ROSIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "He looks.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "The needle on well three leaps, quivers, and plunges.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "Pull it.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "She smashes the glass and pulls the lever.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "Sirens howl through the whole structure.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "The lights go red.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "Please let the lines hold.", "name": "TOBIAS", "speaker": 0, "ext": ["CONT'D"], "paren": ["not loud, to himself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "They'll hold.", "name": "ROSIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "How do you know?", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "Because I checked them this morning.", "name": "ROSIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "He closes his eyes for one second.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "Opens them.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "Grabs the clipboard, her pen, her sleeve.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "Come on.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "action", "text": "They run into the red corridor.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}]}