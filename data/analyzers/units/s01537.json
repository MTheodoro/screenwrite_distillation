{"scene_id": "s01537", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01537.fountain", "heading": "INT. MUSEUM OF CLOCKS - NIGHT", "cast": [{"id": 0, "name": "MADAME ODETTE FONTAINE-ABARA", "names": ["MADAME ODETTE FONTAINE-ABARA", "ODETTE"], "gender": "?", "first": 4, "spoke": 2}, {"id": 1, "name": "GUS", "names": ["GUS"], "gender": "?", "first": 5, "spoke": 2}, {"id": 2, "name": "RUDZINSKI", "names": ["RUDZINSKI"], "gender": "?", "first": 5, "spoke": 0}, {"id": 3, "name": "LI WEI-NAKAMURA", "names": ["LI WEI-NAKAMURA", "LI"], "gender": "?", "first": 7, "spoke": 2}, {"id": 4, "name": "THEO BRANDT", "names": ["THEO BRANDT", "THEO"], "gender": "?", "first": 8, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. MUSEUM OF CLOCKS - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Hundreds of clocks ticking out of step.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Moonlight on brass.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Four figures in black stand before a glass case holding a jewelled pocket watch.", "para": 1, "sent": 0, "present": []}, {"u": 4, "kind": "action", "text": "MADAME ODETTE FONTAINE-ABARA, 50s, elegant, gloves on, studies the lock.", "para": 2, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "AUGUST \"GUS\" RUDZINSKI, 30s, enormous, holds a duffel.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "He sweats.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "LI WEI-NAKAMURA, 20s, crouches at the alarm box, tools laid out like surgical instruments.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "THEO BRANDT, 40s, nervous, glances at the corridor.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Thirty seconds.", "name": "LI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Take twenty-nine.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "She taps the glass.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "He nods without looking up.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "The guard comes at two.", "name": "THEO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "It's one fifty-eight.", "name": "GUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Which clock?", "name": "THEO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "All of them.", "name": "GUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "They all look around.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "The clocks disagree by hours.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Quiet.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "The alarm box clicks.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "A green light.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Done.", "name": "LI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "She lifts the glass.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "He lowers the watch into the duffel with enormous tenderness.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Footsteps.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "A flashlight sweeps the doorway.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "All four freeze.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "He holds his breath.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "She extinguishes her torch.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "They duck behind the case as one.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "The beam passes.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "A cough.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "The footsteps retreat.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Odette exhales.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Raises two fingers.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "They slip out, one by one, into the night.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4]}]}