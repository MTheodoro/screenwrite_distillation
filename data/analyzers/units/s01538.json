{"scene_id": "s01538", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01538.fountain", "heading": "EXT. ABANDONED DRIVE-IN THEATRE - NIGHT", "cast": [{"id": 0, "name": "NEELY", "names": ["NEELY"], "gender": "?", "first": 4, "spoke": 15}, {"id": 1, "name": "JAMES-OKONKWO", "names": ["JAMES-OKONKWO"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "LUCY", "names": ["LUCY"], "gender": "m", "first": 6, "spoke": 12}, {"id": 3, "name": "ARAUJO-PRICE", "names": ["ARAUJO-PRICE"], "gender": "?", "first": 6, "spoke": 0}, {"id": 4, "name": "OLD BARN", "names": ["OLD BARN"], "gender": "?", "first": 44, "spoke": 6}, {"id": 5, "name": "HOLLINGSWORTH", "names": ["HOLLINGSWORTH"], "gender": "?", "first": 44, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ABANDONED DRIVE-IN THEATRE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cracked lot of weeds and speaker posts.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A huge screen, blank and peeling, glows faintly under the moon.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "On the hood of a rust-pitted pickup, two teenagers share a thermos.", "para": 1, "sent": 0, "present": []}, {"u": 4, "kind": "action", "text": "CORNELIUS \"NEELY\" JAMES-OKONKWO, 17, in a letterman jacket two sizes too big, pours coffee into the cap.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "He is trying very hard to look relaxed.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Beside him, LUCINDA \"LUCY\" ARAUJO-PRICE, 17, in a flannel and combat boots, swings her legs and counts stars.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Dad used to bring me here.", "name": "NEELY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Before they closed it?", "name": "LUCY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Before everything.", "name": "NEELY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "What did you watch?", "name": "LUCY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Whatever was on. Monster movies, mostly.", "name": "NEELY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Scary?", "name": "LUCY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Not to him.", "name": "NEELY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "She laughs.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Takes the cap.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Sips.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Makes a face.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "This is terrible.", "name": "LUCY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "It's my grandmother's recipe.", "name": "NEELY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Your grandmother hated you.", "name": "LUCY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Possibly.", "name": "NEELY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "They sit.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Crickets.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "The screen creaks in the wind.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "I leave Friday.", "name": "LUCY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "I know.", "name": "NEELY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "You're not going to say anything?", "name": "LUCY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "I'm saying it. I'm saying \"I know.\"", "name": "NEELY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "That's not saying.", "name": "LUCY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "It's most of what I've got.", "name": "NEELY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "She hands back the cap.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Their fingers touch.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Neither pulls away.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "There's a car.", "name": "LUCY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Where?", "name": "NEELY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Behind the screen. Headlights.", "name": "LUCY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "He looks.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Two white eyes crawl along the fence line.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Probably nothing.", "name": "NEELY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "It's stopping.", "name": "LUCY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "The headlights go dark.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "A door opens.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "A figure walks toward them across the lot, hands in pockets.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "BARNABY \"OLD BARN\" HOLLINGSWORTH, 60s, in a security jacket, flashlight swinging, whistling a tuneless song.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Evening, kids.", "name": "OLD BARN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Evening, Mr. Hollingsworth.", "name": "NEELY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "Thought I'd find you here.", "name": "OLD BARN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "You knew?", "name": "NEELY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "Your father told me. Before he passed.", "name": "OLD BARN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "Neely goes quiet.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Lucy touches his sleeve.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "He said, \"If the boy ever comes out here with somebody, tell him there's a reel in the projection booth. Third shelf. Marked 'Neely.'\"", "name": "OLD BARN", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "A reel.", "name": "NEELY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "He never said what's on it.", "name": "OLD BARN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "Is the projector--", "name": "NEELY", "speaker": 0, "ext": [], "paren": ["slowly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "Still works. I oiled her last week. Don't ask me why.", "name": "OLD BARN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "Lucy slides off the hood.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "Takes Neely's hand.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "Come on.", "name": "LUCY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "action", "text": "They cross the lot, Old Barn lighting the way.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "The flashlight beam swings across the blank screen and, far above, the first flicker of an old image begins to shimmer.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}