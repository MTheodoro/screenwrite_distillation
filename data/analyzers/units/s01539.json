{"scene_id": "s01539", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01539.fountain", "heading": "INT. MOSS THRONE ROOM OF THE WILLOW KING - DAY", "cast": [{"id": 0, "name": "KING ALDERMERE GREEN", "names": ["KING ALDERMERE GREEN", "ALDERMERE"], "gender": "?", "first": 5, "spoke": 3}, {"id": 1, "name": "SIORA", "names": ["SIORA"], "gender": "?", "first": 6, "spoke": 2}, {"id": 2, "name": "BRONWYN", "names": ["BRONWYN"], "gender": "?", "first": 6, "spoke": 1}, {"id": 3, "name": "TANSY", "names": ["TANSY"], "gender": "?", "first": 6, "spoke": 1}, {"id": 4, "name": "BRAMBLE", "names": ["BRAMBLE"], "gender": "?", "first": 6, "spoke": 1}, {"id": 5, "name": "IVO", "names": ["IVO"], "gender": "m", "first": 6, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. MOSS THRONE ROOM OF THE WILLOW KING - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A hollow inside a colossal willow.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Roots coil into pillars.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Glowworms hang like chandeliers.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Dew drips into a stone basin.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "KING ALDERMERE THE GREEN, ancient, bark-skinned, crowned with antlers, sits upon a throne of woven roots.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Before him kneel five petitioners: a fox-faced RANGER named SIORA, a hulking BADGER-SMITH named BRONWYN, twin sprites TANSY and BRAMBLE with dragonfly wings, and a hooded MONK named IVO.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 7, "kind": "dialogue", "text": "Speak, children of the glade.", "name": "ALDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "dialogue", "text": "Majesty, the river runs thin.", "name": "SIORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "The fish are gone.", "name": "BRONWYN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Say it softly, sister.", "name": "TANSY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Say it softly, sister.", "name": "BRAMBLE", "speaker": 4, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "They look at each other, annoyed, then back at the king.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "We have come about the stag.", "name": "IVO", "speaker": 5, "ext": [], "paren": ["hood low"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "The stag is dead.", "name": "ALDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "The stag is walking.", "name": "SIORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Glowworms flicker.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "A drop falls in the basin.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Show me.", "name": "ALDERMERE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Ivo lowers his hood.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "From his own skull rise pale antlers dripping moss, and his eyes are dead lamps.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "The king rises.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}