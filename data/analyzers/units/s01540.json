{"scene_id": "s01540", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01540.fountain", "heading": "EXT. ROPE FERRY ON THE SABINE RIVER - NOON", "cast": [{"id": 0, "name": "AMOS", "names": ["AMOS"], "gender": "?", "first": 5, "spoke": 25}, {"id": 1, "name": "TREVELYAN-BELL", "names": ["TREVELYAN-BELL"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "JED", "names": ["JED"], "gender": "m", "first": 7, "spoke": 24}, {"id": 3, "name": "CORVALLIS-ODUYA", "names": ["CORVALLIS-ODUYA"], "gender": "?", "first": 7, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ROPE FERRY ON THE SABINE RIVER - NOON", "present": []}, {"u": 1, "kind": "action", "text": "A flat-bottomed ferry on a hawser strung across a brown, slow river.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cottonwoods on either bank.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The sun beats on warped planks.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A rusted bell hangs from a post.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "AMOS \"OLD HICKORY\" TREVELYAN-BELL, 60s, ferryman, hauls the rope hand over hand, forearms like knotted cord.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "His hat is pulled low.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "On the far end of the deck, leaning against a barrel with a rifle across his knees, sits JEDEDIAH \"JED\" CORVALLIS-ODUYA, 30s, in a duster gone grey with trail dust.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "He has not spoken since they pushed off.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Fare was two bits, Jed.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "I paid it.", "name": "JED", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "You paid it in Mexican coin.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Silver's silver.", "name": "JED", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Not if the marshal says otherwise.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Jed shifts the rifle.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "The barrel catches the sun.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Amos does not look at it.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "He hauls.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "The ferry creeps forward, water slapping the hull.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "You're a long way from Fort Smith.", "name": "AMOS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "So I'm told.", "name": "JED", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "They say a man shot the sheriff there last Thursday.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "They say a lot.", "name": "JED", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "They say he had a scar on his lip.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Jed touches his lip.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "A thin white line, old.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "He lowers the hand slowly.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Lots of men have scars, Hickory.", "name": "JED", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Lots do.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Amos spits over the rail.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Wipes his palm on his trousers.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Reaches for the rope again, and as he does so, his other hand drifts toward a short-handled axe hung from a peg on the post, and rests there, easy, like a man steadying himself on a rail.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Jed watches the hand.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Jed's thumb finds the hammer of the rifle.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Neither of them moves.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "A heron lifts from the reeds, unfolds, and passes across the sun.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "That axe for the rope?", "name": "JED", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "For the rope.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Rope looks fine.", "name": "JED", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "It's a precaution.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Against what?", "name": "JED", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Against men who ask a lot of questions about axes.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Jed almost smiles.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Thumb drops from the hammer.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "He rests the rifle on his knees again, barrel to the sky.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "I never shot a sheriff, Hickory.", "name": "JED", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "I never said you did.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "You said a man with a scar.", "name": "JED", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "I said a lot of things.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "I shot his deputy.", "name": "JED", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "The bell on the post tolls once, nudged by a gust.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Amos' hand stops on the axe.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "That a confession?", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "It's a weather report.", "name": "JED", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Deputy a good man?", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "He had a wife in Muskogee. He told me so, twice, before it started.", "name": "JED", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "That doesn't answer me.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "No. It doesn't.", "name": "JED", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "The ferry nears midstream.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "The current tugs the hull.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "The rope hums.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "Amos lets it run slack, and the deck tilts slowly with the river.", "para": 9, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "You know I'd be in my rights to put you in the water.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "You would.", "name": "JED", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "You know I'd be in my rights to take that rifle.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "You'd be in your rights to try.", "name": "JED", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "Amos unhooks the axe.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "Holds it by the head, handle down, as if offering it.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "Jed looks at the handle.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "At Amos' eyes.", "para": 10, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "He does not take it.", "para": 10, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "dialogue", "text": "Four hundred dollars, Jed. That's the paper on you.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "I know the figure.", "name": "JED", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "My boy's in the territorial prison. Four hundred dollars would buy him a lawyer.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "dialogue", "text": "Then you'd best cut the rope and let the river carry me back across.", "name": "JED", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "dialogue", "text": "And if I don't?", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "dialogue", "text": "Then we both get to the far bank, and you forget my coin was Mexican.", "name": "JED", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "Silence.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "action", "text": "The cottonwoods hiss.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "action", "text": "The ferry drifts.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "action", "text": "Amos stares at the water, at the axe, at the bank still thirty yards off.", "para": 11, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "action", "text": "He hangs the axe back on its peg.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "dialogue", "text": "Silver's silver.", "name": "AMOS", "speaker": 0, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "action", "text": "He bends to the rope and hauls, and the ferry begins to move again, slow and steady, toward the far shore.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 84, "kind": "dialogue", "text": "Thank you, Hickory.", "name": "JED", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 85, "kind": "dialogue", "text": "Don't thank me. Pull the rope.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 86, "kind": "action", "text": "Jed lays the rifle across the barrel, stands, and takes hold of the line behind Amos.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 87, "kind": "action", "text": "They haul together.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 88, "kind": "action", "text": "The bell clangs with each pull, the sun hangs straight overhead, and the bank slides slowly nearer.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 89, "kind": "dialogue", "text": "Where's your boy held?", "name": "JED", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 90, "kind": "dialogue", "text": "Huntsville.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 91, "kind": "dialogue", "text": "I'll send a letter. To a man I know.", "name": "JED", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 92, "kind": "dialogue", "text": "Don't promise what you can't do.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 93, "kind": "dialogue", "text": "I never do.", "name": "JED", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 94, "kind": "action", "text": "The ferry bumps the landing.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 95, "kind": "action", "text": "Mud sucks at the hull.", "para": 15, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 96, "kind": "action", "text": "Jed steps over the rail, onto the bank.", "para": 15, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 97, "kind": "action", "text": "He looks back once.", "para": 15, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 98, "kind": "action", "text": "Amos has already turned the ferry's nose toward the other side.", "para": 15, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 99, "kind": "dialogue", "text": "So long, Hickory.", "name": "JED", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 100, "kind": "dialogue", "text": "Go on, Jed. Before I change my mind.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 101, "kind": "action", "text": "Jed walks up the bank into the cottonwoods.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 102, "kind": "action", "text": "Amos hauls the rope home, alone.", "para": 16, "sent": 1, "present": [0, 1, 2, 3]}]}