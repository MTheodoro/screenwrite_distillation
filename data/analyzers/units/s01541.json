{"scene_id": "s01541", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01541.fountain", "heading": "INT. ORBITAL SEED VAULT - HYDROPONIC RING - NIGHT CYCLE", "cast": [{"id": 0, "name": "TECHNICIAN LAKSHMI OSEI-VANTERPOOL", "names": ["TECHNICIAN LAKSHMI OSEI-VANTERPOOL", "LAKSHMI"], "gender": "?", "first": 5, "spoke": 17}, {"id": 1, "name": "INSPECTOR", "names": ["INSPECTOR"], "gender": "m", "first": 7, "spoke": 10}, {"id": 2, "name": "STATION", "names": ["STATION"], "gender": "?", "first": 18, "spoke": 9}, {"id": 3, "name": "AMBROSE", "names": ["AMBROSE"], "gender": "?", "first": 61, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. ORBITAL SEED VAULT - HYDROPONIC RING - NIGHT CYCLE", "present": []}, {"u": 1, "kind": "action", "text": "A curved corridor of glass tubes, each filled with pale roots in blue-lit water.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Condensation beads on every surface.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A low pump drones.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The floor curves upward in both directions, so that the far end appears to climb into the ceiling.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "TECHNICIAN LAKSHMI OSEI-VANTERPOOL, 30s, in a grey jumpsuit with a seed-bank logo, kneels at an open access panel, a handheld scanner in one hand.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Beside her, a stranger in a clean-room suit stands, hood up, visor opaque.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "THE INSPECTOR, tall, thin.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "The suit has no name patch.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Your clearance was not in the log.", "name": "LAKSHMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "It was filed this morning.", "name": "INSPECTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "By whom?", "name": "LAKSHMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "By the station.", "name": "INSPECTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "The station doesn't file clearances.", "name": "LAKSHMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "The Inspector tilts his head.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Says nothing.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "The pump drones.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "A bead of condensation rolls down a tube.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Technician Osei-Vanterpool, please confirm status of Tube Forty-Four.", "name": "STATION", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Tube Forty-Four is nominal.", "name": "LAKSHMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Please re-scan.", "name": "STATION", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Lakshmi lifts the scanner.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Aims it at the nearest tube.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "The display blinks red.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Contamination. Slight. Fungal.", "name": "LAKSHMI", "speaker": 0, "ext": [], "paren": ["frowning"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Please quarantine.", "name": "STATION", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "That'll take the whole ring.", "name": "LAKSHMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Please quarantine.", "name": "STATION", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "The Inspector steps forward.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Lays a gloved hand on the glass.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Pale roots bend toward his palm, like plants toward light.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "They don't do that.", "name": "LAKSHMI", "speaker": 0, "ext": ["CONT'D"], "paren": ["whisper"], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "They do for me.", "name": "INSPECTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "He pulls back his hood.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Beneath, a face the colour of old paper, cheeks fine with mycelial threads that glint in the blue light.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "He smiles, and the smile is gentle.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "You're not an inspector.", "name": "LAKSHMI", "speaker": 0, "ext": [], "paren": ["backing up"], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "I was. For a time.", "name": "INSPECTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "What are you?", "name": "LAKSHMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "I think you'd call me the contamination.", "name": "INSPECTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Lakshmi's back hits a tube.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "The glass hums.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "The scanner shrieks in her hand.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Technician. Please evacuate Ring Three.", "name": "STATION", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Seal the doors!", "name": "LAKSHMI", "speaker": 0, "ext": [], "paren": ["to the station"], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Doors sealed.", "name": "STATION", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "I'm still inside!", "name": "LAKSHMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Please confirm: Technician, or specimen?", "name": "STATION", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Lakshmi stares at the Inspector.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "He raises both hands, gloved palms out, peaceable.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "I came here to ask you something.", "name": "INSPECTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Ask.", "name": "LAKSHMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Why did you bury us?", "name": "INSPECTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Lakshmi's breath fogs the glass.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "The roots curl toward her too, soft, patient.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "I don't know what you mean.", "name": "LAKSHMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "Fifty thousand seeds. Forty thousand years of silence. And you left us in the dark.", "name": "INSPECTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "That's what a vault is for.", "name": "LAKSHMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "Is it?", "name": "INSPECTOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "He walks past her, trailing one hand along the tubes.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "At each touch, the water inside turns faintly green.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "My name is Ambrose now. I chose it this week. It's a good name, I think.", "name": "INSPECTOR", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "Ambrose.", "name": "LAKSHMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "Yes. You see? Already you're kinder.", "name": "AMBROSE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "Lakshmi's grip on the scanner loosens.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "She sets it on the floor.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "Slowly.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "Ambrose. What do you want?", "name": "LAKSHMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "To grow.", "name": "AMBROSE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "The tubes glow brighter.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "A low hum swells down the whole curve of the ring.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "Lakshmi looks down the long corridor to the vanishing point and sees every tube, one after another, turn the colour of new leaves.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "Please confirm: Technician, or specimen?", "name": "STATION", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "action", "text": "Lakshmi looks at Ambrose.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "He holds out a hand.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "dialogue", "text": "Specimen.", "name": "LAKSHMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "dialogue", "text": "Doors unsealed. Welcome.", "name": "STATION", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}