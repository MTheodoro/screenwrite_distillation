{"scene_id": "s01542", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01542.fountain", "heading": "INT. DERELICT MINING BARGE - ENGINE DECK - NIGHT", "cast": [{"id": 0, "name": "CAPTAIN ISABELLA RUSSO-ADEBAYO", "names": ["CAPTAIN ISABELLA RUSSO-ADEBAYO", "ISABELLA"], "gender": "m", "first": 5, "spoke": 7}, {"id": 1, "name": "FLORIAN KIPKEMBOI", "names": ["FLORIAN KIPKEMBOI", "FLORIAN"], "gender": "m", "first": 7, "spoke": 4}, {"id": 2, "name": "VOICE", "names": ["VOICE"], "gender": "?", "first": 15, "spoke": 4}, {"id": 3, "name": "DOLLY", "names": ["DOLLY"], "gender": "f", "first": 28, "spoke": 8}, {"id": 4, "name": "ACHEBE-LINDGREN", "names": ["ACHEBE-LINDGREN"], "gender": "?", "first": 28, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. DERELICT MINING BARGE - ENGINE DECK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Stillness.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Pipes sweat.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Emergency strips glow amber along the catwalk.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Nothing moves.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CAPTAIN ISABELLA RUSSO-ADEBAYO, 50s, rests a hand on a cold turbine casing.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her breath hangs in front of her.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Her crewmate FLORIAN KIPKEMBOI, 30s, crouches beside a floor hatch and inspects the seal with a torch.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Pressure's holding.", "name": "FLORIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "It shouldn't be.", "name": "ISABELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "The ship's been dead six years.", "name": "FLORIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Dead ships don't hold pressure.", "name": "ISABELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Florian shrugs.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Taps the hatch.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "A hollow echo rolls out through the deck.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Welcome aboard.", "name": "VOICE", "speaker": 2, "ext": ["O.S."], "paren": ["over the intercom, soft"], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Isabella snaps her head around.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Florian leaps to his feet and aims the torch at a speaker grille on the bulkhead.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Who's that?", "name": "ISABELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I am the barge. I have waited.", "name": "VOICE", "speaker": 2, "ext": ["O.S."], "paren": ["warm"], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "It's a recording.", "name": "FLORIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "It answered me.", "name": "ISABELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Floor hatch, please. Do not open it.", "name": "VOICE", "speaker": 2, "ext": ["O.S."], "paren": ["over the intercom"], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Florian is already kneeling, fingers on the latch.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Isabella lunges for his collar, pulls him back, and the two of them tumble against the rail as the hatch springs open on its own and a ladder drops out of the dark.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "A figure climbs up.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Slowly.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "First a hand, then a shoulder, then a head wrapped in a rag of silver foil.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "COMPUTER TECHNICIAN DOLORES \"DOLLY\" ACHEBE-LINDGREN, 60s, in a patched cardigan and welding goggles, hauls herself onto the deck, wipes her palms, and surveys the two visitors with the air of a landlady inspecting a late rent.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "You're early.", "name": "DOLLY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Early for what?", "name": "ISABELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "The inspection.", "name": "DOLLY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "We're not inspectors.", "name": "FLORIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Then you're squatters. Worse.", "name": "DOLLY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "She waves a spanner at them.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Then at the speaker grille.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Barge. Stand down.", "name": "DOLLY", "speaker": 3, "ext": ["CONT'D"], "paren": ["to the grille"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "I was being hospitable.", "name": "VOICE", "speaker": 2, "ext": ["O.S."], "paren": ["sulking"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "You were being creepy.", "name": "DOLLY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Isabella looks at Florian.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Florian looks at Isabella.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Dolly pushes her goggles onto her forehead and her eyes, tired and amused, settle on each in turn.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Six years I've been down in the bilge, keeping this old girl company. You two are the first living souls through that hatch.", "name": "DOLLY", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "And the barge?", "name": "ISABELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Is lonely. Mind your manners.", "name": "DOLLY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Florian lowers the torch.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Isabella lets out a slow breath.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "Is there tea?", "name": "ISABELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "There's something called tea.", "name": "DOLLY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "She turns and climbs down the ladder, spanner swinging.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Florian follows.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "After a moment, Isabella does too, and the hatch settles shut above them with a soft pneumatic sigh.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}]}