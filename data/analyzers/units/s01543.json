{"scene_id": "s01543", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01543.fountain", "heading": "INT. STARSHIP BRIDGE - ALERT", "cast": [{"id": 0, "name": "CAPTAIN VESNA OKORO", "names": ["CAPTAIN VESNA OKORO", "VESNA"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "HELMSMAN DAVOR PETROSYAN", "names": ["HELMSMAN DAVOR PETROSYAN", "DAVOR"], "gender": "?", "first": 5, "spoke": 3}, {"id": 2, "name": "ENGINEER LOLA MBEKI-HART", "names": ["ENGINEER LOLA MBEKI-HART", "LOLA"], "gender": "?", "first": 6, "spoke": 3}, {"id": 3, "name": "MEDIC TARIQ SANDOVAL", "names": ["MEDIC TARIQ SANDOVAL", "TARIQ"], "gender": "?", "first": 7, "spoke": 2}, {"id": 4, "name": "COMMS OFFICER YUKI ABERNATHY", "names": ["COMMS OFFICER YUKI ABERNATHY", "YUKI"], "gender": "f", "first": 8, "spoke": 2}, {"id": 5, "name": "NAVIGATOR BRIDGET FAIRLEY-ONUOHA", "names": ["NAVIGATOR BRIDGET FAIRLEY-ONUOHA", "BRIDGET"], "gender": "?", "first": 9, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. STARSHIP BRIDGE - ALERT", "present": []}, {"u": 1, "kind": "action", "text": "Red light.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Klaxons.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Six crew at six stations.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CAPTAIN VESNA OKORO, 50s, grips the command rail.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "HELMSMAN DAVOR PETROSYAN, 30s, hammers a console.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "ENGINEER LOLA MBEKI-HART, 40s, hangs half out of a panel.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "MEDIC TARIQ SANDOVAL, 30s, braces against a wall.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "COMMS OFFICER YUKI ABERNATHY, 20s, presses a headset to her ear.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "And NAVIGATOR BRIDGET FAIRLEY-ONUOHA, 50s, who stares at the star map.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Report!", "name": "VESNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Thrusters dead!", "name": "DAVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Core's venting!", "name": "LOLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "We've got breach on deck four!", "name": "TARIQ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Captain, they're hailing!", "name": "YUKI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Ignore it!", "name": "VESNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Captain, if I may--", "name": "BRIDGET", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "We're drifting!", "name": "DAVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Fifteen seconds to cascade!", "name": "LOLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "They're asking for surrender!", "name": "YUKI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Is anyone on four?", "name": "TARIQ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Captain!", "name": "BRIDGET", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Quiet!", "name": "VESNA", "speaker": 0, "ext": [], "paren": ["shouting over them all"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Silence.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Only the klaxon.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "She turns to Bridget.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Bridget points at the map.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "There's a gas giant. Eleven minutes away. We can slingshot.", "name": "BRIDGET", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Davor?", "name": "VESNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "No thrust.", "name": "DAVOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "I can give you one burst.", "name": "LOLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Then give it.", "name": "VESNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Lola slams a lever.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "The ship shudders.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Stars wheel.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "The klaxon dies.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Six faces turn to the main screen, where a vast banded planet swells.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Hold on.", "name": "VESNA", "speaker": 0, "ext": ["CONT'D"], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}