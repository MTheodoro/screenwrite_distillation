{"scene_id": "s01544_0", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01544.fountain", "heading": "INT. ABANDONED RADIO OBSERVATORY - CONTROL ROOM - DAWN", "cast": [{"id": 0, "name": "COLETTE ABIODUN-FENWICK", "names": ["COLETTE ABIODUN-FENWICK", "COLETTE"], "gender": "f", "first": 4, "spoke": 11}, {"id": 1, "name": "CASS", "names": ["CASS"], "gender": "f", "first": 6, "spoke": 12}, {"id": 2, "name": "DRAGOMIR", "names": ["DRAGOMIR"], "gender": "m", "first": 6, "spoke": 0}, {"id": 3, "name": "NESTOR PELLEGRINI-OYELOWO", "names": ["NESTOR PELLEGRINI-OYELOWO", "NESTOR"], "gender": "m", "first": 7, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED RADIO OBSERVATORY - CONTROL ROOM - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Dead consoles.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A dish groans overhead.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Grey light leaks through a shattered window.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "COLETTE ABIODUN-FENWICK, 40s, bleeding from the scalp, sits slumped against a rack of machines.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her pistol lies beside her hand, slide locked back.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Across the room, CASSIUS \"CASS\" DRAGOMIR, 30s, in a torn parka, stands against the far wall with his hands up, a sat phone dangling from one finger.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Between them lies a third figure, face down, motionless: NESTOR PELLEGRINI-OYELOWO, 50s, in a lab coat, one hand still clutching a flash drive.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "You brought him here.", "name": "COLETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "I brought a doctor.", "name": "CASS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "You brought a corpse.", "name": "COLETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "He was breathing when we arrived.", "name": "CASS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Not when I did.", "name": "COLETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Cass lowers a hand.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Colette lifts the empty pistol, hand shaking, and levels it.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "It's empty.", "name": "CASS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "You don't know that.", "name": "COLETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "I counted.", "name": "CASS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "You counted wrong.", "name": "COLETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Colette--", "name": "CASS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Don't use my name.", "name": "COLETTE", "speaker": 0, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "A cough.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Nestor stirs.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Colette and Cass both leap, he toward the body, she toward the pistol, and they collide in the middle of the floor, knocking over a chair.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "The sat phone skids across the tile.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Nestor rolls onto his back, wheezing.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Opens one eye.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Don't shoot.", "name": "NESTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Nestor. You're alive.", "name": "COLETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Barely. Cass?", "name": "NESTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Here.", "name": "CASS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Did you call it in?", "name": "NESTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "The signal's dead.", "name": "CASS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "The dish.", "name": "NESTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "The dish is broken.", "name": "CASS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Nestor drags himself to a sitting position.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "He holds up the flash drive, fingers trembling.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Then we do it the old way. Upload by hand.", "name": "NESTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "To what?", "name": "COLETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "There's a transmitter in the basement.", "name": "NESTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Then we go down.", "name": "COLETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "It could be mined.", "name": "CASS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "It could.", "name": "NESTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Or it could be our only way home.", "name": "COLETTE", "speaker": 0, "ext": [], "paren": ["standing, dusting her coat"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Cass stares at her.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "At Nestor.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "At the drive.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Fine. But I carry it.", "name": "CASS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "You'll drop it.", "name": "NESTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "I will not.", "name": "CASS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Colette snatches the drive from Nestor and tosses it to Cass without a word.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "He catches it one-handed.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Thank you.", "name": "CASS", "speaker": 1, "ext": ["CONT'D"], "paren": ["deadpan"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Don't get used to it.", "name": "COLETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "They help Nestor to his feet, one on each arm.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Together they shuffle toward the stairwell door, three silhouettes against the grey window.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Behind them, the dish gives a long metallic groan and turns, by a degree, toward the sky.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}]}