{"scene_id": "s01544_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01544.fountain", "heading": "INT. OBSERVATORY STAIRWELL - CONTINUOUS", "cast": [{"id": 0, "name": "NESTOR", "names": ["NESTOR"], "gender": "m", "first": 4, "spoke": 7}, {"id": 1, "name": "CASS", "names": ["CASS"], "gender": "m", "first": 4, "spoke": 4}, {"id": 2, "name": "COLETTE", "names": ["COLETTE"], "gender": "f", "first": 4, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. OBSERVATORY STAIRWELL - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Concrete spiral.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dust.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single bulb swinging.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Colette leads, Cass behind, Nestor between.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 5, "kind": "action", "text": "Their footsteps ring.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "I never thanked you.", "name": "NESTOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "For what?", "name": "CASS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "For the doctor line. In the car.", "name": "NESTOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "I didn't lie.", "name": "CASS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "You said I was a doctor.", "name": "NESTOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "You are.", "name": "CASS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Of physics.", "name": "NESTOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "That counts.", "name": "CASS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Quiet. Down here.", "name": "COLETTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "They reach the basement door.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Padlock.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "She raises the pistol, finds the slide locked back, curses, and swings it like a hammer.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "The lock breaks.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "The door opens on a black room.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Somewhere a relay clicks.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Lights?", "name": "COLETTE", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Third switch.", "name": "NESTOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Cass finds it.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Fluorescent tubes flicker alive.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "A rack of ancient radio gear, a desk, a chair.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "And on the desk, a single working microphone.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "There she is.", "name": "NESTOR", "speaker": 0, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Cass plugs in the drive.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Nestor sits and leans toward the microphone.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Colette and Cass stand on either side of him, silent, hands on his shoulders.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "This is Nestor Pellegrini-Oyelowo, calling anyone. Anyone at all.", "name": "NESTOR", "speaker": 0, "ext": ["CONT'D"], "paren": ["into the microphone"], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Static.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "A long beat of hiss.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Then, faint, from far away, a voice rises from the speaker.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Colette closes her eyes.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Cass lets out a breath he has been holding since the car.", "para": 7, "sent": 1, "present": [0, 1, 2]}]}