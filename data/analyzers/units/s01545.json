{"scene_id": "s01545", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01545.fountain", "heading": "INT. LUNAR TRANSIT LOUNGE - LONG PERIOD", "cast": [{"id": 0, "name": "RHI", "names": ["RHI"], "gender": "f", "first": 7, "spoke": 18}, {"id": 1, "name": "ACHTERBERG-KOMA", "names": ["ACHTERBERG-KOMA"], "gender": "?", "first": 7, "spoke": 0}, {"id": 2, "name": "TAD", "names": ["TAD"], "gender": "?", "first": 11, "spoke": 19}, {"id": 3, "name": "LOWENSTEIN-OSEI", "names": ["LOWENSTEIN-OSEI"], "gender": "?", "first": 11, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. LUNAR TRANSIT LOUNGE - LONG PERIOD", "present": []}, {"u": 1, "kind": "action", "text": "A curved observation hall hewn from basalt.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Banks of pale seating bolted to the floor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A wall-sized window frames Earth, a blue coin hung in black.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Overhead, signage in six languages announces delays that have no end.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The air smells of recycled coffee and warm plastic.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "A cleaning drone hums past, brushing at invisible dust.", "para": 1, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "RHIANNON \"RHI\" ACHTERBERG-KOMA, 30s, in a faded flight jacket, sits at a corner table nursing a cold tube of coffee.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Her boots are up on a spare chair.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "She has been here a long time.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "A man in a grey pressure suit approaches with a tray.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "THADDEUS \"TAD\" LOWENSTEIN-OSEI, 50s, graying, polite.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "He carries two tubes.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "He stops a respectful distance away.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Is this seat taken?", "name": "TAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "The chair is. The seat isn't.", "name": "RHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "She moves her boots.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "He sits.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Sets the second tube in front of her.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "I didn't order that.", "name": "RHI", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "I thought you might have a second thirst.", "name": "TAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "I have a second everything. It's what happens when you wait.", "name": "RHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Which flight?", "name": "TAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Mars Direct. Twice rescheduled.", "name": "RHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Mine's the Ceres shuttle.", "name": "TAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Sixteen days late.", "name": "RHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "You've been checking.", "name": "TAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Everyone checks. It's the hobby.", "name": "RHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "They sip.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Outside, a transport crosses the lunar horizon, trailing a thin plume.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Earth turns in the window, slowly, blue and white.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "I used to come up here for work. Now I come for the view.", "name": "TAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "It's always the same view.", "name": "RHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "That's the comfort.", "name": "TAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "The comfort is that I know what I'm missing.", "name": "RHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "And what's that?", "name": "TAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Weather.", "name": "RHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "He laughs.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "The drone returns, brushes around their table, and sweeps away.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "What's your trade?", "name": "TAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Soil. I'm an agronomist. I teach dust to grow things.", "name": "RHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Does it listen?", "name": "TAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Not to me. To the right microbe, maybe.", "name": "RHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "I fix valves.", "name": "TAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Somebody has to.", "name": "RHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Somebody does. Mostly me, on bad days.", "name": "TAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "She turns the tube in her fingers.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Peers at the label.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Why Ceres?", "name": "RHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "My daughter's there. Three years. She keeps asking me to visit and I keep telling her it's a long trip.", "name": "TAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Is it?", "name": "RHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "It was, until I decided to go.", "name": "TAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "A soft chime.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Overhead, a board flickers.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "A line changes.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Both of them look up.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Yours?", "name": "RHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "Mine.", "name": "TAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "Boarding?", "name": "RHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "In forty minutes.", "name": "TAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "Rhi nods.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "Lifts her tube in a small salute.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "He raises his in answer.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "To soil, then.", "name": "RHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "To valves.", "name": "TAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "They drink.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "Earth turns, unhurried.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "He rises, takes his tray, and pauses at the edge of the table.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "If you ever see Ceres. The garden domes are poor. They'd listen to you.", "name": "TAD", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "dialogue", "text": "Is that an invitation?", "name": "RHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "dialogue", "text": "It's a valve repair request. Disguised.", "name": "TAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "She smiles for the first time.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "action", "text": "He nods and walks away across the basalt floor.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "action", "text": "Rhi puts her boots back up on the chair and settles to wait.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}]}