{"scene_id": "s01546", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01546.fountain", "heading": "INT. COUNTY COURTHOUSE - BASEMENT HOLDING CELL CORRIDOR - DAY", "cast": [{"id": 0, "name": "ATTORNEY SABINE ROTHSCHILD-OKONJO", "names": ["ATTORNEY SABINE ROTHSCHILD-OKONJO", "SABINE"], "gender": "f", "first": 5, "spoke": 18}, {"id": 1, "name": "DEE", "names": ["DEE"], "gender": "f", "first": 6, "spoke": 14}, {"id": 2, "name": "VASQUEZ-IBEKWE", "names": ["VASQUEZ-IBEKWE"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "WOMAN IN GREY", "names": ["WOMAN GREY", "WOMAN IN GREY"], "gender": "f", "first": 8, "spoke": 3}, {"id": 4, "name": "NICOLA", "names": ["NICOLA"], "gender": "f", "first": 21, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. COUNTY COURTHOUSE - BASEMENT HOLDING CELL CORRIDOR - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Pipes along the ceiling.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Water stains on cinderblock.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A steel bench bolted to the wall.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single bulb in a cage buzzes like a trapped insect.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ATTORNEY SABINE ROTHSCHILD-OKONJO, 40s, in a navy suit with a crease worn in the elbow, stands with her briefcase held against her chest.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across from her, behind a steel mesh gate, a young woman in county orange paces: DEMETRIA \"DEE\" VASQUEZ-IBEKWE, 20s, hair scraped back, eyes red.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "A third woman sits on the bench by the gate, hunched, anonymous in a grey cardigan, hands clasped.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "THE WOMAN IN GREY says nothing.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "She does not look up.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Dee. Sit.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I can't.", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "You've been standing since six.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "They put me on the bench, I think about the bench.", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Then think about me.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Dee halts.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Faces her.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Her fingers curl through the mesh.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "She told them it was me.", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Who?", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Her. The one who works with me. She told them I took the money.", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Nicola?", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Nicola.", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "She did not tell them. She was subpoenaed.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Same thing.", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "It is not.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "The Woman in Grey lifts her head.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Her face is plain, composed, unreadable.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "She glances at Dee, then at Sabine, then away.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Who is she?", "name": "DEE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "I don't know.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Is she with you?", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "No.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Then why is she in here?", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "The Woman in Grey stands.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Smooths her cardigan.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Because I've been waiting a very long time to say something to you.", "name": "WOMAN IN GREY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "This is a private consultation.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Then let me be private.", "name": "WOMAN IN GREY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "She steps up to the gate.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Dee takes a half step back.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "The bulb flickers.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "My name is Nicola Halloran-Eze.", "name": "WOMAN IN GREY", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "No.", "name": "DEE", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Yes.", "name": "NICOLA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Sabine turns the briefcase flat against her chest like a shield.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Ms. Halloran-Eze, I must insist--", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "I took the money.", "name": "NICOLA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Silence.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Pipes tick overhead.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Dee's mouth opens.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Nothing comes out.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "I told them it was you because I thought you'd be believed. Because you were younger. You'd have time.", "name": "NICOLA", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "Time.", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "To recover. I was going to confess before the trial.", "name": "NICOLA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "It's Thursday.", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "I know what day it is.", "name": "NICOLA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "Sabine steps between them.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "She holds up both palms, one to each side.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "Ms. Halloran-Eze, you do not have to say another word.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "I'm done being told what I don't have to say.", "name": "NICOLA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "This is a confession. In a holding corridor. In front of the defendant.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "dialogue", "text": "In front of her counsel. That makes it legal, doesn't it?", "name": "NICOLA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "dialogue", "text": "It makes it extraordinary.", "name": "SABINE", "speaker": 0, "ext": [], "paren": ["a long beat"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "Dee slides down the mesh.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "Sits on the concrete floor, her orange knees drawn up.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "dialogue", "text": "I told my mother it was a mistake.", "name": "DEE", "speaker": 1, "ext": [], "paren": ["to no one"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "dialogue", "text": "Dee, don't speak.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "dialogue", "text": "I told her. I told her.", "name": "DEE", "speaker": 1, "ext": [], "paren": ["still to no one"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "Nicola presses her forehead to the steel.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "action", "text": "A guard's keys jingle somewhere beyond the corridor, and a door clangs.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "dialogue", "text": "Nicola. Will you repeat that to the judge?", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "dialogue", "text": "At two o'clock.", "name": "NICOLA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "dialogue", "text": "Will you repeat it to the prosecutor?", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "dialogue", "text": "If she'll listen.", "name": "NICOLA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "dialogue", "text": "She'll listen.", "name": "SABINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 76, "kind": "action", "text": "Sabine hands her a card from her breast pocket.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 77, "kind": "action", "text": "Nicola takes it.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 78, "kind": "action", "text": "Reads it.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 79, "kind": "action", "text": "Folds it into the cardigan.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 80, "kind": "action", "text": "Dee lifts her head.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 81, "kind": "action", "text": "The bulb steadies.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 82, "kind": "action", "text": "For the first time since the scene began, she is still.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4]}]}