{"scene_id": "s01547", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01547.fountain", "heading": "INT. SNOWBOUND CABIN - DAY", "cast": [{"id": 0, "name": "HETTY", "names": ["HETTY"], "gender": "?", "first": 4, "spoke": 8}, {"id": 1, "name": "MBATHA-FLORES", "names": ["MBATHA-FLORES"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "OSKAR LINDQVIST-AKINTOLA", "names": ["OSKAR LINDQVIST-AKINTOLA", "OSKAR"], "gender": "m", "first": 5, "spoke": 6}, {"id": 3, "name": "JUNE", "names": ["JUNE"], "gender": "?", "first": 6, "spoke": 5}, {"id": 4, "name": "ACHEBE-RYDER", "names": ["ACHEBE-RYDER"], "gender": "?", "first": 6, "spoke": 0}, {"id": 5, "name": "TOMASZ BRZEZINSKI", "names": ["TOMASZ BRZEZINSKI", "TOMASZ"], "gender": "m", "first": 7, "spoke": 10}, {"id": 6, "name": "MIRABEL ODUYA-HART", "names": ["MIRABEL ODUYA-HART", "MIRABEL"], "gender": "?", "first": 8, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. SNOWBOUND CABIN - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Frost on the panes.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A woodstove, nearly dead.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Five survivors packed around a table with a single can between them.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CAPTAIN HENRIETTA \"HETTY\" MBATHA-FLORES, 50s, pilot, scrapes the last bean from the can.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "DR. OSKAR LINDQVIST-AKINTOLA, 40s, holds a splinted arm to his chest.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "JUNIPER \"JUNE\" ACHEBE-RYDER, 20s, shivers in an oversized parka.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "action", "text": "TOMASZ BRZEZINSKI, 60s, glowers at the stove.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "action", "text": "And little MIRABEL ODUYA-HART, 10, wrapped in a blanket, eyes huge.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 9, "kind": "dialogue", "text": "Fire's out in an hour.", "name": "HETTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "dialogue", "text": "We need wood.", "name": "OSKAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "We need a plan.", "name": "TOMASZ", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "We need to stop shouting.", "name": "JUNE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "Nobody's shouting.", "name": "TOMASZ", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "Tomasz, you are.", "name": "HETTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "I'm projecting.", "name": "TOMASZ", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "At whom?", "name": "OSKAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "At whoever gets us killed.", "name": "TOMASZ", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "Nobody's getting killed.", "name": "JUNE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "Is Dad coming?", "name": "MIRABEL", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "action", "text": "Silence.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "action", "text": "Hetty sets down the can.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "action", "text": "Oskar studies the floor.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "Mirabel, sweetheart. The radio's down.", "name": "HETTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "But they know where we are.", "name": "MIRABEL", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "They know where the plane went down.", "name": "OSKAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "Which is twelve miles west.", "name": "TOMASZ", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "We could walk.", "name": "JUNE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "She means him, in the blanket, with a broken arm. And her. And me.", "name": "OSKAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "Then I go alone.", "name": "TOMASZ", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "You'll freeze.", "name": "HETTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "He'll freeze if I don't.", "name": "TOMASZ", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "Who? Me?", "name": "OSKAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "Both of you. All of you.", "name": "TOMASZ", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "Nobody goes alone.", "name": "HETTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "I'll go with him.", "name": "JUNE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "She'll slow me.", "name": "TOMASZ", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "She'll keep you alive.", "name": "HETTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "dialogue", "text": "I want to come.", "name": "MIRABEL", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "No, Mirabel.", "name": "HETTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "Why not?", "name": "MIRABEL", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "dialogue", "text": "Because she is the only reason the rest of us stay.", "name": "OSKAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "Mirabel looks from face to face.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "Tomasz rises and takes his coat from the hook.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "dialogue", "text": "At dawn, then.", "name": "TOMASZ", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "At dawn.", "name": "HETTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "dialogue", "text": "I'll get the rope.", "name": "JUNE", "speaker": 3, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}