{"scene_id": "s01549", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01549.fountain", "heading": "INT. ANTIQUARIAN BOOKSHOP - UPSTAIRS READING ROOM - LATE AFTERNOON", "cast": [{"id": 0, "name": "PROFESSOR IMOGEN LOWERY-ACHEBE", "names": ["PROFESSOR IMOGEN LOWERY-ACHEBE", "IMOGEN"], "gender": "f", "first": 6, "spoke": 20}, {"id": 1, "name": "PIP", "names": ["PIP"], "gender": "f", "first": 8, "spoke": 22}, {"id": 2, "name": "OKONKWO-DAVIES", "names": ["OKONKWO-DAVIES"], "gender": "?", "first": 8, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. ANTIQUARIAN BOOKSHOP - UPSTAIRS READING ROOM - LATE AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Tall shelves on three walls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A rolling ladder.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dust turning in a diagonal bar of light.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single leather armchair with a cracked arm.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "On a round table sit a pot of tea and two untouched cups.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "PROFESSOR IMOGEN LOWERY-ACHEBE, 60s, in a tweed skirt and pearl buttons, stands by the window with her back to the room.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "A magnifying glass hangs from her neck on a ribbon.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "Behind her, seated at the table, is her former student, DETECTIVE-SERGEANT PHILIPPA \"PIP\" OKONKWO-DAVIES, 30s, in a damp raincoat.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "She has not taken it off.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Her notebook lies closed.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Thank you for seeing me.", "name": "PIP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "I almost didn't.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "I know.", "name": "PIP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "You always asked questions with your hands folded. It was a trick.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "It still is.", "name": "PIP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Pip unclasps her hands, deliberately, and lays them flat on the table.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Imogen turns.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Looks at the hands.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Looks at the teapot.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Shall I pour?", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Please.", "name": "PIP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Imogen pours.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "The china clinks.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "A thin line of steam climbs between them.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "The bookseller. Mr. Fenwick.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Yes.", "name": "PIP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "He was found in the cellar.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Yes.", "name": "PIP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "With a first folio.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "How do you know about the folio?", "name": "PIP", "speaker": 1, "ext": [], "paren": ["a pause"], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "It was in the newspaper.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "The newspaper didn't mention a folio.", "name": "PIP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Imogen sets down the pot.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Carefully.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "The spout trembles once, and she steadies it with her other hand.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "The newspaper mentioned a book.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "A book. Yes.", "name": "PIP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "I assumed.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "You assumed correctly.", "name": "PIP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Imogen lowers herself into the armchair, which sighs.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "She does not look at the shelves behind her.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Pip does, once, her eye travelling along the spines to a gap at the height of Imogen's shoulder.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "That's a rare space.", "name": "PIP", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Books are borrowed.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "By whom?", "name": "PIP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "By people who ask nicely.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "And did he ask nicely?", "name": "PIP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Mr. Fenwick asked in a great many ways.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Pip lifts her cup.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Does not sip.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Holds it, level, like a measure.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "He wrote a letter to the Society. Three weeks before he died.", "name": "PIP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Did he.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "He said a colleague had been selling pages from the folio.", "name": "PIP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "Did he name the colleague?", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "He didn't have to.", "name": "PIP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Imogen smooths her skirt.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Her fingers find the magnifying glass on its ribbon and wind the ribbon once around her hand.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "Philippa.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "Professor.", "name": "PIP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "You were my best student.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "I know.", "name": "PIP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "I taught you to see.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "You did.", "name": "PIP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "Then see this. There is nothing in this room that is not what it appears to be.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "Pip sets her cup down.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "Reaches into her raincoat.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "Draws out a slim glass sleeve, and in it, a single torn page, brown at the edges, in a looping Elizabethan hand.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 69, "kind": "dialogue", "text": "Forensics found this in his hand.", "name": "PIP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "Imogen looks at the page.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 71, "kind": "action", "text": "Then at the shelf.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 72, "kind": "action", "text": "Then at the window, where the light has slipped down the wall and is now the colour of tea.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 73, "kind": "dialogue", "text": "He did write beautifully.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}, {"u": 74, "kind": "dialogue", "text": "Who?", "name": "PIP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 75, "kind": "dialogue", "text": "Shakespeare. I mean Shakespeare.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 76, "kind": "dialogue", "text": "I know who you mean.", "name": "PIP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 77, "kind": "action", "text": "They sit, two women and a pot of cooling tea, while the bar of light slides off the table and onto the floor.", "para": 11, "sent": 0, "present": [0, 1, 2]}]}