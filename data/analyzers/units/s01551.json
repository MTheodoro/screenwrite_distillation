{"scene_id": "s01551", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01551.fountain", "heading": "INT. EMERGENCY ROOM - TRAUMA BAY THREE - NIGHT", "cast": [{"id": 0, "name": "CHIDINMA OKAFOR-LINDQVIST", "names": ["CHIDINMA OKAFOR-LINDQVIST", "CHIDINMA"], "gender": "?", "first": 4, "spoke": 17}, {"id": 1, "name": "TOBIAS ACHTERBERG-NNAMDI", "names": ["TOBIAS ACHTERBERG-NNAMDI", "TOBIAS"], "gender": "?", "first": 5, "spoke": 14}, {"id": 2, "name": "NURSE BEATRIZ COLQUHOUN-SANTOS", "names": ["NURSE BEATRIZ COLQUHOUN-SANTOS", "BEATRIZ"], "gender": "?", "first": 6, "spoke": 11}], "units": [{"u": 0, "kind": "heading", "text": "INT. EMERGENCY ROOM - TRAUMA BAY THREE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Blood on the floor.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Monitors shrieking.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A gurney with a young man strapped to it, chest rising in shallow gasps.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. CHIDINMA OKAFOR-LINDQVIST, 40s, in a gown and gloves, leans over the patient.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside her, RESIDENT DR. TOBIAS ACHTERBERG-NNAMDI, 20s, holds a suction wand, white-faced.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "At the foot of the bed, NURSE BEATRIZ COLQUHOUN-SANTOS, 30s, cuts the patient's shirt with trauma shears.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Pressure?", "name": "CHIDINMA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Seventy over forty.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Falling.", "name": "BEATRIZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Two large-bore lines. Now.", "name": "CHIDINMA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Already in.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Left arm's blown.", "name": "BEATRIZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Then go to the neck.", "name": "CHIDINMA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Dr. Okafor-Lindqvist, he's seventeen.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Pressure.", "name": "CHIDINMA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Sixty over thirty.", "name": "BEATRIZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "What's the mechanism?", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Stab wound, left chest, no exit.", "name": "CHIDINMA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Pulse ox ninety.", "name": "BEATRIZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Pneumothorax?", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Hemothorax. Chest tube. Tobias, you do it.", "name": "CHIDINMA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Me?", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Yes. Now.", "name": "CHIDINMA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Betadine.", "name": "BEATRIZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Okay. Okay.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Fifth intercostal, mid-axillary. You know this.", "name": "CHIDINMA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "I know this.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Pressure's fifty.", "name": "BEATRIZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Push the blood.", "name": "CHIDINMA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "O-neg's up.", "name": "BEATRIZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Incision.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Good. Bluntly through the muscle.", "name": "CHIDINMA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "There's a rush of blood.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Good. That's the chest. Insert the tube.", "name": "CHIDINMA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "It's in.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Pressure sixty.", "name": "BEATRIZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Seventy?", "name": "CHIDINMA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Seventy.", "name": "BEATRIZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Output is eight hundred cc and rising.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "We go to the OR.", "name": "CHIDINMA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "OR's clearing.", "name": "BEATRIZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Get the surgeon.", "name": "CHIDINMA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Calling.", "name": "BEATRIZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Dr. Okafor-Lindqvist?", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Yes?", "name": "CHIDINMA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "I thought he was gone.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "So did I.", "name": "CHIDINMA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "She rips off her gloves.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Squeezes his shoulder once.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Good work, Doctor.", "name": "CHIDINMA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}]}