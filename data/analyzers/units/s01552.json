E", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He sits.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She shuffles pages.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "He does the same.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Their hands brush a stapler at the same instant.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Both withdraw.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "After you.", "name": "ASHER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "No. You.", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "He picks it up.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Staples.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Stares at the result.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Wrong page.", "name": "ASHER", "speaker": 1, "ext": [], "paren": ["muttering, to himself"], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She notices.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Says nothing.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "The clock ticks.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "A buzzer sounds.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "They both rise, grab their briefcases, and collide at the door.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "She goes first.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "He follows.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Don't rush me.", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Wouldn't dream of it.", "name": "ASHER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "They enter the courtroom side by side, not touching.", "para": 8, "sent": 0, "present": [0, 1]}]}