{"scene_id": "s01553", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01553.fountain", "heading": "INT. LOCKER ROOM - HALFTIME", "cast": [{"id": 0, "name": "ODUYA-LINDGREN", "names": ["ODUYA-LINDGREN"], "gender": "?", "first": 3, "spoke": 0}, {"id": 1, "name": "JAZZ", "names": ["JAZZ"], "gender": "f", "first": 4, "spoke": 7}, {"id": 2, "name": "ABERNATHY-OKORO", "names": ["ABERNATHY-OKORO"], "gender": "?", "first": 4, "spoke": 0}, {"id": 3, "name": "COACH", "names": ["COACH"], "gender": "?", "first": 5, "spoke": 9}, {"id": 4, "name": "DEE", "names": ["DEE"], "gender": "?", "first": 21, "spoke": 3}, {"id": 5, "name": "KOWALCZYK", "names": ["KOWALCZYK"], "gender": "?", "first": 21, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. LOCKER ROOM - HALFTIME", "present": []}, {"u": 1, "kind": "action", "text": "Sweat, steam, rattling lockers.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A whiteboard scrawled with arrows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "COACH MARGUERITE \"MAGS\" ODUYA-LINDGREN, 50s, paces with a clipboard.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "The team captain, JASMINE \"JAZZ\" ABERNATHY-OKORO, 20s, sits on a bench with a towel over her head.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "Fourteen down.", "name": "COACH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "dialogue", "text": "I know.", "name": "JAZZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Fourteen.", "name": "COACH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "I know, Coach.", "name": "JAZZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "She knows, she says.", "name": "COACH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "We know.", "name": "JAZZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "The coach slams the clipboard against a locker.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Jazz flinches.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "She pulls the towel off, wipes her face, and doesn't look up.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "They run the same play every time. Every single time.", "name": "COACH", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "So why can't we stop it?", "name": "JAZZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Because you're watching the ball.", "name": "COACH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "We're supposed to watch the ball!", "name": "JAZZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "You're supposed to watch the hips!", "name": "COACH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "The door bangs.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "A rookie stands there, sweating.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "DESHAWN \"DEE\" KOWALCZYK, 19, number twelve, helmet under her arm.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Coach. Can I say something?", "name": "DEE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "No.", "name": "COACH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Yes.", "name": "JAZZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "I see it. The tell. The left shoulder drops before the screen.", "name": "DEE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "The coach turns.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Jazz lifts her chin.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Say that again.", "name": "COACH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Left shoulder. Every time.", "name": "DEE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Then we hit it.", "name": "JAZZ", "speaker": 1, "ext": [], "paren": ["standing"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Then we hit it.", "name": "COACH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}