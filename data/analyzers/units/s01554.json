{"scene_id": "s01554", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01554.fountain", "heading": "INT. PAWN SHOP BACK OFFICE - NIGHT", "cast": [{"id": 0, "name": "SOL", "names": ["SOL"], "gender": "m", "first": 4, "spoke": 19}, {"id": 1, "name": "ADEYEMI-BRANDT", "names": ["ADEYEMI-BRANDT"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "REN", "names": ["REN"], "gender": "?", "first": 7, "spoke": 16}, {"id": 3, "name": "PAPADOPOULOS-ESEZOBOR", "names": ["PAPADOPOULOS-ESEZOBOR"], "gender": "?", "first": 7, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. PAWN SHOP BACK OFFICE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A desk lamp.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A safe with its door ajar.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Boxes of watches, wedding rings, guitars.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SOLOMON \"SOL\" ADEYEMI-BRANDT, 60s, cardigan, reading glasses, counts bills with a licked thumb.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Behind him on a shelf, a clock.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "The door opens a crack.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "RENATA \"REN\" PAPADOPOULOS-ESEZOBOR, 30s, in a hooded sweatshirt, slips in, keeping one hand in the pocket.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "We're closed.", "name": "SOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Door was open.", "name": "REN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Doors do that.", "name": "SOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "You Sol?", "name": "REN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Depends.", "name": "SOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Gabe sent me.", "name": "REN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Gabe's in Tucson.", "name": "SOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Gabe's not.", "name": "REN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Sol stops counting.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Folds the bills.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Puts them in a drawer, slowly.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Closes the drawer with his knee.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Sit.", "name": "SOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "I'll stand.", "name": "REN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Suit yourself.", "name": "SOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "She stays by the door.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "He picks up a tea mug, sips, sets it down.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "The clock ticks.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "He says you owe him.", "name": "REN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Everybody owes somebody.", "name": "SOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Eight thousand.", "name": "REN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "I've got six.", "name": "SOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "He said eight.", "name": "REN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "He said a lot of things.", "name": "SOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Ren takes a step.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "The floor creaks.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Sol's hand slides from the desk toward the lamp's base.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "That's close enough.", "name": "SOL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "You scared?", "name": "REN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "I'm seventy. Everything scares me.", "name": "SOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "You said sixty.", "name": "REN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Sixty-nine.", "name": "SOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "He laughs.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "She doesn't.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Her hand comes out of the pocket, empty, then goes back in.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "What's in there?", "name": "SOL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Gloves.", "name": "REN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "It's July.", "name": "SOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "It's a long night.", "name": "REN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Sol rises.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Slowly.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "His chair rolls back, bumps the safe.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Ren darts forward, he swings the lamp, she ducks, they collide against the desk, and the lamp crashes to the floor in a spray of glass.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Darkness.", "para": 7, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "A grunt.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "A thud.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Something metal skitters.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "The lamp's bulb sputters and relights, flickering.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Sol sits on the floor with his back against the safe, breathing hard.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Ren crouches over him, gloves on, a rubber hammer in her fist.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "Gloves.", "name": "SOL", "speaker": 0, "ext": ["CONT'D"], "paren": ["wheezing"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "Told you.", "name": "REN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "She lowers the hammer.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "Sets it on the carpet.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "Sol pats his chest.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "Take the six.", "name": "SOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "Gabe will want eight.", "name": "REN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "Then tell him I'm dead.", "name": "SOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "He'll check.", "name": "REN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "Let him.", "name": "SOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "She stands.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "Opens the drawer, takes the bills.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "Counts.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "Doesn't count.", "para": 11, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "You said sixty.", "name": "REN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "I said sixty-nine.", "name": "SOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "She almost smiles.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "Pockets the cash and goes.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "The door clicks.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "Sol leans his head against the safe, listens to the clock, and shuts his eyes.", "para": 12, "sent": 3, "present": [0, 1, 2, 3]}]}