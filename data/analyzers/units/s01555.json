{"scene_id": "s01555", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01555.fountain", "heading": "INT. DISTRICT COURTHOUSE - CORRIDOR OUTSIDE COURTROOM 4B - DAY", "cast": [{"id": 0, "name": "WOMAN", "names": ["WOMAN"], "gender": "?", "first": 4, "spoke": 0}, {"id": 1, "name": "DONNELLY-ADEYEMI", "names": ["DONNELLY-ADEYEMI"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "MAN", "names": ["MAN"], "gender": "m", "first": 6, "spoke": 0}, {"id": 3, "name": "HAROLD OSEI-BRANDT", "names": ["HAROLD OSEI-BRANDT", "OSEI-BRANDT"], "gender": "?", "first": 7, "spoke": 13}, {"id": 4, "name": "DONNELLY", "names": ["DONNELLY"], "gender": "?", "first": 5, "spoke": 16}], "units": [{"u": 0, "kind": "heading", "text": "INT. DISTRICT COURTHOUSE - CORRIDOR OUTSIDE COURTROOM 4B - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Bench seating.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A water cooler.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A television mounted high plays the news without sound.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A WOMAN in a black suit paces with a folder.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her badge reads P. A. DONNELLY-ADEYEMI, Assistant District Attorney.", "para": 1, "sent": 1, "present": [0, 1, 4]}, {"u": 6, "kind": "action", "text": "A MAN in a rumpled blazer stands near the cooler, tapping his phone.", "para": 2, "sent": 0, "present": [0, 1, 2, 4]}, {"u": 7, "kind": "action", "text": "The placard on his briefcase reads \"HAROLD OSEI-BRANDT, ESQ.\"", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "Harold.", "name": "DONNELLY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Priscilla.", "name": "OSEI-BRANDT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "You filed the motion at five a.m.", "name": "DONNELLY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Insomnia.", "name": "OSEI-BRANDT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "It had a cover letter.", "name": "DONNELLY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "I take pride in my cover letters.", "name": "OSEI-BRANDT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "She stops pacing.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Stares at the TV.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "The ticker reads \"BREAKING: LOCAL JUDGE RECUSES.\"", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Of course.", "name": "DONNELLY", "speaker": 4, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Something?", "name": "OSEI-BRANDT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Nothing. Talking to the weather.", "name": "DONNELLY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "He chuckles.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "She does not.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Anyone with a four o'clock in 4B should know it's been moved.", "name": "DONNELLY", "speaker": 4, "ext": ["CONT'D"], "paren": ["louder, to the whole corridor"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Nobody answers.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "A janitor wheels a mop bucket past, whistling.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Wasted breath.", "name": "OSEI-BRANDT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Habit.", "name": "DONNELLY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Moved to where?", "name": "OSEI-BRANDT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Courtroom 7. New judge.", "name": "DONNELLY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Who?", "name": "OSEI-BRANDT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Judge Kowalczyk.", "name": "DONNELLY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "No.", "name": "OSEI-BRANDT", "speaker": 3, "ext": [], "paren": ["sinking onto the bench"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Yes.", "name": "DONNELLY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "He hates me.", "name": "OSEI-BRANDT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "He hates everyone. That's the beauty.", "name": "DONNELLY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Priscilla, I need a continuance.", "name": "OSEI-BRANDT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Harold, I need a miracle.", "name": "DONNELLY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "She sits beside him.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Their briefcases touch.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "The TV flickers to a weather map: a hurricane swirl.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Priscilla, if I say please.", "name": "OSEI-BRANDT", "speaker": 3, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Don't.", "name": "DONNELLY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Please.", "name": "OSEI-BRANDT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Fine. A week.", "name": "DONNELLY", "speaker": 4, "ext": [], "paren": ["sighing"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "He stands, extends a hand.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "She shakes it.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Then she looks at the placard on his case, and at her own badge, and the cue in her notes.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "Priscilla Anne. Not Priscilla.", "name": "DONNELLY", "speaker": 4, "ext": ["CONT'D"], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "What?", "name": "OSEI-BRANDT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Nothing, Harold. Go.", "name": "DONNELLY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "He goes.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "She remains on the bench, watching the hurricane turn.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}]}