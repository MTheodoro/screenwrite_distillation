{"scene_id": "s01556_0", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01556.fountain", "heading": "EXT. HOMESTEAD - DAWN", "cast": [{"id": 0, "name": "NELL TREMAINE-ADEYEMI", "names": ["NELL TREMAINE-ADEYEMI", "NELL"], "gender": "m", "first": 5, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. HOMESTEAD - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A sod house on an empty plain.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wind combs the grass.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A broken wagon wheel leans against the door.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A lone windmill creaks.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "NELL TREMAINE-ADEYEMI, 40s, stands in the yard in a man's coat and a faded bonnet.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A rifle rests against the fence post beside her.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "A saddlebag, half packed, lies in the dirt at her feet.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "She does not look at the road.", "para": 1, "sent": 3, "present": [0]}, {"u": 9, "kind": "action", "text": "She crouches.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "Pulls a letter from her pocket.", "para": 2, "sent": 1, "present": [0]}, {"u": 11, "kind": "action", "text": "Smooths it against her knee.", "para": 2, "sent": 2, "present": [0]}, {"u": 12, "kind": "dialogue", "text": "\"Dear Nell. By the time you read this, I'll be in Cheyenne.\"", "name": "NELL", "speaker": 0, "ext": ["V.O."], "paren": ["reading, as if written"], "dual": false, "present": [0]}, {"u": 13, "kind": "action", "text": "She lowers the letter.", "para": 3, "sent": 0, "present": [0]}, {"u": 14, "kind": "action", "text": "Looks at the horizon.", "para": 3, "sent": 1, "present": [0]}, {"u": 15, "kind": "action", "text": "Raises it again.", "para": 3, "sent": 2, "present": [0]}, {"u": 16, "kind": "dialogue", "text": "\"The claim is yours. The mule, too. I never did like him.\"", "name": "NELL", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 17, "kind": "action", "text": "A small, dry breath, almost a laugh.", "para": 4, "sent": 0, "present": [0]}, {"u": 18, "kind": "action", "text": "She tucks the letter into her coat.", "para": 4, "sent": 1, "present": [0]}, {"u": 19, "kind": "action", "text": "She stands.", "para": 5, "sent": 0, "present": [0]}, {"u": 20, "kind": "action", "text": "Walks to the well.", "para": 5, "sent": 1, "present": [0]}, {"u": 21, "kind": "action", "text": "Lowers the bucket on its rope.", "para": 5, "sent": 2, "present": [0]}, {"u": 22, "kind": "action", "text": "The rope creaks.", "para": 5, "sent": 3, "present": [0]}, {"u": 23, "kind": "action", "text": "She draws it up slowly, hand over hand, never taking her eyes off the plain.", "para": 5, "sent": 4, "present": [0]}, {"u": 24, "kind": "action", "text": "Drinks from her cupped palm.", "para": 6, "sent": 0, "present": [0]}, {"u": 25, "kind": "action", "text": "Wipes her chin.", "para": 6, "sent": 1, "present": [0]}]}