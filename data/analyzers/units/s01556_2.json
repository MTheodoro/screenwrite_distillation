{"scene_id": "s01556_2", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01556.fountain", "heading": "EXT. HOMESTEAD - CONTINUOUS", "cast": [{"id": 0, "name": "NELL", "names": ["NELL"], "gender": "f", "first": 4, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "EXT. HOMESTEAD - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "She walks to the barn.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Opens the door.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A mule stands in the dark, chewing hay.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "dialogue", "text": "Morning, you.", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 5, "kind": "action", "text": "The mule flicks an ear.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "dialogue", "text": "You heard?", "name": "NELL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 7, "kind": "action", "text": "The mule turns away.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "She laughs, once, helplessly.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "dialogue", "text": "He said you were his favourite.", "name": "NELL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 10, "kind": "action", "text": "She leads the mule out.", "para": 3, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "Loads the saddlebag.", "para": 3, "sent": 1, "present": [0]}, {"u": 12, "kind": "action", "text": "Tightens the cinch with hard jerks.", "para": 3, "sent": 2, "present": [0]}, {"u": 13, "kind": "dialogue", "text": "\"Don't wait for me. Don't write. If you must hate someone, hate the weather.\"", "name": "NELL", "speaker": 0, "ext": ["V.O."], "paren": ["reading"], "dual": false, "present": [0]}, {"u": 14, "kind": "action", "text": "She stops.", "para": 4, "sent": 0, "present": [0]}, {"u": 15, "kind": "action", "text": "Hands flat on the mule's flank.", "para": 4, "sent": 1, "present": [0]}, {"u": 16, "kind": "dialogue", "text": "\"I was never any good at stopping.\"", "name": "NELL", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 17, "kind": "action", "text": "She turns.", "para": 5, "sent": 0, "present": [0]}, {"u": 18, "kind": "action", "text": "The sun clears the horizon and the whole plain turns gold.", "para": 5, "sent": 1, "present": [0]}, {"u": 19, "kind": "action", "text": "She stands in the yard with the mule and the rifle and the house behind her.", "para": 5, "sent": 2, "present": [0]}, {"u": 20, "kind": "action", "text": "She picks up the rifle.", "para": 6, "sent": 0, "present": [0]}, {"u": 21, "kind": "action", "text": "Aims at nothing.", "para": 6, "sent": 1, "present": [0]}, {"u": 22, "kind": "action", "text": "At the windmill.", "para": 6, "sent": 2, "present": [0]}, {"u": 23, "kind": "action", "text": "At the sky.", "para": 6, "sent": 3, "present": [0]}, {"u": 24, "kind": "action", "text": "Lowers it.", "para": 7, "sent": 0, "present": [0]}, {"u": 25, "kind": "dialogue", "text": "Fine.", "name": "NELL", "speaker": 0, "ext": ["CONT'D"], "paren": ["quietly"], "dual": false, "present": [0]}, {"u": 26, "kind": "action", "text": "She walks to the house.", "para": 8, "sent": 0, "present": [0]}, {"u": 27, "kind": "action", "text": "Takes the tintype from the table, wraps it in a rag, tucks it in the saddlebag.", "para": 8, "sent": 1, "present": [0]}, {"u": 28, "kind": "action", "text": "Pulls the saddlebag tight.", "para": 8, "sent": 2, "present": [0]}]}