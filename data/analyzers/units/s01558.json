{"scene_id": "s01558", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01558.fountain", "heading": "INT. DEEP-SPACE LISTENING POST - COMMAND CENTRE - NIGHT", "cast": [{"id": 0, "name": "TEMI", "names": ["TEMI"], "gender": "f", "first": 5, "spoke": 9}, {"id": 1, "name": "AJAYI-NORDQVIST", "names": ["AJAYI-NORDQVIST"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "COMMANDER BARNABY HOLLINGSWORTH-OSEI", "names": ["COMMANDER BARNABY HOLLINGSWORTH-OSEI", "BARNABY"], "gender": "?", "first": 6, "spoke": 12}, {"id": 3, "name": "VISITOR", "names": ["VISITOR"], "gender": "?", "first": 8, "spoke": 5}, {"id": 4, "name": "SPECIALIST ORLANDO PAPADAKIS-NWOSU", "names": ["SPECIALIST ORLANDO PAPADAKIS-NWOSU", "ORLANDO"], "gender": "?", "first": 31, "spoke": 1}, {"id": 5, "name": "ISHMAEL", "names": ["ISHMAEL"], "gender": "?", "first": 36, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. DEEP-SPACE LISTENING POST - COMMAND CENTRE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A circular room of screens and cables.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Banks of antennae data scroll in green.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "One chair empty.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A kettle ticks on a hotplate.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LIEUTENANT TEMITOPE \"TEMI\" AJAYI-NORDQVIST, 30s, in a dark jumpsuit, stares at a waveform.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Beside her, COMMANDER BARNABY HOLLINGSWORTH-OSEI, 50s, leans on a console with a mug.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "At the back, a stranger in a plain grey coat stands with his hands folded.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "THE VISITOR, 40s, calm, unlit by any badge.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "It's repeating.", "name": "TEMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "How many cycles?", "name": "BARNABY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Seventeen.", "name": "TEMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Direction?", "name": "BARNABY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Cygnus.", "name": "TEMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Cygnus is empty.", "name": "BARNABY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Cygnus was empty.", "name": "TEMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "The Visitor steps forward.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Barnaby turns.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Who authorised you down here?", "name": "BARNABY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "No one yet.", "name": "VISITOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "That's not an answer.", "name": "BARNABY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "It will be soon.", "name": "VISITOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Commander, the signal's changing.", "name": "TEMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Changing how?", "name": "BARNABY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "It's addressing us.", "name": "TEMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Show me.", "name": "BARNABY", "speaker": 2, "ext": [], "paren": ["setting down the mug"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "She taps a key.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Text crawls up the main screen: a string of digits, then a single word.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "HELLO", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "The kettle clicks off.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "At the rear console, SPECIALIST ORLANDO PAPADAKIS-NWOSU, 20s, hunched over headphones, pulls one earcup off and stares.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Sir, I heard it too.", "name": "ORLANDO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "That is a prank.", "name": "BARNABY", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "It isn't.", "name": "VISITOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "And you are?", "name": "BARNABY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Call me Ishmael.", "name": "VISITOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "That's not your name.", "name": "BARNABY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "No. But it's one I chose.", "name": "VISITOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Commander, it's responding to him.", "name": "TEMI", "speaker": 0, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "On the screen, the word changes: ISHMAEL.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Barnaby backs away.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Temi grips her console.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "The man who calls himself Ishmael smiles faintly.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Thank you for answering.", "name": "ISHMAEL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "We didn't.", "name": "BARNABY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Someone did. Long ago. I'm merely the postman.", "name": "ISHMAEL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "Who sent you?", "name": "TEMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "Everyone you ever sent a signal to.", "name": "ISHMAEL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "What do they want?", "name": "BARNABY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "To say thank you.", "name": "ISHMAEL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "For what?", "name": "TEMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "For being lonely.", "name": "ISHMAEL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "Barnaby sits heavily in the empty chair.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "Temi presses a hand to her mouth.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "On the screen, a new line scrolls, unhurried, in a language none of them has seen, which all of them somehow read.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}