{"scene_id": "s01559", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01559.fountain", "heading": "INT. VICTORIAN CONSERVATORY - TWILIGHT", "cast": [{"id": 0, "name": "LADY ARABELLA OKONKWO-VANCE", "names": ["LADY ARABELLA OKONKWO-VANCE", "ARABELLA"], "gender": "f", "first": 5, "spoke": 11}, {"id": 1, "name": "GILES FAIRWEATHER-ADEBAYO", "names": ["GILES FAIRWEATHER-ADEBAYO", "GILES"], "gender": "m", "first": 8, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. VICTORIAN CONSERVATORY - TWILIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Glass walls fogged with breath.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Orchids hang in baskets.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Ferns drip.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Gaslights hiss in brass brackets.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LADY ARABELLA OKONKWO-VANCE, 40s, in black bombazine, stands alone among the palms, a pruning knife in her gloved hand.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A single white orchid trembles on its stem.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "The door scrapes.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "GILES FAIRWEATHER-ADEBAYO, 50s, in a doctor's frock coat, steps in with his bag.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He stops, hat in hand.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Lady Arabella.", "name": "GILES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Doctor.", "name": "ARABELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I came as soon as I heard.", "name": "GILES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Heard what?", "name": "ARABELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "That the Colonel is unwell.", "name": "GILES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "He is quite well. He is upstairs, asleep.", "name": "ARABELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Then why did you send for me?", "name": "GILES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She turns the knife in her fingers.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Light slides along the blade.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "I wished to show you the orchid.", "name": "ARABELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "I am no botanist.", "name": "GILES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "It blooms once in seven years.", "name": "ARABELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "How charming.", "name": "GILES", "speaker": 1, "ext": [], "paren": ["wary"], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "It was my husband's favourite.", "name": "ARABELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Giles sets his bag on a wicker table.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "His hands are not quite steady.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "I really ought to see the Colonel.", "name": "GILES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "In a moment.", "name": "ARABELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "She snips the orchid, cleanly, at the stem.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "It falls into her palm.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "She offers it to him.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "For your lapel.", "name": "ARABELLA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "He takes it.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Looks at it.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "At her.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "A drop of water falls from a fern onto the brim of his hat.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Arabella--", "name": "GILES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Lady Arabella.", "name": "ARABELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Lady Arabella. What are you doing?", "name": "GILES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Giving you a flower.", "name": "ARABELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "She steps close.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Pins the orchid to his coat with a hairpin.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Her fingers linger.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "It is poisonous, you know. The sap.", "name": "ARABELLA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "Giles looks down.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "A dark bead glistens on his lapel.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "He steps back.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Hits the wicker table.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "His bag spills.", "para": 9, "sent": 2, "present": [0, 1]}]}