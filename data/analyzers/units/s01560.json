{"scene_id": "s01560", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01560.fountain", "heading": "INT. SEASIDE RESTAURANT - EVENING", "cast": [{"id": 0, "name": "MARI", "names": ["MARI"], "gender": "f", "first": 6, "spoke": 19}, {"id": 1, "name": "ABERNATHY-OSEI", "names": ["ABERNATHY-OSEI"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "BEN", "names": ["BEN"], "gender": "m", "first": 6, "spoke": 15}, {"id": 3, "name": "LINDGREN-ADEBAYO", "names": ["LINDGREN-ADEBAYO"], "gender": "?", "first": 6, "spoke": 0}, {"id": 4, "name": "ROZ", "names": ["ROZ"], "gender": "f", "first": 8, "spoke": 4}, {"id": 5, "name": "TOMMASO BELLINI-OKORO", "names": ["TOMMASO BELLINI-OKORO", "TOMMASO"], "gender": "?", "first": 10, "spoke": 4}, {"id": 6, "name": "DJ", "names": ["DJ"], "gender": "?", "first": 37, "spoke": 0}, {"id": 7, "name": "RADIO", "names": ["RADIO"], "gender": "?", "first": 38, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. SEASIDE RESTAURANT - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "A small trattoria by the sea.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Checked tablecloths.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Candles in wine bottles.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Sunset through salt-streaked windows.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A radio murmurs from the kitchen.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "At a corner table sit MARISOL \"MARI\" ABERNATHY-OSEI, 30s, in a blue dress, and her fianc\u00e9, BENEDICT \"BEN\" LINDGREN-ADEBAYO, 30s, in a pressed shirt.", "para": 1, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "Between them: a bread basket and a bottle of white.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Across the room, her sister ROSALIND \"ROZ\" ABERNATHY-OSEI, 30s, in a leather jacket, sits alone with a coffee.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "She watches the couple the way one watches weather.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "A waiter, TOMMASO BELLINI-OKORO, 20s, hovers with a pad.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Ready to order?", "name": "TOMMASO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Mari?", "name": "BEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "You first.", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "The sea bass.", "name": "BEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "The same.", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Wonderful.", "name": "TOMMASO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "He hurries off.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Mari plays with the stem of her glass.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Ben breaks a piece of bread and doesn't eat it.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "You're quiet.", "name": "BEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "I'm tired.", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "You said that at lunch.", "name": "BEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "I was tired at lunch.", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "From across the room, Roz lifts her coffee in a mock toast.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Mari sees it.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Looks away.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Ben follows her gaze.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Is that your sister?", "name": "BEN", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Probably.", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "You didn't say she'd be here.", "name": "BEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "I didn't know.", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Shall I invite her?", "name": "BEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "No.", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Mari.", "name": "BEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Don't.", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "The radio in the kitchen crackles.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "A DJ's voice cuts through.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "dialogue", "text": "And that was the Delfonics, for the lovers out there tonight. Next up, a request from Roz in booth six, for Mari.", "name": "RADIO", "speaker": 7, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "action", "text": "Mari stiffens.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "action", "text": "Ben looks up.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 41, "kind": "action", "text": "Roz does not move.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 42, "kind": "dialogue", "text": "\"Mari, I'm sorry I never came to the wedding rehearsal. Please dance with me.\"", "name": "RADIO", "speaker": 7, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 43, "kind": "action", "text": "A slow, old song begins.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 44, "kind": "action", "text": "Mari closes her eyes.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 45, "kind": "dialogue", "text": "What is this?", "name": "BEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 46, "kind": "dialogue", "text": "It's our song.", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 47, "kind": "dialogue", "text": "We don't have a song.", "name": "BEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 48, "kind": "dialogue", "text": "Roz and I do.", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 49, "kind": "action", "text": "Ben sets down the bread.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 50, "kind": "action", "text": "Mari stands.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 51, "kind": "action", "text": "Takes a step toward Roz's table.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 52, "kind": "action", "text": "Stops.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 53, "kind": "action", "text": "Looks at Ben.", "para": 9, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 54, "kind": "dialogue", "text": "I'm going to dance.", "name": "MARI", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the room, quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 55, "kind": "action", "text": "The room goes still.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 56, "kind": "action", "text": "Tommaso, mid-stride with a tray, pauses.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 57, "kind": "action", "text": "A fork drops somewhere.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 58, "kind": "dialogue", "text": "Mari. Now?", "name": "BEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 59, "kind": "dialogue", "text": "Yes.", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 60, "kind": "dialogue", "text": "With her?", "name": "BEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 61, "kind": "dialogue", "text": "With my sister.", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 62, "kind": "action", "text": "Ben stares at his plate.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 63, "kind": "action", "text": "Rises, pushes in his chair.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 64, "kind": "action", "text": "Steps aside with a small, brittle bow.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 65, "kind": "dialogue", "text": "Go on, then.", "name": "BEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 66, "kind": "action", "text": "Mari crosses to Roz.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 67, "kind": "action", "text": "Holds out a hand.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 68, "kind": "action", "text": "Roz takes it.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 69, "kind": "action", "text": "They move onto the little cleared floor between tables, and the song swells, and the sea goes violet at the windows.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 70, "kind": "action", "text": "Tommaso sets down the tray.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 71, "kind": "action", "text": "Across the room, Ben pours himself a glass of the white, drinks it quickly, and pours another.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 72, "kind": "dialogue", "text": "Sea bass, sir?", "name": "TOMMASO", "speaker": 5, "ext": [], "paren": ["to Ben, gently"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 73, "kind": "dialogue", "text": "Give it to the gulls.", "name": "BEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 74, "kind": "action", "text": "Tommaso nods.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 75, "kind": "action", "text": "Retreats.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 76, "kind": "action", "text": "The song reaches its bridge.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 77, "kind": "action", "text": "Roz whispers something in Mari's ear.", "para": 14, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 78, "kind": "action", "text": "Mari laughs, and then, abruptly, she isn't laughing.", "para": 14, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 79, "kind": "dialogue", "text": "You always do this.", "name": "MARI", "speaker": 0, "ext": [], "paren": ["to Roz"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 80, "kind": "dialogue", "text": "Do what?", "name": "ROZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 81, "kind": "dialogue", "text": "Arrive at the end.", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 82, "kind": "dialogue", "text": "Somebody has to.", "name": "ROZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 83, "kind": "action", "text": "The music fades.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 84, "kind": "action", "text": "The radio hisses.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 85, "kind": "action", "text": "Mari lets go of Roz's hand.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 86, "kind": "dialogue", "text": "I'm marrying him.", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 87, "kind": "dialogue", "text": "I know.", "name": "ROZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 88, "kind": "dialogue", "text": "Will you come?", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 89, "kind": "dialogue", "text": "If you ask nicely.", "name": "ROZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 90, "kind": "action", "text": "Mari returns to the table.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 91, "kind": "action", "text": "Sits.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 92, "kind": "action", "text": "Takes Ben's glass from him, empties it, hands it back.", "para": 16, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 93, "kind": "dialogue", "text": "I'm hungry.", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 94, "kind": "dialogue", "text": "The sea bass was for the gulls.", "name": "BEN", "speaker": 2, "ext": [], "paren": ["a breath"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 95, "kind": "dialogue", "text": "Then we'll order again.", "name": "MARI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 96, "kind": "action", "text": "Tommaso, hearing, glides over, pad ready.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 97, "kind": "dialogue", "text": "Wonderful.", "name": "TOMMASO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 98, "kind": "action", "text": "Roz drains her coffee, stands, drops a few bills on the table, and walks out into the dusk.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}