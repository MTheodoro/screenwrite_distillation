{"scene_id": "s01561_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01561.fountain", "heading": "INT. ROOM SEVEN - CONTINUOUS", "cast": [{"id": 0, "name": "PHILOMENA", "names": ["PHILOMENA"], "gender": "m", "first": 7, "spoke": 3}, {"id": 1, "name": "ODALYS ABERNATHY-FENWICK", "names": ["ODALYS ABERNATHY-FENWICK", "ODALYS"], "gender": "f", "first": 15, "spoke": 4}, {"id": 2, "name": "VANTERPOOL", "names": ["VANTERPOOL", "MAN"], "gender": "m", "first": 4, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROOM SEVEN - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "A small girl, five, on the bed, tiny chest still.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Monitors scream.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Her mother is not present.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The Man leans in.", "para": 1, "sent": 0, "present": [2]}, {"u": 5, "kind": "action", "text": "Starts compressions with two fingers.", "para": 1, "sent": 1, "present": [2]}, {"u": 6, "kind": "dialogue", "text": "Epi!", "name": "MAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [2]}, {"u": 7, "kind": "dialogue", "text": "Pushing!", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 2]}, {"u": 8, "kind": "dialogue", "text": "Again!", "name": "MAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 2]}, {"u": 9, "kind": "action", "text": "The monitor spikes.", "para": 2, "sent": 0, "present": [0, 2]}, {"u": 10, "kind": "action", "text": "Then another tracing.", "para": 2, "sent": 1, "present": [0, 2]}, {"u": 11, "kind": "action", "text": "The girl gasps.", "para": 2, "sent": 2, "present": [0, 2]}, {"u": 12, "kind": "dialogue", "text": "She's back.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 2]}, {"u": 13, "kind": "action", "text": "The Man wilts.", "para": 3, "sent": 0, "present": [0, 2]}, {"u": 14, "kind": "action", "text": "Wipes his forehead with his sleeve.", "para": 3, "sent": 1, "present": [0, 2]}, {"u": 15, "kind": "action", "text": "A woman in a coat bursts through the door, wild-eyed.", "para": 4, "sent": 0, "present": [0, 2]}, {"u": 16, "kind": "action", "text": "MRS. ODALYS ABERNATHY-FENWICK, 30s, the girl's mother.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Is she--", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "She's breathing.", "name": "MAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Thank you. Thank God. Thank you, Dr. Vanterpool.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "The Man closes his eyes.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "I'm not a doctor.", "name": "VANTERPOOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "What?", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "I'm the night janitor.", "name": "VANTERPOOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Don Vanterpool. He's been here twenty years.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "But you saved her.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "I watched the doctors. For twenty years.", "name": "VANTERPOOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Odalys takes his hand in both of hers.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Philomena looks at him as if seeing him for the first time.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Somebody had to start.", "name": "VANTERPOOL", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}]}