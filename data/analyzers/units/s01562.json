{"scene_id": "s01562", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01562.fountain", "heading": "INT. NEONATAL ICU - NURSES' STATION - 3 A.M.", "cast": [{"id": 0, "name": "SAOIRSE ACHEBE-LINDGREN", "names": ["SAOIRSE ACHEBE-LINDGREN", "SAOIRSE"], "gender": "m", "first": 4, "spoke": 10}, {"id": 1, "name": "NURSE PERPETUA OKONKWO-HART", "names": ["NURSE PERPETUA OKONKWO-HART", "PERPETUA"], "gender": "?", "first": 5, "spoke": 5}, {"id": 2, "name": "ELIAS FAIRWEATHER-NNAMDI", "names": ["ELIAS FAIRWEATHER-NNAMDI", "ELIAS"], "gender": "?", "first": 6, "spoke": 5}, {"id": 3, "name": "HOLLIS BRZEZINSKI-OSEI", "names": ["HOLLIS BRZEZINSKI-OSEI", "HOLLIS"], "gender": "m", "first": 7, "spoke": 17}], "units": [{"u": 0, "kind": "heading", "text": "INT. NEONATAL ICU - NURSES' STATION - 3 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "Low lights.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Monitors blink like fireflies.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Incubators glow along the far wall.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. SAOIRSE ACHEBE-LINDGREN, 40s, scrubs rumpled, drinks cold tea.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "NURSE PERPETUA OKONKWO-HART, 50s, charts at the desk.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "RESIDENT DR. ELIAS FAIRWEATHER-NNAMDI, 20s, rubs his eyes.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "And the father, HOLLIS BRZEZINSKI-OSEI, 30s, in a jacket over pyjamas, stands with a paper cup he has not touched.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Mr. Brzezinski-Osei, sit down.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "I'd rather stand.", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Please.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Is she worse?", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "She's the same.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "The same.", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Her numbers are stable.", "name": "PERPETUA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Her oxygen sats are ninety-four.", "name": "ELIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Is that good?", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "It's better than yesterday.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "But it's not good.", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "It's within range.", "name": "ELIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Whose range?", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Ours.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Mr. Brzezinski-Osei, she is fighting.", "name": "PERPETUA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "She weighs less than a bag of sugar.", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "She weighs one kilo, four hundred.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Everyone keeps telling me the number.", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "It's what we have.", "name": "ELIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "I have a name for her.", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "We know. Matilda.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "She doesn't know it.", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "She does. I say it every shift.", "name": "PERPETUA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "You say it?", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Every shift, Mr. Brzezinski-Osei.", "name": "PERPETUA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Hollis puts down the cup.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Presses his palms to his eyes.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Can I hold her?", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Not tonight.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "When?", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "When her numbers hold for twenty-four hours.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "And if they don't?", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "They will.", "name": "ELIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "You don't know that.", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "No. I don't.", "name": "ELIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "A monitor chirps.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Perpetua looks up, checks the bay, nods.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "She's fine. A feeding pump.", "name": "PERPETUA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Hollis laughs, shaky.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Sits.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Finally.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Tell me about the pump.", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "It's a pump.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Tell me anyway.", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Saoirse sits across from him.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Takes his hand.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Begins to explain.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}]}