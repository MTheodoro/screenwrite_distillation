{"scene_id": "s01563", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01563.fountain", "heading": "EXT. LANTERN MARSH - TWILIGHT", "cast": [{"id": 0, "name": "SERAPHINA ACHEBE-LINDQVIST", "names": ["SERAPHINA ACHEBE-LINDQVIST", "SERAPHINA"], "gender": "?", "first": 5, "spoke": 10}, {"id": 1, "name": "FERRYWOMAN", "names": ["FERRYWOMAN"], "gender": "f", "first": 8, "spoke": 6}, {"id": 2, "name": "SHADOW", "names": ["SHADOW"], "gender": "?", "first": 21, "spoke": 12}], "units": [{"u": 0, "kind": "heading", "text": "EXT. LANTERN MARSH - TWILIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A shallow lake of black water under a violet sky.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Reeds taller than houses.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Thousands of lanterns drift above the surface, each held by a thin silver thread that rises into mist.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The air smells of rain and old coins.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "On a rotted jetty at the edge of the marsh stands SERAPHINA ACHEBE-LINDQVIST, 17, in a ragged green cloak, a lantern pole in her fist.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her boots are wet to the knee.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Her hair has come loose from its braid.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "Behind her, wrapped in a patchwork shawl, a figure sits on an overturned bucket: THE FERRYWOMAN, ageless, skin like bark, eyes pale as river stones.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "She mends a net by feel.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "A third presence stirs in the reeds.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "A boy-shaped shadow with a heron's long legs, wading toward them without a sound.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Is that him?", "name": "SERAPHINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "That is what comes.", "name": "FERRYWOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "I asked who.", "name": "SERAPHINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "And I answered.", "name": "FERRYWOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "The shadow reaches the jetty.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Climbs up, dripping.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "It unfolds into a gaunt young man in a ferryman's coat, face white and handsome, eyes dark as wells.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He looks at Seraphina.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Bows.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Greetings.", "name": "SHADOW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Who are you?", "name": "SERAPHINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Whoever you need.", "name": "SHADOW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Do not trust him.", "name": "FERRYWOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "She never does.", "name": "SHADOW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Seraphina steps back.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "The lantern pole trembles.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "The threads overhead hum.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "I came for my brother.", "name": "SERAPHINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "I know.", "name": "SHADOW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "They said you took him.", "name": "SERAPHINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "They say a great deal.", "name": "SHADOW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Did you?", "name": "SERAPHINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "The Shadow glances at the Ferrywoman.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "She does not look up from her net.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Your brother is a lantern. Third row, left of the willow.", "name": "SHADOW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "A lantern?", "name": "SERAPHINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "They all are, eventually.", "name": "SHADOW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Seraphina looks out at the thousands of lights.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "They sway, gentle, indifferent.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "I want him back.", "name": "SERAPHINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "I can make an exchange.", "name": "SHADOW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Seraphina.", "name": "FERRYWOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "What exchange?", "name": "SERAPHINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "A year of your life.", "name": "SHADOW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "A year.", "name": "SERAPHINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "For a year of his.", "name": "SHADOW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "The Ferrywoman drops her net.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "It slides off her knee into the water, and sinks.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Listen to me, child. He is not what he says.", "name": "FERRYWOMAN", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "I am exactly what I say.", "name": "SHADOW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Then tell her your name.", "name": "FERRYWOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "The Shadow smiles for the first time.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "A smile like a closing door.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "Orren.", "name": "SHADOW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "At the word, every lantern on the marsh flares, a thousand white flames at once, and Seraphina cries out and raises an arm against the glare.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Orren stands in the light, untouched, polite, waiting.", "para": 10, "sent": 1, "present": [0, 1, 2]}]}