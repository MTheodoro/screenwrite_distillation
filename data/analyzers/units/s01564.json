{"scene_id": "s01564", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01564.fountain", "heading": "EXT. LIFE RAFT - OPEN OCEAN - DAY", "cast": [{"id": 0, "name": "LEILA ACHEBE-KOWALCZYK", "names": ["LEILA ACHEBE-KOWALCZYK", "LEILA"], "gender": "?", "first": 5, "spoke": 7}, {"id": 1, "name": "ANSELM ODUYA-FENWICK", "names": ["ANSELM ODUYA-FENWICK", "ANSELM"], "gender": "?", "first": 6, "spoke": 7}, {"id": 2, "name": "SOLENE BRZEZINSKI-OKORO", "names": ["SOLENE BRZEZINSKI-OKORO", "SOLENE"], "gender": "f", "first": 7, "spoke": 7}, {"id": 3, "name": "CAPTAIN ELWOOD NNAMDI-LINDQVIST", "names": ["CAPTAIN ELWOOD NNAMDI-LINDQVIST", "ELWOOD"], "gender": "m", "first": 8, "spoke": 3}, {"id": 4, "name": "KIT ADEBAYO-HART", "names": ["KIT ADEBAYO-HART", "KIT"], "gender": "?", "first": 9, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. LIFE RAFT - OPEN OCEAN - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A yellow raft on flat grey water.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A torn canopy flaps.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The horizon is empty.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Five survivors share the space.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "LEILA ACHEBE-KOWALCZYK, 30s, ties a rag to an oar.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "ANSELM ODUYA-FENWICK, 40s, bails with a cut-off bottle.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "SOLENE BRZEZINSKI-OKORO, 20s, hugs her knees.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Old CAPTAIN ELWOOD NNAMDI-LINDQVIST, 60s, fingers a rosary.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "And little KIT ADEBAYO-HART, 12, lies curled in the middle.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Eight days.", "name": "LEILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Nine.", "name": "ANSELM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Eight.", "name": "LEILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "She counted the first night as one.", "name": "ANSELM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "I didn't count.", "name": "SOLENE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Nine, then.", "name": "ELWOOD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Anselm bails.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Water arcs over the side.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "No one speaks.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Is it going to rain?", "name": "KIT", "speaker": 4, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "No.", "name": "SOLENE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "How do you know?", "name": "KIT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "I don't.", "name": "SOLENE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Don't tell him that.", "name": "LEILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Why not? It's true.", "name": "ANSELM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Because he's twelve.", "name": "LEILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Elwood turns a bead.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Mouths a word.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Solene watches the rosary as if it might answer.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Captain. Are we drifting?", "name": "SOLENE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "North.", "name": "ELWOOD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Towards what?", "name": "SOLENE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Towards nothing.", "name": "ELWOOD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Anselm stops bailing.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Stares at the water.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "There's a shadow.", "name": "ANSELM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Where?", "name": "LEILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Under us.", "name": "ANSELM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "They all lean.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "A long dark shape slides beneath the raft, then another.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Leila grips Kit's shoulder.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Anselm lifts the bottle like a weapon.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Elwood closes his eyes.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Don't look.", "name": "SOLENE", "speaker": 2, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Why?", "name": "KIT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Because it looks back.", "name": "SOLENE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "The shapes pass.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Water laps.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "The raft rocks, gently, and settles.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Dolphins.", "name": "LEILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Sharks.", "name": "ANSELM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "Dolphins, Anselm.", "name": "LEILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "Fine. Dolphins.", "name": "ANSELM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Kit laughs, small, cracked.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "Elwood opens his eyes and looks at the sky, where a thin line of cloud has appeared in the east.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}]}