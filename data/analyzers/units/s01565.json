{"scene_id": "s01565", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01565.fountain", "heading": "INT. ROOFTOP GREENHOUSE RESTAURANT - NIGHT", "cast": [{"id": 0, "name": "ARCHIE", "names": ["ARCHIE"], "gender": "m", "first": 7, "spoke": 6}, {"id": 1, "name": "ISADORA ADEYEMI-VANCE", "names": ["ADEYEMI-VANCE", "ISADORA ADEYEMI-VANCE", "ISADORA"], "gender": "f", "first": 7, "spoke": 5}, {"id": 2, "name": "THAD", "names": ["THAD"], "gender": "m", "first": 11, "spoke": 5}, {"id": 3, "name": "KOWALCZYK-OSEI", "names": ["KOWALCZYK-OSEI"], "gender": "?", "first": 11, "spoke": 0}, {"id": 4, "name": "MADAME LUCRETIA FAIRWEATHER-NNAMDI", "names": ["MADAME LUCRETIA FAIRWEATHER-NNAMDI", "LUCRETIA"], "gender": "?", "first": 13, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROOFTOP GREENHOUSE RESTAURANT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A glass pavilion on top of a skyscraper.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Tomato vines climb strings overhead.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Candles on white tablecloths.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The city glitters below like spilled sequins.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Only one table is occupied.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "At it sit four people.", "para": 1, "sent": 0, "present": []}, {"u": 7, "kind": "action", "text": "ARCHIBALD \"ARCHIE\" ADEYEMI-VANCE, 60s, silver hair, bespoke suit, ring on every finger.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He swirls wine and watches no one.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "His daughter, ISADORA ADEYEMI-VANCE, 30s, in a red dress, sits straight, hands on the cloth.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Her smile is not a smile.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Opposite her, THADDEUS \"THAD\" KOWALCZYK-OSEI, 40s, a lawyer, loosens his tie and sweats.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "His briefcase rests under his chair.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "And at the head, quiet as a stone: MADAME LUCRETIA FAIRWEATHER-NNAMDI, 70s, black lace gloves, who has not spoken since the soup.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "The tomatoes are from the vine above us.", "name": "ARCHIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Impressive.", "name": "THAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "He says that every year.", "name": "ISADORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Because it's true every year.", "name": "ARCHIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "The knife, Archibald.", "name": "LUCRETIA", "speaker": 4, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Archie glances at the steak knife by his plate.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Slowly pushes it away from him.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Of course.", "name": "ARCHIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Mr. Adeyemi-Vance, if we could return to the papers--", "name": "THAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Papers.", "name": "ISADORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "The transfer of shares.", "name": "THAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "After dessert.", "name": "ARCHIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "^After dessert, Thad. Always after dessert.", "name": "ISADORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Neither of them looks at the other.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Lucretia lifts a finger, and the candles flicker as a gust finds the vents.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "My late husband built this building. On a handshake.", "name": "LUCRETIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "So I've heard.", "name": "THAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "He would have disliked the tomatoes.", "name": "LUCRETIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Lucretia, we all have our vices.", "name": "ARCHIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Yours cost him forty million.", "name": "LUCRETIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Silence.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "A tomato vine sways.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Archie sets down his glass.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Isadora folds her napkin into a neat square.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Thad reaches under his chair for the briefcase.", "para": 8, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Madame, I'm only here to--", "name": "THAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Sit, young man.", "name": "LUCRETIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "He sits.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Isadora, my dear. You may open the window.", "name": "LUCRETIA", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Which one?", "name": "ISADORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "The big one.", "name": "LUCRETIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Isadora rises.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Crosses to the glass wall.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Flips a latch.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "A section slides back and night air pours in, cold and loud with traffic far below.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "What are you doing?", "name": "ARCHIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Letting in a draught.", "name": "ISADORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "She returns to the table.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Resumes her seat.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Takes the steak knife from beside her father's plate and lays it across her own, perfectly aligned.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "Archibald. The papers.", "name": "LUCRETIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Archie's mouth tightens.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "He reaches into his jacket, draws out a folded envelope, and slides it across the cloth.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}]}