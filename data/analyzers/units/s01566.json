{"scene_id": "s01566", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01566.fountain", "heading": "EXT. THE GLASS DESERT - DAWN", "cast": [{"id": 0, "name": "WARDEN SALT", "names": ["WARDEN SALT", "WARDEN"], "gender": "f", "first": 7, "spoke": 22}, {"id": 1, "name": "OPPOSITE HER", "names": ["OPPOSITE HER"], "gender": "?", "first": 9, "spoke": 0}, {"id": 2, "name": "WILLA", "names": ["WILLA"], "gender": "f", "first": 9, "spoke": 21}, {"id": 3, "name": "FAIRWEATHER-ACHEBE", "names": ["FAIRWEATHER-ACHEBE"], "gender": "?", "first": 9, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. THE GLASS DESERT - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A vast plain of fused sand, smooth as a frozen sea.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wind carves ripples in the surface.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The sky is a bruise of peach and violet.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Far off, a ridge of black towers rises like broken teeth.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Two figures stand on the glass.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "Each throws a long shadow.", "para": 1, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "THE WARDEN OF SALT, tall, gaunt, draped in a cloak of white crystals, holds a staff topped with a clouded lens.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Where her feet touch the glass, small stars of frost bloom.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "OPPOSITE HER, a girl: WILHELMINA \"WILLA\" FAIRWEATHER-ACHEBE, 15, in a patched travelling coat, a leather satchel across her chest.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "She carries a lantern whose flame is a deep, steady blue.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "You are a long way from the green.", "name": "WARDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "I had a reason.", "name": "WILLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Everyone does.", "name": "WARDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Mine is better.", "name": "WILLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "The Warden tilts her head.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "The crystals on her cloak chime.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Show me.", "name": "WARDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Willa lifts the lantern.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "The blue flame flares.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Across the glass, a hundred feet away, a patch of sand ripples and darkens, as though something beneath it has turned over in its sleep.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Who gave you that?", "name": "WARDEN", "speaker": 0, "ext": ["CONT'D"], "paren": ["a long breath"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "My grandmother.", "name": "WILLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Where is she?", "name": "WARDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Under the sand.", "name": "WILLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "I do not take the dead.", "name": "WARDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "She said you'd say that.", "name": "WILLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "The Warden raises her staff.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "The lens clears.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "In it, a swirl of tiny figures: a woman in a shawl, a child on her knee, an old man laughing, all spinning slowly.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "That's her.", "name": "WILLA", "speaker": 2, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "So it is.", "name": "WARDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Let her go.", "name": "WILLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "She is not mine to release.", "name": "WARDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Then whose?", "name": "WILLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "The Warden looks past the girl at the black towers.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Wind rattles the crystals on her cloak.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Theirs.", "name": "WARDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "The Silent Court.", "name": "WILLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "You know the name.", "name": "WARDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "I know all the names. She taught me.", "name": "WILLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Willa steps forward.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "The lantern's blue light spills across the glass, and where it touches, cracks race out in glittering fans.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "The Warden stumbles back a half step.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Careful. This ground is old.", "name": "WARDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "So am I.", "name": "WILLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "You are fifteen.", "name": "WARDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "I've been fifteen a long time.", "name": "WILLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "They stand.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "The wind drops.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Even the cracks stop whispering.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "What will you give?", "name": "WARDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "What do you ask?", "name": "WILLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "A season of your life.", "name": "WARDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Which season?", "name": "WILLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Spring.", "name": "WARDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Willa's face does not change.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Her hand tightens on the lantern.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "Why spring?", "name": "WILLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "Because it is when you were meant to bloom.", "name": "WARDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "And in exchange?", "name": "WILLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "One hour with her. No more.", "name": "WARDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "An hour.", "name": "WILLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "Under the sand. Where she sleeps.", "name": "WARDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "Willa looks at the blue flame.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "At the towers.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "At the lens, where a tiny woman raises her small hand.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "One hour.", "name": "WILLA", "speaker": 2, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "Choose.", "name": "WARDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "dialogue", "text": "I choose.", "name": "WILLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "dialogue", "text": "Speak it.", "name": "WARDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "At the same moment, in the same breath, both of them whisper a single word.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "Yes.", "name": "WILLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "Yes.", "name": "WARDEN", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "The glass shudders.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "A wide circle of the desert floor turns clear as water, and beneath it, deep down, a long stair descends into lamplight.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "The Warden steps aside.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "She sweeps one crystalled arm toward the opening.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "action", "text": "Willa walks forward, lantern held before her.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "action", "text": "Frost blooms behind her heels.", "para": 14, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "action", "text": "At the edge of the clear circle she pauses.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "action", "text": "Does not turn.", "para": 15, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "dialogue", "text": "Warden. Will it hurt?", "name": "WILLA", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "dialogue", "text": "Only when you climb back up.", "name": "WARDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 84, "kind": "action", "text": "Willa nods.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 85, "kind": "action", "text": "Takes the first step down.", "para": 16, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 86, "kind": "action", "text": "The Warden stands alone on the glass, her staff planted, the wind picking up again, until the girl's blue light shrinks to a point and winks out.", "para": 16, "sent": 2, "present": [0, 1, 2, 3]}]}