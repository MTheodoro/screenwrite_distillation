{"scene_id": "s01567", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01567.fountain", "heading": "INT. VILLA TERRACE - DUSK", "cast": [{"id": 0, "name": "SIGNORA CATERINA BELLINI-OKORO", "names": ["SIGNORA CATERINA BELLINI-OKORO", "BELLINI-OKORO", "CATERINA"], "gender": "f", "first": 6, "spoke": 7}, {"id": 1, "name": "FRANCIE", "names": ["FRANCIE"], "gender": "m", "first": 7, "spoke": 1}, {"id": 2, "name": "HARL", "names": ["HARL"], "gender": "?", "first": 8, "spoke": 4}, {"id": 3, "name": "PERPETUA ACHEBE-LINDQVIST", "names": ["ACHEBE-LINDQVIST", "PERPETUA ACHEBE-LINDQVIST", "PERPETUA"], "gender": "f", "first": 8, "spoke": 5}, {"id": 4, "name": "THEO FAIRWEATHER-KOWALCZYK", "names": ["THEO FAIRWEATHER-KOWALCZYK", "THEO"], "gender": "m", "first": 9, "spoke": 5}, {"id": 5, "name": "TILDA", "names": ["TILDA"], "gender": "?", "first": 11, "spoke": 2}, {"id": 6, "name": "ODUYA-HART", "names": ["ODUYA-HART"], "gender": "?", "first": 11, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. VILLA TERRACE - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "A hilltop villa in the Italian lakes.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Terracotta pots spilling bougainvillea.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Fairy lights strung between lemon trees.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Below, the lake lies like polished pewter.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A long table is laid for a wedding rehearsal dinner.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "At the head of it, SIGNORA CATERINA BELLINI-OKORO, 60s, in emerald silk, directs two waiters with small, imperious flicks of her wrist.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Beside her sits her daughter, the bride-to-be, FRANCESCA \"FRANCIE\" BELLINI-OKORO, 28, in a cream wrap, twisting a glass.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "The groom, HARLAN \"HARL\" ACHEBE-LINDQVIST, 30, rakish in rolled sleeves, leans back with a grin.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "His best man, THEO FAIRWEATHER-KOWALCZYK, 31, ties a napkin round his own head as a joke.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Harl's mother, MRS. PERPETUA ACHEBE-LINDQVIST, 55, small, hawk-eyed, sits upright, her handbag clutched on her lap.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "And last, perched on the balustrade like a bird, is Francie's friend ROSALIND \"TILDA\" ODUYA-HART, 28, bridesmaid, sandals dangling.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "Glasses!", "name": "CATERINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "action", "text": "Everyone obeys.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "action", "text": "Waiters pour prosecco.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "Francie, my love.", "name": "HARL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "My love.", "name": "FRANCIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "I object.", "name": "THEO", "speaker": 4, "ext": [], "paren": ["muffled by napkin"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "Theo, you're not the officiant.", "name": "TILDA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "I'm practising.", "name": "THEO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "Harlan. Sit up straight.", "name": "PERPETUA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "Mama, I am.", "name": "HARL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "You slouch like your father.", "name": "PERPETUA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "Perpetua, a toast!", "name": "CATERINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "I don't make toasts.", "name": "PERPETUA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "Then I will.", "name": "CATERINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "action", "text": "She rises.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "Everyone else half-rises in sympathy and sinks again.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "To my daughter, and to this boy who has the grace to look frightened.", "name": "CATERINA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "I'm not frightened.", "name": "HARL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "You're a little frightened.", "name": "THEO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "You're green.", "name": "TILDA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "It's the lighting.", "name": "HARL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "Francie reaches for his hand.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "Harl takes it.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "They are both smiling too widely.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "Perpetua studies them over the rim of her glass.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "Marriage is a long road.", "name": "PERPETUA", "speaker": 3, "ext": [], "paren": ["dry"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "dialogue", "text": "And a longer lunch.", "name": "CATERINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "The table laughs.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "The tension lifts.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "Then, from the villa's terrace door, a clatter.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "A caterer's tray crashes.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "Cannoli skid across the stones.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "Everyone turns.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "action", "text": "In the doorway stands a man in a white jacket, a stranger, looking stricken.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "action", "text": "Behind him a second tray tilts, shuddering.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "dialogue", "text": "Everyone, down!", "name": "THEO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "Chaos.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "action", "text": "Theo dives under the table with his napkin still on his head.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "action", "text": "Tilda leaps off the balustrade.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "action", "text": "Perpetua rises, handbag swinging like a flail.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "action", "text": "Caterina barks at the waiters.", "para": 9, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "action", "text": "Francie and Harl, startled, collapse into each other, upsetting a candelabrum.", "para": 9, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "action", "text": "Prosecco sprays.", "para": 9, "sent": 6, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "action", "text": "The caterer drops to his knees, scrabbling for pastry.", "para": 9, "sent": 7, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "dialogue", "text": "Enough! Enough!", "name": "CATERINA", "speaker": 0, "ext": ["CONT'D"], "paren": ["over the din"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "action", "text": "Silence falls.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "action", "text": "A single cannolo rolls to a stop at Perpetua's foot.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 59, "kind": "action", "text": "She picks it up.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 60, "kind": "action", "text": "Examines it.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 61, "kind": "action", "text": "Bites.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 62, "kind": "dialogue", "text": "Not bad.", "name": "PERPETUA", "speaker": 3, "ext": [], "paren": ["chewing"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 63, "kind": "action", "text": "The terrace erupts in laughter.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 64, "kind": "action", "text": "Harl kisses Francie.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 65, "kind": "action", "text": "Tilda applauds.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 66, "kind": "action", "text": "Theo emerges from under the table, napkin crooked.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 67, "kind": "dialogue", "text": "Did I miss the vows?", "name": "THEO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 68, "kind": "dialogue", "text": "Not yet, caro. Sit.", "name": "CATERINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 69, "kind": "action", "text": "The waiters refill glasses.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 70, "kind": "action", "text": "The lights twinkle.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 71, "kind": "action", "text": "Below them, the lake darkens, and one by one, the lamps of the far shore come on.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}]}