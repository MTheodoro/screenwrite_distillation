{"scene_id": "s01568", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01568.fountain", "heading": "INT. NIGHT TRAIN SLEEPER COMPARTMENT - NIGHT", "cast": [{"id": 0, "name": "WENDELL ODUYA-FENWICK", "names": ["WENDELL ODUYA-FENWICK", "WENDELL"], "gender": "?", "first": 5, "spoke": 9}, {"id": 1, "name": "CLEMENTINE ACHEBE-LINDQVIST", "names": ["CLEMENTINE ACHEBE-LINDQVIST", "CLEMENTINE"], "gender": "f", "first": 6, "spoke": 16}, {"id": 2, "name": "LAVINIA BELLINI-OKORO", "names": ["LAVINIA BELLINI-OKORO", "LAVINIA"], "gender": "f", "first": 7, "spoke": 17}, {"id": 3, "name": "ANATOLE KOWALCZYK-ADEYEMI", "names": ["ANATOLE KOWALCZYK-ADEYEMI", "ANATOLE"], "gender": "?", "first": 8, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT TRAIN SLEEPER COMPARTMENT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Rhythmic clatter.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A reading lamp swings on its hook.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain streaks the window.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Two bunks, one folded away.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "WENDELL ODUYA-FENWICK, 40s, sits by the window in shirtsleeves, tie loosened.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "His wife CLEMENTINE ACHEBE-LINDQVIST, 40s, on the bunk, braids her hair without looking.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Her sister LAVINIA BELLINI-OKORO, 30s, stands in the doorway with a suitcase.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "And a conductor, ANATOLE KOWALCZYK-ADEYEMI, 50s, hovers in the corridor, punching tickets.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "He glances at the others.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "She doesn't glance back.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "They have not spoken for a long time.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Is there room?", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "There's always room.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "For a suitcase?", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "For a suitcase, yes.", "name": "WENDELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "She enters.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "He shifts.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Their knees brush.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "He pulls his away.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Tickets, please.", "name": "ANATOLE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "He punches two.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Hesitates at the third.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Clementine hands it over without a word.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "He nods, moves on.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "The door slides shut.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "The train rocks.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Lavinia sits on the lower bunk, opposite Clementine.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "You look tired.", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "You look thin.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "I've been travelling.", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "So have we.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Where to?", "name": "WENDELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Anywhere with a sea.", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "There's a sea at the end of this line.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "That's what I heard.", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Who told you?", "name": "WENDELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "A man at the station. He said the sea turns green in September.", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "It does.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Have you seen it?", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Once. A long time ago.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "With me.", "name": "WENDELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "With you.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "A pause.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "The train sways.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Lavinia looks at her hands.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Wendell looks at the rain.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Clementine finishes the braid and ties it off.", "para": 7, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "I should have written.", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "You should have.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "I'm sorry.", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "So am I.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Shall I open a window?", "name": "WENDELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "It's raining.", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "It's close in here.", "name": "WENDELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Leave it.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "All right.", "name": "WENDELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "I met someone.", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "Good.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "It didn't end well.", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "They rarely do.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "Clementine.", "name": "WENDELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "What? It's true.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "No, she's right. They don't.", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "Do you want tea?", "name": "WENDELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "Please.", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "He rises.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "Opens the door.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "Disappears into the corridor.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "The two sisters sit across from each other, alone, the rain tapping the glass.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "dialogue", "text": "He's changed.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "dialogue", "text": "Has he?", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "He lets me braid my own hair.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "action", "text": "They share a smile.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "Small.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "Then bigger.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "Lavinia wipes her eye with the back of her hand.", "para": 9, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "dialogue", "text": "I missed you.", "name": "LAVINIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "dialogue", "text": "I know.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "action", "text": "She reaches across, pulls her sister close, and holds her.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "action", "text": "Over Lavinia's shoulder she watches the door.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "action", "text": "Wendell returns with three cups.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "action", "text": "He stops in the doorway, sees them.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "action", "text": "Sets the tray down gently on the bunk and quietly steps back out.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}]}