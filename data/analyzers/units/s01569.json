{"scene_id": "s01569", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01569.fountain", "heading": "EXT. FLOODED RICE PADDY - NIGHT", "cast": [{"id": 0, "name": "GUS", "names": ["GUS"], "gender": "m", "first": 6, "spoke": 12}, {"id": 1, "name": "ADEBAYO-KOWALCZYK", "names": ["ADEBAYO-KOWALCZYK"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "TEDDY", "names": ["TEDDY"], "gender": "?", "first": 7, "spoke": 6}, {"id": 3, "name": "FAIRWEATHER-LINDQVIST", "names": ["FAIRWEATHER-LINDQVIST"], "gender": "?", "first": 7, "spoke": 0}, {"id": 4, "name": "PRIVATE MARCEL BELLINI-OKORO", "names": ["PRIVATE MARCEL BELLINI-OKORO", "MARCEL"], "gender": "?", "first": 8, "spoke": 6}, {"id": 5, "name": "IGGY", "names": ["IGGY"], "gender": "m", "first": 9, "spoke": 6}, {"id": 6, "name": "NNAMDI-HART", "names": ["NNAMDI-HART"], "gender": "?", "first": 9, "spoke": 0}, {"id": 7, "name": "RADIO", "names": ["RADIO"], "gender": "?", "first": 27, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FLOODED RICE PADDY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Moonlight on black water.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A burned-out watchtower.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Reeds rustle.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Distant artillery thumps.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Four soldiers wade in a ragged line.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "SERGEANT AUGUSTINE \"GUS\" ADEBAYO-KOWALCZYK, 40s, point man, signals with a fist.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "CORPORAL THEODORA \"TEDDY\" FAIRWEATHER-LINDQVIST, 20s, carries a radio on her back.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "PRIVATE MARCEL BELLINI-OKORO, 19, shivers, rifle held high.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "And MEDIC IGNATIUS \"IGGY\" NNAMDI-HART, 30s, limps, red cross faded on his sleeve.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "action", "text": "They stop.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "action", "text": "Listen.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "action", "text": "The reeds sigh.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "Hold.", "name": "GUS", "speaker": 0, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "Sarge?", "name": "TEDDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "Quiet.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "I hear something.", "name": "MARCEL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "It's the water.", "name": "IGGY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "It's footsteps.", "name": "MARCEL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "Both of you shut it.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "action", "text": "A twig snaps ahead.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "action", "text": "All four freeze.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "action", "text": "A flare arcs overhead and bursts, white, turning the paddy to a lit stage.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "The soldiers dive into the water, sinking to their chests.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "action", "text": "The flare drops.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "action", "text": "Darkness.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "Falcon Two, this is Base. Report.", "name": "RADIO", "speaker": 7, "ext": ["V.O."], "paren": ["crackling"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 28, "kind": "action", "text": "Teddy grabs the handset, whispers back.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 29, "kind": "dialogue", "text": "Base, we have contact. Grid four-seven.", "name": "TEDDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "dialogue", "text": "Say again.", "name": "RADIO", "speaker": 7, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "dialogue", "text": "Contact, four-seven! Repeat, contact!", "name": "TEDDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "action", "text": "A crack of gunfire.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "action", "text": "Muzzle flashes stitch the reeds.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "action", "text": "Marcel screams.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "action", "text": "Gus hurls himself on top of him, pushing him under the water as bullets zip past.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "action", "text": "Iggy crawls toward them, pulling a bandage from his pack.", "para": 7, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "action", "text": "Teddy returns fire blindly.", "para": 7, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "dialogue", "text": "Marcel! Marcel!", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "dialogue", "text": "I'm okay! I'm okay!", "name": "MARCEL", "speaker": 4, "ext": [], "paren": ["spluttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "dialogue", "text": "You're hit.", "name": "IGGY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 41, "kind": "dialogue", "text": "Where?", "name": "MARCEL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 42, "kind": "dialogue", "text": "Shoulder.", "name": "IGGY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 43, "kind": "dialogue", "text": "Can he move?", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 44, "kind": "dialogue", "text": "He'll have to.", "name": "IGGY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 45, "kind": "dialogue", "text": "Falcon Two, hold your position. Air support inbound.", "name": "RADIO", "speaker": 7, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 46, "kind": "dialogue", "text": "How long?", "name": "TEDDY", "speaker": 2, "ext": [], "paren": ["shouting"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 47, "kind": "dialogue", "text": "Four minutes.", "name": "RADIO", "speaker": 7, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 48, "kind": "dialogue", "text": "Four minutes. We can do four minutes.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 49, "kind": "action", "text": "Teddy and Gus exchange a look.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 50, "kind": "action", "text": "Gus drags Marcel behind the burned tower.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 51, "kind": "action", "text": "Iggy follows, hands slick.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 52, "kind": "action", "text": "Teddy lays down fire in short, disciplined bursts.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 53, "kind": "dialogue", "text": "Hold him.", "name": "IGGY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 54, "kind": "dialogue", "text": "Got him.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 55, "kind": "action", "text": "Iggy tears the sleeve.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 56, "kind": "action", "text": "Packs the wound.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 57, "kind": "action", "text": "Marcel groans.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 58, "kind": "dialogue", "text": "Sarge, I'm sorry.", "name": "MARCEL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 59, "kind": "dialogue", "text": "For what?", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 60, "kind": "dialogue", "text": "I made noise.", "name": "MARCEL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 61, "kind": "dialogue", "text": "We all make noise, son.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 62, "kind": "action", "text": "Gunfire slackens.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 63, "kind": "action", "text": "Teddy ducks back, breathing hard.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 64, "kind": "dialogue", "text": "They're pulling back.", "name": "TEDDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 65, "kind": "dialogue", "text": "Or flanking.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 66, "kind": "dialogue", "text": "Which?", "name": "IGGY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 67, "kind": "dialogue", "text": "Doesn't matter.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 68, "kind": "action", "text": "A drone in the sky, deep and growing.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 69, "kind": "action", "text": "All four look up.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 70, "kind": "action", "text": "Dark shapes sweep over the moon.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 71, "kind": "dialogue", "text": "That's ours.", "name": "TEDDY", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 72, "kind": "action", "text": "Fire blooms along the treeline.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 73, "kind": "action", "text": "The earth shakes.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 74, "kind": "action", "text": "The soldiers cling to each other behind the tower, water streaming from their faces, laughing and crying at once.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 75, "kind": "dialogue", "text": "Falcon Two, are you still with us?", "name": "RADIO", "speaker": 7, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 76, "kind": "action", "text": "Gus takes the handset from Teddy.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 77, "kind": "dialogue", "text": "Base, Falcon Two. All four. We're still here.", "name": "GUS", "speaker": 0, "ext": [], "paren": ["into the radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}