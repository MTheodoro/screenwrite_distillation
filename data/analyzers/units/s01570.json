{"scene_id": "s01570", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01570.fountain", "heading": "INT. TAXIDERMY SHOP - BACK ROOM - DAWN", "cast": [{"id": 0, "name": "INSPECTOR ADAEZE OKAFOR", "names": ["INSPECTOR ADAEZE OKAFOR", "OKAFOR"], "gender": "m", "first": 4, "spoke": 11}, {"id": 1, "name": "ELIAS VANTERPOOL", "names": ["ELIAS VANTERPOOL", "ELIAS"], "gender": "m", "first": 7, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. TAXIDERMY SHOP - BACK ROOM - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Glass eyes.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Hundreds.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Foxes, owls, one bewildered ostrich.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "INSPECTOR ADAEZE OKAFOR (50s, raincoat, tired eyes) stands over a workbench.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "A half-stuffed heron.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Fresh stitches.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "ELIAS VANTERPOOL (60s, apron, ink-stained thumbs) wipes his hands.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Slowly.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Too slowly.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Nice heron.", "name": "OKAFOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Customer's. Collects Thursday.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Thursday.", "name": "OKAFOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She lifts the heron's wing.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Peers inside.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Sets it down.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Mr. Vanterpool, where were you Sunday night?", "name": "OKAFOR", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Here. Working.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Alone?", "name": "OKAFOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Always alone. Animals don't gossip.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Mrs. Delacroix did. Before she vanished.", "name": "OKAFOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Mrs. Delacroix gossiped about everyone.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "She said you kept a second ledger.", "name": "OKAFOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Everyone keeps a second ledger.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Not everyone keeps it inside a badger.", "name": "OKAFOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Elias glances at the shelf.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Okafor follows his look.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Back to him.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "You've no warrant.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Door was open.", "name": "OKAFOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Door was closed.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Then someone opened it. Funny, that.", "name": "OKAFOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Get out of my shop.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "She paid you for the badger. Didn't she? Forty years of payments. For something that isn't a badger at all.", "name": "OKAFOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Get out.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Where is she, Elias?", "name": "OKAFOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Elias lunges for the shelf.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Okafor tackles him.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "They crash into the workbench.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "The heron topples.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Glass eyes rattle.", "para": 5, "sent": 4, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "They roll.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Elias grabs a scalpel.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "Okafor pins his wrist.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "They freeze, nose to nose, breath ragged.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "The badger falls from the shelf.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Splits open.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Paper spills across the floor.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "Both stare at it.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "Neither moves.", "para": 8, "sent": 1, "present": [0, 1]}]}