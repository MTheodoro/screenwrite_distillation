{"scene_id": "s01573", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01573.fountain", "heading": "INT. GRAIN ELEVATOR CONTROL ROOM - NIGHT", "cast": [{"id": 0, "name": "NADIA KOWALCZYK", "names": ["NADIA KOWALCZYK", "NADIA"], "gender": "f", "first": 5, "spoke": 4}, {"id": 1, "name": "DISPATCH", "names": ["DISPATCH"], "gender": "?", "first": 14, "spoke": 5}, {"id": 2, "name": "MARCUS TREVELYAN", "names": ["MARCUS TREVELYAN", "MARCUS"], "gender": "?", "first": 32, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRAIN ELEVATOR CONTROL ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Concrete.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Steel.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A wall of dead monitors.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "One lit.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "NADIA KOWALCZYK (30s, hard hat, dust in her braid) crouches at a console.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Headset on.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "A flashlight clamped in her teeth.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "She types.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Stops.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "Types.", "para": 2, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "On the monitor: a progress bar.", "para": 3, "sent": 0, "present": [0]}, {"u": 12, "kind": "action", "text": "71%.", "para": 3, "sent": 1, "present": [0]}, {"u": 13, "kind": "action", "text": "The radio on the desk crackles.", "para": 4, "sent": 0, "present": [0]}, {"u": 14, "kind": "dialogue", "text": "Kowalczyk, status.", "name": "DISPATCH", "speaker": 1, "ext": ["V.O."], "paren": ["through static"], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Almost in.", "name": "NADIA", "speaker": 0, "ext": [], "paren": ["into headset"], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Plant manager's asking. He says the auditors arrive at six.", "name": "DISPATCH", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Tell him the auditors can wait.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "He says the auditors can't.", "name": "DISPATCH", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She pulls the flashlight from her mouth.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "84%.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Then tell him the numbers are wrong. Tell him the silo three weights have been wrong since March.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Repeat?", "name": "DISPATCH", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She says nothing.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "96%.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Somewhere below, a heavy door booms shut.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Nadia freezes.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Kills the flashlight.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Footsteps on the steel stairs.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Slow.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Unhurried.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "The door handle turns.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "MARCUS TREVELYAN (50s, plant manager, pressed shirt, no hard hat) steps in.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "He holds a clipboard.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "He smiles.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Working late.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Just routine.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "On a Sunday. At two in the morning.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "The radio crackles.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Kowalczyk? You still there?", "name": "DISPATCH", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Marcus crosses to the radio.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Switches it off.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "The room goes silent but for the console fan.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "On the monitor: 99%.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Nadia's hand drifts to a wrench on the desk.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Step away from the keyboard, Nadia.", "name": "MARCUS", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "She doesn't.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "He drops the clipboard.", "para": 16, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Lunges.", "para": 16, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "The wrench swings.", "para": 17, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "The monitor flashes: 100%.", "para": 17, "sent": 1, "present": [0, 1, 2]}]}