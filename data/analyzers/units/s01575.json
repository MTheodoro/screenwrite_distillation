{"scene_id": "s01575", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01575.fountain", "heading": "INT. COMMUNITY CENTER KITCHEN - MORNING", "cast": [{"id": 0, "name": "WESTBROOK BAKE-OFF", "names": ["WESTBROOK BAKE-OFF"], "gender": "?", "first": 3, "spoke": 0}, {"id": 1, "name": "GLORIA ESPINOSA-REED", "names": ["GLORIA ESPINOSA-REED", "GLORIA"], "gender": "f", "first": 4, "spoke": 21}, {"id": 2, "name": "MAYA", "names": ["MAYA"], "gender": "f", "first": 5, "spoke": 13}, {"id": 3, "name": "TOBY", "names": ["TOBY"], "gender": "m", "first": 6, "spoke": 3}, {"id": 4, "name": "GLORIA'S HUSBAND", "names": ["GLORIA'S HUSBAND"], "gender": "?", "first": 7, "spoke": 0}, {"id": 5, "name": "DENNIS REED", "names": ["DENNIS REED", "DENNIS"], "gender": "m", "first": 4, "spoke": 5}, {"id": 6, "name": "JUDGE'S ASSISTANT", "names": ["JUDGE'S ASSISTANT"], "gender": "?", "first": 21, "spoke": 3}, {"id": 7, "name": "PRUDENCE HARTWELL", "names": ["PRUDENCE HARTWELL", "PRUDENCE"], "gender": "f", "first": 38, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. COMMUNITY CENTER KITCHEN - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "A big institutional kitchen, steel counters, a dozen mismatched pots.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Flour on every surface.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A banner on the wall: \"WESTBROOK BAKE-OFF - 40TH ANNUAL.\"", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "GLORIA ESPINOSA-REED (50s, apron, reading glasses on a chain) kneads dough with ferocity.", "para": 1, "sent": 0, "present": [0, 1, 5]}, {"u": 5, "kind": "action", "text": "Her daughter MAYA (16, headphones around her neck) arranges cooling racks.", "para": 1, "sent": 1, "present": [0, 1, 2, 5]}, {"u": 6, "kind": "action", "text": "Her son TOBY (8, a paper chef hat too big for him) licks a spoon.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 5]}, {"u": 7, "kind": "action", "text": "At the far counter, GLORIA'S HUSBAND, DENNIS REED (50s, mild, a man who apologizes to furniture), is measuring sugar with great care.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "dialogue", "text": "Dennis, level it off.", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "I am leveling it.", "name": "DENNIS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "You're mounding it.", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "It's a gentle mound.", "name": "DENNIS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Dad, it's a hill.", "name": "MAYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Can I have the spoon?", "name": "TOBY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "You already have the spoon.", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Can I have another spoon?", "name": "TOBY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Dennis hands him one.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Gloria sighs, but she is smiling.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "The wall phone rings.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Maya answers it.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Espinosa-Reed residence, kitchen division.", "name": "MAYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Good morning. This is the contest office. We're confirming your entry for ten o'clock.", "name": "JUDGE'S ASSISTANT", "speaker": 6, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Yes. Cinnamon pull-apart.", "name": "MAYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "Wonderful. And the family recipe is original?", "name": "JUDGE'S ASSISTANT", "speaker": 6, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "Totally original.", "name": "MAYA", "speaker": 2, "ext": [], "paren": ["glancing at Gloria"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "Perfect. We'll see you shortly.", "name": "JUDGE'S ASSISTANT", "speaker": 6, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "action", "text": "Maya hangs up.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "Gloria is watching her.", "para": 5, "sent": 1, "present": [0, 1, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "Why did you say it like that?", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "Like what?", "name": "MAYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "Like you were reading it off a card.", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "I wasn't.", "name": "MAYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "Maya.", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "Mom, it's fine.", "name": "MAYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "Is the recipe original?", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "Mom.", "name": "MAYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "Maya Rosalind.", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "It's Grandma Inez's recipe. It's practically ours.", "name": "MAYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "dialogue", "text": "Inez's recipe is from the Hartwell Cookbook, Maya. Page ninety-one. Mrs. Hartwell is a judge.", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "dialogue", "text": "I know.", "name": "MAYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "dialogue", "text": "You know?", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 41, "kind": "dialogue", "text": "I knew last week. I looked it up. I didn't want to say anything.", "name": "MAYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 42, "kind": "dialogue", "text": "You didn't want to say anything.", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 43, "kind": "dialogue", "text": "You looked so happy.", "name": "MAYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 44, "kind": "action", "text": "Dennis sets down the sugar scoop very quietly.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 45, "kind": "action", "text": "Toby stops licking his spoon.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 46, "kind": "dialogue", "text": "I made this recipe for thirty years. My mother gave it to me. She said her mother wrote it herself.", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 47, "kind": "dialogue", "text": "Maybe she did. Maybe she wrote it down from the cookbook.", "name": "MAYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 48, "kind": "dialogue", "text": "Maybe.", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 49, "kind": "dialogue", "text": "Gloria.", "name": "DENNIS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 50, "kind": "dialogue", "text": "Dennis, not now.", "name": "GLORIA", "speaker": 1, "ext": [], "paren": ["sharp"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 51, "kind": "dialogue", "text": "I only meant, maybe change a little. Add the cardamom.", "name": "DENNIS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 52, "kind": "dialogue", "text": "You want me to add the cardamom.", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 53, "kind": "dialogue", "text": "It's the one thing that isn't in the cookbook.", "name": "DENNIS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 54, "kind": "action", "text": "A long silence.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 55, "kind": "action", "text": "The oven timer ticks.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 56, "kind": "dialogue", "text": "Maya, hand me the cardamom.", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 57, "kind": "action", "text": "Maya blinks.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 58, "kind": "action", "text": "Then she crosses to the spice rack and hands over a small tin.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 59, "kind": "action", "text": "The door swings open.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 60, "kind": "action", "text": "MRS. PRUDENCE HARTWELL (70s, lavender cardigan, a clipboard held like a scepter) enters, trailed by an assistant.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 61, "kind": "dialogue", "text": "Gloria, dear, I came early to see the kitchens. Is that cinnamon I smell?", "name": "PRUDENCE", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 62, "kind": "dialogue", "text": "It is.", "name": "GLORIA", "speaker": 1, "ext": [], "paren": ["brightly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 63, "kind": "dialogue", "text": "Is it the pull-apart?", "name": "PRUDENCE", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 64, "kind": "dialogue", "text": "It is.", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 65, "kind": "dialogue", "text": "I used to make one just like it. My own grandmother's recipe. I published it, you know.", "name": "PRUDENCE", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 66, "kind": "action", "text": "Gloria's hand tightens around the cardamom tin.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 67, "kind": "dialogue", "text": "I did not know that.", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 68, "kind": "action", "text": "Prudence leans over the dough, sniffs, and smiles.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 69, "kind": "dialogue", "text": "Oh, there's something different in this. Something warm. What is it?", "name": "PRUDENCE", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 70, "kind": "action", "text": "Maya, Dennis, and Toby all look at Gloria.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 71, "kind": "dialogue", "text": "Cardamom.", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 72, "kind": "dialogue", "text": "Lovely. Page ninety-one, if I'm not mistaken. But with your own touch.", "name": "PRUDENCE", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 73, "kind": "action", "text": "Gloria goes completely still.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 74, "kind": "action", "text": "Prudence pats her arm and sweeps out.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 75, "kind": "action", "text": "The door closes.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 76, "kind": "action", "text": "Nobody speaks.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 77, "kind": "dialogue", "text": "Does that mean we win?", "name": "TOBY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 78, "kind": "action", "text": "Gloria laughs.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 79, "kind": "action", "text": "A short, startled laugh, then a longer one.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 80, "kind": "action", "text": "She wipes her eyes with a floury wrist.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 81, "kind": "dialogue", "text": "It means we bake.", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}