{"scene_id": "s01576", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01576.fountain", "heading": "INT. ROLLER RINK - AFTER HOURS - NIGHT", "cast": [{"id": 0, "name": "JUNE PAIK", "names": ["JUNE PAIK", "JUNE", "MRS. PAIK"], "gender": "f", "first": 8, "spoke": 20}, {"id": 1, "name": "DELROY BASS", "names": ["DELROY BASS", "DELROY"], "gender": "m", "first": 41, "spoke": 12}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROLLER RINK - AFTER HOURS - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Disco ball off.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Work lights on.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Scuffed maple floor.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A snack bar with a hand-lettered menu.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Chairs on tables.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "Mop bucket.", "para": 1, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "Silence.", "para": 1, "sent": 2, "present": []}, {"u": 8, "kind": "action", "text": "JUNE PAIK (16, denim jacket, fresh bruise on one knee) laces up skates at the rail.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Alone.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "Breathing.", "para": 2, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "She stands.", "para": 3, "sent": 0, "present": [0]}, {"u": 12, "kind": "action", "text": "Wobbles.", "para": 3, "sent": 1, "present": [0]}, {"u": 13, "kind": "action", "text": "Pushes off.", "para": 3, "sent": 2, "present": [0]}, {"u": 14, "kind": "action", "text": "Slow loops.", "para": 4, "sent": 0, "present": [0]}, {"u": 15, "kind": "action", "text": "Clumsy.", "para": 4, "sent": 1, "present": [0]}, {"u": 16, "kind": "action", "text": "Then smoother.", "para": 4, "sent": 2, "present": [0]}, {"u": 17, "kind": "action", "text": "On the far wall: a trophy case.", "para": 5, "sent": 0, "present": [0]}, {"u": 18, "kind": "action", "text": "One photo.", "para": 5, "sent": 1, "present": [0]}, {"u": 19, "kind": "action", "text": "A girl in a gold jumpsuit, mid-spin.", "para": 5, "sent": 2, "present": [0]}, {"u": 20, "kind": "action", "text": "June stares at it as she passes.", "para": 6, "sent": 0, "present": [0]}, {"u": 21, "kind": "action", "text": "A buzz.", "para": 7, "sent": 0, "present": [0]}, {"u": 22, "kind": "action", "text": "The wall phone behind the snack bar rings.", "para": 7, "sent": 1, "present": [0]}, {"u": 23, "kind": "action", "text": "June ignores it.", "para": 8, "sent": 0, "present": [0]}, {"u": 24, "kind": "action", "text": "Another lap.", "para": 8, "sent": 1, "present": [0]}, {"u": 25, "kind": "action", "text": "It keeps ringing.", "para": 9, "sent": 0, "present": [0]}, {"u": 26, "kind": "action", "text": "She skates to the counter.", "para": 10, "sent": 0, "present": [0]}, {"u": 27, "kind": "action", "text": "Picks up.", "para": 10, "sent": 1, "present": [0]}, {"u": 28, "kind": "dialogue", "text": "Rink's closed.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 29, "kind": "dialogue", "text": "June. Where are you?", "name": "MRS. PAIK", "speaker": 0, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0]}, {"u": 30, "kind": "dialogue", "text": "Studying. At Hana's.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 31, "kind": "dialogue", "text": "Hana's mother says you left at five.", "name": "MRS. PAIK", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0]}, {"u": 32, "kind": "dialogue", "text": "I went to the library after.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 33, "kind": "dialogue", "text": "The library closes at six.", "name": "MRS. PAIK", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0]}, {"u": 34, "kind": "action", "text": "June closes her eyes.", "para": 11, "sent": 0, "present": [0]}, {"u": 35, "kind": "dialogue", "text": "I'm fine, Mom.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 36, "kind": "dialogue", "text": "Come home.", "name": "MRS. PAIK", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0]}, {"u": 37, "kind": "dialogue", "text": "In an hour.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 38, "kind": "action", "text": "She hangs up.", "para": 12, "sent": 0, "present": [0]}, {"u": 39, "kind": "action", "text": "Turns.", "para": 12, "sent": 1, "present": [0]}, {"u": 40, "kind": "action", "text": "A man in the doorway.", "para": 13, "sent": 0, "present": [0]}, {"u": 41, "kind": "action", "text": "DELROY BASS (60s, rink owner, janitor's keys on his belt, shoulders that sag a little to the left).", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Thought I heard someone.", "name": "DELROY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Sorry. The back door was open.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Back door's never open.", "name": "DELROY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "It was today.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "He looks at her skates.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "At the bruise.", "para": 14, "sent": 1, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "That your mother?", "name": "DELROY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Yeah.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "She sounds worried.", "name": "DELROY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "She's always worried.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "Delroy nods.", "para": 15, "sent": 0, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "Hangs his keys on a nail.", "para": 15, "sent": 1, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "You skate like her.", "name": "DELROY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "Like who?", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "He points at the trophy case.", "para": 16, "sent": 0, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "Valerie Paik. Nineteen eighty-four. Regional champ.", "name": "DELROY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "June stares at him.", "para": 17, "sent": 0, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "That's my mother?", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "She never told you.", "name": "DELROY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "She told me she hated skating.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "She did. After she quit.", "name": "DELROY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "Why?", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "Delroy takes a long breath.", "para": 18, "sent": 0, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "Ask her.", "name": "DELROY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "June sits on the rail.", "para": 19, "sent": 0, "present": [0, 1]}, {"u": 67, "kind": "action", "text": "Skates dangling.", "para": 19, "sent": 1, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "She looks at the photo.", "para": 19, "sent": 2, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "The girl in the gold jumpsuit looks back.", "para": 19, "sent": 3, "present": [0, 1]}, {"u": 70, "kind": "action", "text": "Her phone buzzes.", "para": 20, "sent": 0, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "A text from Mom: \"I'm outside.\"", "para": 20, "sent": 1, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "She looks up at Delroy.", "para": 21, "sent": 0, "present": [0, 1]}, {"u": 73, "kind": "dialogue", "text": "She's here.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 74, "kind": "dialogue", "text": "Then you'd better go.", "name": "DELROY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 75, "kind": "action", "text": "June stands.", "para": 22, "sent": 0, "present": [0, 1]}, {"u": 76, "kind": "action", "text": "Skates to the door.", "para": 22, "sent": 1, "present": [0, 1]}, {"u": 77, "kind": "action", "text": "Slows.", "para": 22, "sent": 2, "present": [0, 1]}, {"u": 78, "kind": "action", "text": "Turns back.", "para": 22, "sent": 3, "present": [0, 1]}, {"u": 79, "kind": "dialogue", "text": "Can I come back tomorrow?", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 80, "kind": "dialogue", "text": "Rink opens at ten.", "name": "DELROY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 81, "kind": "dialogue", "text": "Not for open skate.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 82, "kind": "dialogue", "text": "Then at six. I'll leave the back door open.", "name": "DELROY", "speaker": 1, "ext": [], "paren": ["small smile"], "dual": false, "present": [0, 1]}]}