{"scene_id": "s01577", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01577.fountain", "heading": "INT. COUNTY COURTHOUSE - STAIRWELL LANDING - DAY", "cast": [{"id": 0, "name": "ATTORNEY SIMONE BELLAMY-OKONKWO", "names": ["ATTORNEY SIMONE BELLAMY-OKONKWO", "SIMONE"], "gender": "?", "first": 4, "spoke": 9}, {"id": 1, "name": "DEE", "names": ["DEE"], "gender": "?", "first": 7, "spoke": 4}, {"id": 2, "name": "PRUITT", "names": ["PRUITT"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "BAILIFF OSEI TEMPLETON", "names": ["BAILIFF OSEI TEMPLETON", "TEMPLETON"], "gender": "m", "first": 8, "spoke": 2}, {"id": 4, "name": "DISTRICT ATTORNEY PRUDHOMME LACROIX", "names": ["DISTRICT ATTORNEY PRUDHOMME LACROIX", "LACROIX"], "gender": "m", "first": 4, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. COUNTY COURTHOUSE - STAIRWELL LANDING - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Marble.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Echo.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A broken radiator ticking.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ATTORNEY SIMONE BELLAMY-OKONKWO (30s, charcoal suit, briefcase like a shield) paces.", "para": 1, "sent": 0, "present": [0, 4]}, {"u": 5, "kind": "action", "text": "Phone to ear.", "para": 1, "sent": 1, "present": [0, 4]}, {"u": 6, "kind": "action", "text": "Voicemail again.", "para": 1, "sent": 2, "present": [0, 4]}, {"u": 7, "kind": "action", "text": "Across the landing, her client DARNELL \"DEE\" PRUITT (20s, borrowed tie, handcuffs hidden under a jacket draped over his wrists) sits on a bench, jaw tight.", "para": 2, "sent": 0, "present": [0, 1, 2, 4]}, {"u": 8, "kind": "action", "text": "A bailiff, BAILIFF OSEI TEMPLETON (50s, belly, patience), stands guard.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Pick up, Judge. Pick up.", "name": "SIMONE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "He's not going to pick up.", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Be quiet and memorize your answers.", "name": "SIMONE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "I did.", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Again.", "name": "SIMONE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "I was home at nine. My cousin brought the pizza. My cousin is gone now.", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Gone where?", "name": "SIMONE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Gone gone.", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Simone hangs up.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Stares at him.", "para": 3, "sent": 1, "present": [1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "The radiator clanks.", "para": 3, "sent": 2, "present": [1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Templeton shifts his weight, glances at his watch, clears his throat, then looks at the ceiling as if to give them privacy.", "para": 3, "sent": 3, "present": [1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "The stairwell door slams open.", "para": 4, "sent": 0, "present": [1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Footsteps below, fast, then up.", "para": 4, "sent": 1, "present": [1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "DISTRICT ATTORNEY PRUDHOMME LACROIX (50s, silver hair, voice like warm gravel) arrives on the landing with a file under his arm.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "He stops.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Smiles at no one in particular.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Counsel. A word.", "name": "LACROIX", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Not without a witness.", "name": "SIMONE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "The bailiff is a witness.", "name": "LACROIX", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "I'm furniture, sir.", "name": "TEMPLETON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "We have a recording from the pizza shop.", "name": "LACROIX", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Dee goes rigid.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Simone doesn't move.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Lacroix slides a tablet out of his file, taps it, holds it up.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Grainy footage: a delivery counter, a man in a hoodie, a timestamp at 9:14.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "That's not my client.", "name": "SIMONE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Isn't it?", "name": "LACROIX", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Dee lunges up from the bench.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "The jacket slips.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "The cuffs flash.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Templeton catches his elbow and Simone puts a hand flat on Dee's chest.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Lacroix steps back, the tablet falling, clattering down the marble steps.", "para": 7, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Sit down. Now.", "name": "SIMONE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Dee sits.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Breathing hard.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Simone turns to Lacroix.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "That footage has no chain of custody.", "name": "SIMONE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "Then why did he flinch?", "name": "LACROIX", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Because you're standing six inches from his face, Prudhomme.", "name": "SIMONE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "A pause.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Lacroix retrieves the tablet from the stairs with a wince at the cracked screen, tucks it away, and exhales.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "Plea's still on the table. Ten minutes.", "name": "LACROIX", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "He exits.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Templeton sighs.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "Never seen a man look so pleased about a broken screen.", "name": "TEMPLETON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Simone sits next to Dee.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "For the first time, she lets her shoulders drop.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}]}