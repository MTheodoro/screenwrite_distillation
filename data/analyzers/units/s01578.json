{"scene_id": "s01578", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01578.fountain", "heading": "INT. DEEP-SEA HABITAT MODULE - NIGHT CYCLE", "cast": [{"id": 0, "name": "IMANI KAGWE", "names": ["IMANI KAGWE", "KAGWE"], "gender": "?", "first": 5, "spoke": 7}, {"id": 1, "name": "COMMANDER ARVID LUNDQVIST", "names": ["COMMANDER ARVID LUNDQVIST", "LUNDQVIST"], "gender": "?", "first": 6, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. DEEP-SEA HABITAT MODULE - NIGHT CYCLE", "present": []}, {"u": 1, "kind": "action", "text": "Cramped.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Pipes sweat.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Red emergency strip along the ceiling.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Through a porthole: black water, drifting silt.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. IMANI KAGWE (40s, braided hair, a surgeon's steady hands) stands at a console.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Behind her, COMMANDER ARVID LUNDQVIST (50s, close-cropped silver, a voice trained to be calm) holds a tablet.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Oxygen's holding.", "name": "LUNDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "For how long?", "name": "KAGWE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Nine hours.", "name": "LUNDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "That's not holding. That's a countdown.", "name": "KAGWE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She turns.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Their eyes meet.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He sets the tablet down.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "The surface team says forty-eight.", "name": "LUNDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "The surface team says what it's told to say.", "name": "KAGWE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "You think they're lying.", "name": "LUNDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "I think you are.", "name": "KAGWE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "A pipe groans.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "A thin jet of water hisses from a seam in the wall.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Neither moves.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "The seam isn't structural.", "name": "LUNDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "It's weeping brine. It's structural.", "name": "KAGWE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Imani.", "name": "LUNDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Don't.", "name": "KAGWE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "He grabs a wrench from the wall.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "She steps in front of it.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "He tries to go around her.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "She blocks him.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "They collide, the wrench clattering to the deck.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Let me patch it!", "name": "LUNDQVIST", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "You'll shear the coupling!", "name": "KAGWE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "He shoves her.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "She shoves back.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "He slams against the console.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "She slams against the bulkhead.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "The jet widens.", "para": 5, "sent": 4, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "The lights flicker.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Alarms begin to chirp, softly at first.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "They both freeze, staring at the porthole.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Beyond the glass, something large and pale slides past.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "It does not slide past again.", "para": 8, "sent": 0, "present": [0, 1]}]}