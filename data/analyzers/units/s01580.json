{"scene_id": "s01580", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01580.fountain", "heading": "EXT. ICE FIELD - LATE AFTERNOON", "cast": [{"id": 0, "name": "TOVE HALVORSEN", "names": ["TOVE HALVORSEN", "TOVE"], "gender": "f", "first": 6, "spoke": 8}, {"id": 1, "name": "BASE CAMP", "names": ["BASE CAMP"], "gender": "?", "first": 12, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ICE FIELD - LATE AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "White.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Everywhere.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wind drags spindrift across the surface like smoke.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A tiny orange tent, half-collapsed.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "Skis stabbed upright in the snow.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "TOVE HALVORSEN (30s, frostbitten cheeks, goggles pushed up, a pack nearly as big as she is) crawls out of the tent on hands and knees.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "She stands.", "para": 3, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Staggers.", "para": 3, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "Catches herself on a ski.", "para": 3, "sent": 2, "present": [0]}, {"u": 10, "kind": "action", "text": "A handheld radio hangs from her chest strap.", "para": 4, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "She thumbs it.", "para": 4, "sent": 1, "present": [0]}, {"u": 12, "kind": "dialogue", "text": "Base, this is Tove. Do you copy?", "name": "TOVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Static.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Base. Tove. Anyone.", "name": "TOVE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Static.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "A hiss.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Then, far away, thin as wire:", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "...ove... copy... say position...", "name": "BASE CAMP", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Seventy-nine north. Three kilometers past the cairn.", "name": "TOVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "...repeat...", "name": "BASE CAMP", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Past the cairn! I've lost one ski pole! Tent's torn!", "name": "TOVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "...storm... front... twelve hours...", "name": "BASE CAMP", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She looks up.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "To the west: a bruise-colored wall of cloud, creeping.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Twelve hours. Okay.", "name": "TOVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "She drops to her knees.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Digs in her pack.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Pulls out a thermos, shakes it, unscrews the cap.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Drinks.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Grimaces.", "para": 8, "sent": 4, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Frozen slush.", "para": 8, "sent": 5, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "She tosses it.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "It skitters across the ice.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Wind picks up.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "The tent flaps.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "The first flakes begin to fall.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Pack. Move. Pack. Move.", "name": "TOVE", "speaker": 0, "ext": ["CONT'D"], "paren": ["to herself"], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "She grabs the tent poles.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "They snap in her gloves.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "She stares at the splinters.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "...Tove... turn... back...", "name": "BASE CAMP", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "There is no back!", "name": "TOVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "She keys the radio again, voice cracking.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Base, I'm going to walk. East. Toward the lights.", "name": "TOVE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "...no lights... east...", "name": "BASE CAMP", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "She stops.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Looks east.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Nothing but white.", "para": 13, "sent": 2, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "The snow thickens.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "She zips her jacket to her chin.", "para": 14, "sent": 1, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "Lifts the pack.", "para": 14, "sent": 2, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "Staggers one step.", "para": 14, "sent": 3, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "Two.", "para": 14, "sent": 4, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "Behind her, the tent collapses completely.", "para": 15, "sent": 0, "present": [0, 1]}]}