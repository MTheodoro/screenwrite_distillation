{"scene_id": "s01581", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01581.fountain", "heading": "INT. SYNERGY PARTNERS - OPEN OFFICE - FRIDAY, 4:55 PM", "cast": [{"id": 0, "name": "BRANDEN CHASE", "names": ["BRANDEN CHASE", "BRANDEN"], "gender": "?", "first": 5, "spoke": 9}, {"id": 1, "name": "PRIYANKA MENON", "names": ["PRIYANKA MENON", "PRIYANKA"], "gender": "f", "first": 8, "spoke": 6}, {"id": 2, "name": "DEZ", "names": ["DEZ"], "gender": "?", "first": 9, "spoke": 6}, {"id": 3, "name": "WILLIAMS", "names": ["WILLIAMS"], "gender": "?", "first": 9, "spoke": 0}, {"id": 4, "name": "CALLIE ZIMMERMAN", "names": ["CALLIE ZIMMERMAN", "CALLIE"], "gender": "f", "first": 10, "spoke": 2}, {"id": 5, "name": "HOLLOWAY", "names": ["HOLLOWAY"], "gender": "?", "first": 11, "spoke": 5}, {"id": 6, "name": "VP", "names": ["VP"], "gender": "?", "first": 11, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. SYNERGY PARTNERS - OPEN OFFICE - FRIDAY, 4:55 PM", "present": []}, {"u": 1, "kind": "action", "text": "Beanbags.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A kombucha tap.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A neon sign reads \"GOOD VIBES ONLY.\"", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Under it, five exhausted people.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "BRANDEN CHASE (30s, quarter-zip, gelled hair) stands at a whiteboard that says \"SYNERGY 2.0 - ALIGN.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "PIVOT.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "ELEVATE.\"", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "PRIYANKA MENON (30s, headphones, eye bags) slumps at her desk.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "DESMOND \"DEZ\" WILLIAMS (40s, cardigan, thermos) chews a