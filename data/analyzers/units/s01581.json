, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "Callie, love the energy.", "name": "BRANDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Save it. They'll sell it back to you.", "name": "PRIYANKA", "speaker": 1, "ext": [], "paren": ["to Callie, low"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "Someone mentioned the layoffs?", "name": "HOLLOWAY", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "No one mentioned layoffs, sir.", "name": "BRANDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "Because I'm seeing a rumor.", "name": "HOLLOWAY", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "I'm seeing a door.", "name": "DEZ", "speaker": 2, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "Team, let's take a breath.", "name": "BRANDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "Everyone breathing? Great. Branden, are we getting cut?", "name": "PRIYANKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "I can't speak to that.", "name": "BRANDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "You can speak to everything else.", "name": "PRIYANKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "He's mute on the one subject that matters.", "name": "DEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "Is this a good time to share my mood board?", "name": "CALLIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "Callie, was it? We'll circle back.", "name": "HOLLOWAY", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "Okay. Okay. Let's all just, you know, honor the process.", "name": "BRANDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "The process has a sign-off sheet?", "name": "PRIYANKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "Process is a verb, Priyanka. We are the object.", "name": "DEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "I'll let you all go early. Happy weekend.", "name": "HOLLOWAY", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "The screen goes black.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "Nobody moves.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "Great sync, everyone.", "name": "BRANDEN", "speaker": 0, "ext": [], "paren": ["brightly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "He erases \"ELEVATE\" with his sleeve.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "Callie slowly closes her notebook.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "dialogue", "text": "I'm going to miss the kombucha.", "name": "DEZ", "speaker": 2, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}