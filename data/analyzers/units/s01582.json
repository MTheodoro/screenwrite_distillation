{"scene_id": "s01582", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01582.fountain", "heading": "EXT. DESERT SALT FLAT - DAY", "cast": [{"id": 0, "name": "MARIBEL SOTO", "names": ["MARIBEL SOTO", "MARIBEL"], "gender": "?", "first": 4, "spoke": 12}, {"id": 1, "name": "ANDR\u00c9S", "names": ["ANDR\u00c9S"], "gender": "?", "first": 5, "spoke": 12}, {"id": 2, "name": "OLD MAN BENEDICTO", "names": ["OLD MAN BENEDICTO", "BENEDICTO"], "gender": "?", "first": 43, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DESERT SALT FLAT - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Glare.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "White crust to every horizon.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A jeep sits with its hood up, wheels sunk to the axles.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MARIBEL SOTO (30s, wide-brim hat, cracked lips) kneels at the engine.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her brother ANDR\u00c9S (20s, sunburned neck) sits in the shade of the jeep, rationing a water bottle with one eye.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "She wipes her hands on her jeans.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He caps the bottle.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Anything?", "name": "ANDR\u00c9S", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Radiator's dry.", "name": "MARIBEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "How dry?", "name": "ANDR\u00c9S", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Bone.", "name": "MARIBEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "How much water do we have?", "name": "ANDR\u00c9S", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "You're holding it.", "name": "MARIBEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He turns the bottle upside down.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "A few drops.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "I thought we had four.", "name": "ANDR\u00c9S", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "We had four. You drank two on the first day.", "name": "MARIBEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "You told me to.", "name": "ANDR\u00c9S", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "I told you to sip.", "name": "MARIBEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "I sipped.", "name": "ANDR\u00c9S", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Big sips.", "name": "MARIBEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "You said the road was forty miles.", "name": "ANDR\u00c9S", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "It was forty miles.", "name": "MARIBEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "It's been eighty.", "name": "ANDR\u00c9S", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I know.", "name": "MARIBEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "We took the wrong turn.", "name": "ANDR\u00c9S", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "You took the wrong turn.", "name": "MARIBEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "I was reading your map.", "name": "ANDR\u00c9S", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "My map was fine.", "name": "MARIBEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Your map was upside down.", "name": "ANDR\u00c9S", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "She stands.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Wipes her face.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "He rises with her, squinting.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "On the horizon: a shimmer.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "A dot.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "A dust plume.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "They both freeze.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Is that a car?", "name": "ANDR\u00c9S", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Don't hope.", "name": "MARIBEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "The dot grows.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "A battered pickup rolls out of the glare and stops thirty feet away.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "The door opens.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "OLD MAN BENEDICTO (70s, straw hat, a jug of water slung over one shoulder) climbs down.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "He looks at the jeep.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Looks at them.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "You are very far from the road.", "name": "BENEDICTO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Maribel steps forward.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Please. Water.", "name": "MARIBEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "He unslings the jug.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Holds it out.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "She takes it with both hands and drinks.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Andr\u00e9s watches, trembling.", "para": 10, "sent": 3, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Slowly. Slowly.", "name": "BENEDICTO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}