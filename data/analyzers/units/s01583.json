{"scene_id": "s01583", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01583.fountain", "heading": "INT. BELLTOWER OBSERVATORY - NIGHT", "cast": [{"id": 0, "name": "PROFESSOR AMBROSE QUILL", "names": ["PROFESSOR AMBROSE QUILL", "AMBROSE"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "SEXTON", "names": ["SEXTON"], "gender": "?", "first": 10, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. BELLTOWER OBSERVATORY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped brass-and-oak room at the top of a church tower.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Star charts curl on the walls.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A telescope points through a roof hatch.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "PROFESSOR AMBROSE QUILL (70s, cardigan, wire spectacles) sits at a desk, writing in a leather journal.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He pauses.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Taps his pen.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "Lifts his head as though listening.", "para": 1, "sent": 3, "present": [0]}, {"u": 8, "kind": "action", "text": "He rises, crosses to a brass speaking tube on the wall, and uncaps it.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "dialogue", "text": "Mrs. Pennywhistle?", "name": "AMBROSE", "speaker": 0, "ext": [], "paren": ["into tube"], "dual": false, "present": [0]}, {"u": 10, "kind": "dialogue", "text": "Yes, Professor?", "name": "SEXTON", "speaker": 1, "ext": ["V.O."], "paren": ["distant, tinny"], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Did you take the key to the lower cabinet?", "name": "AMBROSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "No, sir. It was on its hook at supper.", "name": "SEXTON", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He frowns.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Looks to the cabinet.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "The door is ajar.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "It is not there now.", "name": "AMBROSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Shall I come up?", "name": "SEXTON", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He considers.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Glances at the journal on the desk, then at the dark hatch above.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "No. Thank you. I believe I know where it is.", "name": "AMBROSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "He caps the tube.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Returns to his desk.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Opens a drawer.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "The key lies inside, dusted with chalk.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "He smiles faintly.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Closes the drawer.", "para": 6, "sent": 1, "present": [0, 1]}]}