{"scene_id": "s01584", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01584.fountain", "heading": "INT. VICTORIAN CONSERVATORY - AFTERNOON", "cast": [{"id": 0, "name": "LADY EVELYN ASHCROFT", "names": ["LADY EVELYN ASHCROFT", "EVELYN"], "gender": "f", "first": 4, "spoke": 23}, {"id": 1, "name": "JULIAN THORNBURY", "names": ["JULIAN THORNBURY", "JULIAN"], "gender": "?", "first": 5, "spoke": 22}], "units": [{"u": 0, "kind": "heading", "text": "INT. VICTORIAN CONSERVATORY - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Glass roof, iron ribs.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Ferns the size of carriages.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A wrought-iron table set for tea in the middle of a green jungle.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LADY EVELYN ASHCROFT (60s, lavender silk, a cane she uses more for pointing than walking) pours from a silver pot.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across from her, MR. JULIAN THORNBURY (30s, young solicitor, tight collar, too-new gloves) perches on the edge of a wicker chair.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Sugar, Mr. Thornbury?", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Two, thank you.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Two. Ambitious.", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I have a sweet tooth, Lady Ashcroft.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I have a lawyer's nephew with a sweet tooth. I trust you are not he.", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I am nobody's nephew, my lady.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She drops two lumps.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Stirs once.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Hands the cup across.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Then you have no reason to flatter me.", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "I flatter no one.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "A pity. I should like to be flattered. At my age it is the only vitamin.", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He sips.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Burns his tongue.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Hides it.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "My firm has sent me about the estate.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "The estate.", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "The matter of the east orchard.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "The orchard has been mine for forty years.", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "And the Hargreaves family wishes to purchase it.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "The Hargreaves family wishes a great many things.", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "They offered considerably more than market value.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Then it is worth considerably more than market value.", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "That is what the firm suspects.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": ["carefully"], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "She sets down the pot.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Studies him.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "You are not as foolish as you dress.", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "I beg your pardon.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Nothing. Another biscuit?", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Thank you.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "He takes one.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "She watches him bite.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Do you know what grows in the east orchard, Mr. Thornbury?", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Apples, I assume.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Apples. Pears. And beneath the fourth pear tree, a good deal else.", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "My lady?", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Eat your biscuit.", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "He does.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "A parrot shrieks somewhere in the ferns.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "They both pretend not to hear it.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "My late husband was a collector.", "name": "EVELYN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "Of what?", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Whatever he could not bear to leave to others.", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "That is a poet's phrase.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "He was not a poet.", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "A pause.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "The rain begins on the glass.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "Soft, then steady.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "Is there anything I should tell the Hargreaves?", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "Tell them the orchard is not for sale.", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "May I tell them why?", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "You may tell them it is sentimental.", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "Is it?", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "Entirely.", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "I shall convey it.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "She pours him more tea.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "They sit for a while without speaking.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "Lady Ashcroft, the firm will not stop at one letter.", "name": "JULIAN", "speaker": 1, "ext": ["CONT'D"], "paren": ["gently"], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "Then the firm will find me at home.", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "You are very brave.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "I am very old. It is a different thing.", "name": "EVELYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "action", "text": "He smiles.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "She smiles back.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "In the glass, the rain keeps falling.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "Another cup, Mr. Thornbury?", "name": "EVELYN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "dialogue", "text": "Please.", "name": "JULIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "She pours.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "The steam rises between them.", "para": 10, "sent": 1, "present": [0, 1]}]}