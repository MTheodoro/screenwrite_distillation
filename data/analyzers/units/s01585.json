{"scene_id": "s01585", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01585.fountain", "heading": "INT. ABANDONED AQUARIUM - TUNNEL EXHIBIT - NIGHT", "cast": [{"id": 0, "name": "KENJI MORITA", "names": ["KENJI MORITA", "KENJI"], "gender": "?", "first": 6, "spoke": 3}, {"id": 1, "name": "BEA", "names": ["BEA"], "gender": "?", "first": 7, "spoke": 3}, {"id": 2, "name": "CALDERON", "names": ["CALDERON"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "TYRELL BANKS", "names": ["TYRELL BANKS", "TYRELL"], "gender": "?", "first": 8, "spoke": 3}, {"id": 4, "name": "NOOR HAMDAN", "names": ["NOOR HAMDAN", "NOOR"], "gender": "f", "first": 9, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED AQUARIUM - TUNNEL EXHIBIT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A glass tunnel, drained.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Green slime on the walls.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dead fish skeletons lie on the sand like dropped coins.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Water drips somewhere.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Four teenagers huddle in the beam of one flashlight.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "KENJI MORITA (17, backpack, scared grin) holds the light.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "BEATRIZ \"BEA\" CALDERON (17, hoodie, steady) holds his sleeve.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "TYRELL BANKS (18, letterman jacket, loud) leads.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "And NOOR HAMDAN (16, glasses, camera strapped around her neck) trails behind them.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "See? Nothing.", "name": "TYRELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "It's very dark.", "name": "KENJI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "It's an aquarium.", "name": "BEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "It's a dead aquarium.", "name": "NOOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "A sound.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "A wet slap on glass above them.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "All four freeze.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "The flashlight shakes.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "What was that?", "name": "KENJI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Nothing.", "name": "TYRELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "At the end of the tunnel, a shape rises from the dried sand.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Tall.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Dripping.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Gill slits flutter along its neck.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Guys.", "name": "BEA", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Guys.", "name": "NOOR", "speaker": 4, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Guys?", "name": "KENJI", "speaker": 0, "ext": [], "paren": ["at the same time"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Run.", "name": "TYRELL", "speaker": 3, "ext": [], "paren": ["at the same time"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "^Run!", "name": "BEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "They scatter.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Kenji drops the flashlight.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "It rolls, spinning light across the walls.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "The shape lunges.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}]}