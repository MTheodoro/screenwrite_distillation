{"scene_id": "s01586", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01586.fountain", "heading": "EXT. FROZEN QUARRY LAKE - DUSK", "cast": [{"id": 0, "name": "LEILA RAHIMI", "names": ["LEILA RAHIMI", "LEILA"], "gender": "?", "first": 5, "spoke": 11}, {"id": 1, "name": "WYATT PRUITT", "names": ["WYATT PRUITT", "WYATT"], "gender": "?", "first": 6, "spoke": 9}, {"id": 2, "name": "CORA", "names": ["CORA"], "gender": "?", "first": 7, "spoke": 8}, {"id": 3, "name": "DELGADO", "names": ["DELGADO"], "gender": "?", "first": 7, "spoke": 0}, {"id": 4, "name": "ANTON", "names": ["ANTON"], "gender": "?", "first": 8, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FROZEN QUARRY LAKE - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "Black ice.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Gray sky.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Snow drifting sideways.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Four figures on the surface, roped together, each separated by ten feet of slack.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "LEILA RAHIMI (30s, point, goggles fogged) tests the ice with a pole.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Behind her, WYATT PRUITT (50s, quiet, bad knee) hauls a sled.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Then CORAZON \"CORA\" DELGADO (20s, hood up), carrying the radio.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Last, a boy of twelve, ANTON (swallowed by an adult parka), stays close to the sled.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "Leila stops.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Raps the pole twice.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "The ice answers with a dull, hollow note.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Left. Wider.", "name": "LEILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Left is the long way.", "name": "WYATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Left.", "name": "LEILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "We could cut across.", "name": "CORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "We could.", "name": "LEILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Nobody moves.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Wyatt adjusts the sled strap.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Anton looks at the horizon.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "I used to skate here as a kid. Every winter. We'd race from the north wall to the pumphouse. I always lost.", "name": "WYATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "You lost?", "name": "CORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "My brother won. He was faster. He was always faster.", "name": "WYATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Where is he now?", "name": "CORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Montana.", "name": "WYATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "That's far.", "name": "CORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "It's far enough.", "name": "WYATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Cora, how's the radio?", "name": "LEILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Quiet.", "name": "CORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Try it.", "name": "LEILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "It's been quiet all day.", "name": "CORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Try it.", "name": "LEILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Cora thumbs the radio.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Static.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Nothing else.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "She lowers it.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "My brother says the ice thins near the pumphouse. Where the old pipe runs.", "name": "WYATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Which is where we're headed.", "name": "LEILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Yes.", "name": "WYATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "So you think we should go left.", "name": "LEILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "I think we should go left.", "name": "WYATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Anton, you okay?", "name": "CORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Anton nods, not looking at her.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "He tugs the rope at his waist, once, twice, as though checking that it is real.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Wyatt, tie the sled shorter.", "name": "LEILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "It'll drag.", "name": "WYATT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Then it drags.", "name": "LEILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "He kneels, wincing.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Shortens the line.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "The ice creaks.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Everyone looks down.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "That was nothing.", "name": "CORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "That was something.", "name": "LEILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "A long crack, like a rifle shot, rolls across the lake.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "They stand rigid.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Anton drops to his knees, flat.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "The others follow, spreading their weight.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "Silence.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Snow falls on four still bodies.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}]}