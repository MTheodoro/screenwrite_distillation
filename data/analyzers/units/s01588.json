{"scene_id": "s01588", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01588.fountain", "heading": "INT. OPERA HOUSE - BALCONY BOX - EVENING", "cast": [{"id": 0, "name": "CLAIRE", "names": ["CLAIRE"], "gender": "?", "first": 4, "spoke": 3}, {"id": 1, "name": "JACK", "names": ["JACK"], "gender": "?", "first": 5, "spoke": 3}, {"id": 2, "name": "MADAME DUBOIS", "names": ["MADAME DUBOIS"], "gender": "f", "first": 6, "spoke": 0}, {"id": 3, "name": "GENERAL HARTLEY", "names": ["GENERAL HARTLEY"], "gender": "?", "first": 6, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. OPERA HOUSE - BALCONY BOX - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Velvet.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Gilt.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Below, an orchestra tunes.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CLAIRE (30s, emerald gown) sits rigid.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside her, JACK (30s, tux, a man who bought tickets in a hurry).", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Two seats behind: her mother, MADAME DUBOIS (60s, pearls, lorgnette), and his father, GENERAL HARTLEY (60s, medals, mustache).", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "She does not look at him.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "He does not look at her.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Her fingers drum the armrest.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "His gaze stays on the stage.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "The lights dim.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "The overture begins.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "His hand drifts toward hers, hesitates, withdraws.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "She notices.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Madame Dubois lowers her lorgnette.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "The General coughs.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "You came.", "name": "CLAIRE", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "You asked.", "name": "JACK", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "I asked in March.", "name": "CLAIRE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "I got the letter in June.", "name": "JACK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "The music swells.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "She turns at last.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "He meets her eyes.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "The General leans forward to hear.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Madame Dubois leans too.", "para": 6, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Stay for the second act?", "name": "CLAIRE", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Forever.", "name": "JACK", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}]}