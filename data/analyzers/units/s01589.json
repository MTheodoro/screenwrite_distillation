{"scene_id": "s01589", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01589.fountain", "heading": "INT. NIGHT FERRY - OBSERVATION DECK - NIGHT", "cast": [{"id": 0, "name": "DAHLIA OYELARAN", "names": ["DAHLIA OYELARAN", "DAHLIA"], "gender": "?", "first": 4, "spoke": 21}, {"id": 1, "name": "RUSSELL KAPLAN", "names": ["RUSSELL KAPLAN", "RUSSELL"], "gender": "m", "first": 5, "spoke": 21}, {"id": 2, "name": "INGRID SOLBERG", "names": ["INGRID SOLBERG", "INGRID"], "gender": "?", "first": 6, "spoke": 1}, {"id": 3, "name": "BASIL MWANGI", "names": ["BASIL MWANGI", "BASIL"], "gender": "?", "first": 6, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT FERRY - OBSERVATION DECK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Open air, plastic benches, a vending machine blinking in the corner.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The engine thrums underfoot.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Black water, white wake.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DAHLIA OYELARAN (30s, peacoat, a half-eaten sandwich) leans on the rail.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her ex, RUSSELL KAPLAN (30s, scarf, hands in pockets), stands three feet away, as close as he dares.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Below them on the car deck, two figures drift between vehicles: INGRID SOLBERG (60s, captain's cap, a flashlight) and her deckhand, BASIL MWANGI (20s, orange vest, earbuds).", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "You followed me.", "name": "DAHLIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "I took the same boat.", "name": "RUSSELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "At midnight.", "name": "DAHLIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "It was the last one.", "name": "RUSSELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "It's always the last one with you.", "name": "DAHLIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "He laughs once, short.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "She doesn't.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "The ferry horn blows.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "I got the job in Tallinn.", "name": "RUSSELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Good for you.", "name": "DAHLIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "I turned it down.", "name": "RUSSELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Why?", "name": "DAHLIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "You know why.", "name": "RUSSELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "I don't.", "name": "DAHLIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Dahlia.", "name": "RUSSELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Say it.", "name": "DAHLIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Because you're here.", "name": "RUSSELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "She turns.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Wind in her hair.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "He steps closer.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Four years, Russell. Four.", "name": "DAHLIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "I counted every one.", "name": "RUSSELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "You counted?", "name": "DAHLIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Like a prisoner.", "name": "RUSSELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "She looks at him, then at the water, then back.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "I almost called you in February.", "name": "DAHLIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "What stopped you?", "name": "RUSSELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "The phone.", "name": "DAHLIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "It was broken?", "name": "RUSSELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "It was mine.", "name": "DAHLIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "He grins in spite of himself.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "She does too.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "A small, reluctant thaw.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "I love you. Still. Dumb, isn't it?", "name": "RUSSELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Very.", "name": "DAHLIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "But?", "name": "RUSSELL", "speaker": 1, "ext": [], "paren": ["hopeful"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "But nothing.", "name": "DAHLIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "She takes his hand.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "A beat.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Then Ingrid's voice cuts through the PA.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Attention passengers. We will dock in ten minutes.", "name": "INGRID", "speaker": 2, "ext": ["V.O."], "paren": ["over loudspeaker"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Also, someone left a sandwich on bench seven.", "name": "BASIL", "speaker": 3, "ext": ["V.O."], "paren": ["over loudspeaker, muffled"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "That's mine.", "name": "DAHLIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "You're going to leave it?", "name": "RUSSELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "I'm going to stay.", "name": "DAHLIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "He leans in.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "They kiss.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "^I want to tell my mother.", "name": "RUSSELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "^I want to tell mine.", "name": "DAHLIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "They break apart, laughing, and she lifts her phone.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "His expression changes.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "What's that?", "name": "RUSSELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "A message.", "name": "DAHLIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "From who?", "name": "RUSSELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "She turns the screen toward him.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "A name: \"ELLIOT.\"", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "Under it: \"Ready for you at the port.\"", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "I was going to tell you.", "name": "DAHLIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "When?", "name": "RUSSELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "Tonight.", "name": "DAHLIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "Dahlia.", "name": "RUSSELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "It's complicated.", "name": "DAHLIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "dialogue", "text": "It always is.", "name": "RUSSELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "He steps back.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "The ferry lurches as it enters the harbor.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "action", "text": "Lights ahead.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "Who is he?", "name": "RUSSELL", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "She opens her mouth.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "The ferry horn drowns her answer.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}]}