{"scene_id": "s01590", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01590.fountain", "heading": "INT. CURLING CLUB - SHEET THREE - EVENING", "cast": [{"id": 0, "name": "ROCKS FALLING", "names": ["ROCKS FALLING"], "gender": "?", "first": 2, "spoke": 0}, {"id": 1, "name": "COACH MARGUERITE LAVOIE", "names": ["COACH MARGUERITE LAVOIE", "MARGUERITE"], "gender": "?", "first": 3, "spoke": 1}, {"id": 2, "name": "BJORN HALLDORSSON", "names": ["BJORN HALLDORSSON", "BJORN"], "gender": "?", "first": 4, "spoke": 2}, {"id": 3, "name": "DEZ", "names": ["DEZ"], "gender": "?", "first": 5, "spoke": 1}, {"id": 4, "name": "ARCHER", "names": ["ARCHER"], "gender": "?", "first": 5, "spoke": 0}, {"id": 5, "name": "WILLA", "names": ["WILLA"], "gender": "?", "first": 6, "spoke": 1}, {"id": 6, "name": "NG", "names": ["NG"], "gender": "?", "first": 6, "spoke": 0}, {"id": 7, "name": "TAMSIN OKORO", "names": ["TAMSIN OKORO", "TAMSIN"], "gender": "?", "first": 7, "spoke": 1}, {"id": 8, "name": "ALTERNATE POPPY DUNLEAVY", "names": ["ALTERNATE POPPY DUNLEAVY"], "gender": "f", "first": 8, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. CURLING CLUB - SHEET THREE - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Pebbled ice, humming compressors.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A scoreboard reads: ROCKS FALLING, HOUSE TIED.", "para": 0, "sent": 1, "present": [0]}, {"u": 3, "kind": "action", "text": "COACH MARGUERITE LAVOIE (50s, club jacket, whistle) watches from the hack.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "Skip BJORN HALLDORSSON (40s, broom, one-glove) kneels in the house, calling the line.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 5, "kind": "action", "text": "Third DESMOND \"DEZ\" ARCHER (20s, jittery) cradles a stone.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 6, "kind": "action", "text": "Second WILHELMINA \"WILLA\" NG (30s, goggles) sweeps beside it.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 7, "kind": "action", "text": "Lead TAMSIN OKORO (20s, ponytail) holds the broom.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 8, "kind": "action", "text": "And ALTERNATE POPPY DUNLEAVY (teen, coat zipped to chin) sits on the bench, gripping her knees.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 9, "kind": "dialogue", "text": "Dez, hold.", "name": "BJORN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 10, "kind": "dialogue", "text": "Holding.", "name": "DEZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 11, "kind": "action", "text": "Marguerite does not speak.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 12, "kind": "action", "text": "Her eyes move from Dez to the stone to Poppy and back.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 13, "kind": "dialogue", "text": "Easy weight.", "name": "BJORN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 14, "kind": "action", "text": "Dez releases.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 15, "kind": "action", "text": "The stone glides.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 16, "kind": "action", "text": "Willa and Tamsin sweep in sync, the sound of brooms like rain.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 17, "kind": "dialogue", "text": "Hard!", "name": "WILLA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 18, "kind": "dialogue", "text": "Hurry hard!", "name": "TAMSIN", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 19, "kind": "action", "text": "The stone slows.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 20, "kind": "action", "text": "Poppy leans forward.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 21, "kind": "action", "text": "It curls, kisses the guard, and stops one inch from the button.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 22, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 23, "kind": "action", "text": "Then Marguerite lowers her whistle, takes a breath, and sits down next to Poppy.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 24, "kind": "dialogue", "text": "You're up next.", "name": "MARGUERITE", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 25, "kind": "action", "text": "Poppy swallows.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 26, "kind": "action", "text": "Nods.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 27, "kind": "action", "text": "Stands.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 28, "kind": "action", "text": "Takes off her coat.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 29, "kind": "action", "text": "Underneath: the jersey, a size too large.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 30, "kind": "action", "text": "She picks up a stone.", "para": 6, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 31, "kind": "action", "text": "Behind her, the whole team watches.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 32, "kind": "action", "text": "She walks to the hack.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}]}