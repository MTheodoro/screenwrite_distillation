{"scene_id": "s01591", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01591.fountain", "heading": "INT. ABANDONED CARNIVAL - HALL OF MIRRORS - NIGHT", "cast": [{"id": 0, "name": "DETECTIVE NAOMI FAIRWEATHER", "names": ["DETECTIVE NAOMI FAIRWEATHER", "NAOMI"], "gender": "f", "first": 4, "spoke": 2}, {"id": 1, "name": "DETECTIVE CASPIAN ROTH", "names": ["DETECTIVE CASPIAN ROTH", "CASPIAN"], "gender": "?", "first": 5, "spoke": 1}, {"id": 2, "name": "LUCIA FERREIRA", "names": ["LUCIA FERREIRA"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "THE CARNY", "names": ["CARNY", "THE CARNY"], "gender": "m", "first": 6, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED CARNIVAL - HALL OF MIRRORS - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cracked glass multiplies everything.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A hundred reflections of a hundred flashlights, swimming in the dark.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Four silhouettes pick through the maze.", "para": 1, "sent": 0, "present": []}, {"u": 4, "kind": "action", "text": "DETECTIVE NAOMI FAIRWEATHER (40s, rain jacket, gun at her hip).", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "action", "text": "Her partner DETECTIVE CASPIAN ROTH (30s, tall, careful).", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "A hostage, LUCIA FERREIRA (20s, torn dress, hands bound), shoved ahead by the fourth: THE CARNY (50s, grease-stained vest, a pistol, a nervous laugh).", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Don't come closer.", "name": "THE CARNY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "We're not.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "The mirrors show otherwise.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Dozens of Naomis advancing.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "The Carny spins, firing at a reflection.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Glass explodes in a silver storm.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Lucia drops to the floor.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Caspian dives behind a panel.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Naomi flattens against the wall.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "The Carny turns, turns again, lost among his own faces.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Caspian. Left.", "name": "NAOMI", "speaker": 0, "ext": ["CONT'D"], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "He crawls.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "The Carny fires again.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Another mirror blows.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Fragments rain down on Lucia, who covers her head.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Lucia. Stay low.", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "The Carny laughs, high and thin.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Footsteps.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "A hundred of them.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}]}