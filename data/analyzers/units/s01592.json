{"scene_id": "s01592", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01592.fountain", "heading": "INT. MERIDIAN INSURANCE - BASEMENT FILE ROOM - MORNING", "cast": [{"id": 0, "name": "GERALD PLUMMER", "names": ["GERALD PLUMMER", "GERALD"], "gender": "?", "first": 5, "spoke": 12}, {"id": 1, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 11, "spoke": 4}, {"id": 2, "name": "DANA", "names": ["DANA"], "gender": "?", "first": 19, "spoke": 6}, {"id": 3, "name": "HARRIET OKAFOR-BLYTH", "names": ["HARRIET OKAFOR-BLYTH", "HARRIET"], "gender": "f", "first": 26, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. MERIDIAN INSURANCE - BASEMENT FILE ROOM - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Gray shelves.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Gray boxes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "One flickering fluorescent tube.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A sign: \"REMEMBER: DOCUMENTATION IS PROTECTION.\"", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "GERALD PLUMMER (50s, short-sleeved dress shirt, lanyard) wheels a cart of folders down the aisle, whistling a tune with no melody.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "He stops at a shelf, squints at a label.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "A woman steps out of the shadows.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "She wears an expensive coat.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "No lanyard.", "para": 2, "sent": 2, "present": [0]}, {"u": 10, "kind": "action", "text": "No badge.", "para": 2, "sent": 3, "present": [0]}, {"u": 11, "kind": "action", "text": "A STRANGER.", "para": 2, "sent": 4, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Excuse me. Are you the file clerk?", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Archivist.", "name": "GERALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Archivist. I'm looking for the Henderson claim.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Which Henderson?", "name": "GERALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "The big one.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "They're all big, miss.", "name": "GERALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She smiles thinly and holds out a hand.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "I'm Dana. Dana Whitfield. From corporate.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Oh! The audit.", "name": "GERALD", "speaker": 0, "ext": [], "paren": ["delighted"], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Not an audit. A review.", "name": "DANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Gerald Plummer. Twenty-six years in this basement.", "name": "GERALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Impressive.", "name": "DANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "It's a very nice basement.", "name": "GERALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "A third figure appears at the end of the aisle.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "HARRIET OKAFOR-BLYTH (30s, headset, tablet) walks briskly toward them, typing as she goes.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Gerald, I was told you'd be upstairs for the town hall.", "name": "HARRIET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "I was told the town hall was optional.", "name": "GERALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "It's mandatory.", "name": "HARRIET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Then who told me it was optional?", "name": "GERALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Dana, were you speaking to him?", "name": "HARRIET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Briefly.", "name": "DANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Did you mention the restructuring?", "name": "HARRIET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "I did not.", "name": "DANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "What restructuring?", "name": "GERALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Harriet and Dana exchange a look.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "The light flickers.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Gerald, why don't you come upstairs.", "name": "HARRIET", "speaker": 3, "ext": [], "paren": ["carefully"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Why?", "name": "GERALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "There's cake.", "name": "DANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Is it a retirement cake?", "name": "GERALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "It could be.", "name": "DANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Gerald looks down at the cart.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "At the Henderson folder on top.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Then I'd better file this first.", "name": "GERALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "He wheels the cart away, whistling, as Dana and Harriet watch him go.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}]}