{"scene_id": "s01593", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01593.fountain", "heading": "INT. COUNTY ARCHIVE - READING ROOM - RAINY AFTERNOON", "cast": [{"id": 0, "name": "TEDDY", "names": ["TEDDY"], "gender": "f", "first": 5, "spoke": 8}, {"id": 1, "name": "BRANDT", "names": ["BRANDT"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "EZEKIEL FAIRBANKS", "names": ["EZEKIEL FAIRBANKS", "EZEKIEL"], "gender": "m", "first": 6, "spoke": 3}, {"id": 3, "name": "MIRIAM ACHTERBERG", "names": ["MIRIAM ACHTERBERG", "MIRIAM"], "gender": "?", "first": 7, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. COUNTY ARCHIVE - READING ROOM - RAINY AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "High windows, streaked with rain.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Oak tables.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Green-shaded lamps.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The hush of paper.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "THEODORA \"TEDDY\" BRANDT (40s, cardigan, a pencil behind her ear) turns the pages of a bound ledger with white cotton gloves.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "At the next table, EZEKIEL FAIRBANKS (60s, tweed, a magnifying glass on a cord) reads a yellowed newspaper.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "And behind the desk, the archivist MIRIAM ACHTERBERG (50s, bun, reading glasses on her forehead) sorts index cards.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Teddy stops on a page.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Lifts a corner with her pencil.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Looks again.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "She glances at Ezekiel.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "He is watching her over the top of his newspaper.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "They both look away.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Reading room closes at five, everyone.", "name": "MIRIAM", "speaker": 3, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Neither responds.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Teddy photographs the page with her phone, the shutter click loud in the silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Miriam's eyes flick up, then down.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "She files a card.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Ezekiel rises, stretches, and strolls to Teddy's table.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "He glances at the ledger.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "His face stays perfectly polite.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Interesting hand. Eighteen-nineties?", "name": "EZEKIEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Eighteen-ninety-four.", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Mm. I hear the county clerk was a drinker.", "name": "EZEKIEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "I hear a lot of things.", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "He nods.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Returns to his table.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Sits.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Turns a page of his newspaper without reading it.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Teddy takes a slow breath and closes the ledger.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "She slips off one glove, then the other, and folds them over the cover.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Someone always takes that one.", "name": "MIRIAM", "speaker": 3, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Teddy looks up.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Miriam keeps sorting.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Which one?", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "The hand.", "name": "MIRIAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "You've seen it?", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "It's gone out four times this year.", "name": "MIRIAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Ezekiel's newspaper lowers a fraction.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Rain presses at the glass.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Who else?", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "I can't say. Patron privacy.", "name": "MIRIAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Of course.", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Teddy gathers her things.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Stands.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Walks to the desk and slides the ledger across.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Thank you.", "name": "TEDDY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Come again.", "name": "MIRIAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "I'll try.", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "She leaves.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "The door sighs shut behind her.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Ezekiel folds his newspaper, tucks it under his arm, and approaches the desk.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "The same one, please.", "name": "EZEKIEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Miriam lifts the ledger.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Holds it for a moment.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "It's very popular today.", "name": "MIRIAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "She passes it over.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "He opens it to the marked page.", "para": 15, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "Smiles very slightly.", "para": 15, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "Takes out his own phone.", "para": 15, "sent": 3, "present": [0, 1, 2, 3]}]}