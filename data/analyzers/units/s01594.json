{"scene_id": "s01594", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01594.fountain", "heading": "INT. PET GROOMING SALON - AFTERNOON", "cast": [{"id": 0, "name": "CARMELITA VEGA", "names": ["CARMELITA VEGA", "CARMELITA"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "LEO PARK", "names": ["LEO PARK", "LEO"], "gender": "m", "first": 5, "spoke": 3}, {"id": 2, "name": "ZELINSKI", "names": ["ZELINSKI", "MR. ZELINSKI"], "gender": "m", "first": 6, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. PET GROOMING SALON - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent lights.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A wall of leashes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The air smells of oatmeal shampoo and panic.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CARMELITA VEGA (40s, rubber apron, forearms like a boxer's) lathers a very large, very wet Newfoundland named BISCUIT in a steel tub.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Behind her, LEO PARK (20s, trainee, ear gauges) sprays the nozzle without looking.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "And in the waiting area, MR. ZELINSKI (70s, sweater vest, a tiny terrier under his arm) watches with deep concern.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Leo, the nozzle.", "name": "CARMELITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Sorry, I was looking at the dog.", "name": "LEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "The nozzle goes on the dog.", "name": "CARMELITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "That's what I'm doing.", "name": "LEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "You're spraying me.", "name": "CARMELITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Leo glances at the nozzle, then at Carmelita's drenched apron.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "He drops it.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "It whips around, spraying the ceiling.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Leo!", "name": "CARMELITA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Both lunge for the hose.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Biscuit shakes.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "A wave of soapy water crosses the salon.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Mr. Zelinski clutches his terrier and rises from the chair.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Leo slips on the tile.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Carmelita catches his collar.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "They freeze, mid-fall, staring at each other.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Biscuit shakes again.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Foam coats the window.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Is this normal?", "name": "MR. ZELINSKI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Carmelita and Leo exchange a look.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Slowly, they straighten up.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Leo wipes his face with his sleeve.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Carmelita pulls a clump of suds from her hair.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Every Tuesday.", "name": "CARMELITA", "speaker": 0, "ext": [], "paren": ["flatly"], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Every Tuesday.", "name": "LEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "I'll come back later.", "name": "MR. ZELINSKI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "He backs out the door.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "The bell jingles.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Biscuit sneezes.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Soap bubbles drift across the room, floating gently toward the ceiling.", "para": 6, "sent": 3, "present": [0, 1, 2]}]}