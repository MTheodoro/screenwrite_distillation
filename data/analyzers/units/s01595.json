{"scene_id": "s01595", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01595.fountain", "heading": "EXT. MUDDY TRENCH - DAWN", "cast": [{"id": 0, "name": "SERGEANT ABEL TOROSYAN", "names": ["SERGEANT ABEL TOROSYAN", "TOROSYAN"], "gender": "m", "first": 4, "spoke": 2}, {"id": 1, "name": "PRIVATE LUCIEN MARCHAND", "names": ["PRIVATE LUCIEN MARCHAND", "LUCIEN"], "gender": "?", "first": 5, "spoke": 2}, {"id": 2, "name": "CORPORAL HAYDEN BRIGGS", "names": ["CORPORAL HAYDEN BRIGGS", "BRIGGS"], "gender": "m", "first": 6, "spoke": 1}, {"id": 3, "name": "FLIP", "names": ["FLIP"], "gender": "?", "first": 7, "spoke": 2}, {"id": 4, "name": "OKONKWO", "names": ["OKONKWO"], "gender": "?", "first": 7, "spoke": 0}, {"id": 5, "name": "PRIVATE EAMON DOHERTY", "names": ["PRIVATE EAMON DOHERTY", "EAMON"], "gender": "m", "first": 5, "spoke": 1}, {"id": 6, "name": "LIEUTENANT SASHA VOLKOV", "names": ["LIEUTENANT SASHA VOLKOV", "VOLKOV"], "gender": "?", "first": 9, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. MUDDY TRENCH - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A cold morning.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rain-fed mud, duckboards, a sagging tarp strung overhead.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Smoke from a tin stove.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SERGEANT ABEL TOROSYAN (40s, helmet, gray in his stubble) hunches over a mess tin.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside him, PRIVATE LUCIEN MARCHAND (20s, bandaged ear) peels a potato.", "para": 1, "sent": 1, "present": [0, 1, 5]}, {"u": 6, "kind": "action", "text": "CORPORAL HAYDEN BRIGGS (30s, tall, tobacco-stained moustache) cleans his rifle.", "para": 1, "sent": 2, "present": [0, 1, 2, 5]}, {"u": 7, "kind": "action", "text": "PRIVATE FELICITY \"FLIP\" OKONKWO (20s, medic's armband) rewinds a bandage roll.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "action", "text": "PRIVATE EAMON DOHERTY (19, scrawny) writes a letter on his knee.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "action", "text": "And young LIEUTENANT SASHA VOLKOV (20s, polished boots now caked in mud) studies a map.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "dialogue", "text": "Anyone hear the guns?", "name": "TOROSYAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "Not since four.", "name": "BRIGGS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "They're resting.", "name": "LUCIEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "Everyone rests.", "name": "FLIP", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "Gentlemen, a reminder. We move at noon.", "name": "VOLKOV", "speaker": 6, "ext": [], "paren": ["to the trench"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "Noon. Always noon.", "name": "EAMON", "speaker": 5, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "action", "text": "A shell whistles overhead, high and wide, and bursts far behind the line.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "action", "text": "Every man ducks.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "action", "text": "Lucien drops the potato.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "action", "text": "Briggs sweeps the rifle against his chest.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "action", "text": "Flip falls flat.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "action", "text": "Eamon covers his letter with his body.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "action", "text": "Torosyan, last, tucks his tin under his arm.", "para": 2, "sent": 6, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "Then Briggs laughs, once, and the others join, a dry reluctant sound.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "Everyone alive?", "name": "TOROSYAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "My potato's dead.", "name": "LUCIEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "Pity.", "name": "FLIP", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}