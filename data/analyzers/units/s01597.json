{"scene_id": "s01597", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01597.fountain", "heading": "INT. ORBITAL SALVAGE TUG - COCKPIT - SHIP TIME 03:12", "cast": [{"id": 0, "name": "PILOT KESTREL VANDERHOOF", "names": ["PILOT KESTREL VANDERHOOF", "KESTREL"], "gender": "f", "first": 5, "spoke": 8}, {"id": 1, "name": "OSEI MENSAH-RIVERA", "names": ["OSEI MENSAH-RIVERA", "OSEI"], "gender": "f", "first": 6, "spoke": 9}, {"id": 2, "name": "PEBBLE", "names": ["PEBBLE"], "gender": "?", "first": 7, "spoke": 7}, {"id": 3, "name": "VOICE", "names": ["VOICE"], "gender": "?", "first": 48, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. ORBITAL SALVAGE TUG - COCKPIT - SHIP TIME 03:12", "present": []}, {"u": 1, "kind": "action", "text": "Cramped.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Warm.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Handwritten sticky notes on every panel.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Through the viewport: the husk of a dead freighter, tumbling slowly.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "PILOT KESTREL VANDERHOOF (30s, shaved head, a tattoo of a moth on her neck) flicks switches.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "At the engineering station, DR. OSEI MENSAH-RIVERA (40s, glasses taped at the hinge, calm voice) frowns at a readout.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "And the ship's AI, a soft synthetic voice named PEBBLE, speaks from the ceiling.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Pebble, scan that hull again.", "name": "KESTREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Scanning. The hull contains residual heat signatures.", "name": "PEBBLE", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Residual from what?", "name": "OSEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Possibly from life.", "name": "PEBBLE", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "There shouldn't be life.", "name": "KESTREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "There shouldn't be anything.", "name": "OSEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Respectfully, there is both.", "name": "PEBBLE", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Kestrel leans toward the glass.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Osei rises and joins her.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Together they watch the freighter turn.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "A single window glows amber.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I count one.", "name": "OSEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I count more.", "name": "KESTREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "I count seventeen.", "name": "PEBBLE", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Seventeen what?", "name": "OSEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Heartbeats.", "name": "PEBBLE", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Kestrel and Osei stare at the speaker.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "At each other.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "At the glass.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Seventeen heartbeats on a ship that's been dead six years.", "name": "KESTREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Could be a malfunction.", "name": "OSEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Could be a rescue.", "name": "KESTREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Could be a trap.", "name": "OSEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Could be both.", "name": "KESTREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "She unbuckles.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Pushes off toward the airlock.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "He grabs her ankle.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "She grabs his wrist.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "They float, face to face.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "^Let go.", "name": "KESTREL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "^Don't.", "name": "OSEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Please do not argue in zero-g. It increases the risk of injury.", "name": "PEBBLE", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Kestrel laughs despite herself.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Osei lets go.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "We call it in first.", "name": "OSEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Fine.", "name": "KESTREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "She floats back to the console.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Keys the comm.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Static.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "A man's voice answers from the freighter, calm, cheerful, impossible.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Salvage tug, welcome. We've been waiting.", "name": "VOICE", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Kestrel looks at Osei.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Osei looks at the ceiling.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Pebble?", "name": "OSEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "I do not recognize that voice.", "name": "PEBBLE", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Kestrel's hand hovers over the airlock release.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}]}