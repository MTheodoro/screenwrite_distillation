{"scene_id": "s01598", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01598.fountain", "heading": "INT. HOSPITAL - STAFF LOUNGE - 3 AM", "cast": [{"id": 0, "name": "ANIKA SHARMA", "names": ["ANIKA SHARMA", "ANIKA"], "gender": "?", "first": 4, "spoke": 1}, {"id": 1, "name": "BART", "names": ["BART"], "gender": "?", "first": 5, "spoke": 2}, {"id": 2, "name": "KINSELLA", "names": ["KINSELLA"], "gender": "?", "first": 5, "spoke": 0}, {"id": 3, "name": "TOMASZ NOWAK", "names": ["TOMASZ NOWAK", "TOMASZ"], "gender": "?", "first": 6, "spoke": 1}, {"id": 4, "name": "TECH LUCINDA FAIRCHILD", "names": ["TECH LUCINDA FAIRCHILD", "LUCINDA"], "gender": "?", "first": 7, "spoke": 2}, {"id": 5, "name": "ORDERLY MARCUS OYELOWO", "names": ["ORDERLY MARCUS OYELOWO", "MARCUS"], "gender": "?", "first": 8, "spoke": 1}, {"id": 6, "name": "REGINALD PEMBERTON", "names": ["REGINALD PEMBERTON", "PEMBERTON"], "gender": "?", "first": 9, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOSPITAL - STAFF LOUNGE - 3 AM", "present": []}, {"u": 1, "kind": "action", "text": "Vending machine hum.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A couch with a stain no one will claim.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A TV on mute plays a late-night infomercial.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. ANIKA SHARMA (30s, scrubs, hair undone) sprawls on the couch.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "NURSE BARTHOLOMEW \"BART\" KINSELLA (50s, glasses on a chain) stirs instant coffee.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "RESIDENT DR. TOMASZ NOWAK (20s, wired) flips through a chart.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "TECH LUCINDA FAIRCHILD (20s, headphones) eats crackers.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "ORDERLY MARCUS OYELOWO (40s, mop in hand) leans in the doorway.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "action", "text": "And attending DR. REGINALD PEMBERTON (60s, bow tie, exhausted dignity) sits very still in the armchair.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "dialogue", "text": "Anyone want donuts? They're from Tuesday.", "name": "BART", "speaker": 1, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "Pass.", "name": "LUCINDA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "Is Tuesday old?", "name": "TOMASZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "Tuesday is archaeological.", "name": "ANIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "Three hours until rounds.", "name": "PEMBERTON", "speaker": 6, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "action", "text": "A monitor beeps down the hall.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "action", "text": "All six stiffen.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "action", "text": "Anika sits up.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "action", "text": "Tomasz drops the chart.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "action", "text": "Bart sets down the coffee.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "action", "text": "Lucinda pulls off one earphone.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "action", "text": "Marcus straightens.", "para": 2, "sent": 6, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "action", "text": "Pemberton opens one eye.", "para": 2, "sent": 7, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "The beep resolves into a steady rhythm.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "Nobody moves.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "False alarm.", "name": "PEMBERTON", "speaker": 6, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "action", "text": "They exhale together.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "Anika slumps back.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "Tomasz picks up the chart.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "Bart returns to stirring.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "I hate nights.", "name": "MARCUS", "speaker": 5, "ext": [], "paren": ["to no one"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "Everyone hates nights.", "name": "LUCINDA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "Nights are where we find out who we are.", "name": "PEMBERTON", "speaker": 6, "ext": [], "paren": ["gently"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "Tired, apparently.", "name": "BART", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}