{"scene_id": "s01599", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01599.fountain", "heading": "INT. CIRCUS WINTER QUARTERS - REHEARSAL BARN - MORNING", "cast": [{"id": 0, "name": "FLYING FONTAINES", "names": ["FLYING FONTAINES"], "gender": "?", "first": 3, "spoke": 0}, {"id": 1, "name": "RINGMASTER BARNABY FONTAINE", "names": ["RINGMASTER BARNABY FONTAINE", "BARNABY"], "gender": "?", "first": 4, "spoke": 14}, {"id": 2, "name": "PICKLES", "names": ["PICKLES"], "gender": "?", "first": 5, "spoke": 6}, {"id": 3, "name": "VIVI", "names": ["VIVI"], "gender": "?", "first": 6, "spoke": 4}, {"id": 4, "name": "MORETTI", "names": ["MORETTI"], "gender": "?", "first": 6, "spoke": 0}, {"id": 5, "name": "GUSTAV BERGSTROM", "names": ["GUSTAV BERGSTROM", "GUSTAV"], "gender": "?", "first": 7, "spoke": 5}, {"id": 6, "name": "FANNY LU", "names": ["FANNY LU", "FANNY"], "gender": "?", "first": 8, "spoke": 6}, {"id": 7, "name": "ALISTAIR PEMBERTON-HOYT", "names": ["ALISTAIR PEMBERTON-HOYT", "ALISTAIR"], "gender": "m", "first": 31, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. CIRCUS WINTER QUARTERS - REHEARSAL BARN - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "A drafty barn smelling of sawdust and horse.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Trapezes hang at rest.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A faded banner: \"THE FLYING FONTAINES - SINCE 1923.\"", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "RINGMASTER BARNABY FONTAINE (60s, top hat, a tailcoat patched at the elbows) stands center ring, clipboard in hand.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Beside him, the clown PICKLES (40s, half makeup, full despair) hangs his head.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "Atop a ladder, the aerialist VIOLETTA \"VIVI\" MORETTI (30s, sequined leotard under a parka) adjusts a rope.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "action", "text": "Below her, the strongman GUSTAV BERGSTROM (40s, shaved head, shoulders like a door) lifts a barbell without effort.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "action", "text": "And in a folding chair, the bookkeeper FANNY LU (50s, cardigan, adding machine) taps keys.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 9, "kind": "dialogue", "text": "Ladies and gentlemen, we are bankrupt.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "dialogue", "text": "Again?", "name": "PICKLES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "Still.", "name": "FANNY", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "Barnaby, we've been bankrupt since Easter.", "name": "VIVI", "speaker": 3, "ext": [], "paren": ["from the ladder"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "Since Easter, Vivi, we have been merely poor. Today we are bankrupt.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "I thought bankrupt meant we get a bailout.", "name": "GUSTAV", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "It means we get a lawyer.", "name": "FANNY", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "I can juggle lawyers.", "name": "PICKLES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "Pickles, you are not helping.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "I am a clown. I am helping by being unhelpful.", "name": "PICKLES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "We could sell the elephant.", "name": "VIVI", "speaker": 3, "ext": [], "paren": ["sliding down the rope"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "We don't have an elephant.", "name": "GUSTAV", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "We have a very large dog.", "name": "VIVI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "We have a very large debt.", "name": "FANNY", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "I will not sell Cornelius.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "Cornelius is a dog?", "name": "PICKLES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "Cornelius is a lion.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "Cornelius is an old man in a lion costume.", "name": "GUSTAV", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "Cornelius is our dignity.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "A silence.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "Then the barn door bangs open and a gust of wind sweeps in.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "A figure steps through: a stranger in a pinstriped suit, briefcase in hand.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "MR. ALISTAIR PEMBERTON-HOYT (50s, banker's frown, a small gold pin on his lapel).", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "dialogue", "text": "Good morning. I'm looking for Mr. Fontaine.", "name": "ALISTAIR", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "dialogue", "text": "You've found him.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": ["stiffly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "dialogue", "text": "I represent the Third Mutual Bank.", "name": "ALISTAIR", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "dialogue", "text": "Here come the clowns.", "name": "PICKLES", "speaker": 2, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "dialogue", "text": "I'm here to inspect the assets.", "name": "ALISTAIR", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "dialogue", "text": "We have no assets.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "dialogue", "text": "Then I'm here to inspect the liabilities.", "name": "ALISTAIR", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "dialogue", "text": "That's us.", "name": "VIVI", "speaker": 3, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "action", "text": "Alistair opens his briefcase and pulls out a document.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 41, "kind": "action", "text": "Fanny takes it.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 42, "kind": "action", "text": "Reads.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 43, "kind": "action", "text": "Her brows climb.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 44, "kind": "dialogue", "text": "Barnaby, this says the bank will forgive the debt.", "name": "FANNY", "speaker": 6, "ext": [], "paren": ["slowly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 45, "kind": "dialogue", "text": "It says what?", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 46, "kind": "dialogue", "text": "On one condition.", "name": "FANNY", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 47, "kind": "dialogue", "text": "That you perform.", "name": "ALISTAIR", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 48, "kind": "dialogue", "text": "Perform?", "name": "GUSTAV", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 49, "kind": "dialogue", "text": "My daughter's birthday party. Saturday. She's seven. She adores clowns.", "name": "ALISTAIR", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 50, "kind": "action", "text": "Pickles raises one weary hand.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 51, "kind": "dialogue", "text": "^I'm a clown.", "name": "PICKLES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 52, "kind": "dialogue", "text": "^We are the Flying Fontaines.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 53, "kind": "dialogue", "text": "Then it's settled.", "name": "ALISTAIR", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 54, "kind": "action", "text": "Barnaby stares at the contract.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 55, "kind": "action", "text": "At Alistair.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 56, "kind": "action", "text": "At the faded banner.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 57, "kind": "dialogue", "text": "Mr. Pemberton-Hoyt, we will not merely perform. We will astonish.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 58, "kind": "dialogue", "text": "I merely require competence.", "name": "ALISTAIR", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 59, "kind": "dialogue", "text": "Competence is the death of art.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 60, "kind": "action", "text": "Fanny stamps the document.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 61, "kind": "action", "text": "Gustav drops the barbell.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 62, "kind": "action", "text": "Vivi whoops.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 63, "kind": "action", "text": "Pickles produces, from nowhere, a handful of confetti and throws it into the air.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 64, "kind": "dialogue", "text": "I'll see you Saturday.", "name": "ALISTAIR", "speaker": 7, "ext": [], "paren": ["dryly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 65, "kind": "action", "text": "He exits.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 66, "kind": "action", "text": "The door bangs behind him.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 67, "kind": "dialogue", "text": "Barnaby, we have four days.", "name": "FANNY", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 68, "kind": "dialogue", "text": "Then we shall rehearse for three and panic for one.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 69, "kind": "dialogue", "text": "Which day is panic?", "name": "GUSTAV", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 70, "kind": "dialogue", "text": "Saturday, Gustav. Always Saturday.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}