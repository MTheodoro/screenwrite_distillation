{"scene_id": "s01600", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01600.fountain", "heading": "INT. GRAND HOTEL - PENTHOUSE SUITE - NIGHT", "cast": [{"id": 0, "name": "VICTOR LANGFORD", "names": ["VICTOR LANGFORD", "VICTOR"], "gender": "m", "first": 5, "spoke": 15}, {"id": 1, "name": "IRIS LANGFORD", "names": ["IRIS LANGFORD", "IRIS"], "gender": "?", "first": 5, "spoke": 12}, {"id": 2, "name": "WAITER LEONARD CROSS", "names": ["WAITER LEONARD CROSS", "LEONARD"], "gender": "?", "first": 30, "spoke": 12}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRAND HOTEL - PENTHOUSE SUITE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Art deco.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Polished brass.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A fire crackles behind a screen.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Through tall windows, the glittering city.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "VICTOR LANGFORD (50s, dinner jacket, whiskey in hand) stands before a window, admiring his reflection.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "At a writing desk sits his wife IRIS LANGFORD (40s, silver gown, a jeweled pin), reading a letter she does not seem to be reading.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "You're quiet tonight, Victor.", "name": "IRIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "I'm thinking.", "name": "VICTOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "About what?", "name": "IRIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Everything.", "name": "VICTOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "That's not an answer.", "name": "IRIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "It's the only honest one.", "name": "VICTOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She folds the letter.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Slips it into her bag.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "He turns from the window, smiling like a man at ease.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Shall we dine?", "name": "VICTOR", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Here?", "name": "IRIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Upstairs. Eight o'clock. A table for two.", "name": "VICTOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "How romantic.", "name": "IRIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "I try.", "name": "VICTOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "He crosses to her.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Kisses her forehead.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She does not flinch, but she does not close her eyes either.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "A soft knock.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Both turn.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "That will be the champagne.", "name": "VICTOR", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "He opens the door.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "A tall man in a waiter's jacket stands in the hall, tray in hand, a bottle sweating in an ice bucket.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "But his shoes are wrong, military black, and his hands are bare of the white gloves the hotel requires.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "WAITER LEONARD CROSS (30s, thin smile, calm eyes) steps in and sets the tray on the table.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Good evening, Mr. and Mrs. Langford.", "name": "LEONARD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "You're new.", "name": "IRIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Very.", "name": "LEONARD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Where's Henri?", "name": "VICTOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Henri has the night off.", "name": "LEONARD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Henri never has a night off.", "name": "VICTOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "He does tonight.", "name": "LEONARD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "The fire pops.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Victor's smile fades.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Iris, would you excuse us?", "name": "VICTOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "No.", "name": "IRIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Mrs. Langford may stay.", "name": "LEONARD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Of course she may. It's her suite as well.", "name": "VICTOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "It is.", "name": "LEONARD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Victor, who is he?", "name": "IRIS", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "A waiter.", "name": "VICTOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "A friend of Mr. Delacroix.", "name": "LEONARD", "speaker": 2, "ext": [], "paren": ["at the same time"], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "The name hangs in the air.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Victor sets down his glass.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Iris rises, one hand on the desk.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Delacroix.", "name": "IRIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Iris.", "name": "VICTOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "He sends his regards.", "name": "LEONARD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "You told me he was dead.", "name": "IRIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "He is.", "name": "VICTOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "Not entirely.", "name": "LEONARD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Victor takes a step back.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Iris takes a step forward.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "Leonard lifts the champagne bottle, peels the foil, and eases the cork.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Iris, don't.", "name": "VICTOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "Leonard, is it?", "name": "IRIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "Yes.", "name": "LEONARD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "Tell me, Leonard, what does Mr. Delacroix want?", "name": "IRIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "Everything, Mrs. Langford. But tonight, I think he'd settle for the truth.", "name": "LEONARD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "The cork pops.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "Foam spills over the bottle.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "Victor stares at it.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "Iris stares at Leonard.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "Leonard stares at no one.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 71, "kind": "dialogue", "text": "Shall we begin?", "name": "LEONARD", "speaker": 2, "ext": ["CONT'D"], "paren": ["pouring three glasses"], "dual": false, "present": [0, 1, 2]}]}