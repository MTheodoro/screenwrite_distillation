{"scene_id": "s01604", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01604.fountain", "heading": "INT. VELODROME - INFIELD - EARLY MORNING", "cast": [{"id": 0, "name": "ISOLDE MAKINEN", "names": ["ISOLDE MAKINEN", "ISOLDE"], "gender": "f", "first": 4, "spoke": 4}, {"id": 1, "name": "COACH", "names": ["COACH"], "gender": "?", "first": 14, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. VELODROME - INFIELD - EARLY MORNING", "present": []}, {"u": 1, "kind": "action", "text": "An enormous oval of pale wooden track banked to a steep tilt, lit by a few high lamps.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The empty seats rise in tiers into the dark.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The air smells of rubber and resin.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ISOLDE MAKINEN (20s, skin suit, helmet hanging from one hand, a scar on her left calf) sits on an upturned crate, unlacing her cleats.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her bike leans against the rail, its carbon frame catching the lamplight like a blade.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "She stares at the track.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Doesn't blink.", "para": 2, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "Doesn't speak.", "para": 2, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "One thumb works at a loose thread on her glove.", "para": 2, "sent": 3, "present": [0]}, {"u": 10, "kind": "action", "text": "A phone on the crate beside her buzzes.", "para": 3, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "She glances at the screen, then back at the track.", "para": 3, "sent": 1, "present": [0]}, {"u": 12, "kind": "action", "text": "It buzzes again.", "para": 3, "sent": 2, "present": [0]}, {"u": 13, "kind": "action", "text": "She answers, thumb on speaker.", "para": 3, "sent": 3, "present": [0]}, {"u": 14, "kind": "dialogue", "text": "You there?", "name": "COACH", "speaker": 1, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Yes.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Sleep?", "name": "COACH", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Some.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Eat?", "name": "COACH", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "A banana.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "That's not eating.", "name": "COACH", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She says nothing.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Behind her eyes, something flickers: a thousand laps, a thousand pairs of hands, a wall of sound.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "You ready?", "name": "COACH", "speaker": 1, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Isolde stands.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Sets down her cleats.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Steps toward the bike.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Lays a palm on the saddle.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Ask me in four minutes.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "She hangs up.", "para": 6, "sent": 0, "present": [0, 1]}]}