{"scene_id": "s01605", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01605.fountain", "heading": "INT. MUSEUM - EGYPTIAN WING - NIGHT", "cast": [{"id": 0, "name": "LUCKY", "names": ["LUCKY"], "gender": "?", "first": 6, "spoke": 6}, {"id": 1, "name": "ROMANO", "names": ["ROMANO"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "TEDDY BEAR", "names": ["TEDDY BEAR"], "gender": "?", "first": 7, "spoke": 6}, {"id": 3, "name": "ADEBAYO", "names": ["ADEBAYO"], "gender": "?", "first": 7, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. MUSEUM - EGYPTIAN WING - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dim.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Hushed.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Glass cases of scarabs and gold.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A security camera pans slowly, red light blinking.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Two figures in dark jumpsuits crouch behind a stone sarcophagus.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "LUCINDA \"LUCKY\" ROMANO (30s, braids tucked under a cap, tools in a belt) peers around the lid.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Her partner THEODORE \"TEDDY BEAR\" ADEBAYO (40s, soft-spoken, a bag of cable ties) shifts his weight.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Teddy Bear, camera.", "name": "LUCKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "I see it.", "name": "TEDDY BEAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "It turns in six seconds.", "name": "LUCKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I counted five.", "name": "TEDDY BEAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Then it turns in five.", "name": "LUCKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "The camera sweeps away.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Lucky slips out from behind the sarcophagus, Teddy Bear lumbering after her.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "She kneels at a case.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Pulls a thin pick from her belt.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "He crouches beside her, aims a penlight, steadies the glass with a palm.", "para": 2, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "She slides the pick into the lock.", "para": 2, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Clicks it.", "para": 2, "sent": 6, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Slides the glass open an inch, lifts the golden scarab on its velvet cushion, drops it into a lined pouch.", "para": 2, "sent": 7, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "He holds the lid, lowers it back, wipes the print with a sleeve.", "para": 2, "sent": 8, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Done?", "name": "TEDDY BEAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Done.", "name": "LUCKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "That was easy.", "name": "TEDDY BEAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Don't say that.", "name": "LUCKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "It was.", "name": "TEDDY BEAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "An alarm shrieks.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Red lights spin.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "A guard's voice crackles somewhere deep in the building.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "You said it.", "name": "LUCKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "I'm sorry.", "name": "TEDDY BEAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "She grabs his sleeve.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "They bolt for the exit, their footsteps ringing off the marble.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}]}