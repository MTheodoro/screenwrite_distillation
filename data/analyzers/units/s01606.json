{"scene_id": "s01606", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01606.fountain", "heading": "INT. FARMHOUSE CELLAR - NIGHT", "cast": [{"id": 0, "name": "FAITH BROOKS", "names": ["FAITH BROOKS", "FAITH"], "gender": "?", "first": 5, "spoke": 3}, {"id": 1, "name": "WALT", "names": ["WALT"], "gender": "?", "first": 6, "spoke": 3}, {"id": 2, "name": "JUNE", "names": ["JUNE"], "gender": "?", "first": 7, "spoke": 1}, {"id": 3, "name": "DRIFTER", "names": ["DRIFTER"], "gender": "?", "first": 8, "spoke": 3}, {"id": 4, "name": "EPHRAIM", "names": ["EPHRAIM"], "gender": "?", "first": 22, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. FARMHOUSE CELLAR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Damp stone.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Shelves of jarred peaches.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single bare bulb swings from a cord.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Four people stand in the middle of the cellar.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "FAITH BROOKS (30s, flannel, a lantern in one hand).", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Her husband WALT (30s, ball cap, a shovel).", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Her little sister JUNIPER \"JUNE\" (16, braids, a stuffed rabbit).", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "And an older man they found at the door, named only as the DRIFTER (60s, long coat, calm).", "para": 1, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Walt, shut the hatch.", "name": "FAITH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "It's shut.", "name": "WALT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Faith, I don't like it down here.", "name": "JUNE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Hush, June.", "name": "FAITH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "The Drifter inspects a jar.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Holds it to the bulb.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Something inside moves.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Nice peaches.", "name": "DRIFTER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "They're fine.", "name": "WALT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "They're alive.", "name": "DRIFTER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Faith's lantern wavers.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "June clutches the rabbit.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Who are you?", "name": "FAITH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Call me Ephraim.", "name": "DRIFTER", "speaker": 3, "ext": [], "paren": ["smiling"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Ephraim, put that down.", "name": "WALT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Walter, you have no idea what you're keeping.", "name": "EPHRAIM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Ephraim sets the jar back.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "The bulb flickers.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Behind the shelves, something scrapes the wall, patient and slow.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}]}