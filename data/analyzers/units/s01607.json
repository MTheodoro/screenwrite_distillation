{"scene_id": "s01607", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01607.fountain", "heading": "INT. FRONT PORCH - SUMMER EVENING", "cast": [{"id": 0, "name": "ARCHIE", "names": ["ARCHIE"], "gender": "m", "first": 2, "spoke": 3}, {"id": 1, "name": "TURNBULL", "names": ["TURNBULL"], "gender": "?", "first": 2, "spoke": 0}, {"id": 2, "name": "PENELOPE", "names": ["PENELOPE"], "gender": "?", "first": 3, "spoke": 6}, {"id": 3, "name": "BARNABY", "names": ["BARNABY"], "gender": "?", "first": 4, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. FRONT PORCH - SUMMER EVENING", "present": []}, {"u": 1, "kind": "action", "text": "A wooden porch with a creaky swing, a pitcher of lemonade sweating on a side table, a glow of fireflies in the yard beyond.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "GRANDPA ARCHIBALD \"ARCHIE\" TURNBULL (70s, suspenders, a straw hat) rocks in a wicker chair and whittles a small wooden bird.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 3, "kind": "action", "text": "His granddaughter PENELOPE (10, scraped knees, a net) sits cross-legged on the boards.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 4, "kind": "action", "text": "Her cousin BARNABY (8, a jar with holes punched in the lid) kneels at the porch rail.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 5, "kind": "dialogue", "text": "Easy with the net, Penny.", "name": "ARCHIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "dialogue", "text": "I'm being easy.", "name": "PENELOPE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "You're swinging it like a baseball bat.", "name": "ARCHIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "It's the only way to catch one.", "name": "PENELOPE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "I caught three already!", "name": "BARNABY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "You did not.", "name": "PENELOPE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I did too.", "name": "BARNABY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Show me.", "name": "PENELOPE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Barnaby holds up the jar.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "It glows faintly.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Penelope leans in, then leaps up, swings the net, and tumbles into the lemonade table.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "The pitcher wobbles.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Archie reaches out and steadies it.", "para": 2, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Barnaby drops the jar, which rolls off the porch and into the grass.", "para": 2, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Penelope scrambles after it, net flailing.", "para": 2, "sent": 6, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Barnaby follows.", "para": 2, "sent": 7, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Archie sets down the whittling knife and chuckles.", "para": 2, "sent": 8, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "It got out!", "name": "PENELOPE", "speaker": 2, "ext": ["CONT'D"], "paren": ["from the yard"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Three got out!", "name": "BARNABY", "speaker": 3, "ext": [], "paren": ["from the yard"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Let them go, children. They know the way home.", "name": "ARCHIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Penelope and Barnaby stand in the dark yard, surrounded by tiny flickering lights, their faces turned upward.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Wow.", "name": "PENELOPE", "speaker": 2, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Yeah.", "name": "BARNABY", "speaker": 3, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Archie picks up his whittling again.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "The swing creaks.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "The fireflies drift.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}]}