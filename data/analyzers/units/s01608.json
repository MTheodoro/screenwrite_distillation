{"scene_id": "s01608", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01608.fountain", "heading": "INT. SLEEPER TRAIN - DINING CAR - NIGHT", "cast": [{"id": 0, "name": "DOCTOR MIRABELLE ACHEBE-LONG", "names": ["DOCTOR MIRABELLE ACHEBE-LONG", "MIRABELLE"], "gender": "f", "first": 4, "spoke": 3}, {"id": 1, "name": "COLONEL PERCIVAL HOLLOWAY-GRANT", "names": ["COLONEL PERCIVAL HOLLOWAY-GRANT", "PERCIVAL"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "MISS ODALYS FERNSBY", "names": ["MISS ODALYS FERNSBY", "ODALYS"], "gender": "?", "first": 6, "spoke": 4}, {"id": 3, "name": "VLADIMIR ZHURAVLEV", "names": ["VLADIMIR ZHURAVLEV", "VLADIMIR"], "gender": "?", "first": 7, "spoke": 2}, {"id": 4, "name": "DESMOND ISAIAH", "names": ["DESMOND ISAIAH", "DESMOND"], "gender": "m", "first": 8, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. SLEEPER TRAIN - DINING CAR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A narrow carriage, polished wood and brass, white tablecloths swaying with the rails.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Outside the windows, black fields slide by in the dark, broken now and then by a lone farm light.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Five passengers sit scattered among the tables, each with a half-finished meal and a private worry.", "para": 1, "sent": 0, "present": []}, {"u": 4, "kind": "action", "text": "DOCTOR MIRABELLE ACHEBE-LONG (50s, tailored suit, a leather bag at her feet) cuts a piece of fish with surgical care.", "para": 2, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Opposite her sits COLONEL PERCIVAL HOLLOWAY-GRANT (70s, regimental tie, a monocle) tapping a cigarette against a silver case.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "At the next table, MISS ODALYS FERNSBY (20s, hat with a feather, gloves) peers into a compact mirror.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Across the aisle, a heavyset man, MR. VLADIMIR ZHURAVLEV (60s, fur collar, hands like shovels), pours vodka into a glass.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "And near the door, the porter, DESMOND ISAIAH (30s, white jacket, a tray), waits with the patience of the trained.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Colonel, you were saying about the Rhodesian campaign.", "name": "MIRABELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Was I? Yes. The heat was infernal.", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "It must have been dreadful.", "name": "ODALYS", "speaker": 2, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "War is always dreadful.", "name": "VLADIMIR", "speaker": 3, "ext": [], "paren": ["over her"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "I recall a particularly dreadful afternoon in nineteen eleven.", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": ["over him"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Miss Fernsby, are you quite well?", "name": "MIRABELLE", "speaker": 0, "ext": [], "paren": ["to Odalys"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Perfectly.", "name": "ODALYS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "She is not. Look at her hands.", "name": "VLADIMIR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "My hands are fine.", "name": "ODALYS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Shall I bring tea, miss?", "name": "DESMOND", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "No, thank you.", "name": "ODALYS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Tea is a sovereign remedy.", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "So is silence.", "name": "MIRABELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Percival glares.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Vladimir laughs, a bark.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "The train lurches around a curve and a glass falls from a nearby table, shattering.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Everyone looks.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Desmond bends to sweep it up.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Beg pardon, ladies and gentlemen.", "name": "DESMOND", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Careful, my boy.", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Yes, Colonel.", "name": "DESMOND", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "As he gathers the shards, he stops.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "In the debris lies a small brass key.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "He glances up.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Odalys has gone very pale.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Her eyes meet his.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "She shakes her head, once.", "para": 4, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Desmond closes his hand over the key and says nothing.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "He stands.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "The train rushes on.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}]}