{"scene_id": "s01610", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01610.fountain", "heading": "INT. ABANDONED BOWLING ALLEY - BASEMENT VAULT - NIGHT", "cast": [{"id": 0, "name": "OZZIE", "names": ["OZZIE"], "gender": "m", "first": 5, "spoke": 5}, {"id": 1, "name": "QUINTERO", "names": ["QUINTERO"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "LORELEI FAIRBANKS", "names": ["LORELEI FAIRBANKS", "LORELEI"], "gender": "?", "first": 6, "spoke": 3}, {"id": 3, "name": "GRANT BELLAMY", "names": ["GRANT BELLAMY", "GRANT"], "gender": "?", "first": 7, "spoke": 4}, {"id": 4, "name": "MAE-LING TSANG", "names": ["MAE-LING TSANG", "MAE-LING"], "gender": "f", "first": 8, "spoke": 3}, {"id": 5, "name": "OFFICER DELBERT MARCH", "names": ["OFFICER DELBERT MARCH", "DELBERT"], "gender": "?", "first": 37, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED BOWLING ALLEY - BASEMENT VAULT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dust and rust.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A hand-cranked lamp throws a pool of yellow on a steel door.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Behind the pins, behind the lanes, behind forty years of silence: the vault.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Four crew members cluster around it.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "OSWALDO \"OZZIE\" QUINTERO (50s, safecracker, stethoscope around his neck) presses an ear to the dial.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "LORELEI FAIRBANKS (30s, black turtleneck, a laptop on a milk crate) types in the shadows.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "GRANT BELLAMY (40s, plumber's overalls, a pry bar) leans against the wall.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "And in the doorway, watching the stairs, stands MAE-LING TSANG (20s, hood up, earpiece).", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Quiet, please.", "name": "OZZIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "We are quiet.", "name": "LORELEI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "I'm quieter.", "name": "GRANT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Both of you are loud.", "name": "MAE-LING", "speaker": 4, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Ozzie turns the dial a quarter inch.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Clicks.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Turns it back.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Clicks.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "His lips move.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "He is counting.", "para": 3, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Seven. Nineteen. Four.", "name": "OZZIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Your numbers or the bank's?", "name": "LORELEI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "The bank's. Nineteen-eighty-six. The manager's anniversary.", "name": "OZZIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "That's romantic.", "name": "GRANT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "It's lazy.", "name": "OZZIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Lorelei looks up from the laptop.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Grant straightens.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Mae-Ling stiffens, one hand rising to her earpiece.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "She turns.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Someone's on the stairs.", "name": "MAE-LING", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Grant lifts the pry bar.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Lorelei closes the laptop.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Ozzie keeps his hand on the dial, ear still pressed to the steel.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Mae-Ling slips into the shadows beside the stairs, back against the wall.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Footsteps descend.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Slow.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Heavy.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "A flashlight beam sweeps the room.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "A security guard, OFFICER DELBERT MARCH (60s, belly, jangling keys), steps off the last stair.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "He looks around.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Sees nothing but dust, shadows, the glint of an old lane.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Hello?", "name": "DELBERT", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Silence.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "He steps forward.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "His beam crosses the vault door, then the empty milk crate, then a coil of cable.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Kids again.", "name": "DELBERT", "speaker": 5, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "He turns.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Heads back up.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "Mae-Ling exhales.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "Ozzie clicks the dial one last time.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "The vault door shudders, groans, and swings open an inch.", "para": 9, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "Inside, in the glow of the lamp: a single gold bowling ball on a velvet cushion.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "That's it?", "name": "LORELEI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "That's it.", "name": "GRANT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "It's solid gold.", "name": "OZZIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "It's heavy.", "name": "MAE-LING", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "Of course it's heavy. It's gold.", "name": "GRANT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "Ozzie reaches in and lifts it with both hands.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "The floor creaks beneath him.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "Above, a door slams, and the flashlight beam returns, swinging fast down the stairs.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "I knew it! Don't move!", "name": "DELBERT", "speaker": 5, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "action", "text": "All four crew members freeze.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "Ozzie hugs the ball to his chest.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "Grant raises the pry bar.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "Lorelei grabs the laptop.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "Mae-Ling reaches for the nearest bowling pin.", "para": 12, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "dialogue", "text": "Drop it!", "name": "DELBERT", "speaker": 5, "ext": ["O.S.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "action", "text": "Ozzie looks at the others.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "action", "text": "They look at him.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "action", "text": "He takes a step backward, rolls the golden ball down the nearest lane, and watches it thunder into the dark.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "action", "text": "The pins explode.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "action", "text": "Delbert shouts.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "action", "text": "In the chaos, the crew scatters.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}