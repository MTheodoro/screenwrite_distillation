{"scene_id": "s01611", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01611.fountain", "heading": "INT. APPELLATE COURTROOM - DAY", "cast": [{"id": 0, "name": "JUDGE FLORENCE ADEYEMI-HART", "names": ["JUDGE FLORENCE ADEYEMI-HART", "FLORENCE"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "ATTORNEY GABRIEL SOTOMAYOR-BELL", "names": ["ATTORNEY GABRIEL SOTOMAYOR-BELL", "GABRIEL"], "gender": "m", "first": 5, "spoke": 3}, {"id": 2, "name": "ATTORNEY NADINE KRAUSE", "names": ["ATTORNEY NADINE KRAUSE", "NADINE"], "gender": "f", "first": 5, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. APPELLATE COURTROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Dark wood, flags, a ceiling of coffered plaster.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The gallery is nearly empty.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The gavel sits unused.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "JUDGE FLORENCE ADEYEMI-HART (60s, black robe, silver locs) presides.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Before her, two lawyers at separate lecterns: ATTORNEY GABRIEL SOTOMAYOR-BELL (40s, navy suit) and ATTORNEY NADINE KRAUSE (50s, gray pinstripe).", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Counselors, we've heard enough on the statute.", "name": "FLORENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Your Honor, one final point.", "name": "GABRIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Your Honor, I object to a final point.", "name": "NADINE", "speaker": 2, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Let him finish.", "name": "FLORENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "The plaintiff's right of way was established in nineteen-fifty.", "name": "GABRIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Established by whom?", "name": "NADINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "^By the county.", "name": "GABRIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "^By a county that no longer exists.", "name": "NADINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Florence raises a hand.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Both stop.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "She adjusts her glasses, glances at a document, and sets it aside.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Mr. Sotomayor-Bell, sit down.", "name": "FLORENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "He sits.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Nadine remains standing, stiff.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Ms. Krause, you too.", "name": "FLORENCE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Nadine lowers herself slowly.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "The courtroom is silent.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "The court will rule from the bench.", "name": "FLORENCE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "She pauses.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Gabriel clasps his hands.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Nadine doesn't blink.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Affirmed.", "name": "FLORENCE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "A single exhale from the gallery.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Gabriel closes his folder.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Nadine gathers her papers with great care, and neither looks at the other.", "para": 6, "sent": 2, "present": [0, 1, 2]}]}