{"scene_id": "s01612", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01612.fountain", "heading": "INT. SCHOOL BUS - EARLY MORNING", "cast": [{"id": 0, "name": "CASSIUS WORTHINGTON", "names": ["CASSIUS WORTHINGTON", "CASSIUS"], "gender": "m", "first": 4, "spoke": 10}, {"id": 1, "name": "LORRAINE PEAKE", "names": ["LORRAINE PEAKE", "LORRAINE"], "gender": "?", "first": 9, "spoke": 6}, {"id": 2, "name": "WINNIE ABARA", "names": ["WINNIE ABARA", "WINNIE"], "gender": "?", "first": 19, "spoke": 7}, {"id": 3, "name": "DISPATCH", "names": ["DISPATCH"], "gender": "?", "first": 28, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. SCHOOL BUS - EARLY MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Empty seats, green vinyl, window glass fogged with breath.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The engine idles.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain runs down the glass.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CASSIUS WORTHINGTON (17, backpack, a skateboard on his lap) sits alone in the back row.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He stares at his phone.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "A text from \"Mom\": \"Don't forget your lunch.\"", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "He thumbs a reply: \"Got it.\"", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Sends.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "The bus driver, MS. LORRAINE PEAKE (60s, sweater, thermos), watches him in the rearview mirror.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "You're early.", "name": "LORRAINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Couldn't sleep.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Big day?", "name": "LORRAINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Exam.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "You study?", "name": "LORRAINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Some.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "That's the best anyone can do.", "name": "LORRAINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She pulls a lever.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "The door hisses open.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "A girl climbs aboard: WINNIE ABARA (16, braids, headphones).", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "She nods at Lorraine, then spots Cassius and slows.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Is anyone sitting here?", "name": "WINNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "No.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "She slides in across the aisle.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "He turns toward the window.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "She pulls out a notebook.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The bus lurches forward.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "The radio on Lorraine's dash crackles.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Bus forty-two, status?", "name": "DISPATCH", "speaker": 3, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "En route. Two on board.", "name": "LORRAINE", "speaker": 1, "ext": [], "paren": ["into mic"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Reminder: the Hendricks Street bridge is closed. Take Birch.", "name": "DISPATCH", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Copy.", "name": "LORRAINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Winnie leans over.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "You have the Calc exam too?", "name": "WINNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Yeah.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "I'm terrified.", "name": "WINNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Me too.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "She laughs, short and relieved.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "He grins.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "For a moment neither speaks, and the rain drums on the roof.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Do you want to quiz each other?", "name": "WINNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Sure.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "She flips her notebook open.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "He sets his skateboard on the floor.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Derivative of sine x?", "name": "WINNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Cosine x.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Integral of one over x?", "name": "WINNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Natural log of absolute x.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Okay, you studied more than \"some.\"", "name": "WINNIE", "speaker": 2, "ext": [], "paren": ["impressed"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Don't tell anyone.", "name": "CASSIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Lorraine, in the mirror, smiles.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}]}