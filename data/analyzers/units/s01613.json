{"scene_id": "s01613", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01613.fountain", "heading": "INT. CIVIL COURTHOUSE - JURY DELIBERATION ROOM - AFTERNOON", "cast": [{"id": 0, "name": "FOREWOMAN BEATRICE KOWALSKI-DAVIES", "names": ["FOREWOMAN BEATRICE KOWALSKI-DAVIES", "BEATRICE"], "gender": "f", "first": 6, "spoke": 8}, {"id": 1, "name": "JUROR THADDEUS OKAFOR", "names": ["JUROR THADDEUS OKAFOR", "THADDEUS"], "gender": "m", "first": 7, "spoke": 6}, {"id": 2, "name": "JUROR PRUDENCE LINDSTROM", "names": ["JUROR PRUDENCE LINDSTROM", "PRUDENCE"], "gender": "?", "first": 7, "spoke": 3}, {"id": 3, "name": "JUROR MARCELINO ALVARADO", "names": ["JUROR MARCELINO ALVARADO", "MARCELINO"], "gender": "m", "first": 7, "spoke": 3}, {"id": 4, "name": "OFFICER", "names": ["OFFICER"], "gender": "?", "first": 38, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. CIVIL COURTHOUSE - JURY DELIBERATION ROOM - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "A windowless room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A long laminate table, twelve chairs, a water pitcher.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A wall clock ticking too loudly.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Four jurors remain after a long lunch.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "The rest have filed out for a break.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "FOREWOMAN BEATRICE KOWALSKI-DAVIES (50s, practical blazer, reading glasses) leafs through her notes.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "JUROR THADDEUS OKAFOR (30s, hoodie, bitten nails) taps his pen on the table.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "JUROR PRUDENCE LINDSTROM (60s, floral blouse, quiet) arranges a row of peppermints in front of her.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "And JUROR MARCELINO ALVARADO (40s, work boots, a thermos of coffee) leans back in his chair, staring at the ceiling.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Let's recap where we are.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "We're nowhere.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "We're somewhere, dear.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": ["gently"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "We're exactly where we started.", "name": "MARCELINO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Beatrice sets down her notes, removes her glasses, rubs the bridge of her nose.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Thaddeus stops tapping.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Prudence unwraps a peppermint and offers it across the table.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Marcelino takes it, pops it into his mouth, and Thaddeus declines.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Beatrice puts her glasses back on and looks at each of them in turn.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "The plaintiff says the contract was breached on March third.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "The defendant says it was never signed.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "The signature looked genuine.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "It looked traced.", "name": "MARCELINO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Mr. Alvarado, you keep saying that.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "I keep seeing it.", "name": "MARCELINO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "I think she's lying. The plaintiff.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "She didn't seem like a liar.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "The good ones never do.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "We can't convict on a feeling.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "It's not a criminal case.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "We can't find liability on one either.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "The clock ticks.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Prudence folds the peppermint wrapper into a small square.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Marcelino drains his thermos.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Thaddeus resumes tapping.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "The door opens.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "A court officer leans in.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Madam Foreman, the judge wants to know if you've reached a verdict.", "name": "OFFICER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Not yet.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "How much longer?", "name": "OFFICER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Another hour.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "I'll tell her.", "name": "OFFICER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "The door closes.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Beatrice sighs, takes a fresh sheet, and writes a single word at the top.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "What did you write?", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "\"Evidence.\"", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "She underlines it twice.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Prudence nods.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Marcelino leans forward.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Thaddeus, last, sets down his pen and slides his chair closer to the table.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}]}