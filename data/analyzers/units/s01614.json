{"scene_id": "s01614", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01614.fountain", "heading": "EXT. ROOFTOP WATER TANK - SUNSET", "cast": [{"id": 0, "name": "MO", "names": ["MO"], "gender": "?", "first": 5, "spoke": 18}, {"id": 1, "name": "JOHNSON", "names": ["JOHNSON"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "GABBY", "names": ["GABBY"], "gender": "?", "first": 5, "spoke": 16}, {"id": 3, "name": "ORTEGA-NG", "names": ["ORTEGA-NG"], "gender": "?", "first": 5, "spoke": 0}, {"id": 4, "name": "SI", "names": ["SI"], "gender": "?", "first": 5, "spoke": 15}, {"id": 5, "name": "DELACROIX-ODUYA", "names": ["DELACROIX-ODUYA"], "gender": "?", "first": 5, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ROOFTOP WATER TANK - SUNSET", "present": []}, {"u": 1, "kind": "action", "text": "A battered rooftop, tar-papered and patched.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A wooden water tank on stilts casts a long shadow.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Pigeons coo.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Beyond the parapet, the city glows orange.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Three teenagers sit with their legs hanging over the edge: MALIK \"MO\" JOHNSON (17, backwards cap), GABRIELA \"GABBY\" ORTEGA-NG (16, cut-off jean jacket), and SIMON \"SI\" DELACROIX-ODUYA (17, oversized glasses, a handheld camera).", "para": 1, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 6, "kind": "dialogue", "text": "So that's it. Last summer.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 7, "kind": "dialogue", "text": "It's not the last summer.", "name": "GABBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "dialogue", "text": "It's the last summer we're all in the same city.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "You don't know that.", "name": "SI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Gabby's going to Toronto.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Maybe.", "name": "GABBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "You got the letter.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "I got a letter.", "name": "GABBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "What did it say?", "name": "SI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "It said yes.", "name": "GABBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Then it's Toronto.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "It's a maybe, Mo.", "name": "GABBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Say it again for the camera.", "name": "SI", "speaker": 4, "ext": [], "paren": ["filming"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Si, turn that off.", "name": "GABBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "It's my documentary.", "name": "SI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "It's my life.", "name": "GABBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Sorry.", "name": "SI", "speaker": 4, "ext": [], "paren": ["lowering the camera"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "You could stay.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "And do what?", "name": "GABBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Same as always.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "That's the problem.", "name": "GABBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "A long beat.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "A pigeon lands on the tank, bobs its head, flies away.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "I got into film school.", "name": "SI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "You what?", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "In L.A. I haven't told my parents.", "name": "SI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Si! That's huge!", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "It's a thousand miles away.", "name": "SI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "So is Toronto.", "name": "GABBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "So you're both leaving.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "I didn't say that.", "name": "SI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "You did.", "name": "GABBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "I said I got in.", "name": "SI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "What about me?", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "What about you?", "name": "GABBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "I'm not going anywhere.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "You could.", "name": "SI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "To where?", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Anywhere.", "name": "GABBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "I don't want anywhere. I want here.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Here is changing, Mo.", "name": "SI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "Here is fine.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "Here is a rooftop.", "name": "GABBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "It's a good rooftop.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "They laugh, thin and tired.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "The sun slides lower.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "Their shadows stretch across the tar.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "Let's film the sunset.", "name": "SI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "Then it's real.", "name": "GABBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "It's already real.", "name": "SI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "Do it.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "Si lifts the camera.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "Pans across the skyline.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "Settles on the two of them.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "Say something. For the archive.", "name": "SI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "dialogue", "text": "Hi. We were here.", "name": "GABBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "dialogue", "text": "We were here.", "name": "MO", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "The sun touches the horizon.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "The camera keeps rolling.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}