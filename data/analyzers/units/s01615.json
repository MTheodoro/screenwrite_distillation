{"scene_id": "s01615", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01615.fountain", "heading": "INT. VINEYARD TASTING ROOM - LATE AFTERNOON", "cast": [{"id": 0, "name": "CORINNE BASSETT-OYELARAN", "names": ["CORINNE BASSETT-OYELARAN", "CORINNE"], "gender": "?", "first": 5, "spoke": 8}, {"id": 1, "name": "WILL", "names": ["WILL"], "gender": "m", "first": 6, "spoke": 5}, {"id": 2, "name": "TRANH", "names": ["TRANH"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "AUGUSTE LEFEBVRE-MORROW", "names": ["AUGUSTE LEFEBVRE-MORROW", "AUGUSTE"], "gender": "?", "first": 7, "spoke": 12}], "units": [{"u": 0, "kind": "heading", "text": "INT. VINEYARD TASTING ROOM - LATE AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Rustic beams.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A long wooden bar.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Racks of bottles lit by amber bulbs.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Through the open French doors, rows of vines stretch toward the hills.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CORINNE BASSETT-OYELARAN (30s, linen dress, hair in a loose knot) swirls a glass of red and studies the color.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "At her elbow, her fianc\u00e9 WILLIAM \"WILL\" TRANH (30s, rolled sleeves, sunburned nose) pretends to sniff the bouquet.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "And behind the bar, the vintner, MR. AUGUSTE LEFEBVRE-MORROW (60s, apron, silver hair), polishes a glass.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Notes of cherry, perhaps a little leather.", "name": "AUGUSTE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "I can taste the leather.", "name": "CORINNE", "speaker": 0, "ext": [], "paren": ["lying"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "So can I.", "name": "WILL", "speaker": 1, "ext": [], "paren": ["lying"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Excellent. You have a fine palate.", "name": "AUGUSTE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Corinne sips.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Will sips.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Auguste pours a sliver of white into a third glass and slides it across.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Auguste, this is lovely.", "name": "CORINNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Please. Call me Gus.", "name": "AUGUSTE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Gus, do you ever sell your reserve?", "name": "WILL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Never.", "name": "AUGUSTE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Never?", "name": "CORINNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "My late wife made it. I open a bottle on our anniversary. That is all.", "name": "AUGUSTE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Will and Corinne exchange a look.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Will sets down his glass.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Corinne touches Auguste's wrist, gently, and he smiles, embarrassed.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "But you two are getting married, yes?", "name": "AUGUSTE", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "In September.", "name": "CORINNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Then you must have one.", "name": "AUGUSTE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "We couldn't.", "name": "WILL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "I insist.", "name": "AUGUSTE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "He ducks under the bar and returns with a dusty bottle, its label hand-lettered in faded ink.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "He wipes it with a cloth and reads aloud.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Nineteen ninety-eight. The year we met.", "name": "AUGUSTE", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Gus, this is too much.", "name": "CORINNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "It is exactly enough.", "name": "AUGUSTE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "He pops the cork.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Pours three small glasses.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Hands one to each of them.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "They raise the glasses.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "To love.", "name": "AUGUSTE", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "To love.", "name": "CORINNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "To love, and to leather.", "name": "WILL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "They laugh, clink, drink.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "The late sun slants through the doors and turns the wine to garnet.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Oh.", "name": "CORINNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "What?", "name": "WILL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "It tastes like a memory.", "name": "CORINNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "That is the secret. A good wine always does.", "name": "AUGUSTE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}