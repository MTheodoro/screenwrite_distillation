{"scene_id": "s01616", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01616.fountain", "heading": "INT. CONVENT KITCHEN - NIGHT", "cast": [{"id": 0, "name": "SISTER BENEDETTA MARCHETTI-OYO", "names": ["SISTER BENEDETTA MARCHETTI-OYO", "BENEDETTA"], "gender": "f", "first": 4, "spoke": 13}, {"id": 1, "name": "SISTER CLARISSA", "names": ["SISTER CLARISSA"], "gender": "f", "first": 5, "spoke": 0}, {"id": 2, "name": "REVEREND MOTHER AGATHA VANDERPOOL", "names": ["REVEREND MOTHER AGATHA VANDERPOOL", "AGATHA"], "gender": "?", "first": 7, "spoke": 16}], "units": [{"u": 0, "kind": "heading", "text": "INT. CONVENT KITCHEN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Whitewashed walls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A cast-iron stove, a scrubbed deal table, rows of copper pots gleaming in the lamplight.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Outside, wind moves in the cypress trees.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SISTER BENEDETTA MARCHETTI-OYO (60s, black habit, flour on her sleeves) kneads dough with slow, deliberate strokes.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across the table, a novice, SISTER CLARISSA (19, wimple slightly askew), peels potatoes into a bucket.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "And in the doorway, a figure waits.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "REVEREND MOTHER AGATHA VANDERPOOL (70s, black habit, a silver cross, a posture like a cathedral) rests a hand on the frame.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Benedetta does not look up.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Clarissa's knife pauses.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Sister Benedetta.", "name": "AGATHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Reverend Mother.", "name": "BENEDETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "You are up late.", "name": "AGATHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "The bread will not wait.", "name": "BENEDETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Nor will the visitors.", "name": "AGATHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Benedetta presses her palms into the dough.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Clarissa lowers her head and peels faster.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "They arrive at dawn. The bishop's man will want to see the accounts.", "name": "AGATHA", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "They are in order.", "name": "BENEDETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Are they?", "name": "AGATHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "They are.", "name": "BENEDETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Then you will not mind if Sister Clarissa reads them aloud.", "name": "AGATHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "The knife drops.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Clarissa stares at her hands.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Benedetta's fingers stop moving, a long beat, then resume.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Sister Clarissa has other duties.", "name": "BENEDETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "She has the best penmanship in the house.", "name": "AGATHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "She has also been awake since five.", "name": "BENEDETTA", "speaker": 0, "ext": [], "paren": ["evenly"], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Agatha steps into the room.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "The lamp throws her shadow across the table.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Clarissa shrinks.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Benedetta folds the dough over itself, once, twice, three times.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "You have been with us thirty years.", "name": "AGATHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Thirty-one.", "name": "BENEDETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "And in all that time, I have not asked you for anything.", "name": "AGATHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "You have asked me for bread.", "name": "BENEDETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Bread is not asking. Bread is feeding.", "name": "AGATHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Benedetta turns to the oven.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Opens the iron door.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "A wash of heat on her face.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "She slides in the loaf and shuts the door.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "What do you want, Mother?", "name": "BENEDETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "I want to know what is missing from the ledger.", "name": "AGATHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "The kitchen is perfectly still.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Clarissa looks up, at last, at Benedetta.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Benedetta, at Agatha.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "The wind rises in the cypress trees.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Forty-two loaves.", "name": "BENEDETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Per week?", "name": "AGATHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Per week. For thirty-one years.", "name": "BENEDETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Given to whom?", "name": "AGATHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "To those who knock at the back gate.", "name": "BENEDETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Without permission.", "name": "AGATHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Without asking.", "name": "BENEDETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "I see.", "name": "AGATHA", "speaker": 2, "ext": [], "paren": ["a long pause"], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "She lifts the silver cross from her chest and holds it for a moment, as if weighing it.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Then she lets it fall back.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "Then we will need to bake more.", "name": "AGATHA", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}]}