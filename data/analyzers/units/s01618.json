{"scene_id": "s01618", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01618.fountain", "heading": "INT. SUBMARINE BAY - COLD STORAGE - NIGHT", "cast": [{"id": 0, "name": "SENTRY", "names": ["SENTRY"], "gender": "m", "first": 4, "spoke": 5}, {"id": 1, "name": "TECHNICIAN", "names": ["TECHNICIAN"], "gender": "m", "first": 9, "spoke": 1}, {"id": 2, "name": "CONTROL", "names": ["CONTROL"], "gender": "?", "first": 20, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. SUBMARINE BAY - COLD STORAGE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Frost on steel.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of crates under a single caged bulb.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Breath hangs in the air like smoke.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A SENTRY (30s, parka, rifle slung) paces the aisle.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He stops at a crate.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Pries the lid with a gloved hand.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "Peers in.", "para": 1, "sent": 3, "present": [0]}, {"u": 8, "kind": "action", "text": "From behind a stack of pallets, a second man watches him.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "THE TECHNICIAN (40s, thin, ID badge turned inward).", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He holds a small black box in one hand, thumb hovering over a button.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "The Sentry sets down the lid.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Turns.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Looks directly at the pallets.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "The Technician holds his breath.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Hello?", "name": "SENTRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "No reply.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "The Sentry steps closer.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Sniffs.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Reaches for his radio.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Control, I have movement in cold storage.", "name": "SENTRY", "speaker": 0, "ext": ["CONT'D"], "paren": ["into radio"], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Confirm.", "name": "CONTROL", "speaker": 2, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Possible. He's behind the pallets. He's not answering.", "name": "SENTRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Hold position. Backup in two minutes.", "name": "CONTROL", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The Sentry unslings his rifle.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "The Technician presses against the crate.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "A drop of sweat freezes on his forehead.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Come out. He won't hurt you.", "name": "SENTRY", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "The Technician closes his eyes.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "His thumb tightens.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "The box clicks.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Overhead, every light in the bay goes dark.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "In the black, a scuffle: boots on steel, a grunt, a shout, a rifle butt striking something hard.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "The caged bulb swings back on.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Both men stand, five feet apart.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "The Sentry's rifle points at the Technician.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "The Technician's box points at the Sentry.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Neither lowers it.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Put it down. He's got backup coming.", "name": "SENTRY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "So does he.", "name": "TECHNICIAN", "speaker": 1, "ext": [], "paren": ["through his teeth"], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Somewhere above them, a muffled thump.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "A second.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "The ceiling trembles.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Frost sifts from the pipes.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "They look up together.", "para": 10, "sent": 0, "present": [0, 1, 2]}]}