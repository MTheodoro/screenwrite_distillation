{"scene_id": "s01619", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01619.fountain", "heading": "INT. SEASIDE BOARDING HOUSE - ATTIC - NIGHT", "cast": [{"id": 0, "name": "ODELIA PRINGLE", "names": ["ODELIA PRINGLE", "ODELIA"], "gender": "f", "first": 6, "spoke": 4}, {"id": 1, "name": "HORACE BLACKWOOD-ADE", "names": ["HORACE BLACKWOOD-ADE", "HORACE"], "gender": "?", "first": 7, "spoke": 3}, {"id": 2, "name": "MISS CONSTANCE TAMBLYN", "names": ["MISS CONSTANCE TAMBLYN", "CONSTANCE"], "gender": "?", "first": 8, "spoke": 1}, {"id": 3, "name": "FERDINAND OKORO-STRAND", "names": ["FERDINAND OKORO-STRAND", "FERDINAND"], "gender": "?", "first": 9, "spoke": 2}, {"id": 4, "name": "THOMAS", "names": ["THOMAS"], "gender": "m", "first": 9, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. SEASIDE BOARDING HOUSE - ATTIC - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Slanted beams.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A cracked skylight.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Moonlight on trunks, hatboxes, a headless dressmaker's dummy.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The air smells of salt and mildew.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Five guests have climbed the narrow stair with lanterns.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "MRS. ODELIA PRINGLE (60s, shawl, a ring of keys) leads.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "DR. HORACE BLACKWOOD-ADE (50s, black bag, bowler hat) follows.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Then MISS CONSTANCE TAMBLYN (20s, nightgown under a coat), clutching a candle.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Behind her, MR. FERDINAND OKORO-STRAND (40s, braces, a revolver he clearly does not know how to hold), and last, young THOMAS (12, nightshirt, wide-eyed, a tin whistle).", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Stay close. The floor is rotten in places.", "name": "ODELIA", "speaker": 0, "ext": [], "paren": ["to the group"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Mrs. Pringle, what precisely are we looking for?", "name": "HORACE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "The thing that has been tapping.", "name": "ODELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "It tapped again last night.", "name": "CONSTANCE", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Nerves. Nothing but nerves.", "name": "FERDINAND", "speaker": 3, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "It's not nerves.", "name": "THOMAS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Quiet, boy.", "name": "ODELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "A single tap from behind the dummy.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Everyone freezes.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Constance's candle trembles.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Ferdinand raises the revolver, then lowers it, then raises it again.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "A second tap.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "A third.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "A scrape, as of fingernails on wood.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Who is there?", "name": "HORACE", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "The dummy topples.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Dust billows.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "A dark shape lunges across the trunks.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Constance screams.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Ferdinand fires wildly, the shot punching a hole in the skylight.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Horace dives behind a hatbox.", "para": 5, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Odelia swings her lantern.", "para": 5, "sent": 6, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Thomas blows a shrill note on his whistle.", "para": 5, "sent": 7, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "The shape hisses, springs up through the broken glass, and disappears into the night.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Glass tinkles.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Moonlight pours through the new hole.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "The five of them stand panting among the trunks, one by one lowering their lanterns.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "It was a gull.", "name": "THOMAS", "speaker": 4, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "A gull.", "name": "FERDINAND", "speaker": 3, "ext": [], "paren": ["shakily"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "A very large gull.", "name": "HORACE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Odelia lifts the dummy upright with one hand and straightens its collar.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Back to bed, all of you.", "name": "ODELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "She turns.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "One by one they file down the stairs.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Thomas is last.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "He pauses at the top, tin whistle in hand, and looks back at the skylight.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Something taps.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Once.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}]}