{"scene_id": "s01620", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01620.fountain", "heading": "INT. LIGHTHOUSE LENS ROOM - NIGHT (1887)", "cast": [{"id": 0, "name": "HOLLIS BRANT", "names": ["HOLLIS BRANT", "HOLLIS"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "SILAS", "names": ["SILAS"], "gender": "m", "first": 7, "spoke": 3}, {"id": 2, "name": "INSPECTOR AGNES FAIRWEATHER", "names": ["INSPECTOR AGNES FAIRWEATHER", "AGNES"], "gender": "?", "first": 34, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. LIGHTHOUSE LENS ROOM - NIGHT (1887)", "present": []}, {"u": 1, "kind": "action", "text": "Brass.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Prisms.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A hundred glass faces catching one flame.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "HOLLIS BRANT, 60s, salt-stiff beard, oils the turning gear.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Slow.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Careful.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "SILAS, 15, his apprentice, polishes a prism with a rag.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Too fast.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Gently, boy.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Yes, sir.", "name": "SILAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Wind howls.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "The tower groans.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "A crack.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Sharp.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Glass.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Silas freezes.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "A hairline fracture crawls across the prism.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Don't breathe.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "It was already -- I swear it --", "name": "SILAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Hollis crosses.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Fast for his age.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Grips Silas's wrist.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "How long have you known?", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Since Tuesday.", "name": "SILAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Hollis lifts the prism.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Turns it to the flame.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "The crack is a bright wire.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Tuesday.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Silence.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "The great lens turns.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Light sweeps the sea.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "The door bangs open.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Rain blows in.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "INSPECTOR AGNES FAIRWEATHER, 40s, black oilskin, ledger under one arm, stands dripping on the threshold.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Evening, Mr. Brant. The Board sent me to check your lens.", "name": "AGNES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Beat.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Hollis sets the prism down on the cracked side.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Hides it with his sleeve.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Flawless, Inspector.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Agnes studies the prism.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Studies Silas.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Studies Hollis.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "She sets down her ledger.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Closes the door against the storm.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Then you will not mind if I hold it.", "name": "AGNES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Hollis exhales.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Slow.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Mind? Madam, I would be honoured.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "He hands her the prism.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Cracked side down.", "para": 15, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "She turns it over.", "para": 16, "sent": 0, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Looks.", "para": 16, "sent": 1, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Looks longer.", "para": 16, "sent": 2, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "Mm.", "name": "AGNES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "She wraps it in her scarf.", "para": 17, "sent": 0, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "I'll say it caught the weather. Happens every winter.", "name": "AGNES", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Silas sits down hard on an oil drum.", "para": 18, "sent": 0, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "Light the second flame, Mr. Brant. The fog is coming in.", "name": "AGNES", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}]}