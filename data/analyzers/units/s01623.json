{"scene_id": "s01623", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01623.fountain", "heading": "INT. FINCH & PUMPHREY TAXIDERMY SHOP - DAY", "cast": [{"id": 0, "name": "GLORIA FINCH", "names": ["GLORIA FINCH", "GLORIA"], "gender": "?", "first": 4, "spoke": 9}, {"id": 1, "name": "WALTER PUMPHREY", "names": ["WALTER PUMPHREY", "WALTER"], "gender": "?", "first": 5, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. FINCH & PUMPHREY TAXIDERMY SHOP - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Glass eyes everywhere.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A moth-eaten badger on a pedestal.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A stuffed owl in a bowler hat.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "GLORIA FINCH, 40s, sharp as a tack in a sharper suit, stands on a stepladder, hammering a mounted trout to the wall.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "WALTER PUMPHREY, 50s, rumpled, hat in both hands, bursts through the door.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Gloria! The fire inspector is outside!", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Good. Tell him we're closed.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": ["not turning"], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "He saw the smoke!", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "There is no smoke. There is a very warm badger.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She hammers.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He wrings his hat.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She hammers harder.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Gloria, you put a lit cigar in its mouth!", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "To keep it from looking surprised.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "He snatches the badger.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "It's smoking.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He bats at it with his hat.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Smoke curls from the badger's ears.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Put it out!", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "I can't, I'm busy with the trout.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "He dumps a bucket of paint water on the badger.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "It sags.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She climbs down, sniffs, turns slowly, and lets him have a look.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "That was my best badger.", "name": "GLORIA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "He was a fire hazard!", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "She picks up the owl.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Plops it on his head.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Well, put this on. You're the one who has to face the inspector.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Why me?", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "He asked for the owner.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "You own half!", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "And you are the half with the hat.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "The door chimes.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "They both freeze.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "She straightens his bowler.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "He straightens the owl.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "How do I look?", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Like you've been stuffed for years.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "The door swings open.", "para": 8, "sent": 0, "present": [0, 1]}]}