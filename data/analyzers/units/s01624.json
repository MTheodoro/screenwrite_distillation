{"scene_id": "s01624", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01624.fountain", "heading": "INT. FAIRLANES BOWLING ALLEY - PINSETTER ROOM - NIGHT", "cast": [{"id": 0, "name": "SHORTY ALVARADO", "names": ["SHORTY ALVARADO", "SHORTY"], "gender": "m", "first": 5, "spoke": 27}, {"id": 1, "name": "TANYA BOSCO", "names": ["TANYA BOSCO", "TANYA"], "gender": "?", "first": 8, "spoke": 27}], "units": [{"u": 0, "kind": "heading", "text": "INT. FAIRLANES BOWLING ALLEY - PINSETTER ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Behind the lanes.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A long steel cavern of dead machines, each one frozen mid-cycle.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dust.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The smell of oil and old wax.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SHORTY ALVARADO, 50s, wide, slow, in a faded satin bowling jacket, sits on an upturned crate.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A duffel bag between his boots.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Footsteps on the metal catwalk.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "TANYA BOSCO, 30s, leather jacket, no smile, walks the length of the room.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "A flashlight in her hand, not lit.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "You're late, Tanya.", "name": "SHORTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Traffic.", "name": "TANYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "At two in the morning.", "name": "SHORTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "There's always traffic, Shorty.", "name": "TANYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She stops ten feet away.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Looks at the duffel.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "That it?", "name": "TANYA", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "That's it.", "name": "SHORTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Open it.", "name": "TANYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "You open it.", "name": "SHORTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "It's your bag.", "name": "TANYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "It's your problem.", "name": "SHORTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "A long beat.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Somewhere, a pipe drips.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Tanya crosses.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Crouches.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Unzips the duffel.", "para": 5, "sent": 4, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Stacks of bills, rubber-banded.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "She picks one up.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Fans it.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Looks up.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "It's short.", "name": "TANYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "It's what Dominic gave me.", "name": "SHORTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Dominic gave you forty. This is thirty-one.", "name": "TANYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Then Dominic's counting differently than he used to.", "name": "SHORTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Or you are.", "name": "TANYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Careful.", "name": "SHORTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "I'm always careful. That's why I'm still alive.", "name": "TANYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Shorty smiles, without warmth.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "You know why they call me Shorty?", "name": "SHORTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Because you're not.", "name": "TANYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Because I was always short on patience.", "name": "SHORTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "He stands.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "The crate scrapes.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "Tanya doesn't rise.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "She keeps the money in her hand.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Sit down, Shorty.", "name": "TANYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "No.", "name": "SHORTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Sit down.", "name": "TANYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "You think I took nine thousand?", "name": "SHORTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "I think someone did.", "name": "TANYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Then count it again. Slowly. Like your mother taught you.", "name": "SHORTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Leave my mother out of it.", "name": "TANYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "She'd say the same thing. She'd say, Tanya, count again.", "name": "SHORTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "Tanya's jaw sets.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "You knew my mother?", "name": "TANYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "Everybody knew your mother. She bowled a 280 in this very building.", "name": "SHORTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "She bowled a 279.", "name": "TANYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "She told me 280.", "name": "SHORTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "She lied to you.", "name": "TANYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "Maybe she did. Maybe that's what she did to everyone.", "name": "SHORTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "Tanya rises.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "The flashlight clicks on.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "She shines it right into his eyes.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "Where is the nine, Shorty?", "name": "TANYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "Turn that off.", "name": "SHORTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "Where is it?", "name": "TANYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "Turn it off!", "name": "SHORTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "She doesn't.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "He swings the duffel.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 70, "kind": "action", "text": "It catches her across the shoulder.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "She stumbles.", "para": 11, "sent": 3, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "The flashlight clatters, spinning light across the machines.", "para": 11, "sent": 4, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "He goes for her.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 74, "kind": "action", "text": "She meets him.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 75, "kind": "action", "text": "They crash into a pinsetter.", "para": 12, "sent": 2, "present": [0, 1]}, {"u": 76, "kind": "action", "text": "A hundred pins rattle in their tubes like startled bones.", "para": 12, "sent": 3, "present": [0, 1]}, {"u": 77, "kind": "dialogue", "text": "You think Dominic's your friend?", "name": "SHORTY", "speaker": 0, "ext": ["CONT'D"], "paren": ["strangled"], "dual": false, "present": [0, 1]}, {"u": 78, "kind": "dialogue", "text": "I think he's my boss!", "name": "TANYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 79, "kind": "dialogue", "text": "He's a liar!", "name": "SHORTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 80, "kind": "dialogue", "text": "So are you!", "name": "TANYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 81, "kind": "action", "text": "She twists, drives an elbow into his ribs.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 82, "kind": "action", "text": "He folds.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 83, "kind": "action", "text": "She pins him against the machine, forearm across his throat.", "para": 13, "sent": 2, "present": [0, 1]}, {"u": 84, "kind": "action", "text": "Pins spill.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 85, "kind": "action", "text": "They roll across the floor.", "para": 14, "sent": 1, "present": [0, 1]}, {"u": 86, "kind": "action", "text": "One strikes the dead flashlight and stops.", "para": 14, "sent": 2, "present": [0, 1]}, {"u": 87, "kind": "dialogue", "text": "Nine thousand. Where.", "name": "TANYA", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 88, "kind": "action", "text": "Shorty's eyes flick to the next machine.", "para": 15, "sent": 0, "present": [0, 1]}, {"u": 89, "kind": "action", "text": "To a panel, slightly ajar.", "para": 15, "sent": 1, "present": [0, 1]}, {"u": 90, "kind": "action", "text": "She sees it.", "para": 16, "sent": 0, "present": [0, 1]}, {"u": 91, "kind": "action", "text": "Lets him go.", "para": 16, "sent": 1, "present": [0, 1]}, {"u": 92, "kind": "action", "text": "He slides down the metal, wheezing.", "para": 16, "sent": 2, "present": [0, 1]}, {"u": 93, "kind": "dialogue", "text": "You were always sharp. Your mother was too.", "name": "SHORTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 94, "kind": "action", "text": "Tanya opens the panel.", "para": 17, "sent": 0, "present": [0, 1]}, {"u": 95, "kind": "action", "text": "Inside: a gym bag.", "para": 17, "sent": 1, "present": [0, 1]}, {"u": 96, "kind": "action", "text": "She unzips it.", "para": 17, "sent": 2, "present": [0, 1]}, {"u": 97, "kind": "action", "text": "Money.", "para": 17, "sent": 3, "present": [0, 1]}, {"u": 98, "kind": "action", "text": "Lots of it.", "para": 17, "sent": 4, "present": [0, 1]}, {"u": 99, "kind": "dialogue", "text": "This isn't nine.", "name": "TANYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 100, "kind": "dialogue", "text": "No.", "name": "SHORTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 101, "kind": "dialogue", "text": "This is all of it.", "name": "TANYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 102, "kind": "dialogue", "text": "All of Dominic's.", "name": "SHORTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 103, "kind": "action", "text": "She turns slowly, bag in hand.", "para": 18, "sent": 0, "present": [0, 1]}, {"u": 104, "kind": "dialogue", "text": "Shorty.", "name": "TANYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 105, "kind": "dialogue", "text": "Tanya.", "name": "SHORTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 106, "kind": "dialogue", "text": "What did you do?", "name": "TANYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 107, "kind": "action", "text": "Shorty reaches inside his satin jacket.", "para": 19, "sent": 0, "present": [0, 1]}, {"u": 108, "kind": "action", "text": "Slowly.", "para": 19, "sent": 1, "present": [0, 1]}, {"u": 109, "kind": "action", "text": "Tanya freezes.", "para": 19, "sent": 2, "present": [0, 1]}, {"u": 110, "kind": "action", "text": "He pulls out a small black phone, holds it up.", "para": 19, "sent": 3, "present": [0, 1]}, {"u": 111, "kind": "dialogue", "text": "I called him an hour ago.", "name": "SHORTY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 112, "kind": "action", "text": "Far off, a car door.", "para": 20, "sent": 0, "present": [0, 1]}, {"u": 113, "kind": "action", "text": "Another.", "para": 20, "sent": 1, "present": [0, 1]}, {"u": 114, "kind": "action", "text": "Heavy steps on the lane boards beyond the wall.", "para": 20, "sent": 2, "present": [0, 1]}, {"u": 115, "kind": "action", "text": "Tanya drops the bag.", "para": 21, "sent": 0, "present": [0, 1]}, {"u": 116, "kind": "dialogue", "text": "You rat.", "name": "TANYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 117, "kind": "dialogue", "text": "Short on patience, remember?", "name": "SHORTY", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1]}, {"u": 118, "kind": "action", "text": "The door to the pinsetter room crashes open.", "para": 22, "sent": 0, "present": [0, 1]}]}