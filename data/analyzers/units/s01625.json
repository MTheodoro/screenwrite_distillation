{"scene_id": "s01625", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01625.fountain", "heading": "INT. CHURCH BELL TOWER, GHOST TOWN - DAWN", "cast": [{"id": 0, "name": "JEB TALLMAN", "names": ["JEB TALLMAN", "JEB"], "gender": "?", "first": 4, "spoke": 3}, {"id": 1, "name": "CORA LEE PRUETT", "names": ["CORA LEE PRUETT", "CORA LEE"], "gender": "?", "first": 4, "spoke": 2}, {"id": 2, "name": "PIKE", "names": ["PIKE"], "gender": "m", "first": 4, "spoke": 3}, {"id": 3, "name": "DOC AMBROSE", "names": ["DOC AMBROSE"], "gender": "?", "first": 4, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. CHURCH BELL TOWER, GHOST TOWN - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Dust in slanting light.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A rope hangs slack.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Four people share a space built for one.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "JEB TALLMAN, 50s, bandaged ribs, sits against the wall with a Colt on his knee, while CORA LEE PRUETT, 30s, in a torn calico dress, peels back his shirt to check the wound, and PIKE, 20s, cheeks smeared with soot, keeps watch at the slit window, and DOC AMBROSE, 60s, spectacles cracked, tips the last of his flask over Jeb's side.", "para": 1, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 5, "kind": "dialogue", "text": "It's quiet, Pike.", "name": "JEB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "dialogue", "text": "Quiet's worse, Jeb.", "name": "PIKE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Quiet means they ran out of whiskey. Or men.", "name": "CORA LEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Or patience, Miss Cora Lee.", "name": "DOC AMBROSE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "They've got plenty of that. Always did.", "name": "JEB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Doc, how long till he can ride?", "name": "PIKE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Days. Weeks, if he's sensible.", "name": "DOC AMBROSE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "I'm never sensible.", "name": "JEB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "That's why you're here, Jeb Tallman.", "name": "CORA LEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Jeb smiles.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Lets the Colt slide off his knee.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Pike turns from the window, rifle loose in his hand.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "They're gone.", "name": "PIKE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}