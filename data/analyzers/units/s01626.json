{"scene_id": "s01626", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01626.fountain", "heading": "INT. PLANETARIUM DOME - NIGHT", "cast": [{"id": 0, "name": "IMOGEN DRAKE", "names": ["IMOGEN DRAKE", "IMOGEN"], "gender": "?", "first": 3, "spoke": 8}, {"id": 1, "name": "PRIYA NAIR", "names": ["PRIYA NAIR", "PRIYA"], "gender": "f", "first": 4, "spoke": 7}, {"id": 2, "name": "BARNABY", "names": ["BARNABY"], "gender": "m", "first": 5, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. PLANETARIUM DOME - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Stars wheel across the ceiling.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Below, a circle of reclining seats, all empty but three.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "IMOGEN DRAKE, 30s, in a museum guard's uniform two sizes too big, lies back in a seat with a flashlight pen.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "PRIYA NAIR, 30s, in a black turtleneck, crouches at the projector pit, wires in her teeth.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "BARNABY, 60s, the real guard, snores in the front row, hat over his face.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Is he asleep?", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Define asleep.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Eyes closed. Mouth open. Making that noise.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Then yes. The noise is a good sign.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "And she's sure it's behind the Orion slide?", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "She's sure. She says it's in the Betelgeuse mount. Or maybe the Rigel.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Which?", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "She says it's the red one.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "They're both red.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Then check both.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Priya, she told us the diamond was hidden in a star. Not behind one. In one.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Then she's been lying since March.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "She'd hate that you said it.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "She'd hate that you whispered it. She hates whispers.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Barnaby snorts.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Both women freeze.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "A long beat.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "He settles.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Rewind the sky.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Priya flips a switch.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The stars slide backward.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "A tiny red light blinks inside the projector.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Priya laughs, silent, delighted.", "para": 5, "sent": 3, "present": [0, 1, 2]}]}