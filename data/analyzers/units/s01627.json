{"scene_id": "s01627", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01627.fountain", "heading": "INT. NIGHT LAUNDROMAT - 3 A.M.", "cast": [{"id": 0, "name": "NADIA REYES", "names": ["NADIA REYES", "NADIA"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 7, "spoke": 6}, {"id": 2, "name": "GUS", "names": ["GUS"], "gender": "?", "first": 12, "spoke": 5}, {"id": 3, "name": "OSKAR", "names": ["OSKAR"], "gender": "m", "first": 25, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT LAUNDROMAT - 3 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent hum.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dryers turning.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain on the glass.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "NADIA REYES, 30s, folds a hospital scrub top with exact corners.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Alone.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "The bell above the door chimes.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "A STRANGER, 40s, wet raincoat, enters.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Sits two machines away.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Stares.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "We close at four.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I know.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "GUS, 60s, the attendant, leans out from the back office, mop in hand.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Everything okay out here?", "name": "GUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Fine, Gus.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Gus. Right.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Do I know you?", "name": "GUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "You know her.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Nadia stops folding.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I don't know you.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "You knew my brother.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Hey, pal --", "name": "GUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Which brother?", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "The one in the chart. Room 412.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Hey, pal, you're done. Out.", "name": "GUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Oskar. His name was Oskar. Say it.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Nadia sets the scrub top down.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Her hands shake.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Oskar --", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Not him. Me. I'm Oskar. He was Anton.", "name": "OSKAR", "speaker": 3, "ext": [], "paren": ["Stranger, now standing"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Nadia, back away from --", "name": "GUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "She signed the form, Gus.", "name": "OSKAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Gus raises the mop.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Oskar pulls a folded paper from his coat.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Slaps it onto the machine.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Every dryer stops spinning.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Silence.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}]}