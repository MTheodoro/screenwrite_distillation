{"scene_id": "s01628", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01628.fountain", "heading": "INT. CABLE-REPAIR SHIP, FREEZER HOLD - NIGHT", "cast": [{"id": 0, "name": "MAEVE KOSTELNY", "names": ["MAEVE KOSTELNY", "MAEVE"], "gender": "?", "first": 4, "spoke": 10}, {"id": 1, "name": "HARLAN GREER", "names": ["HARLAN GREER", "HARLAN"], "gender": "?", "first": 6, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. CABLE-REPAIR SHIP, FREEZER HOLD - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Rime on steel.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A string of work lights swinging.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Crates stacked to the ceiling, each stamped with a number.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MAEVE KOSTELNY, 30s, parka, ship's cook, drags a crate lid back.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Breath fogs.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "HARLAN GREER, 50s, bosun, stands in the hatch, one hand on the door.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Anyone down here?", "name": "MAEVE", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Nothing.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "A crate shifts, creaks.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Get out of there.", "name": "HARLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "It's counting itself, Harlan.", "name": "MAEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "What?", "name": "HARLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "The crates. There's one more than the manifest. There's always one more.", "name": "MAEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Maeve.", "name": "HARLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Thirty-one. Thirty-two. Thirty-three.", "name": "MAEVE", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Don't look at it. Don't look at it.", "name": "HARLAN", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "I'm not looking.", "name": "MAEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "You're looking.", "name": "HARLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Then so are you.", "name": "MAEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "I'm looking at you.", "name": "HARLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Then who's behind me?", "name": "MAEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "The work lights stop swinging.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Both stare at the same spot.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "All hands up top. All hands up top.", "name": "HARLAN", "speaker": 1, "ext": [], "paren": ["to everyone, to no one"], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "They can't hear you.", "name": "MAEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "They never could.", "name": "HARLAN", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Thirty-four.", "name": "MAEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "The door slams.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Locks.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Harlan hammers it.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Open it! Open it!", "name": "HARLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Thirty-five.", "name": "MAEVE", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "She turns, and a crate lid lifts on its own.", "para": 6, "sent": 0, "present": [0, 1]}]}