{"scene_id": "s01629", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01629.fountain", "heading": "INT. TELEGRAPH OFFICE, DUSTY JUNCTION - DAY", "cast": [{"id": 0, "name": "MARSHAL ISADORA CRANE", "names": ["MARSHAL ISADORA CRANE", "CRANE"], "gender": "f", "first": 5, "spoke": 5}, {"id": 1, "name": "NELL FENTON", "names": ["NELL FENTON", "NELL"], "gender": "?", "first": 6, "spoke": 4}, {"id": 2, "name": "OTTO BRAND", "names": ["OTTO BRAND", "OTTO"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "LUPE ARRIAGA", "names": ["LUPE ARRIAGA", "LUPE"], "gender": "?", "first": 6, "spoke": 2}, {"id": 4, "name": "TOMMY", "names": ["TOMMY"], "gender": "?", "first": 14, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. TELEGRAPH OFFICE, DUSTY JUNCTION - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Shuttered windows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Heat.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A dull roar of hooves somewhere beyond the wall.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A telegraph key clatters on its own.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MARSHAL ISADORA CRANE, 40s, grey duster, stands at the window, peering through a slat.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "NELL FENTON, 20s, the operator, taps the key with a pencil while OTTO BRAND, 60s, the stationmaster, stacks flour sacks against the door and LUPE ARRIAGA, 30s, a drover, holds a shotgun and checks the roof beams for cracks.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "Nobody speaks until the floor starts to shake.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Nell. What does the line say?", "name": "CRANE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "It says \"hold.\" Over and over.", "name": "NELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Hold what?", "name": "OTTO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Hold fast, hold the line, hold your fire. It doesn't say.", "name": "NELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Who sent it?", "name": "LUPE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Miles West. Eight miles up.", "name": "NELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "They're coming through! Don't let 'em split the herd!", "name": "TOMMY", "speaker": 4, "ext": ["O.S."], "paren": ["faint, through the wall"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "That's Tommy.", "name": "CRANE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Tommy's dead. We buried him Tuesday.", "name": "LUPE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Then someone sounds like him.", "name": "CRANE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "The shaking grows.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Dust sifts from the ceiling.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Otto stops stacking.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Lupe lifts the shotgun.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Nell grips the key.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Crane lets the slat fall shut and draws her revolver, and the five of them stand there as the roar rises to a wall of sound.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Nobody fires till I do.", "name": "CRANE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "The roar passes.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Slowly it fades.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Well.", "name": "OTTO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "It says \"all clear.\"", "name": "NELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "That's a first.", "name": "CRANE", "speaker": 0, "ext": [], "paren": ["dry"], "dual": false, "present": [0, 1, 2, 3, 4]}]}