{"scene_id": "s01630", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01630.fountain", "heading": "INT. WEATHER STATION, PACIFIC ATOLL - DAY", "cast": [{"id": 0, "name": "PETTY OFFICER ANSELM BOUCHARD", "names": ["PETTY OFFICER ANSELM BOUCHARD", "BOUCHARD"], "gender": "?", "first": 5, "spoke": 8}, {"id": 1, "name": "FENWICK", "names": ["FENWICK"], "gender": "?", "first": 10, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. WEATHER STATION, PACIFIC ATOLL - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A cinderblock hut.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Louvered windows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Barometers, a wall of dials, a hand-cranked radio on a rough table.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Heat shimmers outside.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "PETTY OFFICER ANSELM BOUCHARD, 30s, sunburnt, shirtless under a rain slicker, logs numbers in a ledger.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "dialogue", "text": "Seven-oh-three. Seven-oh-two. Seven-oh-three.", "name": "BOUCHARD", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0]}, {"u": 7, "kind": "action", "text": "He taps the barometer.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "It does not move.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "The radio crackles.", "para": 3, "sent": 0, "present": [0]}, {"u": 10, "kind": "dialogue", "text": "Atoll Three, Atoll Three, this is Fleet Weather. Do you copy?", "name": "FENWICK", "speaker": 1, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Bouchard picks up the handset.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Takes his time.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Fleet Weather, Atoll Three. I copy.", "name": "BOUCHARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Anselm, is that you?", "name": "FENWICK", "speaker": 1, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "It's the only voice out here, Fenwick.", "name": "BOUCHARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Give me the numbers.", "name": "FENWICK", "speaker": 1, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Seven-oh-three and steady. Wind variable, light. Seas calm. Nothing on the horizon.", "name": "BOUCHARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Nothing at all?", "name": "FENWICK", "speaker": 1, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "A seabird. Maybe two.", "name": "BOUCHARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Understood. Hold position.", "name": "FENWICK", "speaker": 1, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "We've held it eleven weeks.", "name": "BOUCHARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Then you're good at it. Out.", "name": "FENWICK", "speaker": 1, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "The radio clicks dead.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Bouchard sets the handset in its cradle.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Gentlemen, the war continues without us.", "name": "BOUCHARD", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "No one answers.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "The room has no gentlemen.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "He goes back to the ledger.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Writes: no change.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Leans back.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Closes his eyes.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Tomorrow, I swear, I'll paint the wall.", "name": "BOUCHARD", "speaker": 0, "ext": ["CONT'D"], "paren": ["to himself"], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Outside, a seabird calls.", "para": 8, "sent": 0, "present": [0, 1]}]}