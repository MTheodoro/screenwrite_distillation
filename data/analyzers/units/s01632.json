{"scene_id": "s01632", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01632.fountain", "heading": "INT. SS HESPERIA, MAIL SORTING ROOM - NIGHT (1912)", "cast": [{"id": 0, "name": "PURSER EZEKIEL TRAVERS", "names": ["PURSER EZEKIEL TRAVERS", "TRAVERS"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "MINNIE ABARA", "names": ["MINNIE ABARA", "MINNIE"], "gender": "f", "first": 5, "spoke": 5}, {"id": 2, "name": "FOSTER", "names": ["FOSTER"], "gender": "?", "first": 6, "spoke": 4}, {"id": 3, "name": "QUINCEY", "names": ["QUINCEY"], "gender": "m", "first": 7, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. SS HESPERIA, MAIL SORTING ROOM - NIGHT (1912)", "present": []}, {"u": 1, "kind": "action", "text": "A low steel room lined with pigeonholes, lit by green-shaded lamps.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The ship rolls gently.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Letters slide across tables.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "PURSER EZEKIEL TRAVERS, 50s, sleeve garters, sorts a bundle by hand.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across from him, MINNIE ABARA, 20s, a clerk with ink on her cuff, stamps envelopes in a steady rhythm.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "At a third table, FOSTER, 30s, in a brown wool suit, files telegrams.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "And at the back, QUINCEY, a boy of 12, sweeps the floor with a broom taller than he is.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Gentlemen, ladies, we dock Thursday. I'd like the mail from Queenstown done by then.", "name": "TRAVERS", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "It will be, sir.", "name": "FOSTER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Dublin, Dublin, Cork. Dublin.", "name": "MINNIE", "speaker": 1, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Miss Abara, how many left?", "name": "TRAVERS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Four hundred and twelve, sir.", "name": "MINNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "That's a fair number.", "name": "TRAVERS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "It's a fair ship, sir.", "name": "MINNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Travers smiles at that.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Returns to his sorting.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Four hundred and eleven.", "name": "QUINCEY", "speaker": 3, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Quincey, what are you counting?", "name": "MINNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "You dropped one, miss.", "name": "QUINCEY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "He holds up a postcard.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Minnie takes it, reads, and tucks it carefully in a pigeonhole.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Good eyes, lad.", "name": "FOSTER", "speaker": 2, "ext": [], "paren": ["to Quincey"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Thank you, sir.", "name": "QUINCEY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Better than mine.", "name": "FOSTER", "speaker": 2, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Tea, anyone?", "name": "TRAVERS", "speaker": 0, "ext": [], "paren": ["to everyone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Yes, please, sir.", "name": "MINNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "No, thank you.", "name": "FOSTER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Is there milk?", "name": "QUINCEY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "There's always milk, Quincey. It's the one thing the sea doesn't take.", "name": "TRAVERS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "He sets down the bundle.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Rises.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Crosses to the kettle.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "The ship rolls.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "The lamps swing.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Nobody notices.", "para": 5, "sent": 5, "present": [0, 1, 2, 3]}]}