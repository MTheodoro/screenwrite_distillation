{"scene_id": "s01633", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01633.fountain", "heading": "EXT. SALT FLAT STAGE STOP - NOON", "cast": [{"id": 0, "name": "HATTIE MORROW", "names": ["HATTIE MORROW", "HATTIE"], "gender": "?", "first": 5, "spoke": 3}, {"id": 1, "name": "BRODIE", "names": ["BRODIE"], "gender": "m", "first": 6, "spoke": 2}, {"id": 2, "name": "LAZARO", "names": ["LAZARO"], "gender": "?", "first": 7, "spoke": 2}, {"id": 3, "name": "SNOW", "names": ["SNOW"], "gender": "?", "first": 8, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SALT FLAT STAGE STOP - NOON", "present": []}, {"u": 1, "kind": "action", "text": "White to the horizon.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Heat bending the air.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A lone shack.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A dead coach.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "HATTIE MORROW, 40s, hat low, holds a rifle.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "BRODIE, 30s, a hired gun, has a revolver pointed at her.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "LAZARO, 20s, the driver, crouches by a wheel.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "SNOW, an old white-whiskered prospector, watches from the shack's shade.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "You won't shoot a woman in the back.", "name": "HATTIE", "speaker": 0, "ext": [], "paren": ["to Brodie"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "You're facing me.", "name": "BRODIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Then you won't shoot a woman in the front.", "name": "HATTIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "A pause.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "The wind.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Please. Nobody has to die today.", "name": "LAZARO", "speaker": 2, "ext": [], "paren": ["to everyone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Everybody has to die someday.", "name": "SNOW", "speaker": 3, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Shut up, old man.", "name": "BRODIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Brodie's eyes flick to Snow.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Hattie's rifle snaps up.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "A shot rings.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Brodie spins, drops his revolver, grabs his shoulder.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Smoke drifts across the flats.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Get the water.", "name": "HATTIE", "speaker": 0, "ext": [], "paren": ["to Lazaro"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Yes, ma'am.", "name": "LAZARO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Told you.", "name": "SNOW", "speaker": 3, "ext": [], "paren": ["to Brodie, gently"], "dual": false, "present": [0, 1, 2, 3]}]}