{"scene_id": "s01634", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01634.fountain", "heading": "INT. ORBITAL SEED VAULT - HOLD C - CONTINUOUS", "cast": [{"id": 0, "name": "KAZIMIR", "names": ["KAZIMIR"], "gender": "?", "first": 4, "spoke": 10}, {"id": 1, "name": "TOLLIVER", "names": ["TOLLIVER"], "gender": "?", "first": 6, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. ORBITAL SEED VAULT - HOLD C - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "A cold, white corridor of sealed drawers, each labeled in a script that has gone out of use.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Frost on the rails.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A low hum of cooling pumps.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "KAZIMIR, 50s, in a pressure suit with the helmet off, pushes a cart slowly down the aisle.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "His breath clouds.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "TOLLIVER, 40s, also in a suit, strides ahead with a tablet.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He stops at a drawer.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Frowns.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "This one is warm.", "name": "TOLLIVER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Warm?", "name": "KAZIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Eleven degrees above spec.", "name": "TOLLIVER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "It's the cooling pump. I told them in March.", "name": "KAZIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "He told us in March. We told Command.", "name": "TOLLIVER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Command said what?", "name": "KAZIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "That it was within tolerance.", "name": "TOLLIVER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Kazimir sighs.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Parks the cart.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Opens the drawer.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Frost curls out.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Inside, hundreds of tiny glass vials, row on row.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Some are dark.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Some are faintly green.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "How many have turned?", "name": "KAZIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Sixty. Maybe seventy.", "name": "TOLLIVER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Out of how many?", "name": "KAZIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Eleven thousand.", "name": "TOLLIVER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Kazimir lifts one vial.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Holds it to the light.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "A single green seed curls inside, soft and alive.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Still breathing.", "name": "KAZIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Is it?", "name": "TOLLIVER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Look at it. It's trying.", "name": "KAZIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Tolliver sets down the tablet.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Takes the vial.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Cups it in both gloved hands.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "For a long time he says nothing.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "When I was young, he told me nothing in a vault ever grows.", "name": "TOLLIVER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "He was wrong.", "name": "KAZIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "He was often wrong.", "name": "TOLLIVER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Kazimir takes the vial back.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Places it in a tray labeled RESCUE.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Closes the drawer.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "We start with this one. We fix the pump. We save sixty.", "name": "KAZIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "And the rest?", "name": "TOLLIVER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "We tell them it was within tolerance.", "name": "KAZIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Both laugh, softly.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "The cooling pumps hum.", "para": 8, "sent": 1, "present": [0, 1]}]}