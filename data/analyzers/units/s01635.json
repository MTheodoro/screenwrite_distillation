{"scene_id": "s01635", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01635.fountain", "heading": "INT. FIELD HOSPITAL, CONVERTED OPERA HOUSE - NIGHT", "cast": [{"id": 0, "name": "MARISOL VEGA", "names": ["MARISOL VEGA", "DR. VEGA"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "NURSE OLUWASEUN", "names": ["NURSE OLUWASEUN"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "ARCHIBALD", "names": ["ARCHIBALD"], "gender": "?", "first": 5, "spoke": 0}, {"id": 3, "name": "SEUN", "names": ["SEUN"], "gender": "?", "first": 5, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. FIELD HOSPITAL, CONVERTED OPERA HOUSE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Gilt cherubs watch over a row of cots laid across the orchestra pit.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single chandelier burns at half power.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The air smells of carbolic and old velvet.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. MARISOL VEGA, 40s, steps down from the stage with a clipboard, shoulders loose, the first unhurried moment in days.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "NURSE OLUWASEUN, 30s, whom everyone calls Seun, tucks a blanket around ARCHIBALD, 70s, who has been quiet since evening.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "dialogue", "text": "Seun, he's settled?", "name": "DR. VEGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Settled, Doctor. Sleeping like a stone.", "name": "SEUN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Archibald? Can you hear me?", "name": "DR. VEGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Archibald's eyelids flutter.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "He smiles.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "The room is hushed, the chandelier steady.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Doctor, I think the fever's broken.", "name": "SEUN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Good. Very good.", "name": "DR. VEGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "She lays a palm on his forehead.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Then her face changes.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Her hand flinches back.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "She reaches for his wrist.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Seun. Light.", "name": "DR. VEGA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Doctor?", "name": "SEUN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Bring the lamp.", "name": "DR. VEGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Seun lifts the lamp.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "They both lean in.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Archibald's lips are blue.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "His smile has not moved.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Archibald!", "name": "DR. VEGA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "She pounds his chest.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Seun knocks the lamp over and catches it.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "They both freeze as the chandelier above them gutters out.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Darkness.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Then a single cough in the pit, and a hundred cots begin to stir.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}]}