{"scene_id": "s01636", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01636.fountain", "heading": "EXT. FROZEN LAKE LANDSDAL - BONSPIEL RINK - DAY", "cast": [{"id": 0, "name": "ASTRID NYGAARD", "names": ["ASTRID NYGAARD", "ASTRID"], "gender": "f", "first": 5, "spoke": 8}, {"id": 1, "name": "TORVALD", "names": ["TORVALD"], "gender": "?", "first": 6, "spoke": 6}, {"id": 2, "name": "INGE", "names": ["INGE"], "gender": "?", "first": 6, "spoke": 4}, {"id": 3, "name": "HALVOR", "names": ["HALVOR"], "gender": "m", "first": 6, "spoke": 6}, {"id": 4, "name": "LINNEA", "names": ["LINNEA"], "gender": "f", "first": 7, "spoke": 4}, {"id": 5, "name": "REFEREE ODDMUND", "names": ["REFEREE ODDMUND", "ODDMUND"], "gender": "?", "first": 41, "spoke": 4}, {"id": 6, "name": "OFFICIAL", "names": ["OFFICIAL"], "gender": "?", "first": 41, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FROZEN LAKE LANDSDAL - BONSPIEL RINK - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A white plain under a lower white sky.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Eight sheets of curling ice scraped clean.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Flags snapping.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Crowds in wool, breath rising.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "At the far house, ASTRID NYGAARD, 30s, skip, tall, ice in her braid, crouches behind the button, broom raised.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her three teammates wait down the sheet: TORVALD, 50s, burly, thick gloves; INGE, 20s, whip-thin, the lead; and HALVOR, 60s, slow-moving, the veteran.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "At the hack, LINNEA, 20s, her youngest sweeper, adjusts her grip on a stone.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "The score reads 6-6.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "Final end.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Linnea! Heavy! Heavy!", "name": "ASTRID", "speaker": 0, "ext": [], "paren": ["calling"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Heavy?", "name": "LINNEA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Draw to the button. One more.", "name": "ASTRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Right.", "name": "LINNEA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Linnea pushes off.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Slides.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "The stone glides.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "A hush spreads.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Even the wind seems to listen.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Left, Inge! Sweep!", "name": "TORVALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "I am sweeping!", "name": "INGE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Harder!", "name": "HALVOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Harder!", "name": "TORVALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Harder than hard!", "name": "INGE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "The stone creeps down the ice.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Their brooms hiss.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "It curls toward the house -- and stops, a hair short.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Groans from the crowd.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Astrid hangs her head.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Short.", "name": "TORVALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Short by a hair.", "name": "HALVOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "That was my sweeping.", "name": "INGE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "It wasn't you.", "name": "TORVALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "It was the ice.", "name": "HALVOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "It was me.", "name": "ASTRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "A heavy silence.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Down the sheet, the other team's final stone is already gliding home.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "It is perfect.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "It hits the button.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "The crowd cheers.", "para": 7, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "A whistle.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "REFEREE ODDMUND, 60s, in a parka marked OFFICIAL, strides out across the ice with a measuring tape, grim as a judge.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "dialogue", "text": "Measurement! Measurement on the stones!", "name": "ODDMUND", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "The crowd falls quiet.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "Oddmund kneels.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "action", "text": "Unrolls the tape.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "action", "text": "Measures.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "Measures again.", "para": 9, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "dialogue", "text": "Nygaard stone. Four centimeters. Their stone. Four-point-one.", "name": "ODDMUND", "speaker": 5, "ext": ["CONT'D"], "paren": ["looking up"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "dialogue", "text": "We won?", "name": "INGE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "dialogue", "text": "We won!", "name": "TORVALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "dialogue", "text": "We won by a tenth!", "name": "HALVOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "dialogue", "text": "By a tenth of what?", "name": "LINNEA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "dialogue", "text": "Of anything!", "name": "HALVOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "dialogue", "text": "Oddmund. Measure again.", "name": "ASTRID", "speaker": 0, "ext": [], "paren": ["breathless"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "dialogue", "text": "I've measured twice.", "name": "ODDMUND", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "dialogue", "text": "Then measure again.", "name": "ASTRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "action", "text": "Oddmund sighs, kneels, measures a third time.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "action", "text": "The crowd leans in.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 59, "kind": "action", "text": "Wind turns the flags.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 60, "kind": "dialogue", "text": "Four-point-one. Four-point-one. Nygaard stone, four.", "name": "ODDMUND", "speaker": 5, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 61, "kind": "action", "text": "A beat.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 62, "kind": "action", "text": "Then the roar goes up.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 63, "kind": "action", "text": "Torvald lifts Astrid off the ice.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 64, "kind": "action", "text": "Halvor sits down on his broom.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 65, "kind": "action", "text": "Inge dances.", "para": 11, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 66, "kind": "action", "text": "Linnea stares at her own gloves.", "para": 11, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 67, "kind": "dialogue", "text": "You pushed it.", "name": "ASTRID", "speaker": 0, "ext": [], "paren": ["to Linnea"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 68, "kind": "dialogue", "text": "It stopped short.", "name": "LINNEA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 69, "kind": "dialogue", "text": "It was exactly enough.", "name": "ASTRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 70, "kind": "action", "text": "Down the sheet, the other team's stones sit silent on the ice.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 71, "kind": "action", "text": "Wind drifts snow across them.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 72, "kind": "dialogue", "text": "They threw a perfect last stone.", "name": "TORVALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 73, "kind": "dialogue", "text": "Not perfect enough.", "name": "HALVOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 74, "kind": "dialogue", "text": "Then they'll be back.", "name": "ASTRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}