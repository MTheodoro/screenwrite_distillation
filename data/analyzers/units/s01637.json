{"scene_id": "s01637", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01637.fountain", "heading": "EXT. STALLED CABLE CAR OVER A GORGE - DAY", "cast": [{"id": 0, "name": "JUNIPER", "names": ["JUNIPER"], "gender": "?", "first": 4, "spoke": 9}, {"id": 1, "name": "BASHIR", "names": ["BASHIR"], "gender": "?", "first": 34, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "EXT. STALLED CABLE CAR OVER A GORGE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Wind.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A steel box swaying under a single cable.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Far below, a river like a thread.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "JUNIPER, 30s, hiking boots, a torn pack, sits wedged against the door.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She stares at the hatch in the ceiling.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Her knuckles are white.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "dialogue", "text": "Okay. Okay. Everyone stay calm.", "name": "JUNIPER", "speaker": 0, "ext": [], "paren": ["to the empty car"], "dual": false, "present": [0]}, {"u": 8, "kind": "action", "text": "No one answers.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "The car creaks.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "dialogue", "text": "You are not stuck. You are paused.", "name": "JUNIPER", "speaker": 0, "ext": ["CONT'D"], "paren": ["to herself"], "dual": false, "present": [0]}, {"u": 11, "kind": "action", "text": "She reaches into her pack.", "para": 3, "sent": 0, "present": [0]}, {"u": 12, "kind": "action", "text": "Pulls a radio.", "para": 3, "sent": 1, "present": [0]}, {"u": 13, "kind": "action", "text": "Presses the button.", "para": 3, "sent": 2, "present": [0]}, {"u": 14, "kind": "action", "text": "Static.", "para": 3, "sent": 3, "present": [0]}, {"u": 15, "kind": "dialogue", "text": "Base, this is car nine. Anyone?", "name": "JUNIPER", "speaker": 0, "ext": ["CONT'D"], "paren": ["into radio"], "dual": false, "present": [0]}, {"u": 16, "kind": "action", "text": "Static.", "para": 4, "sent": 0, "present": [0]}, {"u": 17, "kind": "action", "text": "She tries again.", "para": 4, "sent": 1, "present": [0]}, {"u": 18, "kind": "action", "text": "And again.", "para": 4, "sent": 2, "present": [0]}, {"u": 19, "kind": "action", "text": "A bolt shears off somewhere above.", "para": 5, "sent": 0, "present": [0]}, {"u": 20, "kind": "action", "text": "Metal rings.", "para": 5, "sent": 1, "present": [0]}, {"u": 21, "kind": "action", "text": "The car lurches six inches.", "para": 5, "sent": 2, "present": [0]}, {"u": 22, "kind": "action", "text": "Juniper screams, clamps both hands on the rail.", "para": 5, "sent": 3, "present": [0]}, {"u": 23, "kind": "dialogue", "text": "No. No no no.", "name": "JUNIPER", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the car"], "dual": false, "present": [0]}, {"u": 24, "kind": "action", "text": "She closes her eyes.", "para": 6, "sent": 0, "present": [0]}, {"u": 25, "kind": "action", "text": "Breathes.", "para": 6, "sent": 1, "present": [0]}, {"u": 26, "kind": "action", "text": "In.", "para": 6, "sent": 2, "present": [0]}, {"u": 27, "kind": "action", "text": "Out.", "para": 6, "sent": 3, "present": [0]}, {"u": 28, "kind": "action", "text": "She opens the hatch release.", "para": 7, "sent": 0, "present": [0]}, {"u": 29, "kind": "action", "text": "Pushes.", "para": 7, "sent": 1, "present": [0]}, {"u": 30, "kind": "action", "text": "Nothing.", "para": 7, "sent": 2, "present": [0]}, {"u": 31, "kind": "action", "text": "Pushes again.", "para": 7, "sent": 3, "present": [0]}, {"u": 32, "kind": "action", "text": "The latch squeals.", "para": 7, "sent": 4, "present": [0]}, {"u": 33, "kind": "action", "text": "A shadow falls across the hatch.", "para": 8, "sent": 0, "present": [0]}, {"u": 34, "kind": "action", "text": "BASHIR, 30s, in a climbing harness and a bright orange helmet, drops through the opening on a rope, boots first.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "He lands, steadies the car with one knee, and clips a carabiner to her pack.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Juniper?", "name": "BASHIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Who are you?", "name": "JUNIPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Rescue. They said you were alone.", "name": "BASHIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "I was talking to the car.", "name": "JUNIPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "How's the car?", "name": "BASHIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Needy.", "name": "JUNIPER", "speaker": 0, "ext": [], "paren": ["laughs, shaky"], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "He tightens the straps across her chest, one at a time, steady.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "I'm going to lift you through the hatch. You look up, not down.", "name": "BASHIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Up. Not down.", "name": "JUNIPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Good.", "name": "BASHIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "He lifts.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "She rises into daylight, boots dangling.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "I can see the sun!", "name": "JUNIPER", "speaker": 0, "ext": [], "paren": ["from above"], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Told you.", "name": "BASHIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "The car groans.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "He follows, last out.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "The cable hums.", "para": 12, "sent": 2, "present": [0, 1]}]}