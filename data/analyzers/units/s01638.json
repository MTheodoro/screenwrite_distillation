{"scene_id": "s01638", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01638.fountain", "heading": "INT. GOLD ASSAY OFFICE - DAY", "cast": [{"id": 0, "name": "ISAIAH COLE", "names": ["ISAIAH COLE", "ISAIAH"], "gender": "?", "first": 5, "spoke": 14}, {"id": 1, "name": "MAGDALENA OROZCO", "names": ["MAGDALENA OROZCO", "MAGDALENA"], "gender": "?", "first": 11, "spoke": 12}], "units": [{"u": 0, "kind": "heading", "text": "INT. GOLD ASSAY OFFICE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "One room, adobe walls, a barred window.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A scale of polished brass on a counter.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A stove ticking.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Dust turning in the light.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ISAIAH COLE, 50s, a stooped assayer in sleeve garters, wipes the scale with a rag.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "He is slow, methodical.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "A man who has weighed other people's hopes for thirty years.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "A door in the back wall stands ajar.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Beyond it, a lamp-lit vault.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "The bell above the front door jingles.", "para": 3, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "MAGDALENA OROZCO, 30s, enters.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Dust on her riding skirt.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "A canvas pouch in one fist.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She walks like she has somewhere to be, and pauses when she sees he has already seen her.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Morning.", "name": "ISAIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "It's afternoon.", "name": "MAGDALENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Not in here.", "name": "ISAIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She lays the pouch on the counter.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He opens it.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Pours out a stream of dull yellow dust, and says nothing.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "He weighs.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "He squints.", "para": 5, "sent": 4, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "He weighs again.", "para": 5, "sent": 5, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Well?", "name": "MAGDALENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Eleven ounces.", "name": "ISAIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "That's all?", "name": "MAGDALENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Where did you find it?", "name": "ISAIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Upriver.", "name": "MAGDALENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Upriver is long.", "name": "ISAIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "She shrugs.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "He looks at her face, then at her hands.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Her fingers are steady.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Her nails are broken.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "That's a rough week.", "name": "ISAIAH", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "A rough year.", "name": "MAGDALENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "He pours the dust back in.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Ties the pouch.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Slides it across.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "It isn't gold.", "name": "ISAIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "It's yellow.", "name": "MAGDALENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "So is brass. So is a fool's hope.", "name": "ISAIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "She doesn't move.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "The stove ticks.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "The scale settles.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "How much for the dust, if it's brass?", "name": "MAGDALENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Nothing.", "name": "ISAIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "Then how much if it's gold?", "name": "MAGDALENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "That depends on whether you're lying.", "name": "ISAIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "He walks to the vault door and pushes it wider.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "Beyond, a long table, covered with ledgers, a hundred small pouches in rows.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "She slips past him.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "Through the open door.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "Into the lamplight.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "He does not stop her.", "para": 10, "sent": 3, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "Isaiah, how many pouches are in here?", "name": "MAGDALENA", "speaker": 1, "ext": ["O.S."], "paren": ["from the back room"], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "More than eleven ounces' worth.", "name": "ISAIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "Whose are they?", "name": "MAGDALENA", "speaker": 1, "ext": ["O.S."], "paren": ["from the back room"], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "Men who stopped coming back.", "name": "ISAIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "A pause.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "A pouch thumps onto the table.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "Another.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "You never sent them anything.", "name": "MAGDALENA", "speaker": 1, "ext": ["O.S."], "paren": ["from the back room"], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "Nobody left an address.", "name": "ISAIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "He lets out a slow breath.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "Sets down the rag.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "Locks the front door with a click.", "para": 12, "sent": 2, "present": [0, 1]}, {"u": 67, "kind": "action", "text": "The bell above it jingles one last time.", "para": 12, "sent": 3, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "She steps from the vault, a pistol held loose at her side.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "Eleven ounces was only the start.", "name": "MAGDALENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "I know.", "name": "ISAIAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "He folds his hands on the counter and waits.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "He has weighed worse.", "para": 14, "sent": 1, "present": [0, 1]}]}