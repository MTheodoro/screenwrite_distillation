{"scene_id": "s01640", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01640.fountain", "heading": "INT. HOSPITAL HYDROTHERAPY POOL - DAY", "cast": [{"id": 0, "name": "LAKSHMI IYER", "names": ["LAKSHMI IYER", "IYER"], "gender": "f", "first": 4, "spoke": 13}, {"id": 1, "name": "NURSE BERTRAND", "names": ["NURSE BERTRAND", "BERTRAND"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "ORDERLY CASIMIR", "names": ["ORDERLY CASIMIR", "CASIMIR"], "gender": "?", "first": 6, "spoke": 3}, {"id": 3, "name": "PADMORE", "names": ["PADMORE"], "gender": "m", "first": 7, "spoke": 3}, {"id": 4, "name": "WILHELMINA OKORO", "names": ["WILHELMINA OKORO", "WILHELMINA"], "gender": "?", "first": 8, "spoke": 15}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOSPITAL HYDROTHERAPY POOL - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Warm green water.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Steam on the tiles.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Handrails along the shallow end.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. LAKSHMI IYER, 40s, stands waist-deep in a wetsuit top, a clipboard on a floating tray.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "NURSE BERTRAND, 50s, adjusts the lift chair at the edge.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "ORDERLY CASIMIR, 20s, holds a towel and does nothing else.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "DR. PADMORE, 60s, observes from a plastic chair by the wall.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "In the water, MRS. WILHELMINA OKORO, 80s, clings to the rail.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Mrs. Okoro, how does that feel?", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Warm.", "name": "WILHELMINA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Good. Lift the left leg for me.", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "That's the one that doesn't lift.", "name": "WILHELMINA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Try anyway.", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "I tried last week.", "name": "WILHELMINA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "And?", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "It stayed where it was.", "name": "WILHELMINA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "She's got spirit, Doctor.", "name": "BERTRAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "She does. Mrs. Okoro, let's try the right.", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Which is the one that works?", "name": "WILHELMINA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "That's the idea.", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Then why do I need a doctor?", "name": "WILHELMINA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "For the paperwork, Mrs. Okoro.", "name": "PADMORE", "speaker": 3, "ext": [], "paren": ["from the chair"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Who's that?", "name": "WILHELMINA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Dr. Padmore. He's observing.", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "He looks like he's been observing since 1990.", "name": "WILHELMINA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "I find the work restful.", "name": "PADMORE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Right leg, please.", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "There.", "name": "WILHELMINA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Higher.", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "There.", "name": "WILHELMINA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Higher.", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "That's as high as it goes.", "name": "WILHELMINA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "It's high enough.", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Casimir, the towel.", "name": "BERTRAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "I have it.", "name": "CASIMIR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Then hold it.", "name": "BERTRAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "I am holding it.", "name": "CASIMIR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Higher.", "name": "BERTRAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "This is as high as it goes.", "name": "CASIMIR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "He's learning.", "name": "WILHELMINA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Slowly.", "name": "PADMORE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Iyer glances at her clipboard.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Makes a note.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Wilhelmina lets go of the rail with one hand, tentatively.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "The water holds her.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "She smiles, a small, surprised thing.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "Oh.", "name": "WILHELMINA", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Yes?", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Nothing. It's only that I'd forgotten.", "name": "WILHELMINA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Forgotten what?", "name": "IYER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "That it could feel like this.", "name": "WILHELMINA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Bertrand lowers the lift chair.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Casimir finally spreads the towel.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "Padmore uncrosses his legs, checks his watch, crosses them again.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}]}