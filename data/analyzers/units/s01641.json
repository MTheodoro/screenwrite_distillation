{"scene_id": "s01641", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01641.fountain", "heading": "INT. ROOFTOP GREENHOUSE, GRAND HOTEL - NIGHT", "cast": [{"id": 0, "name": "SOLANO", "names": ["SOLANO"], "gender": "m", "first": 5, "spoke": 11}, {"id": 1, "name": "HESTER VANCE", "names": ["HESTER VANCE", "HESTER"], "gender": "?", "first": 6, "spoke": 3}, {"id": 2, "name": "KIERAN", "names": ["KIERAN"], "gender": "?", "first": 7, "spoke": 2}, {"id": 3, "name": "BAPTISTE", "names": ["BAPTISTE"], "gender": "?", "first": 8, "spoke": 6}, {"id": 4, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 9, "spoke": 9}, {"id": 5, "name": "CALDER", "names": ["CALDER"], "gender": "?", "first": 26, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROOFTOP GREENHOUSE, GRAND HOTEL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Glass walls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Orchids in hanging baskets.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain tapping overhead.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A city smeared into color below.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DET. SOLANO, 40s, trench coat, sits on a wrought-iron bench, hands in his pockets.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "HESTER VANCE, 50s, the hotel manager, waters ferns with a copper can.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "KIERAN, 20s, the night porter, hovers near the door.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "MR. BAPTISTE, 60s, an elderly guest in a silk robe, studies an orchid.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "A STRANGER, 30s, wet hair, black jacket, steps in.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Nods to no one.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Stands apart.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Evening.", "name": "SOLANO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Evening.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "You're not a guest.", "name": "SOLANO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "I'm waiting for someone.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Who?", "name": "SOLANO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "A friend.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "The greenhouse closes at eleven.", "name": "HESTER", "speaker": 1, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "It's ten-forty.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Then you have twenty minutes.", "name": "HESTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Sir, can I take your coat?", "name": "KIERAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "No.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "What's your friend's name?", "name": "SOLANO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "You wouldn't know him.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Try me.", "name": "SOLANO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Calder.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Calder is dead.", "name": "BAPTISTE", "speaker": 3, "ext": [], "paren": ["without turning"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Is he?", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "I buried him in March.", "name": "BAPTISTE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Then who's standing here?", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "The rain.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "A drop falls from a leaf onto the tile.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Mr. Baptiste. It's been a long time.", "name": "CALDER", "speaker": 5, "ext": [], "paren": ["the Stranger, now"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Not long enough.", "name": "BAPTISTE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "I came to return something.", "name": "CALDER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Hester. Clear the room.", "name": "SOLANO", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Detective?", "name": "HESTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Now.", "name": "SOLANO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Sir, I --", "name": "KIERAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Out, son.", "name": "SOLANO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Kieran backs out of the greenhouse.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Hester sets the can down, walks to the door.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Locks it from the outside.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Don't be dramatic.", "name": "CALDER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "You're supposed to be in a box.", "name": "SOLANO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "So is he.", "name": "CALDER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "What did you bring me?", "name": "BAPTISTE", "speaker": 3, "ext": [], "paren": ["turning at last"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "Your watch.", "name": "CALDER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "He pulls it from his jacket.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Gold.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "Heavy.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "Holds it up by the chain.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "You gave it to me the night you shot me.", "name": "CALDER", "speaker": 5, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "I gave it to you as a kindness.", "name": "BAPTISTE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "It stopped at eleven.", "name": "CALDER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "It always did.", "name": "BAPTISTE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "Solano rises.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "His hand is out of his pocket now.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "Mr. Calder, put the watch on the bench.", "name": "SOLANO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "dialogue", "text": "It's not for the bench.", "name": "CALDER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "dialogue", "text": "Put it down.", "name": "SOLANO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "dialogue", "text": "Detective, I've waited eight months. I can wait one more minute.", "name": "CALDER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "The watch swings.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "Tick.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "action", "text": "Tick.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "action", "text": "Tick.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "action", "text": "It stops.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "dialogue", "text": "Eleven.", "name": "CALDER", "speaker": 5, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}