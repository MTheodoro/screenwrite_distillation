{"scene_id": "s01642", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01642.fountain", "heading": "INT. MORDECAI'S PAWN SHOP - CLOSING SALE - NIGHT", "cast": [{"id": 0, "name": "PAWNBROKER MORDECAI", "names": ["PAWNBROKER MORDECAI", "MORDECAI"], "gender": "m", "first": 3, "spoke": 4}, {"id": 1, "name": "GINA", "names": ["GINA"], "gender": "?", "first": 4, "spoke": 3}, {"id": 2, "name": "TREY", "names": ["TREY"], "gender": "?", "first": 5, "spoke": 3}, {"id": 3, "name": "ROSALIND", "names": ["ROSALIND"], "gender": "f", "first": 6, "spoke": 3}, {"id": 4, "name": "DUKE", "names": ["DUKE"], "gender": "?", "first": 7, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. MORDECAI'S PAWN SHOP - CLOSING SALE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Shelves of guitars, watches, tuba cases.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A red banner: EVERYTHING MUST GO.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "PAWNBROKER MORDECAI, 60s, cash apron, stands behind the counter.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "GINA, 30s, a regular, waves a ticket at him.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "TREY, 20s, a skinny kid in a hoodie, edges toward the display case.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "ROSALIND, 40s, a plainclothes cop, pretends to look at saxophones.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "DUKE, 50s, a large man in a leather vest, blocks the door.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "We're closed!", "name": "MORDECAI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "The banner says sale!", "name": "GINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "I just want the ring.", "name": "TREY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Which ring?", "name": "ROSALIND", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "The one in the case.", "name": "TREY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Nobody leaves.", "name": "DUKE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Nobody enters, Duke! We're closed!", "name": "MORDECAI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Mordecai, my grandmother's locket --", "name": "GINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "It's not for sale, it's for me --", "name": "TREY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Everybody shut up!", "name": "MORDECAI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Silence.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Then Rosalind flashes her badge.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Police. Everybody hands up.", "name": "ROSALIND", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Mordecai lifts his hands.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Gina lifts her ticket.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Trey lunges for the case.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Duke steps aside to let Rosalind through.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Duke!", "name": "MORDECAI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "TREY!", "name": "GINA", "speaker": 1, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "She's a cop!", "name": "DUKE", "speaker": 4, "ext": [], "paren": ["simultaneously"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Trey smashes the glass.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Grabs the ring.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Bolts.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Duke, stop him!", "name": "ROSALIND", "speaker": 3, "ext": [], "paren": ["over her shoulder"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Duke grins and sits down on the nearest tuba case.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}]}