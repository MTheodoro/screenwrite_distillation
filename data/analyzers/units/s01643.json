{"scene_id": "s01643", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01643.fountain", "heading": "INT. LUMBER MILL OFFICE, DEPOSITION - DAY", "cast": [{"id": 0, "name": "ATTORNEY PHILOMENA OKAFOR-LANE", "names": ["ATTORNEY PHILOMENA OKAFOR-LANE", "PHILOMENA"], "gender": "f", "first": 5, "spoke": 22}, {"id": 1, "name": "CORNELIUS HARGROVE", "names": ["CORNELIUS HARGROVE", "CORNELIUS"], "gender": "?", "first": 9, "spoke": 22}], "units": [{"u": 0, "kind": "heading", "text": "INT. LUMBER MILL OFFICE, DEPOSITION - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Wood-paneled walls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sawdust in the corners.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A rattling air conditioner.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A long folding table with a court reporter's empty chair.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ATTORNEY PHILOMENA OKAFOR-LANE, 40s, in a good grey suit, flips through a thick folder.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her pen taps the rim of a mug.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She is very still.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "The door opens.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "CORNELIUS HARGROVE, 60s, work boots, flannel shirt under a blazer too tight at the shoulders, steps inside.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He eases into the chair opposite.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Mr. Hargrove. Thank you for coming.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "You didn't give me a choice.", "name": "CORNELIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "No. I didn't.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Is the reporter coming?", "name": "CORNELIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "She's late. We'll begin.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She turns on a small recorder.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Sets it between them.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "State your name.", "name": "PHILOMENA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Cornelius Hargrove.", "name": "CORNELIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Employment?", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Foreman, Pinecrest Lumber. Thirty-one years.", "name": "CORNELIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "On March ninth, were you on shift?", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "I was.", "name": "CORNELIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Did you see Mr. Dunmore fall?", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I saw a lot of things.", "name": "CORNELIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Mr. Hargrove.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Yes. I saw him fall.", "name": "CORNELIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "From the catwalk?", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "From the catwalk.", "name": "CORNELIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Was the railing intact?", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "No.", "name": "CORNELIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Had you reported it?", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Four times.", "name": "CORNELIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "To whom?", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "To the owner. To his brother. To the safety man. To the priest.", "name": "CORNELIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "The priest?", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "I tell him everything.", "name": "CORNELIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "She smiles, almost.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Cornelius does not.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "And what did the owner say?", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "He said wood bends.", "name": "CORNELIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Wood bends.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "But men break.", "name": "CORNELIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "The air conditioner clatters.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "Philomena closes the folder.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Cornelius stares at the recorder as if it were a gun.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "Mr. Hargrove, would you be willing to say that in open court?", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "I'd rather not.", "name": "CORNELIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Why?", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Because I'd lose my pension.", "name": "CORNELIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "You might lose more by staying silent.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "You don't know that.", "name": "CORNELIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "I know that Mr. Dunmore's widow sits in the next room.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "Cornelius shifts.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "His chair squeaks.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "He looks at the door.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "She's here?", "name": "CORNELIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "She asked to sit in.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "She shouldn't.", "name": "CORNELIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "She wanted to look at you.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "He stands.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "The chair scrapes.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "He paces to the window, back, then stops at the table, hands flat on the wood.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "I can't do this.", "name": "CORNELIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "You already are.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "He slams his palm on the table.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 67, "kind": "action", "text": "The recorder jumps.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "Philomena doesn't flinch, but she catches the mug before it tips.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "They stare at each other.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 70, "kind": "action", "text": "Then, slowly, both reach for the recorder at once, and their hands touch on the plastic.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 71, "kind": "dialogue", "text": "Turn it on again.", "name": "CORNELIUS", "speaker": 1, "ext": ["CONT'D"], "paren": ["quietly"], "dual": false, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "Philomena presses the button.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "The red light blinks.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 74, "kind": "dialogue", "text": "My name is Cornelius Hargrove. I saw him fall.", "name": "CORNELIUS", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}]}