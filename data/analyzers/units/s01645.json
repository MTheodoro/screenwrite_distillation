{"scene_id": "s01645", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01645.fountain", "heading": "INT. DRIVE-IN PROJECTION BOOTH - NIGHT", "cast": [{"id": 0, "name": "ROSARIO VEGA", "names": ["ROSARIO VEGA", "ROSARIO"], "gender": "?", "first": 5, "spoke": 14}, {"id": 1, "name": "BERNADETTE", "names": ["BERNADETTE"], "gender": "f", "first": 6, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRIVE-IN PROJECTION BOOTH - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cramped.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A hot projector throws white light through a slot.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Reels, ashtrays, a cracked radio.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Below, a lot of dark cars and a giant screen.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ROSARIO VEGA, 40s, a scarred shift manager, leans over the projector.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "BERNADETTE, 30s, her new hire, stands by the door with a trembling hand on a canvas bag.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "You're early.", "name": "ROSARIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "I'm always early.", "name": "BERNADETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "That's what worries me.", "name": "ROSARIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Bernadette sets the bag on a stool.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Rosario eyes it.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "That's heavy.", "name": "ROSARIO", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Sandwiches.", "name": "BERNADETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Sandwiches don't clink.", "name": "ROSARIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "These are fancy.", "name": "BERNADETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Everybody hears this? She brought fancy sandwiches.", "name": "ROSARIO", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Nobody.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Just the projector's hum.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Rosario reaches for the bag.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Bernadette catches her wrist.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Don't.", "name": "BERNADETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Why not?", "name": "ROSARIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Because she'll know.", "name": "BERNADETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Who?", "name": "ROSARIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "The one who told me to bring it.", "name": "BERNADETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Always somebody.", "name": "ROSARIO", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "She yanks free.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Unzips the bag.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Inside, three stacks of cash and a small black pistol.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "That's not a sandwich.", "name": "ROSARIO", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "No.", "name": "BERNADETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Whose money?", "name": "ROSARIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Ours.", "name": "BERNADETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Mine and yours?", "name": "ROSARIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Hers and hers.", "name": "BERNADETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Rosario turns slowly.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Bernadette's hand drops to her pocket.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Is that your gun, or mine?", "name": "ROSARIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Hers.", "name": "BERNADETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Honey, whose is \"hers\"?", "name": "ROSARIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "The projector clicks.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "A new reel begins.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "On the lot below, a hundred cars flash blue in the movie's light, and a voice from the speakers booms: \"COMING ATTRACTIONS.\"", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Good title.", "name": "ROSARIO", "speaker": 0, "ext": ["CONT'D"], "paren": ["to herself"], "dual": false, "present": [0, 1]}]}