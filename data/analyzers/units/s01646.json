{"scene_id": "s01646", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01646.fountain", "heading": "INT. FISH MARKET AUCTION FLOOR - EARLY MORNING", "cast": [{"id": 0, "name": "MAUDE PETTIGREW", "names": ["MAUDE PETTIGREW", "MAUDE"], "gender": "?", "first": 6, "spoke": 13}, {"id": 1, "name": "FERDIE", "names": ["FERDIE"], "gender": "?", "first": 7, "spoke": 11}, {"id": 2, "name": "LOMBARD", "names": ["LOMBARD"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "^FERDIE", "names": ["^FERDIE"], "gender": "?", "first": 27, "spoke": 1}, {"id": 4, "name": "SOLD", "names": ["SOLD"], "gender": "?", "first": 42, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. FISH MARKET AUCTION FLOOR - EARLY MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Crushed ice.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Crates of silver mackerel.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A scale.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A bell.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The din of a hundred voices that are not in this scene.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "MAUDE PETTIGREW, 50s, galoshes and a straw hat with a feather in it, grips a number paddle.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "FERDIE \"FERDINAND\" LOMBARD, 50s, a cravat under his oilskins, grips his.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Ferdinand Lombard, put that down.", "name": "MAUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "I will not, Maudie.", "name": "FERDIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "It's my tuna.", "name": "MAUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "It's the market's tuna.", "name": "FERDIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "I saw it first.", "name": "MAUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "You saw it second. I saw it from the harbor.", "name": "FERDIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Did anyone else see a man claim a tuna from the harbor?", "name": "MAUDE", "speaker": 0, "ext": [], "paren": ["to the crowd"], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Did anyone else see a woman in a feather hat claim anything?", "name": "FERDIE", "speaker": 1, "ext": [], "paren": ["to the crowd"], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "An invisible auctioneer raps a gavel.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Both snap their paddles up.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Two hundred!", "name": "MAUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Two hundred!", "name": "FERDIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Two-fifty!", "name": "MAUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Two-fifty!", "name": "FERDIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "You are impossible!", "name": "MAUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "You are impossible!", "name": "FERDIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The gavel bangs.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "They speak at the same instant.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "I'm bidding for my sister's wedding.", "name": "MAUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "I'm bidding for my sister's wedding.", "name": "^FERDIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "They stop.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Stare at each other.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Slowly lower their paddles.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Your sister's Cordelia?", "name": "MAUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Your sister's Cordelia?", "name": "FERDIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "She's marrying a Lombard.", "name": "MAUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "She's marrying a Pettigrew.", "name": "FERDIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Then we're...", "name": "MAUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Cousins-in-law.", "name": "FERDIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Oh, dear.", "name": "MAUDE", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Split the tuna?", "name": "FERDIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Split the tuna.", "name": "MAUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "They shake hands.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "The gavel falls.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "SOLD, says the unseen auctioneer, to both.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}]}