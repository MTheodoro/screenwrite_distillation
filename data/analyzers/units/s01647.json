{"scene_id": "s01647", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01647.fountain", "heading": "INT. RIVERBOAT CALLIOPE ROOM - NIGHT", "cast": [{"id": 0, "name": "CAPTAIN PRUDENCE LOCKWOOD", "names": ["CAPTAIN PRUDENCE LOCKWOOD", "PRUDENCE"], "gender": "f", "first": 4, "spoke": 12}, {"id": 1, "name": "JUBAL", "names": ["JUBAL"], "gender": "m", "first": 6, "spoke": 10}, {"id": 2, "name": "TENNYSON", "names": ["TENNYSON"], "gender": "m", "first": 8, "spoke": 12}], "units": [{"u": 0, "kind": "heading", "text": "INT. RIVERBOAT CALLIOPE ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped brass chamber beneath the smokestacks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Steam pipes, a keyboard of fat ivory keys, a hundred whistles gleaming in the lamplight.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Through a port window, black river water slides by.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CAPTAIN PRUDENCE LOCKWOOD, 50s, braided cuffs, a cigar gone cold, leans against the pipes with her arms folded.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She watches the boy at the keys.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "JUBAL, 17, bare feet, sleeves rolled, sweats at the calliope.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He plays a hymn badly, then well, then badly again.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "In the corner, TENNYSON, 60s, a gambler in a black frock coat, slouches in a barrel chair with a pistol resting on his knee.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "He is not listening to the music.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Jubal, stop.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "The calliope sighs to silence.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Steam hisses.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Jubal turns, wiping his hands on his shirt.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Yes, Captain.", "name": "JUBAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Tell Mr. Tennyson what you told me this morning.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "About the crates?", "name": "JUBAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "About the crates.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Let the boy speak, Prudence.", "name": "TENNYSON", "speaker": 2, "ext": [], "paren": ["not moving"], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "He's speaking.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I loaded forty-one crates at St. Louis, sir. Marked flour. They came out forty-one at Cairo, marked flour. But the ones at Cairo, they were light.", "name": "JUBAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Light.", "name": "TENNYSON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Like they had nothing but air in 'em.", "name": "JUBAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Flour is light, son.", "name": "TENNYSON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Not that light.", "name": "JUBAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "How would you know?", "name": "TENNYSON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "I carried three hundred sacks of it for my father before he died.", "name": "JUBAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Tennyson smiles, thin.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Studies the pistol.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Captain, your boy has sharp eyes.", "name": "TENNYSON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "He has sharp ears too.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Which brings me to my question. What did he hear?", "name": "TENNYSON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Hear?", "name": "JUBAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "He heard you in the hold, Mr. Tennyson. Last Tuesday. Opening crates.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Did he.", "name": "TENNYSON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "He told me you were counting something. Not flour.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "I count many things, Captain. Ducats. Dealers. Debts.", "name": "TENNYSON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Gold.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "A long silence.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "The river hisses along the hull.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Jubal's hands, still on the keys, tremble.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Boy. Play something.", "name": "TENNYSON", "speaker": 2, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Sir?", "name": "JUBAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Something loud.", "name": "TENNYSON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Jubal looks at Prudence.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "She nods, almost imperceptibly.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "He turns back and brings both hands down on the keys.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "The calliope screams into the night, a great, shrieking chord that rattles the pipes.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Tennyson rises.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "He doesn't raise the pistol.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "He walks to the port and looks out at the river.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "It was a good run, Prudence.", "name": "TENNYSON", "speaker": 2, "ext": ["CONT'D"], "paren": ["over the noise"], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "It was.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": ["over the noise"], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "You'd have made a fine partner.", "name": "TENNYSON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "I made a better captain.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "He laughs, once.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Tucks the pistol into his coat.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Steps through the door and onto the deck.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "The calliope plays on.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Jubal keeps playing until the last of the steam gives out.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "In the silence after, he looks up.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Captain?", "name": "JUBAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "Yes, Jubal?", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "Was that a hymn?", "name": "JUBAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "Close enough.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}