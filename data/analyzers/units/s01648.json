{"scene_id": "s01648", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01648.fountain", "heading": "INT. CHEESE CAVE - NIGHT", "cast": [{"id": 0, "name": "ZOFIA LAWNICZAK", "names": ["ZOFIA LAWNICZAK", "ZOFIA"], "gender": "?", "first": 5, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. CHEESE CAVE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cold limestone tunnel lined with racks of wheeled cheese.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Condensation drips.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single bulb.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Behind a rack, a ventilation grate half-pried loose.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ZOFIA LAWNICZAK, 30s, black clothes, headlamp, crouches at the grate with a screwdriver.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A dark rectangle of vault door gleams behind it.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She sets down the screwdriver.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Pulls a small recorder from her pocket.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "Presses play.", "para": 2, "sent": 2, "present": [0]}, {"u": 10, "kind": "dialogue", "text": "Zofia, if you're hearing this, the guard rotates at two. The grate is the third rack from the end. Do not use the main door.", "name": "ZOFIA", "speaker": 0, "ext": ["V.O."], "paren": ["recording, her own voice"], "dual": false, "present": [0]}, {"u": 11, "kind": "action", "text": "She clicks it off.", "para": 3, "sent": 0, "present": [0]}, {"u": 12, "kind": "action", "text": "Frowns.", "para": 3, "sent": 1, "present": [0]}, {"u": 13, "kind": "action", "text": "Looks at the rack.", "para": 3, "sent": 2, "present": [0]}, {"u": 14, "kind": "action", "text": "Counts.", "para": 3, "sent": 3, "present": [0]}, {"u": 15, "kind": "dialogue", "text": "One. Two. Three.", "name": "ZOFIA", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0]}, {"u": 16, "kind": "action", "text": "She presses play again.", "para": 4, "sent": 0, "present": [0]}, {"u": 17, "kind": "dialogue", "text": "The vault has a thumbprint scanner. I have the thumb. It is in the Brie.", "name": "ZOFIA", "speaker": 0, "ext": ["V.O."], "paren": ["recording"], "dual": false, "present": [0]}, {"u": 18, "kind": "action", "text": "Zofia's eyes widen.", "para": 5, "sent": 0, "present": [0]}, {"u": 19, "kind": "action", "text": "She turns to the nearest wheel.", "para": 5, "sent": 1, "present": [0]}, {"u": 20, "kind": "action", "text": "Cuts into it with a pocketknife.", "para": 5, "sent": 2, "present": [0]}, {"u": 21, "kind": "action", "text": "Cheese falls away.", "para": 5, "sent": 3, "present": [0]}, {"u": 22, "kind": "action", "text": "Inside: a small plastic bag.", "para": 6, "sent": 0, "present": [0]}, {"u": 23, "kind": "action", "text": "Inside the bag, a rubber thumb.", "para": 6, "sent": 1, "present": [0]}, {"u": 24, "kind": "action", "text": "She holds it up in the beam of her headlamp.", "para": 6, "sent": 2, "present": [0]}, {"u": 25, "kind": "dialogue", "text": "You are insane.", "name": "ZOFIA", "speaker": 0, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0]}, {"u": 26, "kind": "action", "text": "She presses play a third time.", "para": 7, "sent": 0, "present": [0]}, {"u": 27, "kind": "dialogue", "text": "Yes. Now hurry. Somewhere above you, he is awake.", "name": "ZOFIA", "speaker": 0, "ext": ["V.O."], "paren": ["recording"], "dual": false, "present": [0]}, {"u": 28, "kind": "action", "text": "Zofia freezes.", "para": 8, "sent": 0, "present": [0]}, {"u": 29, "kind": "action", "text": "Overhead, a footstep, then another.", "para": 8, "sent": 1, "present": [0]}, {"u": 30, "kind": "action", "text": "A beam of light sweeps the tunnel.", "para": 8, "sent": 2, "present": [0]}, {"u": 31, "kind": "action", "text": "She switches off her headlamp.", "para": 9, "sent": 0, "present": [0]}, {"u": 32, "kind": "action", "text": "Everything goes black.", "para": 9, "sent": 1, "present": [0]}, {"u": 33, "kind": "dialogue", "text": "Fine. Fine.", "name": "ZOFIA", "speaker": 0, "ext": [], "paren": ["barely audible"], "dual": false, "present": [0]}, {"u": 34, "kind": "action", "text": "She presses the thumb against the scanner.", "para": 10, "sent": 0, "present": [0]}, {"u": 35, "kind": "action", "text": "Click.", "para": 10, "sent": 1, "present": [0]}, {"u": 36, "kind": "action", "text": "The vault door sighs open.", "para": 10, "sent": 2, "present": [0]}]}