{"scene_id": "s01649", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01649.fountain", "heading": "EXT. VAPORETTO STOP, VENICE - EVENING", "cast": [{"id": 0, "name": "PETRA", "names": ["PETRA"], "gender": "?", "first": 5, "spoke": 4}, {"id": 1, "name": "LEOPOLD", "names": ["LEOPOLD"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "GIULIA", "names": ["GIULIA"], "gender": "?", "first": 5, "spoke": 1}, {"id": 3, "name": "HENRIK", "names": ["HENRIK"], "gender": "?", "first": 5, "spoke": 1}, {"id": 4, "name": "FATIMA", "names": ["FATIMA"], "gender": "?", "first": 5, "spoke": 2}, {"id": 5, "name": "ARTHUR", "names": ["ARTHUR"], "gender": "?", "first": 5, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. VAPORETTO STOP, VENICE - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Gold light on green water.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A floating dock.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A crowd on a pier.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Boats slap at their moorings.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "PETRA, 30s, in a red scarf and sensible boots, drags a rolling suitcase onto the dock, while LEOPOLD, 30s, in a rumpled linen suit, sprints from the opposite end holding a bouquet of crushed daisies, and GIULIA, 70s, a nonna in a black shawl, yells from a balcony, and HENRIK, 20s, a tourist with a map, steps between them and drops it, and FATIMA, 30s, a ticket seller in a blue uniform, leans from her booth to shout about the schedule, and ARTHUR, 50s, a silver-haired gentleman, sips an espresso on a bench, watching it all.", "para": 1, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 6, "kind": "dialogue", "text": "Leopold?", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 7, "kind": "dialogue", "text": "Petra!", "name": "LEOPOLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "dialogue", "text": "Leopoldo! Don't let her go!", "name": "GIULIA", "speaker": 2, "ext": [], "paren": ["from the balcony"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "The last boat leaves in two minutes!", "name": "FATIMA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Excuse me, where is the Rialto?", "name": "HENRIK", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Wherever they are, I'd follow them.", "name": "ARTHUR", "speaker": 5, "ext": [], "paren": ["to Henrik"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "Petra stops.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "Leopold stops, six feet away.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "The daisies drop petals on the planks.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "I was a fool.", "name": "LEOPOLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "You were.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Stay.", "name": "LEOPOLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "The boat.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Ninety seconds!", "name": "FATIMA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Petra looks at the boat.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "At the suitcase.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "At the daisies.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Is that for me?", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "It was a bouquet.", "name": "LEOPOLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "She takes the daisies.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Lets go of the suitcase.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "It rolls into the water.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Nobody notices.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "The boat pulls away.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}]}