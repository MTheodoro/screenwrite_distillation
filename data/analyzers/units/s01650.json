{"scene_id": "s01650", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01650.fountain", "heading": "INT. JURY ROOM, FLOODED COURTHOUSE ANNEX - DAY", "cast": [{"id": 0, "name": "BEATRICE ACHTERBERG", "names": ["BEATRICE ACHTERBERG", "BEATRICE"], "gender": "f", "first": 7, "spoke": 13}, {"id": 1, "name": "DEMETRIUS", "names": ["DEMETRIUS"], "gender": "?", "first": 8, "spoke": 6}, {"id": 2, "name": "LOLA PINEDA", "names": ["LOLA PINEDA", "LOLA"], "gender": "f", "first": 9, "spoke": 5}, {"id": 3, "name": "SAMUEL ODHIAMBO", "names": ["SAMUEL ODHIAMBO", "SAMUEL"], "gender": "m", "first": 10, "spoke": 6}, {"id": 4, "name": "KRZYSZTOF", "names": ["KRZYSZTOF"], "gender": "m", "first": 11, "spoke": 14}, {"id": 5, "name": "BAILIFF GWENDOLYN", "names": ["BAILIFF GWENDOLYN", "GWENDOLYN"], "gender": "?", "first": 50, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. JURY ROOM, FLOODED COURTHOUSE ANNEX - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Ankle-deep water on the floor.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sandbags at the door.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A long table, six chairs.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain drums on a high window.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Five jurors sit with their feet on rungs.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "Nobody has taken a coat off.", "para": 1, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "BEATRICE ACHTERBERG, 60s, foreperson, folds her hands.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "DEMETRIUS, 40s, a bus driver, taps a pen.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "LOLA PINEDA, 20s, a barista, chews her thumbnail.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "SAMUEL ODHIAMBO, 50s, a retired teacher, stares at the ceiling.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "KRZYSZTOF, 30s, a welder, sits with arms crossed.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "The verdict form lies in the middle of the table.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "We should vote.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Nobody moves.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Anyone?", "name": "BEATRICE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Not guilty.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Not guilty.", "name": "LOLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Not guilty.", "name": "SAMUEL", "speaker": 3, "ext": [], "paren": ["after a moment"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Guilty.", "name": "KRZYSZTOF", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Beatrice nods.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Makes a mark.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Her pencil is steady.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Three to one. And I've not voted.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Vote.", "name": "KRZYSZTOF", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "After we talk.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "What's there to talk about?", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "The knife.", "name": "KRZYSZTOF", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "The knife wasn't his.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "The glove was.", "name": "KRZYSZTOF", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Gloves can be borrowed.", "name": "LOLA", "speaker": 2, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "So can knives.", "name": "KRZYSZTOF", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Samuel lowers his gaze from the ceiling.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "He picks a pencil off the floor, wipes it on his sleeve.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "I taught his mother.", "name": "SAMUEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Mr. Odhiambo.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "I'm not saying it should matter.", "name": "SAMUEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "We were told to disregard everything but the evidence.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "I know. I know that.", "name": "SAMUEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "The window rattles.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "A little water laps against the table leg.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "My coffee machine's underwater.", "name": "LOLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Mine's my bus.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Mine's a pay stub.", "name": "KRZYSZTOF", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Nobody laughs.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Beatrice smooths the form with both palms.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "Then we take another look at the knife.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "The door opens.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Water sloshes across the floor.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "BAILIFF GWENDOLYN, 40s, in rubber boots and a yellow slicker, wades in with a plastic crate.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "Lunch. Egg sandwiches.", "name": "GWENDOLYN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "She sets the crate on the table.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "Hands out wrapped sandwiches.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "Skips Krzysztof.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "Gives him a longer look instead.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "What?", "name": "KRZYSZTOF", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "Nothing.", "name": "GWENDOLYN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "dialogue", "text": "You looked at me.", "name": "KRZYSZTOF", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "I look at everyone.", "name": "GWENDOLYN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "action", "text": "She leaves.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "The door clunks shut.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "Beatrice unwraps a sandwich.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "Doesn't eat.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "Lola eats half, wraps the rest.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "Demetrius takes one bite and puts it down.", "para": 13, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "action", "text": "Samuel holds his without opening it.", "para": 13, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "action", "text": "Krzysztof leaves his on the table.", "para": 13, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "dialogue", "text": "I'm going to vote.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5]}, {"u": 69, "kind": "dialogue", "text": "Go ahead.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5]}, {"u": 70, "kind": "dialogue", "text": "Not guilty.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5]}, {"u": 71, "kind": "dialogue", "text": "Four.", "name": "LOLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5]}, {"u": 72, "kind": "dialogue", "text": "Five hundred and fifty dollars a week.", "name": "KRZYSZTOF", "speaker": 4, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "dialogue", "text": "Sorry?", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "dialogue", "text": "That's what I make. That's what he stole from me.", "name": "KRZYSZTOF", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 75, "kind": "dialogue", "text": "You knew the defendant?", "name": "SAMUEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 76, "kind": "dialogue", "text": "I want to see the knife again.", "name": "KRZYSZTOF", "speaker": 4, "ext": [], "paren": ["ignoring this"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 77, "kind": "dialogue", "text": "That requires a note to the judge.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 78, "kind": "dialogue", "text": "Write the note.", "name": "KRZYSZTOF", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 79, "kind": "action", "text": "Beatrice looks at the others.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 80, "kind": "action", "text": "Lola nods.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 81, "kind": "action", "text": "Demetrius shrugs.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 82, "kind": "action", "text": "Samuel sighs and hands her a sheet of paper.", "para": 14, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 83, "kind": "action", "text": "She writes.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 84, "kind": "action", "text": "Folds.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 85, "kind": "action", "text": "Passes it to Samuel, who pushes it back along the table to Krzysztof.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 86, "kind": "action", "text": "He doesn't touch it.", "para": 15, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 87, "kind": "dialogue", "text": "You write it.", "name": "KRZYSZTOF", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 88, "kind": "dialogue", "text": "I did.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 89, "kind": "dialogue", "text": "Then I'll carry it.", "name": "KRZYSZTOF", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 90, "kind": "action", "text": "He takes the note.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 91, "kind": "action", "text": "Stands.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 92, "kind": "action", "text": "Water swirls around his boots.", "para": 16, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 93, "kind": "action", "text": "He wades to the door, and Lola's eyes follow him, wide.", "para": 16, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 94, "kind": "dialogue", "text": "Did he say he knew him?", "name": "LOLA", "speaker": 2, "ext": [], "paren": ["whispering, after he's gone"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 95, "kind": "dialogue", "text": "He said it.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 96, "kind": "dialogue", "text": "Then he should have said so at the start.", "name": "SAMUEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 97, "kind": "dialogue", "text": "He didn't want to be excused.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 98, "kind": "action", "text": "Nobody speaks.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 99, "kind": "action", "text": "Rain on the window.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 100, "kind": "action", "text": "The water, still rising.", "para": 17, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}