{"scene_id": "s01651", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01651.fountain", "heading": "INT. DECOMMISSIONED SUBMARINE, CORPORATE RETREAT - DAY", "cast": [{"id": 0, "name": "BRANDEN", "names": ["BRANDEN"], "gender": "?", "first": 5, "spoke": 8}, {"id": 1, "name": "KIMBERLEIGH", "names": ["KIMBERLEIGH"], "gender": "f", "first": 6, "spoke": 3}, {"id": 2, "name": "DEVONTE", "names": ["DEVONTE"], "gender": "?", "first": 7, "spoke": 3}, {"id": 3, "name": "PRUNELLA", "names": ["PRUNELLA"], "gender": "?", "first": 8, "spoke": 3}, {"id": 4, "name": "GUNNAR", "names": ["GUNNAR"], "gender": "?", "first": 9, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. DECOMMISSIONED SUBMARINE, CORPORATE RETREAT - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A cramped steel corridor.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Pipes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Condensation.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A banner: SYNERGY AT DEPTH.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "BRANDEN, 40s, a regional director in a fleece vest, holds a clipboard.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "KIMBERLEIGH, 30s, in a pastel blazer, adjusts her lanyard.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "DEVONTE, 20s, an intern, hugs a thermos.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "PRUNELLA, 50s, finance, stares at a pressure gauge.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "GUNNAR, 60s, the museum guide, leans against a torpedo tube.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Team! Gather round!", "name": "BRANDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Nobody moves.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "There's nowhere to gather.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Branden, there are five of us.", "name": "KIMBERLEIGH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Five is a team.", "name": "BRANDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Is that gauge supposed to be on red?", "name": "DEVONTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "It's a museum. Nothing is supposed to be anything.", "name": "PRUNELLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "That gauge hasn't worked since 1974.", "name": "GUNNAR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Great. Ice-breaker. Everybody say one word that describes our Q3.", "name": "BRANDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Dynamic.", "name": "KIMBERLEIGH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Damp.", "name": "DEVONTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Overdue.", "name": "PRUNELLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Submerged.", "name": "GUNNAR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Beautiful. Mine is \"Lean.\"", "name": "BRANDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Of course it is.", "name": "PRUNELLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Next: trust fall.", "name": "BRANDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Where?", "name": "DEVONTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Backwards. Off the ladder.", "name": "BRANDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Please don't.", "name": "GUNNAR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Branden, I'd rather do the spreadsheet.", "name": "KIMBERLEIGH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "That's the spirit!", "name": "BRANDEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "He climbs the ladder.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Turns.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Falls.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "The others do not move.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "A very loud clang echoes through the sub.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Okay. That's on me.", "name": "BRANDEN", "speaker": 0, "ext": ["CONT'D"], "paren": ["from the floor"], "dual": false, "present": [0, 1, 2, 3, 4]}]}