{"scene_id": "s01652", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01652.fountain", "heading": "INT. HOUSEBOAT GALLEY - CHRISTMAS EVE - NIGHT", "cast": [{"id": 0, "name": "OLD MAN", "names": ["OLD MAN"], "gender": "?", "first": 5, "spoke": 7}, {"id": 1, "name": "CHIARA", "names": ["CHIARA"], "gender": "f", "first": 7, "spoke": 11}, {"id": 2, "name": "LUCA", "names": ["LUCA"], "gender": "f", "first": 22, "spoke": 5}, {"id": 3, "name": "NONNA SABINA", "names": ["NONNA SABINA", "SABINA"], "gender": "f", "first": 37, "spoke": 10}, {"id": 4, "name": "ENZO", "names": ["ENZO"], "gender": "?", "first": 38, "spoke": 7}, {"id": 5, "name": "^SABINA", "names": ["^SABINA"], "gender": "?", "first": 66, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOUSEBOAT GALLEY - CHRISTMAS EVE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A tiny kitchen rocking gently on a canal.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Steam on the window.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A pot of tomato sauce.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Strings of paper lanterns.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "An OLD MAN, 80s, a cardigan, a wooden spoon, stirs the pot with a trembling hand.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "He hums something Neapolitan.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "CHIARA, 40s, in a coat, steps through the hatch, shaking rain off.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She stops.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Looks at him.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Papa, you're not supposed to be cooking.", "name": "CHIARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I'm not cooking. I'm supervising.", "name": "OLD MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "The sauce is boiling.", "name": "CHIARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "It is supposed to boil.", "name": "OLD MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She crosses and takes the spoon.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "He lets her.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She stirs, tastes, smiles.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Salt.", "name": "CHIARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "It has salt.", "name": "OLD MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "More.", "name": "CHIARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Chiara, I made this sauce before you could walk.", "name": "OLD MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "I know. That's how I know it needs more.", "name": "CHIARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "LUCA, 12, her son, bursts in carrying a plastic reindeer.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "He wears a Santa hat two sizes too big.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Mamma! Nonno! I found the reindeer!", "name": "LUCA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Luca, shoes.", "name": "CHIARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "They're on.", "name": "LUCA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "They're wet.", "name": "CHIARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "It's raining!", "name": "LUCA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Come here. Give me the reindeer.", "name": "OLD MAN", "speaker": 0, "ext": [], "paren": ["to Luca"], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Luca hands it over.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The old man turns it, examines it with great seriousness.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "This reindeer has one antler.", "name": "OLD MAN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "It's a one-antler reindeer.", "name": "LUCA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Then he must be very brave.", "name": "OLD MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Luca grins.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "A voice carries from the hatch.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "NONNA SABINA, 80s, in a black headscarf, climbs down slowly, a tray of pastries held out in front of her.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Enzo! You are in my kitchen!", "name": "SABINA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Sabina, it is a houseboat. It is no one's kitchen.", "name": "ENZO", "speaker": 4, "ext": [], "paren": ["the Old Man, caught"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "It is mine when I say it is.", "name": "SABINA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Mamma, he's only supervising.", "name": "CHIARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "He is always supervising. Forty years of supervising.", "name": "SABINA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "And forty years you ate well.", "name": "ENZO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "I ate when I cooked.", "name": "SABINA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Enzo laughs.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "She sets the tray down.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "She puts her hand to his cheek, briefly, and he turns his face into her palm.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Go see if Zio Tomaso has docked.", "name": "CHIARA", "speaker": 1, "ext": [], "paren": ["to Luca, softly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Can I take the reindeer?", "name": "LUCA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Take it.", "name": "CHIARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Luca runs out.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Enzo and Sabina stand very still.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "It's been a good year, Sabina.", "name": "ENZO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "It has.", "name": "SABINA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "The doctor says --", "name": "ENZO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "I know what the doctor says.", "name": "SABINA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "I'd like to be at the table.", "name": "ENZO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "You will be.", "name": "SABINA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "I'd like to carve.", "name": "ENZO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "You'll supervise.", "name": "SABINA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "Chiara, who has been pretending not to listen, wipes her eyes with the back of her wrist.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "dialogue", "text": "And you. Don't cry in my sauce.", "name": "SABINA", "speaker": 3, "ext": ["CONT'D"], "paren": ["without turning"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "dialogue", "text": "Mamma, I wasn't --", "name": "CHIARA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "dialogue", "text": "Cry on the pasta. It needs the salt.", "name": "SABINA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "Cry on the pasta.", "name": "ENZO", "speaker": 4, "ext": [], "paren": ["simultaneously"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "dialogue", "text": "Cry on the pasta.", "name": "^SABINA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "action", "text": "Chiara laughs, wet and sudden.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "action", "text": "The boat sways.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "action", "text": "The lanterns bob.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "action", "text": "Outside, someone starts to sing.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}]}