{"scene_id": "s01653", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01653.fountain", "heading": "INT. HOLLOW WHALE-BONE MARKET - NIGHT", "cast": [{"id": 0, "name": "ELDRIN", "names": ["ELDRIN"], "gender": "?", "first": 5, "spoke": 8}, {"id": 1, "name": "SYLVETTE", "names": ["SYLVETTE"], "gender": "m", "first": 6, "spoke": 5}, {"id": 2, "name": "GORRAK", "names": ["GORRAK"], "gender": "?", "first": 7, "spoke": 5}, {"id": 3, "name": "THISTLE", "names": ["THISTLE"], "gender": "?", "first": 8, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOLLOW WHALE-BONE MARKET - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cathedral of ribs.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Moonlight slants between them.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Stalls of glass beads, herbs, bottled lightning.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Torches burn blue.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ELDRIN, 40s, a gaunt wizard in a cloak stitched with eyes, stalks between stalls.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "SYLVETTE, 30s, a thief in a green hood, trails him by three paces.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "GORRAK, 50s, a troll in a leather apron, hauls a barrel.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "THISTLE, 10, a barefoot child with a lantern, skips ahead.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Hold your wares! The market is closing!", "name": "ELDRIN", "speaker": 0, "ext": [], "paren": ["to everyone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "He lifts his staff.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Eyes on his cloak snap open, scanning the stalls.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Closing. He says closing like it means something.", "name": "SYLVETTE", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "She slips a vial from a stall and into her sleeve.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "He doesn't turn.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "He stops at a stall.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Taps a jar of black powder.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "This. How much?", "name": "ELDRIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "For him? Ten crowns.", "name": "GORRAK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "For whom?", "name": "ELDRIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "For whoever asks.", "name": "GORRAK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Everyone asks.", "name": "ELDRIN", "speaker": 0, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "He drops coins into a bowl.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Takes the jar.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Holds it up to a torch.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "It glows.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Behind him, Thistle tugs at Gorrak's apron.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Is that a dragon's tooth?", "name": "THISTLE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "It's a very old tooth.", "name": "GORRAK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Can I touch it?", "name": "THISTLE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "No.", "name": "GORRAK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "She does.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Sparks leap from her fingertips.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "She yelps, grinning.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Give that here.", "name": "SYLVETTE", "speaker": 1, "ext": [], "paren": ["to Thistle, low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "It's mine.", "name": "THISTLE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "It's his.", "name": "SYLVETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "He gave it to me.", "name": "THISTLE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "He doesn't give anything to anyone.", "name": "SYLVETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Eldrin turns.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "His eyes, on the cloak, all swivel to Sylvette.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "His real eyes stay on Thistle.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Keep it.", "name": "ELDRIN", "speaker": 0, "ext": [], "paren": ["to Thistle"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Truly?", "name": "THISTLE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "And you may keep the vial.", "name": "ELDRIN", "speaker": 0, "ext": [], "paren": ["to Sylvette"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Sylvette stops cold.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Slowly takes the vial from her sleeve.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "How long have you known?", "name": "SYLVETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Since you took it.", "name": "ELDRIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "He turns away.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "The blue torches gutter.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "High above, between the ribs, a pale shape moves against the moon.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "A vast wing.", "para": 9, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "A slow breath.", "para": 9, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Everybody down.", "name": "GORRAK", "speaker": 2, "ext": [], "paren": ["to the whole market"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "The market goes still.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Is it the whale?", "name": "THISTLE", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "It is the whale's dream.", "name": "ELDRIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "He lowers his staff.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "The shape passes.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "The moonlight returns.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "Somewhere a bead rolls off a stall and clinks.", "para": 11, "sent": 3, "present": [0, 1, 2, 3]}]}