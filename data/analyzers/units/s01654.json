{"scene_id": "s01654", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01654.fountain", "heading": "INT. BAT-GUANO MINE OFFICE - NIGHT", "cast": [{"id": 0, "name": "INSPECTOR ALOYSIUS PRYCE", "names": ["INSPECTOR ALOYSIUS PRYCE", "PRYCE"], "gender": "?", "first": 5, "spoke": 17}, {"id": 1, "name": "PHAEDRA LUND", "names": ["PHAEDRA LUND", "PHAEDRA"], "gender": "m", "first": 8, "spoke": 6}, {"id": 2, "name": "TANAKA", "names": ["TANAKA"], "gender": "m", "first": 10, "spoke": 2}, {"id": 3, "name": "BRIGID", "names": ["BRIGID"], "gender": "?", "first": 11, "spoke": 6}, {"id": 4, "name": "OSWIN", "names": ["OSWIN"], "gender": "m", "first": 12, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. BAT-GUANO MINE OFFICE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A timber shack bolted to a cavern wall.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dripping stalactites visible through a cracked window.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A desk covered in ledgers, a kerosene lantern, a wall of hanging miner's lamps.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The air is thick and sour.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "INSPECTOR ALOYSIUS PRYCE, 50s, tall, thin, a tweed overcoat and a black umbrella, sits at the desk.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "His face is long and grave.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "He turns the pages of a ledger without hurry.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "PHAEDRA LUND, 40s, the mine's owner, in a mud-spattered fur coat, watches him from the doorway.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Her hair is silver, her mouth a razor.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "MR. TANAKA, 60s, the foreman, round-faced and quiet, stands behind the desk with a pencil behind his ear.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "BRIGID, 20s, a clerk with red hair and ink-stained fingers, sorts receipts at a side table.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "OSWIN, 30s, a miner with soot to his eyes, sits on a barrel by the stove.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Mrs. Lund. Your figures are very tidy.", "name": "PRYCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "I pride myself on it.", "name": "PHAEDRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Too tidy.", "name": "PRYCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Is that an accusation?", "name": "PHAEDRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "It's an observation.", "name": "PRYCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "We keep good books, Inspector.", "name": "TANAKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Who keeps them?", "name": "PRYCE", "speaker": 0, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "I do, sir.", "name": "BRIGID", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Alone?", "name": "PRYCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Mostly.", "name": "BRIGID", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Who checks your arithmetic?", "name": "PRYCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Mr. Tanaka.", "name": "BRIGID", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Mr. Tanaka, who checks yours?", "name": "PRYCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Mrs. Lund.", "name": "TANAKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "And who checks hers?", "name": "PRYCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "God, Inspector.", "name": "PHAEDRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Pryce nods.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Closes the ledger.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Opens another.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Oswin. You're the miner.", "name": "PRYCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Yes, sir.", "name": "OSWIN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "How many tonnes did you haul last week?", "name": "PRYCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Forty.", "name": "OSWIN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "The ledger says sixty.", "name": "PRYCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Sixty is what they wrote.", "name": "OSWIN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Oswin.", "name": "PHAEDRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "I only count the barrows, ma'am.", "name": "OSWIN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Pryce looks at Phaedra.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "For a moment his face is the face of a priest, very patient.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "The kerosene lantern hisses.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Mrs. Lund, I'm going to ask Miss Brigid a question. You're welcome to stay.", "name": "PRYCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "I wouldn't miss it.", "name": "PHAEDRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Miss Brigid. Where is the guano going?", "name": "PRYCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "To the dock. And then to a ship.", "name": "BRIGID", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "Which ship?", "name": "PRYCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "The Margaret Rose.", "name": "BRIGID", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "And where does the Margaret Rose go?", "name": "PRYCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "To Liverpool.", "name": "BRIGID", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "It does not.", "name": "PRYCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "A drop of water falls from a stalactite onto the roof.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "The Margaret Rose has been at the bottom of the Bay of Biscay since March.", "name": "PRYCE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Brigid's pen stops.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Tanaka's pencil slips from behind his ear.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "Oswin stands up from the barrel, slowly.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Phaedra, still in the doorway, smiles.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "Then who, Inspector, has been buying my guano?", "name": "PHAEDRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}