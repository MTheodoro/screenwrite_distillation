{"scene_id": "s01655", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01655.fountain", "heading": "INT. STALLED ELEVATOR, LAW FIRM TOWER - NIGHT", "cast": [{"id": 0, "name": "MARGUERITE DUVAL", "names": ["MARGUERITE DUVAL", "MARGUERITE"], "gender": "f", "first": 5, "spoke": 11}, {"id": 1, "name": "ROLAND CHASE", "names": ["ROLAND CHASE", "ROLAND"], "gender": "m", "first": 6, "spoke": 9}, {"id": 2, "name": "ELSPETH", "names": ["ELSPETH"], "gender": "f", "first": 7, "spoke": 8}, {"id": 3, "name": "JAMAL", "names": ["JAMAL"], "gender": "?", "first": 8, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. STALLED ELEVATOR, LAW FIRM TOWER - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A brushed steel box.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Four people.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A dim emergency light.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The floor indicator reads 14 and does not change.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MARGUERITE DUVAL, 50s, opposing counsel, in a navy suit, holds a briefcase to her chest.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "ROLAND CHASE, 40s, lead attorney, loosens his tie.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "ELSPETH, 30s, a junior associate, sits on the floor with her laptop.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "JAMAL, 50s, the building's maintenance man, presses the intercom.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Roland, I'm not signing anything in an elevator.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "You don't have a choice.", "name": "ROLAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I always have a choice.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Name one.", "name": "ROLAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "I can wait.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "For what?", "name": "ROLAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "For you to run out of air.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "There's plenty of air.", "name": "ELSPETH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "There's plenty of air. The cables are the problem.", "name": "JAMAL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Mr. Jamal, how long?", "name": "ROLAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Hour. Maybe two.", "name": "JAMAL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Two hours?", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "It's in the contract, Marguerite.", "name": "ELSPETH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "The elevator?", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "The deadline. Midnight.", "name": "ELSPETH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "It's eleven-twenty.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": ["checking watch"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "You see. You see.", "name": "ROLAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "I see a man who parked his deal in an elevator.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Dispatch, we've got a stuck car on fourteen. Four occupants. Two lawyers, one associate, one me.", "name": "JAMAL", "speaker": 3, "ext": [], "paren": ["into intercom"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "The intercom crackles.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Jamal listens, nods.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "What did they say?", "name": "ELSPETH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Twenty minutes. They always say twenty minutes.", "name": "JAMAL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Elspeth, print the settlement.", "name": "ROLAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "There's no printer.", "name": "ELSPETH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Then write it by hand.", "name": "ROLAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "In what?", "name": "ELSPETH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Anything.", "name": "ROLAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Elspeth opens her laptop.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Marguerite snatches it, and Roland lunges, and the laptop tumbles between them, bounces off the wall, and slides to Jamal's feet.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "He picks it up and holds it carefully, like a baby.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Folks, I got a rule in my elevators.", "name": "JAMAL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "This isn't your elevator --", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Give it to me --", "name": "ROLAND", "speaker": 1, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "It's mine, actually --", "name": "ELSPETH", "speaker": 2, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "No fighting. No yelling. No lawyering.", "name": "JAMAL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "The three of them stop.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "The emergency light flickers.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "A groan from the cables above, deep and long.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "The car drops two inches.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Everyone grabs a rail.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Marguerite drops her briefcase.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Roland sits down hard.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Elspeth screams, once, short and sharp.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Jamal alone remains standing.", "para": 5, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "That's the cable settling.", "name": "JAMAL", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "That's the cable settling?", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "That's what it sounds like when it's settling.", "name": "JAMAL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "And when it's not?", "name": "ELSPETH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "You won't have to ask.", "name": "JAMAL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "Roland retrieves a pen from his pocket.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "Marguerite, after a moment, holds out her hand.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "He gives it to her.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "She opens her briefcase, draws a thick document, and signs the last page on the wall of the elevator.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "The ink bleeds into the steel.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "Witness, Mr. Jamal.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "I witness.", "name": "JAMAL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "He signs.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "Hands the pen back.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "The car shudders.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "The indicator light flickers.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "14 becomes 13.", "para": 8, "sent": 4, "present": [0, 1, 2, 3]}]}