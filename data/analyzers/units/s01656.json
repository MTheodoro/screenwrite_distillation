{"scene_id": "s01656", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01656.fountain", "heading": "INT. ICE RINK RESURFACER GARAGE - 3 A.M.", "cast": [{"id": 0, "name": "COACH DOLORES", "names": ["COACH DOLORES", "DOLORES"], "gender": "?", "first": 5, "spoke": 12}, {"id": 1, "name": "RAFFERTY", "names": ["RAFFERTY"], "gender": "m", "first": 6, "spoke": 5}, {"id": 2, "name": "KWAME", "names": ["KWAME"], "gender": "m", "first": 7, "spoke": 3}, {"id": 3, "name": "TULLY", "names": ["TULLY"], "gender": "m", "first": 8, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. ICE RINK RESURFACER GARAGE - 3 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "A concrete bay.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fluorescent tubes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A Zamboni steaming in the corner.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A cracked radio on a shelf plays a farm report.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "COACH DOLORES, 50s, in a stained team jacket, sits on an overturned bucket with a clipboard.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "RAFFERTY, 30s, the goalie, taping his stick, doesn't look up.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "KWAME, 20s, a rookie forward, hunches over a protein shake.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "TULLY, 40s, the driver, polishes the Zamboni's blade with a rag.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "We lost by seven.", "name": "DOLORES", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Nobody answers.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "You let in five.", "name": "DOLORES", "speaker": 0, "ext": ["CONT'D"], "paren": ["to Rafferty"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Four. One was an own goal.", "name": "RAFFERTY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Who was it?", "name": "DOLORES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Kwame.", "name": "RAFFERTY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "It hit my skate!", "name": "KWAME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "It hit the net after it hit your skate.", "name": "RAFFERTY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "That's not my fault!", "name": "KWAME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Kwame. Sit.", "name": "DOLORES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Kwame sits.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "The shake slops.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Tully tosses him a rag.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "He catches it.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Wipes.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "You can pay me back in wins.", "name": "TULLY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "When?", "name": "KWAME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "When you stop scoring on yourself.", "name": "TULLY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Rafferty snorts.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Kwame looks at him.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "They both grin.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Dolores glances up from the clipboard.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "That's the first smile I've seen since February.", "name": "DOLORES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "We've been losing since February.", "name": "RAFFERTY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Since October, really.", "name": "DOLORES", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Coach, is there a game tomorrow?", "name": "TULLY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "There's a game every day, Tully.", "name": "DOLORES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Is there a win?", "name": "TULLY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Not yet.", "name": "DOLORES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "She sets down the clipboard.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Stands.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Her knees crack.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "She crosses to the Zamboni, runs a hand along its flank.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Listen. Nobody's losing sleep tonight. Go home.", "name": "DOLORES", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the whole garage"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "You first, Coach.", "name": "RAFFERTY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "I'm not tired.", "name": "DOLORES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "You're sitting on a bucket.", "name": "TULLY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Best seat in the building.", "name": "DOLORES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Kwame stands, stretches, claps Rafferty's shoulder.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Rafferty swats his hand away.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "They bump chests, hard, then lean into each other and shove, laughing, until Tully swings the rag between them like a referee's flag and Dolores, watching all three, shakes her head.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Idiots.", "name": "DOLORES", "speaker": 0, "ext": ["CONT'D"], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Tully flicks the Zamboni's engine.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "It coughs.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Steam fills the garage.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}]}