{"scene_id": "s01657", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01657.fountain", "heading": "INT. DUBBING STUDIO BOOTH - NIGHT", "cast": [{"id": 0, "name": "IRENKA VESELY", "names": ["IRENKA VESELY", "IRENKA"], "gender": "f", "first": 9, "spoke": 18}], "units": [{"u": 0, "kind": "heading", "text": "INT. DUBBING STUDIO BOOTH - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A padded booth the size of a closet.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Acoustic foam in grey waves.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A microphone on a boom arm.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A music stand holding a script, pages curling.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A small red light on the wall, dark for now.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "Beyond a thick glass pane, an empty control room.", "para": 1, "sent": 0, "present": []}, {"u": 7, "kind": "action", "text": "A mixing desk glows green.", "para": 1, "sent": 1, "present": []}, {"u": 8, "kind": "action", "text": "No one sits behind it.", "para": 1, "sent": 2, "present": []}, {"u": 9, "kind": "action", "text": "IRENKA VESELY, 78, perches on a stool, headphones around her neck, lace collar buttoned to the chin.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "Silver hair pinned back.", "para": 2, "sent": 1, "present": [0]}, {"u": 11, "kind": "action", "text": "Heavy rings on both hands.", "para": 2, "sent": 2, "present": [0]}, {"u": 12, "kind": "action", "text": "She has the kind of face that was once on posters.", "para": 2, "sent": 3, "present": [0]}, {"u": 13, "kind": "action", "text": "A monitor on the wall shows a silent black-and-white clip: a young woman's face, laughing.", "para": 3, "sent": 0, "present": [0]}, {"u": 14, "kind": "action", "text": "Irenka watches it.", "para": 4, "sent": 0, "present": [0]}, {"u": 15, "kind": "action", "text": "She does not laugh.", "para": 4, "sent": 1, "present": [0]}, {"u": 16, "kind": "action", "text": "She reaches over.", "para": 5, "sent": 0, "present": [0]}, {"u": 17, "kind": "action", "text": "Presses a button on a small tape deck beside the stand.", "para": 5, "sent": 1, "present": [0]}, {"u": 18, "kind": "action", "text": "It clicks.", "para": 5, "sent": 2, "present": [0]}, {"u": 19, "kind": "dialogue", "text": "\"I never said I loved you. I said I would stay.\"", "name": "IRENKA", "speaker": 0, "ext": ["V.O."], "paren": ["tape, thirty years younger, brisk"], "dual": false, "present": [0]}, {"u": 20, "kind": "action", "text": "Irenka listens.", "para": 6, "sent": 0, "present": [0]}, {"u": 21, "kind": "action", "text": "Nods slowly.", "para": 6, "sent": 1, "present": [0]}, {"u": 22, "kind": "action", "text": "Presses stop.", "para": 6, "sent": 2, "present": [0]}, {"u": 23, "kind": "dialogue", "text": "Too quick.", "name": "IRENKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 24, "kind": "action", "text": "She rewinds the tape.", "para": 7, "sent": 0, "present": [0]}, {"u": 25, "kind": "action", "text": "Plays it again.", "para": 7, "sent": 1, "present": [0]}, {"u": 26, "kind": "dialogue", "text": "\"I never said I loved you. I said I would stay.\"", "name": "IRENKA", "speaker": 0, "ext": ["V.O."], "paren": ["tape"], "dual": false, "present": [0]}, {"u": 27, "kind": "dialogue", "text": "Still too quick.", "name": "IRENKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 28, "kind": "action", "text": "She switches off the deck.", "para": 8, "sent": 0, "present": [0]}, {"u": 29, "kind": "action", "text": "Slips the headphones on.", "para": 8, "sent": 1, "present": [0]}, {"u": 30, "kind": "action", "text": "Leans toward the microphone.", "para": 8, "sent": 2, "present": [0]}, {"u": 31, "kind": "action", "text": "The red light glows on.", "para": 8, "sent": 3, "present": [0]}, {"u": 32, "kind": "dialogue", "text": "\"I never said I loved you.\"", "name": "IRENKA", "speaker": 0, "ext": ["CONT'D"], "paren": ["reading"], "dual": false, "present": [0]}, {"u": 33, "kind": "action", "text": "Her voice cracks.", "para": 9, "sent": 0, "present": [0]}, {"u": 34, "kind": "action", "text": "She stops.", "para": 9, "sent": 1, "present": [0]}, {"u": 35, "kind": "action", "text": "Clears her throat.", "para": 9, "sent": 2, "present": [0]}, {"u": 36, "kind": "action", "text": "Looks up at the monitor.", "para": 9, "sent": 3, "present": [0]}, {"u": 37, "kind": "action", "text": "The young face laughs again.", "para": 9, "sent": 4, "present": [0]}, {"u": 38, "kind": "dialogue", "text": "She was never in a hurry.", "name": "IRENKA", "speaker": 0, "ext": ["CONT'D"], "paren": ["to herself"], "dual": false, "present": [0]}, {"u": 39, "kind": "action", "text": "She tries again.", "para": 10, "sent": 0, "present": [0]}, {"u": 40, "kind": "dialogue", "text": "\"I never said I loved you. I said --\"", "name": "IRENKA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 41, "kind": "action", "text": "She stops.", "para": 11, "sent": 0, "present": [0]}, {"u": 42, "kind": "action", "text": "Pulls the headphones down.", "para": 11, "sent": 1, "present": [0]}, {"u": 43, "kind": "action", "text": "Sits in the silence for a long moment.", "para": 11, "sent": 2, "present": [0]}, {"u": 44, "kind": "dialogue", "text": "You always did make me say it twice.", "name": "IRENKA", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the glass"], "dual": false, "present": [0]}, {"u": 45, "kind": "action", "text": "No answer.", "para": 12, "sent": 0, "present": [0]}, {"u": 46, "kind": "action", "text": "The green desk glows.", "para": 12, "sent": 1, "present": [0]}, {"u": 47, "kind": "action", "text": "She reaches for the deck again.", "para": 13, "sent": 0, "present": [0]}, {"u": 48, "kind": "action", "text": "Presses a different button.", "para": 13, "sent": 1, "present": [0]}, {"u": 49, "kind": "action", "text": "A second tape hisses.", "para": 13, "sent": 2, "present": [0]}, {"u": 50, "kind": "dialogue", "text": "\"Pavel, put that down. We are rolling.\"", "name": "IRENKA", "speaker": 0, "ext": ["V.O."], "paren": ["tape, much younger, laughing"], "dual": false, "present": [0]}, {"u": 51, "kind": "action", "text": "A man's cough on the tape, nothing more, then the clink of a glass.", "para": 14, "sent": 0, "present": [0]}, {"u": 52, "kind": "action", "text": "She smiles.", "para": 14, "sent": 1, "present": [0]}, {"u": 53, "kind": "action", "text": "The smile slips.", "para": 14, "sent": 2, "present": [0]}, {"u": 54, "kind": "dialogue", "text": "\"Take one. Irenka Vesely. 'The Quiet Hour.'\"", "name": "IRENKA", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": ["tape"], "dual": false, "present": [0]}, {"u": 55, "kind": "action", "text": "The tape hisses.", "para": 15, "sent": 0, "present": [0]}, {"u": 56, "kind": "action", "text": "Ends.", "para": 15, "sent": 1, "present": [0]}, {"u": 57, "kind": "action", "text": "She sits with the deck, hands folded around it, as if keeping it warm.", "para": 15, "sent": 2, "present": [0]}, {"u": 58, "kind": "dialogue", "text": "Take one.", "name": "IRENKA", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0]}, {"u": 59, "kind": "action", "text": "She sets the deck on the floor.", "para": 16, "sent": 0, "present": [0]}, {"u": 60, "kind": "action", "text": "Stands.", "para": 16, "sent": 1, "present": [0]}, {"u": 61, "kind": "action", "text": "Her knees crack.", "para": 16, "sent": 2, "present": [0]}, {"u": 62, "kind": "action", "text": "She grips the mic stand.", "para": 16, "sent": 3, "present": [0]}, {"u": 63, "kind": "action", "text": "She puts on the headphones.", "para": 17, "sent": 0, "present": [0]}, {"u": 64, "kind": "action", "text": "Faces the microphone.", "para": 17, "sent": 1, "present": [0]}, {"u": 65, "kind": "action", "text": "Straightens her spine as if a director stood behind her.", "para": 17, "sent": 2, "present": [0]}, {"u": 66, "kind": "dialogue", "text": "Ready, everyone?", "name": "IRENKA", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the room"], "dual": false, "present": [0]}, {"u": 67, "kind": "action", "text": "Nobody answers.", "para": 18, "sent": 0, "present": [0]}, {"u": 68, "kind": "action", "text": "She smiles, tight and brave.", "para": 18, "sent": 1, "present": [0]}, {"u": 69, "kind": "dialogue", "text": "Ready when you are.", "name": "IRENKA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 70, "kind": "action", "text": "The red light blinks on.", "para": 19, "sent": 0, "present": [0]}, {"u": 71, "kind": "action", "text": "She takes a long breath.", "para": 19, "sent": 1, "present": [0]}, {"u": 72, "kind": "action", "text": "Eyes on the monitor.", "para": 19, "sent": 2, "present": [0]}, {"u": 73, "kind": "action", "text": "On the young face.", "para": 19, "sent": 3, "present": [0]}, {"u": 74, "kind": "action", "text": "On the young smile.", "para": 19, "sent": 4, "present": [0]}, {"u": 75, "kind": "dialogue", "text": "\"I never said I loved you.\"", "name": "IRENKA", "speaker": 0, "ext": ["CONT'D"], "paren": ["slow, warm, barely a whisper"], "dual": false, "present": [0]}, {"u": 76, "kind": "action", "text": "A beat.", "para": 20, "sent": 0, "present": [0]}, {"u": 77, "kind": "action", "text": "The young face on the monitor turns toward an unseen man and smiles.", "para": 20, "sent": 1, "present": [0]}, {"u": 78, "kind": "dialogue", "text": "\"I said I would stay.\"", "name": "IRENKA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 79, "kind": "action", "text": "The red light blinks off.", "para": 21, "sent": 0, "present": [0]}, {"u": 80, "kind": "action", "text": "Silence.", "para": 21, "sent": 1, "present": [0]}, {"u": 81, "kind": "action", "text": "She doesn't move.", "para": 22, "sent": 0, "present": [0]}, {"u": 82, "kind": "action", "text": "Her hands are steady.", "para": 22, "sent": 1, "present": [0]}, {"u": 83, "kind": "action", "text": "Her shoulders are not.", "para": 22, "sent": 2, "present": [0]}, {"u": 84, "kind": "dialogue", "text": "It took me sixty years.", "name": "IRENKA", "speaker": 0, "ext": ["CONT'D"], "paren": ["a whisper"], "dual": false, "present": [0]}, {"u": 85, "kind": "action", "text": "The monitor fades to black.", "para": 23, "sent": 0, "present": [0]}, {"u": 86, "kind": "action", "text": "She stays, listening to the room.", "para": 23, "sent": 1, "present": [0]}, {"u": 87, "kind": "action", "text": "She gathers her handbag, her cardigan, her gloves.", "para": 24, "sent": 0, "present": [0]}, {"u": 88, "kind": "action", "text": "At the door she pauses.", "para": 24, "sent": 1, "present": [0]}, {"u": 89, "kind": "action", "text": "Looks back at the empty control room, the glowing desk.", "para": 24, "sent": 2, "present": [0]}, {"u": 90, "kind": "dialogue", "text": "I'll be here tomorrow.", "name": "IRENKA", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the booth"], "dual": false, "present": [0]}, {"u": 91, "kind": "action", "text": "She opens the door.", "para": 25, "sent": 0, "present": [0]}, {"u": 92, "kind": "action", "text": "Light from the corridor spills over her shoulders.", "para": 25, "sent": 1, "present": [0]}, {"u": 93, "kind": "action", "text": "She steps out, leaving the booth dark.", "para": 25, "sent": 2, "present": [0]}, {"u": 94, "kind": "action", "text": "The tape deck, at her feet, clicks on by itself.", "para": 26, "sent": 0, "present": [0]}, {"u": 95, "kind": "dialogue", "text": "\"Take two.\"", "name": "IRENKA", "speaker": 0, "ext": ["V.O."], "paren": ["tape, faint"], "dual": false, "present": [0]}]}