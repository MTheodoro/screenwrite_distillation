{"scene_id": "s01658", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01658.fountain", "heading": "INT. FARRINER'S BAKERY, PUDDING LANE - NIGHT (1666)", "cast": [{"id": 0, "name": "THOMAS FARRINER", "names": ["THOMAS FARRINER", "THOMAS"], "gender": "m", "first": 5, "spoke": 4}, {"id": 1, "name": "HANNAH", "names": ["HANNAH"], "gender": "m", "first": 6, "spoke": 0}, {"id": 2, "name": "PEG", "names": ["PEG"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "JOSIAH", "names": ["JOSIAH"], "gender": "m", "first": 8, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. FARRINER'S BAKERY, PUDDING LANE - NIGHT (1666)", "present": []}, {"u": 1, "kind": "action", "text": "Low beams.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A great brick oven, banked low.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Flour dusting the floor.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A candle on a tin plate.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "THOMAS FARRINER, 40s, a baker with burn scars on both forearms, rakes the oven's embers.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Behind him, HANNAH, 30s, his wife, folds dough with hard, even strokes.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "PEG, 10, their daughter, sits on a barrel with a rag doll.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "JOSIAH, 20s, his apprentice, yawns against the doorframe.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Thomas rakes.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Hannah folds.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Peg hums.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Josiah slumps lower.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Josiah.", "name": "THOMAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Yes, master.", "name": "JOSIAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "The faggots.", "name": "THOMAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Stacked, master.", "name": "JOSIAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Where?", "name": "THOMAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "By the oven.", "name": "JOSIAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Thomas stops raking.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Slowly turns to look.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "A stack of dry kindling leans against the oven's side, close enough to scorch.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "A single ember has already caught the edge of a bundle.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Hannah looks.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Peg looks.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Josiah looks.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Nobody speaks.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Thomas drops the rake.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Hannah drops the dough.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Josiah dives for the bucket, Peg screams, and Thomas smothers the bundle with his coat while Hannah beats at the flames with her apron, and the four of them stamp, slap, and gasp until the last spark dies and smoke curls up through the beams.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Thomas lifts his scorched coat.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Josiah sets the bucket down.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Open the shutters.", "name": "THOMAS", "speaker": 0, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Aye.", "name": "JOSIAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Hannah gathers Peg into her skirts.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Her hands shake.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Thomas stares at the oven for a long time.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Then, deliberately, he rakes out the last of the embers, and douses them, one by one.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}]}