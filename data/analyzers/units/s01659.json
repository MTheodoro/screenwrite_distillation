{"scene_id": "s01659", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01659.fountain", "heading": "INT. MARBLE FUNERAL PARLOR - DAY", "cast": [{"id": 0, "name": "UNCLE BASIL", "names": ["UNCLE BASIL"], "gender": "?", "first": 5, "spoke": 4}, {"id": 1, "name": "TESS", "names": ["TESS"], "gender": "m", "first": 6, "spoke": 8}, {"id": 2, "name": "MONTY", "names": ["MONTY"], "gender": "f", "first": 7, "spoke": 4}, {"id": 3, "name": "ZELDA", "names": ["ZELDA"], "gender": "f", "first": 8, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. MARBLE FUNERAL PARLOR - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Soft carpet.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A hush.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wreaths of white lilies on stands.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "At the front, a closed mahogany coffin.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "UNCLE BASIL, 60s, in a black suit, greets guests at the door.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "TESS, 30s, in a black dress and sunglasses, shakes his hand.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "MONTY, 40s, in a rumpled black suit, follows her in.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "ZELDA, 50s, in a veiled hat, sits in the front row, hands folded.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Thank you for coming. Thank you.", "name": "UNCLE BASIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "So sorry for your loss.", "name": "TESS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Thank you, dear.", "name": "UNCLE BASIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "He's in position.", "name": "TESS", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Who?", "name": "UNCLE BASIL", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Uncle Basil.", "name": "TESS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "That's me, dear.", "name": "UNCLE BASIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "I know.", "name": "TESS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Tess, what are you doing?", "name": "MONTY", "speaker": 2, "ext": [], "paren": ["hushed"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Quiet, Monty.", "name": "TESS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "They walk down the aisle.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Zelda turns her veiled head.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Tess. Monty. Sit.", "name": "ZELDA", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "They sit.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Zelda leans in.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Is everything in place?", "name": "ZELDA", "speaker": 3, "ext": ["CONT'D"], "paren": ["to Monty"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Everything's in place.", "name": "MONTY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "And the vault?", "name": "ZELDA", "speaker": 3, "ext": [], "paren": ["to Tess"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Monty has the vault.", "name": "TESS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "I have the vault.", "name": "MONTY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Good. When the organ starts, you move.", "name": "ZELDA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "And Uncle Basil?", "name": "TESS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Basil is the one who's dead.", "name": "ZELDA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Tess blinks.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Monty chokes.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Uncle Basil is at the door.", "name": "MONTY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "That is Basil's twin. Basilius. They've been swapping for decades.", "name": "ZELDA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Then who's in the coffin?", "name": "TESS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "The plan.", "name": "ZELDA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "The organ begins.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "A slow, mournful hymn.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Everyone in the room stands.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Zelda lifts her veil, revealing a very small smile.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Now.", "name": "ZELDA", "speaker": 3, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "The coffin lid opens by itself.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}]}