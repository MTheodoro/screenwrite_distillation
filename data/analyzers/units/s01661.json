{"scene_id": "s01661", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01661.fountain", "heading": "INT. MRI SUITE, UNIVERSITY HOSPITAL - NIGHT", "cast": [{"id": 0, "name": "AUGUSTINE LEHMANN", "names": ["AUGUSTINE LEHMANN", "DR. LEHMANN"], "gender": "?", "first": 5, "spoke": 10}, {"id": 1, "name": "NIAMH BRENNAN", "names": ["NIAMH BRENNAN", "NIAMH"], "gender": "f", "first": 8, "spoke": 10}, {"id": 2, "name": "^NIAMH", "names": ["^NIAMH"], "gender": "?", "first": 53, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. MRI SUITE, UNIVERSITY HOSPITAL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cold, white room dominated by the great ring of the scanner.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A narrow table slides in and out of its throat.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Behind a window, a console glows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A low mechanical thrum fills the air, like the breath of something asleep.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. AUGUSTINE LEHMANN, 50s, white coat, wire glasses, sits at the console behind the window.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "His fingers rest on the keys.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "He watches the monitors with the stillness of a man used to bad news.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "NIAMH BRENNAN, 30s, lies on the scanner table in a paper gown, a blanket across her knees, a headset over her ears.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Her eyes are closed.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Her hands are folded on her stomach.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He presses a button.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "The table slides her slowly into the ring.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "The thrum becomes a rhythmic knocking.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Louder.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Louder.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He leans to the intercom.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Niamh, can you hear me?", "name": "DR. LEHMANN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "I hear a jackhammer.", "name": "NIAMH", "speaker": 1, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "That's normal. Keep still.", "name": "DR. LEHMANN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Is it supposed to hurt?", "name": "NIAMH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "No.", "name": "DR. LEHMANN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Then why does it feel like it's looking back at me?", "name": "NIAMH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "He studies the monitor.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "A grey slice of brain scrolls across the screen.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "He freezes it.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Magnifies a small, dark shape.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Frowns.", "para": 6, "sent": 4, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "He does not tell her.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "We're nearly done.", "name": "DR. LEHMANN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "You said that ten minutes ago.", "name": "NIAMH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "I meant it then too.", "name": "DR. LEHMANN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "She laughs, one short breath.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "The scanner knocks.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "He types something.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Deletes it.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Types again.", "para": 8, "sent": 4, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "She lifts one hand slightly.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Opens her fingers.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Doctor?", "name": "NIAMH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Yes?", "name": "DR. LEHMANN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "When you look at the pictures, what do you see?", "name": "NIAMH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "I see a very interesting brain.", "name": "DR. LEHMANN", "speaker": 0, "ext": [], "paren": ["carefully"], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Is it interesting good, or interesting bad?", "name": "NIAMH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "He doesn't answer.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "His hand hovers over the intercom.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "The table slides her out of the ring, slowly, until she is lying in the open white light.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "He rises.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Steps through the door.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "Crosses to her side.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "She opens her eyes and stares up at him.", "para": 11, "sent": 3, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "There's something, isn't there.", "name": "NIAMH", "speaker": 1, "ext": ["CONT'D"], "paren": ["softly"], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "There's something we need to discuss.", "name": "DR. LEHMANN", "speaker": 0, "ext": [], "paren": ["at the same moment"], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "There's something, isn't there.", "name": "^NIAMH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Neither speaks.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "The scanner sighs and falls silent.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "She takes off the headset.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "He offers his hand.", "para": 12, "sent": 3, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "She takes it, and sits up with great care, the blanket sliding to the floor.", "para": 12, "sent": 4, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "Tell me here. Not in an office.", "name": "NIAMH", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "He nods.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "Pulls up a stool.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "Sits beside her, level with her eyes.", "para": 13, "sent": 2, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "I'd like to run one more sequence.", "name": "DR. LEHMANN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "And then?", "name": "NIAMH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "And then I will tell you everything I know.", "name": "DR. LEHMANN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "She nods.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "Lies back down.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "He steps behind the window again.", "para": 14, "sent": 2, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "The ring starts to knock.", "para": 14, "sent": 3, "present": [0, 1, 2]}]}