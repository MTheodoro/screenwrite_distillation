{"scene_id": "s01662", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01662.fountain", "heading": "INT. MIRROR-MAKER'S WORKSHOP - TWILIGHT", "cast": [{"id": 0, "name": "GIRL", "names": ["GIRL"], "gender": "?", "first": 3, "spoke": 5}, {"id": 1, "name": "ORRIN", "names": ["ORRIN"], "gender": "?", "first": 6, "spoke": 8}, {"id": 2, "name": "TAMSIN", "names": ["TAMSIN"], "gender": "?", "first": 21, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. MIRROR-MAKER'S WORKSHOP - TWILIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Frames, silvered glass, hanging bells.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A hundred mirrors lean against the walls, each reflecting a slightly different room.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A GIRL, 12, ragged hem, carries a lantern between the mirrors.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "She stops before the largest, an oval taller than a door.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "dialogue", "text": "Hello?", "name": "GIRL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 6, "kind": "dialogue", "text": "Hello yourself.", "name": "ORRIN", "speaker": 1, "ext": ["O.S."], "paren": ["from within the glass"], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "She jumps.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "The lantern swings.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "In the mirror, her reflection does not move.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Who's there?", "name": "GIRL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Mirror-keeper. Orrin. And you?", "name": "ORRIN", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I don't know.", "name": "GIRL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Everyone knows their name.", "name": "ORRIN", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "I forgot it. Last winter.", "name": "GIRL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "A pause.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "The reflection tilts its head.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Come closer. Let me look.", "name": "ORRIN", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She steps forward.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Presses her palm to the cool glass.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "The reflection mirrors it, and a pale hand on the other side lines up with hers.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Tamsin.", "name": "ORRIN", "speaker": 1, "ext": ["O.S.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "What?", "name": "GIRL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Your name. It's Tamsin. I have it here.", "name": "ORRIN", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The girl stares.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Her eyes fill.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "How do you know?", "name": "TAMSIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Mirrors keep what people lose.", "name": "ORRIN", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "She laughs, wet and astonished.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Tamsin.", "name": "TAMSIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Say it again.", "name": "ORRIN", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Tamsin. Tamsin.", "name": "TAMSIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The mirror fogs, then clears.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "In the glass, only her face remains, smiling.", "para": 7, "sent": 1, "present": [0, 1, 2]}]}