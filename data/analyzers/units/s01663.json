{"scene_id": "s01663", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01663.fountain", "heading": "INT. DRAGON DENTIST'S WAITING CAVE - DAY", "cast": [{"id": 0, "name": "SMOLDER", "names": ["SMOLDER"], "gender": "?", "first": 3, "spoke": 0}, {"id": 1, "name": "PAINLESS", "names": ["PAINLESS"], "gender": "?", "first": 3, "spoke": 0}, {"id": 2, "name": "PERPETUA THORNE", "names": ["PERPETUA THORNE", "PERPETUA"], "gender": "?", "first": 4, "spoke": 12}, {"id": 3, "name": "GRIMBALD", "names": ["GRIMBALD"], "gender": "?", "first": 6, "spoke": 13}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRAGON DENTIST'S WAITING CAVE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A vaulted cavern lined with velvet chairs scaled for giants.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A rack of tattered magazines titled \"Hoard Digest.\"", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A wall plaque: DR. SMOLDER, D.D.S. PAINLESS (FOR YOU).", "para": 0, "sent": 2, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "PERPETUA THORNE, 40s, a knight in battered plate, sits on a chair far too large, feet dangling.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 5, "kind": "action", "text": "She clutches a gauntlet in her lap and stares at the cavern ceiling.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "GRIMBALD, 60s, a very small, very old gnome with a clipboard and spectacles, bustles from a door at the rear.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Dame Perpetua?", "name": "GRIMBALD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "That's me.", "name": "PERPETUA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "The doctor will see you now.", "name": "GRIMBALD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Is it going to hurt?", "name": "PERPETUA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Dame Perpetua, you slew a basilisk last spring.", "name": "GRIMBALD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Yes.", "name": "PERPETUA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Surely you can manage a cavity.", "name": "GRIMBALD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "A basilisk has no drill.", "name": "PERPETUA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "That is true.", "name": "GRIMBALD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "She stands.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Her armor clanks.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "She follows him down a corridor of glowing crystal, toward an immense, steaming doorway.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Grimbald?", "name": "PERPETUA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Yes, Dame?", "name": "GRIMBALD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "How many knights have you walked through here?", "name": "PERPETUA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Seven hundred and twelve.", "name": "GRIMBALD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "How many came out?", "name": "PERPETUA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "All of them.", "name": "GRIMBALD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Really?", "name": "PERPETUA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Some with fewer teeth.", "name": "GRIMBALD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "He pauses at the doorway and pats her hand, which barely reaches his shoulder.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "But everyone leaves smiling.", "name": "GRIMBALD", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "A great rumble from within.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "The floor trembles.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "That sounded hungry.", "name": "PERPETUA", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "That is just the doctor's professional stomach.", "name": "GRIMBALD", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Grimbald, I may faint.", "name": "PERPETUA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Dame Perpetua, I will faint with you.", "name": "GRIMBALD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "She squares her shoulders.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Takes a breath.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Then lead on, small friend.", "name": "PERPETUA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "He opens the door.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Steam rolls out in a warm, mint-scented wave.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "She walks into it, chin up, clanking.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Open wide!", "name": "GRIMBALD", "speaker": 3, "ext": [], "paren": ["calling after"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Her voice, from within, is nearly a squeak.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Wider than that?", "name": "PERPETUA", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}