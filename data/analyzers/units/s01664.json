{"scene_id": "s01664", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01664.fountain", "heading": "INT. SCHOOL GYM - SLEEPOVER - NIGHT", "cast": [{"id": 0, "name": "ANYA", "names": ["ANYA"], "gender": "f", "first": 4, "spoke": 6}, {"id": 1, "name": "BARRETT", "names": ["BARRETT"], "gender": "m", "first": 5, "spoke": 4}, {"id": 2, "name": "DELILAH", "names": ["DELILAH"], "gender": "f", "first": 6, "spoke": 2}, {"id": 3, "name": "KENJI", "names": ["KENJI"], "gender": "m", "first": 7, "spoke": 3}, {"id": 4, "name": "ROXANNE", "names": ["ROXANNE"], "gender": "?", "first": 8, "spoke": 4}, {"id": 5, "name": "WALDO", "names": ["WALDO"], "gender": "m", "first": 9, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. SCHOOL GYM - SLEEPOVER - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Sleeping bags in a circle.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A flashlight in the middle, pointed at the ceiling.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Gym mats smell of rubber and old sweat.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ANYA, 15, in pajamas with cartoon cats, sits cross-legged.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "BARRETT, 16, hugs his knees.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "DELILAH, 15, plays with the zipper on her sleeping bag.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "KENJI, 16, sits with a bag of chips he hasn't opened.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "ROXANNE, 15, stares at the double doors.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "WALDO, 17, lies on his back, hands behind his head.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Okay. Truth or dare. Who's first?", "name": "ANYA", "speaker": 0, "ext": [], "paren": ["to the group"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "Nobody moves.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "You're the one who wanted to play.", "name": "BARRETT", "speaker": 1, "ext": [], "paren": ["to Anya"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "I changed my mind.", "name": "ANYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "It's too quiet.", "name": "DELILAH", "speaker": 2, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "It's a gym. Gyms are quiet.", "name": "KENJI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Not this quiet.", "name": "ROXANNE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "There's no wind. No cars. Nothing.", "name": "WALDO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Don't say that.", "name": "BARRETT", "speaker": 1, "ext": [], "paren": ["to Waldo"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "I'm just saying.", "name": "WALDO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "A basketball rolls out of the dark.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Slowly.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "It bumps against Delilah's sleeping bag.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Stops.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Everyone stares at it.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Nobody touches it.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Did somebody kick that?", "name": "KENJI", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Nobody's near it.", "name": "ANYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Don't look at the doors.", "name": "ROXANNE", "speaker": 4, "ext": [], "paren": ["to everyone"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Why not?", "name": "BARRETT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Because they're open.", "name": "ROXANNE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "They were closed.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Now they gape, a black rectangle onto the dark hallway.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Delilah scoots back on her sleeping bag.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Kenji drops the chips.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Barrett grabs the flashlight and sweeps it across the doors.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Nothing.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Just the hall.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Count us.", "name": "WALDO", "speaker": 5, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "What?", "name": "ANYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Count us. Out loud.", "name": "WALDO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "One.", "name": "ANYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Two.", "name": "BARRETT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "Three.", "name": "DELILAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Four.", "name": "KENJI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Five.", "name": "ROXANNE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "A long pause.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "Waldo hasn't spoken.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "Six.", "name": "WALDO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "Everyone turns.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "Waldo is lying exactly as before.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "But he hasn't moved his lips.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "Anya, barely moving her lips, says the only word left.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "Run.", "name": "ANYA", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}