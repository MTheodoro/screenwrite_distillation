{"scene_id": "s01665", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01665.fountain", "heading": "INT. ICE-CREAM TRUCK - NIGHT", "cast": [{"id": 0, "name": "PIPER", "names": ["PIPER"], "gender": "f", "first": 5, "spoke": 5}, {"id": 1, "name": "CRISPIN", "names": ["CRISPIN"], "gender": "m", "first": 6, "spoke": 4}, {"id": 2, "name": "YOLANDA", "names": ["YOLANDA"], "gender": "f", "first": 7, "spoke": 2}, {"id": 3, "name": "AUGUST", "names": ["AUGUST"], "gender": "?", "first": 14, "spoke": 6}, {"id": 4, "name": "^YOLANDA", "names": ["^YOLANDA"], "gender": "?", "first": 29, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. ICE-CREAM TRUCK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cramped.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Freezer hum.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cardboard menu with faded cartoon sundaes.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Through the windshield, a dark loading dock and a closed steel door.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "PIPER, 30s, in a striped apron, sits at the wheel, tapping a steady pattern with her thumb.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "CRISPIN, 40s, in the passenger seat, loosens his tie and pats his pockets twice.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "YOLANDA, 50s, crouched in the back by the freezers, counts coiled cables with a flashlight in her teeth.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Is it warm in here?", "name": "CRISPIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "It's an ice-cream truck.", "name": "PIPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "It's warm.", "name": "CRISPIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Eleven minutes.", "name": "YOLANDA", "speaker": 2, "ext": [], "paren": ["around the flashlight"], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "A knock on the side window.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "All three freeze.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "AUGUST, 50s, a security guard, holds a flashlight in one hand and a half-eaten cone in the other.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "His uniform is two sizes too small.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "He raps again.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Piper rolls down the window an inch.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "We're closed.", "name": "AUGUST", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "We know.", "name": "PIPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Then why are you here?", "name": "AUGUST", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Waiting for a late order.", "name": "CRISPIN", "speaker": 1, "ext": [], "paren": ["smiling too widely"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Who orders ice cream at midnight?", "name": "AUGUST", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "The stressed.", "name": "PIPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "August nods, as if that explains something.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "He licks his cone.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "What flavor?", "name": "AUGUST", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Pistachio.", "name": "CRISPIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Rocky road.", "name": "PIPER", "speaker": 0, "ext": [], "paren": ["simultaneously"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Neapolitan.", "name": "^YOLANDA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "They glare at one another.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "August lifts an eyebrow.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Pick one.", "name": "AUGUST", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Neapolitan.", "name": "YOLANDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Good choice. Three flavors, no fighting.", "name": "AUGUST", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "He tips his cap.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Wanders off, licking.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Piper rolls the window back up, slowly, and exhales.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Eight minutes.", "name": "PIPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}