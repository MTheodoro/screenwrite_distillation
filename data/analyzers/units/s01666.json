{"scene_id": "s01666", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01666.fountain", "heading": "INT. CRUISE SHIP CASINO COUNTING ROOM - NIGHT", "cast": [{"id": 0, "name": "HEDDA STROM", "names": ["HEDDA STROM", "HEDDA"], "gender": "?", "first": 5, "spoke": 5}, {"id": 1, "name": "CASSIUS", "names": ["CASSIUS"], "gender": "?", "first": 6, "spoke": 2}, {"id": 2, "name": "BIRDIE", "names": ["BIRDIE"], "gender": "f", "first": 7, "spoke": 3}, {"id": 3, "name": "NIGEL", "names": ["NIGEL"], "gender": "m", "first": 8, "spoke": 6}, {"id": 4, "name": "KALINDA", "names": ["KALINDA"], "gender": "?", "first": 9, "spoke": 1}, {"id": 5, "name": "CAPTAIN RUSKIN", "names": ["CAPTAIN RUSKIN", "RUSKIN"], "gender": "?", "first": 33, "spoke": 6}, {"id": 6, "name": "^CASSIUS", "names": ["^CASSIUS"], "gender": "?", "first": 44, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. CRUISE SHIP CASINO COUNTING ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A windowless steel room below decks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Bills in stacks as high as a child.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Counting machines whirring.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single security camera blinks red in the corner.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "HEDDA STROM, 40s, in a crisp white uniform and gloves, feeds bills into a machine with mechanical grace.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "CASSIUS, 30s, in a pit boss's vest, stacks cash in plastic trays.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "BIRDIE, 20s, a trainee, pushes a cart of chips with wide, nervous eyes.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "NIGEL, 50s, the vault manager, hunches over a ledger, glasses low on his nose.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "KALINDA, 30s, in a cashier's cap, sorts coins into tubes.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Cassius, the Tuesday trays.", "name": "HEDDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Stacking.", "name": "CASSIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Hedda, you're short on the dollar bills.", "name": "NIGEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "I'm precisely on the dollar bills.", "name": "HEDDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "You are precisely short.", "name": "NIGEL", "speaker": 3, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Birdie wheels the cart.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "A chip falls.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "It rolls under the machine.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "She crouches.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Fishes.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Comes up with the chip and something else: a small, flat key.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Um, Mr. Nigel?", "name": "BIRDIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Yes?", "name": "NIGEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "What's this?", "name": "BIRDIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "He looks.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "His face does something complicated.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "It's a key.", "name": "NIGEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "To what?", "name": "KALINDA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "To the ship's safe.", "name": "NIGEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Why was it under the machine?", "name": "CASSIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Gravity.", "name": "HEDDA", "speaker": 0, "ext": [], "paren": ["dryly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "The intercom buzzes.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Everyone freezes.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "CAPTAIN RUSKIN, 60s, in full dress whites with gold braid, appears in the doorway with a black briefcase.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "His smile is warm and perfectly empty.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Good evening, everyone. Don't stop.", "name": "RUSKIN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Nobody moves.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "The machines whirr.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "You're missing something, I believe.", "name": "RUSKIN", "speaker": 5, "ext": ["CONT'D"], "paren": ["to Nigel"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Captain?", "name": "NIGEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "A key.", "name": "RUSKIN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Birdie puts her hand behind her back.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Kalinda sets a tube of coins down, very carefully.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "We haven't seen a key.", "name": "HEDDA", "speaker": 0, "ext": [], "paren": ["simultaneously"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "We haven't seen a key.", "name": "^CASSIUS", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "action", "text": "A pause.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "action", "text": "Ruskin lifts the briefcase onto the counter.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "Opens it.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "Inside, stacked and wrapped, more cash than the counting room holds.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "dialogue", "text": "I'd like to make a deposit.", "name": "RUSKIN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "dialogue", "text": "At this hour?", "name": "HEDDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "dialogue", "text": "I'd like it counted by dawn. And I'd like to know who held the key.", "name": "RUSKIN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "action", "text": "Birdie slowly brings her hand out.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "action", "text": "The key sits in her palm.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "dialogue", "text": "It was under the machine.", "name": "BIRDIE", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "action", "text": "Ruskin takes it.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "action", "text": "Smiles.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "action", "text": "Pockets it.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "dialogue", "text": "Good girl.", "name": "RUSKIN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}