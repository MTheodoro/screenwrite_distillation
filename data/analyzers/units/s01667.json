{"scene_id": "s01667", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01667.fountain", "heading": "INT. HOTEL BALLROOM - 24-HOUR TABLE TENNIS MARATHON - NIGHT", "cast": [{"id": 0, "name": "NORIKO ABE", "names": ["NORIKO ABE", "NORIKO"], "gender": "f", "first": 5, "spoke": 17}, {"id": 1, "name": "DESMOND CRAWLEY", "names": ["DESMOND CRAWLEY", "DESMOND"], "gender": "f", "first": 6, "spoke": 19}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOTEL BALLROOM - 24-HOUR TABLE TENNIS MARATHON - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Chandeliers dimmed to amber.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "One green table in the center of a vast parquet floor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Folding chairs along the walls, empty.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A banner sagging between two columns: HOUR 19.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "NORIKO ABE, 40s, in a faded tracksuit with a sweatband, bounces the ball once off her paddle.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "DESMOND CRAWLEY, 50s, in bright orange shorts, stands across from her, red-faced, shoulders heaving.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "The scoreboard reads 10-10.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "A cardboard sign propped against it: SUDDEN DEATH.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Did everyone hear that? Ten-all!", "name": "DESMOND", "speaker": 1, "ext": [], "paren": ["to the empty ballroom"], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Nobody answers.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "A janitor's vacuum hums far away.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Serve.", "name": "NORIKO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "I know it's my serve.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Then serve.", "name": "NORIKO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I'm gathering my thoughts.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "They've scattered.", "name": "NORIKO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Desmond tosses the ball.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Whacks it.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "It flies in a slow arc.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Noriko returns, short, with a flick of the wrist.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Desmond lunges, snaps a backhand over the net.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Noriko leaps, smashes, and the ball cracks onto the table and into the dark, and Desmond, chasing it, goes down hard against a stack of chairs, which clatter across the floor like dropped cutlery while Noriko, arms raised, is already celebrating alone.", "para": 4, "sent": 5, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Point!", "name": "NORIKO", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Desmond sits up.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Chairs are tangled around his legs.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Out!", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "It was on the line.", "name": "NORIKO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "It was off the line.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "It kissed the line.", "name": "NORIKO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "It kissed my dignity.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "He gets to his feet.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Pulls a chair off his shin.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Looks at the scoreboard.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "11-10.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "For the record, I'd like it noted that I was provoked.", "name": "DESMOND", "speaker": 1, "ext": ["CONT'D"], "paren": ["to the room"], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "By what?", "name": "NORIKO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "By you existing.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "She smiles.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "It is the first smile of the night.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Match point.", "name": "NORIKO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Don't.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Your serve.", "name": "NORIKO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Fine.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": ["grim"], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "He retrieves the ball from beneath a chair.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "Wipes it on his shorts.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Steps to the end of the table.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Stares at her, then at the ball, then at the chandelier.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Twenty-four hours. One ball. Two idiots.", "name": "DESMOND", "speaker": 1, "ext": ["CONT'D"], "paren": ["to himself"], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "He serves.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "A looping, impossible spin.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "Noriko tracks it.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "Lifts her paddle.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "Misses by an inch.", "para": 9, "sent": 4, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "The ball bounces off the table.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "Drifts across the ballroom.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "Rolls to a stop at a vacuum cleaner's wheels.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "A long silence.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "They both stare at it.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "Eleven-eleven.", "name": "NORIKO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "It's a point for me!", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "It's a point for you.", "name": "NORIKO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "It's eleven-eleven.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "You need two.", "name": "NORIKO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "I know that!", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "He walks down the room to fetch the ball.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "His shoes squeak on the parquet.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 67, "kind": "action", "text": "Behind him, Noriko sinks onto the edge of the table, rubs her wrist, and looks at the banner.", "para": 12, "sent": 2, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "HOUR 19.", "para": 12, "sent": 3, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "She counts silently on her fingers.", "para": 12, "sent": 4, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "Five more hours.", "name": "NORIKO", "speaker": 0, "ext": [], "paren": ["under her breath"], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "Desmond returns with the ball.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "He holds it up like a trophy.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 73, "kind": "dialogue", "text": "Found it.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 74, "kind": "dialogue", "text": "It didn't go far.", "name": "NORIKO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 75, "kind": "dialogue", "text": "Nothing in this room goes far.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 76, "kind": "action", "text": "They look at each other.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 77, "kind": "action", "text": "Both, slowly, start to laugh.", "para": 14, "sent": 1, "present": [0, 1]}, {"u": 78, "kind": "action", "text": "Neither can stop.", "para": 14, "sent": 2, "present": [0, 1]}, {"u": 79, "kind": "action", "text": "Desmond has to put the paddle down.", "para": 14, "sent": 3, "present": [0, 1]}, {"u": 80, "kind": "action", "text": "Noriko wipes her eyes.", "para": 14, "sent": 4, "present": [0, 1]}, {"u": 81, "kind": "dialogue", "text": "Why are we here?", "name": "NORIKO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 82, "kind": "dialogue", "text": "For charity.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 83, "kind": "dialogue", "text": "Which one?", "name": "NORIKO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 84, "kind": "dialogue", "text": "I don't remember.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 85, "kind": "dialogue", "text": "Serve, Desmond.", "name": "NORIKO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 86, "kind": "dialogue", "text": "Serving.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": ["winded, grinning"], "dual": false, "present": [0, 1]}, {"u": 87, "kind": "action", "text": "He serves.", "para": 15, "sent": 0, "present": [0, 1]}, {"u": 88, "kind": "action", "text": "She returns.", "para": 15, "sent": 1, "present": [0, 1]}, {"u": 89, "kind": "action", "text": "They rally.", "para": 15, "sent": 2, "present": [0, 1]}, {"u": 90, "kind": "action", "text": "It goes on and on, ball ticking over the net, the sound filling the ballroom like the beating of a patient heart, until neither of them is keeping score.", "para": 15, "sent": 3, "present": [0, 1]}]}