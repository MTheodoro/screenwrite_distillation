{"scene_id": "s01668", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01668.fountain", "heading": "INT. PRISON VISITING ROOM - DAY", "cast": [{"id": 0, "name": "THEODORA MBEKI", "names": ["THEODORA MBEKI", "THEODORA"], "gender": "f", "first": 5, "spoke": 18}, {"id": 1, "name": "WINSTON PRICE", "names": ["WINSTON PRICE", "WINSTON"], "gender": "f", "first": 7, "spoke": 17}], "units": [{"u": 0, "kind": "heading", "text": "INT. PRISON VISITING ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Gray tables bolted to the floor.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A guard at the far door, unmoving.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A vending machine humming in the corner.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Fluorescent light with no shadow in it.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "THEODORA MBEKI, 40s, in a tailored charcoal suit, sits upright with a legal pad squared before her.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She has not written anything on it.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "WINSTON PRICE, 60s, in prison-issue tan, enters.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He sits across from her.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "His wrists are scarred where cuffs have been.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "His hands, flat on the table, are very still.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Mr. Price.", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Ms. Mbeki.", "name": "WINSTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "You look rested.", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "I look like a man with nothing to do.", "name": "WINSTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "The appeal has been filed.", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "So I'm told.", "name": "WINSTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Do you have questions?", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Only one.", "name": "WINSTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Go ahead.", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "If they let me out, where do I go?", "name": "WINSTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Theodora's pen stops above the pad.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Home, I'd hope.", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "There's nobody home.", "name": "WINSTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "There's the house.", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Someone sold the house.", "name": "WINSTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "It may be recoverable.", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "It may.", "name": "WINSTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "A long pause.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "The vending machine hums.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "A coin drops somewhere.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Mr. Price, I'm going to be honest with you. The odds are one in three.", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "That's better than I expected.", "name": "WINSTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "It's worse than I'd like.", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "You always say that.", "name": "WINSTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "It's always true.", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Winston looks at her hands.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "At her wedding ring.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "At the way her thumb worries the cap of the pen.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Your husband still in Cleveland?", "name": "WINSTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "How did you know about Cleveland?", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "You told me once.", "name": "WINSTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "I don't tell clients where my husband lives.", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "You told me. In the second year. You said it quietly, like you'd been meaning to for a while.", "name": "WINSTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "Theodora puts down the pen.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "Folds her hands.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "He's in Cleveland.", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "Good.", "name": "WINSTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Why is that good?", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Because one of us should have somebody waiting.", "name": "WINSTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "She looks at him for a long moment.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "When she speaks, her voice is lower.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Mr. Price, you will have somebody.", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "Will I?", "name": "WINSTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "You will have me. Until the day they open that gate.", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "He nods, slowly.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "Almost smiles.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "That's good enough.", "name": "WINSTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "The guard clears his throat.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "Theodora rises, gathers her legal pad, and, after a moment's hesitation, leaves a pen on the table.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "In case you think of something to write.", "name": "THEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "She walks to the door.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "Does not look back.", "para": 10, "sent": 1, "present": [0, 1]}]}