{"scene_id": "s01669", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01669.fountain", "heading": "INT. FIELD KITCHEN IN A BOMBED BREWERY - NIGHT", "cast": [{"id": 0, "name": "MAGNUSSEN", "names": ["MAGNUSSEN"], "gender": "?", "first": 6, "spoke": 12}, {"id": 1, "name": "CORPORAL PETIT", "names": ["CORPORAL PETIT", "PETIT"], "gender": "m", "first": 7, "spoke": 5}, {"id": 2, "name": "WOJCIK", "names": ["WOJCIK"], "gender": "?", "first": 8, "spoke": 6}, {"id": 3, "name": "GREENE", "names": ["GREENE"], "gender": "?", "first": 9, "spoke": 5}, {"id": 4, "name": "DELACROIX", "names": ["DELACROIX"], "gender": "f", "first": 10, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. FIELD KITCHEN IN A BOMBED BREWERY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Copper vats, split and blackened, loom in the dark like wrecked bells.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A tarp stretched across a hole in the roof sags with rain.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Sacks of flour stacked against a wall.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single iron stove glows red.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The smell: cabbage, wet wool, old hops.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "MAGNUSSEN, 40s, a sergeant with a heavy gray mustache, ladles stew into tin mugs, one at a time, with exaggerated care.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "CORPORAL PETIT, 20s, a slight boy in a too-large helmet, sits on an upturned crate, cradling a tin plate.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "WOJCIK, 30s, a private with a broken front tooth, whittles a stick by the stove.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "GREENE, 20s, a radio operator, sits cross-legged by a silent set.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "DELACROIX, 30s, a medic with a stained armband, mends a sleeve with a curved needle.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Nobody speaks for a long time.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Rain on the tarp.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Eat.", "name": "MAGNUSSEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "I'm not hungry.", "name": "PETIT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Eat anyway.", "name": "MAGNUSSEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "It's the cabbage.", "name": "PETIT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "It's what we have.", "name": "MAGNUSSEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "My mother would've cried at that stew.", "name": "WOJCIK", "speaker": 2, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "From pride?", "name": "GREENE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "From shame.", "name": "WOJCIK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Delacroix snorts.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "The needle slips.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "She sucks her thumb, swears softly in French.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Pardon.", "name": "DELACROIX", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "No need.", "name": "MAGNUSSEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "What's that noise?", "name": "PETIT", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "What noise?", "name": "MAGNUSSEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Under the rain. Like a drum.", "name": "PETIT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "They all listen.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "A distant, regular thudding.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Far off.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Nearly a heartbeat.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Artillery.", "name": "GREENE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Ours?", "name": "WOJCIK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Doesn't matter.", "name": "GREENE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "It matters.", "name": "MAGNUSSEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "It's three miles off.", "name": "GREENE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Then it's three miles off.", "name": "MAGNUSSEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "He sets down the ladle.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Wipes his hands.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Takes his own mug and sits on a sack of flour.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "The stove ticks.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Sergeant.", "name": "WOJCIK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Mm.", "name": "MAGNUSSEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Did this place make good beer?", "name": "WOJCIK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "The best in the province.", "name": "MAGNUSSEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "How do you know?", "name": "WOJCIK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "My father used to drink it.", "name": "MAGNUSSEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Did he --", "name": "PETIT", "speaker": 1, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Is that why --", "name": "DELACROIX", "speaker": 4, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "Sergeant, is that why we --", "name": "GREENE", "speaker": 3, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "One at a time.", "name": "MAGNUSSEN", "speaker": 0, "ext": [], "paren": ["raising a hand"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "A beat.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "Greene falls silent.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Petit looks down.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Delacroix threads her needle.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "Wojcik scrapes the stick.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "It's why I asked to cook here.", "name": "MAGNUSSEN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "The rain intensifies.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "The tarp bellies and drips.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "Wojcik whittles.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "A curl of wood falls to the floor.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "He blows the dust from the stick, and holds it up: a tiny, crude beer mug.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "He sets it on the sack beside Magnussen.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "Magnussen looks at it.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "action", "text": "He doesn't say a thing.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "action", "text": "He picks it up, turns it in the light of the stove, and tucks it into his breast pocket.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "The distant thudding does not stop.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "action", "text": "Petit finishes his stew.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}]}