{"scene_id": "s01671", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01671.fountain", "heading": "INT. DRY DOCK PUMP ROOM - NIGHT", "cast": [{"id": 0, "name": "KOVAC", "names": ["KOVAC"], "gender": "m", "first": 4, "spoke": 15}, {"id": 1, "name": "IRINA VESK", "names": ["IRINA VESK", "IRINA"], "gender": "?", "first": 5, "spoke": 15}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRY DOCK PUMP ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Concrete.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sweating pipes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single caged bulb.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "KOVAC (50s, heavy coat, never takes his hands from his pockets) sits on an upturned crate.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "IRINA VESK (40s, wet hair, steady eyes) stands by the door.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Doesn't sit.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "You're late.", "name": "KOVAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Traffic.", "name": "IRINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "There's no traffic at this hour.", "name": "KOVAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Then I took the long way.", "name": "IRINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Why?", "name": "KOVAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Habit.", "name": "IRINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Whose habit? Yours or his?", "name": "KOVAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Whose do you think?", "name": "IRINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I think you're still counting the exits.", "name": "KOVAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Two. The door and the one behind you.", "name": "IRINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Three. You forgot the grate.", "name": "KOVAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "I didn't forget it.", "name": "IRINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Good. Then you know why I picked this room.", "name": "KOVAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Because the water's loud.", "name": "IRINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Because the water's loud. Nobody hears anything down here.", "name": "KOVAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Nobody's supposed to.", "name": "IRINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "You brought it?", "name": "KOVAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "You brought the other half?", "name": "IRINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I asked first.", "name": "KOVAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "And I'm still standing.", "name": "IRINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "That's not an answer.", "name": "KOVAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "It's the only one you get until I see yours.", "name": "IRINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Fair.", "name": "KOVAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Show me.", "name": "IRINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Slowly, then.", "name": "KOVAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Slowly.", "name": "IRINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "You first. Left hand.", "name": "KOVAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Right hand. Always the right.", "name": "IRINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "You're not in charge here.", "name": "KOVAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Neither are you.", "name": "IRINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Somewhere above, a pump shudders on.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Neither of them blinks.", "para": 3, "sent": 1, "present": [0, 1]}]}