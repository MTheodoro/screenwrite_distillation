{"scene_id": "s01672", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01672.fountain", "heading": "INT. TAXIDERMY WORKSHOP - DAY", "cast": [{"id": 0, "name": "INSPECTOR NELL BARROWMAN", "names": ["INSPECTOR NELL BARROWMAN", "NELL"], "gender": "?", "first": 4, "spoke": 3}, {"id": 1, "name": "CONSTABLE JUNO ADEYEMI", "names": ["CONSTABLE JUNO ADEYEMI", "JUNO"], "gender": "?", "first": 5, "spoke": 2}, {"id": 2, "name": "MARGUERITE HOLLIS", "names": ["MARGUERITE HOLLIS", "MARGUERITE"], "gender": "?", "first": 6, "spoke": 3}, {"id": 3, "name": "ALFRED PETTIGREW", "names": ["ALFRED PETTIGREW", "ALFRED"], "gender": "?", "first": 7, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. TAXIDERMY WORKSHOP - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Glass eyes in trays.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A stuffed heron.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dust in the skylight.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "INSPECTOR NELL BARROWMAN (40s, notebook) circles a workbench.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside her, CONSTABLE JUNO ADEYEMI (20s) scribbles.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Behind the counter, MARGUERITE HOLLIS (60s, leather apron) polishes a badger.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "At the back, ALFRED PETTIGREW (70s, cardigan) sits very still.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "A suspect, or furniture.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Nobody touched the owl.", "name": "MARGUERITE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Somebody did. The base is cracked.", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "It was always cracked.", "name": "ALFRED", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Sir, the report says --", "name": "JUNO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Juno. Later.", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "She dropped it in March, Alfred.", "name": "MARGUERITE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "She did not. She said she did.", "name": "ALFRED", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Who is \"she\" now?", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Her. The girl from the post office.", "name": "MARGUERITE", "speaker": 2, "ext": [], "paren": ["over Nell"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Nobody. There's no girl.", "name": "ALFRED", "speaker": 3, "ext": [], "paren": ["over Marguerite"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "She told me there was a ledger.", "name": "JUNO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Nell lifts the heron's wing.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "A key glints in the feathers.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}]}