{"scene_id": "s01674", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01674.fountain", "heading": "INT. COLD STORAGE WAREHOUSE - NIGHT", "cast": [{"id": 0, "name": "RAFA", "names": ["RAFA"], "gender": "?", "first": 4, "spoke": 2}, {"id": 1, "name": "ZUNIGA", "names": ["ZUNIGA"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "BEATRIX LUND", "names": ["BEATRIX LUND", "BEATRIX"], "gender": "?", "first": 6, "spoke": 1}, {"id": 3, "name": "YUSUF KANDEMIR", "names": ["YUSUF KANDEMIR", "YUSUF"], "gender": "?", "first": 7, "spoke": 1}, {"id": 4, "name": "OSEI MENSAH", "names": ["OSEI MENSAH", "OSEI"], "gender": "?", "first": 11, "spoke": 1}, {"id": 5, "name": "LIV HARTWELL", "names": ["LIV HARTWELL", "LIV"], "gender": "?", "first": 11, "spoke": 2}, {"id": 6, "name": "DOMINIK VOSS", "names": ["DOMINIK VOSS", "DOMINIK"], "gender": "m", "first": 21, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. COLD STORAGE WAREHOUSE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Frost on steel racks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Breath fogs.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A forklift sits idle.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "RAFAEL \"RAFA\" ZUNIGA (40s, crew chief) crouches beside a pallet of frozen tuna.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Earpiece in.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "BEATRIX LUND (30s, safecracker) rolls a case across the floor.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "YUSUF KANDEMIR (20s, driver) leans on the forklift, eating an apple.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Thirty minutes. Guard rotation is clockwork.", "name": "RAFA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Always is, until it isn't.", "name": "YUSUF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Relax. Nobody's coming.", "name": "BEATRIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Two more shapes move between the racks: OSEI MENSAH (50s, tech) and LIV HARTWELL (30s, inside woman, wearing a warehouse vest).", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "They set a monitor on a pallet.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Cameras loop. Thirty seconds of clean footage, then it resets.", "name": "OSEI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "My badge opens the vault door. After that, it's yours.", "name": "LIV", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Everybody breathes easier.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Yusuf laughs.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Rafa almost smiles.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Then the lights snap on.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Full white.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "A klaxon wails.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "DOMINIK VOSS (50s, security director, long coat) steps out from behind a rack with a pistol at his side.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "action", "text": "Four armed guards fan out behind him.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "Rafa, Beatrix, Yusuf, Osei and Liv freeze.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "Nobody moves.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "Evening, everyone. Liv. Thank you for the invitation.", "name": "DOMINIK", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "action", "text": "Liv doesn't look at anyone.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "Beatrix lunges at her; Osei catches Beatrix by the arm.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "Yusuf drops the apple and bolts.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "The guards tackle him against the racks.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "Liv. What did you do?", "name": "RAFA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "What I had to.", "name": "LIV", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "action", "text": "Dominik raises a hand.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "The klaxon stops.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "The only sound is Yusuf's ragged breathing and the hum of the freezers.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}]}