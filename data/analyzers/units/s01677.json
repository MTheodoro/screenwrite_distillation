{"scene_id": "s01677", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01677.fountain", "heading": "INT. LAUNDROMAT - NIGHT", "cast": [{"id": 0, "name": "CORA BELLAMY", "names": ["CORA BELLAMY", "CORA"], "gender": "?", "first": 3, "spoke": 7}, {"id": 1, "name": "WANDA BELLAMY", "names": ["WANDA BELLAMY", "WANDA"], "gender": "?", "first": 3, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAUNDROMAT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent hum.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dryers turning.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "CORA BELLAMY (40s, scrubs, tired) folds towels.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "Precisely.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Corners aligned.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Her sister, WANDA BELLAMY (40s, leather jacket), sits on a washer, swinging a boot.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Nice night.", "name": "WANDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "It's one a.m.", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Still nice.", "name": "WANDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Cora folds.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Wanda watches.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Mom called.", "name": "WANDA", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Did she.", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Said you hung up on her.", "name": "WANDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "She said I hung up on her.", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "She said she was sorry, too.", "name": "WANDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "She said that?", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Not in words.", "name": "WANDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Cora sets a towel down.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Squares it.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Why are you here, Wanda?", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "She asked me to tell you something.", "name": "WANDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Then tell me.", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "She sold the house. She sold it last week. She's moving to Tucson.", "name": "WANDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "The dryer buzzes.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Neither of them moves.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Without telling me.", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Without telling either of us. I found out at the bank.", "name": "WANDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Cora picks up the next towel.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Her hands shake.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "She folds it anyway.", "para": 6, "sent": 2, "present": [0, 1]}]}