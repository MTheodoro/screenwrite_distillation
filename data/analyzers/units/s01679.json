{"scene_id": "s01679", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01679.fountain", "heading": "INT. GRANDMOTHER'S ATTIC - EARLY EVENING", "cast": [{"id": 0, "name": "ODALYS FERREIRA", "names": ["ODALYS FERREIRA", "ODALYS"], "gender": "?", "first": 4, "spoke": 2}, {"id": 1, "name": "RUBEN", "names": ["RUBEN"], "gender": "?", "first": 6, "spoke": 1}, {"id": 2, "name": "ISAURA", "names": ["ISAURA"], "gender": "f", "first": 7, "spoke": 1}, {"id": 3, "name": "GRANDMOTHER FERREIRA", "names": ["GRANDMOTHER FERREIRA", "GRANDMOTHER"], "gender": "?", "first": 4, "spoke": 4}, {"id": 4, "name": "UNCLE TOMAS", "names": ["UNCLE TOMAS"], "gender": "?", "first": 36, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRANDMOTHER'S ATTIC - EARLY EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Slanted beams.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Trunks and a dress form wearing a wedding veil.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single dormer window lets in orange light.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ODALYS FERREIRA (8) clutches a flashlight like a sword.", "para": 1, "sent": 0, "present": [0, 3]}, {"u": 5, "kind": "action", "text": "She crouches behind a trunk.", "para": 1, "sent": 1, "present": [0, 3]}, {"u": 6, "kind": "action", "text": "Her brother, RUBEN (11), hunches beside her, whispering.", "para": 1, "sent": 2, "present": [0, 1, 3]}, {"u": 7, "kind": "action", "text": "Her cousin, ISAURA (13), perches on the dress form's stand, bored.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "They are hiding.", "para": 1, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Down the stairs, a door bangs.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Heavy footsteps.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "She presses a finger to her lips.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "He nods.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Isaura rolls her eyes but goes quiet.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "A shape fills the stairwell.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "GRANDMOTHER FERREIRA (70s, flowered apron, spoon in hand) climbs into view, scanning the room.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "She frowns.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Odalys? Ruben? Isaura? Dinner!", "name": "GRANDMOTHER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Shh.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "You shh.", "name": "RUBEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "You're both shh.", "name": "ISAURA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "I heard that.", "name": "GRANDMOTHER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Nobody moves.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "The old woman steps closer to the trunk.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "She reaches down, grips the lid.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "She throws it open.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Odalys shrieks.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Ruben yelps.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Isaura topples off the stand, veil flying.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Found you!", "name": "GRANDMOTHER", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "They stare at her.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Then, all at once, they burst out laughing, breathless and relieved.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "That's not fair, you cheated!", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Old ladies are allowed.", "name": "GRANDMOTHER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Tension gone, she ladles a spoonful of soup into Odalys's mouth.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Odalys swallows, grinning.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Is that my mother screaming up there?", "name": "UNCLE TOMAS", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "He thunders up the stairs, and everyone starts shouting at once.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}]}