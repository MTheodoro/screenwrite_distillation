{"scene_id": "s01680", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01680.fountain", "heading": "INT. ICE-MINING RIG CONTROL CAB - NIGHT", "cast": [{"id": 0, "name": "ANSELM DRAKE", "names": ["ANSELM DRAKE", "ANSELM"], "gender": "?", "first": 4, "spoke": 14}, {"id": 1, "name": "CONTROL", "names": ["CONTROL"], "gender": "?", "first": 6, "spoke": 13}], "units": [{"u": 0, "kind": "heading", "text": "INT. ICE-MINING RIG CONTROL CAB - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped cab bolted to the side of a comet fragment.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Frost on the windows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Red warning lights pulse.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ANSELM DRAKE (40s, miner, worn flight suit) straps into the operator seat.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "A radio crackles on the dash.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "dialogue", "text": "Rig Nine, this is Control. Report.", "name": "CONTROL", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Rig Nine. Drill's jammed at four hundred meters.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Copy. Is the cable still tensioned?", "name": "CONTROL", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Tensioned and shaking.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Anselm, you need to cut it loose.", "name": "CONTROL", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "If I cut it, I lose the whole string.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "If you don't, you lose the rig.", "name": "CONTROL", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Anselm checks a gauge.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "The needle is buried in the red.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "How long have I got?", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Eight minutes, maybe less.", "name": "CONTROL", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Maybe less. Great.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Anselm. Listen to me.", "name": "CONTROL", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "I'm listening.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "The fragment is rotating faster than predicted. The tether will snap.", "name": "CONTROL", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Then tell me what to do.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Release the clamp.", "name": "CONTROL", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "That's what I'm trying to --", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "The cab lurches.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "A cup slides off the dash and shatters.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "It's not releasing!", "name": "ANSELM", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Use the manual override.", "name": "CONTROL", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "He flips a cover.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Pulls a lever.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Nothing.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Manual's dead.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Then go outside.", "name": "CONTROL", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Outside?", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Hammer it free.", "name": "CONTROL", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "You want me to hit it with a hammer.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "I want you to live.", "name": "CONTROL", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Anselm grabs a helmet.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Seals it.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Tell my sister I said --", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Tell her yourself when you're back.", "name": "CONTROL", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": true, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Tell her I said it was a good rig.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "He slaps the airlock.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "It cycles open on black.", "para": 6, "sent": 1, "present": [0, 1]}]}