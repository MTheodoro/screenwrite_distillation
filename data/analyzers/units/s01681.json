{"scene_id": "s01681", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01681.fountain", "heading": "INT. LUNAR GREENHOUSE DOME - DAY", "cast": [{"id": 0, "name": "ENGINEER ILSE VOGEL", "names": ["ENGINEER ILSE VOGEL", "ILSE"], "gender": "?", "first": 3, "spoke": 2}, {"id": 1, "name": "BOTANIST KWAME ASANTE", "names": ["BOTANIST KWAME ASANTE", "KWAME"], "gender": "?", "first": 4, "spoke": 3}, {"id": 2, "name": "TECHNICIAN BRONWYN FALK", "names": ["TECHNICIAN BRONWYN FALK", "BRONWYN"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "COMMANDER", "names": ["COMMANDER"], "gender": "?", "first": 11, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. LUNAR GREENHOUSE DOME - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Rows of tomato plants under pale artificial light.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A quiet hum.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "ENGINEER ILSE VOGEL (30s, coveralls) prunes a vine.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "BOTANIST KWAME ASANTE (40s) logs readings on a tablet.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "They work in comfortable silence.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "TECHNICIAN BRONWYN FALK (20s) hauls a crate of seedlings through the airlock, whistling.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Good yield this month.", "name": "KWAME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Best since the landing.", "name": "ILSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Cafeteria will be thrilled.", "name": "BRONWYN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "A comm panel clicks.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Dome Two, status check.", "name": "COMMANDER", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "All green, Commander.", "name": "KWAME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Good. Keep it that way.", "name": "COMMANDER", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "The panel clicks off.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Ilse snips another stem.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Then the lights flicker.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Once.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Twice.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "The hum drops in pitch.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Was that supposed to happen?", "name": "BRONWYN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "No.", "name": "ILSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Every plant in the row leans toward the airlock door.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Slowly.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "As if something outside were calling them.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Everyone stay very still.", "name": "KWAME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}