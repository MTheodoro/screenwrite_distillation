{"scene_id": "s01683", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01683.fountain", "heading": "INT. FLOODED PARKING GARAGE - NIGHT", "cast": [{"id": 0, "name": "LUCKY", "names": ["LUCKY"], "gender": "?", "first": 5, "spoke": 6}, {"id": 1, "name": "ROSSETTI", "names": ["ROSSETTI"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "NATE", "names": ["NATE"], "gender": "?", "first": 6, "spoke": 8}, {"id": 3, "name": "OBI", "names": ["OBI"], "gender": "?", "first": 6, "spoke": 0}, {"id": 4, "name": "DETECTIVE MARISOL VEGA", "names": ["DETECTIVE MARISOL VEGA", "MARISOL"], "gender": "f", "first": 19, "spoke": 5}, {"id": 5, "name": "SILAS PRINGLE", "names": ["SILAS PRINGLE", "SILAS"], "gender": "?", "first": 26, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. FLOODED PARKING GARAGE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Six inches of black water cover the concrete.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A broken sign sparks overhead.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Pillars throw long shadows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Somewhere, a pump coughs.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LUCIANA \"LUCKY\" ROSSETTI (30s, wet leather jacket, nervous grin) wades toward a gray sedan, a duffel bag on her shoulder.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "At the car, her partner NATHANIEL \"NATE\" OBI (40s, calm, wire-rimmed glasses) checks the trunk.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Tell me it's all there.", "name": "LUCKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Count it yourself.", "name": "NATE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "I trust you.", "name": "LUCKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "You shouldn't.", "name": "NATE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "She drops the bag in the trunk.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "He slams it shut.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Headlights sweep across the pillars.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Who's that?", "name": "LUCKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Nobody.", "name": "NATE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Nate. Who is that?", "name": "LUCKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "A black van rolls to a stop.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "The door slides open.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "DETECTIVE MARISOL VEGA (40s, rain slicker, badge on her belt) steps out into the water, weapon drawn.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Hands where I can see them! Both of you!", "name": "MARISOL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Marisol, wait, I can explain --", "name": "LUCKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Don't say a word, Lucky.", "name": "NATE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Away from the car, Nathaniel!", "name": "MARISOL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "It's Nate.", "name": "NATE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "I don't care what it is!", "name": "MARISOL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "SILAS PRINGLE (60s, garage attendant in a yellow poncho) peers around a pillar, flashlight shaking.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Folks? We're closed. Folks?", "name": "SILAS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Lucky lunges for the trunk; Nate grabs her wrist; Marisol fires a warning shot that rings off the ceiling.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "All three freeze, and the water ripples outward from their feet.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "You said she wasn't coming.", "name": "LUCKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "I said she wasn't supposed to.", "name": "NATE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Last chance. Step away.", "name": "MARISOL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Nate lets go of Lucky.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "She sprints for the stairwell; Marisol swings the gun toward her, then back at Nate.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "He lifts his hands slowly.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "You were always better at this than me.", "name": "NATE", "speaker": 2, "ext": ["CONT'D"], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Don't flatter me. Where's she going?", "name": "MARISOL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Up.", "name": "NATE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Marisol lowers her gun an inch.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Then raises it again.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Footsteps splash away into the dark.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}