{"scene_id": "s01684", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01684.fountain", "heading": "INT. MINOR LEAGUE BASEBALL CLUBHOUSE - NIGHT", "cast": [{"id": 0, "name": "SKIP", "names": ["SKIP"], "gender": "?", "first": 6, "spoke": 15}, {"id": 1, "name": "CUELLAR", "names": ["CUELLAR"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "PITCHER DARIUS WHELAN", "names": ["PITCHER DARIUS WHELAN", "DARIUS"], "gender": "?", "first": 7, "spoke": 4}, {"id": 3, "name": "BEA", "names": ["BEA"], "gender": "?", "first": 7, "spoke": 4}, {"id": 4, "name": "FONSECA", "names": ["FONSECA"], "gender": "?", "first": 7, "spoke": 0}, {"id": 5, "name": "SHORTSTOP KENJI NAKASHIMA", "names": ["SHORTSTOP KENJI NAKASHIMA", "KENJI"], "gender": "?", "first": 7, "spoke": 3}, {"id": 6, "name": "SEUN", "names": ["SEUN"], "gender": "?", "first": 7, "spoke": 4}, {"id": 7, "name": "ADEBAYO", "names": ["ADEBAYO"], "gender": "?", "first": 7, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. MINOR LEAGUE BASEBALL CLUBHOUSE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Lockers.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Bats in racks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cooler of sports drink.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain drums on a tin roof.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The Millbrook Herons sit in a loose half-circle.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "MANAGER LEONARD \"SKIP\" CUELLAR (60s, thick mustache) stands before them.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Around him: PITCHER DARIUS WHELAN (20s), CATCHER BEATRIZ \"BEA\" FONSECA (30s), SHORTSTOP KENJI NAKASHIMA (20s), and TRAINER OLUWASEUN \"SEUN\" ADEBAYO (40s).", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 8, "kind": "dialogue", "text": "Good game, fellas. Good game.", "name": "SKIP", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 9, "kind": "dialogue", "text": "We lost eleven to two, Skip.", "name": "DARIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 10, "kind": "dialogue", "text": "Did we? I didn't notice.", "name": "SKIP", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 11, "kind": "dialogue", "text": "You were in the dugout, Skip. You noticed.", "name": "BEA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 12, "kind": "dialogue", "text": "I notice everything, Bea. That's why I'm manager.", "name": "SKIP", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 13, "kind": "dialogue", "text": "You called a bunt with two outs.", "name": "KENJI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 14, "kind": "dialogue", "text": "It was a tactical bunt.", "name": "SKIP", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 15, "kind": "dialogue", "text": "It was a tactical disaster, boss.", "name": "SEUN", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 16, "kind": "dialogue", "text": "Seun, you're a trainer.", "name": "SKIP", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 17, "kind": "dialogue", "text": "And I trained for this.", "name": "SEUN", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 18, "kind": "dialogue", "text": "Skip, are we still in the standings?", "name": "DARIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 19, "kind": "dialogue", "text": "Technically.", "name": "SKIP", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 20, "kind": "dialogue", "text": "Technically how?", "name": "BEA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 21, "kind": "dialogue", "text": "Technically, there are eight teams, and you can't be lower than eighth.", "name": "SKIP", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 22, "kind": "dialogue", "text": "We're eighth.", "name": "KENJI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 23, "kind": "dialogue", "text": "See? Technically alive.", "name": "SKIP", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 24, "kind": "dialogue", "text": "Skip, I walked nine batters.", "name": "DARIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 25, "kind": "dialogue", "text": "Nine is a nice number.", "name": "SKIP", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 26, "kind": "dialogue", "text": "Skip, I've never seen you this calm.", "name": "BEA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 27, "kind": "dialogue", "text": "That's because I've got news, Bea.", "name": "SKIP", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 28, "kind": "dialogue", "text": "Good news?", "name": "SEUN", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 29, "kind": "dialogue", "text": "Franchise is moving. Sold to a company in Tulsa. Last game's Sunday.", "name": "SKIP", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "action", "text": "Nobody speaks.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "action", "text": "The rain gets louder.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "dialogue", "text": "Seriously?", "name": "DARIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "dialogue", "text": "I wouldn't kid, Darius. Not about this.", "name": "SKIP", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "dialogue", "text": "When did you know?", "name": "KENJI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "dialogue", "text": "Since March. Didn't want to spoil the season.", "name": "SKIP", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "dialogue", "text": "Spoil it? Skip --", "name": "BEA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "dialogue", "text": "Bea, wait. I'm proud of every one of you. Win or lose.", "name": "SKIP", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "dialogue", "text": "We mostly lost.", "name": "SEUN", "speaker": 6, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "dialogue", "text": "We mostly lost beautifully, Seun.", "name": "SKIP", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}