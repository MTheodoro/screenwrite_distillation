{"scene_id": "s01685", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01685.fountain", "heading": "INT. ER TRAUMA BAY 3 - NIGHT", "cast": [{"id": 0, "name": "PRIYA RAMASWAMY", "names": ["PRIYA RAMASWAMY", "PRIYA"], "gender": "f", "first": 5, "spoke": 7}, {"id": 1, "name": "NURSE CALEB DUNMORE", "names": ["NURSE CALEB DUNMORE", "CALEB"], "gender": "?", "first": 6, "spoke": 4}, {"id": 2, "name": "INGRID SOLBERG", "names": ["INGRID SOLBERG", "INGRID"], "gender": "?", "first": 7, "spoke": 2}, {"id": 3, "name": "OTIS WEBB", "names": ["OTIS WEBB"], "gender": "?", "first": 8, "spoke": 0}, {"id": 4, "name": "PARAMEDIC GUS TREMAINE", "names": ["PARAMEDIC GUS TREMAINE", "GUS"], "gender": "?", "first": 14, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. ER TRAUMA BAY 3 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Harsh white light.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Stainless steel.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A monitor beeps too fast.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Blood on the floor tiles, smeared by a gurney's wheels.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. PRIYA RAMASWAMY (40s, surgical cap, steady) leans over a patient.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "NURSE CALEB DUNMORE (30s, tattooed forearms) squeezes a bag valve.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "RESIDENT DR. INGRID SOLBERG (20s, pale and wide-eyed) hovers at the foot of the bed.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "On the table lies MR. OTIS WEBB (70s), unconscious, his shirt cut open.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Pressure?", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Seventy over forty.", "name": "CALEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Ingrid, give me two units of O neg.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Right away, Dr. Ramaswamy.", "name": "INGRID", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Priya. Please. Just Priya.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "PARAMEDIC GUS TREMAINE (30s, soaked jacket) bursts in, still holding a clipboard.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Dr. Priya! Wife says he took nitro an hour ago!", "name": "GUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "He's crashing.", "name": "CALEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "The monitor flatlines.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "A long, flat tone.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Charge to two hundred.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Charging.", "name": "CALEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Clear!", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "The body jerks.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "The line stays flat.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Again. Three hundred.", "name": "PRIYA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Dr. Priya --", "name": "INGRID", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Now, Ingrid!", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Another shock.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "A blip.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Another.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "A steady rhythm.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "We have a pulse.", "name": "CALEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Ingrid exhales.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Priya wipes her forehead with a gloved wrist.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}]}