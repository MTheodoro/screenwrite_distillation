t": 2, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "He turns.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "She smirks.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "She steps up, rolls.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Gutter.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "He laughs.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "She glares.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Deacon looks at the clock.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Poppy looks at her phone.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Tough break.", "name": "ARNOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Wait your turn.", "name": "MINNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "He picks a ball.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "So does she.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "They reach for the same one.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Their hands collide.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Both pull back.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Folks, there's a rack of them.", "name": "DEACON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Arnold shrugs and takes another.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Minnie takes the first, grips it, and rolls.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Strike.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "She turns and bows, slowly.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "He nods, grudging.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "That's two-forty to two-thirty-eight.", "name": "POPPY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Neither of them breathes.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Then both start toward the scoreboard at once, shoving past each other, until Deacon steps between them with both palms out.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}]}