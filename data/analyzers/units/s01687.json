{"scene_id": "s01687", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01687.fountain", "heading": "EXT. FLOODED TRENCH - DAWN", "cast": [{"id": 0, "name": "PRIVATE EMIL HARTMANN", "names": ["PRIVATE EMIL HARTMANN", "EMIL"], "gender": "m", "first": 4, "spoke": 5}, {"id": 1, "name": "SOLDIER", "names": ["SOLDIER"], "gender": "?", "first": 5, "spoke": 3}, {"id": 2, "name": "TORN GREATCOAT", "names": ["TORN GREATCOAT"], "gender": "?", "first": 5, "spoke": 0}, {"id": 3, "name": "BRANDT", "names": ["BRANDT"], "gender": "?", "first": 10, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FLOODED TRENCH - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Mud to the knees.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Barbed wire.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Smoke on the horizon.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "PRIVATE EMIL HARTMANN (20s, cracked glasses) crouches against the wall, rifle across his lap.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "A SOLDIER IN A TORN GREATCOAT (30s) slides into the trench beside him, breathing hard.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Is this Third Company?", "name": "SOLDIER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Who's asking?", "name": "EMIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Corporal. Lost my squad in the night.", "name": "SOLDIER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Name?", "name": "EMIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Brandt. Franz Brandt.", "name": "SOLDIER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Then welcome, Corporal Brandt.", "name": "EMIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Brandt leans back against the mud.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Quiet this morning.", "name": "BRANDT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Too quiet.", "name": "EMIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "A whistle shrieks overhead.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Both men duck.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "A shell lands a hundred yards off, throwing up a column of dirt.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Silence.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Then Emil laughs, shakily.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "That was close.", "name": "EMIL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Not close enough.", "name": "BRANDT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "They sit in the mud.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Neither speaks.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "The smoke drifts on.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}]}