{"scene_id": "s01688", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01688.fountain", "heading": "INT. FIELD HOSPITAL TENT - DAY", "cast": [{"id": 0, "name": "SERGEANT AUGUSTINE MBEKI", "names": ["SERGEANT AUGUSTINE MBEKI", "AUGUSTINE"], "gender": "m", "first": 4, "spoke": 8}, {"id": 1, "name": "CORPORAL TADEUSZ KOWALCZYK", "names": ["CORPORAL TADEUSZ KOWALCZYK", "TADEUSZ"], "gender": "m", "first": 5, "spoke": 6}, {"id": 2, "name": "MEDIC FELICITY ROUSE", "names": ["MEDIC FELICITY ROUSE", "FELICITY"], "gender": "?", "first": 6, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. FIELD HOSPITAL TENT - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Cots in rows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Canvas walls glow with afternoon sun.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A fan turns slowly overhead.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SERGEANT AUGUSTINE MBEKI (30s, bandaged arm) sits on a cot cleaning his boots.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across the aisle, CORPORAL TADEUSZ KOWALCZYK (20s, head wrapped in gauze) stares at the ceiling.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "At the foot of Tadeusz's cot, MEDIC FELICITY ROUSE (30s, bloodied apron) writes in a chart.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "How's the head?", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Still attached.", "name": "TADEUSZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "He's lucky. Another inch and it wouldn't be.", "name": "FELICITY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "You said that about me last week.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "And you're still lucky.", "name": "FELICITY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Is he always like this?", "name": "TADEUSZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Worse on Tuesdays.", "name": "FELICITY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "It's Wednesday.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Then you're improving.", "name": "FELICITY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "She flips a page, checks Tadeusz's pulse, and moves down the row.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Augustine watches her go.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "She's the best medic in the division.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "She's the only medic in the division.", "name": "TADEUSZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "That too.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "The fan ticks.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Do you think they'll send us back?", "name": "TADEUSZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "They always do.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "When?", "name": "TADEUSZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "When we're ready.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "And if we're not?", "name": "TADEUSZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Then they'll send us anyway.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Tadeusz closes his eyes.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Augustine goes back to his boots, brushing off the dust, one stroke at a time.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Mail's here! Anybody expecting a letter?", "name": "FELICITY", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Neither of them answers.", "para": 5, "sent": 0, "present": [0, 1, 2]}]}