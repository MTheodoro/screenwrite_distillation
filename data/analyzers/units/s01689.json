{"scene_id": "s01689", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01689.fountain", "heading": "EXT. SNOWBOUND MOUNTAIN PASS - DAY", "cast": [{"id": 0, "name": "GLORIA PENDERGAST", "names": ["GLORIA PENDERGAST", "GLORIA"], "gender": "f", "first": 4, "spoke": 2}, {"id": 1, "name": "DANIEL HOYT", "names": ["DANIEL HOYT", "DANIEL"], "gender": "?", "first": 5, "spoke": 1}, {"id": 2, "name": "SUNITA RAO", "names": ["SUNITA RAO", "SUNITA"], "gender": "?", "first": 6, "spoke": 1}, {"id": 3, "name": "TEDDY", "names": ["TEDDY"], "gender": "?", "first": 7, "spoke": 1}, {"id": 4, "name": "AUGUST LEBLANC", "names": ["AUGUST LEBLANC", "AUGUST"], "gender": "?", "first": 8, "spoke": 1}, {"id": 5, "name": "COLETTE", "names": ["COLETTE"], "gender": "?", "first": 8, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SNOWBOUND MOUNTAIN PASS - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Wind-scoured white.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A crashed bus lies on its side, half-buried in drift.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Six survivors huddle in its lee.", "para": 1, "sent": 0, "present": []}, {"u": 4, "kind": "action", "text": "GLORIA PENDERGAST (50s), the driver, scrapes ice off a window.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "action", "text": "DANIEL HOYT (30s) feeds a tiny fire.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "SUNITA RAO (40s) bandages a boy's hand.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "The boy, TEDDY (9), watches the flames.", "para": 1, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "AUGUST LEBLANC (60s) and his wife COLETTE (60s) share one blanket.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "action", "text": "She tucks Teddy's scarf tighter.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "He doesn't flinch.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Radio's dead.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Of course it is.", "name": "DANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "We have food for two days.", "name": "SUNITA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Three, if we ration.", "name": "AUGUST", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Four, if we don't mind being hungry.", "name": "COLETTE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "He hands her the last cracker.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "She breaks it in half and gives one piece to the boy.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Thank you.", "name": "TEDDY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "She nods.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Gloria sets her jaw, picks up a shovel, and heads into the wind.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "He rises to follow.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "She waves him back.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Stay. Keep the fire.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Daniel sits.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Sunita looks at the sky.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Nobody says a word.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}