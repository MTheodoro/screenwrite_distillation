{"scene_id": "s01691", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01691.fountain", "heading": "INT. INFLATABLE CASTLE RENTAL SHOP - DAY", "cast": [{"id": 0, "name": "MO", "names": ["MO"], "gender": "?", "first": 4, "spoke": 15}, {"id": 1, "name": "DELACROIX-BROWN", "names": ["DELACROIX-BROWN"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "PAIGE QUINTANILLA", "names": ["PAIGE QUINTANILLA", "PAIGE"], "gender": "f", "first": 5, "spoke": 14}, {"id": 3, "name": "GLADYS QUINTANILLA", "names": ["GLADYS QUINTANILLA", "GLADYS"], "gender": "f", "first": 5, "spoke": 4}, {"id": 4, "name": "FITZ", "names": ["FITZ"], "gender": "?", "first": 7, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. INFLATABLE CASTLE RENTAL SHOP - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A warehouse full of deflated bouncy castles, piled like sleeping dragons.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fans hum.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cash register dings.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MAURICE \"MO\" DELACROIX-BROWN (50s, polo shirt, sunburnt nose) stands behind the counter.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Across from him, bride-to-be PAIGE QUINTANILLA (30s, tailored blazer, manic energy) taps a tablet.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "action", "text": "Behind her, her mother GLADYS QUINTANILLA (60s, enormous sunglasses) examines a banner.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "In the corner, a lanky teenager, FITZ (17, apron with a name tag), pumps a foot blower.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "It has to be a castle. Not a bouncy house. A castle.", "name": "PAIGE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Ma'am, they're the same thing.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "They are not the same thing.", "name": "PAIGE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "It has turrets. It bounces.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "My wedding is in six days.", "name": "PAIGE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Mo takes a long breath.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Gladys tilts her sunglasses down.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Paige, honey, nobody's going to bounce at a wedding.", "name": "GLADYS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Mom, there are twelve children coming.", "name": "PAIGE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Twelve children and nobody's bouncing.", "name": "GLADYS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Fitz stops pumping.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "The blower wheezes out.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "He looks at the others and says nothing.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "I have the Camelot Deluxe. Seven by seven. Cannons on the parapet.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "How many cannons?", "name": "PAIGE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Four.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Do they fire?", "name": "PAIGE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Air, ma'am.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Fire real things?", "name": "PAIGE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Absolutely not.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Paige narrows her eyes.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Gladys lowers her sunglasses all the way and stares at Mo, then at the ceiling, as if praying.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "I'll take the Camelot.", "name": "PAIGE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Wonderful.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "But I want it in pink.", "name": "PAIGE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "It's gray.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Make it pink.", "name": "PAIGE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Mo looks at Fitz.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Fitz looks at the floor.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "The register dings by itself.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Fitz. Do we own pink paint?", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "We own a lot of paint.", "name": "FITZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Pink?", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "There's some salmon.", "name": "FITZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Salmon is pink.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "It is not.", "name": "PAIGE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Paige, salmon is a lovely color.", "name": "GLADYS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Mother!", "name": "PAIGE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Gladys folds her arms.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Paige breathes through her nose.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Mo slides a clipboard across the counter, and Paige signs without reading.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Fitz resumes pumping, a little faster than before.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Six days, then. I'll deliver Friday morning.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "Thursday night.", "name": "PAIGE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "Friday morning.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "Thursday.", "name": "PAIGE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "Thursday it is.", "name": "MO", "speaker": 0, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Paige sweeps out.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Gladys lingers, takes off the sunglasses, and slips Mo a folded fifty.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "For your trouble.", "name": "GLADYS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "She puts the glasses back on and follows her daughter out the door.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "Was that a tip?", "name": "FITZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "That was a ransom.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}