{"scene_id": "s01692", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01692.fountain", "heading": "INT. ROOFTOP CONSERVATORY - EVENING", "cast": [{"id": 0, "name": "SOLANGE MARCHETTI", "names": ["SOLANGE MARCHETTI", "SOLANGE"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "ARTHUR BEAUMONT", "names": ["ARTHUR BEAUMONT", "ARTHUR"], "gender": "?", "first": 4, "spoke": 3}, {"id": 2, "name": "CORDELIA BEAUMONT", "names": ["CORDELIA BEAUMONT", "CORDELIA"], "gender": "?", "first": 4, "spoke": 2}, {"id": 3, "name": "LEOPOLD VASS", "names": ["LEOPOLD VASS"], "gender": "?", "first": 4, "spoke": 0}, {"id": 4, "name": "HANNELORE KRUG", "names": ["HANNELORE KRUG"], "gender": "?", "first": 4, "spoke": 0}, {"id": 5, "name": "LAZARUS RENNICK", "names": ["LAZARUS RENNICK"], "gender": "?", "first": 8, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROOFTOP CONSERVATORY - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Glass and ironwork.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Orchids in terra-cotta pots.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A string quartet tunes in the corner.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SOLANGE MARCHETTI (30s, emerald dress) accepts a champagne flute while her fianc\u00e9, ARTHUR BEAUMONT (30s, tuxedo) is intercepted by his mother, CORDELIA BEAUMONT (60s, pearls), who plucks a stray thread from his lapel as the cellist, LEOPOLD VASS (20s, nervous), drops his bow and scrambles after it, and the violist, HANNELORE KRUG (40s, steel-rimmed glasses), steadies a music stand that Leopold's elbow almost topples, and Solange, observing all this, steps backward into a potted fern.", "para": 1, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 5, "kind": "dialogue", "text": "Sorry, ferns. Sorry.", "name": "SOLANGE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 6, "kind": "dialogue", "text": "You all right?", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "dialogue", "text": "Splendid.", "name": "SOLANGE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "At the door, LAZARUS RENNICK (30s, rumpled suit, a mysterious envelope) appears.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "action", "text": "He catches her eye, taps his chest twice.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "She stiffens.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "Arthur doesn't notice.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Arthur, stand straight.", "name": "CORDELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "I am standing straight, Mother.", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Straighter.", "name": "CORDELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Arthur, I need a moment.", "name": "SOLANGE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Solange, I need a moment.", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Both laugh, awkwardly.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Cordelia lifts an eyebrow.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Hannelore sets the stand down and glances toward the door.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Lazarus is gone.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "The envelope sits on the threshold, white against the dark tiles.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "I'll be right back.", "name": "SOLANGE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "She crosses the conservatory quickly, snatches the envelope, tears it open.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Her face drains of color.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Behind her, the quartet strikes up the first bars of a waltz, bright and cheerful.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}]}