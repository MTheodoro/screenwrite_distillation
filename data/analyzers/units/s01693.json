{"scene_id": "s01693", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01693.fountain", "heading": "INT. TRANSIT AUTHORITY LOST-PROPERTY OFFICE - DAY", "cast": [{"id": 0, "name": "OPAL REINHARDT", "names": ["OPAL REINHARDT", "OPAL"], "gender": "?", "first": 4, "spoke": 7}, {"id": 1, "name": "OLDER MAN", "names": ["OLDER MAN"], "gender": "?", "first": 5, "spoke": 6}, {"id": 2, "name": "AMBROSE", "names": ["AMBROSE"], "gender": "?", "first": 25, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. TRANSIT AUTHORITY LOST-PROPERTY OFFICE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Shelves of umbrellas, gloves, a prosthetic leg.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fluorescent tubes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A counter with a bell.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "OPAL REINHARDT (40s, cardigan, lanyard) sorts a bin of scarves, folding each into a neat square, one at a time, with the slow rhythm of someone who has not slept.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "At the counter, an OLDER MAN (70s, flat cap, grocery bag) waits, rocking on his heels, patient, polite, watching her.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Be right with you.", "name": "OPAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "No rush.", "name": "OLDER MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She finishes the scarf.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Moves to the next.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He glances at the shelves, at the umbrellas, at the leg, and back at her.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "What did you lose?", "name": "OPAL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "A coat.", "name": "OLDER MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Color?", "name": "OPAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Gray. Wool. My wife's initials in the lining.", "name": "OLDER MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Date?", "name": "OPAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Fourteenth. On the Number 9.", "name": "OLDER MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She crosses to a rack, runs her fingers along the hangers, and stops at a gray coat.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She lifts it, turns it inside out, finds the stitched letters.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She says nothing for several seconds.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "What initials?", "name": "OPAL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "M.R.", "name": "OLDER MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "She lowers the coat onto the counter, smoothing the sleeves.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Her hands tremble.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Sir. What's your name?", "name": "OPAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Ambrose Reinhardt.", "name": "OLDER MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "She closes her eyes.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Opens them.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Looks at him properly for the first time.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "He looks back at her, and something in his posture shifts, softens, as though he has recognized her also.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Opal?", "name": "AMBROSE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Hello, Dad.", "name": "OPAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "He takes the coat.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "He doesn't put it on.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "He holds it against his chest while the bell above the door jingles for someone else entirely.", "para": 6, "sent": 2, "present": [0, 1, 2]}]}