{"scene_id": "s01696", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01696.fountain", "heading": "INT. PIE-BAKING CONTEST TENT - DAY", "cast": [{"id": 0, "name": "CHLOE BANKS", "names": ["CHLOE BANKS", "CHLOE"], "gender": "f", "first": 4, "spoke": 1}, {"id": 1, "name": "HORACE PINKERTON", "names": ["HORACE PINKERTON", "HORACE"], "gender": "m", "first": 4, "spoke": 2}, {"id": 2, "name": "DOLORES FINCH", "names": ["DOLORES FINCH", "DOLORES"], "gender": "?", "first": 5, "spoke": 2}, {"id": 3, "name": "BIRDIE KAPOOR", "names": ["BIRDIE KAPOOR", "BIRDIE"], "gender": "?", "first": 6, "spoke": 3}, {"id": 4, "name": "RAJIV KAPOOR", "names": ["RAJIV KAPOOR", "RAJIV"], "gender": "?", "first": 6, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. PIE-BAKING CONTEST TENT - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Gingham tablecloths.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fans stirring warm air.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Judges' scorecards flutter in the draft.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CHLOE BANKS (30s, apron, flour on her cheek) lifts a lattice-topped pie and carries it to the judges, passing her rival HORACE PINKERTON (60s, chef's whites, ego like a thundercloud), who turns his own pie a precise quarter inch.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Meanwhile the host, DOLORES FINCH (50s, sequin blazer), twirls her microphone cord.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "Two tables over, nine-year-old BIRDIE KAPOOR (9) licks a spoon, and her father RAJIV KAPOOR (40s) tries gently to take it away.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "dialogue", "text": "Contestants, five minutes!", "name": "DOLORES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "Five? We were promised ten!", "name": "HORACE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "We were not promised ten.", "name": "CHLOE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Birdie, spoon.", "name": "RAJIV", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "It's evidence.", "name": "BIRDIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Evidence of what?", "name": "HORACE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "That your pie is dry.", "name": "BIRDIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Horace turns the color of rhubarb.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Chloe sets her pie down and presses her lips together very hard.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Folks, folks, let's keep it friendly!", "name": "DOLORES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Horace seizes his tin and thrusts it forward, but the crust slides and his whole filling lands on the floor in a perfect round puddle.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Nobody speaks.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "The fans whir.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Told you.", "name": "BIRDIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}