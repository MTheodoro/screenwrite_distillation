{"scene_id": "s01697", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01697.fountain", "heading": "INT. NEONATAL ICU - NIGHT", "cast": [{"id": 0, "name": "AMARA OKELLO", "names": ["AMARA OKELLO", "AMARA"], "gender": "f", "first": 4, "spoke": 6}, {"id": 1, "name": "NURSE WOJTEK BIALEK", "names": ["NURSE WOJTEK BIALEK", "WOJTEK"], "gender": "?", "first": 5, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. NEONATAL ICU - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dim.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Incubators glow like small aquariums.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Monitors beep in patient intervals.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. AMARA OKELLO (40s, surgical mask pulled under her chin) checks a chart.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside her, NURSE WOJTEK BIALEK (30s, soft-voiced) adjusts a tube.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "She lifts the baby's tiny wrist.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He holds a dosage syringe to the light.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Both are quiet.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Heart rate steady?", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Steady.", "name": "WOJTEK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She nods.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He adjusts the monitor.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She smiles, a little.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Go home, Wojtek.", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "After my shift.", "name": "WOJTEK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "It's three a.m.", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "After my shift.", "name": "WOJTEK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He moves to the next incubator.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She follows.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "They check, they chart, they check again.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "An alarm shrills.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Both spin.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "The monitor on bed four flatlines.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Doctor!", "name": "WOJTEK", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I see it.", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "She reaches in; he pulls the cover.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "She tilts the baby's chin, begins tiny compressions with two fingers.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "He hands her a syringe; she pushes it.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Nothing.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "She compresses again.", "para": 6, "sent": 4, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Come on.", "name": "WOJTEK", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Come on, little one.", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "A blip.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Another.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "A rhythm.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Both freeze, listening.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "The alarm cuts out.", "para": 7, "sent": 4, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "She lets out a shaky breath.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "He sets the syringe down.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Neither of them moves.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "She looks at him; he nods.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "That was close.", "name": "AMARA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Too close.", "name": "WOJTEK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "He pulls a stool over and sits.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "She takes the chart off its hook and, without a word, starts writing.", "para": 9, "sent": 1, "present": [0, 1]}]}