{"scene_id": "s01698", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01698.fountain", "heading": "EXT. BRIDGE OVER A BOTTOMLESS RAVINE - DAWN", "cast": [{"id": 0, "name": "HOODED TRAVELER", "names": ["HOODED TRAVELER"], "gender": "?", "first": 3, "spoke": 3}, {"id": 1, "name": "TROLL", "names": ["TROLL"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "ORVAL GRUNDSTONE", "names": ["ORVAL GRUNDSTONE", "ORVAL"], "gender": "?", "first": 4, "spoke": 9}, {"id": 3, "name": "MAELIS", "names": ["MAELIS"], "gender": "?", "first": 10, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. BRIDGE OVER A BOTTOMLESS RAVINE - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A rope bridge strung between two cliffs, shrouded in mist.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Below, a river roars unseen.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A HOODED TRAVELER (30s, patched cloak, a staff in hand) stands at the near end.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "On the far side waits a TROLL, ORVAL GRUNDSTONE (towering, mossy, a toll ledger tucked under one arm).", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "Is this the only crossing?", "name": "HOODED TRAVELER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Only one for a hundred leagues.", "name": "ORVAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Then I'll pay the toll.", "name": "HOODED TRAVELER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Toll is a story. A true one.", "name": "ORVAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "The traveler sets down the staff, lowers the hood to reveal a weathered face and a braid of silver-streaked hair.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Very well. My name is Maelis. I was a queen.", "name": "HOODED TRAVELER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Many were.", "name": "ORVAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "I lost my crown to my brother.", "name": "MAELIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Many did.", "name": "ORVAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "I killed him for it.", "name": "MAELIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Orval stops writing in the ledger.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "The mist swirls between them.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "That is new.", "name": "ORVAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Is it enough?", "name": "MAELIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "It is a beginning. Cross. Mind the third plank.", "name": "ORVAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "She steps onto the bridge.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "It sways.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "She grips the rope.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "I will mind it.", "name": "MAELIS", "speaker": 3, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "I did not say it was safe.", "name": "ORVAL", "speaker": 2, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "She crosses, plank by plank, one hand always on the rope.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "At the third plank she pauses, steps over it, and continues.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "On the far side, Orval offers a massive hand to help her up.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "She takes it.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Your name was Maelis.", "name": "ORVAL", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "It still is.", "name": "MAELIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Is it?", "name": "ORVAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "She smiles, thin and tired, and walks on into the mist.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}]}