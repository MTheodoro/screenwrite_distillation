{"scene_id": "s01699", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01699.fountain", "heading": "INT. HOSPICE GARDEN ROOM - AFTERNOON", "cast": [{"id": 0, "name": "LORRAINE PEARCE", "names": ["LORRAINE PEARCE", "LORRAINE"], "gender": "?", "first": 4, "spoke": 8}, {"id": 1, "name": "GREGORY PEARCE", "names": ["GREGORY PEARCE", "GREGORY"], "gender": "?", "first": 4, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOSPICE GARDEN ROOM - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Sun through gauze curtains.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A wheelchair by the window.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A tray of untouched tea.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LORRAINE PEARCE (70s, shawl, thin) watches birds on a feeder.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Her son, GREGORY PEARCE (40s, suit jacket over his arm) sits across from her, shifting.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Mom. Do you want the blanket?", "name": "GREGORY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "No.", "name": "LORRAINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "The window open?", "name": "GREGORY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "No.", "name": "LORRAINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Silence.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "The birds scatter and return.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I called Aunt Ruth.", "name": "GREGORY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "You shouldn't have.", "name": "LORRAINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "She wanted to know.", "name": "GREGORY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "She always wants to know.", "name": "LORRAINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Mom, I --", "name": "GREGORY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Gregory, I --", "name": "LORRAINE", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "They stop.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He gestures: you first.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She shakes her head.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Say it.", "name": "GREGORY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "I wasn't a good mother.", "name": "LORRAINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Don't.", "name": "GREGORY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "I'm tired of pretending.", "name": "LORRAINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "He puts the jacket down.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Takes her hand.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "You were fine, Mom.", "name": "GREGORY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Fine.", "name": "LORRAINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Fine is enough.", "name": "GREGORY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}