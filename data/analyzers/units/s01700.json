{"scene_id": "s01700", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01700.fountain", "heading": "INT. DEFUNCT BUS DEPOT - NIGHT", "cast": [{"id": 0, "name": "MATEUS SOTO", "names": ["MATEUS SOTO", "MATEUS"], "gender": "?", "first": 6, "spoke": 5}, {"id": 1, "name": "DEZI", "names": ["DEZI"], "gender": "?", "first": 7, "spoke": 2}, {"id": 2, "name": "JULIEN MOULTRIE", "names": ["MOULTRIE", "JULIEN MOULTRIE", "JULIEN"], "gender": "?", "first": 7, "spoke": 1}, {"id": 3, "name": "HUGO BRANDTNER", "names": ["HUGO BRANDTNER", "HUGO"], "gender": "?", "first": 7, "spoke": 1}, {"id": 4, "name": "AGNES LOVELACE", "names": ["AGNES LOVELACE", "AGNES"], "gender": "?", "first": 7, "spoke": 2}, {"id": 5, "name": "PADDY GLASS", "names": ["PADDY GLASS", "PADDY"], "gender": "?", "first": 7, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. DEFUNCT BUS DEPOT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cracked tile.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Bench seating, rusted.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A flickering departure board with no destinations.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Six masked figures enter through a loading door.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "They fan out.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "MATEUS SOTO (40s, the crew lead) raises a fist.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "Behind him, DESIREE \"DEZI\" MOULTRIE (30s) hauls a duffel; her brother JULIEN MOULTRIE (20s) props open the door; HUGO BRANDTNER (50s) unrolls a map on a bench; AGNES LOVELACE (60s) lifts a crowbar; and the kid, PADDY GLASS (19), keeps lookout, twitching.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "dialogue", "text": "Eyes up. Nobody moves until I say.", "name": "MATEUS", "speaker": 0, "ext": [], "paren": ["to the group"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "Stop jiggling the door.", "name": "DEZI", "speaker": 1, "ext": [], "paren": ["to Julien"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Sorry.", "name": "JULIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "East wall. East wall.", "name": "HUGO", "speaker": 3, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Where's the vault?", "name": "AGNES", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Under the baggage claim.", "name": "MATEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "There's no baggage claim.", "name": "PADDY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Under where it used to be.", "name": "MATEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Agnes sets the crowbar against a locker, strides to the broken department board, and swings.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "The glass shatters; behind it, a steel panel.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "She grins.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Found it.", "name": "AGNES", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Hugo scribbles on the map.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Julien lets the door swing shut and hurries over.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Dezi opens the duffel, pulls out a drill and a coil of cable.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Paddy glances at the street, then back, then at the street again.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Headlights.", "name": "PADDY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Everybody down!", "name": "MATEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "They drop behind benches, lockers, pillars.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "A pair of headlights sweeps the windows and slides past.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Nobody breathes.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "The engine fades.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "False alarm.", "name": "PADDY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Kid's going to give me a heart attack.", "name": "DEZI", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Back to work. Fifteen minutes.", "name": "MATEUS", "speaker": 0, "ext": [], "paren": ["to the group"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}