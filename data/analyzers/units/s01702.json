{"scene_id": "s01702", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01702.fountain", "heading": "INT. FLOATING LIBRARY - LANTERN HALL - TWILIGHT", "cast": [{"id": 0, "name": "IMELDA OGUNLEYE", "names": ["IMELDA OGUNLEYE", "IMELDA"], "gender": "f", "first": 5, "spoke": 15}, {"id": 1, "name": "BARTHOLOMEW QUILL", "names": ["BARTHOLOMEW QUILL", "BARTHOLOMEW"], "gender": "?", "first": 6, "spoke": 14}, {"id": 2, "name": "PIP", "names": ["PIP"], "gender": "m", "first": 7, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. FLOATING LIBRARY - LANTERN HALL - TWILIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Shelves rise in spirals into a sky of drifting clouds.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Books hover on invisible currents, flapping their covers like moths.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Lanterns bob at the ends of long gilt chains.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain falls upward past the windows.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "IMELDA OGUNLEYE (50s, patchwork robes, spectacles on a silver chain) sits at a vast oak desk, writing with a feather that dips itself into the ink.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Before her stands BARTHOLOMEW QUILL (30s, travel-stained coat, a leather satchel), hat in hand.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Perched on a high shelf, a small gray owl-shaped librarian called PIP watches them both with unblinking amber eyes.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Sit.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "I'd rather stand.", "name": "BARTHOLOMEW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "You'll sit, or the books won't speak to you.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He sits.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "A book drifts down and lands in his lap, spine trembling.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Is it always like this?", "name": "BARTHOLOMEW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Only on Tuesdays.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "It's Thursday.", "name": "BARTHOLOMEW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Then it is worse than I thought.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Hoo.", "name": "PIP", "speaker": 2, "ext": [], "paren": ["a soft hoot"], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Pip says you are late.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I came as soon as the letter reached me.", "name": "BARTHOLOMEW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "It reached you three weeks ago.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "The roads were closed.", "name": "BARTHOLOMEW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "The roads are always closed. That is what roads are for.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "He opens the book.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The pages are blank.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "He turns them.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Blank.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Blank.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "A single line of ink slowly blooms on the last page, in handwriting he recognizes.", "para": 3, "sent": 5, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "That's my mother's hand.", "name": "BARTHOLOMEW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Yes.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "She wrote this?", "name": "BARTHOLOMEW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "She is writing it now.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "She's been dead for nine years.", "name": "BARTHOLOMEW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "In this library, no one is dead until the last page is read.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Rain falls up.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "A lantern knocks softly against a shelf.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "What does it say?", "name": "BARTHOLOMEW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Read it aloud.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "\"My dear boy. If you are reading this, I have kept my promise.\"", "name": "BARTHOLOMEW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Hoo.", "name": "PIP", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Go on.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "\"I have kept it a very long time.\"", "name": "BARTHOLOMEW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "His voice cracks.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Imelda takes off her spectacles and polishes them on her sleeve, looking elsewhere.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Pip tucks his head under one wing.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Is there more?", "name": "BARTHOLOMEW", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "There is always more.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "How long may I stay?", "name": "BARTHOLOMEW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Until the lanterns burn down.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "And when is that?", "name": "BARTHOLOMEW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "When you stop reading.", "name": "IMELDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "He bends over the page.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "The lanterns brighten.", "para": 6, "sent": 1, "present": [0, 1, 2]}]}