{"scene_id": "s01703", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01703.fountain", "heading": "INT. GRAND HOTEL LAUNDRY ROOM - NIGHT", "cast": [{"id": 0, "name": "CROWE", "names": ["CROWE"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "IMOGEN TATE", "names": ["IMOGEN TATE", "IMOGEN"], "gender": "f", "first": 5, "spoke": 3}, {"id": 2, "name": "PIOTR SELENKO", "names": ["PIOTR SELENKO", "PIOTR"], "gender": "?", "first": 5, "spoke": 2}, {"id": 3, "name": "WICK", "names": ["WICK"], "gender": "m", "first": 5, "spoke": 2}, {"id": 4, "name": "WICKHAM", "names": ["WICKHAM"], "gender": "?", "first": 5, "spoke": 0}, {"id": 5, "name": "BELLHOP", "names": ["BELLHOP"], "gender": "?", "first": 16, "spoke": 0}, {"id": 6, "name": "GUARD", "names": ["GUARD"], "gender": "?", "first": 40, "spoke": 1}, {"id": 7, "name": "HOTEL SECURITY", "names": ["HOTEL SECURITY"], "gender": "?", "first": 44, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRAND HOTEL LAUNDRY ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Steam hisses from industrial presses.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Carts of white linen.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A tall window shows the city's lights.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CROWE (50s, quiet, hotel uniform) pushes a cart down the aisle, the picture of a bored night porter.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Behind him, three figures in identical gray overalls follow: IMOGEN TATE (30s), who counts keys; PIOTR SELENKO (40s), who whistles; and DESMOND \"WICK\" WICKHAM (20s), who hums a tune.", "para": 1, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 6, "kind": "dialogue", "text": "We walk. We do not run. We do not look at the cameras.", "name": "CROWE", "speaker": 0, "ext": [], "paren": ["to the group"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "dialogue", "text": "Which cameras?", "name": "WICK", "speaker": 3, "ext": [], "paren": ["under his breath"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "Wick.", "name": "IMOGEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Sorry.", "name": "WICK", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "They reach a service lift.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Crowe presses the call button.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Nothing.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Is it supposed to be broken?", "name": "PIOTR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "It is supposed to be slow.", "name": "CROWE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "The lift arrives.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "A BELLHOP (20s, pillbox hat) steps off, sees them, nods.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "They nod back.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "He walks on, whistling the same tune as Piotr.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "The doors close.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "The four of them ride up in silence.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Crowe checks a pocket watch.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Imogen clicks her tongue against her teeth.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Two hundred and six. Two hundred and seven.", "name": "IMOGEN", "speaker": 1, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "What are you counting?", "name": "PIOTR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Seconds.", "name": "IMOGEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Ding.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "The doors open on the penthouse corridor.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "The carpet is red, the walls gold.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "A single guard sits in an armchair at the far end, asleep.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Gentle. Gentle.", "name": "CROWE", "speaker": 0, "ext": [], "paren": ["to the group"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "They creep past the guard.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Wick, passing, nudges a vase with his elbow; it wobbles; he catches it, grinning like a boy.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Imogen swallows a laugh.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Crowe produces a key.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "The suite door opens without a sound.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Inside: a vault door, humming softly, gleaming.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Nobody speaks.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Then every light in the corridor comes on at once.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "The guard stands, no longer asleep, and unholsters a pistol.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Welcome, gentlemen. And lady.", "name": "GUARD", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "Crowe's shoulders sag a fraction.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "He slowly raises his hands.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "dialogue", "text": "Evening, Marcus.", "name": "CROWE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "The Guard smiles, and now we see the badge on his belt: HOTEL SECURITY, DIRECTOR.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}