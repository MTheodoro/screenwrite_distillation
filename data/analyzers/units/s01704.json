{"scene_id": "s01704", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01704.fountain", "heading": "INT. ZOO REPTILE HOUSE - OFFICE - DAY", "cast": [{"id": 0, "name": "NELLIE", "names": ["NELLIE"], "gender": "f", "first": 4, "spoke": 5}, {"id": 1, "name": "BRIGHTWATER", "names": ["BRIGHTWATER"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "PERCIVAL ADEWALE-STONE", "names": ["PERCIVAL ADEWALE-STONE", "PERCIVAL"], "gender": "?", "first": 5, "spoke": 3}, {"id": 3, "name": "HECTOR NAVARRO", "names": ["HECTOR NAVARRO", "HECTOR"], "gender": "?", "first": 6, "spoke": 4}, {"id": 4, "name": "INTERCOM", "names": ["INTERCOM"], "gender": "?", "first": 11, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. ZOO REPTILE HOUSE - OFFICE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Cluttered desk.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A taxidermy iguana on a filing cabinet.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "An intercom box on the wall.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ELEANOR \"NELLIE\" BRIGHTWATER (40s, khaki vest, perpetually frazzled) runs a hand through her hair.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Across from her, new hire PERCIVAL ADEWALE-STONE (20s, brand-new uniform, a clipboard clutched to his chest) sits rigidly.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "By the door, groundskeeper HECTOR NAVARRO (60s, rubber boots, tobacco-stained mustache) leans on a broom.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "So. Your first day.", "name": "NELLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Yes. I'm very excited.", "name": "PERCIVAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Don't be.", "name": "NELLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "It builds character.", "name": "HECTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Nellie, it's the snake house. Mamba's out.", "name": "INTERCOM", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Nellie shuts her eyes.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Percival stares at the intercom.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Out of what?", "name": "PERCIVAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Out of everything.", "name": "NELLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "She leaps to her feet and knocks the desk; papers go flying.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Hector drops the broom.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Percival ducks, and they all tangle in the doorway, jostling, pushing, shoving each other out into the corridor.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Also the python. And the gift shop.", "name": "INTERCOM", "speaker": 4, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "The gift shop?", "name": "HECTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Nobody panic.", "name": "NELLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Everyone's panicking.", "name": "PERCIVAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "I'm not.", "name": "HECTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Hector, you're holding the broom upside down.", "name": "NELLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "That's my panic.", "name": "HECTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "They scatter down the hall in three directions, shouting.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}]}