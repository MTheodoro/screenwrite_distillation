{"scene_id": "s01706", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01706.fountain", "heading": "INT. SUBMERGED CHAPEL - NIGHT", "cast": [{"id": 0, "name": "DETECTIVE IRENE KASPRZAK", "names": ["DETECTIVE IRENE KASPRZAK", "IRENE"], "gender": "?", "first": 6, "spoke": 6}, {"id": 1, "name": "FORENSIC TECH BASIL NWOSU", "names": ["FORENSIC TECH BASIL NWOSU", "BASIL"], "gender": "m", "first": 7, "spoke": 4}, {"id": 2, "name": "FATHER ANSELMO DURAN", "names": ["FATHER ANSELMO DURAN", "ANSELMO"], "gender": "?", "first": 8, "spoke": 4}, {"id": 3, "name": "VOICE", "names": ["VOICE"], "gender": "?", "first": 30, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. SUBMERGED CHAPEL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A drowned stone nave, half-flooded after a dam failure.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Waist-deep black water.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Pews float like wreckage.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Flashlights stab the dark, throwing wavering circles on vaulted arches overhead.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Water drips from a hole in the roof.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "DETECTIVE IRENE KASPRZAK (40s, waders, a tight jaw) wades down the aisle.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Behind her, FORENSIC TECH BASIL NWOSU (30s, a camera held overhead) picks his way through floating hymnals.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "A third figure, a local priest, FATHER ANSELMO DURAN (60s, black cassock hitched to his knees), carries a lantern, mumbling prayers.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Basil, light.", "name": "IRENE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Coming.", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Detective, this is a consecrated place.", "name": "ANSELMO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "It's a crime scene, Father.", "name": "IRENE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Both can be true.", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Not tonight.", "name": "ANSELMO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "A ripple spreads from the altar.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "All three stop.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Stay behind me.", "name": "IRENE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "It's only the dam still settling, it does that --", "name": "ANSELMO", "speaker": 2, "ext": [], "paren": ["over Irene"], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Those are footprints, Irene. Look, on the altar step. Wet.", "name": "BASIL", "speaker": 1, "ext": [], "paren": ["over Anselmo"], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Fresh?", "name": "IRENE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Minutes.", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Impossible. No one has been in here since the flood.", "name": "ANSELMO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Somebody has.", "name": "IRENE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "She raises her flashlight.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "The beam finds the altar, then a dark shape slumped behind it.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Water drips from a gloved hand.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Police! Show me your hands!", "name": "IRENE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Nothing.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Then the hand slowly moves, and a voice, small and hoarse, croaks out of the dark.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Father? Is that you?", "name": "VOICE", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Anselmo drops the lantern.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "It hisses out in the water.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "The chapel plunges into black.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}]}