{"scene_id": "s01707", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01707.fountain", "heading": "INT. CLOCKMAKER'S SHOP - NIGHT", "cast": [{"id": 0, "name": "INSPECTOR LOUISA HARDCASTLE", "names": ["INSPECTOR LOUISA HARDCASTLE", "LOUISA"], "gender": "f", "first": 5, "spoke": 14}, {"id": 1, "name": "BARNEY OKAFOR-LISTER", "names": ["BARNEY OKAFOR-LISTER", "BARNEY"], "gender": "?", "first": 6, "spoke": 13}], "units": [{"u": 0, "kind": "heading", "text": "INT. CLOCKMAKER'S SHOP - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Hundreds of clocks, all ticking, none in agreement.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Brass gears under glass domes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Pendulums swing in long cases along the walls.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single green-shaded lamp lights a workbench strewn with tiny screwdrivers.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "INSPECTOR LOUISA HARDCASTLE (50s, wool overcoat, gray streak in her hair) studies a grandfather clock whose glass door hangs open.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Behind the bench, the shop's owner, BARNEY OKAFOR-LISTER (50s, leather apron, loupe pushed up on his forehead), watches her with his hands flat on the wood.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "You said the clock stopped at 3:15.", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "It did.", "name": "BARNEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "And the man was found at 3:17.", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Yes.", "name": "BARNEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Then he was killed at 3:15.", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Or the clock was wrong.", "name": "BARNEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Your clocks are never wrong, Mr. Okafor-Lister.", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Mine, no. His, perhaps.", "name": "BARNEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Whose?", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "The victim's. He wound it himself.", "name": "BARNEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "He, who?", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "The man who died.", "name": "BARNEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "You said he came to you for repairs.", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "He did. He said it ran slow.", "name": "BARNEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "And did it?", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Not when I looked.", "name": "BARNEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She runs her gloved finger along the clock's pendulum, then lifts it to the lamp.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "A thin dusting of gold powder.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "She sniffs it.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Gold leaf.", "name": "LOUISA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "It would be. For the dial.", "name": "BARNEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "It's on the pendulum, not the dial.", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "He doesn't answer.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "A hundred clocks tick on.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "A cuckoo bursts from a case in the dark and sings once, shrilly, and withdraws.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Mr. Okafor-Lister. Who else had a key?", "name": "LOUISA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Only the man himself.", "name": "BARNEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "And the man's widow.", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "I didn't say that.", "name": "BARNEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "No. I did.", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "He looks at her.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "She looks at him.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Then, slowly, he reaches under the workbench and brings up a small velvet pouch, tilting it so that the gold dust trickles onto the bench.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "He told me it was for the restoration.", "name": "BARNEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "And you believed him.", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "She did.", "name": "BARNEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Louisa closes her eyes.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "The clocks strike the half hour, all at different times.", "para": 5, "sent": 1, "present": [0, 1]}]}