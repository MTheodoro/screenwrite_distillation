{"scene_id": "s01708", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01708.fountain", "heading": "INT. PAWNSHOP BACK ROOM - NIGHT", "cast": [{"id": 0, "name": "MAN IN TRENCHCOAT", "names": ["MAN", "MAN IN TRENCHCOAT"], "gender": "?", "first": 4, "spoke": 3}, {"id": 1, "name": "BEIGE TRENCHCOAT", "names": ["BEIGE TRENCHCOAT"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "GINO FALCONE", "names": ["GINO FALCONE", "GINO"], "gender": "?", "first": 4, "spoke": 8}, {"id": 3, "name": "TREVOR PRICE", "names": ["TREVOR PRICE"], "gender": "m", "first": 5, "spoke": 0}, {"id": 4, "name": "ELLIS", "names": ["ELLIS"], "gender": "m", "first": 13, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. PAWNSHOP BACK ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Shelves of guitars and watches.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single bare bulb.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A card table.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A MAN IN A BEIGE TRENCHCOAT (40s) sits across from GINO FALCONE (50s, shirt sleeves rolled, gold chain), who shuffles a deck.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 5, "kind": "action", "text": "Behind them, a lanky kid, TREVOR PRICE (20s, hoodie), leans on a locker, picking at a thumbnail.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "dialogue", "text": "You're late.", "name": "GINO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Traffic.", "name": "MAN IN TRENCHCOAT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "There's no traffic.", "name": "GINO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "That's what makes it suspicious.", "name": "MAN IN TRENCHCOAT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Trevor snorts.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Gino deals three cards face down.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Name's Gino. This is Trevor. What do we call you?", "name": "GINO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Ellis.", "name": "MAN IN TRENCHCOAT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Ellis what?", "name": "GINO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Just Ellis.", "name": "ELLIS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Gino flips a card.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Ace of spades.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "He grins.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Ellis, you know why you're here?", "name": "GINO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "You tell me.", "name": "ELLIS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Because you owe.", "name": "GINO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "I know what I owe.", "name": "ELLIS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Then pay.", "name": "GINO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Ellis reaches into his coat.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Trevor straightens, hand drifting to his waistband.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Gino raises a palm: easy.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Ellis slowly lays a thick envelope on the table.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Count it.", "name": "ELLIS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Gino thumbs through the bills, nods once, and slides the envelope under the table.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Pleasure doing business.", "name": "GINO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}