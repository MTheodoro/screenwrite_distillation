{"scene_id": "s01709", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01709.fountain", "heading": "INT. LAKESIDE CABIN - LIVING ROOM - NIGHT", "cast": [{"id": 0, "name": "ROSCOE ALDRIDGE", "names": ["ROSCOE ALDRIDGE", "ROSCOE"], "gender": "m", "first": 4, "spoke": 3}, {"id": 1, "name": "FRANCES ALDRIDGE", "names": ["FRANCES ALDRIDGE", "FRANCES"], "gender": "f", "first": 4, "spoke": 3}, {"id": 2, "name": "CAMILLA", "names": ["CAMILLA"], "gender": "?", "first": 4, "spoke": 1}, {"id": 3, "name": "LIAM", "names": ["LIAM"], "gender": "?", "first": 4, "spoke": 0}, {"id": 4, "name": "AUNT BEATA", "names": ["AUNT BEATA"], "gender": "f", "first": 4, "spoke": 0}, {"id": 5, "name": "DOCTOR", "names": ["DOCTOR"], "gender": "?", "first": 10, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAKESIDE CABIN - LIVING ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A wood stove ticks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Six chairs around a worn table.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A phone with a long cord hangs on the wall.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The Aldridge family gathers: father ROSCOE ALDRIDGE (60s), mother FRANCES ALDRIDGE (60s), their daughters CAMILLA (30s) and JOSEPHINE \"JO\" (28), son LIAM (25), and Frances's sister, AUNT BEATA (70s).", "para": 1, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 5, "kind": "action", "text": "Nobody has taken off a coat.", "para": 1, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 6, "kind": "action", "text": "The phone rings.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "action", "text": "Everyone looks at it.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "Frances rises, answers.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Hello?", "name": "FRANCES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Mrs. Aldridge? It's Dr. Suarez at Mercy General.", "name": "DOCTOR", "speaker": 5, "ext": ["V.O."], "paren": ["through phone"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Yes. Go ahead.", "name": "FRANCES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "I'm sorry. He didn't make it through the surgery.", "name": "DOCTOR", "speaker": 5, "ext": ["V.O."], "paren": ["through phone"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "Frances lowers the receiver.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "She stares at the wall.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Frances?", "name": "ROSCOE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "She hangs up.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Turns to the room.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "It's Papa.", "name": "FRANCES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Beata presses a hand to her mouth.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Camilla steps back.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Jo bursts into tears; Liam puts an arm around her.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Roscoe takes off his cap and holds it with both hands.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Then we go to him.", "name": "ROSCOE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Tonight?", "name": "CAMILLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Tonight.", "name": "ROSCOE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Nobody moves.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "The stove ticks.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Then Frances takes her purse from the table and opens the cabin door onto the dark lake.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}