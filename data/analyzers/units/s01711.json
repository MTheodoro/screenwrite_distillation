{"scene_id": "s01711", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01711.fountain", "heading": "INT. AIRPORT LONG-TERM PARKING STRUCTURE - LEVEL 4 - NIGHT", "cast": [{"id": 0, "name": "VESTA KORHONEN", "names": ["VESTA KORHONEN", "VESTA"], "gender": "?", "first": 5, "spoke": 13}, {"id": 1, "name": "ABEL TRUJILLO", "names": ["ABEL TRUJILLO", "ABEL"], "gender": "m", "first": 10, "spoke": 14}, {"id": 2, "name": "SERGEANT LENNOX ODUYA", "names": ["SERGEANT LENNOX ODUYA", "LENNOX"], "gender": "?", "first": 38, "spoke": 2}, {"id": 3, "name": "HAYDEN PRYCE", "names": ["HAYDEN PRYCE", "HAYDEN"], "gender": "?", "first": 44, "spoke": 1}, {"id": 4, "name": "ZELDA MORROW", "names": ["ZELDA MORROW", "ZELDA"], "gender": "?", "first": 44, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. AIRPORT LONG-TERM PARKING STRUCTURE - LEVEL 4 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Concrete.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Oil stains.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Sodium lights hum.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A lone car alarm somewhere, then silence.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "VESTA KORHONEN (40s, charcoal coat, briefcase) walks to a sedan, keys out, shoulders tight.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Footsteps echo behind her.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She stops.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "They stop.", "para": 1, "sent": 3, "present": [0]}, {"u": 9, "kind": "action", "text": "She turns.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "A man in a gray parka, ABEL TRUJILLO (50s, thick glasses), stands ten feet away, hands visible.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Ms. Korhonen.", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I don't know you.", "name": "VESTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "You will.", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Back off.", "name": "VESTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I'm not armed.", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Everybody says that.", "name": "VESTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Check me.", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Absolutely not.", "name": "VESTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Then listen. I worked with your brother.", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "My brother worked alone.", "name": "VESTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "He told you that.", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "He told me everything.", "name": "VESTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "He told you what he could.", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Where is he?", "name": "VESTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Not here.", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Where?", "name": "VESTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "I can take you.", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Why would I go anywhere with you?", "name": "VESTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Because you flew in for this. You wouldn't be here if you didn't half believe me.", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Don't tell me what I believe.", "name": "VESTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Then tell me yourself.", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "I believe my brother is dead.", "name": "VESTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Is that what they told you?", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "It's what the police told me.", "name": "VESTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "And what did you tell yourself?", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "She falls silent.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Her grip on the briefcase whitens.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "A third figure steps out of the dark behind Abel: SERGEANT LENNOX ODUYA (30s, patrol uniform, hand on holster).", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Mr. Trujillo. Step away from the lady.", "name": "LENNOX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Officer, there's no need --", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Now.", "name": "LENNOX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Abel raises his hands.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Vesta stares at Lennox, then at Abel, then at the ramp.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Two more cars roll up from below, headlights blinding, and a woman and a man, HAYDEN PRYCE (30s) and ZELDA MORROW (40s), step out in dark suits.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Ms. Korhonen? Federal agents. We need you to come with us.", "name": "HAYDEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Why?", "name": "VESTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "Because that man isn't who he says.", "name": "ZELDA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Abel meets her eyes, silent, then lowers his hands and turns his palms up: I told you.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}]}