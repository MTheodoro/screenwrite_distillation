{"scene_id": "s01712", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01712.fountain", "heading": "INT. TINY APARTMENT - KITCHEN - NIGHT", "cast": [{"id": 0, "name": "JOANNA CRUZ-DELACROIX", "names": ["JOANNA CRUZ-DELACROIX"], "gender": "?", "first": 4, "spoke": 0}, {"id": 1, "name": "VOICE MAIL", "names": ["VOICE MAIL"], "gender": "?", "first": 15, "spoke": 2}, {"id": 2, "name": "DANIEL", "names": ["DANIEL"], "gender": "?", "first": 15, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. TINY APARTMENT - KITCHEN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A narrow galley kitchen.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Mismatched mugs.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A window over the sink opens onto a brick wall and one square of sky.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "JOANNA CRUZ-DELACROIX (30s) stands at the counter in an oversized cardigan.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "A phone sits face-down beside a bowl of cold noodles.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "She stirs them, doesn't eat.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "She picks up the phone, flips it, sets it down.", "para": 1, "sent": 3, "present": [0]}, {"u": 8, "kind": "action", "text": "Her thumb hovers over the screen.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "She takes a breath.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "Presses.", "para": 2, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "The phone rings through the speaker.", "para": 3, "sent": 0, "present": [0]}, {"u": 12, "kind": "action", "text": "Once.", "para": 3, "sent": 1, "present": [0]}, {"u": 13, "kind": "action", "text": "Twice.", "para": 3, "sent": 2, "present": [0]}, {"u": 14, "kind": "action", "text": "Three times.", "para": 3, "sent": 3, "present": [0]}, {"u": 15, "kind": "dialogue", "text": "You've reached Daniel. I can't come to the phone right now. Leave a message.", "name": "VOICE MAIL", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "She mouths the next word along with the recording.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Or don't. I'll know it was you.", "name": "VOICE MAIL", "speaker": 1, "ext": ["V.O.", "CONT'D"], "paren": ["a soft laugh"], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "BEEP.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "She opens her mouth.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Closes it.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Her free hand rises to her collarbone, where a thin chain holds a small silver ring.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "She ends the call.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Sets the phone down.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Walks to the window.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Opens it, and cold air rushes in.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "She breathes it deeply.", "para": 7, "sent": 4, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "The phone buzzes on the counter.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "She doesn't turn.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "It buzzes again.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "She turns slowly, looks at it, and crosses back.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The screen shows a single word: DANIEL.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "She lets it ring.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Her shoulders drop.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "She picks it up, swipes, and brings it to her ear.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "She says nothing.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "On the other end, a pause, then a quiet voice.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Jo?", "name": "DANIEL", "speaker": 2, "ext": ["V.O."], "paren": ["through phone"], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "She sits down at the little table, very slowly.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Her hand covers her mouth.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "She nods, uselessly, to no one.", "para": 13, "sent": 2, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "I'm sorry. I'm so sorry I didn't call sooner.", "name": "DANIEL", "speaker": 2, "ext": ["V.O.", "CONT'D"], "paren": ["through phone"], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Her eyes fill.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "She finally lets herself smile.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "The noodles go on cooling beside her.", "para": 14, "sent": 2, "present": [0, 1, 2]}]}