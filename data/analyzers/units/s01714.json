{"scene_id": "s01714", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01714.fountain", "heading": "EXT. DUSTY CROSSROADS GENERAL STORE - NOON", "cast": [{"id": 0, "name": "SHERIFF AMOS BRIDGEWATER", "names": ["SHERIFF AMOS BRIDGEWATER", "AMOS"], "gender": "m", "first": 5, "spoke": 9}, {"id": 1, "name": "TAMSIN FOURKILLER", "names": ["TAMSIN FOURKILLER", "TAMSIN"], "gender": "f", "first": 6, "spoke": 3}, {"id": 2, "name": "WENDELL PRATT", "names": ["WENDELL PRATT", "WENDELL"], "gender": "?", "first": 7, "spoke": 3}, {"id": 3, "name": "HOLLIS CARDWELL", "names": ["HOLLIS CARDWELL", "HOLLIS"], "gender": "m", "first": 17, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DUSTY CROSSROADS GENERAL STORE - NOON", "present": []}, {"u": 1, "kind": "action", "text": "A false-fronted store beside a dry well.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A hitching post.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A sleeping dog under a porch.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Heat shimmers off the road.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SHERIFF AMOS BRIDGEWATER (50s, sweat-stained hat) sits on the porch whittling.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Beside him in a rocker, his deputy, TAMSIN FOURKILLER (30s, braid over her shoulder), sharpens a knife.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Inside the doorway, the shopkeeper, WENDELL PRATT (60s, apron), sweeps with a straw broom that moves less than it should.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Quiet day.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Quiet town.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Quiet's good for business.", "name": "WENDELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Is it?", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "It's never been bad.", "name": "WENDELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "The sound of hooves.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "All three look up.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "A lone rider approaches from the south, dust rising behind him.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "He reins up at the well, and dismounts, slowly.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "HOLLIS CARDWELL (40s, gray duster, face like leather, a revolver on each hip) dips a tin cup in the well.", "para": 2, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "He drinks, and watches them over the rim.", "para": 2, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Morning, stranger.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Afternoon, I think.", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Might be.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Hollis wipes his mouth on his sleeve.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Tamsin's knife stops against the whetstone.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Amos does not stop whittling.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Looking for a man.", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "This town's got a few.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "This one's called Baxter.", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Wendell's broom freezes.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Amos blows a shaving off his blade.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Don't know him.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Funny. He knows you, Sheriff.", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Nobody moves.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "The dog under the porch lifts its head, then lowers it.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Mister, you picked a hot day.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "I picked this one on purpose.", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "So what's your business?", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Same as yours, I expect. Old debts.", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Amos closes his knife, slips it into his pocket, and stands.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Hollis's hands hang loose at his sides.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Wendell, go inside.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Sheriff --", "name": "WENDELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Inside.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Wendell backs through the door and shuts it.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "A bolt slides.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Tamsin rises from the rocker, one hand on her hip.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Deputy. You too.", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "I'm fine here.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Suit yourself.", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "A fly drones.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Somewhere, a shutter bangs once in the wind.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}]}