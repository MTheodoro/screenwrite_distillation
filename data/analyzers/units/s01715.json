{"scene_id": "s01715", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01715.fountain", "heading": "INT. MIDWEST DINER - MORNING", "cast": [{"id": 0, "name": "CLARENCE VOSS-HOLT", "names": ["CLARENCE VOSS-HOLT", "CLARENCE"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "ESTELLE", "names": ["ESTELLE"], "gender": "?", "first": 5, "spoke": 3}, {"id": 2, "name": "MARISELA TORRES", "names": ["MARISELA TORRES"], "gender": "f", "first": 5, "spoke": 0}, {"id": 3, "name": "ROY DUNCAN", "names": ["ROY DUNCAN"], "gender": "?", "first": 5, "spoke": 0}, {"id": 4, "name": "LEVI HARKNESS", "names": ["LEVI HARKNESS"], "gender": "?", "first": 5, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. MIDWEST DINER - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Formica counters.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A pie case humming.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Steam on the windows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CLARENCE VOSS-HOLT (70s, suspenders, a coffee cup he never drinks) sits at the counter.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "His daughter ESTELLE (40s, work blazer) slides into the stool beside him as the waitress, MARISELA TORRES (50s, apron), pours her a cup, and in the corner booth two men in feed-store caps, ROY DUNCAN (60s) and LEVI HARKNESS (60s), argue softly about corn futures.", "para": 1, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 6, "kind": "dialogue", "text": "You came.", "name": "CLARENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "dialogue", "text": "You called.", "name": "ESTELLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "He nods.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "She stirs her coffee.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Neither looks at the other.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Marisela moves down the counter.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Roy slaps the table; Levi laughs.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "I sold the farm.", "name": "CLARENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Estelle's spoon stops.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Her jaw tightens.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "He keeps looking at the pie case.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "You what?", "name": "ESTELLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Signed Friday.", "name": "CLARENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "She stands so fast the stool spins.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Marisela freezes with the pot in her hand.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Roy and Levi fall silent.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Estelle grips the counter, breathes, and sits again.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "He finally turns.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Mom would've wanted me out.", "name": "CLARENCE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Mom would've wanted you to ask.", "name": "ESTELLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Clarence reaches over and lays a hand on hers.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "She lets him.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Marisela sets the pot down, and without a word, brings two slices of pie.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}]}