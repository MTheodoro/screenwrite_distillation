{"scene_id": "s01717", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01717.fountain", "heading": "EXT. DRAGON'S ROOST - MOUNTAIN LEDGE - DAWN", "cast": [{"id": 0, "name": "SIR OSWIN HARTLEY", "names": ["SIR OSWIN HARTLEY", "OSWIN"], "gender": "m", "first": 4, "spoke": 4}, {"id": 1, "name": "NELLA", "names": ["NELLA"], "gender": "?", "first": 4, "spoke": 2}, {"id": 2, "name": "FINCH", "names": ["FINCH"], "gender": "?", "first": 4, "spoke": 0}, {"id": 3, "name": "ZAHARA QUDSI", "names": ["ZAHARA QUDSI", "ZAHARA"], "gender": "f", "first": 4, "spoke": 2}, {"id": 4, "name": "BASIL THORNWICK", "names": ["BASIL THORNWICK", "BASIL"], "gender": "m", "first": 4, "spoke": 2}, {"id": 5, "name": "TAMARISK ODEN", "names": ["TAMARISK ODEN", "TAMARISK"], "gender": "?", "first": 23, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DRAGON'S ROOST - MOUNTAIN LEDGE - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A windswept ledge high on a black peak.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Clouds boil below.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "In the distance, a thin line of silver: the sea.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Four adventurers climb the last switchback: SIR OSWIN HARTLEY (40s, battered plate armor), the thief PETRONELLA \"NELLA\" FINCH (20s, hooded, quick-eyed), the mage ZAHARA QUDSI (30s, indigo robes, staff topped with a glowing crystal) and the young squire BASIL THORNWICK (14, carrying too many packs).", "para": 1, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 5, "kind": "dialogue", "text": "Quiet now. We approach.", "name": "OSWIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 6, "kind": "dialogue", "text": "I'm always quiet.", "name": "NELLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "dialogue", "text": "You hummed all night.", "name": "ZAHARA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "Only softly.", "name": "NELLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Sir, my pack is on fire.", "name": "BASIL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "What?", "name": "OSWIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Only a little.", "name": "BASIL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Zahara flicks her fingers; the flame hisses out.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "A deep rumble shakes the ledge.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Pebbles skitter down the rock.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "The adventurers freeze.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "That was the mountain, wasn't it?", "name": "OSWIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "That was something else.", "name": "ZAHARA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "A great shadow slides across them.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "A growl like grinding stones rolls down from above.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Oswin draws his sword.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Nella melts into the rocks.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Basil drops his packs.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Then, from the cave mouth ahead, a figure steps into the light: TAMARISK ODEN (60s, patched green cloak, a ring of keys at her belt), the dragon's keeper, holding a bucket.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Oh, don't mind him. He hasn't had his tea.", "name": "TAMARISK", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "His tea?", "name": "OSWIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Chamomile. Dry throat. Come in.", "name": "TAMARISK", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}