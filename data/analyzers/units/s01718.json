2, 3]}, {"u": 8, "kind": "dialogue", "text": "There's always something.", "name": "ISOLDE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Is that a bird?", "name": "JASPER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "It's a gull. Gulls mean land.", "name": "BAXTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Or a storm.", "name": "HILDEGARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "They scan the sky.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "A speck wheels and vanishes.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "The wind drops.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "The boat creaks.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "In the silence, a distant drone grows, faint, mechanical.", "para": 2, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "A small seaplane skims out of the clouds, banking low over the water.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "PILOT MARCEL DUVALIER (30s, leather helmet) leans from the open cockpit, waving a red flag.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Oh, thank God.", "name": "ISOLDE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "They see us!", "name": "JASPER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Hold your positions! I'm dropping a line!", "name": "PILOT", "speaker": 4, "ext": [], "paren": ["shouting over the engine"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Stay seated. All of you.", "name": "HILDEGARD", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Nobody moves.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Baxter lets the cup slip into the sea.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}]}