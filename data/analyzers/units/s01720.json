{"scene_id": "s01720", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01720.fountain", "heading": "INT. DRAINED MUNICIPAL SWIMMING POOL - NIGHT", "cast": [{"id": 0, "name": "ODALYS VANTERPOOL", "names": ["ODALYS VANTERPOOL", "ODALYS"], "gender": "?", "first": 3, "spoke": 2}, {"id": 1, "name": "BRAM OKONKWO", "names": ["BRAM OKONKWO", "BRAM"], "gender": "f", "first": 4, "spoke": 2}, {"id": 2, "name": "PRUDENCE HALE", "names": ["PRUDENCE HALE", "PRUDENCE"], "gender": "?", "first": 5, "spoke": 3}, {"id": 3, "name": "WENDELL DUCROIX", "names": ["WENDELL DUCROIX", "WENDELL"], "gender": "?", "first": 5, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRAINED MUNICIPAL SWIMMING POOL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cracked blue tile.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "One work light hums over the deep end.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "ODALYS VANTERPOOL (30s, night custodian, flashlight like a club) stands on the ladder.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "BRAM OKONKWO (20s, her apprentice) clutches a mop.", "para": 0, "sent": 3, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "PRUDENCE HALE (60s, retired lifeguard, whistle on a cord) and WENDELL DUCROIX (40s, city inspector, clipboard) crowd the rim above.", "para": 0, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "dialogue", "text": "Nobody swims here. Nobody has swum here since--", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Since the boy. Say it.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "The drain cover is secure, I signed it myself, I signed it twice--", "name": "WENDELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Something's knocking. Under the tile.", "name": "BRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "It's the pipes.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "It's counting.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Three slow knocks.", "para": 1, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "The work light dies.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Odalys and Bram scramble up the ladder, colliding, while Wendell drops the clipboard and Prudence blows the whistle once, hard.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Stop blowing that!", "name": "WENDELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Who's laughing? Somebody's laughing!", "name": "BRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Nobody. Nobody's down there.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "The light snaps back on.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "All four freeze.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "In the deep end, a single wet footprint, then another, walking toward them.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}]}