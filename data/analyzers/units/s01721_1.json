{"scene_id": "s01721_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01721.fountain", "heading": "INT. CABLE CAR - CONTINUOUS", "cast": [{"id": 0, "name": "HOLLIS BRANNIGAN", "names": ["HOLLIS BRANNIGAN", "HOLLIS"], "gender": "m", "first": 1, "spoke": 4}, {"id": 1, "name": "INGRID SOLVANG", "names": ["INGRID SOLVANG"], "gender": "f", "first": 3, "spoke": 0}, {"id": 2, "name": "TOMASZ KRAWIEC", "names": ["TOMASZ KRAWIEC", "TOMASZ"], "gender": "m", "first": 5, "spoke": 2}, {"id": 3, "name": "KEIKO ARAI", "names": ["KEIKO ARAI", "KEIKO"], "gender": "f", "first": 7, "spoke": 1}, {"id": 4, "name": "DARA NWOSU", "names": ["DARA NWOSU", "DARA"], "gender": "f", "first": 8, "spoke": 2}, {"id": 5, "name": "RUFUS", "names": ["RUFUS"], "gender": "m", "first": 20, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. CABLE CAR - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "HOLLIS BRANNIGAN (50s, park ranger, weathered face, steady hands) sits by the door with a thermos.", "para": 0, "sent": 0, "present": [0]}, {"u": 2, "kind": "action", "text": "He pours a cup and passes it along.", "para": 0, "sent": 1, "present": [0]}, {"u": 3, "kind": "action", "text": "INGRID SOLVANG (30s, climber, rope burns on her palms) takes it and smiles.", "para": 0, "sent": 2, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "She says nothing.", "para": 0, "sent": 3, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Beside her, TOMASZ KRAWIEC (40s, heavy coat, camera around his neck) photographs the gorge.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "His hands shake.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "KEIKO ARAI (20s, student, headphones around her neck) leans against the window, eyes closed.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "DARA NWOSU (30s, nurse, practical sneakers) checks a child's mitten, then pockets it.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Power's out on the whole line. They'll winch us by dark.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "By dark? That's six hours.", "name": "TOMASZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Closer to four.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "He glances at the roof hatch.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Nobody else notices.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "You keep looking up.", "name": "DARA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Habit.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "She studies him.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "He drinks his coffee.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "The radio on his belt crackles.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Everyone looks at it.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Station to car four. Hollis, you read me?", "name": "RUFUS", "speaker": 5, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Hollis thumbs the key.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Loud and clear, Rufus. What's the word?", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Don't let anybody open the hatch.", "name": "RUFUS", "speaker": 5, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Tomasz lowers his camera.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Keiko opens her eyes.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Why would he say that?", "name": "KEIKO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Because it isn't the wind, Hollis. Check the roof. Count the weight.", "name": "RUFUS", "speaker": 5, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Hollis stands.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "The car dips, slow and heavy, toward the back.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Ingrid grips the rail.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Dara moves in front of Keiko.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Tomasz backs away until he hits the glass.", "para": 7, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Overhead, something shifts.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "A pause.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Then three soft taps on the hatch, polite as a neighbor's.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "I count five of us.", "name": "TOMASZ", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "There are five of us.", "name": "DARA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "The taps come again.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "From underneath the floor.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}