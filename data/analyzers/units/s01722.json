{"scene_id": "s01722", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01722.fountain", "heading": "INT. ALL-NIGHT LAUNDROMAT - 3 A.M.", "cast": [{"id": 0, "name": "MARISOL REYES", "names": ["MARISOL REYES", "MARISOL"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "TEDDY OYELARAN", "names": ["TEDDY OYELARAN", "TEDDY"], "gender": "m", "first": 5, "spoke": 4}, {"id": 2, "name": "NKECHI BELL", "names": ["NKECHI BELL", "NKECHI"], "gender": "?", "first": 6, "spoke": 3}, {"id": 3, "name": "CAL DRUMMOND", "names": ["CAL DRUMMOND", "CAL"], "gender": "m", "first": 7, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. ALL-NIGHT LAUNDROMAT - 3 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent tubes buzz.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of orange plastic chairs, a broken change machine with a handwritten sign, a wall of dryers like portholes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain on the glass.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MARISOL REYES (17, hoodie, backpack stuffed with a prom dress in a garment bag) sits on a washer, knees up.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "TEDDY OYELARAN (17, tall, thin, a cast on his left wrist) feeds quarters into a dryer.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "NKECHI BELL (16, Marisol's cousin, braids, school jacket) paces.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "CAL DRUMMOND (18, ex-boyfriend, letterman jacket, car keys in his fist) stands by the door, dripping.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Everybody just calm down.", "name": "CAL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "You told me he wasn't coming.", "name": "NKECHI", "speaker": 2, "ext": [], "paren": ["to Marisol"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "I didn't know.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I just want to talk.", "name": "CAL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Here we go.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Okay, nobody is doing this tonight.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Cal steps forward.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Teddy puts down the quarters and stands between them, wrist cast raised like a stop sign.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Cal. Buddy. It's three in the morning.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Stay out of it, Teddy.", "name": "CAL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "I'm in it. I'm holding her dress.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "He is.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "He doesn't remember picking it up.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "I'm calling my mom.", "name": "NKECHI", "speaker": 2, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Don't you dare.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Cal's fist closes on the keys.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Then, slowly, he opens it.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "He lets the keys drop onto the chair and sits down hard, shoulders loose.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "I drove forty minutes. I don't even know what I was going to say.", "name": "CAL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Nobody answers.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "A dryer buzzes.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Marisol slides off the washer.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Then say it. You've got until this cycle's over.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "She sets the timer on the dryer.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Thirty-one minutes.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Teddy hands Cal a warm towel from the load without a word.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "That's somebody's towel.", "name": "NKECHI", "speaker": 2, "ext": [], "paren": ["to Teddy"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "It's everybody's now.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}