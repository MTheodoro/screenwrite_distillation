{"scene_id": "s01723", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01723.fountain", "heading": "INT. WIRELESS ROOM - STEAMSHIP \"MERIDIAN\" - NIGHT (1912)", "cast": [{"id": 0, "name": "AGNES FENWICK", "names": ["AGNES FENWICK", "AGNES"], "gender": "f", "first": 4, "spoke": 4}, {"id": 1, "name": "PHILIPPA ASHCROFT", "names": ["PHILIPPA ASHCROFT", "PHILIPPA"], "gender": "f", "first": 5, "spoke": 4}, {"id": 2, "name": "CAPTAIN HARGREAVES", "names": ["CAPTAIN HARGREAVES"], "gender": "?", "first": 16, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. WIRELESS ROOM - STEAMSHIP \"MERIDIAN\" - NIGHT (1912)", "present": []}, {"u": 1, "kind": "action", "text": "A cramped brass-and-oak cabin.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A spark-gap transmitter crackles.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A speaking tube hangs by the door.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "AGNES FENWICK (20s, wireless operator, ink on her cuffs) taps a key, headphones crooked on her head.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "PHILIPPA ASHCROFT (30s, first-class passenger in a fur collar) stands behind her, gripping the back of the chair.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "She said it was only a drill. She promised.", "name": "PHILIPPA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "She says a great many things, ma'am.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Philippa leans closer.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Agnes pulls a sheet of paper from under the key and covers it with her sleeve.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She watches her the way a cat watches a draft.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Show me what you wrote.", "name": "PHILIPPA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I can't.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "She told me to ask. She gave me leave.", "name": "PHILIPPA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "The speaking tube whistles.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Agnes snatches the cap off.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Miss Fenwick. Is the passenger with you?", "name": "CAPTAIN HARGREAVES", "speaker": 2, "ext": ["V.O."], "paren": ["through the tube"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "She is, sir.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Then you'll finish the message and you'll send it as written. All of it. Do you understand?", "name": "CAPTAIN HARGREAVES", "speaker": 2, "ext": ["V.O."], "paren": ["through the tube"], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Philippa takes the paper from under Agnes's sleeve.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "She reads.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Her face goes white.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Agnes stands, and the chair scrapes the deck.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Ma'am, please sit.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Send it.", "name": "PHILIPPA", "speaker": 1, "ext": [], "paren": ["very quiet"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Agnes lowers her hand to the key.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The spark leaps.", "para": 5, "sent": 1, "present": [0, 1, 2]}]}