{"scene_id": "s01725", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01725.fountain", "heading": "INT. CURLING CLUB - SATURDAY MORNING", "cast": [{"id": 0, "name": "GRETA HOLMQUIST", "names": ["GRETA HOLMQUIST", "GRETA"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "BJORN LUND", "names": ["BJORN LUND", "BJORN"], "gender": "m", "first": 5, "spoke": 1}, {"id": 2, "name": "ILSE NAKAMURA", "names": ["ILSE NAKAMURA", "ILSE"], "gender": "?", "first": 6, "spoke": 1}, {"id": 3, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 7, "spoke": 3}, {"id": 4, "name": "FELIX", "names": ["FELIX"], "gender": "?", "first": 17, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. CURLING CLUB - SATURDAY MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Empty sheet of ice.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rocks lined up like sleeping animals.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A scoreboard that says nothing.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "GRETA HOLMQUIST (40s, skip, club jacket) sweeps a rock into place.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "BJORN LUND (50s, vice, thermos) watches from the hack.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "ILSE NAKAMURA (20s, newest member, brand-new broom) stands too straight.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "A STRANGER (30s, rental shoes, borrowed gloves) pushes open the glass door and stands at the edge of the ice.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Closed to the public.", "name": "GRETA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "I called. A woman said Saturday.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "That was Ilse.", "name": "BJORN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I said come at noon.", "name": "ILSE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "It's eleven fifty.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Bjorn laughs into his thermos.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Greta says nothing.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "She slides a rock back to the hack.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "What's your name?", "name": "GRETA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Felix.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Felix. Ever held a broom?", "name": "GRETA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "My father curled. I never did.", "name": "FELIX", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "That's the best kind.", "name": "GRETA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "She hands him her broom.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Felix steps onto the ice, arms out for balance.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Ilse shifts to make room.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Bjorn lifts the thermos, pours a fourth cup, and sets it on the boards.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}]}