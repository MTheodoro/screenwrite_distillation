{"scene_id": "s01726", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01726.fountain", "heading": "EXT. DRIVE-IN CONCESSION ROOF - NIGHT", "cast": [{"id": 0, "name": "TAVITA SOLOMONA", "names": ["TAVITA SOLOMONA", "TAVITA"], "gender": "m", "first": 4, "spoke": 10}, {"id": 1, "name": "ROZ KELLERMAN", "names": ["ROZ KELLERMAN", "ROZ"], "gender": "f", "first": 5, "spoke": 11}, {"id": 2, "name": "EAMON FLYNN", "names": ["EAMON FLYNN", "EAMON"], "gender": "m", "first": 6, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DRIVE-IN CONCESSION ROOF - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Tar paper.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A dead neon popcorn bucket.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The big screen glows blue over a field of parked cars.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "TAVITA SOLOMONA (17, linebacker shoulders, soft eyes) sits on the edge.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "ROZ KELLERMAN (17, sharp, camera strapped on) crouches near the vent.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "EAMON FLYNN (16, small, hands in his sleeves) arrives last through the hatch.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Eamon's boots on tin.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Everyone freezes.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "You're late.", "name": "ROZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "My mom had me.", "name": "EAMON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Tavita stands.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Roz stands.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "They back away from the hatch.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "A flashlight beam sweeps the lot below.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Cops.", "name": "TAVITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Security.", "name": "ROZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "It's the same thing.", "name": "TAVITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Get down!", "name": "ROZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "All three drop flat.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Tavita pulls Eamon by the collar.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Roz's camera clacks on the tar.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "The beam slides past them, and passes.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "They breathe.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Then Eamon laughs.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Tavita shoves him.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Eamon shoves back.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "They tumble, wheezing, quiet as they can be.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Stop it. Stop.", "name": "ROZ", "speaker": 1, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Roz, you looked so scared.", "name": "EAMON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "I was not.", "name": "ROZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "You were crying.", "name": "TAVITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "I was not!", "name": "ROZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Tav, you cried too.", "name": "EAMON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "I cry at commercials. It doesn't count.", "name": "TAVITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "You said you'd tell him tonight.", "name": "ROZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Tell who what?", "name": "TAVITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Eamon. About the move.", "name": "ROZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "What move?", "name": "EAMON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "It's nothing.", "name": "TAVITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "It's Ohio.", "name": "ROZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Ohio?", "name": "EAMON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "My dad's job. It's August. I didn't want to say it up here.", "name": "TAVITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "You were gonna say it at the lake. You said that.", "name": "EAMON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "I know what I said.", "name": "TAVITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "So say it.", "name": "ROZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "I'm moving. I'm sorry. I'm sorry.", "name": "TAVITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Okay.", "name": "EAMON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Okay?", "name": "TAVITA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Okay. That's August. It's June.", "name": "EAMON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "We have the whole summer.", "name": "ROZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "We have sixty-one nights. I counted.", "name": "EAMON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Tavita wipes his face with his sleeve.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Roz lifts her camera.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "The film flickers across all three of them, blue.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "She takes the picture.", "para": 7, "sent": 0, "present": [0, 1, 2]}]}