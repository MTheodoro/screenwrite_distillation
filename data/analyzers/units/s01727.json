{"scene_id": "s01727", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01727.fountain", "heading": "INT. PIGEON-RACING CLUB - BANQUET HALL - EVENING", "cast": [{"id": 0, "name": "OTTOLINE VANDERMEER", "names": ["OTTOLINE VANDERMEER", "OTTOLINE"], "gender": "f", "first": 5, "spoke": 25}, {"id": 1, "name": "BARNABY CROWE", "names": ["BARNABY CROWE", "BARNABY"], "gender": "m", "first": 7, "spoke": 22}, {"id": 2, "name": "CLEMENTINE ASHBY-NOLAN", "names": ["CLEMENTINE ASHBY-NOLAN", "CLEMENTINE"], "gender": "?", "first": 11, "spoke": 14}], "units": [{"u": 0, "kind": "heading", "text": "INT. PIGEON-RACING CLUB - BANQUET HALL - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "A low-ceilinged hall that smells of boiled ham and floor wax.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Trophies line the walls, each topped with a small bronze bird in mid-flap.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Round tables wear paper cloths.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "One table, at the back, has been set for three, and a single basket of bread rolls sits between the places like a negotiated settlement.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "OTTOLINE VANDERMEER (60s) arrives first, in a green velvet dress she has plainly owned since the club's previous presidency.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She arranges the cutlery by the width of a thumb, sits, and begins to examine her roll as if it might be called to testify.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "BARNABY CROWE (50s) enters carrying a wrapped trophy under one arm and a plastic bag of seed under the other, which he has not been able to leave in the coat room.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He stands for a moment at the end of the table.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He sets the trophy down gently, face-forward.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He sets the seed down with considerably less ceremony.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "CLEMENTINE ASHBY-NOLAN (30s), the youngest person in the room by twenty years, comes in last.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "She has a clipboard.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She also has the expression of someone who has already lost the argument she is about to start.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "You're sitting there?", "name": "OTTOLINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "It was my chair last year.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Last year you were also winning.", "name": "OTTOLINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I'm winning this year.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "The scores aren't posted until after the soup.", "name": "CLEMENTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Then you can sit where you like until after the soup.", "name": "OTTOLINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Barnaby does not sit.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "He lifts the trophy by its base and sets it on the table, an inch closer to Ottoline's plate than to his own.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "I wrapped it myself.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "It looks wrapped.", "name": "OTTOLINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Four layers.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "In what?", "name": "OTTOLINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "In tissue. Mostly.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Mostly.", "name": "OTTOLINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "It's, ah. It's the Hartley Cup. Which is, strictly, for the best bird in the northern loft.", "name": "CLEMENTINE", "speaker": 2, "ext": [], "paren": ["consulting clipboard"], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "It is.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "And Barnaby's northern loft is where?", "name": "OTTOLINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Right where it's always been.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Behind a dry cleaner's.", "name": "OTTOLINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "It's a very good dry cleaner's.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "I think that's not the question.", "name": "CLEMENTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "No. The question is whether it's a very good bird.", "name": "OTTOLINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "She flew four hundred miles.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "So I'm told.", "name": "OTTOLINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "In nine hours.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "In nine hours, from a basket, in a van, according to the van driver.", "name": "OTTOLINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "I have the van driver's log. If anyone wants it.", "name": "CLEMENTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Nobody wants it.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "I'd like to see it.", "name": "OTTOLINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Clementine slides the clipboard across the table.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Barnaby's hand lands on it first.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "For a moment all three hands rest on the same sheet of paper, and none of them moves.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "It's the club's business.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "I am the club's business. Fifty-one years.", "name": "OTTOLINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "You were treasurer for thirty of them.", "name": "CLEMENTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Thirty-one.", "name": "OTTOLINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "I stand corrected.", "name": "CLEMENTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "You don't stand at all. You sit with a clipboard.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "It's a very good clipboard.", "name": "CLEMENTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Everything in this room is very good.", "name": "OTTOLINE", "speaker": 0, "ext": [], "paren": ["to her roll"], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "A waiter passes with soup.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "All three lean back, hands retreating from the clipboard, and watch him set down three bowls.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Nobody reaches for a spoon.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "Is it mushroom?", "name": "OTTOLINE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "It's brown.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "It's mushroom. I checked.", "name": "CLEMENTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "You check everything.", "name": "OTTOLINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Someone has to.", "name": "CLEMENTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "You could have checked the bird.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "I did.", "name": "CLEMENTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "Pause.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "And?", "name": "OTTOLINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "And she's a very good bird.", "name": "CLEMENTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "dialogue", "text": "Thank you.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 68, "kind": "dialogue", "text": "It's not the same bird that was entered.", "name": "CLEMENTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "A spoon is lifted.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "A spoon is set down.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 71, "kind": "action", "text": "Barnaby slides the trophy back an inch toward himself, then, looking at no one, an inch toward the middle of the table.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 72, "kind": "dialogue", "text": "I'd like to see her.", "name": "OTTOLINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 73, "kind": "dialogue", "text": "She's in the car.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 74, "kind": "dialogue", "text": "In the car.", "name": "OTTOLINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 75, "kind": "dialogue", "text": "In the basket. On the back seat. With the windows down an inch.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 76, "kind": "dialogue", "text": "Fetch her.", "name": "OTTOLINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 77, "kind": "dialogue", "text": "It's raining.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 78, "kind": "dialogue", "text": "She's a pigeon.", "name": "OTTOLINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 79, "kind": "dialogue", "text": "She's nervous.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 80, "kind": "dialogue", "text": "Mr. Crowe. Which bird is she?", "name": "CLEMENTINE", "speaker": 2, "ext": [], "paren": ["gently"], "dual": false, "present": [0, 1, 2]}, {"u": 81, "kind": "action", "text": "Barnaby opens his mouth.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 82, "kind": "action", "text": "He closes it again.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 83, "kind": "action", "text": "He picks up his spoon and tastes the soup, and his face does something complicated, and he tastes it again.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 84, "kind": "dialogue", "text": "It is mushroom.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 85, "kind": "dialogue", "text": "It is.", "name": "OTTOLINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 86, "kind": "dialogue", "text": "It's actually quite good.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 87, "kind": "dialogue", "text": "It always has been.", "name": "OTTOLINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 88, "kind": "action", "text": "She tears her roll in half.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 89, "kind": "action", "text": "She puts one half on Barnaby's bread plate, and does not look at him while she does it.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 90, "kind": "dialogue", "text": "So the scores?", "name": "CLEMENTINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 91, "kind": "dialogue", "text": "After the soup.", "name": "OTTOLINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}