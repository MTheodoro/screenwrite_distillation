{"scene_id": "s01728", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01728.fountain", "heading": "EXT. SALT FLAT - DAWN", "cast": [{"id": 0, "name": "ANNELIESE VOGT", "names": ["ANNELIESE VOGT", "ANNELIESE"], "gender": "f", "first": 4, "spoke": 5}, {"id": 1, "name": "JORUND HALVORSEN", "names": ["JORUND HALVORSEN", "JORUND"], "gender": "?", "first": 5, "spoke": 11}, {"id": 2, "name": "PILAR ESPINOSA", "names": ["PILAR ESPINOSA", "PILAR"], "gender": "?", "first": 6, "spoke": 7}, {"id": 3, "name": "MOX", "names": ["MOX"], "gender": "m", "first": 7, "spoke": 6}, {"id": 4, "name": "DEV KAPOOR", "names": ["DEV KAPOOR", "DEV"], "gender": "m", "first": 8, "spoke": 7}, {"id": 5, "name": "DISPATCH", "names": ["DISPATCH"], "gender": "?", "first": 43, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SALT FLAT - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "White to every horizon.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A pickup truck, hood up, sits dead in the middle of nothing.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Heat shimmer already.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ANNELIESE VOGT (40s, geologist, sunburned neck, a sun hat tied under her chin) walks a slow circle around the truck, boots crunching crust.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "JORUND HALVORSEN (50s, driver, gray beard, canvas vest) sits on the tailgate, drinking the last of the water.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "PILAR ESPINOSA (30s, photographer, cameras on both hips) crouches in the shade of the tire.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "MOX (19, nickname, nobody uses his real one, shaved head, wide eyes) sits in the cab with the door open.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "DEV KAPOOR (30s, engineer, glasses, calm) lies under the truck on a flattened cardboard box.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "It's the fuel line. Cracked clean through.", "name": "DEV", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Can you fix it?", "name": "JORUND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "With what, Jorund? Gum?", "name": "DEV", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Hey. Anneliese. Come sit.", "name": "PILAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "I'm looking for the road.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "It's behind us. Forty miles behind us.", "name": "PILAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Forty-one.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Is it forty or forty-one?", "name": "MOX", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Forty-one, Mox. I counted on the odometer.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Okay. That's good. That's a good number.", "name": "MOX", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Jorund tilts the empty bottle and sets it down.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Pilar lifts a camera and takes a picture of the whole white nothing.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Nobody panic, right? We have the satellite phone.", "name": "PILAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "We have a satellite phone.", "name": "JORUND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "That's what I said.", "name": "PILAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "No. I said, we have a satellite phone. I'm telling you, we have a phone.", "name": "JORUND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "A long silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Dev slides out from under the truck and sits up, wiping his hands on his shirt.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Is the phone working, Jorund?", "name": "DEV", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "It has a battery.", "name": "JORUND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Is the phone working?", "name": "DEV", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Pilar, hand me the pack.", "name": "JORUND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Pilar passes the pack.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "He unzips it.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "He takes out the satellite phone, dials, holds it to his ear.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "The others lean in.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "A beat.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "His eyes settle on the horizon.", "para": 4, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "It's ringing.", "name": "JORUND", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Oh, thank God.", "name": "MOX", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Put it on speaker.", "name": "PILAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Wait for it.", "name": "DEV", "speaker": 4, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "A click.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "A voice, warm, bored.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Salt Flat Rescue Coordination, this is Marianne.", "name": "DISPATCH", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "We're stranded. Mile marker forty-one, west of the old road. Four of us. Five. Five of us.", "name": "JORUND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Copy five. Is anyone injured?", "name": "DISPATCH", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Why is everybody smiling?", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": ["to Dev"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "Because they're coming.", "name": "DEV", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "Sir, your coordinates show you at the mile marker. I can have a team to you by ten. Please stay by the vehicle.", "name": "DISPATCH", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "Ten! That's, that's only a few hours!", "name": "MOX", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "Mox, sit.", "name": "PILAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "I'm sitting.", "name": "MOX", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "Thank you, Marianne. Ten is good.", "name": "JORUND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "Sir, one more thing. I'm showing the beacon on your vehicle was triggered at four a.m. last night.", "name": "DISPATCH", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "We didn't trigger any beacon.", "name": "JORUND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "No, sir. That's what I wanted to ask. Because there are two vehicles at those coordinates.", "name": "DISPATCH", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "Jorund lowers the phone.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "Anneliese straightens.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "Dev looks up.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "Pilar, where did you put the second set of keys?", "name": "DEV", "speaker": 4, "ext": [], "paren": ["slowly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "What second set?", "name": "PILAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "At the edge of the flat, a mile away, sunlight catches the windshield of a second truck, parked, with its engine running, waiting.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "dialogue", "text": "Jorund. Who told you to drive out here?", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "Jorund looks at the phone.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "He looks at the truck.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "He looks at Mox, who does not look back.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "dialogue", "text": "Mox, put your hands where I can see them.", "name": "JORUND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "dialogue", "text": "Jorund, it isn't what you think.", "name": "MOX", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "dialogue", "text": "Nobody ever says what it is.", "name": "JORUND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "action", "text": "Mox takes one step out of the cab.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "action", "text": "Pilar's camera drops into the salt.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}