{"scene_id": "s01730", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01730.fountain", "heading": "INT. HOSPITAL VENDING ALCOVE - NIGHT", "cast": [{"id": 0, "name": "WOMAN", "names": ["WOMAN"], "gender": "f", "first": 4, "spoke": 2}, {"id": 1, "name": "LUCIA REYNOSO", "names": ["LUCIA REYNOSO", "LUCIA"], "gender": "f", "first": 5, "spoke": 2}, {"id": 2, "name": "ARLO", "names": ["ARLO"], "gender": "f", "first": 6, "spoke": 1}, {"id": 3, "name": "NORBERT", "names": ["NORBERT"], "gender": "?", "first": 23, "spoke": 2}, {"id": 4, "name": "DELPHINE", "names": ["DELPHINE"], "gender": "f", "first": 23, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOSPITAL VENDING ALCOVE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A humming machine.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Bad light.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A bench bolted to the wall.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A WOMAN (40s, wrinkled scrubs under a trench coat) stands at the machine, a dollar bill in her hand that the slot keeps spitting back.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "LUCIA REYNOSO (30s, her younger sister, cardigan buttoned wrong) sits on the bench.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "ARLO (9, in pajamas, shoes without socks) sits beside Lucia, swinging his legs.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "The Woman smooths the bill on her thigh.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Tries again.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "It spits back.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Let me.", "name": "LUCIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "It's fine.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Lucia takes the bill from her.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "The machine accepts it on the first try.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "The Woman watches the coil turn and a bag of pretzels drop.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "It likes me.", "name": "LUCIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "It always did.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Lucia hands her the pretzels.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "She hands them to Arlo.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "His legs stop swinging.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Her phone buzzes on the bench.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Lucia picks it up and holds it out.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "The Woman takes it, puts it on speaker, sets it on the machine.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Delphine? Delphine, are you there?", "name": "NORBERT", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "I'm here, Norbert.", "name": "DELPHINE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "They said it was quick. They said she didn't wake up.", "name": "NORBERT", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Delphine closes her eyes.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Lucia puts a hand over her mouth.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Arlo opens the pretzels and holds out the bag to nobody.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Thank you for calling.", "name": "DELPHINE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "She ends the call.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Nobody speaks.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Then Arlo slides the bag toward her, one pretzel poking out like a small, brave offering.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Aunt Delphine? You can have the first one.", "name": "ARLO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}