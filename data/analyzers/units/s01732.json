{"scene_id": "s01732", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01732.fountain", "heading": "INT. GRAIN ELEVATOR - NIGHT", "cast": [{"id": 0, "name": "HESTER VOSS", "names": ["HESTER VOSS", "HESTER"], "gender": "?", "first": 3, "spoke": 2}, {"id": 1, "name": "CORWIN", "names": ["CORWIN"], "gender": "?", "first": 5, "spoke": 1}, {"id": 2, "name": "AMBROSE", "names": ["AMBROSE"], "gender": "?", "first": 6, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRAIN ELEVATOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cathedral of rotted timber, forty feet of dark above and a hill of old wheat below.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wind finds the cracks and whistles through them.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "HESTER VOSS (30s, gaunt, a lantern in one fist) climbs the iron stair.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "She does not look down.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "action", "text": "Behind her, CORWIN (50s, her brother, limping) hauls himself up, one hand white on the rail.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Between them, a small boy, AMBROSE (8, barefoot, in a nightshirt), walks with his eyes shut.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "She stops on a landing.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "He bumps into her.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "The boy keeps walking, past them both, toward the chute.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "She seizes his collar.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He catches the boy's wrist.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Together they haul him back from the lip as the wheat below begins to move, hissing, like a thing getting up.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Don't open your eyes.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "He's asleep, Hess.", "name": "CORWIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "He is not.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "The lantern gutters.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "She cups the flame.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "He drags the boy against his leg, and the three of them stand locked together in the swinging light while the grain slides, higher on the walls, rising to meet them.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "The boy's eyes open.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "They are not his.", "para": 5, "sent": 1, "present": [0, 1, 2]}]}