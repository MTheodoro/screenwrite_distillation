{"scene_id": "s01734", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01734.fountain", "heading": "INT. BAGGAGE CLAIM - REGIONAL AIRPORT - NIGHT", "cast": [{"id": 0, "name": "CASSIAN MOORE", "names": ["CASSIAN MOORE", "CASSIAN"], "gender": "m", "first": 4, "spoke": 7}, {"id": 1, "name": "MIRELLE DUPONT", "names": ["MIRELLE DUPONT", "MIRELLE"], "gender": "f", "first": 5, "spoke": 10}, {"id": 2, "name": "OBADIAH FLYNN", "names": ["OBADIAH FLYNN", "OBADIAH"], "gender": "?", "first": 6, "spoke": 11}], "units": [{"u": 0, "kind": "heading", "text": "INT. BAGGAGE CLAIM - REGIONAL AIRPORT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A dead carousel.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single fluorescent tube flickers.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The rubber flaps hang like black tongues.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CASSIAN MOORE (40s, rumpled suit, a battered suitcase at his feet) stands beside the carousel and does not look at it.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "MIRELLE DUPONT (30s, airport security, radio on her shoulder) enters from the staff door.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "OBADIAH FLYNN (60s, janitor, a mop and a yellow bucket) is already there, mopping where nothing has been spilled.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Mirelle drops her hand to her holster.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Cassian lifts his palms.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Obadiah keeps mopping, but slower.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Sir, this area is closed.", "name": "MIRELLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I was told to wait here.", "name": "CASSIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "By whom?", "name": "MIRELLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "That's the problem. I don't know.", "name": "CASSIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Is that your bag?", "name": "MIRELLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "It came out of the last flight. The tag has my name. I don't remember packing it.", "name": "CASSIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Nobody does.", "name": "OBADIAH", "speaker": 2, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Sir, step away from the bag.", "name": "MIRELLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "I would love to, believe me. It keeps ticking.", "name": "CASSIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Mirelle steps back.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Obadiah lets go of the mop.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "It falls, and all three of them flinch at the clatter.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Evening, Cassian.", "name": "OBADIAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Do I know you?", "name": "CASSIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "You will. Take your time. It's a long night.", "name": "OBADIAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Control, I have a possible device in baggage claim, requesting a bomb squad.", "name": "MIRELLE", "speaker": 1, "ext": [], "paren": ["into radio"], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Her radio answers with static, then a click, then silence.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Control? Control, do you copy?", "name": "MIRELLE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "They can't hear you. The line's been cut since nine o'clock.", "name": "OBADIAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Who are you?", "name": "CASSIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Just the janitor.", "name": "OBADIAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Then why do you know the line is cut?", "name": "MIRELLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Because I'm the one that cut it.", "name": "OBADIAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Mirelle draws.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Cassian drops flat.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Obadiah does not move, hands wide, smiling the way you smile at the end of a long shift.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Lower that, Miss Dupont. Nobody's getting hurt. We're going to have a conversation, the three of us, and when it's done, the bag will stop ticking.", "name": "OBADIAH", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "What conversation?", "name": "MIRELLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "About the flight you both worked on, eleven years ago.", "name": "OBADIAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "I never worked a flight.", "name": "CASSIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "You didn't. You were a passenger. She was the gate agent who let you board.", "name": "OBADIAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Mirelle's gun hand wavers.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "That flight was...", "name": "MIRELLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Go on.", "name": "OBADIAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "That flight was cancelled.", "name": "MIRELLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Not for everyone.", "name": "OBADIAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "The carousel lurches.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "It starts to turn.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "A single object rides out of the dark flap, a child's red shoe, and rotates slowly past the three of them before it vanishes again.", "para": 7, "sent": 2, "present": [0, 1, 2]}]}