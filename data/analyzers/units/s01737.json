{"scene_id": "s01737", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01737.fountain", "heading": "INT. CHEESE AGING CAVE - NIGHT SHIFT", "cast": [{"id": 0, "name": "ANOUK LEFEBVRE", "names": ["ANOUK LEFEBVRE", "ANOUK"], "gender": "?", "first": 4, "spoke": 23}, {"id": 1, "name": "DMITRI VOLKOV", "names": ["DMITRI VOLKOV", "DMITRI"], "gender": "?", "first": 5, "spoke": 21}, {"id": 2, "name": "PATRICE ADEYEMI", "names": ["PATRICE ADEYEMI", "PATRICE"], "gender": "m", "first": 6, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. CHEESE AGING CAVE - NIGHT SHIFT", "present": []}, {"u": 1, "kind": "action", "text": "A limestone cave lit by strings of warm bulbs.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Shelves of wheels stretch into the dark, each stamped with a date.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The air is cold and smells of earth and milk.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ANOUK LEFEBVRE (30s, affineur, rubber apron, hairnet, a wooden mallet in her hand) taps wheel after wheel and listens to each one.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "DMITRI VOLKOV (30s, new delivery driver, still in his jacket) stands holding a clipboard, trying not to touch anything.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "PATRICE ADEYEMI (50s, owner, white lab coat, reading glasses on a chain) sits on an overturned crate at the end of the aisle, eating a rind.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Mademoiselle Lefebvre? I have the invoice.", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Anouk. Put it on the crate.", "name": "ANOUK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Anouk. Where should I--", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "There.", "name": "ANOUK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He puts the clipboard down.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "She taps another wheel, and tilts her head.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "That one is not ready.", "name": "ANOUK", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "How can you tell?", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "It sounds like it's holding its breath.", "name": "ANOUK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Patrice chuckles into his rind.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "She says that about people too.", "name": "PATRICE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Patrice.", "name": "ANOUK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I'm only telling the boy.", "name": "PATRICE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "My name is Dmitri.", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Dmitri. She says it about the ones she likes.", "name": "PATRICE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Anouk turns on him with the mallet raised.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Patrice lifts his hands in mock surrender.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Go and count the Comt\u00e9, old man.", "name": "ANOUK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "At this hour?", "name": "PATRICE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "At any hour.", "name": "ANOUK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Patrice goes, slowly, rind in hand.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "His steps fade.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Anouk and Dmitri are left alone with the humming bulbs and the sleeping wheels.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "He likes you.", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "He's my father's cousin.", "name": "ANOUK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "That's not what I meant.", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "She says nothing.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "She taps a wheel.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Dmitri watches her hands.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Can I ask you something?", "name": "DMITRI", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Ask.", "name": "ANOUK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Why do you work nights?", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "The cheese doesn't care. The cheese is the same at noon.", "name": "ANOUK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "That's not the answer.", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "What is the answer, then?", "name": "ANOUK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "I think you can't sleep.", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Her mallet stops.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "She turns, finally.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "She looks at him, fully, for the first time since he came in.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "And you? Why do you drive nights?", "name": "ANOUK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "I told them I needed the money.", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Do you?", "name": "ANOUK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "No.", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "So why?", "name": "ANOUK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Because at this hour, everyone I deliver to is kind. They open the door in their bathrobe. They say thank you like they mean it.", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "And during the day?", "name": "ANOUK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "During the day nobody looks at me.", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "She sets down the mallet.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "She wipes her hands on her apron and steps toward him, and the cave is so quiet that he can hear her breath.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "Dmitri.", "name": "ANOUK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "Yes?", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "I looked at you the moment you walked in.", "name": "ANOUK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "You said put it on the crate.", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "I said it so you would not see my face.", "name": "ANOUK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "He takes a step.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "A wheel of cheese on the shelf behind her shifts with a small, soft crack.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "She flinches, and then laughs, and the laugh goes wrong in her throat.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "No. No, I can't. I can't do this tonight.", "name": "ANOUK", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "Anouk--", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "You come in here in your jacket with your clipboard and you ask me why I can't sleep, as if it were a polite question!", "name": "ANOUK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "dialogue", "text": "It was a polite question.", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 68, "kind": "dialogue", "text": "It was not polite! Nothing about you is polite! You look at me like I'm a thing that might stay!", "name": "ANOUK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 69, "kind": "dialogue", "text": "Isn't that allowed?", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 70, "kind": "dialogue", "text": "Not by me!", "name": "ANOUK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 71, "kind": "action", "text": "She grabs the mallet and strikes the nearest wheel, hard.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 72, "kind": "action", "text": "It rings like a bell.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 73, "kind": "action", "text": "She strikes another, and another, and the whole cave sings with her fury, shelves trembling.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 74, "kind": "action", "text": "Dmitri doesn't flinch.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 75, "kind": "action", "text": "He takes the mallet from her hand, gently, and lays it on the crate beside the invoice.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 76, "kind": "dialogue", "text": "You said it sounds like it's holding its breath.", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 77, "kind": "dialogue", "text": "Yes.", "name": "ANOUK", "speaker": 0, "ext": [], "paren": ["shaking"], "dual": false, "present": [0, 1, 2]}, {"u": 78, "kind": "dialogue", "text": "So breathe.", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 79, "kind": "action", "text": "She does, once, like a diver surfacing.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 80, "kind": "action", "text": "Her forehead drops against his jacket.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 81, "kind": "action", "text": "His hand, uncertain, finds her hairnet, then her back.", "para": 12, "sent": 2, "present": [0, 1, 2]}]}