{"scene_id": "s01738", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01738.fountain", "heading": "INT. ROOFTOP GREENHOUSE - MORNING", "cast": [{"id": 0, "name": "WOMAN", "names": ["WOMAN"], "gender": "?", "first": 5, "spoke": 1}, {"id": 1, "name": "IMOGEN", "names": ["IMOGEN"], "gender": "?", "first": 17, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROOFTOP GREENHOUSE - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Glass walls, fogged.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Tomato vines climbing strings.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cracked radio on the potting bench.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The city sprawls beyond, gray and sleeping.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A WOMAN (30s, gardening gloves, hair tied up with twine) shuffles in with a mug and a stack of unopened mail.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She sets the mug down.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Taps a vine.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "Checks a leaf.", "para": 1, "sent": 3, "present": [0]}, {"u": 9, "kind": "action", "text": "She sorts the envelopes.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "Bills.", "para": 2, "sent": 1, "present": [0]}, {"u": 11, "kind": "action", "text": "A catalog.", "para": 2, "sent": 2, "present": [0]}, {"u": 12, "kind": "action", "text": "A pale blue one, handwritten.", "para": 2, "sent": 3, "present": [0]}, {"u": 13, "kind": "action", "text": "She stops.", "para": 3, "sent": 0, "present": [0]}, {"u": 14, "kind": "action", "text": "She turns it over.", "para": 4, "sent": 0, "present": [0]}, {"u": 15, "kind": "action", "text": "Her name is on the front.", "para": 4, "sent": 1, "present": [0]}, {"u": 16, "kind": "action", "text": "She reads it aloud.", "para": 4, "sent": 2, "present": [0]}, {"u": 17, "kind": "dialogue", "text": "Imogen.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She says it again, softer, like testing a stair.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Imogen Hartley-Voss.", "name": "IMOGEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She sits on an overturned bucket.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "The envelope trembles slightly in her fingers.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Don't look at me.", "name": "IMOGEN", "speaker": 1, "ext": ["CONT'D"], "paren": ["to the plants"], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She tears the flap.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "A single sheet.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "She unfolds it and lays it flat on her knee.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Dear Imogen. I know you will not answer this. I would not.", "name": "IMOGEN", "speaker": 1, "ext": ["V.O."], "paren": ["reading"], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "She stops reading aloud.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Her lips keep moving.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "The radio crackles.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Behind her, a tomato drops from the vine and rolls across the floor, comes to a stop against her boot.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "I have been thinking about the greenhouse, and how you said plants grow towards whatever is already warm.", "name": "IMOGEN", "speaker": 1, "ext": ["V.O."], "paren": ["reading, continued"], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Imogen folds the letter in half.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "In half again.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "She holds it against her chest.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "She picks up the tomato.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "She wipes it on her shirt.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "She bites into it, juice running down her wrist.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Still warm.", "name": "IMOGEN", "speaker": 1, "ext": [], "paren": ["mouth full"], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "She laughs, once, quietly.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Then she gets up, and finds a pen on the bench, and turns the envelope over to write.", "para": 12, "sent": 1, "present": [0, 1]}]}