{"scene_id": "s01740", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01740.fountain", "heading": "INT. TRAM DEPOT - LOST PROPERTY OFFICE - EVENING", "cast": [{"id": 0, "name": "LUCIENNE MARCHAND", "names": ["LUCIENNE MARCHAND", "LUCIENNE"], "gender": "f", "first": 5, "spoke": 16}, {"id": 1, "name": "FERDINAND OYELOWO", "names": ["FERDINAND OYELOWO", "FERDINAND"], "gender": "?", "first": 6, "spoke": 16}, {"id": 2, "name": "ABARA", "names": ["ABARA", "MRS. ABARA"], "gender": "f", "first": 7, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. TRAM DEPOT - LOST PROPERTY OFFICE - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "A cage of shelves under a green-shaded lamp.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Umbrellas by the hundred.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Single gloves pinned to a corkboard.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A brass bell on the counter.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LUCIENNE MARCHAND (30s, in a rain-spotted coat, hair damp) stands at the counter with a ticket stub clutched in her fist.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "FERDINAND OYELOWO (40s, the clerk, cardigan, a pencil behind his ear) sits behind the cage, writing in a ledger.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "MRS. ABARA (70s, regular, a tartan shopping trolley) waits by the umbrellas, politely invisible.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "I lost a hat. On the number nine, yesterday, around six.", "name": "LUCIENNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Color?", "name": "FERDINAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Gray. Felt. A little feather in the band.", "name": "LUCIENNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Pheasant?", "name": "FERDINAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "How did you know?", "name": "LUCIENNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "It's always pheasant. Wait here, Mademoiselle Marchand.", "name": "FERDINAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "How do you know my name?", "name": "LUCIENNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "You wrote it inside the hat. I found it this morning and I've been holding it all day.", "name": "FERDINAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "He vanishes into the shelves.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Lucienne turns to Mrs. Abara, who smiles with the serenity of a woman who has seen a lot of hats.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "He's quite nice, Ferdinand.", "name": "MRS. ABARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I'm sure.", "name": "LUCIENNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "He's been here nineteen years.", "name": "MRS. ABARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "That's very long.", "name": "LUCIENNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "He's waiting for something.", "name": "MRS. ABARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "What?", "name": "LUCIENNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "I wouldn't presume.", "name": "MRS. ABARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Ferdinand returns with the gray hat held in both hands like a small, wounded bird.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "He sets it on the counter.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Lucienne touches the feather, turns it over, and finds her own handwriting inside the brim.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "You found it.", "name": "LUCIENNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "It found me. It was on the seat, face down, as if it had given up.", "name": "FERDINAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Thank you, Mr. Oyelowo.", "name": "LUCIENNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Ferdinand.", "name": "FERDINAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Ferdinand. Thank you.", "name": "LUCIENNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "You'll have to sign.", "name": "FERDINAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "He turns the ledger toward her and offers the pencil.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Their fingers touch on it.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Nobody moves for a moment.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Dear me. I think I've lost my umbrella.", "name": "MRS. ABARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Mrs. Abara, you came in with it.", "name": "FERDINAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Did I?", "name": "MRS. ABARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "It's in your trolley.", "name": "FERDINAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "How careless of me.", "name": "MRS. ABARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Lucienne signs.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "She pushes the ledger back.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Ferdinand reads her signature as if it were a poem.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Lucienne.", "name": "FERDINAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Yes?", "name": "LUCIENNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "I should say, I don't usually keep things. I put a hat in the box, and the box goes on the shelf. I didn't put your hat on the shelf.", "name": "FERDINAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Why not?", "name": "LUCIENNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "I wanted to see who it belonged to.", "name": "FERDINAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "And now you have.", "name": "LUCIENNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Yes.", "name": "FERDINAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Lucienne puts the hat on.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "She tilts it.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "The pheasant feather bobs.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Behind the counter, Ferdinand takes the pencil from behind his ear, looks at it, and puts it back.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "It suits me.", "name": "LUCIENNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "It does.", "name": "FERDINAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "Ferdinand, if I were to lose something else tomorrow--", "name": "LUCIENNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "Then I would be here.", "name": "FERDINAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "At six?", "name": "LUCIENNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "At six.", "name": "FERDINAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "She nods and turns to leave.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "Mrs. Abara, as she passes, taps her trolley three times with a gloved finger, as if blessing it.", "para": 7, "sent": 1, "present": [0, 1, 2]}]}