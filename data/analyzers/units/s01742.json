{"scene_id": "s01742", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01742.fountain", "heading": "INT. HOTEL BATHHOUSE - DUST CREEK - NOON", "cast": [{"id": 0, "name": "MERCY TATE", "names": ["MERCY TATE", "MERCY"], "gender": "f", "first": 4, "spoke": 3}, {"id": 1, "name": "SADIE QUINN", "names": ["SADIE QUINN", "SADIE"], "gender": "f", "first": 5, "spoke": 2}, {"id": 2, "name": "JEB HOLLOWAY", "names": ["JEB HOLLOWAY", "JEB"], "gender": "m", "first": 6, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOTEL BATHHOUSE - DUST CREEK - NOON", "present": []}, {"u": 1, "kind": "action", "text": "Steam.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A copper tub.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A rag rug.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MERCY TATE (30s, gunbelt on a hook, hair pinned up) soaks to her chin.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "SADIE QUINN (20s, hotel maid, towels on her arm) sits on the lid of a barrel.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "JEB HOLLOWAY (50s, bounty man, spurs, dust in his beard) fills the doorway, one hand on the butt of his revolver.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Mercy Tate.", "name": "JEB", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Jeb.", "name": "MERCY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Mister, this is a lady's bath.", "name": "SADIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I see that.", "name": "JEB", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Mercy leans back.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "The water slops.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Sadie slides off the barrel and slips between them.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Jeb steps in.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Mercy reaches for the gunbelt on its hook, but Sadie gets there first, takes it, and holds it behind her back.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Jeb draws.", "para": 2, "sent": 5, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Sadie pales.", "para": 2, "sent": 6, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Mercy rises half out of the water, steam pouring off her shoulders, and lifts a hand to stop everyone.", "para": 2, "sent": 7, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Easy, all of you.", "name": "MERCY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I've got paper on you.", "name": "JEB", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "She's got a bath on her.", "name": "SADIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Jeb lowers the gun an inch.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Mercy sinks back into the water.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Sit down, Jeb. You're letting out the heat.", "name": "MERCY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}