{"scene_id": "s01746", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01746.fountain", "heading": "INT. AIRPLANE HANGAR - ROLLER DERBY TRACK - NIGHT", "cast": [{"id": 0, "name": "BEX LUNDQVIST", "names": ["BEX LUNDQVIST", "BEX"], "gender": "f", "first": 5, "spoke": 3}, {"id": 1, "name": "TAMSIN FALL", "names": ["TAMSIN FALL", "TAMSIN"], "gender": "?", "first": 6, "spoke": 5}, {"id": 2, "name": "KALANI AKANA", "names": ["KALANI AKANA", "KALANI"], "gender": "?", "first": 7, "spoke": 7}, {"id": 3, "name": "COACH RUIZ", "names": ["COACH RUIZ"], "gender": "?", "first": 8, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. AIRPLANE HANGAR - ROLLER DERBY TRACK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A banked oval of painted concrete.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Folding chairs.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A rusting 747 fuselage looms behind the bleachers.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Four skaters huddle at the bench, sweating through their jerseys.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "BEX LUNDQVIST (30s, jammer, star on her helmet).", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "TAMSIN FALL (20s, blocker, bruised shin).", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "KALANI AKANA (30s, captain, scarred knuckles).", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "COACH RUIZ (50s, gravel voice, whistle, a stopwatch) paces in front of them.", "para": 1, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Eight seconds, Bex. Eight seconds you stood in the pack and counted your own feet.", "name": "COACH RUIZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "I was reading the wall.", "name": "BEX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "The wall isn't moving.", "name": "COACH RUIZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Neither was I.", "name": "BEX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Listen up. Down by nine. Two minutes. Tam, you take the inside. Bex, you go on my whistle.", "name": "KALANI", "speaker": 2, "ext": [], "paren": ["to the team"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Whose whistle?", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Mine.", "name": "KALANI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "You don't have a whistle.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Dear God.", "name": "COACH RUIZ", "speaker": 3, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "I will make a noise like a whistle.", "name": "KALANI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Can you make it loud?", "name": "BEX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "I can make it louder than the coach.", "name": "KALANI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "That's not hard.", "name": "COACH RUIZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "I'm gonna throw up. I'm gonna throw up on the 747.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": ["quiet, to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Tamsin. Look at me.", "name": "KALANI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "I'm looking.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "You're going to hit the wall at forty miles an hour, and you're going to get back up, and you're going to do it again until they stop counting.", "name": "KALANI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "And if I don't?", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Then I'll hit it for you.", "name": "KALANI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Coach Ruiz clicks the stopwatch.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "The crowd, small and loud, begins to stomp.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Go. Go, go, go.", "name": "COACH RUIZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "They skate out in a rolling blur, wheels thunder on the concrete, and the 747 watches from the dark.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}]}