{"scene_id": "s01747", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01747.fountain", "heading": "INT. TIDAL POWER STATION - OCEAN PLANET HABITAT - DAY", "cast": [{"id": 0, "name": "YSOLDE FARAH", "names": ["YSOLDE FARAH", "YSOLDE"], "gender": "f", "first": 5, "spoke": 5}, {"id": 1, "name": "PAVAN IYER", "names": ["PAVAN IYER", "PAVAN"], "gender": "m", "first": 6, "spoke": 5}, {"id": 2, "name": "GREAVES", "names": ["GREAVES"], "gender": "m", "first": 7, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. TIDAL POWER STATION - OCEAN PLANET HABITAT - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A glass-walled control gallery above a roaring turbine bay.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Seawater thunders through the lower deck.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Everything hums.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Everything is calm.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "YSOLDE FARAH (40s, station chief, dark braid, mug of tea) sits at the main console and watches a wall of green graphs.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "PAVAN IYER (30s, technician, sleeves rolled, a pen behind each ear) moves between panels, tapping readouts and writing nothing down.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "MR. GREAVES (60s, inspector from the Ministry, gray suit, a slim case) stands at the window with his back to them.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "The graphs scroll.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "All green.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "You'll find we're ahead of schedule, Mr. Greaves.", "name": "YSOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "So I've heard.", "name": "GREAVES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Three weeks ahead. Four, if you count the sluice.", "name": "PAVAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "I don't count the sluice.", "name": "GREAVES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Then three.", "name": "PAVAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Ysolde sips her tea.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "She sets it down, slightly off the coaster, and nudges it back with one finger.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Pavan stops tapping.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "For a moment the only sound is the sea in the bay below.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Greaves turns from the window and lays his slim case on the console.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "He opens it.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Inside, a thin tablet.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "He taps it, and a schedule opens, yellow with warnings.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Ysolde leans forward to read it, and Pavan leans forward to read it over her shoulder, and Greaves watches them both without a flicker of expression.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "That's the old log.", "name": "YSOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "That's the log you filed.", "name": "GREAVES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "It must be a sync issue.", "name": "PAVAN", "speaker": 1, "ext": [], "paren": ["carefully"], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "I don't think so.", "name": "GREAVES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Pavan wipes his palms on his trousers.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Ysolde takes the pen from behind his ear, and puts it in her pocket, and closes the case, gently, as one closes the eyes of the dead.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Pavan, would you get Mr. Greaves some tea?", "name": "YSOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Of course.", "name": "PAVAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "He doesn't move.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "He has already seen the turbines, Ms. Farah.", "name": "GREAVES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Then you know what we've done.", "name": "YSOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "I know what you haven't.", "name": "GREAVES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Below, the roar of the water changes pitch.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "A slow, rising note, like a held breath.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "The graphs on the wall go amber, then red, one after another down the row.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Nobody looks at them.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Ysolde picks up her tea.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Her hand is perfectly steady.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "How long?", "name": "YSOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Four minutes.", "name": "GREAVES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "For what?", "name": "PAVAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Greaves walks to the door.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "He holds it open for the two of them, politely, the way a man holds a door for guests leaving a very good party.", "para": 9, "sent": 1, "present": [0, 1, 2]}]}