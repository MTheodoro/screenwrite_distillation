{"scene_id": "s01752", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01752.fountain", "heading": "INT. PARKING LOT - MERIDIAN SYNERGIES - FIRE DRILL - DAY", "cast": [{"id": 0, "name": "GWENDOLYN PRUITT", "names": ["GWENDOLYN PRUITT", "GWENDOLYN"], "gender": "?", "first": 3, "spoke": 16}, {"id": 1, "name": "HAL BORSTEIN", "names": ["HAL BORSTEIN", "HAL"], "gender": "?", "first": 4, "spoke": 6}, {"id": 2, "name": "TILLY NAKAMURA", "names": ["TILLY NAKAMURA", "TILLY"], "gender": "?", "first": 5, "spoke": 6}, {"id": 3, "name": "HR", "names": ["HR"], "gender": "?", "first": 5, "spoke": 0}, {"id": 4, "name": "MORTIMER GAULT", "names": ["MORTIMER GAULT", "MORTIMER"], "gender": "m", "first": 6, "spoke": 6}, {"id": 5, "name": "CFO", "names": ["CFO"], "gender": "?", "first": 6, "spoke": 0}, {"id": 6, "name": "YVETTE LAROCHE", "names": ["YVETTE LAROCHE", "YVETTE"], "gender": "?", "first": 7, "spoke": 6}, {"id": 7, "name": "INTERN", "names": ["INTERN"], "gender": "?", "first": 8, "spoke": 4}, {"id": 8, "name": "COLTON", "names": ["COLTON"], "gender": "?", "first": 30, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. PARKING LOT - MERIDIAN SYNERGIES - FIRE DRILL - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Two hundred employees in lanyards stand on hot asphalt in neat clusters.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A sign reads ASSEMBLY POINT B.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "GWENDOLYN PRUITT (50s, VP of Operations, clipboard, sunglasses, an air of command) stands at the center, tapping a pen.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "HAL BORSTEIN (40s, sales director, shirt-sleeves rolled, a stress ball in each fist) squeezes both.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "TILLY NAKAMURA (30s, HR, lanyard heavy with badges) counts heads and gets a different number every time.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "action", "text": "MORTIMER GAULT (60s, CFO, a bow tie, a thermos of something) sits on a curb as though he'd been assigned one.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 7, "kind": "action", "text": "YVETTE LAROCHE (30s, marketing lead, phone out, thumbs flying) isn't present in any way that matters.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 8, "kind": "action", "text": "At the edge, an INTERN (20s, wrinkled polo, a name tag that says HELLO MY NAME IS and nothing else) stands holding a box of donuts.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 9, "kind": "dialogue", "text": "Tilly, status.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 10, "kind": "dialogue", "text": "Two hundred and four. Or two hundred and six.", "name": "TILLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 11, "kind": "dialogue", "text": "We have two hundred and one employees.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 12, "kind": "dialogue", "text": "Then I have five ghosts.", "name": "TILLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 13, "kind": "dialogue", "text": "That's synergy.", "name": "HAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 14, "kind": "dialogue", "text": "Can you all not.", "name": "YVETTE", "speaker": 6, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 15, "kind": "dialogue", "text": "Yvette, put down the phone.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 16, "kind": "dialogue", "text": "It's a work phone.", "name": "YVETTE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 17, "kind": "dialogue", "text": "It's a fire drill.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 18, "kind": "dialogue", "text": "It's a very productive fire drill.", "name": "YVETTE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 19, "kind": "dialogue", "text": "In my day, we ran out of the building screaming and called it Tuesday.", "name": "MORTIMER", "speaker": 4, "ext": [], "paren": ["from the curb"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 20, "kind": "dialogue", "text": "Mortimer, that's not helpful.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 21, "kind": "dialogue", "text": "It wasn't meant to be.", "name": "MORTIMER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 22, "kind": "action", "text": "The Intern lifts the donut box.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 23, "kind": "dialogue", "text": "Does anyone want a donut?", "name": "INTERN", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 24, "kind": "action", "text": "Everyone turns.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 25, "kind": "dialogue", "text": "Who authorized donuts?", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 26, "kind": "dialogue", "text": "Nobody. I thought it would be nice.", "name": "INTERN", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 27, "kind": "dialogue", "text": "Who are you?", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 28, "kind": "dialogue", "text": "The, um. Intern?", "name": "INTERN", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 29, "kind": "dialogue", "text": "What's your name?", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "dialogue", "text": "Colton.", "name": "INTERN", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 31, "kind": "dialogue", "text": "There's no Colton on the roster.", "name": "TILLY", "speaker": 2, "ext": [], "paren": ["consulting her clipboard"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 32, "kind": "dialogue", "text": "I'm new.", "name": "COLTON", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 33, "kind": "dialogue", "text": "Nobody told us there was a new guy.", "name": "HAL", "speaker": 1, "ext": [], "paren": ["dual with Tilly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 34, "kind": "dialogue", "text": "^There is no Colton, Gwendolyn. I checked all three lists.", "name": "TILLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 35, "kind": "dialogue", "text": "Colton, who hired you?", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 36, "kind": "dialogue", "text": "A man in the elevator.", "name": "COLTON", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 37, "kind": "dialogue", "text": "That'll be me.", "name": "MORTIMER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 38, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 39, "kind": "action", "text": "Mortimer sips from his thermos, entirely at peace.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 40, "kind": "dialogue", "text": "Mortimer, you can't hire a person in an elevator.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 41, "kind": "dialogue", "text": "The elevator was stuck. It was either hire him or listen to him hum.", "name": "MORTIMER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 42, "kind": "dialogue", "text": "I wasn't humming.", "name": "COLTON", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 43, "kind": "dialogue", "text": "You were humming \"Delilah.\"", "name": "MORTIMER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 44, "kind": "dialogue", "text": "You can hire a guy because he hums \"Delilah\"?", "name": "HAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 45, "kind": "dialogue", "text": "He hummed it in the right key.", "name": "MORTIMER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 46, "kind": "dialogue", "text": "Wait. Are we talking about the fire drill or about Colton?", "name": "YVETTE", "speaker": 6, "ext": [], "paren": ["looking up, finally"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 47, "kind": "dialogue", "text": "We are talking about neither. We are talking about a protocol.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 48, "kind": "dialogue", "text": "What protocol?", "name": "YVETTE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 49, "kind": "dialogue", "text": "There is a protocol, and it states that employees assemble at the point, and wait for the all clear.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 50, "kind": "dialogue", "text": "Gwen, how long have we been waiting?", "name": "HAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 51, "kind": "dialogue", "text": "Forty minutes.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 52, "kind": "dialogue", "text": "Who's giving the all clear?", "name": "HAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 53, "kind": "action", "text": "Everyone looks at the building.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 54, "kind": "action", "text": "Smoke, thin and gray, curls from a third-floor window.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 55, "kind": "dialogue", "text": "Oh, that's a real one.", "name": "YVETTE", "speaker": 6, "ext": [], "paren": ["very quietly, to herself"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 56, "kind": "action", "text": "They all turn together to look at the window.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 57, "kind": "action", "text": "Colton sets down the donuts.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 58, "kind": "dialogue", "text": "Should I call someone?", "name": "COLTON", "speaker": 8, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 59, "kind": "dialogue", "text": "No, Colton. I think we've got this under control.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": ["brightly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 60, "kind": "action", "text": "Behind her, a window pops and glass rains on the asphalt.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 61, "kind": "dialogue", "text": "Two hundred and one.", "name": "TILLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 62, "kind": "dialogue", "text": "Thank you, Tilly.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 63, "kind": "dialogue", "text": "And Colton.", "name": "TILLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 64, "kind": "dialogue", "text": "Two hundred and two.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 65, "kind": "dialogue", "text": "I'd like it noted that I said we should have had donuts.", "name": "HAL", "speaker": 1, "ext": [], "paren": ["squeezing both stress balls"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}]}