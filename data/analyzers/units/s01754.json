{"scene_id": "s01754", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01754.fountain", "heading": "INT. FIRE LOOKOUT TOWER - MOUNTAIN SUMMIT - DAY", "cast": [{"id": 0, "name": "NOELLE BEAUCHAMP", "names": ["NOELLE BEAUCHAMP", "NOELLE"], "gender": "?", "first": 4, "spoke": 24}, {"id": 1, "name": "BARRETT", "names": ["BARRETT"], "gender": "?", "first": 7, "spoke": 26}], "units": [{"u": 0, "kind": "heading", "text": "INT. FIRE LOOKOUT TOWER - MOUNTAIN SUMMIT - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A glass-walled cabin on stilts above a sea of pines.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A cot, a stove, a Osborne fire finder bolted to a table, a radio on a shelf.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The wind sings in the guy-wires.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "NOELLE BEAUCHAMP (17, first summer job, sunburned nose, binoculars on a cord) sits on the cot, eating peanut butter from the jar.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She has not changed her shirt in four days.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "The radio on the shelf crackles.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "dialogue", "text": "Tower Nine, this is Dispatch. Noelle, you there?", "name": "BARRETT", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She leaps, drops the jar, grabs the mic.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I'm here. I'm here, Barrett.", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "You sound out of breath.", "name": "BARRETT", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I was eating.", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Good. Eat. How's the view?", "name": "BARRETT", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "It's green.", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Anything else?", "name": "BARRETT", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "No. Just green. And sky.", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "That's the best kind of day, kid.", "name": "BARRETT", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She picks up the jar, wipes a smear of peanut butter from her wrist, sits.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "The cabin creaks in the wind.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Barrett?", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Yeah?", "name": "BARRETT", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Can I ask you something?", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "I'm not going anywhere. Go ahead.", "name": "BARRETT", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Were you ever scared up here?", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Every summer for twenty-two years.", "name": "BARRETT", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Of what?", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "The first time I saw smoke and wasn't sure.", "name": "BARRETT", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "She nods at the radio, though he can't see.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "She lifts the binoculars and sweeps the horizon.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Her hand stops.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "There's a gray thing.", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Gray thing?", "name": "BARRETT", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "West ridge. A column. Maybe a mile.", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Take a bearing. Use the finder.", "name": "BARRETT", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "She moves to the fire finder, bends, sights down the brass ring.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "She reads the number with her lips.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Two ninety-one. Two ninety-one degrees.", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Distance?", "name": "BARRETT", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Eleven hundred yards, maybe. I can't tell.", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "You're doing great. Say it again, slow.", "name": "BARRETT", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Two ninety-one degrees, west ridge, column of gray smoke, eleven hundred--", "name": "NOELLE", "speaker": 0, "ext": [], "paren": ["dual with Barrett"], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "^Two ninety-one, west ridge, gray smoke, copy, I've got a crew rolling.", "name": "BARRETT", "speaker": 1, "ext": ["V.O."], "paren": ["over radio, dual"], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "They stop at the same moment.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Static hums.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Was that your first call?", "name": "BARRETT", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Yes.", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "It was a good one.", "name": "BARRETT", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "Is it real?", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "We'll know in twenty minutes.", "name": "BARRETT", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Twenty minutes is forever.", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "That's the job. Twenty minutes of forever, and then you eat.", "name": "BARRETT", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "She laughs.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "She laughs again.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "She sets the binoculars on the table, sits on the cot, and pulls the peanut butter back onto her lap.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "Barrett?", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "Yeah, kid.", "name": "BARRETT", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "Stay on the line.", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "Wasn't planning on going anywhere.", "name": "BARRETT", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "She eats a spoonful.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "The radio breathes.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "Outside, a hawk drifts past the glass, and the smoke on the ridge thins and tears apart in the wind.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "It's going out.", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "Is it?", "name": "BARRETT", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "It was a cloud.", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "Everybody's first call is a cloud.", "name": "BARRETT", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "You could have told me.", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "And ruin it?", "name": "BARRETT", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "action", "text": "She puts her face in her hands.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "She is shaking, and she is laughing, and the tears are real.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "I'm so embarrassed.", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "Don't be. You were right to call it. A cloud's a cloud until you prove it.", "name": "BARRETT", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "dialogue", "text": "I called it fast.", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 72, "kind": "dialogue", "text": "That's what you're for.", "name": "BARRETT", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "She wipes her eyes with the back of her wrist.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 74, "kind": "action", "text": "She presses the mic.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 75, "kind": "dialogue", "text": "Tower Nine to Dispatch. False alarm. Stand down.", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 76, "kind": "dialogue", "text": "Copy, Tower Nine. Good work, Noelle.", "name": "BARRETT", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 77, "kind": "action", "text": "She hangs the mic on its hook.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 78, "kind": "action", "text": "The wind sings in the guy-wires.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 79, "kind": "action", "text": "She picks up the jar again, and this time she offers a spoonful to the empty room.", "para": 11, "sent": 2, "present": [0, 1]}]}