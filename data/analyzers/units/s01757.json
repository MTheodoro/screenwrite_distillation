{"scene_id": "s01757", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01757.fountain", "heading": "INT. BOXING GYM - ABOVE A FUNERAL PARLOR - EVENING", "cast": [{"id": 0, "name": "EMEKA OKONKWO", "names": ["EMEKA OKONKWO", "EMEKA"], "gender": "m", "first": 5, "spoke": 17}, {"id": 1, "name": "LARS VESTERGAARD", "names": ["LARS VESTERGAARD", "LARS"], "gender": "m", "first": 6, "spoke": 21}], "units": [{"u": 0, "kind": "heading", "text": "INT. BOXING GYM - ABOVE A FUNERAL PARLOR - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "A long upstairs room with warped floorboards.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "One heavy bag, patched with duct tape.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A ring with sagging ropes.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A window facing a hearse garage; through the glass, a black Cadillac gleams.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "EMEKA OKONKWO (30s, heavyweight, taped hands, hooded sweatshirt) hits the bag in slow, deliberate pairs.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "LARS VESTERGAARD (50s, trainer, gray crew cut, a towel on his shoulder) holds a pair of mitts and watches him with a steady, flat gaze.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Again.", "name": "LARS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "I've done fifty.", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Fifty is warm-up.", "name": "LARS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Fifty is my shoulder.", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Your shoulder is fine.", "name": "LARS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Emeka lets his arms fall.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He walks to the window and looks down at the hearse.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He wipes sweat off his face with the hem of his sweatshirt.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Why did you rent above a funeral home?", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "It was cheap.", "name": "LARS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Is that the reason?", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "It's quiet.", "name": "LARS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Nobody downstairs complains about the noise?", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Nobody downstairs complains about anything.", "name": "LARS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Emeka almost smiles.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "He returns to the bag and sets his feet.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "He hits it twice, hard, and the chain squeaks.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Better. Where did that come from?", "name": "LARS", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "From you telling me I'm too slow.", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "I never said that.", "name": "LARS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "You said it with your eyebrows.", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "My eyebrows have no opinion.", "name": "LARS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Emeka hits again.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "And again.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "A faster rhythm builds, the old chain snapping, the tape on the bag peeling a little at its seam.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Lars lifts the mitts and Emeka drives his fists into them, one-two, one-two, until the older man's knees begin to bend.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Enough.", "name": "LARS", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "No.", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Enough, I said.", "name": "LARS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Three more.", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Fine. Three.", "name": "LARS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Emeka lands three, and they are enormous.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Lars staggers.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "He drops the mitts, rubs his palms together, shakes out his wrists.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "That's what I wanted.", "name": "LARS", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Why wait until now?", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Because you had to be angry.", "name": "LARS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "I wasn't angry.", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "You were furious at me.", "name": "LARS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "I was tired.", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "It's the same thing. Both of them look like the end.", "name": "LARS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Emeka sits on the ring apron.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "He unwinds the tape from one hand, slowly.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "Lars pours him water from a thermos, then pours himself some, then sits, and the two of them listen to the hearse engine turn over below.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Fight's on Saturday.", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "I know.", "name": "LARS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "You think I'm ready?", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "I think he's not.", "name": "LARS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "Who, him or you?", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "Either. Both. The one standing in front of you.", "name": "LARS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "Emeka laughs.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "Lars does not, but something in his shoulders eases.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "If I lose.", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "Then you lose here, with me, and nobody downstairs will notice.", "name": "LARS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "Thanks.", "name": "EMEKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "You're welcome.", "name": "LARS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "The hearse pulls out of the garage and glides into the street, slow and silent.", "para": 8, "sent": 0, "present": [0, 1]}]}