{"scene_id": "s01758", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01758.fountain", "heading": "INT. FOG SIGNAL STATION - NIGHT", "cast": [{"id": 0, "name": "DAGNY HOLM", "names": ["DAGNY HOLM", "DAGNY"], "gender": "f", "first": 6, "spoke": 8}, {"id": 1, "name": "PEREGRINE LOOMIS", "names": ["PEREGRINE LOOMIS", "PEREGRINE"], "gender": "m", "first": 7, "spoke": 9}, {"id": 2, "name": "SOL", "names": ["SOL"], "gender": "?", "first": 8, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. FOG SIGNAL STATION - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A stone tower on a bald rock in a gray sea.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A great iron horn mounted in the wall.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The room is round, cramped, lit by a hanging oil lamp that sways though the air is still.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The walls are slick with condensation.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The floor has been scrubbed so many times the boards are white.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "DAGNY HOLM (40s, keeper, oilskin coat, a wool cap pulled to her eyebrows, a thick log-book in her lap) sits at a table with a mug gone cold.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "PEREGRINE LOOMIS (20s, apprentice, glasses fogged, jacket too big for him) stands at the narrow window with a telescope.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "SOL (60s, deaf, white beard, one milky eye) rocks in a chair by the iron stove, hands knotted around a pipe.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "The horn sounds.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "A single, mournful bellow.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "The lamp shivers.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Everyone waits for the echo.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "None comes.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Something's out there.", "name": "PEREGRINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "It's fog.", "name": "DAGNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "It's moving against the fog.", "name": "PEREGRINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Fog moves.", "name": "DAGNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Not like this. Come see.", "name": "PEREGRINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "She doesn't.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "She turns a page in the log.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Sol rocks.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "The chair creaks.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "The pipe cools.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Dagny. It has lights.", "name": "PEREGRINE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "A ship, then.", "name": "DAGNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Seven lights. In a row. Low on the water.", "name": "PEREGRINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Count again.", "name": "DAGNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Eight.", "name": "PEREGRINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Dagny stands.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "She goes to the window, takes the telescope from his hands, puts it to her eye.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "A long silence.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The lamp swings once.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Ten.", "name": "DAGNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "They're getting closer.", "name": "PEREGRINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Sol stops rocking.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "He stands, and the chair keeps moving without him.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "He crosses to the horn mechanism and puts a hand flat on the iron, feels the tremor.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "They're answering it.", "name": "SOL", "speaker": 2, "ext": [], "paren": ["gravelly"], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Sol.", "name": "DAGNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "It sounds back from the water. I felt it in my bones.", "name": "SOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Peregrine takes the telescope back and sweeps the sea.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Dagny seizes the horn lever.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Sol grips her wrist.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "They stare at each other across a foot of cold air, and between them the lamp swings and the shadows swing with it.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Don't sound it.", "name": "PEREGRINE", "speaker": 1, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "If I don't, the ships hit the rock.", "name": "DAGNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "If you do, those ones come in.", "name": "SOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Which ones?", "name": "DAGNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "The sea gives a long, low, rolling moan.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "The iron horn, silent, answers it, humming in the wall like a plucked string.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "From the dark down the stairwell comes a wet sound, one step, then another, climbing.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Peregrine backs away from the window.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Dagny releases the lever.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Sol raises both hands and pulls the cap from his head, as if it were a church.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "The footsteps stop at the door.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "A knock, polite.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Dagny, Sol, Peregrine look at each other, the same thought in all three faces.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Then, from the other side of the wood, a voice, thin, patient, exactly like Peregrine's.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "Dagny? It's me. Let me in.", "name": "PEREGRINE", "speaker": 1, "ext": ["V.O."], "paren": ["through the door"], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "Peregrine, at the window, has not moved his lips.", "para": 13, "sent": 0, "present": [0, 1, 2]}]}