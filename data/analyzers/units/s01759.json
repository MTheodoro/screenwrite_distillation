{"scene_id": "s01759", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01759.fountain", "heading": "INT. ESCAPE ROOM - \"THE MUMMY'S CRYPT\" - DAY", "cast": [{"id": 0, "name": "BRENDA KOWALSKI", "names": ["BRENDA KOWALSKI", "BRENDA"], "gender": "f", "first": 6, "spoke": 8}, {"id": 1, "name": "KAREEM ALLEN", "names": ["KAREEM ALLEN", "KAREEM"], "gender": "?", "first": 7, "spoke": 5}, {"id": 2, "name": "FENELLA OKAFOR-LISTER", "names": ["FENELLA OKAFOR-LISTER", "FENELLA"], "gender": "f", "first": 8, "spoke": 6}, {"id": 3, "name": "OLUWASEUN ADEYEMI", "names": ["OLUWASEUN ADEYEMI", "OLUWASEUN"], "gender": "?", "first": 9, "spoke": 4}, {"id": 4, "name": "TRIXIE VANCE", "names": ["TRIXIE VANCE", "TRIXIE"], "gender": "f", "first": 10, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. ESCAPE ROOM - \"THE MUMMY'S CRYPT\" - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A fake tomb: painted hieroglyphs, a plastic sarcophagus, torches with flickering LED flames.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A timer on the wall counts down: 04:12.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A speaker hisses behind the sphinx, and nobody pays it any attention.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Five coworkers in matching \"TEAMWORK!\"", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "T-shirts mill around a stone table.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "BRENDA KOWALSKI (50s, regional manager, laminated agenda) reads the instructions aloud to no one.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "KAREEM ALLEN (30s, analyst, hands in pockets) stares at the walls.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "FENELLA OKAFOR-LISTER (40s, accountant, wire-rim glasses) has already found three clues and hidden them in her pocket.", "para": 1, "sent": 4, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "OLUWASEUN ADEYEMI (20s, new hire, smiling too hard) rattles a locked chest.", "para": 1, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "TRIXIE VANCE (30s, sales, huge hoop earrings) leans on the sarcophagus, scrolling her phone.", "para": 1, "sent": 6, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Okay, team, okay. Let's circle up. Circle up!", "name": "BRENDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Nobody circles.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Brenda circles herself.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "The timer reads 03:58.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Brenda, there's a chest.", "name": "KAREEM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Great. Oluwaseun, open the chest.", "name": "BRENDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "It's locked.", "name": "OLUWASEUN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Then unlock it.", "name": "BRENDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "With what?", "name": "OLUWASEUN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "With teamwork!", "name": "BRENDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Fenella steps to the table, takes a scrap of papyrus from her pocket, and lays it flat.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Kareem leans over it, and Trixie pockets her phone and drifts over, and Oluwaseun abandons the chest.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "All four heads converge, and Brenda, in the way of the circle, is somehow left outside it.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "It's a cipher. The sun disc means three.", "name": "FENELLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "What's the jackal?", "name": "KAREEM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Seven.", "name": "FENELLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Where'd you get the paper?", "name": "TRIXIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Under the sarcophagus.", "name": "FENELLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "You didn't tell us.", "name": "TRIXIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Nobody asked.", "name": "FENELLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Fenella, we agreed no hoarding.", "name": "BRENDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "We agreed on a synergy workshop. I'm hoarding.", "name": "FENELLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Three, seven--", "name": "KAREEM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Is there an eye? There's an eye on the chest.", "name": "OLUWASEUN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Eye equals one.", "name": "TRIXIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Three seven one!", "name": "KAREEM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Oluwaseun spins the dials.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "The chest clicks open.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Inside, a plastic scarab and a note.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "It says, \"The real treasure was the friends we made.\"", "name": "OLUWASEUN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "That's lovely.", "name": "BRENDA", "speaker": 0, "ext": [], "paren": ["moved"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "That's the worst clue I've ever read.", "name": "FENELLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Where's the door?", "name": "TRIXIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "The timer reads 00:41.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Brenda! Brenda, which wall?", "name": "KAREEM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "I don't know! I made an agenda, I didn't make a map!", "name": "BRENDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Oluwaseun begins to hum.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Fenella looks at the ceiling.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Trixie heaves the sarcophagus lid aside to reveal a door handle in the back, and the five of them stampede toward it, crash into each other, and tumble together in a heap on the cold fake stone.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "The timer hits zero.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "The torches go out.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "I think that went well.", "name": "BRENDA", "speaker": 0, "ext": ["CONT'D"], "paren": ["in the dark"], "dual": false, "present": [0, 1, 2, 3, 4]}]}