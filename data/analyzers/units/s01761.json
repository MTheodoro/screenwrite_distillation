{"scene_id": "s01761", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01761.fountain", "heading": "INT. MATTRESS SHOWROOM - SATURDAY AFTERNOON", "cast": [{"id": 0, "name": "HARLAN FEENEY", "names": ["HARLAN FEENEY", "HARLAN"], "gender": "?", "first": 6, "spoke": 12}, {"id": 1, "name": "DOT BELLAMY", "names": ["DOT BELLAMY", "DOT"], "gender": "?", "first": 7, "spoke": 17}, {"id": 2, "name": "WALLACE BELLAMY", "names": ["WALLACE BELLAMY", "WALLACE"], "gender": "m", "first": 7, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. MATTRESS SHOWROOM - SATURDAY AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "A cavernous store.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Hundreds of mattresses in neat rows under blazing lights.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A banner hangs from the rafters: EVERYTHING MUST GO.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Soft muzak plays.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The floor is carpeted a shade of regret.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "HARLAN FEENEY (50s, salesman, tan suit, a name tag that says HARLAN - ASK ME ABOUT SLEEP) glides between the beds with a grin.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "DOT BELLAMY (70s, a tiny woman in a quilted jacket, huge handbag, orthopedic sneakers) stalks the aisles, pressing each mattress with her palm.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "WALLACE BELLAMY (70s, her husband, suspenders, a newspaper rolled in his fist) trails behind her at a respectful distance.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Welcome! First time in the market for a mattress?", "name": "HARLAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Forty-one years.", "name": "DOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Wonderful. Then you know the value of a good night's sleep.", "name": "HARLAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "I know the value of a good price.", "name": "DOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She climbs onto a bed in her sneakers.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Harlan's smile locks in place.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "She lies flat, hands folded across her handbag.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Wallace perches on the edge of the next bed and opens his newspaper.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Too soft.", "name": "DOT", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Ma'am, shoes.", "name": "HARLAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Wallace, test this.", "name": "DOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I'm reading.", "name": "WALLACE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Test it.", "name": "DOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Wallace sighs, folds the paper, and lies down on the adjacent mattress with his shoes on.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Harlan winces visibly.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Both Bellamys lie side by side on separate beds, staring at the ceiling, like patients in a ward.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "It's all right.", "name": "WALLACE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "It's not all right.", "name": "DOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "It's fine.", "name": "WALLACE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "You said that in 1983, and we had to buy the one with the lump.", "name": "DOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "This is our Cloud Supreme. Eight inches of memory foam, with a ten-year warranty.", "name": "HARLAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Memory of what?", "name": "DOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Of you, ma'am. It remembers your shape.", "name": "HARLAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "I don't want it to remember me. I want it to forget.", "name": "DOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "That's, uh, our Nap Plus model.", "name": "HARLAN", "speaker": 0, "ext": [], "paren": ["beat"], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "How much?", "name": "DOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Fourteen hundred.", "name": "HARLAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "For a bed.", "name": "DOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "For a sleep.", "name": "HARLAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Dot sits up, swings her legs over the side, and looks at him for a long, hard moment.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Then she slaps her palm down on the mattress.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Eight hundred, and you throw in the pillows.", "name": "DOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Ma'am, I can't--", "name": "HARLAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Wallace. Get up. We're leaving.", "name": "DOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "I'm comfortable.", "name": "WALLACE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Wallace!", "name": "DOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "He rises slowly, unwillingly, shoes squeaking.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Harlan raises both hands.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Twelve hundred. And the pillows.", "name": "HARLAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "One thousand.", "name": "DOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Eleven.", "name": "HARLAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "One thousand, and we take the floor model, and you deliver it Tuesday.", "name": "DOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Done.", "name": "HARLAN", "speaker": 0, "ext": [], "paren": ["defeated"], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Wallace, pay the man.", "name": "DOT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Wallace pulls out his wallet.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "A moth flutters out.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Harlan stares at it, stares at Dot, and takes the wallet gently, as if it might bite.", "para": 6, "sent": 2, "present": [0, 1, 2]}]}