{"scene_id": "s01763", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01763.fountain", "heading": "INT. COLLAPSED SUBWAY TUNNEL - NIGHT", "cast": [{"id": 0, "name": "MAGDA KOWAL", "names": ["MAGDA KOWAL", "MAGDA"], "gender": "f", "first": 5, "spoke": 7}, {"id": 1, "name": "RAVI MENON", "names": ["RAVI MENON", "RAVI"], "gender": "?", "first": 6, "spoke": 4}, {"id": 2, "name": "JOAQUIN BELTRAN", "names": ["JOAQUIN BELTRAN", "JOAQUIN"], "gender": "?", "first": 7, "spoke": 6}, {"id": 3, "name": "XIMENA ORTIZ", "names": ["XIMENA ORTIZ", "XIMENA"], "gender": "f", "first": 8, "spoke": 2}, {"id": 4, "name": "OLD TEO", "names": ["OLD TEO", "TEO"], "gender": "m", "first": 9, "spoke": 4}, {"id": 5, "name": "BEA", "names": ["BEA"], "gender": "?", "first": 10, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. COLLAPSED SUBWAY TUNNEL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Concrete, rebar, rubble.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single emergency light flickers in a cage on the wall.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dust hangs in the beam.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Water drips somewhere out of sight.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MAGDA KOWAL (50s, transit worker, hard hat, reflective vest) leans against a slab, one hand on her ribs.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "RAVI MENON (20s, student, backpack, scuffed laptop) sits cross-legged, scrolling a dead phone.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "JOAQUIN BELTRAN (40s, commuter, suit jacket wrapped around a bleeding hand) paces.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "XIMENA ORTIZ (30s, pregnant, hand on her belly) rests on a plastic crate.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "OLD TEO (70s, flat cap, harmonica in his breast pocket) sits against the wall, eyes closed.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "BEA (9, school uniform, a pink backpack, sitting very close to Ximena) hums.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Everybody, listen. Rescue knows we're down here.", "name": "MAGDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "How?", "name": "JOAQUIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Because they always know.", "name": "MAGDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Phone's dead. Mine's dead.", "name": "RAVI", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "We all have dead phones, kid.", "name": "JOAQUIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Ximena adjusts her seat.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "She winces and tries to hide it.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Bea looks up at her and places a small hand over Ximena's.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Is the baby kicking?", "name": "BEA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "A little.", "name": "XIMENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Does it know we're in a tunnel?", "name": "BEA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "I don't think so.", "name": "XIMENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Good.", "name": "BEA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Old Teo opens one eye, takes the harmonica from his pocket, wipes it on his sleeve, and plays a single low note.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "It trembles in the cave.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Teo, save your breath.", "name": "MAGDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "It saves itself.", "name": "TEO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "He plays another, then a phrase, slow and tender.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Ravi stops scrolling.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Joaquin stops pacing.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Even Magda lowers her head.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "The light flickers.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "For the length of a verse, no one speaks.", "para": 4, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "My wife is going to kill me.", "name": "JOAQUIN", "speaker": 2, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "It's not your fault.", "name": "RAVI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "I took the late train. I never take the late train.", "name": "JOAQUIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "I take it every day.", "name": "BEA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Do you?", "name": "JOAQUIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "My grandma meets me at Elm.", "name": "BEA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Ximena and Magda exchange a look over the child's head.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Teo lowers the harmonica.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "She'll be at Elm tonight too.", "name": "TEO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "I know.", "name": "BEA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Okay. Okay. Water first. Joaquin, what have you got?", "name": "MAGDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "A bottle. Half.", "name": "JOAQUIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Ravi?", "name": "MAGDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "Nothing. A granola bar.", "name": "RAVI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "Break it in six.", "name": "MAGDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "It's tiny.", "name": "RAVI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "Break it in six.", "name": "MAGDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "He does.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "He gives Bea the biggest piece.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "She hands it to Ximena.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "Ximena breaks it again and hands half back.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "Overhead, concrete shifts with a groan.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "Dust sifts down in a thin ribbon.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "Everyone looks up.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "The light dims, brightens, holds.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "Play me a song, little one.", "name": "TEO", "speaker": 4, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "I don't know any.", "name": "BEA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "dialogue", "text": "Hum the one you were humming.", "name": "TEO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "Bea hums.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "Teo finds the key on his harmonica and joins.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "The others sit and let the music do the work.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}