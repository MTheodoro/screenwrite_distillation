{"scene_id": "s01764", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01764.fountain", "heading": "INT. SPACE ELEVATOR CAR - ORBITAL TETHER - DAY", "cast": [{"id": 0, "name": "CAPTAIN IDRIS VAUGHAN", "names": ["CAPTAIN IDRIS VAUGHAN", "IDRIS"], "gender": "m", "first": 5, "spoke": 14}, {"id": 1, "name": "NOOR HASHEMI", "names": ["NOOR HASHEMI", "NOOR"], "gender": "f", "first": 6, "spoke": 8}, {"id": 2, "name": "BART", "names": ["BART"], "gender": "m", "first": 7, "spoke": 8}, {"id": 3, "name": "CHUKWU", "names": ["CHUKWU"], "gender": "?", "first": 7, "spoke": 0}, {"id": 4, "name": "FUMIKO SATO", "names": ["FUMIKO SATO", "FUMIKO"], "gender": "f", "first": 8, "spoke": 6}, {"id": 5, "name": "SVEN LUNDGREN", "names": ["SVEN LUNDGREN", "SVEN"], "gender": "m", "first": 9, "spoke": 11}], "units": [{"u": 0, "kind": "heading", "text": "INT. SPACE ELEVATOR CAR - ORBITAL TETHER - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A decommissioned passenger car, windowless but for one thick porthole.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Worn leather seats, six of them, bolted in a ring around a central pole.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A dial on the wall reads 31,000 km and drops by the second.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The air is stale, the lights half-power.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CAPTAIN IDRIS VAUGHAN (50s, gray crew cut, patched uniform jacket) sits at the control panel, reading tablet data.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "NOOR HASHEMI (30s, flight engineer, braids pinned up, hands always moving) is on her back under the console, wiring.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "BARTHOLOMEW \"BART\" CHUKWU (40s, medic, big man in a small seat) peels the foil off a ration bar.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "FUMIKO SATO (20s, cadet, rigid in her seat, hands gripped white around the harness) stares at the porthole.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "SVEN LUNDGREN (60s, scientist, lab coat over thermals, a thermos strapped to his belt) hums at the wall.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Noor, status.", "name": "IDRIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Power's holding. Descent's nominal.", "name": "NOOR", "speaker": 1, "ext": [], "paren": ["from under the console"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Nominal.", "name": "IDRIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "I said nominal. Didn't say good.", "name": "NOOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Is there such a thing as a bad descent when you're only falling thirty thousand kilometers?", "name": "BART", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Yes, Bart. The kind where you land.", "name": "NOOR", "speaker": 1, "ext": [], "paren": ["dry"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Funny.", "name": "BART", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Captain, how long?", "name": "FUMIKO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Four hours, Cadet.", "name": "IDRIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Four hours is a long time.", "name": "FUMIKO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "It's the normal time.", "name": "IDRIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "It is a good time. Time enough for a story.", "name": "SVEN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "No stories, Sven.", "name": "BART", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "It is a short one.", "name": "SVEN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "It's never short.", "name": "BART", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "It is the one about the cable.", "name": "SVEN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Noor slides out from under the console.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "She sits up, a coil of wire in her fist.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Idris sets down his tablet.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Fumiko turns her eyes from the porthole for the first time.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Not that one, Sven.", "name": "IDRIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "They should hear it, Captain.", "name": "SVEN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "They have clearance to know what they need.", "name": "IDRIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Then they need to know.", "name": "SVEN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "The dial reads 29,000.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "The car shudders, a small tremor along the line.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Everyone feels it.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Nobody mentions it.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Captain, I'd like to hear the story.", "name": "NOOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "No.", "name": "IDRIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Captain--", "name": "NOOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Engineer, return to the panel.", "name": "IDRIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Noor does not move.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Bart pops the foil wrapper off his ration bar and eats a bite without chewing.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Look out the window, kid. Look at the stars.", "name": "BART", "speaker": 2, "ext": [], "paren": ["to Fumiko, quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "They're not moving.", "name": "FUMIKO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "Good.", "name": "BART", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "They should be.", "name": "FUMIKO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "Bart stops chewing.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "He looks at Idris.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Idris, with great deliberateness, puts the tablet face-down on the panel.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "They are not moving because we are not descending, Fumiko.", "name": "SVEN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "That's not funny, Sven.", "name": "NOOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "It is not a joke.", "name": "SVEN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "Sven, I said no.", "name": "IDRIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "It is not a thing you can say no to, Captain. The dial is reading. The dial is wrong. We have been stationary since the first tremor, which was ninety minutes ago.", "name": "SVEN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "The dial's dropping.", "name": "BART", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "dialogue", "text": "The dial is a recording. I looped it myself.", "name": "SVEN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "Noor drops the coil of wire.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "action", "text": "Bart rises, bumping his head on the low ceiling.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "Fumiko lifts her hands off the harness, finally, and puts them in her lap.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "dialogue", "text": "You looped it.", "name": "NOOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "dialogue", "text": "At the Captain's instruction.", "name": "SVEN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "All eyes shift to Idris.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "His face is perfectly composed.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "action", "text": "He lays both hands flat on the panel.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "dialogue", "text": "There is a fault in the tether.", "name": "IDRIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "dialogue", "text": "How bad?", "name": "BART", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "dialogue", "text": "We are holding at thirty thousand and nine hundred kilometers, on a line rated for twenty-two.", "name": "IDRIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "dialogue", "text": "That's not possible.", "name": "NOOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "dialogue", "text": "It is happening.", "name": "IDRIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "dialogue", "text": "Why didn't you tell us?", "name": "FUMIKO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "dialogue", "text": "Because if I had, you would have done what you're doing now.", "name": "IDRIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "dialogue", "text": "What am I doing?", "name": "FUMIKO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 75, "kind": "dialogue", "text": "Looking at me.", "name": "IDRIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 76, "kind": "action", "text": "Silence.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 77, "kind": "action", "text": "The car groans.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 78, "kind": "action", "text": "Somewhere below them, in the dark, a long cable sings a very high note.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 79, "kind": "dialogue", "text": "Now will you let me tell the story?", "name": "SVEN", "speaker": 5, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 80, "kind": "action", "text": "Idris nods, once.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 81, "kind": "action", "text": "Sven sits, unscrews his thermos, pours a single cup of tea, and holds it out to Fumiko, whose hand reaches for it, and closes, and does not shake.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}