[0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Foreman?", "name": "PIP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Nobody move.", "name": "ALDRETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Marn lowers the sledge.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Ysabeau closes the compass.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Pip ducks behind Aldreth.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Together they back up into the narrow shaft as the vein of ivory glows orange and the stone around it begins to crack like an egg.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "A figure steps out of the dark behind them.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "GORRAN (60s, a wyrm-warden, scaled leather armor, a staff of blackened bone) taps the floor once.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "The cracking stops.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "You've dug into the nursery.", "name": "GORRAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "We didn't know.", "name": "ALDRETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Few do. Put down the picks. Back out, slowly, and thank the mountain it's sleeping.", "name": "GORRAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Marn drops the sledge.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Ysabeau bows.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Pip, trembling, holds out his torch, and Gorran takes it, and pinches the flame out with two bare fingers.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}]}