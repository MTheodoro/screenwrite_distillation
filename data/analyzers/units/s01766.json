{"scene_id": "s01766", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01766.fountain", "heading": "INT. PARKING GARAGE - TICKET BOOTH - NIGHT", "cast": [{"id": 0, "name": "KOWALCZYK", "names": ["KOWALCZYK"], "gender": "?", "first": 6, "spoke": 3}, {"id": 1, "name": "ROSARIO LEAL", "names": ["ROSARIO LEAL", "ROSARIO"], "gender": "m", "first": 6, "spoke": 4}, {"id": 2, "name": "NELL TRUMBO", "names": ["NELL TRUMBO", "NELL"], "gender": "f", "first": 7, "spoke": 5}, {"id": 3, "name": "TEAGUE", "names": ["TEAGUE"], "gender": "m", "first": 8, "spoke": 2}, {"id": 4, "name": "BAO PHAM", "names": ["BAO PHAM"], "gender": "m", "first": 9, "spoke": 0}, {"id": 5, "name": "HENDRIK", "names": ["HENDRIK"], "gender": "m", "first": 10, "spoke": 7}, {"id": 6, "name": "KOWAL", "names": ["KOWAL"], "gender": "?", "first": 20, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. PARKING GARAGE - TICKET BOOTH - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A glass cube the size of a closet.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A flickering monitor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A coffee-stained logbook.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A speaker crackles.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Across the lot, rows of parked cars and the red glow of an EXIT sign.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "DET. KOWALCZYK (40s, rumpled, spiral notebook, a dead cigar) squeezes in beside ROSARIO LEAL (30s, rookie detective, ponytail, a camera slung on her shoulder).", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "In the booth's corner sits NELL TRUMBO (60s, the attendant, cardigan, a thermos, a crossword).", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "TEAGUE (30s, driver, cap, hunched in a parked van outside, binoculars) watches the stairwell.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "BAO PHAM (20s, uniformed patrol officer) paces near the barrier arm.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "HENDRIK (50s, a nervous man in a gray suit, a briefcase between his feet) waits on a bench near the elevator.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Anyone been through the barrier since ten?", "name": "KOWALCZYK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Eleven cars. Two vans. One bicycle.", "name": "NELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Bicycle?", "name": "KOWALCZYK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Tried to park it in a car space. I charged him.", "name": "NELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Detective, the suit is making a phone call.", "name": "ROSARIO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Which suit?", "name": "KOWALCZYK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "The one on the bench.", "name": "ROSARIO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Hendrik is whispering into a phone, hunched, shielding his mouth.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Bao glances at him and catches Rosario's eye.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Let him talk. He's the only one who thinks he's hidden.", "name": "KOWAL", "speaker": 6, "ext": [], "paren": ["low, to Rosario"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "Detective, did you want me to--", "name": "ROSARIO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Stay.", "name": "KOWAL", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "Kowalczyk, he's moving.", "name": "TEAGUE", "speaker": 3, "ext": [], "paren": ["over earpiece"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "Understood.", "name": "KOWAL", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "action", "text": "Hendrik stands, briefcase in hand, and walks toward the stairwell.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "action", "text": "Bao shifts into his path, hand on the radio.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "Hendrik stops.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "Teague slides out of the van, closing the door as softly as a sigh.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "Rosario lifts her camera, Nell lowers her crossword, and Kowal comes out of the booth like a man leaving a church, and for the space of a held breath, everyone is still.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "I'm not carrying anything.", "name": "HENDRIK", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "I haven't asked.", "name": "KOWAL", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "The briefcase is empty.", "name": "HENDRIK", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "Then you won't mind opening it.", "name": "NELL", "speaker": 2, "ext": [], "paren": ["from the booth"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "Hendrik looks at her.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "She smiles over her thermos.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "Rosario steps forward and takes the case from his hand.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "He lets her.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "She clicks the latches.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "Inside, a pair of men's gloves, a paperback, and a pink ticket stub.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "That's it.", "name": "ROSARIO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "dialogue", "text": "What's the stub?", "name": "KOWAL", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "dialogue", "text": "It's from here. Level three.", "name": "HENDRIK", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "dialogue", "text": "That's my stub.", "name": "NELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "dialogue", "text": "It's for my car.", "name": "HENDRIK", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "You don't have a car on level three.", "name": "NELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "dialogue", "text": "No. It's for hers.", "name": "HENDRIK", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "Everyone looks at the stub.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "action", "text": "Teague slowly lowers his binoculars.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "dialogue", "text": "Whose?", "name": "KOWAL", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "dialogue", "text": "The woman. The one I was meeting. She's been dead since Tuesday.", "name": "HENDRIK", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "action", "text": "Nell sets down her pen.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "action", "text": "Bao's radio hisses.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "action", "text": "Rosario's camera clicks once, by accident, and the sound in the booth is enormous.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "dialogue", "text": "Mr. Hendrik, where is her car?", "name": "KOWAL", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "dialogue", "text": "Level three. Space forty.", "name": "HENDRIK", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "dialogue", "text": "Bao. Rosario. With me.", "name": "KOWAL", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "action", "text": "They go, three of them in a tight little line toward the elevator.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 59, "kind": "action", "text": "Hendrik doesn't move.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 60, "kind": "action", "text": "Nell watches him from the glass booth, and when he turns to her, she raises her thermos in a silent toast.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 61, "kind": "dialogue", "text": "Level three. We're on our way.", "name": "TEAGUE", "speaker": 3, "ext": [], "paren": ["into his sleeve"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}