{"scene_id": "s01767", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01767.fountain", "heading": "INT. DIM SUM KITCHEN - BACK OFFICE - NIGHT", "cast": [{"id": 0, "name": "LAI MEI-LING", "names": ["LAI MEI-LING", "LAI"], "gender": "f", "first": 5, "spoke": 10}, {"id": 1, "name": "CAZ DELGADO", "names": ["CAZ DELGADO", "CAZ"], "gender": "?", "first": 6, "spoke": 4}, {"id": 2, "name": "MERLE PIKE", "names": ["MERLE PIKE", "MERLE"], "gender": "?", "first": 7, "spoke": 5}, {"id": 3, "name": "PASHA GORSKI", "names": ["PASHA GORSKI", "PASHA"], "gender": "m", "first": 8, "spoke": 13}], "units": [{"u": 0, "kind": "heading", "text": "INT. DIM SUM KITCHEN - BACK OFFICE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped room behind the steam.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A desk strewn with order slips, a rice cooker, a safe the size of a microwave.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Bamboo steamers stack to the ceiling.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The kitchen noise thuds through the wall.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LAI MEI-LING (50s, owner, chef's whites, a cleaver stuck in the desk) is counting bills in neat stacks.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "CAZ DELGADO (30s, her nephew, gold chain, gum) sits on the safe, swinging his heels.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "MERLE PIKE (60s, accountant, bifocals, mismatched socks) stirs a thermos of tea.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "PASHA GORSKI (40s, new supplier, expensive coat, a duffel bag at his feet) stands by the door.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Six thousand.", "name": "LAI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Seven.", "name": "PASHA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Six. We agreed six.", "name": "LAI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Seven. There was a change.", "name": "PASHA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "There is always a change.", "name": "MERLE", "speaker": 2, "ext": [], "paren": ["calmly, to the tea"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Auntie, don't--", "name": "CAZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Caz, quiet.", "name": "LAI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "The kitchen noise outside softens.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Merle takes a sip.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Pasha watches the cleaver in the desk, then the old woman, then the door.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "You have a nice place.", "name": "PASHA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "It's a restaurant.", "name": "LAI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Your dumplings are very good.", "name": "PASHA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "They are the best.", "name": "LAI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "I always say, good food, good business.", "name": "PASHA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "You don't say anything, you just show up.", "name": "CAZ", "speaker": 1, "ext": [], "paren": ["dual with Lai"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "^You say nothing, Mr. Gorski, you take.", "name": "LAI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "They speak at the same moment, in the same tone.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Pasha almost laughs.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Family, yes? Such a family.", "name": "PASHA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Pasha, the number is six.", "name": "MERLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Seven.", "name": "PASHA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Six and a half.", "name": "MERLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Mr. Pike--", "name": "PASHA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Six and a half, and a case of the shrimp har gow, and you stop coming on Fridays.", "name": "MERLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "That is a very strange deal.", "name": "PASHA", "speaker": 3, "ext": [], "paren": ["smiling"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "It is a fair deal.", "name": "LAI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Why Fridays?", "name": "PASHA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Because that's when the inspector comes.", "name": "CAZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "What inspector?", "name": "PASHA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "A sound in the wall, a soft thump, like a boot.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Merle sets the thermos down.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Lai pulls the cleaver out of the desk and lays it across her knees.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Caz slides off the safe.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Mr. Gorski. How many men did you bring tonight?", "name": "LAI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "One. Me.", "name": "PASHA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "You should have said two.", "name": "LAI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Why?", "name": "PASHA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "The door to the kitchen swings open on its own.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "A rush of steam rolls through the room, and beyond it the kitchen is entirely, unnaturally still.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Not a pan clatters.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Auntie. It's Friday.", "name": "CAZ", "speaker": 1, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "I know what day it is.", "name": "LAI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Pasha kicks his duffel bag.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "It falls open, and the money inside is stacks of yellow order slips.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Six and a half.", "name": "MERLE", "speaker": 2, "ext": [], "paren": ["sighing"], "dual": false, "present": [0, 1, 2, 3]}]}