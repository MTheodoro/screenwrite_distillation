{"scene_id": "s01768", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01768.fountain", "heading": "INT. JURY ROOM - FLOODED COURTHOUSE - NIGHT", "cast": [{"id": 0, "name": "HATTIE BOONE", "names": ["HATTIE BOONE", "HATTIE"], "gender": "f", "first": 5, "spoke": 8}, {"id": 1, "name": "SUNIL RAO", "names": ["SUNIL RAO", "SUNIL"], "gender": "m", "first": 6, "spoke": 4}, {"id": 2, "name": "BEVERLY OSEI", "names": ["BEVERLY OSEI", "BEVERLY"], "gender": "?", "first": 7, "spoke": 4}, {"id": 3, "name": "ROMAN VOLKOV", "names": ["ROMAN VOLKOV", "ROMAN"], "gender": "?", "first": 8, "spoke": 2}, {"id": 4, "name": "ESTELLE FARRIER", "names": ["ESTELLE FARRIER", "ESTELLE"], "gender": "?", "first": 9, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. JURY ROOM - FLOODED COURTHOUSE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Two inches of black water on the floor.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A long mahogany table above it.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Five jurors sit with their feet on rungs, trousers rolled.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single lantern on the table.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "HATTIE BOONE (60s, foreperson, cardigan, reading glasses) taps a verdict form.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "SUNIL RAO (30s, jacket on his head against the drip).", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "BEVERLY OSEI (40s, nurse, arms crossed).", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "ROMAN VOLKOV (50s, plumber, boots, a flask).", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "ESTELLE FARRIER (70s, hat with a veil, hands folded).", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "We've been in here nine hours.", "name": "HATTIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Ten.", "name": "SUNIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Eleven, if you count the lunch.", "name": "BEVERLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Nobody counts the lunch.", "name": "HATTIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "I count the lunch.", "name": "ROMAN", "speaker": 3, "ext": [], "paren": ["raising the flask"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Roman.", "name": "HATTIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "It's water.", "name": "ROMAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "It isn't.", "name": "HATTIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Hattie holds out her hand.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Roman gives her the flask.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "She sniffs, wrinkles her nose, and sets it on the table.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Show of hands. Guilty.", "name": "HATTIE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Sunil raises his.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Roman raises his.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Beverly does not.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Estelle does not.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Hattie does, slowly.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Three to two.", "name": "HATTIE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "She did it.", "name": "BEVERLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "She did not.", "name": "ESTELLE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Who? Who did it?", "name": "SUNIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "The defendant, Sunil. The woman. She said it herself.", "name": "BEVERLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "She said she was sorry. That's not the same thing.", "name": "ESTELLE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Water laps at the legs of the table.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "The lantern flickers.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Hattie lifts her eyes, and stops.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Where is the foreman's chair?", "name": "HATTIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "They turn.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "At the head of the table, the chair is pulled out.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Somebody has taken the sixth place.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "A wet gown lies folded on the seat.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Nobody saw anyone enter.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Oh, dear.", "name": "ESTELLE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Hattie. There's only five of us.", "name": "BEVERLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Count again.", "name": "HATTIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "One, two, three, four, five. Five.", "name": "SUNIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Six, dear. You forgot yourself.", "name": "ESTELLE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Sunil looks down.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "His reflection in the black water, perfectly still, looks back up at him and does not blink.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Okay. I want to change my vote.", "name": "SUNIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}