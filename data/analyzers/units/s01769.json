{"scene_id": "s01769", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01769.fountain", "heading": "INT. DRIVER'S LICENSE OFFICE - WAITING AREA - DAY", "cast": [{"id": 0, "name": "ERNEST PLUMLEY", "names": ["ERNEST PLUMLEY", "ERNEST"], "gender": "m", "first": 5, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRIVER'S LICENSE OFFICE - WAITING AREA - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Plastic chairs bolted in rows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A take-a-number machine.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A flag.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A sign: PLEASE HAVE ALL DOCUMENTS READY.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ERNEST PLUMLEY (60s, bow tie, blazer with elbow patches, a folder of papers held in both hands) sits in the exact middle of the front row.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "He aligns his folder with the edge of his knee.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "He checks his watch.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "He checks his ticket: B-114.", "para": 1, "sent": 3, "present": [0]}, {"u": 9, "kind": "action", "text": "The overhead display reads B-103.", "para": 1, "sent": 4, "present": [0]}, {"u": 10, "kind": "action", "text": "He squares his shoulders and stares at the display with immense confidence.", "para": 2, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "The display ticks.", "para": 3, "sent": 0, "present": [0]}, {"u": 12, "kind": "action", "text": "B-104.", "para": 3, "sent": 1, "present": [0]}, {"u": 13, "kind": "action", "text": "He nods.", "para": 4, "sent": 0, "present": [0]}, {"u": 14, "kind": "action", "text": "He smiles at nobody.", "para": 4, "sent": 1, "present": [0]}, {"u": 15, "kind": "action", "text": "He pulls a small cassette recorder from his blazer pocket and presses record.", "para": 4, "sent": 2, "present": [0]}, {"u": 16, "kind": "dialogue", "text": "Note to self. Today I renew my license. A calm man. A prepared man.", "name": "ERNEST", "speaker": 0, "ext": [], "paren": ["into recorder"], "dual": false, "present": [0]}, {"u": 17, "kind": "action", "text": "He clicks it off, pockets it, and checks the folder again, thumbing each page in order.", "para": 5, "sent": 0, "present": [0]}, {"u": 18, "kind": "action", "text": "His smile does not waver.", "para": 5, "sent": 1, "present": [0]}, {"u": 19, "kind": "action", "text": "The display ticks.", "para": 6, "sent": 0, "present": [0]}, {"u": 20, "kind": "action", "text": "B-105.", "para": 6, "sent": 1, "present": [0]}, {"u": 21, "kind": "action", "text": "His eyes flick to a bank of windows.", "para": 7, "sent": 0, "present": [0]}, {"u": 22, "kind": "action", "text": "A clerk, unseen, slams a stamp.", "para": 7, "sent": 1, "present": [0]}, {"u": 23, "kind": "action", "text": "Ernest flinches, covers it with a cough, and straightens his bow tie.", "para": 7, "sent": 2, "present": [0]}, {"u": 24, "kind": "action", "text": "The display ticks.", "para": 8, "sent": 0, "present": [0]}, {"u": 25, "kind": "action", "text": "B-106.", "para": 8, "sent": 1, "present": [0]}, {"u": 26, "kind": "action", "text": "Ernest's knee begins to bounce.", "para": 8, "sent": 2, "present": [0]}, {"u": 27, "kind": "action", "text": "He holds his folder down with his free hand to still it.", "para": 8, "sent": 3, "present": [0]}, {"u": 28, "kind": "action", "text": "He pulls out the recorder again.", "para": 9, "sent": 0, "present": [0]}, {"u": 29, "kind": "action", "text": "He presses play.", "para": 9, "sent": 1, "present": [0]}, {"u": 30, "kind": "dialogue", "text": "Note to self. Today I renew my license. A calm man. A prepared man.", "name": "ERNEST", "speaker": 0, "ext": ["V.O."], "paren": ["recorded"], "dual": false, "present": [0]}, {"u": 31, "kind": "action", "text": "He listens to his own voice, serene.", "para": 10, "sent": 0, "present": [0]}, {"u": 32, "kind": "action", "text": "He rewinds a few seconds and plays it again.", "para": 10, "sent": 1, "present": [0]}, {"u": 33, "kind": "action", "text": "He nods to it, as to a trusted colleague.", "para": 10, "sent": 2, "present": [0]}, {"u": 34, "kind": "action", "text": "The display ticks.", "para": 11, "sent": 0, "present": [0]}, {"u": 35, "kind": "action", "text": "B-107.", "para": 11, "sent": 1, "present": [0]}, {"u": 36, "kind": "action", "text": "Ernest rises, tests his legs, sits again.", "para": 11, "sent": 2, "present": [0]}, {"u": 37, "kind": "action", "text": "He opens his folder.", "para": 12, "sent": 0, "present": [0]}, {"u": 38, "kind": "action", "text": "He turns a page.", "para": 12, "sent": 1, "present": [0]}, {"u": 39, "kind": "action", "text": "He freezes.", "para": 12, "sent": 2, "present": [0]}, {"u": 40, "kind": "action", "text": "He turns another page, and another, faster.", "para": 12, "sent": 3, "present": [0]}, {"u": 41, "kind": "action", "text": "His face drains of color, one shade at a time.", "para": 12, "sent": 4, "present": [0]}, {"u": 42, "kind": "action", "text": "He pulls out the recorder with trembling fingers.", "para": 13, "sent": 0, "present": [0]}, {"u": 43, "kind": "dialogue", "text": "Note to self.", "name": "ERNEST", "speaker": 0, "ext": [], "paren": ["into recorder"], "dual": false, "present": [0]}, {"u": 44, "kind": "action", "text": "He stops.", "para": 14, "sent": 0, "present": [0]}, {"u": 45, "kind": "action", "text": "His lip works.", "para": 14, "sent": 1, "present": [0]}, {"u": 46, "kind": "dialogue", "text": "The proof of residence is on the kitchen table.", "name": "ERNEST", "speaker": 0, "ext": ["CONT'D"], "paren": ["into recorder"], "dual": false, "present": [0]}, {"u": 47, "kind": "action", "text": "He clicks it off.", "para": 15, "sent": 0, "present": [0]}, {"u": 48, "kind": "action", "text": "He looks at the display.", "para": 15, "sent": 1, "present": [0]}, {"u": 49, "kind": "action", "text": "B-108.", "para": 15, "sent": 2, "present": [0]}, {"u": 50, "kind": "action", "text": "He looks at his ticket.", "para": 15, "sent": 3, "present": [0]}, {"u": 51, "kind": "action", "text": "B-114.", "para": 15, "sent": 4, "present": [0]}, {"u": 52, "kind": "action", "text": "Slowly, with enormous dignity, he gets up, tucks the folder under his arm, and walks to the door.", "para": 16, "sent": 0, "present": [0]}, {"u": 53, "kind": "action", "text": "Halfway, he stops, turns, and returns to his seat, and sits, and folds his hands, and stares at the display with immense confidence.", "para": 16, "sent": 1, "present": [0]}]}