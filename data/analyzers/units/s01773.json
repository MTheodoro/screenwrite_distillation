{"scene_id": "s01773", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01773.fountain", "heading": "EXT. DRIVE-IN THEATER - CONCESSION ROOF - NIGHT", "cast": [{"id": 0, "name": "DEWEY HALLORAN", "names": ["DEWEY HALLORAN", "DEWEY"], "gender": "m", "first": 4, "spoke": 18}, {"id": 1, "name": "LONNIE VASQUEZ", "names": ["LONNIE VASQUEZ", "LONNIE"], "gender": "m", "first": 5, "spoke": 15}, {"id": 2, "name": "FRANKIE DUBOIS", "names": ["FRANKIE DUBOIS", "FRANKIE"], "gender": "m", "first": 6, "spoke": 15}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DRIVE-IN THEATER - CONCESSION ROOF - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A flat tar roof above the snack bar.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Beyond the low parapet, rows of parked cars face a giant screen flickering with a western none of them are watching.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Moths swarm the projector beam.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DEWEY HALLORAN, seventeen, lean, in a rented bow tie, sits cross-legged with a flashlight in his teeth.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "LONNIE VASQUEZ, seventeen, stocky, in a usher's jacket two sizes too small, sits beside him eating popcorn from a paper tub.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "FRANKIE DUBOIS, sixteen, wiry, with grease under his nails, stands at the edge and looks down.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Everybody got their cut of the money?", "name": "DEWEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "I got mine. I got it in my sock.", "name": "LONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Why's it in your sock?", "name": "FRANKIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Because that's where my mother never looks.", "name": "LONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Fine. Frankie, you're sure about the key?", "name": "DEWEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "I made it myself. It'll open any projection booth in the county.", "name": "FRANKIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "The county? Frankie, we've got one booth.", "name": "LONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "It's a figure of speech.", "name": "FRANKIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "It's a good key, Lonnie. Leave him alone.", "name": "DEWEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "I'm only saying.", "name": "LONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "You're always only saying.", "name": "FRANKIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "All right, listen. Tonight we show them the thing we made. Everybody's out there, the whole school, my father, Mr. Paget. After the intermission cartoon, it plays. Three minutes. That's all.", "name": "DEWEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "My mother will see it.", "name": "LONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Your mother will love it.", "name": "DEWEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "She's going to see me in it, Dewey. Me, with the cape.", "name": "LONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "You look great in the cape.", "name": "FRANKIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "I look like a tablecloth.", "name": "LONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "You look like a hero.", "name": "DEWEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "A tablecloth hero.", "name": "LONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Lonnie stuffs a fistful of popcorn into his mouth.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Dewey takes the flashlight from his teeth and clicks it off.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "What if it doesn't work?", "name": "FRANKIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "It'll work.", "name": "DEWEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "What if the reel jams?", "name": "FRANKIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "What if it plays backward?", "name": "LONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Then it'll be a different movie.", "name": "DEWEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "You always say that.", "name": "FRANKIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Because it's always true.", "name": "DEWEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Below them, the western reaches a gunfight.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "A hundred car horns honk in approval, and the roof hums with it.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "That's not even a good one.", "name": "LONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Mine's better.", "name": "FRANKIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Ours is better.", "name": "DEWEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Ours.", "name": "LONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Frankie turns from the edge and sits between them.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "The three of them look out over the lot.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Somewhere a screen door bangs.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "What do we do after?", "name": "FRANKIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "After what?", "name": "DEWEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "After they see it.", "name": "FRANKIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "We go home.", "name": "DEWEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "We go home and pretend we weren't here.", "name": "LONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "And then?", "name": "FRANKIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Then we make another one.", "name": "DEWEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "A longer one.", "name": "LONNIE", "speaker": 1, "ext": [], "paren": ["through popcorn"], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "With real stunts.", "name": "FRANKIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "With no capes.", "name": "DEWEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "No, no, the cape stays.", "name": "LONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "The western ends.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "The screen goes white, then black.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "A tinny voice from the loudspeakers announces the intermission.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "A dancing hot dog appears on screen, singing.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Dewey stands.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "Lonnie stands.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "Frankie is already on his feet.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "Frankie. The booth.", "name": "DEWEY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "Going.", "name": "FRANKIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "I'm coming with you.", "name": "LONNIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "Both of you, go. I'll watch the lot.", "name": "DEWEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "Don't let anybody leave.", "name": "FRANKIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "dialogue", "text": "They won't.", "name": "DEWEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "Frankie vaults over the roof's far edge to the ladder.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "Lonnie is on his heels.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "Dewey stays at the parapet, shoulders squared, watching a hundred cars and the dancing hot dog.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 71, "kind": "action", "text": "He lifts the flashlight and holds it like a torch.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 72, "kind": "dialogue", "text": "Now.", "name": "DEWEY", "speaker": 0, "ext": ["CONT'D"], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}, {"u": 73, "kind": "action", "text": "The loudspeakers crackle.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 74, "kind": "action", "text": "The screen flickers and goes dark.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 75, "kind": "action", "text": "For one long second the whole lot is silent, a hundred windshields reflecting nothing.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 76, "kind": "action", "text": "Then a projector lamp flares in the booth and a ragged, hand-cut image leaps up on the screen: a boy in a tablecloth cape, running.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 77, "kind": "action", "text": "Dewey grins.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 78, "kind": "action", "text": "Down in the lot, a horn honks.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 79, "kind": "action", "text": "Then another.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 80, "kind": "action", "text": "Then all of them.", "para": 10, "sent": 3, "present": [0, 1, 2]}]}