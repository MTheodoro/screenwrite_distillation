{"scene_id": "s01776", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01776.fountain", "heading": "INT. GREENHOUSE WEDDING TENT - NIGHT", "cast": [{"id": 0, "name": "NAOMI ADEYEMI-BRAUN", "names": ["NAOMI ADEYEMI-BRAUN", "NAOMI"], "gender": "?", "first": 6, "spoke": 3}, {"id": 1, "name": "SEBASTIAN KOWALCZYK", "names": ["SEBASTIAN KOWALCZYK", "SEBASTIAN"], "gender": "?", "first": 7, "spoke": 3}, {"id": 2, "name": "PRIYA SOLANKI", "names": ["PRIYA SOLANKI", "PRIYA"], "gender": "?", "first": 8, "spoke": 2}, {"id": 3, "name": "FATHER LEOPOLD GAUDET", "names": ["FATHER LEOPOLD GAUDET"], "gender": "?", "first": 9, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. GREENHOUSE WEDDING TENT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Fairy lights.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Orchids.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cake leaning slightly.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The band has stopped.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Guests have drifted outside.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "NAOMI ADEYEMI-BRAUN, thirties, in a champagne gown, stands at the cake table with a knife and no cake cut.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Across from her, SEBASTIAN KOWALCZYK, thirties, bow tie hanging loose, holds two flutes and gives neither of them up.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Beside them, a bridesmaid, PRIYA SOLANKI, twenties, freezes mid-reach for a canap\u00e9.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Behind, the officiant, FATHER LEOPOLD GAUDET, sixty, dozes upright on a folding chair.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Naomi sets the knife down.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Sebastian sets a glass down.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "They both pick up their own again.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "She drinks.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "He doesn't.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "You were always going to leave.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "I'm standing right here.", "name": "SEBASTIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Guys.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Naomi and Sebastian turn their heads together, then back.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Priya retreats a step, canap\u00e9 in hand.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Father Gaudet wakes, blinks, smiles at the ceiling, and is out again.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "I meant tomorrow. Next month. Whenever it gets hard.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "It's already hard.", "name": "SEBASTIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "She takes off her ring, looks at it, puts it on the cake table.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "He steps forward, picks it up, and slides it back onto her finger.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "She lets him.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Neither says anything.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Should I cut the cake?", "name": "PRIYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "No.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Yes.", "name": "SEBASTIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "They look at each other.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "A small laugh escapes Naomi.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Sebastian's mouth twitches.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Priya picks up the knife and cuts, a crooked first slice, and hands the plate to Father Gaudet, who wakes and takes it.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}]}