{"scene_id": "s01778", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01778.fountain", "heading": "INT. GRAIN SILO - BASE LEVEL - NIGHT", "cast": [{"id": 0, "name": "DELPHINE CROSBY", "names": ["DELPHINE CROSBY", "DELPHINE"], "gender": "?", "first": 5, "spoke": 3}, {"id": 1, "name": "MAX", "names": ["MAX"], "gender": "?", "first": 6, "spoke": 1}, {"id": 2, "name": "ODUYA", "names": ["ODUYA"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "OLD ENRICO FABBRI", "names": ["OLD ENRICO FABBRI", "ENRICO"], "gender": "?", "first": 7, "spoke": 2}, {"id": 4, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 8, "spoke": 2}, {"id": 5, "name": "ANSELM", "names": ["ANSELM"], "gender": "?", "first": 20, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRAIN SILO - BASE LEVEL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Rust-streaked concrete.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single hanging bulb swings.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wheat dust hangs in the beam.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Somewhere above, metal ticks.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DELPHINE CROSBY, thirties, holds a flashlight steady.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "MAXWELL \"MAX\" ODUYA, twenties, kneels by a hatch with a crowbar.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "OLD ENRICO FABBRI, seventies, sits on an upturned bucket.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "A STRANGER stands motionless at the foot of the ladder, face in shadow.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Everyone. Stay where you are.", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Nobody moves.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "The ticking stops.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "It's the pipes. It's just the pipes.", "name": "MAX", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Boy. Put the bar down.", "name": "ENRICO", "speaker": 3, "ext": [], "paren": ["to Max"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Max doesn't.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "The Stranger takes one slow step into the light.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Wheat dust clings to the shoulders of his coat.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "His eyes do not blink.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "I've been up there a long time.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Who are you?", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": ["to the Stranger"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Anselm. My name was Anselm.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "The bulb dies.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "In the dark: the ladder groans.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Delphine's flashlight snaps back on.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "ANSELM is now six feet from Max, who has raised the crowbar.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "The wheat around his boots is moving.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "It remembers me.", "name": "ANSELM", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Don't let him touch the grain.", "name": "ENRICO", "speaker": 3, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Back to the door. All of you. Now.", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": ["to the group"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Max swings.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Anselm catches the bar in one hand.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "The silo shudders, and the floor of wheat begins to rise.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}