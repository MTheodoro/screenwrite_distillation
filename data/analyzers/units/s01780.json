{"scene_id": "s01780", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01780.fountain", "heading": "INT. MUSEUM OF CLOCKS - VAULT CORRIDOR - NIGHT", "cast": [{"id": 0, "name": "MAN", "names": ["MAN"], "gender": "?", "first": 4, "spoke": 12}, {"id": 1, "name": "WOMAN", "names": ["WOMAN"], "gender": "?", "first": 5, "spoke": 11}, {"id": 2, "name": "MARCUS", "names": ["MARCUS"], "gender": "f", "first": 55, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. MUSEUM OF CLOCKS - VAULT CORRIDOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A hush of ticking.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Glass cases of pocket watches line the walls.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "At the end, a steel vault door the color of old pewter.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A MAN in a night guard's uniform kneels at the door with a stethoscope pressed against the lock.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "A WOMAN in a cleaner's smock stands behind him with a mop bucket she has not moved in several minutes.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Quiet.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "I am being quiet.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You're breathing.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I'm told it's mandatory.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He turns the dial a hair.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Tick.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Tick.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "The stethoscope clicks.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He sits back.", "para": 2, "sent": 4, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "That's three. One more.", "name": "MAN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "You said that two numbers ago.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "I was optimistic.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Footsteps echo far away.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Both freeze.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "The footsteps stop.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "A radio crackles in the distance and goes silent.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "How long?", "name": "WOMAN", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Ninety seconds.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Till what?", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Till he comes round again.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "She lifts the mop from the bucket like a spear.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "He shakes his head and takes it from her, sets it against the wall, and presses the stethoscope back to the lock.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "The dial turns.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "A deep, final clunk.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "The door sighs open an inch.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Got it.", "name": "MAN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Of course you did.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Inside, on a velvet plinth, a single gold clock the size of a fist ticks serenely.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Sixteen-forty-two. Made for a king who never lived to wind it.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Oh, I like him already.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "She steps forward.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "A red laser blinks across the doorway at ankle height.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "They both see it at the same moment.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "I don't remember that.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "I don't remember that.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Of course. Of course there's a laser.", "name": "MAN", "speaker": 0, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "The woman crouches, studies it, and pulls a compact mirror from her pocket.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "She holds it at an angle.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "The beam bends and strikes the wall.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "There. Satisfied?", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Reasonably.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "She steps through.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "The man follows, stepping high.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "At the plinth, she lifts the gold clock.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "It stops ticking.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "Silence.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "They look at each other.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "That's not good.", "name": "MAN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "She leans in and reads the name stitched on his guard's jacket.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "Marcus?", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "The man closes his eyes.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "Don't start.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "You told me your name was Gil.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "It's a long night.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "Footsteps again, closer now.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "Marcus takes the clock from her hands, sets it back on the plinth, and the ticking resumes.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "They look at it, then at each other.", "para": 14, "sent": 2, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "Marcus smiles, nervous and delighted.", "para": 14, "sent": 3, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "Run.", "name": "MARCUS", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}]}