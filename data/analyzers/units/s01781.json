{"scene_id": "s01781", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01781.fountain", "heading": "INT. COUNTY FAIR - PIE TENT - AFTERNOON", "cast": [{"id": 0, "name": "GIRL", "names": ["GIRL"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "TALL MAN", "names": ["TALL MAN"], "gender": "f", "first": 5, "spoke": 2}, {"id": 2, "name": "WOMAN", "names": ["WOMAN"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "LOUISE", "names": ["LOUISE"], "gender": "?", "first": 17, "spoke": 5}, {"id": 4, "name": "WALTER", "names": ["WALTER"], "gender": "?", "first": 17, "spoke": 6}, {"id": 5, "name": "POPPY", "names": ["POPPY"], "gender": "?", "first": 27, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. COUNTY FAIR - PIE TENT - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Long trestle tables under a striped canvas roof.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Judges' placards, wasps, and a hundred pies cooling in rows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A fan turns without effect.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A GIRL of nine in a gingham dress stands on a milk crate at the end of the nearest table, nose level with the pies.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "A TALL MAN in a pressed apron stands beside her, holding a rolling pin as though it might go off.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Across the tent, a WOMAN in a sunhat leans on a pole and watches them with tight, amused eyes.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Daddy, they're judging in four minutes.", "name": "GIRL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "I know, sweet pea.", "name": "TALL MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Is ours the one with the crust?", "name": "GIRL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "They all have crusts.", "name": "TALL MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "The one with the extra crust.", "name": "GIRL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "He looks down at her.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She looks up at him.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "The Woman in the sunhat pushes off the pole and strolls over, ducking a wasp, and the Girl waves while the Tall Man straightens his apron and drops the rolling pin, and the Girl catches it before it hits the ground.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Mama!", "name": "GIRL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "The Woman kisses her on the head, takes the rolling pin from her, rests it across the table, then takes the Tall Man's hand and turns it over to look at the flour on his palm.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Walter Brockhurst. You are covered in flour.", "name": "LOUISE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "I'm a baker, Louise.", "name": "WALTER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "You're a plumber.", "name": "LOUISE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "I'm a baker today.", "name": "WALTER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Mama, Daddy's nervous.", "name": "GIRL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Daddy is not nervous.", "name": "WALTER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "He's holding the pie with two hands.", "name": "GIRL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Walter looks down.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "He is holding the pie in both hands, as though it were a small and fragile pet.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "He puts it on the table.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Then let's let Poppy decide.", "name": "LOUISE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Me?", "name": "POPPY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "You made the filling. You chose the cinnamon.", "name": "LOUISE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "I chose too much cinnamon.", "name": "POPPY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Poppy, that's not true.", "name": "WALTER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "It's true, Daddy. I watched you taste it.", "name": "POPPY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "I was being polite.", "name": "WALTER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "You were being a coward.", "name": "LOUISE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Walter laughs.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "A judge approaches, a stern woman with a clipboard, and the three of them straighten up on instinct, shoulders squared, as though facing a firing squad.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Poppy steps off the crate.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Smile.", "name": "POPPY", "speaker": 5, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "I am smiling.", "name": "WALTER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Then smile with your face.", "name": "POPPY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}