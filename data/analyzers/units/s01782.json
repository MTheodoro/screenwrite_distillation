{"scene_id": "s01782", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01782.fountain", "heading": "INT. COURTHOUSE - WITNESS PREPARATION ROOM - DAY", "cast": [{"id": 0, "name": "ROSALIND ACHTERBERG", "names": ["ROSALIND ACHTERBERG", "ROSALIND"], "gender": "?", "first": 4, "spoke": 30}, {"id": 1, "name": "OSWALD TIMMONS", "names": ["OSWALD TIMMONS", "OSWALD"], "gender": "m", "first": 5, "spoke": 27}, {"id": 2, "name": "BAILIFF", "names": ["BAILIFF"], "gender": "?", "first": 63, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. COURTHOUSE - WITNESS PREPARATION ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A windowless room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A table, two chairs, a pitcher of water nobody has touched.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A wall clock with a loud second hand.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ROSALIND ACHTERBERG, forties, a defense attorney in a charcoal suit, sits with a legal pad.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across from her, OSWALD TIMMONS, fifties, a quiet accountant in a borrowed tie, smooths his sleeves.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "We have nine minutes. Do you remember what I told you?", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Answer the question asked. Don't volunteer.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Good.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Look at the jury.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Not too much.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Not too much.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She writes something.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He drinks water, then sets the cup down.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Ms. Achterberg. May I ask you something?", "name": "OSWALD", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Of course.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "When this is over, will you still be my lawyer?", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Mr. Timmons, I'll be your lawyer until the court says I'm not.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "That's not what I asked.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She looks at him a moment.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "The clock ticks.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Yes.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "He nods, relieved, and folds his hands.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "It's strange. I've kept books for thirty years. Never lost a penny of anyone else's.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "I know. That's what the jury will hear.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "They won't hear the ledger?", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "They won't read the ledger. They'll hear you.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Then I should stop fidgeting.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "You're doing fine.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "You're kind.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "I'm accurate.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "He smiles faintly.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "She turns a page on the legal pad.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "One more thing. Direct examination goes first, then cross. The prosecutor will try to rattle you with the Cayman accounts.", "name": "ROSALIND", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "I understand.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "What do you say?", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "I say I reported them. Fully. On the forms the bank gave me.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "And if he asks about the second set of forms?", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "What second set?", "name": "OSWALD", "speaker": 1, "ext": [], "paren": ["a beat"], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Exactly. Don't get cute.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "I'm not cute.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "No. You're not.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "The clock ticks.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Rosalind caps her pen.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Oswald. Look at me.", "name": "ROSALIND", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "I'm looking.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Is there a second set of forms?", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "No.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Think carefully.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "There is no second set of forms.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Because if there is, I need to know now, not on the stand. I can still protect you now.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Ms. Achterberg.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Yes?", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "You've been wonderful.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "Rosalind studies him.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "She does not speak.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "The clock ticks four more times.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "Mr. Timmons, why did you say \"wonderful\"?", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "Because you have.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "You said it like goodbye.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "Did I?", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "Yes.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "A knock at the door.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "A BAILIFF's voice carries through.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "Two minutes, counselor.", "name": "BAILIFF", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "Thank you.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "She doesn't move.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "Oswald stands, straightens his tie, and picks up a thin manila folder from the floor beside his chair.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "He sets it on the table in front of her.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 69, "kind": "dialogue", "text": "I was going to give you this after.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "She opens it.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 71, "kind": "action", "text": "Inside, a second set of forms.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 72, "kind": "action", "text": "She reads the first page, then the second, and her face remains still.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 73, "kind": "dialogue", "text": "When did you find these?", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 74, "kind": "dialogue", "text": "I didn't find them. I made them.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 75, "kind": "dialogue", "text": "Oswald.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 76, "kind": "dialogue", "text": "I thought you should know before I swear to tell the truth.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 77, "kind": "dialogue", "text": "Why?", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 78, "kind": "dialogue", "text": "Because I would like very much to do it.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 79, "kind": "action", "text": "Rosalind closes the folder.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 80, "kind": "action", "text": "The second hand ticks.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 81, "kind": "action", "text": "Neither moves.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 82, "kind": "dialogue", "text": "Sit down.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 83, "kind": "action", "text": "He sits.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 84, "kind": "dialogue", "text": "We're going to ask for a continuance. And you're going to tell me everything, from the beginning.", "name": "ROSALIND", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 85, "kind": "dialogue", "text": "All right.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 86, "kind": "dialogue", "text": "Start with the first account.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 87, "kind": "dialogue", "text": "Start with the first account.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": ["speaking over her"], "dual": false, "present": [0, 1, 2]}, {"u": 88, "kind": "action", "text": "He smiles.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 89, "kind": "action", "text": "She almost does.", "para": 13, "sent": 1, "present": [0, 1, 2]}]}