{"scene_id": "s01786_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01786.fountain", "heading": "INT. ICE-FISHING SHACK - CONTINUOUS", "cast": [{"id": 0, "name": "GRETA HOLLINGSWORTH", "names": ["GRETA HOLLINGSWORTH", "GRETA"], "gender": "m", "first": 4, "spoke": 7}, {"id": 1, "name": "LEIF AASEN", "names": ["LEIF AASEN", "LEIF"], "gender": "m", "first": 5, "spoke": 7}, {"id": 2, "name": "DANTE FIORENTINO", "names": ["DANTE FIORENTINO", "DANTE"], "gender": "m", "first": 6, "spoke": 8}, {"id": 3, "name": "STRANGER", "names": ["STRANGER"], "gender": "m", "first": 36, "spoke": 4}, {"id": 4, "name": "TOBIAS", "names": ["TOBIAS"], "gender": "m", "first": 50, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. ICE-FISHING SHACK - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Cramped.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A bunk, a wood stove, two holes in the floor with lines dangling into black water.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Four people live here this week.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "GRETA HOLLINGSWORTH, forties, sits by the stove, sorting matches.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "LEIF AASEN, twenties, hunches over a hole with a rod.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "DANTE FIORENTINO, fifties, lies on the bunk with a blanket up to his chin.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "They have not spoken in an hour.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Anything?", "name": "LEIF", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Not yet.", "name": "GRETA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "It'll bite when the barometer drops.", "name": "DANTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "We don't have a barometer.", "name": "LEIF", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Then it'll bite when it feels like it.", "name": "DANTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Greta tosses a match into the stove.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "It flares, spits, goes out.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Forty hours. We said we'd be home in twelve.", "name": "GRETA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "We said the truck would start.", "name": "LEIF", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "The truck started.", "name": "DANTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "It started and then it died, Dante.", "name": "GRETA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "It died in a way that was consistent with starting.", "name": "DANTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Leif laughs despite himself.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Greta almost does.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "The line in the hole twitches.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Leif grabs the rod.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Greta rises.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Dante sits up.", "para": 3, "sent": 5, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "I've got something.", "name": "LEIF", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Easy. Easy.", "name": "GRETA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Don't horse it.", "name": "DANTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Leif reels.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "The water breaks.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "A pike, long as his arm, thrashes up through the hole and flops onto the floor boards, where it lies still, mouth working.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "All three stare at it.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "The shack is silent.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Well.", "name": "GRETA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Then the shack door bangs open.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "A STRANGER fills the doorway, fifties, bundled head to boot in a snow-caked parka, ice in his beard, a snowmobile helmet under one arm.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "I smelled the smoke from two miles away. Anybody home?", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Mister, you have no idea.", "name": "LEIF", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Close the door. You're letting out the warm.", "name": "DANTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Sorry. Sorry.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "He shuts it.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Greta stares at him.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "He stares at the pike.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "That your supper?", "name": "STRANGER", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "It's our supper if you've got a sled.", "name": "GRETA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Got a sled. Got a tow rope. Got a thermos of coffee, too.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Coffee.", "name": "DANTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Coffee!", "name": "LEIF", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Sit down, mister--", "name": "GRETA", "speaker": 0, "ext": [], "paren": ["over them"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Wren. Tobias Wren.", "name": "TOBIAS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "Wren, there's a sled?", "name": "DANTE", "speaker": 2, "ext": [], "paren": ["over Greta"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "Is it big enough for four?", "name": "LEIF", "speaker": 1, "ext": [], "paren": ["over both"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "It's big enough for four and a fish.", "name": "TOBIAS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "Greta sits him on the bunk and presses a tin mug into his hands.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "The pike gives one last flop.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}]}