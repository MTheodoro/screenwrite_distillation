{"scene_id": "s01787", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01787.fountain", "heading": "INT. FARMHOUSE KITCHEN - MORNING", "cast": [{"id": 0, "name": "GRANDMA ROSELLA PIPER", "names": ["GRANDMA ROSELLA PIPER", "ROSELLA"], "gender": "?", "first": 5, "spoke": 1}, {"id": 1, "name": "HAROLD PIPER", "names": ["HAROLD PIPER", "HAROLD"], "gender": "m", "first": 5, "spoke": 1}, {"id": 2, "name": "JUNIPER", "names": ["JUNIPER"], "gender": "?", "first": 7, "spoke": 1}, {"id": 3, "name": "MABEL", "names": ["MABEL"], "gender": "f", "first": 7, "spoke": 1}, {"id": 4, "name": "TOBY", "names": ["TOBY"], "gender": "?", "first": 9, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. FARMHOUSE KITCHEN - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "A big kitchen, yellow-walled, with a scarred oak table and a coal range ticking.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Window boxes of red geraniums.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A rooster clock on the wall reads six-fifty.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Pancake batter on every surface.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "GRANDMA ROSELLA PIPER, seventies, small and iron-backed, stands at the range flipping a pancake the size of a hubcap.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "HAROLD PIPER, her son, forties, sits at the table in a clean work shirt and reads the paper.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "His wife JUNIPER, forties, ties a ribbon around their daughter MABEL's braid.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "MABEL, seven, kicks her feet.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "In the corner, an old beagle named BISCUIT sleeps on a rag rug, and the youngest, TOBY, three, sits beneath the table with a wooden spoon.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Rosella flips the pancake.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "It lands on the floor.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Biscuit wakes, Toby lunges, the beagle and the toddler scramble for it together, and Mabel shrieks.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Toby's eating off the floor!", "name": "MABEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Toby, no!", "name": "JUNIPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Floor pancake's the best pancake.", "name": "HAROLD", "speaker": 1, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Harold!", "name": "ROSELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Rosella scoops Toby up with one arm and the pancake with the other.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Juniper snatches the spoon.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Harold folds his paper and sighs with great contentment.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}]}