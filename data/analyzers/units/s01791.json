{"scene_id": "s01791", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01791.fountain", "heading": "INT. LAUNDROMAT - NIGHT", "cast": [{"id": 0, "name": "AUGUSTINE BELLAMY", "names": ["AUGUSTINE BELLAMY", "AUGUSTINE"], "gender": "m", "first": 5, "spoke": 1}, {"id": 1, "name": "MARTA BELLAMY", "names": ["MARTA BELLAMY"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "LUCAS", "names": ["LUCAS"], "gender": "m", "first": 7, "spoke": 0}, {"id": 3, "name": "HANA", "names": ["HANA"], "gender": "?", "first": 8, "spoke": 1}, {"id": 4, "name": "PIPPA", "names": ["PIPPA"], "gender": "?", "first": 8, "spoke": 1}, {"id": 5, "name": "DESMOND", "names": ["DESMOND"], "gender": "?", "first": 9, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAUNDROMAT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent tubes, a row of humming dryers, a vending machine selling single-serve detergent.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rain on the window.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The big clock reads 9:40.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Orange plastic chairs bolted in a row.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "AUGUSTINE BELLAMY, sixties, tall, sits stiff in a chair with a duffel bag between his boots.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Beside him MARTA BELLAMY, fifties, folds the same towel for the third time.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Their son LUCAS, twenty, slouches against a washer with his earbuds in.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Their daughters, HANA, fourteen, and PIPPA, nine, share a dryer's warm glass front, sitting cross-legged on the floor.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "And in the doorway stands DESMOND, Augustine's brother, forty, rain-soaked, a suitcase in each hand.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "Nobody speaks.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "Marta puts down the towel.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "Augustine looks at the duffel.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "Lucas pulls out one earbud.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "Hana and Pippa stop whispering.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "The dryers keep turning.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "I knocked at the house.", "name": "DESMOND", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "We moved.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "I see that.", "name": "DESMOND", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Desmond sets down one suitcase.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Then the other.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Water drips from his sleeves.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Is that Uncle Dez?", "name": "PIPPA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Shh.", "name": "HANA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Marta stands.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Augustine stands.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Lucas pushes off the washer.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "They form a half circle around the door, and no one reaches for anyone.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Then Marta crosses to the vending machine, feeds it quarters, and returns with a tiny box of detergent.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "She hands it to Desmond.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "He takes it, turns it over, and nods slowly.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Augustine clears his throat and moves his duffel off the seat beside him.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}