{"scene_id": "s01792", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01792.fountain", "heading": "INT. PROVINCIAL TAXIDERMY CLUB - MEETING HALL - EVENING", "cast": [{"id": 0, "name": "HORTENSE ABERNATHY-LIU", "names": ["HORTENSE ABERNATHY-LIU", "HORTENSE"], "gender": "f", "first": 4, "spoke": 13}, {"id": 1, "name": "CHESTER PUDDIFOOT", "names": ["CHESTER PUDDIFOOT", "CHESTER"], "gender": "m", "first": 6, "spoke": 14}, {"id": 2, "name": "BERNIE", "names": ["BERNIE"], "gender": "?", "first": 7, "spoke": 9}, {"id": 3, "name": "OKOYE", "names": ["OKOYE"], "gender": "?", "first": 7, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. PROVINCIAL TAXIDERMY CLUB - MEETING HALL - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "A long, low room paneled in dark wood and ringed with the glass eyes of badgers.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A banner says TWENTY-NINTH ANNUAL STUFFED SHIRT AWARDS.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A folding table holds a punch bowl and a single plate of deviled eggs.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "HORTENSE ABERNATHY-LIU, sixty, club president, in tweed and a name badge, taps a spoon against a glass.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She is ignored.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "CHESTER PUDDIFOOT, seventy, treasurer, mutters into a ledger at the end of the table.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "And BERNADETTE \"BERNIE\" OKOYE, forties, the newest member, stands at the deviled eggs with a plastic cup, trying to look as if she has belonged for decades.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Order. Order, please.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "There's nobody here to order, Hortense.", "name": "CHESTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "There are three of us, Chester.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "There's two and a half. Bernadette is a guest.", "name": "CHESTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "I paid my dues.", "name": "BERNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "You paid half your dues.", "name": "CHESTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "I paid the half I could afford.", "name": "BERNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "That's a fair point.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "It's a half point.", "name": "CHESTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Hortense taps the glass again, loudly, and a stuffed owl on the wall falls off its perch and thumps to the carpet.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "All three look at it.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Nobody moves.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Should somebody...?", "name": "BERNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "It's done that before.", "name": "CHESTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "It always lands facing the wall.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "The owl lies face-down.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Bernie takes a deviled egg, studies it, and sets it down again as if it might be evidence.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Chester turns a page of his ledger with enormous care.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Hortense straightens her badge.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "First item. The Stuffed Shirt Award for Excellence in Taxidermy.", "name": "HORTENSE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Who's nominated?", "name": "CHESTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Last year's winner was a trout.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Was it a good trout?", "name": "BERNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "It was an adequate trout.", "name": "CHESTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "It was beautiful, Chester.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "It had one fin.", "name": "CHESTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "It had one fin when it came to us. We did what we could.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Maybe the fin was the point.", "name": "BERNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "They both look at her.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "She grips her cup, suddenly aware of herself.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Like, art. The fin that isn't there.", "name": "BERNIE", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "She has a point.", "name": "CHESTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "She has half a point.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Now you're doing it.", "name": "BERNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "We're a very precise club.", "name": "CHESTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Hortense crosses to the owl, picks it up, and carries it with great tenderness to the table.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "She sets it between the punch bowl and the eggs.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "This year's winner. By acclamation.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Of whom?", "name": "CHESTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Of the owl.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "It fell off its perch.", "name": "CHESTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "It fell with dignity.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "I second it.", "name": "BERNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "You can't second it. You're a guest.", "name": "CHESTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "I'm half a member.", "name": "BERNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Seconded, then.", "name": "CHESTER", "speaker": 1, "ext": [], "paren": ["a beat"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Hortense produces a small gold ribbon from her handbag and pins it to the owl's chest.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "She steps back.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "They stand in a row, Hortense, Chester, and Bernie, looking at the owl, and it looks at the wall.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "A moment of silence.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "Nobody speaks.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "The old radiator knocks twice.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "Bernie takes the deviled egg after all and eats it.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}]}