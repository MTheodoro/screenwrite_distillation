{"scene_id": "s01795", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01795.fountain", "heading": "EXT. SHELLED VILLAGE - CELLAR HATCH - NIGHT", "cast": [{"id": 0, "name": "CORPORAL YUSUF DEMIR", "names": ["CORPORAL YUSUF DEMIR", "YUSUF"], "gender": "m", "first": 4, "spoke": 13}, {"id": 1, "name": "HAL", "names": ["HAL"], "gender": "m", "first": 5, "spoke": 11}, {"id": 2, "name": "QUIST", "names": ["QUIST"], "gender": "?", "first": 5, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SHELLED VILLAGE - CELLAR HATCH - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Broken roofs.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A church tower snapped in half.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Flares drift down on parachutes and the ground shudders with distant guns.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CORPORAL YUSUF DEMIR, thirties, crouches at a cellar hatch with a rifle across his knees.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside him lies PRIVATE HALLORAN \"HAL\" QUIST, nineteen, on his back, helmet over his eyes.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "Yusuf shoves him.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Up.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "I am up.", "name": "HAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "You're lying down.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "It's a different kind of up.", "name": "HAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "A shell lands close.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Dirt rains.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Both flatten.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "The ringing fades.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Count.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "One. Two.", "name": "HAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Not shells. Us.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Two.", "name": "HAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Yusuf nods.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "He rises to a crouch and peers over the ruined wall.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "A flare dies.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Darkness.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "We go on three.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Where?", "name": "HAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "The bridge.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "There is no bridge.", "name": "HAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "There's a bridge.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "There was a bridge.", "name": "HAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Yusuf looks at him.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Hal sits up and pushes his helmet back.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Hal.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "I know.", "name": "HAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "If I say go, you go.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "I know.", "name": "HAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "If I fall, you keep going.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "I know.", "name": "HAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "One.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "One.", "name": "HAL", "speaker": 1, "ext": [], "paren": ["at the same time"], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "They exchange a glance.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "A flare pops overhead and the night turns white.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Two.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Hal checks his rifle.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Yusuf takes a breath.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Three.", "name": "YUSUF", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "They run.", "para": 8, "sent": 0, "present": [0, 1, 2]}]}