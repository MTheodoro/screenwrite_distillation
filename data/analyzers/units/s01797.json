{"scene_id": "s01797", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01797.fountain", "heading": "INT. LAKESIDE CABIN - PORCH - EVENING", "cast": [{"id": 0, "name": "GERRY", "names": ["GERRY"], "gender": "?", "first": 5, "spoke": 15}, {"id": 1, "name": "RAYMOND MUKHERJEE", "names": ["MUKHERJEE", "RAYMOND MUKHERJEE", "RAYMOND"], "gender": "m", "first": 5, "spoke": 20}, {"id": 2, "name": "OPHELIA TANAKA-DUBOIS", "names": ["OPHELIA TANAKA-DUBOIS", "OPHELIA"], "gender": "f", "first": 7, "spoke": 12}, {"id": 3, "name": "OSCAR LINDQVIST", "names": ["OSCAR LINDQVIST", "OSCAR"], "gender": "?", "first": 8, "spoke": 11}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAKESIDE CABIN - PORCH - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "A screened porch with four mismatched rocking chairs and a card table.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A citronella candle burns in a coffee can.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Crickets.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The lake is the color of pewter.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "GERALDINE \"GERRY\" MUKHERJEE, fifties, tends a pitcher of lemonade.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Her brother RAYMOND MUKHERJEE, sixty, wears a fishing vest and no fish.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Their old friend OPHELIA TANAKA-DUBOIS, fifty-five, knits something that might be a scarf.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "And OSCAR LINDQVIST, thirty, Gerry's nephew by marriage, sits on the steps with a laptop he's not using.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "They've been there a long time.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "The pitcher is almost empty.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "So that's three years since anyone caught a fish at this lake.", "name": "GERRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "I caught one in July.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "That was a boot.", "name": "GERRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "It was shaped like a fish.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "It was a boot, Raymond.", "name": "OPHELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "A fish-shaped boot.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Is there a Wi-Fi password?", "name": "OSCAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "There's no Wi-Fi, Oscar.", "name": "GERRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "At all?", "name": "OSCAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "There's the lake.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "That's not Wi-Fi.", "name": "OSCAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "No, but it's what we've got.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Ophelia holds up her knitting.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "It is a lumpy tube.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "What does this look like?", "name": "OPHELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "A sock.", "name": "GERRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "A scarf.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "A tube.", "name": "OSCAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "It's a tube. I wasn't sure.", "name": "OPHELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Then why did you knit it?", "name": "GERRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "I thought it would find its shape.", "name": "OPHELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "They never do.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Raymond, you can be very negative.", "name": "OPHELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "I'm a realist.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "You're a pessimist with a fishing license.", "name": "OPHELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "That's cruel.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "It's accurate.", "name": "OPHELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "You two should marry.", "name": "GERRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "GERRY!", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Gerry!", "name": "OPHELIA", "speaker": 2, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "They glare at her.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "She sips her lemonade, unrepentant.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Oscar looks up from the laptop.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Wait, were you serious? Because I could use the extra drama.", "name": "OSCAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "I was never serious in my life.", "name": "GERRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "That's not true.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Name one time.", "name": "GERRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Nineteen eighty-seven. You wanted to be a lion tamer.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "I was seventeen.", "name": "GERRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "You bought a whip.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "It was a very good whip.", "name": "GERRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "She used it on the neighbor's goat.", "name": "OPHELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "It was trespassing.", "name": "GERRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "This is better than the internet.", "name": "OSCAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "It's called the family, Oscar.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "I know.", "name": "OSCAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "No. I don't think you do.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "Raymond rises from his rocker, goes to the screen, and looks out at the lake.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "When I was a boy, our father brought us here. We'd sit on this very porch and he'd say, \"Listen.\" And we'd listen. And you know what we heard?", "name": "RAYMOND", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "Crickets?", "name": "OSCAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "Nothing. It was beautiful.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "He had a lot of theories about nothing.", "name": "GERRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "He had a lot of theories about everything.", "name": "OPHELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "He was right about the goat.", "name": "GERRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "That is true.", "name": "OPHELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "Let's all be quiet for a minute.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "Can I keep typing?", "name": "OSCAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "No.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "dialogue", "text": "Fine.", "name": "OSCAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "The four of them sit in silence.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "The lake laps.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "action", "text": "A loon calls from somewhere out of sight.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "Is anyone going to catch a fish?", "name": "GERRY", "speaker": 0, "ext": [], "paren": ["after a beat"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "dialogue", "text": "No.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "dialogue", "text": "No.", "name": "OPHELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "dialogue", "text": "No.", "name": "OSCAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "dialogue", "text": "Good. Then we can finish the lemonade.", "name": "GERRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}