{"scene_id": "s01798", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01798.fountain", "heading": "INT. OFFICE BREAK ROOM - DAY", "cast": [{"id": 0, "name": "DISH SOAP DISPENSER", "names": ["DISH SOAP DISPENSER"], "gender": "?", "first": 2, "spoke": 0}, {"id": 1, "name": "DEBORAH PIERCE", "names": ["DEBORAH PIERCE", "DEBORAH"], "gender": "?", "first": 5, "spoke": 6}, {"id": 2, "name": "FELIX NWOSU", "names": ["FELIX NWOSU", "FELIX"], "gender": "?", "first": 6, "spoke": 4}, {"id": 3, "name": "SHANTI VENKATARAMAN", "names": ["SHANTI VENKATARAMAN", "SHANTI"], "gender": "f", "first": 7, "spoke": 5}, {"id": 4, "name": "KURT BJORKLUND", "names": ["KURT BJORKLUND", "KURT"], "gender": "?", "first": 8, "spoke": 4}, {"id": 5, "name": "TEODORA IVANOVA", "names": ["TEODORA IVANOVA", "TEODORA"], "gender": "f", "first": 9, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. OFFICE BREAK ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Beige.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A microwave with a taped sign: NOT A DISH SOAP DISPENSER.", "para": 0, "sent": 1, "present": [0]}, {"u": 3, "kind": "action", "text": "A fridge covered in passive-aggressive notes.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "A cake sits on the table, untouched.", "para": 0, "sent": 3, "present": [0]}, {"u": 5, "kind": "action", "text": "DEBORAH PIERCE, fifties, hovers behind the cake with a knife.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "FELIX NWOSU, twenties, hugs a laptop.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "SHANTI VENKATARAMAN, thirties, stands at the coffee machine as if she has been standing there for a decade.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "KURT BJORKLUND, forties, leans in the doorway.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "And TEODORA IVANOVA, sixty, the birthday girl, sits at the table, smiling with the stiffness of a hostage.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Okay, everybody! Cake time!", "name": "DEBORAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Cake time.", "name": "FELIX", "speaker": 2, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "I didn't know it was Teodora's birthday.", "name": "SHANTI", "speaker": 3, "ext": [], "paren": ["to Deborah"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "It's not. It's her retirement.", "name": "DEBORAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "It's both.", "name": "TEODORA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "It's a hybrid.", "name": "KURT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Teodora, how many years?", "name": "DEBORAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Thirty-one.", "name": "TEODORA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Thirty-one?", "name": "FELIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "I've been here eleven and I've never seen you.", "name": "SHANTI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "I sit by the copier.", "name": "TEODORA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Does anyone have a plate?", "name": "KURT", "speaker": 4, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "They're in the cupboard.", "name": "DEBORAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "They're not in the cupboard.", "name": "FELIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "They're by the sink.", "name": "SHANTI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "They're in the drawer.", "name": "KURT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Everyone starts at once.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Deborah opens the cupboard, Felix checks the sink, Shanti pulls the drawer, Kurt says \"I'll look in the fridge\" and does not move.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Teodora watches from the table, hands folded.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "It's all right. I don't need a plate.", "name": "TEODORA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Of course you do.", "name": "DEBORAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "I brought my own.", "name": "TEODORA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "She takes a small blue enamel plate from her bag and sets it on the table.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "The others stop.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Nobody says a word.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Thirty-one years.", "name": "FELIX", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Let's sing!", "name": "DEBORAH", "speaker": 1, "ext": [], "paren": ["to the group"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "They sing, ragged and sparse.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Teodora lifts her plate with both hands as if receiving a sacrament.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Deborah cuts the cake, hands her the first slice, and Teodora eats it slowly, looking at none of them.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Good cake.", "name": "KURT", "speaker": 4, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Thank you.", "name": "SHANTI", "speaker": 3, "ext": [], "paren": ["softly, to Teodora"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "For what?", "name": "TEODORA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "I don't know.", "name": "SHANTI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Teodora nods, as if that were exactly right, and takes another bite.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}