{"scene_id": "s01799", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01799.fountain", "heading": "INT. WEDDING PLANNER'S OFFICE - DAY", "cast": [{"id": 0, "name": "BEATRIX LOMBARDI", "names": ["BEATRIX LOMBARDI", "BEATRIX"], "gender": "f", "first": 5, "spoke": 8}, {"id": 1, "name": "NAT", "names": ["NAT"], "gender": "m", "first": 6, "spoke": 5}, {"id": 2, "name": "OSEI-WRIGHT", "names": ["OSEI-WRIGHT"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "GENEVIEVE ABARCA", "names": ["GENEVIEVE ABARCA", "GENEVIEVE"], "gender": "?", "first": 7, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. WEDDING PLANNER'S OFFICE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Swatches pinned to corkboards.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A mood board shaped like a heart.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cold cappuccino.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "On the desk, an old desk phone with a red blinking light.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "BEATRIX LOMBARDI, thirties, a wedding planner in a pastel blazer, stares at the phone.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Opposite her, NATHANIEL \"NAT\" OSEI-WRIGHT, thirties, groom, sits upright, hands clamped on his knees.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "His fiancee's mother, MRS. GENEVIEVE ABARCA, is on the speakerphone.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Beatrix? Is Nathaniel there? I want him to hear this.", "name": "GENEVIEVE", "speaker": 3, "ext": ["V.O."], "paren": ["from phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Beatrix gives Nat a tight smile.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "He nods, the way a man nods when he is being led to a dentist.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "He's right here, Mrs. Abarca.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Lovely. Nathaniel, dear.", "name": "GENEVIEVE", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Hello, Mrs. Abarca.", "name": "NAT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "I've been thinking about the flowers.", "name": "GENEVIEVE", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Nat closes his eyes.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Beatrix sets her pen down, then picks it up again.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "The peonies?", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "No, no, the peonies are fine. It's the carnations I don't care for.", "name": "GENEVIEVE", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "We don't have carnations.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Well, you should.", "name": "GENEVIEVE", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Beatrix looks at the ceiling.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Nat looks at her.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "A very long pause stretches.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Mrs. Abarca, I think carnations are a terrific idea.", "name": "NAT", "speaker": 1, "ext": [], "paren": ["carefully"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Nat.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": ["sharp, aside"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "What? It's a flower.", "name": "NAT", "speaker": 1, "ext": [], "paren": ["aside"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "You see? Nathaniel understands. Beatrix, I want carnations on every table, and on the cake, and in the bride's hair.", "name": "GENEVIEVE", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "In her hair.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Is there a problem?", "name": "GENEVIEVE", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "None at all.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Beatrix pushes a notepad toward Nat.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "He picks up a pen and writes: SAY NO. Beatrix reads it, nods, and writes beneath it: YOU SAY NO. Nat reads it, shakes his head violently, and underlines his own: SAY NO.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Hello? Did I lose you?", "name": "GENEVIEVE", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "No. We're here.", "name": "NAT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "I wanted to ask one more thing.", "name": "GENEVIEVE", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Of course.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": ["through her teeth"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Is it too late to change the date?", "name": "GENEVIEVE", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Nat drops his pen.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Beatrix stands.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "She goes to the phone, lifts the handset, hangs up on Mrs. Abarca, and sets the receiver down with immense care.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "The red light stops blinking.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Neither of them speaks.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Nat folds the notepad in half, and in half again, and tucks it into his breast pocket.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Carnations.", "name": "NAT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Carnations.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "She sits back down and takes a long sip of the cold cappuccino.", "para": 8, "sent": 0, "present": [0, 1, 2]}]}