{"scene_id": "s01800", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01800.fountain", "heading": "INT. VANTAGE BRANDS - CONFERENCE ROOM 4B - DAY", "cast": [{"id": 0, "name": "CLAUDETTE ABERNETHY-FOX", "names": ["CLAUDETTE ABERNETHY-FOX", "CLAUDETTE"], "gender": "?", "first": 4, "spoke": 12}, {"id": 1, "name": "ROMAN DZIEDZIC", "names": ["ROMAN DZIEDZIC", "ROMAN"], "gender": "?", "first": 5, "spoke": 7}, {"id": 2, "name": "PHIL", "names": ["PHIL"], "gender": "?", "first": 6, "spoke": 9}, {"id": 3, "name": "ARCHULETA", "names": ["ARCHULETA"], "gender": "?", "first": 6, "spoke": 0}, {"id": 4, "name": "CFO", "names": ["CFO"], "gender": "?", "first": 6, "spoke": 0}, {"id": 5, "name": "FAMILY", "names": ["FAMILY"], "gender": "?", "first": 12, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. VANTAGE BRANDS - CONFERENCE ROOM 4B - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A glass box with a view of a parking structure.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Whiteboard marker dries in its tray.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A tray of untouched fruit.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CLAUDETTE ABERNETHY-FOX, forties, VP of Culture, stands at the screen with a clicker.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "ROMAN DZIEDZIC, thirties, a senior analyst, sits with a printout.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "PHILOMENA \"PHIL\" ARCHULETA, fifties, the new CFO, sits at the head of the table in a coat she hasn't removed.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "dialogue", "text": "Welcome to the all-hands pre-read. I'll start with the good news.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "There's good news?", "name": "ROMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "I'm going to need you to trust me.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "I'm listening.", "name": "PHIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Claudette clicks.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "A slide appears: a giant smiling sun and the words WE ARE A FAMILY.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "We are a family.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "We laid off forty people on Monday.", "name": "ROMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Families have difficult conversations.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Families don't usually fire each other by email.", "name": "ROMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Roman.", "name": "PHIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "I'm only saying.", "name": "ROMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "We prefer the term \"restructured.\"", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "They prefer the term \"fired.\"", "name": "ROMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Claudette clicks.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "A second slide: a graph of declining revenue, titled \"GROWTH OPPORTUNITIES.\"", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Can I ask a basic question?", "name": "PHIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Please.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Where does the revenue go?", "name": "PHIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "It goes into the future.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "It goes into the Culture budget.", "name": "ROMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Which is the future.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Claudette, your Culture budget is larger than engineering.", "name": "PHIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Culture is engineering.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Culture is a line item.", "name": "PHIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Phil, with respect--", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "With respect, I read the line items.", "name": "PHIL", "speaker": 2, "ext": [], "paren": ["over her"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "They stare at each other.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Roman reaches for a strawberry, eats it, and eats another.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "I'll circulate a deck.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Please do.", "name": "PHIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Will there be a pre-read for the pre-read?", "name": "ROMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Yes, Roman. There will.", "name": "CLAUDETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "She clicks to a third slide: a photograph of a golden retriever puppy with the words LET'S GO TOGETHER.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Nobody speaks.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "The fruit tray, mostly full, sits in the center like a witness.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "I'm going to need to see a puppy budget.", "name": "PHIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}