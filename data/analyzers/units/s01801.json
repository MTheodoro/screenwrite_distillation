{"scene_id": "s01801", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01801.fountain", "heading": "EXT. SEAWALL PROMENADE - TWILIGHT", "cast": [{"id": 0, "name": "CECILIA MONTGOMERY-VANE", "names": ["CECILIA MONTGOMERY-VANE", "CECILIA"], "gender": "?", "first": 5, "spoke": 8}, {"id": 1, "name": "WILLIAM HARCOURT", "names": ["WILLIAM HARCOURT", "WILLIAM"], "gender": "?", "first": 7, "spoke": 7}, {"id": 2, "name": "SIMEON ABARA", "names": ["SIMEON ABARA", "SIMEON"], "gender": "m", "first": 8, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SEAWALL PROMENADE - TWILIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A curved stone seawall at the edge of a resort town.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Gas lamps flicker on.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Waves slap the base of the wall.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A band plays faintly from a pavilion down the shore.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CECILIA MONTGOMERY-VANE, thirties, stands at the rail in a white evening gown and a traveling cloak.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A suitcase sits at her feet.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Twenty yards away, WILLIAM HARCOURT, thirties, in a rumpled dinner jacket, runs toward her with his tie undone, waving a train ticket.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "A porter, SIMEON ABARA, fifties, trails behind him, struggling with a hatbox.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "William skids to a halt.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Cecilia turns.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "For a long moment they simply look at each other, both breathless, her cloak lifting in the wind, his tie whipping.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "You're still here.", "name": "WILLIAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "I missed the six o'clock.", "name": "CECILIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I know. I heard.", "name": "WILLIAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "How?", "name": "CECILIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "I asked the stationmaster. He said a woman in white had been sitting on the platform for two hours, refusing to board.", "name": "WILLIAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I was thinking.", "name": "CECILIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "About what?", "name": "WILLIAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "About whether you'd come.", "name": "CECILIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Simeon arrives, wheezing, and sets the hatbox on the stones.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "He looks from Cecilia to William and then, discreetly, studies the horizon.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Madam, shall I wait?", "name": "SIMEON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Please. Just a moment, Simeon.", "name": "CECILIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Cecilia and William step toward each other at once, then stop at the same time, a foot apart.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "William drops the ticket.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "A gust takes it.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Cecilia lunges, William lunges, their hands collide on the paper, and they both laugh, ruefully, holding it between them.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "It's one-way.", "name": "WILLIAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Mine, too.", "name": "CECILIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Where were you going?", "name": "WILLIAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Anywhere you weren't.", "name": "CECILIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "And now?", "name": "WILLIAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Anywhere you are.", "name": "CECILIA", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "He takes her hand.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Simeon coughs politely, picks up the hatbox, and the suitcase, and turns his back with great ceremony.", "para": 5, "sent": 1, "present": [0, 1, 2]}]}