{"scene_id": "s01802", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01802.fountain", "heading": "INT. NIGHT-SHIFT DINER - BOOTH - 3 A.M.", "cast": [{"id": 0, "name": "RUTH ALMEIDA-STONE", "names": ["RUTH ALMEIDA-STONE", "RUTH"], "gender": "f", "first": 5, "spoke": 6}, {"id": 1, "name": "LORELEI", "names": ["LORELEI"], "gender": "f", "first": 6, "spoke": 7}, {"id": 2, "name": "WAITRESS", "names": ["WAITRESS"], "gender": "?", "first": 7, "spoke": 1}, {"id": 3, "name": "MAN", "names": ["MAN"], "gender": "?", "first": 17, "spoke": 5}, {"id": 4, "name": "COOK", "names": ["COOK"], "gender": "?", "first": 34, "spoke": 1}, {"id": 5, "name": "BERNARD", "names": ["BERNARD"], "gender": "?", "first": 42, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT-SHIFT DINER - BOOTH - 3 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "Vinyl booths.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A flickering OPEN sign.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain on the glass.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A jukebox plays something low.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "RUTH ALMEIDA-STONE, forties, sits with her coat on and a cold coffee.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across from her, her sister LORELEI, thirties, stares into her own cup.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "A WAITRESS stands at the end of the booth with a pot, patient.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Nobody speaks.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Ruth turns the sugar dispenser in a slow circle.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "You came all this way.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I said I would.", "name": "LORELEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Refill, ladies?", "name": "WAITRESS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Please.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "The waitress pours.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Lorelei puts her hand over her cup, then removes it, then lets the waitress pour.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "A bell over the door jingles.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "A MAN in a soaked trench coat steps in, scans the room, and heads toward their booth.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Ruth.", "name": "MAN", "speaker": 3, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Ruth does not look up.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Lorelei does.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Who is this?", "name": "LORELEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Nobody.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "I'm not nobody. I'm the one who drove four hours.", "name": "MAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "He sits next to Lorelei without being invited.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "She slides away, but he's already too close.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Excuse me?", "name": "LORELEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Ruth, tell her.", "name": "MAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Don't.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Tell her about Dad.", "name": "MAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Lorelei turns to her sister.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "What about Dad?", "name": "LORELEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Ruth says nothing.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "The waitress retreats.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Through the kitchen pass, a COOK in a stained apron slaps a bell.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Order up! The jukebox ends one song and begins another.", "name": "COOK", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "She hasn't told you.", "name": "MAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Ruth.", "name": "LORELEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "He's not who you think he was.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "The man leans back, satisfied, and slips off his hat.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Under the diner light, he has their father's chin.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Who are you?", "name": "LORELEI", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Bernard Almeida-Stone. Your brother.", "name": "BERNARD", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Lorelei stares at him.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Then at Ruth.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Ruth finally looks up, and she is crying, and not hiding it.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "I wanted to tell you. I swear I did.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "Lorelei slides out of the booth and stands.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "She picks up her purse.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "Bernard stands too.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "Ruth reaches for her sister's sleeve, and Lorelei steps back.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "Sit down.", "name": "LORELEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "Ruth sits.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "Bernard sits.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "Lorelei does not.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}