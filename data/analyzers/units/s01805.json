{"scene_id": "s01805", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01805.fountain", "heading": "INT. ORCHARD HOUSE - KITCHEN - EARLY MORNING", "cast": [{"id": 0, "name": "BEN", "names": ["BEN"], "gender": "m", "first": 5, "spoke": 10}, {"id": 1, "name": "OYELARAN-STAHL", "names": ["OYELARAN-STAHL"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "ADELAIDE", "names": ["ADELAIDE"], "gender": "?", "first": 6, "spoke": 6}, {"id": 3, "name": "MARCELLUS", "names": ["MARCELLUS"], "gender": "m", "first": 7, "spoke": 7}, {"id": 4, "name": "PHILIPPA", "names": ["PHILIPPA"], "gender": "?", "first": 8, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. ORCHARD HOUSE - KITCHEN - EARLY MORNING", "present": []}, {"u": 1, "kind": "action", "text": "A farm kitchen before sun-up.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A pot of oatmeal rests on the stove.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A thermos, a lunch pail, and a pair of small rubber boots stand by the door.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The window is a blue square.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "BENEDICT \"BEN\" OYELARAN-STAHL, fifties, sits at the table with his hat on, turning a coffee cup a quarter turn at a time.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "His wife ADELAIDE sits across from him and does not touch her bowl.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Their son MARCELLUS, seventeen, stands at the sink with a duffel bag over his shoulder, running the tap.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Their daughter PHILIPPA, eleven, sits on the stairs in her nightgown, chin on knees.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "The tap runs.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Nobody turns it off.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Your mother packed you the good bread.", "name": "BEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Thanks, Mom.", "name": "MARCELLUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Mind the crust. It's still warm.", "name": "ADELAIDE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Marcy, are you taking the tractor?", "name": "PHILIPPA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "No, Pip. The bus.", "name": "MARCELLUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Then who's going to drive the tractor?", "name": "PHILIPPA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "I will.", "name": "BEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "You don't like the tractor.", "name": "PHILIPPA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "I like it well enough.", "name": "BEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Ben stands, crosses to the window, looks out at the dark orchard.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "His shoulders do not move.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Marcellus finally shuts the tap off.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "The kitchen goes very still.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "You've got your ticket?", "name": "ADELAIDE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "In my coat.", "name": "MARCELLUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Show me.", "name": "ADELAIDE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "He pulls it out.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "She reads it as though it were a letter, then folds it carefully along its crease and hands it back.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Her fingers linger on his sleeve.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Can I come to the bus stop?", "name": "PHILIPPA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "No.", "name": "BEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Why not?", "name": "PHILIPPA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Because there's school.", "name": "BEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "It's Saturday.", "name": "PHILIPPA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "So it is.", "name": "BEN", "speaker": 0, "ext": [], "paren": ["a beat"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Marcellus puts down the duffel.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Philippa runs down the stairs and hugs his leg.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "He ruffles her hair.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Ben takes his hat off and holds it by the brim.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Marcellus.", "name": "BEN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Yes, Dad.", "name": "MARCELLUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "The trees will still be here.", "name": "BEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "I know.", "name": "MARCELLUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "When you come back.", "name": "BEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "I know.", "name": "MARCELLUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Adelaide stands, takes the lunch pail from the shelf, and fills it, slowly, with bread, a wedge of cheese, an apple.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "She snaps the lid shut and holds it out.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "He takes it.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "For a moment both of them keep a hold of it.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Go on, then. You'll miss it.", "name": "ADELAIDE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "He nods.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "At the door he sits on the bench and pulls on his boots, taking much longer than boots require.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Ben puts his hat on, takes it off, and puts it on again.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "Marcy?", "name": "PHILIPPA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "Yeah, Pip?", "name": "MARCELLUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "You forgot your thermos.", "name": "PHILIPPA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "She holds it up.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "He takes it and kisses the top of her head, and then, with his free hand, reaches for Ben's.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "Ben shakes it once, briskly, as he would with a neighbor, and then pulls him in and holds him a second too long.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "Marcellus slings the duffel and goes out into the blue.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "The screen door bangs.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "Nobody moves.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "Then Adelaide ladles oatmeal into Ben's bowl and puts it in front of him.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "dialogue", "text": "Eat.", "name": "ADELAIDE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "I'm not hungry.", "name": "BEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "dialogue", "text": "Eat anyway.", "name": "ADELAIDE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "action", "text": "He sits.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "action", "text": "He eats.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}]}