{"scene_id": "s01812", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01812.fountain", "heading": "INT. ESCAPE ROOM - \"THE PHARAOH'S LAST BRUNCH\" - NIGHT", "cast": [{"id": 0, "name": "BARRETT NWANKWO-HILL", "names": ["BARRETT NWANKWO-HILL", "BARRETT"], "gender": "m", "first": 4, "spoke": 10}, {"id": 1, "name": "DOLORES FITZSIMMONS", "names": ["DOLORES FITZSIMMONS", "DOLORES"], "gender": "?", "first": 5, "spoke": 10}, {"id": 2, "name": "YASMIN KARIMI-ODOM", "names": ["YASMIN KARIMI-ODOM", "YASMIN"], "gender": "f", "first": 6, "spoke": 5}, {"id": 3, "name": "GRIFFIN PELLERIN", "names": ["GRIFFIN PELLERIN", "GRIFFIN"], "gender": "?", "first": 7, "spoke": 7}, {"id": 4, "name": "THEO", "names": ["THEO"], "gender": "f", "first": 8, "spoke": 7}, {"id": 5, "name": "ABARA", "names": ["ABARA"], "gender": "?", "first": 8, "spoke": 0}, {"id": 6, "name": "LEONARD VASQUEZ-TREMBLAY", "names": ["LEONARD VASQUEZ-TREMBLAY", "LEONARD"], "gender": "?", "first": 9, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. ESCAPE ROOM - \"THE PHARAOH'S LAST BRUNCH\" - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A chamber made of cardboard and fabric: painted hieroglyphs, plastic jackals, a sarcophagus with a pizza box inside.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A countdown clock on the wall reads 14:22.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Six coworkers are locked inside.", "para": 1, "sent": 0, "present": []}, {"u": 4, "kind": "action", "text": "BARRETT NWANKWO-HILL, thirties, wears a lanyard and an expression of dread.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "action", "text": "DOLORES FITZSIMMONS, fifties, has taken over the sarcophagus.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "YASMIN KARIMI-ODOM, twenties, holds a flashlight she doesn't need.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "GRIFFIN PELLERIN, forties, runs a finger down a wall of symbols.", "para": 1, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "THEODOSIA \"THEO\" ABARA, thirties, checks her phone.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "action", "text": "And the intern, LEONARD VASQUEZ-TREMBLAY, nineteen, stands very still by the exit.", "para": 1, "sent": 6, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "dialogue", "text": "Okay. Everyone stop touching things.", "name": "DOLORES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "I'm not touching anything.", "name": "BARRETT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "You're touching the jackal.", "name": "GRIFFIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "The jackal touched me first.", "name": "BARRETT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "Guys, there's a symbol that looks like a sandwich.", "name": "YASMIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "That's a hieroglyph for bread.", "name": "THEO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "It looks like a sandwich.", "name": "YASMIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "Everyone, shut up, I'm thinking.", "name": "DOLORES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "Mrs. Fitzsimmons, I think the pizza box is a clue.", "name": "LEONARD", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "Leonard, you're nineteen.", "name": "DOLORES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "I'm aware.", "name": "LEONARD", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "Dolores, listen to the kid.", "name": "GRIFFIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "It's a pizza box. It's Pharaoh's brunch. It's a theme, Griffin.", "name": "DOLORES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "Maybe it's both.", "name": "THEO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "Both what?", "name": "BARRETT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "A theme and a clue.", "name": "THEO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "Can I open it?", "name": "YASMIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "No.", "name": "DOLORES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "Yes.", "name": "GRIFFIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "Maybe.", "name": "BARRETT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "I'm opening it.", "name": "LEONARD", "speaker": 6, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "He flips the lid.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "action", "text": "Inside the box lies a single slice of pepperoni and a folded note.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "They all gape.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "It says, \"The first letter of every item you've touched.\"", "name": "LEONARD", "speaker": 6, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "Jackal.", "name": "BARRETT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "Jar.", "name": "GRIFFIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "Jewel.", "name": "THEO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "dialogue", "text": "Scarab.", "name": "YASMIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "Sarcophagus.", "name": "DOLORES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "Pizza.", "name": "LEONARD", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "dialogue", "text": "J, J, J, S, S, P.", "name": "BARRETT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "dialogue", "text": "That doesn't spell anything.", "name": "THEO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "dialogue", "text": "Jjjsssp.", "name": "GRIFFIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "dialogue", "text": "Maybe it's Egyptian.", "name": "YASMIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "It's not Egyptian, Yasmin, it's an acronym.", "name": "DOLORES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "dialogue", "text": "For what?", "name": "BARRETT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "dialogue", "text": "For \"Jackals Should Stay Properly Put.\"", "name": "DOLORES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "dialogue", "text": "That's not a thing.", "name": "GRIFFIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "dialogue", "text": "It could be a thing.", "name": "THEO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "dialogue", "text": "I think the clock is at four minutes.", "name": "LEONARD", "speaker": 6, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "action", "text": "They all turn.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "action", "text": "The clock reads 4:00.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "action", "text": "A silence follows, broken only by Yasmin's flashlight clicking on and off.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "action", "text": "Barrett sits on the floor and puts his head in his hands.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "dialogue", "text": "I told my wife I'd be home by nine.", "name": "BARRETT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "dialogue", "text": "You told her that?", "name": "GRIFFIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "dialogue", "text": "I was optimistic.", "name": "BARRETT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "dialogue", "text": "Everyone, hands in. We're doing this together.", "name": "DOLORES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 59, "kind": "dialogue", "text": "Doing what?", "name": "THEO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 60, "kind": "dialogue", "text": "I have no idea. But we're doing it together.", "name": "DOLORES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 61, "kind": "action", "text": "They put their hands in a circle.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 62, "kind": "action", "text": "Barrett lifts his head, wipes his eyes, and adds his own.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 63, "kind": "action", "text": "Leonard, who has been watching the door the whole time, reaches out and presses a small button on the frame that reads, in tiny letters, EXIT.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 64, "kind": "action", "text": "The door clicks and swings open.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 65, "kind": "dialogue", "text": "It was just a door.", "name": "LEONARD", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 66, "kind": "action", "text": "Dolores glares.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 67, "kind": "action", "text": "Griffin laughs.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 68, "kind": "action", "text": "Theo lowers her phone.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 69, "kind": "action", "text": "The clock keeps counting.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 70, "kind": "dialogue", "text": "I'm going to need a minute.", "name": "BARRETT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}