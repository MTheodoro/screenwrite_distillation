{"scene_id": "s01816", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01816.fountain", "heading": "INT. SLEEP CLINIC - OBSERVATION ROOM - 4 A.M.", "cast": [{"id": 0, "name": "ISADORA CHUKWUMA-LEE", "names": ["ISADORA CHUKWUMA-LEE", "ISADORA"], "gender": "f", "first": 5, "spoke": 12}, {"id": 1, "name": "ROLAND PAPADOPOULOS", "names": ["ROLAND PAPADOPOULOS", "ROLAND"], "gender": "m", "first": 6, "spoke": 11}, {"id": 2, "name": "PATIENT", "names": ["PATIENT"], "gender": "?", "first": 7, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. SLEEP CLINIC - OBSERVATION ROOM - 4 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "A dark control room with a wall of monitors showing a sleeping man in a bed on the other side of a window.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Waveforms scroll.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A thermos, a half-eaten sandwich.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A clock reads 4:02.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. ISADORA CHUKWUMA-LEE, forties, sits at the central console with a cardigan over her shoulders.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her technician, ROLAND PAPADOPOULOS, thirties, slouches in a rolling chair with headphones around his neck.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "On the other side of the glass, the PATIENT, forties, sleeps on his back under a thin blanket, wired to a dozen electrodes.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Roland, how long has he been in REM?", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Eleven minutes.", "name": "ROLAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Anything unusual?", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Heart rate sixty-two. Respiration steady.", "name": "ROLAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "...forty-one... forty... thirty-nine...", "name": "PATIENT", "speaker": 2, "ext": ["V.O."], "paren": ["from speaker, mumbled"], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Roland pulls off his headphones.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Isadora leans forward.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "He's counting.", "name": "ROLAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Backward.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Lots of people talk in their sleep.", "name": "ROLAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Not in sequence.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "...thirty-four... thirty-three...", "name": "PATIENT", "speaker": 2, "ext": ["V.O."], "paren": ["from speaker"], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "He's slowing down.", "name": "ROLAND", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Roland, what's his baseline?", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Normal. Textbook.", "name": "ROLAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Then why is the EEG doing that?", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "A long spike of activity slides across the screen, regular and sharp, like a metronome.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "That's not REM.", "name": "ROLAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "That's a seizure pattern.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "He's not seizing.", "name": "ROLAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "No. Which is what concerns me.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "...twelve... eleven... ten...", "name": "PATIENT", "speaker": 2, "ext": ["V.O."], "paren": ["from speaker"], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Should we wake him?", "name": "ROLAND", "speaker": 1, "ext": [], "paren": ["over the voice"], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Not yet.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": ["over Roland"], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "...nine... eight...", "name": "PATIENT", "speaker": 2, "ext": ["V.O."], "paren": ["from speaker, overlapping"], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Dr. Chukwuma-Lee.", "name": "ROLAND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Not yet. I want to see what happens at zero.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Both of them watch.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "The numbers fall.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "The metronome spike steadies.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "The room is silent but for the voice.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "...three... two... one...", "name": "PATIENT", "speaker": 2, "ext": ["V.O."], "paren": ["from speaker"], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "The voice stops.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "The spike flatlines, a single clean line.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Roland lunges for the intercom.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Isadora doesn't move.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "On the monitors, the man opens his eyes.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "He sits up in bed, looks straight at the glass, and smiles as though he has been awake all along.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Good morning, Doctor.", "name": "PATIENT", "speaker": 2, "ext": ["V.O.", "CONT'D"], "paren": ["from speaker, clear"], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Good morning.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "He wasn't asleep.", "name": "ROLAND", "speaker": 1, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "No.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "The man stretches, unhurried, swings his feet to the floor, and waves.", "para": 7, "sent": 0, "present": [0, 1, 2]}]}