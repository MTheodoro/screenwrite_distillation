{"scene_id": "s01819", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01819.fountain", "heading": "EXT. LIFE RAFT - OPEN OCEAN - DAY", "cast": [{"id": 0, "name": "ANSELMO TRUJILLO-REYES", "names": ["ANSELMO TRUJILLO-REYES", "ANSELMO"], "gender": "m", "first": 5, "spoke": 14}, {"id": 1, "name": "ODALIE BRANDVOLD", "names": ["ODALIE BRANDVOLD", "ODALIE"], "gender": "f", "first": 6, "spoke": 17}], "units": [{"u": 0, "kind": "heading", "text": "EXT. LIFE RAFT - OPEN OCEAN - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A yellow inflatable raft rides a long gray swell.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The horizon is a razor line.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Sun beats down on a torn canopy.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A water jug, a flare tin, a coil of rope.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ANSELMO TRUJILLO-REYES, forties, a cargo ship engineer, lies on his back on the floor of the raft, cracked lips, shirt over his head.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across from him sits ODALIE BRANDVOLD, thirties, a deckhand, her hair salted into rope, clutching the water jug to her chest.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Don't look. Don't look at the horizon. Don't count the days.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You're talking.", "name": "ANSELMO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I'm not talking.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "You're muttering.", "name": "ANSELMO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Then I'm muttering.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She tilts the jug.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Anselmo's eyes follow it.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She lowers it without drinking.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "How much left?", "name": "ANSELMO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Two inches.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Two inches of what? Two inches in the jug or two inches in the bottle?", "name": "ANSELMO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Two inches in the jug. The bottle's empty.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "When did that happen?", "name": "ANSELMO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Yesterday. While you were asleep.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "You drank it?", "name": "ANSELMO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "I split it. Four sips each.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "I don't remember mine.", "name": "ANSELMO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "You were out.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Anselmo pulls the shirt off his face and stares at the sky.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Gulls wheel above.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Birds.", "name": "ANSELMO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Yes.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Birds mean land.", "name": "ANSELMO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Birds mean fish.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Land's close.", "name": "ANSELMO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Don't.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "She stands, rocking the raft, and shades her eyes.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "She cups her hands around her mouth and shouts at the empty sea.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "HEY! HEY! OVER HERE!", "name": "ODALIE", "speaker": 1, "ext": ["CONT'D"], "paren": ["to the horizon"], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Nothing.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Waves slap the rubber.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "She sits.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Anselmo closes his eyes.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Who are you calling?", "name": "ANSELMO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Whoever's listening.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Nobody's listening.", "name": "ANSELMO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Somebody's always listening.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "That's God.", "name": "ANSELMO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "That's a plane.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Anselmo opens his eyes.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Far above, a tiny silver glint crosses the blue.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Odalie lunges for the flare tin, tears it open, and fires.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "A red streak shoots up, trailing smoke.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "They both stare after it.", "para": 6, "sent": 4, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Did they see?", "name": "ANSELMO", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "I don't know.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "The plane glints, banks, and begins a slow, wide circle.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "Odalie drops the flare gun.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "Anselmo, laughing and sobbing, props himself on one elbow and raises his hand.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "She grips the jug, takes one long drink, then passes it to him.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "Finish it.", "name": "ODALIE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}]}