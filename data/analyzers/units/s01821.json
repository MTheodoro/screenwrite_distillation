{"scene_id": "s01821", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01821.fountain", "heading": "INT. DISUSED CURLING RINK - NIGHT", "cast": [{"id": 0, "name": "COACH HALVORSEN", "names": ["COACH HALVORSEN"], "gender": "m", "first": 7, "spoke": 8}, {"id": 1, "name": "DEE", "names": ["DEE"], "gender": "m", "first": 8, "spoke": 4}, {"id": 2, "name": "OKORO", "names": ["OKORO"], "gender": "?", "first": 8, "spoke": 0}, {"id": 3, "name": "NADIA PETROVIC", "names": ["NADIA PETROVIC", "NADIA"], "gender": "?", "first": 9, "spoke": 9}, {"id": 4, "name": "REYES", "names": ["REYES"], "gender": "?", "first": 10, "spoke": 0}, {"id": 5, "name": "WINNIE CHO", "names": ["WINNIE CHO", "WINNIE"], "gender": "?", "first": 11, "spoke": 4}, {"id": 6, "name": "LUCAS BRANDT", "names": ["LUCAS BRANDT", "LUCAS"], "gender": "m", "first": 12, "spoke": 7}, {"id": 7, "name": "BIG TOM\u00c1S", "names": ["BIG TOM\u00c1S", "TOM\u00c1S"], "gender": "?", "first": 10, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. DISUSED CURLING RINK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Half the lights are dead.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A sheet of ice gone gray, scarred by years of rental hockey.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Folding chairs along the boards.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A cooler.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A speaker on a bucket playing nothing.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "Six people wait for a seventh who is late.", "para": 1, "sent": 0, "present": []}, {"u": 7, "kind": "action", "text": "COACH HALVORSEN, 50s, whistle on a shoelace, sits on the penalty box bench and pares an apple with a pocketknife.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "DESHAWN \"DEE\" OKORO, 30s, goalie pads already strapped, stares at his own skates.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "NADIA PETROVIC, late 20s, captain's C stitched crooked on her jersey, tapes a stick that is already taped.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "BIG TOM\u00c1S REYES, 40s, enormous, eats sunflower seeds one at a time.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 7]}, {"u": 11, "kind": "action", "text": "WINNIE CHO, 19, new, sits straighter than the others.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 7]}, {"u": 12, "kind": "action", "text": "And LUCAS BRANDT, 30s, sponsor's nephew, wears a pressed team jacket and nothing else that says he plays.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 13, "kind": "action", "text": "Nobody speaks.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 14, "kind": "action", "text": "Tom\u00e1s spits a shell into a cup.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 15, "kind": "dialogue", "text": "Ice time ends at ten.", "name": "COACH HALVORSEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 16, "kind": "dialogue", "text": "It's nine-forty.", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 17, "kind": "dialogue", "text": "So.", "name": "COACH HALVORSEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 18, "kind": "action", "text": "Nadia stands, skates onto the ice, and does one lap alone.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 19, "kind": "action", "text": "Winnie watches her.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 20, "kind": "action", "text": "Lucas watches Winnie.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 21, "kind": "dialogue", "text": "Is she always like this?", "name": "LUCAS", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 22, "kind": "action", "text": "Tom\u00e1s turns his head slowly.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 23, "kind": "dialogue", "text": "Like what.", "name": "BIG TOM\u00c1S", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 24, "kind": "dialogue", "text": "Intense.", "name": "LUCAS", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 25, "kind": "action", "text": "Tom\u00e1s goes back to his seeds.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 26, "kind": "dialogue", "text": "You're in Winnie's spot.", "name": "DEE", "speaker": 1, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 27, "kind": "dialogue", "text": "It's a bench.", "name": "LUCAS", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 28, "kind": "dialogue", "text": "She sits there.", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 29, "kind": "action", "text": "Lucas does not move.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "action", "text": "Winnie does not ask him to.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "action", "text": "She takes her helmet off the floor and puts it on, chin strap clicked slowly.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "dialogue", "text": "Dee. You're starting.", "name": "COACH HALVORSEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "dialogue", "text": "I'm starting every game.", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "dialogue", "text": "I know.", "name": "COACH HALVORSEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "action", "text": "He folds the knife.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "action", "text": "Eats the apple core and all.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "action", "text": "Nadia finishes her lap and stops at the boards in front of Lucas, close enough that her breath fogs his jacket.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "dialogue", "text": "Who gave you a roster spot?", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "dialogue", "text": "My uncle owns the sponsor.", "name": "LUCAS", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "dialogue", "text": "Right. And who gave him a tax break?", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 41, "kind": "dialogue", "text": "I didn't come here to fight.", "name": "LUCAS", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 42, "kind": "dialogue", "text": "You didn't come here to play either.", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 43, "kind": "dialogue", "text": "Leave it.", "name": "WINNIE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 44, "kind": "dialogue", "text": "He took your minutes.", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 45, "kind": "dialogue", "text": "I said leave it.", "name": "WINNIE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 46, "kind": "action", "text": "Silence.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 47, "kind": "action", "text": "The speaker crackles and cuts out again.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 48, "kind": "action", "text": "Tom\u00e1s stands.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 49, "kind": "action", "text": "He is very tall standing.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 50, "kind": "action", "text": "He picks up Lucas's stick from the rack, studies it, and hands it back blade first.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 51, "kind": "dialogue", "text": "Tape's wrong.", "name": "BIG TOM\u00c1S", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 52, "kind": "dialogue", "text": "I taped it this morning.", "name": "LUCAS", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 53, "kind": "dialogue", "text": "That's what I said.", "name": "BIG TOM\u00c1S", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 54, "kind": "action", "text": "Lucas takes the stick.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 55, "kind": "action", "text": "His hand shakes a little on the shaft and he hides it by gripping tighter.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 56, "kind": "action", "text": "Coach Halvorsen blows his whistle once.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 57, "kind": "action", "text": "Everyone stops.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 58, "kind": "dialogue", "text": "Lucas. Line one.", "name": "COACH HALVORSEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 59, "kind": "dialogue", "text": "Coach.", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 60, "kind": "dialogue", "text": "Line one, with Winnie and Tom\u00e1s.", "name": "COACH HALVORSEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 61, "kind": "dialogue", "text": "That's my line.", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 62, "kind": "dialogue", "text": "Then you'll be on the bench.", "name": "COACH HALVORSEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 63, "kind": "action", "text": "Nadia looks at him.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 64, "kind": "action", "text": "At Lucas.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 65, "kind": "action", "text": "At Winnie.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 66, "kind": "action", "text": "She takes the C off her chest in one hard tear and drops it on the ice, where it sits, a small crooked patch.", "para": 14, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 67, "kind": "action", "text": "Nobody moves to pick it up.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 68, "kind": "dialogue", "text": "Nadia.", "name": "DEE", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 69, "kind": "dialogue", "text": "Don't.", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 70, "kind": "action", "text": "She skates off to the far end.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 71, "kind": "action", "text": "Slams the boards with her stick.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 72, "kind": "action", "text": "The sound goes up into the dead lights and comes back.", "para": 16, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 73, "kind": "action", "text": "Winnie steps onto the ice.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 74, "kind": "action", "text": "Lucas follows, wobbles, catches himself on her sleeve.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 75, "kind": "action", "text": "She lets him hold it for a second, then removes his hand.", "para": 17, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 76, "kind": "dialogue", "text": "Skate wide. Don't touch anyone.", "name": "WINNIE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 77, "kind": "dialogue", "text": "Why not?", "name": "LUCAS", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 78, "kind": "dialogue", "text": "Because she's waiting for you to.", "name": "WINNIE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 79, "kind": "action", "text": "At the far end Nadia has stopped.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 80, "kind": "action", "text": "She turns.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 81, "kind": "action", "text": "Her stick comes up.", "para": 18, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 82, "kind": "dialogue", "text": "Here we go.", "name": "TOM\u00c1S", "speaker": 7, "ext": [], "paren": ["under his breath"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 83, "kind": "action", "text": "Dee pulls his mask down.", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 84, "kind": "action", "text": "The puck drops by itself, dropped from Coach's fist onto the ice with a click, and then there is only the sound of blades.", "para": 19, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 85, "kind": "action", "text": "Nadia is already moving.", "para": 20, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 86, "kind": "action", "text": "Lucas tries to turn and cannot.", "para": 20, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 87, "kind": "action", "text": "She hits him hip-first into the boards and the whole rink shakes.", "para": 20, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 88, "kind": "action", "text": "He goes down.", "para": 20, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 89, "kind": "action", "text": "She stands over him, breathing, her stick lifted to the height of her shoulder.", "para": 20, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 90, "kind": "action", "text": "Tom\u00e1s is on her in two strides, wrapping her arms.", "para": 21, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 91, "kind": "action", "text": "Winnie is between them.", "para": 21, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 92, "kind": "action", "text": "Dee has left the net and is standing at the blue line, mask pushed up, pads dripping frost.", "para": 21, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 93, "kind": "dialogue", "text": "Let go of me.", "name": "NADIA", "speaker": 3, "ext": [], "paren": ["through teeth"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 94, "kind": "dialogue", "text": "When you drop it.", "name": "BIG TOM\u00c1S", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 95, "kind": "action", "text": "She doesn't.", "para": 22, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 96, "kind": "action", "text": "He doesn't.", "para": 22, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 97, "kind": "action", "text": "The stick shakes between them.", "para": 22, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 98, "kind": "dialogue", "text": "Ten o'clock.", "name": "COACH HALVORSEN", "speaker": 0, "ext": [], "paren": ["from the bench, calm"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 99, "kind": "action", "text": "The lights above the far end click off, one bank after another, until the only light left is over the six of them, and then that one goes too.", "para": 23, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}