{"scene_id": "s01823", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01823.fountain", "heading": "INT. ORBITAL FERRY AIRLOCK - CONTINUOUS", "cast": [{"id": 0, "name": "TECHNICIAN YUSUF BELLAMY", "names": ["TECHNICIAN YUSUF BELLAMY", "YUSUF"], "gender": "m", "first": 3, "spoke": 3}, {"id": 1, "name": "CONTROL", "names": ["CONTROL"], "gender": "?", "first": 4, "spoke": 2}, {"id": 2, "name": "COMMANDER ISOLDE RAINES", "names": ["COMMANDER ISOLDE RAINES", "ISOLDE"], "gender": "?", "first": 11, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. ORBITAL FERRY AIRLOCK - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "A cramped airlock.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Red warning strip lights pulse on the walls.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "TECHNICIAN YUSUF BELLAMY, 30s, pressure suit, helmet off, bangs on the inner hatch with a gloved fist.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "dialogue", "text": "Control, I've got seal failure on lock two. Repeat, seal failure.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "Copy lock two. Do not cycle the outer door.", "name": "CONTROL", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "I'm not cycling anything. Something's cycling it for me.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "The outer door groans a hand's width open.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Air shrieks out.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Yusuf clips his tether to a rail and grabs the manual lever with both hands.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Behind him, the inner hatch pops.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "COMMANDER ISOLDE RAINES, 50s, bare-headed and furious, shoulders in and slaps a patch over the leak in one move.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "The shriek stops.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "The outer door shudders closed.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Both breathe.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Stop shouting at the radio.", "name": "ISOLDE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "It was loud.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Lock two, status?", "name": "CONTROL", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Sealed. Tell maintenance their gasket is a joke.", "name": "ISOLDE", "speaker": 2, "ext": [], "paren": ["into her collar"], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "She hauls Yusuf upright by the harness.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "He laughs, shaky.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "She does not.", "para": 5, "sent": 2, "present": [0, 1, 2]}]}