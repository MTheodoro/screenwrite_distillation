{"scene_id": "s01824", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01824.fountain", "heading": "INT. HOTEL LAUNDRY ROOM - DAY", "cast": [{"id": 0, "name": "INSPECTOR WALTER PRYCE", "names": ["INSPECTOR WALTER PRYCE", "PRYCE"], "gender": "m", "first": 3, "spoke": 6}, {"id": 1, "name": "ADELAIDE VOSS", "names": ["ADELAIDE VOSS", "MRS. VOSS", "^MRS. VOSS"], "gender": "?", "first": 4, "spoke": 5}, {"id": 2, "name": "FINN", "names": ["FINN"], "gender": "?", "first": 11, "spoke": 2}, {"id": 3, "name": "DOYLE", "names": ["DOYLE"], "gender": "?", "first": 11, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOTEL LAUNDRY ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Steam, sheets, rolling carts.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A brass bell on the counter.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "INSPECTOR WALTER PRYCE, 50s, rumpled trench coat, hat in hand, leans on the counter.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "Behind it, MRS. ADELAIDE VOSS, 60s, laundress, folds pillowcases in perfect squares without looking down.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "Room two-fourteen sent down a bundle Tuesday.", "name": "PRYCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Many rooms send bundles.", "name": "MRS. VOSS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "This one had a monogram. \"H.L.\"", "name": "PRYCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "There are two Hs in the hotel. One is a duchess.", "name": "MRS. VOSS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "And the other?", "name": "PRYCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Left Wednesday.", "name": "MRS. VOSS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "The door swings and a young bellhop, FINNEGAN \"FINN\" DOYLE, 17, buttons crooked, hurries in with a cart.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Mrs. Voss, the Hargrove suite wants--", "name": "FINN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "He sees Pryce and stops.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Hargrove, you say?", "name": "PRYCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "I didn't say anything.", "name": "FINN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Finn, the cart.", "name": "^MRS. VOSS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Pryce smiles slowly and taps his hat against his palm.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Mrs. Voss, I'd like to see that bundle.", "name": "PRYCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "It's been laundered.", "name": "MRS. VOSS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "I thought it might have been.", "name": "PRYCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}