{"scene_id": "s01826", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01826.fountain", "heading": "INT. PAWNSHOP BACK ROOM - NIGHT", "cast": [{"id": 0, "name": "VINNIE", "names": ["VINNIE"], "gender": "m", "first": 5, "spoke": 15}, {"id": 1, "name": "CARUSO", "names": ["CARUSO"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "DARIUS CALLOWAY", "names": ["DARIUS CALLOWAY", "DARIUS"], "gender": "m", "first": 6, "spoke": 6}, {"id": 3, "name": "MARISOL DEVEREAUX", "names": ["MARISOL DEVEREAUX", "MARISOL"], "gender": "f", "first": 7, "spoke": 6}, {"id": 4, "name": "LORNE TREMBLAY", "names": ["LORNE TREMBLAY", "LORNE"], "gender": "?", "first": 8, "spoke": 10}, {"id": 5, "name": "^MARISOL", "names": ["^MARISOL"], "gender": "?", "first": 63, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. PAWNSHOP BACK ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A windowless room behind a pawnshop.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Shelves of unclaimed guitars, a safe the size of a refrigerator, a card table under a hanging bulb.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A space heater ticks in the corner.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Four people.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "VINCENT \"VINNIE\" CARUSO, 50s, the owner, sits at the card table counting cash into stacks with a wet thumb.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "His nephew DARIUS CALLOWAY, 20s, leans on the safe with arms folded, a duffel bag at his feet.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "At the door stands MARISOL DEVEREAUX, 30s, in a long coat, one hand in her pocket.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "And across from Vinnie, on a folding chair, sits LORNE TREMBLAY, 40s, a courier who has not taken off his gloves.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Eleven. Twelve.", "name": "VINNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "He slides a stack to Lorne and starts a new one.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "It was fifteen.", "name": "LORNE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "It was fifteen before the thing with the plates.", "name": "VINNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Nobody told me about plates.", "name": "LORNE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Nobody told me you'd double-park.", "name": "VINNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Darius uncrosses his arms, bends to unzip the duffel an inch, looks inside, and zips it again.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Marisol shifts against the door frame and the floor creaks.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Lorne watches her.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "She watches Vinnie.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Vinnie keeps counting, and no one in the room touches anything they haven't already touched.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Who is she?", "name": "LORNE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "A friend of the family.", "name": "VINNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "She doesn't look like family.", "name": "LORNE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "That's because I'm not.", "name": "MARISOL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "She takes her hand out of her pocket.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "It is empty.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "She sets it on the doorknob, and Lorne breathes out.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "You're making me nervous, lady.", "name": "LORNE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Good.", "name": "MARISOL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Marisol, sit.", "name": "VINNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "I'm fine.", "name": "MARISOL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Sit down. You're scaring the courier.", "name": "VINNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "She sits on an amp case near the door.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Darius crouches by the duffel again.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Uncle V. It's not all there.", "name": "DARIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Of course it's not all there.", "name": "VINNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Then what's the point of--", "name": "DARIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "What's the point is we count it twice, once for him and once for us.", "name": "VINNIE", "speaker": 0, "ext": [], "paren": ["cutting in"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Lorne leans forward.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "The chair squeaks.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "I want to know what's in the duffel.", "name": "LORNE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Paperwork.", "name": "DARIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Paperwork doesn't make a sound like that.", "name": "LORNE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "It's a lot of paper.", "name": "VINNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Lorne stands.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Darius stands.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Vinnie sets his stack down.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Marisol rises off the amp case with one slow movement and stands between the door and the table.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Nobody speaks.", "para": 7, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "The space heater ticks louder than it did.", "para": 7, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Open it.", "name": "LORNE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "No.", "name": "DARIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "Open it, or I walk and take the eleven.", "name": "LORNE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "Take the eleven.", "name": "VINNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "Twelve.", "name": "LORNE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "Twelve.", "name": "VINNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Lorne reaches down for the money, but Darius steps forward and blocks the table.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "They stand almost chest to chest.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Lorne is shorter.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "He does not step back.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "Darius.", "name": "MARISOL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "He's not leaving with it.", "name": "DARIUS", "speaker": 2, "ext": [], "paren": ["over his shoulder"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "dialogue", "text": "Let him take the twelve.", "name": "VINNIE", "speaker": 0, "ext": [], "paren": ["simultaneously"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "dialogue", "text": "Let him go, Darius.", "name": "^MARISOL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "Darius does not move.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "Marisol puts her hand into her coat pocket again, and this time the shape in it is not empty.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "dialogue", "text": "Step away from the table.", "name": "MARISOL", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "action", "text": "Everyone freezes.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "action", "text": "The bulb sways.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "action", "text": "It lights Lorne's face, then Darius's, then Marisol's, then Vinnie's, one after another, as it swings.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "action", "text": "Darius steps back.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "action", "text": "His hands come up.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "action", "text": "Lorne takes the twelve stacks, folds them into his jacket, and walks to the door.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "action", "text": "Marisol opens it for him and he goes through.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "action", "text": "The door closes.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 75, "kind": "action", "text": "The latch clicks.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 76, "kind": "action", "text": "Vinnie lets out a breath he has been holding for a long time, and sits.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 77, "kind": "dialogue", "text": "You had nothing in the pocket.", "name": "VINNIE", "speaker": 0, "ext": [], "paren": ["to Marisol"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 78, "kind": "dialogue", "text": "I had a stapler.", "name": "MARISOL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 79, "kind": "action", "text": "Darius, still with his hands up, starts to laugh.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 80, "kind": "action", "text": "It cracks halfway into a cough.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 81, "kind": "action", "text": "Vinnie rubs his eyes with one hand, then reaches across and unzips the duffel himself.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 82, "kind": "action", "text": "Inside, under a folded newspaper, are bricks of cash, rubber-banded.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 83, "kind": "dialogue", "text": "Count it again.", "name": "VINNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 84, "kind": "dialogue", "text": "Now?", "name": "DARIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 85, "kind": "dialogue", "text": "Now.", "name": "VINNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 86, "kind": "action", "text": "Darius kneels.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 87, "kind": "action", "text": "Marisol takes off her coat and hangs it on a guitar neck.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 88, "kind": "action", "text": "Somewhere out front the shop bell rings once, and all three go quiet and look at the door.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}