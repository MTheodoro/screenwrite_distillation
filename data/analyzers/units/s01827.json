{"scene_id": "s01827", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01827.fountain", "heading": "INT. DRIVE-THROUGH WEDDING CHAPEL - NIGHT", "cast": [{"id": 0, "name": "REVEREND AMOS PLUMB", "names": ["REVEREND AMOS PLUMB", "AMOS"], "gender": "m", "first": 4, "spoke": 4}, {"id": 1, "name": "BETTINA", "names": ["BETTINA"], "gender": "?", "first": 5, "spoke": 1}, {"id": 2, "name": "DUANE", "names": ["DUANE"], "gender": "?", "first": 5, "spoke": 2}, {"id": 3, "name": "MARGO TALLEY", "names": ["MARGO TALLEY", "MARGO"], "gender": "?", "first": 14, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRIVE-THROUGH WEDDING CHAPEL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A neon window.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A speaker box.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cardboard heart.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "REVEREND AMOS PLUMB, 60s, rhinestone collar, leans out the window, microphone on a stand.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "In the car below: BETTINA, 26, veil taped to her head, and DUANE, 28, tux jacket over a hoodie.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Do you, Duane, take this woman?", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Yes.", "name": "DUANE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "You didn't let me finish.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Sorry. Yes.", "name": "DUANE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Behind them, the car's back door opens.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "A third person climbs out.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Wrong car.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Wrong chapel.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "MARGO TALLEY, 40s, fast food uniform, a tray of milkshakes.", "para": 2, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Which one of you ordered the vanilla?", "name": "MARGO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Everyone freezes.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Bettina points at Duane.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Duane points at Amos.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Amos points at the menu.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "We didn't order food.", "name": "BETTINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "It says wedding combo.", "name": "MARGO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "That's the second package.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Margo hands a shake through the window.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Amos takes it.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Duane grabs for it.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "They fight over the cup; it pops its lid and sprays all three.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Whipped cream drips from the veil.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Then headlights sweep the lot.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Amos grabs the microphone, and his voice booms from the speaker box.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Next couple, please pull forward.", "name": "AMOS", "speaker": 0, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Everyone scatters.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}]}