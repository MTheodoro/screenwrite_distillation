{"scene_id": "s01828", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01828.fountain", "heading": "INT. DESALINATION HABITAT - CORRIDOR - NIGHT", "cast": [{"id": 0, "name": "ENGINEER PRIYA NAIR", "names": ["ENGINEER PRIYA NAIR", "PRIYA"], "gender": "f", "first": 4, "spoke": 9}, {"id": 1, "name": "HELMUT KASSEL", "names": ["HELMUT KASSEL", "HELMUT"], "gender": "f", "first": 7, "spoke": 7}, {"id": 2, "name": "UNIT SEVEN", "names": ["UNIT SEVEN"], "gender": "?", "first": 9, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. DESALINATION HABITAT - CORRIDOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Seabed pressure hum.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Condensation on every pipe.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Emergency strips at ankle height.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ENGINEER PRIYA NAIR, 40s, sits on the floor against a bulkhead, a toolkit open beside her.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She is rewiring a panel by feel.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Her hands are steady.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "DR. HELMUT KASSEL, 60s, stands over her in a gray sweater.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He holds a clipboard he has stopped writing on.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "A drone, UNIT SEVEN, a squat gray cylinder on treads, idles at the end of the corridor, blue eye dimming and brightening.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Pressure's down four percent.", "name": "HELMUT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I know.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Since the shift change.", "name": "HELMUT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "I said I know.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "She strips a wire with her teeth, spits the insulation.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Helmut watches her do it.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "You're not asking me to hold the light.", "name": "HELMUT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "You'd drop it.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "He sets the clipboard on the floor, clicks on the penlight, and aims it at the panel.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "She does not thank him.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "The drone rolls forward a meter and stops.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Its eye turns amber.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Reminder. Evacuation capsule capacity is two. Habitat population is three.", "name": "UNIT SEVEN", "speaker": 2, "ext": ["V.O."], "paren": ["flat synthetic voice"], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Priya's hands stop.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Helmut's penlight wavers.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Unit Seven. Mute.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Muting is not permitted during a pressure advisory.", "name": "UNIT SEVEN", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Then roll back.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "The drone rolls back.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "A meter.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Two.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The amber stays on.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Helmut crouches.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "He puts a hand on Priya's wrist.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "She looks at it, then at him.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "She does not pull away.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "How long until it holds?", "name": "HELMUT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "An hour. Maybe three.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "And if it doesn't?", "name": "HELMUT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "She shrugs.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "He nods slowly.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "He takes his hand back, picks up the clipboard, and writes something.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Tears off the page.", "para": 10, "sent": 3, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Folds it.", "para": 10, "sent": 4, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Sets it beside her toolkit.", "para": 10, "sent": 5, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "What is that?", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Names, for the capsule. In order.", "name": "HELMUT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "She doesn't open it.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "She goes back to the panel, and the wire slides home with a small click.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "The pipes overhead shudder once.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "A bead of water forms on the ceiling, hangs, and falls onto the folded paper.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Priya covers it with her palm.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "She looks up the corridor at the drone's amber eye.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Unit Seven. Tell the surface we are fine.", "name": "PRIYA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "Transmitting. Confirm: you are fine?", "name": "UNIT SEVEN", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "She says nothing.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "The eye returns to blue.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Helmut slides down the wall until he is sitting beside her.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "They watch the panel.", "para": 15, "sent": 1, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "The pressure gauge ticks up one notch, then holds.", "para": 15, "sent": 2, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "Three percent.", "name": "HELMUT", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Two.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "He laughs, softly, and closes his eyes.", "para": 16, "sent": 0, "present": [0, 1, 2]}]}